<file path="install/systemd/nftban-ui.service">
 1: [Unit]
 2: Description=NFTBan Web GUI Server
 3: Documentation=https://github.com/itcmsgr/nftban
 4: After=network-online.target nftables.service polkit.service
 5: Wants=network-online.target
 6: 
 7: [Service]
 8: Type=simple
 9: User=nftban
10: Group=nftban
11: WorkingDirectory=/var/lib/nftban
12: ExecStart=/usr/sbin/nftban-ui --config /etc/nftban/ui.conf
13: Restart=on-failure
14: RestartSec=10
15: 
16: # Security hardening
17: # NoNewPrivileges=yes prevents gaining additional privileges at runtime
18: # Capabilities granted by systemd (AmbientCapabilities) are not affected
19: NoNewPrivileges=yes
20: 
21: # Grant CAP_NET_ADMIN for nftables operations
22: # Capability is granted by systemd at exec time, not gained dynamically
23: # Security: unprivileged nftban user + NoNewPrivileges + capability bounding
24: AmbientCapabilities=CAP_NET_ADMIN
25: CapabilityBoundingSet=CAP_NET_ADMIN
26: PrivateTmp=true
27: ProtectSystem=strict
28: ProtectHome=true
29: ReadWritePaths=/var/log/nftban /var/lib/nftban
30: ProtectKernelTunables=true
31: ProtectKernelModules=true
32: ProtectControlGroups=true
33: RestrictRealtime=true
34: RestrictNamespaces=true
35: LockPersonality=true
36: # IMPORTANT: MemoryDenyWriteExecute is intentionally NOT set for Go services.
37: # It breaks Go runtime on Ubuntu 24.04 (AppArmor + Landlock) and potentially
38: # future SELinux-enforcing distributions. Security is maintained through
39: # other hardening measures. See: docs/architecture/SYSTEMD_GO_HARDENING.md
40: RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
41: SystemCallFilter=@system-service
42: SystemCallArchitectures=native
43: 
44: # Resource limits (matching safety package defaults)
45: CPUQuota=200%
46: MemoryMax=512M
47: TasksMax=100
48: 
49: # Environment
50: Environment="NFTBAN_GOMAXPROCS=2"
51: Environment="NFTBAN_MAX_CONCURRENT_CONNS=100"
52: Environment="NFTBAN_REQUEST_TIMEOUT_SEC=30"
53: Environment="NFTBAN_MAX_REQUEST_BODY_MB=10"
54: Environment="NFTBAN_MAX_MEMORY_BYTES=536870912"
55: Environment="NFTBAN_MAX_MEMORY_PERCENT=20"
56: 
57: [Install]
58: WantedBy=multi-user.target
</file>

<file path="internal/config/config.go">
  1: package config
  2: 
  3: import (
  4: 	"bufio"
  5: 	"fmt"
  6: 	"os"
  7: 	"strconv"
  8: 	"strings"
  9: 
 10: 	"github.com/itcmsgr/nftban/pkg/nftbanconf"

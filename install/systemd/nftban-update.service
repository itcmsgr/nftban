# =============================================================================
# NFTBan v1.0.0 - Weekly Auto-Update Service
# =============================================================================
# SPDX-License-Identifier: MPL-2.0
# meta:name="nftban-update.service"
# meta:type="systemd"
# meta:version="1.0.0"
# meta:owner="Antonios Voulvoulis <contact@nftban.com>"
# meta:description="Service for automated NFTBan updates"
# meta:inventory.files=""
# meta:inventory.binaries="/usr/sbin/nftban"
# meta:inventory.env_vars=""
# meta:inventory.config_files="/etc/nftban/conf.d/update.conf"
# meta:inventory.systemd_units="nftban-update.timer"
# meta:inventory.network="github.com"
# meta:inventory.privileges="root"
#
# Purpose: Execute automated NFTBan updates
#
# This service is triggered by nftban-update.timer and runs the
# auto-update process. It checks configuration, downloads updates
# from GitHub, and sends email notifications on success/failure.
#
# Exit codes:
#   0 = Update applied successfully
#   1 = No update needed (already on latest version)
#   2 = Update failed (notification sent if configured)
#
# Logs: journalctl -u nftban-update.service
#       /var/log/nftban/update.log
# =============================================================================

[Unit]
Description=NFTBan Weekly Auto-Update
Documentation=man:nftban(8)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/nftban/conf.d/update.conf

[Service]
Type=oneshot

# Run the auto-update command (non-interactive mode)
ExecStart=/usr/sbin/nftban update auto-run

# Accept multiple exit codes as success:
#   0 = Update applied successfully
#   1 = No update needed / disabled in config
#   2 = Update failed (but notification was sent)
SuccessExitStatus=0 1 2

# =============================================================================
# SECURITY HARDENING
# =============================================================================

# Run as root (required for package installation)
User=root
Group=root

# Prevent privilege escalation
NoNewPrivileges=true

# Private /tmp for security
PrivateTmp=true

# =============================================================================
# LOGGING
# =============================================================================

# Send output to journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nftban-update

# =============================================================================
# RESOURCE LIMITS
# =============================================================================

# Maximum 10 minutes for update process
TimeoutStartSec=600

# Limit memory usage (update + health check)
MemoryMax=512M

# Limit CPU during update
CPUQuota=80%

[Install]
WantedBy=multi-user.target

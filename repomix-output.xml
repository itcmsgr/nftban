1397: nftban_health_check_ssh_port() {
1398:     # Check and auto-update SSH port whitelist
1399:     # Returns: 0=OK, 1=Warning (auto-fixed), 2=Error (couldn't fix)
1400: 
1401:     local status=$HEALTH_OK
1402:     local ssh_issues=()
1403: 
1404:     # Detect current SSH port from sshd_config
1405:     local current_ssh_port=22
1406:     if [[ -f "/etc/ssh/sshd_config" ]]; then
1407:         local detected_port
1408:         detected_port=$(grep -E '^\s*Port\s+[0-9]+' /etc/ssh/sshd_config 2>/dev/null | awk '{print $2}' | head -1)
1409:         if [[ -n "$detected_port" ]] && [[ "$detected_port" =~ ^[0-9]+$ ]]; then
1410:             current_ssh_port=$detected_port
1411:         fi
1412:     fi
1413: 
1414:     # Check current whitelisted SSH port in config
1415:     local config_ssh_port=""
1416:     if [[ -f "${NFTBAN_CONFIG_DIR}/ports.d/00-ssh.conf" ]]; then
1417:         config_ssh_port=$(grep -oP '^\d+' "${NFTBAN_CONFIG_DIR}/ports.d/00-ssh.conf" 2>/dev/null | head -1)
1418:     fi
1419: 
1420:     # Compare and auto-update if needed
1421:     if [[ "$current_ssh_port" != "$config_ssh_port" ]]; then
1422:         ssh_issues+=("SSH port mismatch: sshd_config=$current_ssh_port, nftban=$config_ssh_port")
1423: 
1424:         # Auto-fix: Update the SSH port config
1425:         if mkdir -p "${NFTBAN_CONFIG_DIR}/ports.d" 2>/dev/null; then
1426:             cat > "${NFTBAN_CONFIG_DIR}/ports.d/00-ssh.conf" << EOF
1427: # SSH port auto-updated by health check ($(date '+%Y-%m-%d %H:%M:%S'))
1428: # Port format: PORT|PROTO where PROTO = T(tcp), U(udp), B(both)
1429: $current_ssh_port|T
1430: EOF
1431:             chown nftban:nftban "${NFTBAN_CONFIG_DIR}/ports.d/00-ssh.conf" 2>/dev/null || true
1432:             chmod 644 "${NFTBAN_CONFIG_DIR}/ports.d/00-ssh.conf" 2>/dev/null || true
1433: 
1434:             ssh_issues+=("AUTO-FIXED: Updated SSH port to $current_ssh_port in ${NFTBAN_CONFIG_DIR}/ports.d/00-ssh.conf")
1435:             ssh_issues+=("Action required: Run 'nftban firewall reload' to apply changes")
1436: 
1437:             status=$HEALTH_WARNING  # Warning because reload needed
1438:         else

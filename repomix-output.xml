116: <h2><i class="fa fa-door-open"></i> Port Management</h2>
117: <p class="text-muted">Manage firewall port whitelist - Allow or Block ports</p>
118: 
119: <!-- HELP INFO -->
120: <div class="card" style="margin-bottom: 20px; background: var(--bg-alt); border-left: 4px solid var(--primary);">
121:     <h4 style="margin-bottom: 10px;"><i class="fa fa-circle-info"></i> How Port Control Works</h4>
122:     <p style="margin-bottom: 8px; color: var(--text-muted); font-size: 14px;">
123:         NFTBan uses a <strong>whitelist-based firewall</strong>. By default, all ports are BLOCKED.
124:     </p>
125:     <ul style="margin: 0; padding-left: 20px; color: var(--text-muted); font-size: 13px;">
126:         <li><strong>Allow Port</strong> = Add to whitelist (opens the port)</li>
127:         <li><strong>Block Port</strong> = Remove from whitelist (closes the port)</li>
128:         <li>Ports not in the whitelist are automatically blocked by default DROP policy</li>
129:     </ul>
130:     <p style="margin-top: 10px; font-size: 12px; color: var(--text-muted);">
131:         <i class="fa fa-terminal"></i> CLI: <code>nftban port add 8080</code> (allow) | <code>nftban port block 8080</code> (block)
132:     </p>
133: </div>
134: 
135: <!-- STATS -->
136: <div class="stats-row">
137:     <div class="stat-card">
138:         <i class="fa fa-list-check"></i>
139:         <div class="stat-value" id="total-ports">0</div>
140:         <div class="stat-label">Whitelisted Ports</div>
141:     </div>
142:     <div class="stat-card">
143:         <i class="fa fa-check-circle"></i>
144:         <div class="stat-value" id="open-ports">0</div>
145:         <div class="stat-label">Listening (Active)</div>
146:     </div>
147:     <div class="stat-card">
148:         <i class="fa fa-shield-halved"></i>
149:         <div class="stat-value" id="banned-ports">0</div>
150:         <div class="stat-label">Blocked in Firewall</div>
151:     </div>
152:     <div class="stat-card">
153:         <i class="fa fa-network-wired"></i>
154:         <div class="stat-value" id="listening-services">0</div>
155:         <div class="stat-label">Unique Services</div>
156:     </div>
157: </div>
158: 
159: <!-- PORT ACTIONS -->
160: <div class="card" style="margin-bottom: 20px;">
161:     <h3 style="margin-bottom: 15px;"><i class="fa fa-shield-halved"></i> Port Control</h3>
162:     <div style="display: flex; gap: 15px; flex-wrap: wrap; align-items: flex-end;">
163:         <div>
164:             <label style="display: block; font-size: 13px; margin-bottom: 5px; color: var(--text-muted);">Port Number</label>
165:             <input type="number" id="port-input" min="1" max="65535" placeholder="e.g. 8080"
166:                    style="padding: 10px 15px; border: 1px solid var(--border); border-radius: 6px; width: 120px; background: var(--bg); color: var(--text);">
167:         </div>
168:         <div>
169:             <label style="display: block; font-size: 13px; margin-bottom: 5px; color: var(--text-muted);">Protocol</label>
170:             <select id="port-protocol" style="padding: 10px 15px; border: 1px solid var(--border); border-radius: 6px; background: var(--bg); color: var(--text);">
171:                 <option value="both">TCP + UDP (Both)</option>
172:                 <option value="tcp">TCP Only</option>
173:                 <option value="udp">UDP Only</option>
174:             </select>
175:         </div>
176:         <div style="display: flex; gap: 10px;">
177:             <button onclick="addPort()" class="btn-primary" style="padding: 10px 20px;">
178:                 <i class="fa fa-plus"></i> Allow Port
179:             </button>
180:             <button onclick="blockPort()" class="btn-danger" style="padding: 10px 20px; background: #ef4444;">
181:                 <i class="fa fa-ban"></i> Block Port
182:             </button>
183:         </div>
184:     </div>
185:     <div id="port-action-msg" style="margin-top: 15px; display: none; padding: 10px; border-radius: 6px;"></div>
186: </div>
187: 
188: <!-- PORTS TABLE -->
189: <div class="card">
190:     <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
191:         <h3><i class="fa fa-list"></i> Open Ports with Controls</h3>
192:         <button onclick="loadPorts()" class="btn-primary">
193:             <i class="fa fa-rotate"></i> Refresh
194:         </button>
195:     </div>
196:     <div id="ports-list">
197:         <p class="text-center text-muted"><i class="fa fa-spinner fa-spin"></i> Loading ports...</p>
198:     </div>
199: </div>
200: 
201: <script>
202: async function loadPorts() {
203:     try {
204:         document.getElementById('ports-list').innerHTML = '<p class="text-center text-muted"><i class="fa fa-spinner fa-spin"></i> Loading ports...</p>';
205: 
206:         const response = await apiRequest('/ports');
207: 
208:         // CLI returns {timestamp, total, ports: [...]}
209:         const ports = response.ports || response.data?.ports || response.data || [];
210: 
211:         if (!ports || ports.length === 0) {
212:             document.getElementById('ports-list').innerHTML = '<p class="text-center text-muted">No open ports found</p>';
213:             updateStats([], 0);
214:             return;
215:         }
216: 
217:         displayPorts(ports);
218:         updateStats(ports, response.total || ports.length);
219:     } catch (error) {
220:         console.error('Failed to load ports:', error);
221:         document.getElementById('ports-list').innerHTML = `<p class="text-center text-danger">Failed to load ports: ${error.message}</p>`;
222:     }
223: }
224: 
225: function displayPorts(ports) {
226:     const container = document.getElementById('ports-list');
227: 
228:     // Helper to format firewall status
229:     const fwIcon = (status) => {
230:         if (status === 'Allowed' || status === '✔') return '<span style="color:#22c55e">✔</span>';
231:         if (status === 'Blocked' || status === '✖') return '<span style="color:#ef4444">✖</span>';
232:         return '<span style="color:#6b7280">−</span>';
233:     };
234: 
235:     let html = `
236:         <div style="margin-bottom:15px;">
237:             <input type="text" id="port-search" placeholder="Search ports..." onkeyup="filterPorts()"
238:                    style="padding:10px 15px; border:1px solid var(--border); border-radius:6px; width:300px; background:var(--bg); color:var(--text);">
239:         </div>
240:         <table class="ports-table">
241:             <thead>
242:                 <tr>
243:                     <th>Port/Proto</th>
244:                     <th>Service</th>
245:                     <th>Status</th>
246:                     <th>IPv4 IN</th>
247:                     <th>IPv4 OUT</th>
248:                     <th>IPv6 IN</th>
249:                     <th>IPv6 OUT</th>
250:                     <th>Actions</th>
251:                 </tr>
252:             </thead>
253:             <tbody id="ports-tbody">
254:     `;
255: 
256:     ports.forEach(port => {
257:         const portNum = port.port || port;
258:         const protocol = port.protocol || 'TCP';
259:         const service = port.service || 'Unknown';
260:         const listening = port.listening || port.status === 'Listening';
261:         const ipv4_in = port.ipv4_in || 'No-rule';
262:         const ipv4_out = port.ipv4_out || 'No-rule';
263:         const ipv6_in = port.ipv6_in || 'No-rule';
264:         const ipv6_out = port.ipv6_out || 'No-rule';
265: 
266:         const statusClass = listening ? 'status-open' : 'status-unknown';
267:         const statusIcon = listening ? 'fa-check-circle' : 'fa-circle-question';
268:         const statusText = listening ? 'Running' : 'Stopped';
269: 
270:         html += `
271:             <tr data-port="${portNum}" data-service="${service.toLowerCase()}">
272:                 <td><span class="port-number">${portNum}</span>/${protocol}</td>
273:                 <td>${service}</td>
274:                 <td>
275:                     <span class="status-badge ${statusClass}">
276:                         <i class="fa ${statusIcon}"></i> ${statusText}
277:                     </span>
278:                 </td>
279:                 <td style="text-align:center">${fwIcon(ipv4_in)}</td>
280:                 <td style="text-align:center">${fwIcon(ipv4_out)}</td>
281:                 <td style="text-align:center">${fwIcon(ipv6_in)}</td>
282:                 <td style="text-align:center">${fwIcon(ipv6_out)}</td>
283:                 <td>
284:                     <div class="port-actions">
285:                         <select id="action-${portNum}-${protocol}" class="action-dropdown">
286:                             <option value="">Action</option>
287:                             <option value="ban">Block</option>
288:                             <option value="unban">Unblock</option>
289:                         </select>
290:                         <button onclick="executePortAction('${portNum}', '${protocol}')" class="btn-sm btn-primary btn-execute">
291:                             <i class="fa fa-play"></i>
292:                         </button>
293:                     </div>
294:                 </td>
295:             </tr>
296:         `;
297:     });
298: 
299:     html += `
300:             </tbody>
301:         </table>
302:     `;
303: 
304:     container.innerHTML = html;
305: }
306: 
307: function filterPorts() {
308:     const search = document.getElementById('port-search').value.toLowerCase();
309:     const rows = document.querySelectorAll('#ports-tbody tr');
310:     rows.forEach(row => {
311:         const port = row.getAttribute('data-port') || '';
312:         const service = row.getAttribute('data-service') || '';
313:         row.style.display = (port.includes(search) || service.includes(search)) ? '' : 'none';
314:     });
315: }
316: 
317: function updateStats(ports, total) {
318:     if (Array.isArray(ports)) {
319:         const totalPorts = total || ports.length;
320:         const listeningPorts = ports.filter(p => p.listening || p.status === 'Listening').length;
321:         const blockedPorts = ports.filter(p => p.ipv4_in === 'Blocked' || p.ipv6_in === 'Blocked').length;
322:         const services = new Set(ports.map(p => p.service).filter(s => s && s !== 'UNKNOWN')).size;
323: 
324:         document.getElementById('total-ports').textContent = totalPorts;
325:         document.getElementById('open-ports').textContent = listeningPorts;
326:         document.getElementById('banned-ports').textContent = blockedPorts;
327:         document.getElementById('listening-services').textContent = services;
328:     } else {
329:         document.getElementById('total-ports').textContent = 0;
330:         document.getElementById('open-ports').textContent = 0;
331:         document.getElementById('banned-ports').textContent = 0;
332:         document.getElementById('listening-services').textContent = 0;
333:     }
334: }
335: 
336: async function executePortAction(port, protocol) {
337:     const selectEl = document.getElementById(`action-${port}-${protocol}`);
338:     const action = selectEl.value;
339: 
340:     if (!action) {
341:         console.log('[warning]', 'Please select an action');
342:         return;
343:     }
344: 
345:     try {
346:         if (action === 'status') {
347:             await checkPortStatus(port, protocol);
348:         } else if (action === 'ban') {
349:             await banPort(port, protocol);
350:         } else if (action === 'unban') {
351:             await unbanPort(port, protocol);
352:         }
353: 
354:         // Reset dropdown
355:         selectEl.value = '';
356:     } catch (error) {
357:         console.log('[error]', 'Action failed: ' + error.message);
358:     }
359: }
360: 
361: async function banPort(port, protocol) {
362:     if (!confirm(`Ban port ${port}/${protocol}?`)) return;
363: 
364:     try {
365:         const response = await apiRequest('/ports/ban', {
366:             method: 'POST',
367:             body: JSON.stringify({ port: parseInt(port), protocol: protocol.toLowerCase() })
368:         });
369: 
370:         if (response.success) {
371:             console.log('[success]', `Port ${port}/${protocol} banned successfully`);
372:             setTimeout(loadPorts, 1000);
373:         } else {
374:             console.log('[error]', response.error || 'Failed to ban port');
375:         }
376:     } catch (error) {
377:         console.log('[error]', 'Error: ' + error.message);
378:     }
379: }
380: 
381: async function unbanPort(port, protocol) {
382:     if (!confirm(`Unban port ${port}/${protocol}?`)) return;
383: 
384:     try {
385:         const response = await apiRequest('/ports/unban', {
386:             method: 'POST',
387:             body: JSON.stringify({ port: parseInt(port), protocol: protocol.toLowerCase() })
388:         });
389: 
390:         if (response.success) {
391:             console.log('[success]', `Port ${port}/${protocol} unbanned successfully`);
392:             setTimeout(loadPorts, 1000);
393:         } else {
394:             console.log('[error]', response.error || 'Failed to unban port');
395:         }
396:     } catch (error) {
397:         console.log('[error]', 'Error: ' + error.message);
398:     }
399: }
400: 
401: async function checkPortStatus(port, protocol) {
402:     try {
403:         const response = await apiRequest(`/ports/status?port=${port}&protocol=${protocol}`);
404: 
405:         if (response.success && response.data) {
406:             const status = response.data.status || 'unknown';
407:             const message = `Port ${port}/${protocol}: ${status}`;
408:             console.log('[info]', message);
409:         } else {
410:             console.log('[error]', 'Failed to check status');
411:         }
412:     } catch (error) {
413:         console.log('[error]', 'Error: ' + error.message);
414:     }
415: }
416: 
417: // Add port (allow/unblock)
418: async function addPort() {
419:     const port = document.getElementById('port-input').value;
420:     const protocol = document.getElementById('port-protocol').value;
421:     const msgEl = document.getElementById('port-action-msg');
422: 
423:     if (!port || port < 1 || port > 65535) {
424:         msgEl.style.display = 'block';
425:         msgEl.style.background = '#fef2f2';
426:         msgEl.style.color = '#dc2626';
427:         msgEl.textContent = 'Please enter a valid port number (1-65535)';
428:         return;
429:     }
430: 
431:     try {
432:         const response = await apiRequest('/ports/unban', {
433:             method: 'POST',
434:             body: JSON.stringify({ port: parseInt(port), protocol: protocol })
435:         });
436: 
437:         msgEl.style.display = 'block';
438:         if (response.success) {
439:             msgEl.style.background = '#f0fdf4';
440:             msgEl.style.color = '#16a34a';
441:             msgEl.textContent = `Port ${port} (${protocol.toUpperCase()}) allowed successfully`;
442:             document.getElementById('port-input').value = '';
443:             setTimeout(loadPorts, 1000);
444:         } else {
445:             msgEl.style.background = '#fef2f2';
446:             msgEl.style.color = '#dc2626';
447:             msgEl.textContent = response.error || 'Failed to allow port';
448:         }
449:     } catch (error) {
450:         msgEl.style.display = 'block';
451:         msgEl.style.background = '#fef2f2';
452:         msgEl.style.color = '#dc2626';
453:         msgEl.textContent = 'Error: ' + error.message;
454:     }
455: }
456: 
457: // Block port (ban)
458: async function blockPort() {
459:     const port = document.getElementById('port-input').value;
460:     const protocol = document.getElementById('port-protocol').value;
461:     const msgEl = document.getElementById('port-action-msg');
462: 
463:     if (!port || port < 1 || port > 65535) {
464:         msgEl.style.display = 'block';
465:         msgEl.style.background = '#fef2f2';
466:         msgEl.style.color = '#dc2626';
467:         msgEl.textContent = 'Please enter a valid port number (1-65535)';
468:         return;
469:     }
470: 
471:     if (!confirm(`Block port ${port} (${protocol.toUpperCase()})? This will prevent connections to this port.`)) {
472:         return;
473:     }
474: 
475:     try {
476:         const response = await apiRequest('/ports/ban', {
477:             method: 'POST',
478:             body: JSON.stringify({ port: parseInt(port), protocol: protocol })
479:         });
480: 
481:         msgEl.style.display = 'block';
482:         if (response.success) {
483:             msgEl.style.background = '#fef2f2';
484:             msgEl.style.color = '#dc2626';
485:             msgEl.textContent = `Port ${port} (${protocol.toUpperCase()}) blocked successfully`;
486:             document.getElementById('port-input').value = '';
487:             setTimeout(loadPorts, 1000);
488:         } else {
489:             msgEl.style.background = '#fef2f2';
490:             msgEl.style.color = '#dc2626';
491:             msgEl.textContent = response.error || 'Failed to block port';
492:         }
493:     } catch (error) {
494:         msgEl.style.display = 'block';
495:         msgEl.style.background = '#fef2f2';
496:         msgEl.style.color = '#dc2626';
497:         msgEl.textContent = 'Error: ' + error.message;
498:     }
499: }
500: 
501: // Initialize
502: loadPorts();
503: 
504: // Auto-refresh every 30 seconds
505: setInterval(loadPorts, 30000);
506: </script>
</file>


1931: nftban_health_check_cli_errors() {
1932:     # Check CLI error log for recent errors
1933:     # Returns: 0=OK, 1=Warnings, 2=Errors
1934: 
1935:     local status=$HEALTH_OK
1936:     local -a cli_issues=()
1937: 
1938:     local cli_error_log="${NFTBAN_LOG_DIR}/cli-errors.log"
1939: 
1940:     # Check if log file exists
1941:     if [[ ! -f "$cli_error_log" ]]; then
1942:         cli_issues+=("✓ No CLI errors logged (log file doesn't exist)")
1943:         NFTBAN_HEALTH_RESULTS["cli_errors"]=$status
1944:         NFTBAN_HEALTH_ISSUES["cli_errors"]="${cli_issues[*]}"
1945:         return $status
1946:     fi
1947: 
1948:     # Check file size
1949:     local log_size
1950:     log_size=$(stat -f%z "$cli_error_log" 2>/dev/null || stat -c%s "$cli_error_log" 2>/dev/null || echo 0)
1951: 
1952:     if [[ $log_size -eq 0 ]]; then
1953:         cli_issues+=("✓ No CLI errors logged (empty log)")
1954:         NFTBAN_HEALTH_RESULTS["cli_errors"]=$status
1955:         NFTBAN_HEALTH_ISSUES["cli_errors"]="${cli_issues[*]}"
1956:         return $status
1957:     fi
1958: 
1959:     # Check for recent errors (last 24 hours)
1960:     local recent_errors=0
1961:     local cutoff_time
1962:     cutoff_time=$(date -d "24 hours ago" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || date -v-24H '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo "")
1963: 
1964:     if [[ -n "$cutoff_time" ]]; then
1965:         # Count errors in last 24 hours
1966:         while IFS= read -r line; do
1967:             if [[ "$line" =~ ERROR:\ ([0-9]{4}-[0-9]{2}-[0-9]{2}\ [0-9]{2}:[0-9]{2}:[0-9]{2}) ]]; then
1968:                 local error_time="${BASH_REMATCH[1]}"
1969:                 if [[ "$error_time" > "$cutoff_time" ]]; then
1970:                     ((recent_errors++)) || true
1971:                 fi
1972:             fi
1973:         done < "$cli_error_log"
1974:     else
1975:         # Fallback: count all ERROR lines
1976:         recent_errors=$(grep -c "^ERROR:" "$cli_error_log" 2>/dev/null || echo 0)
1977:     fi
1978: 
1979:     # Evaluate error count
1980:     if [[ $recent_errors -eq 0 ]]; then
1981:         cli_issues+=("✓ No recent CLI errors")
1982:     elif [[ $recent_errors -lt 5 ]]; then
1983:         cli_issues+=("Found $recent_errors CLI error(s) in last 24 hours")
1984:         status=$HEALTH_WARNING
1985:     elif [[ $recent_errors -lt 20 ]]; then
1986:         cli_issues+=("Found $recent_errors CLI errors in last 24 hours - investigate")
1987:         status=$HEALTH_ERROR
1988:     else
1989:         cli_issues+=("CRITICAL: $recent_errors CLI errors in last 24 hours")
1990:         status=$HEALTH_CRITICAL
1991:     fi
1992: 
1993:     # Check log size (warn if > 10MB)
1994:     local log_size_mb
1995:     log_size_mb=$((log_size / 1024 / 1024))
1996:     if [[ $log_size_mb -gt 10 ]]; then
1997:         cli_issues+=("CLI error log is ${log_size_mb}MB - consider rotation")
1998:         [[ $status -lt $HEALTH_WARNING ]] && status=$HEALTH_WARNING
1999:     fi
2000: 
2001:     # Store results
2002:     NFTBAN_HEALTH_RESULTS["cli_errors"]=$status
2003:     NFTBAN_HEALTH_ISSUES["cli_errors"]="${cli_issues[*]}"
2004: 
2005:     return $status
2006: }

[Unit]
Description=NFTBan Firewall Snapshot (save current state)
Documentation=man:nftban(8)
After=nftban-firewall-init.service

[Service]
Type=oneshot

# Run as nftban user (has write access to /var/lib/nftban)
User=nftban
Group=nftban

# Save current firewall state to snapshot
ExecStart=/usr/sbin/nftban stats snapshot

# Nice priority (low impact)
Nice=10
IOSchedulingClass=best-effort

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/nftban /var/log/nftban /run/nftban

[Install]
WantedBy=multi-user.target

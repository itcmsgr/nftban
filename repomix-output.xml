246:     return 0
247: }
248: 
249: # Test 4: Textfile collector
250: test_textfile_collector() {
251:     test_header "Textfile Collector"
252: 
253:     # Check directory exists
254:     if [[ -d "$TEXTFILE_COLLECTOR_DIR" ]]; then
255:         test_result "PASS" "Textfile collector directory exists"
256:     else
257:         test_result "FAIL" "Textfile collector directory missing: $TEXTFILE_COLLECTOR_DIR"
258:         return 1
259:     fi
260: 
261:     # Check directory permissions
262:     local perms
263:     perms=$(stat -c "%a" "$TEXTFILE_COLLECTOR_DIR" 2>/dev/null || stat -f "%OLp" "$TEXTFILE_COLLECTOR_DIR" 2>/dev/null)
264:     if [[ "$perms" == "750" ]]; then
265:         test_result "PASS" "Directory permissions correct: $perms"
266:     else
267:         test_result "WARN" "Directory permissions: $perms (expected 750)"
268:     fi
269: 
270:     # Check directory ownership
271:     local owner
272:     owner=$(stat -c "%U:%G" "$TEXTFILE_COLLECTOR_DIR" 2>/dev/null || stat -f "%Su:%Sg" "$TEXTFILE_COLLECTOR_DIR" 2>/dev/null)
273:     if [[ "$owner" == "nftban:nftban" ]]; then
274:         test_result "PASS" "Directory ownership correct: $owner"
275:     else
276:         test_result "WARN" "Directory ownership: $owner (expected nftban:nftban)"
277:     fi
278: 
279:     # Check textfile collector is enabled in metrics
280:     if curl -s "http://localhost:${NODE_EXPORTER_PORT}/metrics" | grep -q "node_textfile_scrape_error"; then
281:         test_result "PASS" "Textfile collector is enabled"
282:     else
283:         test_result "FAIL" "Textfile collector is not enabled"
284:         echo "Add --collector.textfile.directory to Node Exporter service"
285:         return 1
286:     fi
287: 
288:     # Check for scrape errors
289:     local scrape_error
290:     scrape_error=$(curl -s "http://localhost:${NODE_EXPORTER_PORT}/metrics" | grep "^node_textfile_scrape_error" | awk '{print $2}')
291:     if [[ "$scrape_error" == "0" ]]; then
292:         test_result "PASS" "No textfile collector errors"
293:     else
294:         test_result "FAIL" "Textfile collector has errors (value: $scrape_error)"
295:         return 1
296:     fi
297: 
298:     return 0
299: }
300: 
301: # Test 5: NFTBan metrics
302: test_nftban_metrics() {
303:     test_header "NFTBan Metrics Integration"
304: 
305:     # Check if nftban.prom file exists
306:     if [[ -f "$NFTBAN_METRICS_FILE" ]]; then
307:         test_result "PASS" "NFTBan metrics file exists"
308:     else
309:         test_result "WARN" "NFTBan metrics file not found: $NFTBAN_METRICS_FILE"
310:         echo "Run: systemctl start nftban-metrics-exporter.service"
311:         return 1
312:     fi
313: 
314:     # Check file age
315:     local file_age
316:     file_age=$(( $(date +%s) - $(stat -c %Y "$NFTBAN_METRICS_FILE" 2>/dev/null || stat -f %m "$NFTBAN_METRICS_FILE" 2>/dev/null) ))
317:     if [[ $file_age -lt 300 ]]; then
318:         test_result "PASS" "Metrics file is recent (${file_age}s ago)"
319:     else
320:         test_result "WARN" "Metrics file is old (${file_age}s ago)"
321:         echo "Check: systemctl status nftban-metrics-exporter.timer"
322:     fi
323: 
324:     # Check for nftban metrics in endpoint
325:     local nftban_metrics
326:     nftban_metrics=$(curl -s "http://localhost:${NODE_EXPORTER_PORT}/metrics" | grep -c "^nftban_" || true)
327: 
328:     if [[ $nftban_metrics -gt 0 ]]; then
329:         test_result "PASS" "NFTBan metrics found in endpoint ($nftban_metrics metrics)"
330:     else
331:         test_result "FAIL" "No NFTBan metrics in endpoint"
332:         return 1
333:     fi
334: 
335:     # Check for specific expected metrics
336:     local metrics_to_check=(
337:         "nftban_blocks_total"
338:         "nftban_health_status"
339:         "nftban_exporter_duration_seconds"
340:         "nftban_last_update_timestamp"
341:     )
342: 
343:     local metrics_output
344:     metrics_output=$(curl -s "http://localhost:${NODE_EXPORTER_PORT}/metrics")
345: 
346:     for metric in "${metrics_to_check[@]}"; do
347:         if echo "$metrics_output" | grep -q "^${metric}"; then
348:             test_result "PASS" "Metric present: $metric"
349:         else
350:             test_result "WARN" "Metric missing: $metric"
351:         fi
352:     done
353: 
354:     return 0
355: }
356: 
357: # Test 6: Security configuration
358: test_security() {
359:     test_header "Security Configuration"
360: 
361:     # Check systemd security directives
362:     local service_name=""
363:     if systemctl list-unit-files | grep -q "^node_exporter.service"; then
364:         service_name="node_exporter.service"
365:     elif systemctl list-unit-files | grep -q "^prometheus-node-exporter.service"; then
366:         service_name="prometheus-node-exporter.service"
367:     fi
368: 
369:     if [[ -n "$service_name" ]]; then
370:         # Check for security directives
371:         if systemctl cat "$service_name" | grep -q "PrivateTmp=yes"; then
372:             test_result "PASS" "PrivateTmp enabled"
373:         else
374:             test_result "WARN" "PrivateTmp not enabled"
375:         fi
376: 
377:         if systemctl cat "$service_name" | grep -q "ProtectSystem"; then
378:             test_result "PASS" "ProtectSystem enabled"
379:         else
380:             test_result "WARN" "ProtectSystem not enabled"
381:         fi
382: 
383:         if systemctl cat "$service_name" | grep -q "NoNewPrivileges=yes"; then
384:             test_result "PASS" "NoNewPrivileges enabled"
385:         else
386:             test_result "WARN" "NoNewPrivileges not enabled"
387:         fi
388:     fi
389: 
390:     # Check if running as root (bad)
391:     local pid
392:     pid=$(systemctl show "$service_name" -p MainPID --value)
393:     if [[ -n "$pid" && "$pid" != "0" ]]; then
394:         local user
395:         user=$(ps -o user= -p "$pid" 2>/dev/null || true)
396:         if [[ "$user" != "root" ]]; then
397:             test_result "PASS" "Running as non-root user: $user"
398:         else
399:             test_result "FAIL" "Running as root (security risk!)"
400:         fi
401:     fi
402: 
403:     # Check firewall (if firewalld or nftables)
404:     if command -v firewall-cmd &>/dev/null && systemctl is-active --quiet firewalld; then
405:         if firewall-cmd --list-ports 2>/dev/null | grep -q "${NODE_EXPORTER_PORT}/tcp"; then
406:             test_result "WARN" "Port ${NODE_EXPORTER_PORT} is open in firewall (may be exposed)"
407:         else
408:             test_result "PASS" "Port ${NODE_EXPORTER_PORT} not exposed in firewall"
409:         fi
410:     fi
411: 
412:     return 0
413: }
414: 
415: # Print summary
416: print_summary() {
417:     echo ""
418:     print_color "$BLUE" "═══════════════════════════════════════════════════════════════"
419:     print_color "$BLUE" " Validation Summary"
420:     print_color "$BLUE" "═══════════════════════════════════════════════════════════════"
421:     echo ""
422: 
423:     print_color "$GREEN" "Passed:   $PASSED_TESTS/$TOTAL_TESTS tests"
424:     print_color "$RED" "Failed:   $FAILED_TESTS/$TOTAL_TESTS tests"
425:     print_color "$YELLOW" "Warnings: $WARNING_TESTS/$TOTAL_TESTS tests"
426: 
427:     echo ""
428: 
429:     if [[ $FAILED_TESTS -eq 0 ]]; then
430:         print_color "$GREEN" "✓ Node Exporter validation PASSED"
431: 
432:         if [[ $WARNING_TESTS -gt 0 ]]; then
433:             print_color "$YELLOW" "⚠ Review warnings above for optimization opportunities"
434:         fi
435: 
436:         echo ""
437:         print_color "$BLUE" "═══════════════════════════════════════════════════════════════"
438:         echo "Next steps:"
439:         echo "1. Configure Prometheus to scrape metrics"
440:         echo "2. Create Grafana dashboards"
441:         echo "3. Set up alerting rules"
442:         echo ""
443:         print_color "$BLUE" "Metrics endpoint: http://localhost:${NODE_EXPORTER_PORT}/metrics"
444:         print_color "$BLUE" "═══════════════════════════════════════════════════════════════"
445: 
446:         return 0
447:     else
448:         print_color "$RED" "✗ Node Exporter validation FAILED"
449:         echo ""
450:         echo "Review failed tests above and fix issues before continuing."
451:         echo ""
452:         print_color "$BLUE" "═══════════════════════════════════════════════════════════════"
453: 
454:         return 1
455:     fi
456: }
457: 
458: # =============================================================================
459: # MAIN
460: # =============================================================================
461: 
462: main() {
463:     local verbose=false
464:     local skip_nftban=false
465: 
466:     # Parse arguments
467:     while [[ $# -gt 0 ]]; do
468:         case "$1" in
469:             --verbose)
470:                 verbose=true
471:                 shift
472:                 ;;
473:             --skip-nftban-metrics)
474:                 skip_nftban=true
475:                 shift
476:                 ;;
477:             --help)
478:                 usage
479:                 exit 0
480:                 ;;
481:             *)
482:                 echo "Unknown option: $1"
483:                 usage
484:                 exit 1
485:                 ;;
486:         esac
487:     done
488: 
489:     print_color "$BLUE" "═══════════════════════════════════════════════════════════════"
490:     print_color "$BLUE" " NFTBan Node Exporter Validation"
491:     print_color "$BLUE" "═══════════════════════════════════════════════════════════════"
492: 
493:     # Run tests
494:     test_service_status || true
495:     test_network_binding || true
496:     test_metrics_endpoint || true
497:     test_textfile_collector || true
498: 
499:     if [[ "$skip_nftban" != "true" ]]; then
500:         test_nftban_metrics || true
501:     fi
502: 
503:     test_security || true
504: 
505:     # Print summary
506:     print_summary
507: }
508: 
509: # Run main function
510: main "$@"

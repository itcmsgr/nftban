<file path="pkg/analytics/prometheus.go">
 1: // SPDX-License-Identifier: GPL-3.0-or-later
 2: // Copyright (c) 2025 Antonios Voulvoulis <contact@nftban.com>
 3: 
 4: package analytics
 5: 
 6: import (
 7: 	"time"
 8: 
 9: 	"github.com/prometheus/client_golang/prometheus"
10: )
11: 
12: var (
13: 	bansTotal = prometheus.NewCounterVec(
14: 		prometheus.CounterOpts{
15: 			Namespace: "nftban",
16: 			Subsystem: "analytics",
17: 			Name:      "bans_total",
18: 			Help:      "Total number of IP bans, labeled by country and source.",
19: 		},
20: 		[]string{"country", "source"},
21: 	)
22: 
23: 	persistentOffendersTotal = prometheus.NewCounterVec(
24: 		prometheus.CounterOpts{
25: 			Namespace: "nftban",
26: 			Subsystem: "analytics",
27: 			Name:      "persistent_offenders_total",
28: 			Help:      "Total number of IPs escalated to persistent/permanent bans, labeled by country and source.",
29: 		},
30: 		[]string{"country", "source"},
31: 	)
32: 
33: 	uniqueIPsByCountry = prometheus.NewGaugeVec(
34: 		prometheus.GaugeOpts{
35: 			Namespace: "nftban",
36: 			Subsystem: "analytics",
37: 			Name:      "unique_ips_by_country",
38: 			Help:      "Number of unique banned IPs per country.",
39: 		},
40: 		[]string{"country"},
41: 	)
42: )
43: 
44: // RegisterPrometheus registers nftban analytics metrics with Prometheus.
45: // Call once from main after prometheus client init.
46: func RegisterPrometheus(registry *prometheus.Registry) {
47: 	if registry == nil {
48: 		prometheus.MustRegister(bansTotal, persistentOffendersTotal, uniqueIPsByCountry)
49: 		return
50: 	}
51: 	registry.MustRegister(bansTotal, persistentOffendersTotal, uniqueIPsByCountry)
52: }
53: 
54: // RecordBanWithMetrics combines analytics + Prometheus for a ban.
55: func (s *State) RecordBanWithMetrics(ip, country, city, source, reason string, t time.Time) {
56: 	s.RecordBan(ip, country, city, source, reason, t)
57: 
58: 	if country == "" {
59: 		country = "UNK"
60: 	}
61: 	if source == "" {
62: 		source = "unknown"
63: 	}
64: 
65: 	bansTotal.WithLabelValues(country, source).Inc()
66: 
67: 	// Update gauge for unique IPs per country
68: 	if cs := s.countries[country]; cs != nil {
69: 		uniqueIPsByCountry.WithLabelValues(country).Set(float64(cs.IPCount))
70: 	}
71: }
72: 
73: // RecordPersistentOffender increments the persistent offenders counter.
74: func (s *State) RecordPersistentOffender(ip, country, source string, t time.Time) {
75: 	if country == "" {
76: 		country = "UNK"
77: 	}
78: 	if source == "" {
79: 		source = "unknown"
80: 	}
81: 	persistentOffendersTotal.WithLabelValues(country, source).Inc()
82: }
83: 
84: // UpdatePrometheusGauges updates all gauge metrics from current state.
85: // Call periodically (e.g., every 30s) to keep gauges in sync.
86: func (s *State) UpdatePrometheusGauges() {
87: 	if s == nil {
88: 		return
89: 	}
90: 
91: 	s.mu.RLock()
92: 	defer s.mu.RUnlock()
93: 
94: 	for country, cs := range s.countries {
95: 		uniqueIPsByCountry.WithLabelValues(country).Set(float64(cs.IPCount))
96: 	}
97: }
</file>

<file path="pkg/analytics/state.go">
  1: // SPDX-License-Identifier: GPL-3.0-or-later
  2: // Copyright (c) 2025 Antonios Voulvoulis <contact@nftban.com>
  3: 
  4: package analytics
  5: 
  6: import (
  7: 	"encoding/json"
  8: 	"errors"
  9: 	"os"
 10: 	"path/filepath"
 11: 	"sort"
 12: 	"strings"
 13: 	"sync"
 14: 	"time"
 15: )
 16: 
 17: type State struct {
 18: 	mu sync.RWMutex
 19: 
 20: 	countries map[string]*CountryStats
 21: 	ipOrigins map[string]*IPOrigin
 22: 
 23: 	analyticsDir string // /var/lib/nftban/analytics
 24: 	reportsDir   string // /var/lib/nftban/reports
 25: }
 26: 
 27: var (
 28: 	defaultState     *State
 29: 	defaultStateLock sync.Mutex
 30: )
 31: 
 32: // Init creates directories and loads existing state if present.
 33: // Call once from your main init/bootstrap code.
 34: func Init(libPath string, reportsPath string) error {
 35: 	defaultStateLock.Lock()
 36: 	defer defaultStateLock.Unlock()
 37: 
 38: 	if libPath == "" {
 39: 		return errors.New("analytics: libPath is empty")
 40: 	}
 41: 	if reportsPath == "" {
 42: 		return errors.New("analytics: reportsPath is empty")
 43: 	}
 44: 
 45: 	analyticsDir := filepath.Join(libPath, "analytics")
 46: 
 47: 	if err := os.MkdirAll(analyticsDir, 0o755); err != nil {
 48: 		return err
 49: 	}
 50: 	if err := os.MkdirAll(reportsPath, 0o755); err != nil {
 51: 		return err
 52: 	}
 53: 
 54: 	st := &State{
 55: 		countries:    make(map[string]*CountryStats),
 56: 		ipOrigins:    make(map[string]*IPOrigin),
 57: 		analyticsDir: analyticsDir,
 58: 		reportsDir:   reportsPath,
 59: 	}
 60: 
 61: 	if err := st.loadIfExists(); err != nil {
 62: 		return err
 63: 	}
 64: 
 65: 	defaultState = st
 66: 	return nil
 67: }
 68: 
 69: // StateOrNil returns the global state (if Init succeeded).
 70: func StateOrNil() *State {
 71: 	defaultStateLock.Lock()
 72: 	defer defaultStateLock.Unlock()
 73: 	return defaultState
 74: }
 75: 
 76: // loadIfExists loads country-bans.json and ip-origins.json if they exist.
 77: func (s *State) loadIfExists() error {
 78: 	s.mu.Lock()
 79: 	defer s.mu.Unlock()
 80: 
 81: 	countryPath := filepath.Join(s.analyticsDir, "country-bans.json")
 82: 	ipPath := filepath.Join(s.analyticsDir, "ip-origins.json")
 83: 
 84: 	// Countries
 85: 	if data, err := os.ReadFile(countryPath); err == nil {
 86: 		var m map[string]*CountryStats
 87: 		if err := json.Unmarshal(data, &m); err != nil {
 88: 			return err
 89: 		}
 90: 		s.countries = m
 91: 	}
 92: 
 93: 	// IP origins
 94: 	if data, err := os.ReadFile(ipPath); err == nil {
 95: 		var m map[string]*IPOrigin
 96: 		if err := json.Unmarshal(data, &m); err != nil {
 97: 			return err
 98: 		}
 99: 		s.ipOrigins = m
100: 	}
101: 
102: 	return nil
103: }
104: 
105: // RecordBan updates in-memory stats (call this for each ban).
106: // Parameters:
107: //   ip       - IP address being banned
108: //   country  - Country code (GeoIP)
109: //   city     - City name (GeoIP)
110: //   source   - Ban source: "suricata", "login-monitor", "manual", "feeds", or legacy jail name
111: //   reason   - Ban reason/description
112: //   t        - Timestamp
113: func (s *State) RecordBan(ip, country, city, source, reason string, t time.Time) {
114: 	if s == nil {
115: 		return
116: 	}
117: 	if country == "" {
118: 		country = "UNK"
119: 	}
120: 
121: 	s.mu.Lock()
122: 	defer s.mu.Unlock()
123: 
124: 	// Per-country stats
125: 	cs := s.countries[country]
126: 	if cs == nil {
127: 		cs = &CountryStats{
128: 			Country: country,
129: 			IPs:     []string{},
130: 		}
131: 		s.countries[country] = cs
132: 	}
133: 	if !containsString(cs.IPs, ip) {
134: 		cs.IPs = append(cs.IPs, ip)
135: 		cs.IPCount = len(cs.IPs)
136: 	}
137: 	cs.LastUpdated = t
138: 
139: 	// Parse source to determine service (dynamic from reason/source)
140: 	// Examples: "ssh_brute_force" -> service="ssh", "malware_c2" -> service="malware"
141: 	service := extractServiceFromReason(reason, source)
142: 
143: 	// Per-IP origin
144: 	s.ipOrigins[ip] = &IPOrigin{
145: 		IP:       ip,
146: 		Country:  country,
147: 		City:     city,
148: 		BannedAt: t,
149: 		Jail:     source,   // Legacy compatibility
150: 		Source:   source,   // New: suricata, login-monitor, manual, feeds
151: 		Service:  service,  // New: Dynamic service extracted from reason
152: 		Reason:   reason,
153: 		Duration: 0,        // TODO: Add duration parameter if needed
154: 	}
155: }
156: 
157: // extractServiceFromReason extracts service name from ban reason dynamically.
158: // Parses the reason string to identify the service/filter that triggered the ban.
159: //
160: // Logic:
161: //   1. If reason contains "_" (e.g., "ssh_brute_force"), extract first part
162: //   2. If reason contains keywords, match against them
163: //   3. Fallback to source-based classification
164: //
165: // Examples:
166: //   "ssh_brute_force" -> "ssh"
167: //   "wordpress_attack" -> "wordpress"
168: //   "malware_c2" -> "malware"
169: //   "ET MALWARE Zeus" -> "malware"
170: //   "suricata:scan" -> "scan"
171: func extractServiceFromReason(reason, source string) string {
172: 	if reason == "" {
173: 		return extractServiceFromSource(source)
174: 	}
175: 
176: 	reasonLower := strings.ToLower(reason)
177: 
178: 	// Pattern 1: service_action format (e.g., "ssh_brute_force")
179: 	if strings.Contains(reasonLower, "_") {
180: 		parts := strings.SplitN(reasonLower, "_", 2)
181: 		if len(parts) > 0 && parts[0] != "" {
182: 			return parts[0]
183: 		}
184: 	}
185: 
186: 	// Pattern 2: source:service format (e.g., "suricata:malware")
187: 	if strings.Contains(reasonLower, ":") {
188: 		parts := strings.SplitN(reasonLower, ":", 2)
189: 		if len(parts) > 1 && parts[1] != "" {
190: 			return parts[1]
191: 		}
192: 	}
193: 
194: 	// Pattern 3: Keyword matching (works with ET rules, descriptions, etc.)
195: 	// Common keywords from Suricata signatures and filter names
196: 	keywords := []string{
197: 		"malware", "trojan", "botnet", "c2", "c&c",
198: 		"ssh", "http", "https", "web",
199: 		"wordpress", "wp-", "xmlrpc",
200: 		"mail", "smtp", "imap", "pop3",
201: 		"dns", "scan", "probe", "nmap",
202: 		"exploit", "cve", "shellcode",
203: 		"ddos", "flood", "amplification",
204: 		"brute", "bruteforce", "auth",
205: 		"sql", "xss", "rfi", "lfi",
206: 		"ftp", "rdp", "mysql", "postgresql",
207: 		"phpmyadmin", "joomla", "drupal",
208: 		"smb", "cifs", "ldap", "voip",
209: 	}
210: 
211: 	for _, keyword := range keywords {
212: 		if strings.Contains(reasonLower, keyword) {
213: 			return keyword
214: 		}
215: 	}
216: 
217: 	// Fallback to source-based classification
218: 	return extractServiceFromSource(source)
219: }
220: 
221: // extractServiceFromSource returns a service based on the ban source.
222: func extractServiceFromSource(source string) string {
223: 	switch source {
224: 	case "suricata":
225: 		return "ids"
226: 	case "login-monitor":
227: 		return "auth"
228: 	case "feeds":
229: 		return "reputation"
230: 	case "manual":
231: 		return "manual"
232: 	default:
233: 		// Legacy fail2ban jail names
234: 		return source
235: 	}
236: }
237: 
238: // Save flushes analytics state to JSON files on disk.
239: func (s *State) Save() error {
240: 	if s == nil {
241: 		return nil
242: 	}
243: 
244: 	s.mu.RLock()
245: 	defer s.mu.RUnlock()
246: 
247: 	if err := writeJSONAtomic(filepath.Join(s.analyticsDir, "country-bans.json"), s.countries); err != nil {
248: 		return err
249: 	}
250: 	if err := writeJSONAtomic(filepath.Join(s.analyticsDir, "ip-origins.json"), s.ipOrigins); err != nil {
251: 		return err
252: 	}
253: 	return nil
254: }
255: 
256: // SnapshotDaily writes a daily country snapshot into reports dir.
257: // Typically called once per day (via cron or internal scheduler).
258: func (s *State) SnapshotDaily(t time.Time) error {
259: 	if s == nil {
260: 		return nil
261: 	}
262: 
263: 	s.mu.RLock()
264: 	defer s.mu.RUnlock()
265: 
266: 	date := t.Format("2006-01-02")
267: 	path := filepath.Join(s.reportsDir, date+"-country-stats.json")
268: 	return writeJSONAtomic(path, s.countries)
269: }
270: 
271: // GetCountryStats returns a shallow copy of the map for read-only usage.
272: func (s *State) GetCountryStats() map[string]*CountryStats {
273: 	if s == nil {
274: 		return nil
275: 	}
276: 
277: 	s.mu.RLock()
278: 	defer s.mu.RUnlock()
279: 
280: 	out := make(map[string]*CountryStats, len(s.countries))
281: 	for k, v := range s.countries {
282: 		// shallow copy
283: 		cpy := *v
284: 		out[k] = &cpy
285: 	}
286: 	return out
287: }
288: 
289: // GetIPOrigin returns origin info for an IP, if known.
290: func (s *State) GetIPOrigin(ip string) (*IPOrigin, bool) {
291: 	if s == nil {
292: 		return nil, false
293: 	}
294: 
295: 	s.mu.RLock()
296: 	defer s.mu.RUnlock()
297: 
298: 	o, ok := s.ipOrigins[ip]
299: 	if !ok {
300: 		return nil, false
301: 	}
302: 	// copy to avoid external mutation
303: 	cpy := *o
304: 	return &cpy, true
305: }
306: 
307: // GetTopCountries returns top N countries by IP count.
308: func (s *State) GetTopCountries(n int) []CountryStats {
309: 	if s == nil {
310: 		return nil
311: 	}
312: 
313: 	s.mu.RLock()
314: 	defer s.mu.RUnlock()
315: 
316: 	var list []CountryStats
317: 	for _, cs := range s.countries {
318: 		list = append(list, *cs)
319: 	}
320: 
321: 	// Sort by IP count descending
322: 	sort.Slice(list, func(i, j int) bool {
323: 		return list[i].IPCount > list[j].IPCount
324: 	})
325: 
326: 	if n > 0 && n < len(list) {
327: 		list = list[:n]
328: 	}
329: 
330: 	return list
331: }
332: 
333: // GetSummary returns a complete analytics summary for JSON output.
334: func (s *State) GetSummary() *AnalyticsSummary {
335: 	if s == nil {
336: 		return &AnalyticsSummary{
337: 			Success:        false,
338: 			TotalIPs:       0,
339: 			TotalCountries: 0,
340: 			Countries:      make(map[string]*CountryStats),
341: 			LastUpdated:    time.Time{},
342: 		}
343: 	}
344: 
345: 	s.mu.RLock()
346: 	defer s.mu.RUnlock()
347: 
348: 	var lastUpdated time.Time
349: 	totalIPs := len(s.ipOrigins)
350: 
351: 	for _, cs := range s.countries {
352: 		if cs.LastUpdated.After(lastUpdated) {
353: 			lastUpdated = cs.LastUpdated
354: 		}
355: 	}
356: 
357: 	return &AnalyticsSummary{
358: 		Success:        true,
359: 		TotalIPs:       totalIPs,
360: 		TotalCountries: len(s.countries),
361: 		Countries:      s.GetCountryStats(),
362: 		LastUpdated:    lastUpdated,
363: 	}
364: }
365: 
366: // writeJSONAtomic writes JSON atomically using temp file + rename.
367: func writeJSONAtomic(path string, v any) error {
368: 	tmp := path + ".tmp"
369: 
370: 	f, err := os.OpenFile(tmp, os.O_CREATE|os.O_WRONLY|os.O_TRUNC, 0o644)
371: 	if err != nil {
372: 		return err
373: 	}
374: 	enc := json.NewEncoder(f)
375: 	enc.SetIndent("", "  ")
376: 	if err := enc.Encode(v); err != nil {
377: 		f.Close()
378: 		return err
379: 	}
380: 	if err := f.Close(); err != nil {
381: 		return err
382: 	}
383: 	return os.Rename(tmp, path)
384: }
385: 
386: // containsString checks if a string slice contains a value.
387: func containsString(xs []string, s string) bool {
388: 	for _, x := range xs {
389: 		if x == s {
390: 			return true
391: 		}
392: 	}
393: 	return false
394: }
</file>


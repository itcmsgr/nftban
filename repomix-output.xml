350: func cmdTrustLoad(trustDir string) error {
351: 	// Check for privilege (root OR CAP_NET_ADMIN capability)
352: 	if err := checkPrivilege(); err != nil {
353: 		return err
354: 	}
355: 
356: 	fmt.Println(version.BannerWithEmoji("🛡️", "Load Trust Feeds"))
357: 	fmt.Println(strings.Repeat("=", 70))
358: 	fmt.Println()
359: 
360: 	// Read all .txt files from trust directory
361: 	files, err := filepath.Glob(filepath.Join(trustDir, "*.txt"))
362: 	if err != nil {
363: 		return fmt.Errorf("failed to read trust directory: %w", err)
364: 	}
365: 
366: 	if len(files) == 0 {
367: 		fmt.Println("⚠️  No trust feed files found.")
368: 		fmt.Println("   Run 'nftban trust update' first to download feeds.")
369: 		return nil
370: 	}
371: 
372: 	// Collect all IPs
373: 	var ipv4List, ipv6List []string
374: 
375: 	for _, file := range files {
376: 		content, err := os.ReadFile(file)
377: 		if err != nil {
378: 			fmt.Printf("⚠️  Warning: failed to read %s: %v\n", file, err)
379: 			continue
380: 		}
381: 
382: 		lines := strings.Split(string(content), "\n")
383: 		for _, line := range lines {
384: 			line = strings.TrimSpace(line)
385: 			if line == "" || strings.HasPrefix(line, "#") {
386: 				continue
387: 			}
388: 
389: 			if strings.Contains(line, ":") {
390: 				// IPv6
391: 				if !strings.Contains(line, "/") {
392: 					line += "/128"
393: 				}
394: 				ipv6List = append(ipv6List, line)
395: 			} else {
396: 				// IPv4
397: 				if !strings.Contains(line, "/") {
398: 					line += "/32"
399: 				}
400: 				ipv4List = append(ipv4List, line)
401: 			}
402: 		}
403: 	}
404: 
405: 	fmt.Printf("Loaded: %d IPv4 CIDRs, %d IPv6 CIDRs\n", len(ipv4List), len(ipv6List))
406: 	fmt.Println()
407: 
408: 	if len(ipv4List) == 0 && len(ipv6List) == 0 {
409: 		fmt.Println("⚠️  No valid IPs found in trust feed files.")
410: 		return nil
411: 	}
412: 
413: 	// Load into nftables whitelist sets
414: 	fmt.Println("Loading into nftables whitelist sets...")
415: 
416: 	nft, err := sync.NewNFTManager()
417: 	if err != nil {
418: 		return fmt.Errorf("failed to create nftables manager: %w", err)
419: 	}
420: 	defer nft.Close()
421: 
422: 	// Get IPv4 whitelist set
423: 	tableIPv4, err := nft.GetOrCreateTable(nftables.TableFamilyIPv4)
424: 	if err != nil {
425: 		return fmt.Errorf("failed to get IPv4 table: %w", err)
426: 	}
427: 
428: 	whitelistIPv4Set, err := nft.GetOrCreateIntervalSet(tableIPv4, "whitelist_ipv4", true)
429: 	if err != nil {
430: 		return fmt.Errorf("failed to get whitelist_ipv4 set: %w", err)
431: 	}
432: 
433: 	// Load IPv4
434: 	if len(ipv4List) > 0 {
435: 		stats, err := nft.AddCIDRElementsWithStats(whitelistIPv4Set, ipv4List)
436: 		if err != nil {
437: 			return fmt.Errorf("failed to load IPv4 trust feeds: %w", err)
438: 		}
439: 		fmt.Printf("  ✅ IPv4: %d CIDRs → %d ranges (%.1f%% reduction)\n",
440: 			stats.InputCIDRs, stats.OutputRanges, stats.ReductionPct)
441: 	}
442: 
443: 	// Get IPv6 whitelist set
444: 	tableIPv6, err := nft.GetOrCreateTable(nftables.TableFamilyIPv6)
445: 	if err != nil {
446: 		return fmt.Errorf("failed to get IPv6 table: %w", err)
447: 	}
448: 
449: 	whitelistIPv6Set, err := nft.GetOrCreateIntervalSet(tableIPv6, "whitelist_ipv6", false)
450: 	if err != nil {
451: 		return fmt.Errorf("failed to get whitelist_ipv6 set: %w", err)
452: 	}
453: 
454: 	// Load IPv6
455: 	if len(ipv6List) > 0 {
456: 		stats, err := nft.AddCIDRElementsWithStats(whitelistIPv6Set, ipv6List)
457: 		if err != nil {
458: 			return fmt.Errorf("failed to load IPv6 trust feeds: %w", err)
459: 		}
460: 		fmt.Printf("  ✅ IPv6: %d CIDRs → %d ranges (%.1f%% reduction)\n",
461: 			stats.InputCIDRs, stats.OutputRanges, stats.ReductionPct)
462: 	}
463: 
464: 	fmt.Println()
465: 	fmt.Println("✅ Trust feeds loaded into whitelist successfully!")
466: 	fmt.Println("   These IPs will NEVER be blocked by nftban.")
467: 	fmt.Println()

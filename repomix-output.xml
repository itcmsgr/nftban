1470: 
1471:     local status=$HEALTH_OK
1472:     local completion_issues=()
1473: 
1474:     # Check if bash-completion is installed
1475:     # Method 1: Check if main bash_completion script exists
1476:     if [[ ! -f /usr/share/bash-completion/bash_completion ]] && \
1477:        [[ ! -f /etc/bash_completion ]]; then
1478:         completion_issues+=("bash-completion package not installed")
1479:         completion_issues+=("Tab completion for nftban command will not work")
1480:         completion_issues+=("FIX: Install bash-completion package (dnf/apt/yum install bash-completion)")
1481:         status=$HEALTH_WARNING

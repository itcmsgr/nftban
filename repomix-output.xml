236:     # GUI/Metrics - only if user wants AND not small
237:     ENABLE_GUI=0
238:     ENABLE_METRICS=0
239:     if [[ "$WANT_GUI" -eq 1 ]] && [[ "$PROFILE_ENV" != "small" ]]; then
240:         ENABLE_GUI=1
241:         ENABLE_METRICS=1
242:     fi
243: 
244:     # Geoban - off by default
245:     ENABLE_GEOBAN=0
246: 
247:     # Compute DDoS tuning based on environment
248:     case "$PROFILE_ENV" in
249:         small)
250:             DDOS_SYNFLOOD_RATE="30/s"
251:             DDOS_SYNFLOOD_BURST=60
252:             DDOS_CONN_LIMIT_PER_IP=50
253:             ;;
254:         medium)
255:             DDOS_SYNFLOOD_RATE="50/s"
256:             DDOS_SYNFLOOD_BURST=100
257:             DDOS_CONN_LIMIT_PER_IP=100
258:             ;;
259:         large)
260:             DDOS_SYNFLOOD_RATE="100/s"
261:             DDOS_SYNFLOOD_BURST=200
262:             DDOS_CONN_LIMIT_PER_IP=200
263:             ;;
264:     esac
265: 
266:     # Compute portscan tuning based on security level
267:     case "$PROFILE_SECURITY_LEVEL" in
268:         standard)
269:             PORTSCAN_THRESHOLD=30
270:             PORTSCAN_WINDOW_SECONDS=60
271:             PORTSCAN_BAN_DURATION_SECONDS=$((24 * 3600))
272:             ;;
273:         strict)
274:             PORTSCAN_THRESHOLD=20
275:             PORTSCAN_WINDOW_SECONDS=60
276:             PORTSCAN_BAN_DURATION_SECONDS=$((3 * 24 * 3600))
277:             ;;
278:         paranoid)
279:             PORTSCAN_THRESHOLD=10
280:             PORTSCAN_WINDOW_SECONDS=60
281:             PORTSCAN_BAN_DURATION_SECONDS=$((7 * 24 * 3600))
282:             ;;
283:     esac
284: 
285:     # Login tuning
286:     case "$PROFILE_SECURITY_LEVEL" in
287:         standard)
288:             LOGIN_MAX_ATTEMPTS=6
289:             LOGIN_BAN_DURATION_SECONDS=$((1 * 3600))
290:             ;;
291:         strict)
292:             LOGIN_MAX_ATTEMPTS=5
293:             LOGIN_BAN_DURATION_SECONDS=$((12 * 3600))
294:             ;;
295:         paranoid)
296:             LOGIN_MAX_ATTEMPTS=3
297:             LOGIN_BAN_DURATION_SECONDS=$((24 * 3600))
298:             ;;

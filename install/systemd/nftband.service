# =============================================================================
# NFTBan v1.0.0 - Daemon Service (Single nftables Writer)
# =============================================================================
# SPDX-License-Identifier: MPL-2.0
# meta:name="nftband.service"
# meta:type="systemd"
# meta:owner="Antonios Voulvoulis <contact@nftban.com>"
# meta:created_date="2025-10-26"
# meta:description="Main daemon service with socket activation"
# meta:input="None"
# meta:output="Systemd unit"
# meta:depends=""
# meta:inventory.files=""
# meta:inventory.binaries="/usr/lib/nftban/bin/nftband"
# meta:inventory.env_vars=""
# meta:inventory.config_files="/etc/nftban/nftban.conf"
# meta:inventory.systemd_units="nftband.socket"
# meta:inventory.network=""
# meta:inventory.privileges="root"
# =============================================================================
#
# This daemon is the SINGLE writer for all nftables operations.
# All CLI and scheduled tasks must communicate via IPC socket.
#
# Socket activation:
#   - nftband.socket creates /run/nftban/nftband.sock (0660 root:nftban)
#   - Daemon receives socket via systemd file descriptor passing
#   - No capability escalation needed for socket permissions
#
# Access Control:
#   - Socket permissions: 0660 root:nftban (set by nftband.socket)
#   - Peer credentials validated via SO_PEERCRED (defense-in-depth)
#   - Allowed: root OR members of nftban group
#
# Activation modes:
#   - Production: socket activation via nftband.socket
#   - Dev/test: manual start with fallback socket creation
# =============================================================================

[Unit]
Description=NFTBan Daemon (Single nftables Writer)
Documentation=man:nftban(8)

# Socket activation dependencies
Requires=nftband.socket
After=nftband.socket

# Start after network, nftables, and firewall-init are ready
# v1.19.0: Ensure firewall-init creates tables BEFORE daemon starts (Task 46)
After=network.target nftables.service nftban-firewall-init.service
Wants=nftables.service

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=30s

# Daemon runs as root (required for nftables operations)
# This is the ONLY service allowed to run as root for nft operations
# See: ARCHITECTURE-NFT-POLICY.md
User=root
Group=root

ExecStart=/usr/lib/nftban/bin/nftband
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
StartLimitBurst=5
StartLimitIntervalSec=300

# =============================================================================
# SECURITY HARDENING
# =============================================================================

# Prevent privilege escalation
NoNewPrivileges=true

# Filesystem protection
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

# Kernel protection
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

# Additional hardening
RestrictSUIDSGID=true
LockPersonality=true
# MemoryDenyWriteExecute=true  # Uncomment if Go runtime is compatible

# =============================================================================
# RESOURCE LIMITS (Safety Net Only)
# =============================================================================
# IMPORTANT: Actual memory limits are in /etc/nftban/nftban.conf
# The daemon reads NFTBAN_MAX_MEMORY_* and auto-detects based on RAM tier.
#
# These systemd limits are SAFETY NETS ONLY - set very high to avoid
# interfering with the daemon's smart memory management.
#
# To adjust memory limits, edit /etc/nftban/nftban.conf:
#   NFTBAN_MAX_MEMORY_BYTES="536870912"  # 512MB
#   NFTBAN_MAX_MEMORY_PERCENT="20"       # 20% of RAM
#
# DO NOT reduce these systemd limits - they cause OOM kills.
MemoryHigh=1G
MemoryMax=2G

# =============================================================================
# FILESYSTEM ACCESS
# =============================================================================
# Principle of least privilege: daemon writes ONLY to specific paths
#
# READ-ONLY (implicit via ProtectSystem=strict):
#   /etc/nftban/nftban.conf      - main config
#   /etc/nftban/whitelist.d/     - whitelist entries (admin-managed)
#   /etc/nftban/distros/         - distro detection configs
#   /etc/nftban/ports.d/         - port configs
#   /etc/nftban/conf.d/          - module configs
#
# READ-WRITE (explicit):
#   /etc/nftban/blacklist.d/     - ONLY directory daemon writes to in /etc
#   /var/lib/nftban              - persistent data, snapshots, .nft rulesets
#   /var/log/nftban              - log files
#   /run/nftban                  - PID file (socket managed by nftband.socket)
#   /var/cache/nftban            - temporary caches
#
# This minimizes damage if daemon is compromised - cannot modify main config
# Note: /etc/nftban/rules.d is for .nft fragment files (SELinux requires etc_t context)
ReadWritePaths=/etc/nftban/blacklist.d /etc/nftban/rules.d /var/lib/nftban /var/log/nftban /run/nftban /var/cache/nftban

# =============================================================================
# CAPABILITIES
# =============================================================================
# Minimal capability set for nftban operations:
# CAP_NET_ADMIN: required for nft add/delete/flush operations
# CAP_DAC_OVERRIDE: required to write stats/metrics to nftban-owned directories
# No CAP_CHOWN/CAP_FOWNER needed - socket permissions handled by nftband.socket
CapabilityBoundingSet=CAP_NET_ADMIN CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_NET_ADMIN CAP_DAC_OVERRIDE

# =============================================================================
# LOGGING
# =============================================================================
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nftband

[Install]
WantedBy=multi-user.target
Also=nftband.socket

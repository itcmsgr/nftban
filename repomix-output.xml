 711: 
 712:     # Check if binaries exist
 713:     if ! check_binary "$BIN_DIR/nftban-core"; then
 714:         warn "Core binaries not found in $BIN_DIR/"
 715:         warn "Skipping binary installation (CLI will use bash fallbacks)"
 716:         warn "To build binaries: run ./build.sh first"
 717:         return 0
 718:     fi

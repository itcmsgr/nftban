 913: nftban_watchdog_run() {
 914:     # Main entry point called by systemd timer
 915:     # Runs all checks, saves report, exports metrics
 916: 
 917:     if [[ "$NFTBAN_WATCHDOG_ENABLED" != "true" ]]; then
 918:         echo "Watchdog is disabled. Enable with: nftban watchdog enable"
 919:         return 0
 920:     fi
 921: 
 922:     watchdog_log "INFO" "Watchdog check starting"
 923: 
 924:     # Run all checks
 925:     nftban_watchdog_run_all
 926:     local status=$?
 927: 
 928:     # Save report
 929:     local report_file
 930:     report_file=$(nftban_watchdog_report_save)
 931:     watchdog_log "INFO" "Report saved: $report_file"
 932: 
 933:     # Export metrics
 934:     nftban_watchdog_metrics_export
 935: 
 936:     # Cleanup old reports
 937:     nftban_watchdog_cleanup_old >/dev/null
 938: 
 939:     # Log completion
 940:     local status_text="OK"
 941:     [[ $status -eq $WATCHDOG_WARNING ]] && status_text="WARNING"
 942:     [[ $status -eq $WATCHDOG_CRITICAL ]] && status_text="CRITICAL"
 943:     watchdog_log "INFO" "Watchdog check completed: $status_text"
 944: 
 945:     return $status
 946: }

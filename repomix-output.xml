<file path="cli/lib/nftban/helpers/generate_polkit_rules.sh">
 1: #!/usr/bin/env bash
 2: # =============================================================================
 3: # NFTBan - Generate Polkit Rules from Templates
 4: # =============================================================================
 5: # SPDX-License-Identifier: MPL-2.0
 6: #
 7: # Purpose: Generate polkit rules from templates using central config values
 8: #          Used by install.sh and DEB/RPM post-install scripts
 9: #
10: # Usage:
11: #   ./generate_polkit_rules.sh [--source-dir /path/to/templates]
12: #
13: # Templates:
14: #   - 50-nftban-port-status.rules.in  -> @NFTBAN_BIN@
15: #   - 50-nftban-auth.rules.in         -> @NFTBAN_AUTH_BIN@
16: #
17: # Config source: /etc/nftban/nftban.conf
18: # Output:        /usr/share/polkit-1/rules.d/*.rules
19: # =============================================================================
20: 
21: set -euo pipefail
22: 
23: # Source central config for canonical paths (NO HARDCODED FALLBACKS)
24: # shellcheck source=/etc/nftban/nftban.conf
25: [[ -f "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf" ]] && source "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf"
26: 
27: # Paths
28: readonly NFTBAN_CONF="${NFTBAN_CONF:-${NFTBAN_CONFIG_DIR}/nftban.conf}"
29: readonly POLKIT_RULES_DIR="${POLKIT_RULES_DIR:-/usr/share/polkit-1/rules.d}"
30: readonly TEMPLATE_DIR="${1:-/usr/share/nftban/polkit-templates}"
31: 
32: # Colors
33: readonly GREEN='\033[0;32m'
34: readonly YELLOW='\033[1;33m'
35: readonly NC='\033[0m'
36: 
37: log_ok() { echo -e "${GREEN}[OK]${NC} $*"; }
38: log_warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
39: 
40: # =============================================================================
41: # MAIN
42: # =============================================================================
43: 
44: main() {
45:     # Load central config
46:     if [[ -f "$NFTBAN_CONF" ]]; then
47:         # shellcheck source=/dev/null
48:         source "$NFTBAN_CONF"
49:     else
50:         log_warn "Config not found: $NFTBAN_CONF - using defaults"
51:     fi
52: 
53:     # Ensure required variables are set (use defaults if not in config)
54:     : "${NFTBAN_BIN:=/usr/bin/nftban}"
55:     : "${NFTBAN_AUTH_BIN:=/usr/libexec/nftban-ui-auth}"
56: 
57:     # Ensure output directory exists
58:     mkdir -p "$POLKIT_RULES_DIR"
59: 
60:     # Generate 50-nftban-port-status.rules
61:     local port_template="$TEMPLATE_DIR/50-nftban-port-status.rules.in"
62:     if [[ -f "$port_template" ]]; then
63:         sed "s|@NFTBAN_BIN@|$NFTBAN_BIN|g" "$port_template" \
64:             > "$POLKIT_RULES_DIR/50-nftban-port-status.rules"
65:         chmod 644 "$POLKIT_RULES_DIR/50-nftban-port-status.rules"
66:         log_ok "Generated: 50-nftban-port-status.rules (NFTBAN_BIN=$NFTBAN_BIN)"
67:     else
68:         log_warn "Template not found: $port_template"
69:     fi
70: 
71:     # Generate 50-nftban-auth.rules
72:     local auth_template="$TEMPLATE_DIR/50-nftban-auth.rules.in"
73:     if [[ -f "$auth_template" ]]; then
74:         sed "s|@NFTBAN_AUTH_BIN@|$NFTBAN_AUTH_BIN|g" "$auth_template" \
75:             > "$POLKIT_RULES_DIR/50-nftban-auth.rules"
76:         chmod 644 "$POLKIT_RULES_DIR/50-nftban-auth.rules"
77:         log_ok "Generated: 50-nftban-auth.rules (NFTBAN_AUTH_BIN=$NFTBAN_AUTH_BIN)"
78:     else
79:         log_warn "Template not found: $auth_template"
80:     fi
81: 
82:     # Restart polkit to apply changes
83:     if command -v systemctl &>/dev/null; then
84:         systemctl restart polkit 2>/dev/null || log_warn "Failed to restart polkit"
85:     fi
86: 
87:     log_ok "Polkit rules generated successfully"
88: }
89: 
90: main "$@"
</file>

<file path="cli/lib/nftban/helpers/json_output.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - JSON Output Helper Module
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: JSON output support for all CLI commands
  7: #
  8: # meta:name=json_output
  9: # meta:type=helper
 10: # meta:header=JSON Output Module
 11: # meta:version=1.0.0
 12: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 13: # meta:homepage=https://nftban.com
 14: #
 15: # **Description & Purpose**
 16: # meta:description=Provides JSON output format for CLI commands when --json flag is used
 17: # meta:input=Command results in various formats
 18: # meta:output=JSON-formatted responses
 19: #
 20: # **Inventory & Requirements**
 21: # meta:depends=bash>=4.0,jq (optional, has fallback)
 22: #
 23: # meta:created_date=2025-11-24
 24: # meta:updated_date=2025-11-24
 25: # =============================================================================
 26: 
 27: 
 28: # =============================================================================
 29: # MODULE GUARD
 30: # =============================================================================
 31: 
 32: # Prevent double-loading
 33: [[ -n "${NFTBAN_JSON_OUTPUT_LOADED:-}" ]] && return 0
 34: readonly NFTBAN_JSON_OUTPUT_LOADED=1
 35: 
 36: # =============================================================================
 37: # JSON MODE DETECTION
 38: # =============================================================================
 39: 
 40: # Check if --json flag is present in arguments
 41: # Usage: is_json_mode "$@"
 42: # Returns: 0 if --json found, 1 otherwise
 43: is_json_mode() {
 44:     for arg in "$@"; do
 45:         [[ "$arg" == "--json" ]] && return 0
 46:     done
 47:     return 1
 48: }
 49: 
 50: # Remove --json from arguments array
 51: # Usage: remove_json_flag "$@"
 52: # Outputs: All args except --json
 53: remove_json_flag() {
 54:     for arg in "$@"; do
 55:         [[ "$arg" != "--json" ]] && echo "$arg"
 56:     done
 57: }
 58: 
 59: # =============================================================================
 60: # JSON OUTPUT FUNCTIONS
 61: # =============================================================================
 62: 
 63: # Standard json_output function (used by most CLI commands)
 64: # Usage: json_output <success:true/false> <data_json>
 65: # Example: json_output "true" '{"ip":"1.2.3.4"}'
 66: json_output() {
 67:     local success="$1"
 68:     local data="$2"
 69:     local timestamp
 70:     timestamp=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
 71: 
 72:     if command -v jq &>/dev/null; then
 73:         if [[ "$success" == "true" ]]; then
 74:             jq -n \
 75:                 --arg ts "$timestamp" \
 76:                 --argjson data "$data" \
 77:                 '{
 78:                     success: true,
 79:                     timestamp: $ts,
 80:                     data: $data
 81:                 }'
 82:         else
 83:             jq -n \
 84:                 --arg ts "$timestamp" \
 85:                 --arg err "$data" \
 86:                 '{
 87:                     success: false,
 88:                     timestamp: $ts,
 89:                     error: $err
 90:                 }'
 91:         fi
 92:     else
 93:         if [[ "$success" == "true" ]]; then
 94:             cat <<EOF
 95: {
 96:   "success": true,
 97:   "timestamp": "$timestamp",
 98:   "data": $data
 99: }
100: EOF
101:         else
102:             cat <<EOF
103: {
104:   "success": false,
105:   "timestamp": "$timestamp",
106:   "error": "$data"
107: }
108: EOF
109:         fi
110:     fi
111: }
112: 
113: # Output successful JSON response
114: # Usage: json_success <data_json>
115: # Example: json_success '{"ip":"1.2.3.4","action":"banned"}'
116: json_success() {
117:     local data="$1"
118:     local timestamp
119:     timestamp=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
120: 
121:     if command -v jq &>/dev/null; then
122:         # Use jq for proper JSON formatting and validation
123:         jq -n \
124:             --arg ts "$timestamp" \
125:             --argjson data "$data" \
126:             '{
127:                 success: true,
128:                 timestamp: $ts,
129:                 data: $data
130:             }'
131:     else
132:         # Fallback: manual JSON construction
133:         cat <<EOF
134: {
135:   "success": true,
136:   "timestamp": "$timestamp",
137:   "data": $data
138: }
139: EOF
140:     fi
141: }
142: 
143: # Output error JSON response
144: # Usage: json_error <error_message> [error_code]
145: # Example: json_error "Invalid IP address" 400
146: json_error() {
147:     local error_message="$1"
148:     local error_code="${2:-1}"
149:     local timestamp
150:     timestamp=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
151: 
152:     if command -v jq &>/dev/null; then
153:         jq -n \
154:             --arg ts "$timestamp" \
155:             --arg err "$error_message" \
156:             --argjson code "$error_code" \
157:             '{
158:                 success: false,
159:                 timestamp: $ts,
160:                 error: $err,
161:                 error_code: $code
162:             }'
163:     else
164:         cat <<EOF
165: {
166:   "success": false,
167:   "timestamp": "$timestamp",
168:   "error": "$error_message",
169:   "error_code": $error_code
170: }
171: EOF
172:     fi
173: }
174: 
175: # =============================================================================
176: # JSON BUILDERS FOR COMMON OPERATIONS
177: # =============================================================================
178: 
179: # Build JSON for IP ban operation
180: # Usage: json_ban_response <ip> <reason> <timeout>
181: json_ban_response() {
182:     local ip="$1"
183:     local reason="${2:-manual}"
184:     local timeout="${3:-1h}"
185: 
186:     if command -v jq &>/dev/null; then
187:         jq -n \
188:             --arg ip "$ip" \
189:             --arg reason "$reason" \
190:             --arg timeout "$timeout" \
191:             '{
192:                 ip: $ip,
193:                 action: "banned",
194:                 reason: $reason,
195:                 timeout: $timeout
196:             }'
197:     else
198:         cat <<EOF
199: {
200:   "ip": "$ip",
201:   "action": "banned",
202:   "reason": "$reason",
203:   "timeout": "$timeout"
204: }
205: EOF
206:     fi
207: }
208: 
209: # Build JSON for IP unban operation
210: # Usage: json_unban_response <ip> <removed_from...>
211: json_unban_response() {
212:     local ip="$1"
213:     shift
214:     local locations=("$@")
215: 
216:     local locations_json="["
217:     for loc in "${locations[@]}"; do
218:         locations_json+="\"$loc\","
219:     done
220:     locations_json="${locations_json%,}]"
221: 
222:     if command -v jq &>/dev/null; then
223:         jq -n \
224:             --arg ip "$ip" \
225:             --argjson locs "$locations_json" \
226:             '{
227:                 ip: $ip,
228:                 action: "unbanned",
229:                 removed_from: $locs
230:             }'
231:     else
232:         cat <<EOF
233: {
234:   "ip": "$ip",
235:   "action": "unbanned",
236:   "removed_from": $locations_json
237: }
238: EOF
239:     fi
240: }
241: 
242: # Build JSON for search results
243: # Usage: json_search_response <ip> <found> [locations...]
244: json_search_response() {
245:     local ip="$1"
246:     local found="$2"
247:     shift 2
248:     local locations=("$@")
249: 
250:     local locations_json="["
251:     for loc in "${locations[@]}"; do
252:         locations_json+="\"$loc\","
253:     done
254:     locations_json="${locations_json%,}]"
255: 
256:     if command -v jq &>/dev/null; then
257:         jq -n \
258:             --arg ip "$ip" \
259:             --argjson found "$found" \
260:             --argjson locs "$locations_json" \
261:             '{
262:                 ip: $ip,
263:                 found: $found,
264:                 locations: $locs
265:             }'
266:     else
267:         cat <<EOF
268: {
269:   "ip": "$ip",
270:   "found": $found,
271:   "locations": $locations_json
272: }
273: EOF
274:     fi
275: }
276: 
277: # Build JSON for stats/dashboard
278: # Usage: json_stats_response <stats_object>
279: json_stats_response() {
280:     local stats="$1"
281: 
282:     if command -v jq &>/dev/null; then
283:         jq -n --argjson stats "$stats" '{stats: $stats}'
284:     else
285:         cat <<EOF
286: {
287:   "stats": $stats
288: }
289: EOF
290:     fi
291: }
292: 
293: # Build JSON for list results
294: # Usage: json_list_response <items_array> <total_count>
295: json_list_response() {
296:     local items="$1"
297:     local total="${2:-0}"
298: 
299:     if command -v jq &>/dev/null; then
300:         jq -n \
301:             --argjson items "$items" \
302:             --argjson total "$total" \
303:             '{
304:                 items: $items,
305:                 total: $total
306:             }'
307:     else
308:         cat <<EOF
309: {
310:   "items": $items,
311:   "total": $total
312: }
313: EOF
314:     fi
315: }
316: 
317: # Build JSON for geoban operation
318: # Usage: json_geoban_response <action> <country> <ip_count>
319: json_geoban_response() {
320:     local action="$1"
321:     local country="$2"
322:     local ip_count="${3:-0}"
323: 
324:     if command -v jq &>/dev/null; then
325:         jq -n \
326:             --arg action "$action" \
327:             --arg country "$country" \
328:             --argjson count "$ip_count" \
329:             '{
330:                 action: $action,
331:                 country: $country,
332:                 ip_count: $count
333:             }'
334:     else
335:         cat <<EOF
336: {
337:   "action": "$action",
338:   "country": "$country",
339:   "ip_count": $ip_count
340: }
341: EOF
342:     fi
343: }
344: 
345: # =============================================================================
346: # ARRAY/OBJECT HELPERS
347: # =============================================================================
348: 
349: # Convert bash array to JSON array
350: # Usage: array_to_json "${my_array[@]}"
351: array_to_json() {
352:     local arr=("$@")
353: 
354:     if command -v jq &>/dev/null; then
355:         printf '%s\n' "${arr[@]}" | jq -R . | jq -s .
356:     else
357:         # Manual construction
358:         local json="["
359:         for item in "${arr[@]}"; do
360:             # Escape quotes in item
361:             item="${item//\"/\\\"}"
362:             json+="\"$item\","
363:         done
364:         json="${json%,}]"
365:         echo "$json"
366:     fi
367: }
368: 
369: # Convert key=value pairs to JSON object
370: # Usage: pairs_to_json "key1=value1" "key2=value2" ...
371: pairs_to_json() {
372:     local pairs=("$@")
373: 
374:     if command -v jq &>/dev/null; then
375:         local args=()
376:         for pair in "${pairs[@]}"; do
377:             local key="${pair%%=*}"
378:             local value="${pair#*=}"
379:             args+=(--arg "$key" "$value")
380:         done
381: 
382:         # Build jq object dynamically
383:         local obj_str="{"
384:         for pair in "${pairs[@]}"; do
385:             local key="${pair%%=*}"
386:             obj_str+="\"$key\": \$$key,"
387:         done
388:         obj_str="${obj_str%,}}"
389: 
390:         jq -n "${args[@]}" "$obj_str"
391:     else
392:         # Manual construction
393:         local json="{"
394:         for pair in "${pairs[@]}"; do
395:             local key="${pair%%=*}"
396:             local value="${pair#*=}"
397:             # Escape quotes
398:             value="${value//\"/\\\"}"
399:             json+="\"$key\": \"$value\","
400:         done
401:         json="${json%,}}"
402:         echo "$json"
403:     fi
404: }
405: 
406: # =============================================================================
407: # ESCAPE FUNCTIONS
408: # =============================================================================
409: 
410: # Escape string for JSON
411: # Usage: json_escape "string with \"quotes\" and \backslashes"
412: json_escape() {
413:     local str="$1"
414: 
415:     # Escape backslash first
416:     str="${str//\\/\\\\}"
417:     # Escape quotes
418:     str="${str//\"/\\\"}"
419:     # Escape newlines
420:     str="${str//$'\n'/\\n}"
421:     # Escape tabs
422:     str="${str//$'\t'/\\t}"
423:     # Escape carriage returns
424:     str="${str//$'\r'/\\r}"
425: 
426:     echo "$str"
427: }
428: 
429: # =============================================================================
430: # VALIDATION
431: # =============================================================================
432: 
433: # Check if string is valid JSON
434: # Usage: is_valid_json "$json_string"
435: is_valid_json() {
436:     local json="$1"
437: 
438:     if command -v jq &>/dev/null; then
439:         echo "$json" | jq empty 2>/dev/null
440:         return $?
441:     else
442:         # Basic check: starts with { or [, ends with } or ]
443:         [[ "$json" =~ ^[[:space:]]*(\{.*\}|\[.*\])[[:space:]]*$ ]]
444:     fi
445: }
446: 
447: # =============================================================================
448: # COMMAND EXIT MARKER
449: # =============================================================================
450: 
451: # Output command exit marker for validation
452: # This marker helps testing framework detect successful command completion
453: # Only outputs in debug mode (NFTBAN_DEBUG=true)
454: # Usage: nftban_cmd_exit <command_name>
455: # Example: nftban_cmd_exit "search"
456: nftban_cmd_exit() {
457:     # Only output in debug mode
458:     [[ "${NFTBAN_DEBUG:-false}" != "true" ]] && return 0
459:     local cmd_name="$1"
460:     echo "# NFTBAN_CMD_EXIT: $cmd_name"
461: }
462: 
463: # =============================================================================
464: # EXPORT FUNCTIONS
465: # =============================================================================
466: 
467: export -f is_json_mode
468: export -f remove_json_flag
469: export -f json_output
470: export -f json_success
471: export -f json_error
472: export -f json_ban_response
473: export -f json_unban_response
474: export -f json_search_response
475: export -f json_stats_response
476: export -f json_list_response
477: export -f json_geoban_response
478: export -f array_to_json
479: export -f pairs_to_json
480: export -f json_escape
481: export -f is_valid_json
482: export -f nftban_cmd_exit
483: 
484: # =============================================================================
485: # MODULE LOADED
486: # =============================================================================
487: 
488: # Silent - no output on load
489: true
</file>

<file path="cli/lib/nftban/helpers/nftban_audit.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - Central Audit Log Module
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Central audit trail for all NFTBan actions
  7: #
  8: # meta:name=nftban_audit
  9: # meta:type=helper
 10: # meta:header=Audit Trail Module
 11: # meta:version=1.0.0
 12: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 13: # meta:homepage=https://nftban.com
 14: #
 15: # **Description & Purpose**
 16: # meta:description=Logs all security-relevant actions (bans, unbans, config changes) to audit trail
 17: # meta:input=Action type, target, reason, user
 18: # meta:output=JSON-formatted audit entries to nftban-actions.log
 19: #
 20: # **Inventory & Requirements**
 21: # meta:depends=bash>=4.0
 22: #
 23: # meta:created_date=2025-11-24
 24: # meta:updated_date=2025-11-24
 25: # =============================================================================
 26: 
 27: 
 28: # =============================================================================
 29: # MODULE GUARD
 30: # =============================================================================
 31: 
 32: # Prevent double-loading
 33: [[ -n "${NFTBAN_AUDIT_LOADED:-}" ]] && return 0
 34: readonly NFTBAN_AUDIT_LOADED=1
 35: 
 36: # Source central config for canonical paths (NO HARDCODED FALLBACKS)
 37: # shellcheck source=/etc/nftban/nftban.conf
 38: [[ -f "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf" ]] && source "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf"
 39: 
 40: # =============================================================================
 41: # CONFIGURATION
 42: # =============================================================================
 43: 
 44: # Audit log file
 45: readonly NFTBAN_AUDIT_LOG="${NFTBAN_AUDIT_LOG:-${NFTBAN_LOG_DIR}/nftban-actions.log}"
 46: 
 47: # Enable/disable audit logging
 48: : "${NFTBAN_AUDIT_ENABLED:=true}"
 49: 
 50: # Audit log format: json, text
 51: : "${NFTBAN_AUDIT_FORMAT:=json}"
 52: 
 53: # =============================================================================
 54: # CORE AUDIT FUNCTION
 55: # =============================================================================
 56: 
 57: # Main audit logging function
 58: # Usage: nftban_audit_log <action> <target> [reason] [user] [details]
 59: nftban_audit_log() {
 60:     local action="$1"       # ban, unban, geoban, feed_update, config_change, etc.
 61:     local target="$2"       # IP, country code, feed name, config file, etc.
 62:     local reason="${3:-}"   # Optional reason
 63:     local user="${4:-${USER:-unknown}}"  # User performing action
 64:     local details="${5:-}"  # Optional JSON details
 65: 
 66:     # Skip if audit is disabled
 67:     [[ "${NFTBAN_AUDIT_ENABLED}" != "true" ]] && return 0
 68: 
 69:     # Build timestamp
 70:     local timestamp
 71:     timestamp=$(date -u '+%Y-%m-%dT%H:%M:%SZ')  # ISO 8601 UTC
 72: 
 73:     # Get hostname
 74:     local hostname
 75:     hostname=$(hostname -f 2>/dev/null || hostname 2>/dev/null || echo "unknown")
 76: 
 77:     # Get source IP (if available from SSH)
 78:     local source_ip="${SSH_CLIENT%% *}"
 79:     source_ip="${source_ip:-local}"
 80: 
 81:     # Ensure audit log directory exists
 82:     local audit_dir
 83:     audit_dir="$(dirname "$NFTBAN_AUDIT_LOG")"
 84: 
 85:     if [[ ! -d "$audit_dir" ]]; then
 86:         mkdir -p "$audit_dir" 2>/dev/null || true
 87:     fi
 88: 
 89:     # Create audit log if it doesn't exist (with correct ownership)
 90:     if [[ ! -f "$NFTBAN_AUDIT_LOG" ]]; then
 91:         touch "$NFTBAN_AUDIT_LOG" 2>/dev/null || true
 92:         chown nftban:nftban "$NFTBAN_AUDIT_LOG" 2>/dev/null || true
 93:         chmod 640 "$NFTBAN_AUDIT_LOG" 2>/dev/null || true
 94:     fi
 95: 
 96:     # Build audit entry based on format
 97:     local audit_entry
 98: 
 99:     case "${NFTBAN_AUDIT_FORMAT}" in
100:         json)
101:             # JSON format (better for parsing)
102:             if [[ -n "$details" ]]; then
103:                 audit_entry=$(cat <<EOF
104: {"timestamp":"$timestamp","hostname":"$hostname","action":"$action","target":"$target","reason":"$reason","user":"$user","source_ip":"$source_ip","pid":$$,"details":$details}
105: EOF
106: )
107:             else
108:                 audit_entry=$(cat <<EOF
109: {"timestamp":"$timestamp","hostname":"$hostname","action":"$action","target":"$target","reason":"$reason","user":"$user","source_ip":"$source_ip","pid":$$}
110: EOF
111: )
112:             fi
113:             ;;
114:         text)
115:             # Human-readable text format
116:             audit_entry="[$timestamp] [$hostname] [$user@$source_ip] ACTION=$action TARGET=$target REASON=$reason PID=$$"
117:             ;;
118:         *)
119:             # Default to JSON
120:             audit_entry=$(cat <<EOF
121: {"timestamp":"$timestamp","hostname":"$hostname","action":"$action","target":"$target","reason":"$reason","user":"$user","source_ip":"$source_ip","pid":$$}
122: EOF
123: )
124:             ;;
125:     esac
126: 
127:     # Write to audit log (with error handling)
128:     if [[ -w "$audit_dir" ]] || [[ -w "$NFTBAN_AUDIT_LOG" ]]; then
129:         echo "$audit_entry" >> "$NFTBAN_AUDIT_LOG" 2>/dev/null || true
130:     fi
131: }
132: 
133: # =============================================================================
134: # CONVENIENCE FUNCTIONS FOR COMMON ACTIONS
135: # =============================================================================
136: 
137: # Audit IP ban
138: # Usage: nftban_audit_ban <ip> <reason> [timeout]
139: nftban_audit_ban() {
140:     local ip="$1"
141:     local reason="${2:-manual}"
142:     local timeout="${3:-}"
143: 
144:     local details=""
145:     if [[ -n "$timeout" ]]; then
146:         details='{"timeout":"'$timeout'"}'
147:     fi
148: 
149:     nftban_audit_log "ban" "$ip" "$reason" "${USER:-unknown}" "$details"
150: }
151: 
152: # Audit IP unban
153: # Usage: nftban_audit_unban <ip> [reason]
154: nftban_audit_unban() {
155:     local ip="$1"
156:     local reason="${2:-manual}"
157: 
158:     nftban_audit_log "unban" "$ip" "$reason"
159: }
160: 
161: # Audit GeoBan action
162: # Usage: nftban_audit_geoban <action> <country_code> [reason]
163: nftban_audit_geoban() {
164:     local action="$1"  # block, unblock
165:     local country="$2"
166:     local reason="${3:-manual}"
167: 
168:     nftban_audit_log "geoban_${action}" "$country" "$reason"
169: }
170: 
171: # Audit feed update
172: # Usage: nftban_audit_feed_update <feed_name> <added> <removed>
173: nftban_audit_feed_update() {
174:     local feed_name="$1"
175:     local added="${2:-0}"
176:     local removed="${3:-0}"
177: 
178:     local details='{"added":'$added',"removed":'$removed'}'
179: 
180:     nftban_audit_log "feed_update" "$feed_name" "automatic" "${USER:-system}" "$details"
181: }
182: 
183: # Audit configuration change
184: # Usage: nftban_audit_config_change <config_file> <change_description>
185: nftban_audit_config_change() {
186:     local config_file="$1"
187:     local change_desc="$2"
188: 
189:     nftban_audit_log "config_change" "$config_file" "$change_desc"
190: }
191: 
192: # Audit whitelist add
193: # Usage: nftban_audit_whitelist_add <ip> [reason]
194: nftban_audit_whitelist_add() {
195:     local ip="$1"
196:     local reason="${2:-manual}"
197: 
198:     nftban_audit_log "whitelist_add" "$ip" "$reason"
199: }
200: 
201: # Audit whitelist remove
202: # Usage: nftban_audit_whitelist_remove <ip> [reason]
203: nftban_audit_whitelist_remove() {
204:     local ip="$1"
205:     local reason="${2:-manual}"
206: 
207:     nftban_audit_log "whitelist_remove" "$ip" "$reason"
208: }
209: 
210: # Audit firewall reload
211: # Usage: nftban_audit_firewall_reload [reason]
212: nftban_audit_firewall_reload() {
213:     local reason="${1:-manual}"
214: 
215:     nftban_audit_log "firewall_reload" "nftables" "$reason"
216: }
217: 
218: # Audit service start/stop
219: # Usage: nftban_audit_service <action> <service_name>
220: nftban_audit_service() {
221:     local action="$1"  # start, stop, restart
222:     local service="$2"
223: 
224:     nftban_audit_log "service_${action}" "$service" "manual"
225: }
226: 
227: # =============================================================================
228: # AUDIT LOG QUERY HELPERS
229: # =============================================================================
230: 
231: # Get last N audit entries
232: # Usage: nftban_audit_tail [n]
233: nftban_audit_tail() {
234:     local n="${1:-10}"
235: 
236:     if [[ -f "$NFTBAN_AUDIT_LOG" ]]; then
237:         tail -n "$n" "$NFTBAN_AUDIT_LOG"
238:     fi
239: }
240: 
241: # Search audit log for specific action
242: # Usage: nftban_audit_search <action> [n]
243: nftban_audit_search() {
244:     local action="$1"
245:     local n="${2:-100}"
246: 
247:     if [[ -f "$NFTBAN_AUDIT_LOG" ]]; then
248:         grep "\"action\":\"$action\"" "$NFTBAN_AUDIT_LOG" | tail -n "$n"
249:     fi
250: }
251: 
252: # Get audit entries for specific target
253: # Usage: nftban_audit_search_target <target> [n]
254: nftban_audit_search_target() {
255:     local target="$1"
256:     local n="${2:-100}"
257: 
258:     if [[ -f "$NFTBAN_AUDIT_LOG" ]]; then
259:         grep "\"target\":\"$target\"" "$NFTBAN_AUDIT_LOG" | tail -n "$n"
260:     fi
261: }
262: 
263: # Get audit entries by user
264: # Usage: nftban_audit_search_user <user> [n]
265: nftban_audit_search_user() {
266:     local user="$1"
267:     local n="${2:-100}"
268: 
269:     if [[ -f "$NFTBAN_AUDIT_LOG" ]]; then
270:         grep "\"user\":\"$user\"" "$NFTBAN_AUDIT_LOG" | tail -n "$n"
271:     fi
272: }
273: 
274: # Get audit summary (counts by action)
275: # Usage: nftban_audit_summary
276: nftban_audit_summary() {
277:     if [[ ! -f "$NFTBAN_AUDIT_LOG" ]]; then
278:         echo "No audit log found"
279:         return 0
280:     fi
281: 
282:     echo "Audit Log Summary:"
283:     echo "==================="
284:     echo ""
285:     echo "Total entries: $(wc -l < "$NFTBAN_AUDIT_LOG")"
286:     echo ""
287:     echo "Actions breakdown:"
288: 
289:     if command -v jq &>/dev/null; then
290:         # Use jq for better parsing
291:         jq -r '.action' "$NFTBAN_AUDIT_LOG" 2>/dev/null | sort | uniq -c | sort -rn
292:     else
293:         # Fallback to grep
294:         grep -oP '"action":"[^"]*"' "$NFTBAN_AUDIT_LOG" | cut -d'"' -f4 | sort | uniq -c | sort -rn
295:     fi
296: }
297: 
298: # =============================================================================
299: # AUDIT LOG ROTATION
300: # =============================================================================
301: 
302: # Rotate audit log if too large
303: # Usage: nftban_audit_rotate [max_size_mb]
304: nftban_audit_rotate() {
305:     local max_size_mb="${1:-50}"  # Default 50MB
306: 
307:     [[ ! -f "$NFTBAN_AUDIT_LOG" ]] && return 0
308: 
309:     local size_bytes
310:     size_bytes=$(stat -f%z "$NFTBAN_AUDIT_LOG" 2>/dev/null || stat -c%s "$NFTBAN_AUDIT_LOG" 2>/dev/null || echo "0")
311:     local size_mb=$((size_bytes / 1024 / 1024))
312: 
313:     if ((size_mb >= max_size_mb)); then
314:         # Rotate with timestamp
315:         local backup
316:         backup="${NFTBAN_AUDIT_LOG}.$(date '+%Y%m%d-%H%M%S')"
317:         mv "$NFTBAN_AUDIT_LOG" "$backup"
318:         touch "$NFTBAN_AUDIT_LOG"
319:         chown nftban:nftban "$NFTBAN_AUDIT_LOG" 2>/dev/null || true
320:         chmod 640 "$NFTBAN_AUDIT_LOG" 2>/dev/null || true
321: 
322:         # Compress old audit log
323:         if command -v gzip &>/dev/null; then
324:             gzip "$backup" &
325:         fi
326: 
327:         nftban_audit_log "audit_rotate" "$backup" "size_exceeded:${size_mb}MB"
328:     fi
329: }
330: 
331: # =============================================================================
332: # EXPORT FUNCTIONS
333: # =============================================================================
334: 
335: # Export audit functions for use by other scripts
336: export -f nftban_audit_log
337: export -f nftban_audit_ban
338: export -f nftban_audit_unban
339: export -f nftban_audit_geoban
340: export -f nftban_audit_feed_update
341: export -f nftban_audit_config_change
342: export -f nftban_audit_whitelist_add
343: export -f nftban_audit_whitelist_remove
344: export -f nftban_audit_firewall_reload
345: export -f nftban_audit_service
346: export -f nftban_audit_tail
347: export -f nftban_audit_search
348: export -f nftban_audit_search_target
349: export -f nftban_audit_search_user
350: export -f nftban_audit_summary
351: export -f nftban_audit_rotate
352: 
353: # =============================================================================
354: # MODULE LOADED
355: # =============================================================================
356: 
357: # Initialize audit log on first load (with correct ownership)
358: if [[ ! -f "$NFTBAN_AUDIT_LOG" ]] && [[ "${NFTBAN_AUDIT_ENABLED}" == "true" ]]; then
359:     _nftban_audit_init_dir="$(dirname "$NFTBAN_AUDIT_LOG")"
360:     mkdir -p "$_nftban_audit_init_dir" 2>/dev/null || true
361:     touch "$NFTBAN_AUDIT_LOG" 2>/dev/null || true
362:     chown nftban:nftban "$NFTBAN_AUDIT_LOG" 2>/dev/null || true
363:     chmod 640 "$NFTBAN_AUDIT_LOG" 2>/dev/null || true
364:     unset _nftban_audit_init_dir
365: fi
</file>

<file path="cli/lib/nftban/helpers/nftban_logger.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - Centralized Logging Module
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Centralized logging for all NFTBan modules
  7: #
  8: # meta:name=nftban_logger
  9: # meta:type=helper
 10: # meta:header=Logging Module
 11: # meta:version=1.0.0
 12: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 13: # meta:homepage=https://nftban.com
 14: #
 15: # **Description & Purpose**
 16: # meta:description=Centralized logging to files and stdout for all modules
 17: # meta:input=Log level, module name, message
 18: # meta:output=Log entries to files and stdout
 19: #
 20: # **Inventory & Requirements**
 21: # meta:depends=bash>=4.0
 22: #
 23: # meta:created_date=2025-11-24
 24: # meta:updated_date=2025-11-24
 25: # =============================================================================
 26: 
 27: 
 28: # =============================================================================
 29: # MODULE GUARD
 30: # =============================================================================
 31: 
 32: # Prevent double-loading
 33: [[ -n "${NFTBAN_LOGGER_LOADED:-}" ]] && return 0
 34: readonly NFTBAN_LOGGER_LOADED=1
 35: 
 36: # Source central config for canonical paths (NO HARDCODED FALLBACKS)
 37: # shellcheck source=/etc/nftban/nftban.conf
 38: [[ -f "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf" ]] && source "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf"
 39: 
 40: # =============================================================================
 41: # LOG LEVELS
 42: # =============================================================================
 43: 
 44: # Log level constants for external use
 45: # shellcheck disable=SC2034
 46: readonly LOG_LEVEL_DEBUG=0
 47: # shellcheck disable=SC2034
 48: readonly LOG_LEVEL_INFO=1
 49: # shellcheck disable=SC2034
 50: readonly LOG_LEVEL_WARN=2
 51: # shellcheck disable=SC2034
 52: readonly LOG_LEVEL_ERROR=3
 53: # shellcheck disable=SC2034
 54: readonly LOG_LEVEL_SUCCESS=4
 55: 
 56: # =============================================================================
 57: # CONFIGURATION
 58: # =============================================================================
 59: 
 60: # Main log file
 61: : "${NFTBAN_LOG_FILE:=${NFTBAN_LOG_DIR}/nftban.log}"
 62: 
 63: # Current log level (default: INFO)
 64: : "${NFTBAN_LOG_LEVEL:=$LOG_LEVEL_INFO}"
 65: 
 66: # Enable/disable stdout logging
 67: : "${NFTBAN_LOG_STDOUT:=true}"
 68: 
 69: # Enable/disable file logging
 70: : "${NFTBAN_LOG_FILE_ENABLED:=true}"
 71: 
 72: # Log format: timestamp, simple
 73: : "${NFTBAN_LOG_FORMAT:=timestamp}"
 74: 
 75: # =============================================================================
 76: # CORE LOGGING FUNCTION
 77: # =============================================================================
 78: 
 79: # Main logging function
 80: # Usage: nftban_log <level> <module> <message...>
 81: nftban_log() {
 82:     local level="$1"
 83:     local module="${2:-nftban}"
 84:     shift 2
 85:     local message="$*"
 86: 
 87:     # Skip if message is empty
 88:     [[ -z "$message" ]] && return 0
 89: 
 90:     # Build timestamp
 91:     local timestamp
 92:     timestamp=$(date '+%Y-%m-%d %H:%M:%S')
 93: 
 94:     # Build log line based on format
 95:     local log_line
 96:     case "${NFTBAN_LOG_FORMAT}" in
 97:         timestamp)
 98:             log_line="[$timestamp] [$level] [$module] $message"
 99:             ;;
100:         simple)
101:             log_line="[$level] [$module] $message"
102:             ;;
103:         *)
104:             log_line="[$timestamp] [$level] [$module] $message"
105:             ;;
106:     esac
107: 
108:     # Write to file (with error handling)
109:     if [[ "${NFTBAN_LOG_FILE_ENABLED}" == "true" ]]; then
110:         local log_dir
111:         log_dir="$(dirname "$NFTBAN_LOG_FILE")"
112: 
113:         if [[ -w "$log_dir" ]] || [[ -w "$NFTBAN_LOG_FILE" ]]; then
114:             echo "$log_line" >> "$NFTBAN_LOG_FILE" 2>/dev/null || true
115:         fi
116:     fi
117: 
118:     # Write to stdout (if enabled)
119:     if [[ "${NFTBAN_LOG_STDOUT}" == "true" ]] && [[ "${NFTBAN_SILENT:-false}" != "true" ]]; then
120:         echo "[$level] $message"
121:     fi
122: }
123: 
124: # =============================================================================
125: # CONVENIENCE FUNCTIONS
126: # =============================================================================
127: 
128: # Log DEBUG message
129: nftban_log_debug() {
130:     local module="${NFTBAN_MODULE_NAME:-nftban}"
131:     nftban_log "DEBUG" "$module" "$@"
132: }
133: 
134: # Log INFO message
135: nftban_log_info() {
136:     local module="${NFTBAN_MODULE_NAME:-nftban}"
137:     nftban_log "INFO" "$module" "$@"
138: }
139: 
140: # Log WARN message
141: nftban_log_warn() {
142:     local module="${NFTBAN_MODULE_NAME:-nftban}"
143:     nftban_log "WARN" "$module" "$@"
144: }
145: 
146: # Log ERROR message
147: nftban_log_error() {
148:     local module="${NFTBAN_MODULE_NAME:-nftban}"
149:     nftban_log "ERROR" "$module" "$@"
150: }
151: 
152: # Log SUCCESS message
153: nftban_log_success() {
154:     local module="${NFTBAN_MODULE_NAME:-nftban}"
155:     nftban_log "SUCCESS" "$module" "$@"
156: }
157: 
158: # =============================================================================
159: # MODULE-SPECIFIC LOGGING
160: # =============================================================================
161: 
162: # Log to module-specific file
163: # Usage: nftban_log_to_module_file <log_file> <level> <message...>
164: nftban_log_to_module_file() {
165:     local module_log="$1"
166:     local level="$2"
167:     shift 2
168:     local message="$*"
169: 
170:     # Skip if message is empty
171:     [[ -z "$message" ]] && return 0
172: 
173:     local timestamp
174:     timestamp=$(date '+%Y-%m-%d %H:%M:%S')
175: 
176:     local log_line="[$timestamp] [$level] $message"
177: 
178:     # Check if log directory is writable
179:     local log_dir
180:     log_dir="$(dirname "$module_log")"
181: 
182:     if [[ -w "$log_dir" ]] || [[ -w "$module_log" ]]; then
183:         echo "$log_line" >> "$module_log" 2>/dev/null || true
184:     fi
185: }
186: 
187: # =============================================================================
188: # HELPER FUNCTIONS
189: # =============================================================================
190: 
191: # Initialize logging for a module
192: # Usage: nftban_logger_init <module_name> [log_file]
193: nftban_logger_init() {
194:     local module_name="$1"
195:     local module_log="${2:-${NFTBAN_LOG_DIR}/${module_name}.log}"
196: 
197:     # Set module name for convenience functions
198:     export NFTBAN_MODULE_NAME="$module_name"
199:     export NFTBAN_MODULE_LOG_FILE="$module_log"
200: 
201:     # Ensure log directory exists
202:     local log_dir
203:     log_dir="$(dirname "$module_log")"
204: 
205:     if [[ ! -d "$log_dir" ]]; then
206:         mkdir -p "$log_dir" 2>/dev/null || true
207:     fi
208: 
209:     # Create log file if it doesn't exist
210:     if [[ ! -f "$module_log" ]]; then
211:         touch "$module_log" 2>/dev/null || true
212:         chmod 640 "$module_log" 2>/dev/null || true
213:     fi
214: 
215:     # Log initialization
216:     nftban_log_info "Logger initialized for module: $module_name"
217:     nftban_log_to_module_file "$module_log" "INFO" "Module logger initialized"
218: }
219: 
220: # Write to both main log and module log
221: # Usage: nftban_log_dual <level> <message...>
222: nftban_log_dual() {
223:     local level="$1"
224:     shift
225:     local message="$*"
226: 
227:     # Log to main log
228:     nftban_log "$level" "${NFTBAN_MODULE_NAME:-nftban}" "$message"
229: 
230:     # Log to module log (if defined)
231:     if [[ -n "${NFTBAN_MODULE_LOG_FILE:-}" ]]; then
232:         nftban_log_to_module_file "$NFTBAN_MODULE_LOG_FILE" "$level" "$message"
233:     fi
234: }
235: 
236: # =============================================================================
237: # LOG ROTATION HELPER
238: # =============================================================================
239: 
240: # Check if log file needs rotation (based on size)
241: # Usage: nftban_log_check_rotation <log_file> <max_size_mb>
242: nftban_log_check_rotation() {
243:     local log_file="$1"
244:     local max_size_mb="${2:-10}"  # Default 10MB
245: 
246:     [[ ! -f "$log_file" ]] && return 0
247: 
248:     local size_bytes
249:     size_bytes=$(stat -f%z "$log_file" 2>/dev/null || stat -c%s "$log_file" 2>/dev/null || echo "0")
250:     local size_mb=$((size_bytes / 1024 / 1024))
251: 
252:     if ((size_mb >= max_size_mb)); then
253:         # Rotate log
254:         local backup="${log_file}.1"
255:         [[ -f "$backup" ]] && rm -f "$backup"
256:         mv "$log_file" "$backup"
257:         touch "$log_file"
258:         chmod 640 "$log_file" 2>/dev/null || true
259: 
260:         nftban_log_info "Rotated log file: $log_file (was ${size_mb}MB)"
261:     fi
262: }
263: 
264: # =============================================================================
265: # EXPORT FUNCTIONS
266: # =============================================================================
267: 
268: # Export logging functions for use by other scripts
269: export -f nftban_log
270: export -f nftban_log_debug
271: export -f nftban_log_info
272: export -f nftban_log_warn
273: export -f nftban_log_error
274: export -f nftban_log_success
275: export -f nftban_log_to_module_file
276: export -f nftban_log_dual
277: export -f nftban_logger_init
278: export -f nftban_log_check_rotation
279: 
280: # =============================================================================
281: # MODULE LOADED
282: # =============================================================================
283: 
284: # Silent mode - don't log this during module load
285: if [[ "${NFTBAN_SILENT:-false}" != "true" ]] && [[ "${NFTBAN_DEBUG_MODE:-false}" == "true" ]]; then
286:     nftban_log_debug "Logger module loaded"
287: fi
</file>

<file path="cli/lib/nftban/helpers/nftban_task_queue.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan Task Queue System
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Async task queue for heavy operations (feeds sync, geoban apply)
  7: #
  8: # How it works:
  9: # 1. Commands (feeds disable, geoban ban, etc.) add tasks to queue
 10: # 2. Systemd timer runs nftban-sync.timer every minute
 11: # 3. Timer processes ONE task at a time (prevents parallel syncs)
 12: # 4. Lock file prevents multiple timer instances
 13: #
 14: # Task Types:
 15: # - feeds_sync: Sync all feeds to nftables
 16: # - geoban_apply: Apply GeoBan rules to nftables
 17: #
 18: # =============================================================================
 19: 
 20: # Source central config for canonical paths (NO HARDCODED FALLBACKS)
 21: # shellcheck source=/etc/nftban/nftban.conf
 22: [[ -f "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf" ]] && source "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf"
 23: 
 24: readonly TASK_QUEUE_DIR="${NFTBAN_DATA_DIR}/queue"
 25: readonly TASK_LOCK_FILE="${NFTBAN_RUN_DIR}/queue.lock"
 26: readonly TASK_LOG="${NFTBAN_LOG_DIR}/queue.log"
 27: 
 28: # Source required modules for task processing
 29: : "${NFTBAN_LIB_DIR:=/usr/lib/nftban}"
 30: # shellcheck source=/dev/null
 31: source "${NFTBAN_LIB_DIR}/core/nftban_feeds.sh" 2>/dev/null || true
 32: # shellcheck source=/dev/null
 33: source "${NFTBAN_LIB_DIR}/core/nftban_geoban.sh" 2>/dev/null || true
 34: 
 35: # Initialize queue directory (with correct ownership)
 36: _queue_init() {
 37:     mkdir -p "$TASK_QUEUE_DIR" 2>/dev/null
 38:     mkdir -p "$(dirname "$TASK_LOCK_FILE")" 2>/dev/null
 39:     touch "$TASK_LOG" 2>/dev/null
 40:     chown nftban:nftban "$TASK_LOG" 2>/dev/null || true
 41:     chmod 640 "$TASK_LOG" 2>/dev/null || true
 42: }
 43: 
 44: # Log to queue log
 45: _queue_log() {
 46:     local level="$1"
 47:     shift
 48:     echo "[$(date '+%Y-%m-%d %H:%M:%S')] [$level] $*" >> "$TASK_LOG"
 49: }
 50: 
 51: # Add task to queue
 52: # Usage: nftban_queue_add <task_type> [description]
 53: nftban_queue_add() {
 54:     local task_type="$1"
 55:     local description="${2:-$task_type}"
 56: 
 57:     _queue_init
 58: 
 59:     # Create task file with timestamp
 60:     local task_id task_file
 61:     task_id="$(date +%s)-${task_type}"
 62:     task_file="${TASK_QUEUE_DIR}/${task_id}.task"
 63: 
 64:     cat > "$task_file" <<EOF
 65: TASK_TYPE="$task_type"
 66: TASK_DESCRIPTION="$description"
 67: TASK_CREATED="$(date '+%Y-%m-%d %H:%M:%S')"
 68: TASK_STATUS="pending"
 69: EOF
 70: 
 71:     _queue_log "INFO" "Task queued: $task_type ($description)"
 72:     echo "$task_id"
 73: }
 74: 
 75: # Check if queue has pending tasks
 76: nftban_queue_has_pending() {
 77:     _queue_init
 78:     [[ -n "$(find "$TASK_QUEUE_DIR" -name "*.task" -type f 2>/dev/null)" ]]
 79: }
 80: 
 81: # Get pending task count
 82: nftban_queue_count() {
 83:     _queue_init
 84:     find "$TASK_QUEUE_DIR" -name "*.task" -type f 2>/dev/null | wc -l
 85: }
 86: 
 87: # Process next task in queue
 88: # Returns: 0 if task processed, 1 if no tasks, 2 if locked
 89: nftban_queue_process_next() {
 90:     _queue_init
 91: 
 92:     # Check for lock (prevent parallel processing)
 93:     if [[ -f "$TASK_LOCK_FILE" ]]; then
 94:         local lock_pid
 95:         lock_pid=$(cat "$TASK_LOCK_FILE" 2>/dev/null)
 96:         if [[ -n "$lock_pid" ]] && kill -0 "$lock_pid" 2>/dev/null; then
 97:             # Check if locked for over 15 minutes (900 seconds)
 98:             local lock_age
 99:             lock_age=$(( $(date +%s) - $(stat -c %Y "$TASK_LOCK_FILE" 2>/dev/null || echo 0) ))
100:             if [[ $lock_age -gt 900 ]]; then
101:                 _queue_log "ALERT" "Queue processor stuck for ${lock_age}s (PID: $lock_pid) - SOMETHING WRONG!"
102:                 # Log to syslog for admin alerts
103:                 logger -t nftban-queue -p user.alert "NFTBan queue processor stuck for ${lock_age}s - manual intervention required"
104:             fi
105:             _queue_log "WARN" "Queue processor already running (PID: $lock_pid)"
106:             return 2
107:         else
108:             # Stale lock, remove it
109:             rm -f "$TASK_LOCK_FILE"
110:         fi
111:     fi
112: 
113:     # Acquire lock
114:     echo "$$" > "$TASK_LOCK_FILE"
115: 
116:     # Get oldest task
117:     local task_file
118:     task_file=$(find "$TASK_QUEUE_DIR" -name "*.task" -type f 2>/dev/null | sort | head -1)
119: 
120:     if [[ -z "$task_file" ]]; then
121:         rm -f "$TASK_LOCK_FILE"
122:         return 1
123:     fi
124: 
125:     # Load task
126:     # shellcheck source=/dev/null
127:     source "$task_file"
128: 
129:     _queue_log "INFO" "Processing task: $TASK_TYPE ($TASK_DESCRIPTION)"
130: 
131:     # Process based on type
132:     local result=0
133:     case "$TASK_TYPE" in
134:         feeds_sync)
135:             _queue_log "INFO" "Running feeds sync..."
136:             if nftban_feeds_sync_to_nftables >> "$TASK_LOG" 2>&1; then
137:                 _queue_log "SUCCESS" "Feeds sync completed"
138:             else
139:                 _queue_log "ERROR" "Feeds sync failed"
140:                 result=1
141:             fi
142:             ;;
143:         geoban_apply)
144:             _queue_log "INFO" "Running GeoBan apply..."
145:             if nftban_geoban_apply_to_nftables >> "$TASK_LOG" 2>&1; then
146:                 _queue_log "SUCCESS" "GeoBan apply completed"
147:             else
148:                 _queue_log "ERROR" "GeoBan apply failed"
149:                 result=1
150:             fi
151:             ;;
152:         *)
153:             _queue_log "ERROR" "Unknown task type: $TASK_TYPE"
154:             result=1
155:             ;;
156:     esac
157: 
158:     # Remove task file
159:     rm -f "$task_file"
160: 
161:     # Release lock
162:     rm -f "$TASK_LOCK_FILE"
163: 
164:     return $result
165: }
166: 
167: # Export functions
168: export -f nftban_queue_add
169: export -f nftban_queue_has_pending
170: export -f nftban_queue_count
171: export -f nftban_queue_process_next
</file>

<file path="cli/lib/nftban/helpers/nftban_trace.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - Debug Trace Module
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Script execution tracing for debugging stuck/failed scripts
  7: #
  8: # meta:name=nftban_trace
  9: # meta:type=helper
 10: # meta:header=Debug Trace Module
 11: # meta:version=1.0.0
 12: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 13: # meta:homepage=https://nftban.com
 14: #
 15: # **Description & Purpose**
 16: # meta:description=Logs START/END of scripts with unique trace IDs to detect stuck scripts
 17: # meta:input=Module name, optional function name
 18: # meta:output=Trace entries to debug_trace.log
 19: #
 20: # **Usage**
 21: # 1. Source this library at start of script
 22: # 2. Call nftban_trace_start "module_name" at beginning
 23: # 3. Call nftban_trace_end at end (uses same trace ID)
 24: # 4. If script crashes, START entry exists without END = problem found
 25: #
 26: # **Inventory & Requirements**
 27: # meta:depends=bash>=4.0
 28: #
 29: # meta:created_date=2025-12-04
 30: # meta:updated_date=2025-12-04
 31: # =============================================================================
 32: 
 33: # =============================================================================
 34: # MODULE GUARD
 35: # =============================================================================
 36: 
 37: [[ -n "${NFTBAN_TRACE_LOADED:-}" ]] && return 0
 38: readonly NFTBAN_TRACE_LOADED=1
 39: 
 40: # =============================================================================
 41: # CONFIGURATION
 42: # =============================================================================
 43: 
 44: # Source central config for canonical paths (NO HARDCODED FALLBACKS)
 45: # shellcheck source=/etc/nftban/nftban.conf
 46: [[ -f "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf" ]] && source "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf"
 47: 
 48: # Defaults
 49: : "${NFTBAN_DEBUG_TRACE:=false}"
 50: : "${NFTBAN_DEBUG_TRACE_LOG:=${NFTBAN_LOG_DIR}/debug_trace.log}"
 51: 
 52: # =============================================================================
 53: # TRACE STATE
 54: # =============================================================================
 55: 
 56: # Current trace ID (set by nftban_trace_start)
 57: declare -g _NFTBAN_TRACE_ID=""
 58: declare -g _NFTBAN_TRACE_MODULE=""
 59: declare -g _NFTBAN_TRACE_START_TIME=""
 60: 
 61: # =============================================================================
 62: # TRACE FUNCTIONS
 63: # =============================================================================
 64: 
 65: # Generate unique trace ID: MODULE-TIMESTAMP-PID
 66: # Format: login_alert-20251204_114532_123456-12345
 67: _nftban_trace_generate_id() {
 68:     local module="$1"
 69:     local timestamp
 70:     timestamp=$(date '+%Y%m%d_%H%M%S_%N')
 71:     echo "${module}-${timestamp}-$$"
 72: }
 73: 
 74: # Start trace - call at beginning of script/function
 75: # Usage: nftban_trace_start "module_name" [function_name]
 76: nftban_trace_start() {
 77:     # Skip if debug trace disabled
 78:     [[ "${NFTBAN_DEBUG_TRACE}" != "true" ]] && return 0
 79: 
 80:     local module="${1:-unknown}"
 81:     local function_name="${2:-main}"
 82: 
 83:     # Generate trace ID
 84:     _NFTBAN_TRACE_ID=$(_nftban_trace_generate_id "$module")
 85:     _NFTBAN_TRACE_MODULE="$module"
 86:     _NFTBAN_TRACE_START_TIME=$(date '+%Y-%m-%d %H:%M:%S.%N')
 87: 
 88:     # Ensure log directory exists
 89:     local log_dir
 90:     log_dir="$(dirname "$NFTBAN_DEBUG_TRACE_LOG")"
 91:     [[ ! -d "$log_dir" ]] && mkdir -p "$log_dir" 2>/dev/null
 92: 
 93:     # Write START entry
 94:     local entry="[${_NFTBAN_TRACE_START_TIME}] [START] [${_NFTBAN_TRACE_ID}] ${module}::${function_name} PID=$$ PPID=$PPID"
 95:     echo "$entry" >> "$NFTBAN_DEBUG_TRACE_LOG" 2>/dev/null || true
 96: 
 97:     # Also store in temp file for crash detection
 98:     echo "$_NFTBAN_TRACE_ID" > "/tmp/nftban_trace_$$" 2>/dev/null || true
 99: }
100: 
101: # End trace - call at end of script/function
102: # Usage: nftban_trace_end [exit_code]
103: nftban_trace_end() {
104:     # Skip if debug trace disabled
105:     [[ "${NFTBAN_DEBUG_TRACE}" != "true" ]] && return 0
106: 
107:     # Skip if no trace started
108:     [[ -z "${_NFTBAN_TRACE_ID:-}" ]] && return 0
109: 
110:     local exit_code="${1:-0}"
111:     local end_time
112:     end_time=$(date '+%Y-%m-%d %H:%M:%S.%N')
113: 
114:     # Calculate duration if possible
115:     local duration="N/A"
116:     if [[ -n "${_NFTBAN_TRACE_START_TIME:-}" ]]; then
117:         # Simple duration calculation (seconds)
118:         local start_epoch end_epoch
119:         start_epoch=$(date -d "${_NFTBAN_TRACE_START_TIME}" '+%s' 2>/dev/null || echo "0")
120:         end_epoch=$(date '+%s')
121:         if [[ "$start_epoch" != "0" ]]; then
122:             duration="$((end_epoch - start_epoch))s"
123:         fi
124:     fi
125: 
126:     # Write END entry
127:     local status="OK"
128:     [[ "$exit_code" != "0" ]] && status="ERROR($exit_code)"
129: 
130:     local entry="[${end_time}] [END]   [${_NFTBAN_TRACE_ID}] ${_NFTBAN_TRACE_MODULE} status=${status} duration=${duration}"
131:     echo "$entry" >> "$NFTBAN_DEBUG_TRACE_LOG" 2>/dev/null || true
132: 
133:     # Remove temp file
134:     rm -f "/tmp/nftban_trace_$$" 2>/dev/null || true
135: 
136:     # Clear state
137:     _NFTBAN_TRACE_ID=""
138:     _NFTBAN_TRACE_MODULE=""
139:     _NFTBAN_TRACE_START_TIME=""
140: }
141: 
142: # Mark trace as error (before exit)
143: # Usage: nftban_trace_error "error message"
144: nftban_trace_error() {
145:     [[ "${NFTBAN_DEBUG_TRACE}" != "true" ]] && return 0
146:     [[ -z "${_NFTBAN_TRACE_ID:-}" ]] && return 0
147: 
148:     local error_msg="${1:-Unknown error}"
149:     local error_time
150:     error_time=$(date '+%Y-%m-%d %H:%M:%S.%N')
151: 
152:     local entry="[${error_time}] [ERROR] [${_NFTBAN_TRACE_ID}] ${_NFTBAN_TRACE_MODULE}: ${error_msg}"
153:     echo "$entry" >> "$NFTBAN_DEBUG_TRACE_LOG" 2>/dev/null || true
154: }
155: 
156: # Add checkpoint to trace (for long-running scripts)
157: # Usage: nftban_trace_checkpoint "description"
158: nftban_trace_checkpoint() {
159:     [[ "${NFTBAN_DEBUG_TRACE}" != "true" ]] && return 0
160:     [[ -z "${_NFTBAN_TRACE_ID:-}" ]] && return 0
161: 
162:     local checkpoint="${1:-checkpoint}"
163:     local checkpoint_time
164:     checkpoint_time=$(date '+%Y-%m-%d %H:%M:%S.%N')
165: 
166:     local entry="[${checkpoint_time}] [CHECK] [${_NFTBAN_TRACE_ID}] ${_NFTBAN_TRACE_MODULE}: ${checkpoint}"
167:     echo "$entry" >> "$NFTBAN_DEBUG_TRACE_LOG" 2>/dev/null || true
168: }
169: 
170: # =============================================================================
171: # TRACE ANALYSIS FUNCTIONS
172: # =============================================================================
173: 
174: # Find orphaned traces (START without END)
175: # Usage: nftban_trace_find_orphans [minutes_ago]
176: nftban_trace_find_orphans() {
177:     local minutes_ago="${1:-5}"  # Default: look for traces older than 5 minutes
178:     local trace_log="${NFTBAN_DEBUG_TRACE_LOG}"
179: 
180:     [[ ! -f "$trace_log" ]] && echo "No trace log found" && return 1
181: 
182:     echo "=== Orphaned Traces (START without END, older than ${minutes_ago}m) ==="
183:     echo ""
184: 
185:     # Get all START trace IDs
186:     local start_ids
187:     start_ids=$(grep '\[START\]' "$trace_log" | sed 's/.*\[\([^]]*\)\].*/\1/' | grep -E '^[a-z_]+-[0-9]+_[0-9]+_[0-9]+-[0-9]+$')
188: 
189:     # Get all END trace IDs
190:     local end_ids
191:     end_ids=$(grep '\[END\]' "$trace_log" | sed 's/.*\[\([^]]*\)\].*/\1/' | grep -E '^[a-z_]+-[0-9]+_[0-9]+_[0-9]+-[0-9]+$')
192: 
193:     local orphan_count=0
194:     local current_time
195:     current_time=$(date '+%s')
196:     local threshold=$((minutes_ago * 60))
197: 
198:     for trace_id in $start_ids; do
199:         # Check if this trace has an END
200:         if ! echo "$end_ids" | grep -q "^${trace_id}$"; then
201:             # Found orphan - check age
202:             local trace_time
203:             trace_time=$(grep "\[${trace_id}\]" "$trace_log" | head -1 | sed 's/\[\([^]]*\)\].*/\1/')
204:             local trace_epoch
205:             trace_epoch=$(date -d "$trace_time" '+%s' 2>/dev/null || echo "0")
206: 
207:             if [[ "$trace_epoch" != "0" ]]; then
208:                 local age=$((current_time - trace_epoch))
209:                 if [[ $age -gt $threshold ]]; then
210:                     ((orphan_count++))
211:                     echo "ORPHAN #${orphan_count}:"
212:                     echo "  Trace ID: $trace_id"
213:                     echo "  Age: $((age / 60))m $((age % 60))s"
214:                     grep "\[${trace_id}\]" "$trace_log" | sed 's/^/  /'
215:                     echo ""
216:                 fi
217:             fi
218:         fi
219:     done
220: 
221:     if [[ $orphan_count -eq 0 ]]; then
222:         echo "No orphaned traces found (all scripts completed normally)"
223:     else
224:         echo "Found $orphan_count orphaned trace(s) - these scripts may have crashed"
225:     fi
226: 
227:     return $orphan_count
228: }
229: 
230: # Show recent trace activity
231: # Usage: nftban_trace_recent [count]
232: nftban_trace_recent() {
233:     local count="${1:-20}"
234:     local trace_log="${NFTBAN_DEBUG_TRACE_LOG}"
235: 
236:     [[ ! -f "$trace_log" ]] && echo "No trace log found" && return 1
237: 
238:     echo "=== Recent Trace Activity (last $count entries) ==="
239:     tail -n "$count" "$trace_log"
240: }
241: 
242: # Show trace statistics
243: # Usage: nftban_trace_stats
244: nftban_trace_stats() {
245:     local trace_log="${NFTBAN_DEBUG_TRACE_LOG}"
246: 
247:     [[ ! -f "$trace_log" ]] && echo "No trace log found" && return 1
248: 
249:     echo "=== Trace Statistics ==="
250:     echo ""
251:     echo "Total START entries: $(grep -c '\[START\]' "$trace_log" 2>/dev/null || echo 0)"
252:     echo "Total END entries:   $(grep -c '\[END\]' "$trace_log" 2>/dev/null || echo 0)"
253:     echo "Total ERROR entries: $(grep -c '\[ERROR\]' "$trace_log" 2>/dev/null || echo 0)"
254:     echo "Total CHECK entries: $(grep -c '\[CHECK\]' "$trace_log" 2>/dev/null || echo 0)"
255:     echo ""
256:     echo "Log file size: $(du -h "$trace_log" 2>/dev/null | cut -f1)"
257:     echo ""
258: 
259:     echo "=== Traces by Module (last 24h) ==="
260:     local yesterday
261:     yesterday=$(date -d '1 day ago' '+%Y-%m-%d')
262:     grep '\[START\]' "$trace_log" | grep -E "^\[$yesterday|^\[$(date '+%Y-%m-%d')" | \
263:         sed 's/.*\] \([^:]*\)::.*/\1/' | sort | uniq -c | sort -rn | head -10
264: }
265: 
266: # Clear old trace entries (log rotation)
267: # Usage: nftban_trace_rotate [days_to_keep]
268: nftban_trace_rotate() {
269:     local days="${1:-7}"
270:     local trace_log="${NFTBAN_DEBUG_TRACE_LOG}"
271: 
272:     [[ ! -f "$trace_log" ]] && return 0
273: 
274:     local cutoff_date
275:     cutoff_date=$(date -d "$days days ago" '+%Y-%m-%d')
276: 
277:     local backup="${trace_log}.old"
278:     local temp="${trace_log}.tmp"
279: 
280:     # Keep only recent entries
281:     awk -v cutoff="$cutoff_date" '
282:         /^\[/ {
283:             # Extract date from [YYYY-MM-DD HH:MM:SS.nnnnnnnnn]
284:             match($0, /\[([0-9]{4}-[0-9]{2}-[0-9]{2})/, arr)
285:             if (arr[1] >= cutoff) print
286:         }
287:     ' "$trace_log" > "$temp"
288: 
289:     # Backup and replace
290:     [[ -f "$backup" ]] && rm -f "$backup"
291:     mv "$trace_log" "$backup"
292:     mv "$temp" "$trace_log"
293:     chmod 640 "$trace_log" 2>/dev/null || true
294: 
295:     echo "Rotated trace log, kept entries from $cutoff_date onwards"
296: }
297: 
298: # =============================================================================
299: # TRAP HANDLER (Auto-log on unexpected exit)
300: # =============================================================================
301: 
302: # Trap handler for unexpected exits
303: _nftban_trace_trap_handler() {
304:     local exit_code=$?
305:     if [[ -n "${_NFTBAN_TRACE_ID:-}" ]] && [[ "${NFTBAN_DEBUG_TRACE}" == "true" ]]; then
306:         nftban_trace_error "Unexpected exit (signal/error)"
307:         nftban_trace_end "$exit_code"
308:     fi
309: }
310: 
311: # Install trap (only if trace is enabled)
312: if [[ "${NFTBAN_DEBUG_TRACE}" == "true" ]]; then
313:     trap '_nftban_trace_trap_handler' EXIT ERR
314: fi
315: 
316: # =============================================================================
317: # EXPORT FUNCTIONS
318: # =============================================================================
319: 
320: export -f nftban_trace_start
321: export -f nftban_trace_end
322: export -f nftban_trace_error
323: export -f nftban_trace_checkpoint
324: export -f nftban_trace_find_orphans
325: export -f nftban_trace_recent
326: export -f nftban_trace_stats
327: export -f nftban_trace_rotate
328: 
329: # =============================================================================
330: # MODULE LOADED
331: # =============================================================================
332: 
333: if [[ "${NFTBAN_DEBUG_TRACE}" == "true" ]]; then
334:     # Log that trace module is loaded (only in debug mode)
335:     echo "[$(date '+%Y-%m-%d %H:%M:%S.%N')] [LOAD]  [nftban_trace] Module loaded PID=$$" >> "$NFTBAN_DEBUG_TRACE_LOG" 2>/dev/null || true
336: fi
</file>

<file path="cli/lib/nftban/helpers/suricata_troubleshoot.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0 - Suricata Troubleshooting & Verification Script
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Diagnose Suricata issues and verify proper operation
  7: # Location: /usr/lib/nftban/helpers/suricata_troubleshoot.sh
  8: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
  9: # meta:homepage=https://nftban.com
 10: # =============================================================================
 11: 
 12: set -Eeuo pipefail
 13: IFS=$'\n\t'
 14: 
 15: # Source central config for canonical paths (NO HARDCODED FALLBACKS)
 16: # shellcheck source=/etc/nftban/nftban.conf
 17: [[ -f "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf" ]] && source "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf"
 18: 
 19: # Colors
 20: readonly RED='\033[0;31m'
 21: readonly GREEN='\033[0;32m'
 22: readonly YELLOW='\033[1;33m'
 23: readonly BLUE='\033[0;34m'
 24: readonly NC='\033[0m'
 25: 
 26: # Paths
 27: readonly SURICATA_BIN="${SURICATA_BIN:-/usr/bin/suricata}"
 28: readonly SURICATA_YAML="${SURICATA_YAML:-/etc/suricata/suricata.yaml}"
 29: readonly EVE_LOG="${EVE_LOG:-/var/log/suricata/eve.json}"
 30: readonly SURICATA_LOG="${SURICATA_LOG:-/var/log/suricata/suricata.log}"
 31: 
 32: # Counters
 33: CHECKS_PASSED=0
 34: CHECKS_FAILED=0
 35: CHECKS_WARNING=0
 36: 
 37: print_header() {
 38:     echo ""
 39:     echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
 40:     echo -e "${BLUE}$1${NC}"
 41:     echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
 42: }
 43: 
 44: print_check() {
 45:     echo -e "${BLUE}[CHECK]${NC} $1"
 46: }
 47: 
 48: print_pass() {
 49:     echo -e "${GREEN}[✓]${NC} $1"
 50:     ((CHECKS_PASSED++))
 51: }
 52: 
 53: print_fail() {
 54:     echo -e "${RED}[✗]${NC} $1"
 55:     ((CHECKS_FAILED++))
 56: }
 57: 
 58: print_warn() {
 59:     echo -e "${YELLOW}[!]${NC} $1"
 60:     ((CHECKS_WARNING++))
 61: }
 62: 
 63: print_info() {
 64:     echo -e "    $1"
 65: }
 66: 
 67: print_fix() {
 68:     echo -e "${YELLOW}    FIX:${NC} $1"
 69: }
 70: 
 71: # =============================================================================
 72: # CHECK 1: Suricata Binary
 73: # =============================================================================
 74: check_binary() {
 75:     print_header "1. Suricata Binary Check"
 76: 
 77:     print_check "Checking if Suricata is installed..."
 78:     if [[ -x "$SURICATA_BIN" ]]; then
 79:         local version
 80:         version=$("$SURICATA_BIN" --build-info 2>&1 | grep -oP 'Suricata version \K[0-9.]+' | head -1 || echo "unknown")
 81:         print_pass "Suricata found: $SURICATA_BIN (version: $version)"
 82:     else
 83:         print_fail "Suricata not found at $SURICATA_BIN"
 84:         print_fix "Install Suricata: sudo ./cli/lib/nftban/setup/install_suricata.sh"
 85:         return 1
 86:     fi
 87: }
 88: 
 89: # =============================================================================
 90: # CHECK 2: Systemd Service
 91: # =============================================================================
 92: check_service() {
 93:     print_header "2. Systemd Service Check"
 94: 
 95:     print_check "Checking if Suricata service exists..."
 96:     if systemctl list-unit-files | grep -q suricata.service; then
 97:         print_pass "Suricata service exists"
 98:     else
 99:         print_fail "Suricata service not found"
100:         print_fix "Create service: see /cli/lib/nftban/setup/install_suricata.sh"
101:         return 1
102:     fi
103: 
104:     print_check "Checking if Suricata is enabled..."
105:     if systemctl is-enabled --quiet suricata 2>/dev/null; then
106:         print_pass "Suricata service is enabled"
107:     else
108:         print_warn "Suricata service is NOT enabled (won't start on boot)"
109:         print_fix "Enable: sudo systemctl enable suricata"
110:     fi
111: 
112:     print_check "Checking if Suricata is running..."
113:     if systemctl is-active --quiet suricata 2>/dev/null; then
114:         print_pass "Suricata is running"
115: 
116:         # Check uptime
117:         local uptime
118:         uptime=$(systemctl show suricata -p ActiveEnterTimestamp --value 2>/dev/null || echo "unknown")
119:         print_info "Started: $uptime"
120:     else
121:         print_fail "Suricata is NOT running"
122:         print_fix "Start: sudo systemctl start suricata"
123:         print_fix "Check logs: sudo journalctl -xeu suricata -n 50"
124:         return 1
125:     fi
126: }
127: 
128: # =============================================================================
129: # CHECK 3: Configuration Files
130: # =============================================================================
131: check_config() {
132:     print_header "3. Configuration Files Check"
133: 
134:     print_check "Checking suricata.yaml..."
135:     if [[ -f "$SURICATA_YAML" ]]; then
136:         print_pass "Found: $SURICATA_YAML"
137: 
138:         # Test configuration syntax
139:         print_check "Testing configuration syntax..."
140:         if "$SURICATA_BIN" -T -c "$SURICATA_YAML" &>/dev/null; then
141:             print_pass "Configuration syntax is valid"
142:         else
143:             print_fail "Configuration syntax has errors"
144:             print_fix "Test manually: sudo suricata -T -c $SURICATA_YAML"
145:             return 1
146:         fi
147:     else
148:         print_fail "suricata.yaml not found at $SURICATA_YAML"
149:         print_fix "Copy template: sudo cp /install/templates/suricata.yaml.optimized $SURICATA_YAML"
150:         return 1
151:     fi
152: 
153:     print_check "Checking network interface configuration..."
154:     local interface
155:     interface=$(grep -A1 "^af-packet:" "$SURICATA_YAML" | grep "interface:" | awk '{print $3}' | head -1 || echo "")
156:     if [[ -n "$interface" ]]; then
157:         print_pass "Monitoring interface: $interface"
158: 
159:         # Check if interface exists
160:         if ip link show "$interface" &>/dev/null; then
161:             print_pass "Interface $interface exists"
162: 
163:             # Check if interface is UP
164:             if ip link show "$interface" | grep -q "state UP"; then
165:                 print_pass "Interface $interface is UP"
166:             else
167:                 print_warn "Interface $interface is DOWN"
168:                 print_fix "Bring up: sudo ip link set $interface up"
169:             fi
170:         else
171:             print_fail "Interface $interface does NOT exist"
172:             print_fix "Check available interfaces: ip link show"
173:             print_fix "Update suricata.yaml with correct interface"
174:         fi
175:     else
176:         print_fail "No interface configured in af-packet section"
177:         print_fix "Edit $SURICATA_YAML and set interface under af-packet section"
178:     fi
179: }
180: 
181: # =============================================================================
182: # CHECK 4: Rules
183: # =============================================================================
184: check_rules() {
185:     print_header "4. Suricata Rules Check"
186: 
187:     print_check "Checking if rules are installed..."
188:     local rules_dir="/var/lib/suricata/rules"
189:     if [[ -d "$rules_dir" ]]; then
190:         local rule_count
191:         rule_count=$(find "$rules_dir" -name "*.rules" -type f 2>/dev/null | wc -l)
192: 
193:         if [[ $rule_count -gt 0 ]]; then
194:             print_pass "Found $rule_count rule files in $rules_dir"
195: 
196:             # Count actual rules
197:             local total_rules
198:             total_rules=$(grep -h "^alert\|^drop\|^pass\|^reject" "$rules_dir"/*.rules 2>/dev/null | wc -l || echo 0)
199:             print_info "Total rules: $total_rules"
200: 
201:             if [[ $total_rules -lt 100 ]]; then
202:                 print_warn "Very few rules loaded ($total_rules) - detection may be limited"
203:                 print_fix "Update rules: sudo suricata-update"
204:             fi
205:         else
206:             print_fail "No rule files found in $rules_dir"
207:             print_fix "Download rules: sudo suricata-update"
208:             return 1
209:         fi
210:     else
211:         print_fail "Rules directory not found: $rules_dir"
212:         print_fix "Create and populate: sudo suricata-update"
213:         return 1
214:     fi
215: 
216:     print_check "Checking rule reload in logs..."
217:     if grep -q "rule reload complete" "$SURICATA_LOG" 2>/dev/null; then
218:         local loaded_rules
219:         loaded_rules=$(grep "rule reload complete" "$SURICATA_LOG" 2>/dev/null | tail -1 | grep -oP '\d+ rules' || echo "unknown")
220:         print_pass "Rules loaded: $loaded_rules"
221:     else
222:         print_warn "No 'rule reload complete' message found in logs"
223:         print_fix "Check: sudo journalctl -u suricata | grep -i rule"
224:     fi
225: }
226: 
227: # =============================================================================
228: # CHECK 5: Logging
229: # =============================================================================
230: check_logging() {
231:     print_header "5. Logging Check"
232: 
233:     print_check "Checking eve.json log file..."
234:     if [[ -f "$EVE_LOG" ]]; then
235:         local size
236:         size=$(du -h "$EVE_LOG" | awk '{print $1}')
237:         print_pass "Found: $EVE_LOG ($size)"
238: 
239:         # Check if file is growing (modified in last hour)
240:         if [[ $(find "$EVE_LOG" -mmin -60 2>/dev/null) ]]; then
241:             print_pass "Log file is actively being written (modified < 1 hour ago)"
242:         else
243:             print_warn "Log file hasn't been modified in over 1 hour"
244:             print_fix "Check if Suricata is receiving traffic"
245:         fi
246: 
247:         # Check permissions
248:         if [[ -r "$EVE_LOG" ]]; then
249:             print_pass "Log file is readable"
250:         else
251:             print_fail "Log file is NOT readable (permission denied)"
252:             print_fix "Fix permissions: sudo chmod 644 $EVE_LOG"
253:         fi
254: 
255:         # Parse event types
256:         print_check "Analyzing event types in eve.json..."
257:         if command -v jq &>/dev/null; then
258:             local event_summary
259:             event_summary=$(tail -1000 "$EVE_LOG" 2>/dev/null | jq -r '.event_type' 2>/dev/null | sort | uniq -c | sort -rn || echo "")
260: 
261:             if [[ -n "$event_summary" ]]; then
262:                 print_pass "Event type distribution (last 1000 events):"
263:                 echo "$event_summary" | while read -r line; do
264:                     print_info "$line"
265:                 done
266: 
267:                 # Check for alerts
268:                 if echo "$event_summary" | grep -q "alert"; then
269:                     print_pass "Alerts are being generated"
270:                 else
271:                     print_warn "No alerts found in recent logs (may be normal if no attacks)"
272:                     print_info "This is expected if there's no malicious traffic"
273:                 fi
274:             else
275:                 print_warn "Could not parse eve.json (may be empty or invalid JSON)"
276:             fi
277:         else
278:             print_warn "jq not installed - skipping JSON analysis"
279:             print_fix "Install jq: sudo yum install jq (RHEL) or sudo apt install jq (Debian)"
280:         fi
281:     else
282:         print_fail "eve.json not found at $EVE_LOG"
283:         print_fix "Check suricata.yaml eve-log configuration"
284:         print_fix "Verify Suricata has write permissions to /var/log/suricata/"
285:         return 1
286:     fi
287: 
288:     print_check "Checking suricata.log for errors..."
289:     if [[ -f "$SURICATA_LOG" ]]; then
290:         local error_count
291:         error_count=$(grep -i "error\|failed\|fatal" "$SURICATA_LOG" 2>/dev/null | tail -10 | wc -l)
292: 
293:         if [[ $error_count -gt 0 ]]; then
294:             print_warn "Found $error_count recent errors in $SURICATA_LOG"
295:             print_info "Last 5 errors:"
296:             grep -i "error\|failed\|fatal" "$SURICATA_LOG" | tail -5 | while read -r line; do
297:                 print_info "  $line"
298:             done
299:             print_fix "Review full log: sudo tail -50 $SURICATA_LOG"
300:         else
301:             print_pass "No recent errors in suricata.log"
302:         fi
303:     fi
304: }
305: 
306: # =============================================================================
307: # CHECK 6: Resource Usage
308: # =============================================================================
309: check_resources() {
310:     print_header "6. Resource Usage Check"
311: 
312:     if systemctl is-active --quiet suricata 2>/dev/null; then
313:         print_check "Checking CPU and memory usage..."
314: 
315:         local pid
316:         pid=$(systemctl show suricata -p MainPID --value 2>/dev/null || echo "")
317: 
318:         if [[ -n "$pid" && "$pid" != "0" ]]; then
319:             # Get CPU and memory
320:             local cpu_mem
321:             cpu_mem=$(ps -p "$pid" -o %cpu,%mem,rss --no-headers 2>/dev/null || echo "")
322: 
323:             if [[ -n "$cpu_mem" ]]; then
324:                 local cpu
325:                 local mem_percent
326:                 local mem_rss
327:                 cpu=$(echo "$cpu_mem" | awk '{print $1}')
328:                 mem_percent=$(echo "$cpu_mem" | awk '{print $2}')
329:                 mem_rss=$(echo "$cpu_mem" | awk '{print $3}')
330:                 mem_mb=$((mem_rss / 1024))
331: 
332:                 print_pass "CPU: ${cpu}%  |  RAM: ${mem_mb}MB (${mem_percent}%)"
333: 
334:                 # Check if within expected ranges
335:                 if (( $(echo "$cpu > 50" | bc -l) )); then
336:                     print_warn "CPU usage is high (>50%) - may need optimization"
337:                     print_fix "Check /install/templates/suricata.yaml.optimized for tuning"
338:                 fi
339: 
340:                 if (( mem_mb > 1024 )); then
341:                     print_warn "Memory usage is high (>1GB) - may need optimization"
342:                     print_fix "Reduce flow timeouts or disable unused protocols"
343:                 fi
344:             else
345:                 print_warn "Could not retrieve CPU/memory stats"
346:             fi
347: 
348:             # Check packet stats
349:             print_check "Checking packet capture statistics..."
350:             if command -v suricatasc &>/dev/null && [[ -S /var/run/suricata/suricata-command.socket ]]; then
351:                 local stats
352:                 stats=$(echo "dump-counters" | suricatasc 2>/dev/null | jq -r '.message.capture.kernel_packets' 2>/dev/null || echo "")
353: 
354:                 if [[ -n "$stats" && "$stats" != "null" ]]; then
355:                     print_pass "Packets captured: $stats"
356:                 fi
357:             fi
358:         fi
359:     else
360:         print_warn "Suricata not running - cannot check resource usage"
361:     fi
362: }
363: 
364: # =============================================================================
365: # CHECK 7: Network Connectivity Test
366: # =============================================================================
367: check_network_test() {
368:     print_header "7. Network Traffic Test"
369: 
370:     print_check "Sending test traffic to trigger detection..."
371:     print_info "Attempting SSH connection to trigger SSH detection rule..."
372: 
373:     # Try to connect to localhost SSH (will trigger SSH detection)
374:     timeout 2 ssh -o ConnectTimeout=1 -o StrictHostKeyChecking=no testuser@localhost 2>/dev/null || true
375: 
376:     sleep 3  # Wait for Suricata to process
377: 
378:     # Check if SSH events were logged
379:     if [[ -f "$EVE_LOG" ]]; then
380:         local ssh_events
381:         ssh_events=$(tail -100 "$EVE_LOG" 2>/dev/null | jq -r 'select(.event_type=="ssh")' 2>/dev/null | wc -l || echo 0)
382: 
383:         if [[ $ssh_events -gt 0 ]]; then
384:             print_pass "SSH events detected in eve.json (Suricata IS capturing traffic)"
385:         else
386:             print_warn "No SSH events found - Suricata may not be capturing traffic"
387:             print_fix "Check interface configuration in suricata.yaml"
388:             print_fix "Verify interface is correct: ip link show"
389:         fi
390:     fi
391: }
392: 
393: # =============================================================================
394: # CHECK 8: NFTBan Integration
395: # =============================================================================
396: check_nftban_integration() {
397:     print_header "8. NFTBan Integration Check"
398: 
399:     print_check "Checking NFTBan configuration..."
400:     local nftban_conf="${NFTBAN_CONFIG_DIR}/nftban.conf"
401: 
402:     if [[ -f "$nftban_conf" ]]; then
403:         if grep -q "NFTBAN_SURICATA_ENABLED" "$nftban_conf" 2>/dev/null; then
404:             local enabled
405:             enabled=$(grep "NFTBAN_SURICATA_ENABLED" "$nftban_conf" | cut -d= -f2 | tr -d '"' || echo "false")
406: 
407:             if [[ "$enabled" == "true" ]]; then
408:                 print_pass "Suricata integration is ENABLED in nftban.conf"
409:             else
410:                 print_warn "Suricata integration is DISABLED in nftban.conf"
411:                 print_fix "Enable: Set NFTBAN_SURICATA_ENABLED=\"true\" in $nftban_conf"
412:             fi
413:         fi
414: 
415:         # Check eve.json path
416:         local eve_path
417:         eve_path=$(grep "NFTBAN_SURICATA_EVE_LOG" "$nftban_conf" 2>/dev/null | cut -d= -f2 | tr -d '"' || echo "")
418:         if [[ -n "$eve_path" ]]; then
419:             if [[ "$eve_path" == "$EVE_LOG" ]]; then
420:                 print_pass "Eve.json path matches: $eve_path"
421:             else
422:                 print_warn "Eve.json path mismatch:"
423:                 print_info "  Config: $eve_path"
424:                 print_info "  Actual: $EVE_LOG"
425:             fi
426:         fi
427:     else
428:         print_warn "NFTBan config not found at $nftban_conf"
429:     fi
430: }
431: 
432: # =============================================================================
433: # SUMMARY
434: # =============================================================================
435: print_summary() {
436:     print_header "SUMMARY"
437: 
438:     echo ""
439:     echo -e "  ${GREEN}✓ Passed:${NC}  $CHECKS_PASSED"
440:     echo -e "  ${YELLOW}! Warnings:${NC} $CHECKS_WARNING"
441:     echo -e "  ${RED}✗ Failed:${NC}  $CHECKS_FAILED"
442:     echo ""
443: 
444:     if [[ $CHECKS_FAILED -eq 0 ]]; then
445:         echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
446:         echo -e "${GREEN}✓ Suricata is properly configured and operational!${NC}"
447:         echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
448: 
449:         if [[ $CHECKS_WARNING -gt 0 ]]; then
450:             echo -e "${YELLOW}Note: There are $CHECKS_WARNING warnings to review above.${NC}"
451:         fi
452:     else
453:         echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
454:         echo -e "${RED}✗ Suricata has $CHECKS_FAILED critical issues that need attention!${NC}"
455:         echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
456:         echo ""
457:         echo "Review the failures above and apply the suggested fixes."
458:     fi
459:     echo ""
460: }
461: 
462: # =============================================================================
463: # MAIN
464: # =============================================================================
465: main() {
466:     echo ""
467:     echo -e "${BLUE}═══════════════════════════════════════════════════════════════════${NC}"
468:     echo -e "${BLUE}   NFTBan v1.0 - Suricata Troubleshooting & Verification${NC}"
469:     echo -e "${BLUE}═══════════════════════════════════════════════════════════════════${NC}"
470:     echo ""
471: 
472:     # Run all checks
473:     check_binary || true
474:     check_service || true
475:     check_config || true
476:     check_rules || true
477:     check_logging || true
478:     check_resources || true
479:     check_network_test || true
480:     check_nftban_integration || true
481: 
482:     # Print summary
483:     print_summary
484: 
485:     # Exit code based on failures
486:     if [[ $CHECKS_FAILED -gt 0 ]]; then
487:         exit 1
488:     else
489:         exit 0
490:     fi
491: }
492: 
493: main "$@"
</file>

<file path="cli/lib/nftban/lib/exporter_utils.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - Exporter Utilities Library
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Common utility functions for Prometheus metrics exporters
  7: # Location: /usr/lib/nftban/lib/exporter_utils.sh
  8: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
  9: # meta:homepage=https://nftban.com
 10: #
 11: # meta:name=exporter_utils
 12: # meta:type=lib
 13: # meta:header=Exporter Utilities Library
 14: # meta:version=1.0.0
 15: #
 16: # **Description & Purpose**
 17: # meta:description=Common utility functions shared across all Prometheus exporters
 18: # meta:input=Metric name, type, help text, values
 19: # meta:output=Prometheus text exposition format
 20: #
 21: # **Functions Provided**
 22: # - write_metric(): Write a metric in Prometheus text exposition format
 23: # - write_metric_simple(): Simple single-value metric writer
 24: # - init_metrics_file(): Initialize an empty metrics file
 25: #
 26: # meta:created_date=2025-12-02
 27: # =============================================================================
 28: 
 29: # Guard against multiple sourcing
 30: [[ -n "${_NFTBAN_EXPORTER_UTILS_LOADED:-}" ]] && return 0
 31: readonly _NFTBAN_EXPORTER_UTILS_LOADED=1
 32: 
 33: # =============================================================================
 34: # METRIC WRITER FUNCTIONS
 35: # =============================================================================
 36: 
 37: # Write a metric with multiple label/value pairs in Prometheus text exposition format
 38: # Usage: write_metric "metric_name" "gauge|counter" "Help text" "{label=\"val\"} 123" ...
 39: # Args:
 40: #   $1 = metric name
 41: #   $2 = metric type (gauge, counter, histogram, summary)
 42: #   $3 = HELP description text
 43: #   $4+ = metric lines (with labels and values)
 44: #
 45: # Example:
 46: #   write_metric "nftban_blocks" "gauge" "Number of blocked IPs" \
 47: #       "{type=\"permanent\"} 100" \
 48: #       "{type=\"temporary\"} 50"
 49: write_metric() {
 50:     local name="$1"
 51:     local type="$2"
 52:     local help="$3"
 53:     shift 3
 54: 
 55:     # Write HELP line
 56:     echo "# HELP ${name} ${help}"
 57:     # Write TYPE line
 58:     echo "# TYPE ${name} ${type}"
 59: 
 60:     # Write all metric values
 61:     for line in "$@"; do
 62:         echo "${name}${line}"
 63:     done
 64: }
 65: 
 66: # Write a simple single-value metric in Prometheus text exposition format
 67: # Usage: write_metric_simple "metric_name" "value" "Help text" ["gauge"|"counter"]
 68: # Args:
 69: #   $1 = metric name (without labels)
 70: #   $2 = metric value
 71: #   $3 = HELP description text (optional)
 72: #   $4 = metric type (default: gauge)
 73: #
 74: # Example:
 75: #   write_metric_simple "nftban_blocks_total" "150" "Total blocked IPs"
 76: write_metric_simple() {
 77:     local name="$1"
 78:     local value="$2"
 79:     local help="${3:-}"
 80:     local type="${4:-gauge}"
 81: 
 82:     # Write HELP line if provided
 83:     if [[ -n "$help" ]]; then
 84:         echo "# HELP ${name} ${help}"
 85:     fi
 86: 
 87:     # Write TYPE line
 88:     echo "# TYPE ${name} ${type}"
 89: 
 90:     # Write metric value
 91:     echo "${name} ${value}"
 92:     echo ""
 93: }
 94: 
 95: # Initialize an empty metrics file for atomic writes
 96: # Usage: init_metrics_file "output_file"
 97: # Returns: Path to temp file (use with atomic move pattern)
 98: init_metrics_file() {
 99:     local output_file="$1"
100:     local tmp_file="${output_file}.$$"
101: 
102:     # Initialize empty temp file
103:     : > "$tmp_file"
104: 
105:     echo "$tmp_file"
106: }
107: 
108: # Atomic move of temp file to final output
109: # Usage: finalize_metrics_file "tmp_file" "output_file" ["permissions"]
110: # Args:
111: #   $1 = temporary file path
112: #   $2 = final output file path
113: #   $3 = permissions (default: 644)
114: finalize_metrics_file() {
115:     local tmp_file="$1"
116:     local output_file="$2"
117:     local permissions="${3:-644}"
118: 
119:     mv "$tmp_file" "$output_file"
120:     chmod "$permissions" "$output_file"
121: }
122: 
123: # =============================================================================
124: # EXPORTS
125: # =============================================================================
126: 
127: export -f write_metric
128: export -f write_metric_simple
129: export -f init_metrics_file
130: export -f finalize_metrics_file
131: 
132: # =============================================================================
133: # LICENSE
134: # =============================================================================
135: # Mozilla Public License 2.0 (MPL-2.0)
136: # Copyright © 2024-2026 NFTBAN Project / Antonios Voulvoulis
137: # Contact: contact@nftban.com | Website: https://nftban.com
138: #
139: # This Source Code Form is subject to the terms of the Mozilla Public
140: # License, v. 2.0. If a copy of the MPL was not distributed with this
141: # file, You can obtain one at https://mozilla.org/MPL/2.0/.
142: # =============================================================================
</file>

<file path="cli/lib/nftban/lib/nftban_distro_config.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBAN DISTRIBUTION CONFIGURATION MODULE
  4: # =============================================================================
  5: # Purpose: Load and parse distribution-specific configuration
  6: # Version: 1.0.0
  7: # Created: 2025-11-16
  8: # Part of: Centralized Distro Config Project
  9: # =============================================================================
 10: 
 11: set -Eeuo pipefail
 12: 
 13: # Prevent double-loading
 14: [[ -n "${NFTBAN_DISTRO_CONFIG_LOADED:-}" ]] && return 0
 15: NFTBAN_DISTRO_CONFIG_LOADED="true"
 16: 
 17: # Configuration paths (allow override for testing)
 18: : "${NFTBAN_DISTRO_CONF_DIR:=/etc/nftban/distros}"
 19: : "${NFTBAN_DISTRO_CONF_LINK:=/etc/nftban/conf.d/distro.conf}"
 20: : "${NFTBAN_DISTRO_CUSTOM_CONF:=/etc/nftban/conf.d/distro-custom.conf}"
 21: 
 22: # Global associative arrays for configuration
 23: declare -gA DISTRO_INFO
 24: declare -gA DISTRO_PKGMGR
 25: declare -gA DISTRO_PACKAGES
 26: declare -gA DISTRO_SERVICES
 27: declare -gA DISTRO_PATHS
 28: declare -gA DISTRO_REPOSITORY
 29: declare -gA DISTRO_FEATURES
 30: 
 31: # =============================================================================
 32: # DETECTION FUNCTIONS
 33: # =============================================================================
 34: 
 35: # Detect current distribution and version
 36: nftban_distro_detect() {
 37:     local os_id=""
 38:     local os_version=""
 39:     local os_version_id=""
 40: 
 41:     # Primary: /etc/os-release (systemd standard)
 42:     if [[ -f /etc/os-release ]]; then
 43:         source /etc/os-release
 44:         os_id="${ID:-unknown}"
 45:         os_version="${VERSION_ID:-unknown}"
 46:         os_version_id="${VERSION_ID:-unknown}"
 47:     # Fallback: /etc/redhat-release
 48:     elif [[ -f /etc/redhat-release ]]; then
 49:         os_id="rhel"
 50:         os_version=$(grep -oP '\d+' /etc/redhat-release | head -1)
 51:         os_version_id="$os_version"
 52:     # Fallback: /etc/debian_version
 53:     elif [[ -f /etc/debian_version ]]; then
 54:         os_id="debian"
 55:         os_version=$(cat /etc/debian_version)
 56:         os_version_id="$os_version"
 57:     else
 58:         echo "ERROR: Cannot detect distribution" >&2
 59:         return 1
 60:     fi
 61: 
 62:     # Normalize OS ID
 63:     case "$os_id" in
 64:         centos|centos-stream) os_id="centos" ;;
 65:         rhel|redhat) os_id="rhel" ;;
 66:         rocky) os_id="rocky" ;;
 67:         almalinux|alma) os_id="almalinux" ;;
 68:         debian) os_id="debian" ;;
 69:         ubuntu) os_id="ubuntu" ;;
 70:         fedora) os_id="fedora" ;;
 71:     esac
 72: 
 73:     echo "${os_id}:${os_version_id}"
 74: }
 75: 
 76: # Find appropriate configuration file
 77: nftban_distro_find_config() {
 78:     local detection="$1"
 79:     local os_id="${detection%%:*}"
 80:     local os_version="${detection##*:}"
 81: 
 82:     # Try exact match first: ubuntu-24.04.conf or centos-stream-9.conf
 83:     local config_file="${NFTBAN_DISTRO_CONF_DIR}/${os_id}-${os_version}.conf"
 84:     if [[ -f "$config_file" ]]; then
 85:         echo "$config_file"
 86:         return 0
 87:     fi
 88: 
 89:     # Try major version: centos-9.conf, ubuntu-24.conf
 90:     local major_version="${os_version%%.*}"
 91:     config_file="${NFTBAN_DISTRO_CONF_DIR}/${os_id}-${major_version}.conf"
 92:     if [[ -f "$config_file" ]]; then
 93:         echo "$config_file"
 94:         return 0
 95:     fi
 96: 
 97:     # Try generic: centos.conf, ubuntu.conf
 98:     config_file="${NFTBAN_DISTRO_CONF_DIR}/${os_id}.conf"
 99:     if [[ -f "$config_file" ]]; then
100:         echo "$config_file"
101:         return 0
102:     fi
103: 
104:     # Helpful error with what was tried
105:     echo "ERROR: No configuration file found for ${os_id} ${os_version}" >&2
106:     echo "       Tried: ${NFTBAN_DISTRO_CONF_DIR}/${os_id}-${os_version}.conf" >&2
107:     echo "              ${NFTBAN_DISTRO_CONF_DIR}/${os_id}-${major_version}.conf" >&2
108:     echo "              ${NFTBAN_DISTRO_CONF_DIR}/${os_id}.conf" >&2
109:     echo "       Config dir: ${NFTBAN_DISTRO_CONF_DIR}" >&2
110:     return 1
111: }
112: 
113: # =============================================================================
114: # CONFIGURATION PARSING
115: # =============================================================================
116: 
117: # Parse INI configuration file
118: nftban_distro_parse_config() {
119:     local config_file="$1"
120:     local current_section=""
121: 
122:     while IFS= read -r line || [[ -n "$line" ]]; do
123:         # Remove leading/trailing whitespace
124:         line="${line#"${line%%[![:space:]]*}"}"
125:         line="${line%"${line##*[![:space:]]}"}"
126: 
127:         # Skip empty lines and comments
128:         [[ -z "$line" || "$line" =~ ^# ]] && continue
129: 
130:         # Section headers: [section]
131:         if [[ "$line" =~ ^\[([^\]]+)\] ]]; then
132:             current_section="${BASH_REMATCH[1]}"
133:             continue
134:         fi
135: 
136:         # Key-value pairs: key = value
137:         if [[ "$line" =~ ^([^=]+)=(.+)$ ]]; then
138:             local key="${BASH_REMATCH[1]}"
139:             local value="${BASH_REMATCH[2]}"
140: 
141:             # Trim whitespace
142:             key="${key#"${key%%[![:space:]]*}"}"
143:             key="${key%"${key##*[![:space:]]}"}"
144:             value="${value#"${value%%[![:space:]]*}"}"
145:             value="${value%"${value##*[![:space:]]}"}"
146: 
147:             # Remove quotes
148:             value="${value#\"}"
149:             value="${value%\"}"
150:             value="${value#\'}"
151:             value="${value%\'}"
152: 
153:             # Store in appropriate associative array
154:             case "$current_section" in
155:                 distro)
156:                     DISTRO_INFO["$key"]="$value"
157:                     ;;
158:                 package_manager)
159:                     DISTRO_PKGMGR["$key"]="$value"
160:                     ;;
161:                 packages)
162:                     DISTRO_PACKAGES["$key"]="$value"
163:                     ;;
164:                 services)
165:                     DISTRO_SERVICES["$key"]="$value"
166:                     ;;
167:                 paths)
168:                     DISTRO_PATHS["$key"]="$value"
169:                     ;;
170:                 repository)
171:                     DISTRO_REPOSITORY["$key"]="$value"
172:                     ;;
173:                 features)
174:                     DISTRO_FEATURES["$key"]="$value"
175:                     ;;
176:             esac
177:         fi
178:     done < "$config_file"
179: }
180: 
181: # =============================================================================
182: # INITIALIZATION
183: # =============================================================================
184: 
185: # Initialize distribution configuration
186: nftban_distro_init() {
187:     # Detect distribution
188:     local detection
189:     detection=$(nftban_distro_detect) || return 1
190: 
191:     # Find configuration file
192:     local config_file
193:     config_file=$(nftban_distro_find_config "$detection") || return 1
194: 
195:     # Parse main configuration
196:     nftban_distro_parse_config "$config_file"
197: 
198:     # Parse custom overrides if exists
199:     if [[ -f "$NFTBAN_DISTRO_CUSTOM_CONF" ]]; then
200:         nftban_distro_parse_config "$NFTBAN_DISTRO_CUSTOM_CONF"
201:     fi
202: 
203:     return 0
204: }
205: 
206: # =============================================================================
207: # HELPER FUNCTIONS
208: # =============================================================================
209: 
210: # Get package name for current distribution
211: nftban_distro_get_package() {
212:     local package_name="$1"
213:     echo "${DISTRO_PACKAGES[$package_name]:-}"
214: }
215: 
216: # Get service name for current distribution
217: nftban_distro_get_service() {
218:     local service_name="$1"
219:     echo "${DISTRO_SERVICES[$service_name]:-}"
220: }
221: 
222: # Get binary path for current distribution
223: nftban_distro_get_path() {
224:     local path_name="$1"
225:     echo "${DISTRO_PATHS[$path_name]:-}"
226: }
227: 
228: # Get package manager command
229: nftban_distro_get_pkgmgr_cmd() {
230:     local cmd_type="$1"  # install_cmd, update_cmd, etc.
231:     echo "${DISTRO_PKGMGR[$cmd_type]:-}"
232: }
233: 
234: # Install packages using distribution's package manager
235: nftban_distro_install_packages() {
236:     local packages=("$@")
237:     local install_cmd
238:     install_cmd=$(nftban_distro_get_pkgmgr_cmd "install_cmd")
239: 
240:     if [[ -z "$install_cmd" ]]; then
241:         echo "ERROR: Package manager install command not configured" >&2
242:         return 1
243:     fi
244: 
245:     # Execute installation
246:     $install_cmd "${packages[@]}"
247: }
248: 
249: # Restart service using correct service name
250: nftban_distro_restart_service() {
251:     local service_key="$1"
252:     local service_name
253:     service_name=$(nftban_distro_get_service "$service_key")
254: 
255:     if [[ -z "$service_name" ]]; then
256:         echo "ERROR: Service '$service_key' not found in configuration" >&2
257:         return 1
258:     fi
259: 
260:     systemctl restart "$service_name"
261: }
262: 
263: # Check if a package is installed
264: nftban_distro_is_package_installed() {
265:     local package="$1"
266: 
267:     # Get query command from config
268:     local query_cmd="${DISTRO_PKGMGR[query_cmd]:-}"
269: 
270:     if [[ -z "$query_cmd" ]]; then
271:         echo "ERROR: No query_cmd configured" >&2
272:         return 1
273:     fi
274: 
275:     # Execute query based on package manager type
276:     case "$query_cmd" in
277:         *dpkg*)
278:             dpkg -l "$package" 2>/dev/null | grep -q "^ii"
279:             ;;
280:         *rpm*)
281:             rpm -qa | grep -q "^${package}"
282:             ;;
283:         *)
284:             echo "ERROR: Unsupported query command: $query_cmd" >&2
285:             return 1
286:             ;;
287:     esac
288: }
289: 
290: # Show current configuration (diagnostic)
291: nftban_distro_show_config() {
292:     echo "=== Distribution Configuration ==="
293:     echo ""
294:     echo "[Distribution Info]"
295:     for key in "${!DISTRO_INFO[@]}"; do
296:         echo "  $key = ${DISTRO_INFO[$key]}"
297:     done | sort
298:     echo ""
299:     echo "[Package Manager]"
300:     for key in "${!DISTRO_PKGMGR[@]}"; do
301:         echo "  $key = ${DISTRO_PKGMGR[$key]}"
302:     done | sort
303:     echo ""
304:     echo "[Packages]"
305:     for key in "${!DISTRO_PACKAGES[@]}"; do
306:         echo "  $key = ${DISTRO_PACKAGES[$key]}"
307:     done | sort
308:     echo ""
309:     echo "[Services]"
310:     for key in "${!DISTRO_SERVICES[@]}"; do
311:         echo "  $key = ${DISTRO_SERVICES[$key]}"
312:     done | sort
313:     echo ""
314:     echo "[Paths]"
315:     for key in "${!DISTRO_PATHS[@]}"; do
316:         echo "  $key = ${DISTRO_PATHS[$key]}"
317:     done | sort
318:     echo ""
319:     echo "[Repository]"
320:     for key in "${!DISTRO_REPOSITORY[@]}"; do
321:         echo "  $key = ${DISTRO_REPOSITORY[$key]}"
322:     done | sort
323:     echo ""
324:     echo "[Features]"
325:     for key in "${!DISTRO_FEATURES[@]}"; do
326:         echo "  $key = ${DISTRO_FEATURES[$key]}"
327:     done | sort
328: }
329: 
330: # =============================================================================
331: # AUTO-INITIALIZE ON SOURCE
332: # =============================================================================
333: 
334: # Auto-initialize when module is loaded (unless disabled)
335: if [[ "${NFTBAN_DISTRO_AUTO_INIT:-true}" == "true" ]]; then
336:     nftban_distro_init || {
337:         echo "WARNING: Failed to initialize distribution configuration" >&2
338:     }
339: fi
340: 
341: return 0 2>/dev/null || :
</file>


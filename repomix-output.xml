 522: // parseSetElements extracts IP addresses and ranges from nft list output
 523: func (m *NFTManager) parseSetElements(output string) []string {
 524: 	var elements []string
 525: 
 526: 	// Find the elements section
 527: 	elemStart := strings.Index(output, "elements = {")
 528: 	if elemStart == -1 {
 529: 		return elements
 530: 	}
 531: 
 532: 	// Find closing brace
 533: 	elemEnd := strings.LastIndex(output, "}")
 534: 	if elemEnd == -1 || elemEnd <= elemStart {
 535: 		return elements
 536: 	}
 537: 
 538: 	// Extract content between braces
 539: 	content := output[elemStart+len("elements = {") : elemEnd]
 540: 
 541: 	// Split by comma and clean up
 542: 	parts := strings.Split(content, ",")
 543: 	for _, part := range parts {
 544: 		elem := strings.TrimSpace(part)
 545: 		// Skip empty or invalid entries
 546: 		if elem == "" {
 547: 			continue
 548: 		}
 549: 		// Remove timeout info like "timeout 1h expires 30m"
 550: 		if idx := strings.Index(elem, " timeout"); idx != -1 {
 551: 			elem = elem[:idx]
 552: 		}
 553: 		if idx := strings.Index(elem, " expires"); idx != -1 {
 554: 			elem = elem[:idx]
 555: 		}
 556: 		elem = strings.TrimSpace(elem)
 557: 		if elem != "" && (strings.Contains(elem, ".") || strings.Contains(elem, ":")) {
 558: 			elements = append(elements, elem)
 559: 		}
 560: 	}
 561: 
 562: 	return elements
 563: }

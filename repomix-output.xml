<file path="cli/lib/nftban/tests/test_metrics_integration.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v0.6.0 - Metrics Integration Test Suite
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: End-to-end integration testing of metrics system
  7: # Location: /usr/share/nftban/tests/test_metrics_integration.sh
  8: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
  9: # meta:homepage=https://nftban.com
 10: #
 11: # meta:name=test_metrics_integration
 12: # meta:type=testing
 13: # meta:header=Metrics Integration Tests
 14: # meta:version=0.6.0
 15: #
 16: # meta:created_date=2025-11-17
 17: # =============================================================================
 18: 
 19: set -Eeuo pipefail
 20: IFS=$'\n\t'
 21: 
 22: # Colors
 23: readonly RED='\033[0;31m'
 24: readonly GREEN='\033[0;32m'
 25: readonly YELLOW='\033[1;33m'
 26: readonly BLUE='\033[0;34m'
 27: readonly NC='\033[0m'
 28: 
 29: # Test counters
 30: TESTS_RUN=0
 31: TESTS_PASSED=0
 32: TESTS_FAILED=0
 33: TESTS_SKIPPED=0

252:         card.style.display = name.includes(search) ? '' : 'none';
253:     });
254: }
255: 
256: function logMsg(msg, type = 'info') {
257:     const logCard = document.getElementById('feeds-log-card');
258:     const logEl = document.getElementById('feeds-log');
259:     logCard.style.display = 'block';
260:     const time = new Date().toLocaleTimeString();
261:     const color = type === 'error' ? '#ef4444' : type === 'success' ? '#22c55e' : '#0f0';
262:     logEl.innerHTML += `<div style="color: ${color}">[${time}] ${msg}</div>`;
263:     logEl.scrollTop = logEl.scrollHeight;
264: }
265: 
266: async function toggleFeed(feedId, enable) {
267:     const action = enable ? 'enable' : 'disable';
268:     const feedName = feedId.toUpperCase();
269: 
270:     logMsg(`${action === 'enable' ? 'Enabling' : 'Disabling'} feed: ${feedName}...`);
271: 
272:     try {
273:         const response = await apiRequest('/feeds/control', {
274:             method: 'POST',
275:             body: JSON.stringify({ action: action, feed: feedId })
276:         });
277: 
278:         if (response.success) {
279:             logMsg(`✓ Feed ${feedName} ${action}d successfully`, 'success');
280:             if (enable) {
281:                 logMsg(`Downloading IP list for ${feedName}...`);
282:             }
283:             setTimeout(() => {
284:                 loadFeedsData();
285:                 logMsg(`✓ Stats updated`, 'success');
286:             }, 1500);
287:         } else {
288:             logMsg(`✗ Failed: ${response.error || 'Unknown error'}`, 'error');
289:             const toggle = document.querySelector(`input[data-feed="${feedId}"]`);
290:             if (toggle) toggle.checked = !enable;
291:         }
292:     } catch (err) {
293:         logMsg(`✗ Error: ${err.message}`, 'error');
294:         const toggle = document.querySelector(`input[data-feed="${feedId}"]`);
295:         if (toggle) toggle.checked = !enable;
296:     }
297: }
298: 
299: async function updateAllFeeds() {
300:     logMsg('Updating all enabled feeds...');
301:     logMsg('This may take a moment, please wait...');
302: 
303:     try {
304:         const response = await apiRequest('/sync-feeds', { method: 'POST' });
305: 
306:         if (response.success) {
307:             logMsg('✓ All feeds updated successfully', 'success');
308:             setTimeout(() => {
309:                 loadFeedsData();
310:                 logMsg('✓ Stats refreshed', 'success');
311:             }, 1500);
312:         } else {
313:             logMsg(`✗ Failed: ${response.error || 'Unknown error'}`, 'error');
314:         }
315:     } catch (err) {
316:         logMsg(`✗ Error: ${err.message}`, 'error');
317:     }
318: }
319: 
320: // Initialize
321: loadFeedsData();
322: 
323: // Auto-refresh every 60 seconds
324: setInterval(loadFeedsData, 60000);
325: </script>

# meta:description="Timer for automatic rollback after apply"
# meta:input="None"
# meta:output="Systemd unit"
# meta:depends=""
# meta:inventory.files=""
# meta:inventory.binaries=""
# meta:inventory.env_vars=""
# meta:inventory.config_files=""
# meta:inventory.systemd_units="nftban-rollback.service"
# meta:inventory.network=""
# meta:inventory.privileges="root"
# =============================================================================

[Unit]
Description=NFTBan Automatic Rollback Timer
Documentation=man:nftban(8)
Documentation=https://nftban.com/docs
PartOf=nftban-rollback.service

[Timer]
# Trigger 5 minutes after nftban-apply starts the timer
# (nftban-apply starts this timer, nftban-confirm stops it)
OnActiveSec=5min
AccuracySec=10s

# CRITICAL: Jitter prevents synchronized rollback waves across fleet
# If 10 servers apply changes simultaneously, rollbacks should NOT fire together
RandomizedDelaySec=30s

[Install]
# NOTE: Do NOT auto-enable. Timer is started by nftban-apply and stopped by nftban-confirm.
# Auto-enabling causes failures on fresh install (no backup.rules exists yet).
# WantedBy=timers.target

 990: 			})
 991: 			return
 992: 		}
 993: 
 994: 		// Check if file exists
 995: 		if _, err := os.Stat(logFile); os.IsNotExist(err) {
 996: 			respondJSON(w, http.StatusOK, map[string]interface{}{
 997: 				"success":       true,
 998: 				"log_type":      logType,
 999: 				"lines":         []string{},
1000: 				"total_lines":   0,
1001: 				"visible_lines": 0,
1002: 				"message":       "Log file does not exist yet",
1003: 			})
1004: 			return
1005: 		}
1006: 
1007: 		// Read with tail/grep
1008: 		var output string
1009: 		var err error
1010: 
1011: 		if searchFilter != "" {
1012: 			output, err = execCommand("sh", "-c", fmt.Sprintf("tail -n %d %s | grep -i '%s'", lines, logFile, searchFilter))
1013: 		} else {
1014: 			output, err = execCommand("tail", "-n", strconv.Itoa(lines), logFile)
1015: 		}
1016: 
1017: 		if err != nil && searchFilter != "" && output == "" {

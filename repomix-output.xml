 963:             const cls = c.status === 'OK' ? 'status-ok' : c.status === 'WARNING' ? 'status-warning' : 'status-error';
 964:             html += `<tr><td>${c.name}</td><td class="${cls}">${c.status}</td><td style="font-size:12px;">${c.details || ''}</td></tr>`;
 965:         });
 966:         html += '</tbody></table>';
 967:     }
 968: 
 969:     container.innerHTML = html;
 970: }

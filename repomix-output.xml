 314: # Parse /proc/net/dev for interface statistics
 315: get_interface_stats() {
 316:     local interface=$1
 317:     local stats
 318: 
 319:     # Read stats from /proc/net/dev
 320:     stats=$(grep -E "^\\s*${interface}:" /proc/net/dev 2>/dev/null || echo "")
 321: 
 322:     if [[ -z "$stats" ]]; then
 323:         return 1
 324:     fi
 325: 
 326:     # Remove interface name and extract values
 327:     stats=$(echo "$stats" | sed 's/^[^:]*://' | tr -s ' ')
 328: 
 329:     # Extract relevant fields
 330:     local rx_bytes
 331:     local rx_packets
 332:     local tx_bytes
 333:     local tx_packets
 334:     rx_bytes=$(echo "$stats" | awk '{print $1}')
 335:     rx_packets=$(echo "$stats" | awk '{print $2}')
 336:     tx_bytes=$(echo "$stats" | awk '{print $9}')
 337:     tx_packets=$(echo "$stats" | awk '{print $10}')
 338: 
 339:     echo "${rx_bytes} ${rx_packets} ${tx_bytes} ${tx_packets}"
 340: }

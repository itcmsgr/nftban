 638: nftban_watchdog_run_all() {
 639:     # Execute all enabled checks
 640:     # Returns: highest severity status
 641: 
 642:     # Clear previous results
 643:     WATCHDOG_RESULTS=()
 644:     WATCHDOG_ALERTS=()
 645: 
 646:     local overall_status=$WATCHDOG_OK
 647:     local status
 648: 
 649:     # Run all checks
 650:     nftban_watchdog_check_load
 651:     status=$?
 652:     [[ $status -gt $overall_status ]] && overall_status=$status
 653: 
 654:     nftban_watchdog_check_memory
 655:     status=$?
 656:     [[ $status -gt $overall_status ]] && overall_status=$status
 657: 
 658:     nftban_watchdog_check_iowait
 659:     status=$?
 660:     [[ $status -gt $overall_status ]] && overall_status=$status
 661: 
 662:     nftban_watchdog_check_disk
 663:     status=$?
 664:     [[ $status -gt $overall_status ]] && overall_status=$status
 665: 
 666:     nftban_watchdog_check_fd
 667:     status=$?
 668:     [[ $status -gt $overall_status ]] && overall_status=$status
 669: 
 670:     nftban_watchdog_get_top_cpu
 671:     nftban_watchdog_get_top_mem
 672: 
 673:     # Store overall status
 674:     WATCHDOG_RESULTS[overall_status]="$overall_status"
 675:     WATCHDOG_RESULTS[check_timestamp]=$(date +%s)
 676:     WATCHDOG_RESULTS[check_datetime]=$(date '+%Y-%m-%d %H:%M:%S')
 677: 
 678:     return $overall_status
 679: }

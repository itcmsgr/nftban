335:         echo "    nftban whitelist add $ip"
336:     else
337:         echo "  Ban temporarily (1 hour):"
338:         echo "    nftban ban $ip --timeout 3600"
339:         echo ""
340:         echo "  Ban permanently:"
341:         echo "    nftban ban $ip"

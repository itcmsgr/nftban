#!/bin/bash
# =============================================================================
# NFTBan v0.30.0 - DEB Post-Install Script
# =============================================================================
# SPDX-License-Identifier: MPL-2.0
# Purpose: Post-installation configuration for DEB packages
# =============================================================================

set -e

case "$1" in
    configure)
        # Create nftban user and nftban-cli group if they don't exist
        if ! getent passwd nftban >/dev/null; then
            adduser --system --group --no-create-home --home /nonexistent \
                --shell /usr/sbin/nologin nftban
        fi

        if ! getent group nftban-cli >/dev/null; then
            addgroup --system nftban-cli
        fi

        # Create auditors group for v0.30 inventory helpers
        if ! getent group auditors >/dev/null; then
            addgroup --system auditors
        fi

        # Generate system.conf with UID/GID
        NFTBAN_UID=$(id -u nftban)
        NFTBAN_GID=$(id -g nftban)
        NFTBAN_CLI_GID=$(getent group nftban-cli | cut -d: -f3)

        mkdir -p /var/lib/nftban/config
        cat > /var/lib/nftban/config/system.conf <<EOF
# =============================================================================
# NFTBan System Configuration (AUTO-GENERATED - DO NOT EDIT)
# =============================================================================
# Generated: $(date -u +"%Y-%m-%d %H:%M:%S UTC")
# Hostname: $(hostname)
#
# ⚠️  WARNING: DO NOT EDIT THIS FILE MANUALLY
# This file MUST stay aligned with actual system UID/GID values.
# =============================================================================

NFTBAN_USER="nftban"
NFTBAN_UID=${NFTBAN_UID}
NFTBAN_GROUP="nftban"
NFTBAN_GID=${NFTBAN_GID}
NFTBAN_CLI_GROUP="nftban-cli"
NFTBAN_CLI_GID=${NFTBAN_CLI_GID}
EOF

        chmod 0644 /var/lib/nftban/config/system.conf

        # Fix /etc/nftban ownership and permissions (daemon readable)
        chown root:nftban /etc/nftban
        chown root:nftban /etc/nftban/conf.d
        chgrp -R nftban /etc/nftban
        find /etc/nftban -type d -exec chmod 0750 {} \;
        find /etc/nftban -type f -exec chmod 0640 {} \;
        # Secrets directory is root-only
        chmod 0700 /etc/nftban/secrets.d

        # Fix /var ownership
        chown -R nftban:nftban /var/lib/nftban
        chown -R nftban:nftban /var/cache/nftban
        chown -R nftban:nftban /var/log/nftban

        # Set proper permissions on /var directories
        chmod 0755 /var/lib/nftban
        chmod 0750 /var/lib/nftban/{state,snapshots,feeds,keyring,backup,reports,metrics,config}
        chmod 0750 /var/log/nftban
        chmod 0755 /var/cache/nftban

        # Create and set permissions for v0.30 directories
        mkdir -p /var/lib/nftban/reports/baseline
        mkdir -p /etc/nftban/keys
        chown nftban:nftban /var/lib/nftban/reports/baseline
        chmod 0755 /var/lib/nftban/reports/baseline
        chmod 0700 /etc/nftban/keys

        # Print installation message
        echo ""
        echo "╔════════════════════════════════════════════════════════════╗"
        echo "║  NFTBan v0.30.0 Installation Complete!                    ║"
        echo "╚════════════════════════════════════════════════════════════╝"
        echo ""
        echo "Next steps:"
        echo "  1. Review config: /etc/nftban/nftban.conf"
        echo "  2. Customize (optional): /etc/nftban/nftban.conf.local"
        echo "  3. Enable service: systemctl enable --now nftban.timer"
        echo "  4. Check health: nftban health check"
        echo "  5. Try inventory: nftban-health --inventory | jq ."
        echo "  6. Create baseline: nftban-baseline-save"
        echo ""
        ;;
esac

#DEBHELPER#

exit 0

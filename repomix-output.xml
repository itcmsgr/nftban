137: nftban_geoip_cmd_lookup() {
138:     # Lookup single IP address via nftban-core
139:     # Args: $1 = IP address, $2 = format (optional: json|compact|country)
140: 
141:     local ip="${1:-}"
142:     local format="${2:-compact}"
143: 
144:     if [[ -z "$ip" ]]; then
145:         echo "ERROR: IP address required" >&2
146:         echo "Usage: nftban geoip lookup <IP> [json|compact|country]" >&2
147:         return 1
148:     fi
149: 
150:     # Use nftban-core geoip lookup command
151:     local nftban_core_bin="${NFTBAN_CORE_BIN:-${NFTBAN_LIB_DIR}/bin/nftban-core}"
152: 
153:     # Fallback: try to find nftban-core in PATH
154:     if [[ ! -x "$nftban_core_bin" ]]; then
155:         nftban_core_bin=$(command -v nftban-core 2>/dev/null || echo "")
156:     fi
157: 
158:     if [[ -z "$nftban_core_bin" || ! -x "$nftban_core_bin" ]]; then
159:         echo "ERROR: nftban-core binary not found" >&2
160:         echo "" >&2
161:         echo "The 'geoip lookup' command requires the nftban-core Go binary." >&2
162:         echo "Expected location: ${NFTBAN_LIB_DIR}/bin/nftban-core" >&2
163:         echo "" >&2
164:         echo "This happens in CLI-only mode (bash scripts only)." >&2
165:         echo "" >&2
166:         echo "Solutions:" >&2
167:         echo "  1. Install full NFTBan package:" >&2
168:         echo "     dnf install nftban  (or: apt install nftban)" >&2
169:         echo "" >&2
170:         echo "  2. Check if binary exists:" >&2
171:         echo "     ls -la ${NFTBAN_LIB_DIR}/bin/nftban-core" >&2
172:         echo "" >&2
173:         return 1
174:     fi
175: 
176:     case "$format" in
177:         json)
178:             # JSON format for GUI/API
179:             "$nftban_core_bin" geoip lookup "$ip" --json
180:             ;;
181:         compact)
182:             # Full format: CC/City/Timezone
183:             "$nftban_core_bin" geoip lookup "$ip"
184:             ;;
185:         country)
186:             # Country only
187:             "$nftban_core_bin" geoip lookup "$ip" 2>/dev/null | cut -d'/' -f1 || echo "Unknown"
188:             ;;
189:         *)
190:             echo "ERROR: Invalid format: $format" >&2
191:             echo "Valid formats: json, compact, country" >&2
192:             return 1
193:             ;;
194:     esac
195: }

 72: 
 73: show_usage() {
 74:     cat << EOF
 75: Usage: $0 [MODE]
 76: 
 77: Automated NFTBan metrics deployment script.
 78: 
 79: MODES:
 80:   local         Deploy with local Prometheus + Grafana (default)
 81:   grafana-cloud Deploy with Grafana Cloud (remote write)
 82:   minimal       Deploy only exporter + Node Exporter (no Prometheus/Grafana)
 83: 
 84: EXAMPLES:
 85:   $0                    # Deploy with local Prometheus + Grafana
 86:   $0 local              # Same as above
 87:   $0 grafana-cloud      # Deploy with Grafana Cloud
 88:   $0 minimal            # Minimal deployment
 89: 
 90: REQUIREMENTS:
 91:   - Root privileges
 92:   - NFTBan v1.0.0+ installed
 93:   - Internet connection (for package downloads)
 94: 
 95: WHAT THIS SCRIPT DOES:
 96:   1. Enables and starts NFTBan metrics exporter
 97:   2. Installs and configures Node Exporter
 98:   3. Installs and configures Prometheus (local mode)
 99:   4. Installs Grafana (optional)
100:   5. Provisions Grafana dashboards
101:   6. Configures Prometheus datasource
102:   7. Validates entire stack
103:   8. Runs integration tests
104: 
105: EOF
106: }
107: 
108: # =============================================================================
109: # DEPLOYMENT STEPS
110: # =============================================================================
111: 
112: step1_enable_exporter() {
113:     print_step "1" "Enable NFTBan Metrics Exporter"
114: 
115:     # Check if exporter is installed
116:     if [[ ! -f "/usr/lib/nftban/exporters/nftban_prometheus_exporter.sh" ]]; then
117:         print_error "NFTBan metrics exporter not found"
118:         print_info "Install NFTBan v1.0.0+ first"
119:         exit 1
120:     fi
121: 
122:     print_info "Found NFTBan prometheus exporter"
123: 
124:     # Enable and start timer
125:     if systemctl list-unit-files | grep -q "nftban-metrics-exporter.timer"; then
126:         systemctl enable nftban-metrics-exporter.timer
127:         systemctl start nftban-metrics-exporter.timer
128:         print_status "Metrics exporter timer enabled and started"
129: 
130:         # Run exporter once to create initial metrics
131:         print_info "Running exporter to generate initial metrics..."
132:         /usr/lib/nftban/exporters/nftban_prometheus_exporter.sh || true
133:         print_status "Initial metrics generated"
134:     else
135:         print_error "Metrics exporter systemd units not found"
136:         exit 1
137:     fi
138: 
139:     # Verify metrics file created
140:     if [[ -f "/var/lib/node_exporter/textfile_collector/nftban.prom" ]]; then
141:         print_status "Metrics file created successfully"
142:     else
143:         print_warn "Metrics file not yet created (will be created on next run)"
144:     fi
145: }
146: 
147: step2_install_node_exporter() {
148:     print_step "2" "Install and Configure Node Exporter"
149: 
150:     if [[ -f "$SCRIPT_DIR/install_node_exporter.sh" ]]; then
151:         print_info "Running Node Exporter installation..."
152:         "$SCRIPT_DIR/install_node_exporter.sh"
153:         print_status "Node Exporter installation complete"
154:     else
155:         print_error "install_node_exporter.sh not found at: $SCRIPT_DIR"
156:         exit 1
157:     fi
158: 
159:     # Validate
160:     if [[ -f "$SCRIPT_DIR/validate_node_exporter.sh" ]]; then
161:         print_info "Validating Node Exporter..."
162:         if "$SCRIPT_DIR/validate_node_exporter.sh"; then
163:             print_status "Node Exporter validation passed"
164:         else
165:             print_warn "Node Exporter validation had warnings (may be OK)"
166:         fi
167:     fi
168: }

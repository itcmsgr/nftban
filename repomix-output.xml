 307: nftban_login_cmd_enable() {
 308:     # Enable monitoring for specific type or service
 309:     # Usage: nftban login enable [ssh|su|sudo|console|service|all]
 310: 
 311:     local target="${1:-}"
 312:     local config_local="${NFTBAN_CONFIG_DIR:-/etc/nftban}/conf.d/login_alert.conf.local"
 313: 
 314:     if [[ $EUID -ne 0 ]]; then
 315:         echo "ERROR: Requires root privileges" >&2
 316:         return 1
 317:     fi
 318: 
 319:     # Ensure local config exists
 320:     if [[ ! -f "$config_local" ]]; then
 321:         mkdir -p "$(dirname "$config_local")"
 322:         echo "# NFTBan Login Alert - User Overrides" > "$config_local"
 323:         echo "# This file overrides defaults from login_alert.conf" >> "$config_local"
 324:         chmod 640 "$config_local"
 325:         chown root:nftban "$config_local" 2>/dev/null || true
 326:     fi
 327: 
 328:     case "$target" in
 329:         ssh)
 330:             _nftban_login_set_config "NFTBAN_LOGIN_ALERT_SSH" "true" "$config_local"
 331:             echo "✅ SSH login monitoring enabled"
 332:             ;;
 333:         su)
 334:             _nftban_login_set_config "NFTBAN_LOGIN_ALERT_SU" "true" "$config_local"
 335:             echo "✅ SU login monitoring enabled"
 336:             ;;
 337:         sudo)
 338:             _nftban_login_set_config "NFTBAN_LOGIN_ALERT_SUDO" "true" "$config_local"
 339:             echo "✅ SUDO monitoring enabled"
 340:             ;;
 341:         console)
 342:             _nftban_login_set_config "NFTBAN_LOGIN_ALERT_CONSOLE" "true" "$config_local"
 343:             echo "✅ Console login monitoring enabled"
 344:             ;;
 345:         all)
 346:             _nftban_login_set_config "NFTBAN_LOGIN_ALERT_ENABLED" "true" "$config_local"
 347:             _nftban_login_set_config "NFTBAN_LOGIN_ALERT_SSH" "true" "$config_local"
 348:             _nftban_login_set_config "NFTBAN_LOGIN_ALERT_SU" "true" "$config_local"
 349:             _nftban_login_set_config "NFTBAN_LOGIN_ALERT_SUDO" "true" "$config_local"
 350:             echo "✅ All login monitoring enabled (ssh, su, sudo)"
 351:             ;;
 352:         service|"")
 353:             # Enable and start systemd service (auto-install if needed)
 354:             if [[ ! -f "/etc/systemd/system/${NFTBAN_SERVICE_LOGIN_MONITOR:-nftban-login-monitor.service}" ]]; then
 355:                 echo "Installing login monitor service..."
 356:                 nftban_login_cmd_install >/dev/null 2>&1
 357:                 echo "✅ Service installed"
 358:             fi
 359:             _nftban_login_set_config "NFTBAN_LOGIN_ALERT_ENABLED" "true" "$config_local"
 360:             _nftban_login_set_config "NFTBAN_LOGIN_ALERT_SSH" "true" "$config_local"
 361:             systemctl enable ${NFTBAN_SERVICE_LOGIN_MONITOR:-nftban-login-monitor.service} >/dev/null 2>&1
 362:             systemctl start ${NFTBAN_SERVICE_LOGIN_MONITOR:-nftban-login-monitor.service}
 363:             echo "✅ Login monitoring enabled and started (SSH alerts active)"
 364:             ;;
 365:         *)
 366:             echo "ERROR: Unknown target: $target" >&2
 367:             echo "Usage: nftban login enable [ssh|su|sudo|console|service|all]" >&2
 368:             return 1
 369:             ;;
 370:     esac
 371: }

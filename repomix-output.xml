414: // restoreRuntimeSets re-adds runtime elements after atomic reload (v0.7.3)
415: func restoreRuntimeSets(runtime *RuntimeSets) error {
416: 	// v0.7.3: temp_whitelist moved to main tables (ip/ip6 nftban)
417: 	// v0.7.3: temp bans handled via CLI (tracks timeout metadata externally)
418: 
419: 	// Restore temp_whitelist_ipv4 (v0.7.3: in main table ip nftban)
420: 	for _, ip := range runtime.Whitelist.IPv4 {
421: 		cmd := exec.Command("nft", "add", "element", "ip", "nftban", "temp_whitelist_ipv4", fmt.Sprintf("{ %s }", ip))
422: 		if err := cmd.Run(); err != nil {
423: 			fmt.Printf("WARNING: Failed to restore whitelist %s: %v\n", ip, err)
424: 		}
425: 	}
426: 
427: 	// Restore temp_whitelist_ipv6 (v0.7.3: in main table ip6 nftban)
428: 	for _, ip := range runtime.Whitelist.IPv6 {
429: 		cmd := exec.Command("nft", "add", "element", "ip6", "nftban", "temp_whitelist_ipv6", fmt.Sprintf("{ %s }", ip))
430: 		if err := cmd.Run(); err != nil {
431: 			fmt.Printf("WARNING: Failed to restore whitelist %s: %v\n", ip, err)
432: 		}
433: 	}
434: 
435: 	// NOTE: Temporary bans no longer restored here in v0.7.3
436: 	// Rationale: Temp bans are in unified blacklist_ipv4/ipv6 with timeout
437: 	// nft-sync loads blacklist from config files (which includes active bans)
438: 	// Fail2Ban re-adds bans via CLI if they're still active
439: 	// This prevents stale ban restoration and ensures metadata consistency
440: 
441: 	return nil
442: }

[Unit]
Description=NFTBan Firewall Initialization (with startup delay)
Documentation=man:nftban(8)
After=network-online.target nftables.service
Wants=network-online.target
# NOTE: Don't use Before=sshd.service (would delay SSH)

[Service]
Type=forking
RemainAfterExit=yes

# CRITICAL: Set environment variable to enable 5-minute startup delay
Environment="NFTBAN_SYSTEMD_BOOT=1"

# Set PATH to ensure we find nft command (works on RHEL, Debian, Ubuntu)
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Run as root (firewall init requires root privileges)
User=root
Group=root

# SECURITY FIX: Do NOT use EnvironmentFile with bash -c variable interpolation
# Previous code had CRITICAL command injection vulnerability (CWE-78)
# Attacker could set: NFTBAN_STARTUP_DELAY='0 ]; rm -rf / #'
# This would execute: bash -c 'if [ "0 ]; rm -rf / #" -eq 0 ]; ...'
# Result: System wiped as root on boot
#
# FIX: Call immutable helper script directly (no variable interpolation)
# Helper script validates input before use (blocks injection)
ExecStart=/usr/lib/nftban/helpers/firewall-init-with-delay.sh

# NOTE: Snapshot save will be done by snapshot timer (not here)

# On stop, flush firewall (safety measure)
ExecStop=/bin/sh -c 'command -v nft >/dev/null 2>&1 && nft flush ruleset || true'

# Don't restart on failure (would cause loops)
Restart=no

# Security hardening (minimal - service needs root for firewall ops)
PrivateTmp=yes
ProtectHome=yes
NoNewPrivileges=no
# Note: Cannot use ProtectSystem=strict (needs to write to /var/lib/nftban)
ReadWritePaths=/var/lib/nftban /var/log/nftban /var/cache/nftban /run/nftban

[Install]
WantedBy=multi-user.target

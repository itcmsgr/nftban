NIKTO|Nikto|useragent|1|60|86400|true|Nikto - vulnerability scanner
WPSCAN|WPScan|useragent|1|60|86400|true|WPScan - WordPress scanner
DIRBUSTER|DirBuster|useragent|1|60|86400|true|DirBuster - directory scanner
GOBUSTER|gobuster|useragent|1|60|86400|true|Gobuster - directory scanner
NUCLEI|nuclei|useragent|1|60|86400|true|Nuclei vulnerability scanner
HTTPX|httpx|useragent|3|60|7200|true|ProjectDiscovery httpx scanner

# =============================================================================
# GENERIC SCRAPERS AND BOTS
# =============================================================================
PYTHON_REQUESTS|python-requests|useragent|50|300|1800|false|Python requests library
PYTHON_URLLIB|Python-urllib|useragent|50|300|1800|false|Python urllib library
CURL_UA|curl/|useragent|100|300|900|false|Curl user agent
WGET_UA|Wget/|useragent|100|300|900|false|Wget user agent
JAVA_UA|Java/|useragent|50|300|1800|false|Java HTTP client
LIBWWW|libwww|useragent|50|300|1800|false|Perl LWP library

# =============================================================================
# HEADLESS BROWSERS (Often used for scraping)
# =============================================================================
HEADLESS_CHROME|HeadlessChrome|useragent|30|120|3600|false|Headless Chrome
PHANTOMJS|PhantomJS|useragent|20|60|7200|true|PhantomJS headless browser
SELENIUM|Selenium|useragent|20|60|7200|false|Selenium automation

# =============================================================================
# EMPTY OR SUSPICIOUS USER AGENTS
# =============================================================================
EMPTY_UA|-$|useragent|20|60|3600|true|Empty user agent
SINGLE_DASH|^-$|useragent|20|60|3600|true|Single dash user agent


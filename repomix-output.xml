<file path="pkg/metrics/nftban.go">
  1: // Package metrics provides Prometheus metrics for NFTBan operations
  2: // This file contains application-level metrics for ban/unban operations,
  3: // feed loading, sync operations, and authentication
  4: package metrics
  5: 
  6: import (
  7: 	"sync"
  8: 
  9: 	"github.com/prometheus/client_golang/prometheus"
 10: 	"github.com/prometheus/client_golang/prometheus/promauto"
 11: )
 12: 
 13: // =============================================================================
 14: // NFTBan Operation Metrics
 15: // =============================================================================
 16: // These metrics track ban/unban operations, feed loading, sync duration,
 17: // and authentication events for observability and alerting
 18: // =============================================================================
 19: 
 20: var (
 21: 	// Ban/Unban counters
 22: 	bansTotal = promauto.NewCounterVec(prometheus.CounterOpts{
 23: 		Namespace: "nftban",
 24: 		Name:      "bans_total",
 25: 		Help:      "Total number of IP bans performed",
 26: 	}, []string{"source", "family"}) // source: manual, feeds, suricata, portscan, etc. family: ipv4, ipv6
 27: 
 28: 	unbansTotal = promauto.NewCounterVec(prometheus.CounterOpts{
 29: 		Namespace: "nftban",
 30: 		Name:      "unbans_total",
 31: 		Help:      "Total number of IP unbans performed",
 32: 	}, []string{"source", "family"})
 33: 
 34: 	// Ban/Unban errors
 35: 	banErrorsTotal = promauto.NewCounterVec(prometheus.CounterOpts{
 36: 		Namespace: "nftban",
 37: 		Name:      "ban_errors_total",
 38: 		Help:      "Total number of ban operation errors",
 39: 	}, []string{"source", "error_type"})
 40: 
 41: 	unbanErrorsTotal = promauto.NewCounterVec(prometheus.CounterOpts{
 42: 		Namespace: "nftban",
 43: 		Name:      "unban_errors_total",
 44: 		Help:      "Total number of unban operation errors",
 45: 	}, []string{"source", "error_type"})
 46: 
 47: 	// Feed loading metrics
 48: 	feedsLoadDuration = promauto.NewHistogramVec(prometheus.HistogramOpts{
 49: 		Namespace: "nftban",
 50: 		Name:      "feeds_load_duration_seconds",
 51: 		Help:      "Time to load threat feeds",
 52: 		Buckets:   prometheus.ExponentialBuckets(0.1, 2, 10), // 0.1s to ~102s
 53: 	}, []string{"feed_name"})
 54: 
 55: 	feedsLoadTotal = promauto.NewCounterVec(prometheus.CounterOpts{
 56: 		Namespace: "nftban",
 57: 		Name:      "feeds_load_total",
 58: 		Help:      "Total number of feed load operations",
 59: 	}, []string{"feed_name", "status"}) // status: success, error
 60: 
 61: 	feedsIPsLoaded = promauto.NewGaugeVec(prometheus.GaugeOpts{
 62: 		Namespace: "nftban",
 63: 		Name:      "feeds_ips_loaded",
 64: 		Help:      "Number of IPs loaded from each feed",
 65: 	}, []string{"feed_name", "family"})
 66: 
 67: 	// Sync operation metrics
 68: 	syncDuration = promauto.NewHistogramVec(prometheus.HistogramOpts{
 69: 		Namespace: "nftban",
 70: 		Name:      "sync_duration_seconds",
 71: 		Help:      "Time to sync firewall rules with nftables",
 72: 		Buckets:   prometheus.ExponentialBuckets(0.01, 2, 12), // 10ms to ~40s
 73: 	}, []string{"operation"}) // operation: full, incremental, feeds, manual
 74: 
 75: 	syncOperationsTotal = promauto.NewCounterVec(prometheus.CounterOpts{
 76: 		Namespace: "nftban",
 77: 		Name:      "sync_operations_total",
 78: 		Help:      "Total number of sync operations performed",
 79: 	}, []string{"operation", "status"})
 80: 
 81: 	syncIPsAdded = promauto.NewCounter(prometheus.CounterOpts{
 82: 		Namespace: "nftban",
 83: 		Name:      "sync_ips_added_total",
 84: 		Help:      "Total number of IPs added during sync operations",
 85: 	})
 86: 
 87: 	syncIPsRemoved = promauto.NewCounter(prometheus.CounterOpts{
 88: 		Namespace: "nftban",
 89: 		Name:      "sync_ips_removed_total",
 90: 		Help:      "Total number of IPs removed during sync operations",
 91: 	})
 92: 
 93: 	// Authentication metrics
 94: 	authAttemptsTotal = promauto.NewCounterVec(prometheus.CounterOpts{
 95: 		Namespace: "nftban",
 96: 		Name:      "auth_attempts_total",
 97: 		Help:      "Total authentication attempts",
 98: 	}, []string{"status"}) // status: success, failure
 99: 
100: 	authFailuresTotal = promauto.NewCounterVec(prometheus.CounterOpts{
101: 		Namespace: "nftban",
102: 		Name:      "auth_failures_total",
103: 		Help:      "Total authentication failures by reason",
104: 	}, []string{"reason"}) // reason: invalid_password, user_not_found, root_blocked, token_expired
105: 
106: 	// API request metrics
107: 	apiRequestDuration = promauto.NewHistogramVec(prometheus.HistogramOpts{
108: 		Namespace: "nftban",
109: 		Name:      "api_request_duration_seconds",
110: 		Help:      "API request duration in seconds",
111: 		Buckets:   prometheus.DefBuckets,
112: 	}, []string{"endpoint", "method"})
113: 
114: 	apiRequestsTotal = promauto.NewCounterVec(prometheus.CounterOpts{
115: 		Namespace: "nftban",
116: 		Name:      "api_requests_total",
117: 		Help:      "Total API requests",
118: 	}, []string{"endpoint", "method", "status_code"})
119: 
120: 	// Module status gauges
121: 	moduleStatus = promauto.NewGaugeVec(prometheus.GaugeOpts{
122: 		Namespace: "nftban",
123: 		Name:      "module_enabled",
124: 		Help:      "Module enabled status (1=enabled, 0=disabled)",
125: 	}, []string{"module"}) // module: portscan, ddos, login_monitor, suricata, geoban
126: 
127: 	// NFT CLI execution metrics
128: 	nftCLIDuration = promauto.NewHistogramVec(prometheus.HistogramOpts{
129: 		Namespace: "nftban",
130: 		Name:      "nft_cli_duration_seconds",
131: 		Help:      "Duration of nft CLI command execution",
132: 		Buckets:   prometheus.ExponentialBuckets(0.001, 2, 15), // 1ms to ~32s
133: 	}, []string{"operation"})
134: 
135: 	nftCLIErrorsTotal = promauto.NewCounterVec(prometheus.CounterOpts{
136: 		Namespace: "nftban",
137: 		Name:      "nft_cli_errors_total",
138: 		Help:      "Total nft CLI command errors",
139: 	}, []string{"operation", "error_type"})
140: )
141: 
142: // =============================================================================
143: // Metric Recording Functions
144: // =============================================================================
145: 
146: // RecordBan records a successful ban operation
147: func RecordBan(source, family string) {
148: 	bansTotal.WithLabelValues(source, family).Inc()
149: }
150: 
151: // RecordUnban records a successful unban operation
152: func RecordUnban(source, family string) {
153: 	unbansTotal.WithLabelValues(source, family).Inc()
154: }
155: 
156: // RecordBanError records a ban operation error
157: func RecordBanError(source, errorType string) {
158: 	banErrorsTotal.WithLabelValues(source, errorType).Inc()
159: }
160: 
161: // RecordUnbanError records an unban operation error
162: func RecordUnbanError(source, errorType string) {
163: 	unbanErrorsTotal.WithLabelValues(source, errorType).Inc()
164: }
165: 
166: // RecordFeedLoad records a feed load operation with duration
167: func RecordFeedLoad(feedName string, durationSec float64, success bool) {
168: 	feedsLoadDuration.WithLabelValues(feedName).Observe(durationSec)
169: 	status := "success"
170: 	if !success {
171: 		status = "error"
172: 	}
173: 	feedsLoadTotal.WithLabelValues(feedName, status).Inc()
174: }
175: 
176: // SetFeedIPsLoaded sets the number of IPs loaded from a feed
177: func SetFeedIPsLoaded(feedName, family string, count float64) {
178: 	feedsIPsLoaded.WithLabelValues(feedName, family).Set(count)
179: }
180: 
181: // RecordSync records a sync operation with duration
182: func RecordSync(operation string, durationSec float64, success bool) {
183: 	syncDuration.WithLabelValues(operation).Observe(durationSec)
184: 	status := "success"
185: 	if !success {
186: 		status = "error"
187: 	}
188: 	syncOperationsTotal.WithLabelValues(operation, status).Inc()
189: }
190: 
191: // RecordSyncIPChanges records IPs added/removed during sync
192: func RecordSyncIPChanges(added, removed int) {
193: 	syncIPsAdded.Add(float64(added))
194: 	syncIPsRemoved.Add(float64(removed))
195: }
196: 
197: // RecordAuthAttempt records an authentication attempt
198: func RecordAuthAttempt(success bool) {
199: 	status := "success"
200: 	if !success {
201: 		status = "failure"
202: 	}
203: 	authAttemptsTotal.WithLabelValues(status).Inc()
204: }
205: 
206: // RecordAuthFailure records an authentication failure with reason
207: func RecordAuthFailure(reason string) {
208: 	authFailuresTotal.WithLabelValues(reason).Inc()
209: }
210: 
211: // RecordAPIRequest records an API request
212: func RecordAPIRequest(endpoint, method string, statusCode int, durationSec float64) {
213: 	apiRequestDuration.WithLabelValues(endpoint, method).Observe(durationSec)
214: 	apiRequestsTotal.WithLabelValues(endpoint, method, statusCodeString(statusCode)).Inc()
215: }
216: 
217: // SetModuleStatus sets the enabled status of a module
218: func SetModuleStatus(module string, enabled bool) {
219: 	value := float64(0)
220: 	if enabled {
221: 		value = 1
222: 	}
223: 	moduleStatus.WithLabelValues(module).Set(value)
224: }
225: 
226: // RecordNFTCLI records an nft CLI command execution
227: func RecordNFTCLI(operation string, durationSec float64, err error) {
228: 	nftCLIDuration.WithLabelValues(operation).Observe(durationSec)
229: 	if err != nil {
230: 		nftCLIErrorsTotal.WithLabelValues(operation, "execution_error").Inc()
231: 	}
232: }
233: 
234: // =============================================================================
235: // Helper Functions
236: // =============================================================================
237: 
238: func statusCodeString(code int) string {
239: 	switch {
240: 	case code >= 200 && code < 300:
241: 		return "2xx"
242: 	case code >= 300 && code < 400:
243: 		return "3xx"
244: 	case code >= 400 && code < 500:
245: 		return "4xx"
246: 	case code >= 500:
247: 		return "5xx"
248: 	default:
249: 		return "unknown"
250: 	}
251: }
252: 
253: // =============================================================================
254: // Metrics Registration with Global Sampler
255: // =============================================================================
256: 
257: var registerOnce sync.Once
258: 
259: // RegisterWithSampler registers all nftban metrics with the global sampler's registry
260: // This should be called once during application startup
261: func RegisterWithSampler() {
262: 	registerOnce.Do(func() {
263: 		sampler := GetSampler()
264: 		if sampler == nil {
265: 			return
266: 		}
267: 
268: 		registry := sampler.Registry()
269: 		if registry == nil {
270: 			return
271: 		}
272: 
273: 		// Note: promauto already registers with default registry
274: 		// If you need custom registry, use prometheus.NewCounterVec instead of promauto
275: 		// and register manually here
276: 	})
277: }

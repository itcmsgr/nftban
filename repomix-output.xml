146: // checkIPInFeeds checks if an IP is present in threat intelligence feeds
147: func checkIPInFeeds(ip string, isIPv4 bool, feedsDir string) (bool, bool, []string) {
148: 	// Load all feeds
149: 	ipv4Set, ipv6Set, ipv4CIDRSet, ipv6CIDRSet, feedsInfo, err := feeds.LoadAllFeeds(feedsDir)
150: 	if err != nil {
151: 		// If feeds can't be loaded, return false
152: 		return false, false, nil
153: 	}
154: 
155: 	parsedIP := net.ParseIP(ip)
156: 	if parsedIP == nil {
157: 		return false, false, nil
158: 	}
159: 
160: 	var matchedFeeds []string
161: 	inIP := false
162: 	inCIDR := false
163: 
164: 	// Check if IP is in individual IP sets
165: 	if isIPv4 {
166: 		if ipv4Set[ip] {
167: 			inIP = true
168: 		}
169: 	} else {
170: 		if ipv6Set[ip] {
171: 			inIP = true
172: 		}
173: 	}
174: 
175: 	// Check if IP is in any CIDR range
176: 	if isIPv4 {
177: 		for cidr := range ipv4CIDRSet {
178: 			_, ipNet, err := net.ParseCIDR(cidr)
179: 			if err != nil {
180: 				continue
181: 			}
182: 			if ipNet.Contains(parsedIP) {
183: 				inCIDR = true
184: 				break
185: 			}
186: 		}
187: 	} else {
188: 		for cidr := range ipv6CIDRSet {
189: 			_, ipNet, err := net.ParseCIDR(cidr)
190: 			if err != nil {
191: 				continue
192: 			}
193: 			if ipNet.Contains(parsedIP) {
194: 				inCIDR = true
195: 				break
196: 			}
197: 		}
198: 	}
199: 
200: 	// If found, try to determine which feeds
201: 	if inIP || inCIDR {
202: 		for _, feed := range feedsInfo {
203: 			matchedFeeds = append(matchedFeeds, feed.Name)
204: 		}
205: 	}
206: 
207: 	return inIP, inCIDR, matchedFeeds
208: }

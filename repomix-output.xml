499: # Get stats line (tables, chains, rules, bans)
500: nftban_get_stats_line() {
501:     command -v nft >/dev/null 2>&1 || return
502: 
503:     local tables chains rules bans
504:     local ruleset
505: 
506:     ruleset="$(nft -a list ruleset 2>/dev/null)" || return
507: 
508:     tables=$(echo "$ruleset" | grep -cE '^table[[:space:]]' || echo 0)
509:     chains=$(echo "$ruleset" | grep -cE '^[[:space:]]*chain[[:space:]]' || echo 0)
510:     rules=$(echo "$ruleset" | grep -cE '[[:space:]]handle[[:space:]][0-9]+' || echo 0)
511: 
512:     # Count ban set elements (simplified heuristic)
513:     bans=0
514:     if echo "$ruleset" | grep -qi "set.*ban"; then
515:         # Count elements in sets with "ban" in name
516:         bans=$(echo "$ruleset" | { grep -i 'elements = {' | grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' || true; } | wc -l || echo 0)
517:     fi
518: 
519:     local stats="tables $tables · chains $chains · rules $rules"
520:     [[ $bans -gt 0 ]] && stats="$stats · bans $bans"
521: 
522:     echo "$stats"
523: }

# =============================================================================
# NFTBan v1.0.0 - Release Go Binaries
# =============================================================================
# SPDX-License-Identifier: MPL-2.0
# Purpose: Build and release Go binaries on GitHub releases
# Triggers: Published releases
#
# Builds:
#   - nftban-core (main Go binary for feeds, geoip, API operations)
#   - nftban-api-server (REST API server)
# =============================================================================

name: Release Go Binaries

on:
  release:
    types: [published]

permissions:
  contents: write

jobs:
  build-matrix:
    name: Build (${{ matrix.go }} • ${{ matrix.arch }})
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        go: ["1.22.x"]
        arch: [amd64, arm64]

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-go@v5
        with:
          go-version: ${{ matrix.go }}

      - name: Install build dependencies
        run: sudo apt-get update && sudo apt-get install -y libpam0g-dev

      - name: Build nftban-core (${{ matrix.arch }})
        run: |
          mkdir -p dist
          GOOS=linux GOARCH=${{ matrix.arch }} CGO_ENABLED=0 \
          go build -trimpath -ldflags "-s -w" \
            -o dist/nftban-core-${{ matrix.arch }} ./cmd/nftban-core

      - name: Build nftban-ui (${{ matrix.arch }})
        run: |
          GOOS=linux GOARCH=${{ matrix.arch }} CGO_ENABLED=0 \
          go build -trimpath -ldflags "-s -w" \
            -o dist/nftban-ui-${{ matrix.arch }} ./cmd/nftban-ui

      - name: Build nftban-ui-auth (${{ matrix.arch }})
        if: matrix.arch == 'amd64'
        run: |
          # nftban-ui-auth requires CGO for PAM support (only amd64 for now)
          GOOS=linux GOARCH=${{ matrix.arch }} CGO_ENABLED=1 \
          go build -trimpath -ldflags "-s -w" \
            -o dist/nftban-ui-auth-${{ matrix.arch }} ./cmd/nftban-ui-auth

      - name: Build nftband (${{ matrix.arch }})
        run: |
          GOOS=linux GOARCH=${{ matrix.arch }} CGO_ENABLED=0 \
          go build -trimpath -ldflags "-s -w" \
            -o dist/nftband-${{ matrix.arch }} ./cmd/nftband

      - name: Upload matrix artifacts
        uses: actions/upload-artifact@v4
        with:
          name: nftban-binaries-${{ matrix.arch }}
          path: dist/*-${{ matrix.arch }}

  assemble-release:
    name: Assemble & Sign Artifacts
    needs: [build-matrix]
    runs-on: ubuntu-latest

    steps:
      - uses: actions/download-artifact@v4
        with:
          path: dist

      - name: Flatten
        run: |
          shopt -s globstar nullglob
          mv dist/**/nftban-* dist/ || true

      - name: Generate SHA256SUMS
        working-directory: dist
        run: |
          rm -f SHA256SUMS
          for f in nftban-*; do sha256sum "$f" >> SHA256SUMS; done

      # GPG signing disabled - will be enabled when GPG keys are configured

      - name: Upload to GitHub Release
        uses: softprops/action-gh-release@v2
        with:
          files: |
            dist/nftban-*
            dist/SHA256SUMS
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

// =============================================================================
// NFTBan v1.0.20 - Consolidated Systemd Authorization Rules
// =============================================================================
// SPDX-License-Identifier: MPL-2.0
// meta:name="10-nftban-systemd.rules"
// meta:type="polkit"
// meta:owner="Antonios Voulvoulis <contact@nftban.com>"
// meta:created_date="2025-10-26"
// meta:description="Polkit rules granting nftban group systemd unit management"
// meta:inventory.files=""
// meta:inventory.binaries=""
// meta:inventory.env_vars=""
// meta:inventory.config_files="/etc/polkit-1/rules.d/10-nftban-systemd.rules"
// meta:inventory.systemd_units=""
// meta:inventory.network=""
// meta:inventory.privileges="polkit"
// Purpose: Grant nftban group (operators) full systemd service management
// Location: /etc/polkit-1/rules.d/10-nftban-systemd.rules
//
// Security Model:
// - Members of 'nftban' group can manage NFTBan + Suricata systemd services
// - Scope limited to EXPLICIT WHITELIST of unit names (NO wildcards)
// - nftables access ONLY via nftban-core (root + CAP_NET_ADMIN)
// - NO direct nft command execution via polkit
// - NO pkexec privileges
//
// Groups:
//   nftban: NFTBan operators (full CLI + service management)
//
// Allowed Actions:
//   - start/stop/restart/reload/enable/disable specific allowlisted units
//   - reload systemd daemon (needed after unit file changes)
//   - query service status (systemctl status/show)
//
// Does NOT Grant:
//   - Direct nft command execution
//   - pkexec access to arbitrary binaries
//   - File system modifications
//   - Management of non-NFTBan services
//   - Wildcard/prefix-based unit access
//
// Security Philosophy:
//   ✓ Whitelist-only unit access (explicit unit names - NO wildcards)
//   ✓ Verb-based action control
//   ✓ Group-based access control
//   ✓ nftables isolation (only via nftban-core root daemon)
//   ✓ Principle of least privilege
//   ✓ Defense in depth
//
// Version History:
//   v1.0.20: Added health/maintenance/watchdog/queue/exporter/snapshot/rollback
//            units to allowlist (required for health auto-heal via polkit)
//   v1.0.19: Consolidated from 10-nftban-core.rules + 20-nftban-suricata.rules
//            Removed unsafe wildcard pattern from 60-nftban-services.rules
//            Removed obsolete auth-helper from 50-nftban-auth.rules
// =============================================================================

polkit.addRule(function (action, subject) {
    // Only trust local users in the nftban operator group
    if (!subject.isInGroup("nftban")) {
        return polkit.Result.NOT_HANDLED;
    }

    // Allow managing specific NFTBan + Suricata units (WHITELIST ONLY)
    if (action.id == "org.freedesktop.systemd1.manage-units" ||
        action.id == "org.freedesktop.systemd1.manage-unit-files") {

        var verb = action.lookup("verb");
        var unit = action.lookup("unit");

        // Allowed service lifecycle operations
        var allowedVerbs = [
            "start",
            "stop",
            "restart",
            "reload",
            "enable",
            "disable",
            "try-restart",
            "reload-or-restart",
            "try-reload-or-restart"
        ];

        // WHITELIST: ONLY these units can be managed
        // CRITICAL: NO wildcards, NO prefix matching - explicit names only
        // See docs/systemd/UNITS.md for canonical list
        var allowedUnits = [
            // NFTBan Main Daemon
            "nftband.service",

            // NFTBan Core Services
            "nftban-core-feeds.service",
            "nftban-core-feeds.timer",
            "nftban-core-geoip.service",
            "nftban-core-geoip.timer",

            // NFTBan Health & Maintenance (managed by auto-heal)
            "nftban-health.service",
            "nftban-health.timer",
            "nftban-health-fix.service",
            "nftban-maintenance.service",
            "nftban-maintenance.timer",
            "nftban-watchdog.service",
            "nftban-watchdog.timer",
            "nftban-queue.service",
            "nftban-queue.timer",
            "nftban-unified-exporter.service",
            "nftban-unified-exporter.timer",
            "nftban-snapshot.service",
            "nftban-snapshot.timer",
            "nftban-rollback.service",
            "nftban-rollback.timer",

            // NFTBan Suricata Integration (wrapper units)
            "nftban-suricata.service",
            "nftban-suricata-update.service",
            "nftban-suricata-update.timer",

            // NFTBan Login Monitor
            "nftban-login-monitor.service",

            // Native Suricata Services (direct management)
            "suricata.service",
            "suricata-update.service",
            "suricata-update.timer"
        ];

        // Check both verb AND unit are in allowlists (strict AND logic)
        if (allowedVerbs.indexOf(verb) >= 0 &&
            allowedUnits.indexOf(unit) >= 0) {
            return polkit.Result.YES;
        }
    }

    // Allow daemon-reload from nftban group (needed after unit file changes)
    if (action.id == "org.freedesktop.systemd1.reload-daemon") {
        return polkit.Result.YES;
    }

    return polkit.Result.NOT_HANDLED;
});

// =============================================================================
// SECURITY NOTES
// =============================================================================
//
// nftables Security Model:
// - NO polkit authorization for 'nft' commands
// - nftables ONLY accessible via nftban-core running as:
//     User=root
//     Group=root
//     AmbientCapabilities=CAP_NET_ADMIN
//     CapabilityBoundingSet=CAP_NET_ADMIN
// - All firewall operations go through audited Go code
//
// Suricata Integration:
// - NFTBan manages Suricata via wrapper units (nftban-suricata.service)
// - Wrapper runs as root with SupplementaryGroups=suricata,nftban
// - Native suricata.service also manageable via this rule
//
// Why Wildcards Are Forbidden:
// - Pattern like `unit.indexOf("nftban") === 0` is UNSAFE
// - Allows ANY service starting with "nftban" to be managed
// - Attacker could create nftban-backdoor.service and start it
// - v1.0.19: Removed 60-nftban-services.rules for this reason
//
// Why Auth Helper Was Removed:
// - 50-nftban-auth.rules allowed pkexec of /usr/libexec/nftban-auth-helper
// - Binary never existed (dead code from v0.3)
// - pkexec creates privilege escalation risk
// - v1.0.19: Removed entirely
//
// Group Separation:
// - nftban: Operators (full access - THIS FILE)
// - nftban-auditor: Read-only (see 20-nftban-auditor.rules)
// - nftban-panel: Limited reload (see 30-nftban-panel.rules)
//
// To verify rule is loaded:
//   pkaction --action-id org.freedesktop.systemd1.manage-units --verbose
//
// To test authorization (as nftban group member):
//   systemctl restart nftban-suricata.service  # Should work without sudo
//   systemctl status nftband.service       # Should work
//   systemctl start nftban-backdoor.service    # Should FAIL (not in whitelist)
//
// To add user to group:
//   sudo usermod -a -G nftban username
//   # User must log out and back in for group membership to take effect
//
// Related Files:
// - 20-nftban-auditor.rules: Auditor group (read-only access)
// - 30-nftban-panel.rules: Panel group (limited reload access)
//
// =============================================================================

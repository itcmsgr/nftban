415: // CountryConfig holds country blocking configuration
416: type CountryConfig struct {
417: 	Enabled     bool
418: 	Mode        string   // "blacklist" or "whitelist"
419: 	Blocked     []string // Countries to block (blacklist mode)
420: 	Whitelisted []string // Countries to allow (whitelist mode)
421: }
422: 
423: func readCountryConfig(configPath string) CountryConfig {
424: 	config := CountryConfig{
425: 		Enabled:     false,
426: 		Mode:        "blacklist",
427: 		Blocked:     []string{},
428: 		Whitelisted: []string{},
429: 	}
430: 
431: 	content, err := os.ReadFile(configPath)
432: 	if err != nil {
433: 		return config
434: 	}
435: 
436: 	lines := strings.Split(string(content), "\n")
437: 	for _, line := range lines {
438: 		line = strings.TrimSpace(line)
439: 		if line == "" || strings.HasPrefix(line, "#") {
440: 			continue
441: 		}
442: 
443: 		parts := strings.SplitN(line, "=", 2)
444: 		if len(parts) != 2 {
445: 			continue
446: 		}
447: 
448: 		key := strings.TrimSpace(parts[0])
449: 		value := strings.Trim(parts[1], `"' `)
450: 
451: 		switch key {
452: 		case "COUNTRY_ENABLED":
453: 			config.Enabled = (value == "true")
454: 		case "COUNTRY_MODE":
455: 			config.Mode = value
456: 		case "COUNTRY_BLOCKED":
457: 			if value != "" {
458: 				config.Blocked = strings.Split(value, ",")
459: 				for i := range config.Blocked {
460: 					config.Blocked[i] = strings.TrimSpace(config.Blocked[i])
461: 				}
462: 			}
463: 		case "COUNTRY_WHITELISTED":
464: 			if value != "" {
465: 				config.Whitelisted = strings.Split(value, ",")
466: 				for i := range config.Whitelisted {
467: 					config.Whitelisted[i] = strings.TrimSpace(config.Whitelisted[i])
468: 				}
469: 			}
470: 		}
471: 	}
472: 
473: 	return config
474: }
475: 
476: func writeCountryConfig(configPath string, config CountryConfig) error {
477: 	// Ensure directory exists
478: 	dir := filepath.Dir(configPath)
479: 	if err := os.MkdirAll(dir, 0750); err != nil {
480: 		return err
481: 	}
482: 
483: 	content := `# =============================================================================
484: # NFTBan v1.0.0 - Country Blocking Configuration
485: # =============================================================================
486: # Control traffic by country using GeoIP data
487: #
488: # Mode:
489: #   blacklist - Block listed countries, allow all others (default)
490: #   whitelist - Allow ONLY listed countries, block all others
491: # =============================================================================
492: 
493: `
494: 	content += fmt.Sprintf("COUNTRY_ENABLED=\"%v\"\n", config.Enabled)
495: 	content += fmt.Sprintf("COUNTRY_MODE=\"%s\"\n", config.Mode)
496: 	content += fmt.Sprintf("COUNTRY_BLOCKED=\"%s\"\n", strings.Join(config.Blocked, ","))
497: 	content += fmt.Sprintf("COUNTRY_WHITELISTED=\"%s\"\n", strings.Join(config.Whitelisted, ","))
498: 
499: 	return os.WriteFile(configPath, []byte(content), 0640)
500: }
501: 
502: func contains(slice []string, item string) bool {
503: 	for _, s := range slice {
504: 		if s == item {
505: 			return true
506: 		}
507: 	}
508: 	return false
509: }
510: 
511: func removeString(slice []string, item string) []string {
512: 	result := []string{}
513: 	for _, s := range slice {
514: 		if s != item {
515: 			result = append(result, s)
516: 		}
517: 	}
518: 	return result
519: }

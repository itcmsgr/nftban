 988: nftban_cmd_login() {
 989:     # Main login CLI handler
 990:     local subcommand="${1:-status}"
 991:     local json_mode=false
 992:     shift || true
 993: 
 994:     # Check for --json flag
 995:     for arg in "$@"; do
 996:         [[ "$arg" == "--json" ]] && json_mode=true && break
 997:     done
 998: 
 999:     # Load output module (for help banner)
1000:     if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_output.sh" ]]; then
1001:         # shellcheck source=/dev/null
1002:         source "${NFTBAN_LIB_DIR}/core/nftban_output.sh"
1003:     fi
1004: 
1005:     case "$subcommand" in
1006:         status)
1007:             _nftban_login_cmd_status_json "$json_mode"
1008:             ;;
1009:         stats)
1010:             _nftban_login_cmd_stats_json "$json_mode"
1011:             ;;
1012:         install)
1013:             nftban_login_cmd_install "$@"
1014:             ;;
1015:         enable)
1016:             nftban_login_cmd_enable "$@"
1017:             ;;
1018:         disable)
1019:             nftban_login_cmd_disable "$@"
1020:             ;;
1021:         restart)
1022:             nftban_login_cmd_restart "$@"
1023:             ;;
1024:         health-fix)
1025:             echo "NOTE: Login health checks are now part of the main autoheal system."
1026:             echo ""
1027:             echo "Use: nftban health check --auto-heal"
1028:             echo ""
1029:             ;;
1030:         logs)
1031:             nftban_login_cmd_logs "$@"
1032:             ;;
1033:         test)
1034:             nftban_login_cmd_test "$@"
1035:             ;;
1036:         run)
1037:             nftban_login_cmd_run "$@"
1038:             ;;
1039:         mode)
1040:             nftban_login_cmd_mode "$@"
1041:             ;;
1042:         digest)
1043:             nftban_login_cmd_digest "$@"
1044:             ;;

# ==========================================================
# File: nftban.logrotate
# Author: Antonios Voulvoulis | ITCMS (itcms.gr)
# Company: IT Consulting Managed Services (ITCMS)
# Version: v1.0
# Date: 2025-09-18
# ==========================================================
# Changelog:
# v1.0 (2025-09-18) - Initial release, rotates logs monthly or >10M,
#                     keeps 12 archives, compresses with gzip.
# ==========================================================
#
# - Rotates all logs under /etc/nftban/logs
# - Rotation policy: monthly OR when size >10M
# - Keeps 12 archives (1 year), compresses with gzip
# - Reference copy: /etc/nftban/config/nftban.logrotate
# - Active copy:    /etc/logrotate.d/nftban
#

/etc/nftban/logs/*.log {
    monthly
    size 10M
    rotate 12
    compress
    missingok
    notifempty
    create 640 root adm
    sharedscripts
    postrotate
        systemctl reload fail2ban >/dev/null 2>&1 || true
    endscript
}

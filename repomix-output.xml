1768: func execCommand(name string, args ...string) (string, error) {
1769: 	cmd := exec.Command(name, args...)
1770: 	output, err := cmd.CombinedOutput()
1771: 	if err != nil {
1772: 		return "", fmt.Errorf("command failed: %v (output: %s)", err, string(output))
1773: 	}
1774: 	return string(output), nil
1775: }

 387:         echo "    Total alert rules: $rule_count"
 388:         echo "    Rules directory:   /var/lib/suricata/rules/"
 389:     else
 390:         echo "    ⚠  No rules directory found"
 391:     fi
 392: 
 393:     # Recent alerts
 394:     echo ""
 395:     echo "  Recent Alerts (last 5):"
 396:     if [[ -f /var/log/suricata/eve.json ]]; then

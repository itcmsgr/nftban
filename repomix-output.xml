 7: 
 8: set -e
 9: 
10: # Summary of how this script can be called:
11: #        * <postrm> `remove'
12: #        * <postrm> `purge'
13: #        * <old-postrm> `upgrade' <new-version>
14: #        * <new-postrm> `failed-upgrade' <old-version>
15: #        * <new-postrm> `abort-install'
16: #        * <new-postrm> `abort-install' <old-version>
17: #        * <new-postrm> `abort-upgrade' <old-version>
18: #        * <disappearer's-postrm> `disappear' <overwriter>
19: #          <overwriter-version>
20: # for details, see https://www.debian.org/doc/debian-policy/ or
21: # the debian-policy package
22: 
23: case "$1" in
24:     purge)
25:         # Remove metrics file on purge (but keep directory for Node Exporter)
26:         echo "Purging NFTBan metrics data..."
27:         rm -f /var/lib/node_exporter/textfile_collector/nftban.prom 2>/dev/null || true

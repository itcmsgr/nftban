# =============================================================================

[Unit]
Description=NFTBan Pro Inventory Collection and Submission
Documentation=man:nftban(8)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/nftban/pro.token

[Service]
Type=oneshot

# Run as root to read system info (CPU, RAM, disk)
# Inventory needs to read /proc/cpuinfo, /proc/meminfo, /sys/block/*/
User=root
Group=root

# Collect and submit inventory (idempotent, checksum-based)
ExecStart=/usr/sbin/nftban pro inventory run --verbose

# Exit codes: 0=OK, 1=error (non-fatal)
SuccessExitStatus=0 1

# =============================================================================
# SECURITY HARDENING
# =============================================================================

# Core hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

# Filesystem access
# Read system info from /proc, /sys
ReadOnlyPaths=/proc /sys /etc/os-release
# Write inventory to Pro data dir
ReadWritePaths=/var/lib/nftban/pro
# Read token
ReadOnlyPaths=/etc/nftban

# Network for Pro API calls
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Resource limits
MemoryMax=64M
TasksMax=5
TimeoutStartSec=120

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nftban-pro-inventory

[Install]
WantedBy=multi-user.target

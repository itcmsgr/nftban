# NFTBan SELinux File Context (R39 v1.19.12)
# SPDX-License-Identifier: MPL-2.0
#
# Apply: semanage fcontext -a -t <type> '<pattern>'
#        restorecon -R /path

# Executables
/usr/sbin/nftban                                        --  gen_context(system_u:object_r:nftband_exec_t,s0)
/usr/lib/nftban/bin/nftband                             --  gen_context(system_u:object_r:nftband_exec_t,s0)
/usr/lib/nftban/bin/nftban-core                         --  gen_context(system_u:object_r:nftband_exec_t,s0)

# Configuration files
/etc/nftban(/.*)?                                           gen_context(system_u:object_r:nftban_conf_t,s0)
/etc/nftban/nftban\.conf                                --  gen_context(system_u:object_r:nftban_conf_t,s0)
/etc/nftban/conf\.d(/.*)?                                   gen_context(system_u:object_r:nftban_conf_t,s0)

# v1.228.5 — the ONE artifact consumed by the distro nftables.service (iptables_t).
# More specific than the /etc/nftban(/.*)? entry above, so it wins. Everything else
# under /etc/nftban stays nftban_conf_t and remains unreadable by that domain.
# NOTE: the renderer publishes via a temp file + rename, which PRESERVES the source
# type, so this declaration alone is NOT sufficient — cmd_firewall.sh must restore the
# context on the final path after publication. See _firewall_publish_conf().
/etc/nftban/nftables\.conf                              --  gen_context(system_u:object_r:nftban_nftables_conf_t,s0)

# v1.229.13 Lane 3D.5A — the boot projection is the SECOND artifact consumed by the
# distro nftables.service (iptables_t), after Lane 3D.4 moved boot authority to it.
#
# ⛔ WITHOUT THIS RULE THE FPA TRANSITION IS UNREACHABLE ON EL. restorecon on the
# published projection resolves to the /etc/nftban(/.*)? catch-all (nftban_conf_t),
# _firewall_publish_conf's type verification then fails, render-boot exits 1,
# bootProjectionReady stays false, and IntegrateSystemConf correctly refuses the
# include transition. Measured on a Rocky 9.8 host, 2026-09-06.
#
# DELIBERATELY NARROW: this names the ONE file, not /etc/nftban/generated(/.*)?.
# The directory and anything else generated under it stay nftban_conf_t and remain
# unreadable by iptables_t, preserving type separation.
#
# Same caveat as the line above: the renderer publishes via temp file + rename, which
# PRESERVES the source type, so this declaration alone is NOT sufficient —
# _firewall_publish_conf() must restorecon the final path. It does.
/etc/nftban/generated/nftban-boot\.nft                  --  gen_context(system_u:object_r:nftban_nftables_conf_t,s0)

# State files (var/lib)
/var/lib/nftban(/.*)?                                       gen_context(system_u:object_r:nftban_var_lib_t,s0)
/var/lib/nftban/feeds(/.*)?                                 gen_context(system_u:object_r:nftban_var_lib_t,s0)
/var/lib/nftban/geoip(/.*)?                                 gen_context(system_u:object_r:nftban_var_lib_t,s0)
/var/lib/nftban/staging(/.*)?                               gen_context(system_u:object_r:nftban_var_lib_t,s0)

# Log files
/var/log/nftban(/.*)?                                       gen_context(system_u:object_r:nftban_log_t,s0)
/var/log/nftban/nftban\.log.*                           --  gen_context(system_u:object_r:nftban_log_t,s0)
/var/log/nftban/audit\.log.*                            --  gen_context(system_u:object_r:nftban_log_t,s0)

# Runtime files
/run/nftban(/.*)?                                           gen_context(system_u:object_r:nftban_var_run_t,s0)
/run/nftban/nftband\.sock                               -s  gen_context(system_u:object_r:nftban_var_run_t,s0)
/run/nftban/nftband\.pid                                --  gen_context(system_u:object_r:nftban_var_run_t,s0)

# Cache files (same as state)
/var/cache/nftban(/.*)?                                     gen_context(system_u:object_r:nftban_var_lib_t,s0)

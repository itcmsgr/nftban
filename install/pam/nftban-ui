#%PAM-1.0
# NFTBan Web UI PAM Configuration
# User must be in nftban group AND must provide valid password

# Group gate - must be in nftban group for full access
auth   [success=ok default=die]    pam_succeed_if.so user ingroup nftban

# Password check (REQUIRED - enforces password verification)
auth   required   pam_unix.so

# Account checks (expiry, locked status, etc.)
account required   pam_unix.so

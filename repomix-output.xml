55: #   ls -la /var/lib/nftban
56: #
57: # Groups (v1.0 simplified model):
58: #   nftban: All operators (CLI, Web, services)
59: #   nftban-auditors: Read-only audit access
60: #
61: # =============================================================================
</file>

<file path="install/download-binaries.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan Binary Download with SLSA Verification
  4: # =============================================================================
  5: # Purpose: Download and verify NFTBan Go binaries from GitHub releases
  6: # Usage: ./download-binaries.sh [VERSION]
  7: #        VERSION: Tag like v1.0.0 (default: latest)
  8: #
  9: # Features:
 10: #   - Downloads binaries from GitHub releases
 11: #   - Verifies SLSA Level 3 provenance (cryptographic proof)
 12: #   - Falls back to SHA256 if SLSA verifier not available
 13: #   - Supports amd64 and arm64 architectures
 14: # =============================================================================
 15: 
 16: set -euo pipefail
 17: 
 18: # Configuration
 19: GITHUB_REPO="itcmsgr/nftban-v1.0-dev"
 20: GITHUB_API="https://api.github.com/repos/${GITHUB_REPO}"
 21: GITHUB_RELEASES="https://github.com/${GITHUB_REPO}/releases/download"
 22: VERSION="${1:-latest}"
 23: 
 24: # Directories
 25: DOWNLOAD_DIR="${DOWNLOAD_DIR:-/tmp/nftban-binaries}"
 26: INSTALL_DIR="${INSTALL_DIR:-/usr/lib/nftban/bin}"
 27: 
 28: # Colors
 29: RED='\033[0;31m'
 30: GREEN='\033[0;32m'
 31: YELLOW='\033[1;33m'
 32: BLUE='\033[0;34m'
 33: NC='\033[0m'
 34: 
 35: log()   { echo -e "${BLUE}[DOWNLOAD]${NC} $*"; }
 36: ok()    { echo -e "${GREEN}[  OK    ]${NC} $*"; }
 37: warn()  { echo -e "${YELLOW}[ WARN   ]${NC} $*"; }
 38: error() { echo -e "${RED}[ ERROR  ]${NC} $*"; exit 1; }
 39: 
 40: # =============================================================================
 41: # FUNCTIONS
 42: # =============================================================================
 43: 
 44: detect_arch() {
 45:     local arch
 46:     arch=$(uname -m)
 47:     case "$arch" in
 48:         x86_64)  echo "amd64" ;;
 49:         aarch64) echo "arm64" ;;
 50:         *)       error "Unsupported architecture: $arch" ;;
 51:     esac
 52: }
 53: 
 54: get_latest_version() {
 55:     log "Fetching latest release version..."
 56:     local latest
 57:     latest=$(curl -fsSL "${GITHUB_API}/releases/latest" | jq -r '.tag_name' 2>/dev/null)
 58:     if [[ -z "$latest" || "$latest" == "null" ]]; then
 59:         error "Failed to get latest version from GitHub API"
 60:     fi
 61:     echo "$latest"
 62: }
 63: 
 64: install_slsa_verifier() {
 65:     log "Installing SLSA verifier..."
 66: 
 67:     # Check if Go is available
 68:     if command -v go &>/dev/null; then
 69:         go install github.com/slsa-framework/slsa-verifier/v2/cli/slsa-verifier@latest
 70:         local gopath
 71:         gopath=$(go env GOPATH)
 72:         export PATH="$PATH:${gopath}/bin"
 73:         return 0
 74:     fi
 75: 
 76:     # Download pre-built binary
 77:     local arch
 78:     arch=$(detect_arch)
 79:     local verifier_version="v2.6.0"
 80:     local verifier_url="https://github.com/slsa-framework/slsa-verifier/releases/download/${verifier_version}/slsa-verifier-linux-${arch}"
 81: 
 82:     log "Downloading slsa-verifier ${verifier_version}..."
 83:     curl -fsSL -o "$DOWNLOAD_DIR/slsa-verifier" "$verifier_url"
 84:     chmod +x "$DOWNLOAD_DIR/slsa-verifier"
 85:     export PATH="$PATH:$DOWNLOAD_DIR"
 86: 
 87:     return 0
 88: }
 89: 
 90: verify_slsa() {
 91:     local binary="$1"
 92:     local provenance="${binary}.intoto.jsonl"
 93:     local tag="$2"
 94: 
 95:     if [[ ! -f "$provenance" ]]; then
 96:         warn "Provenance file not found: $provenance"
 97:         return 1
 98:     fi
 99: 
100:     log "Verifying SLSA provenance for $(basename "$binary")..."
101: 
102:     if slsa-verifier verify-artifact "$binary" \
103:         --provenance-path "$provenance" \
104:         --source-uri "github.com/${GITHUB_REPO}" \
105:         --source-tag "$tag" 2>&1; then
106:         ok "SLSA verification PASSED: $(basename "$binary")"
107:         return 0
108:     else
109:         error "SLSA verification FAILED: $(basename "$binary")"
110:         return 1
111:     fi
112: }
113: 
114: verify_sha256() {
115:     local binary="$1"
116:     local sums_file="$2"
117: 
118:     if [[ ! -f "$sums_file" ]]; then
119:         warn "SHA256SUMS file not found"
120:         return 1
121:     fi
122: 
123:     local basename
124:     basename=$(basename "$binary")
125:     local expected
126:     expected=$(grep "$basename" "$sums_file" | awk '{print $1}')
127: 
128:     if [[ -z "$expected" ]]; then
129:         warn "No SHA256 entry for $basename"
130:         return 1
131:     fi
132: 
133:     local actual
134:     actual=$(sha256sum "$binary" | awk '{print $1}')
135: 
136:     if [[ "$expected" == "$actual" ]]; then
137:         ok "SHA256 verification PASSED: $basename"
138:         return 0
139:     else
140:         error "SHA256 verification FAILED: $basename"
141:         error "Expected: $expected"
142:         error "Got:      $actual"
143:         return 1
144:     fi
145: }
146: 
147: download_binary() {
148:     local name="$1"
149:     local arch="$2"
150:     local version="$3"
151:     local filename="${name}-linux-${arch}"
152:     local url="${GITHUB_RELEASES}/${version}/${filename}"
153: 
154:     log "Downloading $filename..."
155: 
156:     # Download binary
157:     if ! curl -fsSL -o "$DOWNLOAD_DIR/$filename" "$url"; then
158:         warn "Failed to download $filename"
159:         return 1
160:     fi
161: 
162:     # Download provenance
163:     log "Downloading provenance for $filename..."
164:     curl -fsSL -o "$DOWNLOAD_DIR/${filename}.intoto.jsonl" "${url}.intoto.jsonl" 2>/dev/null || true
165: 
166:     ok "Downloaded: $filename"
167:     return 0
168: }
169: 
170: download_all() {
171:     local version="$1"
172:     local arch="$2"
173: 
174:     log "Downloading NFTBan binaries ${version} for ${arch}..."
175: 
176:     # Download main binaries
177:     download_binary "nftban-core" "$arch" "$version"
178:     download_binary "nftban-ui" "$arch" "$version"
179: 
180:     # nftban-ui-auth is amd64 only (CGO)
181:     if [[ "$arch" == "amd64" ]]; then
182:         download_binary "nftban-ui-auth" "$arch" "$version"
183:     else
184:         warn "nftban-ui-auth not available for $arch (requires CGO)"
185:     fi
186: 
187:     # Download SHA256SUMS
188:     log "Downloading SHA256SUMS..."
189:     curl -fsSL -o "$DOWNLOAD_DIR/SHA256SUMS" "${GITHUB_RELEASES}/${version}/SHA256SUMS" 2>/dev/null || true
190: }
191: 
192: verify_all() {
193:     local version="$1"
194:     local arch="$2"
195:     local method="$3"
196: 
197:     local binaries=("nftban-core-linux-${arch}" "nftban-ui-linux-${arch}")
198:     if [[ "$arch" == "amd64" ]]; then
199:         binaries+=("nftban-ui-auth-linux-amd64")
200:     fi
201: 
202:     local verified=0
203:     local failed=0
204: 
205:     for binary in "${binaries[@]}"; do
206:         local path="$DOWNLOAD_DIR/$binary"
207:         [[ ! -f "$path" ]] && continue
208: 
209:         case "$method" in
210:             slsa)
211:                 if verify_slsa "$path" "$version"; then
212:                     verified=$((verified + 1))
213:                 else
214:                     failed=$((failed + 1))
215:                 fi
216:                 ;;
217:             sha256)
218:                 if verify_sha256 "$path" "$DOWNLOAD_DIR/SHA256SUMS"; then
219:                     verified=$((verified + 1))
220:                 else
221:                     failed=$((failed + 1))
222:                 fi
223:                 ;;
224:         esac
225:     done
226: 
227:     if [[ $failed -gt 0 ]]; then
228:         error "Verification failed for $failed binary(ies). DO NOT USE!"
229:         return 1
230:     fi
231: 
232:     ok "All binaries verified ($verified total)"
233:     return 0
234: }
235: 
236: install_binaries() {
237:     local arch="$1"
238: 
239:     log "Installing binaries to $INSTALL_DIR..."
240: 
241:     mkdir -p "$INSTALL_DIR"
242: 
243:     # Install nftban-core
244:     if [[ -f "$DOWNLOAD_DIR/nftban-core-linux-${arch}" ]]; then
245:         cp -f "$DOWNLOAD_DIR/nftban-core-linux-${arch}" "$INSTALL_DIR/nftban-core"
246:         chmod 755 "$INSTALL_DIR/nftban-core"
247:         ok "Installed: $INSTALL_DIR/nftban-core"
248:     fi
249: 
250:     # Install nftban-ui
251:     if [[ -f "$DOWNLOAD_DIR/nftban-ui-linux-${arch}" ]]; then
252:         cp -f "$DOWNLOAD_DIR/nftban-ui-linux-${arch}" /usr/sbin/nftban-ui
253:         chmod 755 /usr/sbin/nftban-ui
254:         ok "Installed: /usr/sbin/nftban-ui"
255:     fi
256: 
257:     # Install nftban-ui-auth (amd64 only)
258:     if [[ -f "$DOWNLOAD_DIR/nftban-ui-auth-linux-amd64" ]]; then
259:         cp -f "$DOWNLOAD_DIR/nftban-ui-auth-linux-amd64" /usr/libexec/nftban-ui-auth
260:         chmod 755 /usr/libexec/nftban-ui-auth
261:         ok "Installed: /usr/libexec/nftban-ui-auth"
262:     fi
263: 
264:     ok "Binaries installed successfully"
265: }
266: 
267: show_usage() {
268:     cat << EOF
269: NFTBan Binary Download with SLSA Verification
270: 
271: Usage:
272:   $0 [VERSION]
273: 
274: Arguments:
275:   VERSION    Release tag (e.g., v1.0.0). Default: latest
276: 
277: Options:
278:   --help     Show this help
279: 
280: Environment Variables:
281:   DOWNLOAD_DIR   Directory for downloaded files (default: /tmp/nftban-binaries)
282:   INSTALL_DIR    Directory for installed binaries (default: /usr/lib/nftban/bin)
283:   SKIP_INSTALL   Set to 1 to download only, don't install
284: 
285: Examples:
286:   $0                    # Download and install latest version
287:   $0 v1.0.0            # Download specific version
288:   SKIP_INSTALL=1 $0    # Download only, don't install
289: 
290: Security:
291:   This script verifies binaries using SLSA Level 3 provenance.
292:   If verification fails, binaries will NOT be installed.
293: 
294:   Learn more: https://slsa.dev/
295: 
296: EOF
297: }
298: 
299: # =============================================================================
300: # MAIN
301: # =============================================================================
302: 
303: # Handle help
304: if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
305:     show_usage
306:     exit 0
307: fi
308: 
309: # Check root for installation
310: if [[ "${SKIP_INSTALL:-0}" != "1" && $EUID -ne 0 ]]; then
311:     error "Root required for installation. Use sudo or set SKIP_INSTALL=1"
312: fi
313: 
314: echo ""
315: echo "================================================"
316: echo "  NFTBan Binary Download with SLSA Verification"
317: echo "================================================"
318: echo ""
319: 
320: # Setup
321: ARCH=$(detect_arch)
322: mkdir -p "$DOWNLOAD_DIR"
323: 
324: log "Architecture: $ARCH"
325: log "Download dir: $DOWNLOAD_DIR"
326: echo ""
327: 
328: # Get version
329: if [[ "$VERSION" == "latest" ]]; then
330:     VERSION=$(get_latest_version)
331: fi
332: log "Version: $VERSION"
333: echo ""
334: 
335: # Download all binaries
336: download_all "$VERSION" "$ARCH"
337: echo ""
338: 
339: # Check for SLSA verifier
340: VERIFY_METHOD="sha256"
341: if command -v slsa-verifier &>/dev/null; then
342:     VERIFY_METHOD="slsa"
343:     log "SLSA verifier found"
344: else
345:     log "SLSA verifier not found, attempting to install..."
346:     if install_slsa_verifier; then
347:         if command -v slsa-verifier &>/dev/null; then
348:             VERIFY_METHOD="slsa"
349:             ok "SLSA verifier installed"
350:         fi
351:     fi
352: fi
353: 
354: if [[ "$VERIFY_METHOD" == "slsa" ]]; then
355:     log "Using SLSA Level 3 verification (recommended)"
356: else
357:     warn "Falling back to SHA256 verification"
358:     warn "For better security, install slsa-verifier:"
359:     echo "  go install github.com/slsa-framework/slsa-verifier/v2/cli/slsa-verifier@latest"
360: fi
361: echo ""
362: 
363: # Verify all binaries
364: verify_all "$VERSION" "$ARCH" "$VERIFY_METHOD"
365: echo ""
366: 
367: # Install binaries
368: if [[ "${SKIP_INSTALL:-0}" != "1" ]]; then
369:     install_binaries "$ARCH"
370:     echo ""
371: fi
372: 
373: # Cleanup
374: if [[ "${KEEP_DOWNLOADS:-0}" != "1" ]]; then
375:     rm -rf "$DOWNLOAD_DIR"
376: fi
377: 
378: echo ""
379: ok "Download and verification complete!"
380: echo ""
381: echo "Verification method: $VERIFY_METHOD"
382: echo "Version installed:   $VERSION"
383: echo ""
384: echo "Next steps:"
385: echo "  nftban version        # Check installation"
386: echo "  nftban health         # Run health check"
387: echo ""
</file>

<file path="install/verify_installation.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan Installation Verification Script
  4: # =============================================================================
  5: # Purpose: Verify all files are correctly installed on target system
  6: # Usage: ./verify_installation.sh [--verbose]
  7: # =============================================================================
  8: 
  9: set -euo pipefail
 10: 
 11: VERBOSE=false
 12: if [[ "${1:-}" == "--verbose" ]] || [[ "${1:-}" == "-v" ]]; then
 13:     VERBOSE=true
 14: fi
 15: 
 16: # Color codes
 17: RED='\033[0;31m'
 18: GREEN='\033[0;32m'
 19: YELLOW='\033[1;33m'
 20: NC='\033[0m' # No Color
 21: 
 22: # Counters
 23: TOTAL=0
 24: MISSING=0
 25: PRESENT=0
 26: 
 27: check_file() {
 28:     local file="$1"
 29:     local required="${2:-true}"
 30: 

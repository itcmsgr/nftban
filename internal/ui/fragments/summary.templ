package fragments

import (
	"strconv"
	"github.com/itcmsgr/nftban/internal/ui"
)

// SummaryCards renders the dashboard summary statistics cards
templ SummaryCards(data ui.SummaryData) {
	<div class="card-grid">
		<div class="card stat-card">
			<div class="stat-label">Active Bans</div>
			<div class="stat-value" style="color: var(--accent-red);">
				{ strconv.Itoa(data.ActiveBans) }
			</div>
		</div>

		<div class="card stat-card">
			<div class="stat-label">Events (1h)</div>
			<div class="stat-value" style="color: var(--accent-yellow);">
				{ strconv.Itoa(data.EventsLastHour) }
			</div>
		</div>

		<div class="card stat-card">
			<div class="stat-label">Modules Active</div>
			<div class="stat-value" style="color: var(--accent-green);">
				{ strconv.Itoa(data.ModulesUp) }
			</div>
		</div>

		<div class="card stat-card">
			<div class="stat-label">Whitelisted IPs</div>
			<div class="stat-value">
				{ strconv.Itoa(data.WhitelistCount) }
			</div>
		</div>
	</div>
}

266: 
267:         # DNS logs (useful for C2/malware detection)
268:         - dns:
269:             version: 2
270:             query: yes
271:             answer: yes
272: 
273:         # TLS logs (for encrypted traffic analysis)
274:         - tls:
275:             extended: yes
276:             session-resumption: yes
277: 
278:         # === DISABLED EVENT TYPES (save CPU + disk) ===
279:         # Uncomment only if you specifically need them
280:         # - stats:
281:         #     totals: no
282:         #     threads: no
283: 
284:         # - flow              # Flow logs (verbose, not needed for NFTBan)
285:         # - netflow           # Netflow export (not needed)
286:         # - drop              # Packet drops (only for debugging)
287:         # - files             # File extraction (not needed)
288:         # - fileinfo          # File metadata (not needed)
289:         # - smtp              # SMTP logs (if you monitor mail)
290:         # - ftp               # FTP logs
291:         # - rdp               # RDP logs
292:         # - nfs               # NFS logs
293:         # - smb               # SMB logs
294:         # - dcerpc            # DCERPC logs
295:         # - dhcp              # DHCP logs
296:         # - anomaly           # Anomaly detection events
297: 
298:   # Fast log (optional, for quick alert review)
299:   - fast:
300:       enabled: no
301:       filename: /var/log/nftban/suricata/fast.log
302: 
303:   # Unified2 output (disable, we use eve.json)
304:   - unified2-alert:
305:       enabled: no
306: 
307: # =============================================================================
308: # RULES & DETECTION ENGINE
309: # =============================================================================
310: # Rule file location
311: default-rule-path: /var/lib/suricata/rules
312: rule-files:

package pages

import (
	"fmt"
	"strconv"
	"github.com/itcmsgr/nftban/internal/ui"
)

// Health renders the full health analysis page
templ Health(data ui.HealthData) {
	@ui.LayoutWithNav("Health", "health") {
		<div class="page-header">
			<h1 class="page-title">System Health</h1>
			<div style="display: flex; gap: 0.5rem; align-items: center;">
				<span id="health-loading" class="htmx-indicator">
					<span class="loading-spinner"></span>
				</span>
				<button class="btn btn-primary" hx-get="/ui/frag/health-all" hx-target="#health-content" hx-swap="innerHTML" hx-indicator="#health-loading">
					Refresh
				</button>
				<button class="btn btn-danger" hx-post="/ui/action/health-fix" hx-confirm="Run auto-heal to fix issues?" data-tooltip="Attempt automatic fixes for detected issues">
					Auto-Heal
				</button>
			</div>
		</div>

		<!-- Overall Status Banner -->
		<div class={ "card", "status-banner", data.OverallStatus } style="margin-bottom: 1.5rem;">
			<div style="display: flex; align-items: center; justify-content: space-between;">
				<div style="display: flex; align-items: center; gap: 1rem;">
					if data.OverallStatus == "ok" {
						<span style="font-size: 2rem;">&#x2705;</span>
						<div>
							<div style="font-size: 1.25rem; font-weight: 600;">All Systems Healthy</div>
							<div style="color: var(--text-muted); font-size: 0.9rem;">No issues detected</div>
						</div>
					} else if data.OverallStatus == "warning" {
						<span style="font-size: 2rem;">&#x26A0;</span>
						<div>
							<div style="font-size: 1.25rem; font-weight: 600;">Warnings Detected</div>
							<div style="color: var(--text-muted); font-size: 0.9rem;">{ intToStr(data.WarningCount) } warning(s) need attention</div>
						</div>
					} else {
						<span style="font-size: 2rem;">&#x274C;</span>
						<div>
							<div style="font-size: 1.25rem; font-weight: 600;">Errors Detected</div>
							<div style="color: var(--text-muted); font-size: 0.9rem;">{ intToStr(data.ErrorCount) } error(s), { intToStr(data.WarningCount) } warning(s)</div>
						</div>
					}
				</div>
				<div style="text-align: right; font-size: 0.85rem; color: var(--text-muted);">
					<div>Last check: { data.Timestamp }</div>
					<div>Exit code: { intToStr(data.ExitCode) }</div>
				</div>
			</div>
		</div>

		<div id="health-content">
			@HealthContentFragment(data)
		</div>
	}
}

// HealthContentFragment renders all health sections
templ HealthContentFragment(data ui.HealthData) {
	<!-- Errors Section (if any) -->
	if len(data.Errors) > 0 {
		<div class="card" style="margin-bottom: 1.5rem; border-left: 4px solid var(--accent-danger);">
			<div class="card-header">
				<span class="card-title" style="color: var(--accent-danger);">Errors ({ intToStr(len(data.Errors)) })</span>
			</div>
			<div style="display: flex; flex-direction: column; gap: 0.75rem;">
				for _, err := range data.Errors {
					<div style="background: rgba(239, 68, 68, 0.1); padding: 0.75rem; border-radius: 6px;">
						<pre style="margin: 0; white-space: pre-wrap; font-size: 0.85rem; color: var(--text-primary);">{ err }</pre>
					</div>
				}
			</div>
		</div>
	}

	<!-- Warnings Section (if any) -->
	if len(data.Warnings) > 0 {
		<div class="card" style="margin-bottom: 1.5rem; border-left: 4px solid var(--accent-warning);">
			<div class="card-header">
				<span class="card-title" style="color: var(--accent-warning);">Warnings ({ intToStr(len(data.Warnings)) })</span>
			</div>
			<div style="display: flex; flex-direction: column; gap: 0.75rem;">
				for _, warn := range data.Warnings {
					<div style="background: rgba(245, 158, 11, 0.1); padding: 0.75rem; border-radius: 6px;">
						<pre style="margin: 0; white-space: pre-wrap; font-size: 0.85rem; color: var(--text-primary);">{ warn }</pre>
					</div>
				}
			</div>
		</div>
	}

	<!-- Health Checks Table -->
	<div class="card">
		<div class="card-header">
			<span class="card-title">Health Checks</span>
		</div>
		<table class="data-table">
			<thead>
				<tr>
					<th>Check</th>
					<th>Status</th>
					<th>Details</th>
				</tr>
			</thead>
			<tbody>
				for _, check := range data.Checks {
					<tr>
						<td style="font-weight: 500; text-transform: capitalize;">{ check.Name }</td>
						<td>
							if check.Status == "ok" {
								<span class="badge badge-success">OK</span>
							} else if check.Status == "warning" {
								<span class="badge badge-warning">Warning</span>
							} else {
								<span class="badge badge-danger">Error</span>
							}
						</td>
						<td style="font-size: 0.85rem; color: var(--text-muted); max-width: 400px;">
							if check.Message != "" {
								<span style="white-space: pre-wrap;">{ check.Message }</span>
							} else {
								<span>-</span>
							}
						</td>
					</tr>
				}
				if len(data.Checks) == 0 {
					<tr>
						<td colspan="3">
							<div class="empty-state">
								<div class="empty-state-icon">&#x1F50D;</div>
								<div class="empty-state-title">No Health Checks Available</div>
								<div class="empty-state-description">Run <code style="background: var(--bg-elevated); padding: 0.25rem 0.5rem; border-radius: 4px;">nftban health check</code> to generate health diagnostics.</div>
							</div>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>

	<!-- System Resources -->
	if data.Extended.Resources.Status != "" {
		<div class="card" style="margin-top: 1.5rem;">
			<div class="card-header">
				<span class="card-title">System Resources</span>
				if data.Extended.Resources.Status == "ok" {
					<span class="badge badge-success">OK</span>
				} else if data.Extended.Resources.Status == "warning" {
					<span class="badge badge-warning">Warning</span>
				} else {
					<span class="badge badge-danger">Critical</span>
				}
			</div>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
				<div class="system-stat">
					<div class="system-label">Load Average</div>
					<div class="system-value">{ fmt.Sprintf("%.2f / %.2f / %.2f", data.Extended.Resources.Load.Load1m, data.Extended.Resources.Load.Load5m, data.Extended.Resources.Load.Load15m) }</div>
					<div style="font-size: 0.8rem; color: var(--text-muted);">{ intToStr(data.Extended.Resources.Load.CPUs) } CPUs</div>
				</div>
				<div class="system-stat">
					<div class="system-label">Memory Usage</div>
					<div class="system-value">{ intToStr(data.Extended.Resources.Memory.UsedPercent) }%</div>
					<div style="font-size: 0.8rem; color: var(--text-muted);">{ intToStr(data.Extended.Resources.Memory.TotalMB) } MB total</div>
				</div>
				<div class="system-stat">
					<div class="system-label">Disk Usage ({ data.Extended.Resources.Disk.Path })</div>
					<div class="system-value">{ intToStr(data.Extended.Resources.Disk.UsedPercent) }%</div>
				</div>
			</div>
		</div>
	}

	<!-- Suricata IDS Status -->
	if data.Extended.Suricata.Installed {
		<div class="card" style="margin-top: 1.5rem;">
			<div class="card-header">
				<span class="card-title">Suricata IDS</span>
				if data.Extended.Suricata.Status == "ok" {
					<span class="badge badge-success">OK</span>
				} else if data.Extended.Suricata.Status == "warning" {
					<span class="badge badge-warning">Warning</span>
				} else if data.Extended.Suricata.Status != "" {
					<span class="badge badge-danger">Error</span>
				}
			</div>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem;">
				<div class="system-stat">
					<div class="system-label">Service</div>
					<div class="system-value">
						if data.Extended.Suricata.ServiceActive {
							<span style="color: var(--accent-green);">Active</span>
						} else {
							<span style="color: var(--accent-danger);">Inactive</span>
						}
					</div>
				</div>
				<div class="system-stat">
					<div class="system-label">EVE Log</div>
					<div class="system-value">
						if data.Extended.Suricata.EVEExists && data.Extended.Suricata.EVEFresh {
							<span style="color: var(--accent-green);">Fresh</span>
						} else if data.Extended.Suricata.EVEExists {
							<span style="color: var(--accent-warning);">Stale</span>
						} else {
							<span style="color: var(--text-muted);">Missing</span>
						}
					</div>
				</div>
				<div class="system-stat">
					<div class="system-label">Rules Loaded</div>
					<div class="system-value">{ intToStr(data.Extended.Suricata.RulesLoaded) }</div>
				</div>
				<div class="system-stat">
					<div class="system-label">Banning</div>
					<div class="system-value">
						if data.Extended.Suricata.BanningActive {
							<span style="color: var(--accent-green);">Active</span>
						} else {
							<span style="color: var(--text-muted);">Inactive</span>
						}
					</div>
				</div>
			</div>
		</div>
	}

	<!-- DNS Resolver Status -->
	if data.Extended.DNS.Status != "" {
		<div class="card" style="margin-top: 1.5rem;">
			<div class="card-header">
				<span class="card-title">DNS Resolver</span>
				if data.Extended.DNS.Status == "ok" {
					<span class="badge badge-success">OK</span>
				} else {
					<span class="badge badge-warning">Issue</span>
				}
			</div>
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem;">
				<div class="system-stat">
					<div class="system-label">Resolver</div>
					<div class="system-value" style="font-size: 0.9rem;">{ data.Extended.DNS.Resolver }</div>
				</div>
				<div class="system-stat">
					<div class="system-label">Status</div>
					<div class="system-value">
						if data.Extended.DNS.Working {
							<span style="color: var(--accent-green);">Working</span>
						} else {
							<span style="color: var(--accent-danger);">Failing</span>
						}
					</div>
				</div>
				<div class="system-stat">
					<div class="system-label">Latency</div>
					<div class="system-value">{ intToStr(data.Extended.DNS.LatencyMS) } ms</div>
				</div>
				if data.Extended.DNS.Hostname != "" {
					<div class="system-stat">
						<div class="system-label">Hostname</div>
						<div class="system-value" style="font-size: 0.85rem;">{ data.Extended.DNS.Hostname }</div>
					</div>
				}
			</div>
		</div>
	}

	<!-- Firewall Conflicts -->
	@HealthFirewallConflicts(data.Extended.FirewallConflicts)

	<!-- Quick Commands -->
	<div class="card" style="margin-top: 1.5rem;">
		<div class="card-header">
			<span class="card-title">Quick Commands</span>
		</div>
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1rem;">
			<div class="cmd-box">
				<code>nftban health check</code>
				<span style="color: var(--text-muted); font-size: 0.85rem;">Full diagnostics</span>
			</div>
			<div class="cmd-box">
				<code>nftban health check --auto-heal</code>
				<span style="color: var(--text-muted); font-size: 0.85rem;">Fix issues automatically</span>
			</div>
			<div class="cmd-box">
				<code>nftban geoip update</code>
				<span style="color: var(--text-muted); font-size: 0.85rem;">Update GeoIP database</span>
			</div>
			<div class="cmd-box">
				<code>nftban services status</code>
				<span style="color: var(--text-muted); font-size: 0.85rem;">Check all services</span>
			</div>
		</div>
	</div>
}

// HealthFirewallConflicts renders conflicting firewall detections
templ HealthFirewallConflicts(fc ui.HealthFirewallConflicts) {
	if fc.CSF.Installed || fc.Firewalld.Installed || fc.UFW.Installed || fc.IPTables.Installed {
		<div class="card" style="margin-top: 1.5rem;">
			<div class="card-header">
				<span class="card-title">Firewall Conflict Detection</span>
			</div>
			<table class="data-table">
				<thead>
					<tr>
						<th>Firewall</th>
						<th>Installed</th>
						<th>Active</th>
						<th>Conflict Level</th>
					</tr>
				</thead>
				<tbody>
					@healthFirewallRow("CSF", fc.CSF)
					@healthFirewallRow("Firewalld", fc.Firewalld)
					@healthFirewallRow("UFW", fc.UFW)
					@healthFirewallRow("IPTables (legacy)", fc.IPTables)
				</tbody>
			</table>
		</div>
	}
}

templ healthFirewallRow(name string, fw ui.HealthFirewall) {
	if fw.Installed {
		<tr>
			<td style="font-weight: 500;">{ name }</td>
			<td><span class="badge badge-warning">Yes</span></td>
			<td>
				if fw.Active {
					<span class="badge badge-danger">Active</span>
				} else {
					<span class="badge badge-muted">Inactive</span>
				}
			</td>
			<td>
				if fw.ConflictLevel == "critical" {
					<span class="badge badge-danger">Critical</span>
				} else if fw.ConflictLevel == "high" {
					<span class="badge badge-danger">High</span>
				} else if fw.ConflictLevel == "warning" {
					<span class="badge badge-warning">Warning</span>
				} else {
					<span class="badge badge-muted">None</span>
				}
			</td>
		</tr>
	}
}

func intToStr(n int) string {
	return strconv.Itoa(n)
}

 59: 
 60: # In-memory tracking arrays
 61: declare -gA _PORTSCAN_CLASSIC_IP_PORTS       # IP -> ports seen (space-separated)
 62: declare -gA _PORTSCAN_CLASSIC_IP_TIMESTAMPS  # IP -> timestamps (space-separated)
 63: declare -gA _PORTSCAN_CLASSIC_IP_TARGETS     # IP -> target IPs (space-separated)
 64: declare -gA _PORTSCAN_CLASSIC_IP_BLOCKED     # IP -> block timestamp
 65: declare -gA _PORTSCAN_CLASSIC_IP_BAN_COUNT   # IP -> number of times banned
 66: 
 67: # Initialize state tracking
 68: nftban_portscan_classic_init_state() {
 69:     _PORTSCAN_CLASSIC_IP_PORTS=()
 70:     _PORTSCAN_CLASSIC_IP_TIMESTAMPS=()
 71:     _PORTSCAN_CLASSIC_IP_TARGETS=()
 72:     _PORTSCAN_CLASSIC_IP_BLOCKED=()
 73:     _PORTSCAN_CLASSIC_IP_BAN_COUNT=()
 74: 
 75:     # Load persistent state if exists
 76:     if [[ -f "${PORTSCAN_CLASSIC_STATE_FILE}" ]]; then
 77:         nftban_portscan_classic_load_state
 78:     fi
 79: 
 80:     return 0
 81: }
 82: 
 83: # Save state to disk
 84: nftban_portscan_classic_save_state() {
 85:     local state_file="${PORTSCAN_CLASSIC_STATE_FILE}"
 86:     local state_dir
 87:     state_dir=$(dirname "$state_file")
 88: 
 89:     [[ -d "$state_dir" ]] || mkdir -p "$state_dir"
 90: 
 91:     {
 92:         echo "# NFTBan Portscan Classic State - $(date -Iseconds)"
 93:         echo "# Format: TYPE|IP|DATA"
 94: 
 95:         for ip in "${!_PORTSCAN_CLASSIC_IP_BLOCKED[@]}"; do

352:   interval: 60           # Log stats every 60 seconds
353: 
354:   decoder-events: yes
355:   decoder-events-prefix: "decoder.event"
356: 
357:   stream-events: no      # Disable to save CPU
358: 
359: # =============================================================================
360: # HOST OS SETTINGS
361: # =============================================================================
362: host-mode: auto          # Auto-detect IDS vs IPS mode
363: 
364: # =============================================================================

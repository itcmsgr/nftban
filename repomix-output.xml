460: # Ban countries (add to blacklist)
461: nftban_geoban_ban_countries() {
462:     local countries=("$@")
463: 
464:     # Checks
465:     nftban_geoban_check_enabled || return 1
466:     # Don't fail if binary missing - we have bash fallback now!
467:     # nftban_geoban_check_binary || return 1
468:     nftban_geoban_ensure_directories
469: 
470:     if [[ ${#countries[@]} -eq 0 ]]; then
471:         nftban_error "No countries specified"
472:         nftban_info "Usage: nftban geoip ban <CC> [CC...]"
473:         nftban_info "Example: nftban geoip ban CN RU KP"
474:         return 1
475:     fi
476: 
477:     # Process each country
478:     local success=0
479:     local failed=0
480: 
481:     for cc in "${countries[@]}"; do
482:         # Uppercase country code
483:         cc=$(echo "${cc}" | tr '[:lower:]' '[:upper:]')
484: 
485:         # Validate
486:         nftban_geoban_validate_country_code "${cc}" || {
487:             ((failed++))
488:             continue
489:         }
490: 
491:         nftban_info "Banning country: ${cc}"
492: 
493:         # Use smart fetch (Go with bash fallback)
494:         if nftban_geoban_fetch_country "${cc}" "ban"; then
495:             nftban_success "Successfully banned ${cc}"
496:             # Audit log the action
497:             if [[ "$LOGGING_ENABLED" == "true" ]]; then
498:                 nftban_audit_geoban "block" "${cc}" "geoban_ban_countries"
499:             fi
500:             ((success++))
501:         else
502:             nftban_error "Failed to ban ${cc}"
503:             ((failed++))
504:         fi
505:     done
506: 
507:     # Summary
508:     echo ""
509:     nftban_info "Summary: ${success} succeeded, ${failed} failed"
510: 
511:     if [[ ${success} -gt 0 ]]; then
512:         nftban_info "View banned countries: nftban geoip list"
513:         echo ""
514: 
515:         # ARCHITECTURE COMPLIANCE: Always use timer-based queue for nftables sync
516:         # NEVER execute synchronous sync - all feeds/ban/unban/countries managed by timer
517:         # This prevents 30+ second hangs with large IP sets and respects async architecture
518:         nftban_queue_add "geoban_apply" "Countries banned: $*" >/dev/null 2>&1
519: 
520:         nftban_info "✅ GeoBan configured successfully"
521:         nftban_info "   NFTables update queued (processed every 2 minutes)"
522:         nftban_info "   Check queue: tail -f ${NFTBAN_LOG_DIR}/queue.log"
523:         echo ""
524:     fi
525: 
526:     [[ ${failed} -eq 0 ]] && return 0 || return 1
527: }

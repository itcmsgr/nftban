// =============================================================================
// NFTBan - Polkit Authorization for System User
// =============================================================================
// SPDX-License-Identifier: MPL-2.0
// Purpose: Grant nftban system user permission to execute nft commands
// Location: /etc/polkit-1/rules.d/61-nftban-system.rules
//
// Security Model:
// - Only the nftban system user is granted permissions
// - Allows execution of /usr/sbin/nft command (nftables manipulation)
// - NO root services - uses Polkit for privilege escalation
// - Follows fail2ban model: dedicated user + Polkit authorization
//
// Usage:
//   Automatically applied when systemd service runs as User=nftban
//   No manual configuration needed
//
// Commands this enables (as nftban user):
//   nft list ruleset
//   nft add element ...
//   nft delete element ...
//   nftban feeds update (calls nft internally)
//
// Design Philosophy:
//   ✓ NO root services
//   ✓ Use Polkit for privilege escalation
//   ✓ Follow fail2ban model
//   ✓ Least privilege principle
// =============================================================================

polkit.addRule(function(action, subject) {
  // Only handle requests from nftban system user
  if (subject.user !== "nftban") {
    return polkit.Result.NOT_HANDLED;
  }

  // Allow nftban user to execute nft commands
  // This is required for feeds update and nftables manipulation
  if (action.id === "org.freedesktop.policykit.exec" &&
      action.lookup("program") === "/usr/sbin/nft") {
    return polkit.Result.YES;
  }

  // Not handled - fall through to default Polkit policy
  return polkit.Result.NOT_HANDLED;
});

// =============================================================================
// SECURITY NOTES
// =============================================================================
//
// Why this is safe:
// - Scope limited to nftban user only (system account, no login shell)
// - Only allows execution of /usr/sbin/nft (nftables management)
// - No broad system access granted
// - No sudoers, no setuid binaries
// - Standard Polkit authorization flow via D-Bus
//
// Alternative approaches considered:
// 1. Run service as root - ❌ REJECTED (security risk)
// 2. Use sudo - ❌ REJECTED (adds complexity, less secure than Polkit)
// 3. Use Polkit - ✅ CHOSEN (follows best practices, fail2ban model)
//
// To verify rule is loaded:
//   pkaction --action-id org.freedesktop.policykit.exec --verbose
//
// To test authorization (as nftban user):
//   sudo -u nftban nft list ruleset     # Should work
//   sudo -u nftban nftban feeds update   # Should work
//
// Related:
// - BUG-007: Missing Polkit rule for nftban user
// - docs/architecture/permission-architecture.md
// - KNOWN_BUGS.md
//
// =============================================================================

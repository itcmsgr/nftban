 923: nftban_report_cmd_status() {
 924:     # Show comprehensive report configuration status
 925:     # Usage: nftban report status [--json]
 926: 
 927:     local json_mode=0
 928:     [[ "${1:-}" == "--json" ]] && json_mode=1
 929: 
 930:     # Source mail config if available
 931:     local mail_conf="${NFTBAN_CONFIG_DIR:-/etc/nftban}/conf.d/mail.conf"
 932:     local mail_local="${NFTBAN_CONFIG_DIR:-/etc/nftban}/conf.d/mail.conf.local"
 933:     [[ -f "$mail_conf" ]] && source "$mail_conf" 2>/dev/null || true
 934:     [[ -f "$mail_local" ]] && source "$mail_local" 2>/dev/null || true
 935: 
 936:     # Source stats config if available
 937:     local stats_conf="${NFTBAN_CONFIG_DIR:-/etc/nftban}/conf.d/stats.conf"
 938:     local stats_local="${NFTBAN_CONFIG_DIR:-/etc/nftban}/conf.d/stats.conf.local"
 939:     [[ -f "$stats_conf" ]] && source "$stats_conf" 2>/dev/null || true
 940:     [[ -f "$stats_local" ]] && source "$stats_local" 2>/dev/null || true
 941: 
 942:     if [[ $json_mode -eq 1 ]]; then
 943:         _report_status_json
 944:         return 0
 945:     fi
 946: 
 947:     echo "=============================================================="
 948:     echo "  NFTBan Report Configuration Status"
 949:     echo "=============================================================="
 950:     echo ""
 951: 
 952:     # ─────────────────────────────────────────────────────────────────
 953:     # EMAIL DELIVERY
 954:     # ─────────────────────────────────────────────────────────────────
 955:     echo "EMAIL DELIVERY"
 956:     echo "--------------------------------------------------------------"
 957: 
 958:     local mail_enabled="${MAIL_ENABLED:-${NFTBAN_MAIL_ENABLED:-false}}"
 959:     local mail_recipients="${STATS_EMAIL_RECIPIENTS:-${NFTBAN_MAIL_RECIPIENT:-}}"
 960:     local mail_from="${MAIL_FROM:-${NFTBAN_MAIL_FROM:-nftban@$(hostname -f 2>/dev/null || hostname)}}"
 961:     local mail_cmd=""
 962: 
 963:     # Detect mail command
 964:     if command -v msmtp &>/dev/null; then
 965:         mail_cmd="msmtp"
 966:     elif command -v sendmail &>/dev/null; then
 967:         mail_cmd="sendmail"
 968:     elif command -v mailx &>/dev/null; then
 969:         mail_cmd="mailx"
 970:     elif command -v mail &>/dev/null; then
 971:         mail_cmd="mail"
 972:     else
 973:         mail_cmd="NOT FOUND"
 974:     fi
 975: 
 976:     if [[ "$mail_enabled" == "true" ]]; then
 977:         printf "  %-20s %s\n" "Status.............." "ENABLED"
 978:     else
 979:         printf "  %-20s %s\n" "Status.............." "DISABLED"
 980:     fi
 981: 
 982:     if [[ -n "$mail_recipients" ]]; then
 983:         printf "  %-20s %s\n" "Recipients.........." "$mail_recipients"
 984:     else
 985:         printf "  %-20s %s\n" "Recipients.........." "(not configured)"
 986:     fi
 987: 
 988:     printf "  %-20s %s\n" "From Address........" "$mail_from"
 989:     printf "  %-20s %s\n" "Mail Command........" "$mail_cmd"
 990:     echo ""
 991: 
 992:     # ─────────────────────────────────────────────────────────────────
 993:     # SCHEDULED REPORTS
 994:     # ─────────────────────────────────────────────────────────────────
 995:     echo "SCHEDULED REPORTS"
 996:     echo "--------------------------------------------------------------"
 997: 
 998:     local cron_file="${NFTBAN_CRON_FILE:-/etc/cron.d/nftban-stats}"
 999:     local has_schedules=0
1000: 
1001:     if [[ -f "$cron_file" ]]; then
1002:         # Parse cron entries
1003:         local daily_time="" weekly_time="" monthly_time=""
1004: 
1005:         while IFS= read -r line; do
1006:             [[ "$line" =~ ^# ]] && continue
1007:             [[ -z "$line" ]] && continue
1008: 
1009:             if [[ "$line" =~ nftban.*report.*run.*daily ]]; then
1010:                 local min hour
1011:                 min=$(echo "$line" | awk '{print $1}')
1012:                 hour=$(echo "$line" | awk '{print $2}')
1013:                 # Use 10# to force decimal interpretation (avoid octal issues with 08, 09)
1014:                 daily_time=$(printf "%02d:%02d" "$((10#$hour))" "$((10#$min))")
1015:                 has_schedules=1
1016:             elif [[ "$line" =~ nftban.*report.*run.*weekly ]]; then
1017:                 local min hour dow
1018:                 min=$(echo "$line" | awk '{print $1}')
1019:                 hour=$(echo "$line" | awk '{print $2}')
1020:                 dow=$(echo "$line" | awk '{print $5}')
1021:                 weekly_time=$(printf "%02d:%02d (day %s)" "$((10#$hour))" "$((10#$min))" "$dow")
1022:                 has_schedules=1
1023:             elif [[ "$line" =~ nftban.*report.*run.*monthly ]]; then
1024:                 local min hour dom
1025:                 min=$(echo "$line" | awk '{print $1}')
1026:                 hour=$(echo "$line" | awk '{print $2}')
1027:                 dom=$(echo "$line" | awk '{print $3}')
1028:                 monthly_time=$(printf "%02d:%02d (day %s)" "$((10#$hour))" "$((10#$min))" "$dom")
1029:                 has_schedules=1  # shellcheck disable=SC2034  # Reserved for schedule validation
1030:             fi
1031:         done < "$cron_file"
1032: 
1033:         if [[ -n "$daily_time" ]]; then
1034:             printf "  %-20s %s\n" "Daily..............." "$daily_time"
1035:         else
1036:             printf "  %-20s %s\n" "Daily..............." "Not configured"
1037:         fi
1038: 
1039:         if [[ -n "$weekly_time" ]]; then
1040:             printf "  %-20s %s\n" "Weekly.............." "$weekly_time"
1041:         else
1042:             printf "  %-20s %s\n" "Weekly.............." "Not configured"
1043:         fi
1044: 
1045:         if [[ -n "$monthly_time" ]]; then
1046:             printf "  %-20s %s\n" "Monthly............." "$monthly_time"
1047:         else
1048:             printf "  %-20s %s\n" "Monthly............." "Not configured"
1049:         fi
1050:     else
1051:         printf "  %-20s %s\n" "Daily..............." "Not configured"
1052:         printf "  %-20s %s\n" "Weekly.............." "Not configured"
1053:         printf "  %-20s %s\n" "Monthly............." "Not configured"
1054:     fi
1055:     echo ""
1056: 
1057:     # ─────────────────────────────────────────────────────────────────
1058:     # STORAGE
1059:     # ─────────────────────────────────────────────────────────────────
1060:     echo "STORAGE"
1061:     echo "--------------------------------------------------------------"
1062: 
1063:     local reports_dir="${NFTBAN_REPORTS_DIR:-${NFTBAN_DATA_DIR:-/var/lib/nftban}/reports}"
1064:     printf "  %-20s %s\n" "Reports Directory..." "$reports_dir"
1065: 
1066:     if [[ -d "$reports_dir" ]]; then
1067:         local report_count
1068:         report_count=$(find "$reports_dir" -type f \( -name "*.html" -o -name "*.json" -o -name "*.csv" \) 2>/dev/null | wc -l)
1069:         local total_size
1070:         total_size=$(du -sh "$reports_dir" 2>/dev/null | awk '{print $1}' || echo "0")
1071:         local last_report=""
1072:         last_report=$(find "$reports_dir" -type f \( -name "*.html" -o -name "*.json" \) -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -1 | awk '{print $2}')
1073: 
1074:         printf "  %-20s %s\n" "Report Count........" "$report_count files"
1075:         printf "  %-20s %s\n" "Total Size.........." "$total_size"
1076: 
1077:         if [[ -n "$last_report" ]]; then
1078:             local last_date
1079:             last_date=$(stat -c %y "$last_report" 2>/dev/null | cut -d' ' -f1)
1080:             printf "  %-20s %s\n" "Last Report........." "$last_date ($(basename "$last_report"))"
1081:         else
1082:             printf "  %-20s %s\n" "Last Report........." "(none)"
1083:         fi
1084:     else
1085:         printf "  %-20s %s\n" "Report Count........" "(directory not found)"
1086:     fi
1087:     echo ""
1088: 
1089:     # ─────────────────────────────────────────────────────────────────
1090:     # QUICK COMMANDS
1091:     # ─────────────────────────────────────────────────────────────────
1092:     echo "=============================================================="
1093:     echo "QUICK COMMANDS"
1094:     echo "  nftban report generate            Generate report now"
1095:     echo "  nftban report schedule daily      Set up daily schedule"
1096:     echo "  nftban report email test          Send test email"
1097:     echo "  nftban report list                List generated reports"
1098:     echo "=============================================================="
1099: 
1100:     return 0
1101: }

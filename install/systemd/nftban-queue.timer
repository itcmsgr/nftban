# =============================================================================
# NFTBan v1.0.0 - Queue Processor Timer
# =============================================================================
# SPDX-License-Identifier: MPL-2.0
# Purpose: Systemd timer unit that triggers queue processing every 5 minutes
#
# meta:name="nftban_queue_timer"
# meta:type="config"
# meta:owner="Antonios Voulvoulis <contact@nftban.com>"
# meta:created_date="2025-11-05"
# meta:description="Timer that triggers NFTBan queue processor every 5 minutes"
# meta:input="None"
# meta:output="Triggers nftban-queue.service"
# meta:depends="nftban-queue.service"
#
# meta:inventory.files=""
# meta:inventory.binaries=""
# meta:inventory.env_vars=""
# meta:inventory.config_files=""
# meta:inventory.systemd_units="nftban-queue.service"
# meta:inventory.network=""
# meta:inventory.privileges="none"
# =============================================================================

[Unit]
Description=NFTBan Task Queue Processor Timer
Documentation=man:nftban(8)

[Timer]
# OPTIMIZED: 5 minutes (reduces 60% of timer overhead vs original 2min)
# Queue processing is not latency-critical - 5min is acceptable
OnBootSec=3min
OnUnitActiveSec=5min

# Allow systemd to batch
AccuracySec=30s

# SMART JITTER: 40% variance (2min on 5min interval)
RandomizedDelaySec=2min
FixedRandomDelay=true

# Catch up if missed (ensures queue doesn't grow unbounded)
Persistent=true

[Install]
WantedBy=timers.target

 1: // Package system provides unified system lookup utilities
 2: package system
 3: 
 4: import (
 5: 	"bufio"
 6: 	"fmt"
 7: 	"os"
 8: 	"os/user"
 9: 	"strings"
10: )
11: 
12: // LookupGroupID finds GID by group name
13: // Prefers os/user package, falls back to /etc/group parsing
14: func LookupGroupID(name string) (int, error) {
15: 	// Try standard library first
16: 	g, err := user.LookupGroup(name)
17: 	if err == nil {
18: 		var gid int
19: 		fmt.Sscanf(g.Gid, "%d", &gid)
20: 		return gid, nil
21: 	}
22: 
23: 	// Fallback: manual /etc/group parsing
24: 	return lookupGroupFromFile(name)
25: }
26: 
27: // lookupGroupFromFile parses /etc/group directly
28: func lookupGroupFromFile(name string) (int, error) {
29: 	file, err := os.Open("/etc/group")
30: 	if err != nil {
31: 		return 0, err
32: 	}
33: 	defer file.Close()
34: 
35: 	scanner := bufio.NewScanner(file)
36: 	for scanner.Scan() {
37: 		line := scanner.Text()
38: 		if line == "" || strings.HasPrefix(line, "#") {
39: 			continue
40: 		}
41: 		parts := strings.Split(line, ":")
42: 		if len(parts) >= 3 && parts[0] == name {
43: 			var gid int
44: 			fmt.Sscanf(parts[2], "%d", &gid)
45: 			return gid, nil
46: 		}
47: 	}
48: 	if err := scanner.Err(); err != nil {
49: 		return 0, err
50: 	}
51: 	return 0, fmt.Errorf("group %s not found", name)
52: }
53: 
54: // GetUserGroups returns all group names for a user
55: func GetUserGroups(u *user.User) ([]string, error) {
56: 	gids, err := u.GroupIds()
57: 	if err != nil {
58: 		return nil, err
59: 	}
60: 
61: 	groups := make([]string, 0, len(gids))
62: 	for _, gid := range gids {
63: 		g, err := user.LookupGroupId(gid)
64: 		if err != nil {
65: 			continue // Skip groups we can't resolve
66: 		}
67: 		groups = append(groups, g.Name)
68: 	}
69: 	return groups, nil
70: }

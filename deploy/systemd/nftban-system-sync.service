[Unit]
Description=NFTBan System IP Sync (Auto-protect server IPs)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/lib/nftban/cli/cmd_whitelist_system.sh sync
User=root
Group=root
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_INET AF_INET6

# Capabilities (need NET_ADMIN for nftables)
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN

# Writable paths
ReadWritePaths=/etc/nftban /var/lib/nftban /var/log/nftban /var/backups/nftban /run/nftban

# Timeout (max 5 minutes)
TimeoutStartSec=5min

[Install]
WantedBy=multi-user.target

[Unit]
Description=NFTBan Firewall Snapshot (save current state)
Documentation=man:nftban(8)
After=nftban-firewall-init.service

[Service]
Type=oneshot

# Run as nftban user (has write access to /var/lib/nftban)
User=nftban
Group=nftban

# Save current firewall state to snapshot
ExecStart=/usr/sbin/nftban snapshot save

# Nice priority (low impact)
Nice=10
IOSchedulingClass=best-effort

[Install]
WantedBy=multi-user.target

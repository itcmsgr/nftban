1187: 
1188:     # Source distro config loader
1189:     if [[ -f "$SCRIPT_DIR/cli/lib/nftban/lib/nftban_distro_config.sh" ]]; then
1190:         export NFTBAN_DISTRO_CONF_DIR="$SCRIPT_DIR/etc/nftban/distros"
1191:         source "$SCRIPT_DIR/cli/lib/nftban/lib/nftban_distro_config.sh"
1192:     else
1193:         warn "Distro config system not found, skipping dependency installation"
1194:         return 0
1195:     fi
1196: 
1197:     # Initialize distro detection
1198:     if ! nftban_distro_init; then
1199:         warn "Failed to detect distribution, skipping dependency installation"
1200:         return 0
1201:     fi
1202: 
1203:     # Check if package manager is available
1204:     local pkg_type="${DISTRO_PKGMGR[type]}"
1205:     local install_cmd="${DISTRO_PKGMGR[install_cmd]}"
1206:     local update_cmd="${DISTRO_PKGMGR[update_cmd]}"
1207: 
1208:     if [[ -z "$install_cmd" ]]; then
1209:         warn "No package manager configured, skipping dependency installation"
1210:         return 0
1211:     fi
1212: 
1213:     log "Detected: ${DISTRO_INFO[name]} ${DISTRO_INFO[version]} (${pkg_type})"
1214:     echo ""
1215: 
1216:     # Update package cache
1217:     log "Updating package cache..."
1218:     if eval "$update_cmd" >/dev/null 2>&1; then
1219:         ok "Package cache updated"
1220:     else
1221:         warn "Package cache update failed (non-critical)"
1222:     fi
1223: 
1224:     # Required packages for NFTBan
1225:     local required_packages=(
1226:         nftables
1227:         curl
1228:         suricata
1229:         suricata_update
1230:         jq
1231:     )
1232: 
1233:     # Optional packages (install if available)
1234:     local optional_packages=(
1235:         wget
1236:         git
1237:         prometheus
1238:         node_exporter
1239:     )
1240: 
1241:     # Install required packages
1242:     log "Installing required packages..."
1243:     local installed=0
1244:     local failed=0
1245: 
1246:     for pkg_key in "${required_packages[@]}"; do
1247:         local pkg_name="${DISTRO_PACKAGES[$pkg_key]}"
1248: 
1249:         if [[ -z "$pkg_name" ]]; then
1250:             warn "Package '$pkg_key' not defined for this distro"
1251:             failed=$((failed + 1))
1252:             continue
1253:         fi
1254: 
1255:         # Check if already installed
1256:         if command -v "$pkg_key" &>/dev/null || dpkg -l "$pkg_name" 2>/dev/null | grep -q "^ii"; then
1257:             echo "  ✓ $pkg_name (already installed)"
1258:             continue
1259:         fi
1260: 
1261:         # Install package
1262:         echo "  Installing $pkg_name..."
1263:         if eval "$install_cmd $pkg_name" >/dev/null 2>&1; then
1264:             ok "  ✓ $pkg_name"
1265:             installed=$((installed + 1))
1266:         else
1267:             warn "  ✗ $pkg_name (failed)"
1268:             failed=$((failed + 1))
1269:         fi
1270:     done
1271: 
1272:     # Install optional packages (fail silently)
1273:     for pkg_key in "${optional_packages[@]}"; do
1274:         local pkg_name="${DISTRO_PACKAGES[$pkg_key]}"
1275:         [[ -z "$pkg_name" ]] && continue
1276: 
1277:         if command -v "$pkg_key" &>/dev/null; then
1278:             continue
1279:         fi
1280: 
1281:         eval "$install_cmd $pkg_name" >/dev/null 2>&1 && installed=$((installed + 1)) || true
1282:     done
1283: 
1284:     echo ""
1285:     if [[ $failed -gt 0 ]]; then
1286:         warn "Some packages failed to install ($failed failed)"
1287:         echo "    You may need to install them manually"
1288:     else
1289:         ok "All dependencies installed ($installed new packages)"
1290:     fi
1291: 
1292:     return 0
1293: }

 23: // LoggingMiddleware logs all HTTP requests
 24: func LoggingMiddleware(next http.Handler) http.Handler {
 25: 	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
 26: 		start := time.Now()
 27: 		clientIP := netutil.GetClientIP(r)
 28: 
 29: 		// Create response writer wrapper to capture status code
 30: 		lrw := &loggingResponseWriter{ResponseWriter: w, statusCode: http.StatusOK}
 31: 
 32: 		// Call next handler
 33: 		next.ServeHTTP(lrw, r)
 34: 
 35: 		// Log request
 36: 		duration := time.Since(start)
 37: 		log.Printf("[HTTP] %s %s %s - %d - %v", clientIP, r.Method, r.RequestURI, lrw.statusCode, duration)
 38: 	})
 39: }
 40: 
 41: // loggingResponseWriter wraps http.ResponseWriter to capture status code
 42: type loggingResponseWriter struct {
 43: 	http.ResponseWriter
 44: 	statusCode int
 45: }
 46: 
 47: func (lrw *loggingResponseWriter) WriteHeader(code int) {
 48: 	lrw.statusCode = code
 49: 	lrw.ResponseWriter.WriteHeader(code)
 50: }
 51: 
 52: // IPWhitelistMiddleware enforces IP-based access control
 53: // SECURITY: Logs warning at startup if whitelist file is missing (all IPs will be denied)
 54: func IPWhitelistMiddleware(cfg *config.Config) func(http.Handler) http.Handler {
 55: 	// Check whitelist file at startup and warn if missing
 56: 	if _, err := os.Stat(cfg.IPWhitelistFile); os.IsNotExist(err) {
 57: 		log.Printf("[SECURITY] WARNING: IP whitelist file %s does not exist - ALL IPs will be DENIED access", cfg.IPWhitelistFile)
 58: 	} else if err != nil {
 59: 		log.Printf("[SECURITY] WARNING: Cannot access IP whitelist file %s: %v", cfg.IPWhitelistFile, err)
 60: 	} else {
 61: 		log.Printf("[SECURITY] IP whitelist enabled using: %s", cfg.IPWhitelistFile)
 62: 	}
 63: 
 64: 	return func(next http.Handler) http.Handler {
 65: 		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
 66: 			clientIP := netutil.GetClientIP(r)
 67: 
 68: 			// Check if IP is whitelisted
 69: 			allowed, err := netutil.IsIPWhitelisted(clientIP, cfg.IPWhitelistFile)
 70: 			if err != nil {
 71: 				log.Printf("[SECURITY] IP whitelist check error for %s: %v", clientIP, err)
 72: 				http.Error(w, "Internal server error", http.StatusInternalServerError)
 73: 				return
 74: 			}
 75: 
 76: 			if !allowed {
 77: 				log.Printf("[SECURITY] Blocked access from non-whitelisted IP: %s", clientIP)
 78: 				http.Error(w, "Access denied - IP not whitelisted", http.StatusForbidden)
 79: 				return
 80: 			}
 81: 
 82: 			// IP is whitelisted, proceed
 83: 			next.ServeHTTP(w, r)
 84: 		})
 85: 	}
 86: }
 87: 
 88: // JWTAuthMiddleware validates JWT tokens
 89: // The authService is created once and reused for all requests (performance optimization)
 90: func JWTAuthMiddleware(cfg *config.Config) func(http.Handler) http.Handler {
 91: 	// Create auth service ONCE at middleware initialization, not per-request
 92: 	authService, err := auth.NewPAMAuth(cfg)
 93: 	if err != nil {
 94: 		log.Printf("[AUTH] FATAL: Failed to initialize auth service for middleware: %v", err)
 95: 		// Return middleware that always fails if auth service couldn't be created
 96: 		return func(next http.Handler) http.Handler {
 97: 			return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
 98: 				http.Error(w, "Authentication service unavailable", http.StatusInternalServerError)
 99: 			})
100: 		}
101: 	}
102: 
103: 	return func(next http.Handler) http.Handler {
104: 		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
105: 			// Extract token from Authorization header
106: 			authHeader := r.Header.Get("Authorization")
107: 			if authHeader == "" {
108: 				http.Error(w, "Missing authorization header", http.StatusUnauthorized)
109: 				return
110: 			}
111: 
112: 			// Parse Bearer token
113: 			parts := strings.SplitN(authHeader, " ", 2)
114: 			if len(parts) != 2 || parts[0] != "Bearer" {
115: 				http.Error(w, "Invalid authorization header format", http.StatusUnauthorized)
116: 				return
117: 			}
118: 
119: 			tokenString := parts[1]
120: 
121: 			// Validate token using pre-initialized auth service
122: 			claims, err := authService.ValidateToken(tokenString)
123: 			if err != nil {
124: 				log.Printf("[AUTH] Invalid token from %s: %v", netutil.GetClientIP(r), err)
125: 				w.Header().Set("Content-Type", "application/json")
126: 				w.WriteHeader(http.StatusUnauthorized)
127: 				json.NewEncoder(w).Encode(map[string]interface{}{
128: 					"success": false,
129: 					"error":   "Invalid or expired token",
130: 				})
131: 				return
132: 			}
133: 
134: 			// Add user to context
135: 			ctx := context.WithValue(r.Context(), UserContextKey, claims)
136: 			next.ServeHTTP(w, r.WithContext(ctx))
137: 		})
138: 	}
139: }
140: 
141: // SecurityHeadersMiddleware adds security headers to responses
142: func SecurityHeadersMiddleware(next http.Handler) http.Handler {
143: 	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
144: 		// Prevent clickjacking
145: 		w.Header().Set("X-Frame-Options", "DENY")
146: 
147: 		// Prevent MIME type sniffing
148: 		w.Header().Set("X-Content-Type-Options", "nosniff")
149: 
150: 		// Enable XSS protection
151: 		w.Header().Set("X-XSS-Protection", "1; mode=block")
152: 
153: 		// HSTS (HTTP Strict Transport Security)
154: 		w.Header().Set("Strict-Transport-Security", "max-age=31536000; includeSubDomains")
155: 
156: 		// Content Security Policy - Allow Chart.js CDN only (no external iframes)
157: 		// NOTE: Tailwind removed in v0.7 - using pure CSS now
158: 		w.Header().Set("Content-Security-Policy", "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self';")
159: 
160: 		// Referrer Policy
161: 		w.Header().Set("Referrer-Policy", "no-referrer")
162: 
163: 		// Permissions Policy
164: 		w.Header().Set("Permissions-Policy", "geolocation=(), microphone=(), camera=()")
165: 
166: 		next.ServeHTTP(w, r)
167: 	})
168: }
169: 
170: // GetClientIP extracts the real client IP address
171: // Exported for backward compatibility - delegates to netutil.GetClientIP
172: // Deprecated: Use netutil.GetClientIP directly for new code
173: func GetClientIP(r *http.Request) string {
174: 	return netutil.GetClientIP(r)
175: }

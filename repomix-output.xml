 934: // AddPortElements adds port numbers to a port set
 935: func (m *NFTManager) AddPortElements(set *nftables.Set, ports []int) error {
 936: 	if len(ports) == 0 {
 937: 		return nil
 938: 	}
 939: 
 940: 	var elements []nftables.SetElement
 941: 	for _, port := range ports {
 942: 		// Validate port range
 943: 		if port < 1 || port > 65535 {
 944: 			return fmt.Errorf("invalid port number: %d (must be 1-65535)", port)
 945: 		}
 946: 
 947: 		// Port numbers are uint16 in big-endian format
 948: 		portBytes := []byte{byte(port >> 8), byte(port & 0xff)}
 949: 		elements = append(elements, nftables.SetElement{
 950: 			Key: portBytes,
 951: 		})
 952: 	}
 953: 
 954: 	if err := m.conn.SetAddElements(set, elements); err != nil {
 955: 		return fmt.Errorf("failed to add port elements: %w", err)
 956: 	}
 957: 
 958: 	if err := m.conn.Flush(); err != nil {
 959: 		return fmt.Errorf("failed to flush port elements: %w", err)
 960: 	}

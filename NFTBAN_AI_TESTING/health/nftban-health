#!/usr/bin/env bash
# SPDX-License-Identifier: MPL-2.0
# nftban-health - Enhanced health check with inventory, diff, and signing
# Part of NFTBan v0.30 - Self-healing monitoring system

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: nftban-health [--alert|--inventory] [--diff BASELINE.json] [--sign KEY.pem]

  --alert           Produce short alert JSON (suspicious ports + tampered pkgs)
  --inventory       Produce full inventory JSON
  --diff FILE       Compare current output against FILE and emit a diff report
  --sign KEY.pem    Wrap the (possibly diffed) JSON in a signed envelope using
                    OpenSSL (SHA-256). Signature and key fingerprint are included.

Notes:
- You can combine --diff and --sign (diff first, then sign the final JSON).
- Requires: python3, openssl, pkexec (for polkit)
- Non-root users in 'nftban-auditors' group can run via polkit
EOF
}

run() { pkexec "$@"; }

MODE=""
BASELINE=""
SIGN_KEY=""

# Parse arguments
while (( "$#" )); do
  case "$1" in
    --alert|--inventory) MODE="$1"; shift;;
    --diff) BASELINE="${2:-}"; shift 2;;
    --sign) SIGN_KEY="${2:-}"; shift 2;;
    -h|--help) usage; exit 0;;
    *) echo "Unknown arg: $1" >&2; usage; exit 2;;
  esac
done

[ -n "$MODE" ] || { echo "Choose --alert or --inventory" >&2; usage; exit 2; }

# --- Core runners ---
make_alert() {
  local PROC VER
  PROC="$(run /usr/libexec/nftban/nftban-procnet)"
  VER="$(run /usr/libexec/nftban/nftban-verify)"

  python3 - "$PROC" "$VER" <<'PY'
import json, sys
proc=json.loads(sys.argv[1]); ver=json.loads(sys.argv[2])
sus=[]
for s in proc.get("sockets",[]):
    if s.get("proto")=="tcp" and s.get("state")=="LISTEN":
        try: port=int(s["local"].rsplit(":",1)[-1])
        except: continue
        common={22,80,443,25,110,143,465,587,993,995,53,3306,5432}
        if port not in common:
            sus.append({"pid":s.get("pid"),"exe":s.get("exe"),"port":port,
                        "addr":(s.get("local") or "").split("%")[0],
                        "reason":"non-standard port"})
alert={"time":proc.get("time"),"host":proc.get("host"),
        "findings":{"suspicious_processes":sus,"tampered_packages":ver.get("tampered",[])}}
print(json.dumps(alert))
PY
}

make_inventory() {
  local PROC PKG FW
  PROC="$(run /usr/libexec/nftban/nftban-procnet)"
  PKG="$(run /usr/libexec/nftban/nftban-pkgs)"
  FW="$(run /usr/libexec/nftban/nftban-firewall || echo '{}')"

  python3 - "$PROC" "$PKG" "$FW" <<'PY'
import json, sys
proc=json.loads(sys.argv[1]); pkgs=json.loads(sys.argv[2]); fw=json.loads(sys.argv[3] or "{}")

def default_policy_accept(nft_json):
    try:
        for e in nft_json.get("nftables",[]):
            ch=e.get("chain")
            if ch and ch.get("family")=="inet" and ch.get("policy","").lower()=="accept":
                return True
        return False
    except Exception:
        return False

policy_accept = default_policy_accept(fw) if isinstance(fw,dict) else False
sockets=[]
for s in proc.get("sockets",[]):
    sockets.append({**s, "firewall":{"verdict":("accept" if policy_accept else "unknown")}})

inv={
  "time":proc.get("time"), "host":proc.get("host"),
  "os":{"kernel":proc.get("kernel")},
  "processes":proc.get("processes",[]),
  "sockets":sockets,
  "firewall":{"nftables_json":fw},
  "packages":pkgs
}
print(json.dumps(inv))
PY
}

JSON_OUT=""
case "$MODE" in
  --alert) JSON_OUT="$(make_alert)";;
  --inventory) JSON_OUT="$(make_inventory)";;
esac

# --- Diff (optional) ---
if [ -n "$BASELINE" ]; then
  [ -r "$BASELINE" ] || { echo "Baseline not readable: $BASELINE" >&2; exit 2; }

  JSON_OUT="$(python3 - "$JSON_OUT" "$BASELINE" <<'PY'
import json, sys

cur=json.loads(sys.argv[1])
with open(sys.argv[2],"r",encoding="utf-8") as f:
    base=json.load(f)

def index_processes(ps):
    res={}
    for p in ps:
        k=(p.get("exe"), p.get("sha256"))
        res.setdefault(k,[]).append(p)
    return res

def index_sockets(ss):
    res={}
    for s in ss:
        k=(s.get("proto"), s.get("local"), (s.get("sha256") or s.get("exe")))
        res.setdefault(k,[]).append(s)
    return res

def index_packages(pkgs):
    items=pkgs.get("installed",[]) if isinstance(pkgs,dict) else []
    res={}
    for it in items:
        name=it.get("name")
        ver=it.get("version")
        rel=it.get("release")
        arch=it.get("arch") or it.get("architecture")
        key=(name,ver,rel,arch)
        res[key]=it
    return res

def shallow_diff_maps(a,b):
    add=[k for k in a.keys() if k not in b]
    rem=[k for k in b.keys() if k not in a]
    common=[k for k in a.keys() if k in b]
    chg=[]
    for k in common:
        if json.dumps(a[k],sort_keys=True)!=json.dumps(b[k],sort_keys=True):
            chg.append(k)
    return add, rem, chg

cur_ps=index_processes(cur.get("processes",[]))
base_ps=index_processes(base.get("processes",[]))
cur_ss=index_sockets(cur.get("sockets",[]))
base_ss=index_sockets(base.get("sockets",[]))
cur_pkgs=index_packages(cur.get("packages",{}))
base_pkgs=index_packages(base.get("packages",{}))

ps_add,ps_rem,ps_chg=shallow_diff_maps(cur_ps, base_ps)
ss_add,ss_rem,ss_chg=shallow_diff_maps(cur_ss, base_ss)
pk_add,pk_rem,pk_chg=shallow_diff_maps(cur_pkgs, base_pkgs)

diff={
  "time": cur.get("time"),
  "host": cur.get("host"),
  "summary": {
    "processes": {"added": len(ps_add), "removed": len(ps_rem), "changed": len(ps_chg)},
    "sockets":   {"added": len(ss_add), "removed": len(ss_rem), "changed": len(ss_chg)},
    "packages":  {"added": len(pk_add), "removed": len(pk_rem), "changed": len(pk_chg)}
  },
  "details": {
    "processes": {
      "added":   [ {"exe":k[0], "sha256":k[1]} for k in ps_add ],
      "removed": [ {"exe":k[0], "sha256":k[1]} for k in ps_rem ],
      "changed": [ {"exe":k[0], "sha256":k[1]} for k in ps_chg ],
    },
    "sockets": {
      "added":   [ {"proto":k[0], "local":k[1], "exe_hash":k[2]} for k in ss_add ],
      "removed": [ {"proto":k[0], "local":k[1], "exe_hash":k[2]} for k in ss_rem ],
      "changed": [ {"proto":k[0], "local":k[1], "exe_hash":k[2]} for k in ss_chg ],
    },
    "packages": {
      "added":   [ {"name":k[0], "version":k[1], "release":k[2], "arch":k[3]} for k in pk_add ],
      "removed": [ {"name":k[0], "version":k[1], "release":k[2], "arch":k[3]} for k in pk_rem ],
      "changed": [ {"name":k[0], "version":k[1], "release":k[2], "arch":k[3]} for k in pk_chg ],
    }
  },
  "current": cur
}
print(json.dumps(diff))
PY
)"
fi

# --- Sign (optional) ---
if [ -n "$SIGN_KEY" ]; then
  command -v openssl >/dev/null 2>&1 || { echo "openssl not found" >&2; exit 2; }

  SIG="$(printf "%s" "$JSON_OUT" | openssl dgst -sha256 -sign "$SIGN_KEY" | base64 -w0)"
  PUB_DER="$(openssl pkey -in "$SIGN_KEY" -pubout -outform DER 2>/dev/null)"
  FP="$(printf "%s" "$PUB_DER" | openssl dgst -sha256 -binary | base64 -w0)"
  PUB_PEM="$(openssl pkey -in "$SIGN_KEY" -pubout 2>/dev/null)"

  python3 - <<'PY' "$JSON_OUT" "$SIG" "$FP" "$PUB_PEM"
import json, sys
doc=sys.argv[1]
sig=sys.argv[2]
fp=sys.argv[3]
pub=sys.argv[4]
envelope={
  "type": "nftban.signed+json",
  "alg": "sha256-with-openssl",
  "key_fingerprint_b64": fp,
  "signature_b64": sig,
  "pubkey_pem": pub,
  "payload": json.loads(doc)
}
print(json.dumps(envelope))
PY
else
  printf "%s\n" "$JSON_OUT"
fi

335: nftban_cmd_rbl_server() {
336:     # Check full server: all IPs (IPv4 + IPv6) + hostname
337:     # Subcommands: check
338:     # Options: --fresh, --json, --verbose, --quiet, --alert
339: 
340:     local subcmd="${1:-check}"
341:     shift || true
342: 
343:     if [[ "$subcmd" != "check" ]]; then
344:         echo "Error: Unknown server subcommand: $subcmd" >&2
345:         echo "Usage: nftban rbl server check [options]" >&2
346:         return 1
347:     fi
348: 
349:     local fresh=0
350:     local format="text"
351:     local verbose=0
352:     local quiet=0
353:     local alert=0
354: 
355:     # Parse arguments
356:     while [[ $# -gt 0 ]]; do
357:         case "$1" in
358:             --fresh)
359:                 fresh=1
360:                 shift
361:                 ;;
362:             --json)
363:                 format="json"
364:                 shift
365:                 ;;
366:             --verbose)
367:                 verbose=1
368:                 export NFTBAN_RBL_VERBOSE="YES"
369:                 shift
370:                 ;;
371:             --quiet)
372:                 quiet=1
373:                 shift
374:                 ;;
375:             --alert)
376:                 alert=1
377:                 shift
378:                 ;;
379:             *)
380:                 echo "Error: Unknown option: $1" >&2
381:                 return 1
382:                 ;;
383:         esac
384:     done
385: 
386:     [[ $quiet -eq 0 ]] && echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
387:     [[ $quiet -eq 0 ]] && echo "NFTBan RBL Server Check"
388:     [[ $quiet -eq 0 ]] && echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
389:     [[ $quiet -eq 0 ]] && echo ""
390: 
391:     # Get server hostname
392:     local hostname
393:     hostname=$(hostname -f 2>/dev/null || hostname)
394:     [[ $quiet -eq 0 ]] && echo "Server: $hostname"
395:     [[ $quiet -eq 0 ]] && echo ""
396: 
397:     # Collect all IPs
398:     local all_ips=()
399: 
400:     # 1. Auto-discovered IPv4
401:     [[ $quiet -eq 0 ]] && echo "━━━ IPv4 Addresses ━━━"
402:     local ipv4_count=0
403:     while IFS= read -r ip; do
404:         all_ips+=("$ip:ipv4")
405:         ((ipv4_count++))
406:         [[ $quiet -eq 0 ]] && echo "  ✓ $ip"
407:     done < <(ip -4 addr show | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | grep -v '^127\.' | sort -u)
408:     [[ $quiet -eq 0 ]] && [[ $ipv4_count -eq 0 ]] && echo "  (none found)"
409:     [[ $quiet -eq 0 ]] && echo ""
410: 
411:     # 2. Auto-discovered IPv6 (if enabled)
412:     if [[ "${NFTBAN_RBL_CHECK_IPV6:-YES}" == "YES" ]]; then
413:         [[ $quiet -eq 0 ]] && echo "━━━ IPv6 Addresses ━━━"
414:         local ipv6_count=0
415:         while IFS= read -r ip; do
416:             all_ips+=("$ip:ipv6")
417:             ((ipv6_count++))
418:             [[ $quiet -eq 0 ]] && echo "  ✓ $ip"
419:         done < <(ip -6 addr show | grep -oP '(?<=inet6\s)[0-9a-f:]+' | grep -v '^::1' | grep -v '^fe80:' | grep -v '^fc00:' | grep -v '^fd00:' | sort -u)
420:         [[ $quiet -eq 0 ]] && [[ $ipv6_count -eq 0 ]] && echo "  (none found)"
421:         [[ $quiet -eq 0 ]] && echo ""
422:     fi
423: 
424:     # 3. Hostname resolution
425:     [[ $quiet -eq 0 ]] && echo "━━━ Hostname Resolution ━━━"
426:     while IFS= read -r ip; do
427:         all_ips+=("$ip:hostname")
428:         [[ $quiet -eq 0 ]] && echo "  ✓ $hostname → $ip"
429:     done < <(host "$hostname" 2>/dev/null | grep "has address" | awk '{print $NF}')
430:     [[ $quiet -eq 0 ]] && echo ""
431: 
432:     if [[ ${#all_ips[@]} -eq 0 ]]; then
433:         echo "Error: No IPs found to check" >&2
434:         return 1
435:     fi
436: 
437:     [[ $quiet -eq 0 ]] && echo "━━━ RBL Checks ━━━"
438:     [[ $quiet -eq 0 ]] && echo "Total IPs to check: ${#all_ips[@]}"
439:     [[ $quiet -eq 0 ]] && echo ""
440: 
441:     # Check each IP
442:     local any_listed=0
443:     local total_listed=0
444:     local total_clean=0
445: 
446:     for ip_entry in "${all_ips[@]}"; do
447:         local check_ip="${ip_entry%%:*}"
448:         local ip_source="${ip_entry#*:}"
449: 
450:         # Filter public IPs only
451:         if ! nftban_rbl_is_public_ip "$check_ip"; then
452:             [[ $quiet -eq 0 ]] && echo "⚠️  Skipping private IP: $check_ip ($ip_source)"
453:             continue
454:         fi
455: 
456:         [[ $quiet -eq 0 ]] && echo "─────────────────────────────────────────────────────────────"
457:         [[ $quiet -eq 0 ]] && echo "Checking: $check_ip (source: $ip_source)"
458:         [[ $quiet -eq 0 ]] && echo ""
459: 
460:         # Check cache if not fresh
461:         local cache_file
462:         if [[ $fresh -eq 0 ]] && cache_file=$(nftban_rbl_cache_get "$check_ip"); then
463:             [[ $quiet -eq 0 ]] && echo "(Using cached results)"
464:             cat "$cache_file"
465:         else
466:             # Perform fresh check
467:             local results
468:             results=$(nftban_rbl_check_ip "$check_ip" "$format")
469: 
470:             # Cache results
471:             echo "$results" | nftban_rbl_cache_set "$check_ip"
472: 
473:             # Output results
474:             echo "$results"
475: 
476:             # Track statistics
477:             if echo "$results" | grep -q "LISTED"; then
478:                 any_listed=1
479:                 ((total_listed++))
480: 
481:                 # Send alert if requested
482:                 if [[ $alert -eq 1 ]] && [[ "${NFTBAN_RBL_ALERT_ON_NEW_LISTING:-YES}" == "YES" ]]; then
483:                     if nftban_rbl_check_new_listing "$check_ip" "listed"; then
484:                         local first_rbl
485:                         local first_reason
486:                         first_rbl=$(echo "$results" | grep "LISTED:" | head -n1 | awk '{print $3}')
487:                         first_reason=$(echo "$results" | grep "Reason:" | head -n1 | sed 's/.*Reason: //')
488:                         nftban_rbl_send_alert "$check_ip" "$first_rbl" "$first_reason" "$ip_source"
489:                     fi
490:                 fi
491:                 nftban_rbl_update_state "$check_ip" "listed"
492:             else
493:                 ((total_clean++))
494:                 nftban_rbl_update_state "$check_ip" "clean"
495:             fi
496:         fi
497: 
498:         [[ $quiet -eq 0 ]] && echo ""
499:     done
500: 
501:     # Final summary
502:     [[ $quiet -eq 0 ]] && echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
503:     [[ $quiet -eq 0 ]] && echo "Server RBL Check Summary"
504:     [[ $quiet -eq 0 ]] && echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
505:     [[ $quiet -eq 0 ]] && echo "Server: $hostname"
506:     [[ $quiet -eq 0 ]] && echo "IPs Checked: ${#all_ips[@]}"
507:     [[ $quiet -eq 0 ]] && echo "Listed: $total_listed"
508:     [[ $quiet -eq 0 ]] && echo "Clean: $total_clean"
509:     [[ $quiet -eq 0 ]] && echo ""
510: 
511:     if [[ $total_listed -gt 0 ]]; then
512:         [[ $quiet -eq 0 ]] && echo "⚠️  WARNING: Server has $total_listed IP(s) on RBL blacklists!"
513:     else
514:         [[ $quiet -eq 0 ]] && echo "✅ All IPs are clean (not blacklisted)"
515:     fi
516: 
517:     # Update last check timestamp
518:     mkdir -p "${NFTBAN_RBL_CACHE_DIR}"
519:     date -Iseconds > "${NFTBAN_RBL_CACHE_DIR}/last_check"
520: 
521:     # Return exit code based on listings
522:     return $any_listed
523: }

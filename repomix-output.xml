 383:     fi
 384: 
 385:     # Ensure local config exists
 386:     if [[ ! -f "$config_local" ]]; then
 387:         mkdir -p "$(dirname "$config_local")"
 388:         echo "# NFTBan Login Alert - User Overrides" > "$config_local"
 389:         chmod 640 "$config_local"

 648: nftban_nft_validate_full() {
 649:     # Run full NFT schema validation
 650:     # Returns: 0 if all pass, 1 if any errors
 651: 
 652:     local errors=0 warnings=0
 653:     local output=""
 654: 
 655:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
 656:     echo "NFTBan NFT Schema Validation"
 657:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
 658:     echo ""
 659:     echo "Schema Version: 1.0.0"
 660:     echo "Architecture: Separate ip/ip6 tables"
 661:     echo ""
 662: 
 663:     # 1. Validate tables
 664:     echo "1. Tables (IPv4 + IPv6):"
 665:     if output=$(nftban_nft_validate_tables 2>&1); then
 666:         echo "   ✅ Required tables exist"
 667:     else
 668:         echo "   ❌ Table validation failed"
 669:         echo "$output" | sed 's/^/      /'
 670:         ((errors++))
 671:     fi
 672: 
 673:     # 2. Validate sets (IPv4)
 674:     echo ""
 675:     echo "2. Sets (IPv4):"
 676:     if output=$(nftban_nft_validate_sets 2>&1); then
 677:         echo "   ✅ Required sets exist"
 678:     else
 679:         echo "   ❌ Set validation failed"
 680:         echo "$output" | sed 's/^/      /'
 681:         ((errors++))
 682:     fi
 683: 
 684:     # 3. Validate set flags/types (IPv4 + IPv6)
 685:     echo ""
 686:     echo "3. Set Types & Flags (IPv4 + IPv6):"
 687:     if output=$(nftban_nft_validate_set_flags 2>&1); then
 688:         echo "   ✅ Set types and flags correct"
 689:     else
 690:         echo "   ⚠️  Set validation issues"
 691:         echo "$output" | sed 's/^/      /'
 692:         ((warnings++))
 693:     fi
 694: 
 695:     # 4. Validate chains (IPv4 + IPv6)
 696:     echo ""
 697:     echo "4. Chains (IPv4 + IPv6):"
 698:     if output=$(nftban_nft_validate_chains 2>&1); then
 699:         echo "   ✅ Required chains exist with correct policies"
 700:     else
 701:         echo "   ❌ Chain validation failed"
 702:         echo "$output" | sed 's/^/      /'
 703:         ((errors++))
 704:     fi
 705: 
 706:     # 5. Validate rule order (security-critical) - IPv4 + IPv6
 707:     echo ""
 708:     echo "5. Rule Order Security (IPv4 + IPv6):"
 709:     if output=$(nftban_nft_validate_rule_order 2>&1); then
 710:         echo "   ✅ Rule order is correct (blacklist before established)"
 711:     else
 712:         echo "   ❌ SECURITY ISSUE: Rule order incorrect!"
 713:         echo "$output" | sed 's/^/      /'
 714:         ((errors++))
 715:     fi
 716: 
 717:     # 6. Check for deprecated tables
 718:     echo ""
 719:     echo "6. Legacy Tables:"
 720:     local deprecated_found=0
 721:     local existing_tables
 722:     existing_tables=$(nft list tables 2>/dev/null)
 723:     for deprecated_table in "${!NFTBAN_DEPRECATED_TABLES[@]}"; do
 724:         if echo "$existing_tables" | grep -q "^table ${deprecated_table}$"; then
 725:             echo "   ⚠️  Legacy table: ${deprecated_table}"
 726:             ((deprecated_found++))
 727:         fi
 728:     done
 729:     if [[ $deprecated_found -eq 0 ]]; then
 730:         echo "   ✅ No deprecated tables found"
 731:     fi
 732: 
 733:     # Show element counts
 734:     echo ""
 735:     echo "7. Current Set Sizes:"
 736:     local ipv4_wl ipv4_bl ipv4_tcp ipv4_udp ipv6_wl ipv6_bl
 737:     ipv4_wl=$(nft list set ip nftban whitelist_ipv4 2>/dev/null | grep -c "elements = {" || echo 0)
 738:     ipv4_bl=$(nft list set ip nftban blacklist_ipv4 2>/dev/null | grep -oP '\d+(?= elements)' || echo "0")
 739:     [[ -z "$ipv4_bl" ]] && ipv4_bl=$(nft list set ip nftban blacklist_ipv4 2>/dev/null | grep -c "," || echo 0)
 740:     ipv6_bl=$(nft list set ip6 nftban blacklist_ipv6 2>/dev/null | grep -c "elements = {" || echo 0)  # shellcheck disable=SC2034  # Reserved for IPv6 stats
 741:     ipv4_udp=$(nft list set ip nftban udp_ports 2>/dev/null | grep -oP 'elements = \{ [^}]+' | tr ',' '\n' | wc -l || echo 0)
 742:     ipv6_wl=$(nft list set ip6 nftban whitelist_ipv6 2>/dev/null | grep -c "elements = {" || echo 0)
 743:     ipv6_bl=$(nft list set ip6 nftban blacklist_ipv6 2>/dev/null | grep -c "elements = {" || echo 0)
 744: 
 745:     echo "   IPv4: whitelist=${ipv4_wl:-0}, blacklist=active, tcp_ports=${ipv4_tcp:-0}, udp_ports=${ipv4_udp:-0}"
 746:     echo "   IPv6: whitelist=${ipv6_wl:-0}, blacklist=active"
 747: 
 748:     # Summary
 749:     echo ""
 750:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
 751:     if [[ $errors -eq 0 ]]; then
 752:         echo "Result: ✅ PASSED (${warnings} warnings)"
 753:     else
 754:         echo "Result: ❌ FAILED (${errors} errors, ${warnings} warnings)"
 755:     fi
 756:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
 757: 
 758:     return $errors
 759: }

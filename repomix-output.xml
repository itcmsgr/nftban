<file path="cli/lib/nftban/tests/test_all_commands.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan Command Testing Framework
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Test all CLI commands to detect silent failures and hanging commands
  7: #
  8: # Author: Antonios Voulvoulis <contact@nftban.com>
  9: # Created: 2025-11-24
 10: # =============================================================================
 11: 
 12: set -u
 13: 
 14: # =============================================================================
 15: # CONFIGURATION
 16: # =============================================================================
 17: 
 18: # shellcheck disable=SC2034  # SCRIPT_DIR reserved for future use
 19: # Script directory (currently unused, reserved for future use)
 20: # SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
 21: # readonly SCRIPT_DIR
 22: readonly TEST_TIMEOUT=20  # seconds (increased for commands with network checks)
 23: TEST_LOG="/tmp/nftban_test_$(date +%Y%m%d_%H%M%S).log"
 24: readonly TEST_LOG
 25: readonly TEST_IP="8.8.8.8"  # Safe test IP (Google DNS)
 26: readonly TEST_PORT="8080"
 27: 
 28: # Colors for output
 29: readonly RED='\033[0;31m'
 30: readonly GREEN='\033[0;32m'
 31: readonly YELLOW='\033[1;33m'
 32: readonly NC='\033[0m' # No Color
 33: 
 34: # Counters
 35: TESTS_TOTAL=0
 36: TESTS_PASSED=0
 37: TESTS_FAILED=0
 38: TESTS_TIMEOUT=0
 39: TESTS_NO_OUTPUT=0
 40: 
 41: # =============================================================================
 42: # HELPER FUNCTIONS
 43: # =============================================================================
 44: 
 45: log() {
 46:     echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" | tee -a "$TEST_LOG"
 47: }
 48: 
 49: test_start() {
 50:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" | tee -a "$TEST_LOG"
 51: }
 52: 
 53: test_end() {
 54:     echo "" | tee -a "$TEST_LOG"
 55: }
 56: 
 57: pass() {
 58:     echo -e "${GREEN}✓ PASS${NC}: $*" | tee -a "$TEST_LOG"
 59:     ((TESTS_PASSED++))
 60: }
 61: 
 62: fail() {
 63:     echo -e "${RED}✗ FAIL${NC}: $*" | tee -a "$TEST_LOG"
 64:     ((TESTS_FAILED++))
 65: }
 66: 
 67: warn() {
 68:     echo -e "${YELLOW}⚠ WARN${NC}: $*" | tee -a "$TEST_LOG"
 69: }
 70: 
 71: timeout_fail() {
 72:     echo -e "${RED}⏱ TIMEOUT${NC}: $*" | tee -a "$TEST_LOG"
 73:     ((TESTS_TIMEOUT++))
 74: }
 75: 
 76: no_output() {
 77:     echo -e "${YELLOW}∅ NO OUTPUT${NC}: $*" | tee -a "$TEST_LOG"
 78:     ((TESTS_NO_OUTPUT++))
 79: }
 80: 
 81: # =============================================================================
 82: # TEST COMMAND FUNCTION
 83: # =============================================================================
 84: 
 85: # Test a command and check for:
 86: # 1. Does it complete within timeout?
 87: # 2. Does it produce output?
 88: # 3. Does it have expected markers (banner, footer)?
 89: # 4. What exit code does it return?
 90: #
 91: # Usage: test_command <name> <command> [expected_markers...]
 92: test_command() {
 93:     local name="$1"
 94:     shift
 95:     local cmd="$*"
 96: 
 97:     ((TESTS_TOTAL++))
 98: 
 99:     test_start
100:     log "TEST #$TESTS_TOTAL: $name"
101:     log "Command: $cmd"
102: 
103:     # Create temp file for output
104:     local output_file="/tmp/nftban_test_output_$$.txt"
105:     local exit_code_file="/tmp/nftban_test_exit_$$.txt"
106: 
107:     # Run command with timeout
108:     local start_time end_time duration
109:     start_time=$(date +%s)
110:     timeout $TEST_TIMEOUT bash -c "$cmd > '$output_file' 2>&1; echo \$? > '$exit_code_file'" || {
111:         local timeout_exit=$?
112:         if [[ $timeout_exit -eq 124 ]]; then
113:             timeout_fail "$name (exceeded ${TEST_TIMEOUT}s)"
114:             rm -f "$output_file" "$exit_code_file"
115:             test_end
116:             return 1
117:         fi
118:     }
119:     end_time=$(date +%s)
120:     duration=$((end_time - start_time))
121: 
122:     # Read results
123:     local output=""
124:     local exit_code=999
125: 
126:     if [[ -f "$output_file" ]]; then
127:         output=$(cat "$output_file")
128:     fi
129: 
130:     if [[ -f "$exit_code_file" ]]; then
131:         exit_code=$(cat "$exit_code_file")
132:     fi
133: 
134:     # Check 1: Does it have output?
135:     if [[ -z "$output" ]]; then
136:         no_output "$name - command produced NO output (${duration}s)"
137:         log "Exit code: $exit_code"
138:         rm -f "$output_file" "$exit_code_file"
139:         test_end
140:         return 1
141:     fi
142: 
143:     # Check 2: Does it have expected markers?
144:     local has_markers=false
145:     local marker_details=""
146: 
147:     # Check for common NFTBan markers
148:     if echo "$output" | grep -q "═\|─\|NFTBan\|nftban"; then
149:         has_markers=true
150:         marker_details="(has formatting markers)"
151:     fi
152: 
153:     # Check 3: Does it have exit marker?
154:     # This is what we'll add to all commands: "# NFTBAN_CMD_EXIT: <command_name>"
155:     if echo "$output" | grep -q "NFTBAN_CMD_EXIT"; then
156:         has_markers=true
157:         marker_details="$marker_details (has exit marker)"
158:     fi
159: 
160:     # Determine result
161:     if [[ $exit_code -eq 0 ]] && [[ -n "$output" ]]; then
162:         if [[ "$has_markers" == "true" ]]; then
163:             pass "$name - output OK, exit 0, ${duration}s $marker_details"
164:         else
165:             warn "$name - works but NO formatting markers (${duration}s)"
166:             ((TESTS_PASSED++))
167:         fi
168:     elif [[ $exit_code -ne 0 ]]; then
169:         # Some commands exit non-zero on purpose (e.g., search when not found, health check with errors)
170:         if [[ -n "$output" ]]; then
171:             if [[ "$has_markers" == "true" ]]; then
172:                 warn "$name - exit $exit_code but has output and markers (${duration}s)"
173:                 ((TESTS_PASSED++))
174:             else
175:                 # Has output but no markers - could be intentional (like health summary)
176:                 warn "$name - exit $exit_code with output but no markers (${duration}s)"
177:                 ((TESTS_PASSED++))
178:             fi
179:         else
180:             fail "$name - exit code $exit_code (${duration}s)"
181:         fi
182:     else
183:         fail "$name - unexpected state: exit=$exit_code, output_len=${#output}"
184:     fi
185: 
186:     # Show sample of output (first 5 lines)
187:     log "Output sample:"
188:     echo "$output" | head -5 | sed 's/^/  | /' | tee -a "$TEST_LOG"
189: 
190:     # Cleanup
191:     rm -f "$output_file" "$exit_code_file"
192:     test_end
193: }
194: 
195: # =============================================================================
196: # TEST SUITE
197: # =============================================================================
198: 

320: // parseLoginLogLine parses a single line from login_alert.log
321: func parseLoginLogLine(line string) *LoginEvent {
322: 	// Expected format: [2025-11-21 10:30:00] [SSH] [SUCCESS] user@192.168.1.1 - Location info
323: 	event := &LoginEvent{}
324: 
325: 	// Extract timestamp
326: 	tsRegex := regexp.MustCompile(`\[(\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2})\]`)
327: 	if matches := tsRegex.FindStringSubmatch(line); len(matches) > 1 {
328: 		event.Timestamp = matches[1]
329: 	}
330: 
331: 	// Extract type (SSH, SU, SUDO, CONSOLE)
332: 	typeRegex := regexp.MustCompile(`\[(SSH|SU|SUDO|CONSOLE)\]`)
333: 	if matches := typeRegex.FindStringSubmatch(line); len(matches) > 1 {
334: 		event.Type = matches[1]
335: 	}
336: 
337: 	// Extract status
338: 	if strings.Contains(line, "[SUCCESS]") {
339: 		event.Status = "SUCCESS"
340: 	} else if strings.Contains(line, "[FAILED]") {
341: 		event.Status = "FAILED"
342: 	}
343: 
344: 	// Extract user and IP
345: 	userIPRegex := regexp.MustCompile(`(\w+)@([\d\.]+)`)
346: 	if matches := userIPRegex.FindStringSubmatch(line); len(matches) > 2 {
347: 		event.User = matches[1]
348: 		event.IP = matches[2]
349: 	}
350: 
351: 	// Extract location (after the dash)
352: 	if idx := strings.Index(line, " - "); idx > 0 {
353: 		event.Location = strings.TrimSpace(line[idx+3:])
354: 	}
355: 
356: 	if event.Timestamp == "" && event.Type == "" {
357: 		return nil
358: 	}
359: 
360: 	return event
361: }
362: 
363: // parseAuthLog parses /var/log/auth.log or /var/log/secure for SSH events
364: func parseAuthLog(limit int) []LoginEvent {
365: 	var events []LoginEvent
366: 
367: 	// Try both auth.log (Debian/Ubuntu) and secure (RHEL/CentOS)
368: 	logPaths := []string{"/var/log/auth.log", "/var/log/secure"}
369: 
370: 	for _, logPath := range logPaths {
371: 		file, err := os.Open(logPath)
372: 		if err != nil {
373: 			continue
374: 		}
375: 		defer file.Close()
376: 
377: 		scanner := bufio.NewScanner(file)
378: 		var lines []string
379: 		for scanner.Scan() {
380: 			line := scanner.Text()
381: 			// Match SSH events: Accepted, Failed, Invalid user, Connection closed
382: 			if strings.Contains(line, "sshd") &&
383: 				(strings.Contains(line, "Accepted") ||
384: 					strings.Contains(line, "Failed") ||
385: 					strings.Contains(line, "Invalid user") ||
386: 					strings.Contains(line, "Connection closed") ||
387: 					strings.Contains(line, "Disconnected from")) {
388: 				lines = append(lines, line)
389: 			}
390: 		}
391: 
392: 		// Get last N lines
393: 		start := 0
394: 		if len(lines) > limit {
395: 			start = len(lines) - limit
396: 		}
397: 
398: 		for i := len(lines) - 1; i >= start && len(events) < limit; i-- {
399: 			if event := parseAuthLogLine(lines[i]); event != nil {
400: 				events = append(events, *event)
401: 			}
402: 		}
403: 
404: 		if len(events) > 0 {
405: 			break
406: 		}
407: 	}
408: 
409: 	return events
410: }
411: 
412: // parseAuthLogLine parses a single line from auth.log/secure
413: func parseAuthLogLine(line string) *LoginEvent {
414: 	event := &LoginEvent{
415: 		Type: "SSH",
416: 	}
417: 
418: 	// Extract timestamp (e.g., "Nov 21 10:30:00" or "Dec  7 00:03:14")
419: 	parts := strings.Fields(line)
420: 	if len(parts) >= 3 {
421: 		event.Timestamp = strings.Join(parts[0:3], " ")
422: 	}
423: 
424: 	// Determine status
425: 	if strings.Contains(line, "Accepted") {
426: 		event.Status = "SUCCESS"
427: 	} else if strings.Contains(line, "Failed") ||
428: 		strings.Contains(line, "Invalid user") ||
429: 		strings.Contains(line, "Connection closed") ||
430: 		strings.Contains(line, "Disconnected from") {
431: 		event.Status = "FAILED"
432: 	} else {
433: 		return nil
434: 	}
435: 
436: 	// Extract user - handle multiple patterns:
437: 	// "for root from", "for invalid user oracle from", "user root", "Invalid user oracle from"
438: 	userPatterns := []string{
439: 		`for (?:invalid user )?(\w+)`,
440: 		`Invalid user (\w+) from`,
441: 		`user (\w+) `,
442: 		`Disconnected from (?:authenticating )?user (\w+)`,
443: 	}
444: 	for _, pattern := range userPatterns {
445: 		userRegex := regexp.MustCompile(pattern)
446: 		if matches := userRegex.FindStringSubmatch(line); len(matches) > 1 {
447: 			event.User = matches[1]
448: 			break
449: 		}
450: 	}
451: 
452: 	// Extract IP - handle both "from IP" and "Connection from IP"
453: 	ipPatterns := []string{
454: 		`from ([\d\.]+)`,
455: 		`Connection from ([\d\.]+)`,
456: 	}
457: 	for _, pattern := range ipPatterns {
458: 		ipRegex := regexp.MustCompile(pattern)
459: 		if matches := ipRegex.FindStringSubmatch(line); len(matches) > 1 {
460: 			event.IP = matches[1]
461: 			break
462: 		}
463: 	}
464: 
465: 	return event
466: }

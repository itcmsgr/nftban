  45: check_dependencies() {
  46:     local build_type="$1"
  47:     local missing=()
  48: 
  49:     # Check build tools
  50:     if [[ ! -x "${PROJECT_ROOT}/build.sh" ]]; then
  51:         log_error "build.sh not found or not executable"
  52:         return 1
  53:     fi
  54: 
  55:     # Check for DEB tools
  56:     if [[ "$build_type" =~ (deb|both) ]]; then
  57:         command -v dpkg-deb >/dev/null || missing+=("dpkg-deb")
  58:     fi
  59: 
  60:     # Check for RPM tools
  61:     if [[ "$build_type" =~ (rpm|both) ]]; then
  62:         command -v rpmbuild >/dev/null || missing+=("rpmbuild")
  63:     fi
  64: 
  65:     if [[ ${#missing[@]} -gt 0 ]]; then
  66:         log_error "Missing: ${missing[*]}"
  67:         log_info "Install: sudo dnf install rpm-build dpkg-dev"
  68:         return 1
  69:     fi
  70: 
  71:     return 0
  72: }

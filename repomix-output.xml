160: // Descriptor contains static metadata about a module
161: type Descriptor struct {
162: 	Name         string   `json:"name"`          // Unique module identifier
163: 	Version      string   `json:"version"`       // Module version
164: 	Description  string   `json:"description"`   // Human-readable description
165: 	Dependencies []string `json:"dependencies"`  // Other modules this depends on
166: 	Optional     bool     `json:"optional"`      // Whether module can be disabled
167: 	ConfigFile   string   `json:"config_file"`   // Path to module's config file
168: }
169: 
170: // Registry manages all registered modules
171: type Registry struct {
172: 	modules     map[string]Module
173: 	descriptors map[string]Descriptor
174: }
175: 
176: // NewRegistry creates a new module registry
177: func NewRegistry() *Registry {
178: 	return &Registry{
179: 		modules:     make(map[string]Module),
180: 		descriptors: make(map[string]Descriptor),
181: 	}
182: }
183: 
184: // Register adds a module to the registry
185: func (r *Registry) Register(m Module, d Descriptor) {
186: 	name := m.Name()
187: 	r.modules[name] = m
188: 	r.descriptors[name] = d
189: }
190: 
191: // Get retrieves a module by name
192: func (r *Registry) Get(name string) (Module, bool) {
193: 	m, ok := r.modules[name]
194: 	return m, ok
195: }
196: 
197: // GetDescriptor retrieves a module descriptor by name
198: func (r *Registry) GetDescriptor(name string) (Descriptor, bool) {
199: 	d, ok := r.descriptors[name]
200: 	return d, ok
201: }
202: 
203: // All returns all registered modules
204: func (r *Registry) All() map[string]Module {
205: 	return r.modules
206: }
207: 
208: // Names returns all registered module names
209: func (r *Registry) Names() []string {
210: 	names := make([]string, 0, len(r.modules))
211: 	for name := range r.modules {
212: 		names = append(names, name)
213: 	}
214: 	return names
215: }
216: 
217: // InitAll initializes all modules with the event bus
218: func (r *Registry) InitAll(bus *eventbus.Bus) error {
219: 	for name, m := range r.modules {
220: 		if err := m.Init(bus); err != nil {
221: 			return &ModuleError{Module: name, Op: "init", Err: err}
222: 		}
223: 	}
224: 	return nil
225: }
226: 
227: // StartAll starts all modules
228: func (r *Registry) StartAll(ctx context.Context) error {
229: 	for name, m := range r.modules {
230: 		if err := m.Start(ctx); err != nil {
231: 			return &ModuleError{Module: name, Op: "start", Err: err}
232: 		}
233: 	}
234: 	return nil
235: }
236: 
237: // StopAll stops all modules
238: func (r *Registry) StopAll() error {
239: 	var lastErr error
240: 	for name, m := range r.modules {
241: 		if err := m.Stop(); err != nil {
242: 			lastErr = &ModuleError{Module: name, Op: "stop", Err: err}
243: 		}
244: 	}
245: 	return lastErr
246: }
247: 
248: // StatusAll returns status for all modules
249: func (r *Registry) StatusAll() map[string]Status {
250: 	statuses := make(map[string]Status, len(r.modules))
251: 	for name, m := range r.modules {
252: 		statuses[name] = m.Status()
253: 	}
254: 	return statuses
255: }
256: 
257: // ModuleError wraps errors with module context
258: type ModuleError struct {
259: 	Module string
260: 	Op     string
261: 	Err    error
262: }
263: 
264: func (e *ModuleError) Error() string {
265: 	return "module " + e.Module + " " + e.Op + ": " + e.Err.Error()
266: }
267: 
268: func (e *ModuleError) Unwrap() error {
269: 	return e.Err
270: }
</file>

<file path="pkg/persistent/config.go">
  1: package persistent
  2: 
  3: import (
  4: 	"fmt"
  5: 	"os"
  6: 	"strconv"
  7: 	"strings"
  8: 	"time"
  9: 
 10: 	"github.com/itcmsgr/nftban/pkg/nftbanconf"
 11: )
 12: 
 13: // Config holds persistent offender configuration
 14: type Config struct {
 15: 	GlobalThreshold int
 16: 	GlobalPeriod    time.Duration
 17: 	GlobalAction    string
 18: 	Enabled         bool
 19: 
 20: 	BanLog       string
 21: 	OffendersLog string
 22: 	OffendersConf string
 23: 
 24: 	// Per-filter thresholds (v1.0: renamed from jail)
 25: 	Filters map[string]*FilterConfig
 26: }
 27: 
 28: // FilterConfig holds configuration for a specific filter (v1.0: renamed from JailConfig)
 29: type FilterConfig struct {
 30: 	Name      string
 31: 	Threshold int
 32: 	Period    time.Duration
 33: 	Action    string
 34: 	Comment   string
 35: }
 36: 
 37: // getDefaultPersistentPaths returns paths from central config
 38: // NO FALLBACK - paths must come from /etc/nftban/nftban.conf
 39: func getDefaultPersistentPaths() (configDir, logDir string) {
 40: 	cfg := nftbanconf.MustLoad()
 41: 	return cfg.ConfigDir, cfg.LogDir
 42: }
 43: 
 44: // LoadConfig loads persistent offender configuration from files
 45: // Removed: fail2ban.conf references (v1.0 migration to Suricata)
 46: // .local settings override defaults
 47: func LoadConfig(configDir string) (*Config, error) {
 48: 	defaultConfigDir, defaultLogDir := getDefaultPersistentPaths()
 49: 
 50: 	cfg := &Config{
 51: 		GlobalThreshold: 10,
 52: 		GlobalPeriod:    24 * time.Hour,
 53: 		GlobalAction:    "permanent",
 54: 		Enabled:         true,
 55: 		BanLog:          defaultLogDir + "/bans.log",
 56: 		OffendersLog:    defaultLogDir + "/persistent-offenders.log",
 57: 		OffendersConf:   defaultConfigDir + "/blacklist.d/30-persistent-offenders.conf",
 58: 		Filters:         make(map[string]*FilterConfig),
 59: 	}
 60: 
 61: 	// Read default config
 62: 	defaultPath := configDir + "/persistent.conf" // Removed: fail2ban.conf (v1.0)
 63: 	if err := cfg.parseConfigFile(defaultPath); err != nil {
 64: 		// If default doesn't exist, use built-in defaults (not an error)
 65: 		if !os.IsNotExist(err) {
 66: 			return nil, fmt.Errorf("failed to parse %s: %w", defaultPath, err)
 67: 		}
 68: 	}
 69: 
 70: 	// Read local overrides
 71: 	localPath := configDir + "/persistent.conf.local" // Removed: fail2ban.conf.local (v1.0)
 72: 	if err := cfg.parseConfigFile(localPath); err != nil {
 73: 		// Local file is optional
 74: 		if !os.IsNotExist(err) {
 75: 			return nil, fmt.Errorf("failed to parse %s: %w", localPath, err)
 76: 		}
 77: 	}
 78: 
 79: 	return cfg, nil
 80: }
 81: 
 82: // parseConfigFile parses an INI-style config file
 83: func (c *Config) parseConfigFile(path string) error {
 84: 	data, err := os.ReadFile(path)
 85: 	if err != nil {
 86: 		return err
 87: 	}
 88: 
 89: 	lines := strings.Split(string(data), "\n")
 90: 	var currentSection string
 91: 
 92: 	for _, line := range lines {
 93: 		line = strings.TrimSpace(line)
 94: 
 95: 		// Skip comments and empty lines
 96: 		if line == "" || strings.HasPrefix(line, "#") {
 97: 			continue
 98: 		}
 99: 
100: 		// Section headers
101: 		if strings.HasPrefix(line, "[") && strings.HasSuffix(line, "]") {
102: 			currentSection = strings.Trim(line, "[]")
103: 			if currentSection != "global" {
104: 				// Create filter config if it doesn't exist
105: 				if _, exists := c.Filters[currentSection]; !exists {
106: 					c.Filters[currentSection] = &FilterConfig{
107: 						Name:      currentSection,
108: 						Threshold: c.GlobalThreshold,
109: 						Period:    c.GlobalPeriod,
110: 						Action:    c.GlobalAction,
111: 					}
112: 				}
113: 			}
114: 			continue
115: 		}
116: 
117: 		// Key-value pairs
118: 		parts := strings.SplitN(line, "=", 2)
119: 		if len(parts) != 2 {
120: 			continue
121: 		}
122: 
123: 		key := strings.TrimSpace(parts[0])
124: 		value := strings.TrimSpace(parts[1])
125: 
126: 		// Remove inline comments
127: 		if idx := strings.Index(value, "#"); idx >= 0 {
128: 			value = strings.TrimSpace(value[:idx])
129: 		}
130: 
131: 		if currentSection == "global" {
132: 			c.parseGlobalSetting(key, value)
133: 		} else if filter, exists := c.Filters[currentSection]; exists {
134: 			c.parseFilterSetting(filter, key, value)
135: 		}
136: 	}
137: 
138: 	return nil
139: }
140: 
141: // parseGlobalSetting parses a global configuration setting
142: func (c *Config) parseGlobalSetting(key, value string) {
143: 	switch key {
144: 	case "default_threshold":
145: 		if val, err := strconv.Atoi(value); err == nil {
146: 			c.GlobalThreshold = val
147: 		}
148: 	case "default_period":
149: 		if dur, err := parseDuration(value); err == nil {
150: 			c.GlobalPeriod = dur
151: 		}
152: 	case "default_action":
153: 		c.GlobalAction = value
154: 	case "enabled":
155: 		c.Enabled = (value == "true" || value == "yes" || value == "1")
156: 	case "ban_log":
157: 		c.BanLog = value
158: 	case "offenders_log":
159: 		c.OffendersLog = value
160: 	case "offenders_conf":
161: 		c.OffendersConf = value
162: 	}
163: }
164: 
165: // parseFilterSetting parses a filter-specific configuration setting (v1.0: renamed from parseJailSetting)
166: func (c *Config) parseFilterSetting(filter *FilterConfig, key, value string) {
167: 	switch key {
168: 	case "threshold":
169: 		if val, err := strconv.Atoi(value); err == nil {
170: 			filter.Threshold = val
171: 		}
172: 	case "period":
173: 		if dur, err := parseDuration(value); err == nil {
174: 			filter.Period = dur
175: 		}
176: 	case "action":
177: 		filter.Action = value
178: 	case "comment":
179: 		filter.Comment = strings.Trim(value, "\"")
180: 	}
181: }
182: 
183: // parseDuration parses duration strings like "24h", "48h", "7d"
184: func parseDuration(s string) (time.Duration, error) {
185: 	s = strings.ToLower(s)
186: 
187: 	// Handle days
188: 	if strings.HasSuffix(s, "d") {
189: 		days, err := strconv.Atoi(strings.TrimSuffix(s, "d"))
190: 		if err != nil {
191: 			return 0, err
192: 		}
193: 		return time.Duration(days) * 24 * time.Hour, nil
194: 	}
195: 
196: 	// Use standard time.ParseDuration for h, m, s
197: 	return time.ParseDuration(s)
198: }
199: 
200: // GetFilterConfig returns configuration for a specific filter (v1.0: renamed from GetJailConfig)
201: // If filter not found, returns global defaults
202: func (c *Config) GetFilterConfig(filterName string) *FilterConfig {
203: 	if filter, exists := c.Filters[filterName]; exists {
204: 		return filter
205: 	}
206: 
207: 	// Return global defaults
208: 	return &FilterConfig{
209: 		Name:      filterName,
210: 		Threshold: c.GlobalThreshold,
211: 		Period:    c.GlobalPeriod,
212: 		Action:    c.GlobalAction,
213: 	}
214: }
</file>

<file path="pkg/ports/panel_loader.go">
  1: package ports
  2: 
  3: import (
  4: 	"bufio"
  5: 	"fmt"
  6: 	"os"
  7: 	"os/exec"
  8: 	"path/filepath"
  9: 	"strconv"
 10: 	"strings"
 11: )
 12: 
 13: // PanelConfig represents a control panel's port configuration
 14: type PanelConfig struct {
 15: 	Name      string   // Panel name (directadmin, cpanel, plesk)
 16: 	Enabled   bool     // Whether panel is enabled
 17: 	ConfigFile string  // Path to panel config file
 18: 	TCPIn     []int    // TCP input ports
 19: 	TCPOut    []int    // TCP output ports (for OUTPUT chain)
 20: 	UDPIn     []int    // UDP input ports
 21: 	UDPOut    []int    // UDP output ports (for OUTPUT chain)
 22: }
 23: 
 24: // PanelStateFile location
 25: const PanelStateFile = "/var/lib/nftban/panels/enabled.conf"
 26: 
 27: // LoadEnabledPanels reads the panel state file and returns enabled panel names
 28: func LoadEnabledPanels() ([]string, error) {
 29: 	var enabled []string
 30: 
 31: 	// If state file doesn't exist, return empty list (no panels enabled)
 32: 	if _, err := os.Stat(PanelStateFile); os.IsNotExist(err) {
 33: 		return enabled, nil
 34: 	}
 35: 
 36: 	file, err := os.Open(PanelStateFile)
 37: 	if err != nil {
 38: 		return nil, fmt.Errorf("failed to open panel state file: %w", err)
 39: 	}
 40: 	defer file.Close()
 41: 
 42: 	scanner := bufio.NewScanner(file)
 43: 	for scanner.Scan() {
 44: 		line := strings.TrimSpace(scanner.Text())
 45: 
 46: 		// Skip empty lines and comments
 47: 		if line == "" || strings.HasPrefix(line, "#") {
 48: 			continue
 49: 		}
 50: 
 51: 		// Parse format: panelname=enabled or panelname=disabled
 52: 		parts := strings.SplitN(line, "=", 2)
 53: 		if len(parts) != 2 {
 54: 			continue
 55: 		}
 56: 
 57: 		panelName := strings.TrimSpace(parts[0])
 58: 		status := strings.TrimSpace(parts[1])
 59: 
 60: 		if strings.ToLower(status) == "enabled" {
 61: 			enabled = append(enabled, panelName)
 62: 		}
 63: 	}
 64: 
 65: 	if err := scanner.Err(); err != nil {
 66: 		return nil, fmt.Errorf("error reading panel state file: %w", err)
 67: 	}
 68: 
 69: 	return enabled, nil
 70: }
 71: 
 72: // SetPanelEnabled updates the panel state file to enable/disable a panel
 73: func SetPanelEnabled(panelName string, enabled bool) error {
 74: 	// Ensure state directory exists
 75: 	stateDir := filepath.Dir(PanelStateFile)
 76: 	if err := os.MkdirAll(stateDir, 0755); err != nil {
 77: 		return fmt.Errorf("failed to create state directory: %w", err)
 78: 	}
 79: 
 80: 	// Read existing state
 81: 	existingState := make(map[string]string)
 82: 	if _, err := os.Stat(PanelStateFile); err == nil {
 83: 		file, err := os.Open(PanelStateFile)
 84: 		if err != nil {
 85: 			return fmt.Errorf("failed to open panel state file: %w", err)
 86: 		}
 87: 		defer file.Close()
 88: 
 89: 		scanner := bufio.NewScanner(file)
 90: 		for scanner.Scan() {
 91: 			line := strings.TrimSpace(scanner.Text())
 92: 			if line == "" || strings.HasPrefix(line, "#") {
 93: 				continue
 94: 			}
 95: 
 96: 			parts := strings.SplitN(line, "=", 2)
 97: 			if len(parts) == 2 {
 98: 				existingState[strings.TrimSpace(parts[0])] = strings.TrimSpace(parts[1])
 99: 			}
100: 		}
101: 
102: 		if err := scanner.Err(); err != nil {
103: 			return fmt.Errorf("error reading panel state file: %w", err)
104: 		}
105: 	}
106: 
107: 	// Update state
108: 	status := "disabled"
109: 	if enabled {
110: 		status = "enabled"
111: 	}
112: 	existingState[panelName] = status
113: 
114: 	// Write back
115: 	f, err := os.Create(PanelStateFile)
116: 	if err != nil {
117: 		return fmt.Errorf("failed to create panel state file: %w", err)
118: 	}
119: 	defer f.Close()
120: 
121: 	// Write header
122: 	fmt.Fprintln(f, "# NFTBan Panel State Configuration")
123: 	fmt.Fprintln(f, "# Format: panelname=enabled|disabled")
124: 	fmt.Fprintln(f, "# This file is automatically managed by 'nftban panel' commands")
125: 	fmt.Fprintln(f, "")
126: 
127: 	// Write all panels in alphabetical order
128: 	panels := []string{"directadmin", "cpanel", "plesk", "cyberpanel", "cwp", "interworx", "vesta"}
129: 	for _, panel := range panels {
130: 		if state, exists := existingState[panel]; exists {
131: 			fmt.Fprintf(f, "%s=%s\n", panel, state)
132: 		}
133: 	}
134: 
135: 	return nil
136: }
137: 
138: // LoadPanelConfig loads port configuration for a specific panel by reading its bash config file
139: func LoadPanelConfig(configDir, panelName string) (*PanelConfig, error) {
140: 	panelConfigPath := filepath.Join(configDir, "conf.d", "panels", panelName, "main.conf")
141: 
142: 	// Check if config file exists
143: 	if _, err := os.Stat(panelConfigPath); os.IsNotExist(err) {
144: 		return nil, fmt.Errorf("panel config not found: %s", panelConfigPath)
145: 	}
146: 
147: 	// Parse bash config file to extract port variables
148: 	// We use bash to source the file and output the variables
149: 	config := &PanelConfig{
150: 		Name:       panelName,
151: 		Enabled:    true,
152: 		ConfigFile: panelConfigPath,
153: 		TCPIn:      []int{},
154: 		TCPOut:     []int{},
155: 		UDPIn:      []int{},
156: 		UDPOut:     []int{},
157: 	}
158: 
159: 	// Uppercase panel name for variable prefix
160: 	panelUpper := strings.ToUpper(panelName)
161: 
162: 	// Variable names to extract
163: 	varNames := map[string]*[]int{
164: 		fmt.Sprintf("NFTBAN_%s_TCP_IN", panelUpper):  &config.TCPIn,
165: 		fmt.Sprintf("NFTBAN_%s_TCP_OUT", panelUpper): &config.TCPOut,
166: 		fmt.Sprintf("NFTBAN_%s_UDP_IN", panelUpper):  &config.UDPIn,
167: 		fmt.Sprintf("NFTBAN_%s_UDP_OUT", panelUpper): &config.UDPOut,
168: 	}
169: 
170: 	// Extract each variable using bash
171: 	for varName, portList := range varNames {
172: 		bashCmd := fmt.Sprintf("source %s && echo \"${%s:-}\"", panelConfigPath, varName)
173: 		cmd := exec.Command("bash", "-c", bashCmd)
174: 		output, err := cmd.Output()
175: 		if err != nil {
176: 			// Variable might not be defined - that's OK, skip it
177: 			continue
178: 		}
179: 
180: 		portString := strings.TrimSpace(string(output))
181: 		if portString == "" {
182: 			continue
183: 		}
184: 
185: 		// Parse comma-separated port list (may contain ranges)
186: 		ports, err := parsePortList(portString)
187: 		if err != nil {
188: 			fmt.Fprintf(os.Stderr, "Warning: Failed to parse %s: %v\n", varName, err)
189: 			continue
190: 		}
191: 
192: 		*portList = ports
193: 	}
194: 
195: 	return config, nil
196: }
197: 
198: // LoadAllPanelPorts loads port configuration for all enabled panels
199: func LoadAllPanelPorts(configDir string) (*PortConfig, error) {
200: 	combined := &PortConfig{
201: 		TCPPorts: []int{},
202: 		UDPPorts: []int{},
203: 		AllRules: []PortRule{},
204: 		PortMap:  make(map[int][]string),
205: 	}
206: 
207: 	// Get enabled panels
208: 	enabledPanels, err := LoadEnabledPanels()
209: 	if err != nil {
210: 		return nil, fmt.Errorf("failed to load enabled panels: %w", err)
211: 	}
212: 
213: 	if len(enabledPanels) == 0 {
214: 		// No panels enabled - return empty config
215: 		return combined, nil
216: 	}
217: 
218: 	// Load each enabled panel's config
219: 	for _, panelName := range enabledPanels {
220: 		panelCfg, err := LoadPanelConfig(configDir, panelName)
221: 		if err != nil {
222: 			fmt.Fprintf(os.Stderr, "Warning: Failed to load panel config for %s: %v\n", panelName, err)
223: 			continue
224: 		}
225: 
226: 		// Add TCP IN ports (input chain - most common for panels)
227: 		for _, port := range panelCfg.TCPIn {
228: 			rule := PortRule{
229: 				Port:     port,
230: 				Protocol: "T",
231: 				Source:   fmt.Sprintf("panel:%s", panelName),
232: 			}
233: 			combined.AllRules = append(combined.AllRules, rule)
234: 			combined.PortMap[port] = append(combined.PortMap[port], "T")
235: 		}
236: 
237: 		// Add UDP IN ports
238: 		for _, port := range panelCfg.UDPIn {
239: 			rule := PortRule{
240: 				Port:     port,
241: 				Protocol: "U",
242: 				Source:   fmt.Sprintf("panel:%s", panelName),
243: 			}
244: 			combined.AllRules = append(combined.AllRules, rule)
245: 			combined.PortMap[port] = append(combined.PortMap[port], "U")
246: 		}
247: 
248: 		// Note: TCP_OUT and UDP_OUT are for OUTPUT chain rules
249: 		// For now we focus on INPUT chain (most panels only need INPUT)
250: 		// Future enhancement: Support OUTPUT chain port rules
251: 	}
252: 
253: 	// Deduplicate
254: 	combined.deduplicatePorts()
255: 
256: 	return combined, nil
257: }
258: 
259: // parsePortList parses a comma-separated port list (may contain ranges)
260: // Examples: "22,80,443", "20,21,22,35000-35999"
261: func parsePortList(portString string) ([]int, error) {
262: 	var ports []int
263: 
264: 	parts := strings.Split(portString, ",")
265: 	for _, part := range parts {
266: 		part = strings.TrimSpace(part)
267: 		if part == "" {
268: 			continue
269: 		}
270: 
271: 		// Check for range (e.g., "35000-35999")
272: 		if strings.Contains(part, "-") {
273: 			rangeParts := strings.SplitN(part, "-", 2)
274: 			if len(rangeParts) != 2 {
275: 				return nil, fmt.Errorf("invalid port range: %s", part)
276: 			}
277: 
278: 			start, err := strconv.Atoi(strings.TrimSpace(rangeParts[0]))
279: 			if err != nil {
280: 				return nil, fmt.Errorf("invalid port range start: %s", rangeParts[0])
281: 			}
282: 
283: 			end, err := strconv.Atoi(strings.TrimSpace(rangeParts[1]))
284: 			if err != nil {
285: 				return nil, fmt.Errorf("invalid port range end: %s", rangeParts[1])
286: 			}
287: 
288: 			// Validate range
289: 			if start < 1 || start > 65535 || end < 1 || end > 65535 {
290: 				return nil, fmt.Errorf("port range out of bounds (1-65535): %s", part)
291: 			}
292: 			if start > end {
293: 				return nil, fmt.Errorf("invalid port range (start > end): %s", part)
294: 			}
295: 
296: 			// Expand range (but limit to prevent DoS)
297: 			rangeSize := end - start + 1
298: 			if rangeSize > 10000 {
299: 				return nil, fmt.Errorf("port range too large (>10000 ports): %s", part)
300: 			}
301: 
302: 			for p := start; p <= end; p++ {
303: 				ports = append(ports, p)
304: 			}
305: 		} else {
306: 			// Single port
307: 			port, err := strconv.Atoi(part)
308: 			if err != nil {
309: 				return nil, fmt.Errorf("invalid port number: %s", part)
310: 			}
311: 
312: 			if port < 1 || port > 65535 {
313: 				return nil, fmt.Errorf("port out of range (1-65535): %d", port)
314: 			}
315: 
316: 			ports = append(ports, port)
317: 		}
318: 	}
319: 
320: 	return ports, nil
321: }
322: 
323: // LoadAllPorts loads ports from BOTH ports.d/ directory AND enabled panel configs
324: func LoadAllPorts(configDir string) (*PortConfig, error) {
325: 	// Load custom ports from ports.d/
326: 	portsDir := filepath.Join(configDir, "ports.d")
327: 	customPorts, err := LoadPortsFromDirectory(portsDir)
328: 	if err != nil {
329: 		return nil, fmt.Errorf("failed to load custom ports: %w", err)
330: 	}
331: 
332: 	// Load panel ports from enabled panels
333: 	panelPorts, err := LoadAllPanelPorts(configDir)
334: 	if err != nil {
335: 		return nil, fmt.Errorf("failed to load panel ports: %w", err)
336: 	}
337: 
338: 	// Merge both sources
339: 	combined := &PortConfig{
340: 		TCPPorts: []int{},
341: 		UDPPorts: []int{},
342: 		AllRules: []PortRule{},
343: 		PortMap:  make(map[int][]string),
344: 	}
345: 
346: 	// Add custom ports
347: 	combined.AllRules = append(combined.AllRules, customPorts.AllRules...)
348: 	for port, protocols := range customPorts.PortMap {
349: 		combined.PortMap[port] = append(combined.PortMap[port], protocols...)
350: 	}
351: 
352: 	// Add panel ports
353: 	combined.AllRules = append(combined.AllRules, panelPorts.AllRules...)
354: 	for port, protocols := range panelPorts.PortMap {
355: 		combined.PortMap[port] = append(combined.PortMap[port], protocols...)
356: 	}
357: 
358: 	// Deduplicate
359: 	combined.deduplicatePorts()
360: 
361: 	return combined, nil
362: }
</file>

<file path="pkg/portscan/module.go">
  1: // =============================================================================
  2: // NFTBan v1.0 - Port Scan Detection Module (Go Wrapper)
  3: // =============================================================================
  4: // SPDX-License-Identifier: MPL-2.0
  5: // Package: portscan
  6: // Purpose: Go module wrapper for portscan detection, integrates with event bus
  7: //
  8: // Architecture:
  9: // - Wraps the bash dual-mode implementation (classic/suricata/hybrid)
 10: // - Publishes events to the central event bus
 11: // - Subscribes to portscan events from other modules
 12: // - Runs periodic detection cycles via goroutine
 13: //
 14: // The bash scripts remain the implementation layer, this module provides:
 15: // - Event bus integration
 16: // - Daemon lifecycle management
 17: // - Metrics collection
 18: // =============================================================================
 19: 
 20: package portscan
 21: 
 22: import (
 23: 	"context"
 24: 	"os/exec"
 25: 	"strings"
 26: 	"sync"
 27: 	"time"
 28: 
 29: 	"github.com/itcmsgr/nftban/pkg/eventbus"
 30: 	"github.com/itcmsgr/nftban/pkg/module"
 31: 	"github.com/itcmsgr/nftban/pkg/nftbanconf"
 32: )
 33: 
 34: const (
 35: 	ModuleName    = "portscan"
 36: 	ModuleVersion = "1.0.0"
 37: 
 38: 	// Check interval
 39: 	DefaultCheckInterval = 60 * time.Second
 40: )
 41: 
 42: // getPortscanScript returns the portscan script path from central config
 43: // NO FALLBACK - path must come from /etc/nftban/nftban.conf
 44: func getPortscanScript() string {
 45: 	cfg := nftbanconf.MustLoad()
 46: 	return cfg.LibDir + "/core/nftban_portscan.sh"
 47: }
 48: 
 49: // Module implements the portscan detection module
 50: type Module struct {
 51: 	bus           *eventbus.Bus
 52: 	status        module.Status
 53: 	mu            sync.RWMutex
 54: 	cancel        context.CancelFunc
 55: 	checkInterval time.Duration
 56: 
 57: 	// Runtime state
 58: 	mode          string // classic, suricata, hybrid, auto
 59: 	enabled       bool
 60: 	suricataAvail bool
 61: 	scansDetected int64
 62: }
 63: 
 64: // New creates a new portscan detection module
 65: func New() *Module {
 66: 	return &Module{
 67: 		status:        module.NewStatus(ModuleName),
 68: 		checkInterval: DefaultCheckInterval,
 69: 		mode:          "auto",
 70: 		enabled:       true,
 71: 	}
 72: }
 73: 
 74: // Name returns the module identifier
 75: func (m *Module) Name() string {
 76: 	return ModuleName
 77: }
 78: 
 79: // Init initializes the module with the event bus
 80: func (m *Module) Init(bus *eventbus.Bus) error {
 81: 	m.bus = bus
 82: 
 83: 	// Subscribe to relevant events
 84: 	bus.Subscribe(eventbus.EventPortscan, m.handlePortscanEvent)
 85: 
 86: 	// Detect current mode
 87: 	m.detectMode()
 88: 
 89: 	m.status.Enabled = m.enabled
 90: 	return nil
 91: }
 92: 
 93: // Start begins the module's background work
 94: func (m *Module) Start(ctx context.Context) error {
 95: 	ctx, m.cancel = context.WithCancel(ctx)
 96: 
 97: 	m.mu.Lock()
 98: 	m.status.MarkRunning()
 99: 	m.mu.Unlock()
100: 
101: 	// Enable portscan detection
102: 	if err := m.enable(); err != nil {
103: 		m.status.RecordError(err)
104: 	}
105: 
106: 	// Start periodic detection goroutine
107: 	go m.runDetectionCycle(ctx)
108: 
109: 	// Publish module start event
110: 	m.bus.Publish(eventbus.NewEvent(eventbus.EventModuleStart, ModuleName).
111: 		WithMessage("Portscan detection module started").
112: 		WithData("mode", m.mode))
113: 
114: 	return nil
115: }
116: 
117: // Stop gracefully shuts down the module
118: func (m *Module) Stop() error {
119: 	if m.cancel != nil {
120: 		m.cancel()
121: 	}
122: 
123: 	// Disable portscan detection
124: 	m.disable()
125: 
126: 	m.mu.Lock()
127: 	m.status.MarkStopped()
128: 	m.mu.Unlock()
129: 
130: 	// Publish module stop event
131: 	m.bus.Publish(eventbus.NewEvent(eventbus.EventModuleStop, ModuleName).
132: 		WithMessage("Portscan detection module stopped"))
133: 
134: 	return nil
135: }
136: 
137: // Status returns the current module status
138: func (m *Module) Status() module.Status {
139: 	m.mu.RLock()
140: 	defer m.mu.RUnlock()
141: 
142: 	m.status.UpdateUptime()
143: 	m.status.Extra["mode"] = m.mode
144: 	m.status.Extra["suricata_available"] = m.suricataAvail
145: 	m.status.Extra["scans_detected"] = m.scansDetected
146: 
147: 	return m.status
148: }
149: 
150: // detectMode detects the current portscan detection mode
151: func (m *Module) detectMode() {
152: 	scriptPath := getPortscanScript()
153: 	// Source the script and get mode
154: 	out, err := exec.Command("bash", "-c",
155: 		"source "+scriptPath+" 2>/dev/null && nftban_portscan_load_config && _nftban_portscan_detect_mode").Output()
156: 	if err != nil {
157: 		m.mode = "classic" // Default fallback
158: 		return
159: 	}
160: 	m.mode = strings.TrimSpace(string(out))
161: 
162: 	// Check Suricata availability
163: 	out, _ = exec.Command("bash", "-c",
164: 		"source "+scriptPath+" 2>/dev/null && _nftban_portscan_suricata_is_available && echo yes || echo no").Output()
165: 	m.suricataAvail = strings.TrimSpace(string(out)) == "yes"
166: }
167: 
168: // enable enables portscan detection
169: func (m *Module) enable() error {
170: 	cmd := exec.Command("bash", "-c", "source "+getPortscanScript()+" && nftban_portscan_enable")
171: 	return cmd.Run()
172: }
173: 
174: // disable disables portscan detection
175: func (m *Module) disable() error {
176: 	cmd := exec.Command("bash", "-c", "source "+getPortscanScript()+" && nftban_portscan_disable")
177: 	return cmd.Run()
178: }
179: 
180: // runDetectionCycle runs periodic detection cycles
181: func (m *Module) runDetectionCycle(ctx context.Context) {
182: 	ticker := time.NewTicker(m.checkInterval)
183: 	defer ticker.Stop()
184: 
185: 	for {
186: 		select {
187: 		case <-ctx.Done():
188: 			return
189: 		case <-ticker.C:
190: 			m.runCycle()
191: 		}
192: 	}
193: }
194: 
195: // runCycle runs a single detection cycle
196: func (m *Module) runCycle() {
197: 	// Run the bash detection script
198: 	cmd := exec.Command("bash", "-c", "source "+getPortscanScript()+" && nftban_portscan_run")
199: 	err := cmd.Run()
200: 
201: 	m.mu.Lock()
202: 	defer m.mu.Unlock()
203: 
204: 	m.status.RecordEvent()
205: 	if err != nil {
206: 		m.status.RecordError(err)
207: 	} else {
208: 		m.status.ClearError()
209: 	}
210: }
211: 
212: // handlePortscanEvent handles portscan events from other sources
213: func (m *Module) handlePortscanEvent(e eventbus.Event) {
214: 	m.mu.Lock()
215: 	m.scansDetected++
216: 	m.status.RecordEvent()
217: 	m.mu.Unlock()
218: 
219: 	// Publish processed event
220: 	if m.bus != nil {
221: 		m.bus.Publish(eventbus.NewEvent(eventbus.EventPortscan, ModuleName).
222: 			WithIP(e.IP).
223: 			WithMessage("Portscan detected and processed").
224: 			WithSeverity(eventbus.SeverityWarning).
225: 			WithData("total_scans", m.scansDetected))
226: 	}
227: }
228: 
229: // Descriptor returns the module descriptor
230: // NO FALLBACK - path must come from /etc/nftban/nftban.conf
231: func Descriptor() module.Descriptor {
232: 	cfg := nftbanconf.MustLoad()
233: 	return module.Descriptor{
234: 		Name:        ModuleName,
235: 		Version:     ModuleVersion,
236: 		Description: "Port Scan Detection (Dual-Mode: Classic/Suricata/Hybrid)",
237: 		Optional:    false,
238: 		ConfigFile:  cfg.ConfigDir + "/conf.d/portscan/main.conf",
239: 	}
240: }
</file>

<file path="pkg/runtime/state.go">
  1: package runtime
  2: 
  3: import (
  4: 	"fmt"
  5: 	"sync"
  6: 	"time"
  7: 
  8: 	"github.com/itcmsgr/nftban/pkg/blacklist"
  9: 	"github.com/itcmsgr/nftban/pkg/whitelist"
 10: )
 11: 
 12: // RuntimeState holds the in-memory firewall state
 13: // Thread-safe with RWMutex
 14: type RuntimeState struct {
 15: 	mu sync.RWMutex
 16: 
 17: 	// Whitelist sets (IPv4 and IPv6 separated)
 18: 	WhitelistIPv4 map[string]*IPEntry
 19: 	WhitelistIPv6 map[string]*IPEntry
 20: 
 21: 	// Blacklist sets (IPv4 and IPv6 separated)
 22: 	BlacklistIPv4 map[string]*IPEntry
 23: 	BlacklistIPv6 map[string]*IPEntry
 24: 
 25: 	// Effective sets (computed from sources)
 26: 	EffectiveBlackIPv4 map[string]bool
 27: 	EffectiveBlackIPv6 map[string]bool
 28: 
 29: 	// Per-source tracking
 30: 	Sources map[string]*SourceStats
 31: 
 32: 	// Counters
 33: 	Counters *Counters
 34: 
 35: 	// Config directory
 36: 	ConfigDir string
 37: 
 38: 	// Last reload time
 39: 	LastReload time.Time
 40: }
 41: 
 42: // IPEntry represents a single IP in the runtime state
 43: type IPEntry struct {
 44: 	IP         string
 45: 	Source     string    // "whitelist", "blacklist", "feeds", "geoban", "tempban" (v1.0: removed fail2ban)
 46: 	AddedAt    time.Time
 47: 	BanCount   int       // Number of times this IP was banned
 48: 	LastBanAt  time.Time // Last time this IP was banned
 49: 	ExpireAt   *time.Time // Optional: expiration time for temporary bans
 50: 	Reason     string    // Why this IP was added
 51: }
 52: 
 53: // SourceStats tracks statistics per source
 54: type SourceStats struct {
 55: 	Name         string
 56: 	IPv4Count    int
 57: 	IPv6Count    int
 58: 	LastUpdate   time.Time
 59: 	TotalAdded   int64 // Lifetime counter
 60: 	TotalRemoved int64 // Lifetime counter
 61: }
 62: 
 63: // Counters holds atomic counters for metrics
 64: type Counters struct {
 65: 	mu sync.RWMutex
 66: 
 67: 	// Global counters
 68: 	TotalWhitelistIPv4 int64
 69: 	TotalWhitelistIPv6 int64
 70: 	TotalBlacklistIPv4 int64
 71: 	TotalBlacklistIPv6 int64
 72: 
 73: 	// Per-source counters
 74: 	FeedsIPv4     int64
 75: 	FeedsIPv6     int64
 76: 	GeoBanIPv4    int64
 77: 	GeoBanIPv6    int64
 78: 	// Removed: Fail2BanIPv4, Fail2BanIPv6 (v1.0 migration to Suricata)
 79: 	ManualIPv4    int64
 80: 	ManualIPv6    int64
 81: 
 82: 	// Operations counters
 83: 	BansTotal      int64
 84: 	UnbansTotal    int64
 85: 	ReloadsTotal   int64
 86: 	SyncsTotal     int64
 87: 	SyncErrorsTotal int64
 88: }
 89: 
 90: // NewRuntimeState creates a new RuntimeState instance
 91: func NewRuntimeState(configDir string) *RuntimeState {
 92: 	return &RuntimeState{
 93: 		WhitelistIPv4: make(map[string]*IPEntry),
 94: 		WhitelistIPv6: make(map[string]*IPEntry),
 95: 		BlacklistIPv4: make(map[string]*IPEntry),
 96: 		BlacklistIPv6: make(map[string]*IPEntry),
 97: 		EffectiveBlackIPv4: make(map[string]bool),
 98: 		EffectiveBlackIPv6: make(map[string]bool),
 99: 		Sources:    make(map[string]*SourceStats),
100: 		Counters:   &Counters{},
101: 		ConfigDir:  configDir,
102: 		LastReload: time.Now(),
103: 	}
104: }
105: 
106: // LoadWhitelists loads all whitelist files into memory
107: func (rs *RuntimeState) LoadWhitelists() error {
108: 	rs.mu.Lock()
109: 	defer rs.mu.Unlock()
110: 
111: 	// Load from all whitelist sources
112: 	ipv4Set, ipv6Set, err := whitelist.LoadAllWhitelists(rs.ConfigDir)
113: 	if err != nil {
114: 		return fmt.Errorf("failed to load whitelists: %w", err)
115: 	}
116: 
117: 	// Clear existing whitelists
118: 	rs.WhitelistIPv4 = make(map[string]*IPEntry)
119: 	rs.WhitelistIPv6 = make(map[string]*IPEntry)
120: 
121: 	// Populate IPv4 whitelist
122: 	for ip := range ipv4Set {
123: 		rs.WhitelistIPv4[ip] = &IPEntry{
124: 			IP:      ip,
125: 			Source:  "whitelist",
126: 			AddedAt: time.Now(),
127: 		}
128: 	}
129: 
130: 	// Populate IPv6 whitelist
131: 	for ip := range ipv6Set {
132: 		rs.WhitelistIPv6[ip] = &IPEntry{
133: 			IP:      ip,
134: 			Source:  "whitelist",
135: 			AddedAt: time.Now(),
136: 		}
137: 	}
138: 
139: 	// Update counters
140: 	rs.Counters.mu.Lock()
141: 	rs.Counters.TotalWhitelistIPv4 = int64(len(rs.WhitelistIPv4))
142: 	rs.Counters.TotalWhitelistIPv6 = int64(len(rs.WhitelistIPv6))
143: 	rs.Counters.mu.Unlock()
144: 
145: 	// Update source stats
146: 	if _, ok := rs.Sources["whitelist"]; !ok {
147: 		rs.Sources["whitelist"] = &SourceStats{Name: "whitelist"}
148: 	}
149: 	rs.Sources["whitelist"].IPv4Count = len(rs.WhitelistIPv4)
150: 	rs.Sources["whitelist"].IPv6Count = len(rs.WhitelistIPv6)
151: 	rs.Sources["whitelist"].LastUpdate = time.Now()
152: 
153: 	return nil
154: }
155: 
156: // LoadBlacklists loads all blacklist files into memory
157: func (rs *RuntimeState) LoadBlacklists() error {
158: 	rs.mu.Lock()
159: 	defer rs.mu.Unlock()
160: 
161: 	// Load from all blacklist sources
162: 	ipv4Set, ipv6Set, err := blacklist.LoadAllBlacklists(rs.ConfigDir)
163: 	if err != nil {
164: 		return fmt.Errorf("failed to load blacklists: %w", err)
165: 	}
166: 
167: 	// Clear existing blacklists
168: 	rs.BlacklistIPv4 = make(map[string]*IPEntry)
169: 	rs.BlacklistIPv6 = make(map[string]*IPEntry)
170: 
171: 	// Populate IPv4 blacklist
172: 	for ip := range ipv4Set {
173: 		rs.BlacklistIPv4[ip] = &IPEntry{
174: 			IP:      ip,
175: 			Source:  "blacklist",
176: 			AddedAt: time.Now(),
177: 		}
178: 	}
179: 
180: 	// Populate IPv6 blacklist
181: 	for ip := range ipv6Set {
182: 		rs.BlacklistIPv6[ip] = &IPEntry{
183: 			IP:      ip,
184: 			Source:  "blacklist",
185: 			AddedAt: time.Now(),
186: 		}
187: 	}
188: 
189: 	// Update counters
190: 	rs.Counters.mu.Lock()
191: 	rs.Counters.TotalBlacklistIPv4 = int64(len(rs.BlacklistIPv4))
192: 	rs.Counters.TotalBlacklistIPv6 = int64(len(rs.BlacklistIPv6))
193: 	rs.Counters.mu.Unlock()
194: 
195: 	// Update source stats
196: 	if _, ok := rs.Sources["blacklist"]; !ok {
197: 		rs.Sources["blacklist"] = &SourceStats{Name: "blacklist"}
198: 	}
199: 	rs.Sources["blacklist"].IPv4Count = len(rs.BlacklistIPv4)
200: 	rs.Sources["blacklist"].IPv6Count = len(rs.BlacklistIPv6)
201: 	rs.Sources["blacklist"].LastUpdate = time.Now()
202: 
203: 	return nil
204: }
205: 
206: // ReloadAll reloads both whitelists and blacklists
207: func (rs *RuntimeState) ReloadAll() error {
208: 	if err := rs.LoadWhitelists(); err != nil {
209: 		return fmt.Errorf("failed to reload whitelists: %w", err)
210: 	}
211: 
212: 	if err := rs.LoadBlacklists(); err != nil {
213: 		return fmt.Errorf("failed to reload blacklists: %w", err)
214: 	}
215: 
216: 	rs.mu.Lock()
217: 	rs.LastReload = time.Now()
218: 	rs.mu.Unlock()
219: 
220: 	rs.Counters.mu.Lock()
221: 	rs.Counters.ReloadsTotal++
222: 	rs.Counters.mu.Unlock()
223: 
224: 	return nil
225: }
226: 
227: // IsWhitelisted checks if an IP is in the whitelist
228: func (rs *RuntimeState) IsWhitelisted(ip string, isIPv4 bool) bool {
229: 	rs.mu.RLock()
230: 	defer rs.mu.RUnlock()
231: 
232: 	if isIPv4 {
233: 		_, ok := rs.WhitelistIPv4[ip]
234: 		return ok
235: 	}
236: 
237: 	_, ok := rs.WhitelistIPv6[ip]
238: 	return ok
239: }
240: 
241: // IsBlacklisted checks if an IP is in the blacklist
242: func (rs *RuntimeState) IsBlacklisted(ip string, isIPv4 bool) bool {
243: 	rs.mu.RLock()
244: 	defer rs.mu.RUnlock()
245: 
246: 	if isIPv4 {
247: 		_, ok := rs.BlacklistIPv4[ip]
248: 		return ok
249: 	}
250: 
251: 	_, ok := rs.BlacklistIPv6[ip]
252: 	return ok
253: }
254: 
255: // AddToBlacklist adds an IP to the blacklist
256: func (rs *RuntimeState) AddToBlacklist(ip string, isIPv4 bool, source string, reason string) error {
257: 	// Check if whitelisted first
258: 	if rs.IsWhitelisted(ip, isIPv4) {
259: 		return fmt.Errorf("cannot blacklist %s: IP is whitelisted", ip)
260: 	}
261: 
262: 	rs.mu.Lock()
263: 	defer rs.mu.Unlock()
264: 
265: 	entry := &IPEntry{
266: 		IP:        ip,
267: 		Source:    source,
268: 		AddedAt:   time.Now(),
269: 		BanCount:  1,
270: 		LastBanAt: time.Now(),
271: 		Reason:    reason,
272: 	}
273: 
274: 	if isIPv4 {
275: 		if existing, ok := rs.BlacklistIPv4[ip]; ok {
276: 			// IP already blacklisted, increment ban count
277: 			existing.BanCount++
278: 			existing.LastBanAt = time.Now()
279: 			return nil
280: 		}
281: 		rs.BlacklistIPv4[ip] = entry
282: 		rs.Counters.mu.Lock()
283: 		rs.Counters.TotalBlacklistIPv4++
284: 		rs.Counters.BansTotal++
285: 		rs.Counters.mu.Unlock()
286: 	} else {
287: 		if existing, ok := rs.BlacklistIPv6[ip]; ok {
288: 			existing.BanCount++
289: 			existing.LastBanAt = time.Now()
290: 			return nil
291: 		}
292: 		rs.BlacklistIPv6[ip] = entry
293: 		rs.Counters.mu.Lock()
294: 		rs.Counters.TotalBlacklistIPv6++
295: 		rs.Counters.BansTotal++
296: 		rs.Counters.mu.Unlock()
297: 	}
298: 
299: 	return nil
300: }
301: 
302: // RemoveFromBlacklist removes an IP from the blacklist
303: func (rs *RuntimeState) RemoveFromBlacklist(ip string, isIPv4 bool) error {
304: 	rs.mu.Lock()
305: 	defer rs.mu.Unlock()
306: 
307: 	if isIPv4 {
308: 		if _, ok := rs.BlacklistIPv4[ip]; !ok {
309: 			return fmt.Errorf("IP %s not found in blacklist", ip)
310: 		}
311: 		delete(rs.BlacklistIPv4, ip)
312: 		rs.Counters.mu.Lock()
313: 		rs.Counters.TotalBlacklistIPv4--
314: 		rs.Counters.UnbansTotal++
315: 		rs.Counters.mu.Unlock()
316: 	} else {
317: 		if _, ok := rs.BlacklistIPv6[ip]; !ok {
318: 			return fmt.Errorf("IP %s not found in blacklist", ip)
319: 		}
320: 		delete(rs.BlacklistIPv6, ip)
321: 		rs.Counters.mu.Lock()
322: 		rs.Counters.TotalBlacklistIPv6--
323: 		rs.Counters.UnbansTotal++
324: 		rs.Counters.mu.Unlock()
325: 	}
326: 
327: 	return nil
328: }
329: 
330: // GetStats returns a snapshot of current stats
331: func (rs *RuntimeState) GetStats() map[string]interface{} {
332: 	rs.mu.RLock()
333: 	defer rs.mu.RUnlock()
334: 
335: 	rs.Counters.mu.RLock()
336: 	defer rs.Counters.mu.RUnlock()
337: 
338: 	return map[string]interface{}{
339: 		"whitelist_ipv4": len(rs.WhitelistIPv4),
340: 		"whitelist_ipv6": len(rs.WhitelistIPv6),
341: 		"blacklist_ipv4": len(rs.BlacklistIPv4),
342: 		"blacklist_ipv6": len(rs.BlacklistIPv6),
343: 		"last_reload":    rs.LastReload.Format(time.RFC3339),
344: 		"counters": map[string]int64{
345: 			"bans_total":        rs.Counters.BansTotal,
346: 			"unbans_total":      rs.Counters.UnbansTotal,
347: 			"reloads_total":     rs.Counters.ReloadsTotal,
348: 			"syncs_total":       rs.Counters.SyncsTotal,
349: 			"sync_errors_total": rs.Counters.SyncErrorsTotal,
350: 		},
351: 	}
352: }
353: 
354: // GetWhitelistSnapshot returns a copy of current whitelist
355: func (rs *RuntimeState) GetWhitelistSnapshot() ([]string, []string) {
356: 	rs.mu.RLock()
357: 	defer rs.mu.RUnlock()
358: 
359: 	ipv4List := make([]string, 0, len(rs.WhitelistIPv4))
360: 	for ip := range rs.WhitelistIPv4 {
361: 		ipv4List = append(ipv4List, ip)
362: 	}
363: 
364: 	ipv6List := make([]string, 0, len(rs.WhitelistIPv6))
365: 	for ip := range rs.WhitelistIPv6 {
366: 		ipv6List = append(ipv6List, ip)
367: 	}
368: 
369: 	return ipv4List, ipv6List
370: }
371: 
372: // GetBlacklistSnapshot returns a copy of current blacklist
373: func (rs *RuntimeState) GetBlacklistSnapshot() ([]string, []string) {
374: 	rs.mu.RLock()
375: 	defer rs.mu.RUnlock()
376: 
377: 	ipv4List := make([]string, 0, len(rs.BlacklistIPv4))
378: 	for ip := range rs.BlacklistIPv4 {
379: 		ipv4List = append(ipv4List, ip)
380: 	}
381: 
382: 	ipv6List := make([]string, 0, len(rs.BlacklistIPv6))
383: 	for ip := range rs.BlacklistIPv6 {
384: 		ipv6List = append(ipv6List, ip)
385: 	}
386: 
387: 	return ipv4List, ipv6List
388: }
389: 
390: // IncrementSyncCounter increments the sync counter
391: func (rs *RuntimeState) IncrementSyncCounter(success bool) {
392: 	rs.Counters.mu.Lock()
393: 	defer rs.Counters.mu.Unlock()
394: 
395: 	rs.Counters.SyncsTotal++
396: 	if !success {
397: 		rs.Counters.SyncErrorsTotal++
398: 	}
399: }
</file>

<file path="pkg/suricata/customrules/manager.go">
  1: package customrules
  2: 
  3: import (
  4: 	"bufio"
  5: 	"fmt"
  6: 	"os"
  7: 	"path/filepath"
  8: 	"strings"
  9: 	"time"
 10: 
 11: 	"github.com/itcmsgr/nftban/pkg/nftbanconf"
 12: )
 13: 
 14: // CustomRule represents a custom Suricata rule
 15: type CustomRule struct {
 16: 	SID      int
 17: 	FilePath string
 18: 	Rule     string
 19: 	Message  string
 20: 	Action   string
 21: 	Enabled  bool
 22: }
 23: 
 24: // Manager handles custom rule operations
 25: type Manager struct {
 26: 	rulesDir   string
 27: 	backupDir  string
 28: 	customFile string
 29: }
 30: 
 31: // NewManager creates a new custom rules manager
 32: func NewManager() (*Manager, error) {
 33: 	cfg := nftbanconf.MustLoad()
 34: 	rulesDir := filepath.Join(cfg.ConfigDir, "suricata/rules")
 35: 	backupDir := filepath.Join(cfg.ConfigDir, "suricata/rules/backups")
 36: 	customFile := filepath.Join(rulesDir, "custom.rules")
 37: 
 38: 	// Ensure directories exist
 39: 	if err := os.MkdirAll(rulesDir, 0755); err != nil {
 40: 		return nil, fmt.Errorf("failed to create rules directory: %w", err)
 41: 	}
 42: 	if err := os.MkdirAll(backupDir, 0755); err != nil {
 43: 		return nil, fmt.Errorf("failed to create backup directory: %w", err)
 44: 	}
 45: 
 46: 	// Create custom.rules if it doesn't exist
 47: 	if _, err := os.Stat(customFile); os.IsNotExist(err) {
 48: 		header := `# NFTBan Custom Suricata Rules
 49: # SID Range: 9000000-9999999
 50: # Edit with: nftban suricata custom add/edit
 51: # Validate with: nftban suricata custom validate
 52: #
 53: # IMPORTANT: Always use SIDs in range 9000000-9999999
 54: # Lower SIDs are reserved for official rulesets

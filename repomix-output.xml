<file path="cli/lib/nftban/core/nftban_health.sh">
   1: #!/usr/bin/env bash
   2: # shellcheck disable=SC1090  # Dynamic config paths, cannot follow
   3: # =============================================================================
   4: # NFTBan v1.0 - Health Check System
   5: # =============================================================================
   6: # SPDX-License-Identifier: MPL-2.0
   7: # Purpose: System health checks and diagnostics
   8: #
   9: # meta:name=nftban_health
  10: # meta:type=core
  11: # meta:header=Health Check System
  12: # meta:version=1.0.0
  13: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
  14: # meta:homepage=https://nftban.com
  15: #
  16: # **Description & Purpose**
  17: # meta:description=Comprehensive system health verification and auto-fix capabilities
  18: # meta:input=System state and configuration files
  19: # meta:output=Health status reports and automated fixes
  20: #
  21: # **Inventory & Requirements**
  22: # meta:depends=nftban_fhs_spec.sh,nft,systemctl
  23: #
  24: # meta:created_date=2025-11-05
  25: # meta:updated_date=2025-11-24
  26: # =============================================================================
  27: 
  28: # Enhanced strict mode
  29: IFS=$'\n\t'
  30: umask 027
  31: 
  32: # Prevent double-loading
  33: [[ -n "${NFTBAN_HEALTH_LOADED:-}" ]] && return 0
  34: readonly NFTBAN_HEALTH_LOADED=1
  35: 
  36: # =============================================================================
  37: # CONFIGURATION
  38: # =============================================================================
  39: 
  40: # Health check results storage
  41: declare -A NFTBAN_HEALTH_RESULTS
  42: declare -A NFTBAN_HEALTH_ISSUES
  43: declare -a NFTBAN_HEALTH_WARNINGS
  44: declare -a NFTBAN_HEALTH_ERRORS
  45: 
  46: # Health status codes
  47: readonly HEALTH_OK=0
  48: readonly HEALTH_WARNING=1
  49: readonly HEALTH_ERROR=2
  50: readonly HEALTH_CRITICAL=3
  51: readonly HEALTH_NOT_INSTALLED=4
  52: 
  53: # Load main configuration (service names, paths)
  54: # shellcheck source=/etc/nftban/nftban.conf
  55: if [[ -f "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf" ]]; then
  56:     source "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf"
  57: fi
  58: 
  59: # Metrics endpoint defaults (use config or fallback)
  60: : "${NFTBAN_METRICS_PROMETHEUS_ADDR:=localhost:9090}"
  61: : "${NFTBAN_METRICS_NODE_EXPORTER_ADDR:=localhost:9100}"
  62: : "${NFTBAN_METRICS_VICTORIA_ADDR:=localhost:8428}"
  63: : "${NFTBAN_TIMEOUT_FAST:=5}"
  64: 
  65: # Load NFT schema (single source of truth for table/set names)
  66: # NFTBAN_LIB_DIR is set by the calling script (cmd_health.sh, etc.)
  67: # shellcheck source=/usr/lib/nftban/lib/nft_schema.sh
  68: if [[ -f "${NFTBAN_LIB_DIR:-/usr/lib/nftban}/lib/nft_schema.sh" ]]; then
  69:     source "${NFTBAN_LIB_DIR:-/usr/lib/nftban}/lib/nft_schema.sh"
  70: fi
  71: 
  72: # =============================================================================
  73: # INITIALIZATION & DEPENDENCIES
  74: # =============================================================================
  75: 
  76: nftban_health_init() {
  77:     # Initialize health check system and load report modules
  78: 
  79:     # Clear previous results (MUST be associative arrays)
  80:     declare -gA NFTBAN_HEALTH_RESULTS=()
  81:     declare -gA NFTBAN_HEALTH_ISSUES=()
  82:     declare -ga NFTBAN_HEALTH_WARNINGS=()
  83:     declare -ga NFTBAN_HEALTH_ERRORS=()
  84: 
  85:     # Load report modules (orchestrate, don't duplicate!)
  86:     local lib_dir="${NFTBAN_LIB_DIR}"
  87: 
  88:     # Load module report
  89:     if ! declare -f nftban_module_report_summary >/dev/null 2>&1; then
  90:         if [[ -f "${lib_dir}/core/nftban_report_module.sh" ]]; then
  91:             source "${lib_dir}/core/nftban_report_module.sh" 2>/dev/null || true
  92:         fi
  93:     fi
  94: 
  95:     # Load FHS report
  96:     if ! declare -f nftban_fhs_report_summary >/dev/null 2>&1; then
  97:         if [[ -f "${lib_dir}/core/nftban_report_fhs.sh" ]]; then
  98:             source "${lib_dir}/core/nftban_report_fhs.sh" 2>/dev/null || true
  99:         fi
 100:     fi
 101: 
 102:     # Load distro config module for cross-distro compatibility
 103:     if ! declare -f nftban_distro_get_service >/dev/null 2>&1; then
 104:         if [[ -f "${lib_dir}/lib/nftban_distro_config.sh" ]]; then
 105:             source "${lib_dir}/lib/nftban_distro_config.sh" 2>/dev/null || true
 106:         fi
 107:     fi
 108: 
 109:     # Load services report
 110:     if ! declare -f nftban_services_report_summary >/dev/null 2>&1; then
 111:         if [[ -f "${lib_dir}/core/nftban_report_services.sh" ]]; then
 112:             source "${lib_dir}/core/nftban_report_services.sh" 2>/dev/null || true
 113:         fi
 114:     fi
 115: 
 116:     return 0
 117: }
 118: 
 119: # =============================================================================
 120: # BINARY CHECKS
 121: # =============================================================================
 122: 
 123: nftban_health_check_binaries() {
 124:     # Check all required binaries are present and executable
 125:     # Returns: 0=OK, 1=Warning, 2=Error
 126: 
 127:     local status=$HEALTH_OK
 128:     local required_binaries=(
 129:         "nft"
 130:         "systemctl"
 131:         "journalctl"
 132:         "awk"
 133:         "sed"
 134:         "grep"
 135:         "jq"
 136:         "curl"
 137:         "wget"
 138:     )
 139: 
 140:     local optional_binaries=(
 141:         "go"
 142:         "git"
 143:         "mail"
 144:         "sendmail"
 145:     )
 146: 
 147:     local missing_required=()
 148:     local missing_optional=()
 149: 
 150:     # Check required binaries
 151:     for binary in "${required_binaries[@]}"; do
 152:         if ! command -v "$binary" >/dev/null 2>&1; then
 153:             missing_required+=("$binary")
 154:             status=$HEALTH_ERROR
 155:         fi
 156:     done
 157: 
 158:     # Check optional binaries
 159:     for binary in "${optional_binaries[@]}"; do
 160:         if ! command -v "$binary" >/dev/null 2>&1; then
 161:             missing_optional+=("$binary")
 162:             [[ $status -eq $HEALTH_OK ]] && status=$HEALTH_WARNING
 163:         fi
 164:     done
 165: 
 166:     # Store results
 167:     if [[ ${#missing_required[@]} -gt 0 ]]; then
 168:         NFTBAN_HEALTH_ISSUES["binaries"]="Missing required: ${missing_required[*]}"
 169:         NFTBAN_HEALTH_ERRORS+=("Missing required binaries: ${missing_required[*]}")
 170:     fi
 171: 
 172:     if [[ ${#missing_optional[@]} -gt 0 ]]; then
 173:         NFTBAN_HEALTH_WARNINGS+=("Optional features not installed (OK to ignore): ${missing_optional[*]}")
 174:     fi
 175: 
 176:     NFTBAN_HEALTH_RESULTS["binaries"]=$status
 177:     return $status
 178: }
 179: 
 180: # =============================================================================
 181: # PATH CHECKS
 182: # =============================================================================
 183: 
 184: nftban_health_check_paths() {
 185:     # Check all FHS paths exist
 186:     # Returns: 0=OK, 1=Warning, 2=Error
 187: 
 188:     local status=$HEALTH_OK
 189:     local missing_paths=()
 190: 
 191:     # Critical paths
 192:     local critical_paths=(
 193:         "${NFTBAN_LIB_DIR}"
 194:         "${NFTBAN_LIB_DIR}/core"
 195:         "${NFTBAN_LIB_DIR}/cli"
 196:         "${NFTBAN_CONFIG_DIR}"
 197:         "${NFTBAN_DATA_DIR}"
 198:         "${NFTBAN_LOG_DIR}"
 199:     )
 200: 
 201:     # Check critical paths
 202:     for path in "${critical_paths[@]}"; do
 203:         if [[ ! -d "$path" ]]; then
 204:             missing_paths+=("$path")
 205:             status=$HEALTH_ERROR
 206:         fi
 207:     done
 208: 
 209:     # Store results
 210:     if [[ ${#missing_paths[@]} -gt 0 ]]; then
 211:         NFTBAN_HEALTH_ISSUES["paths"]="Missing: ${missing_paths[*]}"
 212:         NFTBAN_HEALTH_ERRORS+=("Missing critical paths: ${missing_paths[*]}")
 213:     fi
 214: 
 215:     NFTBAN_HEALTH_RESULTS["paths"]=$status
 216:     return $status
 217: }
 218: 
 219: # =============================================================================
 220: # PERMISSION CHECKS
 221: # =============================================================================
 222: 
 223: nftban_health_check_permissions() {
 224:     # Check file and directory permissions
 225:     # Returns: 0=OK, 1=Warning, 2=Error
 226: 
 227:     local status=$HEALTH_OK
 228:     local permission_issues=()
 229: 
 230:     # Check nftban user exists
 231:     if ! id -u nftban >/dev/null 2>&1; then
 232:         permission_issues+=("User 'nftban' does not exist")
 233:         status=$HEALTH_ERROR
 234:     fi
 235: 
 236:     # Check critical file permissions
 237:     local critical_files=(
 238:         "/usr/sbin/nftban"
 239:         "${NFTBAN_LIB_DIR}/core/nftban_output.sh"
 240:     )
 241: 
 242:     for file in "${critical_files[@]}"; do
 243:         if [[ -f "$file" ]]; then
 244:             if [[ ! -r "$file" ]]; then
 245:                 permission_issues+=("$file not readable")
 246:                 status=$HEALTH_ERROR
 247:             fi
 248:         fi
 249:     done
 250: 
 251:     # Check config files should be nftban:nftban 644
 252:     local config_files=(
 253:         "${NFTBAN_CONFIG_DIR}/portscan_whitelist.conf"
 254:     )
 255: 
 256:     for file in "${config_files[@]}"; do
 257:         if [[ -f "$file" ]]; then
 258:             local file_owner file_group file_perms
 259:             file_owner=$(stat -c '%U' "$file" 2>/dev/null || echo "unknown")
 260:             file_group=$(stat -c '%G' "$file" 2>/dev/null || echo "unknown")
 261:             file_perms=$(stat -c '%a' "$file" 2>/dev/null || echo "unknown")
 262: 
 263:             if [[ "$file_owner" == "root" || "$file_group" == "root" ]]; then
 264:                 permission_issues+=("$file has root ownership (should be nftban:nftban)")
 265:                 status=$HEALTH_WARNING
 266:             fi
 267: 
 268:             if [[ "$file_perms" == "600" ]]; then
 269:                 permission_issues+=("$file has restrictive permissions 600 (should be 644)")
 270:                 status=$HEALTH_WARNING
 271:             fi
 272:         fi
 273:     done
 274: 
 275:     # Check data directory ownership
 276:     if [[ -d "${NFTBAN_DATA_DIR}" ]]; then
 277:         local owner
 278:         owner=$(stat -c '%U' "${NFTBAN_DATA_DIR}" 2>/dev/null || echo "unknown")
 279:         if [[ "$owner" != "nftban" && "$owner" != "root" ]]; then
 280:             permission_issues+=("${NFTBAN_DATA_DIR} has incorrect owner: $owner")
 281:             status=$HEALTH_WARNING
 282:         fi
 283:     fi
 284: 
 285:     # Store results
 286:     if [[ ${#permission_issues[@]} -gt 0 ]]; then
 287:         NFTBAN_HEALTH_ISSUES["permissions"]="${permission_issues[*]}"
 288:         if [[ $status -eq $HEALTH_ERROR ]]; then
 289:             NFTBAN_HEALTH_ERRORS+=("Permission issues: ${permission_issues[*]}")
 290:         else
 291:             NFTBAN_HEALTH_WARNINGS+=("Permission warnings: ${permission_issues[*]}")
 292:         fi
 293:     fi
 294: 
 295:     NFTBAN_HEALTH_RESULTS["permissions"]=$status
 296:     return $status
 297: }
 298: 
 299: # =============================================================================
 300: # NFTABLES SECURITY CHECKS
 301: # =============================================================================
 302: 
 303: nftban_health_check_nftables_security() {
 304:     # Check for security vulnerabilities in nftables configuration
 305:     # Specifically: CVE-2025-NFTBAN-001 (inet filter bypass)
 306:     # Returns: 0=OK, 2=Critical Error
 307: 
 308:     local status=$HEALTH_OK
 309:     local security_issues=()
 310: 
 311:     # Check for legacy inet filter table (CVE-2025-NFTBAN-001)
 312:     if nft list table inet filter &>/dev/null 2>&1; then
 313:         # Table exists - check if it has ACCEPT policy at priority 0
 314:         local filter_policy
 315:         filter_policy=$(nft list table inet filter 2>/dev/null | grep -E 'chain input.*priority 0.*policy accept' || true)
 316: 
 317:         if [[ -n "$filter_policy" ]]; then
 318:             security_issues+=("CRITICAL: inet filter table with 'policy accept' at priority 0 bypasses nftban blocking (CVE-2025-NFTBAN-001)")
 319:             security_issues+=("  └─ All banned IPs can still connect!")
 320:             security_issues+=("  └─ FIX: nft delete table inet filter")
 321:             status=$HEALTH_CRITICAL
 322:         else
 323:             # Table exists but not at priority 0 or doesn't have accept policy
 324:             security_issues+=("WARNING: inet filter table exists but may not conflict")
 325:             security_issues+=("  └─ Verify with: nft list table inet filter")
 326:             status=$HEALTH_WARNING
 327:         fi
 328:     fi
 329: 
 330:     # Check nftban tables exist (v0.7.3: dual-table architecture)
 331:     if ! nft list table ${NFTBAN_TABLE_IPV4} &>/dev/null 2>&1; then
 332:         security_issues+=("ERROR: IPv4 table (${NFTBAN_TABLE_IPV4}) missing - firewall not active")
 333:         status=$HEALTH_CRITICAL
 334:     fi
 335: 
 336:     if ! nft list table ${NFTBAN_TABLE_IPV6} &>/dev/null 2>&1; then
 337:         security_issues+=("WARNING: IPv6 table (${NFTBAN_TABLE_IPV6}) missing - IPv6 firewall not active")
 338:         [[ $status -eq $HEALTH_OK ]] && status=$HEALTH_WARNING
 339:     fi
 340: 
 341:     # Store results
 342:     if [[ ${#security_issues[@]} -gt 0 ]]; then
 343:         NFTBAN_HEALTH_ISSUES["nftables_security"]="${security_issues[*]}"
 344:         if [[ $status -eq $HEALTH_CRITICAL ]]; then
 345:             NFTBAN_HEALTH_ERRORS+=("CRITICAL nftables security issue: ${security_issues[*]}")
 346:         elif [[ $status -eq $HEALTH_WARNING ]]; then
 347:             NFTBAN_HEALTH_WARNINGS+=("nftables security warning: ${security_issues[*]}")
 348:         fi
 349:     fi
 350: 
 351:     NFTBAN_HEALTH_RESULTS["nftables_security"]=$status
 352:     return $status
 353: }
 354: 
 355: nftban_health_check_conflicting_firewalls() {
 356:     # Check for conflicting firewall services (firewalld, iptables, ufw)
 357:     # These cannot coexist with nftban and cause unpredictable behavior
 358:     # Returns: 0=OK, 1=Warning, 2=Critical Error
 359: 
 360:     local status=$HEALTH_OK
 361:     local firewall_conflicts=()
 362: 
 363:     # Check firewalld
 364:     if command -v firewall-cmd &>/dev/null; then
 365:         if systemctl is-active --quiet firewalld 2>/dev/null; then
 366:             firewall_conflicts+=("ERROR: firewalld is ACTIVE - conflicts with nftban")
 367:             firewall_conflicts+=("  └─ FIX: systemctl stop firewalld && systemctl disable firewalld")
 368:             status=$HEALTH_CRITICAL
 369:         elif systemctl is-enabled --quiet firewalld 2>/dev/null; then
 370:             firewall_conflicts+=("WARNING: firewalld is ENABLED (not running)")
 371:             firewall_conflicts+=("  └─ FIX: systemctl disable firewalld")
 372:             [[ $status -eq $HEALTH_OK ]] && status=$HEALTH_WARNING
 373:         fi
 374:     fi
 375: 
 376:     # Check iptables service
 377:     if systemctl is-active --quiet iptables 2>/dev/null || \
 378:        systemctl is-active --quiet iptables.service 2>/dev/null || \
 379:        systemctl is-active --quiet ip6tables.service 2>/dev/null; then
 380:         firewall_conflicts+=("ERROR: iptables service is ACTIVE - conflicts with nftban")
 381:         firewall_conflicts+=("  └─ FIX: systemctl stop iptables && systemctl disable iptables")
 382:         status=$HEALTH_CRITICAL
 383:     elif systemctl is-enabled --quiet iptables 2>/dev/null || \
 384:          systemctl is-enabled --quiet iptables.service 2>/dev/null; then
 385:         firewall_conflicts+=("WARNING: iptables service is ENABLED (not running)")
 386:         firewall_conflicts+=("  └─ FIX: systemctl disable iptables")
 387:         [[ $status -eq $HEALTH_OK ]] && status=$HEALTH_WARNING
 388:     fi
 389: 
 390:     # Check ufw
 391:     if command -v ufw &>/dev/null; then
 392:         if ufw status 2>/dev/null | grep -q "Status: active"; then
 393:             firewall_conflicts+=("ERROR: ufw is ACTIVE - conflicts with nftban")
 394:             firewall_conflicts+=("  └─ FIX: ufw disable")
 395:             status=$HEALTH_CRITICAL
 396:         fi
 397:     fi
 398: 
 399:     # Store results
 400:     if [[ ${#firewall_conflicts[@]} -gt 0 ]]; then
 401:         NFTBAN_HEALTH_ISSUES["conflicting_firewalls"]="${firewall_conflicts[*]}"
 402:         if [[ $status -eq $HEALTH_CRITICAL ]]; then
 403:             NFTBAN_HEALTH_ERRORS+=("Conflicting firewall(s) detected: ${firewall_conflicts[*]}")
 404:         else
 405:             NFTBAN_HEALTH_WARNINGS+=("Conflicting firewall(s) enabled: ${firewall_conflicts[*]}")
 406:         fi
 407:     fi
 408: 
 409:     NFTBAN_HEALTH_RESULTS["conflicting_firewalls"]=$status
 410:     return $status
 411: }

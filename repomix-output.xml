<file path="cli/lib/nftban/tests/validate_distro_configs.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan Distro Config Validation Script
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Validate distribution configuration files
  7: # Usage: ./validate_distro_configs.sh [config_dir]
  8: #
  9: # Tests:
 10: # - INI syntax validity
 11: # - Required sections present
 12: # - Required fields in each section
 13: # - Value format validation
 14: # =============================================================================
 15: 
 16: set -Eeuo pipefail
 17: 
 18: # Colors
 19: RED='\033[0;31m'
 20: GREEN='\033[0;32m'
 21: YELLOW='\033[1;33m'
 22: BLUE='\033[0;34m'
 23: NC='\033[0m'
 24: 
 25: # Configuration
 26: CONFIG_DIR="${1:-./}"
 27: ERRORS=0
 28: WARNINGS=0
 29: PASSED=0
 30: 
 31: # Required sections
 32: REQUIRED_SECTIONS=("distro" "package_manager" "packages" "services" "paths")
 33: 
 34: # Required fields per section
 35: declare -A REQUIRED_FIELDS
 36: REQUIRED_FIELDS[distro]="id name version family"
 37: REQUIRED_FIELDS[package_manager]="type install_cmd update_cmd query_cmd"
 38: REQUIRED_FIELDS[packages]="nftables curl bash systemd fail2ban mail golang"
 39: REQUIRED_FIELDS[services]="cron rsyslog fail2ban nftables sshd"
 40: REQUIRED_FIELDS[paths]="nft systemctl journalctl"
 41: 
 42: # =============================================================================
 43: # VALIDATION FUNCTIONS
 44: # =============================================================================
 45: 
 46: print_header() {
 47:     echo ""
 48:     echo "═══════════════════════════════════════════════════════════"
 49:     echo "  NFTBan Distribution Config Validator"
 50:     echo "═══════════════════════════════════════════════════════════"
 51:     echo ""
 52: }
 53: 
 54: print_summary() {
 55:     echo ""
 56:     echo "═══════════════════════════════════════════════════════════"
 57:     echo "  Validation Summary"
 58:     echo "═══════════════════════════════════════════════════════════"
 59:     echo ""
 60:     echo -e "${GREEN}✓ Passed: ${PASSED}${NC}"
 61:     echo -e "${YELLOW}⚠ Warnings: ${WARNINGS}${NC}"
 62:     echo -e "${RED}✗ Errors: ${ERRORS}${NC}"
 63:     echo ""
 64: 
 65:     if [[ $ERRORS -eq 0 ]]; then
 66:         echo -e "${GREEN}All validations passed!${NC}"
 67:         return 0
 68:     else
 69:         echo -e "${RED}Validation failed with ${ERRORS} error(s)${NC}"
 70:         return 1
 71:     fi
 72: }
 73: 
 74: # Check if section exists in config
 75: has_section() {
 76:     local file="$1"
 77:     local section="$2"
 78:     grep -q "^\[$section\]" "$file"
 79: }
 80: 
 81: # Get value from INI file
 82: get_value() {
 83:     local file="$1"
 84:     local section="$2"
 85:     local key="$3"
 86: 
 87:     awk -F= -v section="$section" -v key="$key" '
 88:         /^\[.*\]/ { in_section=0 }
 89:         $0 == "["section"]" { in_section=1; next }
 90:         in_section && $1 ~ "^"key"$" {
 91:             gsub(/^[ \t]+|[ \t]+$/, "", $2)
 92:             print $2
 93:             exit
 94:         }
 95:     ' "$file"
 96: }
 97: 
 98: # Validate INI syntax
 99: validate_syntax() {
100:     local file="$1"
101:     local filename
102:     filename=$(basename "$file")
103:     local syntax_errors=0
104: 
105:     # Check for basic INI format issues
106:     while IFS= read -r line; do
107:         # Skip empty lines and comments
108:         [[ -z "$line" || "$line" =~ ^# ]] && continue
109: 
110:         # Check for section headers
111:         if [[ "$line" =~ ^\[ ]]; then
112:             if [[ ! "$line" =~ ^\[[a-z_]+\]$ ]]; then
113:                 echo -e "${RED}  ✗ Invalid section header: $line${NC}"
114:                 ((syntax_errors++))
115:             fi
116:             continue
117:         fi
118: 
119:         # Check for key=value pairs
120:         if [[ ! "$line" =~ ^[a-z_]+=.+ ]]; then
121:             echo -e "${RED}  ✗ Invalid line format: $line${NC}"
122:             ((syntax_errors++))
123:         fi
124:     done < "$file"
125: 
126:     if [[ $syntax_errors -eq 0 ]]; then
127:         echo -e "${GREEN}  ✓ Syntax valid${NC}"
128:         ((PASSED++))
129:         return 0
130:     else
131:         echo -e "${RED}  ✗ Syntax errors: $syntax_errors${NC}"
132:         ((ERRORS+=syntax_errors))
133:         return 1
134:     fi
135: }
136: 
137: # Validate required sections
138: validate_sections() {
139:     local file="$1"
140:     local missing=0
141: 
142:     for section in "${REQUIRED_SECTIONS[@]}"; do
143:         if has_section "$file" "$section"; then
144:             echo -e "${GREEN}  ✓ Section [$section] present${NC}"
145:             ((PASSED++))
146:         else
147:             echo -e "${RED}  ✗ Section [$section] missing${NC}"
148:             ((ERRORS++))
149:             ((missing++))
150:         fi
151:     done
152: 
153:     return $missing
154: }
155: 
156: # Validate required fields in a section
157: validate_fields() {
158:     local file="$1"
159:     local section="$2"
160:     local required="${REQUIRED_FIELDS[$section]}"
161:     local missing=0
162: 
163:     for field in $required; do
164:         local value
165:         value=$(get_value "$file" "$section" "$field")
166:         if [[ -n "$value" ]]; then
167:             echo -e "${GREEN}    ✓ $field = $value${NC}"
168:             ((PASSED++))
169:         else
170:             echo -e "${RED}    ✗ $field is missing or empty${NC}"
171:             ((ERRORS++))
172:             ((missing++))
173:         fi
174:     done
175: 
176:     return $missing
177: }
178: 
179: # Validate distro family
180: validate_family() {
181:     local file="$1"
182:     local family
183:     family=$(get_value "$file" "distro" "family")
184: 
185:     case "$family" in
186:         rhel|debian)
187:             echo -e "${GREEN}    ✓ Valid family: $family${NC}"
188:             ((PASSED++))
189:             return 0
190:             ;;
191:         *)
192:             echo -e "${RED}    ✗ Invalid family: $family (expected: rhel or debian)${NC}"
193:             ((ERRORS++))
194:             return 1
195:             ;;
196:     esac
197: }
198: 
199: # Validate package manager type
200: validate_pkgmgr() {
201:     local file="$1"
202:     local type
203:     type=$(get_value "$file" "package_manager" "type")
204: 
205:     case "$type" in
206:         dnf|yum|apt-get)
207:             echo -e "${GREEN}    ✓ Valid package manager: $type${NC}"
208:             ((PASSED++))
209:             return 0
210:             ;;
211:         *)
212:             echo -e "${YELLOW}    ⚠ Unusual package manager: $type${NC}"
213:             ((WARNINGS++))
214:             return 0
215:             ;;
216:     esac
217: }
218: 
219: # Validate query_cmd matches family
220: validate_query_cmd() {
221:     local file="$1"
222:     local family
223:     family=$(get_value "$file" "distro" "family")
224:     local query_cmd
225:     query_cmd=$(get_value "$file" "package_manager" "query_cmd")
226: 
227:     case "$family" in
228:         rhel)
229:             if [[ "$query_cmd" == "rpm -qa" ]]; then
230:                 echo -e "${GREEN}    ✓ Correct query_cmd for RHEL family${NC}"
231:                 ((PASSED++))
232:             else
233:                 echo -e "${RED}    ✗ Wrong query_cmd for RHEL: $query_cmd (expected: rpm -qa)${NC}"
234:                 ((ERRORS++))
235:             fi
236:             ;;
237:         debian)
238:             if [[ "$query_cmd" == "dpkg -l" ]]; then
239:                 echo -e "${GREEN}    ✓ Correct query_cmd for Debian family${NC}"
240:                 ((PASSED++))
241:             else
242:                 echo -e "${RED}    ✗ Wrong query_cmd for Debian: $query_cmd (expected: dpkg -l)${NC}"
243:                 ((ERRORS++))
244:             fi
245:             ;;
246:     esac
247: }
248: 
249: # Validate a single config file
250: validate_config() {
251:     local file="$1"
252:     local filename
253:     filename=$(basename "$file")
254: 
255:     echo ""
256:     echo -e "${BLUE}Validating: $filename${NC}"
257:     echo "───────────────────────────────────────────────────────────"
258: 
259:     # 1. Syntax validation
260:     echo "Checking syntax..."
261:     validate_syntax "$file"
262: 
263:     # 2. Section validation
264:     echo ""
265:     echo "Checking required sections..."
266:     validate_sections "$file"
267: 
268:     # 3. Field validation per section
269:     for section in "${REQUIRED_SECTIONS[@]}"; do
270:         if has_section "$file" "$section"; then
271:             echo ""
272:             echo "Checking [$section] fields..."
273:             validate_fields "$file" "$section"
274: 
275:             # Special validations
276:             if [[ "$section" == "distro" ]]; then
277:                 validate_family "$file"
278:             elif [[ "$section" == "package_manager" ]]; then
279:                 validate_pkgmgr "$file"
280:                 validate_query_cmd "$file"
281:             fi
282:         fi
283:     done
284: }
285: 
286: # =============================================================================
287: # MAIN
288: # =============================================================================
289: 
290: print_header
291: 
292: # Find all .conf files
293: echo "Searching for config files in: $CONFIG_DIR"
294: echo ""
295: 
296: config_files=()
297: while IFS= read -r -d '' file; do
298:     config_files+=("$file")
299: done < <(find "$CONFIG_DIR" -name "*.conf" -type f -print0 2>/dev/null)
300: 
301: if [[ ${#config_files[@]} -eq 0 ]]; then
302:     echo -e "${RED}No config files found in $CONFIG_DIR${NC}"
303:     exit 1
304: fi
305: 
306: echo "Found ${#config_files[@]} config file(s)"
307: 
308: # Validate each config
309: for config in "${config_files[@]}"; do
310:     validate_config "$config"
311: done
312: 
313: # Print summary
314: print_summary
</file>


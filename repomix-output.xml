 480: nftban_watchdog_check_fd() {
 481:     # Check file descriptor usage from /proc/sys/fs/file-nr
 482:     # Returns: status code, sets WATCHDOG_RESULTS
 483: 
 484:     local allocated free max
 485:     # File-nr uses tabs as separator, but also spaces sometimes - use explicit IFS
 486:     if ! IFS=$' \t' read -r allocated free max < /proc/sys/fs/file-nr 2>/dev/null; then
 487:         WATCHDOG_RESULTS[fd_status]="ERROR"
 488:         return $WATCHDOG_WARNING
 489:     fi
 490: 
 491:     WATCHDOG_RESULTS[fd_allocated]="$allocated"
 492:     WATCHDOG_RESULTS[fd_free]="$free"
 493:     WATCHDOG_RESULTS[fd_max]="$max"
 494: 
 495:     # Calculate percentage
 496:     local fd_percent=0
 497:     if [[ $max -gt 0 ]]; then
 498:         fd_percent=$((allocated * 100 / max))
 499:     fi
 500:     WATCHDOG_RESULTS[fd_used_percent]="$fd_percent"
 501: 
 502:     # Alert if over 80% (hardcoded threshold for FD exhaustion)
 503:     if [[ $fd_percent -ge 80 ]]; then
 504:         WATCHDOG_RESULTS[fd_status]="WARNING"
 505:         if watchdog_should_alert "fd"; then
 506:             watchdog_alert "WARNING" "File descriptors at ${fd_percent}% (${allocated}/${max})"
 507:         fi
 508:         return $WATCHDOG_WARNING
 509:     fi
 510: 
 511:     WATCHDOG_RESULTS[fd_status]="OK"
 512:     return $WATCHDOG_OK
 513: }

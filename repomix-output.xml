 531:     # Load core modules (only if not doing completion)
 532:     if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_output.sh" ]]; then
 533:         # shellcheck source=/dev/null
 534:         source "${NFTBAN_LIB_DIR}/core/nftban_output.sh"

 665: // AddIPWithTimeout adds a single IP to a set with optional timeout
 666: // If timeout is 0, IP is added permanently
 667: // If timeout > 0, IP will auto-expire after the specified duration
 668: //
 669: // IMPORTANT: For interval sets, uses nft CLI to avoid corrupted ranges.
 670: // The netlink library doesn't properly handle interval markers for single IPs,
 671: // which can cause corrupted ranges like "1.2.3.4-255.255.255.255".
 672: func (m *NFTManager) AddIPWithTimeout(set *nftables.Set, ipStr string, timeout time.Duration) error {
 673: 	ip := net.ParseIP(ipStr)
 674: 	if ip == nil {
 675: 		return fmt.Errorf("invalid IP: %s", ipStr)
 676: 	}
 677: 
 678: 	// Validate IP type matches set type
 679: 	if set.KeyType == nftables.TypeIPAddr {
 680: 		if ip.To4() == nil {
 681: 			return fmt.Errorf("IP %s is not IPv4", ipStr)
 682: 		}
 683: 	} else {
 684: 		if ip.To4() != nil {
 685: 			return fmt.Errorf("IP %s is not IPv6", ipStr)
 686: 		}
 687: 	}
 688: 
 689: 	// For interval sets, use nft CLI to avoid corrupted interval ranges
 690: 	// The netlink library doesn't properly handle interval markers for single IPs
 691: 	if set.Interval {
 692: 		return m.addIPWithTimeoutCLI(set, ipStr, timeout)
 693: 	}
 694: 
 695: 	// Non-interval sets: use netlink directly
 696: 	var key []byte
 697: 	if set.KeyType == nftables.TypeIPAddr {
 698: 		key = ip.To4()
 699: 	} else {
 700: 		key = ip.To16()
 701: 	}
 702: 
 703: 	element := nftables.SetElement{
 704: 		Key: key,
 705: 	}
 706: 
 707: 	// Add timeout if specified
 708: 	if timeout > 0 {
 709: 		element.Timeout = timeout
 710: 	}
 711: 
 712: 	if err := m.conn.SetAddElements(set, []nftables.SetElement{element}); err != nil {
 713: 		return fmt.Errorf("failed to add element: %w", err)
 714: 	}
 715: 
 716: 	if err := m.conn.Flush(); err != nil {
 717: 		// Ignore "file exists" errors - element already in set
 718: 		if !strings.Contains(err.Error(), "file exists") && !strings.Contains(err.Error(), "exists") {
 719: 			return fmt.Errorf("failed to flush: %w", err)
 720: 		}
 721: 		// Element already exists - not an error
 722: 	}
 723: 
 724: 	return nil
 725: }

 602: nftban_health_should_alert() {
 603:     # Check if we should send an alert for a specific issue
 604:     # Args: $1 = alert_key (unique identifier for this alert type)
 605:     # Returns: 0 = should alert, 1 = throttled (too soon)
 606: 
 607:     local alert_key="$1"
 608:     local throttle_seconds="${NFTBAN_ALERT_THROTTLE_SECONDS:-3600}"
 609:     local state_file="${NFTBAN_ALERT_STATE_FILE:-${NFTBAN_DATA_DIR}/state/health_alerts.state}"
 610:     local state_dir
 611:     state_dir=$(dirname "$state_file")
 612: 
 613:     # Create state directory if it doesn't exist
 614:     if [[ ! -d "$state_dir" ]]; then
 615:         mkdir -p "$state_dir" 2>/dev/null || return 0
 616:     fi
 617: 
 618:     # Create state file if it doesn't exist
 619:     if [[ ! -f "$state_file" ]]; then
 620:         touch "$state_file" 2>/dev/null || return 0
 621:     fi
 622: 
 623:     local current_time
 624:     current_time=$(date +%s)
 625: 
 626:     # Check last alert time for this key
 627:     local last_alert_time
 628:     last_alert_time=$(grep "^${alert_key}:" "$state_file" 2>/dev/null | cut -d: -f2)
 629: 
 630:     if [[ -n "$last_alert_time" ]]; then
 631:         local time_since_last_alert
 632:         time_since_last_alert=$((current_time - last_alert_time))
 633: 
 634:         if [[ $time_since_last_alert -lt $throttle_seconds ]]; then
 635:             # Too soon, throttle this alert
 636:             return 1
 637:         fi
 638:     fi
 639: 
 640:     # Update state file with current time
 641:     # Remove old entry and add new one
 642:     grep -v "^${alert_key}:" "$state_file" > "${state_file}.tmp" 2>/dev/null || true
 643:     echo "${alert_key}:${current_time}" >> "${state_file}.tmp"
 644:     mv "${state_file}.tmp" "$state_file" 2>/dev/null || true
 645: 
 646:     # Clean up old entries (older than 24 hours)
 647:     local cutoff_time
 648:     cutoff_time=$((current_time - 86400))
 649:     awk -F: -v cutoff="$cutoff_time" '$2 >= cutoff' "$state_file" > "${state_file}.tmp" 2>/dev/null || true
 650:     mv "${state_file}.tmp" "$state_file" 2>/dev/null || true
 651: 
 652:     # Should send alert
 653:     return 0
 654: }

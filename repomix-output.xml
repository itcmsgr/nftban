 231:     # Usage: nftban_stats_count_whitelist
 232:     # Returns: Total whitelist entries
 233: 
 234:     local total=0
 235: 
 236:     # Read from nftables whitelist_ipv4 set (v0.7.3 naming)
 237:     if nft list set "${NFTBAN_TABLE_IPV4}" whitelist_ipv4 &>/dev/null 2>&1; then
 238:         local wl_v4
 239:         wl_v4=$(nft list set "${NFTBAN_TABLE_IPV4}" whitelist_ipv4 2>/dev/null | { grep -oP '\d+\.\d+\.\d+\.\d+(/\d+)?' || true; } | wc -l 2>/dev/null)
 240:         wl_v4=${wl_v4:-0}
 241:         total=$((total + wl_v4))
 242:     fi
 243: 
 244:     # Read from nftables whitelist_ipv6 set (v0.7.3 naming)
 245:     if nft list set "${NFTBAN_TABLE_IPV6}" whitelist_ipv6 &>/dev/null 2>&1; then
 246:         local wl_v6

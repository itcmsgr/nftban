522:             systemctl restart nftban.service 2>/dev/null || echo "    (not running)"
523: 
524:             # nftables
525:             echo "  Restarting nftables.service..."
526:             systemctl restart nftables.service 2>/dev/null || echo "    (not running)"
527: 
528:             # Suricata (if enabled)
529:             if declare -f nftban_service_is_enabled &>/dev/null && nftban_service_is_enabled "suricata"; then
530:                 echo "  Restarting suricata.service..."
531:                 systemctl restart suricata.service 2>/dev/null || echo "    (not running)"
532:             elif command -v suricata &>/dev/null; then
533:                 echo "  Suricata: disabled in config (skipping)"
534:             fi
535: 
536:             # Login monitor (if active)
537:             if systemctl is-active --quiet "${NFTBAN_SERVICE_LOGIN_MONITOR:-nftban-login-monitor.service}" 2>/dev/null; then
538:                 echo "  Restarting ${NFTBAN_SERVICE_LOGIN_MONITOR:-nftban-login-monitor.service}..."
539:                 systemctl restart "${NFTBAN_SERVICE_LOGIN_MONITOR:-nftban-login-monitor.service}" || true
540:             fi
541:             ;;
542:         nftables)
543:             echo "Restarting nftables..."
544:             systemctl restart nftables.service
545:             ;;
546:         suricata)
547:             echo "Restarting Suricata..."
548:             systemctl restart suricata.service
549:             ;;
550:         login)
551:             echo "Restarting login monitor..."
552:             systemctl restart "${NFTBAN_SERVICE_LOGIN_MONITOR:-nftban-login-monitor.service}"
553:             ;;
554:         timers)

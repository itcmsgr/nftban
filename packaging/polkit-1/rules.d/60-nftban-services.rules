// =============================================================================
// NFTBan v1.0 - Service Management Polkit Rules
// =============================================================================
// SPDX-License-Identifier: MPL-2.0
// Purpose: Grant nftban group permission to manage all NFTBan systemd services
// Location: /etc/polkit-1/rules.d/60-nftban-services.rules
//
// Security Model:
// - Members of 'nftban' group can manage NFTBan systemd services without sudo
// - Scope limited to services starting with "nftban" prefix
// - Follows principle of least privilege
//
// Groups:
//   nftban: All NFTBan operators (CLI, services, web UI)
//
// Commands this enables (for nftban group members):
//   systemctl start nftban-*
//   systemctl stop nftban-*
//   systemctl restart nftban-*
//   systemctl reload nftban-*
//   systemctl enable nftban-*
//   systemctl disable nftban-*
//
// Design Philosophy:
//   ✓ NO sudo required for service management
//   ✓ Single group-based access control (nftban)
//   ✓ Limited scope (only nftban-* services)
//   ✓ Follows systemd best practices
// =============================================================================

polkit.addRule(function(action, subject) {
  // Only handle systemd unit management actions
  if (!(action.id == "org.freedesktop.systemd1.manage-units" ||
        action.id == "org.freedesktop.systemd1.manage-unit-files")) {
    return polkit.Result.NOT_HANDLED;
  }

  // Check if user is in nftban group
  if (!subject.isInGroup("nftban")) {
    return polkit.Result.NOT_HANDLED;
  }

  var unit = action.lookup("unit");
  var verb = action.lookup("verb");

  // Only allow managing NFTBan units by prefix
  if (!unit || unit.indexOf("nftban") !== 0) {
    return polkit.Result.NOT_HANDLED;
  }

  // Allowed service lifecycle operations
  var allowedVerbs = [
    "start",
    "stop",
    "restart",
    "reload",
    "enable",
    "disable",
    "try-restart",
    "reload-or-restart",
    "try-reload-or-restart"
  ];

  if (allowedVerbs.indexOf(verb) >= 0) {
    return polkit.Result.YES;
  }

  return polkit.Result.NOT_HANDLED;
});

// =============================================================================
// SECURITY NOTES
// =============================================================================
//
// Why this is safe:
// - Scope limited to nftban group members only
// - Only allows management of services starting with "nftban"
// - No broad system access granted
// - Users still cannot modify service files or configurations
// - Standard Polkit authorization flow
//
// Allowed services (examples):
// - nftban.service
// - nftban-ui.service
// - nftban-login-monitor.service
// - nftban-metrics-exporter.service
// - nftban-metrics-exporter.timer
// - nftban-health.timer
// - nftban-core.service
// - nftban-core-feeds.service
// - nftban-core-feeds.timer
// - nftban-core-geoip.service
// - nftban-core-geoip.timer
// - nftban-suricata.service
// - nftban-suricata-update.timer
// - nftban-queue.timer
// - nftban-snapshot.timer
// - nftban-rollback.timer
//
// To verify rule is loaded:
//   pkaction --action-id org.freedesktop.systemd1.manage-units --verbose
//
// To test authorization (as nftban group member):
//   systemctl restart nftban-ui     # Should work without sudo
//   systemctl status nftban-ui      # Should work (reading is always allowed)
//
// To add user to group:
//   sudo usermod -a -G nftban username
//   # User must log out and back in for group membership to take effect
//
// Related:
// - 10-nftban-core.rules (explicit whitelist for core services)
// - 20-nftban-suricata.rules (native Suricata services)
// - 50-nftban-auth.rules (auth helper access)
// - 50-nftban-v030.rules (auditors read-only)
//
// =============================================================================

108: // Sync performs atomic firewall reload
109: //
110: // Algorithm (single phase) - v0.7.3 unified architecture:
111: // 1. Read static config (whitelist, blacklist, ports)
112: // 2. Build feed sets (Go pkg/feeds) - loaded into unified blacklist
113: // 3. Build geoban sets (Go pkg/geoban) - loaded into unified blacklist
114: // 4. Dump runtime sets (temp_whitelist_ipv4/ipv6, blacklist with timeout)
115: // 5. Generate rules.new.nft
116: // 6. Validate: nft -c -f rules.new.nft
117: // 7. Snapshot: nft list ruleset > backup.nft
118: // 8. Apply: nft -f rules.new.nft
119: // 9. Restore runtime elements (temp_whitelist, blacklist items with timeout)
120: func Sync(opts *SyncOptions) error {
121: 	if opts == nil {
122: 		opts = DefaultSyncOptions()
123: 	}
124: 
125: 	// Ensure directories exist
126: 	if err := os.MkdirAll(opts.StagingDir, 0750); err != nil {
127: 		return fmt.Errorf("failed to create staging dir: %w", err)
128: 	}
129: 	if err := os.MkdirAll(opts.SnapshotDir, 0750); err != nil {
130: 		return fmt.Errorf("failed to create snapshot dir: %w", err)
131: 	}
132: 
133: 	fmt.Println("==> Step 1: Read static config")
134: 	config := model.NewFirewallConfig()
135: 
136: 	// Load whitelist
137: 	if whitelist, err := loadIPFile(opts.WhitelistFile); err == nil {
138: 		config.Whitelist = whitelist
139: 		fmt.Printf("    Whitelist: %d IPv4, %d IPv6\n", len(whitelist.IPv4), len(whitelist.IPv6))
140: 	} else {
141: 		fmt.Printf("    WARNING: No whitelist file: %v\n", err)
142: 	}
143: 
144: 	// Load blacklist
145: 	if blacklist, err := loadIPFile(opts.BlacklistFile); err == nil {
146: 		config.Blacklist = blacklist
147: 		fmt.Printf("    Blacklist: %d IPv4, %d IPv6\n", len(blacklist.IPv4), len(blacklist.IPv6))
148: 	} else {
149: 		fmt.Printf("    WARNING: No blacklist file: %v\n", err)
150: 	}
151: 
152: 	config.TCPPorts = opts.TCPPorts
153: 	config.UDPPorts = opts.UDPPorts
154: 
155: 	fmt.Println("\n==> Step 2: Build feed sets")
156: 	feedsData, err := feeds.Build(opts.FeedsDir, nil)
157: 	if err != nil {
158: 		return fmt.Errorf("failed to build feeds: %w", err)
159: 	}
160: 	config.Feeds = feedsData
161: 	for name, data := range feedsData {
162: 		fmt.Printf("    %s: %d IPv4, %d IPv6\n", name, len(data.IPv4), len(data.IPv6))
163: 	}
164: 
165: 	fmt.Println("\n==> Step 3: Build geoban sets")
166: 	geobanData, err := geoban.Build(opts.GeobanDir, nil)
167: 	if err != nil {
168: 		return fmt.Errorf("failed to build geoban: %w", err)
169: 	}
170: 	config.Geoban = geobanData
171: 	fmt.Printf("    GeoBan: %d IPv4, %d IPv6\n", len(geobanData.IPv4), len(geobanData.IPv6))
172: 
173: 	fmt.Println("\n==> Step 4: Dump runtime sets (Fail2Ban state)")
174: 	runtime, err := dumpRuntimeSets()
175: 	if err != nil {
176: 		fmt.Printf("    WARNING: Failed to dump runtime sets: %v\n", err)
177: 	} else {
178: 		config.RuntimeBans = runtime.Bans
179: 		config.RuntimeWhitelist = runtime.Whitelist
180: 		fmt.Printf("    Runtime bans: %d IPv4, %d IPv6\n", len(runtime.Bans.IPv4), len(runtime.Bans.IPv6))
181: 		fmt.Printf("    Runtime whitelist: %d IPv4, %d IPv6\n", len(runtime.Whitelist.IPv4), len(runtime.Whitelist.IPv6))
182: 	}
183: 
184: 	fmt.Println("\n==> Step 5: Generate rules.new.nft")
185: 	rulesPath := filepath.Join(opts.StagingDir, "rules.new.nft")
186: 	if err := generateRuleset(rulesPath, config, opts.TemplateFile); err != nil {
187: 		return fmt.Errorf("failed to generate ruleset: %w", err)
188: 	}
189: 	fmt.Printf("    Written: %s\n", rulesPath)
190: 
191: 	fmt.Println("\n==> Step 6: Validate ruleset")
192: 	if err := validateRuleset(rulesPath); err != nil {
193: 		return fmt.Errorf("ruleset validation failed: %w", err)
194: 	}
195: 	fmt.Println("    ✓ Validation passed")
196: 
197: 	if opts.DryRun {
198: 		fmt.Println("\n==> DRY RUN: Stopping before apply")
199: 		return nil
200: 	}
201: 
202: 	fmt.Println("\n==> Step 7: Snapshot current rules")
203: 	snapshotPath := filepath.Join(opts.SnapshotDir, fmt.Sprintf("snapshot-%s.nft", time.Now().Format("2006-01-02T15-04-05")))
204: 	if err := snapshotRuleset(snapshotPath); err != nil {
205: 		return fmt.Errorf("failed to snapshot ruleset: %w", err)
206: 	}
207: 	fmt.Printf("    Snapshot: %s\n", snapshotPath)
208: 
209: 	fmt.Println("\n==> Step 8: Apply new ruleset")
210: 	if err := applyRuleset(rulesPath); err != nil {
211: 		return fmt.Errorf("failed to apply ruleset: %w", err)
212: 	}
213: 	fmt.Println("    ✓ Ruleset applied")
214: 
215: 	fmt.Println("\n==> Step 9: Restore runtime elements")
216: 	if runtime != nil {
217: 		if err := restoreRuntimeSets(runtime); err != nil {
218: 			fmt.Printf("    WARNING: Failed to restore runtime sets: %v\n", err)
219: 		} else {
220: 			fmt.Println("    ✓ Runtime state restored")
221: 		}
222: 	}
223: 
224: 	fmt.Println("\n==> Step 10: Cleanup old snapshots")
225: 	cleanupSnapshots(opts.SnapshotDir, MaxSnapshots)
226: 
227: 	fmt.Println("\n✅ nftban sync COMPLETE")
228: 	return nil
229: }

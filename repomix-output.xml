<file path="cmd/nftban-ui/disable-dev-mode.sh">
 1: #!/usr/bin/env bash
 2: # =============================================================================
 3: # Disable Development Mode for nftban-ui.service
 4: # =============================================================================
 5: # This script removes development mode configuration and restores production
 6: # mode, which uses embedded files.
 7: # =============================================================================
 8: 
 9: set -Eeuo pipefail
10: 
11: # Colors
12: GREEN='\033[0;32m'
13: YELLOW='\033[1;33m'
14: RED='\033[0;31m'
15: NC='\033[0m' # No Color
16: 
17: echo -e "${YELLOW}🔒 Disabling Development Mode for nftban-ui${NC}"
18: echo ""
19: 
20: # Check if running as root
21: if [[ $EUID -ne 0 ]]; then
22:    echo -e "${RED}❌ This script must be run as root${NC}"
23:    exit 1
24: fi
25: 
26: # Service file path
27: DEV_OVERRIDE_FILE="/etc/systemd/system/nftban-ui.service.d/dev-mode.conf"
28: 
29: # Remove dev mode override if it exists
30: if [[ -f "$DEV_OVERRIDE_FILE" ]]; then
31:     rm "$DEV_OVERRIDE_FILE"
32:     echo -e "${GREEN}✅ Removed dev mode override: $DEV_OVERRIDE_FILE${NC}"
33: else
34:     echo -e "${YELLOW}ℹ️  Dev mode override not found (already disabled)${NC}"
35: fi
36: 
37: # Reload systemd
38: systemctl daemon-reload
39: echo -e "${GREEN}✅ Reloaded systemd daemon${NC}"
40: 
41: # Restart service
42: systemctl restart nftban-ui
43: echo -e "${GREEN}✅ Restarted nftban-ui service${NC}"
44: 
45: # Show status
46: echo ""
47: echo -e "${YELLOW}📊 Service Status:${NC}"
48: systemctl status nftban-ui --no-pager -l | head -15
49: 
50: echo ""
51: echo -e "${GREEN}🎉 Production mode restored!${NC}"
52: echo ""
53: echo -e "${YELLOW}Service is now using:${NC}"
54: echo "  - Embedded files (compiled into binary)"
55: echo "  - Standard ExecStart: /usr/sbin/nftban-ui"
56: echo "  - No --dev flag"
</file>

<file path="etc/nftban/conf.d/ddos/classic.conf">
  1: # =============================================================================
  2: # NFTBan DDoS Protection - CLASSIC MODE Configuration
  3: # =============================================================================
  4: # This configuration is used when Suricata is NOT installed/enabled.
  5: # Uses native nftables meters, conntrack, and kernel-level rate limiting.
  6: #
  7: # File: /etc/nftban/conf.d/ddos-classic.conf
  8: # =============================================================================
  9: 
 10: # -----------------------------------------------------------------------------
 11: # CLASSIC MODE SETTINGS
 12: # -----------------------------------------------------------------------------
 13: # These settings control the standalone nftables-based DDoS protection.
 14: # No external IDS required - pure kernel-level enforcement.
 15: 
 16: # SYN Flood Protection
 17: # --------------------
 18: # Rate limit for new TCP SYN packets per source IP
 19: DDOS_CLASSIC_SYN_RATE="25/second"
 20: DDOS_CLASSIC_SYN_BURST="50"
 21: 
 22: # Connection Limits (per source IP)
 23: # ---------------------------------
 24: # Maximum concurrent connections per service
 25: DDOS_CLASSIC_SSH_CONN_LIMIT="10"
 26: DDOS_CLASSIC_HTTP_CONN_LIMIT="100"
 27: DDOS_CLASSIC_HTTPS_CONN_LIMIT="100"
 28: DDOS_CLASSIC_SMTP_CONN_LIMIT="20"
 29: DDOS_CLASSIC_DNS_CONN_LIMIT="50"
 30: 
 31: # Generic connection limit for unlisted ports
 32: DDOS_CLASSIC_GENERIC_CONN_LIMIT="50"
 33: 
 34: # ICMP Rate Limiting
 35: # ------------------
 36: # Rate limit for ICMP echo requests (ping flood protection)
 37: DDOS_CLASSIC_ICMP_RATE="10/second"
 38: DDOS_CLASSIC_ICMP_BURST="20"
 39: 
 40: # ICMPv6 Rate Limiting
 41: DDOS_CLASSIC_ICMPV6_RATE="10/second"
 42: DDOS_CLASSIC_ICMPV6_BURST="20"
 43: 
 44: # UDP Flood Protection
 45: # --------------------
 46: # Rate limit for UDP packets (DNS amplification, etc.)
 47: DDOS_CLASSIC_UDP_RATE="100/second"
 48: DDOS_CLASSIC_UDP_BURST="200"
 49: 
 50: # Port Flood Protection
 51: # ---------------------
 52: # Rate limit for connection attempts across multiple ports (scan detection)
 53: DDOS_CLASSIC_PORT_FLOOD_RATE="50/second"
 54: DDOS_CLASSIC_PORT_FLOOD_BURST="100"
 55: 
 56: # -----------------------------------------------------------------------------
 57: # AUTO-TUNING (Based on System Resources)
 58: # -----------------------------------------------------------------------------
 59: # Enable auto-tuning of thresholds based on CPU cores and RAM
 60: DDOS_CLASSIC_AUTO_TUNE="true"
 61: 
 62: # CPU load threshold to trigger aggressive blocking (percentage of cores)
 63: # Example: 0.9 = 90% of available cores
 64: DDOS_CLASSIC_LOAD_TRIP_MULTIPLIER="0.90"
 65: DDOS_CLASSIC_LOAD_CLEAR_MULTIPLIER="0.60"
 66: 
 67: # Conntrack pressure thresholds (percentage of nf_conntrack_max)
 68: DDOS_CLASSIC_CONNTRACK_TRIP_PERCENT="85"
 69: DDOS_CLASSIC_CONNTRACK_CLEAR_PERCENT="70"
 70: 
 71: # -----------------------------------------------------------------------------
 72: # BLOCKING POLICY
 73: # -----------------------------------------------------------------------------
 74: # Default ban duration for detected attackers (seconds)
 75: DDOS_CLASSIC_BAN_DURATION_SHORT="300"      # 5 minutes (first offense)
 76: DDOS_CLASSIC_BAN_DURATION_MEDIUM="1800"    # 30 minutes (repeat offense)
 77: DDOS_CLASSIC_BAN_DURATION_LONG="3600"      # 1 hour (persistent attacker)
 78: 
 79: # Escalation: number of hits before increasing ban duration
 80: DDOS_CLASSIC_ESCALATE_THRESHOLD="3"
 81: 
 82: # -----------------------------------------------------------------------------
 83: # METER/SET NAMES (nftables)
 84: # -----------------------------------------------------------------------------
 85: # Names for nftables meters used in rate limiting
 86: DDOS_CLASSIC_SYN_METER="ddos_syn_flood"
 87: DDOS_CLASSIC_ICMP_METER="ddos_icmp_flood"
 88: DDOS_CLASSIC_UDP_METER="ddos_udp_flood"
 89: DDOS_CLASSIC_PORT_METER="ddos_port_flood"
 90: 
 91: # Set name for blocked IPs
 92: DDOS_CLASSIC_BLOCK_SET="ddos_blocked"
 93: 
 94: # -----------------------------------------------------------------------------
 95: # LOGGING
 96: # -----------------------------------------------------------------------------
 97: # Log file for classic mode events
 98: DDOS_CLASSIC_LOG_FILE="/var/log/nftban/ddos-classic.log"
 99: 
100: # Log level: DEBUG, INFO, WARN, ERROR
101: DDOS_CLASSIC_LOG_LEVEL="INFO"
102: 
103: # Log dropped packets (may be verbose under attack)
104: DDOS_CLASSIC_LOG_DROPS="false"
105: 
106: # =============================================================================
107: # END OF CLASSIC MODE CONFIGURATION
108: # =============================================================================
</file>

<file path="etc/nftban/conf.d/ddos/main.conf">
  1: # =============================================================================
  2: # NFTBan DDoS Protection - MAIN Configuration
  3: # =============================================================================
  4: # Master configuration for DDoS protection module.
  5: # Controls mode selection and global settings.
  6: #
  7: # File: /etc/nftban/conf.d/ddos/main.conf
  8: # =============================================================================
  9: 
 10: # -----------------------------------------------------------------------------
 11: # MODULE ENABLE/DISABLE
 12: # -----------------------------------------------------------------------------
 13: # Master switch for DDoS protection
 14: DDOS_ENABLED="true"
 15: 
 16: # -----------------------------------------------------------------------------
 17: # MODE SELECTION
 18: # -----------------------------------------------------------------------------
 19: # Choose DDoS detection mode:
 20: #
 21: #   auto     - Auto-detect: use Suricata if available, otherwise Classic
 22: #   classic  - Force Classic mode (nftables-only, no IDS)
 23: #   suricata - Force Suricata mode (requires Suricata installed & running)
 24: #   hybrid   - Use both: Classic as Layer 0 + Suricata as Layer 1
 25: #
 26: DDOS_MODE="auto"
 27: 
 28: # -----------------------------------------------------------------------------
 29: # AUTO-DETECTION SETTINGS
 30: # -----------------------------------------------------------------------------
 31: # How to detect if Suricata is available
 32: 
 33: # Check if Suricata service is running
 34: DDOS_AUTO_CHECK_SERVICE="true"
 35: 
 36: # Check if Suricata binary exists
 37: DDOS_AUTO_CHECK_BINARY="true"
 38: 
 39: # Check if EVE JSON file exists and is being written to
 40: DDOS_AUTO_CHECK_EVE_FILE="true"
 41: 
 42: # Suricata service name (for systemctl check)
 43: DDOS_SURICATA_SERVICE_NAME="suricata"
 44: 
 45: # Suricata binary path (for existence check)
 46: DDOS_SURICATA_BINARY="/usr/bin/suricata"
 47: 
 48: # EVE file freshness threshold (seconds) - file must be updated within this time
 49: DDOS_EVE_FRESHNESS_THRESHOLD="60"
 50: 
 51: # -----------------------------------------------------------------------------
 52: # HYBRID MODE SETTINGS
 53: # -----------------------------------------------------------------------------
 54: # When DDOS_MODE="hybrid", both Classic and Suricata run together
 55: 
 56: # Classic mode acts as Layer 0 (hard rate limits)
 57: # Suricata mode acts as Layer 1 (intelligent detection)
 58: 
 59: # Enable Classic Layer 0 even in Suricata mode
 60: DDOS_HYBRID_CLASSIC_LAYER0="true"
 61: 
 62: # Classic Layer 0 uses stricter thresholds (multiplier)
 63: DDOS_HYBRID_CLASSIC_MULTIPLIER="0.5"
 64: 
 65: # -----------------------------------------------------------------------------
 66: # NFTABLES SETTINGS
 67: # -----------------------------------------------------------------------------
 68: # Chain and table names
 69: 
 70: DDOS_NFT_TABLE_IPV4="ip nftban"
 71: DDOS_NFT_TABLE_IPV6="ip6 nftban"
 72: DDOS_NFT_CHAIN="ddos_protection"
 73: 
 74: # Position in input chain (after which rule to insert jump)
 75: # Options: "established" (after ct state established,related)
 76: #          "whitelist"   (after whitelist check)
 77: #          "first"       (at the beginning)
 78: DDOS_NFT_JUMP_POSITION="established"
 79: 
 80: # -----------------------------------------------------------------------------
 81: # WHITELIST
 82: # -----------------------------------------------------------------------------
 83: # IPs/networks that should NEVER be blocked by DDoS protection
 84: 
 85: # Whitelist file path
 86: DDOS_WHITELIST_FILE="/etc/nftban/whitelist.d/ddos-whitelist.conf"
 87: 
 88: # Auto-whitelist localhost
 89: DDOS_WHITELIST_LOCALHOST="true"
 90: 
 91: # Auto-whitelist private networks (RFC1918)
 92: DDOS_WHITELIST_PRIVATE="false"
 93: 
 94: # Auto-whitelist Cloudflare IPs
 95: DDOS_WHITELIST_CLOUDFLARE="false"
 96: 
 97: # -----------------------------------------------------------------------------
 98: # GLOBAL LIMITS (Safety Net)
 99: # -----------------------------------------------------------------------------
100: # Maximum IPs to block (prevent runaway blocking)
101: DDOS_MAX_BLOCKED_IPS="10000"
102: 
103: # Maximum block duration (seconds) - safety cap
104: DDOS_MAX_BAN_DURATION="86400"
105: 
106: # Minimum time between blocks of same IP (seconds)
107: DDOS_MIN_REBLOCK_INTERVAL="60"
108: 
109: # -----------------------------------------------------------------------------
110: # NOTIFICATIONS
111: # -----------------------------------------------------------------------------
112: # Alert on significant events
113: 
114: # Enable email notifications
115: DDOS_NOTIFY_EMAIL="false"
116: DDOS_NOTIFY_EMAIL_TO=""
117: 
118: # Enable webhook notifications
119: DDOS_NOTIFY_WEBHOOK="false"
120: DDOS_NOTIFY_WEBHOOK_URL=""
121: 
122: # Threshold for notification (minimum score or block count)
123: DDOS_NOTIFY_THRESHOLD="0.80"
124: 
125: # =============================================================================
126: # END OF MAIN CONFIGURATION
127: # =============================================================================
</file>

<file path="etc/nftban/conf.d/ddos/suricata.conf">
  1: # =============================================================================
  2: # NFTBan DDoS Protection - SURICATA MODE Configuration
  3: # =============================================================================
  4: # This configuration is used when Suricata IDS is installed and enabled.
  5: # Uses Suricata EVE JSON alerts for intelligent DDoS detection.
  6: #
  7: # File: /etc/nftban/conf.d/ddos/suricata.conf
  8: # =============================================================================
  9: 
 10: # -----------------------------------------------------------------------------
 11: # SURICATA MODE SETTINGS
 12: # -----------------------------------------------------------------------------
 13: # These settings control Suricata-integrated DDoS detection.
 14: # Provides deep packet inspection and signature-based detection.
 15: 
 16: # EVE JSON Log Path (Suricata alert output)
 17: DDOS_SURICATA_EVE_FILE="/var/log/suricata/eve.json"
 18: 
 19: # Alternative: Unix socket for real-time alerts (faster, optional)
 20: DDOS_SURICATA_EVE_SOCKET=""
 21: 
 22: # -----------------------------------------------------------------------------
 23: # ALERT CATEGORIES TO MONITOR
 24: # -----------------------------------------------------------------------------
 25: # Suricata alert categories that trigger DDoS protection
 26: # These map to Suricata rule categories (ET Open / ET Pro)
 27: 
 28: # Enable/disable specific detection types
 29: DDOS_SURICATA_DETECT_SYN_FLOOD="true"
 30: DDOS_SURICATA_DETECT_UDP_FLOOD="true"
 31: DDOS_SURICATA_DETECT_ICMP_FLOOD="true"
 32: DDOS_SURICATA_DETECT_DNS_AMPLIFICATION="true"
 33: DDOS_SURICATA_DETECT_NTP_AMPLIFICATION="true"
 34: DDOS_SURICATA_DETECT_SSDP_AMPLIFICATION="true"
 35: DDOS_SURICATA_DETECT_HTTP_FLOOD="true"
 36: DDOS_SURICATA_DETECT_SLOWLORIS="true"
 37: 
 38: # Signature patterns to match (regex, pipe-separated)
 39: DDOS_SURICATA_SIG_PATTERNS="DDoS|flood|amplification|reflection|slowloris"
 40: 
 41: # Signature IDs to explicitly monitor (comma-separated)
 42: # Example ET Open SIDs for DDoS detection
 43: DDOS_SURICATA_SIG_IDS="2100366,2100367,2100368,2100369,2008581,2008582"
 44: 
 45: # Categories to monitor (from Suricata classification.config)
 46: DDOS_SURICATA_CATEGORIES="attempted-dos,successful-dos,denial-of-service"
 47: 
 48: # -----------------------------------------------------------------------------
 49: # SCORING THRESHOLDS
 50: # -----------------------------------------------------------------------------
 51: # Score-based decision making (0.0 - 1.0 scale)
 52: 
 53: # Base score per alert severity (Suricata severity 1-4)
 54: DDOS_SURICATA_SCORE_SEVERITY_1="0.10"   # Low
 55: DDOS_SURICATA_SCORE_SEVERITY_2="0.20"   # Medium
 56: DDOS_SURICATA_SCORE_SEVERITY_3="0.35"   # High
 57: DDOS_SURICATA_SCORE_SEVERITY_4="0.50"   # Critical
 58: 
 59: # Bonus score for specific attack types
 60: DDOS_SURICATA_SCORE_SYN_FLOOD="0.15"
 61: DDOS_SURICATA_SCORE_AMPLIFICATION="0.20"
 62: DDOS_SURICATA_SCORE_HTTP_FLOOD="0.15"
 63: 
 64: # Repetition multiplier (alerts from same IP in window)
 65: DDOS_SURICATA_SCORE_REPEAT_5="0.10"     # 5+ alerts
 66: DDOS_SURICATA_SCORE_REPEAT_10="0.20"    # 10+ alerts
 67: DDOS_SURICATA_SCORE_REPEAT_20="0.30"    # 20+ alerts
 68: 
 69: # Feed reputation bonus (if IP is in threat feeds)
 70: DDOS_SURICATA_SCORE_BAD_REPUTATION="0.15"
 71: 
 72: # GeoIP risk bonus (high-risk countries)
 73: DDOS_SURICATA_SCORE_HIGH_RISK_GEO="0.10"
 74: 
 75: # -----------------------------------------------------------------------------
 76: # ACTION THRESHOLDS
 77: # -----------------------------------------------------------------------------
 78: # What to do based on final score
 79: 
 80: # Observe only (log, no block)
 81: DDOS_SURICATA_THRESHOLD_OBSERVE="0.30"
 82: 
 83: # Short block (temporary)
 84: DDOS_SURICATA_THRESHOLD_BLOCK_SHORT="0.50"
 85: 
 86: # Long block (extended)
 87: DDOS_SURICATA_THRESHOLD_BLOCK_LONG="0.70"
 88: 
 89: # Permanent block (until manual review)
 90: DDOS_SURICATA_THRESHOLD_BLOCK_PERMANENT="0.90"
 91: 
 92: # -----------------------------------------------------------------------------
 93: # BLOCKING POLICY
 94: # -----------------------------------------------------------------------------
 95: # Ban durations for each threshold level
 96: 
 97: DDOS_SURICATA_BAN_DURATION_SHORT="600"       # 10 minutes
 98: DDOS_SURICATA_BAN_DURATION_LONG="3600"       # 1 hour
 99: DDOS_SURICATA_BAN_DURATION_PERMANENT="86400" # 24 hours
100: 
101: # Score decay time (seconds) - how long before score resets
102: DDOS_SURICATA_SCORE_DECAY="3600"
103: 
104: # Time window for counting repeated alerts (seconds)
105: DDOS_SURICATA_ALERT_WINDOW="120"
106: 
107: # -----------------------------------------------------------------------------
108: # INTEGRATION WITH OTHER MODULES
109: # -----------------------------------------------------------------------------
110: # Enable correlation with other nftban modules
111: 
112: # Use threat feeds for reputation scoring
113: DDOS_SURICATA_USE_FEEDS="true"
114: 
115: # Use GeoIP for risk scoring
116: DDOS_SURICATA_USE_GEOIP="true"
117: 
118: # Use classic mode as Layer 0 (hard limits before Suricata analysis)
119: DDOS_SURICATA_USE_CLASSIC_LAYER0="true"
120: 
121: # -----------------------------------------------------------------------------
122: # PERFORMANCE TUNING
123: # -----------------------------------------------------------------------------
124: # EVE JSON parsing settings
125: 
126: # Batch size for processing alerts
127: DDOS_SURICATA_BATCH_SIZE="100"
128: 
129: # Poll interval for EVE file (milliseconds)
130: DDOS_SURICATA_POLL_INTERVAL_MS="500"
131: 
132: # Maximum alerts to process per second (rate limiting)
133: DDOS_SURICATA_MAX_ALERTS_PER_SEC="1000"
134: 
135: # -----------------------------------------------------------------------------
136: # LOGGING
137: # -----------------------------------------------------------------------------
138: # Log file for suricata mode events
139: DDOS_SURICATA_LOG_FILE="/var/log/nftban/ddos-suricata.log"
140: 
141: # Log level: DEBUG, INFO, WARN, ERROR
142: DDOS_SURICATA_LOG_LEVEL="INFO"
143: 
144: # Log all alerts (verbose)
145: DDOS_SURICATA_LOG_ALL_ALERTS="false"
146: 
147: # Log scoring decisions
148: DDOS_SURICATA_LOG_SCORES="true"
149: 
150: # =============================================================================
151: # END OF SURICATA MODE CONFIGURATION
152: # =============================================================================
</file>

<file path="etc/nftban/conf.d/login/classic.conf">
  1: # =============================================================================
  2: # NFTBan Login Monitor - CLASSIC MODE Configuration
  3: # =============================================================================
  4: # Configuration for Classic mode (journalctl/log file parsing).
  5: # Used when Suricata is not available or in hybrid mode.
  6: #
  7: # File: /etc/nftban/conf.d/login/classic.conf
  8: # =============================================================================
  9: 
 10: # -----------------------------------------------------------------------------
 11: # LOG SOURCE SELECTION
 12: # -----------------------------------------------------------------------------
 13: # How to read authentication logs
 14: 
 15: # Primary source: "journalctl" (recommended) or "file"
 16: LOGIN_CLASSIC_SOURCE="journalctl"
 17: 
 18: # Use JSON output from journalctl (requires jq)
 19: LOGIN_CLASSIC_JOURNALCTL_JSON="true"
 20: 
 21: # Fallback to file parsing if journalctl fails
 22: LOGIN_CLASSIC_FALLBACK_FILE="true"
 23: 
 24: # -----------------------------------------------------------------------------
 25: # JOURNALCTL SETTINGS
 26: # -----------------------------------------------------------------------------
 27: # Settings for journalctl-based monitoring
 28: 
 29: # Follow mode (real-time monitoring)
 30: LOGIN_CLASSIC_JOURNALCTL_FOLLOW="true"
 31: 
 32: # Include cursor for resuming after restart
 33: LOGIN_CLASSIC_JOURNALCTL_CURSOR="/var/lib/nftban/login-journal-cursor"
 34: 
 35: # Priority filter (0=emerg to 7=debug, empty=all)
 36: LOGIN_CLASSIC_JOURNALCTL_PRIORITY=""
 37: 
 38: # -----------------------------------------------------------------------------
 39: # LOG FILE PATHS
 40: # -----------------------------------------------------------------------------
 41: # Used when LOGIN_CLASSIC_SOURCE="file" or as fallback
 42: 
 43: # Auth log path (varies by distro)
 44: LOGIN_CLASSIC_AUTH_LOG="/var/log/auth.log"
 45: LOGIN_CLASSIC_SECURE_LOG="/var/log/secure"
 46: 
 47: # Mail logs
 48: LOGIN_CLASSIC_MAIL_LOG="/var/log/mail.log"
 49: LOGIN_CLASSIC_MAILLOG="/var/log/maillog"
 50: 
 51: # Web server logs (for WordPress detection)
 52: LOGIN_CLASSIC_APACHE_ERROR="/var/log/apache2/error.log"
 53: LOGIN_CLASSIC_APACHE_ACCESS="/var/log/apache2/access.log"
 54: LOGIN_CLASSIC_HTTPD_ERROR="/var/log/httpd/error_log"
 55: LOGIN_CLASSIC_HTTPD_ACCESS="/var/log/httpd/access_log"
 56: LOGIN_CLASSIC_NGINX_ERROR="/var/log/nginx/error.log"
 57: LOGIN_CLASSIC_NGINX_ACCESS="/var/log/nginx/access.log"
 58: 
 59: # FTP logs
 60: LOGIN_CLASSIC_PUREFTPD_LOG="/var/log/pureftpd.log"
 61: LOGIN_CLASSIC_VSFTPD_LOG="/var/log/vsftpd.log"
 62: 
 63: # Control panel logs
 64: LOGIN_CLASSIC_DIRECTADMIN_LOG="/var/log/directadmin/login.log"
 65: 
 66: # -----------------------------------------------------------------------------
 67: # GLOBAL THRESHOLDS
 68: # -----------------------------------------------------------------------------
 69: # Default thresholds (can be overridden per-service in services.conf)
 70: 
 71: # Failed attempts before action
 72: LOGIN_CLASSIC_FAIL_THRESHOLD="5"
 73: 
 74: # Time window for counting failures (seconds)
 75: LOGIN_CLASSIC_FAIL_WINDOW="300"
 76: 
 77: # Reset failure count after successful login
 78: LOGIN_CLASSIC_RESET_ON_SUCCESS="true"
 79: 
 80: # -----------------------------------------------------------------------------
 81: # PATTERN MATCHING
 82: # -----------------------------------------------------------------------------
 83: # Common auth failure patterns (service-specific in services.conf)
 84: 
 85: # Patterns are extended regex, case-insensitive by default
 86: LOGIN_CLASSIC_CASE_INSENSITIVE="true"
 87: 
 88: # Generic failed authentication patterns
 89: LOGIN_CLASSIC_PATTERN_FAILED="[Ff]ailed|[Aa]uthentication [Ff]ailure|[Ii]nvalid [Pp]assword|[Aa]ccess [Dd]enied"
 90: 
 91: # Generic invalid user patterns
 92: LOGIN_CLASSIC_PATTERN_INVALID_USER="[Ii]nvalid user|[Uu]nknown user|[Nn]o such user"
 93: 
 94: # Connection closed patterns (often indicates password failure)
 95: LOGIN_CLASSIC_PATTERN_DISCONNECT="[Cc]onnection closed|[Dd]isconnected|[Pp]reauth"
 96: 
 97: # Banned/blocked patterns (other security systems)
 98: LOGIN_CLASSIC_PATTERN_BANNED="[Bb]anned|[Bb]locked|[Dd]enied"
 99: 
100: # -----------------------------------------------------------------------------
101: # SCORING ENGINE
102: # -----------------------------------------------------------------------------
103: # Calculate risk score for each event (0.0 - 1.0 scale)
104: 
105: # Base score per failed attempt
106: LOGIN_CLASSIC_SCORE_FAILED="0.10"
107: 
108: # Invalid user attempt (higher risk)
109: LOGIN_CLASSIC_SCORE_INVALID_USER="0.15"
110: 
111: # Root/admin login attempt (critical)
112: LOGIN_CLASSIC_SCORE_ROOT_ATTEMPT="0.25"
113: 
114: # Attempt during off-hours (configurable in services.conf)
115: LOGIN_CLASSIC_SCORE_OFF_HOURS="0.10"
116: 
117: # Multiple services targeted from same IP
118: LOGIN_CLASSIC_SCORE_MULTI_SERVICE="0.15"
119: 
120: # Rapid attempts (faster than normal typing)
121: LOGIN_CLASSIC_SCORE_RAPID="0.10"
122: LOGIN_CLASSIC_RAPID_THRESHOLD_MS="500"
123: 
124: # Repetition bonuses
125: LOGIN_CLASSIC_SCORE_REPEAT_3="0.10"    # 3+ failures
126: LOGIN_CLASSIC_SCORE_REPEAT_5="0.15"    # 5+ failures
127: LOGIN_CLASSIC_SCORE_REPEAT_10="0.25"   # 10+ failures
128: 
129: # Known bad username patterns (honeypot indicators)
130: LOGIN_CLASSIC_SCORE_HONEYPOT_USER="0.20"
131: LOGIN_CLASSIC_HONEYPOT_USERS="admin,root,test,guest,user,administrator,oracle,mysql,postgres"
132: 
133: # -----------------------------------------------------------------------------
134: # ACTION THRESHOLDS
135: # -----------------------------------------------------------------------------
136: # What to do based on final risk score
137: 
138: # Observe only (log, no block)
139: LOGIN_CLASSIC_THRESHOLD_OBSERVE="0.25"
140: 
141: # Short block (temporary)
142: LOGIN_CLASSIC_THRESHOLD_BLOCK_SHORT="0.45"
143: 
144: # Long block (extended)
145: LOGIN_CLASSIC_THRESHOLD_BLOCK_LONG="0.65"
146: 
147: # Permanent block candidate
148: LOGIN_CLASSIC_THRESHOLD_BLOCK_PERMANENT="0.85"
149: 
150: # -----------------------------------------------------------------------------
151: # BAN DURATIONS
152: # -----------------------------------------------------------------------------
153: # Block durations for each threshold level
154: 
155: LOGIN_CLASSIC_BAN_DURATION_SHORT="900"        # 15 minutes
156: LOGIN_CLASSIC_BAN_DURATION_LONG="3600"        # 1 hour
157: LOGIN_CLASSIC_BAN_DURATION_PERMANENT="86400"  # 24 hours
158: 
159: # Score decay time (seconds) - how long before score resets
160: LOGIN_CLASSIC_SCORE_DECAY="1800"
161: 
162: # -----------------------------------------------------------------------------
163: # STATE MANAGEMENT
164: # -----------------------------------------------------------------------------
165: # Tracking login attempts across restarts
166: 
167: # State file for tracking failed attempts
168: LOGIN_CLASSIC_STATE_FILE="/var/lib/nftban/login-classic-state.db"
169: 
170: # Maximum tracked IPs (memory limit)
171: LOGIN_CLASSIC_MAX_TRACKED_IPS="50000"
172: 
173: # State file save interval (seconds)
174: LOGIN_CLASSIC_STATE_SAVE_INTERVAL="60"
175: 
176: # Cleanup old entries interval (seconds)
177: LOGIN_CLASSIC_CLEANUP_INTERVAL="300"
178: 
179: # -----------------------------------------------------------------------------
180: # PERFORMANCE TUNING
181: # -----------------------------------------------------------------------------
182: # Processing settings
183: 
184: # Batch size for processing log entries
185: LOGIN_CLASSIC_BATCH_SIZE="100"
186: 
187: # Poll interval for log files (milliseconds)
188: LOGIN_CLASSIC_POLL_INTERVAL_MS="500"
189: 
190: # Maximum log lines to process per second
191: LOGIN_CLASSIC_MAX_LINES_PER_SEC="1000"
192: 
193: # Journal reader buffer size
194: LOGIN_CLASSIC_JOURNAL_BUFFER="8192"
195: 
196: # -----------------------------------------------------------------------------
197: # SPECIAL HANDLING
198: # -----------------------------------------------------------------------------
199: # Service-specific quirks
200: 
201: # Ignore PAM authentication (some services double-log)
202: LOGIN_CLASSIC_IGNORE_PAM_DUPLICATES="true"
203: 
204: # Aggregate IPv4/IPv6 from same host (dual-stack)
205: LOGIN_CLASSIC_AGGREGATE_DUAL_STACK="true"
206: 
207: # Follow symlinks for log files
208: LOGIN_CLASSIC_FOLLOW_SYMLINKS="true"
209: 
210: # Handle log rotation gracefully
211: LOGIN_CLASSIC_HANDLE_ROTATION="true"
212: 
213: # =============================================================================
214: # END OF CLASSIC MODE CONFIGURATION
215: # =============================================================================
</file>

<file path="etc/nftban/conf.d/login/main.conf">
  1: # =============================================================================
  2: # NFTBan Login Monitor - MAIN Configuration
  3: # =============================================================================
  4: # Master configuration for login/authentication monitoring module.
  5: # Replaces fail2ban with native nftban integration.
  6: #
  7: # File: /etc/nftban/conf.d/login/main.conf
  8: # =============================================================================
  9: 
 10: # -----------------------------------------------------------------------------
 11: # MODULE ENABLE/DISABLE
 12: # -----------------------------------------------------------------------------
 13: # Master switch for login monitoring
 14: LOGIN_ENABLED="true"
 15: 
 16: # -----------------------------------------------------------------------------
 17: # MODE SELECTION
 18: # -----------------------------------------------------------------------------
 19: # Choose login monitoring mode:
 20: #
 21: #   auto     - Auto-detect: use Suricata if available, otherwise Classic
 22: #   classic  - Force Classic mode (journalctl/log parsing)
 23: #   suricata - Force Suricata mode (EVE JSON auth failure alerts)
 24: #   hybrid   - Use both: Classic parsing + Suricata correlation
 25: #
 26: LOGIN_MODE="auto"
 27: 
 28: # -----------------------------------------------------------------------------
 29: # AUTO-DETECTION SETTINGS
 30: # -----------------------------------------------------------------------------
 31: # How to detect if Suricata is available for auth failure correlation
 32: 
 33: # Check if Suricata service is running
 34: LOGIN_AUTO_CHECK_SERVICE="true"
 35: 
 36: # Check if Suricata binary exists
 37: LOGIN_AUTO_CHECK_BINARY="true"
 38: 
 39: # Check if EVE JSON file exists and is being written to
 40: LOGIN_AUTO_CHECK_EVE_FILE="true"
 41: 
 42: # Suricata service name (for systemctl check)
 43: LOGIN_SURICATA_SERVICE_NAME="suricata"
 44: 
 45: # Suricata binary path (for existence check)
 46: LOGIN_SURICATA_BINARY="/usr/bin/suricata"
 47: 
 48: # EVE file freshness threshold (seconds)
 49: LOGIN_EVE_FRESHNESS_THRESHOLD="60"
 50: 
 51: # -----------------------------------------------------------------------------
 52: # HYBRID MODE SETTINGS
 53: # -----------------------------------------------------------------------------
 54: # When LOGIN_MODE="hybrid", both Classic and Suricata run together
 55: 
 56: # Classic mode provides: journalctl monitoring for immediate response
 57: # Suricata mode provides: network-level auth failure detection + correlation
 58: 
 59: # In hybrid mode, Classic handles log-based detection
 60: LOGIN_HYBRID_CLASSIC_DETECT="true"
 61: 
 62: # In hybrid mode, Suricata adds correlation and network-level detection
 63: LOGIN_HYBRID_SURICATA_CORRELATE="true"
 64: 
 65: # Cross-reference: if Suricata sees auth failure + Classic sees same IP = higher risk
 66: LOGIN_HYBRID_CROSS_REFERENCE="true"
 67: 
 68: # -----------------------------------------------------------------------------
 69: # SERVICE AUTO-DETECTION
 70: # -----------------------------------------------------------------------------
 71: # Automatically detect which services are installed and enable monitoring
 72: 
 73: # Auto-detect installed services
 74: LOGIN_AUTO_DETECT_SERVICES="true"
 75: 
 76: # Services to check for (will only monitor if detected)
 77: # Each service has detailed config in services.conf
 78: LOGIN_SERVICES_TO_CHECK="ssh,dovecot,exim,postfix,roundcube,wordpress,xmlrpc,directadmin,pure-ftpd"
 79: 
 80: # -----------------------------------------------------------------------------
 81: # GLOBAL ACTION SETTINGS
 82: # -----------------------------------------------------------------------------
 83: # What to do when login failures are detected
 84: 
 85: # Action mode: "alert" (notify only), "ban" (auto-block), "both"
 86: LOGIN_ACTION_MODE="both"
 87: 
 88: # Use nftban command for blocking (uses NFTBAN_BIN from /etc/nftban/nftban.conf)
 89: # This can be overridden but defaults to the centralized path
 90: LOGIN_BAN_COMMAND="${NFTBAN_BIN:-/usr/bin/nftban} ban"
 91: 
 92: # Default ban duration for auto-ban (seconds)
 93: LOGIN_DEFAULT_BAN_DURATION="3600"
 94: 
 95: # Ban reason prefix
 96: LOGIN_BAN_REASON_PREFIX="login-monitor"
 97: 
 98: # -----------------------------------------------------------------------------
 99: # PERSISTENT OFFENDER ESCALATION
100: # -----------------------------------------------------------------------------
101: # Track repeat offenders and escalate ban duration
102: 
103: # Enable persistent offender tracking
104: LOGIN_PERSISTENT_OFFENDER_ENABLED="true"
105: 
106: # State file for tracking repeat offenders
107: LOGIN_PERSISTENT_STATE_FILE="/var/lib/nftban/login-persistent-offenders.db"
108: 
109: # Escalation levels (ban_count:duration_seconds)
110: # After X bans within the tracking period, apply new duration
111: LOGIN_ESCALATION_LEVEL_1="3:7200"      # 3 bans -> 2 hours
112: LOGIN_ESCALATION_LEVEL_2="5:14400"     # 5 bans -> 4 hours
113: LOGIN_ESCALATION_LEVEL_3="8:43200"     # 8 bans -> 12 hours
114: LOGIN_ESCALATION_LEVEL_4="12:86400"    # 12 bans -> 24 hours (permanent candidate)
115: 
116: # After this many bans, add to permanent blacklist
117: LOGIN_PERMANENT_BAN_THRESHOLD="15"
118: 
119: # Tracking period for counting bans (seconds)
120: LOGIN_PERSISTENT_TRACKING_PERIOD="86400"
121: 
122: # -----------------------------------------------------------------------------
123: # WHITELIST
124: # -----------------------------------------------------------------------------
125: # IPs/networks that should NEVER be blocked for failed logins
126: 
127: # Whitelist file path
128: LOGIN_WHITELIST_FILE="/etc/nftban/whitelist.d/login-whitelist.conf"
129: 
130: # Auto-whitelist localhost
131: LOGIN_WHITELIST_LOCALHOST="true"
132: 
133: # Auto-whitelist private networks (RFC1918)
134: LOGIN_WHITELIST_PRIVATE="true"
135: 
136: # Auto-whitelist server's own IPs
137: LOGIN_WHITELIST_SELF="true"
138: 
139: # -----------------------------------------------------------------------------
140: # GEOIP ENRICHMENT
141: # -----------------------------------------------------------------------------
142: # Add geographic context to login events
143: 
144: # Enable GeoIP lookups
145: LOGIN_GEOIP_ENABLED="true"
146: 
147: # GeoIP database path
148: LOGIN_GEOIP_DATABASE="/usr/share/GeoIP/GeoLite2-Country.mmdb"
149: 
150: # High-risk countries (2-letter ISO codes, comma-separated)
151: # Connections from these countries get higher risk score
152: LOGIN_HIGH_RISK_COUNTRIES="CN,RU,KP,IR"
153: 
154: # GeoIP risk score bonus for high-risk countries
155: LOGIN_GEOIP_RISK_BONUS="0.15"
156: 
157: # -----------------------------------------------------------------------------
158: # GLOBAL LIMITS (Safety Net)
159: # -----------------------------------------------------------------------------
160: # Maximum IPs to block (prevent runaway blocking)
161: LOGIN_MAX_BLOCKED_IPS="10000"
162: 
163: # Maximum block duration (seconds) - safety cap
164: LOGIN_MAX_BAN_DURATION="604800"
165: 
166: # Minimum time between blocks of same IP (seconds)
167: LOGIN_MIN_REBLOCK_INTERVAL="60"
168: 
169: # Maximum events to process per second (rate limiting)
170: LOGIN_MAX_EVENTS_PER_SEC="100"
171: 
172: # -----------------------------------------------------------------------------
173: # NOTIFICATIONS
174: # -----------------------------------------------------------------------------
175: # Alert on significant events
176: 
177: # Enable email notifications
178: LOGIN_NOTIFY_EMAIL="false"
179: LOGIN_NOTIFY_EMAIL_TO=""
180: 
181: # Email format: "html" or "text"
182: LOGIN_NOTIFY_EMAIL_FORMAT="html"
183: 
184: # Enable webhook notifications
185: LOGIN_NOTIFY_WEBHOOK="false"
186: LOGIN_NOTIFY_WEBHOOK_URL=""
187: 
188: # Notify on every ban (can be noisy)
189: LOGIN_NOTIFY_ON_BAN="true"
190: 
191: # Notify only on high-risk events (score >= threshold)
192: LOGIN_NOTIFY_THRESHOLD="0.60"
193: 
194: # Aggregate notifications (send summary instead of individual)
195: LOGIN_NOTIFY_AGGREGATE="false"
196: LOGIN_NOTIFY_AGGREGATE_INTERVAL="300"
197: 
198: # -----------------------------------------------------------------------------
199: # LOGGING
200: # -----------------------------------------------------------------------------
201: # Module logging settings
202: 
203: # Log file for login monitor events
204: LOGIN_LOG_FILE="/var/log/nftban/login-monitor.log"
205: 
206: # Log level: DEBUG, INFO, WARN, ERROR
207: LOGIN_LOG_LEVEL="INFO"
208: 
209: # Log all auth events (verbose, useful for debugging)
210: LOGIN_LOG_ALL_EVENTS="false"
211: 
212: # Log scoring decisions
213: LOGIN_LOG_SCORES="true"
214: 
215: # Log successful logins (for correlation)
216: LOGIN_LOG_SUCCESSFUL="false"
217: 
218: # =============================================================================
219: # END OF MAIN CONFIGURATION
220: # =============================================================================
</file>

<file path="etc/nftban/conf.d/login/services.conf">
  1: # =============================================================================
  2: # NFTBan Login Monitor - SERVICES Configuration
  3: # =============================================================================
  4: # Per-service configuration for login/authentication monitoring.
  5: # Each service can be individually enabled/disabled and tuned.
  6: # Services are only active if detected on the system when LOGIN_AUTO_DETECT_SERVICES="true"
  7: #
  8: # File: /etc/nftban/conf.d/login/services.conf
  9: # =============================================================================
 10: 
 11: # -----------------------------------------------------------------------------
 12: # SSH (Secure Shell)
 13: # -----------------------------------------------------------------------------
 14: # Monitors: sshd login failures
 15: # Source: journalctl -u sshd / journalctl -u ssh
 16: # Replaces: fail2ban [nftban-sshd] jail
 17: 
 18: LOGIN_SERVICE_SSH_ENABLED="true"
 19: 
 20: # Journalctl unit names (varies by distro)
 21: LOGIN_SERVICE_SSH_UNITS="sshd,ssh"
 22: 
 23: # Detection patterns (extended regex)
 24: LOGIN_SERVICE_SSH_PATTERN_FAILED="Failed password|authentication failure|Invalid user.*from"
 25: LOGIN_SERVICE_SSH_PATTERN_PREAUTH="Disconnected from.*preauth|Connection closed.*preauth"
 26: LOGIN_SERVICE_SSH_PATTERN_INVALID="Invalid user|User .* not allowed"
 27: LOGIN_SERVICE_SSH_PATTERN_ROOT="Failed password for root|Invalid user root"
 28: 
 29: # Thresholds (override global)
 30: LOGIN_SERVICE_SSH_FAIL_THRESHOLD="5"
 31: LOGIN_SERVICE_SSH_FAIL_WINDOW="300"
 32: 
 33: # Ban durations
 34: LOGIN_SERVICE_SSH_BAN_SHORT="900"
 35: LOGIN_SERVICE_SSH_BAN_LONG="3600"
 36: 
 37: # Persistent offender: X bans in period -> permanent
 38: LOGIN_SERVICE_SSH_PERM_THRESHOLD="12"
 39: LOGIN_SERVICE_SSH_PERM_PERIOD="86400"
 40: 
 41: # Risk score multiplier (1.0 = normal, higher = more critical)
 42: LOGIN_SERVICE_SSH_RISK_MULTIPLIER="1.2"
 43: 
 44: # Special: root login attempts get extra penalty
 45: LOGIN_SERVICE_SSH_ROOT_PENALTY="0.25"
 46: 
 47: # -----------------------------------------------------------------------------
 48: # DOVECOT (IMAP/POP3 Mail Server)
 49: # -----------------------------------------------------------------------------
 50: # Monitors: dovecot auth failures
 51: # Source: journalctl -u dovecot / /var/log/mail.log
 52: # Replaces: fail2ban [nftban-dovecot] jail
 53: 
 54: LOGIN_SERVICE_DOVECOT_ENABLED="true"
 55: 
 56: # Journalctl unit names
 57: LOGIN_SERVICE_DOVECOT_UNITS="dovecot"
 58: 
 59: # Detection patterns
 60: LOGIN_SERVICE_DOVECOT_PATTERN_FAILED="auth failed|authentication failure|password mismatch"
 61: LOGIN_SERVICE_DOVECOT_PATTERN_UNKNOWN="unknown user|user not found"
 62: LOGIN_SERVICE_DOVECOT_PATTERN_DISCONNECT="Disconnected.*no auth|Connection closed.*AUTHENTICATE"
 63: 
 64: # Thresholds
 65: LOGIN_SERVICE_DOVECOT_FAIL_THRESHOLD="5"
 66: LOGIN_SERVICE_DOVECOT_FAIL_WINDOW="300"
 67: 
 68: # Ban durations
 69: LOGIN_SERVICE_DOVECOT_BAN_SHORT="900"
 70: LOGIN_SERVICE_DOVECOT_BAN_LONG="3600"
 71: 
 72: # Persistent offender
 73: LOGIN_SERVICE_DOVECOT_PERM_THRESHOLD="15"
 74: LOGIN_SERVICE_DOVECOT_PERM_PERIOD="86400"
 75: 
 76: # Risk multiplier
 77: LOGIN_SERVICE_DOVECOT_RISK_MULTIPLIER="1.0"
 78: 
 79: # -----------------------------------------------------------------------------
 80: # EXIM (Mail Transfer Agent)
 81: # -----------------------------------------------------------------------------
 82: # Monitors: exim SMTP auth failures
 83: # Source: journalctl -u exim / /var/log/exim/mainlog
 84: # Replaces: fail2ban [nftban-exim] jail
 85: 
 86: LOGIN_SERVICE_EXIM_ENABLED="true"
 87: 
 88: # Journalctl unit names
 89: LOGIN_SERVICE_EXIM_UNITS="exim,exim4"
 90: 
 91: # Detection patterns
 92: LOGIN_SERVICE_EXIM_PATTERN_FAILED="authenticator failed|AUTH.*failed|login failed"
 93: LOGIN_SERVICE_EXIM_PATTERN_SPAM="rejected MAIL|refused relay"
 94: LOGIN_SERVICE_EXIM_PATTERN_UNKNOWN="unknown user"
 95: 
 96: # Thresholds
 97: LOGIN_SERVICE_EXIM_FAIL_THRESHOLD="5"
 98: LOGIN_SERVICE_EXIM_FAIL_WINDOW="300"
 99: 
100: # Spam attempts (stricter)
101: LOGIN_SERVICE_EXIM_SPAM_THRESHOLD="3"
102: LOGIN_SERVICE_EXIM_SPAM_WINDOW="300"
103: 
104: # Ban durations
105: LOGIN_SERVICE_EXIM_BAN_SHORT="900"
106: LOGIN_SERVICE_EXIM_BAN_LONG="7200"
107: 
108: # Persistent offender (stricter for mail abuse)
109: LOGIN_SERVICE_EXIM_PERM_THRESHOLD="8"
110: LOGIN_SERVICE_EXIM_PERM_PERIOD="43200"
111: 
112: # Spam offender (very strict)
113: LOGIN_SERVICE_EXIM_SPAM_PERM_THRESHOLD="5"
114: LOGIN_SERVICE_EXIM_SPAM_PERM_PERIOD="21600"
115: 
116: # Risk multiplier
117: LOGIN_SERVICE_EXIM_RISK_MULTIPLIER="1.1"
118: 
119: # -----------------------------------------------------------------------------
120: # POSTFIX (Mail Transfer Agent)
121: # -----------------------------------------------------------------------------
122: # Monitors: postfix SMTP auth failures
123: # Source: journalctl -u postfix / /var/log/mail.log
124: # Replaces: fail2ban [nftban-postfix] jail
125: 
126: LOGIN_SERVICE_POSTFIX_ENABLED="true"
127: 
128: # Journalctl unit names
129: LOGIN_SERVICE_POSTFIX_UNITS="postfix,postfix@-"
130: 
131: # Detection patterns
132: LOGIN_SERVICE_POSTFIX_PATTERN_FAILED="SASL.*authentication failed|warning.*authentication failure"
133: LOGIN_SERVICE_POSTFIX_PATTERN_UNKNOWN="unknown user|user unknown"
134: LOGIN_SERVICE_POSTFIX_PATTERN_SPAM="reject.*relay|blocked using"
135: 
136: # Thresholds
137: LOGIN_SERVICE_POSTFIX_FAIL_THRESHOLD="5"
138: LOGIN_SERVICE_POSTFIX_FAIL_WINDOW="300"
139: 
140: # Ban durations
141: LOGIN_SERVICE_POSTFIX_BAN_SHORT="900"
142: LOGIN_SERVICE_POSTFIX_BAN_LONG="3600"
143: 
144: # Persistent offender
145: LOGIN_SERVICE_POSTFIX_PERM_THRESHOLD="10"
146: LOGIN_SERVICE_POSTFIX_PERM_PERIOD="86400"
147: 
148: # Risk multiplier
149: LOGIN_SERVICE_POSTFIX_RISK_MULTIPLIER="1.0"
150: 
151: # -----------------------------------------------------------------------------
152: # ROUNDCUBE (Webmail)
153: # -----------------------------------------------------------------------------
154: # Monitors: roundcube login failures
155: # Source: journalctl -u php-fpm / /var/log/roundcube/errors
156: # Replaces: fail2ban [nftban-roundcube] jail
157: 
158: LOGIN_SERVICE_ROUNDCUBE_ENABLED="true"
159: 
160: # Log file path (journalctl doesn't capture well)
161: LOGIN_SERVICE_ROUNDCUBE_LOG="/var/log/roundcubemail/errors.log"
162: LOGIN_SERVICE_ROUNDCUBE_LOG_ALT="/var/log/roundcube/errors"
163: 
164: # Detection patterns
165: LOGIN_SERVICE_ROUNDCUBE_PATTERN_FAILED="Login failed|IMAP error.*login|Authentication failed"
166: 
167: # Thresholds (webmail gets many automated attacks)
168: LOGIN_SERVICE_ROUNDCUBE_FAIL_THRESHOLD="5"
169: LOGIN_SERVICE_ROUNDCUBE_FAIL_WINDOW="600"
170: 
171: # Ban durations
172: LOGIN_SERVICE_ROUNDCUBE_BAN_SHORT="1800"
173: LOGIN_SERVICE_ROUNDCUBE_BAN_LONG="3600"
174: 
175: # Persistent offender
176: LOGIN_SERVICE_ROUNDCUBE_PERM_THRESHOLD="20"
177: LOGIN_SERVICE_ROUNDCUBE_PERM_PERIOD="172800"
178: 
179: # Risk multiplier
180: LOGIN_SERVICE_ROUNDCUBE_RISK_MULTIPLIER="0.9"
181: 
182: # -----------------------------------------------------------------------------
183: # WORDPRESS (wp-login.php)
184: # -----------------------------------------------------------------------------
185: # Monitors: WordPress login failures
186: # Source: Apache/Nginx access logs
187: # Replaces: fail2ban [nftban-apache-wp-login] jail
188: 
189: LOGIN_SERVICE_WORDPRESS_ENABLED="true"
190: 
191: # Log source (Apache or Nginx access logs)
192: LOGIN_SERVICE_WORDPRESS_LOG_APACHE="/var/log/apache2/access.log"
193: LOGIN_SERVICE_WORDPRESS_LOG_HTTPD="/var/log/httpd/access_log"
194: LOGIN_SERVICE_WORDPRESS_LOG_NGINX="/var/log/nginx/access.log"
195: 
196: # Detection patterns (POST to wp-login.php)
197: LOGIN_SERVICE_WORDPRESS_PATTERN_LOGIN="POST.*/wp-login\\.php"
198: LOGIN_SERVICE_WORDPRESS_PATTERN_FAILED="wp-login\\.php.*200|wp-login\\.php.*302"
199: 
200: # Thresholds (WordPress brute force is common)
201: LOGIN_SERVICE_WORDPRESS_FAIL_THRESHOLD="10"
202: LOGIN_SERVICE_WORDPRESS_FAIL_WINDOW="600"
203: 
204: # Ban durations
205: LOGIN_SERVICE_WORDPRESS_BAN_SHORT="900"
206: LOGIN_SERVICE_WORDPRESS_BAN_LONG="3600"
207: 
208: # Persistent offender
209: LOGIN_SERVICE_WORDPRESS_PERM_THRESHOLD="20"
210: LOGIN_SERVICE_WORDPRESS_PERM_PERIOD="172800"
211: 
212: # Risk multiplier (lower - high false positive rate)
213: LOGIN_SERVICE_WORDPRESS_RISK_MULTIPLIER="0.8"
214: 
215: # -----------------------------------------------------------------------------
216: # XML-RPC (WordPress API)
217: # -----------------------------------------------------------------------------
218: # Monitors: xmlrpc.php abuse (common brute force vector)
219: # Source: Apache/Nginx access logs
220: # Replaces: fail2ban [nftban-apache-xmlrpc] jail
221: 
222: LOGIN_SERVICE_XMLRPC_ENABLED="true"
223: 
224: # Uses same logs as WordPress
225: LOGIN_SERVICE_XMLRPC_LOG_APACHE="/var/log/apache2/access.log"
226: LOGIN_SERVICE_XMLRPC_LOG_HTTPD="/var/log/httpd/access_log"
227: LOGIN_SERVICE_XMLRPC_LOG_NGINX="/var/log/nginx/access.log"
228: 
229: # Detection patterns (POST to xmlrpc.php)
230: LOGIN_SERVICE_XMLRPC_PATTERN_POST="POST.*/xmlrpc\\.php"
231: LOGIN_SERVICE_XMLRPC_PATTERN_MULTICALL="system\\.multicall"
232: 
233: # Thresholds (xmlrpc is heavily abused - stricter)
234: LOGIN_SERVICE_XMLRPC_FAIL_THRESHOLD="5"
235: LOGIN_SERVICE_XMLRPC_FAIL_WINDOW="300"
236: 
237: # Ban durations
238: LOGIN_SERVICE_XMLRPC_BAN_SHORT="1800"
239: LOGIN_SERVICE_XMLRPC_BAN_LONG="7200"
240: 
241: # Persistent offender (strict - often automated)
242: LOGIN_SERVICE_XMLRPC_PERM_THRESHOLD="10"
243: LOGIN_SERVICE_XMLRPC_PERM_PERIOD="43200"
244: 
245: # Risk multiplier (higher - rarely legitimate)
246: LOGIN_SERVICE_XMLRPC_RISK_MULTIPLIER="1.3"
247: 
248: # -----------------------------------------------------------------------------
249: # DIRECTADMIN (Control Panel)
250: # -----------------------------------------------------------------------------
251: # Monitors: DirectAdmin login failures
252: # Source: /var/log/directadmin/login.log
253: # Replaces: fail2ban [nftban-directadmin] jail
254: 
255: LOGIN_SERVICE_DIRECTADMIN_ENABLED="true"
256: 
257: # Log file path
258: LOGIN_SERVICE_DIRECTADMIN_LOG="/var/log/directadmin/login.log"
259: LOGIN_SERVICE_DIRECTADMIN_ERROR="/var/log/directadmin/errortaskq.log"
260: 
261: # Detection patterns
262: LOGIN_SERVICE_DIRECTADMIN_PATTERN_FAILED="FAILED LOGIN|login failure"
263: LOGIN_SERVICE_DIRECTADMIN_PATTERN_BRUTEFORCE="IP .* has been blocked"
264: 
265: # Thresholds
266: LOGIN_SERVICE_DIRECTADMIN_FAIL_THRESHOLD="5"
267: LOGIN_SERVICE_DIRECTADMIN_FAIL_WINDOW="300"
268: 
269: # Ban durations
270: LOGIN_SERVICE_DIRECTADMIN_BAN_SHORT="900"
271: LOGIN_SERVICE_DIRECTADMIN_BAN_LONG="3600"
272: 
273: # Persistent offender
274: LOGIN_SERVICE_DIRECTADMIN_PERM_THRESHOLD="10"
275: LOGIN_SERVICE_DIRECTADMIN_PERM_PERIOD="86400"
276: 
277: # Risk multiplier (control panel = high value target)
278: LOGIN_SERVICE_DIRECTADMIN_RISK_MULTIPLIER="1.5"
279: 
280: # -----------------------------------------------------------------------------
281: # PURE-FTPD (FTP Server)
282: # -----------------------------------------------------------------------------
283: # Monitors: Pure-FTPd auth failures
284: # Source: journalctl -u pure-ftpd / /var/log/pureftpd.log
285: # Replaces: fail2ban [nftban-pure-ftpd] jail
286: 
287: LOGIN_SERVICE_PUREFTPD_ENABLED="true"
288: 
289: # Journalctl unit names
290: LOGIN_SERVICE_PUREFTPD_UNITS="pure-ftpd"
291: 
292: # Log file path (fallback)
293: LOGIN_SERVICE_PUREFTPD_LOG="/var/log/pureftpd.log"
294: 
295: # Detection patterns
296: LOGIN_SERVICE_PUREFTPD_PATTERN_FAILED="Authentication failed|Login failed"
297: LOGIN_SERVICE_PUREFTPD_PATTERN_UNKNOWN="unknown user|user not found"
298: 
299: # Thresholds
300: LOGIN_SERVICE_PUREFTPD_FAIL_THRESHOLD="5"
301: LOGIN_SERVICE_PUREFTPD_FAIL_WINDOW="300"
302: 
303: # Ban durations
304: LOGIN_SERVICE_PUREFTPD_BAN_SHORT="900"
305: LOGIN_SERVICE_PUREFTPD_BAN_LONG="3600"
306: 
307: # Persistent offender
308: LOGIN_SERVICE_PUREFTPD_PERM_THRESHOLD="12"
309: LOGIN_SERVICE_PUREFTPD_PERM_PERIOD="86400"
310: 
311: # Risk multiplier
312: LOGIN_SERVICE_PUREFTPD_RISK_MULTIPLIER="1.0"
313: 
314: # -----------------------------------------------------------------------------
315: # VSFTPD (FTP Server)
316: # -----------------------------------------------------------------------------
317: # Monitors: vsftpd auth failures
318: # Source: journalctl -u vsftpd / /var/log/vsftpd.log
319: 
320: LOGIN_SERVICE_VSFTPD_ENABLED="true"
321: 
322: # Journalctl unit names
323: LOGIN_SERVICE_VSFTPD_UNITS="vsftpd"
324: 
325: # Log file path (fallback)
326: LOGIN_SERVICE_VSFTPD_LOG="/var/log/vsftpd.log"
327: 
328: # Detection patterns
329: LOGIN_SERVICE_VSFTPD_PATTERN_FAILED="FAIL LOGIN|authentication failure"
330: 
331: # Thresholds
332: LOGIN_SERVICE_VSFTPD_FAIL_THRESHOLD="5"
333: LOGIN_SERVICE_VSFTPD_FAIL_WINDOW="300"
334: 
335: # Ban durations
336: LOGIN_SERVICE_VSFTPD_BAN_SHORT="900"
337: LOGIN_SERVICE_VSFTPD_BAN_LONG="3600"
338: 
339: # Persistent offender
340: LOGIN_SERVICE_VSFTPD_PERM_THRESHOLD="12"
341: LOGIN_SERVICE_VSFTPD_PERM_PERIOD="86400"
342: 
343: # Risk multiplier
344: LOGIN_SERVICE_VSFTPD_RISK_MULTIPLIER="1.0"
345: 
346: # -----------------------------------------------------------------------------
347: # PROFTPD (FTP Server)
348: # -----------------------------------------------------------------------------
349: # Monitors: ProFTPD auth failures
350: # Source: journalctl -u proftpd / /var/log/proftpd/proftpd.log
351: 
352: LOGIN_SERVICE_PROFTPD_ENABLED="true"
353: 
354: # Journalctl unit names
355: LOGIN_SERVICE_PROFTPD_UNITS="proftpd"
356: 
357: # Log file path (fallback)
358: LOGIN_SERVICE_PROFTPD_LOG="/var/log/proftpd/proftpd.log"
359: 
360: # Detection patterns
361: LOGIN_SERVICE_PROFTPD_PATTERN_FAILED="USER.*no such user|Login failed"
362: 
363: # Thresholds
364: LOGIN_SERVICE_PROFTPD_FAIL_THRESHOLD="5"
365: LOGIN_SERVICE_PROFTPD_FAIL_WINDOW="300"
366: 
367: # Ban durations
368: LOGIN_SERVICE_PROFTPD_BAN_SHORT="900"
369: LOGIN_SERVICE_PROFTPD_BAN_LONG="3600"
370: 
371: # Persistent offender
372: LOGIN_SERVICE_PROFTPD_PERM_THRESHOLD="12"
373: LOGIN_SERVICE_PROFTPD_PERM_PERIOD="86400"
374: 
375: # Risk multiplier
376: LOGIN_SERVICE_PROFTPD_RISK_MULTIPLIER="1.0"
377: 
378: # -----------------------------------------------------------------------------
379: # APACHE (HTTP Auth)
380: # -----------------------------------------------------------------------------
381: # Monitors: HTTP Basic/Digest auth failures
382: # Source: Apache error logs
383: 
384: LOGIN_SERVICE_APACHE_AUTH_ENABLED="true"
385: 
386: # Log file paths
387: LOGIN_SERVICE_APACHE_ERROR="/var/log/apache2/error.log"
388: LOGIN_SERVICE_APACHE_ERROR_ALT="/var/log/httpd/error_log"
389: 
390: # Detection patterns
391: LOGIN_SERVICE_APACHE_PATTERN_FAILED="user .* authentication failure|client denied by server"
392: LOGIN_SERVICE_APACHE_PATTERN_NOUSER="user .* not found"
393: 
394: # Thresholds
395: LOGIN_SERVICE_APACHE_FAIL_THRESHOLD="5"
396: LOGIN_SERVICE_APACHE_FAIL_WINDOW="300"
397: 
398: # Ban durations
399: LOGIN_SERVICE_APACHE_BAN_SHORT="900"
400: LOGIN_SERVICE_APACHE_BAN_LONG="3600"
401: 
402: # Persistent offender
403: LOGIN_SERVICE_APACHE_PERM_THRESHOLD="15"
404: LOGIN_SERVICE_APACHE_PERM_PERIOD="86400"
405: 
406: # Risk multiplier
407: LOGIN_SERVICE_APACHE_RISK_MULTIPLIER="1.0"
408: 
409: # -----------------------------------------------------------------------------
410: # NGINX (HTTP Auth)
411: # -----------------------------------------------------------------------------
412: # Monitors: HTTP Basic auth failures
413: # Source: Nginx error logs
414: 
415: LOGIN_SERVICE_NGINX_AUTH_ENABLED="true"
416: 
417: # Log file paths
418: LOGIN_SERVICE_NGINX_ERROR="/var/log/nginx/error.log"
419: 
420: # Detection patterns
421: LOGIN_SERVICE_NGINX_PATTERN_FAILED="user .* was not found|no user/password was provided"
422: 
423: # Thresholds
424: LOGIN_SERVICE_NGINX_FAIL_THRESHOLD="5"
425: LOGIN_SERVICE_NGINX_FAIL_WINDOW="300"
426: 
427: # Ban durations
428: LOGIN_SERVICE_NGINX_BAN_SHORT="900"
429: LOGIN_SERVICE_NGINX_BAN_LONG="3600"
430: 
431: # Persistent offender
432: LOGIN_SERVICE_NGINX_PERM_THRESHOLD="15"
433: LOGIN_SERVICE_NGINX_PERM_PERIOD="86400"
434: 
435: # Risk multiplier
436: LOGIN_SERVICE_NGINX_RISK_MULTIPLIER="1.0"
437: 
438: # -----------------------------------------------------------------------------
439: # MODSECURITY (Web Application Firewall)
440: # -----------------------------------------------------------------------------
441: # Monitors: ModSecurity rule triggers (auth bypass attempts)
442: # Source: ModSecurity audit log
443: 
444: LOGIN_SERVICE_MODSECURITY_ENABLED="true"
445: 
446: # Log file paths
447: LOGIN_SERVICE_MODSECURITY_LOG="/var/log/modsec_audit.log"
448: LOGIN_SERVICE_MODSECURITY_LOG_ALT="/var/log/apache2/modsec_audit.log"
449: 
450: # Detection patterns (SQL injection, auth bypass attempts)
451: LOGIN_SERVICE_MODSECURITY_PATTERN_SQLI="SQL Injection|Access denied with code 403"
452: LOGIN_SERVICE_MODSECURITY_PATTERN_AUTH="Authentication|Login|Password"
453: 
454: # Thresholds (ModSecurity already filtered - lower threshold)
455: LOGIN_SERVICE_MODSECURITY_FAIL_THRESHOLD="3"
456: LOGIN_SERVICE_MODSECURITY_FAIL_WINDOW="300"
457: 
458: # Ban durations
459: LOGIN_SERVICE_MODSECURITY_BAN_SHORT="1800"
460: LOGIN_SERVICE_MODSECURITY_BAN_LONG="7200"
461: 
462: # Persistent offender (WAF triggers = serious)
463: LOGIN_SERVICE_MODSECURITY_PERM_THRESHOLD="5"
464: LOGIN_SERVICE_MODSECURITY_PERM_PERIOD="43200"
465: 
466: # Risk multiplier (WAF = pre-filtered, high confidence)
467: LOGIN_SERVICE_MODSECURITY_RISK_MULTIPLIER="1.5"
468: 
469: # =============================================================================
470: # END OF SERVICES CONFIGURATION
471: # =============================================================================
</file>

<file path="etc/nftban/conf.d/login/suricata.conf">
  1: # =============================================================================
  2: # NFTBan Login Monitor - SURICATA MODE Configuration
  3: # =============================================================================
  4: # Configuration for Suricata mode (EVE JSON auth failure alerts).
  5: # Uses Suricata's built-in authentication failure detection via rules.
  6: #
  7: # File: /etc/nftban/conf.d/login/suricata.conf
  8: # =============================================================================
  9: 
 10: # -----------------------------------------------------------------------------
 11: # SURICATA MODE SETTINGS
 12: # -----------------------------------------------------------------------------
 13: # EVE JSON parsing for authentication events
 14: 
 15: # EVE JSON Log Path (Suricata alert output)
 16: LOGIN_SURICATA_EVE_FILE="/var/log/suricata/eve.json"
 17: 
 18: # Alternative: Unix socket for real-time alerts (faster, optional)
 19: LOGIN_SURICATA_EVE_SOCKET=""
 20: 
 21: # -----------------------------------------------------------------------------
 22: # AUTHENTICATION EVENT DETECTION
 23: # -----------------------------------------------------------------------------
 24: # Suricata rules can detect various auth failures at network level
 25: 
 26: # Enable SSH auth failure detection
 27: LOGIN_SURICATA_DETECT_SSH="true"
 28: 
 29: # Enable FTP auth failure detection
 30: LOGIN_SURICATA_DETECT_FTP="true"
 31: 
 32: # Enable SMTP auth failure detection
 33: LOGIN_SURICATA_DETECT_SMTP="true"
 34: 
 35: # Enable POP3/IMAP auth failure detection
 36: LOGIN_SURICATA_DETECT_MAIL="true"
 37: 
 38: # Enable HTTP auth failure detection (401 responses)
 39: LOGIN_SURICATA_DETECT_HTTP="true"
 40: 
 41: # Enable generic protocol anomalies (potential auth attacks)
 42: LOGIN_SURICATA_DETECT_ANOMALIES="true"
 43: 
 44: # -----------------------------------------------------------------------------
 45: # ALERT FILTERING
 46: # -----------------------------------------------------------------------------
 47: # Filter Suricata alerts for auth-related events
 48: 
 49: # Signature patterns to match (regex, pipe-separated)
 50: LOGIN_SURICATA_SIG_PATTERNS="[Aa]uth|[Ll]ogin|[Pp]assword|[Cc]redential|[Bb]rute|SSH|FTP|SMTP|POP3|IMAP"
 51: 
 52: # Event types to monitor (from EVE JSON)
 53: LOGIN_SURICATA_EVENT_TYPES="alert,ssh,anomaly"
 54: 
 55: # Alert categories to monitor
 56: LOGIN_SURICATA_CATEGORIES="attempted-admin,unsuccessful-user,default-login-attempt"
 57: 
 58: # Signature IDs for auth failures (Suricata ET rules)
 59: # SSH brute force: 2001219, 2003068
 60: # FTP brute force: 2001068, 2001069
 61: # SMTP auth failure: 2005001
 62: LOGIN_SURICATA_SIG_IDS="2001219,2003068,2001068,2001069,2005001"
 63: 
 64: # -----------------------------------------------------------------------------
 65: # SSH PROTOCOL LOGGING
 66: # -----------------------------------------------------------------------------
 67: # Suricata's SSH protocol logging (requires eve-log ssh type)
 68: 
 69: # Use SSH protocol logs for auth event extraction
 70: LOGIN_SURICATA_USE_SSH_LOG="true"
 71: 
 72: # SSH protocol version to monitor ("1.99", "2.0", or "all")
 73: LOGIN_SURICATA_SSH_PROTOCOL_VERSION="all"
 74: 
 75: # Detect client version patterns (potential attack tools)
 76: LOGIN_SURICATA_SSH_CLIENT_PATTERNS="libssh|paramiko|dropbear|putty"
 77: 
 78: # Detect scanner signatures in SSH banner
 79: LOGIN_SURICATA_SSH_SCANNER_PATTERNS="[Nn]map|[Ss]can|[Aa]udit|[Bb]rute"
 80: 
 81: # -----------------------------------------------------------------------------
 82: # SCORING THRESHOLDS
 83: # -----------------------------------------------------------------------------
 84: # Score-based decision making (0.0 - 1.0 scale)
 85: 
 86: # Base score per alert severity (Suricata severity 1-4)
 87: LOGIN_SURICATA_SCORE_SEVERITY_1="0.10"   # Low
 88: LOGIN_SURICATA_SCORE_SEVERITY_2="0.20"   # Medium
 89: LOGIN_SURICATA_SCORE_SEVERITY_3="0.35"   # High
 90: LOGIN_SURICATA_SCORE_SEVERITY_4="0.50"   # Critical
 91: 
 92: # Bonus score for specific attack types
 93: LOGIN_SURICATA_SCORE_BRUTE_FORCE="0.25"
 94: LOGIN_SURICATA_SCORE_CREDENTIAL_STUFFING="0.30"
 95: LOGIN_SURICATA_SCORE_DICTIONARY_ATTACK="0.25"
 96: LOGIN_SURICATA_SCORE_PASSWORD_SPRAY="0.30"
 97: 
 98: # Repetition multiplier (alerts from same IP in window)
 99: LOGIN_SURICATA_SCORE_REPEAT_3="0.10"     # 3+ alerts
100: LOGIN_SURICATA_SCORE_REPEAT_5="0.15"     # 5+ alerts
101: LOGIN_SURICATA_SCORE_REPEAT_10="0.25"    # 10+ alerts
102: 
103: # Multi-protocol bonus (attacking multiple services)
104: LOGIN_SURICATA_SCORE_MULTI_PROTOCOL="0.20"
105: 
106: # Feed reputation bonus (if IP is in threat feeds)
107: LOGIN_SURICATA_SCORE_BAD_REPUTATION="0.15"
108: 
109: # GeoIP risk bonus (high-risk countries)
110: LOGIN_SURICATA_SCORE_HIGH_RISK_GEO="0.10"
111: 
112: # Known attack tool detected
113: LOGIN_SURICATA_SCORE_KNOWN_TOOL="0.20"
114: 
115: # -----------------------------------------------------------------------------
116: # ACTION THRESHOLDS
117: # -----------------------------------------------------------------------------
118: # What to do based on final score
119: 
120: # Observe only (log, no block)
121: LOGIN_SURICATA_THRESHOLD_OBSERVE="0.25"
122: 
123: # Short block (temporary)
124: LOGIN_SURICATA_THRESHOLD_BLOCK_SHORT="0.45"
125: 
126: # Long block (extended)
127: LOGIN_SURICATA_THRESHOLD_BLOCK_LONG="0.65"
128: 
129: # Permanent block candidate
130: LOGIN_SURICATA_THRESHOLD_BLOCK_PERMANENT="0.85"
131: 
132: # -----------------------------------------------------------------------------
133: # BLOCKING POLICY
134: # -----------------------------------------------------------------------------
135: # Ban durations for each threshold level
136: 
137: LOGIN_SURICATA_BAN_DURATION_SHORT="900"        # 15 minutes
138: LOGIN_SURICATA_BAN_DURATION_LONG="3600"        # 1 hour
139: LOGIN_SURICATA_BAN_DURATION_PERMANENT="86400"  # 24 hours
140: 
141: # Score decay time (seconds) - how long before score resets
142: LOGIN_SURICATA_SCORE_DECAY="1800"
143: 
144: # Time window for counting repeated alerts (seconds)
145: LOGIN_SURICATA_ALERT_WINDOW="300"
146: 
147: # -----------------------------------------------------------------------------
148: # INTEGRATION WITH OTHER MODULES
149: # -----------------------------------------------------------------------------
150: # Enable correlation with other nftban modules
151: 
152: # Use threat feeds for reputation scoring
153: LOGIN_SURICATA_USE_FEEDS="true"
154: 
155: # Use GeoIP for risk scoring
156: LOGIN_SURICATA_USE_GEOIP="true"
157: 
158: # Cross-reference with classic mode (dual detection = higher score)
159: LOGIN_SURICATA_USE_CLASSIC_CORRELATION="true"
160: 
161: # Cross-reference with portscan module (recon before attack?)
162: LOGIN_SURICATA_USE_PORTSCAN_CORRELATION="true"
163: 
164: # -----------------------------------------------------------------------------
165: # PERFORMANCE TUNING
166: # -----------------------------------------------------------------------------
167: # EVE JSON parsing settings
168: 
169: # Batch size for processing alerts
170: LOGIN_SURICATA_BATCH_SIZE="100"
171: 
172: # Poll interval for EVE file (milliseconds)
173: LOGIN_SURICATA_POLL_INTERVAL_MS="500"
174: 
175: # Maximum alerts to process per second (rate limiting)
176: LOGIN_SURICATA_MAX_ALERTS_PER_SEC="500"
177: 
178: # Maximum tracked IPs
179: LOGIN_SURICATA_MAX_TRACKED_IPS="50000"
180: 
181: # State file for persistent tracking
182: LOGIN_SURICATA_STATE_FILE="/var/lib/nftban/login-suricata-state.db"
183: 
184: # -----------------------------------------------------------------------------
185: # LOGGING
186: # -----------------------------------------------------------------------------
187: # Log file for suricata mode events
188: 
189: LOGIN_SURICATA_LOG_FILE="/var/log/nftban/login-suricata.log"
190: 
191: # Log level: DEBUG, INFO, WARN, ERROR
192: LOGIN_SURICATA_LOG_LEVEL="INFO"
193: 
194: # Log all alerts (verbose)
195: LOGIN_SURICATA_LOG_ALL_ALERTS="false"
196: 
197: # Log scoring decisions
198: LOGIN_SURICATA_LOG_SCORES="true"
199: 
200: # Log protocol details
201: LOGIN_SURICATA_LOG_PROTOCOL_DETAILS="true"
202: 
203: # =============================================================================
204: # END OF SURICATA MODE CONFIGURATION
205: # =============================================================================
</file>

<file path="etc/nftban/conf.d/portscan/classic.conf">
  1: # =============================================================================
  2: # NFTBan Portscan Protection - CLASSIC MODE Configuration
  3: # =============================================================================
  4: # This configuration is used when running without Suricata IDS.
  5: # Uses nftables logging + kernel log parsing for portscan detection.
  6: #
  7: # File: /etc/nftban/conf.d/portscan/classic.conf
  8: # =============================================================================
  9: 
 10: # -----------------------------------------------------------------------------
 11: # CLASSIC MODE SETTINGS
 12: # -----------------------------------------------------------------------------
 13: # Log-based portscan detection using nftables and kernel log parsing.
 14: # No external IDS required - pure nftables implementation.
 15: 
 16: # Log prefix for nftables rules (used to identify portscan events)
 17: PORTSCAN_CLASSIC_LOG_PREFIX="NFTBAN_PORTSCAN:"
 18: 
 19: # Log file to monitor (usually kern.log or messages)
 20: PORTSCAN_CLASSIC_LOG_FILE="/var/log/kern.log"
 21: 
 22: # Alternative log files to check (comma-separated)
 23: PORTSCAN_CLASSIC_LOG_FILE_ALT="/var/log/messages,/var/log/syslog"
 24: 
 25: # -----------------------------------------------------------------------------
 26: # DETECTION THRESHOLDS
 27: # -----------------------------------------------------------------------------
 28: # Number of unique ports to trigger portscan detection
 29: 
 30: # Minimum unique ports from same IP in time window
 31: PORTSCAN_CLASSIC_MIN_PORTS="5"
 32: 
 33: # Time window for counting ports (seconds)
 34: PORTSCAN_CLASSIC_TIME_WINDOW="60"
 35: 
 36: # Minimum unique IPs targeted to detect horizontal scan
 37: PORTSCAN_CLASSIC_MIN_TARGETS="3"
 38: 
 39: # -----------------------------------------------------------------------------
 40: # SCAN TYPE DETECTION
 41: # -----------------------------------------------------------------------------
 42: # Different thresholds for different scan types
 43: 
 44: # Vertical scan: Single IP scanning multiple ports on one target
 45: PORTSCAN_CLASSIC_VERTICAL_PORTS="10"
 46: PORTSCAN_CLASSIC_VERTICAL_WINDOW="60"
 47: 
 48: # Horizontal scan: Single IP scanning same port on multiple targets
 49: PORTSCAN_CLASSIC_HORIZONTAL_TARGETS="5"
 50: PORTSCAN_CLASSIC_HORIZONTAL_WINDOW="30"
 51: 
 52: # Block scan: Single IP scanning port ranges
 53: PORTSCAN_CLASSIC_BLOCK_RANGE="20"
 54: PORTSCAN_CLASSIC_BLOCK_WINDOW="120"
 55: 
 56: # Strobe scan: Rapid scanning of common ports
 57: PORTSCAN_CLASSIC_STROBE_PORTS="5"
 58: PORTSCAN_CLASSIC_STROBE_WINDOW="10"
 59: 
 60: # -----------------------------------------------------------------------------
 61: # COMMON PORT MONITORING
 62: # -----------------------------------------------------------------------------
 63: # Log connections to these ports (comma-separated)
 64: 
 65: # Critical ports to always log
 66: PORTSCAN_CLASSIC_LOG_PORTS_CRITICAL="22,23,3389,5900"
 67: 
 68: # Service ports to log
 69: PORTSCAN_CLASSIC_LOG_PORTS_SERVICES="21,25,53,80,110,143,443,465,587,993,995,3306,5432"
 70: 
 71: # High ports to sample log (random sampling, not all)
 72: PORTSCAN_CLASSIC_LOG_PORTS_HIGH_RANGE="1024-65535"
 73: PORTSCAN_CLASSIC_LOG_PORTS_HIGH_SAMPLE_RATE="0.1"
 74: 
 75: # Enable logging of all closed port connections
 76: PORTSCAN_CLASSIC_LOG_CLOSED_PORTS="true"
 77: 
 78: # Enable logging of all new connections (verbose, use with caution)
 79: PORTSCAN_CLASSIC_LOG_ALL_NEW="false"
 80: 
 81: # -----------------------------------------------------------------------------
 82: # BLOCKING POLICY
 83: # -----------------------------------------------------------------------------
 84: # What to do when portscan is detected
 85: 
 86: # Action: block, log, alert, or block_and_alert
 87: PORTSCAN_CLASSIC_ACTION="block"
 88: 
 89: # Ban duration based on scan type (seconds)
 90: PORTSCAN_CLASSIC_BAN_VERTICAL="1800"      # 30 minutes
 91: PORTSCAN_CLASSIC_BAN_HORIZONTAL="3600"    # 1 hour
 92: PORTSCAN_CLASSIC_BAN_BLOCK="7200"         # 2 hours
 93: PORTSCAN_CLASSIC_BAN_STROBE="600"         # 10 minutes
 94: 
 95: # Default ban duration
 96: PORTSCAN_CLASSIC_BAN_DEFAULT="1800"
 97: 
 98: # Progressive banning: increase duration on repeat offenders
 99: PORTSCAN_CLASSIC_PROGRESSIVE_BAN="true"
100: PORTSCAN_CLASSIC_PROGRESSIVE_MULTIPLIER="2"
101: PORTSCAN_CLASSIC_PROGRESSIVE_MAX="86400"
102: 
103: # -----------------------------------------------------------------------------
104: # STATE TRACKING
105: # -----------------------------------------------------------------------------
106: # In-memory tracking configuration
107: 
108: # State file for persistent tracking across restarts
109: PORTSCAN_CLASSIC_STATE_FILE="/var/lib/nftban/portscan-state.db"
110: 
111: # Maximum IPs to track in memory
112: PORTSCAN_CLASSIC_MAX_TRACKED_IPS="10000"
113: 
114: # Cleanup interval for stale entries (seconds)
115: PORTSCAN_CLASSIC_CLEANUP_INTERVAL="300"
116: 
117: # State entry TTL (seconds)
118: PORTSCAN_CLASSIC_STATE_TTL="3600"
119: 
120: # -----------------------------------------------------------------------------
121: # NFTABLES RULES
122: # -----------------------------------------------------------------------------
123: # Rule generation settings
124: 
125: # Use nftables meters for rate tracking
126: PORTSCAN_CLASSIC_USE_METERS="true"
127: 
128: # Meter names
129: PORTSCAN_CLASSIC_METER_SYN="portscan_syn_meter"
130: PORTSCAN_CLASSIC_METER_NEW="portscan_new_meter"
131: 
132: # Log rate limit (prevent log flooding)
133: PORTSCAN_CLASSIC_LOG_RATE="10/second"
134: PORTSCAN_CLASSIC_LOG_BURST="50"
135: 
136: # -----------------------------------------------------------------------------
137: # AUTO-TUNING (OPTIONAL)
138: # -----------------------------------------------------------------------------
139: # Automatically adjust thresholds based on traffic patterns
140: 
141: # Enable auto-tuning
142: PORTSCAN_CLASSIC_AUTO_TUNE="false"
143: 
144: # Learning period (seconds) - observe before tuning
145: PORTSCAN_CLASSIC_AUTO_TUNE_PERIOD="3600"
146: 
147: # Baseline connection rate (if auto-tune disabled)
148: PORTSCAN_CLASSIC_BASELINE_RATE="100"
149: 
150: # -----------------------------------------------------------------------------
151: # LOGGING
152: # -----------------------------------------------------------------------------
153: # Module-specific logging
154: 
155: PORTSCAN_CLASSIC_LOG_FILE="/var/log/nftban/portscan-classic.log"
156: PORTSCAN_CLASSIC_LOG_LEVEL="INFO"
157: 
158: # Log all detections (including below threshold)
159: PORTSCAN_CLASSIC_LOG_ALL_DETECTIONS="false"
160: 
161: # Log port connection details
162: PORTSCAN_CLASSIC_LOG_PORT_DETAILS="true"
163: 
164: # =============================================================================
165: # END OF CLASSIC MODE CONFIGURATION
166: # =============================================================================
</file>

<file path="etc/nftban/conf.d/portscan/main.conf">
  1: # =============================================================================
  2: # NFTBan Portscan Protection - MAIN Configuration
  3: # =============================================================================
  4: # Master configuration for portscan detection module.
  5: # Controls mode selection and global settings.
  6: #
  7: # File: /etc/nftban/conf.d/portscan/main.conf
  8: # =============================================================================
  9: 
 10: # -----------------------------------------------------------------------------
 11: # MODULE ENABLE/DISABLE
 12: # -----------------------------------------------------------------------------
 13: # Master switch for portscan detection
 14: PORTSCAN_ENABLED="true"
 15: 
 16: # -----------------------------------------------------------------------------
 17: # MODE SELECTION
 18: # -----------------------------------------------------------------------------
 19: # Choose portscan detection mode:
 20: #
 21: #   auto     - Auto-detect: use Suricata if available, otherwise Classic
 22: #   classic  - Force Classic mode (nftables log-based detection)
 23: #   suricata - Force Suricata mode (requires Suricata installed & running)
 24: #   hybrid   - Use both: Classic logging + Suricata analysis
 25: #
 26: PORTSCAN_MODE="auto"
 27: 
 28: # -----------------------------------------------------------------------------
 29: # AUTO-DETECTION SETTINGS
 30: # -----------------------------------------------------------------------------
 31: # How to detect if Suricata is available (same as DDOS module)
 32: 
 33: # Check if Suricata service is running
 34: PORTSCAN_AUTO_CHECK_SERVICE="true"
 35: 
 36: # Check if Suricata binary exists
 37: PORTSCAN_AUTO_CHECK_BINARY="true"
 38: 
 39: # Check if EVE JSON file exists and is being written to
 40: PORTSCAN_AUTO_CHECK_EVE_FILE="true"
 41: 
 42: # Suricata service name (for systemctl check)
 43: PORTSCAN_SURICATA_SERVICE_NAME="suricata"
 44: 
 45: # Suricata binary path (for existence check)
 46: PORTSCAN_SURICATA_BINARY="/usr/bin/suricata"
 47: 
 48: # EVE file freshness threshold (seconds) - file must be updated within this time
 49: PORTSCAN_EVE_FRESHNESS_THRESHOLD="60"
 50: 
 51: # -----------------------------------------------------------------------------
 52: # HYBRID MODE SETTINGS
 53: # -----------------------------------------------------------------------------
 54: # When PORTSCAN_MODE="hybrid", both Classic and Suricata run together
 55: 
 56: # Classic mode provides nftables logging for audit trail
 57: # Suricata mode provides intelligent portscan detection
 58: 
 59: # Enable Classic logging even in Suricata mode
 60: PORTSCAN_HYBRID_CLASSIC_LOGGING="true"
 61: 
 62: # In hybrid mode, use Suricata for detection, Classic for logging only
 63: PORTSCAN_HYBRID_SURICATA_DETECT="true"
 64: 
 65: # -----------------------------------------------------------------------------
 66: # NFTABLES SETTINGS
 67: # -----------------------------------------------------------------------------
 68: # Chain and table names
 69: 
 70: PORTSCAN_NFT_TABLE_IPV4="ip nftban"
 71: PORTSCAN_NFT_TABLE_IPV6="ip6 nftban"
 72: PORTSCAN_NFT_CHAIN="portscan_detection"
 73: 
 74: # Position in input chain (after which rule to insert jump)
 75: # Options: "established" (after ct state established,related)
 76: #          "whitelist"   (after whitelist check)
 77: #          "ddos"        (after ddos protection)
 78: #          "first"       (at the beginning)
 79: PORTSCAN_NFT_JUMP_POSITION="ddos"
 80: 
 81: # -----------------------------------------------------------------------------
 82: # WHITELIST
 83: # -----------------------------------------------------------------------------
 84: # IPs/networks that should NEVER be flagged for portscan
 85: 
 86: # Whitelist file path
 87: PORTSCAN_WHITELIST_FILE="/etc/nftban/whitelist.d/portscan-whitelist.conf"
 88: 
 89: # Auto-whitelist localhost
 90: PORTSCAN_WHITELIST_LOCALHOST="true"
 91: 
 92: # Auto-whitelist private networks (RFC1918)
 93: PORTSCAN_WHITELIST_PRIVATE="true"
 94: 
 95: # Auto-whitelist known monitoring services (Nagios, Zabbix, etc.)
 96: PORTSCAN_WHITELIST_MONITORING="true"
 97: 
 98: # -----------------------------------------------------------------------------
 99: # GLOBAL LIMITS (Safety Net)
100: # -----------------------------------------------------------------------------
101: # Maximum IPs to block (prevent runaway blocking)
102: PORTSCAN_MAX_BLOCKED_IPS="5000"
103: 
104: # Maximum block duration (seconds) - safety cap
105: PORTSCAN_MAX_BAN_DURATION="86400"
106: 
107: # Minimum time between blocks of same IP (seconds)
108: PORTSCAN_MIN_REBLOCK_INTERVAL="300"
109: 
110: # -----------------------------------------------------------------------------
111: # NOTIFICATIONS
112: # -----------------------------------------------------------------------------
113: # Alert on significant events
114: 
115: # Enable email notifications
116: PORTSCAN_NOTIFY_EMAIL="false"
117: PORTSCAN_NOTIFY_EMAIL_TO=""
118: 
119: # Enable webhook notifications
120: PORTSCAN_NOTIFY_WEBHOOK="false"
121: PORTSCAN_NOTIFY_WEBHOOK_URL=""
122: 
123: # Threshold for notification (minimum ports or score)
124: PORTSCAN_NOTIFY_THRESHOLD="10"
125: 
126: # =============================================================================
127: # END OF MAIN CONFIGURATION
128: # =============================================================================
</file>

<file path="etc/nftban/conf.d/portscan/suricata.conf">
  1: # =============================================================================
  2: # NFTBan Portscan Protection - SURICATA MODE Configuration
  3: # =============================================================================
  4: # This configuration is used when Suricata IDS is installed and enabled.
  5: # Uses Suricata's built-in portscan detection via EVE JSON alerts.
  6: #
  7: # File: /etc/nftban/conf.d/portscan/suricata.conf
  8: # =============================================================================
  9: 
 10: # -----------------------------------------------------------------------------
 11: # SURICATA MODE SETTINGS
 12: # -----------------------------------------------------------------------------
 13: # These settings control Suricata-integrated portscan detection.
 14: # Suricata has sophisticated portscan detection built-in (sfportscan).
 15: 
 16: # EVE JSON Log Path (Suricata alert output)
 17: PORTSCAN_SURICATA_EVE_FILE="/var/log/suricata/eve.json"
 18: 
 19: # Alternative: Unix socket for real-time alerts (faster, optional)
 20: PORTSCAN_SURICATA_EVE_SOCKET=""
 21: 
 22: # -----------------------------------------------------------------------------
 23: # SURICATA PORTSCAN DETECTION TYPES
 24: # -----------------------------------------------------------------------------
 25: # Suricata sfportscan preprocessor detects these scan types
 26: 
 27: # Enable/disable specific detection types
 28: PORTSCAN_SURICATA_DETECT_PORTSCAN="true"
 29: PORTSCAN_SURICATA_DETECT_PORTSWEEP="true"
 30: PORTSCAN_SURICATA_DETECT_DECOY_PORTSCAN="true"
 31: PORTSCAN_SURICATA_DETECT_DISTRIBUTED_PORTSCAN="true"
 32: 
 33: # Scan sensitivity (1=low, 2=medium, 3=high)
 34: PORTSCAN_SURICATA_SENSITIVITY="2"
 35: 
 36: # -----------------------------------------------------------------------------
 37: # ALERT FILTERING
 38: # -----------------------------------------------------------------------------
 39: # Filter Suricata alerts for portscan-related events
 40: 
 41: # Signature patterns to match (regex, pipe-separated)
 42: PORTSCAN_SURICATA_SIG_PATTERNS="[Pp]ort[Ss]can|[Pp]ort [Ss]weep|SCAN|Nmap|masscan"
 43: 
 44: # Event types to monitor (from EVE JSON)
 45: PORTSCAN_SURICATA_EVENT_TYPES="alert,anomaly"
 46: 
 47: # Alert categories to monitor
 48: PORTSCAN_SURICATA_CATEGORIES="attempted-recon,successful-recon,network-scan"
 49: 
 50: # Signature IDs to explicitly monitor (comma-separated)
 51: # Example Suricata portscan detection SIDs
 52: PORTSCAN_SURICATA_SIG_IDS="2010935,2010936,2010937,2010938"
 53: 
 54: # -----------------------------------------------------------------------------
 55: # SCORING THRESHOLDS
 56: # -----------------------------------------------------------------------------
 57: # Score-based decision making (0.0 - 1.0 scale)
 58: 
 59: # Base score per alert severity (Suricata severity 1-4)
 60: PORTSCAN_SURICATA_SCORE_SEVERITY_1="0.10"   # Low
 61: PORTSCAN_SURICATA_SCORE_SEVERITY_2="0.20"   # Medium
 62: PORTSCAN_SURICATA_SCORE_SEVERITY_3="0.35"   # High
 63: PORTSCAN_SURICATA_SCORE_SEVERITY_4="0.50"   # Critical
 64: 
 65: # Bonus score for specific scan types
 66: PORTSCAN_SURICATA_SCORE_PORTSCAN="0.15"
 67: PORTSCAN_SURICATA_SCORE_PORTSWEEP="0.20"
 68: PORTSCAN_SURICATA_SCORE_DECOY="0.25"
 69: PORTSCAN_SURICATA_SCORE_DISTRIBUTED="0.30"
 70: 
 71: # Repetition multiplier (alerts from same IP in window)
 72: PORTSCAN_SURICATA_SCORE_REPEAT_5="0.10"     # 5+ alerts
 73: PORTSCAN_SURICATA_SCORE_REPEAT_10="0.20"    # 10+ alerts
 74: PORTSCAN_SURICATA_SCORE_REPEAT_20="0.30"    # 20+ alerts
 75: 
 76: # Feed reputation bonus (if IP is in threat feeds)
 77: PORTSCAN_SURICATA_SCORE_BAD_REPUTATION="0.15"
 78: 
 79: # GeoIP risk bonus (high-risk countries)
 80: PORTSCAN_SURICATA_SCORE_HIGH_RISK_GEO="0.10"
 81: 
 82: # Known scanner tools detected (Nmap, Masscan, etc.)
 83: PORTSCAN_SURICATA_SCORE_KNOWN_TOOL="0.20"
 84: 
 85: # -----------------------------------------------------------------------------
 86: # ACTION THRESHOLDS
 87: # -----------------------------------------------------------------------------
 88: # What to do based on final score
 89: 
 90: # Observe only (log, no block)
 91: PORTSCAN_SURICATA_THRESHOLD_OBSERVE="0.25"
 92: 
 93: # Short block (temporary)
 94: PORTSCAN_SURICATA_THRESHOLD_BLOCK_SHORT="0.45"
 95: 
 96: # Long block (extended)
 97: PORTSCAN_SURICATA_THRESHOLD_BLOCK_LONG="0.65"
 98: 
 99: # Permanent block (until manual review)
100: PORTSCAN_SURICATA_THRESHOLD_BLOCK_PERMANENT="0.85"
101: 
102: # -----------------------------------------------------------------------------
103: # BLOCKING POLICY
104: # -----------------------------------------------------------------------------
105: # Ban durations for each threshold level
106: 
107: PORTSCAN_SURICATA_BAN_DURATION_SHORT="900"        # 15 minutes
108: PORTSCAN_SURICATA_BAN_DURATION_LONG="3600"        # 1 hour
109: PORTSCAN_SURICATA_BAN_DURATION_PERMANENT="86400"  # 24 hours
110: 
111: # Score decay time (seconds) - how long before score resets
112: PORTSCAN_SURICATA_SCORE_DECAY="1800"
113: 
114: # Time window for counting repeated alerts (seconds)
115: PORTSCAN_SURICATA_ALERT_WINDOW="300"
116: 
117: # -----------------------------------------------------------------------------
118: # SCAN TOOL SIGNATURES
119: # -----------------------------------------------------------------------------
120: # Detect known scanning tools
121: 
122: # Nmap detection patterns
123: PORTSCAN_SURICATA_NMAP_PATTERNS="Nmap|nmap|NMAP|-sS|-sT|-sU|-sV"
124: 
125: # Masscan detection patterns
126: PORTSCAN_SURICATA_MASSCAN_PATTERNS="masscan|Masscan|MASSCAN"
127: 
128: # ZMap detection patterns
129: PORTSCAN_SURICATA_ZMAP_PATTERNS="zmap|ZMap|ZMAP"
130: 
131: # Shodan/Censys patterns
132: PORTSCAN_SURICATA_INTERNET_SCANNER_PATTERNS="Shodan|Censys|internet-census"
133: 
134: # -----------------------------------------------------------------------------
135: # INTEGRATION WITH OTHER MODULES
136: # -----------------------------------------------------------------------------
137: # Enable correlation with other nftban modules
138: 
139: # Use threat feeds for reputation scoring
140: PORTSCAN_SURICATA_USE_FEEDS="true"
141: 
142: # Use GeoIP for risk scoring
143: PORTSCAN_SURICATA_USE_GEOIP="true"
144: 
145: # Cross-reference with login module (was IP trying auth before scan?)
146: PORTSCAN_SURICATA_USE_LOGIN_CORRELATION="true"
147: 
148: # Use classic mode for logging (hybrid logging)
149: PORTSCAN_SURICATA_USE_CLASSIC_LOGGING="false"
150: 
151: # -----------------------------------------------------------------------------
152: # PERFORMANCE TUNING
153: # -----------------------------------------------------------------------------
154: # EVE JSON parsing settings
155: 
156: # Batch size for processing alerts
157: PORTSCAN_SURICATA_BATCH_SIZE="100"
158: 
159: # Poll interval for EVE file (milliseconds)
160: PORTSCAN_SURICATA_POLL_INTERVAL_MS="500"
161: 
162: # Maximum alerts to process per second (rate limiting)
163: PORTSCAN_SURICATA_MAX_ALERTS_PER_SEC="500"
164: 
165: # Maximum tracked IPs
166: PORTSCAN_SURICATA_MAX_TRACKED_IPS="10000"
167: 
168: # State file for persistent tracking
169: PORTSCAN_SURICATA_STATE_FILE="/var/lib/nftban/portscan-suricata-state.db"
170: 
171: # -----------------------------------------------------------------------------
172: # LOGGING
173: # -----------------------------------------------------------------------------
174: # Log file for suricata mode events
175: 
176: PORTSCAN_SURICATA_LOG_FILE="/var/log/nftban/portscan-suricata.log"
177: 
178: # Log level: DEBUG, INFO, WARN, ERROR
179: PORTSCAN_SURICATA_LOG_LEVEL="INFO"
180: 
181: # Log all alerts (verbose)
182: PORTSCAN_SURICATA_LOG_ALL_ALERTS="false"
183: 
184: # Log scoring decisions
185: PORTSCAN_SURICATA_LOG_SCORES="true"
186: 
187: # Log detected scanner tools
188: PORTSCAN_SURICATA_LOG_TOOLS="true"
189: 
190: # =============================================================================
191: # END OF SURICATA MODE CONFIGURATION
192: # =============================================================================
</file>

<file path="etc/nftban/conf.d/banner.conf">
  1: # =============================================================================
  2: # NFTBAN BANNER & OUTPUT CONFIGURATION
  3: # =============================================================================
  4: # Version: 1.0.0
  5: # Purpose: Control banner display, output formatting, and module load messages
  6: # Loaded by: nftban core during initialization
  7: # Referenced from: /etc/nftban/nftban.conf (NFTBAN_DEBUG_MODE)
  8: #
  9: # To customize banner settings:
 10: #   Add overrides to /etc/nftban/nftban.conf.local
 11: #
 12: # Example overrides in nftban.conf.local:
 13: #   NFTBAN_BANNER_MODE="simple"
 14: #   NFTBAN_MODULE_LOAD_LEVEL="debug"
 15: # =============================================================================
 16: 
 17: # =============================================================================
 18: # BANNER MODE
 19: # =============================================================================
 20: # Controls what banner/header is shown when running nftban commands
 21: # Values: full | simple | minimal | none | auto
 22: #
 23: # full    - Full decorative banner with stats, hostname, kernel
 24: #           ╭───────────────────────────────────────────────╮
 25: #           │  NFTBan v1.0.0 @ lab · 6.6.56-1.el9           │
 26: #           │         ban · unban · protect                 │
 27: #           │    tables 2 · chains 4 · rules 12 · bans 134 │
 28: #           ╰───────────────────────────────────────────────╯
 29: #
 30: # simple  - One-line version banner
 31: #           NFTBan v1.0.0
 32: #
 33: # minimal - No banner, just command output
 34: #
 35: # none    - Suppress all banners (automation-friendly)
 36: #
 37: # auto    - Smart default (RECOMMENDED):
 38: #           - Interactive (TTY):  full banner
 39: #           - Piped/scripted:     minimal (no banner)
 40: #           - DEBUG_MODE=true:    full banner (always)
 41: #
 42: # DO NOT EDIT THIS FILE FOR PERMANENT CHANGES!
 43: # Your changes will be lost during package updates.
 44: #
 45: # TO CUSTOMIZE:
 46: #   1. Copy setting to /etc/nftban/nftban.conf.local
 47: #   2. Uncomment and modify in .local file
 48: #   3. .local file is NEVER overwritten by updates
 49: #
 50: 
 51: NFTBAN_BANNER_MODE="auto"
 52: 
 53: # =============================================================================
 54: # MODULE LOAD LEVEL
 55: # =============================================================================
 56: # Controls module load messages visibility
 57: # Values: none | error | info | debug | verbose | auto
 58: #
 59: # none    - Never show module load messages
 60: #
 61: # error   - Only show if module fails to load
 62: #
 63: # info    - Show module name and version (DEFAULT)
 64: #           [INFO] Feed Management Module loaded (v1.0.0)
 65: #
 66: # debug   - Show detailed info (meta fields, timing)
 67: #           [DEBUG] Module loaded in 0.023s:
 68: #             Name:     nftban_feeds
 69: #             Version:  1.0.0
 70: #             Type:     module
 71: #             Depends:  nftban_core, nftban_utils
 72: #
 73: # verbose - Maximum detail (dependencies, load order, functions)
 74: #
 75: # auto    - Smart default (RECOMMENDED):
 76: #           - Normal mode:      info
 77: #           - DEBUG_MODE=true:  debug
 78: #
 79: NFTBAN_MODULE_LOAD_LEVEL="auto"
 80: 
 81: # Module load message format (for info level)
 82: # Uses meta: fields from module headers
 83: # Available: {name}, {version}, {type}, {header}, {description}
 84: #
 85: # Examples:
 86: #   "[INFO] {header} loaded (v{version})"
 87: #   "[INFO] {name} v{version} ready"
 88: #
 89: NFTBAN_MODULE_LOAD_FORMAT="[INFO] {header} loaded (v{version})"
 90: 
 91: # =============================================================================
 92: # TROUBLESHOOTING HELPERS (auto = enabled when DEBUG_MODE=true)
 93: # =============================================================================
 94: 
 95: # Show configuration source (which file set each variable)
 96: # Helps answer: "Why isn't my setting working?"
 97: # auto = show only when DEBUG_MODE=true
 98: NFTBAN_SHOW_CONFIG_SOURCE="auto"
 99: 
100: # Show module load timing (how long each module takes to load)
101: # Helps identify slow modules
102: # auto = show only when DEBUG_MODE=true
103: NFTBAN_SHOW_LOAD_TIMING="auto"
104: 
105: # Show dependency chain (which modules depend on what)
106: # Helps diagnose missing dependencies
107: # auto = show only when DEBUG_MODE=true
108: NFTBAN_SHOW_DEPENDENCIES="auto"
109: 
110: # Show environment info (user, permissions, paths)
111: # Helps diagnose permission issues
112: # auto = show only when DEBUG_MODE=true
113: NFTBAN_SHOW_ENVIRONMENT="auto"
114: 
115: # Show quick help/hints in banner
116: # Helpful commands and tips
117: NFTBAN_SHOW_HINTS="true"
118: 
119: # Show log file paths
120: # Where to find detailed logs
121: # auto = show only when DEBUG_MODE=true
122: NFTBAN_SHOW_LOG_PATHS="auto"
123: 
124: # =============================================================================
125: # BANNER COMPONENTS
126: # =============================================================================
127: 
128: # Show emoji/unicode or ASCII
129: # auto = detect from locale (UTF-8 = emoji, C = ASCII)
130: NFTBAN_BANNER_EMOJI="auto"
131: 
132: # Show hostname in banner
133: NFTBAN_BANNER_HOSTNAME="true"
134: 
135: # Show kernel version in banner
136: NFTBAN_BANNER_KERNEL="true"
137: 
138: # Show system statistics (tables, chains, rules, bans)
139: # Queries nftables for current state
140: NFTBAN_BANNER_STATS="true"
141: 
142: # Show motto/tagline
143: NFTBAN_BANNER_MOTTO="true"
144: 
145: # Motto text (customize if you want)
146: NFTBAN_MOTTO="ban · unban · protect"
147: 
148: # Update check (requires network, checks GitHub for new version)
149: # Disabled by default for privacy/performance
150: NFTBAN_BANNER_UPDATE_CHECK="false"
151: 
152: # GitHub repository for update check (if enabled)
153: # Format: owner/repo
154: NFTBAN_REPO="nftban/nftban"
155: 
156: # Update check cache TTL (seconds)
157: NFTBAN_UPDATE_TTL="86400"           # 24 hours
158: 
159: # =============================================================================
160: # OUTPUT FORMATTING
161: # =============================================================================
162: 
163: # Enable colors in output
164: # auto = enabled if TTY, disabled if piped
165: NFTBAN_COLOR="auto"
166: 
167: # Terminal width
168: # auto = detect from terminal, fallback to 80
169: NFTBAN_WIDTH="auto"
170: 
171: # Show timestamps in output
172: NFTBAN_TIMESTAMPS="true"
173: 
174: # Timestamp format (strftime format)
175: NFTBAN_TIMESTAMP_FORMAT="%Y-%m-%d %H:%M:%S"
176: 
177: # =============================================================================
178: # ERROR/WARNING DISPLAY
179: # =============================================================================
180: 
181: # Show error banners (always shown, even in minimal mode)
182: NFTBAN_ERROR_BANNER="true"
183: 
184: # Error banner style
185: # box     - Full decorative box with borders
186: # line    - Single line with [ERROR] prefix
187: # minimal - Plain text "ERROR: message"
188: NFTBAN_ERROR_BANNER_STYLE="box"
189: 
190: # Show warning banners
191: NFTBAN_WARNING_BANNER="true"
192: 
193: # Warning banner style
194: # line    - Single line with [WARNING] prefix (default)
195: # minimal - Plain text "WARNING: message"
196: NFTBAN_WARNING_BANNER_STYLE="line"
197: 
198: # =============================================================================
199: # PROGRESS INDICATORS
200: # =============================================================================
201: 
202: # Show progress for long-running operations
203: # auto = show if TTY
204: NFTBAN_PROGRESS="auto"
205: 
206: # Progress style
207: # spinner - Rotating spinner
208: # bar     - Progress bar [========] 80%
209: # dots    - Animated dots ...
210: # minimal - Simple text updates
211: NFTBAN_PROGRESS_STYLE="spinner"
212: 
213: # =============================================================================
214: # ADVANCED SETTINGS
215: # =============================================================================
216: 
217: # Honor NO_COLOR environment variable (disables all colors)
218: # Standard: https://no-color.org/
219: # This is always respected, regardless of NFTBAN_COLOR setting
220: 
221: # Suppress output for specific commands (space-separated)
222: # Example: "version help"
223: NFTBAN_SUPPRESS_BANNER_FOR=""
224: 
225: # =============================================================================
226: # END OF BANNER CONFIGURATION
227: # =============================================================================
</file>

<file path="etc/nftban/conf.d/mail.conf">
  1: # =============================================================================
  2: # NFTBan v1.0.0 - Mail Configuration
  3: # =============================================================================
  4: # SPDX-License-Identifier: MPL-2.0
  5: # Configuration for email notifications and reports
  6: #
  7: # Copy this file to /etc/nftban/conf.d/mail.conf and customize
  8: # =============================================================================
  9: 
 10: # -----------------------------------------------------------------------------
 11: # MAIL SYSTEM SETTINGS
 12: # -----------------------------------------------------------------------------
 13: 
 14: # Enable/disable mail notifications (YES/NO)
 15: NFTBAN_MAIL_ENABLED="NO"
 16: 
 17: # Default recipient for all mail notifications
 18: # Override per-module with specific settings
 19: NFTBAN_MAIL_RECIPIENT=""
 20: 
 21: # Sender address (defaults to nftban@hostname)
 22: NFTBAN_SENDER=""
 23: 
 24: # From name displayed in emails
 25: NFTBAN_FROM_NAME="NFTBan Security System"
 26: 
 27: # Subject prefix for all emails
 28: NFTBAN_MAIL_SUBJECT_PREFIX="[NFTBan]"
 29: 
 30: # -----------------------------------------------------------------------------
 31: # SMART MAIL ADAPTER - METHOD SELECTION
 32: # -----------------------------------------------------------------------------
 33: # The mail system auto-detects the best available method.
 34: # You can force a specific method if needed.
 35: #
 36: # Available methods (auto-detected in this priority):
 37: #   postfix   - Local Postfix MTA (fastest)
 38: #   sendmail  - Local Sendmail MTA
 39: #   exim      - Local Exim MTA
 40: #   msmtp     - Lightweight SMTP relay client
 41: #   curl      - Direct SMTP via curl (no local MTA needed)
 42: #   mailx     - Basic mail command (fallback)
 43: #
 44: # Leave empty for auto-detection (recommended)
 45: NFTBAN_MAIL_METHOD=""
 46: 
 47: # -----------------------------------------------------------------------------
 48: # DIRECT SMTP SETTINGS (for curl method)
 49: # -----------------------------------------------------------------------------
 50: # Configure these if you want to send email via external SMTP server
 51: # without running a local MTA (postfix/sendmail/exim).
 52: #
 53: # When NFTBAN_SMTP_HOST is set and no local MTA is found,
 54: # the mail system will automatically use curl SMTP.
 55: 
 56: # SMTP server hostname (e.g., smtp.gmail.com, mail.example.com)
 57: NFTBAN_SMTP_HOST=""
 58: 
 59: # SMTP port: 587 (STARTTLS), 465 (SMTPS), 25 (plain - not recommended)
 60: NFTBAN_SMTP_PORT="587"
 61: 
 62: # SMTP authentication (leave empty if not required)
 63: NFTBAN_SMTP_USER=""
 64: NFTBAN_SMTP_PASS=""
 65: 
 66: # -----------------------------------------------------------------------------
 67: # COMPANY BRANDING (Optional)
 68: # -----------------------------------------------------------------------------
 69: 
 70: # Company name shown in email headers/footers
 71: NFTBAN_COMPANY_NAME=""
 72: 
 73: # Logo URL (optional - for HTML emails)
 74: NFTBAN_LOGO_LOCATION=""
 75: 
 76: # Include version in emails (YES/NO)
 77: NFTBAN_VERSION_INCLUDE="YES"
 78: 
 79: # -----------------------------------------------------------------------------
 80: # TEMPLATE SETTINGS
 81: # -----------------------------------------------------------------------------
 82: 
 83: # Use HTML emails (YES/NO)
 84: NFTBAN_MAIL_USE_HTML="YES"
 85: 
 86: # Template directory (defaults to /usr/share/nftban/templates/mail)
 87: # NFTBAN_TEMPLATE_DIR="/usr/share/nftban/templates/mail"
 88: 
 89: # -----------------------------------------------------------------------------
 90: # SECURITY SETTINGS
 91: # -----------------------------------------------------------------------------
 92: 
 93: # Validate email addresses (YES/NO)
 94: NFTBAN_MAIL_VALIDATE_RECIPIENTS="YES"
 95: 
 96: # Allowed paths for file attachments (colon-separated)
 97: NFTBAN_MAIL_ALLOWED_PATHS="/var/lib/nftban:/var/log/nftban"
 98: 
 99: # Maximum file size in KB for attachments
100: NFTBAN_MAIL_MAX_FILE_SIZE="10240"
101: 
102: # -----------------------------------------------------------------------------
103: # DEBUG SETTINGS
104: # -----------------------------------------------------------------------------
105: 
106: # Enable mail debug mode (true/false)
107: NFTBAN_MAIL_DEBUG="false"
108: 
109: # Save sent emails to directory (empty to disable)
110: # NFTBAN_MAIL_SAVE_SENT="/var/lib/nftban/mail-archive"
111: 
112: # -----------------------------------------------------------------------------
113: # NOTIFICATION TRIGGERS
114: # -----------------------------------------------------------------------------
115: 
116: # Send email on critical health check failures (YES/NO)
117: NFTBAN_MAIL_ON_HEALTH_CRITICAL="NO"
118: 
119: # Send daily summary report (YES/NO)
120: NFTBAN_MAIL_DAILY_REPORT="NO"
121: 
122: # Daily report time (24h format, e.g., 08:00)
123: NFTBAN_MAIL_DAILY_REPORT_TIME="08:00"
124: 
125: # Send email on new ban (YES/NO) - can be noisy!
126: NFTBAN_MAIL_ON_BAN="NO"
127: 
128: # Send email on login alert (YES/NO)
129: NFTBAN_MAIL_ON_LOGIN_ALERT="NO"
130: 
131: # Minimum severity for alerts (info/warning/critical)
132: NFTBAN_MAIL_ALERT_SEVERITY="warning"
</file>


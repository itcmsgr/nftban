<file path="pkg/api/response.go">
  1: // Package api provides HTTP API handlers for NFTBan
  2: package api
  3: 
  4: import (
  5: 	"encoding/json"
  6: 	"net/http"
  7: 	"time"
  8: )
  9: 
 10: // =============================================================================
 11: // Standardized API Response Types
 12: // =============================================================================
 13: // Purpose: Ensure all API endpoints return consistent JSON structure
 14: // This makes frontend integration reliable and predictable
 15: // =============================================================================
 16: 
 17: // APIResponse is the standard JSON envelope for all API responses
 18: type APIResponse struct {
 19: 	Success   bool        `json:"success"`
 20: 	Message   string      `json:"message,omitempty"`
 21: 	Error     string      `json:"error,omitempty"`
 22: 	Data      interface{} `json:"data,omitempty"`
 23: 	Timestamp int64       `json:"timestamp"`
 24: }
 25: 
 26: // NewSuccessResponse creates a success response with optional data
 27: func NewSuccessResponse(message string, data interface{}) APIResponse {
 28: 	return APIResponse{
 29: 		Success:   true,
 30: 		Message:   message,
 31: 		Data:      data,
 32: 		Timestamp: time.Now().Unix(),
 33: 	}
 34: }
 35: 
 36: // NewErrorResponse creates an error response
 37: func NewErrorResponse(err string) APIResponse {
 38: 	return APIResponse{
 39: 		Success:   false,
 40: 		Error:     err,
 41: 		Timestamp: time.Now().Unix(),
 42: 	}
 43: }
 44: 
 45: // NewDataResponse creates a success response with just data (no message)
 46: func NewDataResponse(data interface{}) APIResponse {
 47: 	return APIResponse{
 48: 		Success:   true,
 49: 		Data:      data,
 50: 		Timestamp: time.Now().Unix(),
 51: 	}
 52: }
 53: 
 54: // =============================================================================
 55: // JSON Response Writers
 56: // =============================================================================
 57: 
 58: // JSON sends a successful response with data
 59: func JSON(w http.ResponseWriter, status int, data interface{}) {
 60: 	w.Header().Set("Content-Type", "application/json")
 61: 	w.WriteHeader(status)
 62: 	json.NewEncoder(w).Encode(NewDataResponse(data))
 63: }
 64: 
 65: // JSONSuccess sends a success message with optional data
 66: func JSONSuccess(w http.ResponseWriter, message string, data interface{}) {
 67: 	w.Header().Set("Content-Type", "application/json")
 68: 	w.WriteHeader(http.StatusOK)
 69: 	json.NewEncoder(w).Encode(NewSuccessResponse(message, data))
 70: }
 71: 
 72: // JSONError sends an error response with specified status code
 73: func JSONError(w http.ResponseWriter, status int, msg string) {
 74: 	w.Header().Set("Content-Type", "application/json")
 75: 	w.WriteHeader(status)
 76: 	json.NewEncoder(w).Encode(NewErrorResponse(msg))
 77: }
 78: 
 79: // JSONRaw sends a raw response object (for backward compatibility)
 80: func JSONRaw(w http.ResponseWriter, status int, response interface{}) {
 81: 	w.Header().Set("Content-Type", "application/json")
 82: 	w.WriteHeader(status)
 83: 	json.NewEncoder(w).Encode(response)
 84: }
 85: 
 86: // =============================================================================
 87: // Convenience Error Functions
 88: // =============================================================================
 89: 
 90: // JSONBadRequest sends 400 Bad Request error
 91: func JSONBadRequest(w http.ResponseWriter, msg string) {
 92: 	JSONError(w, http.StatusBadRequest, msg)
 93: }
 94: 
 95: // JSONUnauthorized sends 401 Unauthorized error
 96: func JSONUnauthorized(w http.ResponseWriter, msg string) {
 97: 	JSONError(w, http.StatusUnauthorized, msg)
 98: }
 99: 
100: // JSONForbidden sends 403 Forbidden error
101: func JSONForbidden(w http.ResponseWriter, msg string) {
102: 	JSONError(w, http.StatusForbidden, msg)
103: }
104: 
105: // JSONNotFound sends 404 Not Found error
106: func JSONNotFound(w http.ResponseWriter, msg string) {
107: 	JSONError(w, http.StatusNotFound, msg)
108: }
109: 
110: // JSONConflict sends 409 Conflict error
111: func JSONConflict(w http.ResponseWriter, msg string) {
112: 	JSONError(w, http.StatusConflict, msg)
113: }
114: 
115: // JSONInternalError sends 500 Internal Server Error
116: func JSONInternalError(w http.ResponseWriter, msg string) {
117: 	JSONError(w, http.StatusInternalServerError, msg)
118: }
119: 
120: // JSONServiceUnavailable sends 503 Service Unavailable error
121: func JSONServiceUnavailable(w http.ResponseWriter, msg string) {
122: 	JSONError(w, http.StatusServiceUnavailable, msg)
123: }
124: 
125: // =============================================================================
126: // Pagination Response Helpers
127: // =============================================================================
128: 
129: // PaginatedResponse wraps data with pagination info
130: type PaginatedResponse struct {
131: 	Items      interface{} `json:"items"`
132: 	Page       int         `json:"page"`
133: 	Limit      int         `json:"limit"`
134: 	Total      int         `json:"total"`
135: 	TotalPages int         `json:"total_pages"`
136: }
137: 
138: // NewPaginatedResponse creates a paginated response
139: func NewPaginatedResponse(items interface{}, page, limit, total int) PaginatedResponse {
140: 	totalPages := total / limit
141: 	if total%limit > 0 {
142: 		totalPages++
143: 	}
144: 	return PaginatedResponse{
145: 		Items:      items,
146: 		Page:       page,
147: 		Limit:      limit,
148: 		Total:      total,
149: 		TotalPages: totalPages,
150: 	}
151: }
152: 
153: // JSONPaginated sends a paginated response
154: func JSONPaginated(w http.ResponseWriter, items interface{}, page, limit, total int) {
155: 	w.Header().Set("Content-Type", "application/json")
156: 	w.WriteHeader(http.StatusOK)
157: 	json.NewEncoder(w).Encode(NewSuccessResponse("", NewPaginatedResponse(items, page, limit, total)))
158: }

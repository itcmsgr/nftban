 581: <script>
 582: // Avoid redeclaration errors
 583: window.allModules = window.allModules || [];
 584: 
 585: function showSystemTab(tabName) {
 586:     document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
 587:     document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
 588: 
 589:     event.target.closest('.tab').classList.add('active');
 590:     document.getElementById(`tab-${tabName}`).classList.add('active');
 591: 
 592:     // Load data when tab is shown
 593:     if (tabName === 'overview') {
 594:         loadOverview();
 595:     } else if (tabName === 'services') {
 596:         loadServices();
 597:     } else if (tabName === 'timers') {
 598:         loadTimers();
 599:     } else if (tabName === 'modules') {
 600:         loadModules();
 601:     } else if (tabName === 'fhs') {
 602:         loadFHS();
 603:     } else if (tabName === 'health') {
 604:         loadHealth();
 605:     }
 606: }
 607: 
 608: async function loadOverview() {
 609:     // Check if we're on this page
 610:     if (!document.getElementById('nftban-status')) return;
 611: 
 612:     try {
 613:         // Load status
 614:         const statusResp = await apiRequest('/system/status');
 615:         if (statusResp.success && statusResp.data) {
 616:             const d = statusResp.data;
 617:             setText('nftban-status', d.active ? 'Active' : 'Inactive');
 618:             setText('nftban-version', d.version || 'v1.0.0');
 619:             setText('nftban-rules', d.rules || '0');
 620:             setText('nftban-banned', d.banned || '0');
 621: 
 622:             // Protection modules
 623:             setText('ddos-status', d.ddos_enabled ? 'Enabled' : 'Disabled');
 624:             setText('portscan-status', d.portscan_enabled ? 'Enabled' : 'Disabled');
 625:             setText('login-status', d.login_enabled ? 'Enabled' : 'Disabled');
 626:             setText('feeds-status', (d.feeds_active || '0') + ' active');
 627: 
 628:             // Services
 629:             setText('svc-nftables', d.nftables_running ? 'Running' : 'Stopped');
 630:             setText('svc-fail2ban', d.fail2ban_running ? 'Running' : 'Stopped');
 631:             setText('svc-ui', d.ui_running ? 'Running' : 'Stopped');
 632:             setText('svc-login', d.login_monitor_running ? 'Running' : 'Stopped');
 633: 
 634:             // Health summary
 635:             const healthCard = document.getElementById('health-card');
 636:             if (d.health_status === 'OK') {
 637:                 setText('health-status-text', 'OK');
 638:                 healthCard.classList.add('success');
 639:             } else if (d.health_errors > 0) {
 640:                 setText('health-status-text', d.health_errors + ' Errors');
 641:                 healthCard.classList.add('danger');
 642:             } else {

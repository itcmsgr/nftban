3241: nftban_health_render_json() {
3242:     # Render health check results as JSON
3243:     # Output: Complete JSON object with all health data
3244: 
3245:     # JSON escape function - escapes special chars for valid JSON strings
3246:     _json_escape() {
3247:         local str="$1"
3248:         # Escape backslashes first, then other special chars
3249:         str="${str//\\/\\\\}"      # backslash
3250:         str="${str//\"/\\\"}"      # double quote
3251:         str="${str//$'\n'/\\n}"    # newline
3252:         str="${str//$'\r'/\\r}"    # carriage return
3253:         str="${str//$'\t'/\\t}"    # tab
3254:         echo -n "$str"
3255:     }
3256: 
3257:     # Count errors and warnings safely
3258:     local error_count=0
3259:     local warning_count=0
3260: 
3261:     if [[ -n "${NFTBAN_HEALTH_ERRORS+x}" ]]; then
3262:         error_count="${#NFTBAN_HEALTH_ERRORS[@]}"
3263:     fi
3264:     if [[ -n "${NFTBAN_HEALTH_WARNINGS+x}" ]]; then
3265:         warning_count="${#NFTBAN_HEALTH_WARNINGS[@]}"
3266:     fi
3267: 
3268:     # Determine overall status
3269:     local overall_status="ok"
3270:     local exit_code=0
3271:     if [[ $error_count -gt 0 ]]; then
3272:         overall_status="error"
3273:         exit_code=2
3274:     elif [[ $warning_count -gt 0 ]]; then
3275:         overall_status="warning"
3276:         exit_code=1
3277:     fi
3278: 
3279:     echo "{"
3280:     echo "  \"timestamp\": \"$(date --iso-8601=seconds)\","
3281:     echo "  \"overall_status\": \"$overall_status\","
3282:     echo "  \"exit_code\": $exit_code,"
3283:     echo "  \"summary\": {"
3284:     echo "    \"errors\": $error_count,"
3285:     echo "    \"warnings\": $warning_count"
3286:     echo "  },"
3287:     echo "  \"checks\": {"
3288: 
3289:     # Output each check result
3290:     local first=true
3291:     for check in binaries paths permissions services modules geoip databases config fhs metrics gui; do
3292:         if [[ -n "${NFTBAN_HEALTH_RESULTS[$check]:-}" ]]; then
3293:             [[ "$first" == "false" ]] && echo ","
3294:             first=false
3295: 
3296:             local status="${NFTBAN_HEALTH_RESULTS[$check]}"
3297:             local status_name="ok"
3298:             [[ $status -eq 1 ]] && status_name="warning"
3299:             [[ $status -eq 2 ]] && status_name="error"
3300:             local issues="${NFTBAN_HEALTH_ISSUES[$check]:-}"  # shellcheck disable=SC2178  # Intentional string from array
3301: 
3302:             escaped_issues="$(_json_escape "$issues")"  # shellcheck disable=SC2128  # First element extraction
3303:             local escaped_issues
3304:             escaped_issues="$(_json_escape "$issues")"
3305: 
3306:             echo -n "    \"$check\": {\"status\": \"$status_name\", \"exit_code\": $status, \"message\": \"$escaped_issues\"}"
3307:         fi
3308:     done
3309: 
3310:     echo ""
3311:     echo "  },"
3312:     echo "  \"errors\": ["
3313: 
3314:     # Output errors array
3315:     if [[ $error_count -gt 0 ]]; then
3316:         local first_error=true
3317:         for error in "${NFTBAN_HEALTH_ERRORS[@]}"; do
3318:             [[ "$first_error" == "false" ]] && echo ","
3319:             first_error=false
3320:             local escaped_error
3321:             escaped_error="$(_json_escape "$error")"
3322:             echo -n "    \"$escaped_error\""
3323:         done
3324:         echo ""
3325:     fi
3326: 
3327:     echo "  ],"
3328:     echo "  \"warnings\": ["
3329: 
3330:     # Output warnings array
3331:     if [[ $warning_count -gt 0 ]]; then
3332:         local first_warn=true
3333:         for warning in "${NFTBAN_HEALTH_WARNINGS[@]}"; do
3334:             [[ "$first_warn" == "false" ]] && echo ","
3335:             first_warn=false
3336:             local escaped_warning
3337:             escaped_warning="$(_json_escape "$warning")"
3338:             echo -n "    \"$escaped_warning\""
3339:         done
3340:         echo ""
3341:     fi
3342: 
3343:     echo "  ]"
3344:     echo "}"
3345: 
3346:     return $exit_code
3347: }

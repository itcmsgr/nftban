248: # =============================================================================
249: # TRACE SUBCOMMANDS
250: # =============================================================================
251: 
252: nftban_debug_trace() {
253:     local subcommand="${1:-recent}"
254:     shift || true
255: 
256:     # Source trace library
257:     if [[ -f "${NFTBAN_LIB_DIR}/helpers/nftban_trace.sh" ]]; then
258:         source "${NFTBAN_LIB_DIR}/helpers/nftban_trace.sh"
259:     fi

207: _nftban_portscan_stats_json() {
208:     local json_mode="${1:-false}"
209: 
210:     # Get portscan enabled status, mode from config
211:     local portscan_enabled="false"
212:     local portscan_mode="classic"
213:     local suricata_available="false"
214:     local config_file="/etc/nftban/conf.d/portscan.conf"
215:     local config_main="/etc/nftban/conf.d/portscan/main.conf"
216:     local monitored_ports=0
217: 
218:     # Check if Suricata is available
219:     if systemctl is-active suricata.service >/dev/null 2>&1; then
220:         suricata_available="true"
221:     fi
222: 
223:     # Read from main.conf (new structure)
224:     if [[ -f "$config_main" ]]; then
225:         local enabled_val
226:         enabled_val=$(grep "^PORTSCAN_ENABLED=" "$config_main" 2>/dev/null | head -1 | cut -d= -f2 | tr -d '"' | tr -d "'" | tr -d ' ') || true
227:         [[ "$enabled_val" == "true" ]] && portscan_enabled="true"
228: 
229:         # Get mode (auto, classic, suricata, hybrid)
230:         local mode_val
231:         mode_val=$(grep "^PORTSCAN_MODE=" "$config_main" 2>/dev/null | cut -d= -f2 | tr -d '"' | tr -d "'" | xargs)
232:         [[ -n "$mode_val" ]] && portscan_mode="$mode_val"
233: 
234:         # If mode is "auto", determine effective mode
235:         if [[ "$portscan_mode" == "auto" ]]; then
236:             if [[ "$suricata_available" == "true" ]]; then
237:                 portscan_mode="suricata"
238:             else
239:                 portscan_mode="classic"
240:             fi
241:         fi
242:     elif [[ -f "$config_file" ]]; then
243:         # Fallback to old config file
244:         local enabled_val
245:         enabled_val=$(grep "^PORTSCAN_ENABLED=" "$config_file" 2>/dev/null | head -1 | cut -d= -f2 | tr -d '"' | tr -d "'" | tr -d ' ') || true
246:         [[ "$enabled_val" == "true" ]] && portscan_enabled="true"
247: 
248:         # Get monitored ports count from old config
249:         local ports_val
250:         ports_val=$(grep "^PORTSCAN_MONITOR_PORTS=" "$config_file" 2>/dev/null | head -1 | cut -d= -f2 | tr -d '"' | tr -d "'") || true
251:         if [[ "$ports_val" == "closed" ]] || [[ "$ports_val" == "all" ]]; then
252:             monitored_ports=1
253:         elif [[ -n "$ports_val" ]]; then
254:             monitored_ports=$(echo "$ports_val" | grep -oE '[0-9]+' | wc -l) || monitored_ports=0
255:         fi
256:     fi
257: 
258:     # Count portscan blocks from nftban-actions.log
259:     local blocked_24h=0
260:     local blocked_total=0
261: 
262:     if [[ -f "/var/log/nftban/nftban-actions.log" ]]; then
263:         # Count portscan bans in last 24 hours
264:         local yesterday_ts
265:         yesterday_ts=$(date -d '24 hours ago' +%s 2>/dev/null) || yesterday_ts=0  # shellcheck disable=SC2034  # Reserved for time range filtering
266:         blocked_24h=$(grep -c '"source":"portscan"' /var/log/nftban/nftban-actions.log 2>/dev/null) || blocked_24h=0
267: 
268:         # Count total portscan bans (same as 24h for now, proper implementation needs timestamp filtering)
269:         blocked_total=$blocked_24h
270:     fi
271: 
272:     # Ensure numeric values - strip any non-numeric characters
273:     monitored_ports=$(echo "$monitored_ports" | tr -dc '0-9')
274:     [[ -z "$monitored_ports" ]] && monitored_ports=0
275:     blocked_24h=$(echo "$blocked_24h" | tr -dc '0-9')
276:     [[ -z "$blocked_24h" ]] && blocked_24h=0
277:     blocked_total=$(echo "$blocked_total" | tr -dc '0-9')
278:     [[ -z "$blocked_total" ]] && blocked_total=0
279: 
280:     if [[ "$json_mode" == "true" ]] && declare -f json_output >/dev/null 2>&1; then
281:         local data
282:         if command -v jq &>/dev/null; then
283:             data=$(jq -n \
284:                 --arg ports "$monitored_ports" \
285:                 --arg blocked_24h "$blocked_24h" \
286:                 --arg blocked_total "$blocked_total" \
287:                 --arg enabled "$portscan_enabled" \
288:                 --arg mode "$portscan_mode" \
289:                 --arg suricata "$suricata_available" \
290:                 '{
291:                     portscan: {
292:                         monitored_ports: ($ports | tonumber),
293:                         blocked_24h: ($blocked_24h | tonumber),
294:                         blocked_total: ($blocked_total | tonumber),
295:                         enabled: ($enabled == "true"),
296:                         mode: $mode,
297:                         suricata_available: ($suricata == "true")
298:                     }
299:                 }')
300:         else
301:             local enabled_json="false"
302:             local suricata_json="false"
303:             [[ "$portscan_enabled" == "true" ]] && enabled_json="true"
304:             [[ "$suricata_available" == "true" ]] && suricata_json="true"
305:             data="{\"portscan\":{\"monitored_ports\":$monitored_ports,\"blocked_24h\":$blocked_24h,\"blocked_total\":$blocked_total,\"enabled\":$enabled_json,\"mode\":\"$portscan_mode\",\"suricata_available\":$suricata_json}}"
306:         fi
307: 
308:         json_output "true" "$data"
309:         return 0
310:     fi
311: 
312:     # Human-readable output
313:     echo "Port Scan Detection Statistics"
314:     echo "=============================="
315:     echo ""
316:     echo "  Enabled:          $portscan_enabled"
317:     echo "  Mode:             $portscan_mode"
318:     echo "  Suricata:         $suricata_available"
319:     echo "  Monitored Ports:  $monitored_ports"
320:     echo "  Blocked (24h):    $blocked_24h"
321:     echo "  Blocked (Total):  $blocked_total"
322:     echo ""
323: }
324: 
325: # =============================================================================
326: 
327: # MAIN COMMAND HANDLER
328: # =============================================================================
329: 
330: 
331: nftban_cmd_portscan() {
332:     local action="${1:-status}"
333:     local json_mode=false
334: 
335:     # Check for --json flag
336:     for arg in "$@"; do
337:         [[ "$arg" == "--json" ]] && json_mode=true && break
338:     done
339:     shift || true
340: 
341:     # Load core port scan module (lazy loading for performance)
342:     if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_portscan.sh" ]]; then
343:         # shellcheck source=/dev/null
344:         source "${NFTBAN_LIB_DIR}/core/nftban_portscan.sh"
345:     else
346:         echo "ERROR: Port scan detection module not found"
347:         echo "Expected: ${NFTBAN_LIB_DIR}/core/nftban_portscan.sh"
348:         exit 1
349:     fi
350: 
351:     # NOTE: Root check removed - nftables operations require CAP_NET_ADMIN
352:     # which can be granted via capabilities, not just EUID==0.
353:     # Let the actual nft commands fail with proper error if privileges missing.
354: 
355:     # Handle commands
356:     case "$action" in
357:         enable)
358:             nftban_portscan_enable
359:             ;;
360: 
361:         disable)
362:             nftban_portscan_disable
363:             ;;
364: 
365:         status)
366:             nftban_portscan_status
367:             ;;
368: 
369:         stats)
370:             # JSON stats for API/GUI - output portscan statistics
371:             _nftban_portscan_stats_json "$json_mode"
372:             ;;
373: 
374:         check)
375:             nftban_portscan_banner
376:             echo ""
377:             echo "🔍 Running port scan check..."
378:             echo ""
379: 
380:             # Parse kernel log
381:             local log_file="/var/log/kern.log"
382:             if [[ ! -f "$log_file" ]]; then
383:                 log_file="/var/log/messages"
384:             fi
385: 
386:             if [[ ! -f "$log_file" ]]; then
387:                 echo "❌ No suitable log file found"
388:                 echo "   Tried: /var/log/kern.log, /var/log/messages"
389:                 exit 1
390:             fi
391: 
392:             echo "Parsing log file: $log_file"
393:             echo ""
394: 
395:             nftban_portscan_check "$log_file"
396: 
397:             echo ""
398:             echo "✅ Port scan check complete"
399:             echo "   Check log: /var/log/nftban/portscan.log"
400:             ;;
401: 
402:         history)
403:             nftban_portscan_banner
404:             echo ""
405:             echo "📜 Recent Port Scan Detections (last 24 hours)"
406:             echo ""
407: 
408:             local log_file="/var/log/nftban/portscan.log"
409:             if [[ ! -f "$log_file" ]]; then
410:                 echo "  (no detections yet)"
411:             else
412:                 # Show last 24 hours of detections
413:                 local cutoff_time
414:                 cutoff_time=$(date -d "24 hours ago" "+%Y-%m-%d %H:%M:%S" 2>/dev/null || date -v-24H "+%Y-%m-%d %H:%M:%S")
415: 
416:                 grep "Port scanner detected" "$log_file" 2>/dev/null | \
417:                     awk -v cutoff="$cutoff_time" '$0 >= cutoff' | \
418:                     tail -n 50 | \
419:                     sed 's/^/  /' || echo "  (no recent detections)"
420:             fi
421:             echo ""
422:             ;;
423: 
424:         test)
425:             nftban_portscan_banner
426:             echo ""
427:             echo "🧪 Testing Port Scan Detection Rules"
428:             echo ""
429:             echo "Checking nftables chains..."
430:             echo ""
431: 
432:             # Check for portscan chain
433:             if nft list chain ${NFTBAN_TABLE_IPV4} portscan_detection &>/dev/null; then
434:                 echo "  ✅ Port scan detection chain exists (IPv4)"
435: 
436:                 # Count rules
437:                 local rule_count
438:                 rule_count=$(nft list chain ${NFTBAN_TABLE_IPV4} portscan_detection 2>/dev/null | grep -c "log prefix" || echo "0")
439:                 echo "     Rules: $rule_count logging rules"
440:             else
441:                 echo "  ❌ Port scan detection chain not found (IPv4)"
442:                 echo "     Run 'sudo nftban portscan enable' to create"
443:             fi
444: 
445:             if nft list chain ${NFTBAN_TABLE_IPV6} portscan_detection &>/dev/null; then
446:                 echo "  ✅ Port scan detection chain exists (IPv6)"
447:             else
448:                 echo "  ❌ Port scan detection chain not found (IPv6)"
449:             fi
450: 
451:             echo ""
452:             echo "Checking log file..."
453:             if [[ -f "/var/log/nftban/portscan.log" ]]; then
454:                 local log_size
455:                 log_size=$(stat -f%z "/var/log/nftban/portscan.log" 2>/dev/null || stat -c%s "/var/log/nftban/portscan.log")
456:                 echo "  ✅ Log file exists: /var/log/nftban/portscan.log"
457:                 echo "     Size: $log_size bytes"
458:             else
459:                 echo "  ⚠️  Log file not found (will be created on first detection)"
460:             fi
461: 
462:             echo ""
463:             echo "Test complete. Run 'nftban portscan status' for detailed configuration."
464:             ;;
465: 
466:         sync)
467:             nftban_portscan_banner
468:             echo ""
469:             echo "🔄 Syncing port scan logs from journalctl..."
470:             echo ""
471: 
472:             nftban_portscan_sync_logs
473: 
474:             local portscan_log="${NFTBAN_PORTSCAN_LOG:-/var/log/nftban/portscan.log}"
475:             local line_count
476:             line_count=$(wc -l < "$portscan_log" 2>/dev/null || echo "0")
477: 
478:             echo "✅ Log sync complete"
479:             echo "   File: $portscan_log"
480:             echo "   Entries: $line_count"
481:             ;;
482: 
483:         help|--help|-h)
484:             _nftban_portscan_help
485:             ;;
486: 
487:         *)
488:             echo "ERROR: Unknown command: $action"
489:             echo ""
490:             echo "Available commands: enable, disable, status, check, history, test, sync, help"
491:             echo "Run 'nftban portscan help' for detailed usage information"
492:             exit 1
493:             ;;
494:     esac
495: 
496: 
497:     # Exit marker for testing validation
498:     command -v nftban_cmd_exit >/dev/null 2>&1 && nftban_cmd_exit "portscan"
499:     return 0
500: }
501: 
502: # =============================================================================
503: 
504: # EXPORT FOR MAIN CLI
505: # =============================================================================
506: 
507: export -f nftban_cmd_portscan
508: 
509: # Execute if called directly (shouldn't happen, but handle gracefully)
510: if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
511:     nftban_cmd_portscan "$@"
512: fi
</file>


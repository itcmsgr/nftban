394: func snapshotRuleset(path string) error {
395: 	cmd := exec.Command("nft", "list", "ruleset")
396: 	output, err := cmd.Output()
397: 	if err != nil {
398: 		return err
399: 	}
400: 
401: 	return os.WriteFile(path, output, 0640)
402: }

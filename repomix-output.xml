 656: # =============================================================================
 657: # SYSTEM RESOURCE CHECKS (CPU, RAM, DISK)
 658: # =============================================================================
 659: 
 660: nftban_health_check_resources() {
 661:     # Check system resources (CPU, RAM, disk usage)
 662:     # Returns: 0=OK, 1=Warning, 2=Error
 663: 
 664:     local status=$HEALTH_OK
 665:     local resource_issues=()
 666: 
 667:     # Configurable thresholds (can be overridden in /etc/nftban/conf.d/health.conf)
 668:     local DISK_WARN_THRESHOLD=${NFTBAN_DISK_WARN_THRESHOLD:-85}
 669:     local DISK_CRIT_THRESHOLD=${NFTBAN_DISK_CRIT_THRESHOLD:-95}
 670:     local RAM_WARN_THRESHOLD=${NFTBAN_RAM_WARN_THRESHOLD:-90}
 671:     local RAM_CRIT_THRESHOLD=${NFTBAN_RAM_CRIT_THRESHOLD:-95}
 672:     local CPU_WARN_THRESHOLD=${NFTBAN_CPU_WARN_THRESHOLD:-80}
 673:     local CPU_CRIT_THRESHOLD=${NFTBAN_CPU_CRIT_THRESHOLD:-95}
 674: 
 675:     # ==========================================================================
 676:     # DISK USAGE CHECK
 677:     # ==========================================================================
 678: 
 679:     # Check critical filesystems
 680:     local critical_mounts=("/" "/var" "/var/log" "/tmp")
 681: 
 682:     for mount_point in "${critical_mounts[@]}"; do
 683:         if [[ -d "$mount_point" ]]; then
 684:             # Get disk usage percentage (without % symbol)
 685:             local disk_usage
 686:             disk_usage=$(df -h "$mount_point" 2>/dev/null | awk 'NR==2 {gsub(/%/,"",$5); print $5}')
 687: 
 688:             if [[ -n "$disk_usage" && "$disk_usage" =~ ^[0-9]+$ ]]; then
 689:                 if [[ $disk_usage -ge $DISK_CRIT_THRESHOLD ]]; then
 690:                     resource_issues+=("CRITICAL: $mount_point disk usage at ${disk_usage}%")
 691:                     status=$HEALTH_ERROR
 692:                 elif [[ $disk_usage -ge $DISK_WARN_THRESHOLD ]]; then
 693:                     resource_issues+=("WARNING: $mount_point disk usage at ${disk_usage}%")
 694:                     [[ $status -eq $HEALTH_OK ]] && status=$HEALTH_WARNING
 695:                 fi
 696:             fi
 697:         fi
 698:     done
 699: 
 700:     # ==========================================================================
 701:     # MEMORY (RAM) USAGE CHECK
 702:     # ==========================================================================
 703: 
 704:     if command -v free >/dev/null 2>&1; then
 705:         # Get memory usage percentage
 706:         # Using available memory for more accurate calculation
 707:         local mem_total mem_available mem_used_percent
 708: 
 709:         mem_total=$(free -m | awk '/^Mem:/ {print $2}')
 710:         mem_available=$(free -m | awk '/^Mem:/ {print $7}')
 711: 
 712:         if [[ -n "$mem_total" && -n "$mem_available" && "$mem_total" -gt 0 ]]; then
 713:             mem_used_percent=$(( 100 - (mem_available * 100 / mem_total) ))
 714: 
 715:             if [[ $mem_used_percent -ge $RAM_CRIT_THRESHOLD ]]; then
 716:                 resource_issues+=("CRITICAL: RAM usage at ${mem_used_percent}%")
 717:                 status=$HEALTH_ERROR
 718:             elif [[ $mem_used_percent -ge $RAM_WARN_THRESHOLD ]]; then
 719:                 resource_issues+=("WARNING: RAM usage at ${mem_used_percent}%")
 720:                 [[ $status -eq $HEALTH_OK ]] && status=$HEALTH_WARNING
 721:             fi
 722:         fi
 723:     fi
 724: 
 725:     # ==========================================================================
 726:     # CPU LOAD CHECK
 727:     # ==========================================================================
 728: 
 729:     if [[ -f /proc/loadavg ]]; then
 730:         # Get 1-minute load average
 731:         local load_avg cpu_count load_percent
 732: 
 733:         load_avg=$(awk '{print $1}' /proc/loadavg)
 734:         cpu_count=$(nproc 2>/dev/null || grep -c ^processor /proc/cpuinfo)
 735: 
 736:         if [[ -n "$load_avg" && -n "$cpu_count" && "$cpu_count" -gt 0 ]]; then
 737:             # Calculate load as percentage of CPU capacity
 738:             load_percent=$(awk -v loadval="$load_avg" -v cpus="$cpu_count" 'BEGIN {printf "%.0f", (loadval/cpus)*100}')
 739: 
 740:             if [[ $load_percent -ge $CPU_CRIT_THRESHOLD ]]; then
 741:                 resource_issues+=("CRITICAL: CPU load at ${load_percent}% (${load_avg}/${cpu_count} cores)")
 742:                 status=$HEALTH_ERROR
 743:             elif [[ $load_percent -ge $CPU_WARN_THRESHOLD ]]; then
 744:                 resource_issues+=("WARNING: CPU load at ${load_percent}% (${load_avg}/${cpu_count} cores)")
 745:                 [[ $status -eq $HEALTH_OK ]] && status=$HEALTH_WARNING
 746:             fi
 747:         fi
 748:     fi
 749: 
 750:     # ==========================================================================
 751:     # SWAP USAGE CHECK (Optional - high swap can indicate memory pressure)
 752:     # ==========================================================================
 753: 
 754:     if command -v free >/dev/null 2>&1; then
 755:         local swap_total swap_used swap_percent
 756: 
 757:         swap_total=$(free -m | awk '/^Swap:/ {print $2}')
 758:         swap_used=$(free -m | awk '/^Swap:/ {print $3}')
 759: 
 760:         if [[ -n "$swap_total" && -n "$swap_used" && "$swap_total" -gt 0 ]]; then
 761:             swap_percent=$(( swap_used * 100 / swap_total ))
 762: 
 763:             # Warn if swap usage is high (indicates memory pressure)
 764:             if [[ $swap_percent -ge 75 ]]; then
 765:                 resource_issues+=("WARNING: High swap usage at ${swap_percent}% (memory pressure)")
 766:                 [[ $status -eq $HEALTH_OK ]] && status=$HEALTH_WARNING
 767:             fi
 768:         fi
 769:     fi
 770: 
 771:     # ==========================================================================
 772:     # INODE USAGE CHECK (Can cause issues even with free disk space)
 773:     # ==========================================================================
 774: 
 775:     for mount_point in "${critical_mounts[@]}"; do
 776:         if [[ -d "$mount_point" ]]; then
 777:             local inode_usage
 778:             inode_usage=$(df -i "$mount_point" 2>/dev/null | awk 'NR==2 {gsub(/%/,"",$5); print $5}')
 779: 
 780:             if [[ -n "$inode_usage" && "$inode_usage" =~ ^[0-9]+$ ]]; then
 781:                 if [[ $inode_usage -ge 95 ]]; then
 782:                     resource_issues+=("CRITICAL: $mount_point inode usage at ${inode_usage}%")
 783:                     status=$HEALTH_ERROR
 784:                 elif [[ $inode_usage -ge 85 ]]; then
 785:                     resource_issues+=("WARNING: $mount_point inode usage at ${inode_usage}%")
 786:                     [[ $status -eq $HEALTH_OK ]] && status=$HEALTH_WARNING
 787:                 fi
 788:             fi
 789:         fi
 790:     done
 791: 
 792:     # Store results
 793:     if [[ ${#resource_issues[@]} -gt 0 ]]; then
 794:         NFTBAN_HEALTH_ISSUES["resources"]="${resource_issues[*]}"
 795:         if [[ $status -eq $HEALTH_ERROR ]]; then
 796:             NFTBAN_HEALTH_ERRORS+=("Resource issues: ${resource_issues[*]}")
 797:         else
 798:             NFTBAN_HEALTH_WARNINGS+=("Resource warnings: ${resource_issues[*]}")
 799:         fi
 800:     else
 801:         NFTBAN_HEALTH_ISSUES["resources"]="All resources within normal limits"
 802:     fi
 803: 
 804:     NFTBAN_HEALTH_RESULTS["resources"]=$status
 805:     return "$status"
 806: }

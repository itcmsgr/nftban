1777: func execNFTBanCommand(args ...string) (string, error) {
1778: 	// Use central config for CLI path - no hardcoding
1779: 	cmd := exec.Command(getNFTBanCLI(), args...)
1780: 	output, err := cmd.CombinedOutput()
1781: 
1782: 	// Ignore netlink socket warnings - these are harmless warnings not errors
1783: 	outputStr := string(output)
1784: 	if err != nil {
1785: 		// Check if it's just netlink warnings (exit code 3 with netlink message)
1786: 		if strings.Contains(outputStr, "Unable to initialize Netlink socket") {
1787: 			// Command succeeded despite warnings, ignore the error
1788: 			return outputStr, nil
1789: 		}
1790: 		// Return output even on error so caller can check for success messages
1791: 		return outputStr, fmt.Errorf("command failed: %v (output: %s)", err, outputStr)
1792: 	}
1793: 	return outputStr, nil
1794: }

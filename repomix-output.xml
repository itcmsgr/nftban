285: // EnableMetrics enables continuous sampling (overrides session-based logic)
286: func (s *Sampler) EnableMetrics() {
287: 	s.mu.Lock()
288: 	defer s.mu.Unlock()
289: 
290: 	if s.metricsEnabled {
291: 		log.Println("[METRICS] Already enabled")
292: 		return
293: 	}
294: 
295: 	s.metricsEnabled = true
296: 	log.Println("[METRICS] Metrics mode enabled (continuous sampling)")
297: 
298: 	// Start sampler if not running
299: 	if !s.running {
300: 		s.startLocked()
301: 	}
302: }
303: 
304: // DisableMetrics disables continuous sampling (back to session-based logic)
305: func (s *Sampler) DisableMetrics() {
306: 	s.mu.Lock()
307: 	defer s.mu.Unlock()
308: 
309: 	if !s.metricsEnabled {
310: 		log.Println("[METRICS] Already disabled")
311: 		return
312: 	}
313: 
314: 	s.metricsEnabled = false
315: 	log.Println("[METRICS] Metrics mode disabled (back to session-based)")
316: 
317: 	// Stop sampler if no active sessions
318: 	if s.running && s.activeSessions == 0 {
319: 		s.stopLocked()
320: 	}
321: }

   1: #!/usr/bin/env bash
   2: # =============================================================================
   3: # NFTBan v1.0.0 - Complete Package Builder
   4: # =============================================================================
   5: # Builds RPM and DEB packages for NFTBan core components
   6: #
   7: # Usage:
   8: #   ./build_nftban.sh [deb|rpm|both]
   9: #
  10: # Packages created:
  11: #   - nftban-core     - Core binaries (nftban-core, nftban CLI)
  12: #   - nftban-libs     - Shell libraries
  13: #   - nftban-ui       - Web GUI
  14: #   - nftban-all      - Meta-package (depends on all above)
  15: #
  16: # =============================================================================
  17: 
  18: set -Eeuo pipefail
  19: 
  20: # Colors
  21: readonly RED='\033[0;31m'
  22: readonly GREEN='\033[0;32m'
  23: readonly YELLOW='\033[1;33m'
  24: readonly BLUE='\033[0;34m'
  25: readonly NC='\033[0m'

247: # =============================================================================
248: # COMMON BANNER ALIAS (for all CLI modules)
249: # =============================================================================
250: # Convenience function for CLI modules to show consistent banner
251: # Now uses unified banner with health indicator for all commands
252: # Usage: nftban_banner [mode]
253: nftban_banner() {
254:     local mode="${1:-cli}"
255:     nftban_banner_unified "$mode"
256: }
257: 
258: # =============================================================================
259: # UNIFIED BANNER WITH HEALTH INDICATOR
260: # =============================================================================
261: # Unified banner for all CLI commands with:
262: #   - Health indicator (🟢/🟠/🔴) from timer cache
263: #   - System info: Hostname, Kernel, Uptime
264: #   - Mode indicator showing current command
265: #
266: # Usage: nftban_banner_unified [mode]
267: # Example: nftban_banner_unified "status"
268: #
269: # Health cache: /var/cache/nftban/health/health_status.cache
270: # Updated by: nftban-health.timer (runs daily)
271: #
272: # See also: nftban help banner (for user documentation)
273: # =============================================================================
274: 
275: nftban_banner_unified() {
276:     local mode="${1:-cli}"
277:     local cache_file="${NFTBAN_CACHE_DIR}/health/health_status.cache"
278: 
279:     # Skip for non-interactive or JSON mode
280:     [[ "${NFTBAN_BANNER_MODE:-auto}" == "none" ]] && return 0
281:     [[ "${NFTBAN_OUTPUT_JSON:-false}" == "true" ]] && return 0
282: 
283:     # Get version
284:     local version
285:     version="$(nftban_get_version)"
286: 
287:     # Get health indicator from cache
288:     local health_icon="🟢"  # Default: healthy
289:     local health_status="OK"
290: 
291:     if [[ -f "$cache_file" ]]; then
292:         local cache_age
293:         cache_age=$(( $(date +%s) - $(stat -c %Y "$cache_file" 2>/dev/null || stat -f %m "$cache_file" 2>/dev/null || echo "0") ))
294: 
295:         # Cache valid for 2 days (172800 seconds)
296:         if [[ $cache_age -lt 172800 ]]; then
297:             health_status=$(cat "$cache_file" 2>/dev/null || echo "OK")
298:         else
299:             health_status="STALE"  # Cache expired
300:         fi
301:     else
302:         health_status="UNKNOWN"  # No cache file
303:     fi
304: 
305:     # Determine health icon
306:     case "$health_status" in
307:         OK|healthy|0)
308:             health_icon="🟢"
309:             ;;
310:         WARNING|warnings|1|STALE)
311:             health_icon="🟠"
312:             ;;
313:         ERROR|errors|2|CRITICAL|3)
314:             health_icon="🔴"
315:             ;;
316:         UNKNOWN|*)
317:             health_icon="⚪"
318:             ;;
319:     esac
320: 
321:     # Get system info
322:     local hostname kernel uptime_str
323:     hostname=$(hostname -f 2>/dev/null || hostname -s 2>/dev/null || uname -n)
324:     kernel=$(uname -r | cut -d'-' -f1-2)  # Shorten kernel version
325: 
326:     # Format uptime (compact)
327:     if [[ -f /proc/uptime ]]; then
328:         local uptime_sec
329:         uptime_sec=$(awk '{print int($1)}' /proc/uptime)
330:         local days
331:         days=$((uptime_sec / 86400))
332:         local hours
333:         hours=$(( (uptime_sec % 86400) / 3600 ))
334:         local mins
335:         mins=$(( (uptime_sec % 3600) / 60 ))
336: 
337:         if [[ $days -gt 0 ]]; then
338:             if [[ $days -gt 7 ]]; then
339:                 uptime_str="${days}d"
340:             else
341:                 uptime_str="${days}d ${hours}h"
342:             fi
343:         elif [[ $hours -gt 0 ]]; then
344:             uptime_str="${hours}h ${mins}m"
345:         else
346:             uptime_str="${mins}m"
347:         fi
348:     else
349:         uptime_str=$(uptime -p 2>/dev/null | sed 's/^up //' | head -c 20 || echo "?")
350:     fi
351: 
352:     # Get icons
353:     local icons
354:     icons="$(nftban_icon_pair)"
355: 
356:     # Build banner
357:     local width
358:     width=$((NFTBAN_WIDTH - 2))
359:     [[ $width -lt 60 ]] && width=60
360:     [[ $width -gt 70 ]] && width=70
361: 
362:     # Colors
363:     local dim="${NFTBAN_COLOR_DIM}"
364:     local reset="${NFTBAN_COLOR_RESET}"
365:     local bold="${NFTBAN_COLOR_BOLD}"
366:     local cyan="${NFTBAN_COLOR_CYAN}"
367: 
368:     # Top border (use simple ASCII for SSH compatibility)
369:     echo -e "${dim}+$(nftban_repeat_char $width '-')+${reset}"
370: 
371:     # Line 1: Icon + Health + Version + System Status
372:     local line1="${icons}  (${health_icon})  ${bold}NFTBan v${version}${reset}${dim} - System Status${reset}"
373:     printf "${dim}|${reset} %-$((width - 2))b ${dim}|${reset}\n" "$line1"
374: 
375:     # Line 2: Host, Kernel, Uptime
376:     local line2="${dim}Host: ${cyan}${hostname}${reset}${dim} | Kernel: ${kernel}${reset}"
377:     printf "${dim}|${reset} %-$((width - 2))b ${dim}|${reset}\n" "$line2"
378: 
379:     # Line 3: Uptime + Mode
380:     local line3="${dim}Uptime: ${uptime_str} | Mode: ${mode}${reset}"
381:     printf "${dim}|${reset} %-$((width - 2))b ${dim}|${reset}\n" "$line3"
382: 
383:     # Bottom border
384:     echo -e "${dim}+$(nftban_repeat_char $width '-')+${reset}"
385:     echo ""
386: }

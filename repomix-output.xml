153: // Save writes configuration to file
154: func (c *Config) Save(path string) error {
155: 	file, err := os.Create(path)
156: 	if err != nil {
157: 		return fmt.Errorf("failed to create config file: %w", err)
158: 	}
159: 	defer file.Close()
160: 
161: 	// Write configuration
162: 	fmt.Fprintf(file, "# NFTBan Web GUI Configuration\n")
163: 	fmt.Fprintf(file, "# Generated: %s\n\n", "2025-11-10")
164: 
165: 	fmt.Fprintf(file, "PORT=%d\n", c.Port)
166: 	fmt.Fprintf(file, "TLS_CERT=%s\n", c.TLSCert)
167: 	fmt.Fprintf(file, "TLS_KEY=%s\n", c.TLSKey)
168: 	fmt.Fprintf(file, "JWT_SECRET=%s\n", c.JWTSecret)
169: 	fmt.Fprintf(file, "SESSION_TIMEOUT=%d\n", c.SessionTimeout)
170: 	fmt.Fprintf(file, "IP_WHITELIST_FILE=%s\n", c.IPWhitelistFile)
171: 	fmt.Fprintf(file, "AUDIT_LOG_FILE=%s\n", c.AuditLogFile)
172: 	fmt.Fprintf(file, "REQUIRED_GROUP=%s\n", c.RequiredGroup)
173: 	fmt.Fprintf(file, "BLOCK_ROOT_LOGIN=%t\n", c.BlockRootLogin)
174: 	fmt.Fprintf(file, "MAX_LOGIN_ATTEMPTS=%d\n", c.MaxLoginAttempts)
175: 	fmt.Fprintf(file, "LOCKOUT_DURATION=%d\n", c.LockoutDuration)
176: 
177: 	return nil
178: }

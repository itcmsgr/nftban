# =============================================================================

[Unit]
Description=NFTBan Task Queue Processor
Documentation=man:nftban(8)
After=network.target nftables.service
# Alert on failure (uses template unit)
OnFailure=nftban-alert@%n.service

[Service]
Type=oneshot
ExecStart=/usr/lib/nftban/sbin/nftban-queue-processor
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nftban-queue

# Run as unprivileged nftban user
User=nftban
Group=nftban

# Resource limits
MemoryMax=256M
TasksMax=50

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
PrivateDevices=yes
RestrictNamespaces=true
LockPersonality=true
RestrictSUIDSGID=true
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/nftban /var/log/nftban /var/cache/nftban /run/nftban

# Timeout after 15 minutes
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target

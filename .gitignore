# =============================================================================
# NFTBan .gitignore
# =============================================================================

# Build artifacts
bin/
dist/
build/
# Exception: FHS spec files are tracked
!build/fhs-spec.yaml
!build/generate-fhs-outputs.sh
*.o
*.a

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test artifacts
*.test
*.out
coverage.html
coverage.txt

# IDE and editor
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Claude Code (local dev settings)
.claude/

# Local environment
.env
.env.local
*.local
# Exception: Track .conf.local templates in source tree (shipped as empty templates)
!etc/nftban/conf.d/**/*.local

# Node modules (for web UI)
node_modules/

# Temporary files
*.tmp
*.temp
*.log
*.bak

# Package artifacts
*.rpm
*.deb
*.tar.gz
*.tgz

# Go daemon binary
nftband

# Debug
*.debug
__debug_bin

# Local test data
*.mmdb
GeoLite2-*.mmdb

# Config files with secrets (examples are ok)
/etc/nftban/*.conf
!/etc/nftban/*.conf.example
bin/
dist/

# Repomix analysis files
repomix*.json
repomix*.xml

262: function updateAnalyticsCharts(countries) {
263:     if (!countries || countries.length === 0) return;
264: 
265:     // Sort by IP count descending
266:     const sorted = [...countries].sort((a, b) => b.ip_count - a.ip_count);
267: 
268:     // Top 10 for bar chart
269:     const top10 = sorted.slice(0, 10);
270: 
271:     if (countriesChart) {
272:         countriesChart.data.labels = top10.map(c => getCountryFlag(c.country) + ' ' + c.country);
273:         countriesChart.data.datasets[0].data = top10.map(c => c.ip_count);
274:         countriesChart.update();
275:     }
276: 
277:     // Top 8 for pie chart (+ "Others" category)
278:     const top8 = sorted.slice(0, 8);
279:     const othersCount = sorted.slice(8).reduce((sum, c) => sum + c.ip_count, 0);
280: 
281:     if (distributionChart) {
282:         const labels = top8.map(c => c.country);
283:         const data = top8.map(c => c.ip_count);
284: 
285:         if (othersCount > 0) {
286:             labels.push('Others');
287:             data.push(othersCount);
288:         }
289: 
290:         distributionChart.data.labels = labels;
291:         distributionChart.data.datasets[0].data = data;
292:         distributionChart.update();
293:     }
294: }
295: 
296: function updateCountriesTable(countries) {
297:     if (!countries || countries.length === 0) {
298:         document.getElementById('countries-table-body').innerHTML = `
299:             <tr><td colspan="5" style="text-align: center; padding: 20px; color: var(--text-muted);">
300:                 No analytics data available
301:             </td></tr>
302:         `;
303:         return;
304:     }
305: 
306:     // Calculate total for percentages
307:     const total = countries.reduce((sum, c) => sum + c.ip_count, 0);
308: 
309:     // Sort by IP count descending
310:     const sorted = [...countries].sort((a, b) => b.ip_count - a.ip_count);
311: 
312:     // Build table rows
313:     const rows = sorted.map((country, index) => {
314:         const percentage = ((country.ip_count / total) * 100).toFixed(1);
315:         const lastUpdated = country.last_updated ?
316:             new Date(country.last_updated).toLocaleString() : '-';
317: 
318:         return `
319:             <tr style="border-bottom: 1px solid var(--border-color);">
320:                 <td style="padding: 10px;">#${index + 1}</td>
321:                 <td style="padding: 10px;">${getCountryFlag(country.country)} ${country.country}</td>
322:                 <td style="padding: 10px; text-align: right; font-weight: bold;">${country.ip_count}</td>
323:                 <td style="padding: 10px; text-align: right;">${percentage}%</td>
324:                 <td style="padding: 10px; color: var(--text-muted);">${lastUpdated}</td>
325:             </tr>
326:         `;
327:     }).join('');
328: 
329:     document.getElementById('countries-table-body').innerHTML = rows;
330: }
331: 
332: function showPlaceholderData() {
333:     // Show placeholder/example data when API is not available
334:     console.log('[ANALYTICS] Showing placeholder data');
335: 
336:     document.getElementById('analytics-total-ips').textContent = '0';
337:     document.getElementById('analytics-total-countries').textContent = '0';
338:     document.getElementById('analytics-ipv4-count').textContent = '0';
339:     document.getElementById('analytics-ipv6-count').textContent = '0';
340:     document.getElementById('analytics-last-updated').textContent = 'Never';
341:     document.getElementById('analytics-status').textContent = 'No Data';
342:     document.getElementById('analytics-status').className = 'text-warning fw-bold';
343: 
344:     document.getElementById('countries-table-body').innerHTML = `
345:         <tr><td colspan="5" style="text-align: center; padding: 20px; color: var(--text-muted);">
346:             Analytics data not available. Ban some IPs to see statistics here.
347:         </td></tr>
348:     `;
349: }

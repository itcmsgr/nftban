237: # ==============================================================================
238: # Helper: Set backend in config
239: # ==============================================================================
240: _set_metrics_backend() {
241:     local backend="$1"
242: 
243:     if [[ ! -f "${NFTBAN_CONFIG_DIR}/nftban.conf" ]]; then
244:         mkdir -p "${NFTBAN_CONFIG_DIR}"
245:         touch "${NFTBAN_CONFIG_DIR}/nftban.conf"
246:     fi
247: 
248:     if grep -q "^NFTBAN_METRICS_BACKEND=" "${NFTBAN_CONFIG_DIR}/nftban.conf" 2>/dev/null; then
249:         sed -i "s|^NFTBAN_METRICS_BACKEND=.*|NFTBAN_METRICS_BACKEND=\"${backend}\"|" "${NFTBAN_CONFIG_DIR}/nftban.conf"
250:     else
251:         echo "NFTBAN_METRICS_BACKEND=\"${backend}\"" >> "${NFTBAN_CONFIG_DIR}/nftban.conf"
252:     fi
253: 
254:     # Also set metrics mode to true
255:     if grep -q "^NFTBAN_METRICS_MODE=" "${NFTBAN_CONFIG_DIR}/nftban.conf" 2>/dev/null; then
256:         sed -i 's|^NFTBAN_METRICS_MODE=.*|NFTBAN_METRICS_MODE="true"|' "${NFTBAN_CONFIG_DIR}/nftban.conf"
257:     else
258:         echo 'NFTBAN_METRICS_MODE="true"' >> "${NFTBAN_CONFIG_DIR}/nftban.conf"
259:     fi
260: }

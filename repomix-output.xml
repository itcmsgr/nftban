469:     for arg in "$@"; do
470:         [[ "$arg" == "--json" ]] && json_mode=true && break
471:     done
472: 
473:     shift || true
474: 
475:     case "$action" in
476:         select)
477:             # Check CAP_NET_ADMIN capability for nftables modifications
478:             if declare -F nftban_require_net_admin_or_exit >/dev/null 2>&1; then
479:                 nftban_require_net_admin_or_exit
480:             fi
481:             nftban_feeds_select
482:             ;;
483:         list)
484:             nftban_feeds_list "$@"
485:             ;;
486:         enable)
487:             # Check CAP_NET_ADMIN capability for nftables modifications
488:             if declare -F nftban_require_net_admin_or_exit >/dev/null 2>&1; then
489:                 nftban_require_net_admin_or_exit
490:             fi
491:             if [[ $# -lt 1 ]] || [[ "${1}" == "--json" ]]; then
492:                 if [[ "$json_mode" == "true" ]] && declare -f json_output >/dev/null 2>&1; then
493:                     json_output "false" '{}' "Usage: nftban feeds enable <feed_name>"
494:                 else
495:                     echo "ERROR: Usage: nftban feeds enable <feed_name>" >&2
496:                 fi
497:                 exit 1
498:             fi
499:             nftban_feeds_enable_json "$1" "$json_mode"
500:             ;;
501:         disable)
502:             # Check CAP_NET_ADMIN capability for nftables modifications
503:             if declare -F nftban_require_net_admin_or_exit >/dev/null 2>&1; then
504:                 nftban_require_net_admin_or_exit
505:             fi
506:             if [[ $# -lt 1 ]] || [[ "${1}" == "--json" ]]; then
507:                 if [[ "$json_mode" == "true" ]] && declare -f json_output >/dev/null 2>&1; then
508:                     json_output "false" '{}' "Usage: nftban feeds disable <feed_name>"
509:                 else
510:                     echo "ERROR: Usage: nftban feeds disable <feed_name>" >&2
511:                 fi
512:                 exit 1
513:             fi
514:             nftban_feeds_disable_json "$1" "$json_mode"
515:             ;;
516:         enable-cat|enable-category)
517:             # Check CAP_NET_ADMIN capability for nftables modifications
518:             if declare -F nftban_require_net_admin_or_exit >/dev/null 2>&1; then
519:                 nftban_require_net_admin_or_exit
520:             fi
521:             if [[ $# -lt 1 ]]; then
522:                 echo "ERROR: Usage: nftban feeds enable-category <category>" >&2
523:                 exit 1
524:             fi
525:             local cat_feeds
526:             cat_feeds=$(nftban_feeds_get_by_category "$1")
527: 
528:             if [[ -z "$cat_feeds" ]]; then
529:                 echo "⚠️  No feeds found in category: $1"
530:                 echo ""
531:                 echo "Available categories: protection, ssh, web, email, anonymity"
532:                 echo ""
533:                 echo "Run 'nftban feeds list' to see all feeds by category"
534:                 exit 1
535:             fi
536: 
537:             echo "⏳ Enabling all feeds in category: $1"
538:             echo ""
539:             local enabled_count=0
540:             local failed_count=0
541: 
542:             for feed in $cat_feeds; do
543:                 echo "  • Enabling $feed..."
544:                 if nftban_feeds_enable "$feed" "true"; then  # Use quiet mode for batch
545:                     echo "    ✅ $feed enabled"
546:                     ((enabled_count++))
547:                 else
548:                     echo "    ❌ $feed failed"
549:                     ((failed_count++))
550:                 fi
551:             done
552: 
553:             echo ""
554:             echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
555:             if [[ $failed_count -eq 0 ]]; then
556:                 echo "✅ Successfully enabled and downloaded $enabled_count feed(s) in category '$1'"
557:             else
558:                 echo "✅ Enabled $enabled_count feed(s), ❌ Failed $failed_count feed(s)"
559:                 echo "⚠️  Check errors in: ${NFTBAN_LOG_DIR:-/var/log/nftban}/feeds.log"
560:             fi
561:             echo ""
562:             echo "Check status: nftban feeds status"
563:             echo ""
564:             ;;
565:         update)
566:             # Check CAP_NET_ADMIN capability for nftables modifications
567:             if declare -F nftban_require_net_admin_or_exit >/dev/null 2>&1; then
568:                 nftban_require_net_admin_or_exit
569:             fi
570:             # Use Go binary for feeds update (dynamic, central architecture)
571:             if [[ -x "${NFTBAN_CORE_BIN:-${NFTBAN_LIB_DIR}/bin/nftban-core}" ]]; then
572:                 "${NFTBAN_CORE_BIN:-${NFTBAN_LIB_DIR}/bin/nftban-core}" feeds update
573:             else
574:                 # Fallback to bash implementation
575:                 nftban_feeds_update_json "$json_mode" "$@"
576:             fi
577:             ;;
578:         status)
579:             nftban_feeds_status_json "$json_mode"
580:             ;;
581:         help|--help|-h)
582:             _nftban_feeds_help
583:             ;;
584:         *)
585:             echo "ERROR: Unknown feeds action: $action" >&2
586:             _nftban_feeds_help
587:             exit 1
588:             ;;
589:     esac
590: }

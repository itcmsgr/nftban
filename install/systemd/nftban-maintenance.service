# meta:type="systemd"
# meta:owner="Antonios Voulvoulis <contact@nftban.com>"
# meta:created_date="2025-10-26"
# meta:description="Critical maintenance tasks that run even when NFTBan is disabled"
# meta:input="None"
# meta:output="Systemd unit"
# meta:depends=""
# meta:inventory.files=""
# meta:inventory.binaries="/usr/lib/nftban/cron/maintenance.sh"
# meta:inventory.env_vars=""
# meta:inventory.config_files=""
# meta:inventory.systemd_units="nftban-maintenance.timer"
# meta:inventory.network=""
# meta:inventory.privileges="root"
# =============================================================================
#
# This service performs safety-critical checks:
#   - SSH port monitoring (prevents lockout)
#   - System IP monitoring (updates whitelists)
#   - Autoheal (fixes permissions, creates directories)
#   - Configuration validation
#
# SECURITY NOTE: Runs as root because it must write to /etc/nftban/ for:
#   - ports.d and whitelist.d: SSH lockout prevention (safety-critical)
#   - nftables.conf + .nftables.conf.tmp: firewall reload/rebuild via autoheal
# /etc must remain root-owned (not group-writable by nftban) per FHS standards.
# Strict sandboxing limits root to only necessary paths.
#
# Runs every 15 minutes via nftban-maintenance.timer
# =============================================================================

[Unit]
Description=NFTBan Maintenance Service (Safety Checks)
Documentation=https://nftban.com/docs/maintenance
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot

# Run as root for /etc writes (safety-critical SSH lockout prevention)
# Security is enforced via strict sandboxing below
User=root
Group=root

# Run maintenance script with flock to prevent overlap
ExecStart=/usr/bin/flock -n /run/nftban/maintenance.lock /usr/lib/nftban/cron/maintenance.sh

# =============================================================================
# SECURITY HARDENING (strict sandboxing for root service)
# =============================================================================

# Core hardening (applies even when running as root)
NoNewPrivileges=yes
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

# Minimal filesystem access - root can only write to these paths
# /etc/nftban: firewall reload/rebuild writes .nftables.conf.tmp + rendered nftables.conf
# /etc/nftban/ports.d and /etc/nftban/whitelist.d: SSH lockout prevention
# /var/lib/nftban, /var/log/nftban, /var/cache/nftban, /run/nftban: normal state
ReadWritePaths=/var/lib/nftban /var/log/nftban /var/cache/nftban /run/nftban /etc/nftban /etc/nftban/ports.d /etc/nftban/whitelist.d

# Network access (IPC socket + curl for SSH port detection)
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Resource limits
CPUQuota=50%
MemoryMax=256M
TasksMax=20

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nftban-maintenance

# Restart on failure
Restart=on-failure
RestartSec=5min

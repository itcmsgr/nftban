 37: #        POP3S(995), cPanel Webmail(2077), cPanel Webmail SSL(2078),
 38: #        cPanel CalDAV(2079), cPanel WebDAV(2080), cPanel(2082),
 39: #        cPanel SSL(2083), WHM(2086), WHM SSL(2087), Webmail(2095),
 40: #        Webmail SSL(2096), WebSocket(8443)
 41: # NOTE: Port 22 (SSH) excluded - managed automatically as safety port
 42: NFTBAN_CPANEL_TCP_IN="20,21,25,53,80,110,143,443,465,587,993,995,2077,2078,2079,2080,2082,2083,2086,2087,2095,2096,8443"

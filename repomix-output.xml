465: 	})
466: 
467: 
468: 	// Serve index.html at root
469: 	router.HandleFunc("/", func(w http.ResponseWriter, r *http.Request) {
470: 		if r.URL.Path == "/" || r.URL.Path == "/index.html" {
471: 			data, err := readFile("web/static/index.html")
472: 			if err != nil {
473: 				http.Error(w, "Not found", http.StatusNotFound)
474: 				return
475: 			}
476: 			w.Header().Set("Content-Type", "text/html; charset=utf-8")
477: 			w.Header().Set("Cache-Control", "no-cache, no-store, must-revalidate")
478: 			w.Header().Set("Pragma", "no-cache")
479: 			w.Header().Set("Expires", "0")
480: 			w.Write(data)
481: 			return
482: 		}
483: 		http.Error(w, "Not found", http.StatusNotFound)
484: 	})
485: 
486: 	// Server configuration with safety limits
487: 	addr := fmt.Sprintf(":%d", cfg.Port)
488: 	requestTimeout := time.Duration(limits.RequestTimeoutSec) * time.Second
489: 	server := &http.Server{
490: 		Addr:           addr,
491: 		Handler:        router,
492: 		ReadTimeout:    requestTimeout,
493: 		WriteTimeout:   requestTimeout,
494: 		IdleTimeout:    60 * time.Second,
495: 		MaxHeaderBytes: 1 << 20, // 1 MB
496: 	}
497: 
498: 	// Log sampler status
499: 	samplerStatus := sampler.GetStatus()
500: 	log.Printf("[METRICS] Global sampler initialized: running=%v, sessions=%d, period=%v",
501: 		samplerStatus["running"], samplerStatus["active_sessions"], samplerStatus["period_seconds"])
502: 
503: 	// Start server
504: 	log.Printf("%s v%s starting on https://0.0.0.0:%d", AppName, Version, cfg.Port)
505: 	log.Printf("TLS Certificate: %s", cfg.TLSCert)
506: 	log.Printf("TLS Key: %s", cfg.TLSKey)
507: 	log.Printf("Request Timeout: %v, Max Connections: %d", requestTimeout, limits.MaxConcurrentConns)
508: 
509: 	if err := server.ListenAndServeTLS(cfg.TLSCert, cfg.TLSKey); err != nil {
510: 		log.Fatalf("Server failed to start: %v", err)
511: 	}
512: }

470: func LoginMonitorUsersHandler(w http.ResponseWriter, r *http.Request) {
471: 	users := aggregateUserStats()
472: 
473: 	respondJSON(w, http.StatusOK, map[string]interface{}{
474: 		"success": true,
475: 		"data": map[string]interface{}{
476: 			"users": users,
477: 		},
478: 	})

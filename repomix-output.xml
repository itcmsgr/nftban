605: 
606:         # Add apply task to queue (processed by systemd timer every 2 minutes)
607:         # ARCHITECTURE COMPLIANCE: Always use timer-based queue for nftables sync
608:         # NEVER execute synchronous sync - all feeds/ban/unban/countries managed by timer
609:         # This prevents 30+ second hangs with large IP sets and respects async architecture
610:         nftban_queue_add "geoban_apply" "Countries unbanned: $*" >/dev/null 2>&1
611: 
612:         nftban_info "✅ GeoBan configured successfully"
613:         nftban_info "   NFTables update queued (processed every 2 minutes)"
614:         nftban_info "   Check queue: tail -f ${NFTBAN_LOG_DIR}/queue.log"
615:         echo ""
616:     fi
617: 
618:     [[ ${failed} -eq 0 ]] && return 0 || return 1
619: }

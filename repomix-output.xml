 447: # Helper function: Check if CloudFlare is enabled (via trust command)
 448: _nftban_panel_check_cloudflare() {
 449:     # Check if CLOUDFLARE is enabled in trust feeds
 450:     # First try new trust command, fallback to legacy cloudflare command
 451:     local status_output
 452:     status_output=$(nftban-core trust list 2>/dev/null) || true
 453:     if echo "$status_output" | grep -q 'CLOUDFLARE.*enabled'; then
 454:         return 0
 455:     fi
 456:     # Fallback: check legacy cloudflare command
 457:     status_output=$(nftban cloudflare status 2>/dev/null) || true
 458:     echo "$status_output" | grep -q 'Master switch: true'
 459: }

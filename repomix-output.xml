  3: 
  4: package main
  5: 
  6: import (
  7: 	"encoding/json"
  8: 	"fmt"
  9: 	"os"
 10: 	"sort"
 11: 	"strconv"
 12: 	"strings"
 13: 	"text/tabwriter"
 14: 
 15: 	"github.com/itcmsgr/nftban/pkg/analytics"
 16: )
 17: 
 18: func cmdAnalytics(action string) error {
 19: 	st := analytics.StateOrNil()
 20: 	if st == nil {
 21: 		return fmt.Errorf("analytics state not initialized")
 22: 	}
 23: 
 24: 	switch action {
 25: 	case "summary":
 26: 		return cmdAnalyticsSummary()
 27: 	case "countries":
 28: 		return cmdAnalyticsCountries()
 29: 	case "top":
 30: 		return cmdAnalyticsTop()
 31: 	case "ip":
 32: 		return cmdAnalyticsIP()
 33: 	default:
 34: 		return fmt.Errorf("unknown analytics action: %s\nUsage: nftban-core analytics [summary|countries|top|ip]", action)
 35: 	}
 36: }
 37: 
 38: // cmdAnalyticsSummary shows overall analytics summary.
 39: // Usage: nftban-core analytics summary [--json]
 40: func cmdAnalyticsSummary() error {
 41: 	st := analytics.StateOrNil()
 42: 	if st == nil {
 43: 		return fmt.Errorf("analytics not initialized")
 44: 	}
 45: 
 46: 	jsonOutput := hasFlag("--json")
 47: 
 48: 	summary := st.GetSummary()
 49: 
 50: 	if jsonOutput {
 51: 		data, err := json.MarshalIndent(summary, "", "  ")
 52: 		if err != nil {
 53: 			return err
 54: 		}
 55: 		fmt.Println(string(data))
 56: 		return nil
 57: 	}
 58: 
 59: 	// Human-readable output
 60: 	fmt.Println("📊 NFTBan Analytics Summary")
 61: 	fmt.Println(strings.Repeat("=", 70))
 62: 	fmt.Println()
 63: 	fmt.Printf("Total Banned IPs:     %d\n", summary.TotalIPs)
 64: 	fmt.Printf("Total Countries:      %d\n", summary.TotalCountries)
 65: 	if !summary.LastUpdated.IsZero() {
 66: 		fmt.Printf("Last Updated:         %s\n", summary.LastUpdated.Format("2006-01-02 15:04:05"))
 67: 	}
 68: 	fmt.Println()
 69: 
 70: 	return nil
 71: }
 72: 
 73: // cmdAnalyticsCountries lists all countries with ban counts.
 74: // Usage: nftban-core analytics countries [--json]
 75: func cmdAnalyticsCountries() error {
 76: 	st := analytics.StateOrNil()
 77: 	if st == nil {
 78: 		return fmt.Errorf("analytics not initialized")
 79: 	}
 80: 
 81: 	jsonOutput := hasFlag("--json")
 82: 
 83: 	stats := st.GetCountryStats()
 84: 
 85: 	if jsonOutput {
 86: 		data, err := json.MarshalIndent(stats, "", "  ")
 87: 		if err != nil {
 88: 			return err
 89: 		}
 90: 		fmt.Println(string(data))
 91: 		return nil
 92: 	}
 93: 
 94: 	// Human-readable table output
 95: 	fmt.Println("🌍 Banned IPs by Country")
 96: 	fmt.Println(strings.Repeat("=", 70))
 97: 	fmt.Println()
 98: 
 99: 	w := tabwriter.NewWriter(os.Stdout, 0, 4, 2, ' ', 0)
100: 	fmt.Fprintln(w, "COUNTRY\tIP COUNT\tLAST UPDATED")
101: 	fmt.Fprintln(w, strings.Repeat("-", 60))
102: 
103: 	type row struct {
104: 		country string
105: 		count   int
106: 		updated string
107: 	}
108: 	var rows []row
109: 	for _, cs := range stats {
110: 		rows = append(rows, row{
111: 			country: cs.Country,
112: 			count:   cs.IPCount,
113: 			updated: cs.LastUpdated.Format("2006-01-02 15:04"),
114: 		})
115: 	}
116: 
117: 	// Sort by count descending
118: 	sort.Slice(rows, func(i, j int) bool {
119: 		return rows[i].count > rows[j].count
120: 	})
121: 
122: 	for _, r := range rows {
123: 		fmt.Fprintf(w, "%s\t%d\t%s\n", r.country, r.count, r.updated)
124: 	}
125: 
126: 	w.Flush()
127: 	fmt.Println()
128: 
129: 	return nil
130: }
131: 
132: // cmdAnalyticsTop shows top N countries by IP count.
133: // Usage: nftban-core analytics top [N] [--json]
134: func cmdAnalyticsTop() error {
135: 	st := analytics.StateOrNil()
136: 	if st == nil {
137: 		return fmt.Errorf("analytics not initialized")
138: 	}
139: 
140: 	// Parse N from args
141: 	n := 10 // default
142: 	for i, arg := range os.Args {
143: 		if arg == "top" && i+1 < len(os.Args) {
144: 			nextArg := os.Args[i+1]
145: 			if !strings.HasPrefix(nextArg, "--") {
146: 				if val, err := strconv.Atoi(nextArg); err == nil {
147: 					n = val
148: 				}
149: 			}
150: 			break
151: 		}
152: 	}
153: 
154: 	jsonOutput := hasFlag("--json")
155: 
156: 	topCountries := st.GetTopCountries(n)
157: 
158: 	if jsonOutput {
159: 		result := map[string]interface{}{
160: 			"success":       true,
161: 			"count":         len(topCountries),
162: 			"top_countries": topCountries,
163: 		}
164: 		data, err := json.MarshalIndent(result, "", "  ")
165: 		if err != nil {
166: 			return err
167: 		}
168: 		fmt.Println(string(data))
169: 		return nil
170: 	}
171: 
172: 	// Human-readable output
173: 	fmt.Printf("🏆 Top %d Countries by Banned IPs\n", n)
174: 	fmt.Println(strings.Repeat("=", 70))
175: 	fmt.Println()
176: 
177: 	w := tabwriter.NewWriter(os.Stdout, 0, 4, 2, ' ', 0)
178: 	fmt.Fprintln(w, "RANK\tCOUNTRY\tIP COUNT")
179: 	fmt.Fprintln(w, strings.Repeat("-", 50))
180: 
181: 	for i, cs := range topCountries {
182: 		fmt.Fprintf(w, "%d\t%s\t%d\n", i+1, cs.Country, cs.IPCount)
183: 	}
184: 
185: 	w.Flush()
186: 	fmt.Println()
187: 
188: 	return nil
189: }
190: 
191: // cmdAnalyticsIP looks up analytics data for a specific IP.
192: // Usage: nftban-core analytics ip <IP> [--json]
193: func cmdAnalyticsIP() error {
194: 	st := analytics.StateOrNil()
195: 	if st == nil {
196: 		return fmt.Errorf("analytics not initialized")
197: 	}
198: 
199: 	// Find IP argument
200: 	var ip string
201: 	for i, arg := range os.Args {
202: 		if arg == "ip" && i+1 < len(os.Args) {
203: 			ip = os.Args[i+1]
204: 			break
205: 		}
206: 	}
207: 
208: 	if ip == "" {
209: 		return fmt.Errorf("usage: nftban-core analytics ip <IP> [--json]")
210: 	}
211: 
212: 	jsonOutput := hasFlag("--json")
213: 
214: 	origin, found := st.GetIPOrigin(ip)
215: 
216: 	result := &analytics.IPLookupResult{
217: 		Success: true,
218: 		IP:      ip,
219: 		Found:   found,
220: 		Origin:  origin,
221: 	}
222: 
223: 	if !found {
224: 		result.Message = "IP not found in analytics database"
225: 	}
226: 
227: 	if jsonOutput {
228: 		data, err := json.MarshalIndent(result, "", "  ")
229: 		if err != nil {
230: 			return err
231: 		}
232: 		fmt.Println(string(data))
233: 		return nil
234: 	}
235: 
236: 	// Human-readable output
237: 	fmt.Printf("🔍 Analytics for IP: %s\n", ip)
238: 	fmt.Println(strings.Repeat("=", 70))
239: 	fmt.Println()
240: 
241: 	if !found {
242: 		fmt.Println("❌ IP not found in analytics database")
243: 		fmt.Println()
244: 		fmt.Println("This IP has not been banned, or analytics were not enabled when it was banned.")
245: 		fmt.Println()
246: 		return nil
247: 	}
248: 
249: 	fmt.Printf("IP Address:   %s\n", origin.IP)
250: 	fmt.Printf("Country:      %s\n", origin.Country)
251: 	if origin.City != "" {
252: 		fmt.Printf("City:         %s\n", origin.City)
253: 	}
254: 	fmt.Printf("Banned At:    %s\n", origin.BannedAt.Format("2006-01-02 15:04:05"))
255: 	if origin.Jail != "" {
256: 		fmt.Printf("Jail:         %s\n", origin.Jail)
257: 	}
258: 	if origin.Reason != "" {
259: 		fmt.Printf("Reason:       %s\n", origin.Reason)
260: 	}
261: 	fmt.Println()
262: 
263: 	return nil
264: }
265: 
266: // hasFlag checks if a flag exists in os.Args.
267: func hasFlag(flag string) bool {
268: 	for _, arg := range os.Args {
269: 		if arg == flag {
270: 			return true
271: 		}
272: 	}
273: 	return false
274: }
</file>

<file path="cmd/nftban-core/cmd_ban.go">
  1: package main
  2: 
  3: import (
  4: 	"fmt"
  5: 	"strings"
  6: 	"time"
  7: 
  8: 	"github.com/google/nftables"
  9: 	"github.com/itcmsgr/nftban/pkg/analytics"
 10: 	"github.com/itcmsgr/nftban/pkg/banlog"
 11: 	"github.com/itcmsgr/nftban/pkg/blacklist"
 12: 	"github.com/itcmsgr/nftban/pkg/geoip"
 13: 	"github.com/itcmsgr/nftban/pkg/nftbanconf"
 14: 	"github.com/itcmsgr/nftban/pkg/persistent"
 15: 	"github.com/itcmsgr/nftban/pkg/sync"
 16: 	"github.com/itcmsgr/nftban/pkg/version"
 17: 	"github.com/itcmsgr/nftban/pkg/whitelist"
 18: )
 19: 
 20: // getBanConfigDir returns the config directory from passed config
 21: func getBanConfigDir(cfg *nftbanconf.Config) string {
 22: 	return cfg.ConfigDir
 23: }
 24: 
 25: // formatDuration converts seconds to human-readable format
 26: func formatDuration(seconds int) string {
 27: 	if seconds < 60 {
 28: 		return fmt.Sprintf("%ds", seconds)
 29: 	} else if seconds < 3600 {
 30: 		return fmt.Sprintf("%dm", seconds/60)
 31: 	} else if seconds < 86400 {
 32: 		hours := seconds / 3600
 33: 		mins := (seconds % 3600) / 60
 34: 		if mins > 0 {
 35: 			return fmt.Sprintf("%dh%dm", hours, mins)
 36: 		}
 37: 		return fmt.Sprintf("%dh", hours)
 38: 	}
 39: 	days := seconds / 86400
 40: 	hours := (seconds % 86400) / 3600
 41: 	if hours > 0 {
 42: 		return fmt.Sprintf("%dd%dh", days, hours)
 43: 	}
 44: 	return fmt.Sprintf("%dd", days)
 45: }
 46: 
 47: func cmdBan(ipStr string, reason string, source string, timeoutSeconds int, cfg *nftbanconf.Config) error {
 48: 	// Check for privilege (root OR CAP_NET_ADMIN capability)
 49: 	if err := checkPrivilege(); err != nil {
 50: 		return err
 51: 	}
 52: 
 53: 	fmt.Printf("%s: %s\n", version.BannerWithEmoji("🛡️", "Ban IP"), ipStr)
 54: 	fmt.Println(strings.Repeat("=", 70))
 55: 	fmt.Println()
 56: 
 57: 	// Validate IP
 58: 	fmt.Println("Step 1: Validating IP address...")
 59: 	normalizedIP, isIPv4, err := blacklist.ValidateIP(ipStr)
 60: 	if err != nil {
 61: 		return fmt.Errorf("invalid IP: %w", err)
 62: 	}
 63: 	ipType := "IPv6"
 64: 	if isIPv4 {
 65: 		ipType = "IPv4"
 66: 	}
 67: 	fmt.Printf("  ✅ Valid %s address: %s\n", ipType, normalizedIP)
 68: 	fmt.Println()
 69: 
 70: 	// Check if IP is whitelisted
 71: 	fmt.Println("Step 2: Checking whitelist...")
 72: 	configDir := getBanConfigDir(cfg)
 73: 	whitelistIPv4, whitelistIPv6, err := whitelist.LoadAllWhitelists(configDir)
 74: 	if err != nil {
 75: 		return fmt.Errorf("failed to load whitelists: %w", err)
 76: 	}
 77: 
 78: 	if isIPv4 {
 79: 		if whitelistIPv4[normalizedIP] {
 80: 			return fmt.Errorf("IP %s is whitelisted, cannot ban", normalizedIP)
 81: 		}
 82: 	} else {
 83: 		if whitelistIPv6[normalizedIP] {
 84: 			return fmt.Errorf("IP %s is whitelisted, cannot ban", normalizedIP)
 85: 		}
 86: 	}
 87: 	fmt.Printf("  ✅ IP is not whitelisted\n")
 88: 	fmt.Println()
 89: 
 90: 	// Check if already banned
 91: 	fmt.Println("Step 3: Checking if already banned...")
 92: 	blacklistIPv4, blacklistIPv6, err := blacklist.LoadAllBlacklists(configDir)
 93: 	if err != nil {
 94: 		return fmt.Errorf("failed to load blacklists: %w", err)
 95: 	}
 96: 
 97: 	alreadyBanned := false
 98: 	if isIPv4 {
 99: 		alreadyBanned = blacklistIPv4[normalizedIP]
100: 	} else {
101: 		alreadyBanned = blacklistIPv6[normalizedIP]
102: 	}
103: 
104: 	// Step 4: Check for persistent offender (fail2ban only)
105: 	shouldEscalate := false
106: 	jailName := ""
107: 
108: 	if timeoutSeconds > 0 && source == "fail2ban" {
109: 		// Extract jail name from reason (format: "fail2ban: jail-name")
110: 		if strings.HasPrefix(reason, "fail2ban: ") {
111: 			jailName = strings.TrimPrefix(reason, "fail2ban: ")
112: 		}
113: 
114: 		// Check if this IP should escalate to permanent
115: 		escalate, err := checkPersistentOffender(configDir, normalizedIP, jailName)
116: 		if err != nil {
117: 			fmt.Printf("  ⚠️  Warning: Failed to check persistent offender status: %v\n", err)
118: 		} else if escalate {
119: 			shouldEscalate = true
120: 			fmt.Println()
121: 			fmt.Println("🚨 PERSISTENT OFFENDER DETECTED")
122: 			fmt.Printf("  ⚠️  This IP has exceeded the ban threshold\n")
123: 			fmt.Printf("  🔒 Escalating to PERMANENT ban\n")
124: 			fmt.Println()
125: 			// Override: make it permanent
126: 			timeoutSeconds = 0
127: 		}
128: 	}
129: 
130: 	// Step 5: Add to appropriate location
131: 	fmt.Println("Step 5: Adding ban...")
132: 
133: 	if timeoutSeconds > 0 {
134: 		// Temporary ban - add directly to NFT with timeout (no config file)
135: 		fmt.Printf("  ⏱️  Temporary ban: %d seconds (%s)\n", timeoutSeconds, formatDuration(timeoutSeconds))
136: 		if reason != "" {
137: 			fmt.Printf("  ✅ Reason: %s\n", reason)
138: 		}
139: 		fmt.Println()
140: 	} else {
141: 		// Permanent ban - add to config file
142: 		if alreadyBanned {
143: 			fmt.Printf("  ⚠️  IP %s is already banned\n", normalizedIP)
144: 			fmt.Println()
145: 			fmt.Println("Re-syncing to ensure nftables is up to date...")
146: 		} else {
147: 			// Determine target file based on source
148: 			banSource := source
149: 			if banSource == "" {
150: 				banSource = "manual"
151: 			}
152: 			targetFile := configDir + "/blacklist.d/99-manual.conf"
153: 			switch banSource {
154: 			case "login":
155: 				targetFile = configDir + "/blacklist.d/login-auto.conf"
156: 			case "portscan":
157: 				targetFile = configDir + "/blacklist.d/portscan-auto.conf"
158: 			case "ddos":
159: 				targetFile = configDir + "/blacklist.d/ddos-auto.conf"
160: 			}
161: 			banReason := reason
162: 
163: 			if shouldEscalate {
164: 				// Use persistent offenders file (overrides source-based file)
165: 				targetFile = configDir + "/blacklist.d/30-persistent-offenders.conf"
166: 				banReason = fmt.Sprintf("persistent offender (%s)", jailName)
167: 				banSource = "persistent"
168: 			}
169: 
170: 			if err := blacklist.AddIPWithSource(configDir, normalizedIP, banReason, banSource); err != nil {
171: 				return fmt.Errorf("failed to add to blacklist: %w", err)
172: 			}
173: 			fmt.Printf("  ✅ Added to %s\n", targetFile)
174: 			if banReason != "" {
175: 				fmt.Printf("  ✅ Reason: %s\n", banReason)
176: 			}
177: 			fmt.Println()
178: 		}
179: 	}
180: 
181: 	// Step 6: Add to nftables
182: 	fmt.Println("Step 6: Adding to nftables...")
183: 
184: 	nft, err := sync.NewNFTManager()
185: 	if err != nil {
186: 		return fmt.Errorf("failed to create nftables manager: %w", err)
187: 	}
188: 	defer nft.Close()
189: 
190: 	// Get table and set
191: 	var table *nftables.Table
192: 	var setName string
193: 	if isIPv4 {
194: 		table, err = nft.GetOrCreateTable(nftables.TableFamilyIPv4)
195: 		setName = "blacklist_ipv4"
196: 	} else {
197: 		table, err = nft.GetOrCreateTable(nftables.TableFamilyIPv6)
198: 		setName = "blacklist_ipv6"
199: 	}
200: 	if err != nil {
201: 		return fmt.Errorf("failed to get table: %w", err)
202: 	}
203: 
204: 	blacklistSet, err := nft.GetOrCreateSet(table, setName, isIPv4)
205: 	if err != nil {
206: 		return fmt.Errorf("failed to get blacklist set: %w", err)
207: 	}
208: 
209: 	// Add IP with optional timeout
210: 	startTime := time.Now()
211: 	var timeout time.Duration
212: 	if timeoutSeconds > 0 {
213: 		timeout = time.Duration(timeoutSeconds) * time.Second
214: 	}
215: 
216: 	if err := nft.AddIPWithTimeout(blacklistSet, normalizedIP, timeout); err != nil {
217: 		return fmt.Errorf("failed to add to nftables: %w", err)
218: 	}
219: 	duration := time.Since(startTime)
220: 
221: 	if timeoutSeconds > 0 {
222: 		fmt.Printf("  ✅ Added to nftables with %s timeout in %v\n", formatDuration(timeoutSeconds), duration)
223: 	} else {
224: 		fmt.Printf("  ✅ Added to nftables (permanent) in %v\n", duration)
225: 	}
226: 	fmt.Println()
227: 
228: 	// ════════════════════════════════════════════════════════════
229: 	// Step 7: Record analytics and central ban log
230: 	// ════════════════════════════════════════════════════════════
231: 	fmt.Println("Step 7: Recording analytics...")
232: 	country, city := lookupCountryAndCity(normalizedIP)
233: 
234: 	// Record to analytics (JSON files for dashboard)
235: 	if st := analytics.StateOrNil(); st != nil {
236: 		st.RecordBan(normalizedIP, country, city, source, reason, time.Now())
237: 		fmt.Printf("  ✅ Analytics recorded: %s (%s)\n", country, city)
238: 	} else {
239: 		fmt.Printf("  ⚠️  Analytics not available\n")
240: 	}
241: 
242: 	// Record to central ban.log (for stats dashboard)
243: 	banSource := source
244: 	if banSource == "" {
245: 		banSource = banlog.SourceManual
246: 	}
247: 	if err := banlog.LogBan(normalizedIP, banSource, country); err != nil {
248: 		fmt.Printf("  ⚠️  Failed to write to bans.log: %v\n", err)
249: 	} else {
250: 		fmt.Printf("  ✅ Ban logged to %s/bans.log\n", cfg.LogDir)
251: 	}
252: 	fmt.Println()
253: 
254: 	// Success!
255: 	fmt.Println(strings.Repeat("=", 70))
256: 	fmt.Printf("✅ IP %s has been BANNED!\n", normalizedIP)
257: 	fmt.Println()
258: 	fmt.Println("The IP is now blocked by the firewall.")
259: 	if !alreadyBanned && timeoutSeconds == 0 {
260: 		// Show correct file based on source
261: 		savedFile := "99-manual.conf"
262: 		switch source {
263: 		case "login":
264: 			savedFile = "login-auto.conf"
265: 		case "portscan":
266: 			savedFile = "portscan-auto.conf"
267: 		case "ddos":
268: 			savedFile = "ddos-auto.conf"
269: 		}
270: 		if shouldEscalate {
271: 			savedFile = "30-persistent-offenders.conf"
272: 		}
273: 		fmt.Printf("Entry saved to: /etc/nftban/blacklist.d/%s\n", savedFile)
274: 	}
275: 	fmt.Println()
276: 
277: 	return nil
278: }
279: 
280: // lookupCountryAndCity performs GeoIP lookup for an IP address.
281: // Returns country code and city name, or "UNK"/"Unknown" if lookup fails.
282: func lookupCountryAndCity(ip string) (string, string) {
283: 	country, city := geoip.LookupIP(ip)
284: 
285: 	// Use defaults if lookup failed
286: 	if country == "" {
287: 		country = "UNK"
288: 	}
289: 	if city == "" {
290: 		city = "Unknown"
291: 	}
292: 
293: 	return country, city
294: }
295: 
296: // checkPersistentOffender checks if an IP should be escalated to permanent ban
297: // Returns true if threshold exceeded
298: func checkPersistentOffender(configDir, ip, jailName string) (bool, error) {
299: 	// Load configuration
300: 	cfg, err := persistent.LoadConfig(configDir)
301: 	if err != nil {
302: 		return false, fmt.Errorf("failed to load persistent offender config: %w", err)
303: 	}
304: 
305: 	if !cfg.Enabled {
306: 		return false, nil // Feature disabled
307: 	}
308: 
309: 	// Get filter-specific configuration (was jail in v0.7)
310: 	jailCfg := cfg.GetFilterConfig(jailName)
311: 
312: 	// Log this temp ban for escalation tracking
313: 	if err := persistent.LogTempBan(cfg.BanLog, ip, jailName, fmt.Sprintf("temp ban from %s", jailName)); err != nil {
314: 		return false, fmt.Errorf("failed to log ban: %w", err)
315: 	}
316: 
317: 	// Count recent bans for this IP
318: 	banCount, err := persistent.CountRecentBans(cfg.BanLog, ip, jailCfg.Period)
319: 	if err != nil {
320: 		return false, fmt.Errorf("failed to count bans: %w", err)
321: 	}
322: 
323: 	// Check if threshold exceeded
324: 	if banCount >= jailCfg.Threshold {
325: 		// Log persistent offender
326: 		if err := persistent.LogPersistentOffender(cfg.OffendersLog, ip, jailName, banCount); err != nil {
327: 			// Log error but don't fail the ban
328: 			fmt.Printf("  ⚠️  Warning: Failed to log persistent offender: %v\n", err)
329: 		}
330: 
331: 		// Add to persistent offenders file
332: 		reason := fmt.Sprintf(">=%d bans in %s", jailCfg.Threshold, jailCfg.Period)
333: 		if err := persistent.AddToPersistentOffenders(cfg.OffendersConf, ip, reason); err != nil {
334: 			return false, fmt.Errorf("failed to add to persistent offenders: %w", err)
335: 		}
336: 
337: 		return true, nil
338: 	}
339: 
340: 	return false, nil
341: }
</file>


126:     // Countries Bar Chart
127:     const countriesCtx = document.getElementById('countries-chart');
128:     if (countriesCtx) {
129:         countriesChart = new Chart(countriesCtx, {
130:             type: 'bar',
131:             data: {
132:                 labels: [],
133:                 datasets: [{
134:                     label: 'Banned IPs',
135:                     data: [],
136:                     backgroundColor: '#ff6b6b',
137:                     borderColor: '#ff6b6b',
138:                     borderWidth: 1
139:                 }]
140:             },
141:             options: {
142:                 indexAxis: 'y', // Horizontal bar chart
143:                 responsive: true,
144:                 maintainAspectRatio: false,
145:                 plugins: {

# nftban-managed: yes
# nftban-templates-version: 1

[nftban-ssh]
enabled   = @@NFTBAN_F2B_SSH_JAIL@@
filter    = sshd
backend   = auto
port      = ssh
logpath   = @@NFTBAN_F2B_SSH_LOG@@
maxretry  = @@NFTBAN_F2B_SSH_MAX_RETRY@@
findtime  = @@NFTBAN_F2B_SSH_FIND_TIME@@
bantime   = @@NFTBAN_F2B_SSH_BAN_TIME@@

347: // GetRecentSamples returns the most recent N samples
348: func (s *Sampler) GetRecentSamples(count int) []Sample {
349: 	s.mu.RLock()
350: 	defer s.mu.RUnlock()
351: 
352: 	if count <= 0 || count > len(s.samples) {
353: 		count = len(s.samples)
354: 	}
355: 
356: 	start := len(s.samples) - count
357: 	result := make([]Sample, count)
358: 	copy(result, s.samples[start:])
359: 	return result
360: }
361: 
362: // startLocked starts the sampler (must be called with lock held)
363: func (s *Sampler) startLocked() {
364: 	if s.running {
365: 		return
366: 	}
367: 
368: 	log.Printf("[METRICS] Starting sampler (period: %v, sessions: %d, metrics: %v)",
369: 		s.period, s.activeSessions, s.metricsEnabled)
370: 
371: 	s.running = true
372: 	s.ticker = time.NewTicker(s.period)
373: 
374: 	// Take initial sample
375: 	go s.takeSample()
376: 
377: 	// Start sampling loop
378: 	go s.run()
379: }
380: 
381: // stopLocked stops the sampler (must be called with lock held)
382: func (s *Sampler) stopLocked() {
383: 	if !s.running {
384: 		return
385: 	}
386: 
387: 	log.Println("[METRICS] Stopping sampler")
388: 	s.running = false
389: 
390: 	if s.ticker != nil {
391: 		s.ticker.Stop()
392: 	}
393: 
394: 	select {
395: 	case s.stopChan <- struct{}{}:
396: 	default:
397: 	}
398: }

 38: # shellcheck source=/usr/lib/nftban/lib/strict.sh
 39: if [[ -f "${NFTBAN_LIB_DIR}/lib/strict.sh" ]]; then
 40:     source "${NFTBAN_LIB_DIR}/lib/strict.sh"
 41: else
 42:     # Fallback to manual strict mode
 43:     set -Eeuo pipefail
 44: fi
 45: 
 46: # Load version library
 47: # shellcheck source=/usr/lib/nftban/lib/version.sh
 48: if [[ -f "${NFTBAN_LIB_DIR}/lib/version.sh" ]]; then
 49:     source "${NFTBAN_LIB_DIR}/lib/version.sh"
 50: fi
 51: 
 52: 
 53: # Load NFT schema (single source of truth for table/set names)
 54: # shellcheck source=/usr/lib/nftban/lib/nft_schema.sh
 55: if [[ -f "${NFTBAN_LIB_DIR}/lib/nft_schema.sh" ]]; then
 56:     source "${NFTBAN_LIB_DIR}/lib/nft_schema.sh"
 57: fi
 58: # Load JSON helper for --json support
 59: JSON_HELPER="${NFTBAN_LIB_DIR}/helpers/json_output.sh"
 60: if [[ -f "$JSON_HELPER" ]]; then
 61:     # shellcheck source=/dev/null
 62:     source "$JSON_HELPER"
 63: fi
 64: 
 65: # =============================================================================
 66: # MAIN COMMAND HANDLER
 67: # =============================================================================

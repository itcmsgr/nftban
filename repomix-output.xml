<file path="pkg/geoban/geoban.go">
  1: // SPDX-License-Identifier: GPL-3.0-or-later
  2: // Copyright (c) 2025 Antonios Voulvoulis <contact@nftban.com>
  3: 
  4: package geoban
  5: 
  6: import (
  7: 	"bufio"
  8: 	"fmt"
  9: 	"os"
 10: 	"path/filepath"
 11: 	"strings"
 12: 
 13: 	"github.com/itcmsgr/nftban/pkg/feeds"
 14: 	"github.com/itcmsgr/nftban/pkg/model"
 15: 	"github.com/itcmsgr/nftban/pkg/nftbanconf"
 16: )
 17: 
 18: const (
 19: 	// BanFilePrefix is the prefix for ban config files
 20: 	BanFilePrefix = "50-ban-"
 21: 
 22: 	// WhitelistFilePrefix is the prefix for whitelist config files
 23: 	WhitelistFilePrefix = "50-whitelist-"
 24: )
 25: 
 26: // getDefaultGeobanDir returns geoban directory from central config
 27: // NO FALLBACK - path must come from /etc/nftban/nftban.conf
 28: func getDefaultGeobanDir() string {
 29: 	cfg := nftbanconf.MustLoad()
 30: 	return cfg.ConfigDir + "/geoban.d"
 31: }
 32: 
 33: // Build loads all geoban country files and returns consolidated SetData
 34: // This replaces the slow bash implementation with fast Go parsing
 35: //
 36: // Performance: <2s for 2,259 CIDRs (vs 120s timeout in bash)
 37: //
 38: // Features:
 39: // - Reads from /etc/nftban/geoban.d/50-ban-*.conf files
 40: // - IPv4/IPv6 automatic separation
 41: // - CIDR normalization
 42: // - Comment and empty line filtering
 43: // - Streaming parsing (memory efficient)
 44: func Build(geobanDir string, countries []string) (*model.SetData, error) {
 45: 	if geobanDir == "" {
 46: 		geobanDir = getDefaultGeobanDir()
 47: 	}
 48: 
 49: 	data := model.NewSetData("geoban")
 50: 
 51: 	// If no countries specified, load ALL ban files
 52: 	if len(countries) == 0 {
 53: 		entries, err := os.ReadDir(geobanDir)
 54: 		if err != nil {
 55: 			return nil, fmt.Errorf("failed to read geoban directory: %w", err)
 56: 		}
 57: 
 58: 		for _, entry := range entries {
 59: 			if entry.IsDir() {
 60: 				continue
 61: 			}
 62: 			// Load all 50-ban-*.conf files
 63: 			if strings.HasPrefix(entry.Name(), BanFilePrefix) && strings.HasSuffix(entry.Name(), ".conf") {
 64: 				countryCode := strings.TrimSuffix(strings.TrimPrefix(entry.Name(), BanFilePrefix), ".conf")
 65: 				countries = append(countries, countryCode)
 66: 			}
 67: 		}
 68: 	}
 69: 
 70: 	// Load each country
 71: 	for _, country := range countries {
 72: 		if err := loadCountry(data, geobanDir, country); err != nil {
 73: 			// Log error but continue with other countries
 74: 			fmt.Fprintf(os.Stderr, "WARNING: Failed to load country %s: %v\n", country, err)
 75: 		}
 76: 	}
 77: 
 78: 	return data, nil
 79: }
 80: 
 81: // loadCountry loads a single country's ban file
 82: func loadCountry(data *model.SetData, geobanDir, country string) error {
 83: 	// Normalize country code (uppercase)
 84: 	countryCode := strings.ToUpper(country)
 85: 
 86: 	// Build filename: 50-ban-CN.conf
 87: 	filename := fmt.Sprintf("%s%s.conf", BanFilePrefix, countryCode)
 88: 	path := filepath.Join(geobanDir, filename)
 89: 
 90: 	file, err := os.Open(path)
 91: 	if err != nil {
 92: 		return fmt.Errorf("country file not found: %s", path)
 93: 	}
 94: 	defer file.Close()
 95: 
 96: 	scanner := bufio.NewScanner(file)
 97: 	lineNum := 0
 98: 
 99: 	for scanner.Scan() {
100: 		lineNum++
101: 		line := strings.TrimSpace(scanner.Text())
102: 
103: 		// Skip empty lines and comments
104: 		if line == "" || strings.HasPrefix(line, "#") {
105: 			continue
106: 		}
107: 
108: 		// Parse CIDR
109: 		if err := addCIDR(data, line); err != nil {
110: 			// Log but don't fail on individual line errors
111: 			fmt.Fprintf(os.Stderr, "WARNING: %s:%d: invalid CIDR: %s (%v)\n",
112: 				path, lineNum, line, err)
113: 		}
114: 	}
115: 
116: 	if err := scanner.Err(); err != nil {
117: 		return fmt.Errorf("error reading country file %s: %w", path, err)
118: 	}
119: 
120: 	return nil
121: }
122: 
123: // addCIDR adds a CIDR to the appropriate set (IPv4 or IPv6)
124: // Uses unified ParseFeedLine for consistent parsing across the codebase
125: func addCIDR(data *model.SetData, cidrStr string) error {
126: 	entry, err := feeds.ParseFeedLine(cidrStr)
127: 	if err != nil {
128: 		return err
129: 	}
130: 	if entry == nil {
131: 		return nil // Skip (comment or empty)
132: 	}
133: 
134: 	if entry.IPv4 {
135: 		data.AddIPv4(entry.Value)
136: 	} else {
137: 		data.AddIPv6(entry.Value)
138: 	}
139: 	return nil
140: }
141: 
142: // ListBannedCountries returns list of currently banned countries
143: func ListBannedCountries(geobanDir string) ([]string, error) {
144: 	if geobanDir == "" {
145: 		geobanDir = getDefaultGeobanDir()
146: 	}
147: 
148: 	entries, err := os.ReadDir(geobanDir)
149: 	if err != nil {
150: 		return nil, fmt.Errorf("failed to read geoban directory: %w", err)
151: 	}
152: 
153: 	var countries []string
154: 	for _, entry := range entries {
155: 		if entry.IsDir() {
156: 			continue
157: 		}
158: 		if strings.HasPrefix(entry.Name(), BanFilePrefix) && strings.HasSuffix(entry.Name(), ".conf") {
159: 			countryCode := strings.TrimSuffix(strings.TrimPrefix(entry.Name(), BanFilePrefix), ".conf")
160: 			countries = append(countries, countryCode)
161: 		}
162: 	}
163: 
164: 	return countries, nil
165: }
166: 
167: // ListWhitelistedCountries returns list of currently whitelisted countries
168: func ListWhitelistedCountries(geobanDir string) ([]string, error) {
169: 	if geobanDir == "" {
170: 		geobanDir = getDefaultGeobanDir()
171: 	}
172: 
173: 	entries, err := os.ReadDir(geobanDir)
174: 	if err != nil {
175: 		return nil, fmt.Errorf("failed to read geoban directory: %w", err)
176: 	}
177: 
178: 	var countries []string
179: 	for _, entry := range entries {
180: 		if entry.IsDir() {
181: 			continue
182: 		}
183: 		if strings.HasPrefix(entry.Name(), WhitelistFilePrefix) && strings.HasSuffix(entry.Name(), ".conf") {
184: 			countryCode := strings.TrimSuffix(strings.TrimPrefix(entry.Name(), WhitelistFilePrefix), ".conf")
185: 			countries = append(countries, countryCode)
186: 		}
187: 	}
188: 
189: 	return countries, nil
190: }
191: 
192: // Stats returns statistics about geoban data
193: type Stats struct {
194: 	Countries   int
195: 	TotalCIDRs  int
196: 	IPv4CIDRs   int
197: 	IPv6CIDRs   int
198: 	BannedList  []string
199: 	WhitelistList []string
200: }
201: 
202: // GetStats returns statistics about current geoban configuration
203: func GetStats(geobanDir string) (*Stats, error) {
204: 	banned, err := ListBannedCountries(geobanDir)
205: 	if err != nil {
206: 		return nil, err
207: 	}
208: 
209: 	whitelisted, err := ListWhitelistedCountries(geobanDir)
210: 	if err != nil {
211: 		return nil, err
212: 	}
213: 
214: 	data, err := Build(geobanDir, banned)
215: 	if err != nil {
216: 		return nil, err
217: 	}
218: 
219: 	return &Stats{
220: 		Countries:     len(banned),
221: 		TotalCIDRs:    data.Count,
222: 		IPv4CIDRs:     len(data.IPv4),
223: 		IPv6CIDRs:     len(data.IPv6),
224: 		BannedList:    banned,
225: 		WhitelistList: whitelisted,
226: 	}, nil
227: }

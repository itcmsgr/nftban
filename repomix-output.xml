 36: declare -a FAILED_TESTS
 37: 
 38: print_header() {
 39:     echo ""
 40:     echo -e "${BLUE}╔═══════════════════════════════════════════════════════════╗${NC}"
 41:     echo -e "${BLUE}║  NFTBan v0.6.0 - Metrics Integration Test Suite          ║${NC}"
 42:     echo -e "${BLUE}╚═══════════════════════════════════════════════════════════╝${NC}"
 43:     echo ""
 44: }

# =============================================================================
# NFTBan v1.0.0 - Queue Processor Timer
# =============================================================================
# SPDX-License-Identifier: MPL-2.0
# Purpose: Systemd timer unit that triggers queue processing every 2 minutes
#
# meta:name="nftban_queue_timer"
# meta:type="config"
# meta:owner="Antonios Voulvoulis <contact@nftban.com>"
# meta:created_date="2025-11-05"
# meta:description="Timer that triggers NFTBan queue processor every 2 minutes"
# meta:input="None"
# meta:output="Triggers nftban-queue.service"
# meta:depends="nftban-queue.service"
#
# meta:inventory.files=""
# meta:inventory.binaries=""
# meta:inventory.env_vars=""
# meta:inventory.config_files=""
# meta:inventory.systemd_units="nftban-queue.service"
# meta:inventory.network=""
# meta:inventory.privileges="none"
# =============================================================================

[Unit]
Description=NFTBan Task Queue Processor Timer
Documentation=man:nftban(8)

[Timer]
# Run every 2 minutes with jitter to prevent synchronized bursts
OnBootSec=2min
OnUnitActiveSec=2min
AccuracySec=10s
RandomizedDelaySec=30s

[Install]
WantedBy=timers.target

 372: // splitRangeAndRemoveIP uses a full-set-refresh approach to remove an IP from a merged range.
 373: // Due to nftables kernel auto-merge behavior, we can't reliably delete individual ranges.
 374: // Instead, we:
 375: // 1. Parse all current set elements
 376: // 2. Flush the set
 377: // 3. Re-add all elements EXCEPT the IP we want to remove (and its containing range, split)
 378: func (m *NFTManager) splitRangeAndRemoveIP(set *nftables.Set, family string, r *IPRange, ipVal uint32) error {
 379: 	// First try direct range delete (works in some nftables versions)
 380: 	startIP := uint32ToIPv4(r.Start).String()
 381: 	endIP := uint32ToIPv4(r.End).String()
 382: 	rangeStr := startIP + "-" + endIP
 383: 
 384: 	err := nftDeleteElement(family, set.Table.Name, set.Name, "{ "+rangeStr+" }")
 385: 	if err != nil {
 386: 		// Range delete failed - use full-set-refresh approach
 387: 		// This is the only reliable way to split merged ranges
 388: 		return m.fullSetRefreshExcludingIP(set, family, uint32ToIPv4(ipVal).String())
 389: 	}
 390: 
 391: 	// Range delete succeeded - now re-add the sub-ranges
 392: 	// Step 2: Re-add left sub-range (if IP is not at start)
 393: 	if r.Start < ipVal {
 394: 		leftEnd := ipVal - 1
 395: 		var leftRangeStr string
 396: 		if r.Start == leftEnd {
 397: 			leftRangeStr = uint32ToIPv4(r.Start).String()
 398: 		} else {
 399: 			leftRangeStr = uint32ToIPv4(r.Start).String() + "-" + uint32ToIPv4(leftEnd).String()
 400: 		}
 401: 
 402: 		// Ignore interval overlaps - already covered
 403: 		_ = nftAddElement(family, set.Table.Name, set.Name, "{ "+leftRangeStr+" }")
 404: 	}
 405: 
 406: 	// Step 3: Re-add right sub-range (if IP is not at end)
 407: 	if ipVal < r.End {
 408: 		rightStart := ipVal + 1
 409: 		var rightRangeStr string
 410: 		if rightStart == r.End {
 411: 			rightRangeStr = uint32ToIPv4(r.End).String()
 412: 		} else {
 413: 			rightRangeStr = uint32ToIPv4(rightStart).String() + "-" + uint32ToIPv4(r.End).String()
 414: 		}
 415: 
 416: 		// Ignore interval overlaps - already covered
 417: 		_ = nftAddElement(family, set.Table.Name, set.Name, "{ "+rightRangeStr+" }")
 418: 	}
 419: 
 420: 	return nil
 421: }

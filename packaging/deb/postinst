#!/bin/bash
# =============================================================================
# NFTBan v1.7.0 - DEB Package Post-Install Script
# =============================================================================
# SPDX-License-Identifier: MPL-2.0
#
# meta:name="postinst"
# meta:type="packaging"
# meta:owner="Antonios Voulvoulis <contact@nftban.com>"
# meta:created_date="2025-10-26"
# meta:description="DEB package post-install script for NFTBan"
# meta:input="None"
# meta:output="Configured NFTBan system"
# meta:depends="adduser,addgroup,systemctl,chown,chmod,mkdir"
# meta:inventory.files="/etc/nftban/,/var/lib/nftban/,/var/log/nftban/"
# meta:inventory.binaries="adduser,addgroup,usermod,systemctl,chown,chmod,mkdir,setcap"
# meta:inventory.env_vars=""
# meta:inventory.config_files="/etc/nftban/nftban.conf,/etc/nftables.conf"
# meta:inventory.systemd_units="nftband.socket,nftband.service,nftban-maintenance.timer,nftban-health.timer"
# meta:inventory.network=""
# meta:inventory.privileges="root"
#
# Purpose: SAFE INSTALL FLOW - Setup user/groups, permissions, whitelist BEFORE
#          enabling firewall to prevent self-lockout
#
# Installation Flow:
#   1. Create groups (nftban, nftban-auditor)
#   2. Create nftban system user
#   3. Create FHS directory structure
#   4. Set correct permissions
#   5. Install polkit policies
#   6. **SAFETY** Auto-whitelist system IPs (SSH client, interfaces, public IP)
#   7. Run health check / validation
#   8. THEN enable timers and services
#
# This prevents lockout by ensuring whitelist is in place BEFORE firewall is active.
# =============================================================================

set -Eeuo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log_info() { echo -e "${GREEN}[NFTBan]${NC} $*"; }
log_warn() { echo -e "${YELLOW}[NFTBan WARN]${NC} $*"; }
log_error() { echo -e "${RED}[NFTBan ERROR]${NC} $*"; }

case "$1" in
    configure)
        # Get version from VERSION file (single source of truth)
        NFTBAN_VERSION="unknown"
        for version_file in /usr/lib/nftban/VERSION /var/lib/dpkg/info/nftban-core.list; do
            if [[ -f "$version_file" ]]; then
                NFTBAN_VERSION=$(cat "$version_file" 2>/dev/null | tr -d '[:space:]')
                break
            fi
        done
        [[ -z "$NFTBAN_VERSION" ]] && NFTBAN_VERSION="unknown"

        log_info "Configuring NFTBan v${NFTBAN_VERSION}..."

        # =====================================================================
        # STEP 0: Security Check - CVE-2025-NFTBAN-001
        # =====================================================================
        if command -v nft >/dev/null 2>&1; then
            if nft list table inet filter >/dev/null 2>&1; then
                log_error "Conflicting 'inet filter' table detected!"
                log_error "This table will bypass nftban blocking (CVE-2025-NFTBAN-001)."
                log_error "Please run: nft delete table inet filter"
                log_error "Then re-install the package."
                exit 1
            fi
        fi

        # =====================================================================
        # STEP 0.1: Remove immutable flags before upgrade (security files)
        # =====================================================================
        # Critical security files are marked immutable to prevent tampering
        # Remove flags before upgrade to allow package manager to update them
        for immutable_file in /etc/nftban/nftban.conf /usr/lib/nftban/lib/nft_schema.sh; do
            if [[ -f "$immutable_file" ]]; then
                chattr -i "$immutable_file" 2>/dev/null || true
            fi
        done

        # =====================================================================
        # STEP 0.2: Cleanup old paths from pre-1.8.13 DEB packages
        # =====================================================================
        # Old DEB packages incorrectly installed CLI to /usr/bin instead of /usr/sbin
        if [[ -f "/usr/bin/nftban" ]] && [[ ! -L "/usr/bin/nftban" ]]; then
            rm -f "/usr/bin/nftban"
            log_info "Removed old CLI from /usr/bin/nftban (migrated to /usr/sbin)"
        fi

        # =====================================================================
        # STEP 0.3: Cleanup obsolete/stale files from previous versions
        # =====================================================================
        log_info "Cleaning up obsolete files from previous versions..."
        OBSOLETE_CLEANED=0

        # Remove nested nftban directory (stale from old installs)
        if [[ -d "/usr/lib/nftban/lib/nftban" ]]; then
            rm -rf "/usr/lib/nftban/lib/nftban"
            log_info "Removed stale: /usr/lib/nftban/lib/nftban/"
            ((OBSOLETE_CLEANED++)) || true
        fi

        # Remove nested etc directory (stale from old installs)
        if [[ -d "/usr/lib/nftban/etc" ]]; then
            rm -rf "/usr/lib/nftban/etc"
            log_info "Removed stale: /usr/lib/nftban/etc/"
            ((OBSOLETE_CLEANED++)) || true
        fi

        # Remove old cmd_health.sh at wrong location (moved to cli/)
        if [[ -f "/usr/lib/nftban/core/cmd_health.sh" ]]; then
            rm -f "/usr/lib/nftban/core/cmd_health.sh"
            log_info "Removed stale: /usr/lib/nftban/core/cmd_health.sh"
            ((OBSOLETE_CLEANED++)) || true
        fi

        # Remove json_output.sh at wrong location (moved to helpers/)
        if [[ -f "/usr/lib/nftban/json_output.sh" ]]; then
            rm -f "/usr/lib/nftban/json_output.sh"
            log_info "Removed stale: /usr/lib/nftban/json_output.sh"
            ((OBSOLETE_CLEANED++)) || true
        fi

        # Remove old cmd_ui.sh at root level (moved to cli/)
        if [[ -f "/usr/lib/nftban/cmd_ui.sh" ]]; then
            rm -f "/usr/lib/nftban/cmd_ui.sh"
            log_info "Removed stale: /usr/lib/nftban/cmd_ui.sh"
            ((OBSOLETE_CLEANED++)) || true
        fi

        [[ $OBSOLETE_CLEANED -gt 0 ]] && log_info "Obsolete file cleanup complete"

        # =====================================================================
        # STEP 0.4: CRITICAL PREFLIGHT - Check BEFORE any nftables changes
        # =====================================================================
        # v1.16.3: This MUST run before ANY nft commands to prevent lockout
        # Three checks: (A) Live xt targets, (B) cPanel detection, (C) Set safety flags
        log_info "Running critical preflight checks..."

        NFTABLES_SAFE=1
        CPANEL_MODE=0
        SKIP_DROP_CHAINS=0

        # (A) Check LIVE ruleset for xt targets (not just config file!)
        # cPanel/iptables-nft creates xt rules that break nftables service
        if command -v nft >/dev/null 2>&1; then
            LIVE_CHECK=$(nft list ruleset 2>&1 || true)
            if echo "$LIVE_CHECK" | grep -qE "xt target|xtables compat"; then
                log_error ""
                log_error "=========================================="
                log_error " XT TARGET RULES DETECTED IN LIVE RULESET"
                log_error "=========================================="
                log_error "This system has iptables-nft xt compat rules loaded."
                log_error "These are incompatible with nftables service management."
                log_error ""
                log_error "NFTBan will install but NOT activate nftables."
                log_error "Existing firewall rules will remain unchanged."
                log_error ""
                NFTABLES_SAFE=0
                SKIP_DROP_CHAINS=1
            fi
        fi

        # (B) Detect cPanel - force coexist mode (don't manage nftables service)
        if [[ -f /usr/local/cpanel/version ]]; then
            CPANEL_VER=$(cat /usr/local/cpanel/version 2>/dev/null || echo "unknown")
            log_warn ""
            log_warn "=========================================="
            log_warn " cPanel DETECTED (v${CPANEL_VER})"
            log_warn "=========================================="
            log_warn "NFTBan will operate in coexistence mode:"
            log_warn "  - Will NOT manage nftables.service"
            log_warn "  - Will NOT flush or replace existing rules"
            log_warn "  - Will NOT create hook chains with DROP policy"
            log_warn ""
            CPANEL_MODE=1
            SKIP_DROP_CHAINS=1
        fi

        # (C) Export flags for use by nftban commands during install
        export NFTBAN_SKIP_DROP_CHAINS=$SKIP_DROP_CHAINS
        export NFTBAN_CPANEL_MODE=$CPANEL_MODE

        if [[ $SKIP_DROP_CHAINS -eq 1 ]]; then
            log_warn "Safety mode: Hook chains with DROP policy will NOT be created"
            log_warn "NFTBan sets/tables will be created but firewall won't block traffic"
        fi

        # =====================================================================
        # STEP 0.5: Link bundled yq v4 (mikefarah/yq) - REQUIRED
        # =====================================================================
        # WHY v4 IS REQUIRED:
        #   - yq v3 (Python pip) is ~10x slower (0.17s vs 0.017s per call)
        #   - nftban help makes 100+ yq calls, causing timeout with v3
        #   - NFTBan 1.12.7+ standardized on mikefarah/yq v4 syntax
        # SUPPLY-CHAIN SAFE: yq is bundled in package with SHA256 verification at build time
        log_info "Checking yq v4 (YAML processor)..."

        # Check if system yq is already v4
        if command -v yq &>/dev/null; then
            YQ_VER=$(yq --version 2>/dev/null | head -1 || echo "")
            if [[ "$YQ_VER" == *"mikefarah"* ]] || [[ "$YQ_VER" == *"version v4"* ]]; then
                log_info "yq v4 found: $YQ_VER"
            else
                # System has yq v3, use bundled v4
                if [[ -x /usr/lib/nftban/bin/yq ]]; then
                    ln -sf /usr/lib/nftban/bin/yq /usr/bin/yq
                    log_info "yq v4 linked from bundled binary (replaced v3)"
                fi
            fi
        else
            # No system yq, link bundled
            if [[ -x /usr/lib/nftban/bin/yq ]]; then
                ln -sf /usr/lib/nftban/bin/yq /usr/bin/yq
                log_info "yq v4 linked from bundled binary"
            else
                log_warn "WARNING: bundled yq not found - help command may be slow"
            fi
        fi

        # =====================================================================
        # STEP 0.5: Check for Conflicting Firewalls
        # =====================================================================
        log_info "Checking for conflicting firewalls..."

        CONFLICTS_FOUND=0
        FIREWALL_ISSUES=""

        # Check firewalld
        if command -v firewall-cmd >/dev/null 2>&1; then
            if systemctl is-active --quiet firewalld 2>/dev/null; then
                FIREWALL_ISSUES="${FIREWALL_ISSUES}firewalld (ACTIVE) "
                CONFLICTS_FOUND=1
            elif systemctl is-enabled --quiet firewalld 2>/dev/null; then
                FIREWALL_ISSUES="${FIREWALL_ISSUES}firewalld (ENABLED) "
                CONFLICTS_FOUND=1
            fi
        fi

        # Check iptables service
        if systemctl is-active --quiet iptables 2>/dev/null || \
           systemctl is-active --quiet iptables.service 2>/dev/null || \
           systemctl is-active --quiet ip6tables.service 2>/dev/null; then
            FIREWALL_ISSUES="${FIREWALL_ISSUES}iptables-services (ACTIVE) "
            CONFLICTS_FOUND=1
        fi

        # Check ufw
        if command -v ufw >/dev/null 2>&1; then
            if ufw status 2>/dev/null | grep -q "Status: active"; then
                FIREWALL_ISSUES="${FIREWALL_ISSUES}ufw (ACTIVE) "
                CONFLICTS_FOUND=1
            fi
        fi

        if [ $CONFLICTS_FOUND -eq 1 ]; then
            log_error ""
            log_error "=========================================="
            log_error " CONFLICTING FIREWALL(S) DETECTED!"
            log_error "=========================================="
            log_error ""
            log_error "NFTBan cannot coexist with: ${FIREWALL_ISSUES}"
            log_error ""
            log_error "These firewalls will cause:"
            log_error "  • Duplicate filtering rules"
            log_error "  • Unpredictable blocking behavior"
            log_error "  • NFTBan blocks may not work"
            log_error ""
            log_error "Please disable conflicting firewalls:"
            log_error ""

            if echo "$FIREWALL_ISSUES" | grep -q "firewalld"; then
                log_error "  systemctl stop firewalld"
                log_error "  systemctl disable firewalld"
                log_error ""
            fi

            if echo "$FIREWALL_ISSUES" | grep -q "iptables"; then
                log_error "  systemctl stop iptables"
                log_error "  systemctl disable iptables"
                log_error "  systemctl stop ip6tables"
                log_error "  systemctl disable ip6tables"
                log_error ""
            fi

            if echo "$FIREWALL_ISSUES" | grep -q "ufw"; then
                log_error "  ufw disable"
                log_error "  systemctl stop ufw"
                log_error "  systemctl disable ufw"
                log_error ""
            fi

            log_error "Then re-install: apt install --reinstall nftban"
            log_error ""
            exit 1
        fi

        log_info "  No conflicting firewalls detected"

        # =====================================================================
        # STEP 1: Create System Groups
        # =====================================================================
        # NFTBan v1.0 uses 2-group model:
        #   nftban: All operators (CLI + Web GUI)
        #   nftban-auditor: Read-only audit access
        log_info "Creating system groups..."

        if ! getent group nftban > /dev/null 2>&1; then
            addgroup --system nftban
            log_info "  Created group: nftban"
        fi

        if ! getent group nftban-auditor > /dev/null 2>&1; then
            addgroup --system nftban-auditor
            log_info "  Created group: nftban-auditor"
        fi

        # Create suricata group if not exists (needed for nftban-suricata-update.service)
        if ! getent group suricata > /dev/null 2>&1; then
            addgroup --system suricata
            log_info "  Created group: suricata"
        fi

        # Add root to nftban group for CLI access
        if ! id -nG root 2>/dev/null | grep -qw nftban; then
            usermod -a -G nftban root 2>/dev/null || true
        fi

        # =====================================================================
        # STEP 2: Create System User
        # =====================================================================
        log_info "Creating system user..."

        if ! getent passwd nftban > /dev/null 2>&1; then
            adduser --system --group --home /var/lib/nftban \
                --no-create-home --disabled-login \
                --gecos "NFTBan system user" nftban
            log_info "  Created user: nftban"
        fi

        # =====================================================================
        # STEP 3: Create FHS Directory Structure
        # =====================================================================
        log_info "Creating FHS directories..."

        # Configuration directories
        mkdir -p /etc/nftban/{conf.d,distros,whitelist.d,blacklist.d,ports.d,rules.d}
        mkdir -p /etc/nftban/suricata/{profiles,config,rules,cache,state/last-good}

        # Variable data directories
        mkdir -p /var/lib/nftban/{banned,whitelist,feeds,geoip,reports,config,state,metrics,snapshots,exports}
        mkdir -p /var/lib/nftban/reports/{baseline,auditors}

        # Log directories
        mkdir -p /var/log/nftban/reports

        # Cache and runtime
        mkdir -p /var/cache/nftban/health
        mkdir -p /run/nftban
        mkdir -p /run/nftban-ui

        # Shared data
        mkdir -p /usr/share/nftban/templates/{mail,reports}

        # Prometheus textfile_collector directory (BUG-009 fix)
        # Required by nftban-unified-exporter.service ReadWritePaths directive
        if [[ ! -d /var/lib/node_exporter/textfile_collector ]]; then
            mkdir -p /var/lib/node_exporter/textfile_collector
            chown nftban:nftban /var/lib/node_exporter/textfile_collector 2>/dev/null || true
            chmod 755 /var/lib/node_exporter/textfile_collector
            log_info "  Created: /var/lib/node_exporter/textfile_collector"
        fi

        # =====================================================================
        # STEP 4: Set Permissions (FHS Compliant - Generated from fhs-spec.yaml)
        # =====================================================================
        log_info "Setting permissions via FHS spec..."

        # Source generated FHS permissions script (single source of truth)
        if [ -f /usr/lib/nftban/setup/fhs-permissions.sh ]; then
            # shellcheck source=/dev/null
            source /usr/lib/nftban/setup/fhs-permissions.sh
            nftban_install_set_file_permissions
            log_info "  File permissions set via FHS spec"
        else
            log_warn "FHS permissions script not found, using fallback"
        fi

        # Directories handled by tmpfiles.d (systemd-tmpfiles --create)
        # File permissions handled by fhs-permissions.sh above

        # Special cases not in FHS spec (group-writable for CLI management):
        if [ -d /etc/nftban/suricata/rules ]; then
            chmod 775 /etc/nftban/suricata/rules
            for conf in disable.conf enable.conf categories.enabled local.rules; do
                [ -f "/etc/nftban/suricata/rules/$conf" ] && chmod 664 "/etc/nftban/suricata/rules/$conf"
            done
        fi
        [ -d /etc/nftban/suricata/state ] && chmod 770 /etc/nftban/suricata/state
        [ -f /etc/nftban/suricata/suricata.yaml.overlay ] && chmod 664 /etc/nftban/suricata/suricata.yaml.overlay

        # Set capabilities for nft binary (required for CLI fallback operations)
        if [ -x /usr/sbin/nft ]; then
            setcap 'cap_net_admin+ep' /usr/sbin/nft 2>/dev/null || \
                log_warn "Could not set CAP_NET_ADMIN on nft"
        fi

        # =====================================================================
        # STEP 5: Install Polkit Policies
        # =====================================================================
        log_info "Installing polkit policies..."

        # Polkit directories
        mkdir -p /usr/share/polkit-1/rules.d
        mkdir -p /etc/polkit-1/rules.d

        # Restart polkit to load new rules
        systemctl restart polkit 2>/dev/null || true

        # =====================================================================
        # STEP 6: **SAFETY** Auto-Whitelist System IPs
        # =====================================================================
        # CRITICAL: This MUST happen BEFORE enabling any firewall services
        # to prevent self-lockout during installation
        log_info "Auto-whitelisting system IPs (lockout prevention)..."

        if command -v nftban >/dev/null 2>&1; then
            # Run whitelist-system sync with --quick to skip slow operations
            # Detects: SSH client IP, interface IPs, public IP, gateway, DNS
            nftban whitelist-system sync --quick 2>/dev/null || log_warn "Auto-whitelist sync failed (non-critical)"
        else
            log_warn "nftban command not found, skipping auto-whitelist"
        fi

        # =====================================================================
        # STEP 7: Enforce Permissions (skip full health check for speed)
        # =====================================================================
        log_info "Enforcing permissions..."

        if command -v nftban >/dev/null 2>&1; then
            # Enforce correct permissions using the built-in permission system
            nftban permissions enforce 2>/dev/null || log_warn "Permission enforcement returned warnings"
            # Full health check runs on first timer trigger (nftban-health.timer)
            # Saves ~10-20 seconds during install
        fi

        # =====================================================================
        # STEP 8: Enable Timers and Services
        # =====================================================================
        # v1.16.3: Respect SKIP_DROP_CHAINS flag from preflight
        log_info "Enabling systemd timers and services..."

        # Fresh install - enable services
        if [ -z "$2" ]; then
            # NFTBand daemon (SINGLE nftables writer - MUST start first)
            # Socket activation: nftband.socket creates socket, service receives FD
            # Use deb-systemd-helper first, fallback to systemctl if it fails
            if ! deb-systemd-helper enable nftband.socket >/dev/null 2>&1; then
                systemctl enable nftband.socket >/dev/null 2>&1 || true
            fi
            if ! deb-systemd-helper enable nftband.service >/dev/null 2>&1; then
                systemctl enable nftband.service >/dev/null 2>&1 || true
            fi

            # v1.16.3: In CPANEL_MODE or SKIP_DROP_CHAINS, don't trigger full sync
            # which would create DROP chains and cause lockout
            if [[ $SKIP_DROP_CHAINS -eq 1 ]]; then
                log_warn "Safety mode: Skipping daemon sync (would create DROP chains)"
                log_warn "NFTBan daemon enabled but firewall NOT active"
                # Start socket only - don't trigger sync that creates structure
                systemctl start nftband.socket >/dev/null 2>&1 || true
            else
                # Normal mode: Start socket and service explicitly
                # BUG-002 fix: Socket activation alone is unreliable on fresh install
                systemctl start nftband.socket >/dev/null 2>&1 || true
                systemctl start nftband.service >/dev/null 2>&1 || true
                log_info "  NFTBand socket and service started"

                # Trigger sync to ensure daemon is operational
                sleep 1
                if timeout 10s nftban sync >/dev/null 2>&1; then
                    log_info "  NFTBand daemon verified via sync"
                else
                    # Retry once after short delay
                    sleep 2
                    timeout 10s nftban sync >/dev/null 2>&1 || log_warn "NFTBand sync failed (non-critical)"
                fi
            fi

            # Core timers (maintenance tasks) - with fallback
            for timer in nftban-maintenance.timer nftban-health.timer nftban-queue.timer nftban-unified-exporter.timer; do
                if ! deb-systemd-helper enable "$timer" >/dev/null 2>&1; then
                    systemctl enable "$timer" >/dev/null 2>&1 || true
                fi
            done

            # Core service (nftables management daemon)
            if ! deb-systemd-helper enable nftban-core.service >/dev/null 2>&1; then
                systemctl enable nftban-core.service >/dev/null 2>&1 || true
            fi

            # UI socket (if available)
            if ! deb-systemd-helper enable nftban-ui-auth.socket >/dev/null 2>&1; then
                systemctl enable nftban-ui-auth.socket >/dev/null 2>&1 || true
            fi
            systemctl start nftban-ui-auth.socket >/dev/null 2>&1 || true

            # Start timers
            systemctl start nftban-maintenance.timer >/dev/null 2>&1 || true
            systemctl start nftban-health.timer >/dev/null 2>&1 || true

            # Start queue timer only if unit file exists (BUG-005 fix)
            if systemctl list-unit-files nftban-queue.timer --no-legend 2>/dev/null | grep -q '^nftban-queue.timer'; then
                systemctl start nftban-queue.timer >/dev/null 2>&1 || true
                log_info "  Queue timer started"
            else
                log_warn "nftban-queue.timer not installed (optional)"
            fi

            log_info "  Fresh install - timers enabled and started"
        fi

        # Upgrade - restart services if running
        if [ -n "$2" ]; then
            deb-systemd-invoke try-restart nftband.service >/dev/null 2>&1 || true
            deb-systemd-invoke try-restart nftban-core.service >/dev/null 2>&1 || true
            deb-systemd-invoke try-restart nftban-ui-auth.socket >/dev/null 2>&1 || true
            deb-systemd-invoke try-restart nftban-ui.service >/dev/null 2>&1 || true
            log_info "  Upgrade - services restarted"
        fi

        # =====================================================================
        # STEP 9: Configure nftables and reload
        # =====================================================================
        log_info "Configuring nftables service..."

        # Source distro config library to get correct paths
        if [ -f /usr/lib/nftban/lib/nftban_distro_config.sh ]; then
            source /usr/lib/nftban/lib/nftban_distro_config.sh 2>/dev/null || true

            # Get distro-specific nftables.conf path
            nftban_distro_load_config 2>/dev/null || true
            SYSTEM_NFT_CONF=$(nftban_distro_get_path "nftables_conf" 2>/dev/null)

            if [ -n "${SYSTEM_NFT_CONF}" ] && [ -f "${SYSTEM_NFT_CONF}" ]; then
                # Check if already configured
                if ! grep -q "/etc/nftban/nftables.conf" "${SYSTEM_NFT_CONF}" 2>/dev/null; then
                    echo "# NFTBan firewall configuration" >> "${SYSTEM_NFT_CONF}"
                    echo "include \"/etc/nftban/nftables.conf\"" >> "${SYSTEM_NFT_CONF}"
                    log_info "  Added NFTBan config to ${SYSTEM_NFT_CONF}"
                fi
            fi
        fi

        log_info "Reloading systemd daemon..."
        systemctl daemon-reload

        # =====================================================================
        # STEP 10: Sync whitelist.d files to nftables sets
        # =====================================================================
        # v1.16.3: Skip if in safety mode (DROP chains not created)
        if [[ $SKIP_DROP_CHAINS -eq 1 ]]; then
            log_warn "Safety mode: Skipping whitelist sync (no nftables structure)"
        else
            log_info "Syncing whitelist files to nftables..."
            if nftban sync --quick >/dev/null 2>&1; then
                log_info "  Whitelist sync completed"
            else
                sleep 0.5
                nftban sync --quick >/dev/null 2>&1 || log_warn "Whitelist sync failed (run: nftban sync)"
            fi
        fi

        # =====================================================================
        # STEP 10.5: Additional config validation (secondary to STEP 0.4 preflight)
        # =====================================================================
        # Config file validation (complements live ruleset check from STEP 0.4)
        if [[ -f /etc/nftban/nftables.conf ]] && [[ $NFTABLES_SAFE -eq 1 ]]; then
            if ! nft -c -f /etc/nftban/nftables.conf 2>/dev/null; then
                log_error "NFTBan nftables config validation failed"
                NFTABLES_SAFE=0
            fi
        fi

        # =====================================================================
        # STEP 11: Enable and start nftables ONLY IF SAFE and NOT cPanel
        # =====================================================================
        # v1.16.3: cPanel mode = never manage nftables.service
        if [[ $CPANEL_MODE -eq 1 ]]; then
            log_warn ""
            log_warn "=========================================="
            log_warn " cPanel MODE - nftables.service NOT managed"
            log_warn "=========================================="
            log_warn "NFTBan installed in coexistence mode."
            log_warn "cPanel continues to manage firewall rules."
            log_warn "NFTBan tables NOT created (no DROP policy chains)."
            log_warn ""
            log_info "To manually enable NFTBan protection later:"
            log_info "  1. Disable cPanel firewall: csf -x (or via WHM)"
            log_info "  2. Remove conflicts: nftban health conflicts --fix"
            log_info "  3. Enable NFTBan: nftban sync && systemctl start nftables"
            log_warn ""
        elif [[ $NFTABLES_SAFE -eq 1 ]]; then
            if systemctl is-active nftables >/dev/null 2>&1; then
                log_info "Reloading nftables..."
                systemctl reload nftables 2>/dev/null || log_warn "nftables reload failed"
            else
                log_info "Enabling and starting nftables..."
                systemctl enable nftables 2>/dev/null || true
                systemctl start nftables 2>/dev/null || log_warn "nftables start failed"
            fi
        else
            log_warn ""
            log_warn "=========================================="
            log_warn " NFTABLES NOT ACTIVATED (Safety Mode)"
            log_warn "=========================================="
            log_warn "Install completed but firewall is NOT active."
            log_warn "SSH access is preserved. Fix issues above, then run:"
            log_warn "  systemctl start nftables"
            log_warn ""
        fi

        # =====================================================================
        # STEP 12: GeoIP Database Download (with timeout for airgapped systems)
        # =====================================================================
        log_info "Downloading GeoIP database..."
        if [[ -x /usr/lib/nftban/bin/nftban-core ]]; then
            # Use timeout to prevent blocking on slow/no network (15s max)
            if timeout 15s /usr/lib/nftban/bin/nftban-core geoip update 2>/dev/null; then
                log_info "  GeoIP database downloaded successfully"
            else
                log_info "  GeoIP download skipped (timeout or no network)"
                log_info "  Will auto-download on first timer run, or manual: nftban geoip update"
            fi
        else
            log_warn "nftban-core not found, skipping GeoIP download"
        fi

        # =====================================================================
        # STEP 13: Enable Login Monitoring (Default Protection)
        # =====================================================================
        log_info "Enabling login monitoring (SSH/FTP brute-force protection)..."
        if command -v nftban >/dev/null 2>&1; then
            if nftban login enable 2>/dev/null; then
                log_info "  Login monitoring enabled successfully"
            else
                log_warn "  Login monitoring enable failed (run manually: nftban login enable)"
            fi
        fi

        # =====================================================================
        # STEP 14: Set immutable flags on security-critical files
        # =====================================================================
        log_info "Setting immutable flags on security files..."
        for immutable_file in /etc/nftban/nftban.conf /usr/lib/nftban/lib/nft_schema.sh; do
            if [[ -f "$immutable_file" ]]; then
                chmod 444 "$immutable_file" 2>/dev/null || true
                chattr +i "$immutable_file" 2>/dev/null || true
            fi
        done
        log_info "  Security files protected (immutable)"

        # =====================================================================
        # Installation Complete
        # =====================================================================
        log_info ""
        log_info "========================================"
        log_info " NFTBan v${NFTBAN_VERSION} Installation Complete!"
        log_info "========================================"
        log_info ""
        log_info "Quick Start:"
        log_info "  nftban status              # System overview"
        log_info "  nftban health              # Health check"
        log_info "  nftban whitelist-system show  # View safety whitelist"
        log_info ""
        log_info "Your IP has been auto-whitelisted to prevent lockout."
        log_info ""
        ;;
esac

#DEBHELPER#

exit 0

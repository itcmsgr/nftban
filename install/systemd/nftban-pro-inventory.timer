# =============================================================================
# NFTBan - Pro Inventory Collection Timer
# =============================================================================
# SPDX-License-Identifier: MPL-2.0
# meta:name="nftban-pro-inventory.timer"
# meta:type="systemd"
# meta:tier="PRO"
# meta:owner="Antonios Voulvoulis <contact@nftban.com>"
# meta:created_date="2026-01-08"
# meta:description="Timer for daily Pro inventory collection"
# meta:input="None"
# meta:output="Systemd unit"
# meta:depends=""
# meta:inventory.files=""
# meta:inventory.binaries=""
# meta:inventory.env_vars=""
# meta:inventory.config_files=""
# meta:inventory.systemd_units="nftban-pro-inventory.service"
# meta:inventory.network=""
# meta:inventory.privileges="root"
# =============================================================================

[Unit]
# v1.235 R-DEC: kernel parameter nftban=disabled = per-boot emergency bypass of NFTBan.
# systemd enforces this on every start path (socket, Requires=, timer, installer, self-heal).
ConditionKernelCommandLine=!nftban=disabled
# v1.235 D10: while a commit-confirm rollback has FAILED, nothing may apply another state.
ConditionPathExists=!/var/lib/nftban/state/commit-confirm.rollback-failed
Description=NFTBan Pro Daily Inventory Collection Timer
Documentation=man:nftban(8)
# v1.19.0: Removed Requires= — causes timer to stop when oneshot completes (Task 47)
ConditionPathExists=/etc/nftban/pro.token

[Timer]
# Run daily at 04:00 AM (after license check at 00/6:00)
OnCalendar=*-*-* 04:00:00

# Catch up after reboot
OnBootSec=30min

# JITTER: 30m variance for daily task (reduced from 60m)
RandomizedDelaySec=30m

# DETERMINISTIC: Same offset per host for predictable behavior
FixedRandomDelay=true

# Persist timer across reboots
Persistent=true

# Unit to activate
Unit=nftban-pro-inventory.service

[Install]
WantedBy=timers.target

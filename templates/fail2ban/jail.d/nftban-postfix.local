# nftban-managed: yes
# nftban-templates-version: 1

[nftban-postfix]
enabled   = @@NFTBAN_F2B_POSTFIX_JAIL@@
filter    = postfix
backend   = auto
port      = smtp,ssmtp,submission
logpath   = @@NFTBAN_F2B_POSTFIX_LOG@@
maxretry  = @@NFTBAN_F2B_POSTFIX_MAX_RETRY@@
findtime  = @@NFTBAN_F2B_POSTFIX_FIND_TIME@@
bantime   = @@NFTBAN_F2B_POSTFIX_BAN_TIME@@

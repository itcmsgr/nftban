 726: nftban_report_schedule_remove() {
 727:     # Remove scheduled report
 728:     local frequency="${1:-}"
 729: 
 730:     if [[ -z "$frequency" ]]; then
 731:         echo "ERROR: Specify frequency to remove (daily, weekly, monthly, or all)" >&2
 732:         return 1
 733:     fi
 734: 
 735:     if [[ ! -f "$NFTBAN_CRON_FILE" ]]; then
 736:         echo "No scheduled reports configured"
 737:         return 0
 738:     fi
 739: 
 740:     if [[ "$frequency" == "all" ]]; then
 741:         rm -f "$NFTBAN_CRON_FILE"
 742:         echo "All scheduled reports removed"
 743:     else
 744:         # Selective removal - remove only the specified frequency
 745:         local pattern=""
 746:         case "$frequency" in
 747:             daily)
 748:                 pattern="nftban report run daily"
 749:                 ;;
 750:             weekly)
 751:                 pattern="nftban report run weekly"
 752:                 ;;
 753:             monthly)
 754:                 pattern="nftban report run monthly"
 755:                 ;;
 756:             *)
 757:                 echo "ERROR: Invalid frequency: $frequency" >&2
 758:                 echo "Valid options: daily, weekly, monthly, all" >&2
 759:                 return 1
 760:                 ;;
 761:         esac
 762: 
 763:         # Create temp file without the matching entries
 764:         local temp_file
 765:         temp_file=$(mktemp)
 766:         # Ensure cleanup on exit/error
 767:         trap 'rm -f "$temp_file" 2>/dev/null' EXIT
 768: 
 769:         # Remove matching cron entry and its comment line
 770:         local skip_next=false
 771:         while IFS= read -r line; do
 772:             # Skip comment line for this frequency
 773:             if [[ "$line" =~ ^#.*${frequency^}.*report ]]; then
 774:                 skip_next=true
 775:                 continue
 776:             fi
 777: 
 778:             # Skip the actual cron entry
 779:             if [[ "$line" == *"$pattern"* ]]; then
 780:                 skip_next=false
 781:                 continue
 782:             fi
 783: 
 784:             # Skip blank line after removed entry
 785:             if $skip_next && [[ -z "$line" ]]; then
 786:                 skip_next=false
 787:                 continue
 788:             fi
 789: 
 790:             skip_next=false
 791:             echo "$line"
 792:         done < "$NFTBAN_CRON_FILE" > "$temp_file"
 793: 
 794:         # Check if anything remains besides headers
 795:         local remaining_entries
 796:         remaining_entries=$(grep -cE "^[0-9].*nftban report run" "$temp_file" 2>/dev/null || echo "0")
 797: 
 798:         if [[ "$remaining_entries" -eq 0 ]]; then
 799:             # No report entries left, but keep snapshot/cleanup
 800:             local has_other
 801:             has_other=$(grep -cE "^[0-9]" "$temp_file" 2>/dev/null || echo "0")
 802:             if [[ "$has_other" -eq 0 ]]; then
 803:                 rm -f "$NFTBAN_CRON_FILE" "$temp_file"
 804:                 echo "${frequency^} report removed (cron file cleaned up - no entries remaining)"
 805:                 return 0
 806:             fi
 807:         fi
 808: 
 809:         mv "$temp_file" "$NFTBAN_CRON_FILE"
 810:         chmod 644 "$NFTBAN_CRON_FILE"
 811:         echo "${frequency^} report schedule removed"
 812:     fi
 813: }

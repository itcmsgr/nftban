                echo "--json"
                echo "help"
                ;;
            *)
                # No subcommands
                ;;
        esac
        return 0
    fi

    # Level 2: Options for specific subcommands
    if (( cword == 2 )); then
        local subcmd="${words[1]}"
        case "${cmd}_${subcmd}" in
            geoip_lookup)
                echo "json"
                echo "compact"
                echo "country"
                ;;
            geoip_config)
                echo "show"
                echo "set-source"
                echo "set-key"

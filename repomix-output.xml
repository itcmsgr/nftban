 410: // cmdSuricataDaemon runs the Suricata processor in daemon mode
 411: func cmdSuricataDaemon() error {
 412: 	// Check for privilege (root OR CAP_NET_ADMIN capability)
 413: 	if err := checkPrivilege(); err != nil {
 414: 		return err
 415: 	}
 416: 
 417: 	fmt.Println(version.BannerWithEmoji("🛡️", "Suricata Daemon"))
 418: 	fmt.Println(strings.Repeat("=", 70))
 419: 	fmt.Println()
 420: 
 421: 	// Initialize analytics (for ban tracking)
 422: 	// Note: main.go only initializes for "ban" and "analytics" commands
 423: 	// We need it for "suricata daemon" too
 424: 	if err := initAnalyticsIfNeeded(); err != nil {
 425: 		fmt.Printf("⚠️  Analytics disabled: %v\n", err)
 426: 	} else {
 427: 		fmt.Println("✅ Analytics enabled")
 428: 		// Ensure we save on exit
 429: 		defer saveAnalyticsIfNeeded()
 430: 	}
 431: 	fmt.Println()
 432: 
 433: 	// Create ban handler using existing netlink infrastructure
 434: 	banHandler, err := suricata.NewNetlinkBanHandler()
 435: 	if err != nil {
 436: 		return fmt.Errorf("failed to create ban handler: %w", err)
 437: 	}
 438: 	defer banHandler.Close()
 439: 
 440: 	// Create processor
 441: 	suricataConfigDir, evePath, logDir, _ := getSuricataPaths()
 442: 	cfg := &suricata.ProcessorConfig{
 443: 		ConfigDir:  suricataConfigDir,
 444: 		EvePath:    evePath,
 445: 		LogPath:    logDir + "/suricata-events.log",
 446: 		BanHandler: banHandler,
 447: 	}
 448: 
 449: 	processor, err := suricata.NewProcessor(cfg)
 450: 	if err != nil {
 451: 		return fmt.Errorf("failed to create processor: %w", err)
 452: 	}
 453: 
 454: 	// Start processor
 455: 	if err := processor.Start(); err != nil {
 456: 		return fmt.Errorf("failed to start processor: %w", err)
 457: 	}
 458: 
 459: 	// Setup signal handling for graceful shutdown
 460: 	sigChan := make(chan os.Signal, 1)
 461: 	signal.Notify(sigChan, syscall.SIGINT, syscall.SIGTERM)
 462: 
 463: 	fmt.Println("✅ Daemon started - Press Ctrl+C to stop")
 464: 	fmt.Println()
 465: 
 466: 	// Wait for signal
 467: 	sig := <-sigChan
 468: 	fmt.Printf("\n📡 Received signal: %v\n", sig)
 469: 
 470: 	// Stop processor
 471: 	if err := processor.Stop(); err != nil {
 472: 		return fmt.Errorf("failed to stop processor: %w", err)
 473: 	}
 474: 
 475: 	fmt.Println("✅ Daemon stopped gracefully")
 476: 	return nil
 477: }

<file path="cli/lib/nftban/exporters/nftban_portscan_exporter.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - Portscan Metrics Exporter
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Export port scan detection metrics in Prometheus text exposition format
  7: # Location: /usr/lib/nftban/exporters/nftban_portscan_exporter.sh
  8: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
  9: # meta:homepage=https://nftban.com
 10: # nftban — Simplifying Linux Firewall Management
 11: #
 12: # meta:name=nftban_portscan_exporter
 13: # meta:type=exporter
 14: # meta:header=Portscan Metrics Exporter
 15: # meta:version=1.0.0
 16: #
 17: # **Description & Purpose**
 18: # meta:description=Export port scan detection and blocking metrics for Prometheus
 19: # meta:input=/var/log/nftban/nftban-actions.log, /etc/nftban/conf.d/portscan.conf
 20: # meta:output=Prometheus text exposition format metrics appended to main metrics file
 21: #
 22: # **Metrics Collected**
 23: # - nftban_portscan_monitored_ports: Number of ports being monitored
 24: # - nftban_portscan_blocked_24h: Port scans blocked in last 24 hours
 25: # - nftban_portscan_blocked_total: Total port scans blocked
 26: # - nftban_portscan_module_enabled: Whether portscan module is enabled (0/1)
 27: #
 28: # **Inventory & Requirements**
 29: # meta:depends=bash,jq,date
 30: # meta:requires_env=NFTBAN_LIB_DIR
 31: #
 32: # meta:created_date=2025-11-19
 33: # =============================================================================
 34: 
 35: # Enhanced strict mode
 36: set -Eeuo pipefail
 37: IFS=$'\n\t'
 38: umask 027
 39: 
 40: # Source central config for canonical paths (NO HARDCODED FALLBACKS)
 41: # shellcheck source=/etc/nftban/nftban.conf
 42: [[ -f "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf" ]] && source "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf"
 43: 
 44: # CONFIGURATION
 45: readonly NFTBAN_LIB_DIR="${NFTBAN_LIB_DIR}"
 46: readonly OUTPUT_FILE="${NFTBAN_METRICS_FILE:-/var/lib/node_exporter/textfile_collector/nftban.prom}"
 47: readonly ACTIONS_LOG="${NFTBAN_LOG_DIR}/nftban-actions.log"
 48: readonly PORTSCAN_CONF="${NFTBAN_CONFIG_DIR}/conf.d/portscan.conf"
 49: 
 50: # =============================================================================
 51: # HELPER FUNCTIONS
 52: # =============================================================================
 53: 
 54: # Get monitored ports count from config
 55: get_monitored_ports_count() {
 56:     local count=0
 57: 
 58:     if [[ ! -f "$PORTSCAN_CONF" ]]; then
 59:         echo "0"
 60:         return
 61:     fi
 62: 
 63:     # Check if portscan is enabled
 64:     local enabled
 65:     enabled=$(grep "^PORTSCAN_ENABLED=" "$PORTSCAN_CONF" 2>/dev/null | cut -d= -f2 | tr -d '"' || echo "false")
 66: 
 67:     if [[ "$enabled" != "true" ]]; then
 68:         echo "0"
 69:         return
 70:     fi
 71: 
 72:     # Get monitored ports value
 73:     local ports_line
 74:     ports_line=$(grep "^PORTSCAN_MONITOR_PORTS=" "$PORTSCAN_CONF" 2>/dev/null || echo "")
 75: 
 76:     if [[ -n "$ports_line" ]]; then
 77:         # Extract value: PORTSCAN_MONITOR_PORTS="value"
 78:         local ports_value
 79:         ports_value=$(echo "$ports_line" | cut -d= -f2 | tr -d '"' | tr -d "'" | xargs)
 80: 
 81:         # Handle special values
 82:         if [[ "$ports_value" == "closed" ]] || [[ "$ports_value" == "all" ]]; then
 83:             # "closed" or "all" means monitoring is active
 84:             count=1
 85:         else
 86:             # Count specific port numbers
 87:             count=$(echo "$ports_value" | { grep -o '[0-9]\+' || true; } | wc -l || echo "0")
 88:         fi
 89:     fi
 90: 
 91:     echo "$count"
 92: }
 93: 
 94: # Get portscan blocked count (24h)
 95: get_portscan_blocked_24h() {
 96:     if [[ ! -f "$ACTIONS_LOG" ]]; then
 97:         echo "0"
 98:         return
 99:     fi
100: 
101:     if ! command -v jq &>/dev/null; then
102:         echo "0"
103:         return
104:     fi
105: 
106:     # Calculate 24 hours ago timestamp
107:     local yesterday_ts
108:     yesterday_ts=$(date -d '24 hours ago' +%s 2>/dev/null || date -v-24H +%s 2>/dev/null || echo "0")
109: 
110:     if [[ "$yesterday_ts" == "0" ]]; then
111:         echo "0"
112:         return
113:     fi
114: 
115:     # Count portscan bans in last 24 hours
116:     local count
117:     count=$(jq -r --arg ts "$yesterday_ts" \
118:         'select(.source == "portscan" and .event == "ban") |
119:          select((.ts | fromdateiso8601) >= ($ts | tonumber))' \
120:         "$ACTIONS_LOG" 2>/dev/null | \
121:         jq -s '. | length' 2>/dev/null || echo "0")
122: 
123:     echo "$count"
124: }
125: 
126: # Get total portscan blocked count
127: get_portscan_blocked_total() {
128:     if [[ ! -f "$ACTIONS_LOG" ]]; then
129:         echo "0"
130:         return
131:     fi
132: 
133:     if ! command -v jq &>/dev/null; then
134:         echo "0"
135:         return
136:     fi
137: 
138:     # Count total portscan bans
139:     local count
140:     count=$(jq -r 'select(.source == "portscan" and .event == "ban")' \
141:         "$ACTIONS_LOG" 2>/dev/null | \
142:         jq -s '. | length' 2>/dev/null || echo "0")
143: 
144:     echo "$count"
145: }
146: 
147: # Check if portscan module is enabled
148: get_portscan_enabled() {
149:     if [[ ! -f "$PORTSCAN_CONF" ]]; then
150:         echo "0"
151:         return
152:     fi
153: 
154:     local enabled
155:     enabled=$(grep "^PORTSCAN_ENABLED=" "$PORTSCAN_CONF" 2>/dev/null | cut -d= -f2 | tr -d '"' || echo "false")
156: 
157:     if [[ "$enabled" == "true" ]]; then
158:         echo "1"
159:     else
160:         echo "0"
161:     fi
162: }
163: 
164: # =============================================================================
165: # METRIC COLLECTION
166: # =============================================================================
167: 
168: collect_portscan_metrics() {
169:     # Get metrics
170:     local monitored_ports
171:     local blocked_24h
172:     local blocked_total
173:     local module_enabled
174: 
175:     monitored_ports=$(get_monitored_ports_count)
176:     blocked_24h=$(get_portscan_blocked_24h)
177:     blocked_total=$(get_portscan_blocked_total)
178:     module_enabled=$(get_portscan_enabled)
179: 
180:     # Append to main metrics file
181:     {
182:         echo "# HELP nftban_portscan_monitored_ports Number of ports being monitored for port scans"
183:         echo "# TYPE nftban_portscan_monitored_ports gauge"
184:         echo "nftban_portscan_monitored_ports $monitored_ports"
185:         echo ""
186: 
187:         echo "# HELP nftban_portscan_blocked_24h Port scans blocked in last 24 hours"
188:         echo "# TYPE nftban_portscan_blocked_24h gauge"
189:         echo "nftban_portscan_blocked_24h $blocked_24h"
190:         echo ""
191: 
192:         echo "# HELP nftban_portscan_blocked_total Total port scans blocked since logging began"
193:         echo "# TYPE nftban_portscan_blocked_total counter"
194:         echo "nftban_portscan_blocked_total $blocked_total"
195:         echo ""
196: 
197:         echo "# HELP nftban_portscan_module_enabled Whether port scan detection module is enabled (1=enabled, 0=disabled)"
198:         echo "# TYPE nftban_portscan_module_enabled gauge"
199:         echo "nftban_portscan_module_enabled $module_enabled"
200:         echo ""
201:     } >> "$OUTPUT_FILE"
202: }
203: 
204: # =============================================================================
205: # MAIN
206: # =============================================================================
207: 
208: main() {
209:     # Only run if output file exists (main exporter runs first)
210:     if [[ ! -f "$OUTPUT_FILE" ]]; then
211:         exit 0
212:     fi
213: 
214:     # Collect and append metrics
215:     collect_portscan_metrics
216: 
217:     exit 0
218: }
219: 
220: # Run main function
221: main "$@"
222: 
223: # =============================================================================

2667: nftban_health_fix_directories() {
2668:     # Create missing directories with correct ownership and permissions
2669:     # Uses canonical FHS spec from nftban_fhs_spec.sh (SINGLE SOURCE OF TRUTH)
2670:     # Smart about privileges: fixes what it can, reports what needs root
2671: 
2672:     local running_as_root=0
2673:     [[ $EUID -eq 0 ]] && running_as_root=1
2674: 
2675:     echo "Creating missing directories..."
2676: 
2677:     # Load canonical FHS specification
2678:     if ! declare -f nftban_fhs_load_spec >/dev/null 2>&1; then
2679:         source "${NFTBAN_LIB_DIR}/core/nftban_fhs_spec.sh" || {
2680:             echo "  ✖ ERROR: Failed to load FHS specification" >&2
2681:             return 1
2682:         }
2683:     fi
2684: 
2685:     # Ensure spec is loaded
2686:     if [[ ${#NFTBAN_FHS_DIRECTORIES[@]} -eq 0 ]]; then
2687:         nftban_fhs_load_spec
2688:     fi
2689: 
2690:     local fixed_count=0
2691:     local need_root_count=0
2692:     declare -a need_root_dirs=()
2693: 
2694:     for dir in "${!NFTBAN_FHS_DIRECTORIES[@]}"; do
2695:         if [[ ! -d "$dir" ]]; then
2696:             IFS='|' read -r perms owner group _purpose <<< "${NFTBAN_FHS_DIRECTORIES[$dir]}"
2697: 
2698:             # Check if we can create this directory
2699:             local parent_dir
2700:             parent_dir=$(dirname "$dir")
2701:             local can_create=0
2702: 
2703:             # Check if nftban user can write to parent
2704:             if [[ "$owner" == "nftban" ]] && [[ -d "$parent_dir" ]] && [[ -w "$parent_dir" ]]; then
2705:                 can_create=1
2706:             elif [[ $running_as_root -eq 1 ]]; then
2707:                 can_create=1
2708:             fi
2709: 
2710:             if [[ $can_create -eq 1 ]]; then
2711:                 # We can create this directory
2712:                 if mkdir -p "$dir" 2>/dev/null; then
2713:                     # Set ownership (only if root or already correct owner)
2714:                     if [[ $running_as_root -eq 1 ]]; then
2715:                         chown "${owner}:${group}" "$dir" 2>/dev/null || true
2716:                         chmod "$perms" "$dir" 2>/dev/null || true
2717:                         echo "  ✓ Created $dir (${perms} ${owner}:${group})"
2718:                     else
2719:                         # nftban user created it, ownership is already correct
2720:                         chmod "$perms" "$dir" 2>/dev/null || true
2721:                         echo "  ✓ Created $dir (${perms} ${owner}:${group})"
2722:                     fi
2723:                     : $((fixed_count++))
2724: 
2725:                     # Log to audit trail
2726:                     if declare -f perms_log_audit >/dev/null 2>&1; then
2727:                         perms_log_audit "Health auto-fix: Created directory $dir ($perms $owner:$group)"
2728:                     fi
2729:                 else
2730:                     # mkdir failed
2731:                     need_root_dirs+=("$dir: mkdir failed (check parent directory permissions)")
2732:                     ((need_root_count++))
2733:                 fi
2734:             else
2735:                 # Need root to create this
2736:                 need_root_dirs+=("$dir → ${perms} ${owner}:${group} (parent: $parent_dir not writable)")
2737:                 ((need_root_count++))
2738:             fi
2739:         fi
2740:     done
2741: 
2742:     if [[ $fixed_count -eq 0 ]] && [[ $need_root_count -eq 0 ]]; then
2743:         echo "  ✓ All directories already exist"
2744:     fi
2745: 
2746:     # Report what needs root
2747:     if [[ $need_root_count -gt 0 ]]; then
2748:         echo ""
2749:         echo "  ⚠️  Cannot create $need_root_count directories (need root privileges):"
2750:         for item in "${need_root_dirs[@]}"; do
2751:             echo "     - $item"
2752:         done
2753:         echo ""
2754:         echo "  💡 Run with root privileges to fix:"
2755:         echo "     sudo nftban health fix directories"
2756:     fi
2757:     return 0
2758: }

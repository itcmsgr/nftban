 878: check_service_clean() {
 879:     # Check and display service status with clean format (dot leaders)
 880:     # Args: service_name systemd_unit
 881:     local name="$1"
 882:     local unit="$2"
 883: 
 884:     # Pad name with dots for alignment
 885:     local padded_name
 886:     padded_name=$(printf "%-16s" "$name")
 887:     padded_name="${padded_name// /.}"
 888: 
 889:     # Check if unit exists
 890:     if ! systemctl list-unit-files "$unit" --no-legend 2>/dev/null | grep -q "$unit"; then
 891:         printf "  %s NOT INSTALLED\n" "$padded_name"
 892:         return 0
 893:     fi
 894: 
 895:     # Check if active
 896:     if ! systemctl is-active "$unit" >/dev/null 2>&1; then
 897:         # For timer-triggered services, check if the corresponding timer is active
 898:         local timer_unit="${unit%.service}.timer"
 899:         if systemctl is-active "$timer_unit" >/dev/null 2>&1; then
 900:             printf "  %s TIMER (scheduled)\n" "$padded_name"
 901:             return 0
 902:         fi
 903:         # Check if enabled but not running
 904:         if systemctl is-enabled "$unit" >/dev/null 2>&1; then
 905:             printf "  %s ENABLED (stopped)\n" "$padded_name"
 906:         else
 907:             printf "  %s INACTIVE\n" "$padded_name"
 908:         fi
 909:         return 0
 910:     fi
 911: 
 912:     # Active - get details
 913:     local pid mem_mb uptime_str=""
 914:     pid=$(systemctl show "$unit" --property=MainPID --value 2>/dev/null || echo "")
 915: 
 916:     if [[ -n "$pid" ]] && [[ "$pid" != "0" ]]; then
 917:         # Memory in MB
 918:         mem_mb=$(ps -o rss= -p "$pid" 2>/dev/null | awk '{printf "%.1fMB", $1/1024}' || echo "")
 919: 
 920:         # Uptime
 921:         local start_time start_epoch now_epoch
 922:         start_time=$(ps -o lstart= -p "$pid" 2>/dev/null || echo "")
 923:         if [[ -n "$start_time" ]]; then
 924:             start_epoch=$(date -d "$start_time" +%s 2>/dev/null || echo "0")
 925:             now_epoch=$(date +%s)
 926:             local uptime_sec
 927:             uptime_sec=$((now_epoch - start_epoch))
 928:             if [[ $uptime_sec -ge 86400 ]]; then
 929:                 uptime_str="$((uptime_sec / 86400))d"
 930:             elif [[ $uptime_sec -ge 3600 ]]; then
 931:                 uptime_str="$((uptime_sec / 3600))h"
 932:             else
 933:                 uptime_str="$((uptime_sec / 60))m"
 934:             fi
 935:         fi
 936: 
 937:         local details=""
 938:         [[ -n "$pid" ]] && details="pid:$pid"
 939:         [[ -n "$mem_mb" ]] && details="${details:+$details }$mem_mb"
 940:         [[ -n "$uptime_str" ]] && details="${details:+$details }up:$uptime_str"
 941: 
 942:         printf "  %s ACTIVE (%s)\n" "$padded_name" "$details"
 943:     else
 944:         printf "  %s ACTIVE\n" "$padded_name"
 945:     fi
 946:     return 0
 947: }
 948: 
 949: check_service_detailed() {
 950:     # Check and display detailed service status with memory, CPU, PID, uptime, port
 951:     # Args: service_name systemd_unit
 952:     local name="$1"
 953:     local unit="$2"
 954: 
 955:     # Check if unit exists
 956:     if ! systemctl list-unit-files "$unit" --no-legend 2>/dev/null | grep -q "$unit"; then
 957:         printf "  %-18s ⚪ Not installed\n" "$name:"
 958:         return 0
 959:     fi
 960: 
 961:     # Check if active
 962:     if ! systemctl is-active "$unit" >/dev/null 2>&1; then
 963:         # Check if enabled but not running
 964:         if systemctl is-enabled "$unit" >/dev/null 2>&1; then
 965:             printf "  %-18s ⚠️  Enabled (not running)\n" "$name:"
 966:         else
 967:             printf "  %-18s ⚪ Inactive\n" "$name:"
 968:         fi
 969:         return 0
 970:     fi
 971: 
 972:     # Active - get details
 973:     local pid mem_mb uptime_str port_info=""
 974: 
 975:     # Get main PID
 976:     pid=$(systemctl show "$unit" --property=MainPID --value 2>/dev/null || echo "")
 977: 
 978:     if [[ -n "$pid" ]] && [[ "$pid" != "0" ]]; then
 979:         # Get memory usage (RSS in MB)
 980:         mem_mb=$(ps -o rss= -p "$pid" 2>/dev/null | awk '{printf "%.1f", $1/1024}' || echo "?")
 981: 
 982:         # Get process uptime
 983:         local start_time
 984:         start_time=$(ps -o lstart= -p "$pid" 2>/dev/null || echo "")
 985:         if [[ -n "$start_time" ]]; then
 986:             local start_epoch now_epoch diff_sec
 987:             start_epoch=$(date -d "$start_time" +%s 2>/dev/null || echo "0")
 988:             now_epoch=$(date +%s)
 989:             diff_sec=$((now_epoch - start_epoch))
 990: 
 991:             if [[ $diff_sec -ge 86400 ]]; then
 992:                 uptime_str="$((diff_sec / 86400))d"
 993:             elif [[ $diff_sec -ge 3600 ]]; then
 994:                 uptime_str="$((diff_sec / 3600))h"
 995:             elif [[ $diff_sec -ge 60 ]]; then
 996:                 uptime_str="$((diff_sec / 60))m"
 997:             else
 998:                 uptime_str="${diff_sec}s"
 999:             fi
1000:         else
1001:             uptime_str="?"
1002:         fi
1003: 
1004:         # Get listening port for certain services
1005:         case "$name" in
1006:             nftban-api)
1007:                 port_info=$(ss -tlnp 2>/dev/null | grep "pid=$pid" | awk '{print $4}' | grep -oP ':\d+$' | tr '\n' ',' | sed 's/,$//' || echo "")
1008:                 ;;
1009:             metrics-exporter)
1010:                 port_info=$(ss -tlnp 2>/dev/null | grep "pid=$pid" | awk '{print $4}' | grep -oP ':\d+$' | tr '\n' ',' | sed 's/,$//' || echo "")
1011:                 ;;
1012:             suricata)
1013:                 # Suricata uses AF_PACKET, check interface
1014:                 local iface
1015:                 iface=$(grep -oP 'interface:\s*\K\S+' /etc/suricata/suricata.yaml 2>/dev/null | head -1 || echo "")
1016:                 [[ -n "$iface" ]] && port_info="$iface"
1017:                 ;;
1018:         esac
1019: 
1020:         # Build output line
1021:         local detail_str="pid:$pid mem:${mem_mb}MB up:$uptime_str"
1022:         [[ -n "$port_info" ]] && detail_str="$detail_str $port_info"
1023: 
1024:         printf "  %-18s ✅ Active (%s)\n" "$name:" "$detail_str"
1025:     else
1026:         printf "  %-18s ✅ Active\n" "$name:"
1027:     fi
1028: }

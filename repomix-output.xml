 59: 		fmt.Println("  ℹ️  Continuing with defaults...")
 60: 	} else {
 61: 		fmt.Printf("  ✅ Loaded FHS specification (%d directories)\n", len(fhsSpec))
 62: 	}
 63: 
 64: 	// Load distro config
 65: 	distro, err := config.LoadDistroConfig()
 66: 	if err != nil {
 67: 		fmt.Fprintf(os.Stderr, "  ⚠️  Warning: Could not load distro config: %v\n", err)
 68: 		fmt.Println("  ℹ️  Continuing with defaults...")
 69: 	} else {
 70: 		fmt.Printf("  ✅ Detected distribution: %s\n", distro.Name)
 71: 	}
 72: 
 73: 	// Load services config
 74: 	services, err := config.LoadServicesConfig()
 75: 	if err != nil {
 76: 		fmt.Fprintf(os.Stderr, "  ⚠️  Warning: Could not load services config: %v\n", err)
 77: 	} else {
 78: 		fmt.Printf("  ✅ Loaded services configuration\n")
 79: 		if !services["nftban"] {
 80: 			return fmt.Errorf("NFTBan is disabled in services.conf")
 81: 		}
 82: 	}
 83: 	fmt.Println()
 84: 
 85: 	// Step 5: Create emergency whitelist file
 86: 	fmt.Println("Step 3: Creating emergency whitelist...")
 87: 	emergencyFile := config.GetFHSPath("config") + "/emergency_whitelist.conf"
 88: 
 89: 	f, err := os.OpenFile(emergencyFile, os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0644)
 90: 	if err != nil {
 91: 		return fmt.Errorf("failed to create emergency whitelist: %w", err)
 92: 	}
 93: 
 94: 	fmt.Fprintf(f, "# NFTBan Emergency Whitelist\n")
 95: 	fmt.Fprintf(f, "# Auto-generated: %s\n", time.Now().Format(time.RFC3339))
 96: 	fmt.Fprintf(f, "# These IPs are CRITICAL and must NEVER be blocked!\n\n")
 97: 
 98: 	if sysIPs.CurrentUserIP != nil {
 99: 		fmt.Fprintf(f, "# Your current SSH connection:\n")
100: 		fmt.Fprintf(f, "%s\n\n", sysIPs.CurrentUserIP)
101: 	}
102: 
103: 	fmt.Fprintf(f, "# Server interface IPs:\n")
104: 	for _, ip := range sysIPs.ServerIPs {
105: 		fmt.Fprintf(f, "%s\n", ip)
106: 	}
107: 
108: 	if len(sysIPs.GatewayIPs) > 0 {
109: 		fmt.Fprintf(f, "\n# Gateway IPs:\n")
110: 		for _, ip := range sysIPs.GatewayIPs {
111: 			fmt.Fprintf(f, "%s\n", ip)
112: 		}
113: 	}
114: 
115: 	if len(sysIPs.DNSServers) > 0 {
116: 		fmt.Fprintf(f, "\n# DNS Servers:\n")
117: 		for _, ip := range sysIPs.DNSServers {
118: 			fmt.Fprintf(f, "%s\n", ip)
119: 		}
120: 	}
121: 
122: 	f.Close()
123: 	fmt.Printf("  ✅ Created: %s\n", emergencyFile)
124: 	fmt.Println()
125: 
126: 	// Step 6: Update whitelist using organized whitelist.d/ structure
127: 	fmt.Println("Step 4: Updating whitelist (whitelist.d/ structure)...")
128: 	whitelistDir := config.GetFHSPath("config") + "/whitelist.d"
129: 	whitelistFile := whitelistDir + "/01-nftban-init.conf"
130: 
131: 	// Ensure whitelist.d directory exists
132: 	if err := os.MkdirAll(whitelistDir, 0750); err != nil {
133: 		return fmt.Errorf("failed to create whitelist.d: %w", err)
134: 	}
135: 
136: 	// Read existing whitelist from ALL sources (whitelist.conf + whitelist.d/*)
137: 	existingIPs := make(map[string]bool)
138: 
139: 	// Read main whitelist.conf
140: 	mainWhitelist := config.GetFHSPath("config") + "/whitelist.conf"
141: 	if data, err := os.ReadFile(mainWhitelist); err == nil {
142: 		lines := strings.Split(string(data), "\n")
143: 		for _, line := range lines {
144: 			line = strings.TrimSpace(line)
145: 			if line != "" && !strings.HasPrefix(line, "#") {
146: 				existingIPs[line] = true
147: 			}
148: 		}
149: 	}
150: 
151: 	// Read all files in whitelist.d/
152: 	if entries, err := os.ReadDir(whitelistDir); err == nil {
153: 		for _, entry := range entries {
154: 			if entry.IsDir() || !strings.HasSuffix(entry.Name(), ".conf") {
155: 				continue
156: 			}
157: 			filePath := whitelistDir + "/" + entry.Name()
158: 			if data, err := os.ReadFile(filePath); err == nil {
159: 				lines := strings.Split(string(data), "\n")
160: 				for _, line := range lines {
161: 					line = strings.TrimSpace(line)
162: 					if line != "" && !strings.HasPrefix(line, "#") {
163: 						existingIPs[line] = true
164: 					}
165: 				}
166: 			}
167: 		}
168: 	}
169: 
170: 	// Check what IPs need to be added
171: 	allIPs := sysIPs.GetAllIPs()
172: 	var newIPs []string
173: 	for _, ip := range allIPs {
174: 		ipStr := ip.String()
175: 		if !existingIPs[ipStr] {
176: 			newIPs = append(newIPs, ipStr)
177: 		}
178: 	}
179: 
180: 	if len(newIPs) > 0 {
181: 		// Create/append to 01-nftban-init.conf
182: 		f, err = os.OpenFile(whitelistFile, os.O_CREATE|os.O_WRONLY|os.O_TRUNC, 0640)
183: 		if err != nil {
184: 			return fmt.Errorf("failed to open whitelist: %w", err)
185: 		}
186: 		defer f.Close()
187: 
188: 		fmt.Fprintf(f, "# NFTBan Init Auto-Whitelist\n")
189: 		fmt.Fprintf(f, "# Auto-generated: %s\n", time.Now().Format(time.RFC3339))
190: 		fmt.Fprintf(f, "# Critical system IPs detected during initialization\n")
191: 		fmt.Fprintf(f, "# DO NOT DELETE - LOCKOUT RISK!\n\n")
192: 
193: 		if sysIPs.CurrentUserIP != nil {
194: 			found := false
195: 			for _, ip := range newIPs {
196: 				if ip == sysIPs.CurrentUserIP.String() {
197: 					found = true
198: 					break
199: 				}
200: 			}
201: 			if found {
202: 				fmt.Fprintf(f, "# Current SSH connection:\n")
203: 				fmt.Fprintf(f, "%s\n\n", sysIPs.CurrentUserIP)
204: 			}
205: 		}
206: 
207: 		// Server IPs
208: 		serverIPsAdded := false
209: 		for _, ip := range sysIPs.ServerIPs {
210: 			ipStr := ip.String()
211: 			for _, newIP := range newIPs {
212: 				if newIP == ipStr {
213: 					if !serverIPsAdded {
214: 						fmt.Fprintf(f, "# Server interface IPs:\n")
215: 						serverIPsAdded = true
216: 					}
217: 					fmt.Fprintf(f, "%s\n", ipStr)
218: 					break
219: 				}
220: 			}
221: 		}
222: 		if serverIPsAdded {
223: 			fmt.Fprintf(f, "\n")
224: 		}
225: 
226: 		// Gateway IPs
227: 		if len(sysIPs.GatewayIPs) > 0 {
228: 			gatewayIPsAdded := false
229: 			for _, ip := range sysIPs.GatewayIPs {
230: 				ipStr := ip.String()
231: 				for _, newIP := range newIPs {
232: 					if newIP == ipStr {
233: 						if !gatewayIPsAdded {
234: 							fmt.Fprintf(f, "# Gateway IPs:\n")
235: 							gatewayIPsAdded = true
236: 						}
237: 						fmt.Fprintf(f, "%s\n", ipStr)
238: 						break
239: 					}
240: 				}
241: 			}
242: 			if gatewayIPsAdded {
243: 				fmt.Fprintf(f, "\n")
244: 			}
245: 		}
246: 
247: 		// DNS Servers
248: 		if len(sysIPs.DNSServers) > 0 {
249: 			dnsIPsAdded := false
250: 			for _, ip := range sysIPs.DNSServers {
251: 				ipStr := ip.String()
252: 				for _, newIP := range newIPs {
253: 					if newIP == ipStr {
254: 						if !dnsIPsAdded {
255: 							fmt.Fprintf(f, "# DNS Servers:\n")
256: 							dnsIPsAdded = true
257: 						}
258: 						fmt.Fprintf(f, "%s\n", ipStr)
259: 						break
260: 					}
261: 				}
262: 			}
263: 		}
264: 
265: 		fmt.Printf("  ✅ Added %d new IPs to whitelist\n", len(newIPs))
266: 		fmt.Printf("  ✅ Updated: %s\n", whitelistFile)
267: 	} else {
268: 		fmt.Println("  ℹ️  All critical IPs already whitelisted")
269: 	}
270: 	fmt.Println()
271: 
272: 	// Step 7: Success!
273: 	fmt.Println(strings.Repeat("=", 70))
274: 	fmt.Println("✅ NFTBan initialized successfully!")
275: 	fmt.Println()
276: 	fmt.Println("CRITICAL IPs whitelisted:")
277: 	for _, ip := range allIPs {
278: 		fmt.Printf("  ✅ %s\n", ip)
279: 	}
280: 	fmt.Println()
281: 	fmt.Println("Whitelist files structure:")
282: 	fmt.Printf("  📁 /etc/nftban/whitelist.conf (main file)\n")
283: 	fmt.Printf("  📁 /etc/nftban/whitelist.d/*.conf (modular includes)\n")
284: 	fmt.Printf("  📁 %s (emergency backup)\n", emergencyFile)
285: 	fmt.Println()

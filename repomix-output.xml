348: # Detected from: $sshd_config
349: [ssh]
350: port=$ssh_port
351: protocol=tcp
352: direction=input
353: EOF
354:         chmod 644 "$ssh_conf"
355:         echo "  ✅ SSH port whitelisted: $ssh_port/tcp"
356:     else
357:         echo "  ✅ SSH port already whitelisted: $ssh_port/tcp"
358:     fi

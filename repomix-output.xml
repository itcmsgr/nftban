357:             hours.push(hour.getHours() + ':00');
358:         }
359: 
360:         // Try to load real bandwidth/traffic data
361:         try {
362:             const trafficResp = await apiRequest('/stats/traffic');
363:             if (trafficResp.success && trafficResp.data && bandwidthChart) {
364:                 const data = trafficResp.data;
365:                 bandwidthChart.data.labels = data.labels || data.hours || hours;
366:                 bandwidthChart.data.datasets[0].data = data.bandwidth_in || data.incoming || hours.map(() => 0);
367:                 bandwidthChart.data.datasets[1].data = data.bandwidth_out || data.outgoing || hours.map(() => 0);
368:                 bandwidthChart.update();
369:             }
370:         } catch (err) {
371:             console.log('[DASHBOARD] Traffic API not available, using empty data');
372:             if (bandwidthChart) {
373:                 bandwidthChart.data.labels = hours;
374:                 bandwidthChart.data.datasets[0].data = hours.map(() => 0);
375:                 bandwidthChart.data.datasets[1].data = hours.map(() => 0);

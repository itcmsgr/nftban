613:         echo "  Config:       $SURICATA_CONF_DIR/suricata.yaml"
614:         echo "  Eve.json:     $SURICATA_LOG_DIR/eve.json (NFTBan HFS)"
615:         echo "  Rules:        $SURICATA_DATA_DIR/rules"
616:         echo "  Version:      $SURICATA_VERSION"
617:         echo ""
618:         print_info "Performance Expectations:"
619:         echo "  CPU Usage:    10-30% of 1 core (medium traffic)"
620:         echo "  RAM Usage:    300-600 MB typical, 600-800 MB peaks"
621:         echo "  Optimization: 40-60% CPU reduction vs unoptimized"
622:         echo ""
623:         print_info "Next Steps:"
624:         echo "  1. Check eve.json: tail -f $SURICATA_LOG_DIR/eve.json"
625:         echo "  2. Monitor stats: journalctl -u suricata -f"
626:         echo "  3. Customize rules: edit $SURICATA_CONF_DIR/*.conf.local"
627:         echo "  4. Enable in NFTBan: edit /etc/nftban/nftban.conf"
628:         echo "     Set: NFTBAN_SURICATA_ENABLED=\"true\""
629:         echo ""
630:         print_info "Rule Management:"
631:         echo "  - See: $SURICATA_CONF_DIR/README.md"
632:         echo "  - Enable optional rules: $SURICATA_CONF_DIR/enable.conf.local"
633:         echo "  - Disable noisy rules: $SURICATA_CONF_DIR/disable.conf.local"
634:         echo ""
635:     else
636:         print_error "Suricata failed to start"
637:         systemctl status suricata --no-pager -l
638:         exit 1
639:     fi
640: 
641:     echo ""
642:     print_status "Suricata installation complete!"
643:     echo ""
644: }
645: 
646: main "$@"

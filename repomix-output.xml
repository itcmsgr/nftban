  39: # Functions
  40: log_info() { echo -e "${BLUE}[INFO]${NC} $*"; }
  41: log_success() { echo -e "${GREEN}[✓]${NC} $*"; }
  42: log_warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
  43: log_error() { echo -e "${RED}[ERROR]${NC} $*"; }

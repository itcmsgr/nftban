<file path="install/config/feeds.conf">
  1: # =============================================================================
  2: # NFTBan v0.32.6 - Threat Feeds Configuration
  3: # =============================================================================
  4: # SPDX-License-Identifier: MPL-2.0
  5: # Purpose: Dynamic threat intelligence feed configuration
  6: #
  7: # IMPORTANT: ALL FEEDS ARE DISABLED BY DEFAULT FOR SAFETY
  8: # Use 'nftban feeds select' to interactively enable feeds
  9: # Use 'nftban feeds enable <name>' to enable specific feeds
 10: #
 11: # ⚠️  WARNING: LARGE FEEDS IMPACT PERFORMANCE!
 12: # Feeds with 100K+ entries make 'nft list ruleset' VERY SLOW (60-90 seconds).
 13: # ALWAYS use 'nft -t list ruleset' (terse mode) instead - it's fast.
 14: # See docs/FEEDS_PERFORMANCE.md for details.
 15: #
 16: # Pattern: FEED_<NAME>_<PROPERTY>="value"
 17: # This file is DYNAMIC - feeds are auto-discovered by scanning for FEED_*_URL
 18: # To add a new feed, just add the 4 required variables below
 19: # =============================================================================
 20: 
 21: # =============================================================================
 22: # GLOBAL SETTINGS
 23: # =============================================================================
 24: 
 25: # Master switch for feeds system
 26: FEEDS_ENABLED="true"
 27: 
 28: # Update settings
 29: FEEDS_UPDATE_INTERVAL="3600"                    # 1 hour (seconds)
 30: FEEDS_AUTO_UPDATE="true"                        # Auto-update via timer
 31: FEEDS_DOWNLOAD_TIMEOUT="30"                     # Download timeout (seconds)
 32: 
 33: # Validation settings
 34: FEEDS_MIN_ENTRIES="10"                          # Minimum valid entries
 35: FEEDS_MAX_ENTRIES="500000"                      # Maximum entries (truncate if exceeded)
 36: 
 37: # Paths
 38: FEEDS_STORAGE_DIR="/var/lib/nftban/feeds"       # Parsed feed files
 39: FEEDS_CACHE_DIR="/var/cache/nftban/feeds"       # Download cache
 40: FEEDS_LOG_FILE="/var/log/nftban/feeds.log"      # Dedicated feeds log for troubleshooting
 41: 
 42: # Logging
 43: FEEDS_LOG_LEVEL="INFO"                          # DEBUG, INFO, WARN, ERROR
 44: FEEDS_LOG_DOWNLOADS="true"                      # Log all download attempts
 45: FEEDS_LOG_PARSING="true"                        # Log parsing details
 46: 
 47: # =============================================================================
 48: # CATEGORY: protection (General Security & Protection)
 49: # =============================================================================
 50: 
 51: # Spamhaus DROP - Known spam sources
 52: FEED_SPAMHAUS_DROP_URL="https://www.spamhaus.org/drop/drop.txt"
 53: FEED_SPAMHAUS_DROP_ENABLED="false"              # ⚠️ DISABLED BY DEFAULT
 54: FEED_SPAMHAUS_DROP_CATEGORY="protection"
 55: FEED_SPAMHAUS_DROP_DESCRIPTION="Spamhaus DROP - Known spam sources"
 56: FEED_SPAMHAUS_DROP_INTERVAL="DAILY"
 57: FEED_SPAMHAUS_DROP_SIZE="~1,000 IPs"
 58: 
 59: 
 60: # Abuse.ch Feodo Tracker - Botnet C&C servers
 61: FEED_ABUSECH_FEODO_URL="https://feodotracker.abuse.ch/downloads/ipblocklist.txt"
 62: FEED_ABUSECH_FEODO_ENABLED="false"              # ⚠️ DISABLED BY DEFAULT
 63: FEED_ABUSECH_FEODO_CATEGORY="protection"
 64: FEED_ABUSECH_FEODO_DESCRIPTION="Abuse.ch Feodo - Botnet C&C servers"
 65: FEED_ABUSECH_FEODO_INTERVAL="DAILY"
 66: FEED_ABUSECH_FEODO_SIZE="~5,000 IPs"
 67: 
 68: # Abuse.ch SSL Blacklist - SSL/TLS abuse
 69: FEED_ABUSECH_SSL_URL="https://sslbl.abuse.ch/blacklist/sslipblacklist.txt"
 70: FEED_ABUSECH_SSL_ENABLED="false"                # ⚠️ DISABLED BY DEFAULT
 71: FEED_ABUSECH_SSL_CATEGORY="protection"
 72: FEED_ABUSECH_SSL_DESCRIPTION="Abuse.ch SSL - SSL/TLS abuse"
 73: FEED_ABUSECH_SSL_INTERVAL="DAILY"
 74: FEED_ABUSECH_SSL_SIZE="~3,000 IPs"
 75: 
 76: # FireHOL Level 1 - High-confidence threats
 77: FEED_FIREHOL_LEVEL1_URL="https://raw.githubusercontent.com/firehol/blocklist-ipsets/master/firehol_level1.netset"
 78: FEED_FIREHOL_LEVEL1_ENABLED="false"             # ⚠️ DISABLED BY DEFAULT

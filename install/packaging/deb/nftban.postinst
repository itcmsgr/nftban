#!/bin/bash
# SPDX-License-Identifier: MPL-2.0
# SPDX-FileCopyrightText: Copyright (c) 2024-2025 NFTBan Development Team
#
# postinst script for nftban (main package)
# Configure after installation
#
# NOTE: Directory creation is handled by:
#   - systemd-sysusers (users/groups)
#   - systemd-tmpfiles (runtime directories)
#   - dh_installdirs (package directories from nftban.dirs)
#
# This script only handles:
#   - Invoking systemd-sysusers and systemd-tmpfiles
#   - Writing initial receipt
#   - Feature-specific configuration (SSH port, GeoIP, etc.)
#   - Enabling default services/timers
#
# meta:name="nftban.postinst"
# meta:type="packaging"
# meta:header="DEB Post-Install"
# meta:version="1.0.0"
# meta:owner="Antonios Voulvoulis <contact@nftban.com>"
# meta:homepage="https://nftban.com"
#
# meta:description="DEB package post-installation script"
# meta:inventory.files=""
# meta:inventory.binaries="systemd-sysusers,systemd-tmpfiles,systemctl"
# meta:inventory.env_vars=""
# meta:inventory.config_files=""
# meta:inventory.systemd_units=""
# meta:inventory.network=""
# meta:inventory.privileges="root"
#
# meta:created_date="2024-12-17"
# meta:updated_date="2026-01-10"

set -Eeuo pipefail

# =============================================================================
# PATH DEFAULTS
# =============================================================================
NFTBAN_CONFIG_DIR="${NFTBAN_CONFIG_DIR:-/etc/nftban}"
NFTBAN_DATA_DIR="${NFTBAN_DATA_DIR:-/var/lib/nftban}"

case "$1" in
    configure)
        echo "Configuring NFTBan..."

        # ======================================================================
        # STEP 1: Create users and groups via systemd-sysusers
        # ======================================================================
        # Uses /usr/lib/sysusers.d/nftban.conf (generated from build/fhs-spec.yaml)
        if [ -f /usr/lib/sysusers.d/nftban.conf ]; then
            echo "Creating system users and groups..."
            systemd-sysusers /usr/lib/sysusers.d/nftban.conf 2>/dev/null || {
                # Fallback for systems without systemd-sysusers
                # NFTBan 3-Group Security Model:
                #   nftban:         Admin/Operator (full access)
                #   nftban-auditor: Read-only (reports, logs)
                #   nftban-panel:   Panel Operator (ban/unban, NO config)
                echo "systemd-sysusers not available, using fallback..."
                if ! getent group nftban >/dev/null; then
                    groupadd -r nftban
                fi
                if ! getent group nftban-auditor >/dev/null; then
                    groupadd -r nftban-auditor
                fi
                if ! getent group nftban-panel >/dev/null; then
                    groupadd -r nftban-panel
                fi
                if ! getent passwd nftban >/dev/null; then
                    useradd -r -g nftban -G nftban-auditor -d "${NFTBAN_DATA_DIR}" \
                        -s /usr/sbin/nologin -c "NFTBan service account" nftban
                fi
            }
        fi

        # ======================================================================
        # DIRECTADMIN PANEL: Add nftban to mysyslog group for logger access
        # ======================================================================
        # DirectAdmin uses 'mysyslog' group for /dev/log socket permissions.
        # Without this, nftban-login-monitor fails with:
        #   logger: socket /dev/log: Permission denied
        # Ref: /run/systemd/journal/dev-log is owned by root:mysyslog (srw-rw----)
        if [ -d /usr/local/directadmin ]; then
            if getent group mysyslog >/dev/null 2>&1; then
                if ! id -nG nftban 2>/dev/null | grep -qw mysyslog; then
                    usermod -a -G mysyslog nftban 2>/dev/null && \
                        echo "DirectAdmin: Added nftban to mysyslog group (syslog access)"
                fi
            fi
        fi

        # ======================================================================
        # STEP 2: Create runtime directories via systemd-tmpfiles
        # ======================================================================
        # Uses /usr/lib/tmpfiles.d/nftban.conf (generated from build/fhs-spec.yaml)
        if [ -f /usr/lib/tmpfiles.d/nftban.conf ]; then
            echo "Creating runtime directories..."
            systemd-tmpfiles --create /usr/lib/tmpfiles.d/nftban.conf 2>/dev/null || {
                echo "Warning: systemd-tmpfiles failed, directories may need manual creation"
            }
        fi

        # ======================================================================
        # STEP 3: Set config directory permissions (root-owned, group readable)
        # ======================================================================
        # Config directories are created by dh_installdirs from nftban.dirs
        # Just ensure correct ownership for daemon read access
        if [ -d "${NFTBAN_CONFIG_DIR}" ]; then
            chown root:nftban "${NFTBAN_CONFIG_DIR}"
            chmod 750 "${NFTBAN_CONFIG_DIR}"
            # Set first-level subdirs only (not recursive into user files)
            find "${NFTBAN_CONFIG_DIR}" -maxdepth 1 -type d -exec chown root:nftban {} \;
            find "${NFTBAN_CONFIG_DIR}" -maxdepth 1 -type d -exec chmod 750 {} \;
            # Fix conf.d files - must be readable by nftban group for services
            find "${NFTBAN_CONFIG_DIR}/conf.d" -name "*.conf" -exec chown root:nftban {} \; 2>/dev/null || true
            find "${NFTBAN_CONFIG_DIR}/conf.d" -name "*.conf" -exec chmod 640 {} \; 2>/dev/null || true
            find "${NFTBAN_CONFIG_DIR}" -name "*.local" -exec chown root:nftban {} \; 2>/dev/null || true
            find "${NFTBAN_CONFIG_DIR}" -name "*.local" -exec chmod 640 {} \; 2>/dev/null || true
        fi

        # Reload systemd
        systemctl daemon-reload >/dev/null 2>&1 || true

        # ======================================================================
        # STEP 4: Auto-detect SSH port and create whitelist
        # ======================================================================
        SSH_PORT="22"
        if [ -f /etc/ssh/sshd_config ]; then
            DETECTED=$(grep -E "^Port\s+" /etc/ssh/sshd_config 2>/dev/null | awk '{print $2}' | head -1)
            if [ -n "$DETECTED" ]; then
                SSH_PORT="$DETECTED"
            fi
        fi

        if [ ! -f "${NFTBAN_CONFIG_DIR}/ports.d/00-ssh.conf" ]; then
            cat > "${NFTBAN_CONFIG_DIR}/ports.d/00-ssh.conf" << EOF
# Auto-generated SSH port whitelist
# Created by: NFTBan package installer
[ssh]
port=$SSH_PORT
protocol=tcp
direction=input
EOF
            chmod 644 "${NFTBAN_CONFIG_DIR}/ports.d/00-ssh.conf"
            chown root:nftban "${NFTBAN_CONFIG_DIR}/ports.d/00-ssh.conf"
            echo "SSH port whitelisted: $SSH_PORT/tcp"
        fi

        # ======================================================================
        # STEP 5: Auto-whitelist system IP (prevents lockout)
        # ======================================================================
        SYSTEM_IP=$(ip route get 1.1.1.1 2>/dev/null | grep -oP 'src \K[0-9.]+' | head -1)
        if [ -z "$SYSTEM_IP" ]; then
            SYSTEM_IP=$(hostname -I 2>/dev/null | awk '{print $1}')
        fi
        if [ -n "$SYSTEM_IP" ]; then
            if [ ! -f "${NFTBAN_CONFIG_DIR}/whitelist.d/00-system.conf" ]; then
                cat > "${NFTBAN_CONFIG_DIR}/whitelist.d/00-system.conf" << EOF
# Auto-generated system IP whitelist
# Created by: NFTBan package installer
# Purpose: Prevent lockout from this server
$SYSTEM_IP
EOF
                chmod 644 "${NFTBAN_CONFIG_DIR}/whitelist.d/00-system.conf"
                chown root:nftban "${NFTBAN_CONFIG_DIR}/whitelist.d/00-system.conf"
                echo "System IP whitelisted: $SYSTEM_IP"
            fi
        fi

        # ======================================================================
        # STEP 6: Download FREE GeoIP database
        # ======================================================================
        GEOIP_DIR="${NFTBAN_DATA_DIR}/geoip"
        GEOIP_FILE="${GEOIP_DIR}/dbip-country-lite.mmdb"
        GEOIP_URL="https://download.db-ip.com/free/dbip-country-lite-$(date +%Y-%m).mmdb.gz"

        if [ ! -f "$GEOIP_FILE" ]; then
            echo "Downloading FREE GeoIP database..."
            if curl -fsSL "$GEOIP_URL" -o "${GEOIP_FILE}.gz" 2>/dev/null; then
                gunzip -f "${GEOIP_FILE}.gz" 2>/dev/null || true
                chown nftban:nftban "$GEOIP_FILE" 2>/dev/null || true
                chmod 644 "$GEOIP_FILE"
                echo "GeoIP database downloaded"
            else
                echo "GeoIP download failed (will retry on first use)"
            fi
        fi

        # ======================================================================
        # STEP 7: Create login_alert.conf if not exists
        # ======================================================================
        if [ ! -f "${NFTBAN_CONFIG_DIR}/conf.d/login_alert.conf" ]; then
            cat > "${NFTBAN_CONFIG_DIR}/conf.d/login_alert.conf" << 'LOGINEOF'
# NFTBan Login Alert Configuration (auto-generated by installer)
NFTBAN_LOGIN_ALERT_ENABLED="true"
NFTBAN_LOGIN_ALERT_SSH="true"
NFTBAN_LOGIN_ALERT_SU="true"
NFTBAN_LOGIN_ALERT_SUDO="true"
NFTBAN_LOGIN_ALERT_GEOIP="true"
NFTBAN_LOGIN_ALERT_MODE="realtime"
NFTBAN_LOGIN_ALERT_FORMAT="html"
LOGINEOF
            chmod 644 "${NFTBAN_CONFIG_DIR}/conf.d/login_alert.conf"
            chown root:nftban "${NFTBAN_CONFIG_DIR}/conf.d/login_alert.conf"
        fi

        # Enable login monitoring in main config
        if [ -f "${NFTBAN_CONFIG_DIR}/nftban.conf" ]; then
            sed -i 's/^NFTBAN_LOGIN_ALERT_ENABLED=.*/NFTBAN_LOGIN_ALERT_ENABLED="true"/' "${NFTBAN_CONFIG_DIR}/nftban.conf" 2>/dev/null || true
            sed -i 's/^NFTBAN_LOGIN_ALERT_SSH=.*/NFTBAN_LOGIN_ALERT_SSH="true"/' "${NFTBAN_CONFIG_DIR}/nftban.conf" 2>/dev/null || true
            sed -i 's/^NFTBAN_GEOIP_ENABLED=.*/NFTBAN_GEOIP_ENABLED="true"/' "${NFTBAN_CONFIG_DIR}/nftban.conf" 2>/dev/null || true
        fi

        # ======================================================================
        # STEP 8: Create Suricata EVE log directory and file
        # ======================================================================
        # Bug fix v1.12.8: Suricata 7.x with threaded:yes only creates EVE file on first event
        # nftban-suricata daemon requires file to exist on startup
        # Bug fix v1.12.9: Handle Debian/Ubuntu where Suricata runs as root (no suricata user)
        SURICATA_LOG_DIR="/var/log/nftban/suricata"
        SURICATA_EVE_FILE="${SURICATA_LOG_DIR}/eve-alerts.json"

        # Detect Suricata user: suricata (RHEL/AlmaLinux) or root (Debian/Ubuntu)
        if id suricata >/dev/null 2>&1; then
            SURI_USER="suricata"
        else
            # Debian/Ubuntu: Suricata runs as root
            SURI_USER="root"
        fi

        # Create log directory if needed
        if [ ! -d "$SURICATA_LOG_DIR" ]; then
            mkdir -p "$SURICATA_LOG_DIR"
            chown "${SURI_USER}:nftban" "$SURICATA_LOG_DIR"
            chmod 770 "$SURICATA_LOG_DIR"
            echo "Created Suricata log directory: $SURICATA_LOG_DIR (owner: $SURI_USER)"
        fi

        # Create EVE file if needed
        if [ ! -f "$SURICATA_EVE_FILE" ]; then
            touch "$SURICATA_EVE_FILE"
            chown "${SURI_USER}:nftban" "$SURICATA_EVE_FILE"
            chmod 640 "$SURICATA_EVE_FILE"
            echo "Created Suricata EVE log file: $SURICATA_EVE_FILE"
        fi

        # Add suricata user to nftban group (only if suricata user exists)
        if [ "$SURI_USER" = "suricata" ]; then
            if ! id -nG suricata 2>/dev/null | grep -qw nftban; then
                usermod -aG nftban suricata 2>/dev/null && \
                    echo "Added suricata user to nftban group"
            fi
        fi

        # ======================================================================
        # STEP 9: Enable default services and timers
        # ======================================================================
        systemctl enable nftban-login-monitor.service >/dev/null 2>&1 || true
        systemctl start nftban-login-monitor.service >/dev/null 2>&1 || true

        for timer in nftban-health.timer nftban-maintenance.timer; do
            systemctl enable "$timer" >/dev/null 2>&1 || true
            systemctl start "$timer" >/dev/null 2>&1 || true
        done

        # ======================================================================
        # STEP 10: Security - Protect nft_schema.sh from modification
        # ======================================================================
        if [ -f /usr/lib/nftban/lib/nft_schema.sh ]; then
            chmod 444 /usr/lib/nftban/lib/nft_schema.sh
            chattr +i /usr/lib/nftban/lib/nft_schema.sh 2>/dev/null || true
            echo "Security: nft_schema.sh protected (immutable)"
        fi

        # ======================================================================
        # COMPLETE
        # ======================================================================
        echo ""
        echo "NFTBan installed successfully!"
        echo ""
        echo "Auto-enabled:"
        echo "  - Login monitoring (SSH alerts)"
        echo "  - GeoIP blocking"
        echo "  - Core timers (health, maintenance)"
        echo ""
        echo "Enable optional features:"
        echo "  nftban feeds enable      # Threat intel feeds"
        echo "  nftban portscan enable   # Port scan detection"
        echo "  nftban ddos enable       # DDoS protection"
        echo "  nftban gui enable        # Web GUI"
        echo "  nftban metrics enable    # Metrics collection"
        echo "  nftban pro enroll        # NFTBan Pro subscription"
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

exit 0

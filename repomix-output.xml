107: # Load state from disk
108: nftban_portscan_classic_load_state() {
109:     local state_file="${PORTSCAN_CLASSIC_STATE_FILE}"
110: 
111:     [[ -f "$state_file" ]] || return 0
112: 
113:     while IFS='|' read -r type ip data; do
114:         [[ "$type" =~ ^# ]] && continue
115:         [[ -z "$type" ]] && continue
116: 
117:         case "$type" in
118:             BLOCKED)
119:                 _PORTSCAN_CLASSIC_IP_BLOCKED["$ip"]="$data"
120:                 ;;
121:             BAN_COUNT)
122:                 _PORTSCAN_CLASSIC_IP_BAN_COUNT["$ip"]="$data"
123:                 ;;
124:         esac
125:     done < "$state_file"
126: 
127:     return 0
128: }

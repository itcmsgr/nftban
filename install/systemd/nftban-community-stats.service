# =============================================================================

[Unit]
Description=NFTBan Anonymous Community Stats Submission
Documentation=man:nftban(8)
After=network-online.target nftband.service
Wants=network-online.target

[Service]
Type=oneshot

# Submit anonymous stats (NO PII — OS, version, bucketed CPU/RAM, panel, modules, health)
ExecStart=/usr/sbin/nftban pro community submit

# Exit codes: 0=OK, 1=error (non-fatal)
SuccessExitStatus=0 1

# =============================================================================
# SECURITY HARDENING
# =============================================================================

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

# Filesystem access (read-only except stats write)
ReadOnlyPaths=/etc/nftban /var/lib/nftban /proc /sys /etc/os-release
ReadWritePaths=/var/lib/nftban/community

# Network for stats API
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Resource limits
MemoryMax=64M
TasksMax=5
TimeoutStartSec=60

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nftban-community-stats

[Install]
WantedBy=multi-user.target

#!/bin/bash
# SPDX-License-Identifier: MPL-2.0
# SPDX-FileCopyrightText: Copyright (c) 2024-2025 NFTBan Development Team
#
# postrm script for nftban (main package)
# Cleanup after removal

set -e

case "$1" in
    purge)
        echo "Purging NFTBan data..."

        # Remove config files
        rm -rf /etc/nftban 2>/dev/null || true

        # Remove data files
        rm -rf /var/lib/nftban 2>/dev/null || true

        # Remove logs
        rm -rf /var/log/nftban 2>/dev/null || true

        # Remove cache
        rm -rf /var/cache/nftban 2>/dev/null || true

        # Remove runtime
        rm -rf /run/nftban 2>/dev/null || true

        # Remove nftables table (optional - may want to keep firewall rules)
        if command -v nft &>/dev/null; then
            nft delete table inet nftban 2>/dev/null || true
        fi

        # Remove user and group (optional)
        if getent passwd nftban &>/dev/null; then
            userdel nftban 2>/dev/null || true
        fi
        if getent group nftban &>/dev/null; then
            groupdel nftban 2>/dev/null || true
        fi
        if getent group nftban-auditor &>/dev/null; then
            groupdel nftban-auditor 2>/dev/null || true
        fi

        echo "NFTBan data purged."
    ;;

    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        # Reload systemd daemon
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload >/dev/null 2>&1 || true
        fi
    ;;

    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

exit 0

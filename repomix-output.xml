<file path="pkg/safety/mem.go">
  1: package safety
  2: 
  3: import (
  4: 	"os"
  5: 	"strconv"
  6: 	"strings"
  7: )
  8: 
  9: // MemAvail holds available memory info (cgroup-aware)
 10: // This matches the pattern from go-feeds/internal/safety/mem.go
 11: type MemAvail struct {
 12: 	Total         int64
 13: 	Avail         int64
 14: 	CgroupLimit   int64
 15: 	CgroupCurrent int64
 16: }
 17: 
 18: func readFirstInt64(path string) (int64, error) {
 19: 	b, err := os.ReadFile(path)
 20: 	if err != nil {
 21: 		return 0, err
 22: 	}
 23: 	s := strings.TrimSpace(string(b))
 24: 	if s == "max" {
 25: 		return 1 << 62, nil // cgroup v2 "no limit"
 26: 	}
 27: 	return strconv.ParseInt(s, 10, 64)
 28: }
 29: 
 30: // AvailableMem returns available memory (cgroup-aware for containers)
 31: // This is critical for running in Docker/Kubernetes where cgroup limits apply
 32: func AvailableMem() MemAvail {
 33: 	// cgroup v2 paths
 34: 	mlim, _ := readFirstInt64("/sys/fs/cgroup/memory.max")
 35: 	mcur, _ := readFirstInt64("/sys/fs/cgroup/memory.current")
 36: 
 37: 	// cgroup v1 paths (fallback)
 38: 	if mlim == 0 {
 39: 		mlim, _ = readFirstInt64("/sys/fs/cgroup/memory/memory.limit_in_bytes")
 40: 		mcur, _ = readFirstInt64("/sys/fs/cgroup/memory/memory.usage_in_bytes")
 41: 	}
 42: 
 43: 	// /proc/meminfo fallback (host system)
 44: 	var memTotal, memAvail int64
 45: 	if b, err := os.ReadFile("/proc/meminfo"); err == nil {
 46: 		lines := strings.Split(string(b), "\n")
 47: 		for _, ln := range lines {
 48: 			if strings.HasPrefix(ln, "MemTotal:") {
 49: 				fields := strings.Fields(ln)
 50: 				// kB → bytes
 51: 				if len(fields) >= 2 {
 52: 					if v, err := strconv.ParseInt(fields[1], 10, 64); err == nil {
 53: 						memTotal = v * 1024
 54: 					}
 55: 				}
 56: 			}
 57: 			if strings.HasPrefix(ln, "MemAvailable:") {
 58: 				fields := strings.Fields(ln)
 59: 				if len(fields) >= 2 {
 60: 					if v, err := strconv.ParseInt(fields[1], 10, 64); err == nil {
 61: 						memAvail = v * 1024
 62: 					}
 63: 				}
 64: 			}
 65: 		}
 66: 	}
 67: 
 68: 	// if running under cgroup with a smaller limit than host RAM, use that window
 69: 	if mlim > 0 && mlim < (1<<61) {
 70: 		// avail within cgroup = limit - current (bounded by MemAvailable)
 71: 		cgAvail := mlim - mcur
 72: 		if cgAvail < 0 {
 73: 			cgAvail = 0
 74: 		}
 75: 		if memAvail == 0 || cgAvail < memAvail {
 76: 			memAvail = cgAvail
 77: 		}
 78: 		memTotal = mlim
 79: 	}
 80: 
 81: 	return MemAvail{
 82: 		Total:         memTotal,
 83: 		Avail:         memAvail,
 84: 		CgroupLimit:   mlim,
 85: 		CgroupCurrent: mcur,
 86: 	}
 87: }
 88: 
 89: // FormatBytes converts bytes to human-readable format
 90: func FormatBytes(bytes int64) string {
 91: 	const (
 92: 		KB = 1024
 93: 		MB = KB * 1024
 94: 		GB = MB * 1024
 95: 	)
 96: 
 97: 	switch {
 98: 	case bytes >= GB:
 99: 		return strconv.FormatInt(bytes/GB, 10) + " GB"
100: 	case bytes >= MB:
101: 		return strconv.FormatInt(bytes/MB, 10) + " MB"
102: 	case bytes >= KB:
103: 		return strconv.FormatInt(bytes/KB, 10) + " KB"
104: 	default:
105: 		return strconv.FormatInt(bytes, 10) + " B"
106: 	}
107: }
</file>

<file path="pkg/suricata/config.go">
  1: package suricata
  2: 
  3: import (
  4: 	"fmt"
  5: 	"os"
  6: 	"strconv"
  7: 	"strings"
  8: 	"time"
  9: )
 10: 
 11: // FilterConfig represents a single Suricata filter configuration
 12: type FilterConfig struct {
 13: 	Name        string
 14: 	Enabled     bool
 15: 	Keywords    []string
 16: 	Threshold   int
 17: 	BanTime     time.Duration
 18: 	Action      string // "log", "observe", "ban"
 19: 	BanType     string // "temporary", "permanent", "escalate"
 20: 	MaxBans     int    // For escalate: after X temp bans, go permanent
 21: 	Period      time.Duration // For escalate: count bans in this period
 22: 	Description string
 23: }
 24: 
 25: // Config holds the complete Suricata filter configuration
 26: type Config struct {
 27: 	GlobalEnabled      bool
 28: 	DefaultThreshold   int
 29: 	DefaultBanTime     time.Duration
 30: 	DefaultAction      string
 31: 	ScoreDecay         time.Duration
 32: 	Filters            map[string]*FilterConfig
 33: }
 34: 
 35: // LoadConfig loads Suricata filter configuration from files
 36: // Loads filters.conf first, then filters.conf.local overrides
 37: func LoadConfig(configDir string) (*Config, error) {
 38: 	cfg := &Config{
 39: 		GlobalEnabled:    true,
 40: 		DefaultThreshold: 100,
 41: 		DefaultBanTime:   30 * time.Minute,
 42: 		DefaultAction:    "ban",
 43: 		ScoreDecay:       1 * time.Hour,
 44: 		Filters:          make(map[string]*FilterConfig),
 45: 	}
 46: 
 47: 	// Load default config
 48: 	defaultPath := configDir + "/filters.conf"
 49: 	if err := cfg.parseConfigFile(defaultPath); err != nil {
 50: 		// If default doesn't exist, that's OK (use built-in defaults)
 51: 		if !os.IsNotExist(err) {
 52: 			return nil, fmt.Errorf("failed to parse %s: %w", defaultPath, err)
 53: 		}
 54: 	}
 55: 
 56: 	// Load local overrides
 57: 	localPath := configDir + "/filters.conf.local"
 58: 	if err := cfg.parseConfigFile(localPath); err != nil {
 59: 		// Local file is optional
 60: 		if !os.IsNotExist(err) {
 61: 			return nil, fmt.Errorf("failed to parse %s: %w", localPath, err)
 62: 		}
 63: 	}
 64: 
 65: 	return cfg, nil
 66: }
 67: 
 68: // parseConfigFile parses a single config file
 69: func (c *Config) parseConfigFile(path string) error {
 70: 	data, err := os.ReadFile(path)
 71: 	if err != nil {
 72: 		return err
 73: 	}
 74: 
 75: 	lines := strings.Split(string(data), "\n")
 76: 	var currentSection string
 77: 
 78: 	for lineNum, line := range lines {
 79: 		line = strings.TrimSpace(line)
 80: 
 81: 		// Skip comments and empty lines
 82: 		if line == "" || strings.HasPrefix(line, "#") {
 83: 			continue
 84: 		}
 85: 
 86: 		// Section headers
 87: 		if strings.HasPrefix(line, "[") && strings.HasSuffix(line, "]") {
 88: 			currentSection = strings.Trim(line, "[]")
 89: 			continue
 90: 		}
 91: 
 92: 		// Key-value pairs
 93: 		parts := strings.SplitN(line, "=", 2)
 94: 		if len(parts) != 2 {
 95: 			continue
 96: 		}
 97: 
 98: 		key := strings.TrimSpace(parts[0])
 99: 		value := strings.TrimSpace(parts[1])
100: 
101: 		if currentSection == "global" {
102: 			c.parseGlobalSetting(key, value)
103: 		} else if currentSection == "filters" {
104: 			if err := c.parseFilterLine(key, value, lineNum+1); err != nil {
105: 				// Log warning but continue parsing
106: 				fmt.Fprintf(os.Stderr, "Warning: %s:%d: %v\n", path, lineNum+1, err)
107: 			}
108: 		}
109: 	}
110: 
111: 	return nil
112: }
113: 
114: // parseGlobalSetting parses a global configuration setting
115: func (c *Config) parseGlobalSetting(key, value string) {
116: 	switch key {
117: 	case "enabled":
118: 		c.GlobalEnabled = (value == "true" || value == "yes" || value == "1")
119: 	case "default_threshold":
120: 		if val, err := strconv.Atoi(value); err == nil {
121: 			c.DefaultThreshold = val
122: 		}
123: 	case "default_ban_time":
124: 		if dur, err := parseDuration(value); err == nil {
125: 			c.DefaultBanTime = dur
126: 		}
127: 	case "default_action":
128: 		c.DefaultAction = value
129: 	case "score_decay":
130: 		if dur, err := parseDuration(value); err == nil {
131: 			c.ScoreDecay = dur
132: 		}
133: 	}
134: }
135: 
136: // parseFilterLine parses a single filter line
137: // Format: filter_name = enabled | keywords | threshold | ban_time | action | ban_type | description
138: // ban_type can be: temporary, permanent, or escalate:3:24h (escalate after 3 bans in 24h)
139: func (c *Config) parseFilterLine(name, value string, lineNum int) error {
140: 	// Split by pipe separator
141: 	parts := strings.Split(value, "|")
142: 	if len(parts) != 7 {
143: 		return fmt.Errorf("filter '%s' invalid format (expected 7 fields, got %d)", name, len(parts))
144: 	}
145: 
146: 	// Trim all parts
147: 	for i := range parts {
148: 		parts[i] = strings.TrimSpace(parts[i])
149: 	}
150: 
151: 	// Parse enabled
152: 	enabled := (parts[0] == "true" || parts[0] == "yes" || parts[0] == "1")
153: 
154: 	// Parse keywords
155: 	keywordsStr := strings.TrimSpace(parts[1])
156: 	keywords := []string{}
157: 	if keywordsStr != "" {
158: 		for _, kw := range strings.Split(keywordsStr, ",") {
159: 			kw = strings.TrimSpace(kw)
160: 			if kw != "" {
161: 				keywords = append(keywords, strings.ToLower(kw))
162: 			}
163: 		}
164: 	}
165: 
166: 	// Parse threshold
167: 	threshold, err := strconv.Atoi(parts[2])
168: 	if err != nil {
169: 		return fmt.Errorf("filter '%s' invalid threshold: %v", name, err)
170: 	}
171: 
172: 	// Parse ban_time
173: 	banTime, err := parseDuration(parts[3])
174: 	if err != nil {
175: 		return fmt.Errorf("filter '%s' invalid ban_time: %v", name, err)
176: 	}
177: 
178: 	// Parse action
179: 	action := strings.ToLower(parts[4])
180: 	if action != "log" && action != "observe" && action != "ban" {
181: 		return fmt.Errorf("filter '%s' invalid action '%s' (must be log/observe/ban)", name, action)
182: 	}
183: 
184: 	// Parse ban_type (temporary, permanent, or escalate:3:24h)
185: 	banTypeStr := strings.TrimSpace(parts[5])
186: 	banType := "temporary"
187: 	maxBans := 0
188: 	period := time.Duration(0)
189: 
190: 	if strings.HasPrefix(banTypeStr, "escalate:") {
191: 		// Format: escalate:3:24h (escalate after 3 bans in 24h)
192: 		escalateParts := strings.Split(banTypeStr, ":")
193: 		if len(escalateParts) != 3 {
194: 			return fmt.Errorf("filter '%s' invalid escalate format (expected escalate:COUNT:PERIOD)", name)
195: 		}
196: 		banType = "escalate"
197: 		if val, err := strconv.Atoi(escalateParts[1]); err == nil {
198: 			maxBans = val
199: 		} else {
200: 			return fmt.Errorf("filter '%s' invalid escalate count: %v", name, err)
201: 		}
202: 		if dur, err := parseDuration(escalateParts[2]); err == nil {
203: 			period = dur
204: 		} else {
205: 			return fmt.Errorf("filter '%s' invalid escalate period: %v", name, err)
206: 		}
207: 	} else {
208: 		// Simple: temporary or permanent
209: 		banType = strings.ToLower(banTypeStr)
210: 		if banType != "temporary" && banType != "permanent" {
211: 			return fmt.Errorf("filter '%s' invalid ban_type '%s' (must be temporary/permanent/escalate:N:PERIOD)", name, banType)
212: 		}
213: 	}
214: 
215: 	// Description
216: 	description := parts[6]
217: 
218: 	// Create or update filter
219: 	filter := &FilterConfig{
220: 		Name:        name,
221: 		Enabled:     enabled,
222: 		Keywords:    keywords,
223: 		Threshold:   threshold,
224: 		BanTime:     banTime,
225: 		Action:      action,
226: 		BanType:     banType,
227: 		MaxBans:     maxBans,
228: 		Period:      period,
229: 		Description: description,
230: 	}
231: 
232: 	c.Filters[name] = filter
233: 	return nil
234: }
235: 
236: // parseDuration parses duration strings like "30s", "5m", "1h", "24h", "7d"
237: func parseDuration(s string) (time.Duration, error) {
238: 	s = strings.ToLower(strings.TrimSpace(s))
239: 
240: 	// Handle days
241: 	if strings.HasSuffix(s, "d") {
242: 		days, err := strconv.Atoi(strings.TrimSuffix(s, "d"))
243: 		if err != nil {
244: 			return 0, err
245: 		}
246: 		return time.Duration(days) * 24 * time.Hour, nil
247: 	}
248: 
249: 	// Use standard time.ParseDuration for h, m, s
250: 	return time.ParseDuration(s)
251: }
252: 
253: // GetEnabledFilters returns only enabled filters
254: func (c *Config) GetEnabledFilters() map[string]*FilterConfig {
255: 	enabled := make(map[string]*FilterConfig)
256: 	for name, filter := range c.Filters {
257: 		if filter.Enabled {
258: 			enabled[name] = filter
259: 		}
260: 	}
261: 	return enabled
262: }
263: 
264: // GetFilter returns a specific filter by name
265: func (c *Config) GetFilter(name string) (*FilterConfig, bool) {
266: 	filter, ok := c.Filters[name]
267: 	return filter, ok
268: }
</file>


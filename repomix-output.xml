 58:     local repo="${NFTBAN_REPO:-itcmsgr/nftban}"
 59:     local current_version
 60:     current_version="${NFTBAN_VERSION:-1.0.0}"
 61:     current_version="${current_version#v}"
 62: 
 63:     echo ""
 64:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
 65:     echo "NFTBan Update Check"
 66:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
 67:     echo ""
 68:     printf "  %-20s %s\n" "Installed version:" "v${current_version}"
 69:     printf "  %-20s %s\n" "Repository:" "github.com/${repo}"
 70:     echo ""
 71: 
 72:     # Check if curl is available
 73:     if ! command -v curl &>/dev/null; then
 74:         echo "  ❌ Error: curl is required for update check"
 75:         return 1
 76:     fi
 77: 
 78:     echo "  Checking for updates..."
 79:     echo ""
 80: 
 81:     # Fetch latest release from GitHub API
 82:     local api_response latest_version latest_date
 83:     api_response=$(curl -sf --max-time 10 "https://api.github.com/repos/${repo}/releases/latest" 2>/dev/null)
 84: 
 85:     if [[ -z "$api_response" ]]; then
 86:         # No releases yet, check tags
 87:         api_response=$(curl -sf --max-time 10 "https://api.github.com/repos/${repo}/tags" 2>/dev/null)
 88:         if [[ -n "$api_response" ]]; then
 89:             latest_version=$(echo "$api_response" | grep -oP '"name":\s*"v?\K[0-9]+\.[0-9]+\.[0-9]+[^"]*' | head -1)
 90:         fi
 91:     else
 92:         latest_version=$(echo "$api_response" | grep -oP '"tag_name":\s*"v?\K[0-9]+\.[0-9]+\.[0-9]+[^"]*' | head -1)
 93:         latest_date=$(echo "$api_response" | grep -oP '"published_at":\s*"\K[^"]+' | head -1)
 94:     fi
 95: 
 96:     if [[ -z "$latest_version" ]]; then
 97:         echo "  ⚠️  Could not fetch latest version from GitHub"
 98:         echo "  Check: https://github.com/${repo}/releases"
 99:         return 1
100:     fi
101: 
102:     latest_version="${latest_version#v}"
103:     printf "  %-20s %s\n" "Latest version:" "v${latest_version}"
104:     [[ -n "$latest_date" ]] && printf "  %-20s %s\n" "Released:" "${latest_date%%T*}"
105:     echo ""
106: 
107:     # Compare versions
108:     local cmp_result=0
109:     if declare -f nftban_version_compare &>/dev/null; then
110:         nftban_version_compare "$current_version" "$latest_version"
111:         cmp_result=$?
112:     else
113:         # Simple comparison fallback
114:         if [[ "$current_version" == "$latest_version" ]]; then
115:             cmp_result=0
116:         elif [[ "$(printf '%s\n' "$current_version" "$latest_version" | sort -V | head -1)" == "$current_version" ]]; then
117:             cmp_result=1
118:         else
119:             cmp_result=2
120:         fi
121:     fi
122: 
123:     # Display result
124:     case $cmp_result in
125:         0)
126:             echo "  ✅ You are running the latest version!"
127:             ;;
128:         1)
129:             echo "  📦 UPDATE AVAILABLE!"
130:             echo ""
131:             echo "  To update, run one of:"
132:             echo "    • curl -fsSL https://get.nftban.com | sudo bash"
133:             echo "    • Visit: https://github.com/${repo}/releases/latest"
134:             return 2
135:             ;;
136:         2)
137:             echo "  🔧 You are running a development version (ahead of release)"
138:             ;;
139:     esac
140: 
141:     echo ""
142:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
143:     return 0
144: }
145: 
146: # =============================================================================
147: # COMMAND HANDLER
148: # =============================================================================
149: 
150: nftban_cmd_version() {
151:     # Display version information
152:     # Usage: nftban version [--short|--numeric|--check|--json]
153: 
154:     local format="full"
155:     local json_output=false
156: 
157:     # Parse arguments
158:     while [[ $# -gt 0 ]]; do
159:         case "$1" in
160:             --short|-s)
161:                 format="short"
162:                 shift
163:                 ;;
164:             --numeric|-n)
165:                 format="numeric"
166:                 shift
167:                 ;;
168:             --check|-c)
169:                 format="check"
170:                 shift
171:                 ;;
172:             --update|-u)
173:                 format="update"
174:                 shift
175:                 ;;
176:             --json|-j)
177:                 json_output=true
178:                 shift
179:                 ;;
180:             --help|-h)
181:                 nftban_cmd_version_usage
182:                 return 0
183:                 ;;
184:             *)
185:                 echo "ERROR: Unknown option: $1" >&2
186:                 nftban_cmd_version_usage
187:                 return 1
188:                 ;;
189:         esac
190:     done
191: 
192:     # Show banner (skip for JSON, short, and numeric output)
193:     if [[ "$json_output" != "true" ]] && [[ "$format" != "short" ]] && [[ "$format" != "numeric" ]]; then
194:         if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_output.sh" ]]; then
195:             # shellcheck source=/dev/null
196:             source "${NFTBAN_LIB_DIR}/core/nftban_output.sh"
197:             if [[ $(type -t nftban_banner) == "function" ]]; then
198:                 nftban_banner
199:             fi
200:         fi
201:         echo ""
202:     fi
203: 
204:     # Output based on format
205:     if [[ "$json_output" == "true" ]]; then
206:         cat <<EOF
207: {
208:   "version": "${NFTBAN_VERSION}",
209:   "version_name": "${NFTBAN_VERSION_NAME}",
210:   "version_date": "${NFTBAN_VERSION_DATE}",
211:   "build_date": "${NFTBAN_BUILD_DATE}",
212:   "components": {
213:     "cli": "${NFTBAN_CLI_VERSION}",
214:     "core": "${NFTBAN_CORE_VERSION}",
215:     "gui": "${NFTBAN_GUI_VERSION}",
216:     "api": "${NFTBAN_API_VERSION}"
217:   },
218:   "requirements": {
219:     "bash_min": "${NFTBAN_MIN_BASH_VERSION}",
220:     "nftables_min": "${NFTBAN_MIN_NFT_VERSION}"
221:   }
222: }
223: EOF
224:     elif [[ "$format" == "short" ]]; then
225:         nftban_version_short
226:     elif [[ "$format" == "numeric" ]]; then
227:         nftban_version_numeric
228:     elif [[ "$format" == "check" ]]; then
229:         nftban_version_check_requirements
230:         if [[ $? -eq 0 ]]; then
231:             echo "✅ All requirements met"
232:             return 0
233:         else
234:             echo "❌ Requirements not met"
235:             return 1
236:         fi
237:     elif [[ "$format" == "update" ]]; then
238:         nftban_check_for_updates
239:         return $?
240:     else
241:         nftban_version_info
242:     fi
243: 
244:     echo "# NFTBAN_CMD_EXIT: version"
245:     return 0
246: }
247: 
248: nftban_cmd_version_usage() {
249:     cat <<EOF
250: Usage: nftban version [OPTIONS]
251: 
252: Display NFTBan version information.
253: 
254: OPTIONS:
255:   --short, -s       Show version number only (e.g., "1.0.0")
256:   --numeric, -n     Show numeric version for comparison (e.g., "100")
257:   --check, -c       Check system requirements
258:   --update, -u      Check GitHub for newer version
259:   --json, -j        Output in JSON format
260:   --help, -h        Show this help message
261: 
262: EXAMPLES:
263:   nftban version                 # Show full version information
264:   nftban version --short         # Show version number only
265:   nftban version --json          # Get version in JSON format
266:   nftban version --check         # Check system requirements
267:   nftban version --update        # Check for updates from GitHub
268: 
269: EOF
270: }
271: 
272: # Export functions
273: export -f nftban_cmd_version
274: export -f nftban_cmd_version_usage
275: export -f nftban_check_for_updates
276: 
277: # =============================================================================
278: # EXECUTE IF RUN DIRECTLY
279: # =============================================================================
280: 
281: if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
282:     nftban_cmd_version "$@"
283: fi
</file>


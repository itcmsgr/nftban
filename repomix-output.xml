111: # ==============================================================================
112: # Shared: Stop Prometheus Stack
113: # ==============================================================================
114: nftban_metrics_stop_stack() {
115:     # Stop Node Exporter, Prometheus, and NFTBan metrics exporter
116:     # Returns: 0 on success
117: 
118:     local verbose="${1:-true}"  # Show output by default
119: 
120:     # Stop NFTBan metrics exporter
121:     local metrics_timer="${NFTBAN_TIMER_METRICS_EXPORTER:-nftban-metrics-exporter.timer}"
122:     local metrics_svc="${NFTBAN_SERVICE_METRICS_EXPORTER:-nftban-metrics-exporter.service}"
123:     if systemctl list-unit-files 2>/dev/null | grep -q "$metrics_timer"; then
124:         systemctl stop "$metrics_timer" &>/dev/null || true
125:         systemctl stop "$metrics_svc" &>/dev/null || true
126:         systemctl disable "$metrics_timer" &>/dev/null || true
127:         [[ "$verbose" == "true" ]] && echo "  ✓ NFTBan metrics exporter stopped"
128:     fi
129: 
130:     # Stop Prometheus
131:     local prometheus_service
132:     prometheus_service=$(nftban_distro_get_service prometheus 2>/dev/null || echo "prometheus")
133:     if systemctl list-unit-files 2>/dev/null | grep -q "${prometheus_service}.service"; then
134:         systemctl stop "$prometheus_service" &>/dev/null || true
135:         systemctl disable "$prometheus_service" &>/dev/null || true
136:         [[ "$verbose" == "true" ]] && echo "  ✓ Prometheus stopped"
137:     fi
138: 
139:     # Stop Node Exporter
140:     local node_exporter_service
141:     node_exporter_service=$(nftban_distro_get_service node_exporter 2>/dev/null || echo "prometheus-node-exporter")
142:     if systemctl list-unit-files 2>/dev/null | grep -q "${node_exporter_service}.service"; then
143:         systemctl stop "$node_exporter_service" &>/dev/null || true
144:         systemctl disable "$node_exporter_service" &>/dev/null || true
145:         [[ "$verbose" == "true" ]] && echo "  ✓ Node Exporter stopped"
146:     fi
147: 
148:     return 0
149: }

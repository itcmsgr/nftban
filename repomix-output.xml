<file path="cli/lib/nftban/lib/strict.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - Strict Mode Library
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Standardizes error handling across all bash modules
  7: #
  8: # meta:name=strict
  9: # meta:type=library
 10: # meta:header=Strict Mode Library
 11: # meta:version=1.0.0
 12: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 13: # meta:homepage=https://nftban.com
 14: #
 15: # **Description & Purpose**
 16: # meta:description=Provides consistent strict mode configuration for all bash scripts
 17: # meta:input=None (sourced by other scripts)
 18: # meta:output=Sets shell options and error handlers
 19: #
 20: # **Inventory & Requirements**
 21: # meta:depends=bash>=4.0
 22: #
 23: # **Usage**
 24: # Source this file at the beginning of every bash script:
 25: #   source "${NFTBAN_LIB_DIR}/lib/strict.sh"
 26: #
 27: # **Error Logging**
 28: # Errors are automatically logged to /var/log/nftban/cli-errors.log
 29: # Configure with:
 30: #   export NFTBAN_CLI_ERROR_LOG="/custom/path/errors.log"  # Custom log path
 31: #   export NFTBAN_ENABLE_ERROR_LOGGING=0                    # Disable logging
 32: #
 33: # meta:created_date=2025-11-24
 34: # =============================================================================
 35: 
 36: # =============================================================================
 37: # GUARD: Prevent double-loading
 38: # =============================================================================
 39: 
 40: # If already loaded, just return
 41: [[ -n "${NFTBAN_STRICT_MODE_LOADED:-}" ]] && return 0
 42: 
 43: # =============================================================================
 44: # STRICT MODE SETTINGS
 45: # =============================================================================
 46: 
 47: # Exit on error
 48: # Any command that returns non-zero will cause script to exit
 49: set -e
 50: 
 51: # Exit on undefined variable
 52: # Referencing undefined variables will cause script to exit
 53: set -u
 54: 
 55: # Exit on pipe failure
 56: # If any command in a pipeline fails, the whole pipeline fails
 57: set -o pipefail
 58: 
 59: # Optional: Enable extended debugging
 60: # Uncomment for development/debugging
 61: # set -x
 62: 
 63: # =============================================================================
 64: # SAFE INTERNAL FIELD SEPARATOR
 65: # =============================================================================
 66: 
 67: # Set IFS to only newline and tab
 68: # This prevents word splitting on spaces, which is often a security issue
 69: # Preserves spaces in filenames and variables
 70: IFS=$'\n\t'
 71: 
 72: # =============================================================================
 73: # SECURE FILE CREATION
 74: # =============================================================================
 75: 
 76: # Set umask for secure file creation
 77: # 027 = owner: rwx (7), group: r-x (5), other: none (0)
 78: # Created files: rw-r----- (640)
 79: # Created directories: rwxr-x--- (750)
 80: umask 027
 81: 
 82: # =============================================================================
 83: # ERROR HANDLING
 84: # =============================================================================
 85: 
 86: # Error handler function
 87: # Called when any command fails (via ERR trap)
 88: nftban_error_handler() {
 89:     local exit_code=$?
 90:     local line_no=$1  # shellcheck disable=SC2034  # Used in ERR trap context
 91:     local bash_lineno=${BASH_LINENO[0]}
 92:     local function_name="${FUNCNAME[1]:-main}"
 93:     local script_name="${BASH_SOURCE[1]:-${0}}"
 94: 
 95:     # Don't print error if we're in an if/while/test context
 96:     # (these are expected to fail sometimes)
 97:     if [[ "${BASH_COMMAND}" =~ ^(test|\[|\[\[) ]]; then
 98:         return 0
 99:     fi
100: 
101:     # Don't print error for ANY return statement
102:     # return 0 = success, return 1 = normal failure/not found, return 2-3 = warnings
103:     # These are all intentional exit codes, not errors worth logging
104:     if [[ "${BASH_COMMAND}" =~ ^return ]]; then
105:         return 0
106:     fi
107: 
108:     # Don't print error for explicit exit statements
109:     # exit 1 after showing usage/help is intentional, not an error
110:     if [[ "${BASH_COMMAND}" =~ ^exit ]]; then
111:         return 0
112:     fi
113: 
114:     # Print error message to stderr
115:     cat >&2 <<EOF
116: 
117: ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
118: ERROR: Script failed
119: ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
120: 
121: Script:   ${script_name}
122: Function: ${function_name}
123: Line:     ${bash_lineno}
124: Command:  ${BASH_COMMAND}
125: Exit:     ${exit_code}
126: 
127: ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
128: 
129: EOF
130: 
131:     # Log error to file (if logging enabled and writable)
132:     local cli_error_log="${NFTBAN_CLI_ERROR_LOG:-${NFTBAN_LOG_DIR}/cli-errors.log}"
133:     if [[ "${NFTBAN_ENABLE_ERROR_LOGGING:-1}" == "1" ]]; then
134:         local log_dir
135:         log_dir=$(dirname "${cli_error_log}")
136:         # Only log if directory exists and is writable
137:         if [[ -d "${log_dir}" && -w "${log_dir}" ]]; then
138:             {
139:                 echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
140:                 echo "ERROR: $(date '+%Y-%m-%d %H:%M:%S')"
141:                 echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
142:                 echo "Script:   ${script_name}"
143:                 echo "Function: ${function_name}"
144:                 echo "Line:     ${bash_lineno}"
145:                 echo "Command:  ${BASH_COMMAND}"
146:                 echo "Exit:     ${exit_code}"
147:                 echo "User:     ${USER:-unknown}"
148:                 echo "PWD:      ${PWD:-unknown}"
149:                 echo ""
150:             } >> "${cli_error_log}" 2>/dev/null || true
151:         fi
152:     fi
153: 
154:     # Exit with the original error code
155:     exit "${exit_code}"
156: }
157: 
158: # Set up error trap
159: # This trap will call nftban_error_handler whenever a command fails
160: trap 'nftban_error_handler ${LINENO}' ERR
161: 
162: # =============================================================================
163: # EXIT HANDLER (CLEANUP)
164: # =============================================================================
165: 
166: # Cleanup handler function
167: # Called when script exits (normally or via error)
168: nftban_exit_handler() {
169:     local exit_code=$?
170: 
171:     # Clean up temp files if they exist
172:     # Scripts can add files to this array for automatic cleanup
173:     if [[ -n "${NFTBAN_TEMP_FILES:-}" ]]; then
174:         for temp_file in "${NFTBAN_TEMP_FILES[@]:-}"; do
175:             [[ -f "${temp_file}" ]] && rm -f "${temp_file}" 2>/dev/null || true
176:         done
177:     fi
178: 
179:     # Clean up temp directories if they exist
180:     if [[ -n "${NFTBAN_TEMP_DIRS:-}" ]]; then
181:         for temp_dir in "${NFTBAN_TEMP_DIRS[@]:-}"; do
182:             [[ -d "${temp_dir}" ]] && rm -rf "${temp_dir}" 2>/dev/null || true
183:         done
184:     fi
185: 
186:     return "${exit_code}"
187: }
188: 
189: # Set up exit trap
190: trap 'nftban_exit_handler' EXIT
191: 
192: # =============================================================================
193: # UTILITY FUNCTIONS
194: # =============================================================================
195: 
196: # Disable strict mode temporarily
197: # Usage: nftban_strict_off
198: nftban_strict_off() {
199:     set +e
200:     set +u
201:     set +o pipefail
202: }
203: 
204: # Re-enable strict mode
205: # Usage: nftban_strict_on
206: nftban_strict_on() {
207:     set -e
208:     set -u
209:     set -o pipefail
210: }
211: 
212: # Run a command without strict mode
213: # Usage: nftban_try <command>
214: # Returns: exit code of command (doesn't exit script on failure)
215: nftban_try() {
216:     set +e
217:     "$@"
218:     local exit_code=$?
219:     set -e
220:     return "${exit_code}"
221: }
222: 
223: # Check if running as root
224: # Usage: nftban_require_root
225: # Exits: 1 if not root
226: nftban_require_root() {
227:     if [[ "${EUID}" -ne 0 ]]; then
228:         echo "ERROR: This script must be run as root" >&2
229:         echo "Try: sudo $0 $*" >&2
230:         exit 1
231:     fi
232: }
233: 
234: # Check if a command exists
235: # Usage: nftban_require_command <command> [package]
236: # Exits: 1 if command not found
237: nftban_require_command() {
238:     local cmd="$1"
239:     local pkg="${2:-$1}"
240: 
241:     if ! command -v "${cmd}" &>/dev/null; then
242:         echo "ERROR: Required command '${cmd}' not found" >&2
243:         echo "Install: dnf install ${pkg}" >&2
244:         exit 1
245:     fi
246: }
247: 
248: # Validate required environment variable
249: # Usage: nftban_require_var <var_name>
250: # Exits: 1 if variable not set or empty
251: nftban_require_var() {
252:     local var_name="$1"
253:     local var_value="${!var_name:-}"
254: 
255:     if [[ -z "${var_value}" ]]; then
256:         echo "ERROR: Required environment variable '${var_name}' is not set" >&2
257:         exit 1
258:     fi
259: }
260: 
261: # =============================================================================
262: # TEMP FILE MANAGEMENT
263: # =============================================================================
264: 
265: # Create a temporary file and register it for cleanup
266: # Usage: temp_file=$(nftban_mktemp)
267: nftban_mktemp() {
268:     local temp_file
269:     temp_file=$(mktemp "${TMPDIR:-/tmp}/nftban.XXXXXXXXXX")
270: 
271:     # Add to cleanup array
272:     NFTBAN_TEMP_FILES+=("${temp_file}")
273: 
274:     echo "${temp_file}"
275: }
276: 
277: # Create a temporary directory and register it for cleanup
278: # Usage: temp_dir=$(nftban_mktemp_dir)
279: nftban_mktemp_dir() {
280:     local temp_dir
281:     temp_dir=$(mktemp -d "${TMPDIR:-/tmp}/nftban.XXXXXXXXXX")
282: 
283:     # Add to cleanup array
284:     NFTBAN_TEMP_DIRS+=("${temp_dir}")
285: 
286:     echo "${temp_dir}"
287: }
288: 
289: # Initialize temp file/dir arrays
290: declare -a NFTBAN_TEMP_FILES=()
291: declare -a NFTBAN_TEMP_DIRS=()
292: 
293: # =============================================================================
294: # EXPORT FUNCTIONS
295: # =============================================================================
296: 
297: export -f nftban_error_handler
298: export -f nftban_exit_handler
299: export -f nftban_strict_off
300: export -f nftban_strict_on
301: export -f nftban_try
302: export -f nftban_require_root
303: export -f nftban_require_command
304: export -f nftban_require_var
305: export -f nftban_mktemp
306: export -f nftban_mktemp_dir
307: 

303: nftban_fhs_generate_html_report() {
304:     # Generate HTML report from FHS data
305:     # Returns: Path to generated HTML file
306: 
307:     local template_path="${NFTBAN_TEMPLATE_DIR:-/usr/share/nftban/templates}/reports/fhs_report.html"
308:     local report_dir="${NFTBAN_REPORT_DIR:-/var/lib/nftban/reports}"
309:     local timestamp
310:     timestamp=$(date +%Y%m%d_%H%M%S)
311:     local report_file="${report_dir}/fhs_report_${timestamp}.html"
312: 
313:     # Ensure report directory exists
314:     mkdir -p "$report_dir" 2>/dev/null || true
315: 
316:     # Check if template exists
317:     if [[ ! -f "$template_path" ]]; then
318:         echo "ERROR: Template not found: $template_path" >&2
319:         return 1
320:     fi
321: 
322:     # Check directories if not already checked
323:     if [[ ${#NFTBAN_FHS_STATUS[@]} -eq 0 ]]; then
324:         nftban_fhs_check_all
325:     fi
326: 
327:     # Calculate statistics
328:     local total_directories=${#NFTBAN_FHS_DIRECTORIES[@]}
329:     local ok_directories=0
330:     local error_directories=0
331:     local missing_directories=0
332: 
333:     for path in "${!NFTBAN_FHS_STATUS[@]}"; do
334:         local status="${NFTBAN_FHS_STATUS[$path]}"
335:         if [[ "$status" == "OK" ]]; then
336:             ok_directories=$((ok_directories + 1))
337:         elif [[ "$status" == "MISSING" ]]; then
338:             missing_directories=$((missing_directories + 1))
339:         else
340:             error_directories=$((error_directories + 1))
341:         fi
342:     done
343: 
344:     # Generate compliance alert
345:     local compliance_alert=""
346:     if (( error_directories > 0 || missing_directories > 0 )); then
347:         compliance_alert='<div class="alert alert-danger">
348:             <strong>⚠ FHS Compliance Issues Detected!</strong><br>
349:             Found '"$error_directories"' permission/ownership errors and '"$missing_directories"' missing directories. Please review and fix the issues below.
350:         </div>'
351:     else
352:         compliance_alert='<div class="alert alert-success">
353:             <strong>✓ FHS Compliance Verified!</strong><br>
354:             All NFTBan directories have correct permissions and ownership.
355:         </div>'
356:     fi
357: 
358:     # Generate HTML table rows
359:     local table_rows=""
360:     for path in $(printf '%s\n' "${!NFTBAN_FHS_DIRECTORIES[@]}" | sort); do
361:         local expected="${NFTBAN_FHS_DIRECTORIES[$path]}"
362:         local actual="${NFTBAN_FHS_ACTUAL[$path]:-N/A}"
363:         local status="${NFTBAN_FHS_STATUS[$path]}"
364: 
365:         # Status badge and row class
366:         local status_badge
367:         local row_class=""
368:         if [[ "$status" == "OK" ]]; then
369:             status_badge="<span class=\"badge badge-ok\">✔ OK</span>"
370:         elif [[ "$status" == "MISSING" ]]; then
371:             status_badge="<span class=\"badge badge-missing\">⚠ MISSING</span>"
372:             row_class=' class="error-row"'
373:         else
374:             status_badge="<span class=\"badge badge-error\">✖ ERROR</span>"
375:             row_class=' class="error-row"'
376:             # Extract issues from status
377:             local issues="${status#ERROR:}"  # shellcheck disable=SC2178,SC2128  # Intentional string from array
378:         fi
379: 
380:         table_rows+="                <tr${row_class}>
381:                     <td class=\"path-text\">${path}</td>
382:                     <td class=\"perm-text\">${expected}</td>
383:                     <td class=\"perm-text\">${actual}</td>
384:                     <td>${status_badge}</td>
385:                     <td>${issues:-—}</td>
386:                 </tr>
387: "
388:     done
389: 
390:     # Generate recommendations section
391:     local recommendations_section=""
392:     if (( error_directories > 0 || missing_directories > 0 )); then
393:         recommendations_section='<h2>🔧 Recommendations</h2>
394:         <div class="alert alert-info">
395:             <strong>To fix permission issues:</strong><br>
396:             <code>nftban fhs fix</code> - Automatically fix all permission issues (coming soon)<br>
397:             <br>
398:             <strong>Manual fix commands:</strong>'
399: 
400:         for path in $(printf '%s\n' "${!NFTBAN_FHS_STATUS[@]}" | sort); do
401:             local status="${NFTBAN_FHS_STATUS[$path]}"
402:             if [[ "$status" != "OK" && "$status" != "MISSING" ]]; then
403:                 local expected="${NFTBAN_FHS_DIRECTORIES[$path]}"
404:                 IFS=' ' read -r perms owner_group <<< "$expected"
405:                 recommendations_section+="<br><code>chmod ${perms} ${path} && chown ${owner_group} ${path}</code>"
406:             fi
407:         done
408: 
409:         recommendations_section+='
410:         </div>'
411:     fi
412: 
413:     # Read template
414:     local html_content
415:     html_content=$(cat "$template_path")
416: 
417:     # Get system info
418:     local hostname
419:     hostname=$(hostname -f 2>/dev/null || hostname)
420:     local server_ip
421:     server_ip=$(hostname -I 2>/dev/null | awk '{print $1}' || echo "N/A")
422:     local current_date
423:     current_date=$(date +%Y-%m-%d)
424:     local current_time
425:     current_time=$(date +%H:%M:%S)
426: 
427:     # Substitute placeholders
428:     html_content="${html_content//\{HOSTNAME\}/$hostname}"
429:     html_content="${html_content//\{SERVER_IP\}/$server_ip}"
430:     html_content="${html_content//\{DATE\}/$current_date}"
431:     html_content="${html_content//\{TIME\}/$current_time}"
432:     html_content="${html_content//\{NFTBAN_VERSION\}/${NFTBAN_VERSION:-1.0.0}}"
433:     html_content="${html_content//\{COMPANY_NAME\}/${NFTBAN_COMPANY_NAME:-}}"
434:     html_content="${html_content//\{LOGO_HTML\}/}"
435:     html_content="${html_content//\{VERSION_HTML\}/<p>Version: <strong>${NFTBAN_VERSION:-1.0.0}</strong></p>}"
436: 
437:     # Statistics
438:     html_content="${html_content//\{TOTAL_DIRECTORIES\}/$total_directories}"
439:     html_content="${html_content//\{OK_DIRECTORIES\}/$ok_directories}"
440:     html_content="${html_content//\{ERROR_DIRECTORIES\}/$error_directories}"
441:     html_content="${html_content//\{MISSING_DIRECTORIES\}/$missing_directories}"
442: 
443:     # Alerts and sections
444:     html_content="${html_content//\{COMPLIANCE_ALERT\}/$compliance_alert}"
445:     html_content="${html_content//\{RECOMMENDATIONS_SECTION\}/$recommendations_section}"
446: 
447:     # Table rows
448:     html_content="${html_content//\{FHS_TABLE_ROWS\}/$table_rows}"
449: 
450:     # Write HTML file
451:     echo "$html_content" > "$report_file"
452: 
453:     # Set permissions
454:     chmod 640 "$report_file" 2>/dev/null || true
455: 
456:     echo "$report_file"
457: }

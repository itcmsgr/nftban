404: nftban_report_render_text() {
405:     # Render report as plain text
406:     # Usage: nftban_report_render_text
407:     # Returns: Text report
408: 
409:     local output=""
410:     local sections="${NFTBAN_REPORT_METADATA[sections]}"
411:     local mode="${NFTBAN_REPORT_METADATA[mode]}"
412: 
413:     # Header
414:     output+="═══════════════════════════════════════════════════════════════\n"
415:     output+="  ${NFTBAN_REPORT_METADATA[title]:-NFTBan Report}\n"
416:     output+="═══════════════════════════════════════════════════════════════\n\n"
417:     output+="Hostname: ${NFTBAN_REPORT_METADATA[hostname]:-$(hostname)}\n"
418:     output+="Generated: ${NFTBAN_REPORT_METADATA[date_display]:-$(date)}\n\n"
419: 
420:     # Sections
421:     IFS=',' read -ra section_array <<< "$sections"
422:     for section in "${section_array[@]}"; do
423:         section=$(echo "$section" | xargs)
424: 
425:         case "$section" in
426:             health)
427:                 output+="[HEALTH]\n"
428:                 if [[ -n "${NFTBAN_REPORT_DATA[health_summary]:-}" ]]; then
429:                     output+="${NFTBAN_REPORT_DATA[health_summary]}\n"
430:                     if [[ "$mode" == "detailed" && -n "${NFTBAN_REPORT_DATA[health_detailed]:-}" ]]; then
431:                         output+="\n${NFTBAN_REPORT_DATA[health_detailed]}\n"
432:                     fi
433:                 fi
434:                 output+="\n"
435:                 ;;
436:             module)
437:                 output+="[MODULES]\n"
438:                 if [[ -n "${NFTBAN_REPORT_DATA[module_summary]:-}" ]]; then
439:                     output+="${NFTBAN_REPORT_DATA[module_summary]}\n"
440:                     if [[ "$mode" == "detailed" && -n "${NFTBAN_REPORT_DATA[module_detailed]:-}" ]]; then
441:                         output+="\n${NFTBAN_REPORT_DATA[module_detailed]}\n"
442:                     fi
443:                 fi
444:                 output+="\n"
445:                 ;;
446:             fhs)
447:                 output+="[FHS]\n"
448:                 if [[ -n "${NFTBAN_REPORT_DATA[fhs_summary]:-}" ]]; then
449:                     output+="${NFTBAN_REPORT_DATA[fhs_summary]}\n"
450:                     if [[ "$mode" == "detailed" && -n "${NFTBAN_REPORT_DATA[fhs_detailed]:-}" ]]; then
451:                         output+="\n${NFTBAN_REPORT_DATA[fhs_detailed]}\n"
452:                     fi
453:                 fi
454:                 output+="\n"
455:                 ;;
456:             services)
457:                 output+="[SERVICES]\n"
458:                 if [[ -n "${NFTBAN_REPORT_DATA[services_summary]:-}" ]]; then
459:                     output+="${NFTBAN_REPORT_DATA[services_summary]}\n"
460:                     if [[ "$mode" == "detailed" && -n "${NFTBAN_REPORT_DATA[services_detailed]:-}" ]]; then
461:                         output+="\n${NFTBAN_REPORT_DATA[services_detailed]}\n"
462:                     fi
463:                 fi
464:                 output+="\n"
465:                 ;;
466:             stats)
467:                 output+="[STATS]\n"
468:                 if [[ -n "${NFTBAN_REPORT_DATA[stats_summary]:-}" ]]; then
469:                     output+="${NFTBAN_REPORT_DATA[stats_summary]}\n"
470:                     if [[ "$mode" == "detailed" && -n "${NFTBAN_REPORT_DATA[stats_detailed]:-}" ]]; then
471:                         output+="\n${NFTBAN_REPORT_DATA[stats_detailed]}\n"
472:                     fi
473:                 fi
474:                 output+="\n"
475:                 ;;
476:         esac
477:     done
478: 
479:     # Footer
480:     output+="═══════════════════════════════════════════════════════════════\n"
481:     output+="Generated with NFTBan v${NFTBAN_REPORT_ENGINE_VERSION}\n"
482:     output+="═══════════════════════════════════════════════════════════════\n"
483: 
484:     echo -e "$output"
485: }

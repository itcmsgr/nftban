496: function formatBytes(bytes) {
497:     if (bytes === 0) return '0 B';
498:     const k = 1024;
499:     const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
500:     const i = Math.floor(Math.log(bytes) / Math.log(k));
501:     return Math.round(bytes / Math.pow(k, i) * 100) / 100 + ' ' + sizes[i];
502: }

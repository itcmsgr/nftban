# =============================================================================
# NFTBan - Feed Update Timer
# =============================================================================
# SPDX-License-Identifier: MPL-2.0
# meta:name="nftban-core-feeds.timer"
# meta:type="systemd"
# meta:owner="Antonios Voulvoulis <contact@nftban.com>"
# meta:created_date="2025-10-26"
# meta:description="Timer for daily threat feed updates"
# meta:input="None"
# meta:output="Systemd unit"
# meta:depends=""
# meta:inventory.files=""
# meta:inventory.binaries=""
# meta:inventory.env_vars=""
# meta:inventory.config_files=""
# meta:inventory.systemd_units="nftban-core-feeds.service"
# meta:inventory.network=""
# meta:inventory.privileges="root"
# =============================================================================

[Unit]
# v1.235 R-DEC: kernel parameter nftban=disabled = per-boot emergency bypass of NFTBan.
# systemd enforces this on every start path (socket, Requires=, timer, installer, self-heal).
ConditionKernelCommandLine=!nftban=disabled
# v1.235 D10: while a commit-confirm rollback has FAILED, nothing may apply another state.
ConditionPathExists=!/var/lib/nftban/state/commit-confirm.rollback-failed
Description=NFTBan Core - Daily Feed Update Timer
Documentation=https://github.com/itcmsgr/nftban

[Timer]
# Run daily at 03:20 AM (staggered from health@03:00, suricata@03:40)
# COLLISION FIX: Previously all at 03:00, now spread across 40-minute window
OnCalendar=*-*-* 03:20:00

# Also run 15 minutes after boot (if missed scheduled time)
OnBootSec=15min

# Run if missed (e.g., system was off)
Persistent=true

# JITTER: 15m variance for daily task (was 30m - reduced for tighter window)
RandomizedDelaySec=15m

# DETERMINISTIC: Same offset per host for predictable behavior
FixedRandomDelay=true

[Install]
WantedBy=timers.target

404: // applyRuleset applies the new ruleset
405: func applyRuleset(path string) error {
406: 	cmd := exec.Command("nft", "-f", path)
407: 	output, err := cmd.CombinedOutput()
408: 	if err != nil {
409: 		return fmt.Errorf("%w: %s", err, output)
410: 	}
411: 	return nil
412: }

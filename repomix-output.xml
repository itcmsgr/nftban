741: 
742:     # Enable specific feed
743:     sudo nftban feeds enable SPAMHAUS_DROP
744: 
745:     # Enable all SSH protection feeds
746:     sudo nftban feeds enable-category ssh
747: 
748:     # Update all enabled feeds

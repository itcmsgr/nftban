 242: nftban_login_cmd_install() {
 243:     # Install systemd service
 244: 
 245:     if [[ $EUID -ne 0 ]]; then
 246:         echo "ERROR: Service installation requires root privileges" >&2
 247:         return 1
 248:     fi
 249: 
 250:     echo "Installing NFTBan Login Monitor Service"
 251:     echo "========================================"
 252:     echo ""
 253: 
 254:     # Create service file
 255:     local service_file="/etc/systemd/system/${NFTBAN_SERVICE_LOGIN_MONITOR:-nftban-login-monitor.service}"
 256:     echo "Creating service file: $service_file"
 257: 
 258:     cat > "$service_file" <<'EOF'
 259: [Unit]
 260: Description=NFTBan Login Monitor
 261: Documentation=https://nftban.com
 262: After=network.target sshd.service
 263: 
 264: [Service]
 265: Type=simple
 266: User=root
 267: Group=root
 268: ExecStart=/usr/bin/nftban login run
 269: Restart=on-failure
 270: RestartSec=5s
 271: StandardOutput=journal
 272: StandardError=journal
 273: SyslogIdentifier=nftban-login-monitor
 274: 
 275: # Security hardening
 276: PrivateTmp=yes
 277: NoNewPrivileges=yes
 278: ProtectSystem=strict
 279: ProtectHome=yes
 280: ReadWritePaths=${NFTBAN_LOG_DIR:-/var/log/nftban}
 281: 
 282: [Install]
 283: WantedBy=multi-user.target
 284: EOF
 285: 
 286:     echo "✅ Service file created"

 973: 		linesStr := r.URL.Query().Get("lines")
 974: 		searchFilter := r.URL.Query().Get("search")
 975: 
 976: 		lines := 100
 977: 		if linesStr != "" {
 978: 			if n, err := strconv.Atoi(linesStr); err == nil && n > 0 && n <= 10000 {
 979: 				lines = n
 980: 			}
 981: 		}
 982: 
 983: 		// Map log types to files - use central config
 984: 		logFiles := getLogFiles()

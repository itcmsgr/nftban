1796: // execNFTBanCommandPrivileged executes nftban commands that require root privileges
1797: // The nftban-core binary has CAP_NET_ADMIN capability set, allowing direct nft access
1798: // when run by members of the nftban group (via polkit rules)
1799: func execNFTBanCommandPrivileged(args ...string) (string, error) {
1800: 	// nftban-core has CAP_NET_ADMIN set, so it can manipulate nftables directly
1801: 	// No sudo/pkexec needed - capabilities handle privilege escalation
1802: 	cmd := exec.Command(getCoreBin(), args...)
1803: 	output, err := cmd.CombinedOutput()
1804: 
1805: 	outputStr := string(output)
1806: 	if err != nil {
1807: 		// Check for netlink warnings
1808: 		if strings.Contains(outputStr, "Unable to initialize Netlink socket") {
1809: 			return outputStr, nil
1810: 		}
1811: 		return outputStr, fmt.Errorf("privileged command failed: %v (output: %s)", err, outputStr)
1812: 	}
1813: 	return outputStr, nil
1814: }
1815: 
1816: // execNFTBanCoreCommand executes nftban-core Go binary (preferred for new features)
1817: func execNFTBanCoreCommand(args ...string) (string, error) {
1818: 	// Use central config for core binary path - no hardcoding
1819: 	cmd := exec.Command(getCoreBin(), args...)
1820: 	output, err := cmd.CombinedOutput()
1821: 

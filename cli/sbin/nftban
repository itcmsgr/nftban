#!/usr/bin/env bash
# =============================================================================
# NFTBan - CLI Interface
# =============================================================================
# SPDX-License-Identifier: MPL-2.0
# Purpose: Main CLI entry point for NFTBan
#
# meta:name="nftban_cli"
# meta:type="cli"
# meta:header="NFTBan CLI"
# meta:version="1.0.0"
# meta:owner="Antonios Voulvoulis <contact@nftban.com>"
# meta:homepage="https://nftban.com"
#
# meta:description="Main command-line interface for NFTBan firewall management"
# meta:input="Command line arguments"
# meta:output="Banner and command help"
# meta:depends="bash,nftban_output.sh"
# meta:created_date="2025-10-26"
#
# meta:inventory.files="nftban_output.sh,nftban_help.sh,nftban_config.sh"
# meta:inventory.binaries=""
# meta:inventory.env_vars="NFTBAN_LIB_DIR,NFTBAN_DEBUG"
# meta:inventory.config_files="/etc/nftban/nftban.conf"
# meta:inventory.systemd_units=""
# meta:inventory.network=""
# meta:inventory.privileges="varies by command"

set -Eeuo pipefail

# =============================================================================
# CONFIGURATION
# =============================================================================

# =============================================================================
# LOAD CENTRAL ENVIRONMENT (single source of truth for paths)
# =============================================================================
# Must be loaded BEFORE anything else to ensure vars are set for strict mode
export NFTBAN_LIB_DIR="${NFTBAN_LIB_DIR:-/usr/lib/nftban}"
# shellcheck source=/dev/null
source "${NFTBAN_LIB_DIR}/lib/env.sh"

# =============================================================================
# LOAD VERSION (single source of truth from VERSION file)
# =============================================================================
# shellcheck source=/dev/null
source "${NFTBAN_LIB_DIR}/lib/version.sh"
export NFTBAN_VERSION

# =============================================================================
# PERMISSION CHECK
# =============================================================================

# Check if user has permission to read nftban config
# Regular users must be in nftban group OR run as root
if [[ -f "${NFTBAN_CONFIG_DIR}/nftban.conf" ]] && [[ ! -r "${NFTBAN_CONFIG_DIR}/nftban.conf" ]]; then
    cat >&2 <<EOF

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
ERROR: Permission Denied
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

You do not have permission to run nftban.

Requirements:
  • Be root (uid 0), OR
  • Be a member of the 'nftban' group (operators)

Current user: $(whoami) (uid: $(id -u))
Current groups: $(id -Gn)

To grant operator access, your administrator can run:
  sudo usermod -aG nftban $(whoami)

For read-only auditor access:
  sudo usermod -aG nftban-auditor $(whoami)

Then log out and log back in for the group to take effect.

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
EOF
    exit 1
fi

# =============================================================================
# LOAD CONFIGURATION
# =============================================================================
# NOTE: Safe config parser available but temporarily using legacy mode
# TODO: Convert config files to pure KEY=VALUE format and enable safe parser

# Load main config if exists
if [[ -f "${NFTBAN_CONFIG_DIR}/nftban.conf" ]]; then
    # shellcheck source=/dev/null
    source "${NFTBAN_CONFIG_DIR}/nftban.conf"
    export NFTBAN_CONFIG_LOADED="true"
fi

# Load module configs (conf.d/*.conf) in alphabetical order
# After each .conf file, load corresponding .local override if exists
# NOTE: Skip INI-style configs (contain [section] headers) - these are for Go components
if [[ -d "${NFTBAN_CONFIG_DIR}/conf.d" ]]; then
    for conf_file in "${NFTBAN_CONFIG_DIR}"/conf.d/*.conf; do
        if [[ -f "$conf_file" ]]; then
            # Skip INI-style configs (for Go daemon, not bash)
            if grep -q '^\[' "$conf_file" 2>/dev/null; then
                continue
            fi

            # Load main config file
            # shellcheck source=/dev/null
            source "$conf_file"

            # Load .local override for this specific config (if exists)
            local_override="${conf_file}.local"
            if [[ -f "$local_override" ]]; then
                # Skip if INI-style
                if ! grep -q '^\[' "$local_override" 2>/dev/null; then
                    # shellcheck source=/dev/null
                    source "$local_override"
                fi
            fi
        fi
    done
fi

# Load user overrides (highest priority) if exists
if [[ -f "${NFTBAN_CONFIG_DIR}/nftban.conf.local" ]]; then
    # shellcheck source=/dev/null
    source "${NFTBAN_CONFIG_DIR}/nftban.conf.local"
fi

# =============================================================================
# LOAD DISTRO CONFIG
# =============================================================================
# Load distribution-specific paths and settings (no hardcoded paths)

if [[ -f "${NFTBAN_LIB_DIR}/lib/nftban_distro_config.sh" ]]; then
    # shellcheck source=/dev/null
    source "${NFTBAN_LIB_DIR}/lib/nftban_distro_config.sh"
    # Initialize distro config (detects OS and loads appropriate config)
    nftban_distro_init 2>/dev/null || true
fi

# =============================================================================
# BASH COMPLETION ENDPOINT
# =============================================================================

nftban_complete() {
    # Provides completion suggestions for bash
    # Args: current words being completed

    local words=("$@")
    local cword="${#words[@]}"
    local cur=""

    # Safely get last element if array is not empty
    if (( cword > 0 )); then
# shellcheck disable=SC2034  # cur reserved for bash completion
        cur="${words[$((cword - 1))]}"
    fi

    # Level 0: Main commands
    if (( cword == 0 )) || [[ -z "${words[0]:-}" ]]; then
        # CORE
        echo "status"
        echo "check"
        echo "validate"
        echo "health"
        echo "version"
        echo "help"
        echo "hello"
        # SERVICE CONTROL
        echo "enable"
        echo "disable"
        echo "restart"
        echo "services"
        # CONFIGURATION & SETUP
        echo "config"
        echo "setup"
        echo "wizard"
        echo "system"
        # FIREWALL & SECURITY
        echo "firewall"
        echo "firewall-logs"
        echo "ban"
        echo "unban"
        echo "search"
        echo "whitelist"
        echo "whitelist-system"
        echo "profile"
        echo "permissions"
        echo "polkit"
        echo "sync"
        # PROTECTION MODULES
        echo "ddos"
        echo "portscan"
        echo "login"
        echo "botscan"
        echo "modes"
        echo "feeds"
        echo "rbl"
        echo "suricata"
        echo "trust"
        echo "country"
        echo "cloudflare"
        # MONITORING & REPORTING
        echo "stats"
        echo "report"
        echo "metrics"
        echo "timers"
        echo "watchdog"
        echo "queue"
        echo "port"
        echo "panel"
        echo "module"
        echo "services"
        echo "fhs"
        echo "nftables"
        echo "geoip"
        echo "geoban"
        echo "mail"
        echo "connector"
        echo "zabbix"
        # UI
        echo "menu"
        echo "gui"
        # DEBUG & TESTING
        echo "debug"
        echo "smoke"
        # ADDITIONAL
        echo "list"
        echo "test"
        echo "emulate"
        echo "explain"
        # CONFIG VALIDATION
        echo "configtest"
        echo "configaudit"
        # MEMORY & BAN MANAGEMENT
        echo "protect"
        echo "unprotect"
        echo "cleanup"
        echo "snapshot"
        # EMERGENCY/RECOVERY
        echo "flush"
        # SYSTEM ADMINISTRATION
        echo "update"
        echo "support"
        echo "support-bundle"
        echo "pro"
        # PREFLIGHT
        echo "preflight"
        return 0
    fi

    # Level 1: Subcommands for each main command
    local cmd="${words[0]}"
    if (( cword == 1 )); then
        case "$cmd" in
            port)
                echo "scan"
                echo "list"
                echo "summary"
                echo "html-report"
                echo "mail-report"
                echo "help"
                ;;
            panel)
                echo "directadmin"
                echo "da"
                echo "help"
                ;;
            module)
                echo "list"
                echo "summary"
                echo "html-report"
                echo "mail-report"
                echo "help"
                ;;
            fhs)
                echo "check"
                echo "summary"
                echo "json"
                echo "html-report"
                echo "mail-report"
                echo "help"
                ;;
            nftables)
                echo "start"
                echo "stop"
                echo "restart"
                echo "reload"
                echo "enable"
                echo "disable"
                echo "status"
                echo "check"
                echo "list"
                echo "help"
                ;;
            geoip)
                echo "lookup"
                echo "bulk"
                echo "status"
                echo "test"
                echo "update"
                echo "config"
                echo "help"
                ;;
            geoban)
                echo "ban"
                echo "unban"
                echo "whitelist"
                echo "unwhitelist"
                echo "list"
                echo "status"
                echo "update"
                echo "config"
                echo "refresh"
                echo "help"
                ;;
            gui)
                echo "enable"
                echo "disable"
                echo "status"
                ;;
            emulate|explain)
                echo "--proto"
                echo "--port"
                echo "--direction"
                echo "--json"
                echo "--help"
                ;;
            metrics)
                echo "enable"
                echo "disable"
                echo "status"
                echo "help"
                ;;
            timers)
                echo "status"
                echo "enable"
                echo "disable"
                echo "help"
                ;;
            stats)
                echo "dashboard"
                echo "top"
                echo "ip"
                echo "recent"
                echo "monitor"
                echo "export"
                echo "snapshot"
                echo "cleanup"
                echo "clear-cache"
                echo "check-alerts"
                echo "help"
                ;;
            report)
                echo "generate"
                echo "email"
                echo "schedule"
                echo "run"
                echo "list"
                echo "help"
                ;;
            health)
                echo "check"
                echo "report"
                echo "fix"
                echo "services"
                echo "modules"
                echo "conflicts"
                ;;
            whitelist)
                echo "sync"
                echo "show"
                echo "whitelistme"
                echo "help"
                ;;
            status)
                echo "--json"
                echo "--quiet"
                echo "help"
                ;;
            menu)
                echo "help"
                ;;
            permissions)
                echo "check"
                echo "enforce"
                echo "fix"
                echo "help"
                echo "binaries"
                echo "permissions"
                echo "geoip"
                ;;
            polkit)
                echo "validate"
                echo "static"
                echo "runtime"
                echo "status"
                echo "groups"
                echo "rules"
                echo "test"
                echo "help"
                ;;
            login)
                echo "status"
                echo "install"
                echo "enable"
                echo "disable"
                echo "logs"
                echo "test"
                echo "run"
                echo "help"
                ;;
            enable|disable|restart)
                echo "all"
                echo "nftables"
                echo "suricata"
                echo "login"
                echo "timers"
                ;;
            services)
                echo "status"
                echo "--json"
                ;;
            mail)
                echo "test"
                echo "send"
                echo "spool"
                echo "status"
                echo "configure"
                echo "help"
                ;;
            queue)
                echo "status"
                echo "list"
                echo "process"
                echo "dlq"
                echo "metrics"
                echo "help"
                ;;
            cloudflare)
                echo "enable"
                echo "disable"
                echo "update"
                echo "status"
                echo "download"
                echo "help"
                ;;
            ddos)
                echo "enable"
                echo "disable"
                echo "status"
                echo "test"
                echo "help"
                ;;
            portscan)
                echo "enable"
                echo "disable"
                echo "status"
                echo "check"
                echo "history"
                echo "test"
                echo "help"
                ;;
            botscan)
                echo "enable"
                echo "disable"
                echo "status"
                echo "stats"
                echo "check"
                echo "patterns"
                echo "history"
                echo "test"
                echo "help"
                ;;
            modes)
                echo "help"
                echo "--json"
                ;;
            watchdog)
                echo "status"
                echo "check"
                echo "report"
                echo "history"
                echo "enable"
                echo "disable"
                echo "help"
                ;;
            profile)
                echo "select"
                echo "apply"
                echo "show"
                echo "list"
                echo "help"
                ;;
            feeds)
                echo "select"
                echo "list"
                echo "enable"
                echo "disable"
                echo "enable-cat"
                echo "enable-category"
                echo "update"
                echo "status"
                echo "help"
                ;;
            flush)
                echo "blacklist"
                echo "whitelist"
                echo "feeds"
                echo "geoban"
                echo "ddos"

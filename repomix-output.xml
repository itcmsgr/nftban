  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - System Watchdog CLI Handler
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: CLI interface for system watchdog monitoring
  7: #
  8: # meta:name=cmd_watchdog
  9: # meta:type=cli
 10: # meta:header=System Watchdog CLI Handler
 11: # meta:version=1.0.0
 12: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 13: # meta:homepage=https://nftban.com
 14: #
 15: # meta:created_date=2025-12-17
 16: # meta:updated_date=2025-12-17
 17: # =============================================================================
 18: 
 19: # Source central config for canonical paths (NO HARDCODED FALLBACKS)
 20: # shellcheck source=/etc/nftban/nftban.conf
 21: [[ -f "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf" ]] && source "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf"
 22: 
 23: # Load JSON helper for --json support
 24: [[ -z "${NFTBAN_LIB_DIR:-}" ]] && readonly NFTBAN_LIB_DIR="/usr/lib/nftban"
 25: 
 26: # Load strict mode library
 27: # shellcheck source=/usr/lib/nftban/lib/strict.sh
 28: if [[ -f "${NFTBAN_LIB_DIR}/lib/strict.sh" ]]; then
 29:     source "${NFTBAN_LIB_DIR}/lib/strict.sh"
 30: else
 31:     # Fallback to manual strict mode
 32:     set -Eeuo pipefail
 33: fi
 34: 
 35: # Enhanced strict mode
 36: IFS=$'\n\t'
 37: umask 027
 38: 
 39: # Prevent double-loading
 40: [[ -n "${NFTBAN_CLI_WATCHDOG_LOADED:-}" ]] && return 0
 41: readonly NFTBAN_CLI_WATCHDOG_LOADED=1
 42: 
 43: # Load the core watchdog module
 44: # shellcheck source=/dev/null
 45: if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_watchdog.sh" ]]; then
 46:     source "${NFTBAN_LIB_DIR}/core/nftban_watchdog.sh"
 47: fi
 48: 
 49: # =============================================================================
 50: # HELP TEXT
 51: # =============================================================================
 52: 
 53: nftban_watchdog_help() {
 54:     # Show watchdog help
 55:     cat << 'EOF'
 56: USAGE: nftban watchdog <command> [options]
 57: 
 58: COMMANDS:
 59:   status           Quick one-line status
 60:   check            Run all checks and show alerts only
 61:   report           Full detailed report
 62:   trend            Show 7-day trend analysis with averages
 63:   history          Show saved reports for auditing
 64:   enable           Enable watchdog timer (auto-monitoring)
 65:   disable          Disable watchdog timer
 66:   help             Show this help message
 67: 
 68: OPTIONS:
 69:   --json           Output in JSON format (for status, check)
 70:   --last=N         Show last N reports (for history, default: 10)
 71:   --format=FORMAT  Output format: text, json (for history)
 72: 
 73: EXAMPLES:
 74:   nftban watchdog status         # Quick status check
 75:   nftban watchdog check          # Run checks, show alerts
 76:   nftban watchdog report         # Full report with all metrics
 77:   nftban watchdog history        # Last 10 reports
 78:   nftban watchdog history --last=24
 79:   nftban watchdog enable         # Enable auto-monitoring
 80: 
 81: WHAT WATCHDOG MONITORS:
 82:   - Load Average     (from /proc/loadavg)
 83:   - Memory Usage     (from /proc/meminfo)
 84:   - Swap Usage       (from /proc/meminfo)
 85:   - I/O Wait %       (from /proc/stat)
 86:   - Disk Usage       (df on /var/log)
 87:   - File Descriptors (from /proc/sys/fs/file-nr)
 88:   - Top Processes    (CPU and memory consumers)
 89: 
 90: CONFIGURATION:
 91:   Config file: /etc/nftban/conf.d/watchdog.conf
 92:   Reports dir: /var/lib/nftban/reports/watchdog/
 93:   Metrics:     /var/lib/nftban/metrics/watchdog.prom
 94: 
 95: EOF
 96: }

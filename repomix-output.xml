138: 		feedsInfo, _ := feeds.GetFeedStats(feedsDir)
139: 
140: 		// Build feeds array with details
141: 		feedsData := []map[string]interface{}{}
142: 		for _, feedName := range feedsList {
143: 			// Check if enabled in config
144: 			enabled := enabledMap[strings.ToUpper(feedName)]
145: 
146: 			feedData := map[string]interface{}{

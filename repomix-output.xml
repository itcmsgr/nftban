<file path="cli/lib/nftban/core/nftban_report_module.sh">
  1: #!/usr/bin/env bash
  2: 
  3: # =============================================================================
  4: # NFTBan v1.0.0 - Module Report Core Module
  5: # =============================================================================
  6: # SPDX-License-Identifier: MPL-2.0
  7: # Purpose: Module inventory scanning and reporting with validation
  8: #
  9: # meta:name=nftban_report_module
 10: # meta:type=core
 11: # meta:header=Module Report Core
 12: # meta:version=1.0.0
 13: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 14: # meta:homepage=https://nftban.com
 15: #
 16: # **Description & Purpose**
 17: # meta:description=Scans, inventories, and validates NFTBan modules by meta tags
 18: # meta:input=Module scan options, output format, validation flags
 19: # meta:output=Module inventory reports with validation results
 20: #
 21: # **Inventory & Requirements**
 22: # meta:depends=bash,grep,sed
 23: #
 24: # meta:created_date=2025-11-05
 25: # meta:updated_date=2025-11-24
 26: # meta:contributors=Claude (Anthropic) - Testing and integration, ChatGPT (OpenAI) - Code review
 27: # =============================================================================
 28: 
 29: # Strict mode
 30: IFS=$'\n\t'
 31: umask 027
 32: 
 33: # =============================================================================
 34: # GLOBALS
 35: # =============================================================================
 36: 
 37: declare -g -A NFTBAN_MODULE_INVENTORY=()  # key: file_path -> "name|version|type|created|depends|owner|homepage|description"
 38: declare -g NFTBAN_MODULE_TIMESTAMP
 39: NFTBAN_MODULE_TIMESTAMP="$(date --iso-8601=seconds)"
 40: declare -g NFTBAN_MODULE_OUTPUT_FORMAT="${NFTBAN_MODULE_OUTPUT_FORMAT:-table}"
 41: 
 42: # Color symbols
 43: if type -t nftban_render_banner >/dev/null 2>&1; then
 44:     NFTBAN_MODULE_SYM_OK="✔"  # shellcheck disable=SC2034  # Symbols for UI rendering
 45:     NFTBAN_MODULE_SYM_KO="✖"  # shellcheck disable=SC2034  # Symbols for UI rendering
 46: else
 47:     NFTBAN_MODULE_SYM_OK="✔"  # shellcheck disable=SC2034  # Symbols for UI rendering
 48:     NFTBAN_MODULE_SYM_KO="✖"  # shellcheck disable=SC2034  # Symbols for UI rendering
 49:     C_RESET="\e[0m"
 50:     C_RED="\e[31m"
 51:     C_GREEN="\e[32m"
 52:     C_YELLOW="\e[33m"
 53:     C_BLUE="\e[34m"
 54:     C_BOLD="\e[1m"
 55: fi
 56: 
 57: # =============================================================================
 58: # HELPER FUNCTIONS
 59: # =============================================================================
 60: 
 61: nftban_module_trim() {
 62:     local s="${*-}"
 63:     s="${s#"${s%%[![:space:]]*}"}"
 64:     s="${s%"${s##*[![:space:]]}"}"
 65:     printf '%s' "$s"
 66: }
 67: 
 68: nftban_module_extract_meta() {
 69:     # Extract meta tag value from file
 70:     # Args: $1 = file path, $2 = meta tag name
 71:     # Output: meta tag value or empty string
 72: 
 73:     local file="$1"
 74:     local tag="$2"
 75: 
 76:     grep -E "^#[[:space:]]*meta:${tag}=" "$file" 2>/dev/null | head -1 | sed -E "s/^#[[:space:]]*meta:${tag}=(.*)/\1/" | sed 's/^"//' | sed 's/"$//' || echo ""
 77: }
 78: 
 79: nftban_module_extract_license() {
 80:     # Extract SPDX license from file
 81:     # Args: $1 = file path
 82:     # Output: license identifier or empty string
 83: 
 84:     local file="$1"
 85:     grep -E "^#[[:space:]]*SPDX-License-Identifier:" "$file" 2>/dev/null | head -1 | sed -E 's/^#[[:space:]]*SPDX-License-Identifier:[[:space:]]*(.*)/\1/' | xargs || echo ""
 86: }
 87: 
 88: # =============================================================================
 89: # MODULE SCANNING FUNCTIONS
 90: # =============================================================================
 91: 
 92: nftban_module_scan() {
 93:     # Scan all shell scripts for meta tags
 94:     # Populates: NFTBAN_MODULE_INVENTORY
 95: 
 96:     local lib_dir="${NFTBAN_LIB_DIR:-/usr/lib/nftban}"
 97: 
 98:     # Find all .sh files in lib directory
 99:     while IFS= read -r -d '' file; do
100:         # Skip if file doesn't exist or isn't readable
101:         [[ ! -r "$file" ]] && continue
102: 
103:         # Check if file has meta tags
104:         if ! grep -q "^#[[:space:]]*meta:" "$file" 2>/dev/null; then
105:             continue
106:         fi
107: 
108:         # Extract meta tags
109:         local name version module_type created depends owner homepage description
110:         name="$(nftban_module_extract_meta "$file" "name")"
111:         version="$(nftban_module_extract_meta "$file" "version")"
112:         module_type="$(nftban_module_extract_meta "$file" "type")"
113:         created="$(nftban_module_extract_meta "$file" "created_date")"
114:         depends="$(nftban_module_extract_meta "$file" "depends")"
115:         owner="$(nftban_module_extract_meta "$file" "owner")"
116:         homepage="$(nftban_module_extract_meta "$file" "homepage")"
117:         description="$(nftban_module_extract_meta "$file" "description")"
118: 
119:         # Skip if no name (invalid module)
120:         [[ -z "$name" ]] && continue
121: 
122:         # Store in inventory
123:         NFTBAN_MODULE_INVENTORY["$file"]="${name}|${version}|${module_type}|${created}|${depends}|${owner}|${homepage}|${description}"
124: 
125:     done < <(find "$lib_dir" -type f -name "*.sh" -print0 2>/dev/null || true)
126: }
127: 
128: nftban_module_check_enabled() {
129:     # Check if a module is enabled
130:     # Args: $1 = file path
131:     # Output: "ENABLED" or "DISABLED"
132: 
133:     local file="$1"
134: 
135:     # If file is executable, consider it enabled
136:     if [[ -x "$file" ]]; then
137:         echo "ENABLED"
138:         return 0
139:     fi
140: 
141:     # All modules in recognized directories are considered enabled (sourced/active)
142:     # - core/     : Core functionality modules
143:     # - cli/      : Command-line interface handlers
144:     # - lib/      : Shared libraries
145:     # - helpers/  : Helper utilities
146:     # - cron/     : Scheduled task modules
147:     # - setup/    : Installation and setup scripts
148:     # - exporters/: Metrics exporters
149:     if [[ "$file" =~ /core/ ]] || [[ "$file" =~ /cli/ ]] || [[ "$file" =~ /lib/ ]] || \
150:        [[ "$file" =~ /helpers/ ]] || [[ "$file" =~ /cron/ ]] || [[ "$file" =~ /setup/ ]] || \
151:        [[ "$file" =~ /exporters/ ]]; then
152:         echo "ENABLED"
153:         return 0
154:     fi
155: 
156:     # nftban_help.sh is also sourced (not executed)
157:     if [[ "$file" =~ nftban_help\.sh$ ]]; then
158:         echo "ENABLED"
159:         return 0
160:     fi
161: 
162:     # Otherwise disabled
163:     echo "DISABLED"
164: }

 355: // StatusHandler returns firewall status
 356: func StatusHandler(w http.ResponseWriter, r *http.Request) {
 357: 	output, err := execNFTBanCommand("status", "--json")
 358: 	if err != nil {
 359: 		respondJSON(w, http.StatusInternalServerError, ErrorResponse{Error: "Failed to get status"})
 360: 		return
 361: 	}
 362: 
 363: 	// Strip any non-JSON output (comments, warnings, etc.) before parsing
 364: 	// Look for the first '{' and last '}' to extract only the JSON portion
 365: 	output = strings.TrimSpace(output)
 366: 	startIdx := strings.Index(output, "{")
 367: 	endIdx := strings.LastIndex(output, "}")
 368: 
 369: 	if startIdx == -1 || endIdx == -1 || startIdx > endIdx {
 370: 		log.Printf("[ERROR] No valid JSON found in status output: %s", output)
 371: 		respondJSON(w, http.StatusInternalServerError, ErrorResponse{Error: "Invalid status response format"})
 372: 		return
 373: 	}
 374: 
 375: 	jsonOutput := output[startIdx : endIdx+1]
 376: 
 377: 	// Parse JSON response from CLI
 378: 	var statusData map[string]interface{}
 379: 	if err := json.Unmarshal([]byte(jsonOutput), &statusData); err != nil {
 380: 		log.Printf("[ERROR] Failed to parse status JSON: %v - Output: %s", err, jsonOutput)
 381: 		respondJSON(w, http.StatusInternalServerError, ErrorResponse{Error: "Failed to parse status data"})
 382: 		return
 383: 	}
 384: 
 385: 	respondJSON(w, http.StatusOK, statusData)
 386: }

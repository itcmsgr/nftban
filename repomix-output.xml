 791:         log_error "PROJECT_ROOT=${PROJECT_ROOT}"
 792:         ls -la "${PROJECT_ROOT}/" || true
 793:         return 1
 794:     fi
 795: 
 796:     # Create tarball with error checking
 797:     log_info "Creating source tarball: ${tarball}"
 798:     if ! tar czf "${BUILD_DIR}/SOURCES/${tarball}" \
 799:         --transform "s,^,nftban-core-${PKG_VERSION}/," \
 800:         -C "${PROJECT_ROOT}" \
 801:         bin/ cli/ cmd/ pkg/ install/ etc/ internal/ packaging/ scripts/ docs/ \
 802:         VERSION go.mod go.sum LICENSE README.md commands.registry.yml; then
 803:         log_error "Failed to create source tarball"
 804:         log_error "tar command failed with exit code $?"
 805:         return 1
 806:     fi
 807: 
 808:     # Verify tarball was created
 809:     if [[ ! -f "${BUILD_DIR}/SOURCES/${tarball}" ]]; then
 810:         log_error "Tarball not found after creation: ${BUILD_DIR}/SOURCES/${tarball}"
 811:         log_error "Contents of ${BUILD_DIR}/SOURCES/:"
 812:         ls -la "${BUILD_DIR}/SOURCES/" || true
 813:         return 1
 814:     fi
 815: 

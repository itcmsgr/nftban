719: // Load 7-day trend data from API
720: async function loadTrendData() {
721:     const setText = (id, value) => {
722:         const el = document.getElementById(id);
723:         if (el) el.textContent = value;
724:     };
725: 
726:     try {
727:         const resp = await fetch('/api/v1/stats/trend', {
728:             headers: window.getAuthHeaders()
729:         }).catch(() => null);
730: 
731:         if (resp && resp.ok) {
732:             const data = await resp.json();
733:             if (data.success && data.data) {
734:                 const trend = data.data;
735: 
736:                 // Averages
737:                 if (trend.averages) {
738:                     setText('trend-avg-hourly', trend.averages.avg_hourly || 0);
739:                     setText('trend-avg-daily', trend.averages.avg_daily || 0);
740: 
741:                     if (trend.averages.samples > 0) {
742:                         setText('trend-samples', `Based on ${trend.averages.samples} hourly samples (min: ${trend.averages.min}, max: ${trend.averages.max})`);
743:                     } else {
744:                         setText('trend-samples', 'No trend data yet. Data is collected hourly by maintenance timer.');
745:                     }
746:                 }
747: 
748:                 // Comparison with colors and arrows
749:                 if (trend.comparison) {
750:                     const vsYesterday = trend.comparison.vs_yesterday || 0;
751:                     const vsWeek = trend.comparison.vs_last_week;
752: 
753:                     // vs Yesterday
754:                     const yesterdayEl = document.getElementById('trend-vs-yesterday');
755:                     if (yesterdayEl) {
756:                         let arrow = '→';
757:                         let colorClass = 'text-muted';
758:                         if (vsYesterday > 0) {
759:                             arrow = '↑';
760:                             colorClass = 'text-danger';
761:                         } else if (vsYesterday < 0) {
762:                             arrow = '↓';
763:                             colorClass = 'text-success';
764:                         }
765:                         yesterdayEl.innerHTML = `<span class="${colorClass}">${arrow} ${Math.abs(vsYesterday)}%</span>`;
766:                     }
767: 
768:                     // vs Last Week
769:                     const weekEl = document.getElementById('trend-vs-week');
770:                     if (weekEl) {
771:                         if (vsWeek === null || vsWeek === undefined) {
772:                             weekEl.innerHTML = '<span class="text-muted">N/A</span>';
773:                         } else {
774:                             let arrow = '→';
775:                             let colorClass = 'text-muted';
776:                             if (vsWeek > 0) {
777:                                 arrow = '↑';
778:                                 colorClass = 'text-danger';
779:                             } else if (vsWeek < 0) {
780:                                 arrow = '↓';
781:                                 colorClass = 'text-success';
782:                             }
783:                             weekEl.innerHTML = `<span class="${colorClass}">${arrow} ${Math.abs(vsWeek)}%</span>`;
784:                         }
785:                     }
786:                 }
787: 
788:                 // Update trend chart with hourly data
789:                 if (trend.hourly && Array.isArray(trend.hourly) && trend.hourly.length > 0 && trendChart) {
790:                     const labels = trend.hourly.map(h => {
791:                         // Format hour label (e.g., "Dec 20 14:00")
792:                         if (h.hour) {
793:                             const date = new Date(h.hour);
794:                             const month = date.toLocaleString('en', { month: 'short' });
795:                             const day = date.getDate();
796:                             const hour = date.getHours().toString().padStart(2, '0');
797:                             return `${month} ${day} ${hour}:00`;
798:                         }
799:                         return '';
800:                     });
801:                     const bansData = trend.hourly.map(h => h.bans || 0);
802: 
803:                     trendChart.data.labels = labels;
804:                     trendChart.data.datasets[0].data = bansData;
805:                     trendChart.update();
806:                 }
807:             }
808:         } else {
809:             setText('trend-samples', 'Trend data not available');
810:         }
811:     } catch (error) {
812:         console.error('[DASHBOARD] Failed to load trend data:', error);
813:         setText('trend-samples', 'Failed to load trend data');
814:     }
815: }
816: 
817: // Auto-initialize when script loads
818: if (document.getElementById('bandwidth-chart')) {
819:     console.log('[DASHBOARD] Auto-initializing dashboard');
820:     window.initDashboardPage();
821:     loadDashboardStats();
822:     loadRecentActivity();
823:     loadTopCountries();
824:     loadTrendData();

238: 
239:       # Prevent file from growing infinitely
240:       rotate-interval: 1h
241: 
242:       # JSON formatting
243:       community-id: yes
244:       community-id-seed: 0
245: 
246:       # === ENABLED EVENT TYPES (minimal set for NFTBan) ===
247:       types:
248:         # CRITICAL: Alerts (signature matches)
249:         - alert:
250:             payload: no              # Don't log packet payloads (saves space)
251:             payload-buffer-size: 0
252:             payload-printable: no
253:             packet: no               # Don't log full packets
254:             metadata: yes            # Keep metadata for correlation
255:             tagged-packets: no
256: 
257:         # HTTP logs (for WordPress/web attack detection)
258:         - http:
259:             extended: yes            # Include extended HTTP fields
260:             custom: [accept, accept-charset, accept-encoding, accept-language,
261:                      authorization, cache-control, cookie, from,
262:                      referer, user-agent, x-forwarded-for]
263: 
264:         # SSH logs (for brute-force detection)

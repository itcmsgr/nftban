 833: // AddDropRuleForSet adds a rule to drop packets from IPs in a set
 834: func (m *NFTManager) AddDropRuleForSet(chain *nftables.Chain, set *nftables.Set, ipv4 bool) error {
 835: 	// Build rule: ip saddr @blacklist_ipv4 drop
 836: 	var expressions []expr.Any
 837: 
 838: 	if ipv4 {
 839: 		// Load IPv4 source address
 840: 		expressions = append(expressions,
 841: 			&expr.Payload{
 842: 				DestRegister: 1,
 843: 				Base:         expr.PayloadBaseNetworkHeader,
 844: 				Offset:       12, // IPv4 source address offset
 845: 				Len:          4,  // IPv4 address length
 846: 			},
 847: 		)
 848: 	} else {
 849: 		// Load IPv6 source address
 850: 		expressions = append(expressions,
 851: 			&expr.Payload{
 852: 				DestRegister: 1,
 853: 				Base:         expr.PayloadBaseNetworkHeader,
 854: 				Offset:       8,  // IPv6 source address offset
 855: 				Len:          16, // IPv6 address length
 856: 			},
 857: 		)
 858: 	}
 859: 
 860: 	// Lookup in set
 861: 	expressions = append(expressions,
 862: 		&expr.Lookup{
 863: 			SourceRegister: 1,
 864: 			SetName:        set.Name,
 865: 			SetID:          set.ID,
 866: 		},
 867: 	)
 868: 
 869: 	// Drop verdict
 870: 	expressions = append(expressions,
 871: 		&expr.Verdict{
 872: 			Kind: expr.VerdictDrop,
 873: 		},
 874: 	)
 875: 
 876: 	// Add rule
 877: 	rule := &nftables.Rule{
 878: 		Table: chain.Table,
 879: 		Chain: chain,
 880: 		Exprs: expressions,
 881: 	}
 882: 
 883: 	m.conn.AddRule(rule)
 884: 
 885: 	if err := m.conn.Flush(); err != nil {
 886: 		return fmt.Errorf("failed to add drop rule: %w", err)
 887: 	}
 888: 
 889: 	return nil
 890: }

 11: 
 12: // EveAlert represents a Suricata eve.json alert entry
 13: type EveAlert struct {
 14: 	Timestamp string `json:"timestamp"`
 15: 	EventType string `json:"event_type"`
 16: 	SrcIP     string `json:"src_ip"`
 17: 	SrcPort   int    `json:"src_port"`
 18: 	DestIP    string `json:"dest_ip"`
 19: 	DestPort  int    `json:"dest_port"`
 20: 	Proto     string `json:"proto"`
 21: 	Alert     struct {
 22: 		SignatureID int    `json:"signature_id"`
 23: 		Signature   string `json:"signature"`
 24: 		Category    string `json:"category"`
 25: 		Severity    int    `json:"severity"` // 1=High, 2=Medium, 3=Low, 4=Info
 26: 		Action      string `json:"action"`
 27: 	} `json:"alert"`
 28: 	HTTP *struct {
 29: 		Hostname string `json:"hostname"`
 30: 		URL      string `json:"url"`
 31: 		Method   string `json:"http_method"`
 32: 	} `json:"http,omitempty"`
 33: 	SSH *struct {
 34: 		Client  string `json:"client"`
 35: 		Server  string `json:"server"`
 36: 		Version string `json:"proto_version"`
 37: 	} `json:"ssh,omitempty"`
 38: }
 39: 
 40: // Event represents a normalized Suricata event for NFTBan processing
 41: type Event struct {
 42: 	Timestamp   time.Time
 43: 	EventType   string // "alert", "http", "ssh", etc.
 44: 	SrcIP       string
 45: 	SrcPort     int
 46: 	DestIP      string
 47: 	DestPort    int
 48: 	Proto       string
 49: 	SignatureID int
 50: 	Signature   string
 51: 	Category    string
 52: 	Severity    int    // 1=High, 2=Medium, 3=Low, 4=Info
 53: 	Filter      string // Matched filter name (e.g., "ssh", "http")
 54: }
 55: 
 56: // EveReader reads and parses Suricata eve.json log file
 57: type EveReader struct {
 58: 	file    *os.File
 59: 	reader  *bufio.Reader
 60: 	path    string
 61: 	matcher *FilterMatcher
 62: }
 63: 
 64: // NewEveReader creates a new eve.json reader
 65: func NewEveReader(evePath string, matcher *FilterMatcher) (*EveReader, error) {
 66: 	file, err := os.Open(evePath)
 67: 	if err != nil {
 68: 		return nil, fmt.Errorf("failed to open eve.json: %w", err)
 69: 	}
 70: 
 71: 	// Seek to end to only process new events
 72: 	if _, err := file.Seek(0, io.SeekEnd); err != nil {
 73: 		file.Close()
 74: 		return nil, fmt.Errorf("failed to seek to end: %w", err)
 75: 	}
 76: 
 77: 	return &EveReader{
 78: 		file:    file,
 79: 		reader:  bufio.NewReader(file),
 80: 		path:    evePath,
 81: 		matcher: matcher,
 82: 	}, nil
 83: }
 84: 
 85: // Close closes the eve.json file
 86: func (r *EveReader) Close() error {
 87: 	if r.file != nil {
 88: 		return r.file.Close()
 89: 	}
 90: 	return nil
 91: }
 92: 
 93: // ReadEvent reads the next event from eve.json
 94: // Returns nil if no event available (non-blocking)
 95: func (r *EveReader) ReadEvent() (*Event, error) {
 96: 	line, err := r.reader.ReadBytes('\n')
 97: 	if err != nil {
 98: 		if err == io.EOF {
 99: 			// No data available right now
100: 			return nil, nil
101: 		}
102: 		return nil, fmt.Errorf("failed to read line: %w", err)
103: 	}
104: 
105: 	// Parse JSON
106: 	var raw map[string]interface{}
107: 	if err := json.Unmarshal(line, &raw); err != nil {
108: 		// Skip malformed JSON
109: 		return nil, nil
110: 	}
111: 
112: 	// Only process "alert" events
113: 	eventType, ok := raw["event_type"].(string)
114: 	if !ok || eventType != "alert" {
115: 		// Skip non-alert events
116: 		return nil, nil
117: 	}
118: 
119: 	// Parse full alert structure
120: 	var alert EveAlert
121: 	if err := json.Unmarshal(line, &alert); err != nil {
122: 		// Skip if can't parse
123: 		return nil, nil
124: 	}
125: 
126: 	// Parse timestamp
127: 	timestamp, err := time.Parse(time.RFC3339Nano, alert.Timestamp)
128: 	if err != nil {
129: 		timestamp = time.Now()
130: 	}
131: 
132: 	// Match filter
133: 	filterName, _ := r.matcher.GetFilterForEvent(alert.Alert.Signature, alert.Alert.Category)
134: 
135: 	// Create normalized event
136: 	event := &Event{
137: 		Timestamp:   timestamp,
138: 		EventType:   alert.EventType,
139: 		SrcIP:       alert.SrcIP,
140: 		SrcPort:     alert.SrcPort,
141: 		DestIP:      alert.DestIP,
142: 		DestPort:    alert.DestPort,
143: 		Proto:       alert.Proto,
144: 		SignatureID: alert.Alert.SignatureID,
145: 		Signature:   alert.Alert.Signature,
146: 		Category:    alert.Alert.Category,
147: 		Severity:    alert.Alert.Severity,
148: 		Filter:      filterName,
149: 	}
150: 
151: 	return event, nil
152: }
153: 
154: // ReadEvents continuously reads events from eve.json
155: // Sends events to the provided channel
156: func (r *EveReader) ReadEvents(events chan<- *Event, stopChan <-chan struct{}) error {
157: 	ticker := time.NewTicker(100 * time.Millisecond)
158: 	defer ticker.Stop()
159: 
160: 	for {
161: 		select {
162: 		case <-stopChan:
163: 			return nil
164: 		case <-ticker.C:
165: 			// Try to read an event
166: 			event, err := r.ReadEvent()
167: 			if err != nil {
168: 				// Log error but continue
169: 				fmt.Fprintf(os.Stderr, "Error reading event: %v\n", err)
170: 				continue
171: 			}
172: 
173: 			if event != nil {
174: 				// Send event to channel (non-blocking)
175: 				select {
176: 				case events <- event:
177: 				case <-stopChan:
178: 					return nil
179: 				default:
180: 					// Channel full, skip event
181: 					fmt.Fprintf(os.Stderr, "Warning: event channel full, dropping event\n")
182: 				}
183: 			}
184: 		}
185: 	}
186: }
</file>

<file path="pkg/suricata/scorer.go">
  1: package suricata
  2: 
  3: import (
  4: 	"sync"
  5: 	"time"
  6: )
  7: 
  8: // IPScore tracks scoring for a single IP address
  9: type IPScore struct {
 10: 	IP            string
 11: 	CurrentScore  int
 12: 	Events        []time.Time // Timestamps of recent events
 13: 	LastUpdate    time.Time
 14: 	TotalEvents   int
 15: }
 16: 
 17: // Scorer calculates threat scores for IPs based on Suricata events
 18: type Scorer struct {
 19: 	mu          sync.RWMutex
 20: 	scores      map[string]*IPScore
 21: 	config      *Config
 22: 	decayTicker *time.Ticker
 23: 	stopChan    chan struct{}
 24: }
 25: 
 26: // NewScorer creates a new scorer
 27: func NewScorer(config *Config) *Scorer {
 28: 	s := &Scorer{
 29: 		scores:      make(map[string]*IPScore),
 30: 		config:      config,
 31: 		decayTicker: time.NewTicker(1 * time.Minute),
 32: 		stopChan:    make(chan struct{}),
 33: 	}
 34: 
 35: 	// Start decay goroutine
 36: 	go s.runDecay()
 37: 
 38: 	return s
 39: }
 40: 
 41: // Stop stops the scorer
 42: func (s *Scorer) Stop() {
 43: 	close(s.stopChan)
 44: 	s.decayTicker.Stop()
 45: }
 46: 
 47: // runDecay periodically decays scores
 48: func (s *Scorer) runDecay() {
 49: 	for {
 50: 		select {
 51: 		case <-s.decayTicker.C:
 52: 			s.applyDecay()
 53: 		case <-s.stopChan:
 54: 			return
 55: 		}
 56: 	}
 57: }
 58: 
 59: // applyDecay removes old events and decays scores
 60: func (s *Scorer) applyDecay() {
 61: 	s.mu.Lock()
 62: 	defer s.mu.Unlock()
 63: 
 64: 	cutoff := time.Now().Add(-s.config.ScoreDecay)
 65: 
 66: 	for ip, score := range s.scores {
 67: 		// Remove events older than decay period
 68: 		newEvents := []time.Time{}
 69: 		for _, t := range score.Events {
 70: 			if t.After(cutoff) {
 71: 				newEvents = append(newEvents, t)
 72: 			}
 73: 		}
 74: 		score.Events = newEvents
 75: 
 76: 		// If no recent events, remove IP from tracking
 77: 		if len(score.Events) == 0 {
 78: 			delete(s.scores, ip)
 79: 		}
 80: 	}
 81: }
 82: 
 83: // AddEvent processes a new event and updates IP score
 84: func (s *Scorer) AddEvent(event *Event) int {
 85: 	s.mu.Lock()
 86: 	defer s.mu.Unlock()
 87: 
 88: 	// Get or create IP score tracker
 89: 	score, exists := s.scores[event.SrcIP]
 90: 	if !exists {
 91: 		score = &IPScore{
 92: 			IP:     event.SrcIP,
 93: 			Events: []time.Time{},
 94: 		}
 95: 		s.scores[event.SrcIP] = score
 96: 	}
 97: 
 98: 	// Add event timestamp
 99: 	score.Events = append(score.Events, event.Timestamp)
100: 	score.LastUpdate = time.Now()
101: 	score.TotalEvents++
102: 
103: 	// Calculate new score
104: 	newScore := s.calculateScore(event, score)
105: 	score.CurrentScore = newScore
106: 
107: 	return newScore
108: }
109: 
110: // calculateScore calculates the threat score for an IP based on an event
111: func (s *Scorer) calculateScore(event *Event, ipScore *IPScore) int {
112: 	score := 0
113: 
114: 	// 1. Base severity score
115: 	// Severity: 1=High(40pts), 2=Medium(30pts), 3=Low(20pts), 4=Info(10pts)
116: 	severityScores := map[int]int{
117: 		1: 40, // High
118: 		2: 30, // Medium
119: 		3: 20, // Low
120: 		4: 10, // Info
121: 	}
122: 	if severityScore, ok := severityScores[event.Severity]; ok {
123: 		score += severityScore
124: 	}
125: 
126: 	// 2. Repetition score (events in last 2 minutes)
127: 	cutoff := time.Now().Add(-2 * time.Minute)
128: 	recentCount := 0
129: 	for _, t := range ipScore.Events {
130: 		if t.After(cutoff) {
131: 			recentCount++
132: 		}
133: 	}
134: 
135: 	if recentCount >= 5 && recentCount < 10 {
136: 		score += 20
137: 	} else if recentCount >= 10 && recentCount < 20 {
138: 		score += 30
139: 	} else if recentCount >= 20 {
140: 		score += 50
141: 	}
142: 
143: 	// 3. TODO: Integrate with feeds module (when available)
144: 	// if feeds.IsBlacklisted(event.SrcIP) {
145: 	//     score += 30
146: 	// }
147: 
148: 	// 4. TODO: Integrate with geoban module (when available)
149: 	// country := geoban.Lookup(event.SrcIP)
150: 	// if country in high-risk countries {
151: 	//     score += 10
152: 	// }
153: 
154: 	// 5. TODO: Integrate with DDoS counters (when available)
155: 	// if ddos.GetPPS(event.SrcIP) > 1000 {
156: 	//     score += 40
157: 	// }
158: 
159: 	return score
160: }
161: 
162: // GetScore returns the current score for an IP
163: func (s *Scorer) GetScore(ip string) int {
164: 	s.mu.RLock()
165: 	defer s.mu.RUnlock()
166: 
167: 	if score, exists := s.scores[ip]; exists {
168: 		return score.CurrentScore
169: 	}
170: 	return 0
171: }
172: 
173: // GetIPScore returns full scoring details for an IP
174: func (s *Scorer) GetIPScore(ip string) *IPScore {
175: 	s.mu.RLock()
176: 	defer s.mu.RUnlock()
177: 
178: 	if score, exists := s.scores[ip]; exists {
179: 		// Return a copy to avoid race conditions
180: 		return &IPScore{
181: 			IP:           score.IP,
182: 			CurrentScore: score.CurrentScore,
183: 			Events:       append([]time.Time{}, score.Events...),
184: 			LastUpdate:   score.LastUpdate,
185: 			TotalEvents:  score.TotalEvents,
186: 		}
187: 	}
188: 	return nil
189: }
190: 
191: // GetAllScores returns all current IP scores
192: func (s *Scorer) GetAllScores() map[string]*IPScore {
193: 	s.mu.RLock()
194: 	defer s.mu.RUnlock()
195: 
196: 	// Return a copy
197: 	result := make(map[string]*IPScore)
198: 	for ip, score := range s.scores {
199: 		result[ip] = &IPScore{
200: 			IP:           score.IP,
201: 			CurrentScore: score.CurrentScore,
202: 			Events:       append([]time.Time{}, score.Events...),
203: 			LastUpdate:   score.LastUpdate,
204: 			TotalEvents:  score.TotalEvents,
205: 		}
206: 	}
207: 	return result
208: }
209: 
210: // ResetScore resets the score for an IP (e.g., after banning)
211: func (s *Scorer) ResetScore(ip string) {
212: 	s.mu.Lock()
213: 	defer s.mu.Unlock()
214: 
215: 	delete(s.scores, ip)
216: }

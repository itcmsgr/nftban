package pages

import (
	"fmt"
	"strconv"
	"github.com/itcmsgr/nftban/internal/ui"
)

// BansData wrapper for page-specific data
type BansPageData struct {
	Data ui.BansData
}

// Bans renders the ban management page
templ Bans(data ui.BansData) {
	@ui.LayoutWithNav("Bans", "bans") {
		<!-- Page Header with Stats -->
		<div class="page-header">
			<h1>Ban Management</h1>
			<div class="header-stats">
				<span class="stat-badge danger">{ strconv.Itoa(data.TotalBans) } Total</span>
				<span class="stat-badge">IPv4: { strconv.Itoa(data.BansIPv4) }</span>
				<span class="stat-badge">IPv6: { strconv.Itoa(data.BansIPv6) }</span>
				<span class="stat-badge warning">Temp: { strconv.Itoa(data.TempBans) }</span>
				<span class="stat-badge info">Perm: { strconv.Itoa(data.PermBans) }</span>
			</div>
		</div>

		<!-- Bulk Action Toolbar (hidden by default, shown when items selected) -->
		<div id="bulk-toolbar" class="bulk-toolbar" style="display: none;">
			<div class="bulk-info">
				<span id="selected-count">0</span> items selected
			</div>
			<div class="bulk-actions">
				<button class="btn btn-warning" onclick="bulkUnban()" title="Unban selected IPs">
					Bulk Unban
				</button>
				<button class="btn btn-danger" onclick="bulkDelete()" title="Permanently delete selected bans">
					Bulk Delete
				</button>
				<button class="btn btn-secondary" onclick="clearSelection()">
					Clear Selection
				</button>
			</div>
		</div>

		<!-- Search and Filter Bar -->
		<div class="toolbar">
			<div class="search-group">
				<input
					type="text"
					class="search-input"
					placeholder="Search IP address..."
					name="search"
					hx-get="/ui/frag/bans-table"
					hx-trigger="keyup changed delay:300ms"
					hx-target="#bans-table"
					hx-include="[name='filter']"
				/>
			</div>
			<div class="filter-group">
				<select name="filter" class="filter-select" hx-get="/ui/frag/bans-table" hx-trigger="change" hx-target="#bans-table" hx-include="[name='search']">
					<option value="all" selected?={ data.Filter == "all" }>All Bans</option>
					<option value="temp" selected?={ data.Filter == "temp" }>Temporary</option>
					<option value="perm" selected?={ data.Filter == "perm" }>Permanent</option>
					<option value="feed" selected?={ data.Filter == "feed" }>From Feeds</option>
					<option value="geo" selected?={ data.Filter == "geo" }>GeoBan</option>
				</select>
			</div>
			<div class="action-group">
				<button class="btn btn-primary" onclick="showBanModal()">
					+ Ban IP
				</button>
				<button class="btn btn-warning" hx-post="/ui/action/flush-temp" hx-confirm="Clear ALL temporary bans?">
					Flush Temp
				</button>
			</div>
		</div>

		<!-- Bans Table -->
		<div class="card">
			<div id="bans-table" hx-get="/ui/frag/bans-table" hx-trigger="every 10s" hx-swap="innerHTML">
				@BansTableFragment(data)
			</div>
		</div>

		<!-- Bulk Operation Result -->
		<div id="bulk-result" class="bulk-result" style="display: none;"></div>

		<!-- Ban Modal (hidden by default) -->
		<div id="ban-modal" class="modal" style="display: none;">
			<div class="modal-content">
				<div class="modal-header">
					<h3>Ban IP Address</h3>
					<button class="modal-close" onclick="hideBanModal()">&times;</button>
				</div>
				<form hx-post="/api/v1/ban" hx-target="#ban-result" hx-swap="innerHTML">
					<div class="form-group">
						<label>IP Address</label>
						<input type="text" name="ip" class="form-input" placeholder="192.168.1.100 or 2001:db8::1" required/>
					</div>
					<div class="form-group">
						<label>Ban Type</label>
						<select name="type" class="form-select">
							<option value="permanent">Permanent</option>
							<option value="temporary">Temporary</option>
						</select>
					</div>
					<div class="form-group" id="timeout-group">
						<label>Duration (seconds)</label>
						<input type="number" name="timeout" class="form-input" value="3600" min="60"/>
					</div>
					<div class="form-group">
						<label>Reason</label>
						<input type="text" name="reason" class="form-input" placeholder="Manual ban"/>
					</div>
					<div id="ban-result"></div>
					<div class="modal-actions">
						<button type="button" class="btn btn-secondary" onclick="hideBanModal()">Cancel</button>
						<button type="submit" class="btn btn-danger">Ban IP</button>
					</div>
				</form>
			</div>
		</div>

		@bulkOperationsScript()
	}
}

// bulkOperationsScript renders the JavaScript for bulk operations
templ bulkOperationsScript() {
	<script>
		// Track selected IPs
		let selectedIPs = new Set();

		function showBanModal() {
			document.getElementById('ban-modal').style.display = 'flex';
		}

		function hideBanModal() {
			document.getElementById('ban-modal').style.display = 'none';
		}

		// Toggle individual row selection
		function toggleRowSelection(checkbox, ip) {
			if (checkbox.checked) {
				selectedIPs.add(ip);
			} else {
				selectedIPs.delete(ip);
			}
			updateBulkToolbar();
			updateSelectAllState();
		}

		// Select all / deselect all
		function toggleSelectAll(checkbox) {
			const rowCheckboxes = document.querySelectorAll('.ban-row-checkbox');
			rowCheckboxes.forEach(cb => {
				cb.checked = checkbox.checked;
				const ip = cb.dataset.ip;
				if (checkbox.checked) {
					selectedIPs.add(ip);
				} else {
					selectedIPs.delete(ip);
				}
			});
			updateBulkToolbar();
		}

		// Update select-all checkbox state based on individual selections
		function updateSelectAllState() {
			const selectAll = document.getElementById('select-all-checkbox');
			const rowCheckboxes = document.querySelectorAll('.ban-row-checkbox');
			if (!selectAll || rowCheckboxes.length === 0) return;

			const allChecked = Array.from(rowCheckboxes).every(cb => cb.checked);
			const someChecked = Array.from(rowCheckboxes).some(cb => cb.checked);

			selectAll.checked = allChecked;
			selectAll.indeterminate = someChecked && !allChecked;
		}

		// Update bulk toolbar visibility and selected count
		function updateBulkToolbar() {
			const toolbar = document.getElementById('bulk-toolbar');
			const countEl = document.getElementById('selected-count');
			const count = selectedIPs.size;

			if (count > 0) {
				toolbar.style.display = 'flex';
				countEl.textContent = count;
			} else {
				toolbar.style.display = 'none';
			}
		}

		// Clear all selections
		function clearSelection() {
			selectedIPs.clear();
			const checkboxes = document.querySelectorAll('.ban-row-checkbox, #select-all-checkbox');
			checkboxes.forEach(cb => {
				cb.checked = false;
				cb.indeterminate = false;
			});
			updateBulkToolbar();
		}

		// Bulk unban operation
		async function bulkUnban() {
			if (selectedIPs.size === 0) return;

			const ips = Array.from(selectedIPs);
			const confirmMsg = `Unban ${ips.length} IP(s)? This will remove them from the ban list.`;
			if (!confirm(confirmMsg)) return;

			await performBulkOperation('/ui/action/bulk-unban', ips, 'unban');
		}

		// Bulk delete operation (permanent removal)
		async function bulkDelete() {
			if (selectedIPs.size === 0) return;

			const ips = Array.from(selectedIPs);
			const confirmMsg = `Permanently delete ${ips.length} ban(s)? This action cannot be undone.`;
			if (!confirm(confirmMsg)) return;

			await performBulkOperation('/ui/action/bulk-delete', ips, 'delete');
		}

		// Perform bulk operation via fetch
		async function performBulkOperation(url, ips, operation) {
			const resultEl = document.getElementById('bulk-result');
			resultEl.style.display = 'block';
			resultEl.className = 'bulk-result loading';
			resultEl.innerHTML = `<span class="spinner"></span> Processing ${ips.length} ${operation} operation(s)...`;

			try {
				const response = await fetch(url, {
					method: 'POST',
					headers: {
						'Content-Type': 'application/json',
					},
					body: JSON.stringify({ ips: ips })
				});

				const data = await response.json();

				if (response.ok) {
					resultEl.className = 'bulk-result success';
					resultEl.innerHTML = `<strong>Success:</strong> ${data.success_count} of ${data.total} operations completed.`;
					if (data.failed_count > 0) {
						resultEl.innerHTML += ` <span class="text-warning">(${data.failed_count} failed)</span>`;
					}

					// Clear selection and refresh table
					clearSelection();
					htmx.trigger('#bans-table', 'htmx:load');
				} else {
					resultEl.className = 'bulk-result error';
					resultEl.innerHTML = `<strong>Error:</strong> ${data.error || 'Operation failed'}`;
				}

				// Auto-hide result after 5 seconds
				setTimeout(() => {
					resultEl.style.display = 'none';
				}, 5000);

			} catch (error) {
				resultEl.className = 'bulk-result error';
				resultEl.innerHTML = `<strong>Error:</strong> ${error.message}`;
			}
		}

		// Re-apply selections after HTMX table refresh
		document.body.addEventListener('htmx:afterSwap', function(event) {
			if (event.detail.target.id === 'bans-table') {
				// Re-check checkboxes for IPs that were previously selected
				const checkboxes = document.querySelectorAll('.ban-row-checkbox');
				checkboxes.forEach(cb => {
					if (selectedIPs.has(cb.dataset.ip)) {
						cb.checked = true;
					}
				});
				updateSelectAllState();
				updateBulkToolbar();
			}
		});
	</script>

	<style>
		.bulk-toolbar {
			display: flex;
			align-items: center;
			justify-content: space-between;
			background: var(--bg-tertiary, #2a2a3e);
			border: 1px solid var(--border-color, #3a3a5e);
			border-radius: 8px;
			padding: 12px 16px;
			margin-bottom: 16px;
			animation: slideDown 0.2s ease-out;
		}

		@keyframes slideDown {
			from { opacity: 0; transform: translateY(-10px); }
			to { opacity: 1; transform: translateY(0); }
		}

		.bulk-info {
			font-weight: 600;
			color: var(--text-primary, #fff);
		}

		.bulk-info #selected-count {
			color: var(--color-primary, #6366f1);
			font-size: 1.1em;
		}

		.bulk-actions {
			display: flex;
			gap: 8px;
		}

		.bulk-result {
			padding: 12px 16px;
			border-radius: 8px;
			margin-bottom: 16px;
			font-weight: 500;
		}

		.bulk-result.loading {
			background: var(--bg-tertiary, #2a2a3e);
			color: var(--text-secondary, #a0a0a0);
		}

		.bulk-result.success {
			background: rgba(16, 185, 129, 0.15);
			border: 1px solid var(--color-success, #10b981);
			color: var(--color-success, #10b981);
		}

		.bulk-result.error {
			background: rgba(239, 68, 68, 0.15);
			border: 1px solid var(--color-danger, #ef4444);
			color: var(--color-danger, #ef4444);
		}

		.bulk-result .spinner {
			display: inline-block;
			width: 14px;
			height: 14px;
			border: 2px solid currentColor;
			border-right-color: transparent;
			border-radius: 50%;
			animation: spin 0.75s linear infinite;
			margin-right: 8px;
			vertical-align: middle;
		}

		@keyframes spin {
			to { transform: rotate(360deg); }
		}

		/* Checkbox styling */
		.checkbox-cell {
			width: 40px;
			text-align: center;
		}

		.checkbox-cell input[type="checkbox"] {
			width: 18px;
			height: 18px;
			cursor: pointer;
			accent-color: var(--color-primary, #6366f1);
		}

		/* Row hover highlight when checkbox is checked */
		tr:has(.ban-row-checkbox:checked) {
			background: rgba(99, 102, 241, 0.1);
		}

		.text-warning {
			color: var(--color-warning, #f59e0b);
		}
	</style>
}

// BansTableFragment renders just the table (for HTMX updates)
templ BansTableFragment(data ui.BansData) {
	<table class="data-table">
		<thead>
			<tr>
				<th class="checkbox-cell">
					<input
						type="checkbox"
						id="select-all-checkbox"
						onclick="toggleSelectAll(this)"
						title="Select all"
					/>
				</th>
				<th>IP Address</th>
				<th>Type</th>
				<th>Country</th>
				<th>Reason</th>
				<th>Module</th>
				<th>Source</th>
				<th>Banned At</th>
				<th>Expires</th>
				<th>Action</th>
			</tr>
		</thead>
		<tbody>
			if len(data.Bans) == 0 {
				<tr>
					<td colspan="10" class="empty-state">No bans found</td>
				</tr>
			} else {
				for _, ban := range data.Bans {
					<tr>
						<td class="checkbox-cell">
							<input
								type="checkbox"
								class="ban-row-checkbox"
								data-ip={ ban.IP }
								onchange="toggleRowSelection(this, this.dataset.ip)"
							/>
						</td>
						<td class="ip-cell">
							<code>{ ban.IP }</code>
						</td>
						<td>
							<span class={ "type-badge", getBanTypeClass(ban.Type) }>{ ban.Type }</span>
						</td>
						<td>
							if ban.CountryCode != "" {
								<span class="country-flag" title={ ban.Country }>{ ban.CountryCode }</span>
							} else {
								<span class="text-muted">--</span>
							}
						</td>
						<td class="reason-cell" title={ ban.Reason }>
							{ truncate(ban.Reason, 30) }
						</td>
						<td>
							<span class="module-badge">{ ban.Module }</span>
						</td>
						<td class="source-cell">
							if ban.Source != "" {
								{ truncate(ban.Source, 25) }
							} else {
								<span class="text-muted">--</span>
							}
						</td>
						<td class="time-cell">{ ban.BannedAt }</td>
						<td class="time-cell">
							if ban.ExpiresAt != "" {
								{ ban.ExpiresAt }
							} else {
								<span class="text-muted">Never</span>
							}
						</td>
						<td>
							<button
								class="btn btn-sm btn-danger"
								hx-post="/api/v1/unban"
								hx-vals={ fmt.Sprintf(`{"ip": "%s"}`, ban.IP) }
								hx-confirm={ fmt.Sprintf("Unban %s?", ban.IP) }
								hx-target="#bans-table"
								hx-swap="innerHTML"
							>
								Unban
							</button>
						</td>
					</tr>
				}
			}
		</tbody>
	</table>

	<!-- Pagination -->
	if data.TotalPages > 1 {
		<div class="pagination">
			for i := 1; i <= data.TotalPages; i++ {
				<button
					class={ "page-btn", templ.KV("active", i == data.Page) }
					hx-get={ fmt.Sprintf("/ui/frag/bans-table?page=%d", i) }
					hx-target="#bans-table"
				>
					{ strconv.Itoa(i) }
				</button>
			}
		</div>
	}
}

// Helper functions
func getBanTypeClass(banType string) string {
	switch banType {
	case "permanent":
		return "danger"
	case "temporary":
		return "warning"
	case "feed":
		return "info"
	case "geoban":
		return "secondary"
	default:
		return ""
	}
}

func truncate(s string, max int) string {
	if len(s) <= max {
		return s
	}
	return s[:max-3] + "..."
}

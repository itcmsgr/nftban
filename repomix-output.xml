105:     else
106:         echo "ERROR: Trace library not found" >&2
107:         return 1
108:     fi
109: 
110:     echo "Checking for orphaned traces (scripts that started but never finished)..."
111:     echo "Looking for traces older than ${minutes} minutes..."
112:     echo ""
113: 
114:     nftban_trace_find_orphans "$minutes"
115: }
116: 
117: nftban_smoke_stats() {
118:     # Source trace library
119:     if [[ -f "${NFTBAN_LIB_DIR}/helpers/nftban_trace.sh" ]]; then
120:         # shellcheck source=/dev/null
121:         source "${NFTBAN_LIB_DIR}/helpers/nftban_trace.sh"
122:     else
123:         echo "ERROR: Trace library not found" >&2
124:         return 1
125:     fi
126: 
127:     nftban_trace_stats
128: }
129: 
130: nftban_smoke_trace() {
131:     local subcommand="${1:-recent}"
132:     shift || true
133: 
134:     # Source trace library
135:     if [[ -f "${NFTBAN_LIB_DIR}/helpers/nftban_trace.sh" ]]; then
136:         # shellcheck source=/dev/null
137:         source "${NFTBAN_LIB_DIR}/helpers/nftban_trace.sh"
138:     else
139:         echo "ERROR: Trace library not found" >&2
140:         return 1
141:     fi
142: 
143:     case "$subcommand" in
144:         recent)
145:             local count="${1:-20}"
146:             nftban_trace_recent "$count"
147:             ;;
148:         rotate)
149:             local days="${1:-7}"
150:             nftban_trace_rotate "$days"
151:             ;;
152:         enable|disable)
153:             echo "Use 'nftban debug $subcommand' instead"
154:             echo ""
155:             echo "Quick reference:"
156:             echo "  nftban debug enable    Enable debug trace"
157:             echo "  nftban debug disable   Disable debug trace"
158:             echo "  nftban debug status    Show debug status"
159:             ;;
160:         *)
161:             echo "Unknown trace command: $subcommand"
162:             echo "Available: recent, rotate"
163:             echo ""
164:             echo "For enable/disable, use: nftban debug enable/disable"
165:             return 1
166:             ;;
167:     esac
168: }
169: 
170: # =============================================================================
171: # USAGE
172: # =============================================================================
173: 
174: nftban_cmd_smoke_usage() {
175:     cat <<EOF
176: Usage: nftban smoke <command> [OPTIONS]
177: 
178: CLI health check and debugging tool.
179: 
180: Commands:
181:   run, test          Run standard smoke test (~20 commands)
182:   quick              Run quick test (3 core commands only)
183:   all, detailed      Run ALL CLI tests (43 commands - comprehensive)
184:   check [MINUTES]    Check for orphaned traces (stuck scripts)
185:   stats              Show trace statistics
186:   trace recent [N]   Show last N trace entries
187:   trace rotate [D]   Rotate trace log, keep D days
188: 
189: Test Modes:
190:   quick    = 3 tests   (version, help, status)
191:   run/test = ~20 tests (core + modules + stats + search)
192:   all      = 43+ tests (every cmd_*.sh gets help tested)
193: 
194: Examples:
195:   nftban smoke run              # Standard smoke test (~20 commands)
196:   nftban smoke quick            # Quick test (3 commands)
197:   nftban smoke all              # Test ALL 43 CLI commands
198:   nftban smoke check            # Check for stuck scripts
199:   nftban smoke check 10         # Check traces older than 10 min
200:   nftban smoke stats            # Trace statistics
201:   nftban smoke trace recent 50  # Last 50 trace entries
202: 
203: Debug Trace Configuration:
204:   Set NFTBAN_DEBUG_TRACE="true" in /etc/nftban/nftban.conf to enable
205:   script execution tracing. Each script logs START/END with unique ID.
206:   If START exists without END = script crashed/stuck.
207: 
208:   Trace log: /var/log/nftban/debug_trace.log
209: 
210: EOF
211: }
212: 
213: # Export functions
214: export -f nftban_cmd_smoke
215: export -f nftban_cmd_smoke_usage
</file>


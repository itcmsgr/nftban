</file>

<file path="cli/sbin/nftban-confirm">
 1: #!/usr/bin/env bash
 2: # NFTBan Emergency Recovery - Confirm Rules
 3: # Copyright (c) 2024–2026 NFTBAN Project / Antonios Voulvoulis
 4: # SPDX-License-Identifier: MPL-2.0
 5: #
 6: # Confirms the currently applied rules and disarms the rollback timer.
 7: # Call this after verifying SSH/connectivity works with new rules.
 8: 
 9: set -Eeuo pipefail
10: 
11: ROLLBACK_FLAG="/run/nftban.rollback.deadline"
12: 
13: echo "╔═══════════════════════════════════════════════════╗"
14: echo "║  NFTBan Emergency Recovery - Confirm Rules       ║"
15: echo "╚═══════════════════════════════════════════════════╝"
16: echo ""
17: 
18: # Check if we have a pending rollback
19: if [[ -f "$ROLLBACK_FLAG" ]]; then
20:     DEADLINE=$(cat "$ROLLBACK_FLAG")
21:     NOW=$(date +%s)
22:     REMAINING=$((DEADLINE - NOW))
23: 
24:     if (( REMAINING > 0 )); then
25:         echo "Confirming rules and disarming rollback timer..."
26:         echo "  Time remaining: ${REMAINING} seconds"
27:         echo ""
28: 
29:         # Remove rollback flag
30:         rm -f "$ROLLBACK_FLAG"
31: 
32:         # Stop rollback timer
33:         if command -v systemctl &>/dev/null; then
34:             systemctl stop nftban-rollback.timer 2>/dev/null || true
35:         fi
36: 
37:         echo "✓ Rules confirmed successfully!"
38:         echo "✓ Rollback timer disarmed"
39:         echo "✓ Current rules are now permanent"
40:         echo ""
41:         echo "Your firewall rules are active and will persist across reboots."
42:     else
43:         echo "ERROR: Rollback deadline has passed!"
44:         echo "Rules may have already been rolled back."
45:         echo ""
46:         echo "Check current rules with: nft list ruleset"
47:         exit 1
48:     fi
49: else
50:     echo "Nothing to confirm."
51:     echo ""
52:     echo "No pending rollback timer found."
53:     echo "Either:"
54:     echo "  - Rules were already confirmed"
55:     echo "  - Rules were already rolled back"
56:     echo "  - No rules were applied with nftban-apply"
57:     echo ""
58:     echo "Current status: Rules are stable (no auto-rollback pending)"
59: fi
60: 
61: exit 0
</file>

<file path="cli/sbin/nftban-queue-processor">
 1: #!/usr/bin/env bash
 2: # =============================================================================
 3: # NFTBan Queue Processor (called by systemd timer)
 4: # =============================================================================
 5: # SPDX-License-Identifier: MPL-2.0
 6: # Purpose: Process tasks from NFTBan queue
 7: # Called by: nftban-queue.timer every 2 minutes
 8: # =============================================================================
 9: 
10: set -euo pipefail
11: 
12: # Set NFTBan library directory
13: readonly NFTBAN_LIB_DIR="${NFTBAN_LIB_DIR:-/usr/lib/nftban}"
14: 
15: # Source task queue helper
16: # shellcheck source=/dev/null
17: if [[ ! -f "${NFTBAN_LIB_DIR}/helpers/nftban_task_queue.sh" ]]; then
18:     echo "ERROR: Cannot find nftban_task_queue.sh at ${NFTBAN_LIB_DIR}/helpers/nftban_task_queue.sh" >&2
19:     exit 1
20: fi
21: source "${NFTBAN_LIB_DIR}/helpers/nftban_task_queue.sh"
22: 
23: # Log startup
24: _queue_log "INFO" "Queue processor started by systemd timer"
25: 
26: # Process one task (if available)
27: if nftban_queue_process_next; then
28:     _queue_log "INFO" "Task processed successfully"
29:     exit 0
30: else
31:     result=$?
32:     if [[ $result -eq 1 ]]; then
33:         # No tasks in queue (normal)
34:         exit 0
35:     elif [[ $result -eq 2 ]]; then
36:         # Already locked (another instance running)
37:         _queue_log "WARN" "Queue processor already running, skipping this cycle"
38:         exit 0
39:     else
40:         # Processing error
41:         _queue_log "ERROR" "Task processing failed"
42:         exit 1
43:     fi
44: fi
</file>

<file path="cli/sbin/nftban-rollback">
  1: #!/usr/bin/env bash
  2: # NFTBan Emergency Recovery - Rollback Rules
  3: # Copyright (c) 2024–2026 NFTBAN Project / Antonios Voulvoulis
  4: # SPDX-License-Identifier: MPL-2.0
  5: #
  6: # Rolls back to the last-known-good ruleset.
  7: # Can be called automatically by timer or manually for emergency recovery.
  8: 
  9: set -Eeuo pipefail
 10: 
 11: BACKUP="/var/lib/nftban/backup.rules"
 12: ROLLBACK_FLAG="/run/nftban.rollback.deadline"
 13: FORCE_MODE=false
 14: 
 15: # Check for force flag
 16: if [[ "${1:-}" == "--force" ]]; then
 17:     FORCE_MODE=true
 18: fi
 19: 
 20: # Banner (only in interactive mode)
 21: if [[ "$FORCE_MODE" == "false" ]]; then
 22:     echo "╔═══════════════════════════════════════════════════╗"
 23:     echo "║  NFTBan Emergency Recovery - Rollback Rules      ║"
 24:     echo "╚═══════════════════════════════════════════════════╝"
 25:     echo ""
 26: fi
 27: 
 28: # Check if we have a rollback deadline
 29: if [[ -f "$ROLLBACK_FLAG" ]]; then
 30:     DEADLINE=$(cat "$ROLLBACK_FLAG")
 31:     NOW=$(date +%s)
 32: 
 33:     # Check if we've reached the deadline (or force mode)
 34:     if (( NOW >= DEADLINE )) || [[ "$FORCE_MODE" == "true" ]]; then
 35: 
 36:         if [[ "$FORCE_MODE" == "true" ]]; then
 37:             echo "FORCED ROLLBACK requested..."
 38:         else
 39:             echo "Rollback deadline reached (not confirmed in time)..."
 40:         fi
 41:         echo ""
 42: 
 43:         # Check if we have a backup
 44:         if [[ ! -s "$BACKUP" ]]; then
 45:             echo "ERROR: No backup ruleset found at $BACKUP"
 46:             echo "Cannot rollback without backup!"
 47:             echo ""
 48:             echo "Emergency options:"
 49:             echo "  1. Flush all rules: nft flush ruleset"
 50:             echo "  2. Load baseline: nft -f /etc/nftban/baseline.nft"
 51:             echo "  3. Console/IPMI access to fix manually"
 52:             exit 1
 53:         fi
 54: 
 55:         echo "Rolling back to last-known-good ruleset..."
 56: 
 57:         # Apply backup ruleset
 58:         if nft -f "$BACKUP"; then
 59:             echo "  ✓ Backup ruleset applied successfully"
 60:         else
 61:             echo "  ✗ ERROR: Failed to apply backup ruleset!"
 62:             echo ""
 63:             echo "Emergency: Flushing all rules for safety..."
 64:             nft flush ruleset || true
 65:             exit 2
 66:         fi
 67: 
 68:         # Remove rollback flag
 69:         rm -f "$ROLLBACK_FLAG"
 70: 
 71:         # Stop rollback timer
 72:         if command -v systemctl &>/dev/null; then
 73:             systemctl stop nftban-rollback.timer 2>/dev/null || true
 74:         fi
 75: 
 76:         echo "  ✓ Rollback flag cleared"
 77:         echo ""
 78:         echo "════════════════════════════════════════════════════"
 79:         echo "✓ ROLLBACK COMPLETE"
 80:         echo "════════════════════════════════════════════════════"
 81:         echo ""
 82:         echo "Your firewall has been restored to the previous state."
 83:         echo "SSH access should be restored now."
 84:         echo ""
 85:         echo "Next steps:"
 86:         echo "  1. Verify connectivity: ssh user@server"
 87:         echo "  2. Review candidate rules: cat /etc/nftban/compiled.nft"
 88:         echo "  3. Fix issues and re-apply: nftban-apply"
 89: 
 90:         exit 0
 91:     else
 92:         # Deadline not yet reached
 93:         REMAINING=$((DEADLINE - NOW))
 94:         echo "Rollback not yet due."
 95:         echo "  Time remaining: ${REMAINING} seconds"
 96:         echo "  Deadline: $(date -d "@${DEADLINE}" 2>/dev/null || date -r "${DEADLINE}" 2>/dev/null || echo "unknown")"
 97:         echo ""
 98:         echo "To rollback immediately, use: sudo nftban-rollback --force"
 99:         exit 0
100:     fi
101: else
102:     # No rollback flag
103:     if [[ "$FORCE_MODE" == "true" ]]; then
104:         echo "FORCED ROLLBACK requested (no timer active)..."
105:         echo ""
106: 
107:         # Check if we have a backup
108:         if [[ ! -s "$BACKUP" ]]; then
109:             echo "ERROR: No backup ruleset found at $BACKUP"
110:             echo "Cannot rollback without backup!"
111:             exit 1
112:         fi
113: 
114:         echo "Rolling back to last-known-good ruleset..."
115: 
116:         # Apply backup ruleset
117:         if nft -f "$BACKUP"; then
118:             echo "  ✓ Backup ruleset applied successfully"
119:             echo ""
120:             echo "Rollback complete. Previous rules restored."
121:         else
122:             echo "  ✗ ERROR: Failed to apply backup ruleset!"
123:             exit 2
124:         fi
125: 
126:         exit 0
127:     else
128:         # Normal check, no rollback pending
129:         # Silent exit for timer-based checks
130:         exit 0
131:     fi
132: fi
</file>

<file path="cli/cmd_ui.sh">
  1: #!/usr/bin/env bash
  2: # NFTBan v1.0.0
  3: # Web GUI Management Commands
  4: # Author: Antonios Voulvoulis (itcmsgr)
  5: # License: MPL-2.0
  6: # SPDX-License-Identifier: MPL-2.0
  7: # meta:version=1.0.0
  8: # meta:homepage=https://github.com/itcmsgr/nftban
  9: 
 10: set -Eeuo pipefail
 11: 
 12: # Configuration
 13: NFTBAN_UI_SERVICE="nftban-ui.service"
 14: NFTBAN_UI_CONFIG="/etc/nftban/ui.conf"
 15: NFTBAN_UI_WHITELIST="/etc/nftban/ui-whitelist.conf"
 16: NFTBAN_UI_CERT="/etc/nftban/ssl/cert.pem"
 17: NFTBAN_UI_KEY="/etc/nftban/ssl/key.pem"
 18: NFTBAN_UI_PORT="${NFTBAN_UI_PORT:-3940}"
 19: 
 20: # cmd_ui_init - Initialize Web GUI
 21: # Creates configuration, generates TLS certificates, sets up IP whitelist
 22: cmd_ui_init() {
 23:     echo "╔════════════════════════════════════════════════════════════════════╗"
 24:     echo "║            NFTBan Web GUI Initialization                           ║"
 25:     echo "╚════════════════════════════════════════════════════════════════════╝"
 26:     echo ""
 27: 
 28:     # Check if running as root
 29:     if [[ $EUID -ne 0 ]]; then
 30:         echo "❌ Error: This command must be run as root"
 31:         exit 1
 32:     fi
 33: 
 34:     # Create directories
 35:     echo "📁 Creating directories..."
 36:     mkdir -p /etc/nftban/ssl
 37:     mkdir -p /var/log/nftban
 38:     chmod 750 /etc/nftban/ssl
 39: 
 40:     # Generate self-signed TLS certificate if not exists
 41:     if [[ ! -f "$NFTBAN_UI_CERT" ]] || [[ ! -f "$NFTBAN_UI_KEY" ]]; then
 42:         echo "🔐 Generating self-signed TLS certificate..."
 43: 
 44:         openssl req -x509 -nodes -newkey rsa:4096 \
 45:             -keyout "$NFTBAN_UI_KEY" \
 46:             -out "$NFTBAN_UI_CERT" \
 47:             -days 3650 \
 48:             -subj "/C=US/ST=State/L=City/O=NFTBan/CN=$(hostname)" \
 49:             2>/dev/null || {
 50:             echo "❌ Error: Failed to generate TLS certificate"
 51:             exit 1
 52:         }
 53: 
 54:         chmod 600 "$NFTBAN_UI_KEY"
 55:         chmod 644 "$NFTBAN_UI_CERT"
 56:         echo "✅ TLS certificate generated"
 57:     else
 58:         echo "ℹ️  TLS certificate already exists"
 59:     fi
 60: 
 61:     # Generate JWT secret
 62:     JWT_SECRET=$(openssl rand -base64 32)
 63: 
 64:     # Create configuration file
 65:     if [[ ! -f "$NFTBAN_UI_CONFIG" ]]; then
 66:         echo "📝 Creating configuration file..."
 67: 
 68:         cat > "$NFTBAN_UI_CONFIG" << EOF
 69: # NFTBan Web GUI Configuration
 70: # Generated: $(date '+%Y-%m-%d %H:%M:%S')
 71: 
 72: # Server Settings
 73: PORT=$NFTBAN_UI_PORT
 74: TLS_CERT=$NFTBAN_UI_CERT
 75: TLS_KEY=$NFTBAN_UI_KEY
 76: 
 77: # Security Settings
 78: JWT_SECRET=$JWT_SECRET
 79: SESSION_TIMEOUT=60
 80: BLOCK_ROOT_LOGIN=true
 81: 
 82: # Authentication
 83: # Web GUI requires nftban-cli group (same as CLI access)
 84: REQUIRED_GROUP=nftban-cli
 85: 
 86: # Access Control
 87: IP_WHITELIST_FILE=$NFTBAN_UI_WHITELIST
 88: 
 89: # Audit Logging
 90: AUDIT_LOG_FILE=/var/log/nftban/ui-access.log
 91: 
 92: # Rate Limiting
 93: MAX_LOGIN_ATTEMPTS=5
 94: LOCKOUT_DURATION=15
 95: 
 96: # Resource Limits (from safety package pattern)
 97: NFTBAN_GOMAXPROCS=2
 98: NFTBAN_MAX_CONCURRENT_CONNS=100
 99: NFTBAN_REQUEST_TIMEOUT_SEC=30
100: NFTBAN_MAX_REQUEST_BODY_MB=10
101: EOF
102: 
103:         chmod 640 "$NFTBAN_UI_CONFIG"
104:         echo "✅ Configuration created at $NFTBAN_UI_CONFIG"
105:     else
106:         echo "ℹ️  Configuration already exists"
107:     fi
108: 
109:     # Verify nftban group exists (created by install.sh)
110:     if ! getent group nftban >/dev/null 2>&1; then
111:         echo "❌ nftban group not found. Run install.sh first."
112:         return 1
113:     else
114:         echo "✅ nftban group exists"
115:     fi
116: 
117:     # Initialize IP whitelist
118:     cmd_ui_init_whitelist
119: 
120:     echo ""
121:     echo "✅ Web GUI initialization complete!"
122:     echo ""
123:     echo "📋 Next steps:"
124:     echo "   1. Add users to nftban group: sudo usermod -aG nftban <username>"
125:     echo "   2. Start the GUI server: nftban ui start"
126:     echo "   3. Access GUI at: https://$(hostname -I | awk '{print $1}'):$NFTBAN_UI_PORT"
127:     echo ""
128: }
129: 
130: # cmd_ui_init_whitelist - Initialize IP whitelist with current SSH client IP
131: cmd_ui_init_whitelist() {
132:     echo "🔒 Initializing IP whitelist..."
133: 
134:     # Get current SSH client IP
135:     local current_ip=""
136:     if [[ -n "${SSH_CLIENT:-}" ]]; then
137:         current_ip=$(echo "$SSH_CLIENT" | awk '{print $1}')
138:     elif [[ -n "${SSH_CONNECTION:-}" ]]; then
139:         current_ip=$(echo "$SSH_CONNECTION" | awk '{print $1}')
140:     fi
141: 
142:     # Create whitelist file
143:     if [[ ! -f "$NFTBAN_UI_WHITELIST" ]]; then
144:         cat > "$NFTBAN_UI_WHITELIST" << EOF
145: # NFTBan Web GUI IP Whitelist
146: # Only IPs listed here can access the web interface
147: # Format: One IP or CIDR per line
148: # Example: 192.168.1.100
149: # Example: 10.0.0.0/8
150: 
151: # Localhost
152: 127.0.0.1
153: ::1
154: 
155: EOF
156: 
157:         # Add current SSH client IP if detected
158:         if [[ -n "$current_ip" ]]; then
159:             echo "# Current SSH client IP (auto-detected)" >> "$NFTBAN_UI_WHITELIST"
160:             echo "$current_ip" >> "$NFTBAN_UI_WHITELIST"
161:             echo "✅ Added current SSH client IP to whitelist: $current_ip"
162:         fi
163: 
164:         chmod 640 "$NFTBAN_UI_WHITELIST"
165:         echo "✅ Whitelist created at $NFTBAN_UI_WHITELIST"
166:     else
167:         echo "ℹ️  Whitelist already exists"
168:     fi
169: }
170: 
171: # cmd_ui_add_ip - Add IP to GUI whitelist
172: cmd_ui_add_ip() {
173:     local ip="${1:-}"
174: 
175:     if [[ -z "$ip" ]]; then
176:         echo "❌ Error: IP address required"
177:         echo "Usage: nftban ui add-ip <IP>"
178:         exit 1
179:     fi
180: 
181:     # Validate IP format
182:     if ! [[ "$ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+(/[0-9]+)?$ ]] && ! [[ "$ip" =~ ^([0-9a-fA-F]{0,4}:){1,7}[0-9a-fA-F]{0,4}(/[0-9]+)?$ ]]; then
183:         echo "❌ Error: Invalid IP address format: $ip"
184:         exit 1
185:     fi
186: 
187:     # Check if IP already exists
188:     if grep -qx "$ip" "$NFTBAN_UI_WHITELIST" 2>/dev/null; then
189:         echo "ℹ️  IP already whitelisted: $ip"
190:         return 0
191:     fi
192: 
193:     # Add IP to whitelist
194:     echo "$ip" >> "$NFTBAN_UI_WHITELIST"
195:     echo "✅ IP added to whitelist: $ip"
196: 
197:     # Reload service if running
198:     if systemctl is-active --quiet "$NFTBAN_UI_SERVICE"; then
199:         echo "🔄 Reloading web GUI service..."
200:         systemctl reload "$NFTBAN_UI_SERVICE" || {
201:             echo "⚠️  Warning: Failed to reload service (changes take effect on restart)"
202:         }
203:     fi
204: }
205: 
206: # cmd_ui_remove_ip - Remove IP from GUI whitelist
207: cmd_ui_remove_ip() {
208:     local ip="${1:-}"
209: 
210:     if [[ -z "$ip" ]]; then
211:         echo "❌ Error: IP address required"
212:         echo "Usage: nftban ui remove-ip <IP>"
213:         exit 1
214:     fi
215: 
216:     # Check if IP exists in whitelist
217:     if ! grep -qx "$ip" "$NFTBAN_UI_WHITELIST" 2>/dev/null; then
218:         echo "ℹ️  IP not found in whitelist: $ip"
219:         return 0
220:     fi
221: 
222:     # Remove IP from whitelist
223:     local temp_file
224:     temp_file=$(mktemp)
225:     grep -vx "$ip" "$NFTBAN_UI_WHITELIST" > "$temp_file" || true
226:     mv "$temp_file" "$NFTBAN_UI_WHITELIST"
227: 
228:     echo "✅ IP removed from whitelist: $ip"
229: 
230:     # Reload service if running
231:     if systemctl is-active --quiet "$NFTBAN_UI_SERVICE"; then
232:         echo "🔄 Reloading web GUI service..."
233:         systemctl reload "$NFTBAN_UI_SERVICE" || {
234:             echo "⚠️  Warning: Failed to reload service (changes take effect on restart)"
235:         }
236:     fi
237: }
238: 
239: # cmd_ui_list_ips - List whitelisted IPs
240: cmd_ui_list_ips() {
241:     echo "╔════════════════════════════════════════════════════════════════════╗"
242:     echo "║             NFTBan Web GUI IP Whitelist                            ║"
243:     echo "╚════════════════════════════════════════════════════════════════════╝"
244:     echo ""
245: 
246:     if [[ ! -f "$NFTBAN_UI_WHITELIST" ]]; then
247:         echo "❌ Whitelist file not found: $NFTBAN_UI_WHITELIST"
248:         echo "Run: nftban ui init"
249:         exit 1
250:     fi
251: 
252:     local count=0
253:     while IFS= read -r line; do
254:         # Skip empty lines and comments
255:         [[ -z "$line" ]] && continue
256:         [[ "$line" =~ ^[[:space:]]*# ]] && continue
257: 
258:         ((count++)) || true
259:         echo "  $count. $line"
260:     done < "$NFTBAN_UI_WHITELIST"
261: 
262:     if [[ $count -eq 0 ]]; then
263:         echo "  (empty)"
264:     fi
265: 
266:     echo ""
267: }
268: 
269: # cmd_ui_start - Start Web GUI service
270: cmd_ui_start() {
271:     echo "🚀 Starting NFTBan Web GUI..."
272: 
273:     if ! systemctl is-enabled --quiet "$NFTBAN_UI_SERVICE" 2>/dev/null; then
274:         echo "📌 Enabling service..."
275:         systemctl enable "$NFTBAN_UI_SERVICE" || {
276:             echo "❌ Error: Failed to enable service"
277:             exit 1
278:         }
279:     fi
280: 
281:     systemctl start "$NFTBAN_UI_SERVICE" || {
282:         echo "❌ Error: Failed to start service"
283:         echo "Check logs: journalctl -xeu $NFTBAN_UI_SERVICE"
284:         exit 1
285:     }
286: 
287:     sleep 2
288: 
289:     if systemctl is-active --quiet "$NFTBAN_UI_SERVICE"; then
290:         echo "✅ Web GUI started successfully"
291:         cmd_ui_status
292:     else
293:         echo "❌ Service failed to start"
294:         echo "Check logs: journalctl -xeu $NFTBAN_UI_SERVICE"
295:         exit 1
296:     fi
297: }
298: 
299: # cmd_ui_stop - Stop Web GUI service
300: cmd_ui_stop() {
301:     echo "🛑 Stopping NFTBan Web GUI..."
302: 
303:     systemctl stop "$NFTBAN_UI_SERVICE" || {
304:         echo "❌ Error: Failed to stop service"
305:         exit 1
306:     }
307: 
308:     echo "✅ Web GUI stopped"
309: }
310: 
311: # cmd_ui_restart - Restart Web GUI service
312: cmd_ui_restart() {
313:     echo "🔄 Restarting NFTBan Web GUI..."
314: 
315:     systemctl restart "$NFTBAN_UI_SERVICE" || {
316:         echo "❌ Error: Failed to restart service"
317:         echo "Check logs: journalctl -xeu $NFTBAN_UI_SERVICE"
318:         exit 1
319:     }
320: 
321:     sleep 2
322: 
323:     if systemctl is-active --quiet "$NFTBAN_UI_SERVICE"; then
324:         echo "✅ Web GUI restarted successfully"
325:         cmd_ui_status
326:     else
327:         echo "❌ Service failed to restart"
328:         exit 1
329:     fi
330: }
331: 
332: # cmd_ui_status - Show Web GUI service status
333: cmd_ui_status() {
334:     echo "╔════════════════════════════════════════════════════════════════════╗"
335:     echo "║             NFTBan Web GUI Status                                  ║"
336:     echo "╚════════════════════════════════════════════════════════════════════╝"
337:     echo ""
338: 
339:     # Service status
340:     if systemctl is-active --quiet "$NFTBAN_UI_SERVICE"; then
341:         echo "Service Status:  ✅ Running"
342:     else
343:         echo "Service Status:  ❌ Stopped"
344:     fi
345: 
346:     # Enabled status
347:     if systemctl is-enabled --quiet "$NFTBAN_UI_SERVICE" 2>/dev/null; then
348:         echo "Auto-start:      ✅ Enabled"
349:     else
350:         echo "Auto-start:      ❌ Disabled"
351:     fi
352: 
353:     # Configuration
354:     if [[ -f "$NFTBAN_UI_CONFIG" ]]; then
355:         local port
356:         port=$(grep -E "^PORT=" "$NFTBAN_UI_CONFIG" | cut -d= -f2 || echo "$NFTBAN_UI_PORT")
357:         echo "Port:            $port"
358:     else
359:         echo "Port:            $NFTBAN_UI_PORT (default)"
360:     fi
361: 
362:     # Server IP
363:     local server_ip
364:     server_ip=$(hostname -I | awk '{print $1}')
365:     echo "Server IP:       $server_ip"
366:     echo "Access URL:      https://$server_ip:${port:-$NFTBAN_UI_PORT}"
367: 
368:     # Whitelist count
369:     if [[ -f "$NFTBAN_UI_WHITELIST" ]]; then
370:         local whitelist_count
371:         whitelist_count=$(grep -cvE "^[[:space:]]*(#|$)" "$NFTBAN_UI_WHITELIST" || echo "0")
372:         echo "Whitelisted IPs: $whitelist_count"
373:     fi
374: 
375:     # Recent logs
376:     echo ""
377:     echo "Recent Logs:"
378:     echo "────────────────────────────────────────────────────────────────────"
379:     journalctl -u "$NFTBAN_UI_SERVICE" -n 5 --no-pager 2>/dev/null || echo "  (no logs available)"
380:     echo ""
381: }
382: 
383: # cmd_ui_test - Test Web GUI connectivity
384: cmd_ui_test() {
385:     echo "╔════════════════════════════════════════════════════════════════════╗"
386:     echo "║             NFTBan Web GUI Connection Test                         ║"
387:     echo "╚════════════════════════════════════════════════════════════════════╝"
388:     echo ""
389: 
390:     # Get configuration
391:     local port
392:     port=$(grep -E "^PORT=" "$NFTBAN_UI_CONFIG" 2>/dev/null | cut -d= -f2 || echo "$NFTBAN_UI_PORT")
393: 
394:     local server_ip
395:     server_ip=$(hostname -I | awk '{print $1}')
396: 
397:     local url="https://$server_ip:$port"
398: 
399:     echo "Testing connection to: $url"
400:     echo ""
401: 
402:     # Test 1: Service running
403:     echo "1. Checking service status..."
404:     if systemctl is-active --quiet "$NFTBAN_UI_SERVICE"; then
405:         echo "   ✅ Service is running"
406:     else
407:         echo "   ❌ Service is not running"
408:         echo "   Run: nftban ui start"
409:         return 1
410:     fi
411: 
412:     # Test 2: Port listening
413:     echo "2. Checking port $port..."
414:     if ss -tlnp | grep -q ":$port " 2>/dev/null; then
415:         echo "   ✅ Port $port is listening"
416:     else
417:         echo "   ❌ Port $port is not listening"
418:         return 1
419:     fi
420: 
421:     # Test 3: TLS certificate
422:     echo "3. Checking TLS certificate..."
423:     if [[ -f "$NFTBAN_UI_CERT" ]] && [[ -f "$NFTBAN_UI_KEY" ]]; then
424:         echo "   ✅ TLS certificate exists"
425:     else
426:         echo "   ❌ TLS certificate missing"
427:         echo "   Run: nftban ui init"
428:         return 1
429:     fi
430: 
431:     # Test 4: HTTP connectivity
432:     echo "4. Testing HTTPS connection..."
433:     if curl -k -s -o /dev/null -w "%{http_code}" "https://127.0.0.1:$port" --max-time 5 >/dev/null 2>&1; then
434:         echo "   ✅ HTTPS server responding"
435:     else
436:         echo "   ⚠️  HTTPS server not responding (may be IP whitelist blocked)"
437:     fi
438: 
439:     echo ""
440:     echo "✅ Connection test complete"
441:     echo ""
442:     echo "📋 Access Information:"
443:     echo "   URL:  $url"
444:     echo "   Note: You must add your IP to whitelist: nftban ui add-ip <your_ip>"
445:     echo ""
446: }
447: 
448: # Main command router
449: cmd_ui() {
450:     local subcommand="${1:-}"
451: 
452:     case "$subcommand" in
453:         init)
454:             shift
455:             cmd_ui_init "$@"
456:             ;;
457:         start)
458:             shift
459:             cmd_ui_start "$@"
460:             ;;
461:         stop)
462:             shift
463:             cmd_ui_stop "$@"
464:             ;;
465:         restart)
466:             shift
467:             cmd_ui_restart "$@"
468:             ;;
469:         status)
470:             shift
471:             cmd_ui_status "$@"
472:             ;;
473:         init-whitelist)
474:             shift
475:             cmd_ui_init_whitelist "$@"
476:             ;;
477:         add-ip)
478:             shift
479:             cmd_ui_add_ip "$@"
480:             ;;
481:         remove-ip)
482:             shift
483:             cmd_ui_remove_ip "$@"
484:             ;;
485:         list-ips)
486:             shift
487:             cmd_ui_list_ips "$@"
488:             ;;
489:         test)
490:             shift
491:             cmd_ui_test "$@"
492:             ;;
493:         "")
494:             echo "Usage: nftban ui <command> [options]"
495:             echo ""
496:             echo "Commands:"
497:             echo "  init               Initialize Web GUI (config, certs, whitelist)"
498:             echo "  start              Start Web GUI service"
499:             echo "  stop               Stop Web GUI service"
500:             echo "  restart            Restart Web GUI service"
501:             echo "  status             Show Web GUI status"
502:             echo "  init-whitelist     Initialize IP whitelist"
503:             echo "  add-ip <IP>        Add IP to whitelist"
504:             echo "  remove-ip <IP>     Remove IP from whitelist"
505:             echo "  list-ips           List whitelisted IPs"
506:             echo "  test               Test Web GUI connectivity"
507:             echo ""
508:             echo "Examples:"
509:             echo "  nftban ui init"
510:             echo "  nftban ui add-ip 192.168.1.100"
511:             echo "  nftban ui start"
512:             echo "  nftban ui status"
513:             echo ""
514:             ;;
515:         *)
516:             echo "Error: Unknown subcommand: $subcommand"
517:             echo "Run: nftban ui (without arguments) for usage"
518:             exit 1

package pages

import (
	"strconv"
	"github.com/itcmsgr/nftban/internal/ui"
)

// Inventory renders the inventory page
templ Inventory(data ui.InventoryData) {
	@ui.LayoutWithNav("Inventory", "inventory") {
		<div class="page-header">
			<h1 class="page-title">System Inventory</h1>
			<button class="btn btn-primary" hx-get="/ui/frag/inventory" hx-target="#inventory-content" hx-swap="innerHTML">
				Refresh
			</button>
		</div>

		<div id="inventory-content">
			@InventoryContent(data)
		</div>
	}
}

// InventoryContent renders the inventory sections
templ InventoryContent(data ui.InventoryData) {
	<!-- Services Section -->
	<div class="card" style="margin-bottom: 1.5rem;">
		<div class="card-header">
			<span class="card-title">Services</span>
		</div>
		<table class="data-table">
			<thead>
				<tr>
					<th>Service</th>
					<th>Description</th>
					<th>Status</th>
					<th>PID</th>
					<th>Memory</th>
					<th>Uptime</th>
				</tr>
			</thead>
			<tbody>
				for _, svc := range data.Services {
					<tr>
						<td style="font-weight: 500;">{ svc.Name }</td>
						<td style="color: var(--text-muted); font-size: 0.85rem;">{ svc.Description }</td>
						<td>
							if svc.Status == "active" {
								<span class="badge badge-success">Active</span>
							} else if svc.Status == "failed" {
								<span class="badge badge-danger">Failed</span>
							} else {
								<span class="badge badge-muted">Inactive</span>
							}
						</td>
						<td style="font-family: monospace;">
							if svc.PID > 0 {
								{ intToStr(svc.PID) }
							} else {
								<span style="color: var(--text-muted);">-</span>
							}
						</td>
						<td>
							if svc.MemoryMB > 0 {
								{ floatToStr(svc.MemoryMB) } MB
							} else {
								<span style="color: var(--text-muted);">-</span>
							}
						</td>
						<td style="color: var(--text-muted); font-size: 0.85rem;">{ svc.Uptime }</td>
					</tr>
				}
				if len(data.Services) == 0 {
					<tr>
						<td colspan="6" style="text-align: center; color: var(--text-muted);">
							No services found
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>

	<!-- Timers Section -->
	<div class="card" style="margin-bottom: 1.5rem;">
		<div class="card-header">
			<span class="card-title">Timers</span>
		</div>
		<table class="data-table">
			<thead>
				<tr>
					<th>Timer</th>
					<th>Description</th>
					<th>Status</th>
					<th>Next Run</th>
					<th>Last Run</th>
				</tr>
			</thead>
			<tbody>
				for _, timer := range data.Timers {
					<tr>
						<td style="font-weight: 500;">{ timer.Name }</td>
						<td style="color: var(--text-muted); font-size: 0.85rem;">{ timer.Description }</td>
						<td>
							if timer.Status == "active" {
								<span class="badge badge-success">Active</span>
							} else if timer.Status == "enabled" {
								<span class="badge badge-info">Enabled</span>
							} else {
								<span class="badge badge-muted">Inactive</span>
							}
						</td>
						<td style="font-size: 0.85rem;">{ timer.NextRun }</td>
						<td style="color: var(--text-muted); font-size: 0.85rem;">{ timer.LastRun }</td>
					</tr>
				}
				if len(data.Timers) == 0 {
					<tr>
						<td colspan="5" style="text-align: center; color: var(--text-muted);">
							No timers found
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>

	<!-- Binaries Section -->
	<div class="card" style="margin-bottom: 1.5rem;">
		<div class="card-header">
			<span class="card-title">Binaries</span>
		</div>
		<table class="data-table">
			<thead>
				<tr>
					<th>Binary</th>
					<th>Path</th>
					<th>Version</th>
					<th>Size</th>
				</tr>
			</thead>
			<tbody>
				for _, bin := range data.Binaries {
					<tr>
						<td style="font-weight: 500;">{ bin.Name }</td>
						<td style="font-family: monospace; font-size: 0.85rem; color: var(--text-muted);">{ bin.Path }</td>
						<td>{ bin.Version }</td>
						<td style="color: var(--text-muted);">{ bin.Size }</td>
					</tr>
				}
				if len(data.Binaries) == 0 {
					<tr>
						<td colspan="4" style="text-align: center; color: var(--text-muted);">
							No binaries found
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>

	<!-- Config Files Section -->
	<div class="card" style="margin-bottom: 1.5rem;">
		<div class="card-header">
			<span class="card-title">Configuration Files</span>
		</div>
		<table class="data-table">
			<thead>
				<tr>
					<th>File</th>
					<th>Path</th>
					<th>Modified</th>
					<th>Size</th>
				</tr>
			</thead>
			<tbody>
				for _, cfg := range data.Configs {
					<tr>
						<td style="font-weight: 500;">{ cfg.Name }</td>
						<td style="font-family: monospace; font-size: 0.85rem; color: var(--text-muted);">{ cfg.Path }</td>
						<td style="font-size: 0.85rem;">{ cfg.Modified }</td>
						<td style="color: var(--text-muted);">{ cfg.Size }</td>
					</tr>
				}
				if len(data.Configs) == 0 {
					<tr>
						<td colspan="4" style="text-align: center; color: var(--text-muted);">
							No configuration files found
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>

	<!-- FHS Compliance Section -->
	<div class="card">
		<div class="card-header">
			<span class="card-title">FHS Directories</span>
		</div>
		<table class="data-table">
			<thead>
				<tr>
					<th>Path</th>
					<th>Expected</th>
					<th>Actual</th>
					<th>Status</th>
				</tr>
			</thead>
			<tbody>
				for _, fhs := range data.FHS {
					<tr>
						<td style="font-family: monospace; font-size: 0.85rem;">{ fhs.Path }</td>
						<td style="font-family: monospace; font-size: 0.8rem; color: var(--text-muted);">{ fhs.Expected }</td>
						<td style="font-family: monospace; font-size: 0.8rem;">{ fhs.Actual }</td>
						<td>
							if fhs.Status == "ok" {
								<span class="badge badge-success">OK</span>
							} else if fhs.Status == "warning" {
								<span class="badge badge-warning">Warn</span>
							} else {
								<span class="badge badge-danger">Error</span>
							}
						</td>
					</tr>
				}
				if len(data.FHS) == 0 {
					<tr>
						<td colspan="4" style="text-align: center; color: var(--text-muted);">
							No FHS data available
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

// Helper functions
func floatToStr(f float64) string {
	return strconv.FormatFloat(f, 'f', 1, 64)
}

 180: nftban_stats_cmd_dashboard() {
 181:     # Show statistics dashboard
 182:     # Usage: nftban stats [dashboard] [--since DATE] [--until DATE] [--last PERIOD] [--json]
 183: 
 184:     local since=""
 185:     local until=""
 186:     local detailed=false
 187:     local json_mode=false
 188: 
 189:     # Parse options
 190:     while [[ $# -gt 0 ]]; do
 191:         case "$1" in
 192:             --json)
 193:                 json_mode=true
 194:                 shift
 195:                 ;;
 196:             --since)
 197:                 since="$2"
 198:                 shift 2
 199:                 ;;
 200:             --until)
 201:                 until="$2"
 202:                 shift 2
 203:                 ;;
 204:             --last)
 205:                 # Parse period: 24h, 7d, 30d
 206:                 local period="$2"
 207:                 case "$period" in
 208:                     *h)
 209:                         local hours="${period%h}"
 210:                         since="$(date -d "${hours} hours ago" +%Y-%m-%d)"
 211:                         ;;
 212:                     *d)
 213:                         local days="${period%d}"
 214:                         since="$(date -d "${days} days ago" +%Y-%m-%d)"
 215:                         ;;
 216:                     *)
 217:                         if [[ "$json_mode" == "true" ]] && declare -f json_output >/dev/null 2>&1; then
 218:                             json_output "false" '{}' "Invalid period format. Use: 24h, 7d, 30d, etc."
 219:                         else
 220:                             echo "ERROR: Invalid period format. Use: 24h, 7d, 30d, etc." >&2
 221:                         fi
 222:                         return 1
 223:                         ;;
 224:                 esac
 225:                 shift 2
 226:                 ;;
 227:             --detailed)
 228:                 detailed=true
 229:                 shift
 230:                 ;;
 231:             *)
 232:                 if [[ "$json_mode" == "true" ]] && declare -f json_output >/dev/null 2>&1; then
 233:                     json_output "false" '{}' "Unknown option: $1"
 234:                 else
 235:                     echo "ERROR: Unknown option: $1" >&2
 236:                 fi
 237:                 return 1
 238:                 ;;
 239:         esac
 240:     done
 241: 
 242:     # Set defaults if not specified
 243:     [[ -z "$since" ]] && since="$(date -d '24 hours ago' +%Y-%m-%d)"
 244:     [[ -z "$until" ]] && until="$(date +%Y-%m-%d)"
 245: 
 246:     # JSON output mode
 247:     if [[ "$json_mode" == "true" ]] && declare -f json_output >/dev/null 2>&1; then
 248:         # Get raw statistics data
 249:         local total_bans=0
 250:         local active_bans=0
 251:         local total_countries=0
 252: 
 253:         # Count total bans from log
 254:         if [[ -f "${NFTBAN_BAN_LOG:-/var/log/nftban/ban.log}" ]]; then
 255:             total_bans=$(grep -c "^" "${NFTBAN_BAN_LOG}" 2>/dev/null || echo "0")
 256:         fi
 257: 
 258:         # Count active bans from nftables - USE CENTRALIZED nftban_stats_count_breakdown()
 259:         # This ensures consistency across all commands (status, stats, GUI API)
 260:         local temp_v4=0 temp_v6=0 black_v4=0 black_v6=0 feed_v4=0 feed_v6=0
 261:         local whitelist_v4=0 whitelist_v6=0 geoban_v4=0 geoban_v6=0
 262: 
 263:         # Call centralized breakdown function (if available)
 264:         if declare -f nftban_stats_count_breakdown >/dev/null 2>&1; then
 265:             # Use centralized function
 266:             eval "$(nftban_stats_count_breakdown)"
 267:         else
 268:             # Fallback: inline counting for v0.7.3 architecture (ip/ip6 nftban tables)
 269:             # Note: New architecture uses single blacklist with timeout flag
 270:             # Cannot distinguish temp vs permanent without parsing timeout attribute
 271: 
 272:             # Blacklist (contains permanent + temporary with timeout)
 273:             if nft list set ${NFTBAN_TABLE_IPV4} blacklist_ipv4 &>/dev/null 2>&1; then
 274:                 black_v4=$(nft list set ${NFTBAN_TABLE_IPV4} blacklist_ipv4 2>/dev/null | { grep -oP '\d+\.\d+\.\d+\.\d+' || true; } | wc -l 2>/dev/null || echo "0")
 275:                 black_v4=${black_v4//[^0-9]/}
 276:                 black_v4=${black_v4:-0}
 277:             fi
 278:             if nft list set ${NFTBAN_TABLE_IPV6} blacklist_ipv6 &>/dev/null 2>&1; then
 279:                 black_v6=$(nft list set ${NFTBAN_TABLE_IPV6} blacklist_ipv6 2>/dev/null | { grep -oP '[0-9a-fA-F:]+::[0-9a-fA-F:]*|[0-9a-fA-F:]+:[0-9a-fA-F:]+' || true; } | wc -l 2>/dev/null || echo "0")
 280:                 black_v6=${black_v6//[^0-9]/}
 281:                 black_v6=${black_v6:-0}
 282:             fi
 283: 
 284:             # Whitelist
 285:             if nft list set ${NFTBAN_TABLE_IPV4} whitelist_ipv4 &>/dev/null 2>&1; then
 286:                 whitelist_v4=$(nft list set ${NFTBAN_TABLE_IPV4} whitelist_ipv4 2>/dev/null | { grep -oP '\d+\.\d+\.\d+\.\d+' || true; } | wc -l 2>/dev/null || echo "0")
 287:                 whitelist_v4=${whitelist_v4//[^0-9]/}
 288:                 whitelist_v4=${whitelist_v4:-0}
 289:             fi
 290:             if nft list set ${NFTBAN_TABLE_IPV6} whitelist_ipv6 &>/dev/null 2>&1; then
 291:                 whitelist_v6=$(nft list set ${NFTBAN_TABLE_IPV6} whitelist_ipv6 2>/dev/null | { grep -oP '[0-9a-fA-F:]+::[0-9a-fA-F:]*|[0-9a-fA-F:]+:[0-9a-fA-F:]+' || true; } | wc -l 2>/dev/null || echo "0")
 292:                 whitelist_v6=${whitelist_v6//[^0-9]/}
 293:                 whitelist_v6=${whitelist_v6:-0}
 294:             fi
 295: 
 296:             # Note: In v0.7.3, feeds/geoban are consolidated into blacklist by nftban-core
 297:             # Set to 0 as they're no longer separate sets
 298:             temp_v4=0
 299:             temp_v6=0
 300:             feed_v4=0
 301:             feed_v6=0
 302:             geoban_v4=0
 303:             geoban_v6=0
 304:         fi
 305: 
 306:         # Calculate totals
 307:         local total_temp=$((${temp_v4} + ${temp_v6}))
 308:         local total_black=$((${black_v4} + ${black_v6}))
 309:         local total_feed=$((${feed_v4} + ${feed_v6}))
 310:         local total_geoban=$((${geoban_v4} + ${geoban_v6}))
 311:         local total_whitelist=$((${whitelist_v4} + ${whitelist_v6}))
 312:         active_bans=$((${total_temp} + ${total_black} + ${total_feed} + ${total_geoban}))
 313: 
 314:         # Get top data
 315:         local top_ips="[]"
 316:         local top_countries="[]"
 317:         local top_jails="[]"
 318: 
 319:         if declare -f nftban_stats_top_ips >/dev/null 2>&1; then
 320:             top_ips=$(nftban_stats_top_ips 10 "$since" "$until" 2>/dev/null || echo "[]")
 321:         fi
 322: 
 323:         if declare -f nftban_stats_top_countries >/dev/null 2>&1; then
 324:             top_countries=$(nftban_stats_top_countries 10 "$since" "$until" 2>/dev/null || echo "[]")
 325:             total_countries=$(echo "$top_countries" | jq '. | length' 2>/dev/null || echo "0")
 326:         fi
 327: 
 328:         if declare -f nftban_stats_top_jails >/dev/null 2>&1; then
 329:             top_jails=$(nftban_stats_top_jails 10 "$since" "$until" 2>/dev/null || echo "[]")
 330:         fi
 331: 
 332:         # Get portscan statistics from nftban-actions.log
 333:         local portscan_blocked_24h=0
 334:         local portscan_blocked_total=0
 335:         local portscan_monitored_ports=0
 336:         local portscan_enabled="false"
 337: 
 338:         local actions_log="${NFTBAN_ACTIONS_LOG:-${NFTBAN_LOG_DIR:-/var/log/nftban}/nftban-actions.log}"
 339:         if [[ -f "$actions_log" ]]; then
 340:             # Count portscan bans in last 24 hours
 341:             local yesterday_ts
 342:             yesterday_ts=$(date -d '24 hours ago' +%s)
 343:             portscan_blocked_24h=$(jq -r --arg ts "$yesterday_ts" 'select(.source == "portscan" and .event == "ban") | select((.ts | fromdateiso8601) >= ($ts | tonumber))' "$actions_log" 2>/dev/null | jq -s '. | length' 2>/dev/null || echo "0")
 344: 
 345:             # Count total portscan bans
 346:             portscan_blocked_total=$(jq -r 'select(.source == "portscan" and .event == "ban")' "$actions_log" 2>/dev/null | jq -s '. | length' 2>/dev/null || echo "0")
 347:         fi
 348: 
 349:         # Get monitored ports count and enabled status from portscan config
 350:         local portscan_conf="${NFTBAN_CONFIG_DIR:-/etc/nftban}/conf.d/portscan/main.conf"
 351:         if [[ -f "$portscan_conf" ]]; then
 352:             # Check if enabled
 353:             local enabled_line
 354:             enabled_line=$(grep "^PORTSCAN_ENABLED=" "$portscan_conf" 2>/dev/null) || true
 355:             if [[ -n "$enabled_line" ]]; then
 356:                 local enabled_value
 357:                 enabled_value=$(echo "$enabled_line" | cut -d= -f2 | tr -d '"' | tr -d "'" | tr -d ' ') || true
 358:                 if [[ "$enabled_value" == "true" ]]; then
 359:                     portscan_enabled="true"
 360:                 fi
 361:             fi
 362: 
 363:             # Get monitored ports
 364:             local ports_line
 365:             ports_line=$(grep "^PORTSCAN_MONITOR_PORTS=" "$portscan_conf" 2>/dev/null) || true
 366:             if [[ -n "$ports_line" ]]; then
 367:                 # Extract value: PORTSCAN_MONITOR_PORTS="value"
 368:                 local ports_value
 369:                 ports_value=$(echo "$ports_line" | cut -d= -f2 | tr -d '"' | tr -d "'") || true
 370: 
 371:                 # Handle special values
 372:                 if [[ "$ports_value" == "closed" ]] || [[ "$ports_value" == "all" ]]; then
 373:                     portscan_monitored_ports=1
 374:                 elif [[ -n "$ports_value" ]]; then
 375:                     portscan_monitored_ports=$(echo "$ports_value" | grep -oE '[0-9]+' | wc -l) || portscan_monitored_ports=0
 376:                 fi
 377:             fi
 378:         fi
 379: 
 380:         # Get DDoS statistics from config and nftables counters
 381:         local ddos_enabled="false"
 382:         local ddos_packets_dropped=0
 383:         local ddos_bytes_dropped=0
 384:         local ddos_blocked_24h=0
 385:         local ddos_blocked_total=0
 386: 
 387:         local ddos_conf="${NFTBAN_CONFIG_DIR:-/etc/nftban}/conf.d/ddos/main.conf"
 388:         if [[ -f "$ddos_conf" ]]; then
 389:             # Check if enabled
 390:             local ddos_enabled_line
 391:             ddos_enabled_line=$(grep "^DDOS_ENABLED=" "$ddos_conf" 2>/dev/null) || true
 392:             if [[ -n "$ddos_enabled_line" ]]; then
 393:                 local ddos_enabled_value
 394:                 ddos_enabled_value=$(echo "$ddos_enabled_line" | cut -d= -f2 | tr -d '"' | tr -d "'" | tr -d ' ') || true
 395:                 if [[ "$ddos_enabled_value" == "true" ]]; then
 396:                     ddos_enabled="true"
 397:                 fi
 398:             fi
 399:         fi
 400: 
 401:         # Get DDoS counters from nftables if available
 402:         if [[ "$ddos_enabled" == "true" ]]; then
 403:             # Try to get counters from ddos chain
 404:             local ddos_counter_output
 405:             ddos_counter_output=$(nft list chain inet nftban ddos_protection 2>/dev/null || nft list chain ip nftban ddos_protection 2>/dev/null || true)
 406:             if [[ -n "$ddos_counter_output" ]]; then
 407:                 # Extract packets and bytes from counter output
 408:                 ddos_packets_dropped=$(echo "$ddos_counter_output" | grep -oP 'packets \K[0-9]+' | head -1 || echo "0")
 409:                 ddos_bytes_dropped=$(echo "$ddos_counter_output" | grep -oP 'bytes \K[0-9]+' | head -1 || echo "0")
 410:             fi
 411: 
 412:             # Get DDoS bans from actions log
 413:             if [[ -f "$actions_log" ]]; then
 414:                 ddos_blocked_24h=$(jq -r --arg ts "$yesterday_ts" 'select(.source == "ddos" and .event == "ban") | select((.ts | fromdateiso8601) >= ($ts | tonumber))' "$actions_log" 2>/dev/null | jq -s '. | length' 2>/dev/null || echo "0")
 415:                 ddos_blocked_total=$(jq -r 'select(.source == "ddos" and .event == "ban")' "$actions_log" 2>/dev/null | jq -s '. | length' 2>/dev/null || echo "0")
 416:             fi
 417:         fi
 418: 
 419:         # Build JSON response with detailed breakdown
 420:         local data
 421:         if command -v jq &>/dev/null; then
 422:             data=$(jq -n \
 423:                 --arg since "$since" \
 424:                 --arg until "$until" \
 425:                 --arg total_bans "$total_bans" \
 426:                 --arg active_bans "$active_bans" \
 427:                 --arg total_countries "$total_countries" \
 428:                 --arg temp_v4 "$temp_v4" \
 429:                 --arg temp_v6 "$temp_v6" \
 430:                 --arg black_v4 "$black_v4" \
 431:                 --arg black_v6 "$black_v6" \
 432:                 --arg feed_v4 "$feed_v4" \
 433:                 --arg feed_v6 "$feed_v6" \
 434:                 --arg geoban_v4 "$geoban_v4" \
 435:                 --arg geoban_v6 "$geoban_v6" \
 436:                 --arg whitelist_v4 "$whitelist_v4" \
 437:                 --arg whitelist_v6 "$whitelist_v6" \
 438:                 --arg total_temp "$total_temp" \
 439:                 --arg total_black "$total_black" \
 440:                 --arg total_feed "$total_feed" \
 441:                 --arg total_geoban "$total_geoban" \
 442:                 --arg total_whitelist "$total_whitelist" \
 443:                 --arg portscan_blocked_24h "$portscan_blocked_24h" \
 444:                 --arg portscan_blocked_total "$portscan_blocked_total" \
 445:                 --arg portscan_monitored_ports "$portscan_monitored_ports" \
 446:                 --arg portscan_enabled "$portscan_enabled" \
 447:                 --arg ddos_enabled "$ddos_enabled" \
 448:                 --arg ddos_packets_dropped "$ddos_packets_dropped" \
 449:                 --arg ddos_bytes_dropped "$ddos_bytes_dropped" \
 450:                 --arg ddos_blocked_24h "$ddos_blocked_24h" \
 451:                 --arg ddos_blocked_total "$ddos_blocked_total" \
 452:                 --argjson top_ips "$top_ips" \
 453:                 --argjson top_countries "$top_countries" \
 454:                 --argjson top_jails "$top_jails" \
 455:                 '{
 456:                     period: {since: $since, until: $until},
 457:                     summary: {
 458:                         total_bans: ($total_bans | tonumber),
 459:                         active_bans: ($active_bans | tonumber),
 460:                         total_countries: ($total_countries | tonumber)
 461:                     },
 462:                     breakdown: {
 463:                         temporary: {
 464:                             total: ($total_temp | tonumber),
 465:                             ipv4: ($temp_v4 | tonumber),
 466:                             ipv6: ($temp_v6 | tonumber)
 467:                         },
 468:                         blacklist: {
 469:                             total: ($total_black | tonumber),
 470:                             ipv4: ($black_v4 | tonumber),
 471:                             ipv6: ($black_v6 | tonumber)
 472:                         },
 473:                         feeds: {
 474:                             total: ($total_feed | tonumber),
 475:                             ipv4: ($feed_v4 | tonumber),
 476:                             ipv6: ($feed_v6 | tonumber)
 477:                         },
 478:                         geoban: {
 479:                             total: ($total_geoban | tonumber),
 480:                             ipv4: ($geoban_v4 | tonumber),
 481:                             ipv6: ($geoban_v6 | tonumber)
 482:                         },
 483:                         whitelist: {
 484:                             total: ($total_whitelist | tonumber),
 485:                             ipv4: ($whitelist_v4 | tonumber),
 486:                             ipv6: ($whitelist_v6 | tonumber)
 487:                         }
 488:                     },
 489:                     portscan: {
 490:                         monitored_ports: ($portscan_monitored_ports | tonumber),
 491:                         blocked_24h: ($portscan_blocked_24h | tonumber),
 492:                         blocked_total: ($portscan_blocked_total | tonumber),
 493:                         enabled: ($portscan_enabled == "true")
 494:                     },
 495:                     ddos: {
 496:                         packets_dropped: ($ddos_packets_dropped | tonumber),
 497:                         bytes_dropped: ($ddos_bytes_dropped | tonumber),
 498:                         blocked_24h: ($ddos_blocked_24h | tonumber),
 499:                         blocked_total: ($ddos_blocked_total | tonumber),
 500:                         enabled: ($ddos_enabled == "true")
 501:                     },
 502:                     top_ips: $top_ips,
 503:                     top_countries: $top_countries,
 504:                     top_jails: $top_jails
 505:                 }')
 506:         else
 507:             # Fallback without jq
 508:             local portscan_enabled_json="false"
 509:             [[ "$portscan_enabled" == "true" ]] && portscan_enabled_json="true"
 510:             local ddos_enabled_json="false"
 511:             [[ "$ddos_enabled" == "true" ]] && ddos_enabled_json="true"
 512:             data="{\"period\":{\"since\":\"$since\",\"until\":\"$until\"},\"summary\":{\"total_bans\":$total_bans,\"active_bans\":$active_bans,\"total_countries\":$total_countries},\"breakdown\":{\"temporary\":{\"total\":$total_temp,\"ipv4\":$temp_v4,\"ipv6\":$temp_v6},\"blacklist\":{\"total\":$total_black,\"ipv4\":$black_v4,\"ipv6\":$black_v6},\"feeds\":{\"total\":$total_feed,\"ipv4\":$feed_v4,\"ipv6\":$feed_v6},\"whitelist\":{\"total\":$total_whitelist,\"ipv4\":$whitelist_v4,\"ipv6\":$whitelist_v6}},\"portscan\":{\"monitored_ports\":$portscan_monitored_ports,\"blocked_24h\":$portscan_blocked_24h,\"blocked_total\":$portscan_blocked_total,\"enabled\":$portscan_enabled_json},\"ddos\":{\"packets_dropped\":$ddos_packets_dropped,\"bytes_dropped\":$ddos_bytes_dropped,\"blocked_24h\":$ddos_blocked_24h,\"blocked_total\":$ddos_blocked_total,\"enabled\":$ddos_enabled_json},\"top_ips\":$top_ips,\"top_countries\":$top_countries,\"top_jails\":$top_jails}"
 513:         fi
 514: 
 515:         json_output "true" "$data"
 516:         return 0
 517:     fi
 518: 
 519:     # Human-readable output mode
 520:     # Show unified banner with health indicator
 521:     set +e
 522:     if [[ ! $(type -t nftban_banner_unified) == "function" ]]; then
 523:         if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_output.sh" ]]; then
 524:             source "${NFTBAN_LIB_DIR}/core/nftban_output.sh" 2>/dev/null || true
 525:         fi
 526:     fi
 527:     if type -t nftban_banner_unified >/dev/null 2>&1; then
 528:         nftban_banner_unified "stats" 2>/dev/null || true
 529:     elif type -t nftban_banner >/dev/null 2>&1; then
 530:         nftban_banner 2>/dev/null || true
 531:         echo ""
 532:     fi
 533:     set -e
 534: 
 535:     # Generate dashboard
 536:     nftban_stats_generate_dashboard "$since" "$until"
 537: }

 664: output_json() {
 665:     # Output JSON format
 666:     echo "{"
 667:     echo "  \"version\": \"${NFTBAN_VERSION:-unknown}\","
 668:     echo "  \"timestamp\": \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\","
 669:     echo "  \"hostname\": \"$(hostname)\","
 670: 
 671:     # Firewall
 672:     local nft_active=false
 673:     systemctl is-active nftables.service >/dev/null 2>&1 && nft_active=true
 674: 
 675:     echo "  \"firewall\": {"
 676:     echo "    \"nftables_active\": $nft_active,"
 677: 
 678:     # PERFORMANCE FIX: Use 'nft list table' instead of 'nft list ruleset'
 679:     # Reason: With large feed sets (5000+ IPs), 'list ruleset' can take 30+ seconds
 680:     #         and consume 100% CPU + 850MB RAM just to serialize all IP addresses.
 681:     #         We only need rule count, not the full IP list.
 682:     # Impact: Reduces execution time from 30s to <1s, CPU from 100% to <5%
 683:     local rule_count=0
 684:     if command -v nft >/dev/null 2>&1; then
 685:         rule_count=$(nft list table ${NFTBAN_TABLE_IPV4} 2>/dev/null | grep -c "^[[:space:]]*rule" 2>/dev/null || true)
 686:         rule_count=${rule_count:-0}
 687:     fi
 688:     echo "    \"rule_count\": $rule_count,"
 689: 
 690:     # v0.7.3: Use unified blacklist_ipv4/ipv6 sets (all bans consolidated)
 691:     local ban_count=0
 692:     if command -v nftban_stats_count_active_bans >/dev/null 2>&1; then
 693:         # Use stats module function (correct for v0.7.3)
 694:         ban_count=$(nftban_stats_count_active_bans 2>/dev/null || echo 0)
 695:     elif nft list set ${NFTBAN_TABLE_IPV4} blacklist_ipv4 >/dev/null 2>&1; then
 696:         # Fallback: Count blacklist_ipv4 + blacklist_ipv6 manually
 697:         local black_v4 black_v6
 698:         black_v4=$(nft list set ${NFTBAN_TABLE_IPV4} blacklist_ipv4 2>/dev/null | { grep -oP '\d+\.\d+\.\d+\.\d+' || true; } | wc -l || echo 0)
 699:         black_v6=$(nft list set ${NFTBAN_TABLE_IPV6} blacklist_ipv6 2>/dev/null | { grep -oP '[0-9a-fA-F:]+::[0-9a-fA-F:]*|[0-9a-fA-F:]+:[0-9a-fA-F:]+' || true; } | wc -l || echo 0)
 700:         ban_count=$((black_v4 + black_v6))
 701:     fi
 702:     echo "    \"banned_ips\": $ban_count,"
 703: 
 704:     # Add GUI-required fields for dashboard
 705:     # whitelist_ips: Total whitelist count
 706:     local whitelist_count=0
 707:     if command -v nftban_stats_count_whitelist >/dev/null 2>&1; then
 708:         whitelist_count=$(nftban_stats_count_whitelist 2>/dev/null || echo 0)
 709:     fi
 710:     echo "    \"whitelist_ips\": $whitelist_count,"
 711: 
 712:     # feed_ips: Count of IPs from threat feeds (part of unified blacklist in v0.7.3)
 713:     # NOTE: In v0.7.3, feeds are loaded into unified blacklist, can't distinguish
 714:     # Return 0 or query feed config files for count
 715:     echo "    \"feed_ips\": 0,"
 716: 
 717:     # threats_blocked_24h: Bans in last 24 hours
 718:     local threats_24h=0
 719:     if command -v nftban_stats_count_bans >/dev/null 2>&1; then
 720:         local since
 721:         since=$(($(date +%s) - 86400))
 722:         threats_24h=$(nftban_stats_count_bans "$since" 2>/dev/null || echo 0)
 723:     fi
 724:     echo "    \"threats_blocked_24h\": $threats_24h"
 725:     echo "  },"
 726: 
 727:     # Master control
 728:     local master_enabled="true"
 729:     if [[ -f "${NFTBAN_CONFIG_DIR}/conf.d/services.conf.local" ]]; then
 730:         # shellcheck source=/dev/null
 731:         source "${NFTBAN_CONFIG_DIR}/conf.d/services.conf.local" 2>/dev/null || true
 732:         master_enabled="${NFTBAN_ENABLED:-true}"
 733:     fi
 734:     if grep -q 'nftban=disabled' /proc/cmdline 2>/dev/null; then
 735:         master_enabled="false"
 736:     fi
 737:     echo "  \"master_enabled\": $master_enabled,"
 738: 
 739:     # Services (detailed)
 740:     echo "  \"services\": {"
 741: 
 742:     # Helper to get service info as JSON
 743:     _json_service_info() {
 744:         local unit="$1"
 745:         local status="inactive" pid="" mem="" uptime=""
 746: 
 747:         if ! systemctl list-unit-files "$unit" --no-legend 2>/dev/null | grep -q "$unit"; then
 748:             echo "null"
 749:             return
 750:         fi
 751: 
 752:         if systemctl is-active "$unit" >/dev/null 2>&1; then
 753:             status="active"
 754:             pid=$(systemctl show "$unit" --property=MainPID --value 2>/dev/null || echo "")
 755:             # pid=0 means no main process, treat as null
 756:             if [[ -n "$pid" ]] && [[ "$pid" != "0" ]]; then
 757:                 mem=$(ps -o rss= -p "$pid" 2>/dev/null | awk '{printf "%.1f", $1/1024}' || echo "")
 758:                 local start_time
 759:                 start_time=$(ps -o lstart= -p "$pid" 2>/dev/null || echo "")
 760:                 if [[ -n "$start_time" ]]; then
 761:                     local start_epoch now_epoch
 762:                     start_epoch=$(date -d "$start_time" +%s 2>/dev/null || echo "0")
 763:                     now_epoch=$(date +%s)
 764:                     uptime=$((now_epoch - start_epoch))
 765:                 fi
 766:             else
 767:                 pid=""  # Reset 0 to empty so it becomes null
 768:             fi
 769:         elif systemctl is-enabled "$unit" >/dev/null 2>&1; then
 770:             status="enabled"
 771:         fi
 772: 
 773:         # Build JSON with proper null handling
 774:         local pid_json="${pid:-null}"
 775:         [[ -n "$pid" ]] && pid_json="$pid"
 776:         local mem_json="${mem:-null}"
 777:         [[ -n "$mem" ]] && mem_json="$mem"
 778:         local uptime_json="${uptime:-null}"
 779:         [[ -n "$uptime" ]] && uptime_json="$uptime"
 780: 
 781:         echo "{\"status\": \"$status\", \"pid\": $pid_json, \"memory_mb\": $mem_json, \"uptime_sec\": $uptime_json}"
 782:     }
 783: 
 784:     echo "    \"nftables\": $(_json_service_info nftables.service),"
 785:     echo "    \"suricata\": $(_json_service_info suricata.service),"
 786:     echo "    \"nftban_core\": $(_json_service_info "${NFTBAN_SERVICE_CORE:-nftban-core.service}"),"
 787:     echo "    \"nftban_api\": $(_json_service_info "${NFTBAN_SERVICE_UI:-nftban-ui.service}"),"
 788:     echo "    \"nftban_suricata\": $(_json_service_info "${NFTBAN_SERVICE_SURICATA:-nftban-suricata.service}"),"
 789:     echo "    \"login_monitor\": $(_json_service_info "${NFTBAN_SERVICE_LOGIN_MONITOR:-nftban-login-monitor.service}"),"
 790:     echo "    \"metrics_exporter\": $(_json_service_info "${NFTBAN_SERVICE_METRICS_EXPORTER:-nftban-metrics-exporter.service}")"
 791:     echo "  },"
 792: 
 793:     # Health
 794:     local health_exit=0
 795:     if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_health.sh" ]]; then
 796:         source "${NFTBAN_LIB_DIR}/core/nftban_health.sh"
 797:         nftban_health_check_all 0 >/dev/null 2>&1 || health_exit=$?
 798:     fi
 799: 
 800:     local health_status="unknown"
 801:     case $health_exit in
 802:         0) health_status="healthy" ;;
 803:         1) health_status="warnings" ;;
 804:         2) health_status="errors" ;;
 805:     esac
 806: 
 807:     echo "  \"health\": {"
 808:     echo "    \"status\": \"$health_status\","
 809:     echo "    \"exit_code\": $health_exit"
 810:     echo "  },"
 811: 
 812:     # System info for GUI
 813:     local uptime_sec
 814:     uptime_sec=$(awk '{print int($1)}' /proc/uptime 2>/dev/null || echo 0)
 815:     local kernel
 816:     kernel=$(uname -r 2>/dev/null || echo "unknown")
 817: 
 818:     echo "  \"system\": {"
 819:     echo "    \"kernel\": \"$kernel\","
 820:     echo "    \"uptime_sec\": $uptime_sec"
 821:     echo "  },"
 822: 
 823:     # Protection modules status
 824:     echo "  \"protection\": {"
 825: 
 826:     # Suricata
 827:     local suricata_enabled=false suricata_banning=false
 828:     systemctl is-active suricata.service >/dev/null 2>&1 && suricata_enabled=true
 829:     systemctl is-active nftban-suricata.service >/dev/null 2>&1 && suricata_banning=true
 830:     echo "    \"suricata\": {\"enabled\": $suricata_enabled, \"banning\": $suricata_banning},"
 831: 
 832:     # Login Monitor
 833:     local login_enabled=false
 834:     systemctl is-active nftban-login-monitor.service >/dev/null 2>&1 && login_enabled=true
 835:     echo "    \"login_monitor\": {\"enabled\": $login_enabled},"
 836: 
 837:     # GeoIP
 838:     local geoip_installed=false geoip_countries=0
 839:     if [[ -f "${NFTBAN_DATA_DIR}/geoip/GeoLite2-City.mmdb" ]]; then
 840:         geoip_installed=true
 841:         geoip_countries=$(nftban geoban list 2>/dev/null | grep -c "BLOCKED" 2>/dev/null || true)
 842:         geoip_countries="${geoip_countries:-0}"
 843:     fi
 844:     echo "    \"geoip\": {\"installed\": $geoip_installed, \"blocked_countries\": $geoip_countries},"
 845: 
 846:     # Feeds
 847:     local feeds_count=0
 848:     if [[ -d "${NFTBAN_DATA_DIR}/feeds" ]]; then
 849:         feeds_count=$(find "${NFTBAN_DATA_DIR}/feeds" -name "*.txt" -type f 2>/dev/null | wc -l || true)
 850:         feeds_count="${feeds_count:-0}"
 851:     fi
 852:     echo "    \"feeds\": {\"count\": $feeds_count}"
 853:     echo "  },"
 854: 
 855:     # Timers
 856:     echo "  \"timers\": {"
 857:     local timer_list=("nftban-health.timer" "nftban-feeds.timer" "nftban-geoip-update.timer" "nftban-maintenance.timer" "nftban-stats.timer" "nftban-metrics-exporter.timer")
 858:     local timer_json=""
 859:     for timer in "${timer_list[@]}"; do
 860:         local timer_name="${timer%.timer}"
 861:         timer_name="${timer_name#nftban-}"
 862:         local timer_active=false
 863:         systemctl is-active "$timer" >/dev/null 2>&1 && timer_active=true
 864:         [[ -n "$timer_json" ]] && timer_json+=","
 865:         timer_json+="\"$timer_name\": $timer_active"
 866:     done
 867:     echo "    $timer_json"
 868:     echo "  }"
 869: 
 870:     echo "}"
 871: 
 872: 
 873:     # Exit marker for testing validation
 874:     command -v nftban_cmd_exit >/dev/null 2>&1 && nftban_cmd_exit "status"
 875:     return 0
 876: }

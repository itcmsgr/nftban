<file path="cli/lib/nftban/core/nftban_config.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - Configuration Management
  4: # =============================================================================
  5: 
  6: # SPDX-License-Identifier: MPL-2.0
  7: # Purpose: Unified configuration file management with .conf.local override support
  8: #
  9: # meta:name=nftban_config
 10: # meta:type=core
 11: # meta:header=Configuration Management
 12: # meta:version=1.0.0
 13: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 14: # meta:homepage=https://nftban.com
 15: #
 16: # **Description & Purpose**
 17: # meta:description=Read and write configuration files with .conf.local override support
 18: # meta:input=Configuration module name (portscan, ddos, etc.)
 19: # meta:output=Merged configuration or write status
 20: #
 21: # **Inventory & Requirements**
 22: # meta:depends=nftban_file_ops.sh
 23: #
 24: # meta:created_date=2025-11-15
 25: # meta:updated_date=2025-11-24
 26: # =============================================================================
 27: 
 28: IFS=$'\n\t'
 29: umask 027
 30: 
 31: # =============================================================================
 32: # CONFIGURATION
 33: # =============================================================================
 34: 
 35: readonly NFTBAN_CONF_DIR="${NFTBAN_CONF_DIR:-/etc/nftban}"
 36: readonly NFTBAN_CONFD_DIR="${NFTBAN_CONFD_DIR:-/etc/nftban/conf.d}"
 37: readonly NFTBAN_LOCAL_CONF="${NFTBAN_CONF_DIR}/nftban.conf.local"
 38: 
 39: # =============================================================================
 40: # HELPER FUNCTIONS
 41: # =============================================================================
 42: 
 43: nftban_config_parse_file() {
 44:     # Parse a config file and extract KEY=VALUE pairs
 45:     # Args: $1 = file path
 46:     # Output: KEY=VALUE lines (one per line)
 47: 
 48:     local file="$1"
 49: 
 50:     [[ ! -f "$file" ]] && return 0
 51: 
 52:     # Extract lines that look like KEY="VALUE" or KEY=VALUE
 53:     # Skip comments and empty lines
 54:     grep -E '^[A-Z_]+=' "$file" 2>/dev/null || true
 55: }
 56: 
 57: nftban_config_get_value() {
 58:     # Get a specific config value from a file
 59:     # Args: $1 = file path, $2 = key name
 60:     # Output: value (without quotes)
 61: 
 62:     local file="$1"
 63:     local key="$2"
 64: 
 65:     [[ ! -f "$file" ]] && return 0
 66: 
 67:     local line
 68:     line=$(grep -E "^${key}=" "$file" 2>/dev/null | tail -n1 || true)
 69: 
 70:     if [[ -n "$line" ]]; then
 71:         # Extract value, remove quotes
 72:         local value="${line#*=}"
 73:         value="${value#\"}"
 74:         value="${value%\"}"
 75:         echo "$value"
 76:     fi
 77: }
 78: 
 79: # =============================================================================
 80: # MAIN FUNCTIONS
 81: # =============================================================================
 82: 
 83: nftban_config_get_defaults() {
 84:     # Get default configuration for a module
 85:     # Args: $1 = module name (portscan, ddos, etc.)
 86:     # Output: JSON object with all default config values
 87: 
 88:     local module="$1"
 89:     local conf_file=""
 90: 
 91:     # Check for config in subdirectory structure (e.g., conf.d/portscan/main.conf)
 92:     if [[ -f "${NFTBAN_CONFD_DIR}/${module}/main.conf" ]]; then
 93:         conf_file="${NFTBAN_CONFD_DIR}/${module}/main.conf"
 94:     # Fallback to flat file structure (e.g., conf.d/portscan.conf)
 95:     elif [[ -f "${NFTBAN_CONFD_DIR}/${module}.conf" ]]; then
 96:         conf_file="${NFTBAN_CONFD_DIR}/${module}.conf"
 97:     else
 98:         echo "{\"error\": \"Configuration file not found for module: ${module}\"}"
 99:         return 1
100:     fi
101: 
102:     # Parse config file and build JSON
103:     local json="{"
104:     local first=true
105: 
106:     while IFS='=' read -r key value; do
107:         [[ -z "$key" ]] && continue
108: 
109:         # Remove quotes from value
110:         value="${value#\"}"
111:         value="${value%\"}"
112: 
113:         # Escape JSON special characters
114:         value="${value//\\/\\\\}"
115:         value="${value//\"/\\\"}"
116: 
117:         if [[ "$first" == true ]]; then
118:             first=false
119:         else
120:             json+=","
121:         fi
122: 
123:         json+="\"${key}\": \"${value}\""
124:     done < <(nftban_config_parse_file "$conf_file")
125: 
126:     json+="}"
127:     echo "$json"
128: }
129: 
130: nftban_config_get_overrides() {
131:     # Get override configuration for a module from .conf.local
132:     # Args: $1 = module name (portscan, ddos, etc.)
133:     # Output: JSON object with override config values
134: 
135:     local module="$1"
136: 
137:     if [[ ! -f "$NFTBAN_LOCAL_CONF" ]]; then
138:         echo "{}"
139:         return 0
140:     fi
141: 
142:     # Find section for this module in .conf.local
143:     # Format: # --- MODULE_NAME Configuration ---
144:     local section_marker="# --- ${module^^} Configuration ---"
145:     local in_section=false
146:     local json="{"
147:     local first=true
148: 
149:     while IFS= read -r line; do
150:         # Check if we're entering the section
151:         if [[ "$line" == *"$section_marker"* ]]; then
152:             in_section=true
153:             continue
154:         fi
155: 
156:         # Check if we're leaving the section (next section marker or EOF)
157:         if [[ "$in_section" == true ]] && [[ "$line" == "# --- "* ]] && [[ "$line" != *"$section_marker"* ]]; then
158:             break
159:         fi
160: 
161:         # If in section, parse KEY=VALUE
162:         if [[ "$in_section" == true ]] && [[ "$line" =~ ^[A-Z_]+=.* ]]; then
163:             local key="${line%%=*}"
164:             local value="${line#*=}"
165: 
166:             # Remove quotes
167:             value="${value#\"}"
168:             value="${value%\"}"
169: 
170:             # Escape JSON special characters
171:             value="${value//\\/\\\\}"
172:             value="${value//\"/\\\"}"
173: 
174:             if [[ "$first" == true ]]; then
175:                 first=false
176:             else
177:                 json+=","
178:             fi
179: 
180:             json+="\"${key}\": \"${value}\""
181:         fi
182:     done < "$NFTBAN_LOCAL_CONF"
183: 
184:     json+="}"
185:     echo "$json"
186: }
187: 
188: nftban_config_get_merged() {
189:     # Get merged configuration (defaults + overrides)
190:     # Args: $1 = module name, $2 = --json flag (optional)
191:     # Output: JSON object with merged config
192: 
193:     local module="$1"
194:     local json_mode="${2:-false}"
195: 
196:     local defaults overrides
197:     defaults=$(nftban_config_get_defaults "$module")
198:     overrides=$(nftban_config_get_overrides "$module")
199: 
200:     # Merge JSON objects (overrides take precedence) - use -c for compact output
201:     local merged
202:     merged=$(jq -c -n --argjson defaults "$defaults" --argjson overrides "$overrides" \
203:         '$defaults + $overrides')
204: 
205:     if [[ "$json_mode" == "--json" ]]; then
206:         echo "{\"success\": true, \"data\": {\"defaults\": $defaults, \"overrides\": $overrides, \"merged\": $merged}}"
207:     else
208:         echo "$merged"
209:     fi
210: }
211: 
212: nftban_config_set() {
213:     # Set a configuration value in .conf.local
214:     # Args: $1 = module name, $2 = KEY=VALUE
215:     # Output: success/error message
216: 
217:     local module="$1"
218:     local key_value="$2"
219: 
220:     # Validate KEY=VALUE format
221:     if [[ ! "$key_value" =~ ^[A-Z_]+= ]]; then
222:         echo "ERROR: Invalid format. Use KEY=VALUE"
223:         return 1
224:     fi
225: 
226:     local key="${key_value%%=*}"
227:     local value="${key_value#*=}"
228: 
229:     # Ensure .conf.local exists
230:     if [[ ! -f "$NFTBAN_LOCAL_CONF" ]]; then
231:         echo "# NFTBan Local Configuration Overrides" > "$NFTBAN_LOCAL_CONF"
232:         echo "# Auto-generated by nftban config command" >> "$NFTBAN_LOCAL_CONF"
233:         echo "" >> "$NFTBAN_LOCAL_CONF"
234:         chmod 640 "$NFTBAN_LOCAL_CONF"
235:     fi
236: 
237:     local section_marker="# --- ${module^^} Configuration ---"
238:     local temp_file="${NFTBAN_LOCAL_CONF}.tmp"
239: 
240:     # Check if section exists
241:     if ! grep -q "$section_marker" "$NFTBAN_LOCAL_CONF" 2>/dev/null; then
242:         # Add new section at end
243:         {
244:             cat "$NFTBAN_LOCAL_CONF"
245:             echo ""
246:             echo "$section_marker"
247:             echo "${key}=\"${value}\""
248:             echo ""
249:         } > "$temp_file"
250:         mv "$temp_file" "$NFTBAN_LOCAL_CONF"
251:         echo "✓ Configuration saved: ${key}=${value}"
252:         return 0
253:     fi
254: 
255:     # Section exists, update or add key
256:     local in_section=false
257:     local key_found=false
258: 
259:     while IFS= read -r line; do
260:         # Entering section
261:         if [[ "$line" == *"$section_marker"* ]]; then
262:             in_section=true
263:             echo "$line"
264:             continue
265:         fi
266: 
267:         # Leaving section
268:         if [[ "$in_section" == true ]] && [[ "$line" == "# --- "* ]] && [[ "$line" != *"$section_marker"* ]]; then
269:             # If key wasn't found, add it before leaving section
270:             if [[ "$key_found" == false ]]; then
271:                 echo "${key}=\"${value}\""
272:             fi
273:             in_section=false
274:             echo "$line"
275:             continue
276:         fi
277: 
278:         # In section, check if this is our key
279:         if [[ "$in_section" == true ]] && [[ "$line" =~ ^${key}= ]]; then
280:             echo "${key}=\"${value}\""
281:             key_found=true
282:             continue
283:         fi
284: 
285:         echo "$line"
286:     done < "$NFTBAN_LOCAL_CONF" > "$temp_file"
287: 
288:     # If we reached EOF while in section and key not found, add it
289:     if [[ "$in_section" == true ]] && [[ "$key_found" == false ]]; then
290:         echo "${key}=\"${value}\""
291:         echo ""
292:     fi >> "$temp_file"
293: 
294:     mv "$temp_file" "$NFTBAN_LOCAL_CONF"
295:     echo "✓ Configuration saved: ${key}=${value}"
296: }
297: 
298: nftban_config_reset() {
299:     # Reset a configuration value (remove from .conf.local)
300:     # Args: $1 = module name, $2 = KEY
301:     # Output: success/error message
302: 
303:     local module="$1"
304:     local key="$2"
305: 
306:     if [[ ! -f "$NFTBAN_LOCAL_CONF" ]]; then
307:         echo "✓ No local overrides to reset"
308:         return 0
309:     fi
310: 
311:     local section_marker="# --- ${module^^} Configuration ---"
312:     local temp_file="${NFTBAN_LOCAL_CONF}.tmp"
313:     local in_section=false
314:     local key_found=false
315: 
316:     while IFS= read -r line; do
317:         # Entering section
318:         if [[ "$line" == *"$section_marker"* ]]; then
319:             in_section=true
320:             echo "$line"
321:             continue
322:         fi
323: 
324:         # Leaving section
325:         if [[ "$in_section" == true ]] && [[ "$line" == "# --- "* ]] && [[ "$line" != *"$section_marker"* ]]; then
326:             in_section=false
327:             echo "$line"
328:             continue
329:         fi
330: 
331:         # In section, skip our key
332:         if [[ "$in_section" == true ]] && [[ "$line" =~ ^${key}= ]]; then
333:             key_found=true
334:             continue
335:         fi
336: 
337:         echo "$line"
338:     done < "$NFTBAN_LOCAL_CONF" > "$temp_file"
339: 
340:     mv "$temp_file" "$NFTBAN_LOCAL_CONF"
341: 
342:     if [[ "$key_found" == true ]]; then
343:         echo "✓ Configuration reset: ${key} (using default value)"
344:     else
345:         echo "✓ Key not found in overrides: ${key}"
346:     fi
347: }
348: 
349: nftban_config_reset_all() {
350:     # Reset all configuration for a module (remove entire section from .conf.local)
351:     # Args: $1 = module name
352:     # Output: success/error message
353: 
354:     local module="$1"
355: 
356:     if [[ ! -f "$NFTBAN_LOCAL_CONF" ]]; then
357:         echo "✓ No local overrides to reset"
358:         return 0
359:     fi
360: 
361:     local section_marker="# --- ${module^^} Configuration ---"
362:     local temp_file="${NFTBAN_LOCAL_CONF}.tmp"
363:     local in_section=false
364: 
365:     while IFS= read -r line; do
366:         # Entering section - skip it
367:         if [[ "$line" == *"$section_marker"* ]]; then
368:             in_section=true
369:             continue
370:         fi
371: 
372:         # Leaving section
373:         if [[ "$in_section" == true ]] && [[ "$line" == "# --- "* ]] && [[ "$line" != *"$section_marker"* ]]; then
374:             in_section=false
375:             echo "$line"
376:             continue
377:         fi
378: 
379:         # Skip lines in section
380:         if [[ "$in_section" == true ]]; then
381:             continue
382:         fi
383: 
384:         echo "$line"
385:     done < "$NFTBAN_LOCAL_CONF" > "$temp_file"
386: 
387:     mv "$temp_file" "$NFTBAN_LOCAL_CONF"
388:     echo "✓ All ${module} configuration reset to defaults"
389: }
390: 
391: # =============================================================================
392: # SIMPLE CONFIG GET/SET (for global settings like GUI_MODE)
393: # =============================================================================
394: 
395: nftban_config_get() {
396:     # Get a global config value
397:     # Args: $1 = key name (e.g., NFTBAN_GUI_MODE)
398:     # Output: value (without quotes), or empty if not found
399: 
400:     local key="$1"
401:     local conf_file="${NFTBAN_CONF_DIR}/nftban.conf"
402: 
403:     # Check main config file
404:     if [[ -f "$conf_file" ]]; then
405:         nftban_config_get_value "$conf_file" "$key"
406:         return 0
407:     fi
408: 
409:     # Default: return empty (false)
410:     echo ""
411: }
412: 
413: nftban_config_set_global() {
414:     # Set a global config value in nftban.conf
415:     # Args: $1 = key name, $2 = value
416:     # Use nftban_config_set() for per-module config in .conf.local
417: 
418:     local key="$1"
419:     local value="$2"
420:     local conf_file="${NFTBAN_CONF_DIR}/nftban.conf"
421: 
422:     # Create config directory if needed
423:     mkdir -p "${NFTBAN_CONF_DIR}"
424: 
425:     # Create config file if it doesn't exist
426:     if [[ ! -f "$conf_file" ]]; then
427:         cat > "$conf_file" << 'EOF'
428: # NFTBan Global Configuration
429: # This file contains system-wide NFTBan settings
430: 
431: # GUI Mode: Enable Web GUI + Prometheus + Go binaries
432: # Values: true, false
433: # Default: false (CLI only, bash mode)
434: NFTBAN_GUI_MODE="false"
435: EOF
436:     fi
437: 
438:     # Update or add the key
439:     if grep -q "^${key}=" "$conf_file"; then
440:         # Key exists, update it
441:         sed -i "s|^${key}=.*|${key}=\"${value}\"|" "$conf_file"
442:     else
443:         # Key doesn't exist, append it
444:         echo "${key}=\"${value}\"" >> "$conf_file"
445:     fi
446: }
447: 
448: # =============================================================================
449: # EXPORTS
450: # =============================================================================
451: 
452: export -f nftban_config_get_defaults
453: export -f nftban_config_get_overrides
454: export -f nftban_config_get_merged
455: export -f nftban_config_set
456: export -f nftban_config_set_global
457: export -f nftban_config_reset
458: export -f nftban_config_reset_all
459: export -f nftban_config_get
</file>

<file path="cli/lib/nftban/core/nftban_emulate.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan Packet Emulation Module
  4: # =============================================================================
  5: # Simulates packet evaluation to show what nftban would do with an IP/port
  6: #
  7: # Usage:
  8: #   source nftban_emulate.sh
  9: #   nftban_emulate_packet "8.8.8.8" "tcp" "22" "in"
 10: #
 11: # Version: 1.0.0
 12: # =============================================================================
 13: 
 14: # Prevent double-sourcing
 15: [[ -n "${_NFTBAN_EMULATE_LOADED:-}" ]] && return 0
 16: _NFTBAN_EMULATE_LOADED=1
 17: 
 18: # Source dependencies
 19: NFTBAN_LIB_DIR="${NFTBAN_LIB_DIR:-/usr/lib/nftban}"
 20: [[ -f "${NFTBAN_LIB_DIR}/lib/common.sh" ]] && source "${NFTBAN_LIB_DIR}/lib/common.sh"
 21: 
 22: # =============================================================================
 23: # CIDR MATCHING FUNCTIONS
 24: # =============================================================================
 25: 
 26: # Convert IP to integer for comparison
 27: _ip_to_int() {
 28:     local ip="$1"
 29:     local a b c d
 30:     IFS='.' read -r a b c d <<< "$ip"
 31:     echo $(( (a << 24) + (b << 16) + (c << 8) + d ))
 32: }
 33: 
 34: # Convert integer to IP
 35: _int_to_ip() {
 36:     local int="$1"
 37:     echo "$(( (int >> 24) & 255 )).$(( (int >> 16) & 255 )).$(( (int >> 8) & 255 )).$(( int & 255 ))"
 38: }
 39: 
 40: # Check if IP is within CIDR range
 41: # Returns: 0 if in range, 1 if not
 42: _ip_in_cidr() {
 43:     local ip="$1"
 44:     local cidr="$2"
 45: 
 46:     # Handle single IP (no /)
 47:     if [[ "$cidr" != *"/"* ]]; then
 48:         [[ "$ip" == "$cidr" ]] && return 0
 49:         return 1
 50:     fi
 51: 
 52:     local network="${cidr%/*}"
 53:     local prefix="${cidr#*/}"
 54: 
 55:     local ip_int network_int mask
 56:     ip_int=$(_ip_to_int "$ip")
 57:     network_int=$(_ip_to_int "$network")
 58: 
 59:     # Calculate mask
 60:     if [[ "$prefix" -eq 0 ]]; then
 61:         mask=0
 62:     else
 63:         mask=$(( 0xFFFFFFFF << (32 - prefix) ))
 64:     fi
 65: 
 66:     # Check if IP is in network
 67:     [[ $(( ip_int & mask )) -eq $(( network_int & mask )) ]] && return 0
 68:     return 1
 69: }
 70: 
 71: # Expand IPv6 to full 32-character hex (no colons)
 72: # 2001:db8::1 -> 20010db8000000000000000000000001
 73: _ipv6_expand() {
 74:     local ip="$1"
 75:     local expanded=""
 76: 
 77:     # Handle :: expansion
 78:     if [[ "$ip" == *"::"* ]]; then
 79:         local left="${ip%%::*}"
 80:         local right="${ip#*::}"
 81: 
 82:         # Count existing groups (use prefix increment to avoid ((0)) returning false with set -e)
 83:         local left_groups=0 right_groups=0
 84:         if [[ -n "$left" ]]; then
 85:             left_groups=$(echo "$left" | tr -cd ':' | wc -c)
 86:             left_groups=$((left_groups + 1))
 87:         fi
 88:         if [[ -n "$right" ]]; then
 89:             right_groups=$(echo "$right" | tr -cd ':' | wc -c)
 90:             right_groups=$((right_groups + 1))
 91:         fi
 92: 
 93:         # Calculate missing groups
 94:         local missing
 95:         missing=$((8 - left_groups - right_groups))
 96: 
 97:         # Build zero groups
 98:         local zeros=""
 99:         for ((i=0; i<missing; i++)); do
100:             zeros="${zeros}0000"
101:         done
102: 
103:         # Expand left part
104:         if [[ -n "$left" ]]; then
105:             IFS=':' read -ra groups <<< "$left"
106:             for g in "${groups[@]}"; do
107:                 printf -v g "%04s" "$g"
108:                 expanded="${expanded}${g// /0}"
109:             done
110:         fi
111: 
112:         # Add zeros
113:         expanded="${expanded}${zeros}"
114: 
115:         # Expand right part
116:         if [[ -n "$right" ]]; then
117:             IFS=':' read -ra groups <<< "$right"
118:             for g in "${groups[@]}"; do
119:                 printf -v g "%04s" "$g"
120:                 expanded="${expanded}${g// /0}"
121:             done
122:         fi
123:     else
124:         # No ::, just expand each group
125:         IFS=':' read -ra groups <<< "$ip"
126:         for g in "${groups[@]}"; do
127:             printf -v g "%04s" "$g"
128:             expanded="${expanded}${g// /0}"
129:         done
130:     fi
131: 
132:     # Ensure lowercase
133:     echo "${expanded,,}"
134: }
135: 
136: # Convert hex string to binary string (for bit operations)
137: _hex_to_bin() {
138:     local hex="$1"
139:     local bin=""
140:     for ((i=0; i<${#hex}; i++)); do
141:         case "${hex:$i:1}" in
142:             0) bin+="0000" ;; 1) bin+="0001" ;; 2) bin+="0010" ;; 3) bin+="0011" ;;
143:             4) bin+="0100" ;; 5) bin+="0101" ;; 6) bin+="0110" ;; 7) bin+="0111" ;;
144:             8) bin+="1000" ;; 9) bin+="1001" ;; a|A) bin+="1010" ;; b|B) bin+="1011" ;;
145:             c|C) bin+="1100" ;; d|D) bin+="1101" ;; e|E) bin+="1110" ;; f|F) bin+="1111" ;;
146:         esac
147:     done
148:     echo "$bin"
149: }
150: 
151: # Check if IPv6 is within CIDR range (full implementation)
152: _ipv6_in_cidr() {
153:     local ip="$1"
154:     local cidr="$2"
155: 
156:     # Handle single IP (no /)
157:     if [[ "$cidr" != *"/"* ]]; then
158:         local ip_exp net_exp
159:         ip_exp=$(_ipv6_expand "$ip")
160:         net_exp=$(_ipv6_expand "$cidr")
161:         [[ "$ip_exp" == "$net_exp" ]] && return 0
162:         return 1
163:     fi
164: 
165:     local network="${cidr%/*}"
166:     local prefix="${cidr#*/}"
167: 
168:     # Expand both to full hex
169:     local ip_hex net_hex
170:     ip_hex=$(_ipv6_expand "$ip")
171:     net_hex=$(_ipv6_expand "$network")
172: 
173:     # For /0, everything matches
174:     [[ "$prefix" -eq 0 ]] && return 0
175: 
176:     # For /128, exact match required
177:     if [[ "$prefix" -eq 128 ]]; then
178:         [[ "$ip_hex" == "$net_hex" ]] && return 0
179:         return 1
180:     fi
181: 
182:     # Convert to binary for bit comparison
183:     local ip_bin net_bin
184:     ip_bin=$(_hex_to_bin "$ip_hex")
185:     net_bin=$(_hex_to_bin "$net_hex")
186: 
187:     # Compare first 'prefix' bits
188:     [[ "${ip_bin:0:$prefix}" == "${net_bin:0:$prefix}" ]] && return 0
189:     return 1
190: }
191: 
192: # =============================================================================
193: # SET LOOKUP FUNCTIONS
194: # =============================================================================
195: 
196: # Check if IP is in a specific nft set
197: # Returns: matching CIDR or empty string
198: _check_ip_in_set() {
199:     local family="$1"  # ip or ip6
200:     local set_name="$2"
201:     local check_ip="$3"
202: 
203:     local set_content
204:     set_content=$(nft list set "$family" nftban "$set_name" 2>/dev/null)
205:     [[ -z "$set_content" ]] && return 1
206: 
207:     # Extract elements section - handle multi-line nft output
208:     local elements
209:     elements=$(echo "$set_content" | \
210:         sed -n '/elements = {/,/}/p' | \
211:         sed 's/elements = {//' | \
212:         tr ',' '\n' | \
213:         tr -d '{}' | \
214:         sed 's/^[[:space:]]*//' | \
215:         sed 's/[[:space:]]*$//' | \
216:         grep -v '^$')
217: 
218:     local best_match=""
219:     local best_prefix=0
220: 
221:     while IFS= read -r entry; do
222:         # Clean entry (remove timeout info, whitespace)
223:         entry=$(echo "$entry" | sed 's/timeout.*//' | tr -d ' \t')
224:         [[ -z "$entry" ]] && continue
225: 
226:         # Handle IP ranges (a.b.c.d-e.f.g.h)
227:         if [[ "$entry" == *"-"* ]]; then
228:             # Range format - check if IP is within
229:             local start_ip="${entry%-*}"
230:             local end_ip="${entry#*-}"
231:             local ip_int start_int end_int
232:             ip_int=$(_ip_to_int "$check_ip")
233:             start_int=$(_ip_to_int "$start_ip")
234:             end_int=$(_ip_to_int "$end_ip")
235: 
236:             if [[ "$ip_int" -ge "$start_int" && "$ip_int" -le "$end_int" ]]; then
237:                 best_match="$entry"
238:                 best_prefix=32  # Treat range as most specific
239:                 break
240:             fi
241:             continue
242:         fi
243: 
244:         # Check CIDR match
245:         if [[ "$family" == "ip" ]]; then
246:             if _ip_in_cidr "$check_ip" "$entry"; then
247:                 local prefix=32
248:                 [[ "$entry" == *"/"* ]] && prefix="${entry#*/}"
249:                 if [[ "$prefix" -gt "$best_prefix" ]]; then
250:                     best_prefix="$prefix"
251:                     best_match="$entry"
252:                 fi
253:             fi
254:         else
255:             if _ipv6_in_cidr "$check_ip" "$entry"; then
256:                 best_match="$entry"
257:                 break
258:             fi
259:         fi
260:     done <<< "$elements"
261: 
262:     if [[ -n "$best_match" ]]; then
263:         echo "$best_match"
264:         return 0
265:     fi
266:     return 1
267: }
268: 
269: # Get rule handle for a set reference in chain
270: _get_set_rule_handle() {
271:     local family="$1"
272:     local chain="$2"
273:     local set_name="$3"
274: 
275:     nft -a list chain "$family" nftban "$chain" 2>/dev/null | \
276:         grep -E "@${set_name}[[:space:]]" | \
277:         grep -oE 'handle [0-9]+' | \
278:         head -1 | \
279:         awk '{print $2}'
280: }
281: 
282: # =============================================================================
283: # MODULE DETECTION
284: # =============================================================================
285: 
286: # Determine which module added an IP to a set
287: _detect_module_source() {
288:     local ip="$1"
289:     local set_name="$2"
290: 
291:     local module="unknown"
292:     local source="unknown"
293: 
294:     # Check blacklist config files for source
295:     local config_dir="${NFTBAN_CONFIG_DIR:-/etc/nftban}"
296: 
297:     # Check feeds
298:     if [[ -f "${NFTBAN_DATA_DIR:-/var/lib/nftban}/feeds/feed_ips.txt" ]]; then
299:         if grep -q "$ip" "${NFTBAN_DATA_DIR}/feeds/feed_ips.txt" 2>/dev/null; then
300:             module="threat_feeds"
301:             # Try to find which feed
302:             for feed_file in "${NFTBAN_DATA_DIR}"/feeds/*.txt; do
303:                 [[ -f "$feed_file" ]] || continue
304:                 if grep -q "$ip" "$feed_file" 2>/dev/null; then
305:                     source=$(basename "$feed_file" .txt | tr '[:lower:]' '[:upper:]')
306:                     break
307:                 fi
308:             done
309:         fi
310:     fi
311: 
312:     # Check manual blacklist
313:     if [[ "$module" == "unknown" ]]; then
314:         for conf_file in "$config_dir"/blacklist.d/*.conf; do
315:             [[ -f "$conf_file" ]] || continue
316:             if grep -q "$ip" "$conf_file" 2>/dev/null; then
317:                 module="manual"
318:                 source=$(basename "$conf_file")
319:                 break
320:             fi
321:         done
322:     fi
323: 
324:     # Check whitelist
325:     if [[ "$set_name" == *"whitelist"* ]]; then
326:         module="whitelist"
327:         for conf_file in "$config_dir"/whitelist.d/*.conf; do
328:             [[ -f "$conf_file" ]] || continue
329:             if grep -q "$ip" "$conf_file" 2>/dev/null; then
330:                 source=$(basename "$conf_file")
331:                 break
332:             fi
333:         done
334:         [[ "$source" == "unknown" ]] && source="manual"
335:     fi
336: 
337:     # Check if from login monitor
338:     if grep -q "$ip" "${NFTBAN_LOG_DIR:-/var/log/nftban}/login-monitor.log" 2>/dev/null; then
339:         if [[ "$module" == "unknown" ]]; then
340:             module="login_monitor"
341:             source="ssh_bruteforce"
342:         fi
343:     fi
344: 
345:     # Check if from portscan
346:     if grep -q "$ip" "${NFTBAN_LOG_DIR:-/var/log/nftban}/portscan.log" 2>/dev/null; then
347:         if [[ "$module" == "unknown" ]]; then
348:             module="portscan"
349:             source="port_scan_detection"
350:         fi
351:     fi
352: 
353:     echo "${module}|${source}"
354: }
355: 
356: # =============================================================================
357: # PORT CHECKING
358: # =============================================================================
359: 
360: # Check if port is in allowed ports set
361: _check_port_allowed() {
362:     local proto="$1"  # tcp or udp
363:     local port="$2"
364: 
365:     local set_name="${proto}_ports"
366:     local set_content
367:     set_content=$(nft list set ip nftban "$set_name" 2>/dev/null)
368: 
369:     if [[ -z "$set_content" ]]; then
370:         # No port restrictions
371:         return 0
372:     fi
373: 
374:     # Check if port is in set
375:     if echo "$set_content" | grep -qE "elements.*[{,][[:space:]]*${port}[[:space:]]*[,}]"; then
376:         return 0
377:     fi
378: 
379:     return 1
380: }
381: 
382: # =============================================================================
383: # MAIN EMULATION FUNCTION
384: # =============================================================================
385: 
386: # Emulate packet and return JSON result
387: # Usage: nftban_emulate_packet <ip> [proto] [port] [direction]
388: nftban_emulate_packet() {
389:     local ip="$1"
390:     local proto="${2:-}"
391:     local port="${3:-}"
392:     local direction="${4:-in}"
393: 
394:     # Detect IP family
395:     local family="ip"
396:     if [[ "$ip" == *":"* ]]; then
397:         family="ip6"
398:     fi
399: 
400:     # Map direction to chain
401:     local chain="input"
402:     case "$direction" in
403:         in|input)   chain="input" ;;
404:         out|output) chain="output" ;;
405:         fwd|forward) chain="forward" ;;
406:     esac
407: 
408:     # Initialize result
409:     local decision="allow"
410:     local matched_set=""
411:     local matched_cidr=""
412:     local matched_handle=""
413:     local module=""
414:     local source=""
415:     local list_type=""
416:     local explanation=""
417: 
418:     # Evaluation order array for JSON
419:     local eval_order=""
420: 
421:     # 1. Check whitelist first
422:     local whitelist_set="whitelist_ipv4"
423:     [[ "$family" == "ip6" ]] && whitelist_set="whitelist_ipv6"
424: 
425:     local wl_match
426:     wl_match=$(_check_ip_in_set "$family" "$whitelist_set" "$ip")
427: 
428:     if [[ -n "$wl_match" ]]; then
429:         decision="allow"
430:         matched_set="$whitelist_set"
431:         matched_cidr="$wl_match"
432:         matched_handle=$(_get_set_rule_handle "$family" "$chain" "$whitelist_set")
433:         list_type="$whitelist_set"
434:         local mod_src
435:         mod_src=$(_detect_module_source "$ip" "$whitelist_set")
436:         module="${mod_src%|*}"
437:         source="${mod_src#*|}"
438:         explanation="The address $ip is part of $matched_cidr, which is in the whitelist (trusted IPs)."
439:         eval_order="{\"set\":\"$whitelist_set\",\"matched\":true,\"entry\":\"$wl_match\"}"
440:     else
441:         eval_order="{\"set\":\"$whitelist_set\",\"matched\":false}"
442: 
443:         # 2. Check blacklist
444:         local blacklist_set="blacklist_ipv4"
445:         [[ "$family" == "ip6" ]] && blacklist_set="blacklist_ipv6"
446: 
447:         local bl_match
448:         bl_match=$(_check_ip_in_set "$family" "$blacklist_set" "$ip")
449: 
450:         if [[ -n "$bl_match" ]]; then
451:             decision="block"
452:             matched_set="$blacklist_set"
453:             matched_cidr="$bl_match"
454:             matched_handle=$(_get_set_rule_handle "$family" "$chain" "$blacklist_set")
455:             list_type="$blacklist_set"
456:             local mod_src
457:             mod_src=$(_detect_module_source "$ip" "$blacklist_set")
458:             module="${mod_src%|*}"
459:             source="${mod_src#*|}"
460:             explanation="The address $ip is part of $matched_cidr, which is in the unified blacklist."
461:             eval_order="${eval_order},{\"set\":\"$blacklist_set\",\"matched\":true,\"entry\":\"$bl_match\"}"
462:         else
463:             eval_order="${eval_order},{\"set\":\"$blacklist_set\",\"matched\":false}"
464: 
465:             # 3. Check port if specified (only for input chain)
466:             if [[ -n "$port" && -n "$proto" && "$chain" == "input" ]]; then
467:                 if ! _check_port_allowed "$proto" "$port"; then
468:                     decision="block"
469:                     matched_set="${proto}_ports"
470:                     module="port_filter"
471:                     source="not_in_allowed_ports"
472:                     list_type="${proto}_ports"
473:                     explanation="Port $port/$proto is not in the allowed ports list."
474:                     eval_order="${eval_order},{\"set\":\"${proto}_ports\",\"matched\":false,\"reason\":\"port_not_allowed\"}"
475:                 else
476:                     eval_order="${eval_order},{\"set\":\"${proto}_ports\",\"matched\":true}"
477:                 fi
478:             fi
479: 
480:             # 4. Default: allow (for established connections / allowed ports)
481:             if [[ "$decision" == "allow" && -z "$module" ]]; then
482:                 module="default_policy"
483:                 source="no_match"
484:                 explanation="No blocking rules matched. Traffic allowed by default chain policy or established connection tracking."
485:             fi
486:         fi
487:     fi
488: 
489:     # Build JSON output
490:     cat <<EOF
491: {
492:   "query": {
493:     "ip": "$ip",
494:     "protocol": "${proto:-null}",
495:     "port": ${port:-null},
496:     "direction": "$direction",
497:     "family": "${family/ip/ipv}4"
498:   },
499:   "result": {
500:     "decision": "$decision",
501:     "reason": {
502:       "module": "${module:-unknown}",
503:       "source": "${source:-unknown}",
504:       "list_type": "${list_type:-none}",
505:       "matching_cidr": "${matched_cidr:-null}"
506:     },
507:     "nftables": {
508:       "family": "$family",
509:       "table": "nftban",
510:       "chain": "$chain",
511:       "rule_handle": ${matched_handle:-null},
512:       "set_name": "${matched_set:-null}"
513:     },
514:     "explanation": "$explanation"
515:   },
516:   "evaluation_order": [${eval_order}]
517: }
518: EOF
519: }
520: 
521: # Format emulation result as pretty text
522: nftban_emulate_format_text() {
523:     local json="$1"
524: 
525:     # Parse JSON (using jq if available, or basic parsing)
526:     local ip decision module source list_type matching_cidr chain handle explanation
527: 
528:     if command -v jq &>/dev/null; then
529:         ip=$(echo "$json" | jq -r '.query.ip')
530:         decision=$(echo "$json" | jq -r '.result.decision')
531:         module=$(echo "$json" | jq -r '.result.reason.module')
532:         source=$(echo "$json" | jq -r '.result.reason.source')
533:         list_type=$(echo "$json" | jq -r '.result.reason.list_type')
534:         matching_cidr=$(echo "$json" | jq -r '.result.reason.matching_cidr')
535:         chain=$(echo "$json" | jq -r '.result.nftables.chain')
536:         handle=$(echo "$json" | jq -r '.result.nftables.rule_handle')
537:         explanation=$(echo "$json" | jq -r '.result.explanation')
538:     else
539:         # Basic parsing without jq
540:         ip=$(echo "$json" | grep -o '"ip": *"[^"]*"' | head -1 | cut -d'"' -f4)
541:         decision=$(echo "$json" | grep -o '"decision": *"[^"]*"' | cut -d'"' -f4)
542:         module=$(echo "$json" | grep -o '"module": *"[^"]*"' | cut -d'"' -f4)
543:         source=$(echo "$json" | grep -o '"source": *"[^"]*"' | cut -d'"' -f4)
544:         list_type=$(echo "$json" | grep -o '"list_type": *"[^"]*"' | cut -d'"' -f4)
545:         matching_cidr=$(echo "$json" | grep -o '"matching_cidr": *"[^"]*"' | cut -d'"' -f4)
546:         chain=$(echo "$json" | grep -o '"chain": *"[^"]*"' | cut -d'"' -f4)
547:         handle=$(echo "$json" | grep -o '"rule_handle": *[0-9]*' | grep -o '[0-9]*')
548:         explanation=$(echo "$json" | grep -o '"explanation": *"[^"]*"' | cut -d'"' -f4)
549:     fi
550: 
551:     # Colors
552:     local RED='\033[0;31m'
553:     local GREEN='\033[0;32m'
554:     local YELLOW='\033[1;33m'
555:     local CYAN='\033[0;36m'
556:     local NC='\033[0m'
557:     local BOLD='\033[1m'
558: 
559:     # Disable colors if not terminal or disabled
560:     if [[ ! -t 1 ]] || [[ "${NFTBAN_COLOR_OUTPUT:-true}" != "true" ]]; then
561:         RED="" GREEN="" YELLOW="" CYAN="" NC="" BOLD=""
562:     fi
563: 
564:     local result_icon result_text result_color
565:     if [[ "$decision" == "block" ]]; then
566:         result_icon="❌"
567:         result_text="BLOCKED"
568:         result_color="$RED"
569:     else
570:         result_icon="✅"
571:         result_text="ALLOWED"
572:         result_color="$GREEN"
573:     fi
574: 
575:     cat <<EOF
576: 
577: ${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
578: NFTBan Packet Emulation
579: ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}
580: 
581: ${BOLD}INPUT:${NC}   ${CYAN}${ip}${NC}
582: ${BOLD}RESULT:${NC}  ${result_color}${result_icon} ${result_text}${NC}
583: 
584: ${BOLD}REASON${NC}
585: ────────────────────────────────────────────────────────────
586:   Module............. ${YELLOW}${module}${NC}
587:   Source............. ${source}
588:   List type.......... ${list_type}
589:   Matching entry..... ${matching_cidr:-N/A}
590:   Table/Chain........ ip nftban → ${chain}
591:   Rule handle........ ${handle:-N/A}
592: 
593: ${BOLD}EXPLANATION${NC}
594: ────────────────────────────────────────────────────────────
595:   ${explanation}
596: 
597: ${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}
598: EOF
599: }
600: 
601: # Quick check function - returns just allow/block
602: nftban_emulate_quick() {
603:     local ip="$1"
604:     local result
605:     result=$(nftban_emulate_packet "$ip")
606:     echo "$result" | grep -o '"decision": *"[^"]*"' | cut -d'"' -f4
607: }
608: 
609: # Export functions
610: export -f nftban_emulate_packet
611: export -f nftban_emulate_format_text
612: export -f nftban_emulate_quick
613: export -f _ip_to_int
614: export -f _int_to_ip
615: export -f _ip_in_cidr
616: export -f _check_ip_in_set
</file>

<file path="cli/lib/nftban/core/nftban_feeds.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - Threat Feeds Core Module
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Dynamic threat intelligence feed management with Go integration
  7: #
  8: # meta:name=nftban_feeds
  9: # meta:type=core
 10: # meta:header=Threat Feeds Core
 11: # meta:version=1.0.0
 12: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 13: # meta:homepage=https://nftban.com
 14: #
 15: # **Description & Purpose**
 16: # meta:description=Dynamic threat intelligence feeds with beautiful selection UI
 17: # meta:input=Feed URLs from config (dynamic discovery)
 18: # meta:output=Parsed IPs/CIDRs to nftables, logs to /var/log/nftban/feeds.log
 19: #
 20: # **Inventory & Requirements**
 21: # meta:depends=bash,curl,flock,nftban-feeds (Go binary)
 22: #
 23: # meta:created_date=2025-11-05
 24: # meta:updated_date=2025-11-24
 25: # =============================================================================
 26: 
 27: # Prevent double-loading (required for circular dependency with task_queue.sh)
 28: [[ -n "${NFTBAN_FEEDS_LOADED:-}" ]] && return 0
 29: readonly NFTBAN_FEEDS_LOADED=1
 30: 
 31: # =============================================================================
 32: # DEPENDENCIES
 33: # =============================================================================
 34: 
 35: # Source canonical NFT schema (single source of truth for table/set names)
 36: # shellcheck source=/dev/null
 37: source "${NFTBAN_LIB_DIR:-/usr/lib/nftban}/lib/nft_schema.sh" 2>/dev/null || {
 38:     echo "ERROR: Cannot load nft_schema.sh - NFTables schema undefined" >&2
 39:     exit 1
 40: }
 41: 
 42: # =============================================================================
 43: # CONFIGURATION
 44: # =============================================================================
 45: 
 46: # Source central config for canonical paths (NO HARDCODED FALLBACKS)
 47: # shellcheck source=/etc/nftban/nftban.conf
 48: [[ -f "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf" ]] && source "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf"
 49: 
 50: readonly NFTBAN_FEEDS_CONFIG="${NFTBAN_CONFIG_DIR}/conf.d/feeds.conf"
 51: readonly NFTBAN_FEEDS_STORAGE_DIR="${NFTBAN_FEEDS_STORAGE_DIR:-${NFTBAN_DATA_DIR}/feeds}"
 52: readonly NFTBAN_FEEDS_CACHE_DIR="${NFTBAN_FEEDS_CACHE_DIR:-${NFTBAN_CACHE_DIR}/feeds}"
 53: readonly NFTBAN_FEEDS_LOG="${NFTBAN_FEEDS_LOG:-${NFTBAN_LOG_DIR}/feeds.log}"
 54: # Use central config for Go binary path (NO HARDCODED FALLBACKS)
 55: readonly NFTBAN_FEEDS_BINARY="${NFTBAN_CORE_BIN:-${NFTBAN_LIB_DIR}/bin/nftban-core}"
 56: readonly NFTBAN_FEEDS_LOCKFILE="${NFTBAN_RUN_DIR}/feeds-update.lock"
 57: 
 58: # =============================================================================
 59: # LOCKING - Prevent concurrent updates
 60: # =============================================================================
 61: 
 62: # Ensure lock directory exists
 63: mkdir -p "$(dirname "$NFTBAN_FEEDS_LOCKFILE")" 2>/dev/null || true
 64: 
 65: # Acquire lock (30 second timeout)
 66: _feeds_lock() {
 67:     exec 9>"$NFTBAN_FEEDS_LOCKFILE"
 68:     if ! flock -w 30 9; then
 69:         return 1
 70:     fi
 71:     return 0
 72: }
 73: 
 74: # Release lock
 75: _feeds_unlock() {
 76:     flock -u 9 2>/dev/null || true
 77: }
 78: 
 79: # Check if another update is running
 80: _feeds_is_locked() {
 81:     if [[ -f "$NFTBAN_FEEDS_LOCKFILE" ]]; then
 82:         # Check if lock is stale (older than 1 hour = hung process)
 83:         local lock_age
 84:         lock_age=$(( $(date +%s) - $(stat -c %Y "$NFTBAN_FEEDS_LOCKFILE" 2>/dev/null || echo 0) ))
 85:         if [[ $lock_age -gt 3600 ]]; then
 86:             # Stale lock, remove it
 87:             rm -f "$NFTBAN_FEEDS_LOCKFILE"
 88:             return 1
 89:         fi
 90: 
 91:         # Try to acquire lock (non-blocking check)
 92:         if exec 9>"$NFTBAN_FEEDS_LOCKFILE" && flock -n 9 2>/dev/null; then
 93:             flock -u 9
 94:             return 1  # Not locked
 95:         fi
 96:         return 0  # Locked
 97:     fi
 98:     return 1  # Not locked
 99: }
100: 
101: # =============================================================================
102: # LOGGING
103: # =============================================================================
104: 
105: nftban_feeds_log() {
106:     local level="$1"; shift
107:     local msg="$*"
108:     local timestamp
109:     timestamp=$(date '+%Y-%m-%d %H:%M:%S')
110: 
111:     # Ensure log directory exists
112:     mkdir -p "$(dirname "$NFTBAN_FEEDS_LOG")"
113: 
114:     # Log to dedicated feeds.log
115:     echo "[$timestamp] [$level] $msg" | tee -a "$NFTBAN_FEEDS_LOG"
116: 
117:     # Also log via main nftban logging if available
118:     if declare -f nftban_log_${level,,} >/dev/null 2>&1; then
119:         nftban_log_${level,,} "FEEDS: $msg"
120:     fi
121: }
122: 
123: # =============================================================================
124: # DYNAMIC FEED DISCOVERY (NO HARDCODED ARRAYS!)
125: # =============================================================================
126: 
127: # Discover all feeds from config file
128: nftban_feeds_discover_all() {
129:     if [[ ! -f "$NFTBAN_FEEDS_CONFIG" ]]; then
130:         nftban_feeds_log ERROR "Config file not found: $NFTBAN_FEEDS_CONFIG"
131:         return 1
132:     fi
133: 
134:     # Find all FEED_*_URL variables (dynamic discovery!)
135:     grep -oP 'FEED_\K[A-Z0-9_]+(?=_URL=)' "$NFTBAN_FEEDS_CONFIG" | sort -u
136: }
137: 
138: # Get feed property dynamically
139: nftban_feeds_get_property() {
140:     local feed_name="$1"
141:     local property="$2"  # URL, ENABLED, CATEGORY, DESCRIPTION, etc.
142: 
143:     if [[ ! -f "$NFTBAN_FEEDS_CONFIG" ]]; then
144:         echo ""
145:         return 1
146:     fi
147: 
148:     # Read property from config
149:     local var_name="FEED_${feed_name}_${property}"
150:     grep "^${var_name}=" "$NFTBAN_FEEDS_CONFIG" 2>/dev/null | head -1 | cut -d'=' -f2- | tr -d '"' || echo ""
151: }
152: 
153: # Set feed property (enable/disable)
154: nftban_feeds_set_property() {
155:     local feed_name="$1"
156:     local property="$2"
157:     local value="$3"
158: 
159:     if [[ ! -f "$NFTBAN_FEEDS_CONFIG" ]]; then
160:         nftban_feeds_log ERROR "Config file not found: $NFTBAN_FEEDS_CONFIG"
161:         return 1
162:     fi
163: 
164:     local var_name="FEED_${feed_name}_${property}"
165: 
166:     # Update with sed (preserves comments and structure)
167:     if grep -q "^${var_name}=" "$NFTBAN_FEEDS_CONFIG"; then
168:         sed -i "s|^${var_name}=.*|${var_name}=\"${value}\"|" "$NFTBAN_FEEDS_CONFIG"
169:     else
170:         echo "${var_name}=\"${value}\"" >> "$NFTBAN_FEEDS_CONFIG"
171:     fi
172: }
173: 
174: # Get all feeds in a category
175: nftban_feeds_get_by_category() {
176:     local category="$1"
177:     local all_feeds
178:     all_feeds=$(nftban_feeds_discover_all)
179: 
180:     for feed in $all_feeds; do
181:         local feed_category
182:         feed_category=$(nftban_feeds_get_property "$feed" "CATEGORY")
183:         if [[ "$feed_category" == "$category" ]]; then
184:             echo "$feed"
185:         fi
186:     done
187: }
188: 
189: # Get all categories (dynamic!)
190: nftban_feeds_get_categories() {
191:     local all_feeds
192:     all_feeds=$(nftban_feeds_discover_all)
193: 
194:     local categories=()
195:     for feed in $all_feeds; do
196:         local cat
197:         cat=$(nftban_feeds_get_property "$feed" "CATEGORY")
198:         local cat_pattern=" ${cat} "
199:         if [[ -n "$cat" ]] && [[ ! " ${categories[*]} " =~ $cat_pattern ]]; then
200:             categories+=("$cat")
201:         fi
202:     done
203: 
204:     printf '%s\n' "${categories[@]}" | sort -u
205: }
206: 
207: # List all enabled feeds
208: nftban_feeds_list_enabled() {
209:     local all_feeds
210:     all_feeds=$(nftban_feeds_discover_all)
211: 
212:     for feed in $all_feeds; do
213:         local enabled
214:         enabled=$(nftban_feeds_get_property "$feed" "ENABLED")
215:         if [[ "$enabled" == "true" ]]; then
216:             echo "$feed"
217:         fi
218:     done
219: }
220: 
221: # =============================================================================
222: # FEED OPERATIONS
223: # =============================================================================
224: 
225: # Enable a feed
226: nftban_feeds_enable() {
227:     local feed_name="$1"
228:     local quiet="${2:-false}"  # Optional: quiet mode for batch operations
229: 
230:     # Validate feed exists
231:     local feed_url
232:     feed_url=$(nftban_feeds_get_property "$feed_name" "URL")
233:     if [[ -z "$feed_url" ]]; then
234:         nftban_feeds_log ERROR "Feed not found: $feed_name"
235:         return 1
236:     fi
237: 
238:     # Enable feed
239:     nftban_feeds_set_property "$feed_name" "ENABLED" "true"
240:     nftban_feeds_log INFO "Feed enabled: $feed_name"
241: 
242:     # Download immediately (foreground) so user can see success/failure
243:     if [[ "$quiet" != "true" ]]; then
244:         echo "✓ Feed enabled: $feed_name"
245:         echo ""
246:         echo "📥 Downloading feed..."
247:     fi
248: 
249:     # Download in foreground with live feedback
250:     # Pass "true" for no_sync since we'll queue the sync after download
251:     if nftban_feeds_update_single "$feed_name" "true"; then
252:         if [[ "$quiet" != "true" ]]; then
253:             echo "✅ Feed downloaded successfully"
254:         fi
255: 
256:         # ARCHITECTURE COMPLIANCE: Always use timer-based queue for nftables sync
257:         # NEVER execute synchronous sync - all feeds/ban/unban/countries managed by timer
258:         # This prevents 30+ second hangs with large feed sets and respects async architecture
259:         if command -v nftban_queue_add &>/dev/null; then
260:             nftban_queue_add "feeds_sync" "Feed enabled: $feed_name" >/dev/null 2>&1
261:             if [[ "$quiet" != "true" ]]; then
262:                 echo "   NFTables update queued (processed every 2 minutes)"
263:                 echo "   Check queue: tail -f /var/log/nftban/queue.log"
264:                 echo ""
265:             fi
266:         else
267:             # Queue function not available, note in logs
268:             nftban_feeds_log "WARN" "Queue function not available, sync will run on next timer cycle"
269:             if [[ "$quiet" != "true" ]]; then
270:                 echo "   NFTables will sync on next timer cycle (every 2 minutes)"
271:                 echo ""
272:             fi
273:         fi
274:     else
275:         if [[ "$quiet" != "true" ]]; then
276:             echo "❌ Feed download failed (check /var/log/nftban/feeds.log)"
277:             echo ""
278:         fi
279:         return 1
280:     fi
281: }
282: 
283: # Disable a feed
284: nftban_feeds_disable() {
285:     local feed_name="$1"
286: 
287:     # Disable feed
288:     nftban_feeds_set_property "$feed_name" "ENABLED" "false"
289:     nftban_feeds_log INFO "Feed disabled: $feed_name"
290: 
291:     # Show immediate feedback
292:     echo "✓ Feed disabled: $feed_name"
293:     echo ""
294: 
295:     # ARCHITECTURE COMPLIANCE: Always use timer-based queue for nftables sync
296:     # NEVER execute synchronous sync - all feeds/ban/unban/countries managed by timer
297:     # This prevents 30+ second hangs with large feed sets and respects async architecture
298:     if command -v nftban_queue_add &>/dev/null; then
299:         nftban_queue_add "feeds_sync" "Feed disabled: $feed_name" >/dev/null 2>&1
300:         echo "✅ Feed disabled successfully"
301:         echo "   NFTables update queued (processed every 2 minutes)"
302:         echo "   Check queue: tail -f /var/log/nftban/queue.log"
303:         echo ""
304:     else
305:         nftban_feeds_log "WARN" "Queue function not available, sync will run on next timer cycle"
306:         echo "✅ Feed disabled successfully"
307:         echo "   NFTables will sync on next timer cycle (every 2 minutes)"
308:         echo ""
309:     fi
310: }
311: 
312: # Update single feed
313: nftban_feeds_update_single() {
314:     local feed_name="$1"
315:     local no_sync="${2:-false}"  # Optional: skip sync (for batch updates)
316: 
317:     nftban_feeds_log INFO "Updating feed: $feed_name"
318: 
319:     # Get feed properties
320:     local feed_url
321:     feed_url=$(nftban_feeds_get_property "$feed_name" "URL")
322:     local feed_enabled
323:     feed_enabled=$(nftban_feeds_get_property "$feed_name" "ENABLED")
324: 
325:     if [[ "$feed_enabled" != "true" ]]; then
326:         nftban_feeds_log WARN "Feed is disabled, skipping: $feed_name"
327:         return 0
328:     fi
329: 
330:     # Ensure directories exist
331:     mkdir -p "$NFTBAN_FEEDS_STORAGE_DIR" "$NFTBAN_FEEDS_CACHE_DIR"
332: 
333:     # Download feed
334:     local temp_file="${NFTBAN_FEEDS_CACHE_DIR}/${feed_name}.tmp"
335:     nftban_feeds_log DEBUG "Downloading: $feed_url"
336: 
337:     if ! curl -sSL --max-time 30 "$feed_url" > "$temp_file" 2>/dev/null; then
338:         nftban_feeds_log ERROR "Download failed: $feed_name"
339:         rm -f "$temp_file"
340:         return 1
341:     fi
342: 
343:     # Parse with Go binary (FAST!) or fallback to bash
344:     # Store files in lowercase for consistency with Go binary expectations
345:     local feed_name_lowercase
346:     feed_name_lowercase=$(echo "$feed_name" | tr '[:upper:]' '[:lower:]')
347:     local parsed_file="${NFTBAN_FEEDS_STORAGE_DIR}/${feed_name_lowercase}.txt"
348:     local parse_result=""
349: 
350:     # Parse feed file to extract IPs (bash parser - handles all formats)
351:     # Note: Go binary is used for 'feeds load' and 'feeds sync' operations
352:     parse_result=$(grep -v '^\s*$' "$temp_file" | \
353:                   grep -v '^\s*#' | \
354:                   grep -v '^\s*;' | \
355:                   sed 's/[[:space:]]*;.*//' | \
356:                   sed 's/[[:space:]]*#.*//' | \
357:                   grep -oE '^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}(/[0-9]{1,2})?' | \
358:                   sort -u)
359: 
360:     # Save parsed IPs
361:     echo "$parse_result" > "$parsed_file"
362:     local ip_count
363:     ip_count=$(echo "$parse_result" | grep -c .)
364: 
365:     # Validate minimum entries
366:     local min_entries
367:     min_entries=$(grep "^FEEDS_MIN_ENTRIES=" "$NFTBAN_FEEDS_CONFIG" | cut -d'=' -f2 | cut -d'#' -f1 | tr -d '" ' | grep -oE '[0-9]+')
368:     min_entries=${min_entries:-10}
369: 
370:     # Final validation
371:     if [[ $ip_count -lt $min_entries ]]; then
372:         nftban_feeds_log ERROR "Feed has only $ip_count entries (minimum: $min_entries), rejecting: $feed_name"
373:         rm -f "$temp_file" "$parsed_file"
374:         return 1
375:     fi
376: 
377:     nftban_feeds_log INFO "Feed updated: $feed_name ($ip_count IPs)"
378: 
379:     # Cleanup
380:     rm -f "$temp_file"
381: 
382:     # Sync to nftables (unless told to skip for batch updates)
383:     if [[ "$no_sync" != "true" ]]; then
384:         # ARCHITECTURE COMPLIANCE: Always use timer-based queue for nftables sync
385:         # NEVER execute synchronous sync - all feeds/ban/unban/countries managed by timer
386:         # This prevents system crashes when loading thousands of IPs at once
387:         if command -v nftban_queue_add &>/dev/null; then
388:             nftban_queue_add "feeds_sync" "Feed updated: $feed_name" >/dev/null 2>&1
389:         else
390:             nftban_feeds_log "WARN" "Queue function not available, sync will run on next timer cycle"
391:         fi
392:     fi
393: 
394:     return 0
395: }
396: 
397: # Update all enabled feeds
398: nftban_feeds_update_all() {
399:     # Check if another update is already running
400:     if _feeds_is_locked; then
401:         echo "⚠️  Another feed update is already running"
402:         echo ""
403:         echo "If this is stuck, check: ps aux | grep 'nftban feeds'"
404:         echo "Lock file: $NFTBAN_FEEDS_LOCKFILE"
405:         nftban_feeds_log WARN "Update skipped: another update is already running"
406:         return 1
407:     fi
408: 
409:     # Acquire lock with timeout
410:     if ! _feeds_lock; then
411:         echo "❌ Failed to acquire lock (timeout after 30 seconds)"
412:         echo ""
413:         echo "Another update may be running or system is overloaded."
414:         echo "Wait and try again, or check: ps aux | grep 'nftban feeds'"
415:         nftban_feeds_log ERROR "Failed to acquire update lock (timeout)"
416:         return 1
417:     fi
418: 
419:     # Ensure lock is released on exit
420:     trap '_feeds_unlock' EXIT INT TERM
421: 
422:     nftban_feeds_log INFO "Updating all enabled feeds... (lock acquired)"
423: 
424:     echo "⏳ Downloading all enabled feeds..."
425:     echo ""
426: 
427:     local all_feeds
428:     all_feeds=$(nftban_feeds_discover_all)
429: 
430:     local success_count=0
431:     local fail_count=0
432: 
433:     # Download all feeds WITHOUT syncing (sync once at the end for efficiency)
434:     for feed in $all_feeds; do
435:         local enabled
436:         enabled=$(nftban_feeds_get_property "$feed" "ENABLED")
437: 
438:         if [[ "$enabled" == "true" ]]; then
439:             echo "  → Downloading: $feed"
440:             if nftban_feeds_update_single "$feed" "true"; then
441:                 success_count=$((success_count + 1))
442:             else
443:                 fail_count=$((fail_count + 1))
444:             fi
445:         fi
446:     done
447: 
448:     echo ""
449:     echo "✓ Downloaded $success_count feed(s), $fail_count failed"
450: 
451:     nftban_feeds_log INFO "Update complete: $success_count succeeded, $fail_count failed"
452: 
453:     # Immediately load feeds into nftables using Go binary (central config path)
454:     echo ""
455:     echo "⏳ Loading feeds into nftables..."
456:     if [[ -x "${NFTBAN_FEEDS_BINARY}" ]]; then
457:         if "${NFTBAN_FEEDS_BINARY}" feeds load 2>&1 | grep -E "^(✅|⚠️|Feed entries:|Total)" ; then
458:             nftban_feeds_log INFO "Feeds loaded into nftables successfully"
459:             echo ""
460:         else
461:             nftban_feeds_log ERROR "Failed to load feeds into nftables"
462:             echo "❌ Failed to load feeds - check logs"
463:             echo ""
464:         fi
465:     else
466:         nftban_feeds_log "WARN" "Go binary not found at ${NFTBAN_FEEDS_BINARY}, feeds downloaded but not loaded"
467:         echo "⚠️ Feeds downloaded but Go binary not found at: ${NFTBAN_FEEDS_BINARY}"
468:         echo "   Check NFTBAN_CORE_BIN in /etc/nftban/nftban.conf"
469:         echo ""
470:     fi
471: 
472:     # Lock will be released by trap
473:     return 0
474: }
475: 
476: # Sync all enabled feeds to nftables (Go-optimized with bash fallback)
477: nftban_feeds_sync_to_nftables() {
478:     nftban_feeds_log INFO "Syncing feeds to nftables (v0.7.3 architecture)..."
479: 
480:     # v0.7.3: Feeds add directly to existing blacklist_ipv4/blacklist_ipv6 sets
481:     # No separate feed sets needed - unified blacklist approach
482: 
483:     # Verify blacklist sets exist (should be created by nftables-safe.conf)
484:     if ! nft list set ${NFTBAN_TABLE_IPV4} blacklist_ipv4 >/dev/null 2>&1; then
485:         nftban_feeds_log ERROR "IPv4 blacklist set missing! Run: nftban nftables init"
486:         return 1
487:     fi
488: 
489:     if ! nft list set ${NFTBAN_TABLE_IPV6} blacklist_ipv6 >/dev/null 2>&1; then
490:         nftban_feeds_log ERROR "IPv6 blacklist set missing! Run: nftban nftables init"
491:         return 1
492:     fi
493: 
494:     # Check if Go binary is available (v0.6.0)
495:     local go_binary="${NFTBAN_LIB_DIR}/bin/nftban-feeds"
496:     if [[ -x "$go_binary" ]]; then
497:         nftban_feeds_log INFO "Using Go-optimized feed loader (fast, atomic)"
498:         nftban_feeds_sync_to_nftables_go
499:         return $?
500:     else
501:         nftban_feeds_log INFO "Using bash feed loader (Go binary not found)"
502:         nftban_feeds_sync_to_nftables_bash
503:         return $?
504:     fi
505: }
506: 
507: # Go-optimized feed sync (v0.6.0)
508: nftban_feeds_sync_to_nftables_go() {
509:     local go_binary="${NFTBAN_LIB_DIR}/bin/nftban-feeds"
510: 
511:     # Get list of enabled feeds
512:     local enabled_feeds
513:     enabled_feeds=$(nftban_feeds_list_enabled | tr '\n' ',' | sed 's/,$//')
514: 
515:     if [[ -z "$enabled_feeds" ]]; then
516:         nftban_feeds_log INFO "No feeds enabled"
517:         return 0
518:     fi
519: 
520:     nftban_feeds_log INFO "Enabled feeds: $enabled_feeds"
521: 
522:     # Convert feed names to lowercase for Go binary compatibility
523:     # Go binary expects: "firehol_anonymous", Bash config has: "FIREHOL_ANONYMOUS"
524:     local enabled_feeds_lowercase
525:     enabled_feeds_lowercase=$(echo "$enabled_feeds" | tr '[:upper:]' '[:lower:]')
526: 
527:     nftban_feeds_log DEBUG "Calling Go binary with: $enabled_feeds_lowercase"
528: 
529:     # Call Go binary with atomic loading
530:     if "$go_binary" sync "$enabled_feeds_lowercase" 2>&1 | tee -a "$NFTBAN_FEEDS_LOG"; then
531:         nftban_feeds_log INFO "Go feed sync completed successfully"
532:         return 0
533:     else
534:         nftban_feeds_log ERROR "Go feed sync failed, falling back to bash"
535:         nftban_feeds_sync_to_nftables_bash
536:         return $?
537:     fi
538: }
539: 
540: # Bash feed sync (fallback, v0.6.0) - ATOMIC RELOAD
541: nftban_feeds_sync_to_nftables_bash() {
542:     # Collect all IPs from enabled feeds
543:     local ipv4_list="${NFTBAN_FEEDS_CACHE_DIR}/feeds_ipv4.tmp"
544:     local ipv6_list="${NFTBAN_FEEDS_CACHE_DIR}/feeds_ipv6.tmp"
545: 
546:     : > "$ipv4_list"
547:     : > "$ipv6_list"
548: 
549:     local all_feeds
550:     all_feeds=$(nftban_feeds_discover_all)
551: 
552:     for feed in $all_feeds; do
553:         local enabled
554:         enabled=$(nftban_feeds_get_property "$feed" "ENABLED")
555: 
556:         if [[ "$enabled" == "true" ]]; then
557:             # Convert to lowercase for filename (files are saved as lowercase)
558:             local feed_lowercase
559:             feed_lowercase=$(echo "$feed" | tr '[:upper:]' '[:lower:]')
560:             local feed_file="${NFTBAN_FEEDS_STORAGE_DIR}/${feed_lowercase}.txt"
561:             if [[ -f "$feed_file" ]]; then
562:                 # Separate IPv4 and IPv6
563:                 while IFS= read -r ip; do
564:                     if [[ "$ip" =~ : ]]; then
565:                         echo "$ip" >> "$ipv6_list"
566:                     else
567:                         echo "$ip" >> "$ipv4_list"
568:                     fi
569:                 done < "$feed_file"
570:             fi
571:         fi
572:     done
573: 
574:     # Count unique IPs
575:     local ipv4_count=0
576:     local ipv6_count=0
577:     [[ -s "$ipv4_list" ]] && ipv4_count=$(sort -u "$ipv4_list" | wc -l)
578:     [[ -s "$ipv6_list" ]] && ipv6_count=$(sort -u "$ipv6_list" | wc -l)
579: 
580:     # Build nftables file for atomic reload (v0.7.3 architecture - dual tables)
581:     local nft_file="${NFTBAN_FEEDS_CACHE_DIR}/feeds.nft"
582:     cat > "$nft_file" << EOF
583: #!/usr/sbin/nft -f
584: # NFTBan Feed Sync - Generated $(date)
585: # IPv4: $ipv4_count | IPv6: $ipv6_count
586: # Architecture: v0.7.3 (dual ip/ip6 tables, unified blacklist sets)
587: 
588: EOF
589: 
590:     # Add IPv4 elements to ip nftban blacklist_ipv4
591:     if [[ -s "$ipv4_list" ]]; then
592:         echo "add element ${NFTBAN_TABLE_IPV4} blacklist_ipv4 {" >> "$nft_file"
593:         sort -u "$ipv4_list" | sed 's/$/,/' | sed '$ s/,$//' >> "$nft_file"
594:         echo "}" >> "$nft_file"
595:         echo "" >> "$nft_file"
596:     fi
597: 
598:     # Add IPv6 elements to ip6 nftban blacklist_ipv6
599:     if [[ -s "$ipv6_list" ]]; then
600:         echo "add element ${NFTBAN_TABLE_IPV6} blacklist_ipv6 {" >> "$nft_file"
601:         sort -u "$ipv6_list" | sed 's/$/,/' | sed '$ s/,$//' >> "$nft_file"
602:         echo "}" >> "$nft_file"
603:     fi
604: 
605:     # Atomic reload using nft -f
606:     if nft -f "$nft_file" 2>&1 | tee -a "$NFTBAN_FEEDS_LOG"; then
607:         nftban_feeds_log INFO "Sync complete: $ipv4_count IPv4, $ipv6_count IPv6"
608:     else
609:         nftban_feeds_log ERROR "Atomic reload failed"
610:         # Cleanup
611:         rm -f "$ipv4_list" "$ipv6_list" "$nft_file"
612:         return 1
613:     fi
614: 
615:     # Cleanup
616:     rm -f "$ipv4_list" "$ipv6_list" "$nft_file"
617: 
618:     return 0
619: }
620: 
621: # =============================================================================
622: # STATUS & INFORMATION
623: # =============================================================================
624: 
625: # List all feeds with status
626: nftban_feeds_list_simple() {
627:     local all_feeds
628:     all_feeds=$(nftban_feeds_discover_all)
629: 
630:     for feed in $all_feeds; do
631:         local enabled
632:         enabled=$(nftban_feeds_get_property "$feed" "ENABLED")
633:         local category
634:         category=$(nftban_feeds_get_property "$feed" "CATEGORY")
635:         local description
636:         description=$(nftban_feeds_get_property "$feed" "DESCRIPTION")
637: 
638:         local status_icon="[✗]"
639:         [[ "$enabled" == "true" ]] && status_icon="[✓]"
640: 
641:         printf "%-4s %-30s %-15s %s\n" "$status_icon" "$feed" "$category" "$description"
642:     done
643: }
644: 
645: # Get feed statistics
646: nftban_feeds_get_stats() {
647:     local all_feeds
648:     all_feeds=$(nftban_feeds_discover_all)
649: 
650:     local total_count=0
651:     local enabled_count=0
652:     local total_ips=0
653: 
654:     for feed in $all_feeds; do
655:         total_count=$((total_count + 1))
656: 
657:         local enabled
658:         enabled=$(nftban_feeds_get_property "$feed" "ENABLED")
659: 
660:         if [[ "$enabled" == "true" ]]; then
661:             enabled_count=$((enabled_count + 1))
662: 
663:             # Convert to lowercase for filename (files are saved as lowercase)
664:             local feed_lowercase
665:             feed_lowercase=$(echo "$feed" | tr '[:upper:]' '[:lower:]')
666:             local feed_file="${NFTBAN_FEEDS_STORAGE_DIR}/${feed_lowercase}.txt"
667:             if [[ -f "$feed_file" ]]; then
668:                 local count
669:                 count=$(wc -l < "$feed_file")
670:                 ((total_ips += count))
671:             fi
672:         fi
673:     done
674: 
675:     echo "$enabled_count/$total_count feeds enabled | $total_ips total IPs"
676: }
677: 
678: # Export functions
679: export -f nftban_feeds_discover_all
680: export -f nftban_feeds_get_property
681: export -f nftban_feeds_set_property
682: export -f nftban_feeds_get_by_category
683: export -f nftban_feeds_get_categories
684: export -f nftban_feeds_enable
685: export -f nftban_feeds_disable
686: export -f nftban_feeds_update_single
687: export -f nftban_feeds_update_all
688: export -f nftban_feeds_sync_to_nftables
689: export -f nftban_feeds_list_simple
690: export -f nftban_feeds_get_stats
691: export -f nftban_feeds_log
692: 
693: # =============================================================================
694: # TASK QUEUE INTEGRATION
695: # =============================================================================
696: # Source task queue at end to make nftban_queue_add available for async operations
697: # Guard above prevents circular dependency (task_queue.sh sources this file)
698: # shellcheck source=/dev/null
699: source "${NFTBAN_LIB_DIR:-/usr/lib/nftban}/helpers/nftban_task_queue.sh" 2>/dev/null || true
</file>

<file path="cli/lib/nftban/core/nftban_file_ops.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - Atomic File Operations Module
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Atomic file write operations to prevent race conditions
  7: #
  8: # meta:name=nftban_file_ops
  9: # meta:type=core
 10: # meta:header=Atomic File Operations
 11: # meta:version=1.0.0
 12: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 13: # meta:homepage=https://nftban.com
 14: #
 15: # **Description & Purpose**
 16: # meta:description=Atomic file write operations to prevent race conditions and corruption
 17: # meta:input=File content via stdin
 18: # meta:output=Safely written files with preserved permissions
 19: #
 20: # **Inventory & Requirements**
 21: # meta:depends=bash,mktemp,mv
 22: #
 23: # meta:created_date=2025-11-05
 24: # meta:updated_date=2025-11-24
 25: # =============================================================================
 26: 
 27: IFS=$'\n\t'
 28: umask 027
 29: 
 30: # Replace entire file atomically with content from stdin
 31: # Usage: echo "full new content" | nftban_atomic_write /path/to/file
 32: nftban_atomic_write() {
 33:   local target="$1"
 34:   local dir base tmp mode owner group
 35:   dir="$(dirname -- "$target")"
 36:   base="$(basename -- "$target")"
 37: 
 38:   # Ensure dir exists & is writable
 39:   [[ -d "$dir" ]] || { echo "No such directory: $dir" >&2; return 1; }
 40:   [[ -w "$dir" ]] || { echo "Directory not writable: $dir" >&2; return 1; }
 41: 
 42:   # Determine attributes (if file exists)
 43:   if [[ -e "$target" ]]; then
 44:     mode="$(stat -c '%a' -- "$target")"
 45:     owner="$(stat -c '%u' -- "$target")"
 46:     group="$(stat -c '%g' -- "$target")"
 47:   else
 48:     # Sensible defaults for config files
 49:     mode="0644"; owner="0"; group="0"
 50:   fi
 51: 
 52:   # Temp in same fs for atomic rename
 53:   tmp="$(mktemp --tmpdir="$dir" ".${base}.tmp.XXXXXX")" || { echo "mktemp failed" >&2; return 1; }
 54:   # Ensure cleanup on any failure
 55:   cleanup() { rm -f -- "$tmp" || true; }
 56:   trap cleanup EXIT
 57: 
 58:   # Write stdin to temp
 59:   # Use dd with oflag=dsync for durability without huge penalty
 60:   dd of="$tmp" oflag=dsync status=none
 61: 
 62:   # Set attributes on temp (before move)
 63:   chown "${owner}:${group}" "$tmp"
 64:   chmod "${mode}" "$tmp"
 65:   # Preserve SELinux context (if source exists) or restore default
 66:   if command -v chcon >/dev/null 2>&1 && [[ -e "$target" ]]; then
 67:     chcon --reference="$target" "$tmp" 2>/dev/null || true
 68:   elif command -v restorecon >/dev/null 2>&1; then
 69:     restorecon "$tmp" 2>/dev/null || true
 70:   fi
 71: 
 72:   # Atomic replace
 73:   mv -f -- "$tmp" "$target"
 74: 
 75:   # fsync dir entry to be extra safe (Linux-only)
 76:   if command -v python3 >/dev/null 2>&1; then
 77:     python3 - <<PY || true
 78: import os, sys
 79: fd=os.open("$dir", os.O_DIRECTORY)
 80: try:
 81:   os.fsync(fd)
 82: finally:
 83:   os.close(fd)
 84: PY
 85:   fi
 86: 
 87:   trap - EXIT
 88:   cleanup
 89: }
 90: 
 91: # Append to file atomically (reads existing file + appends stdin)
 92: # Usage:
 93: #   nftban_atomic_append /path/to/file <<<"one new line"
 94: #   echo "a=b" | nftban_atomic_append /path/file
 95: nftban_atomic_append() {
 96:   local target="$1"
 97:   shift || true
 98: 
 99:   local dir base tmp mode owner group
100:   dir="$(dirname -- "$target")"
101:   base="$(basename -- "$target")"
102: 
103:   [[ -d "$dir" ]] || { echo "No such directory: $dir" >&2; return 1; }
104:   [[ -w "$dir" ]] || { echo "Directory not writable: $dir" >&2; return 1; }
105: 
106:   if [[ -e "$target" ]]; then
107:     mode="$(stat -c '%a' -- "$target")"
108:     owner="$(stat -c '%u' -- "$target")"
109:     group="$(stat -c '%g' -- "$target")"
110:   else
111:     mode="0644"; owner="0"; group="0"
112:     # Ensure file exists to preserve ordering comments if needed
113:     : > "$target"
114:     chown "${owner}:${group}" "$target"
115:     chmod "${mode}" "$target"
116:   fi
117: 
118:   tmp="$(mktemp --tmpdir="$dir" ".${base}.tmp.XXXXXX")" || { echo "mktemp failed" >&2; return 1; }
119:   cleanup() { rm -f -- "$tmp" || true; }
120:   trap cleanup EXIT
121: 
122:   # Build new file: existing + stdin
123:   cat -- "$target" >"$tmp"
124:   # Append stdin (if a single line param was passed via args, print that; else read stdin)
125:   if [[ $# -gt 0 ]]; then
126:     printf '%s\n' "$*" >>"$tmp"
127:   else
128:     cat >>"$tmp"
129:   fi
130: 
131:   chown "${owner}:${group}" "$tmp"
132:   chmod "${mode}" "$tmp"
133:   if command -v chcon >/dev/null 2>&1 && [[ -e "$target" ]]; then
134:     chcon --reference="$target" "$tmp" 2>/dev/null || true
135:   elif command -v restorecon >/dev/null 2>&1; then
136:     restorecon "$tmp" 2>/dev/null || true
137:   fi
138: 
139:   mv -f -- "$tmp" "$target"
140: 
141:   if command -v python3 >/dev/null 2>&1; then
142:     python3 - <<PY || true
143: import os, sys
144: fd=os.open("$dir", os.O_DIRECTORY)
145: try:
146:   os.fsync(fd)
147: finally:
148:   os.close(fd)
149: PY
150:   fi
151: 
152:   trap - EXIT
153:   cleanup
154: }
</file>

<file path="cli/lib/nftban/core/nftban_geoip_download.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - GeoIP Database Download Module
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Download and update MaxMind GeoLite2 database
  7: #
  8: # meta:name=nftban_geoip_download
  9: # meta:type=core
 10: # meta:header=GeoIP Database Management
 11: # meta:version=1.0.0
 12: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 13: # meta:homepage=https://nftban.com
 14: #
 15: # **Description & Purpose**
 16: # meta:description=Manages MaxMind GeoIP database download and updates
 17: # meta:input=MaxMind license key from config
 18: # meta:output=Downloaded GeoLite2-City.mmdb database
 19: #
 20: # **Inventory & Requirements**
 21: # meta:depends=bash,curl,tar,nftban_output.sh
 22: #
 23: # meta:created_date=2025-11-05
 24: # meta:updated_date=2025-11-24
 25: # =============================================================================
 26: 
 27: 
 28: # =============================================================================
 29: # CONFIGURATION
 30: # =============================================================================
 31: 
 32: # NFTBAN_LIB_DIR is set by the calling script (cmd_geoip.sh, etc.)
 33: # Don't set it here - just use it with fallback
 34: 
 35: # Load strict mode library
 36: # shellcheck source=/usr/lib/nftban/lib/strict.sh
 37: if [[ -f "${NFTBAN_LIB_DIR:-/usr/lib/nftban}/lib/strict.sh" ]]; then
 38:     source "${NFTBAN_LIB_DIR:-/usr/lib/nftban}/lib/strict.sh"
 39: else
 40:     # Fallback to manual strict mode
 41:     set -Eeuo pipefail
 42: fi
 43: 
 44: # Load version library
 45: # shellcheck source=/usr/lib/nftban/lib/version.sh
 46: if [[ -f "${NFTBAN_LIB_DIR:-/usr/lib/nftban}/lib/version.sh" ]]; then
 47:     source "${NFTBAN_LIB_DIR:-/usr/lib/nftban}/lib/version.sh"
 48: fi
 49: readonly NFTBAN_CONF_DIR="${NFTBAN_CONF_DIR:-/etc/nftban}"
 50: 
 51: # Load GeoIP configuration
 52: if [[ -f "${NFTBAN_CONF_DIR}/conf.d/geoip.conf" ]]; then
 53:     # shellcheck source=/dev/null
 54:     source "${NFTBAN_CONF_DIR}/conf.d/geoip.conf"
 55: fi
 56: 
 57: # Load output module
 58: if [[ ! $(type -t nftban_render_banner) == "function" ]]; then
 59:     if [[ -f "${NFTBAN_LIB_DIR:-/usr/lib/nftban}/core/nftban_output.sh" ]]; then
 60:         # shellcheck source=/dev/null
 61:         source "${NFTBAN_LIB_DIR:-/usr/lib/nftban}/core/nftban_output.sh"
 62:     fi
 63: fi
 64: 
 65: # =============================================================================
 66: # FUNCTIONS
 67: # =============================================================================
 68: 
 69: # Check if license key is configured
 70: _check_license_key() {
 71:     if [[ -z "${MAXMIND_LICENSE_KEY:-}" ]]; then
 72:         echo "[ERROR] MaxMind license key not configured"
 73:         echo ""
 74:         echo "Please add your license key to:"
 75:         echo "  /etc/nftban/conf.d/geoip.conf"
 76:         echo ""
 77:         echo "Get a free license key at:"
 78:         echo "  https://www.maxmind.com/en/geolite2/signup"
 79:         return 1
 80:     fi
 81:     return 0
 82: }
 83: 
 84: # Download GeoIP database
 85: _download_geoip() {
 86:     local license_key="${MAXMIND_LICENSE_KEY}"
 87:     local edition="${GEOIP_EDITION:-GeoLite2-City}"
 88:     local db_url="${GEOIP_DOWNLOAD_URL:-https://download.maxmind.com/app/geoip_download}"
 89:     local timeout="${GEOIP_TIMEOUT:-300}"
 90:     local db_dir="${GEOIP_DATABASE_DIR:-/var/lib/nftban/geoip}"
 91:     local tmp_file="/tmp/geoip-${edition}-$$.tar.gz"
 92: 
 93:     echo "[INFO] Downloading ${edition} database..."
 94:     echo "[DEBUG] URL: ${db_url}"
 95: 
 96:     # Build download URL with parameters
 97:     local download_url="${db_url}?edition_id=${edition}&license_key=${license_key}&suffix=tar.gz"
 98: 
 99:     # Download database
100:     if curl --proto '=https' --tlsv1.2 -sSf \
101:             --connect-timeout 30 \
102:             --max-time "${timeout}" \
103:             -o "${tmp_file}" \
104:             "${download_url}"; then
105:         echo "[INFO] Download complete"
106:     else
107:         echo "[ERROR] Download failed"
108:         rm -f "${tmp_file}"
109:         return 1
110:     fi
111: 
112:     # Create directory if it doesn't exist
113:     if [[ ! -d "${db_dir}" ]]; then
114:         mkdir -p "${db_dir}"
115:         chown nftban:nftban "${db_dir}"
116:         chmod 750 "${db_dir}"
117:     fi
118: 
119:     # Extract database
120:     echo "[INFO] Extracting database..."
121:     local extract_dir="/tmp/geoip-extract-$$"
122:     mkdir -p "${extract_dir}"
123: 
124:     if tar -xzf "${tmp_file}" -C "${extract_dir}"; then
125:         echo "[INFO] Extraction complete"
126:     else
127:         echo "[ERROR] Extraction failed"
128:         rm -rf "${tmp_file}" "${extract_dir}"
129:         return 1
130:     fi
131: 
132:     # Find and move .mmdb file
133:     local mmdb_file
134:     mmdb_file=$(find "${extract_dir}" -name "*.mmdb" | head -1)
135:     if [[ -z "${mmdb_file}" ]]; then
136:         echo "[ERROR] Database file not found in archive"
137:         rm -rf "${tmp_file}" "${extract_dir}"
138:         return 1
139:     fi
140: 
141:     # Move database to final location
142:     local db_file
143:     db_file="${db_dir}/$(basename ${edition}).mmdb"
144:     mv "${mmdb_file}" "${db_file}"
145:     chown nftban:nftban "${db_file}"
146:     chmod 640 "${db_file}"
147: 
148:     echo "[INFO] Database installed: ${db_file}"
149:     echo "[INFO] File size: $(du -h ${db_file} | cut -f1)"
150: 
151:     # Cleanup
152:     rm -rf "${tmp_file}" "${extract_dir}"
153: 
154:     return 0
155: }
156: 
157: # Check database status
158: _check_database() {
159:     local db_file="${GEOIP_DATABASE:-/var/lib/nftban/geoip/GeoLite2-City.mmdb}"
160: 
161:     if [[ ! -f "${db_file}" ]]; then
162:         echo "[WARNING] GeoIP database not found: ${db_file}"
163:         return 1
164:     fi
165: 
166:     echo "[INFO] GeoIP database found"
167:     echo "[INFO] Location: ${db_file}"
168:     echo "[INFO] Size: $(du -h ${db_file} | cut -f1)"
169:     echo "[INFO] Modified: $(stat -c %y ${db_file} | cut -d. -f1)"
170: 
171:     # Check if database is old (> 30 days)
172:     local mtime
173:     mtime=$(stat -c %Y "${db_file}")
174:     local now
175:     now=$(date +%s)
176:     local age
177:     age=$(( (now - mtime) / 86400 ))
178: 
179:     if [[ ${age} -gt 30 ]]; then
180:         echo "[WARNING] Database is ${age} days old (recommended: update monthly)"
181:     else
182:         echo "[INFO] Database age: ${age} days (OK)"
183:     fi
184: 
185:     return 0
186: }
187: 
188: # =============================================================================
189: # MAIN FUNCTIONS
190: # =============================================================================
191: 
192: nftban_geoip_download() {
193:     echo "═══════════════════════════════════════════════════════════════"
194:     echo "  MaxMind GeoIP Database Download"
195:     echo "═══════════════════════════════════════════════════════════════"
196:     echo ""

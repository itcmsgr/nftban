200: # Add jump to portscan chain from input chain
201: nftban_portscan_classic_add_jump() {
202:     local table_ipv4="${PORTSCAN_NFT_TABLE_IPV4:-ip nftban}"
203:     local table_ipv6="${PORTSCAN_NFT_TABLE_IPV6:-ip6 nftban}"

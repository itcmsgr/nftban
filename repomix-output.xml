 31: # Purpose: Handle mail-related CLI commands
 32: #
 33: # meta:name=cmd_mail
 34: # meta:type=cli
 35: # meta:header=Mail CLI Command
 36: # meta:version=1.0.0
 37: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 38: # meta:homepage=https://nftban.com
 39: #
 40: # **Description & Purpose**
 41: # meta:description=CLI interface for mail module commands
 42: # meta:input=Command line arguments for mail operations
 43: # meta:output=Mail command results
 44: #
 45: # **Inventory & Requirements**
 46: # meta:depends=bash,nftban_mail.sh
 47: #
 48: # meta:created_date=2025-11-05
 49: # meta:updated_date=2025-11-24
 50: # =============================================================================
 51: 
 52: 
 53: # Strict mode
 54: IFS=$'\n\t'
 55: umask 027
 56: 
 57: # Load dependencies
 58: SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
 59: LIB_DIR="$(dirname "$SCRIPT_DIR")"
 60: 
 61: # Load mail core module if not already loaded
 62: if [[ ! $(type -t nftban_mail_check_status) == "function" ]]; then
 63:     if [[ -f "${LIB_DIR}/core/nftban_mail.sh" ]]; then
 64:         # shellcheck source=/dev/null
 65:         source "${LIB_DIR}/core/nftban_mail.sh"
 66:     else
 67:         echo "ERROR: nftban_mail.sh not found at ${LIB_DIR}/core" >&2
 68:         exit 1
 69:     fi
 70: fi
 71: 
 72: # =============================================================================
 73: 
 74: # MAIL COMMAND HANDLER
 75: # =============================================================================
 76: 
 77: 
 78: nftban_cmd_mail() {
 79:     # Handle mail subcommands
 80:     # Args: $@ = mail subcommand and arguments
 81: 
 82:     local subcmd="${1:-help}"
 83:     shift || true
 84: 
 85:     # Load output module for banner (used in help)
 86:     if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_output.sh" ]]; then
 87:         # shellcheck source=/dev/null
 88:         source "${NFTBAN_LIB_DIR}/core/nftban_output.sh"
 89:     fi
 90: 
 91:     case "$subcmd" in
 92:         status)
 93:             # Check mail system status
 94:             nftban_mail_check_status
 95:             return $?
 96:             ;;
 97: 
 98:         port-status)
 99:             # Check mail ports in firewall
100:             nftban_mail_check_ports
101:             return $?
102:             ;;
103: 
104:         test)
105:             # Send test email
106:             local recipient="${1:-}"
107:             nftban_mail_send_test "$recipient"
108:             return $?
109:             ;;
110: 
111:         help|--help|-h)
112:             # Show help
113:             nftban_mail_show_help
114:             return 0
115:             ;;
116: 
117:         *)
118:             # Default: send email
119:             # Args: $subcmd = content (text or file)
120:             #       $1 = recipient (optional)
121:             local content="$subcmd"
122:             local recipient="${1:-}"
123: 
124:             if [[ -z "$content" ]]; then
125:                 echo "Error: No content specified" >&2
126:                 echo "Usage: nftban mail {content} [recipient]" >&2
127:                 echo "       nftban mail help" >&2
128:                 return 1
129:             fi
130: 
131:             nftban_mail_send "$content" "$recipient"
132:             return $?
133:             ;;
134:     esac
135: }
136: 
137: # Export function for auto-loading
138: export -f nftban_cmd_mail

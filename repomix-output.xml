273: 
274: 	fmt.Println(version.BannerWithEmoji("🔄", "Update Trust Feeds"))
275: 	fmt.Println(strings.Repeat("=", 70))
276: 	fmt.Println()
277: 
278: 	// Get enabled status
279: 	enabledMap := getTrustEnabledStatus(configPath)
280: 
281: 	enabledFeeds := []TrustConfig{}
282: 	for _, tf := range builtInTrustFeeds {
283: 		if enabledMap[tf.Name] {
284: 			enabledFeeds = append(enabledFeeds, tf)
285: 		}
286: 	}
287: 
288: 	fmt.Printf("Step 1: Found %d trust feeds (%d enabled)\n", len(builtInTrustFeeds), len(enabledFeeds))
289: 	fmt.Println()

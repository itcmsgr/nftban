1051: 	fmt.Println(strings.Repeat("=", 70))
1052: 	fmt.Println()
1053: 
1054: 	// Create cache
1055: 	cache, err := stats.NewCache()
1056: 	if err != nil {
1057: 		return fmt.Errorf("failed to create cache: %w", err)
1058: 	}
1059: 
1060: 	// Get SIDs from last 24 hours
1061: 	recentSIDs := cache.GetRecentSIDs(24 * time.Hour)
1062: 
1063: 	if len(recentSIDs) == 0 {
1064: 		fmt.Println("⚠️  No recent SID activity in the last 24 hours")
1065: 		fmt.Println()
1066: 		return nil
1067: 	}
1068: 
1069: 	// Display table
1070: 	w := tabwriter.NewWriter(os.Stdout, 0, 0, 2, ' ', 0)
1071: 	fmt.Fprintln(w, "SID\tLast Trigger\tTriggers\tSources\tSignature")
1072: 	fmt.Fprintln(w, "---\t------------\t--------\t-------\t---------")
1073: 
1074: 	for _, sidStats := range recentSIDs {
1075: 		if len(recentSIDs) > 20 && sidStats != recentSIDs[len(recentSIDs)-1] {
1076: 			continue // Limit to 20 most recent
1077: 		}
1078: 
1079: 		signature := sidStats.Signature
1080: 		if len(signature) > 40 {
1081: 			signature = signature[:37] + "..."
1082: 		}
1083: 
1084: 		// Format time as relative (e.g., "5m ago")
1085: 		timeAgo := time.Since(sidStats.LastTrigger)
1086: 		var timeStr string
1087: 		if timeAgo < time.Minute {
1088: 			timeStr = fmt.Sprintf("%ds ago", int(timeAgo.Seconds()))
1089: 		} else if timeAgo < time.Hour {
1090: 			timeStr = fmt.Sprintf("%dm ago", int(timeAgo.Minutes()))
1091: 		} else {
1092: 			timeStr = fmt.Sprintf("%dh ago", int(timeAgo.Hours()))
1093: 		}
1094: 
1095: 		fmt.Fprintf(w, "%s\t%s\t%d\t%d\t%s\n",
1096: 			sidStats.SID,
1097: 			timeStr,
1098: 			sidStats.TriggerCount,
1099: 			sidStats.SourceCount,
1100: 			signature,
1101: 		)
1102: 	}
1103: 	w.Flush()
1104: 	fmt.Println()
1105: 
1106: 	return nil
1107: }

 28: // getDefaultPaths returns default paths from central config
 29: // NO FALLBACK - paths must come from /etc/nftban/nftban.conf
 30: func getDefaultPaths() (configDir, logDir string) {
 31: 	globalCfg := nftbanconf.MustLoad()
 32: 	return globalCfg.ConfigDir, globalCfg.LogDir
 33: }
 34: 
 35: // Load reads configuration from file
 36: func Load(path string) (*Config, error) {
 37: 	// Get paths from central config
 38: 	configDir, logDir := getDefaultPaths()
 39: 
 40: 	// Default configuration - use central config paths
 41: 	cfg := &Config{
 42: 		Port:             3940,
 43: 		TLSCert:          configDir + "/ssl/cert.pem",
 44: 		TLSKey:           configDir + "/ssl/key.pem",
 45: 		JWTSecret:        generateJWTSecret(),
 46: 		SessionTimeout:   60,
 47: 		IPWhitelistFile:  configDir + "/whitelist.d/ui-access.conf",
 48: 		AuditLogFile:     logDir + "/ui-access.log",
 49: 		RequiredGroup:    "nftban-cli", // Web GUI users must be in nftban-cli group
 50: 		BlockRootLogin:   true,
 51: 		MaxLoginAttempts: 5,
 52: 		LockoutDuration:  15,
 53: 	}
 54: 
 55: 	// Try to load from file
 56: 	file, err := os.Open(path)
 57: 	if err != nil {
 58: 		// If file doesn't exist, use defaults
 59: 		if os.IsNotExist(err) {
 60: 			return cfg, nil
 61: 		}
 62: 		return nil, fmt.Errorf("failed to open config file: %w", err)
 63: 	}
 64: 	defer file.Close()
 65: 
 66: 	// Parse configuration file
 67: 	scanner := bufio.NewScanner(file)
 68: 	lineNum := 0
 69: 	for scanner.Scan() {
 70: 		lineNum++
 71: 		line := strings.TrimSpace(scanner.Text())
 72: 
 73: 		// Skip comments and empty lines
 74: 		if line == "" || strings.HasPrefix(line, "#") {
 75: 			continue
 76: 		}
 77: 
 78: 		// Parse key=value (supports both KEY=value and key = "value" formats)
 79: 		parts := strings.SplitN(line, "=", 2)
 80: 		if len(parts) != 2 {
 81: 			continue
 82: 		}
 83: 
 84: 		key := strings.TrimSpace(parts[0])
 85: 		value := strings.TrimSpace(parts[1])
 86: 		// Remove surrounding quotes (single or double)
 87: 		value = strings.Trim(value, "\"'")
 88: 
 89: 		// Normalize key to uppercase for case-insensitive matching
 90: 		keyUpper := strings.ToUpper(key)
 91: 
 92: 		// Set configuration values (case-insensitive key matching)
 93: 		switch keyUpper {
 94: 		case "PORT":
 95: 			if port, err := strconv.Atoi(value); err == nil {
 96: 				cfg.Port = port
 97: 			}
 98: 		case "TLS_CERT", "CERT":
 99: 			cfg.TLSCert = value
100: 		case "TLS_KEY", "KEY":
101: 			cfg.TLSKey = value
102: 		case "JWT_SECRET":
103: 			if value != "" {
104: 				cfg.JWTSecret = value
105: 			}
106: 		case "JWT_SECRET_FILE":
107: 			// Load JWT secret from file (preferred for security)
108: 			if value != "" {
109: 				secretData, err := os.ReadFile(value)
110: 				if err == nil {
111: 					// Trim whitespace/newlines from secret
112: 					cfg.JWTSecret = strings.TrimSpace(string(secretData))
113: 				}
114: 			}
115: 		case "SESSION_TIMEOUT":
116: 			if timeout, err := strconv.Atoi(value); err == nil {
117: 				cfg.SessionTimeout = timeout
118: 			}
119: 		case "IP_WHITELIST_FILE", "IP_WHITELIST":
120: 			cfg.IPWhitelistFile = value
121: 		case "AUDIT_LOG_FILE", "LOG_FILE":
122: 			cfg.AuditLogFile = value
123: 		case "REQUIRED_GROUP":
124: 			cfg.RequiredGroup = value
125: 		case "BLOCK_ROOT_LOGIN":
126: 			cfg.BlockRootLogin = (value == "true" || value == "yes" || value == "1")
127: 		case "MAX_LOGIN_ATTEMPTS", "RATE_LIMIT_REQUESTS":
128: 			if attempts, err := strconv.Atoi(value); err == nil {
129: 				cfg.MaxLoginAttempts = attempts
130: 			}
131: 		case "LOCKOUT_DURATION", "RATE_LIMIT_WINDOW":
132: 			if duration, err := strconv.Atoi(value); err == nil {
133: 				cfg.LockoutDuration = duration
134: 			}
135: 		}
136: 	}
137: 
138: 	if err := scanner.Err(); err != nil {
139: 		return nil, fmt.Errorf("error reading config file: %w", err)
140: 	}
141: 
142: 	return cfg, nil
143: }
144: 
145: // generateJWTSecret creates a random JWT secret if none is provided
146: func generateJWTSecret() string {
147: 	// In production, this should be read from a secure source
148: 	// For now, generate a random string
149: 	// This will be replaced with proper secret management
150: 	return "CHANGE_ME_IN_PRODUCTION_CONFIG"
151: }

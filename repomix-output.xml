<file path="uninstall.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan Uninstall Script
  4: # =============================================================================
  5: # Purpose: Complete removal of NFTBan from system
  6: # Usage: ./uninstall.sh [--purge]
  7: #        --purge: Remove ALL data including configs, logs, and databases
  8: # =============================================================================
  9: 
 10: set -euo pipefail
 11: 
 12: # Colors for output
 13: GREEN='\033[0;32m'
 14: BLUE='\033[0;34m'
 15: YELLOW='\033[1;33m'
 16: RED='\033[0;31m'
 17: NC='\033[0m' # No Color
 18: 
 19: log()   { echo -e "${BLUE}[UNINSTALL]${NC} $*"; }
 20: ok()    { echo -e "${GREEN}[  OK   ]${NC} $*"; }
 21: warn()  { echo -e "${YELLOW}[ WARN  ]${NC} $*"; }
 22: error() { echo -e "${RED}[ ERROR ]${NC} $*"; }
 23: 
 24: # Get script directory
 25: SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
 26: cd "$SCRIPT_DIR"
 27: 
 28: # Parse options
 29: PURGE_DATA=false
 30: if [[ "${1:-}" == "--purge" ]]; then
 31:     PURGE_DATA=true
 32: fi
 33: 
 34: # =============================================================================
 35: # LOAD SCHEMA FOR TABLE/SET NAMES
 36: # =============================================================================
 37: 
 38: load_schema() {
 39:     if [[ -f "$SCRIPT_DIR/cli/lib/nftban/lib/nft_schema.sh" ]]; then
 40:         source "$SCRIPT_DIR/cli/lib/nftban/lib/nft_schema.sh"
 41:         ok "Loaded NFT schema"
 42:     else
 43:         warn "NFT schema not found, using fallback table names"
 44:         # Fallback definitions
 45:         export NFTBAN_TABLE_IPV4="ip nftban"
 46:         export NFTBAN_TABLE_IPV6="ip6 nftban"
 47:     fi
 48: }
 49: 
 50: # =============================================================================
 51: # LOAD DISTRO CONFIG FOR SERVICE NAMES
 52: # =============================================================================
 53: 
 54: load_distro_config() {
 55:     if [[ -f "$SCRIPT_DIR/cli/lib/nftban/lib/nftban_distro_config.sh" ]]; then
 56:         export NFTBAN_DISTRO_CONF_DIR="$SCRIPT_DIR/etc/nftban/distros"
 57:         source "$SCRIPT_DIR/cli/lib/nftban/lib/nftban_distro_config.sh"
 58: 
 59:         if nftban_distro_init; then
 60:             ok "Loaded distro config: ${DISTRO_INFO[name]} ${DISTRO_INFO[version]}"
 61:         else
 62:             warn "Failed to load distro config, using defaults"
 63:         fi
 64:     else
 65:         warn "Distro config system not found, using defaults"
 66:     fi
 67: }
 68: 
 69: # =============================================================================
 70: # UNINSTALL FUNCTIONS
 71: # =============================================================================
 72: 
 73: uninstall_services() {
 74:     log "Stopping and disabling NFTBan services..."
 75: 
 76:     # List of service patterns to remove
 77:     local service_patterns=(
 78:         "nftban-*.service"
 79:         "nftban-*.timer"
 80:     )
 81: 
 82:     local stopped=0
 83: 
 84:     # Find and stop all NFTBan services
 85:     for pattern in "${service_patterns[@]}"; do
 86:         # Get list of matching units
 87:         local units
 88:         units=$(systemctl list-units --all --no-legend "$pattern" 2>/dev/null | awk '{print $1}' || true)
 89: 
 90:         for unit in $units; do
 91:             [[ -z "$unit" ]] && continue
 92: 
 93:             # Stop service
 94:             if systemctl is-active --quiet "$unit" 2>/dev/null; then
 95:                 echo "  Stopping: $unit"
 96:                 systemctl stop "$unit" 2>/dev/null || true
 97:                 stopped=$((stopped + 1))
 98:             fi
 99: 
100:             # Disable service
101:             if systemctl is-enabled --quiet "$unit" 2>/dev/null; then
102:                 echo "  Disabling: $unit"
103:                 systemctl disable "$unit" 2>/dev/null || true
104:             fi
105:         done
106:     done
107: 
108:     if [[ $stopped -gt 0 ]]; then
109:         ok "Stopped $stopped service(s)"
110:     else
111:         ok "No running services found"
112:     fi
113: }
114: 
115: uninstall_systemd_units() {
116:     log "Removing systemd units..."
117: 
118:     local removed=0
119: 
120:     # Remove service and timer files
121:     for file in /etc/systemd/system/nftban-*.service /etc/systemd/system/nftban-*.timer; do
122:         if [[ -f "$file" ]]; then
123:             echo "  Removing: $(basename "$file")"
124:             rm -f "$file"
125:             removed=$((removed + 1))
126:         fi
127:     done
128: 
129:     # Reload systemd
130:     if [[ $removed -gt 0 ]]; then
131:         systemctl daemon-reload
132:         ok "Removed $removed systemd unit(s)"
133:     else
134:         ok "No systemd units found"
135:     fi
136: }
137: 
138: uninstall_binaries() {
139:     log "Removing binaries..."
140: 
141:     local removed=0
142:     local binaries=(
143:         "/usr/bin/nftban"
144:         "/usr/sbin/nftban-ui"
145:         "/usr/libexec/nftban-ui-auth"
146:         "/usr/lib/nftban"
147:     )
148: 
149:     for binary in "${binaries[@]}"; do
150:         if [[ -e "$binary" ]]; then
151:             echo "  Removing: $binary"
152:             rm -rf "$binary"
153:             removed=$((removed + 1))
154:         fi
155:     done
156: 
157:     if [[ $removed -gt 0 ]]; then
158:         ok "Removed $removed binary/library location(s)"
159:     else
160:         ok "No binaries found"
161:     fi
162: }
163: 
164: uninstall_bash_completion() {
165:     log "Removing bash completion..."
166: 
167:     if [[ -f "/usr/share/bash-completion/completions/nftban" ]]; then
168:         rm -f /usr/share/bash-completion/completions/nftban
169:         ok "Bash completion removed"
170:     else
171:         ok "No bash completion found"
172:     fi
173: }
174: 
175: uninstall_nftables() {
176:     log "Removing nftables rules..."
177: 
178:     local removed=0
179: 
180:     # Use schema-defined table names
181:     local tables=("${NFTBAN_TABLE_IPV4}" "${NFTBAN_TABLE_IPV6}")
182: 
183:     for table in "${tables[@]}"; do
184:         if nft list table "$table" >/dev/null 2>&1; then
185:             echo "  Deleting table: $table"
186:             nft delete table "$table" 2>/dev/null || true
187:             removed=$((removed + 1))
188:         fi
189:     done
190: 
191:     if [[ $removed -gt 0 ]]; then
192:         ok "Removed $removed nftables table(s)"
193:     else
194:         ok "No NFTBan nftables found"
195:     fi
196: 
197:     # Remove nftables.conf if it looks like NFTBan's
198:     if [[ -f "/etc/nftables.conf" ]] && grep -q "NFTBan" /etc/nftables.conf 2>/dev/null; then
199:         warn "NFTBan nftables.conf found at /etc/nftables.conf"
200:         echo "    Leaving in place (may contain user modifications)"
201:         echo "    Remove manually if needed: sudo rm /etc/nftables.conf"
202:     fi
203: }
204: 
205: uninstall_polkit() {
206:     log "Removing polkit policies..."
207: 
208:     if [[ -f "/usr/share/polkit-1/actions/com.nftban.auth.policy" ]]; then
209:         rm -f /usr/share/polkit-1/actions/com.nftban.auth.policy
210:         ok "Polkit policy removed"
211:     else
212:         ok "No polkit policy found"
213:     fi
214: }
215: 
216: uninstall_configs() {
217:     if [[ "$PURGE_DATA" == true ]]; then
218:         log "Purging configuration files..."
219: 
220:         if [[ -d "/etc/nftban" ]]; then
221:             echo "  Removing: /etc/nftban"
222:             rm -rf /etc/nftban
223:             ok "Configuration directory purged"
224:         else
225:             ok "No configuration directory found"
226:         fi
227:     else
228:         log "Keeping configuration files..."
229:         echo "    Config directory: /etc/nftban"
230:         echo "    (Use --purge to remove)"
231:         ok "Configuration preserved"
232:     fi
233: }
234: 
235: uninstall_data() {
236:     if [[ "$PURGE_DATA" == true ]]; then
237:         log "Purging data directories..."
238: 
239:         local data_dirs=(
240:             "/var/lib/nftban"
241:             "/var/log/nftban"
242:             "/var/cache/nftban"
243:         )
244: 
245:         local removed=0
246: 
247:         for dir in "${data_dirs[@]}"; do
248:             if [[ -d "$dir" ]]; then
249:                 echo "  Removing: $dir"
250:                 rm -rf "$dir"
251:                 removed=$((removed + 1))
252:             fi
253:         done
254: 
255:         if [[ $removed -gt 0 ]]; then
256:             ok "Purged $removed data directory/directories"
257:         else
258:             ok "No data directories found"
259:         fi
260:     else
261:         log "Keeping data directories..."
262:         echo "    Data: /var/lib/nftban"
263:         echo "    Logs: /var/log/nftban"
264:         echo "    Cache: /var/cache/nftban"
265:         echo "    (Use --purge to remove)"
266:         ok "Data preserved"
267:     fi
268: }
269: 
270: # =============================================================================
271: # MAIN UNINSTALL LOGIC
272: # =============================================================================
273: 
274: echo ""
275: log "════════════════════════════════════════════════════════════"
276: log "  NFTBan Uninstall"
277: log "════════════════════════════════════════════════════════════"
278: echo ""
279: 
280: # Check if running as root
281: if [[ $EUID -ne 0 ]]; then
282:     error "This script must be run as root"
283:     echo "Try: sudo $0 ${1:-}"
284:     exit 1
285: fi
286: 
287: # Show mode
288: if [[ "$PURGE_DATA" == true ]]; then
289:     warn "PURGE MODE: All data will be removed"
290: else
291:     log "STANDARD MODE: Configs and data will be preserved"

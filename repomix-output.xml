<file path="pkg/whitelist/loader.go">
  1: package whitelist
  2: 
  3: import (
  4: 	"fmt"
  5: 	"os"
  6: 	"path/filepath"
  7: 	"strings"
  8: 
  9: 	"github.com/itcmsgr/nftban/pkg/feeds"
 10: 	"github.com/itcmsgr/nftban/pkg/netutil"
 11: 	"github.com/itcmsgr/nftban/pkg/util"
 12: )
 13: 
 14: // LoadAllWhitelists loads IPs from all whitelist sources:
 15: // - /etc/nftban/whitelist.conf (main file)
 16: // - /etc/nftban/whitelist.d/*.conf (modular files)
 17: // Returns two sets: IPv4 and IPv6 addresses
 18: //
 19: // Now uses optimized generic Set type from pkg/util for:
 20: // - Zero memory overhead (struct{} instead of bool)
 21: // - Consistent API
 22: // - Better performance
 23: func LoadAllWhitelists(configDir string) (map[string]bool, map[string]bool, error) {
 24: 	// Use generic Set internally for efficiency
 25: 	ipv4Set := util.NewSet[string]()
 26: 	ipv6Set := util.NewSet[string]()
 27: 
 28: 	// 1. Load main whitelist.conf
 29: 	mainFile := filepath.Join(configDir, "whitelist.conf")
 30: 	if err := loadWhitelistFile(mainFile, ipv4Set, ipv6Set); err != nil {
 31: 		// Non-fatal: file might not exist yet
 32: 		fmt.Fprintf(os.Stderr, "Warning: Could not load %s: %v\n", mainFile, err)
 33: 	}
 34: 
 35: 	// 2. Load all files from whitelist.d/
 36: 	whitelistDir := filepath.Join(configDir, "whitelist.d")
 37: 	entries, err := os.ReadDir(whitelistDir)
 38: 	if err != nil {
 39: 		// Non-fatal: directory might not exist yet
 40: 		fmt.Fprintf(os.Stderr, "Warning: Could not read whitelist.d: %v\n", err)
 41: 
 42: 		// Convert to map[string]bool for backwards compatibility
 43: 		ipv4Map := make(map[string]bool, ipv4Set.Len())
 44: 		for ip := range ipv4Set {
 45: 			ipv4Map[ip] = true
 46: 		}
 47: 		ipv6Map := make(map[string]bool, ipv6Set.Len())
 48: 		for ip := range ipv6Set {
 49: 			ipv6Map[ip] = true
 50: 		}
 51: 		return ipv4Map, ipv6Map, nil
 52: 	}
 53: 
 54: 	for _, entry := range entries {
 55: 		if entry.IsDir() {
 56: 			continue
 57: 		}
 58: 		if !strings.HasSuffix(entry.Name(), ".conf") {
 59: 			continue
 60: 		}
 61: 
 62: 		filePath := filepath.Join(whitelistDir, entry.Name())
 63: 		if err := loadWhitelistFile(filePath, ipv4Set, ipv6Set); err != nil {
 64: 			fmt.Fprintf(os.Stderr, "Warning: Could not load %s: %v\n", filePath, err)
 65: 		}
 66: 	}
 67: 
 68: 	// Convert util.Set back to map[string]bool for backwards compatibility
 69: 	// TODO: Update all callers to use util.Set directly in future
 70: 	ipv4Map := make(map[string]bool, ipv4Set.Len())
 71: 	for ip := range ipv4Set {
 72: 		ipv4Map[ip] = true
 73: 	}
 74: 
 75: 	ipv6Map := make(map[string]bool, ipv6Set.Len())
 76: 	for ip := range ipv6Set {
 77: 		ipv6Map[ip] = true
 78: 	}
 79: 
 80: 	return ipv4Map, ipv6Map, nil
 81: }
 82: 
 83: // loadWhitelistFile loads IPs from a single whitelist file
 84: // Uses unified ParseFeedLine for consistent parsing across the codebase
 85: func loadWhitelistFile(filePath string, ipv4Set, ipv6Set util.Set[string]) error {
 86: 	lineNum := 0
 87: 
 88: 	return util.LoadLines(filePath, func(line string) error {
 89: 		lineNum++
 90: 
 91: 		// Use unified parser for consistent handling
 92: 		entry := feeds.ParseFeedLineSilent(line)
 93: 		if entry == nil {
 94: 			return nil // Skip empty/comment lines or invalid entries
 95: 		}
 96: 
 97: 		if entry.IPv4 {
 98: 			ipv4Set.Add(entry.Value)
 99: 		} else {
100: 			ipv6Set.Add(entry.Value)
101: 		}
102: 
103: 		return nil
104: 	})
105: }
106: 
107: // ValidateIP validates and normalizes an IP address
108: // Returns the normalized IP string and whether it's IPv4
109: // Delegates to netutil.ValidateAndNormalizeIP for consistency
110: func ValidateIP(ipStr string) (string, bool, error) {
111: 	return netutil.ValidateAndNormalizeIP(ipStr)
112: }
113: 
114: // AddIP adds an IP to the appropriate whitelist file
115: // Creates whitelist.d/99-manual.conf for manual additions
116: func AddIP(configDir string, ipStr string) error {
117: 	// Validate IP
118: 	normalizedIP, isIPv4, err := ValidateIP(ipStr)
119: 	if err != nil {
120: 		return err
121: 	}
122: 
123: 	// Target file: whitelist.d/99-manual.conf
124: 	whitelistDir := filepath.Join(configDir, "whitelist.d")
125: 	if err := os.MkdirAll(whitelistDir, 0750); err != nil {
126: 		return fmt.Errorf("failed to create whitelist.d: %w", err)
127: 	}
128: 
129: 	manualFile := filepath.Join(whitelistDir, "99-manual.conf")
130: 
131: 	// Check if IP already exists
132: 	ipv4Set, ipv6Set, err := LoadAllWhitelists(configDir)
133: 	if err != nil {
134: 		return fmt.Errorf("failed to load whitelists: %w", err)
135: 	}
136: 
137: 	if isIPv4 {
138: 		if ipv4Set[normalizedIP] {
139: 			return fmt.Errorf("IP %s already whitelisted", normalizedIP)
140: 		}
141: 	} else {
142: 		if ipv6Set[normalizedIP] {
143: 			return fmt.Errorf("IP %s already whitelisted", normalizedIP)
144: 		}
145: 	}
146: 
147: 	// Append to manual file
148: 	f, err := os.OpenFile(manualFile, os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0640)
149: 	if err != nil {
150: 		return fmt.Errorf("failed to open manual whitelist: %w", err)
151: 	}
152: 	defer f.Close()
153: 
154: 	// Add header if file is empty
155: 	stat, _ := f.Stat()
156: 	if stat.Size() == 0 {
157: 		fmt.Fprintf(f, "# Manual Whitelist Entries\n")
158: 		fmt.Fprintf(f, "# Added via nftban whitelist add command\n")
159: 		fmt.Fprintf(f, "# Format: One IP or CIDR per line\n\n")
160: 	}
161: 
162: 	fmt.Fprintf(f, "%s\n", normalizedIP)
163: 	return nil
164: }
165: 
166: // RemoveIP removes an IP from all whitelist files
167: // Note: This searches all .conf files and removes the IP
168: func RemoveIP(configDir string, ipStr string) error {
169: 	// Validate and normalize IP
170: 	normalizedIP, _, err := ValidateIP(ipStr)
171: 	if err != nil {
172: 		return err
173: 	}
174: 
175: 	removed := false
176: 
177: 	// Check main whitelist.conf
178: 	mainFile := filepath.Join(configDir, "whitelist.conf")
179: 	if err := removeIPFromFile(mainFile, normalizedIP); err == nil {
180: 		removed = true
181: 	}
182: 
183: 	// Check all files in whitelist.d/
184: 	whitelistDir := filepath.Join(configDir, "whitelist.d")
185: 	entries, err := os.ReadDir(whitelistDir)
186: 	if err == nil {
187: 		for _, entry := range entries {
188: 			if entry.IsDir() || !strings.HasSuffix(entry.Name(), ".conf") {
189: 				continue
190: 			}
191: 
192: 			// Skip system-critical files (00-system.conf, 01-nftban-init.conf)
193: 			if entry.Name() == "00-system.conf" || entry.Name() == "01-nftban-init.conf" {
194: 				continue
195: 			}
196: 
197: 			filePath := filepath.Join(whitelistDir, entry.Name())
198: 			if err := removeIPFromFile(filePath, normalizedIP); err == nil {
199: 				removed = true
200: 			}
201: 		}
202: 	}
203: 
204: 	if !removed {
205: 		return fmt.Errorf("IP %s not found in whitelist", normalizedIP)
206: 	}
207: 
208: 	return nil
209: }
210: 
211: // removeIPFromFile removes an IP from a specific file
212: // Uses util.RemoveLineFromFile for atomic file operations
213: func removeIPFromFile(filePath string, ipToRemove string) error {
214: 	removed, err := util.RemoveLineFromFile(filePath, func(line string) bool {
215: 		trimmed := strings.TrimSpace(line)
216: 		// Check if this line contains the IP (exact match or with whitespace/comment after)
217: 		return trimmed == ipToRemove ||
218: 			strings.HasPrefix(trimmed, ipToRemove+" ") ||
219: 			strings.HasPrefix(trimmed, ipToRemove+"\t")
220: 	})
221: 
222: 	if err != nil {
223: 		return err
224: 	}
225: 	if !removed {
226: 		return fmt.Errorf("IP not found in %s", filePath)
227: 	}
228: 	return nil
229: }
</file>


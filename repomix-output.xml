 62: nftban_cmd_health() {
 63:     # Main health command handler
 64:     # Args: subcommand [options]
 65: 
 66:     local subcommand="${1:-check}"
 67:     local json_mode=false
 68: 
 69:     # Check for --json flag in arguments
 70:     for arg in "$@"; do
 71:         [[ "$arg" == "--json" ]] && json_mode=true && break
 72:     done
 73: 
 74:     # Shift to get remaining args
 75:     shift || true
 76: 
 77:     # Load output module (for help banner)
 78:     if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_output.sh" ]]; then
 79:         # shellcheck source=/dev/null
 80:         source "${NFTBAN_LIB_DIR}/core/nftban_output.sh"
 81:     fi
 82: 
 83:     case "$subcommand" in
 84:         check|detailed|""|--auto-heal|--quiet)
 85:             # Default detailed health check (full terminal output)
 86:             # Handle --auto-heal or --quiet as first arg (pass it back to check)
 87:             if [[ "$subcommand" == "--auto-heal" || "$subcommand" == "--quiet" ]]; then
 88:                 set -- "$subcommand" "$@"
 89:             fi
 90:             if [[ "$json_mode" == "true" ]]; then
 91:                 nftban_health_cmd_json "$@"
 92:             else
 93:                 nftban_health_cmd_check "$@"
 94:             fi
 95:             ;;
 96:         summary)
 97:             # One-line summary
 98:             nftban_health_cmd_summary "$@"
 99:             ;;
100:         json|--json)
101:             # JSON output (backward compatibility)
102:             nftban_health_cmd_json "$@"
103:             ;;
104:         report)
105:             nftban_health_cmd_report "$@"
106:             ;;
107:         fix|enforce)
108:             nftban_health_cmd_fix "$@"
109:             ;;
110:         services)
111:             nftban_health_cmd_services "$@"
112:             ;;
113:         modules)
114:             nftban_health_cmd_modules "$@"
115:             ;;
116:         binaries)
117:             nftban_health_cmd_binaries "$@"
118:             ;;
119:         permissions)
120:             nftban_health_cmd_permissions "$@"
121:             ;;
122:         geoip)
123:             nftban_health_cmd_geoip "$@"
124:             ;;
125:         install|verify)
126:             nftban_health_cmd_install "$@"
127:             ;;
128:         help|--help|-h)
129:             nftban_health_cmd_help
130:             ;;
131:         *)
132:             echo "ERROR: Unknown health command: $subcommand" >&2
133:             echo "Run 'nftban health help' for usage information" >&2
134:             return 1
135:             ;;
136:     esac
137: }

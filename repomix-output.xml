<file path="cmd/nftban-ui/web/static/js/app.js">
  1: // /web/static/js/app.js
  2: // NFTBan SPA loader + theme + backend wiring
  3: 
  4: (() => {
  5:   const root = document.documentElement;
  6:   const navItems = document.querySelectorAll(".nav-item");
  7:   const pageContainer = document.getElementById("page-container");
  8:   const themeToggleBtn = document.getElementById("theme-toggle");
  9:   const themeIcon = themeToggleBtn.querySelector("i");
 10: 
 11:   // In-memory cache of loaded pages
 12:   const pageCache = {};
 13: 
 14:   // -----------------------------
 15:   // THEME HANDLING
 16:   // -----------------------------
 17:   function applyTheme(theme) {
 18:     root.setAttribute("data-theme", theme);
 19:     localStorage.setItem("nftban-theme", theme);
 20:     themeIcon.className = theme === "dark" ? "fa fa-moon" : "fa fa-sun";
 21:   }
 22: 
 23:   function initTheme() {
 24:     const saved = localStorage.getItem("nftban-theme");
 25:     const initial = saved || "dark";
 26:     applyTheme(initial);
 27:   }
 28: 
 29:   themeToggleBtn.addEventListener("click", () => {
 30:     const current =
 31:       root.getAttribute("data-theme") === "dark" ? "dark" : "light";
 32:     const next = current === "dark" ? "light" : "dark";
 33:     applyTheme(next);
 34:   });
 35: 
 36:   // -----------------------------
 37:   // PAGE LOADING
 38:   // -----------------------------
 39:   async function loadPage(pageName) {
 40:     // Handle deprecated pages - redirect to replacements
 41:     if (pageName === 'fail2ban') {
 42:       console.warn('[DEPRECATED] Fail2Ban removed in v1.0 - redirecting to Login Monitor');
 43:       pageName = 'login-monitor';
 44:       window.location.hash = 'login-monitor';
 45:     }
 46: 
 47:     // Mark active menu item
 48:     navItems.forEach((item) => {
 49:       item.classList.toggle("active", item.dataset.page === pageName);
 50:     });
 51: 
 52:     // Use cache if available
 53:     if (pageCache[pageName]) {
 54:       pageContainer.innerHTML = pageCache[pageName];
 55:       return;
 56:     }
 57: 
 58:     pageContainer.innerHTML =
 59:       '<div class="loading-message">Loading…</div>';
 60: 
 61:     try {
 62:       const res = await fetch(`/static/pages/${pageName}.html`, {
 63:         cache: "no-cache",
 64:       });
 65:       if (!res.ok) {
 66:         throw new Error(`HTTP ${res.status}`);
 67:       }
 68:       const html = await res.text();
 69:       pageCache[pageName] = html;
 70:       pageContainer.innerHTML = html;
 71: 
 72:       // Execute inline scripts (innerHTML doesn't execute them automatically)
 73:       const scripts = pageContainer.querySelectorAll('script');
 74:       scripts.forEach(oldScript => {
 75:         const newScript = document.createElement('script');
 76:         Array.from(oldScript.attributes).forEach(attr => {
 77:           newScript.setAttribute(attr.name, attr.value);
 78:         });
 79:         newScript.textContent = oldScript.textContent;
 80:         oldScript.parentNode.replaceChild(newScript, oldScript);
 81:       });
 82:     } catch (err) {
 83:       console.error("Error loading page", pageName, err);
 84:       pageContainer.innerHTML = `
 85:         <div class="error-message">
 86:           <h3>Failed to load <code>${pageName}.html</code></h3>
 87:           <p>${err.message}</p>
 88:         </div>
 89:       `;
 90:     }
 91:   }
 92: 
 93:   function initNav() {
 94:     navItems.forEach((item) => {
 95:       item.addEventListener("click", (e) => {
 96:         e.preventDefault();
 97:         const pageName = item.dataset.page;
 98:         if (!pageName) return;
 99:         loadPage(pageName);
100:         window.location.hash = pageName;
101:       });
102:     });
103:   }
104: 
105:   function initFromHashOrDefault() {
106:     const hash = window.location.hash.replace("#", "");
107:     const defaultPage = hash || "dashboard";
108:     loadPage(defaultPage);
109:   }
110: 
111:   window.addEventListener("hashchange", () => {
112:     const hash = window.location.hash.replace("#", "");
113:     if (!hash) return;
114:     loadPage(hash);
115:   });
116: 
117:   // -----------------------------
118:   // AUTHENTICATION
119:   // -----------------------------
120:   function showLogin() {
121:     document.getElementById("login-screen").style.display = "flex";
122:     document.getElementById("nftban-app").style.display = "none";
123:   }
124: 
125:   function showApp() {
126:     document.getElementById("login-screen").style.display = "none";
127:     document.getElementById("nftban-app").style.display = "block";
128:   }
129: 
130:   async function handleLogin(e) {
131:     e.preventDefault();
132: 
133:     const username = document.getElementById("login-username").value.trim();
134:     const password = document.getElementById("login-password").value.trim();
135:     const submitBtn = e.target.querySelector('button[type="submit"]');
136:     const errorEl = document.getElementById("login-error");
137: 
138:     if (!username || !password) {
139:       errorEl.textContent = "Please enter username and password";
140:       errorEl.style.display = "block";
141:       return;
142:     }
143: 
144:     // Disable button and show loading
145:     submitBtn.disabled = true;
146:     submitBtn.textContent = "Signing in...";
147:     errorEl.style.display = "none";
148: 
149:     try {
150:       const response = await fetch("/api/v1/login", {
151:         method: "POST",
152:         headers: { "Content-Type": "application/json" },
153:         body: JSON.stringify({ username, password })
154:       });
155: 
156:       if (!response.ok) {
157:         const errorText = await response.text();
158:         throw new Error(errorText || `Login failed: ${response.status}`);
159:       }
160: 
161:       const data = await response.json();
162: 
163:       if (data.token) {
164:         // Save token to localStorage
165:         localStorage.setItem("token", data.token);
166:         console.log("[AUTH] Login successful, token saved");
167: 
168:         // Clear password field
169:         document.getElementById("login-password").value = "";
170: 
171:         // Show app
172:         showApp();
173: 
174:         // Load initial page
175:         initFromHashOrDefault();
176:       } else {
177:         throw new Error("No token received from server");
178:       }
179:     } catch (error) {
180:       console.error("[AUTH] Login error:", error);
181:       errorEl.textContent = error.message || "Login failed";
182:       errorEl.style.display = "block";
183:       submitBtn.disabled = false;
184:       submitBtn.textContent = "Sign In";
185:     }
186:   }
187: 
188:   function handleLogout() {
189:     localStorage.removeItem("token");
190:     localStorage.removeItem("nftban-token");
191:     localStorage.removeItem("jwt_token");
192:     console.log("[AUTH] Logged out, token cleared");
193:     showLogin();
194:   }
195: 
196:   async function checkAuth() {
197:     const token = localStorage.getItem("token") || localStorage.getItem("nftban-token") || localStorage.getItem("jwt_token");
198: 
199:     if (!token) {
200:       console.log("[AUTH] No token found, showing login");
201:       showLogin();
202:       return false;
203:     }
204: 
205:     // Validate token with backend
206:     try {
207:       console.log("[AUTH] Token found, validating with backend...");
208:       const response = await fetch("/api/v1/health", {
209:         headers: { "Authorization": "Bearer " + token }
210:       });
211: 
212:       if (response.ok) {
213:         console.log("[AUTH] Token valid, auto-login successful");
214:         showApp();
215:         return true;
216:       } else {
217:         console.log("[AUTH] Token invalid or expired, clearing and showing login");
218:         localStorage.removeItem("token");
219:         localStorage.removeItem("nftban-token");
220:         localStorage.removeItem("jwt_token");
221:         showLogin();
222:         return false;
223:       }
224:     } catch (error) {
225:       console.error("[AUTH] Error validating token:", error);
226:       showLogin();
227:       return false;
228:     }
229:   }
230: 
231:   // -----------------------------
232:   // INIT
233:   // -----------------------------
234:   document.addEventListener("DOMContentLoaded", () => {
235:     initTheme();
236:     initNav();
237: 
238:     // Setup login handler
239:     const loginForm = document.getElementById("login-form");
240:     if (loginForm) {
241:       loginForm.addEventListener("submit", handleLogin);
242:     }
243: 
244:     // Setup logout handler
245:     const logoutBtn = document.getElementById("logout-btn");
246:     if (logoutBtn) {
247:       logoutBtn.addEventListener("click", handleLogout);
248:     }
249: 
250:     // Check authentication and show appropriate screen
251:     checkAuth().then(isAuthenticated => {
252:       if (isAuthenticated) {
253:         initFromHashOrDefault();
254:       }
255:     });
256:   });
257: 
258:   // -----------------------------
259:   // GLOBAL API HELPER
260:   // -----------------------------
261:   // Generic helper used by all pages: IP management, ban, unban, etc.
262:   window.apiRequest = async function (endpoint, options = {}) {
263:     // API routes are under /api/v1 (see main.go)
264:     const API_BASE = "/api/v1";
265: 
266:     const url = endpoint.startsWith("http")
267:       ? endpoint
268:       : API_BASE + endpoint;
269: 
270:     const {
271:       method = "GET",
272:       body = null,
273:       headers = {},
274:       ...rest
275:     } = options;
276: 
277:     const finalHeaders = {
278:       "Content-Type": "application/json",
279:       ...headers,
280:       ...window.getAuthHeaders?.(), // merge auth headers if defined
281:     };
282: 
283:     const fetchOptions = {
284:       method,
285:       headers: finalHeaders,
286:       ...rest,
287:     };
288: 
289:     if (body !== null && method !== "GET") {
290:       fetchOptions.body =
291:         typeof body === "string" ? body : JSON.stringify(body);
292:     }
293: 
294:     let res;
295:     try {
296:       res = await fetch(url, fetchOptions);
297:     } catch (err) {
298:       // Network / connection errors
299:       throw new Error("Network error: " + err.message);
300:     }
301: 
302:     let data = null;
303:     const text = await res.text();
304: 
305:     if (!res.ok) {
306:       // Try to parse error as JSON first
307:       try {
308:         const errorData = text ? JSON.parse(text) : null;
309:         const msg = (errorData && errorData.error) || res.statusText || "HTTP " + res.status;
310:         throw new Error(msg);
311:       } catch (e) {
312:         // If JSON parse fails, use raw text or status
313:         throw new Error(text || res.statusText || "HTTP " + res.status);
314:       }
315:     }
316: 
317:     // Parse successful response
318:     try {
319:       data = text ? JSON.parse(text) : null;
320:     } catch (parseError) {
321:       // Not JSON – log warning and return raw text
322:       console.warn(`[API] Response is not JSON for ${endpoint}:`, text.substring(0, 100));
323:       throw new Error(`Invalid JSON response: ${parseError.message}`);
324:     }
325: 
326:     return data;
327:   };
328: 
329:   // -----------------------------
330:   // GLOBAL HOOKS FOR OLD HTML
331:   // -----------------------------
332:   // Some older HTML uses onclick="showSection('xxx')" – keep it working:
333:   window.showSection = function (sectionId) {
334:     // This will trigger the existing hashchange handler,
335:     // which calls loadPage(sectionId)
336:     if (!sectionId) return;
337:     window.location.hash = sectionId;
338:   };
339: 
340:   // Some elements call validateHierarchy() in onclick.
341:   // For now just always allow; you can implement real logic later.
342:   window.validateHierarchy = function () {
343:     // return false here if you ever want to block navigation
344:     return true;
345:   };
346: 
347:   // -----------------------------
348:   // AUTH HEADER HELPER
349:   // -----------------------------
350:   // Used by older code: getAuthHeaders()
351:   window.getAuthHeaders = function () {
352:     // Read token from localStorage and send as Bearer
353:     const token = localStorage.getItem("token") || localStorage.getItem("nftban-token") || localStorage.getItem("jwt_token");
354:     if (!token) {
355:       console.warn('[AUTH] No token found');
356:       return {};
357:     }
358:     return {
359:       Authorization: "Bearer " + token,
360:     };
361:   };
362: 
363:   // -----------------------------

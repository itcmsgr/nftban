 276: nftban_report_cmd_email() {
 277:     # Email report to recipient
 278:     # Usage: nftban report email <RECIPIENT> [OPTIONS]
 279: 
 280:     local recipient="${1:-}"
 281: 
 282:     if [[ -z "$recipient" ]]; then
 283:         echo "ERROR: Recipient email required" >&2
 284:         echo "Usage: nftban report email <recipient@example.com>" >&2
 285:         return 1
 286:     fi
 287: 
 288:     shift
 289: 
 290:     local format="${STATS_EMAIL_FORMAT:-html}"
 291:     local attach_csv="${STATS_EMAIL_ATTACH_CSV:-false}"
 292:     local since
 293:     since="$(date -d '7 days ago' +%Y-%m-%d)"
 294:     local until
 295:     until="$(date +%Y-%m-%d)"
 296: 
 297:     # Parse options
 298:     while [[ $# -gt 0 ]]; do
 299:         case "$1" in
 300:             --format)
 301:                 format="$2"
 302:                 shift 2
 303:                 ;;
 304:             --attach-csv)
 305:                 attach_csv=true
 306:                 shift
 307:                 ;;
 308:             --since)
 309:                 since="$2"
 310:                 shift 2
 311:                 ;;
 312:             --until)
 313:                 until="$2"
 314:                 shift 2
 315:                 ;;
 316:             --last)
 317:                 local period="$2"
 318:                 case "$period" in
 319:                     *d) since="$(date -d "${period%d} days ago" +%Y-%m-%d)" ;;
 320:                 esac
 321:                 shift 2
 322:                 ;;
 323:             *)
 324:                 shift
 325:                 ;;
 326:         esac
 327:     done
 328: 
 329:     if type -t nftban_print_status >/dev/null 2>&1; then
 330:         nftban_print_status "info" "Preparing report email for ${recipient}..."
 331:     else
 332:         echo "[INFO] Preparing email..."
 333:     fi
 334: 
 335:     # Generate reports
 336:     local temp_dir
 337:     temp_dir=$(mktemp -d)
 338:     local report_json="${temp_dir}/report.json"
 339:     local report_csv="${temp_dir}/report.csv"
 340:     local report_html="${temp_dir}/report.html"  # shellcheck disable=SC2034  # Reserved for HTML reports
 341: 
 342:     nftban_stats_export_json "$report_json" "$since" "$until" &>/dev/null
 343: 
 344:     if [[ "$attach_csv" == "true" ]]; then
 345:         nftban_stats_export_csv "$report_csv" "$since" "$until" &>/dev/null
 346:     fi
 347: 
 348:     # Send email with full HTML report
 349: 
 350:     # Load report email generator if not already loaded
 351:     if ! declare -f nftban_report_email_generate >/dev/null 2>&1; then
 352:         if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_report_email.sh" ]]; then
 353:             source "${NFTBAN_LIB_DIR}/core/nftban_report_email.sh" 2>/dev/null || true
 354:         fi
 355:     fi
 356: 
 357:     # Try to use the full HTML report generator
 358:     if declare -f nftban_report_email_generate >/dev/null 2>&1; then
 359:         if ! nftban_report_email_generate "$recipient"; then
 360:             echo "ERROR: Failed to send email" >&2
 361:             rm -rf "$temp_dir"
 362:             return 1
 363:         fi
 364: 
 365:         if type -t nftban_print_status >/dev/null 2>&1; then
 366:             nftban_print_status "success" "Report emailed to ${recipient}"
 367:         else
 368:             echo "[SUCCESS] Email sent to ${recipient}"
 369:         fi
 370:     elif declare -f nftban_mail_send >/dev/null 2>&1; then
 371:         # Fallback: Use mail module with basic content
 372:         local body
 373:         body=$(cat <<EOF
 374: <h2>NFTBan Statistics Report</h2>
 375: 
 376: <p><strong>Period:</strong> ${since} to ${until}</p>
 377: <p><strong>Generated:</strong> $(date)</p>
 378: <p><strong>Hostname:</strong> $(hostname)</p>
 379: 
 380: <p>See attached files for detailed statistics.</p>
 381: 
 382: <hr>
 383: <p><small>Automated by NFTBan v${NFTBAN_VERSION:-1.0.0}</small></p>
 384: EOF
 385: )
 386: 
 387:         # nftban_mail_send signature: content, recipient (optional)
 388:         if ! nftban_mail_send "$body" "$recipient"; then
 389:             echo "ERROR: Failed to send email" >&2
 390:             rm -rf "$temp_dir"
 391:             return 1
 392:         fi
 393: 
 394:         if type -t nftban_print_status >/dev/null 2>&1; then
 395:             nftban_print_status "success" "Report emailed to ${recipient}"
 396:         else
 397:             echo "[SUCCESS] Email sent to ${recipient}"
 398:         fi
 399:     else
 400:         echo ""
 401:         echo "❌ Email not configured"
 402:         echo ""
 403:         echo "To enable email reports, you have two options:"
 404:         echo ""
 405:         echo "Option 1: Interactive Setup (Recommended)"
 406:         echo "  └─ Run: nftban report email-setup"
 407:         echo ""
 408:         echo "Option 2: Manual Configuration"
 409:         echo "  1. Edit: /etc/nftban/conf.d/mail.conf"
 410:         echo "  2. Set: MAIL_ENABLED=\"true\""
 411:         echo "  3. Set: MAIL_TO=\"admin@example.com\""
 412:         echo "  4. Configure SMTP settings (or use sendmail)"
 413:         echo "  5. Test: nftban mail test"
 414:         echo ""
 415:         echo "Documentation: nftban help mail"
 416:         echo ""
 417:         rm -rf "$temp_dir"
 418:         return 1
 419:     fi
 420: 
 421:     # Cleanup
 422:     rm -rf "$temp_dir"
 423: }

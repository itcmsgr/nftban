628: // collectGeobanMetrics counts banned countries and IP ranges
629: func (s *Sampler) collectGeobanMetrics() (countries, ranges int) {
630: 	// Count tracking files - use central config
631: 	_, dataDir := getMetricsPaths()
632: 	trackingDir := dataDir + "/geoban/tracking"
633: 	entries, err := os.ReadDir(trackingDir)
634: 	if err != nil {
635: 		return 0, 0
636: 	}
637: 
638: 	countries = len(entries)
639: 
640: 	// Count total ranges from all tracking files
641: 	for _, entry := range entries {
642: 		if entry.IsDir() {
643: 			continue
644: 		}
645: 		filePath := trackingDir + "/" + entry.Name()
646: 		data, err := os.ReadFile(filePath)
647: 		if err != nil {
648: 			continue
649: 		}
650: 		// Count non-empty lines
651: 		lines := strings.Split(string(data), "\n")
652: 		for _, line := range lines {
653: 			if strings.TrimSpace(line) != "" {
654: 				ranges++
655: 			}
656: 		}
657: 	}
658: 	return countries, ranges
659: }

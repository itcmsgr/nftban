#!/bin/bash
# SPDX-License-Identifier: MPL-2.0
# SPDX-FileCopyrightText: Copyright (c) 2024-2025 NFTBan Development Team
#
# postinst script for nftban (main package)
# Configure after installation

set -e

# =============================================================================
# PATH DEFAULTS (can be overridden by config)
# =============================================================================
NFTBAN_CONFIG_DIR="${NFTBAN_CONFIG_DIR:-/etc/nftban}"
NFTBAN_DATA_DIR="${NFTBAN_DATA_DIR:-/var/lib/nftban}"
NFTBAN_LOG_DIR="${NFTBAN_LOG_DIR:-/var/log/nftban}"
NFTBAN_CACHE_DIR="${NFTBAN_CACHE_DIR:-/var/cache/nftban}"
NFTBAN_RUN_DIR="${NFTBAN_RUN_DIR:-/run/nftban}"

# Source config if exists (allows custom paths)
if [ -f "${NFTBAN_CONFIG_DIR}/nftban.conf" ]; then
    # shellcheck source=/dev/null
    . "${NFTBAN_CONFIG_DIR}/nftban.conf" 2>/dev/null || true
fi

case "$1" in
    configure)
        echo "Configuring NFTBan..."

        # Create user and group if not exists
        if ! getent group nftban >/dev/null; then
            groupadd -r nftban
        fi
        if ! getent group nftban-auditors >/dev/null; then
            groupadd -r nftban-auditors
        fi
        if ! getent passwd nftban >/dev/null; then
            useradd -r -g nftban -G nftban-auditors -d "${NFTBAN_DATA_DIR}" \
                -s /usr/sbin/nologin -c "NFTBan Service Account" nftban
        fi

        # Create directories per FHS spec (see nftban_fhs_spec.sh)
        # Config directories (root:nftban)
        install -d -m 750 -o root -g nftban "${NFTBAN_CONFIG_DIR}"
        install -d -m 750 -o root -g nftban "${NFTBAN_CONFIG_DIR}/conf.d"

        # Data directories (nftban:nftban)
        install -d -m 750 -o nftban -g nftban "${NFTBAN_DATA_DIR}"
        install -d -m 750 -o nftban -g nftban "${NFTBAN_DATA_DIR}/reports"
        install -d -m 750 -o nftban -g nftban "${NFTBAN_DATA_DIR}/reports/baseline"
        install -d -m 750 -o nftban -g nftban "${NFTBAN_DATA_DIR}/reports/watchdog"
        install -d -m 750 -o nftban -g nftban "${NFTBAN_DATA_DIR}/metrics"
        install -d -m 750 -o nftban -g nftban "${NFTBAN_DATA_DIR}/snapshots"
        install -d -m 750 -o nftban -g nftban "${NFTBAN_DATA_DIR}/exports"
        install -d -m 750 -o nftban -g nftban "${NFTBAN_DATA_DIR}/geoip"

        # Stats directories (watchdog runtime stats and profiling)
        install -d -m 750 -o nftban -g nftban "${NFTBAN_DATA_DIR}/stats"
        install -d -m 750 -o nftban -g nftban "${NFTBAN_DATA_DIR}/stats/history"
        install -d -m 750 -o nftban -g nftban "${NFTBAN_DATA_DIR}/stats/profiles"

        # Queue directories (task queue with retry and DLQ)
        install -d -m 750 -o nftban -g nftban "${NFTBAN_DATA_DIR}/queue/pending"
        install -d -m 750 -o nftban -g nftban "${NFTBAN_DATA_DIR}/queue/work"
        install -d -m 750 -o nftban -g nftban "${NFTBAN_DATA_DIR}/queue/dlq"

        # Mail spool directory (failed mail retry queue)
        install -d -m 750 -o nftban -g nftban "${NFTBAN_DATA_DIR}/mailspool"

        # Pro subscription data directory
        install -d -m 750 -o root -g nftban "${NFTBAN_DATA_DIR}/pro"

        # Log directory
        install -d -m 750 -o nftban -g nftban "${NFTBAN_LOG_DIR}"

        # Watchdog log subdirectory
        install -d -m 750 -o nftban -g nftban "${NFTBAN_LOG_DIR}/watchdog"

        # Cache and runtime
        install -d -m 755 -o nftban -g nftban "${NFTBAN_CACHE_DIR}"
        install -d -m 750 -o nftban -g nftban "${NFTBAN_CACHE_DIR}/health"
        install -d -m 755 -o nftban -g nftban "${NFTBAN_RUN_DIR}"

        # Auto-detect SSH port
        SSH_PORT="22"
        if [ -f /etc/ssh/sshd_config ]; then
            DETECTED=$(grep -E "^Port\s+" /etc/ssh/sshd_config 2>/dev/null | awk '{print $2}' | head -1)
            if [ -n "$DETECTED" ]; then
                SSH_PORT="$DETECTED"
            fi
        fi

        # Create SSH port whitelist if not exists
        if [ ! -f "${NFTBAN_CONFIG_DIR}/ports.d/00-ssh.conf" ]; then
            mkdir -p "${NFTBAN_CONFIG_DIR}/ports.d"
            cat > "${NFTBAN_CONFIG_DIR}/ports.d/00-ssh.conf" << EOF
# Auto-generated SSH port whitelist
# Created by: NFTBan package installer
[ssh]
port=$SSH_PORT
protocol=tcp
direction=input
EOF
            chmod 644 "${NFTBAN_CONFIG_DIR}/ports.d/00-ssh.conf"
            chown root:nftban "${NFTBAN_CONFIG_DIR}/ports.d/00-ssh.conf"
            echo "SSH port whitelisted: $SSH_PORT/tcp"
        fi

        # Auto-whitelist system IP (prevents lockout)
        SYSTEM_IP=$(ip route get 1.1.1.1 2>/dev/null | grep -oP 'src \K[0-9.]+' | head -1)
        if [ -z "$SYSTEM_IP" ]; then
            SYSTEM_IP=$(hostname -I 2>/dev/null | awk '{print $1}')
        fi
        if [ -n "$SYSTEM_IP" ]; then
            mkdir -p "${NFTBAN_CONFIG_DIR}/whitelist.d"
            if [ ! -f "${NFTBAN_CONFIG_DIR}/whitelist.d/00-system-ip.conf" ]; then
                cat > "${NFTBAN_CONFIG_DIR}/whitelist.d/00-system-ip.conf" << EOF
# Auto-generated system IP whitelist
# Created by: NFTBan package installer
# Purpose: Prevent lockout from this server
$SYSTEM_IP
EOF
                chmod 644 "${NFTBAN_CONFIG_DIR}/whitelist.d/00-system-ip.conf"
                chown root:nftban "${NFTBAN_CONFIG_DIR}/whitelist.d/00-system-ip.conf"
                echo "System IP whitelisted: $SYSTEM_IP"
            fi
        fi

        # Reload systemd
        systemctl daemon-reload >/dev/null 2>&1 || true

        # ==========================================================================
        # AUTO-ENABLE DEFAULT FEATURES (aligned with install.sh)
        # ==========================================================================

        # 1. Download FREE GeoIP database (DB-IP)
        GEOIP_DIR="${NFTBAN_DATA_DIR}/geoip"
        GEOIP_FILE="${GEOIP_DIR}/dbip-country-lite.mmdb"
        GEOIP_URL="https://download.db-ip.com/free/dbip-country-lite-$(date +%Y-%m).mmdb.gz"

        mkdir -p "$GEOIP_DIR"
        chown nftban:nftban "$GEOIP_DIR"

        if [ ! -f "$GEOIP_FILE" ]; then
            echo "Downloading FREE GeoIP database..."
            if curl -fsSL "$GEOIP_URL" -o "${GEOIP_FILE}.gz" 2>/dev/null; then
                gunzip -f "${GEOIP_FILE}.gz" 2>/dev/null || true
                chown nftban:nftban "$GEOIP_FILE" 2>/dev/null || true
                chmod 644 "$GEOIP_FILE"
                echo "GeoIP database downloaded"
            else
                echo "GeoIP download failed (will retry on first use)"
            fi
        fi

        # 2. Enable Login Monitoring
        if [ -f "${NFTBAN_CONFIG_DIR}/nftban.conf" ]; then
            sed -i 's/^NFTBAN_LOGIN_ALERT_ENABLED=.*/NFTBAN_LOGIN_ALERT_ENABLED="true"/' "${NFTBAN_CONFIG_DIR}/nftban.conf" 2>/dev/null || true
            sed -i 's/^NFTBAN_LOGIN_ALERT_SSH=.*/NFTBAN_LOGIN_ALERT_SSH="true"/' "${NFTBAN_CONFIG_DIR}/nftban.conf" 2>/dev/null || true
        fi
        systemctl enable nftban-login-monitor.service >/dev/null 2>&1 || true
        systemctl start nftban-login-monitor.service >/dev/null 2>&1 || true

        # 3. Enable GeoIP Blocking
        if [ -f "${NFTBAN_CONFIG_DIR}/nftban.conf" ]; then
            sed -i 's/^NFTBAN_GEOIP_ENABLED=.*/NFTBAN_GEOIP_ENABLED="true"/' "${NFTBAN_CONFIG_DIR}/nftban.conf" 2>/dev/null || true
        fi

        # 4. Enable core timers (health, maintenance)
        for timer in nftban-health.timer nftban-maintenance.timer; do
            systemctl enable "$timer" >/dev/null 2>&1 || true
            systemctl start "$timer" >/dev/null 2>&1 || true
        done

        echo ""
        echo "NFTBan installed successfully!"
        echo ""
        echo "Auto-enabled:"
        echo "  - Login monitoring (SSH alerts)"
        echo "  - GeoIP blocking"
        echo "  - Core timers (health, maintenance)"
        echo ""
        echo "Enable optional features:"
        echo "  nftban feeds enable      # Threat intel feeds"
        echo "  nftban portscan enable   # Port scan detection"
        echo "  nftban ddos enable       # DDoS protection"
        echo "  nftban gui enable        # Web GUI"
        echo "  nftban metrics enable    # Metrics collection"
        echo "  nftban pro enroll        # NFTBan Pro subscription"

        # ==========================================================================
        # SECURITY: Protect nft_schema.sh from modification (P0 CRITICAL)
        # ==========================================================================
        # Make nft_schema.sh immutable to prevent command injection attacks
        # This file defines the canonical nftables schema used by all components
        if [ -f /usr/lib/nftban/lib/nft_schema.sh ]; then
            chmod 444 /usr/lib/nftban/lib/nft_schema.sh
            chattr +i /usr/lib/nftban/lib/nft_schema.sh 2>/dev/null || true
            echo "Security: nft_schema.sh protected (immutable)"
        fi
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

exit 0

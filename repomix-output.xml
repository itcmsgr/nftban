314: # Record an alert and update scores
315: nftban_portscan_suricata_record_alert() {
316:     local src_ip="$1"
317:     local severity="$2"
318:     local signature="$3"
319:     local category="$4"
320: 
321:     local current_time
322:     current_time=$(date +%s)
323: 
324:     # Skip whitelisted IPs
325:     if nftban_portscan_suricata_is_whitelisted "$src_ip"; then
326:         return 0
327:     fi
328: 
329:     # Skip already blocked IPs
330:     [[ -n "${_PORTSCAN_SURICATA_IP_BLOCKED[$src_ip]:-}" ]] && return 0
331: 
332:     # Update tracking
333:     [[ -z "${_PORTSCAN_SURICATA_IP_FIRST_SEEN[$src_ip]:-}" ]] && \
334:         _PORTSCAN_SURICATA_IP_FIRST_SEEN["$src_ip"]=$current_time
335: 
336:     _PORTSCAN_SURICATA_IP_LAST_SEEN["$src_ip"]=$current_time
337: 
338:     # Increment alert count
339:     local alert_count="${_PORTSCAN_SURICATA_IP_ALERTS[$src_ip]:-0}"
340:     _PORTSCAN_SURICATA_IP_ALERTS["$src_ip"]=$((alert_count + 1))
341: 
342:     # Detect scan type from signature
343:     local scan_type
344:     scan_type=$(nftban_portscan_suricata_detect_scan_type "$signature")
345: 
346:     if [[ -n "$scan_type" ]]; then
347:         local current_types="${_PORTSCAN_SURICATA_IP_SCAN_TYPES[$src_ip]:-}"
348:         local type_pattern=" ${scan_type} "
349:         if [[ ! " $current_types " =~ $type_pattern ]]; then
350:             _PORTSCAN_SURICATA_IP_SCAN_TYPES["$src_ip"]="${current_types} ${scan_type}"
351:         fi
352:     fi
353: 
354:     # Calculate score
355:     local score
356:     score=$(nftban_portscan_suricata_calculate_score "$src_ip" "$severity" "$scan_type")
357: 
358:     _PORTSCAN_SURICATA_IP_SCORES["$src_ip"]="$score"
359: 
360:     # Log if verbose
361:     if [[ "${PORTSCAN_SURICATA_LOG_ALL_ALERTS:-false}" == "true" ]]; then
362:         nftban_log "DEBUG" "portscan_suricata" "Alert: IP=${src_ip} severity=${severity} sig=${signature} score=${score}"
363:     fi
364: 
365:     # Check thresholds and take action
366:     nftban_portscan_suricata_check_thresholds "$src_ip" "$score"
367: 
368:     return 0
369: }

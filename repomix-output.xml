  1: /**
  2:  * NFTBan Dynamic Page Loader
  3:  * Loads modular HTML pages asynchronously
  4:  */
  5: 
  6: // Current loaded page
  7: let currentPage = 'dashboard';
  8: 
  9: // Content container
 10: const contentContainer = document.querySelector('.wrapper');
 11: 
 12: /**
 13:  * Load a page dynamically
 14:  * @param {string} pageName - Name of the page to load (dashboard, feeds, fail2ban, etc.)
 15:  */
 16: async function loadPage(pageName) {
 17:     if (!contentContainer) {
 18:         console.error('Content container not found');
 19:         return;
 20:     }
 21: 
 22:     try {
 23:         // Show loading indicator
 24:         contentContainer.innerHTML = '<div class="bg-white main-border rad-10 p-20 text-center"><i class="fa-solid fa-spinner fa-spin fa-2x c-blue"></i><p class="mt-10">Loading...</p></div>';
 25: 
 26:         // Fetch the page with cache-busting timestamp
 27:         const cacheBuster = new Date().getTime();
 28:         const response = await fetch(`/static/pages/${pageName}.html?v=${cacheBuster}`);
 29: 
 30:         if (!response.ok) {
 31:             throw new Error(`Failed to load page: ${response.statusText}`);
 32:         }
 33: 
 34:         const html = await response.text();
 35: 
 36:         // Load the content
 37:         contentContainer.innerHTML = html;
 38: 
 39:         // Execute inline scripts (innerHTML doesn't execute them automatically)
 40:         const scripts = contentContainer.querySelectorAll('script');
 41:         scripts.forEach(oldScript => {
 42:             const newScript = document.createElement('script');
 43:             // Copy attributes
 44:             Array.from(oldScript.attributes).forEach(attr => {
 45:                 newScript.setAttribute(attr.name, attr.value);
 46:             });
 47:             // Copy content
 48:             newScript.textContent = oldScript.textContent;
 49:             // Replace old script with new one to trigger execution
 50:             oldScript.parentNode.replaceChild(newScript, oldScript);
 51:         });
 52: 
 53:         // Update current page
 54:         currentPage = pageName;
 55: 
 56:         // Update active menu item
 57:         updateActiveMenu(pageName);
 58: 
 59:         // Execute page-specific initialization after DOM is ready
 60:         // Use setTimeout to ensure DOM elements are accessible
 61:         setTimeout(() => {
 62:             initializePage(pageName);
 63:         }, 100);
 64: 
 65:         console.log(`✅ Loaded page: ${pageName}`);
 66:     } catch (error) {
 67:         console.error(`Error loading page ${pageName}:`, error);
 68:         contentContainer.innerHTML = `
 69:             <div class="bg-white main-border rad-10 p-20 text-center">
 70:                 <i class="fa-solid fa-triangle-exclamation fa-2x c-red"></i>
 71:                 <h3 class="fs-15 fw-bold mt-10 c-red">Error Loading Page</h3>
 72:                 <p class="mt-10 c-grey">${error.message}</p>
 73:                 <button onclick="loadPage('${pageName}')" class="mt-10 px-20 p-10 bg-blue c-white rad-6">
 74:                     <i class="fa-solid fa-rotate"></i> Retry
 75:                 </button>
 76:             </div>
 77:         `;
 78:     }
 79: }
 80: 
 81: /**
 82:  * Update active menu item
 83:  */
 84: function updateActiveMenu(pageName) {
 85:     // Remove active class from all menu items
 86:     document.querySelectorAll('.sidebar ul li').forEach(item => {
 87:         item.classList.remove('menu-item-active');
 88:     });
 89: 
 90:     // Add active class to current menu item
 91:     const menuItem = document.querySelector(`.sidebar ul li[onclick*="'${pageName}'"]`);
 92:     if (menuItem) {
 93:         menuItem.classList.add('menu-item-active');
 94:     }
 95: }

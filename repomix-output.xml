341: # =============================================================================
342: # CONNECTION TRACKING
343: # =============================================================================
344: 
345: # Record a connection attempt
346: nftban_portscan_classic_record_connection() {
347:     local src_ip="$1"
348:     local dst_ip="$2"
349:     local dst_port="$3"
350:     local timestamp="$4"
351: 
352:     local max_tracked="${PORTSCAN_CLASSIC_MAX_TRACKED_IPS}"
353: 
354:     # Check if we're tracking too many IPs
355:     if [[ ${#_PORTSCAN_CLASSIC_IP_PORTS[@]} -ge $max_tracked ]]; then
356:         nftban_portscan_classic_cleanup_old_entries
357:     fi
358: 
359:     # Add port to tracked list for this IP
360:     local current_ports="${_PORTSCAN_CLASSIC_IP_PORTS[$src_ip]:-}"
361:     local port_pattern=" ${dst_port} "
362:     if [[ ! " $current_ports " =~ $port_pattern ]]; then
363:         _PORTSCAN_CLASSIC_IP_PORTS["$src_ip"]="${current_ports} ${dst_port}"
364:     fi
365: 
366:     # Add timestamp
367:     local current_timestamps="${_PORTSCAN_CLASSIC_IP_TIMESTAMPS[$src_ip]:-}"
368:     _PORTSCAN_CLASSIC_IP_TIMESTAMPS["$src_ip"]="${current_timestamps} ${timestamp}"
369: 
370:     # Add target if different from self
371:     if [[ -n "$dst_ip" ]]; then
372:         local current_targets="${_PORTSCAN_CLASSIC_IP_TARGETS[$src_ip]:-}"
373:         local target_pattern=" ${dst_ip} "
374:         if [[ ! " $current_targets " =~ $target_pattern ]]; then
375:             _PORTSCAN_CLASSIC_IP_TARGETS["$src_ip"]="${current_targets} ${dst_ip}"
376:         fi
377:     fi
378: 
379:     return 0
380: }
381: 
382: # Cleanup old tracking entries
383: nftban_portscan_classic_cleanup_old_entries() {
384:     local time_window="${PORTSCAN_CLASSIC_TIME_WINDOW}"
385:     local current_time
386:     current_time=$(date +%s)
387:     local cutoff_time
388:     cutoff_time=$((current_time - time_window))
389: 
390:     for ip in "${!_PORTSCAN_CLASSIC_IP_TIMESTAMPS[@]}"; do
391:         local timestamps="${_PORTSCAN_CLASSIC_IP_TIMESTAMPS[$ip]}"
392:         local new_timestamps=""
393:         local has_recent=false
394: 
395:         for ts in $timestamps; do
396:             if [[ $ts -ge $cutoff_time ]]; then
397:                 new_timestamps="${new_timestamps} ${ts}"
398:                 has_recent=true
399:             fi
400:         done
401: 
402:         if [[ "$has_recent" == "true" ]]; then
403:             _PORTSCAN_CLASSIC_IP_TIMESTAMPS["$ip"]="$new_timestamps"
404:         else
405:             # No recent activity, remove tracking
406:             unset "_PORTSCAN_CLASSIC_IP_PORTS[$ip]"
407:             unset "_PORTSCAN_CLASSIC_IP_TIMESTAMPS[$ip]"
408:             unset "_PORTSCAN_CLASSIC_IP_TARGETS[$ip]"
409:         fi
410:     done
411: 
412:     return 0
413: }
414: 
415: # =============================================================================
416: # SCAN DETECTION
417: # =============================================================================
418: 
419: # Analyze all tracked IPs for portscan behavior
420: nftban_portscan_classic_analyze_all() {
421:     local min_ports="${PORTSCAN_CLASSIC_MIN_PORTS}"
422: 
423:     for ip in "${!_PORTSCAN_CLASSIC_IP_PORTS[@]}"; do
424:         # Skip already blocked IPs
425:         [[ -n "${_PORTSCAN_CLASSIC_IP_BLOCKED[$ip]:-}" ]] && continue
426: 
427:         local scan_type
428:         scan_type=$(nftban_portscan_classic_detect_scan_type "$ip")
429: 
430:         if [[ -n "$scan_type" ]]; then
431:             nftban_portscan_classic_handle_detection "$ip" "$scan_type"
432:         fi
433:     done
434: 
435:     return 0
436: }
437: 
438: # Detect what type of scan an IP is performing
439: nftban_portscan_classic_detect_scan_type() {
440:     local ip="$1"
441: 
442:     local ports="${_PORTSCAN_CLASSIC_IP_PORTS[$ip]:-}"
443:     local targets="${_PORTSCAN_CLASSIC_IP_TARGETS[$ip]:-}"
444: 
445:     # Count unique ports
446:     local port_count
447:     port_count=$(echo "$ports" | tr ' ' '\n' | grep -v '^$' | sort -u | wc -l)
448: 
449:     # Count unique targets
450:     local target_count
451:     target_count=$(echo "$targets" | tr ' ' '\n' | grep -v '^$' | sort -u | wc -l)
452: 
453:     local vertical_threshold="${PORTSCAN_CLASSIC_VERTICAL_PORTS}"
454:     local horizontal_threshold="${PORTSCAN_CLASSIC_HORIZONTAL_TARGETS}"
455:     local block_threshold="${PORTSCAN_CLASSIC_BLOCK_RANGE}"
456:     local strobe_ports="${PORTSCAN_CLASSIC_STROBE_PORTS}"
457: 
458:     # Check for block scan (scanning port ranges)
459:     if [[ $port_count -ge $block_threshold ]]; then
460:         echo "block"
461:         return 0
462:     fi
463: 
464:     # Check for vertical scan (many ports on one target)
465:     if [[ $port_count -ge $vertical_threshold && $target_count -le 1 ]]; then
466:         echo "vertical"
467:         return 0
468:     fi
469: 
470:     # Check for horizontal scan (same ports across many targets)
471:     if [[ $target_count -ge $horizontal_threshold && $port_count -le 3 ]]; then
472:         echo "horizontal"
473:         return 0
474:     fi
475: 
476:     # Check for strobe scan (rapid scanning of common ports)
477:     if [[ $port_count -ge $strobe_ports ]]; then
478:         local timestamps="${_PORTSCAN_CLASSIC_IP_TIMESTAMPS[$ip]}"
479:         # shellcheck disable=SC2206  # Space-separated timestamps intentional
480:         local ts_array=($timestamps)
481:         local ts_count=${#ts_array[@]}
482: 
483:         if [[ $ts_count -gt 0 ]]; then
484:             local first_ts="${ts_array[0]}"
485:             local last_ts="${ts_array[$((ts_count-1))]}"
486:             local duration
487:             duration=$((last_ts - first_ts))
488: 
489:             # If many connections in short time
490:             if [[ $duration -lt 10 && $port_count -ge $strobe_ports ]]; then
491:                 echo "strobe"
492:                 return 0
493:             fi
494:         fi
495:     fi
496: 
497:     # Check minimum port threshold
498:     local min_ports="${PORTSCAN_CLASSIC_MIN_PORTS}"
499:     if [[ $port_count -ge $min_ports ]]; then
500:         echo "generic"
501:         return 0
502:     fi
503: 
504:     return 1
505: }
506: 
507: # =============================================================================
508: # BLOCKING
509: # =============================================================================
510: 
511: # Handle detected portscan
512: nftban_portscan_classic_handle_detection() {
513:     local ip="$1"
514:     local scan_type="$2"
515: 
516:     local action="${PORTSCAN_CLASSIC_ACTION}"
517: 
518:     nftban_log "WARN" "portscan_classic" "Detected ${scan_type} scan from ${ip}"
519: 
520:     case "$action" in
521:         block)
522:             nftban_portscan_classic_block_ip "$ip" "$scan_type"
523:             ;;
524:         log)
525:             nftban_log "INFO" "portscan_classic" "Logged ${scan_type} scan from ${ip} (no block)"
526:             ;;
527:         alert)
528:             nftban_portscan_classic_send_alert "$ip" "$scan_type"
529:             ;;
530:         block_and_alert)
531:             nftban_portscan_classic_block_ip "$ip" "$scan_type"
532:             nftban_portscan_classic_send_alert "$ip" "$scan_type"
533:             ;;
534:     esac
535: 
536:     return 0
537: }
538: 
539: # Block an IP
540: nftban_portscan_classic_block_ip() {
541:     local ip="$1"
542:     local scan_type="$2"
543: 
544:     # Determine ban duration
545:     local duration
546:     case "$scan_type" in
547:         vertical)   duration="${PORTSCAN_CLASSIC_BAN_VERTICAL:-1800}" ;;
548:         horizontal) duration="${PORTSCAN_CLASSIC_BAN_HORIZONTAL:-3600}" ;;
549:         block)      duration="${PORTSCAN_CLASSIC_BAN_BLOCK:-7200}" ;;
550:         strobe)     duration="${PORTSCAN_CLASSIC_BAN_STROBE:-600}" ;;
551:         *)          duration="${PORTSCAN_CLASSIC_BAN_DEFAULT:-1800}" ;;
552:     esac
553: 
554:     # Progressive banning
555:     if [[ "${PORTSCAN_CLASSIC_PROGRESSIVE_BAN:-true}" == "true" ]]; then
556:         local ban_count="${_PORTSCAN_CLASSIC_IP_BAN_COUNT[$ip]:-0}"
557:         local multiplier="${PORTSCAN_CLASSIC_PROGRESSIVE_MULTIPLIER:-2}"
558:         local max_duration="${PORTSCAN_CLASSIC_PROGRESSIVE_MAX:-86400}"
559: 
560:         if [[ $ban_count -gt 0 ]]; then
561:             duration=$((duration * multiplier * ban_count))
562:             [[ $duration -gt $max_duration ]] && duration=$max_duration
563:         fi
564: 
565:         _PORTSCAN_CLASSIC_IP_BAN_COUNT["$ip"]=$((ban_count + 1))
566:     fi
567: 
568:     # Use nftban ban command if available
569:     if type -t nftban_ban &>/dev/null; then
570:         nftban_ban "$ip" \
571:             --timeout "$duration" \
572:             --reason "portscan:${scan_type}" \
573:             --source "portscan-classic"
574:     else
575:         # Direct nftables block
576:         local table_ipv4="${PORTSCAN_NFT_TABLE_IPV4:-ip nftban}"
577:         local table_ipv6="${PORTSCAN_NFT_TABLE_IPV6:-ip6 nftban}"
578: 
579:         if [[ "$ip" =~ : ]]; then
580:             nft add element ${table_ipv6} blacklist { $ip timeout ${duration}s } 2>/dev/null || true
581:         else
582:             nft add element ${table_ipv4} blacklist { $ip timeout ${duration}s } 2>/dev/null || true
583:         fi
584:     fi
585: 
586:     # Record block
587:     _PORTSCAN_CLASSIC_IP_BLOCKED["$ip"]=$(date +%s)
588: 
589:     nftban_log "INFO" "portscan_classic" "Blocked ${ip} for ${duration}s (${scan_type} scan)"
590: 
591:     return 0
592: }
593: 
594: # Send alert notification
595: nftban_portscan_classic_send_alert() {
596:     local ip="$1"
597:     local scan_type="$2"
598: 
599:     local ports="${_PORTSCAN_CLASSIC_IP_PORTS[$ip]:-unknown}"
600:     local port_count
601:     port_count=$(echo "$ports" | tr ' ' '\n' | grep -v '^$' | wc -l)
602: 
603:     local message="Portscan detected: ${scan_type} scan from ${ip} (${port_count} ports)"
604: 
605:     # Email notification
606:     if [[ "${PORTSCAN_NOTIFY_EMAIL:-false}" == "true" && -n "${PORTSCAN_NOTIFY_EMAIL_TO:-}" ]]; then
607:         echo "$message" | mail -s "[NFTBan] Portscan Alert: ${ip}" "${PORTSCAN_NOTIFY_EMAIL_TO}" 2>/dev/null || true
608:     fi
609: 
610:     # Webhook notification
611:     if [[ "${PORTSCAN_NOTIFY_WEBHOOK:-false}" == "true" && -n "${PORTSCAN_NOTIFY_WEBHOOK_URL:-}" ]]; then
612:         curl -s -X POST "${PORTSCAN_NOTIFY_WEBHOOK_URL}" \
613:             -H "Content-Type: application/json" \
614:             -d "{\"type\":\"portscan\",\"ip\":\"${ip}\",\"scan_type\":\"${scan_type}\",\"ports\":${port_count}}" \
615:             2>/dev/null || true
616:     fi
617: 
618:     return 0
619: }
620: 
621: # =============================================================================
622: # WHITELIST
623: # =============================================================================
624: 
625: # Check if IP is whitelisted
626: nftban_portscan_classic_is_whitelisted() {
627:     local ip="$1"
628: 
629:     # Localhost
630:     if [[ "${PORTSCAN_WHITELIST_LOCALHOST:-true}" == "true" ]]; then
631:         case "$ip" in
632:             127.*|::1|0.0.0.0) return 0 ;;
633:         esac
634:     fi
635: 
636:     # Private networks
637:     if [[ "${PORTSCAN_WHITELIST_PRIVATE:-true}" == "true" ]]; then
638:         case "$ip" in
639:             10.*|172.1[6-9].*|172.2[0-9].*|172.3[0-1].*|192.168.*) return 0 ;;
640:             fc*|fd*) return 0 ;;  # IPv6 private
641:         esac
642:     fi
643: 
644:     # Check whitelist file
645:     local whitelist_file="${PORTSCAN_WHITELIST_FILE:-}"
646:     if [[ -f "$whitelist_file" ]]; then
647:         if grep -q "^${ip}$" "$whitelist_file" 2>/dev/null; then
648:             return 0
649:         fi
650:     fi
651: 
652:     # Use nftban whitelist check if available
653:     if type -t nftban_is_whitelisted &>/dev/null; then
654:         if nftban_is_whitelisted "$ip"; then
655:             return 0
656:         fi
657:     fi
658: 
659:     return 1
660: }
661: 
662: # =============================================================================
663: # MODULE LIFECYCLE
664: # =============================================================================
665: 
666: # Enable classic portscan detection
667: nftban_portscan_classic_enable() {
668:     nftban_log "INFO" "portscan_classic" "Enabling classic portscan detection"
669: 
670:     # Load configuration
671:     nftban_portscan_classic_load_config
672: 
673:     # Initialize state
674:     nftban_portscan_classic_init_state
675: 
676:     # Create nftables chain and rules
677:     nftban_portscan_classic_create_chain
678:     nftban_portscan_classic_add_rules
679:     nftban_portscan_classic_add_jump
680: 
681:     nftban_log "INFO" "portscan_classic" "Classic portscan detection enabled"
682:     return 0
683: }
684: 
685: # Disable classic portscan detection
686: nftban_portscan_classic_disable() {
687:     nftban_log "INFO" "portscan_classic" "Disabling classic portscan detection"
688: 
689:     # Save state before disabling
690:     nftban_portscan_classic_save_state
691: 
692:     # Remove rules
693:     nftban_portscan_classic_remove_rules
694: 
695:     nftban_log "INFO" "portscan_classic" "Classic portscan detection disabled"
696:     return 0
697: }
698: 
699: # Get status
700: nftban_portscan_classic_status() {
701:     local table_ipv4="${PORTSCAN_NFT_TABLE_IPV4:-ip nftban}"
702:     local chain="${PORTSCAN_NFT_CHAIN:-portscan_detection}"
703: 
704:     echo "=== NFTBan Portscan Classic Mode Status ==="
705:     echo ""
706: 
707:     # Check if chain exists
708:     if nft list chain ${table_ipv4} ${chain} &>/dev/null; then
709:         echo "Status: ACTIVE"
710:     else
711:         echo "Status: INACTIVE"
712:     fi
713: 
714:     echo ""
715:     echo "Tracking:"
716:     echo "  IPs tracked: ${#_PORTSCAN_CLASSIC_IP_PORTS[@]}"
717:     echo "  IPs blocked: ${#_PORTSCAN_CLASSIC_IP_BLOCKED[@]}"
718: 
719:     echo ""
720:     echo "Configuration:"
721:     echo "  Min ports for detection: ${PORTSCAN_CLASSIC_MIN_PORTS:-5}"
722:     echo "  Time window: ${PORTSCAN_CLASSIC_TIME_WINDOW:-60}s"
723:     echo "  Log file: $(nftban_portscan_classic_find_log 2>/dev/null || echo 'not found')"
724: 
725:     return 0
726: }
727: 
728: # Process pending detections (called periodically)
729: nftban_portscan_classic_run() {
730:     # Process logs
731:     nftban_portscan_classic_process_logs
732: 
733:     # Cleanup old entries
734:     nftban_portscan_classic_cleanup_old_entries
735: 
736:     return 0
737: }
738: 
739: # =============================================================================
740: # END OF CLASSIC MODE IMPLEMENTATION
741: # =============================================================================
</file>

<file path="cli/lib/nftban/setup/install_prometheus.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - Prometheus Installation Script
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Install and configure Prometheus for NFTBan metrics
  7: # Location: /usr/lib/nftban/setup/install_prometheus.sh
  8: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
  9: # meta:homepage=https://nftban.com
 10: #
 11: # meta:name=install_prometheus
 12: # meta:type=setup
 13: # meta:header=Prometheus Installation
 14: # meta:version=1.0.0
 15: #
 16: # meta:created_date=2025-11-16
 17: # =============================================================================
 18: 
 19: set -Eeuo pipefail
 20: IFS=$'\n\t'
 21: 
 22: # =============================================================================
 23: # LIBRARY LOADING
 24: # =============================================================================
 25: 
 26: # Determine library path
 27: NFTBAN_LIB_DIR="${NFTBAN_LIB_DIR:-/usr/lib/nftban}"
 28: 
 29: # Source common setup utilities
 30: if [[ -f "${NFTBAN_LIB_DIR}/lib/setup_utils.sh" ]]; then
 31:     # shellcheck source=/dev/null
 32:     source "${NFTBAN_LIB_DIR}/lib/setup_utils.sh"
 33: elif [[ -f "$(dirname "${BASH_SOURCE[0]}")/../lib/setup_utils.sh" ]]; then
 34:     # shellcheck source=/dev/null
 35:     source "$(dirname "${BASH_SOURCE[0]}")/../lib/setup_utils.sh"
 36: else
 37:     # Fallback: define functions inline if library not found
 38:     echo "[WARN] setup_utils.sh not found, using inline definitions" >&2
 39:     readonly RED='\033[0;31m'
 40:     readonly GREEN='\033[0;32m'
 41:     readonly YELLOW='\033[1;33m'
 42:     readonly NC='\033[0m'
 43:     print_status() { echo -e "${GREEN}[✓]${NC} $1" >&2; }
 44:     print_error() { echo -e "${RED}[✗]${NC} $1" >&2; }
 45:     print_info() { echo -e "${YELLOW}[i]${NC} $1" >&2; }
 46:     detect_distro() { [[ -f /etc/os-release ]] && { . /etc/os-release; echo "${ID}"; } || echo "unknown"; }
 47: fi
 48: 
 49: # =============================================================================
 50: # CONFIGURATION
 51: # =============================================================================
 52: 
 53: # Prometheus configuration
 54: readonly PROM_VERSION="${PROM_VERSION:-2.48.0}"
 55: readonly PROM_USER="prometheus"
 56: readonly PROM_GROUP="prometheus"
 57: readonly PROM_DIR="/etc/prometheus"
 58: readonly PROM_DATA_DIR="/var/lib/prometheus"
 59: readonly PROM_BIN="/usr/local/bin/prometheus"
 60: readonly PROMTOOL_BIN="/usr/local/bin/promtool"
 61: 
 62: install_via_package() {
 63:     local distro="$1"
 64:     
 65:     case "$distro" in
 66:         fedora|centos|rhel|rocky|almalinux)
 67:             print_info "Installing Prometheus via dnf..."
 68:             dnf install -y prometheus2 || {
 69:                 print_error "Package installation failed"
 70:                 return 1
 71:             }
 72:             ;;
 73:         debian|ubuntu)
 74:             print_info "Installing Prometheus via apt..."
 75:             apt-get update
 76:             apt-get install -y prometheus || {
 77:                 print_error "Package installation failed"
 78:                 return 1
 79:             }
 80:             ;;
 81:         *)
 82:             print_error "Package installation not available for $distro"
 83:             return 1
 84:             ;;
 85:     esac
 86:     
 87:     print_status "Prometheus installed via package manager"
 88: }
 89: 
 90: # shellcheck disable=SC2120  # Function designed to accept optional version argument
 91: install_via_binary() {
 92:     local version="${1:-$PROM_VERSION}"
 93:     
 94:     print_info "Installing Prometheus ${version} from binary..."
 95:     
 96:     # Create user/group
 97:     if ! id "$PROM_USER" &>/dev/null; then
 98:         useradd --system --no-create-home --shell /usr/sbin/nologin "$PROM_USER"
 99:         print_status "Created prometheus user"
100:     fi
101:     
102:     # Download and extract
103:     local tmp_dir="/tmp/prometheus-install"
104:     mkdir -p "$tmp_dir"
105:     cd "$tmp_dir"
106:     
107:     local arch="amd64"
108:     local url="https://github.com/prometheus/prometheus/releases/download/v${version}/prometheus-${version}.linux-${arch}.tar.gz"
109:     
110:     print_info "Downloading from: $url"
111:     curl -sL "$url" -o prometheus.tar.gz || {
112:         print_error "Download failed"
113:         return 1
114:     }
115:     
116:     tar xzf prometheus.tar.gz
117:     cd "prometheus-${version}.linux-${arch}"
118:     
119:     # Install binaries
120:     install -m 0755 prometheus "${PROM_BIN}"
121:     install -m 0755 promtool "${PROMTOOL_BIN}"
122:     
123:     # Create directories
124:     mkdir -p "$PROM_DIR" "$PROM_DIR/rules" "$PROM_DIR/rules.d"
125:     mkdir -p "$PROM_DATA_DIR"
126:     
127:     # Install console templates and libraries
128:     cp -r consoles console_libraries "$PROM_DIR/"
129:     
130:     # Set ownership
131:     chown -R "$PROM_USER:$PROM_GROUP" "$PROM_DIR" "$PROM_DATA_DIR"
132:     
133:     # Cleanup
134:     cd /
135:     rm -rf "$tmp_dir"
136:     
137:     print_status "Prometheus binary installed"
138: }
139: 
140: create_systemd_service() {
141:     print_info "Creating systemd service..."
142: 
143:     cat > /etc/systemd/system/prometheus.service << EOF
144: [Unit]
145: Description=Prometheus
146: Documentation=https://prometheus.io/docs/introduction/overview/
147: Wants=network-online.target
148: After=network-online.target
149: 
150: [Service]
151: Type=simple
152: User=prometheus
153: Group=prometheus
154: ExecReload=/bin/kill -HUP \$MAINPID
155: ExecStart=${PROM_BIN} \\
156:   --config.file=/etc/prometheus/prometheus.yml \\
157:   --storage.tsdb.path=/var/lib/prometheus/ \\
158:   --web.console.templates=/etc/prometheus/consoles \\
159:   --web.console.libraries=/etc/prometheus/console_libraries \\
160:   --web.listen-address=127.0.0.1:9090 \\
161:   --storage.tsdb.retention.time=30d
162: 
163: SyslogIdentifier=prometheus
164: Restart=always
165: RestartSec=5
166: 
167: # Security
168: PrivateTmp=yes
169: ProtectSystem=strict
170: ProtectHome=yes
171: NoNewPrivileges=yes
172: ReadWritePaths=/var/lib/prometheus
173: 
174: [Install]
175: WantedBy=multi-user.target
176: EOF
177:     
178:     systemctl daemon-reload
179:     print_status "Systemd service created"
180: }
181: 
182: configure_prometheus() {
183:     print_info "Configuring Prometheus for NFTBan..."
184:     
185:     # Backup existing config
186:     if [[ -f "$PROM_DIR/prometheus.yml" ]]; then
187:         cp "$PROM_DIR/prometheus.yml" "$PROM_DIR/prometheus.yml.backup"
188:     fi
189:     
190:     # Install NFTBan configuration
191:     if [[ -f /usr/share/doc/nftban/metrics/prometheus.yml.example ]]; then
192:         cp /usr/share/doc/nftban/metrics/prometheus.yml.example "$PROM_DIR/prometheus.yml"
193:     else
194:         # Create basic config
195:         cat > "$PROM_DIR/prometheus.yml" << 'EOF'
196: global:
197:   scrape_interval: 60s
198:   evaluation_interval: 60s
199: 
200: scrape_configs:
201:   - job_name: 'nftban'
202:     static_configs:
203:       - targets: ['localhost:9100']
204:     metric_relabel_configs:
205:       - source_labels: [__name__]
206:         regex: 'nftban_.*'
207:         action: keep
208: EOF
209:     fi
210:     
211:     chown "$PROM_USER:$PROM_GROUP" "$PROM_DIR/prometheus.yml"
212:     print_status "Prometheus configured for NFTBan"
213: }
214: 
215: main() {
216:     print_info "NFTBan Prometheus Installation"
217:     echo ""
218:     
219:     # Check root
220:     if [[ $EUID -ne 0 ]]; then
221:         print_error "This script must be run as root"
222:         exit 1
223:     fi
224:     
225:     # Detect distro
226:     local distro
227:     distro=$(detect_distro)
228:     print_info "Detected distribution: $distro"
229:     
230:     # Try package install first, fall back to binary
231:     if ! install_via_package "$distro" 2>/dev/null; then
232:         print_info "Package not available, using binary installation"
233:         install_via_binary
234:         create_systemd_service
235:     fi
236:     
237:     # Configure
238:     configure_prometheus
239:     
240:     # Enable and start
241:     systemctl enable prometheus
242:     systemctl start prometheus
243:     
244:     # Wait and check
245:     sleep 3
246:     if systemctl is-active --quiet prometheus; then
247:         print_status "Prometheus is running"
248:         print_info "Web UI: http://127.0.0.1:9090"
249:         print_info "Config: $PROM_DIR/prometheus.yml"
250:         print_info "Data: $PROM_DATA_DIR"
251:     else
252:         print_error "Prometheus failed to start"
253:         systemctl status prometheus
254:         exit 1
255:     fi

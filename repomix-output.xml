169: func cmdPortsLoad(portsDir string) error {
170: 	// Check for privilege (root OR CAP_NET_ADMIN capability)
171: 	if err := checkPrivilege(); err != nil {
172: 		return err
173: 	}
174: 
175: 	fmt.Println(version.BannerWithEmoji("🔌", "Load Port Rules"))
176: 	fmt.Println(strings.Repeat("=", 70))
177: 	fmt.Println()
178: 
179: 	// Step 1: Detect IP family support (CRITICAL!)
180: 	fmt.Println("Step 1: Detecting IP family support...")
181: 	ipSupport, err := network.DetectIPFamilySupport()
182: 	if err != nil {
183: 		return fmt.Errorf("failed to detect IP families: %w", err)
184: 	}
185: 	fmt.Printf("  ✅ System: %s\n", ipSupport.String())
186: 
187: 	if !ipSupport.HasIPv4 && !ipSupport.HasIPv6 {
188: 		return fmt.Errorf("no IP connectivity detected: system has no IPv4 or IPv6 addresses")
189: 	}
190: 
191: 	// Show what will be created
192: 	fmt.Println()
193: 	fmt.Println("  Will create rules for:")
194: 	if ipSupport.HasIPv4 {
195: 		fmt.Println("  ✅ IPv4 (system has IPv4 addresses)")
196: 	} else {
197: 		fmt.Println("  ⏭️  IPv4 SKIPPED (system has NO IPv4 addresses)")
198: 	}
199: 	if ipSupport.HasIPv6 {
200: 		fmt.Println("  ✅ IPv6 (system has IPv6 addresses)")
201: 	} else {
202: 		fmt.Println("  ⏭️  IPv6 SKIPPED (system has NO IPv6 addresses)")
203: 	}
204: 	fmt.Println()
205: 
206: 	// Step 2: Load port configuration
207: 	fmt.Println("Step 2: Loading port configuration...")
208: 	config, err := ports.LoadPortsFromDirectory(portsDir)
209: 	if err != nil {
210: 		return fmt.Errorf("failed to load ports: %w", err)
211: 	}
212: 
213: 	if len(config.AllRules) == 0 {
214: 		fmt.Println("  ⚠️  No port rules found")
215: 		fmt.Println()
216: 		fmt.Println("Create port configuration in: " + portsDir)
217: 		fmt.Println("Format: PORT/PROTOCOL (T=TCP, U=UDP, B=Both)")
218: 		return nil
219: 	}
220: 
221: 	fmt.Printf("  ✅ Loaded %d port rules\n", len(config.AllRules))
222: 	fmt.Printf("  ✅ TCP ports: %d\n", len(config.TCPPorts))
223: 	fmt.Printf("  ✅ UDP ports: %d\n", len(config.UDPPorts))
224: 	fmt.Println()
225: 
226: 	// Step 3: Initialize nftables manager
227: 	fmt.Println("Step 3: Connecting to nftables...")
228: 	nft, err := sync.NewNFTManager()
229: 	if err != nil {
230: 		return fmt.Errorf("failed to create nftables manager: %w", err)
231: 	}
232: 	defer nft.Close()
233: 	fmt.Println("  ✅ Connected to nftables")
234: 	fmt.Println()
235: 
236: 	// Step 4: ALWAYS create port sets for BOTH IPv4 and IPv6 (for compatibility)
237: 	// But only load data into families that actually exist on the system
238: 	fmt.Println("Step 4: Creating port sets in nftables...")
239: 
240: 	// Create IPv4 table and sets (ALWAYS - even if no IPv4)
241: 	fmt.Println("  Creating IPv4 port sets...")
242: 	ipv4Table, err := nft.GetOrCreateTable(nftables.TableFamilyIPv4)
243: 	if err != nil {
244: 		return fmt.Errorf("failed to get IPv4 table: %w", err)
245: 	}
246: 
247: 	tcpSetV4, err := nft.GetOrCreatePortSet(ipv4Table, "tcp_ports")
248: 	if err != nil {
249: 		return fmt.Errorf("failed to create IPv4 tcp_ports set: %w", err)
250: 	}
251: 	fmt.Println("  ✅ Created/verified tcp_ports set (IPv4)")
252: 
253: 	udpSetV4, err := nft.GetOrCreatePortSet(ipv4Table, "udp_ports")
254: 	if err != nil {
255: 		return fmt.Errorf("failed to create IPv4 udp_ports set: %w", err)
256: 	}
257: 	fmt.Println("  ✅ Created/verified udp_ports set (IPv4)")
258: 
259: 	// Create IPv6 table and sets (ALWAYS - even if no IPv6)
260: 	fmt.Println("  Creating IPv6 port sets...")
261: 	ipv6Table, err := nft.GetOrCreateTable(nftables.TableFamilyIPv6)
262: 	if err != nil {
263: 		return fmt.Errorf("failed to get IPv6 table: %w", err)
264: 	}
265: 
266: 	tcpSetV6, err := nft.GetOrCreatePortSet(ipv6Table, "tcp_ports")
267: 	if err != nil {
268: 		return fmt.Errorf("failed to create IPv6 tcp_ports set: %w", err)
269: 	}
270: 	fmt.Println("  ✅ Created/verified tcp_ports set (IPv6)")
271: 
272: 	udpSetV6, err := nft.GetOrCreatePortSet(ipv6Table, "udp_ports")
273: 	if err != nil {
274: 		return fmt.Errorf("failed to create IPv6 udp_ports set: %w", err)
275: 	}
276: 	fmt.Println("  ✅ Created/verified udp_ports set (IPv6)")
277: 	fmt.Println()
278: 
279: 	// Step 5: Load ports ONLY into families that exist on the system
280: 	fmt.Println("Step 5: Loading ports into nftables sets...")
281: 
282: 	// Load IPv4 ports (only if system has IPv4)
283: 	if ipSupport.HasIPv4 {
284: 		if len(config.TCPPorts) > 0 {
285: 			if err := nft.AddPortElements(tcpSetV4, config.TCPPorts); err != nil {
286: 				return fmt.Errorf("failed to add IPv4 TCP ports: %w", err)
287: 			}
288: 			fmt.Printf("  ✅ Loaded %d TCP ports into IPv4 set\n", len(config.TCPPorts))
289: 		}
290: 		if len(config.UDPPorts) > 0 {
291: 			if err := nft.AddPortElements(udpSetV4, config.UDPPorts); err != nil {
292: 				return fmt.Errorf("failed to add IPv4 UDP ports: %w", err)
293: 			}
294: 			fmt.Printf("  ✅ Loaded %d UDP ports into IPv4 set\n", len(config.UDPPorts))
295: 		}
296: 	} else {
297: 		fmt.Println("  ⏭️  IPv4 sets left EMPTY (system has no IPv4 addresses)")
298: 	}
299: 
300: 	// Load IPv6 ports (only if system has IPv6)
301: 	if ipSupport.HasIPv6 {
302: 		if len(config.TCPPorts) > 0 {
303: 			if err := nft.AddPortElements(tcpSetV6, config.TCPPorts); err != nil {
304: 				return fmt.Errorf("failed to add IPv6 TCP ports: %w", err)
305: 			}
306: 			fmt.Printf("  ✅ Loaded %d TCP ports into IPv6 set\n", len(config.TCPPorts))
307: 		}
308: 		if len(config.UDPPorts) > 0 {
309: 			if err := nft.AddPortElements(udpSetV6, config.UDPPorts); err != nil {
310: 				return fmt.Errorf("failed to add IPv6 UDP ports: %w", err)
311: 			}
312: 			fmt.Printf("  ✅ Loaded %d UDP ports into IPv6 set\n", len(config.UDPPorts))
313: 		}
314: 	} else {
315: 		fmt.Println("  ⏭️  IPv6 sets left EMPTY (system has no IPv6 addresses)")
316: 	}
317: 
318: 	fmt.Println()
319: 	fmt.Println(strings.Repeat("=", 70))
320: 	fmt.Printf("✅ Port rules loaded successfully!\n")
321: 	fmt.Println()
322: 	fmt.Printf("System configuration: %s\n", ipSupport.String())
323: 	fmt.Printf("TCP ports loaded: %d\n", len(config.TCPPorts))
324: 	fmt.Printf("UDP ports loaded: %d\n", len(config.UDPPorts))
325: 	fmt.Println()
326: 	fmt.Println("Port sets are now configured in nftables.")
327: 	fmt.Println("Use firewall rules to reference @tcp_ports and @udp_ports sets.")
328: 	fmt.Println()
329: 
330: 	return nil
331: }

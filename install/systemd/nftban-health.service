[Unit]
Description=NFTBan Periodic Health Check with Auto-Heal
Documentation=man:nftban(8)
After=network.target nftables.service

[Service]
Type=oneshot

# Runs as nftban; auto-heal actions are constrained by systemd + polkit + CAP_NET_ADMIN.
# Polkit allowlist (10-nftban-systemd.rules) controls which units can be restarted.
# Root-only operations (chown, system config) are skipped gracefully.
# For full root-level fixes: systemctl start nftban-health-fix.service (manual)
User=nftban
Group=nftban

# --auto-heal: Fix what nftban user can (services via polkit, nftables via CAP_NET_ADMIN)
# --cache-status: Write health result for banner display
# flock: Prevent timer+manual overlap (non-blocking, exit if already running)
# NOTE: Lock file in /var/cache/nftban (owned by nftban:nftban) NOT /run/nftban
#       to avoid chicken-and-egg: health check can't run if /run/nftban perms broken
ExecStart=/usr/bin/flock -n /var/cache/nftban/health.lock /usr/sbin/nftban health check --auto-heal --cache-status

# v1.98: Trigger root-level safe auto-fix if health check found permission issues.
# The health check runs as nftban and can fix services/nftables but NOT file permissions.
# nftban-health-fix.service runs as root and can fix ownership/mode drift.
# Only runs if health-fix.service is not already running. Fails silently if not needed.
# INV-I-010: One-shot safe auto-fix trigger from check → fix.
ExecStartPost=-/usr/bin/systemctl start --no-block nftban-health-fix.service

# CAP_NET_ADMIN required for nft list/add operations (health checks + auto-heal)
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN

# Exit codes: 0=OK, 1=warnings, 2=errors
SuccessExitStatus=0 1 2

# =============================================================================
# SECURITY HARDENING
# =============================================================================

# Core hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

# Minimal filesystem access (includes /run/nftban for flock)
ReadWritePaths=/var/lib/nftban /var/cache/nftban /var/log/nftban /run/nftban

# Network for nft list operations
RestrictAddressFamilies=AF_UNIX AF_NETLINK

# Resource limits
MemoryMax=128M
TasksMax=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nftban-health

[Install]
WantedBy=multi-user.target

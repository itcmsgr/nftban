1008: nftban_stats_create_snapshot() {
1009:     # Create hourly snapshot for trending
1010:     # Usage: nftban_stats_create_snapshot
1011: 
1012:     local timestamp
1013:     timestamp=$(date +%Y%m%d-%H%M%S)
1014:     local snapshot_file="${NFTBAN_STATS_SNAPSHOTS_DIR}/snapshot-${timestamp}.json"
1015: 
1016:     local since
1017:     local until
1018:     since="$(date -d '1 hour ago' +%Y-%m-%d\ %H:%M:%S)"
1019:     until="$(date +%Y-%m-%d\ %H:%M:%S)"
1020: 
1021:     nftban_stats_export_json "$snapshot_file" "$since" "$until" &>/dev/null
1022: 
1023:     echo "$snapshot_file"
1024: }
1025: 
1026: # =============================================================================
1027: # TREND ANALYSIS (7-day rolling history)
1028: # =============================================================================
1029: 
1030: # Storage paths for trend data
1031: readonly NFTBAN_TREND_DIR="${NFTBAN_DATA_DIR:-/var/lib/nftban}/stats"
1032: readonly NFTBAN_TREND_FILE="${NFTBAN_TREND_DIR}/trend_hourly.json"
1033: readonly NFTBAN_TREND_RETENTION=168  # 7 days in hours
1034: 
1035: nftban_stats_trend_collect() {
1036:     # Collect current hour statistics and append to trend history
1037:     # Called hourly by maintenance timer
1038:     # Usage: nftban_stats_trend_collect
1039: 
1040:     mkdir -p "$NFTBAN_TREND_DIR" 2>/dev/null || true
1041: 
1042:     local hour_start hour_end
1043:     hour_end=$(date +%Y-%m-%dT%H:%M:%SZ)  # shellcheck disable=SC2034  # Reserved for time range
1044:     hour_end=$(date +%Y-%m-%dT%H:%M:%SZ)
1045: 
1046:     # Count bans/unbans in current hour
1047:     local today bans unbans
1048:     today=$(date +%Y-%m-%d)
1049:     local hour_pattern
1050:     hour_pattern="^${today}|$(date +%H):"
1051: 
1052:     if [[ -f "$NFTBAN_BAN_LOG" ]]; then
1053:         bans=$(grep -c "BANNED$" "$NFTBAN_BAN_LOG" 2>/dev/null | grep -cE "$hour_pattern" 2>/dev/null) || bans=0
1054:         unbans=$(grep -c "UNBANNED$" "$NFTBAN_BAN_LOG" 2>/dev/null | grep -cE "$hour_pattern" 2>/dev/null) || unbans=0
1055: 
1056:         # Simpler: count today's bans in current hour
1057:         bans=$(awk -F'|' -v h="$(date +%H)" '$1 ~ /^[0-9]/ && $2 ~ "^"h":" && $6=="BANNED" {c++} END {print c+0}' "$NFTBAN_BAN_LOG" 2>/dev/null) || bans=0
1058:         unbans=$(awk -F'|' -v h="$(date +%H)" '$1 ~ /^[0-9]/ && $2 ~ "^"h":" && $6=="UNBANNED" {c++} END {print c+0}' "$NFTBAN_BAN_LOG" 2>/dev/null) || unbans=0
1059:     else
1060:         bans=0
1061:         unbans=0
1062:     fi
1063: 
1064:     # Count by source
1065:     local login_c=0 portscan_c=0 feeds_c=0 ddos_c=0 manual_c=0
1066:     if [[ -f "$NFTBAN_BAN_LOG" ]]; then
1067:         login_c=$(awk -F'|' -v h="$(date +%H)" '$2 ~ "^"h":" && $3=="login" && $6=="BANNED" {c++} END {print c+0}' "$NFTBAN_BAN_LOG" 2>/dev/null) || login_c=0
1068:         portscan_c=$(awk -F'|' -v h="$(date +%H)" '$2 ~ "^"h":" && $3=="portscan" && $6=="BANNED" {c++} END {print c+0}' "$NFTBAN_BAN_LOG" 2>/dev/null) || portscan_c=0
1069:         feeds_c=$(awk -F'|' -v h="$(date +%H)" '$2 ~ "^"h":" && $3=="feeds" && $6=="BANNED" {c++} END {print c+0}' "$NFTBAN_BAN_LOG" 2>/dev/null) || feeds_c=0
1070:         ddos_c=$(awk -F'|' -v h="$(date +%H)" '$2 ~ "^"h":" && $3=="ddos" && $6=="BANNED" {c++} END {print c+0}' "$NFTBAN_BAN_LOG" 2>/dev/null) || ddos_c=0
1071:         manual_c=$(awk -F'|' -v h="$(date +%H)" '$2 ~ "^"h":" && $3=="manual" && $6=="BANNED" {c++} END {print c+0}' "$NFTBAN_BAN_LOG" 2>/dev/null) || manual_c=0
1072:     fi
1073: 
1074:     # Create new sample JSON
1075:     local sample
1076:     sample=$(cat <<EOF
1077: {"hour":"${hour_start}","bans":${bans},"unbans":${unbans},"sources":{"login":${login_c},"portscan":${portscan_c},"feeds":${feeds_c},"ddos":${ddos_c},"manual":${manual_c}}}
1078: EOF
1079: )
1080: 
1081:     # Load existing data, append, and enforce retention
1082:     local temp_file="${NFTBAN_TREND_FILE}.tmp"
1083: 
1084:     if [[ -f "$NFTBAN_TREND_FILE" ]] && command -v jq &>/dev/null; then
1085:         # Append and trim to retention limit
1086:         jq --argjson new "$sample" --argjson max "$NFTBAN_TREND_RETENTION" \
1087:             '.samples += [$new] | .samples = .samples[-$max:]' \
1088:             "$NFTBAN_TREND_FILE" > "$temp_file" 2>/dev/null && \
1089:             mv "$temp_file" "$NFTBAN_TREND_FILE"
1090:     else
1091:         # Initialize new file
1092:         echo "{\"samples\":[$sample],\"retention_hours\":$NFTBAN_TREND_RETENTION}" > "$NFTBAN_TREND_FILE"
1093:     fi
1094: 
1095:     chown nftban:nftban "$NFTBAN_TREND_FILE" 2>/dev/null || true
1096:     chmod 640 "$NFTBAN_TREND_FILE" 2>/dev/null || true
1097: }
1098: 
1099: nftban_stats_trend_load() {
1100:     # Load trend history
1101:     # Usage: nftban_stats_trend_load
1102:     # Returns: JSON array of samples
1103: 
1104:     if [[ -f "$NFTBAN_TREND_FILE" ]] && command -v jq &>/dev/null; then
1105:         jq -r '.samples' "$NFTBAN_TREND_FILE" 2>/dev/null
1106:     else
1107:         echo "[]"
1108:     fi
1109: }
1110: 
1111: nftban_stats_trend_averages() {
1112:     # Calculate averages from trend data
1113:     # Usage: nftban_stats_trend_averages
1114:     # Returns: JSON with avg, min, max, stddev
1115: 
1116:     if [[ ! -f "$NFTBAN_TREND_FILE" ]] || ! command -v jq &>/dev/null; then
1117:         echo '{"avg_hourly":0,"avg_daily":0,"min":0,"max":0,"stddev":0,"samples":0}'
1118:         return
1119:     fi
1120: 
1121:     jq '
1122:         .samples as $s |
1123:         ($s | length) as $n |
1124:         if $n == 0 then
1125:             {"avg_hourly":0,"avg_daily":0,"min":0,"max":0,"stddev":0,"samples":0}
1126:         else
1127:             ($s | map(.bans) | add / $n) as $avg |
1128:             ($s | map(.bans) | min) as $min |
1129:             ($s | map(.bans) | max) as $max |
1130:             ($s | map((.bans - $avg) * (.bans - $avg)) | add / $n | sqrt) as $stddev |
1131:             {
1132:                 "avg_hourly": ($avg | . * 10 | floor / 10),
1133:                 "avg_daily": ($avg * 24 | floor),
1134:                 "min": $min,
1135:                 "max": $max,
1136:                 "stddev": ($stddev | . * 10 | floor / 10),
1137:                 "samples": $n
1138:             }
1139:         end
1140:     ' "$NFTBAN_TREND_FILE" 2>/dev/null || echo '{"avg_hourly":0,"avg_daily":0,"min":0,"max":0,"stddev":0,"samples":0}'
1141: }
1142: 
1143: nftban_stats_trend_thresholds() {
1144:     # Calculate suggested thresholds based on stddev
1145:     # Usage: nftban_stats_trend_thresholds
1146:     # Returns: JSON with warning and critical thresholds
1147: 
1148:     local stats
1149:     stats=$(nftban_stats_trend_averages)
1150: 
1151:     if ! command -v jq &>/dev/null; then
1152:         echo '{"warning":10,"critical":25}'
1153:         return
1154:     fi
1155: 
1156:     echo "$stats" | jq '
1157:         (.avg_hourly + (1.5 * .stddev)) as $warn |
1158:         (.avg_hourly + (3 * .stddev)) as $crit |
1159:         {
1160:             "warning": ([($warn | floor), 10] | max),
1161:             "critical": ([($crit | floor), 25] | max),
1162:             "based_on_samples": .samples
1163:         }
1164:     ' 2>/dev/null || echo '{"warning":10,"critical":25,"based_on_samples":0}'
1165: }
1166: 
1167: nftban_stats_trend_compare() {
1168:     # Compare current period vs previous periods
1169:     # Usage: nftban_stats_trend_compare
1170:     # Returns: JSON with vs_yesterday and vs_last_week percentages
1171: 
1172:     if [[ ! -f "$NFTBAN_TREND_FILE" ]] || ! command -v jq &>/dev/null; then
1173:         echo '{"vs_yesterday":0,"vs_last_week":0}'
1174:         return
1175:     fi
1176: 
1177:     jq '
1178:         .samples as $s |
1179:         ($s | length) as $n |
1180:         if $n < 48 then
1181:             {"vs_yesterday":0,"vs_last_week":0,"insufficient_data":true}
1182:         else
1183:             # Last 24 hours
1184:             ($s[-24:] | map(.bans) | add) as $today |
1185:             # Previous 24 hours (24-48 hours ago)
1186:             ($s[-48:-24] | map(.bans) | add) as $yesterday |
1187:             # Calculate week comparison if enough data
1188:             (if $n >= 168 then ($s[-168:-144] | map(.bans) | add) else 0 end) as $last_week |
1189:             {
1190:                 "today_total": $today,
1191:                 "yesterday_total": $yesterday,
1192:                 "vs_yesterday": (if $yesterday > 0 then ((($today - $yesterday) / $yesterday * 100) | . * 10 | floor / 10) else 0 end),
1193:                 "vs_last_week": (if $last_week > 0 and $n >= 168 then ((($today - $last_week) / $last_week * 100) | . * 10 | floor / 10) else null end)
1194:             }
1195:         end
1196:     ' "$NFTBAN_TREND_FILE" 2>/dev/null || echo '{"vs_yesterday":0,"vs_last_week":0}'
1197: }
1198: 
1199: nftban_stats_trend_top_sources() {
1200:     # Get source breakdown for trend period
1201:     # Usage: nftban_stats_trend_top_sources
1202:     # Returns: JSON with source totals and percentages
1203: 
1204:     if [[ ! -f "$NFTBAN_TREND_FILE" ]] || ! command -v jq &>/dev/null; then
1205:         echo '[]'
1206:         return
1207:     fi
1208: 
1209:     jq '
1210:         .samples | map(.sources) |
1211:         reduce .[] as $s ({"login":0,"portscan":0,"feeds":0,"ddos":0,"manual":0};
1212:             . + {
1213:                 "login": (.login + $s.login),
1214:                 "portscan": (.portscan + $s.portscan),
1215:                 "feeds": (.feeds + $s.feeds),
1216:                 "ddos": (.ddos + $s.ddos),
1217:                 "manual": (.manual + $s.manual)
1218:             }
1219:         ) |
1220:         . as $totals |
1221:         ($totals | add) as $grand_total |
1222:         to_entries | map({
1223:             "source": .key,
1224:             "count": .value,
1225:             "percent": (if $grand_total > 0 then (.value / $grand_total * 100 | . * 10 | floor / 10) else 0 end)
1226:         }) | sort_by(-.count)
1227:     ' "$NFTBAN_TREND_FILE" 2>/dev/null || echo '[]'
1228: }
1229: 
1230: nftban_stats_trend_display() {
1231:     # Display formatted trend analysis
1232:     # Usage: nftban_stats_trend_display [--json]
1233: 
1234:     local json_mode=0
1235:     [[ "${1:-}" == "--json" ]] && json_mode=1
1236: 
1237:     if [[ $json_mode -eq 1 ]]; then
1238:         # JSON output
1239:         local averages compare sources thresholds hourly_data
1240:         averages=$(nftban_stats_trend_averages)
1241:         compare=$(nftban_stats_trend_compare)
1242:         sources=$(nftban_stats_trend_top_sources)
1243:         thresholds=$(nftban_stats_trend_thresholds)
1244: 
1245:         # Get hourly data points for charting (last 168 hours / 7 days)
1246:         if [[ -f "$NFTBAN_TREND_FILE" ]] && command -v jq &>/dev/null; then
1247:             hourly_data=$(jq '[.samples[] | {hour: .hour, bans: .bans, sources: .sources}]' "$NFTBAN_TREND_FILE" 2>/dev/null || echo '[]')
1248:         else
1249:             hourly_data='[]'
1250:         fi
1251: 
1252:         jq -n --argjson avg "$averages" --argjson cmp "$compare" \
1253:               --argjson src "$sources" --argjson thr "$thresholds" \
1254:               --argjson hourly "$hourly_data" \
1255:             '{averages: $avg, comparison: $cmp, sources: $src, thresholds: $thr, hourly: $hourly}'
1256:         return
1257:     fi
1258: 
1259:     # Text output
1260:     echo ""
1261:     echo "BAN STATISTICS TREND (Last 7 Days)"
1262:     echo "══════════════════════════════════════════════════════════════"
1263:     echo ""
1264: 
1265:     # Get data
1266:     local avg_data compare_data sources_data threshold_data
1267:     avg_data=$(nftban_stats_trend_averages)
1268:     compare_data=$(nftban_stats_trend_compare)
1269:     sources_data=$(nftban_stats_trend_top_sources)
1270:     threshold_data=$(nftban_stats_trend_thresholds)
1271: 
1272:     if ! command -v jq &>/dev/null; then
1273:         echo "[WARN] jq not installed - trend analysis requires jq"
1274:         return 1
1275:     fi
1276: 
1277:     local samples avg_h avg_d min_v max_v
1278:     samples=$(echo "$avg_data" | jq -r '.samples')
1279:     avg_h=$(echo "$avg_data" | jq -r '.avg_hourly')
1280:     avg_d=$(echo "$avg_data" | jq -r '.avg_daily')
1281:     min_v=$(echo "$avg_data" | jq -r '.min')
1282:     max_v=$(echo "$avg_data" | jq -r '.max')
1283: 
1284:     if [[ "$samples" == "0" ]]; then
1285:         echo "  No trend data available yet."
1286:         echo "  Trend data is collected every 15 minutes by the maintenance timer."
1287:         echo ""
1288:         echo "  Enable timer: nftban timers enable nftban-maintenance.timer"
1289:         return 0
1290:     fi
1291: 
1292:     echo "AVERAGES (${samples} samples)"
1293:     echo "───────────────────────────────────────────────────────────────"
1294:     printf "  %-20s %s (min: %s, max: %s)\n" "Bans per hour......." "$avg_h" "$min_v" "$max_v"
1295:     printf "  %-20s %s\n" "Bans per day........" "$avg_d"
1296:     echo ""
1297: 
1298:     # Suggested thresholds
1299:     local warn_t crit_t
1300:     warn_t=$(echo "$threshold_data" | jq -r '.warning')
1301:     crit_t=$(echo "$threshold_data" | jq -r '.critical')
1302: 
1303:     echo "SUGGESTED THRESHOLDS (based on stddev)"
1304:     echo "───────────────────────────────────────────────────────────────"
1305:     printf "  %-20s %s/hour\n" "Warning threshold..." "$warn_t"
1306:     printf "  %-20s %s/hour\n" "Critical threshold.." "$crit_t"
1307:     echo ""
1308: 
1309:     # Trend direction
1310:     local vs_yest vs_week today_t yest_t
1311:     vs_yest=$(echo "$compare_data" | jq -r '.vs_yesterday')
1312:     vs_week=$(echo "$compare_data" | jq -r '.vs_last_week // "N/A"')
1313:     today_t=$(echo "$compare_data" | jq -r '.today_total // 0')
1314:     yest_t=$(echo "$compare_data" | jq -r '.yesterday_total // 0')
1315: 
1316:     echo "TREND DIRECTION"
1317:     echo "───────────────────────────────────────────────────────────────"
1318: 
1319:     local arrow_yest="→"
1320:     if [[ "$vs_yest" != "0" ]] && [[ "$vs_yest" != "null" ]]; then
1321:         if (( $(echo "$vs_yest > 0" | bc -l 2>/dev/null || echo 0) )); then
1322:             arrow_yest="↑"
1323:         elif (( $(echo "$vs_yest < 0" | bc -l 2>/dev/null || echo 0) )); then
1324:             arrow_yest="↓"
1325:         fi
1326:     fi
1327:     printf "  %-20s %s %s%% (%s → %s)\n" "vs Yesterday........" "$arrow_yest" "$vs_yest" "$yest_t" "$today_t"
1328: 
1329:     if [[ "$vs_week" != "null" ]] && [[ "$vs_week" != "N/A" ]]; then
1330:         local arrow_week="→"
1331:         if (( $(echo "$vs_week > 0" | bc -l 2>/dev/null || echo 0) )); then
1332:             arrow_week="↑"
1333:         elif (( $(echo "$vs_week < 0" | bc -l 2>/dev/null || echo 0) )); then
1334:             arrow_week="↓"
1335:         fi
1336:         printf "  %-20s %s %s%%\n" "vs Last Week........" "$arrow_week" "$vs_week"
1337:     else
1338:         printf "  %-20s %s\n" "vs Last Week........" "(need 7 days of data)"
1339:     fi
1340:     echo ""
1341: 
1342:     # Top sources
1343:     echo "TOP SOURCES (7-day)"
1344:     echo "───────────────────────────────────────────────────────────────"
1345:     echo "$sources_data" | jq -r '.[] | select(.count > 0) | "  \(.source)............ \(.percent)% (\(.count) bans)"' 2>/dev/null || true
1346:     echo ""
1347:     echo "══════════════════════════════════════════════════════════════"
1348: }
1349: 
1350: # =============================================================================
1351: # MODULE INITIALIZATION
1352: # =============================================================================
1353: 
1354: # Module loaded
1355: if type -t nftban_print_status >/dev/null 2>&1; then
1356:     nftban_print_status "debug" "Stats module loaded"
1357: fi
</file>

<file path="cli/lib/nftban/core/nftban_validator.sh">
  1: #!/usr/bin/env bash
  2: # shellcheck disable=SC1083  # Braces in nftables syntax are literal, not bash
  3: # =============================================================================
  4: # NFTBan v1.0.0 - NFTables Validator Core Library
  5: # =============================================================================
  6: # SPDX-License-Identifier: MPL-2.0
  7: # Purpose: Core validation and checking functions for nftables structure
  8: #
  9: # meta:name=nftban_validator
 10: # meta:type=core
 11: # meta:header=NFTBan Validator Library
 12: # meta:version=1.0.0
 13: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 14: # meta:homepage=https://nftban.com
 15: #
 16: # **Description & Purpose**
 17: # meta:description=Provides validation logic for nftables structure, IP/port checking, and firewall statistics
 18: # meta:input=Spec file (JSON), live nftables ruleset, IP/port values
 19: # meta:output=Validation results, IP/port status, firewall statistics (JSON or human-readable)
 20: #
 21: # **Inventory & Requirements**
 22: # meta:depends=bash,nft,jq
 23: #
 24: # meta:created_date=2025-11-13
 25: # meta:updated_date=2025-11-24
 26: 
 27: 
 28: # =============================================================================
 29: # CONFIGURATION
 30: # =============================================================================
 31: 
 32: # NFTBAN_LIB_DIR is set by the calling script (cmd_validator.sh, etc.)
 33: # Don't set it here - just use it with fallback
 34: 
 35: # Load strict mode library
 36: # shellcheck source=/usr/lib/nftban/lib/strict.sh
 37: if [[ -f "${NFTBAN_LIB_DIR:-/usr/lib/nftban}/lib/strict.sh" ]]; then
 38:     source "${NFTBAN_LIB_DIR:-/usr/lib/nftban}/lib/strict.sh"
 39: else
 40:     # Fallback to manual strict mode
 41:     set -Eeuo pipefail
 42: fi
 43: 
 44: # Load version library
 45: # shellcheck source=/usr/lib/nftban/lib/version.sh
 46: if [[ -f "${NFTBAN_LIB_DIR:-/usr/lib/nftban}/lib/version.sh" ]]; then
 47:     source "${NFTBAN_LIB_DIR:-/usr/lib/nftban}/lib/version.sh"
 48: fi
 49: NFTBAN_SHARE_DIR="${NFTBAN_SHARE_DIR:-/usr/share/nftban}"
 50: 
 51: # =============================================================================
 52: # SPEC FILE MANAGEMENT
 53: # =============================================================================
 54: 
 55: load_spec() {
 56:     # Load NFTBan structure specification file
 57:     # Priority: user override > default spec
 58:     # Returns: Spec file contents (JSON)
 59: 
 60:     local spec_file=""
 61: 
 62:     # Priority: user override > default spec
 63:     if [[ -f "${NFTBAN_CONFIG_DIR}/spec.json" ]]; then
 64:         spec_file="${NFTBAN_CONFIG_DIR}/spec.json"
 65:     elif [[ -f "/usr/share/nftban/specs/structure_default.json" ]]; then
 66:         spec_file="/usr/share/nftban/specs/structure_default.json"
 67:     elif [[ -f "${NFTBAN_SHARE_DIR}/specs/structure_default.json" ]]; then
 68:         spec_file="${NFTBAN_SHARE_DIR}/specs/structure_default.json"
 69:     else
 70:         echo "ERROR: Cannot find spec file" >&2
 71:         return 1
 72:     fi
 73: 
 74:     if ! jq -e . "$spec_file" >/dev/null 2>&1; then
 75:         echo "ERROR: Invalid JSON in spec file: $spec_file" >&2
 76:         return 1
 77:     fi
 78: 
 79:     cat "$spec_file"
 80: }
 81: 
 82: # =============================================================================
 83: # NFTABLES QUERY
 84: # =============================================================================
 85: 
 86: get_live_ruleset() {
 87:     # Get live nftables ruleset as JSON
 88:     # Returns: Full ruleset in JSON format
 89: 
 90:     local output
 91:     output=$(nft -j list ruleset 2>&1)
 92:     local rc=$?
 93: 
 94:     if [[ $rc -ne 0 ]]; then
 95:         echo "{\"error\": \"Failed to get nftables ruleset: $output\"}" >&2
 96:         return 1
 97:     fi
 98: 
 99:     echo "$output"
100: }
101: 
102: # =============================================================================
103: # STRUCTURE VALIDATION
104: # =============================================================================
105: 
106: validate_structure() {
107:     # Validate nftables structure against spec
108:     # Args: $1 = output_json (true/false)
109:     # Returns: 0 if OK, 1 if errors found
110: 
111:     local output_json="${1:-false}"
112:     local spec ruleset
113:     local errors=() warnings=() info=()
114: 
115:     # Load spec
116:     spec=$(load_spec) || return 1
117: 
118:     # Get live ruleset
119:     ruleset=$(get_live_ruleset) || return 1
120: 
121:     # Check required tables
122:     local required_tables
123:     required_tables=$(echo "$spec" | jq -r '.expected_structure.validation_checks.required_tables[]')
124: 
125:     while IFS= read -r table; do
126:         [[ -z "$table" ]] && continue
127: 
128:         local table_family="${table%% *}"
129:         local table_name="${table#* }"
130: 
131:         if ! echo "$ruleset" | jq -e ".nftables[] | select(.table? and .table.family == \"$table_family\" and .table.name == \"$table_name\")" >/dev/null 2>&1; then
132:             errors+=("CRITICAL: Missing required table: $table")
133:         fi
134:     done <<< "$required_tables"
135: 
136:     # Check forbidden tables
137:     local forbidden_patterns
138:     forbidden_patterns=$(echo "$spec" | jq -r '.expected_structure.validation_checks.forbidden_table_patterns[]')
139: 
140:     while IFS= read -r pattern; do
141:         [[ -z "$pattern" ]] && continue
142: 
143:         local pattern_family="${pattern%% *}"
144:         local pattern_name="${pattern#* }"
145: 
146:         if echo "$ruleset" | jq -e ".nftables[] | select(.table? and .table.family == \"$pattern_family\" and .table.name == \"$pattern_name\")" >/dev/null 2>&1; then
147:             errors+=("CRITICAL: Forbidden table exists: $pattern (bypasses NFTBan!)")
148:         fi
149:     done <<< "$forbidden_patterns"
150: 
151:     # Check required sets
152:     local required_sets
153:     required_sets=$(echo "$spec" | jq -r '.expected_structure.validation_checks.required_sets[]')
154: 
155:     while IFS= read -r set_path; do
156:         [[ -z "$set_path" ]] && continue
157: 
158:         local set_family="${set_path%% *}"
159:         local set_table="${set_path#* }"
160:         set_table="${set_table%% *}"
161:         local set_name="${set_path##* }"
162: 
163:         if ! echo "$ruleset" | jq -e ".nftables[] | select(.set? and .set.family == \"$set_family\" and .set.table == \"$set_table\" and .set.name == \"$set_name\")" >/dev/null 2>&1; then
164:             warnings+=("WARNING: Missing required set: $set_path")
165:         fi
166:     done <<< "$required_sets"
167: 
168:     # Check chain policies
169:     local policy_checks
170:     policy_checks=$(echo "$spec" | jq -r '.expected_structure.validation_checks.policy_checks | to_entries[] | "\(.key)=\(.value)"')
171: 
172:     while IFS= read -r policy_check; do
173:         [[ -z "$policy_check" ]] && continue
174: 
175:         local chain_path="${policy_check%%=*}"
176:         local expected_policy="${policy_check##*=}"
177: 
178:         local chain_family="${chain_path%% *}"
179:         local chain_table="${chain_path#* }"
180:         chain_table="${chain_table%% *}"
181:         local chain_name="${chain_path##* }"
182: 
183:         local actual_policy
184:         actual_policy=$(echo "$ruleset" | jq -r ".nftables[] | select(.chain? and .chain.family == \"$chain_family\" and .chain.table == \"$chain_table\" and .chain.name == \"$chain_name\") | .chain.policy // empty")
185: 
186:         if [[ -n "$actual_policy" && "$actual_policy" != "$expected_policy" ]]; then
187:             errors+=("CRITICAL: Wrong policy on $chain_path: expected '$expected_policy', got '$actual_policy'")
188:         fi
189:     done <<< "$policy_checks"
190: 
191:     # Determine overall status
192:     local status="OK"
193:     if [[ ${#errors[@]} -gt 0 ]]; then
194:         status="ERROR"
195:     elif [[ ${#warnings[@]} -gt 0 ]]; then
196:         status="WARNING"
197:     fi
198: 
199:     # Output results
200:     if [[ "$output_json" == "true" ]]; then
201:         jq -n \
202:             --arg status "$status" \
203:             --argjson errors "$(printf '%s\n' "${errors[@]}" | jq -R . | jq -s .)" \
204:             --argjson warnings "$(printf '%s\n' "${warnings[@]}" | jq -R . | jq -s .)" \
205:             --argjson info "$(printf '%s\n' "${info[@]}" | jq -R . | jq -s .)" \
206:             '{status: $status, errors: $errors, warnings: $warnings, info: $info}'
207:     else
208:         # Human-readable output
209:         echo "NFTBan Structure Validation"
210:         echo "============================"
211:         echo ""
212:         echo "Status: $status"
213:         echo ""
214: 
215:         if [[ ${#errors[@]} -gt 0 ]]; then
216:             echo "❌ ERRORS (${#errors[@]}):"
217:             printf '  %s\n' "${errors[@]}"
218:             echo ""
219:         fi
220: 
221:         if [[ ${#warnings[@]} -gt 0 ]]; then
222:             echo "⚠️  WARNINGS (${#warnings[@]}):"
223:             printf '  %s\n' "${warnings[@]}"
224:             echo ""
225:         fi
226: 
227:         if [[ ${#errors[@]} -eq 0 && ${#warnings[@]} -eq 0 ]]; then
228:             echo "✅ All validation checks passed!"
229:         fi
230:     fi
231: 
232:     # Return non-zero if errors
233:     [[ ${#errors[@]} -eq 0 ]]
234: }
235: 
236: # =============================================================================
237: # IP/PORT CHECKING
238: # =============================================================================
239: 
240: check_ip_or_port() {
241:     # Check if IP or port is blocked/allowed in nftables
242:     # Args: $1 = value (IP or port), $2 = output_json (true/false)
243:     # Returns: Status, matched rule, processing path, available actions
244: 
245:     local value="$1"
246:     local output_json="${2:-false}"
247: 
248:     if [[ -z "$value" ]]; then
249:         echo "ERROR: No value provided" >&2
250:         return 1
251:     fi
252: 
253:     # Detect type: IP (contains . or :) or port (numeric)
254:     local value_type="unknown"
255:     if [[ "$value" =~ ^[0-9]+$ ]]; then
256:         value_type="port"
257:     elif [[ "$value" =~ \. || "$value" =~ : ]]; then
258:         value_type="ip"
259:     else
260:         echo "ERROR: Invalid value format: $value" >&2
261:         return 1
262:     fi
263: 
264:     # Get live ruleset
265:     local ruleset
266:     ruleset=$(get_live_ruleset) || return 1
267: 
268:     # Initialize result
269:     local status="unknown"
270:     local matched_table=""
271:     local matched_chain=""
272:     local matched_set=""
273:     local matched_rule=""
274:     local verdict=""
275:     local priority=0
276:     local processing_path=()
277: 
278:     # Check processing path for new architecture (v0.7.3)
279:     # New architecture uses ip/ip6 nftban tables (not inet)
280:     # Single blacklist set with timeout support (no separate temp_ban)
281: 
282:     if [[ "$value_type" == "ip" ]]; then
283:         # Detect if IPv4 or IPv6
284:         local table_family="ip"
285:         local set_suffix="ipv4"
286:         if [[ "$value" =~ : ]]; then
287:             table_family="ip6"
288:             set_suffix="ipv6"
289:         fi
290: 
291:         processing_path+=("→ Checking ${table_family} nftban input (priority 0)")
292: 
293:         # Check whitelist first (highest priority in ruleset)
294:         if nft get element "${table_family}" nftban "whitelist_${set_suffix}" { "$value" } >/dev/null 2>&1; then
295:             status="allowed"
296:             matched_table="${table_family} nftban"
297:             matched_chain="input"
298:             matched_set="whitelist_${set_suffix}"
299:             verdict="accept"
300:             priority=0
301:             processing_path+=("  ✅ MATCHED: whitelist_${set_suffix} → ACCEPT (full access)")
302:         # Check blacklist (permanent + temporary with timeout)
303:         elif nft get element "${table_family}" nftban "blacklist_${set_suffix}" { "$value" } >/dev/null 2>&1; then
304:             status="blocked"
305:             matched_table="${table_family} nftban"
306:             matched_chain="input"
307:             matched_set="blacklist_${set_suffix}"
308:             verdict="drop"
309:             priority=0
310:             processing_path+=("  ❌ MATCHED: blacklist_${set_suffix} → DROP")
311:         else
312:             processing_path+=("  ⊘ No match in sets")
313:             processing_path+=("  → Default policy: DROP")
314:             status="blocked"
315:             matched_table="${table_family} nftban"
316:             matched_chain="input"
317:             verdict="drop"
318:             matched_rule="default policy"
319:         fi
320: 
321:     elif [[ "$value_type" == "port" ]]; then
322:         # For ports, check allowed port sets in ip nftban table
323:         processing_path+=("→ Checking ip nftban input (priority 0)")
324: 
325:         # Check TCP ports
326:         if nft get element ${NFTBAN_TABLE_IPV4} tcp_ports { "$value" } >/dev/null 2>&1; then
327:             status="allowed"
328:             matched_table="${NFTBAN_TABLE_IPV4}"
329:             matched_chain="input"
330:             matched_set="tcp_ports"
331:             verdict="accept"
332:             priority=0
333:             processing_path+=("  ✅ MATCHED: tcp_ports → ACCEPT")
334:         # Check UDP ports
335:         elif nft get element ${NFTBAN_TABLE_IPV4} udp_ports { "$value" } >/dev/null 2>&1; then
336:             status="allowed"
337:             matched_table="${NFTBAN_TABLE_IPV4}"
338:             matched_chain="input"
339:             matched_set="udp_ports"
340:             verdict="accept"
341:             priority=0
342:             processing_path+=("  ✅ MATCHED: udp_ports → ACCEPT")
343:         else
344:             processing_path+=("  ⊘ Not in tcp_ports or udp_ports")
345:             processing_path+=("  → Default policy: DROP")
346:             status="blocked"
347:             matched_table="ip/ip6 nftban"
348:             matched_chain="input"
349:             verdict="drop"
350:             matched_rule="default policy"
351:         fi
352:     fi
353: 
354:     # Determine available actions
355:     local actions=()
356:     if [[ "$value_type" == "ip" ]]; then
357:         if [[ "$status" == "allowed" ]]; then
358:             if [[ "$matched_set" == "whitelist_v4" ]]; then
359:                 actions+=("remove_from_whitelist" "add_to_blacklist")
360:             elif [[ "$matched_set" == "temp_whitelist_v4" ]]; then
361:                 actions+=("remove_from_temp_whitelist" "add_to_blacklist")
362:             fi
363:         elif [[ "$status" == "blocked" ]]; then
364:             if [[ "$matched_set" == "blacklist_v4" ]]; then
365:                 actions+=("remove_from_blacklist" "add_to_whitelist")
366:             elif [[ "$matched_set" == "temp_ban_v4" ]]; then
367:                 actions+=("remove_from_temp_ban" "add_to_whitelist")
368:             else
369:                 actions+=("add_to_whitelist")
370:             fi
371:         else
372:             actions+=("add_to_whitelist" "add_to_blacklist")
373:         fi
374:     elif [[ "$value_type" == "port" ]]; then
375:         if [[ "$status" == "allowed" ]]; then
376:             actions+=("remove_from_tcp_ports" "remove_from_udp_ports")
377:         else
378:             actions+=("add_to_tcp_ports" "add_to_udp_ports")
379:         fi
380:     fi
381: 
382:     # Output results
383:     if [[ "$output_json" == "true" ]]; then
384:         local matched_rule_json
385:         if [[ -n "$matched_set" ]]; then
386:             matched_rule_json=$(jq -n \
387:                 --arg table "$matched_table" \
388:                 --arg chain "$matched_chain" \
389:                 --arg set "$matched_set" \
390:                 --arg verdict "$verdict" \
391:                 --argjson priority "$priority" \
392:                 '{table: $table, chain: $chain, set: $set, verdict: $verdict, priority: $priority}')
393:         else
394:             matched_rule_json=$(jq -n \
395:                 --arg table "$matched_table" \
396:                 --arg chain "$matched_chain" \
397:                 --arg rule "$matched_rule" \
398:                 --arg verdict "$verdict" \
399:                 '{table: $table, chain: $chain, rule: $rule, verdict: $verdict}')
400:         fi
401: 
402:         jq -n \
403:             --arg value "$value" \
404:             --arg type "$value_type" \
405:             --arg status "$status" \
406:             --argjson matched_rule "$matched_rule_json" \
407:             --argjson path "$(printf '%s\n' "${processing_path[@]}" | jq -R . | jq -s .)" \
408:             --argjson actions "$(printf '%s\n' "${actions[@]}" | jq -R . | jq -s .)" \
409:             '{value: $value, type: $type, status: $status, matched_rule: $matched_rule, path: $path, actions: $actions}'
410:     else
411:         # Human-readable output
412:         echo "IP/Port Check: $value"
413:         echo "============================"
414:         echo ""
415:         echo "Type:   $value_type"
416: 
417:         if [[ "$status" == "allowed" ]]; then
418:             echo "Status: ✅ ALLOWED"
419:         elif [[ "$status" == "blocked" ]]; then
420:             echo "Status: ❌ BLOCKED"
421:         else
422:             echo "Status: ❓ UNKNOWN"
423:         fi
424: 
425:         echo ""
426:         echo "Matched Rule:"
427:         echo "  Table:    $matched_table"
428:         echo "  Chain:    $matched_chain"
429:         if [[ -n "$matched_set" ]]; then
430:             echo "  Set:      $matched_set"
431:         fi
432:         if [[ -n "$matched_rule" ]]; then
433:             echo "  Rule:     $matched_rule"
434:         fi
435:         echo "  Verdict:  $verdict"
436:         if [[ $priority -ne 0 ]]; then
437:             echo "  Priority: $priority"
438:         fi
439: 
440:         echo ""
441:         echo "Processing Path:"
442:         printf '  %s\n' "${processing_path[@]}"
443: 
444:         if [[ ${#actions[@]} -gt 0 ]]; then
445:             echo ""
446:             echo "Available Actions:"
447:             printf '  - %s\n' "${actions[@]}"
448:         fi
449:     fi
450: }
451: 
452: # =============================================================================
453: # FIREWALL STATISTICS
454: # =============================================================================
455: 
456: get_firewall_stats() {
457:     # Get firewall statistics (table/chain/set/rule counts, IP counts per set)
458:     # Args: $1 = output_json (true/false)
459:     # Returns: Statistics summary
460: 
461:     local output_json="${1:-false}"
462: 
463:     local ruleset
464:     ruleset=$(get_live_ruleset) || return 1
465: 
466:     # Count tables
467:     local table_count
468:     table_count=$(echo "$ruleset" | jq '[.nftables[] | select(.table?)] | length')
469: 
470:     # Count chains
471:     local chain_count
472:     chain_count=$(echo "$ruleset" | jq '[.nftables[] | select(.chain?)] | length')
473: 
474:     # Count sets
475:     local set_count
476:     set_count=$(echo "$ruleset" | jq '[.nftables[] | select(.set?)] | length')
477: 
478:     # Count rules
479:     local rule_count
480:     rule_count=$(echo "$ruleset" | jq '[.nftables[] | select(.rule?)] | length')
481: 
482:     # Count IPs per set (v0.7.3 architecture: ip/ip6 nftban tables)
483:     local whitelist_ipv4_count=0
484:     local whitelist_ipv6_count=0
485:     local blacklist_ipv4_count=0
486:     local blacklist_ipv6_count=0
487:     local tcp_ports_count=0
488:     local udp_ports_count=0
489: 
490:     whitelist_ipv4_count=$(nft -j list set ${NFTBAN_TABLE_IPV4} whitelist_ipv4 2>/dev/null | jq '[.nftables[] | select(.set?) | .set.elem[]? // empty] | length' || echo 0)
491:     whitelist_ipv6_count=$(nft -j list set ${NFTBAN_TABLE_IPV6} whitelist_ipv6 2>/dev/null | jq '[.nftables[] | select(.set?) | .set.elem[]? // empty] | length' || echo 0)
492:     blacklist_ipv4_count=$(nft -j list set ${NFTBAN_TABLE_IPV4} blacklist_ipv4 2>/dev/null | jq '[.nftables[] | select(.set?) | .set.elem[]? // empty] | length' || echo 0)
493:     blacklist_ipv6_count=$(nft -j list set ${NFTBAN_TABLE_IPV6} blacklist_ipv6 2>/dev/null | jq '[.nftables[] | select(.set?) | .set.elem[]? // empty] | length' || echo 0)
494:     tcp_ports_count=$(nft -j list set ${NFTBAN_TABLE_IPV4} tcp_ports 2>/dev/null | jq '[.nftables[] | select(.set?) | .set.elem[]? // empty] | length' || echo 0)
495:     udp_ports_count=$(nft -j list set ${NFTBAN_TABLE_IPV4} udp_ports 2>/dev/null | jq '[.nftables[] | select(.set?) | .set.elem[]? // empty] | length' || echo 0)
496: 
497:     # Output results
498:     if [[ "$output_json" == "true" ]]; then
499:         jq -n \
500:             --argjson tables "$table_count" \
501:             --argjson chains "$chain_count" \
502:             --argjson sets "$set_count" \
503:             --argjson rules "$rule_count" \
504:             --argjson whitelist_ipv4 "$whitelist_ipv4_count" \
505:             --argjson whitelist_ipv6 "$whitelist_ipv6_count" \
506:             --argjson blacklist_ipv4 "$blacklist_ipv4_count" \
507:             --argjson blacklist_ipv6 "$blacklist_ipv6_count" \
508:             --argjson tcp_ports "$tcp_ports_count" \
509:             --argjson udp_ports "$udp_ports_count" \
510:             '{
511:                 summary: {
512:                     tables: $tables,
513:                     chains: $chains,
514:                     sets: $sets,
515:                     rules: $rules
516:                 },
517:                 sets: {
518:                     "ip nftban whitelist_ipv4": $whitelist_ipv4,
519:                     "ip6 nftban whitelist_ipv6": $whitelist_ipv6,
520:                     "ip nftban blacklist_ipv4": $blacklist_ipv4,
521:                     "ip6 nftban blacklist_ipv6": $blacklist_ipv6,
522:                     "ip nftban tcp_ports": $tcp_ports,
523:                     "ip nftban udp_ports": $udp_ports
524:                 }
525:             }'
526:     else
527:         # Human-readable output
528:         echo "NFTBan Firewall Statistics"
529:         echo "============================"
530:         echo ""
531:         echo "Summary:"
532:         echo "  Tables:  $table_count"
533:         echo "  Chains:  $chain_count"
534:         echo "  Sets:    $set_count"
535:         echo "  Rules:   $rule_count"
536:         echo ""
537:         echo "ip nftban (IPv4):"
538:         echo "  ├─ whitelist_ipv4:   $whitelist_ipv4_count IPs"
539:         echo "  ├─ blacklist_ipv4:   $blacklist_ipv4_count IPs (permanent + temporary)"
540:         echo "  ├─ tcp_ports:        $tcp_ports_count ports"
541:         echo "  └─ udp_ports:        $udp_ports_count ports"
542:         echo ""
543:         echo "ip6 nftban (IPv6):"
544:         echo "  ├─ whitelist_ipv6:   $whitelist_ipv6_count IPs"
545:         echo "  └─ blacklist_ipv6:   $blacklist_ipv6_count IPs (permanent + temporary)"
546:     fi
547: }

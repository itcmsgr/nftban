482:     if [[ ! $(type -t nftban_banner) == "function" ]]; then
483:         if [[ -f "${NFTBAN_LIB_DIR:-/usr/lib/nftban}/core/nftban_output.sh" ]]; then
484:             source "${NFTBAN_LIB_DIR:-/usr/lib/nftban}/core/nftban_output.sh" 2>/dev/null || true
485:         fi

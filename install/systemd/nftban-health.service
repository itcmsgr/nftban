[Unit]
Description=NFTBan Periodic Health Check with Auto-Heal
Documentation=man:nftban(8)
After=network.target nftables.service

[Service]
Type=oneshot

# Run as root to allow auto-heal fixes
User=root

# Check and auto-fix issues
# --auto-heal: Automatically fix detected issues
# --cache-status: Write health result for banner display
ExecStart=/usr/bin/nftban health check --auto-heal --cache-status

# Exit codes: 0=OK, 1=warnings, 2=errors, 4=permission issues fixed
# All are valid check results (service ran successfully)
SuccessExitStatus=0 1 2 4

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nftban-health

# Security hardening
PrivateTmp=yes

[Install]
WantedBy=multi-user.target

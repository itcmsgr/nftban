526:         ipv6_age=$(( ($(date +%s) - $(stat -c %Y "$CF_IPV6_CACHE")) / 3600 ))
527: 
528:         echo "📊 IPv6 Cache:"
529:         echo "   Ranges: $ipv6_count"
530:         echo "   Age: ${ipv6_age} hours"
531:         echo "   File: $CF_IPV6_CACHE"
532:     else
533:         echo "❌ IPv6 Cache: Not downloaded"
534:     fi

210:         width: 100%;
211:         justify-content: center;
212:     }
213: 
214:     /* Adjust header layout */
215:     .header-actions {
216:         flex-direction: column;
217:         gap: 0.5rem;
218:     }
219: }
220: 
221: /* Small mobile devices */
222: @media (max-width: 480px) {
223:     body {
224:         padding: 0.5rem;
225:     }
226: 
227:     .chart-container {
228:         height: 180px;
229:     }
230: 
231:     /* Further reduce text sizes */
232:     h1 {
233:         font-size: 1.125rem;
234:     }
235: 
236:     h3 {
237:         font-size: 1rem;
238:     }
239: 
240:     .stat-card .text-3xl {
241:         font-size: 1.5rem;
242:     }
243: 
244:     /* Hide additional table columns */
245:     table th:nth-child(3),
246:     table td:nth-child(3) {
247:         display: none;
248:     }
249: }
250: 
251: /* ===== Print Styles ===== */
252: @media print {
253:     body {
254:         background-color: white;
255:         color: black;
256:     }
257: 
258:     .card {
259:         border: 1px solid #ccc;
260:         page-break-inside: avoid;
261:     }
262: 
263:     .btn, .badge-live {
264:         display: none;
265:     }
266: 
267:     .chart-container {
268:         height: 300px;
269:     }
270: }
271: 
272: /* ===== Dark Mode Enhancements ===== */
273: html.dark {
274:     color-scheme: dark;
275: }
276: 
277: html.light {
278:     color-scheme: light;
279: }
280: 
281: /* ===== Accessibility ===== */
282: .sr-only {
283:     position: absolute;
284:     width: 1px;
285:     height: 1px;
286:     padding: 0;
287:     margin: -1px;
288:     overflow: hidden;
289:     clip: rect(0, 0, 0, 0);
290:     white-space: nowrap;
291:     border-width: 0;
292: }
293: 
294: /* Focus styles for keyboard navigation */
295: button:focus,
296: a:focus {
297:     outline: 2px solid var(--color-primary);
298:     outline-offset: 2px;
299: }
300: 
301: /* ===== Utility Classes ===== */
302: .text-primary {
303:     color: var(--color-primary);
304: }
305: 
306: .text-secondary {
307:     color: var(--color-secondary);
308: }
309: 
310: .text-success {
311:     color: var(--color-success);
312: }
313: 
314: .text-warning {
315:     color: var(--color-warning);
316: }
317: 
318: .text-danger {
319:     color: var(--color-danger);
320: }
321: 
322: .bg-primary {
323:     background-color: var(--color-primary);
324: }
325: 
326: .bg-secondary {
327:     background-color: var(--color-secondary);
328: }
329: 
330: /* ===== Animations ===== */
331: @keyframes fadeIn {
332:     from {
333:         opacity: 0;
334:         transform: translateY(10px);
335:     }
336:     to {
337:         opacity: 1;
338:         transform: translateY(0);
339:     }
340: }
341: 
342: .fade-in {
343:     animation: fadeIn 0.3s ease-out;
344: }
345: 
346: @keyframes slideIn {
347:     from {
348:         transform: translateX(-100%);
349:     }
350:     to {
351:         transform: translateX(0);
352:     }
353: }
354: 
355: .slide-in {
356:     animation: slideIn 0.3s ease-out;
357: }
358: 
359: /* ===== Error and Alert Styles ===== */
360: .alert {
361:     padding: 1rem;
362:     border-radius: 0.375rem;
363:     margin-bottom: 1rem;
364: }
365: 
366: .alert-error {
367:     background-color: rgba(239, 68, 68, 0.1);
368:     border: 1px solid var(--color-danger);
369:     color: var(--color-danger);
370: }
371: 
372: .alert-success {
373:     background-color: rgba(34, 197, 94, 0.1);
374:     border: 1px solid var(--color-success);
375:     color: var(--color-success);
376: }
377: 
378: .alert-info {
379:     background-color: rgba(6, 182, 212, 0.1);
380:     border: 1px solid var(--color-info);
381:     color: var(--color-info);
382: }
383: 
384: /* ===== Scrollbar Styles (Dark Mode) ===== */
385: html.dark ::-webkit-scrollbar {
386:     width: 8px;
387:     height: 8px;
388: }
389: 
390: html.dark ::-webkit-scrollbar-track {
391:     background: var(--color-bg-secondary);
392: }
393: 
394: html.dark ::-webkit-scrollbar-thumb {
395:     background: var(--color-border);
396:     border-radius: 4px;
397: }
398: 
399: html.dark ::-webkit-scrollbar-thumb:hover {
400:     background: #555;
401: }
402: 
403: /* ===== Grid Layouts ===== */
404: .grid-responsive {
405:     display: grid;
406:     gap: 1.5rem;
407:     grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
408: }
409: 
410: /* ===== Performance Optimizations ===== */
411: .chart-container canvas {
412:     image-rendering: -webkit-optimize-contrast;
413:     image-rendering: crisp-edges;
414: }
415: 
416: /* Reduce motion for users who prefer it */
417: @media (prefers-reduced-motion: reduce) {
418:     * {
419:         animation-duration: 0.01ms !important;
420:         animation-iteration-count: 1 !important;
421:         transition-duration: 0.01ms !important;
422:     }
423: }

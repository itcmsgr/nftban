1295: install_safety_whitelist() {
1296:     log "Auto-Detecting System IPs (Lockout Prevention)..."
1297: 
1298:     # Source system IP detection module
1299:     if [[ -f "$LIB_DIR/core/nftban_system_ip.sh" ]]; then
1300:         source "$LIB_DIR/core/nftban_system_ip.sh"
1301:     else
1302:         warn "System IP module not found, skipping auto-whitelist"
1303:         return 0
1304:     fi
1305: 
1306:     # Ensure whitelist directory exists
1307:     mkdir -p /etc/nftban/whitelist.d
1308: 
1309:     local protected=0
1310: 
1311:     # 1. Auto-detect SSH client IP (CRITICAL - prevents lockout)
1312:     local ssh_ip="${SSH_CLIENT%% *}"
1313:     if [[ -n "$ssh_ip" ]]; then
1314:         if ! nftban_is_ip_whitelisted "$ssh_ip" 2>/dev/null; then
1315:             nftban_add_system_ip "$ssh_ip" "SSH installer (auto-detected on $(date +'%Y-%m-%d'))" >/dev/null 2>&1 || true
1316:             ok "Auto-whitelisted SSH client: $ssh_ip"
1317:             protected=$((protected + 1))
1318:         fi
1319:     fi
1320: 
1321:     # 2. Auto-detect server interface IPs
1322:     local interface_ips
1323:     interface_ips=$(nftban_get_interface_ips 2>/dev/null || true)
1324:     if [[ -n "$interface_ips" ]]; then
1325:         while IFS= read -r ip; do
1326:             [[ -z "$ip" ]] && continue
1327:             if ! nftban_is_ip_whitelisted "$ip" 2>/dev/null; then
1328:                 nftban_add_system_ip "$ip" "Server interface (auto-detected)" >/dev/null 2>&1 || true
1329:                 protected=$((protected + 1))
1330:             fi
1331:         done <<< "$interface_ips"
1332:         ok "Auto-whitelisted $protected interface IP(s)"
1333:     fi
1334: 
1335:     # 3. Auto-detect public IPs (optional, can fail if no internet)
1336:     local public_ipv4
1337:     public_ipv4=$(nftban_get_public_ip "ipv4" 2>/dev/null || true)
1338:     if [[ -n "$public_ipv4" ]]; then
1339:         if ! nftban_is_ip_whitelisted "$public_ipv4" 2>/dev/null; then
1340:             nftban_add_system_ip "$public_ipv4" "Server public IPv4 (auto-detected)" >/dev/null 2>&1 || true
1341:             ok "Auto-whitelisted public IPv4: $public_ipv4"
1342:             protected=$((protected + 1))
1343:         fi
1344:     fi
1345: 
1346:     # Summary
1347:     if [[ $protected -gt 0 ]]; then
1348:         ok "Safety whitelist created ($protected IP(s) protected)"
1349:         echo ""
1350:         log "Whitelist file: /etc/nftban/whitelist.d/00-system.conf"
1351:     else
1352:         ok "System IPs already whitelisted"
1353:     fi
1354: 
1355:     return 0
1356: }

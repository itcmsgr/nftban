#!/usr/bin/env bash
# =============================================================================
# NFTBan v0.32.21 - Go Binary Wrapper (nftban-geoip)
# =============================================================================
# SPDX-License-Identifier: MPL-2.0
# Purpose: Smart wrapper that auto-execs architecture-specific Go binary
#
# meta:name=nftban-geoip
# meta:type=tool
# meta:header=NFTBan GeoIP Lookup (Go Binary Wrapper)
# meta:version=0.32.21
# meta:owner="Antonios Voulvoulis <contact@nftban.com>"
# meta:homepage=https://nftban.com
#
# **Architecture:**
# - Supports both kernel arch names (x86_64, aarch64) AND Debian names (amd64, arm64)
# - Real Go binaries live in /usr/lib/nftban/bin/.real/nftban-geoip-{ARCH}
# - This wrapper provides cross-distro compatibility
#
# meta:created_date=2025-10-28
# meta:modified_date=2025-11-08
# =============================================================================

set -euo pipefail

REAL_DIR="/usr/lib/nftban/bin/.real"

# Get architecture from kernel
kernel_arch="$(uname -m 2>/dev/null || echo unknown)"

# Get Debian architecture if dpkg available
if command -v dpkg >/dev/null 2>&1; then
    debian_arch="$(dpkg --print-architecture 2>/dev/null || echo)"
else
    debian_arch=""
fi

# Architecture normalization for common cases
normalize_arch() {
    case "$1" in
        x86_64)  echo "x86_64" ;;
        amd64)   echo "amd64" ;;
        aarch64) echo "aarch64" ;;
        arm64)   echo "arm64" ;;
        ppc64le) echo "ppc64le" ;;
        s390x)   echo "s390x" ;;
        *)       echo "$1" ;;
    esac
}

k_norm="$(normalize_arch "$kernel_arch")"
d_norm="$(normalize_arch "$debian_arch")"

# Try kernel-named binary (RPM-style), then Debian arch name (DEB-style)
candidates=(
    "$REAL_DIR/nftban-geoip-$k_norm"
)

# Add Debian candidate if different from kernel
if [[ -n "$d_norm" && "$d_norm" != "$k_norm" ]]; then
    candidates+=("$REAL_DIR/nftban-geoip-$d_norm")
fi

# Try each candidate in order
for REAL in "${candidates[@]}"; do
    if [[ -x "$REAL" ]]; then
        exec "$REAL" "$@"
    fi
done

# No binary found - show helpful error
echo "ERROR: nftban-geoip binary not found for this architecture" >&2
echo "  Kernel arch:  $kernel_arch (normalized: $k_norm)" >&2
if [[ -n "$debian_arch" ]]; then
    echo "  Debian arch:  $debian_arch (normalized: $d_norm)" >&2
fi
echo "" >&2
echo "Checked locations:" >&2
for candidate in "${candidates[@]}"; do
    echo "  - $candidate" >&2
done
echo "" >&2
echo "Please install NFTBan from official RPM/DEB packages for your architecture." >&2
echo "See: https://github.com/itcmsgr/nftban/releases" >&2
exit 1

  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.21 Development - Project Health Check Script
  4: # =============================================================================
  5: # SPDX-License-Identifier: GPL-3.0-or-later
  6: # Description: Validates code quality, documentation, structure, and security
  7: # Generates: STATUS.md with project health metrics
  8: # Usage: .ci/health_check.sh
  9: # Exit codes: 0 = all checks pass, 1 = one or more checks failed
 10: # =============================================================================
 11: 
 12: set -euo pipefail
 13: IFS=$'\n\t'
 14: 
 15: # =============================================================================
 16: # CONSTANTS
 17: # =============================================================================
 18: SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
 19: readonly SCRIPT_DIR
 20: PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
 21: readonly PROJECT_ROOT
 22: readonly STATUS_FILE="$PROJECT_ROOT/STATUS.md"
 23: TIMESTAMP="$(date -u '+%Y-%m-%d %H:%M:%S UTC')"
 24: readonly TIMESTAMP
 25: 
 26: # Color codes for terminal output
 27: readonly RED='\033[0;31m'
 28: readonly GREEN='\033[0;32m'
 29: readonly YELLOW='\033[1;33m'
 30: readonly BLUE='\033[0;34m'
 31: readonly NC='\033[0m' # No Color
 32: 
 33: # =============================================================================
 34: # GLOBAL VARIABLES
 35: # =============================================================================
 36: TOTAL_CHECKS=0
 37: PASSED_CHECKS=0
 38: FAILED_CHECKS=0
 39: WARNINGS=0
 40: 
 41: declare -a FAILED_ITEMS=()
 42: declare -a WARNING_ITEMS=()
 43: 
 44: # =============================================================================
 45: # HELPER FUNCTIONS
 46: # =============================================================================
 47: 
 48: log_info() {
 49:     echo -e "${BLUE}[INFO]${NC} $*" >&2
 50: }
 51: 
 52: log_success() {
 53:     echo -e "${GREEN}[✓]${NC} $*" >&2
 54: }
 55: 
 56: log_error() {
 57:     echo -e "${RED}[✗]${NC} $*" >&2
 58: }
 59: 
 60: log_warning() {
 61:     echo -e "${YELLOW}[!]${NC} $*" >&2
 62: }
 63: 
 64: # Check if command exists
 65: command_exists() {
 66:     command -v "$1" >/dev/null 2>&1
 67: }
 68: 
 69: # Run a check and track results
 70: run_check() {
 71:     local check_name="$1"
 72:     local check_command="$2"
 73:     local is_warning="${3:-false}"
 74: 
 75:     TOTAL_CHECKS=$((TOTAL_CHECKS + 1))
 76: 
 77:     if eval "$check_command" >/dev/null 2>&1; then
 78:         log_success "$check_name"
 79:         PASSED_CHECKS=$((PASSED_CHECKS + 1))
 80:         return 0
 81:     else
 82:         if [ "$is_warning" = "true" ]; then
 83:             log_warning "$check_name (non-critical)"
 84:             WARNINGS=$((WARNINGS + 1))
 85:             WARNING_ITEMS+=("$check_name")
 86:             PASSED_CHECKS=$((PASSED_CHECKS + 1))  # Don't fail build on warnings
 87:             return 0
 88:         else
 89:             log_error "$check_name"
 90:             FAILED_CHECKS=$((FAILED_CHECKS + 1))
 91:             FAILED_ITEMS+=("$check_name")
 92:             return 1
 93:         fi
 94:     fi
 95: }
 96: 
 97: # =============================================================================
 98: # CHECK FUNCTIONS
 99: # =============================================================================
100: 
101: check_required_tools() {
102:     log_info "Checking required tools..."
103: 
104:     run_check "shellcheck installed" "command_exists shellcheck" "true"
105:     run_check "shfmt installed" "command_exists shfmt" "true"
106:     run_check "yamllint installed" "command_exists yamllint" "true"
107:     run_check "markdownlint installed" "command_exists markdownlint-cli2" "true"
108:     run_check "jq installed" "command_exists jq"
109:     run_check "go installed" "command_exists go"
110: }
111: 
112: check_project_structure() {
113:     log_info "Checking project structure..."
114: 
115:     run_check "cli/ directory exists" "[ -d '$PROJECT_ROOT/cli' ]"
116:     run_check "cmd/ directory exists" "[ -d '$PROJECT_ROOT/cmd' ]"
117:     run_check "pkg/ directory exists" "[ -d '$PROJECT_ROOT/pkg' ]"
118:     run_check "install/ directory exists" "[ -d '$PROJECT_ROOT/install' ]"
119:     run_check "packaging/ directory exists" "[ -d '$PROJECT_ROOT/packaging' ]"
120:     run_check "README.md exists" "[ -f '$PROJECT_ROOT/README.md' ]"
121:     run_check "LICENSE exists" "[ -f '$PROJECT_ROOT/LICENSE' ]"
122:     run_check "go.mod exists" "[ -f '$PROJECT_ROOT/go.mod' ]"
123:     run_check "nftban CLI script exists" "[ -f '$PROJECT_ROOT/cli/sbin/nftban' ]"
124:     run_check "build.sh exists" "[ -f '$PROJECT_ROOT/build.sh' ]"
125:     run_check "install.sh exists" "[ -f '$PROJECT_ROOT/install.sh' ]"
126: }
127: 
128: check_shellcheck() {
129:     log_info "Running shellcheck on shell scripts..."
130: 
131:     if ! command_exists shellcheck; then
132:         log_warning "shellcheck not installed, skipping"
133:         WARNINGS=$((WARNINGS + 1))
134:         WARNING_ITEMS+=("shellcheck not installed")
135:         TOTAL_CHECKS=$((TOTAL_CHECKS + 1))
136:         PASSED_CHECKS=$((PASSED_CHECKS + 1))
137:         return 0
138:     fi
139: 
140:     local failed=0
141:     local checked=0
142: 
143:     # Find all .sh files and main nftban script
144:     while IFS= read -r -d '' script; do
145:         checked=$((checked + 1))
146:         if shellcheck -x -S warning "$script" 2>/dev/null; then
147:             : # pass
148:         else
149:             log_error "shellcheck failed: $script"
150:             failed=$((failed + 1))
151:         fi
152:     done < <(find "$PROJECT_ROOT" -type f \( -name "*.sh" -o -name "nftban" \) \
153:         ! -path "*/.git/*" ! -path "*/build/*" ! -path "*/node_modules/*" -print0)
154: 
155:     if [ $failed -eq 0 ]; then
156:         log_success "shellcheck: checked $checked files, all passed"
157:         PASSED_CHECKS=$((PASSED_CHECKS + 1))
158:         TOTAL_CHECKS=$((TOTAL_CHECKS + 1))
159:         return 0
160:     else
161:         log_error "shellcheck: $failed/$checked files failed"
162:         FAILED_CHECKS=$((FAILED_CHECKS + 1))
163:         TOTAL_CHECKS=$((TOTAL_CHECKS + 1))
164:         FAILED_ITEMS+=("shellcheck ($failed files)")
165:         return 1
166:     fi
167: }
168: 
169: check_shfmt() {
170:     log_info "Running shfmt on shell scripts..."
171: 
172:     if ! command_exists shfmt; then
173:         log_warning "shfmt not installed, skipping"
174:         WARNINGS=$((WARNINGS + 1))
175:         WARNING_ITEMS+=("shfmt not installed")
176:         TOTAL_CHECKS=$((TOTAL_CHECKS + 1))
177:         PASSED_CHECKS=$((PASSED_CHECKS + 1))
178:         return 0
179:     fi
180: 
181:     local failed=0
182:     local checked=0
183: 
184:     # Check formatting (don't auto-fix, just verify)
185:     while IFS= read -r -d '' script; do
186:         checked=$((checked + 1))
187:         if shfmt -d -i 4 -bn -ci -sr "$script" >/dev/null 2>&1; then
188:             : # pass
189:         else
190:             log_warning "shfmt formatting issue: $script (non-critical)"
191:             failed=$((failed + 1))
192:         fi
193:     done < <(find "$PROJECT_ROOT" -type f \( -name "*.sh" -o -name "nftban" \) \
194:         ! -path "*/.git/*" ! -path "*/build/*" ! -path "*/node_modules/*" -print0)
195: 
196:     if [ $failed -eq 0 ]; then
197:         log_success "shfmt: checked $checked files, all formatted correctly"
198:     else
199:         log_warning "shfmt: $failed/$checked files have formatting issues (non-critical)"
200:         WARNING_ITEMS+=("shfmt ($failed files)")
201:         WARNINGS=$((WARNINGS + 1))
202:     fi
203: 
204:     PASSED_CHECKS=$((PASSED_CHECKS + 1))
205:     TOTAL_CHECKS=$((TOTAL_CHECKS + 1))
206:     return 0
207: }
208: 
209: check_markdown_lint() {
210:     log_info "Running markdownlint on documentation..."
211: 
212:     if ! command_exists markdownlint-cli2; then
213:         log_warning "markdownlint-cli2 not installed, skipping"
214:         WARNINGS=$((WARNINGS + 1))

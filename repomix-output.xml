 11: // FeedInfo represents metadata about a threat feed
 12: type FeedInfo struct {
 13: 	Name        string
 14: 	FilePath    string
 15: 	IPv4Count   int
 16: 	IPv6Count   int
 17: 	LastUpdated string
 18: }
 19: 
 20: // LoadAllFeeds loads all feed files from the feeds directory
 21: // Returns IPv4 IPs, IPv6 IPs, IPv4 CIDRs, IPv6 CIDRs, and feed info
 22: func LoadAllFeeds(feedsDir string) (map[string]bool, map[string]bool, map[string]bool, map[string]bool, []FeedInfo, error) {
 23: 	ipv4Set := make(map[string]bool)       // Single IPv4 addresses
 24: 	ipv6Set := make(map[string]bool)       // Single IPv6 addresses
 25: 	ipv4CIDRSet := make(map[string]bool)   // IPv4 CIDR ranges
 26: 	ipv6CIDRSet := make(map[string]bool)   // IPv6 CIDR ranges
 27: 	var feedsInfo []FeedInfo
 28: 
 29: 	// Check if feeds directory exists
 30: 	if _, err := os.Stat(feedsDir); os.IsNotExist(err) {
 31: 		// No feeds directory - return empty sets
 32: 		return ipv4Set, ipv6Set, ipv4CIDRSet, ipv6CIDRSet, feedsInfo, nil
 33: 	}
 34: 
 35: 	// Read all .txt files in feeds directory
 36: 	entries, err := os.ReadDir(feedsDir)
 37: 	if err != nil {
 38: 		return nil, nil, nil, nil, nil, fmt.Errorf("failed to read feeds directory: %w", err)
 39: 	}
 40: 
 41: 	for _, entry := range entries {
 42: 		if entry.IsDir() {
 43: 			continue
 44: 		}
 45: 		if !strings.HasSuffix(entry.Name(), ".txt") {
 46: 			continue
 47: 		}
 48: 
 49: 		filePath := filepath.Join(feedsDir, entry.Name())
 50: 
 51: 		// Load this feed
 52: 		ipv4Count, ipv6Count, ipv4CIDRCount, ipv6CIDRCount, err := loadFeedFile(filePath, ipv4Set, ipv6Set, ipv4CIDRSet, ipv6CIDRSet)
 53: 		if err != nil {
 54: 			fmt.Fprintf(os.Stderr, "Warning: Failed to load feed %s: %v\n", entry.Name(), err)
 55: 			continue
 56: 		}
 57: 
 58: 		// Get file modification time
 59: 		info, _ := entry.Info()
 60: 		lastUpdated := ""
 61: 		if info != nil {
 62: 			lastUpdated = info.ModTime().Format("2006-01-02 15:04:05")
 63: 		}
 64: 
 65: 		// Store feed info (total = single IPs + CIDRs)
 66: 		feedsInfo = append(feedsInfo, FeedInfo{
 67: 			Name:        strings.TrimSuffix(entry.Name(), ".txt"),
 68: 			FilePath:    filePath,
 69: 			IPv4Count:   ipv4Count + ipv4CIDRCount,
 70: 			IPv6Count:   ipv6Count + ipv6CIDRCount,
 71: 			LastUpdated: lastUpdated,
 72: 		})
 73: 	}
 74: 
 75: 	return ipv4Set, ipv6Set, ipv4CIDRSet, ipv6CIDRSet, feedsInfo, nil
 76: }
 77: 
 78: // loadFeedFile loads IPs and CIDRs from a single feed file
 79: // Returns counts of IPv4 IPs, IPv6 IPs, IPv4 CIDRs, IPv6 CIDRs
 80: // Uses unified ParseFeedLine for consistent parsing across the codebase
 81: func loadFeedFile(filePath string, ipv4Set, ipv6Set, ipv4CIDRSet, ipv6CIDRSet map[string]bool) (int, int, int, int, error) {
 82: 	file, err := os.Open(filePath)
 83: 	if err != nil {
 84: 		return 0, 0, 0, 0, err
 85: 	}
 86: 	defer file.Close()
 87: 
 88: 	ipv4Count := 0
 89: 	ipv6Count := 0
 90: 	ipv4CIDRCount := 0
 91: 	ipv6CIDRCount := 0
 92: 	scanner := bufio.NewScanner(file)
 93: 
 94: 	for scanner.Scan() {
 95: 		// Use unified parser (silently skip invalid entries)
 96: 		entry := ParseFeedLineSilent(scanner.Text())
 97: 		if entry == nil {
 98: 			continue
 99: 		}
100: 
101: 		// Add to appropriate set based on type
102: 		if entry.IsCIDR {
103: 			if entry.IPv4 {
104: 				if !ipv4CIDRSet[entry.Value] {
105: 					ipv4CIDRSet[entry.Value] = true
106: 					ipv4CIDRCount++
107: 				}
108: 			} else {
109: 				if !ipv6CIDRSet[entry.Value] {
110: 					ipv6CIDRSet[entry.Value] = true
111: 					ipv6CIDRCount++
112: 				}
113: 			}
114: 		} else {
115: 			if entry.IPv4 {
116: 				if !ipv4Set[entry.Value] {
117: 					ipv4Set[entry.Value] = true
118: 					ipv4Count++
119: 				}
120: 			} else {
121: 				if !ipv6Set[entry.Value] {
122: 					ipv6Set[entry.Value] = true
123: 					ipv6Count++
124: 				}
125: 			}
126: 		}
127: 	}
128: 
129: 	if err := scanner.Err(); err != nil {
130: 		return ipv4Count, ipv6Count, ipv4CIDRCount, ipv6CIDRCount, fmt.Errorf("error reading file: %w", err)
131: 	}
132: 
133: 	return ipv4Count, ipv6Count, ipv4CIDRCount, ipv6CIDRCount, nil
134: }

# meta:description="Timer for weekly Suricata rules updates"
# meta:input="None"
# meta:output="Systemd unit"
# meta:depends=""
# meta:inventory.files=""
# meta:inventory.binaries=""
# meta:inventory.env_vars=""
# meta:inventory.config_files=""
# meta:inventory.systemd_units="nftban-suricata-update.service"

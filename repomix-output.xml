 821: nftban_report_cmd_run() {
 822:     # Manually trigger scheduled report
 823:     # Usage: nftban report run <daily|weekly|monthly>
 824: 
 825:     local frequency="${1:-daily}"
 826: 
 827:     local since until
 828:     case "$frequency" in
 829:         daily)
 830:             since="$(date -d '1 day ago' +%Y-%m-%d)"
 831:             until="$(date +%Y-%m-%d)"
 832:             ;;
 833:         weekly)
 834:             since="$(date -d '7 days ago' +%Y-%m-%d)"
 835:             until="$(date +%Y-%m-%d)"
 836:             ;;
 837:         monthly)
 838:             since="$(date -d '30 days ago' +%Y-%m-%d)"
 839:             until="$(date +%Y-%m-%d)"
 840:             ;;
 841:         *)
 842:             echo "ERROR: Unknown frequency: $frequency" >&2
 843:             return 1
 844:             ;;
 845:     esac
 846: 
 847:     if type -t nftban_print_status >/dev/null 2>&1; then
 848:         nftban_print_status "info" "Generating ${frequency} report..."
 849:     else
 850:         echo "[INFO] Generating ${frequency} report..."
 851:     fi
 852: 
 853:     # Generate report
 854:     local output_dir="${NFTBAN_REPORTS_DIR}/${frequency}"
 855:     mkdir -p "$output_dir"
 856: 
 857:     local output_file
 858:     output_file="${output_dir}/report-$(date +%Y%m%d).html"
 859:     nftban_report_generate_html "$output_file" "$since" "$until" "${REPORTS_THEME:-dark}"
 860: 
 861:     # Email if configured
 862:     if [[ "${STATS_EMAIL_ENABLED}" == "true" ]] && [[ -n "${STATS_EMAIL_RECIPIENTS:-}" ]]; then
 863:         nftban_report_cmd_email "${STATS_EMAIL_RECIPIENTS}" --format html --since "$since" --until "$until"
 864:     fi
 865: 
 866:     # Send login digest if mode is digest or both (only for daily reports)
 867:     if [[ "$frequency" == "daily" ]]; then
 868:         # Load login alert config
 869:         local login_config="/etc/nftban/conf.d/login_alert.conf"
 870:         local login_config_local="/etc/nftban/conf.d/login_alert.conf.local"
 871:         [[ -f "$login_config" ]] && source "$login_config"
 872:         [[ -f "$login_config_local" ]] && source "$login_config_local"
 873: 
 874:         local alert_mode="${NFTBAN_LOGIN_ALERT_MODE:-realtime}"
 875:         if [[ "$alert_mode" == "digest" ]] || [[ "$alert_mode" == "both" ]]; then
 876:             # Load and call digest send function
 877:             local login_alert_lib="${NFTBAN_LIB_DIR:-/usr/lib/nftban}/core/nftban_login_alert.sh"
 878:             if [[ -f "$login_alert_lib" ]]; then
 879:                 source "$login_alert_lib"
 880:                 if type -t nftban_login_digest_send >/dev/null 2>&1; then
 881:                     echo "[INFO] Sending login digest..."
 882:                     nftban_login_digest_send
 883:                 fi
 884:             fi
 885:         fi
 886:     fi
 887: }

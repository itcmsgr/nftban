 773: nftban_stats_recent_activity() {
 774:     # Show recent ban events
 775:     # Usage: nftban_stats_recent_activity [limit]
 776: 
 777:     local limit="${1:-20}"
 778: 
 779:     if [[ ! -f "$NFTBAN_BAN_LOG" ]]; then
 780:         echo "[WARN] No ban log available"
 781:         return 0
 782:     fi
 783: 
 784:     echo ""
 785:     echo "Recent Activity (last ${limit})"
 786:     echo "───────────────────────────────────────────────────────────────"
 787:     echo ""
 788: 
 789:     tail -n "$limit" "$NFTBAN_BAN_LOG" | \
 790:     # shellcheck disable=SC2034  # Structured log parsing - only some fields used
 791:     while IFS='|' read -r timestamp id jail ip reason action timeout; do
 792:         printf "%s | %-16s | %-12s | %s\n" \
 793:             "$timestamp" "$ip" "$action" "$jail"
 794:     done
 795: 
 796:     echo ""
 797: }

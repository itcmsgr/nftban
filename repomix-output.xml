 13: // Config holds the application configuration
 14: type Config struct {
 15: 	Port              int
 16: 	TLSCert           string
 17: 	TLSKey            string
 18: 	JWTSecret         string
 19: 	SessionTimeout    int    // minutes
 20: 	IPWhitelistFile   string
 21: 	AuditLogFile      string
 22: 	RequiredGroup     string
 23: 	BlockRootLogin    bool
 24: 	MaxLoginAttempts  int
 25: 	LockoutDuration   int // minutes
 26: }

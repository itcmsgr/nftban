 48: # DEPENDENCIES
 49: # =============================================================================
 50: 
 51: # Load system IP module
 52: if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_system_ip.sh" ]]; then
 53:     source "${NFTBAN_LIB_DIR}/core/nftban_system_ip.sh"
 54: else
 55:     echo "ERROR: System IP module not found"
 56:     exit 1
 57: fi
 58: 
 59: # Load atomic file ops if available
 60: if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_file_ops.sh" ]]; then
 61:     source "${NFTBAN_LIB_DIR}/core/nftban_file_ops.sh"
 62: fi
 63: 
 64: # =============================================================================
 65: 
 66: # USAGE
 67: # =============================================================================
 68: 
 69: 
 70: show_usage() {
 71:     cat <<'EOF'
 72: Usage: nftban whitelist-system <command>
 73: 
 74: COMMANDS:
 75:   sync              Auto-detect and whitelist all system IPs
 76:   show              Show current system whitelist
 77:   whitelistme       Whitelist your current IP (interactive)
 78: 
 79: EXAMPLES:
 80:   # Auto-detect and protect all system IPs
 81:   sudo nftban whitelist-system sync
 82: 
 83:   # Show protected system IPs
 84:   nftban whitelist-system show
 85: 
 86:   # Protect your current IP from being banned
 87:   sudo nftban whitelist-system whitelistme
 88: 
 89: WHAT IS AUTO-DETECTED:
 90:   • Localhost (127.0.0.1, ::1)
 91:   • All server interface IPs (IPv4 + IPv6)
 92:   • Server public IPv4
 93:   • Server public IPv6
 94: 
 95: SAFE TO RUN:
 96:   This command only ADDS IPs to whitelist, never removes them.
 97:   It's safe to run multiple times (skips already whitelisted IPs).
 98: 
 99: EOF
100: }
101: 
102: # =============================================================================
103: 
104: # MAIN COMMAND HANDLER
105: # =============================================================================
106: 
107: 
108: nftban_cmd_whitelist_system() {
109:     # Main command handler for whitelist-system
110:     # Args: subcommand and options
111: 
112:     local subcommand="${1:-help}"
113:     shift || true
114: 
115:     # Check for --json flag in remaining args (suppress banner for JSON output)
116:     local json_mode=false
117:     for arg in "$@"; do
118:         [[ "$arg" == "--json" ]] && json_mode=true && break
119:     done
120: 
121:     # Show banner (skip for JSON output to avoid polluting machine-readable output)
122:     if [[ "$json_mode" == "false" ]]; then
123:         if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_output.sh" ]]; then
124:             # shellcheck source=/dev/null
125:             source "${NFTBAN_LIB_DIR}/core/nftban_output.sh"
126:             if [[ $(type -t nftban_banner) == "function" ]]; then
127:                 nftban_banner
128:             fi
129:         fi
130:         echo ""
131:     fi
132: 
133:     case "$subcommand" in
134:         sync)
135:             # Auto-detect and whitelist all system IPs
136:             nftban_whitelist_system_sync
137:             ;;
138: 
139:         show|list)
140:             # Show current system whitelist
141:             # Pass through any additional arguments (like --json)
142:             nftban_show_system_whitelist "$@"
143:             ;;
144: 
145:         whitelistme)
146:             # Whitelist current user's IP
147:             nftban_whitelistme
148:             ;;
149: 
150:         help|--help|-h|"")
151:             show_usage
152:             return 0
153:             ;;
154: 
155:         *)
156:             echo "ERROR: Unknown command: $subcommand" >&2
157:             echo "" >&2
158:             show_usage
159:             return 1
160:             ;;
161:     esac
162: }
163: 
164: # =============================================================================
165: 
166: # EXPORTS
167: # =============================================================================
168: 
169: 
170: export -f nftban_cmd_whitelist_system
171: 
172: # =============================================================================
173: 
174: # DIRECT EXECUTION SUPPORT (for backward compatibility)
175: # =============================================================================
176: 
177: 
178: # If executed directly (not sourced), run the command handler
179: if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
180:     nftban_cmd_whitelist_system "$@"
181: fi
</file>


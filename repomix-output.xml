  8: # shellcheck disable=SC2207  # Bash completion uses traditional array assignment for compatibility
  9: 
 10: _nftban() {
 11:     local cur prev words cword
 12:     _init_completion || return
 13: 
 14:     # ==========================================================================
 15:     # MAIN COMMANDS (from nftban help)
 16:     # ==========================================================================

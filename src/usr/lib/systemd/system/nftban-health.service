[Unit]
Description=NFTBan Daily Health Check with Auto-Heal
Documentation=man:nftban(8) https://nftban.com
After=network.target

[Service]
Type=oneshot
# Run as root (required for chown/chmod in auto-heal)
User=root
Group=root

# Run health check with auto-heal and quiet mode
ExecStart=/usr/sbin/nftban health check --auto-heal --quiet

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nftban-health-autoheal

# Security hardening
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/nftban /var/log/nftban /etc/nftban

[Install]
WantedBy=multi-user.target

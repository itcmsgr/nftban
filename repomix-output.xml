482: # =============================================================================
483: # SEND EMAIL (MAIN FUNCTION)
484: # =============================================================================
485: 
486: nftban_mail_send() {
487:     # Send email with content
488:     # Args: $1 = content (text or file path)
489:     #       $2 = recipient (optional, uses default if omitted)
490: 
491:     local content_arg="${1:-}"
492:     local recipient="${2:-${NFTBAN_MAIL_RECIPIENT:-}}"
493: 
494:     # Validate recipient
495:     if [[ -z "$recipient" ]]; then
496:         echo "Error: No recipient specified and no default recipient configured" >&2
497:         return 1
498:     fi
499: 
500:     if [[ "${NFTBAN_MAIL_VALIDATE_RECIPIENTS:-YES}" == "YES" ]]; then
501:         if ! nftban_mail_validate_address "$recipient"; then
502:             echo "Error: Invalid email address: $recipient" >&2
503:             return 1
504:         fi
505:     fi
506: 
507:     # Determine if content is a file or text
508:     local is_file=0
509:     local content_text=""
510:     local content_html=""
511: 
512:     if [[ -f "$content_arg" ]]; then
513:         # It's a file
514:         if nftban_mail_validate_path "$content_arg"; then
515:             is_file=1  # shellcheck disable=SC2034  # Reserved for attachment handling
516:             content_text="$(cat "$content_arg")"
517:         else
518:             echo "Error: File not allowed to be sent: $content_arg" >&2
519:             return 1
520:         fi
521:     else
522:         # It's text
523:         content_text="$content_arg"
524:     fi
525: 
526:     # Build HTML email if enabled
527:     if [[ "${NFTBAN_MAIL_USE_HTML:-YES}" == "YES" ]]; then
528:         local header footer
529:         header="$(nftban_mail_load_template "header_default")"
530:         footer="$(nftban_mail_load_template "footer_default")"
531: 
532:         # Combine and replace variables
533:         content_html="${header}${content_text}${footer}"
534:         content_html="$(nftban_mail_template_replace "$content_html")"
535:     else
536:         content_html="$content_text"
537:     fi
538: 
539:     # Prepare email
540:     local sender="${NFTBAN_SENDER:-nftban@$(hostname -f)}"
541:     local from_name="${NFTBAN_FROM_NAME:-NFTBan Security System}"
542:     local subject_prefix="${NFTBAN_MAIL_SUBJECT_PREFIX:-[NFTBan]}"
543:     local subject
544:     subject="${subject_prefix} Report from $(hostname -f)"
545: 
546:     # Detect mail command
547:     local mta
548:     mta="$(nftban_mail_detect_mta)"
549: 
550:     if [[ "$mta" == "none" ]]; then
551:         echo "Error: No mail system available" >&2
552:         return 1
553:     fi
554: 
555:     # Send email using detected MTA
556:     case "$mta" in
557:         postfix|sendmail)
558:             # Use sendmail command
559:             if [[ "${NFTBAN_MAIL_DEBUG:-false}" == "true" ]]; then
560:                 echo "[DEBUG] Sending via sendmail to: $recipient"
561:                 echo "[DEBUG] Subject: $subject"
562:             fi
563: 
564:             /usr/sbin/sendmail -t <<EOF
565: From: ${from_name} <${sender}>
566: To: ${recipient}
567: Subject: ${subject}
568: Content-Type: text/html; charset=UTF-8
569: MIME-Version: 1.0
570: 
571: ${content_html}
572: EOF
573:             ;;
574: 
575:         exim)
576:             # Use exim
577:             if [[ "${NFTBAN_MAIL_DEBUG:-false}" == "true" ]]; then
578:                 echo "[DEBUG] Sending via exim to: $recipient"
579:             fi
580: 
581:             /usr/sbin/exim -t <<EOF
582: From: ${from_name} <${sender}>
583: To: ${recipient}
584: Subject: ${subject}
585: Content-Type: text/html; charset=UTF-8
586: 
587: ${content_html}
588: EOF
589:             ;;
590: 
591:         msmtp)
592:             # Use msmtp
593:             if [[ "${NFTBAN_MAIL_DEBUG:-false}" == "true" ]]; then
594:                 echo "[DEBUG] Sending via msmtp to: $recipient"
595:             fi
596: 
597:             /usr/bin/msmtp -t <<EOF
598: From: ${from_name} <${sender}>
599: To: ${recipient}
600: Subject: ${subject}
601: Content-Type: text/html; charset=UTF-8
602: 
603: ${content_html}
604: EOF
605:             ;;
606: 
607:         mailx)
608:             # Use mailx (basic, may not support HTML well)
609:             if [[ "${NFTBAN_MAIL_DEBUG:-false}" == "true" ]]; then
610:                 echo "[DEBUG] Sending via mailx to: $recipient"
611:                 echo "[DEBUG] Warning: mailx may not support HTML emails properly"
612:             fi
613: 
614:             echo "$content_html" | mailx -s "$subject" -r "$sender" "$recipient"
615:             ;;
616: 
617:         curl)
618:             # Use curl for direct SMTP (no local MTA required)
619:             # Requires: NFTBAN_SMTP_HOST, optionally NFTBAN_SMTP_PORT, NFTBAN_SMTP_USER, NFTBAN_SMTP_PASS
620:             if [[ "${NFTBAN_MAIL_DEBUG:-false}" == "true" ]]; then
621:                 echo "[DEBUG] Sending via curl SMTP to: $recipient"
622:                 echo "[DEBUG] SMTP Host: ${NFTBAN_SMTP_HOST:-not set}"
623:             fi
624: 
625:             # Validate SMTP settings
626:             if [[ -z "${NFTBAN_SMTP_HOST:-}" ]]; then
627:                 echo "Error: NFTBAN_SMTP_HOST not configured for curl SMTP" >&2
628:                 return 1
629:             fi
630: 
631:             # Build SMTP URL
632:             local smtp_port="${NFTBAN_SMTP_PORT:-587}"
633:             local smtp_proto="smtp"
634:             local smtp_ssl_opts=""
635: 
636:             # Determine protocol and SSL options based on port
637:             case "$smtp_port" in
638:                 465)
639:                     # SMTPS (implicit TLS)
640:                     smtp_proto="smtps"
641:                     ;;
642:                 587|25)
643:                     # STARTTLS
644:                     smtp_ssl_opts="--ssl-reqd"
645:                     ;;
646:             esac
647: 
648:             local smtp_url="${smtp_proto}://${NFTBAN_SMTP_HOST}:${smtp_port}"
649: 
650:             # Build curl command arguments
651:             local curl_args=(
652:                 --url "$smtp_url"
653:                 --mail-from "$sender"
654:                 --mail-rcpt "$recipient"
655:             )
656: 
657:             # Add SSL options
658:             # shellcheck disable=SC2206  # Word splitting intentional for SSL options
659:             [[ -n "$smtp_ssl_opts" ]] && curl_args+=($smtp_ssl_opts)
660: 
661:             # Add authentication if configured
662:             if [[ -n "${NFTBAN_SMTP_USER:-}" ]]; then
663:                 curl_args+=(--user "${NFTBAN_SMTP_USER}:${NFTBAN_SMTP_PASS:-}")
664:             fi
665: 
666:             # Create temporary email file with headers
667:             local tmp_email
668:             tmp_email="$(mktemp)"
669:             cat > "$tmp_email" <<CURLEOF
670: From: ${from_name} <${sender}>
671: To: ${recipient}
672: Subject: ${subject}
673: Content-Type: text/html; charset=UTF-8
674: MIME-Version: 1.0
675: Date: $(date -R)
676: Message-ID: <$(date +%s).nftban@$(hostname -f)>
677: 
678: ${content_html}
679: CURLEOF
680: 
681:             # Send email
682:             if [[ "${NFTBAN_MAIL_DEBUG:-false}" == "true" ]]; then
683:                 echo "[DEBUG] curl ${curl_args[*]} -T $tmp_email"
684:             fi
685: 
686:             curl "${curl_args[@]}" -T "$tmp_email" 2>/dev/null
687:             local curl_result=$?
688: 
689:             # Cleanup
690:             rm -f "$tmp_email"
691: 
692:             # Return curl result
693:             (( curl_result != 0 )) && return 1
694:             ;;
695:     esac
696: 
697:     local send_result=$?
698: 
699:     if (( send_result == 0 )); then
700:         echo "✓ Email sent successfully to: $recipient"
701: 
702:         # Save sent email if debugging
703:         if [[ -n "${NFTBAN_MAIL_SAVE_SENT:-}" ]] && [[ -d "${NFTBAN_MAIL_SAVE_SENT}" ]]; then
704:             local save_file
705:             save_file="${NFTBAN_MAIL_SAVE_SENT}/sent_$(date +%Y%m%d_%H%M%S).html"
706:             echo "$content_html" > "$save_file"
707:             echo "  (Saved to: $save_file)"
708:         fi
709: 
710:         return 0
711:     else
712:         echo "✗ Failed to send email" >&2
713:         return 1
714:     fi
715: }

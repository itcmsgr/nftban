<file path="cmd/nftban-core/install.sh">
  1: #!/bin/bash
  2: # NFTBan Core v1.0.0 - Installation Script
  3: # Installs systemd services, PolicyKit rules, and sets up proper permissions
  4: 
  5: set -e
  6: 
  7: # Colors for output
  8: RED='\033[0.31m'
  9: GREEN='\033[0;32m'
 10: YELLOW='\033[1;33m'
 11: NC='\033[0m' # No Color
 12: 
 13: echo -e "${GREEN}NFTBan Core v1.0.0 - Installation${NC}"
 14: echo "========================================"
 15: echo
 16: 
 17: # Check if running as root
 18: if [ "$EUID" -ne 0 ]; then
 19:    echo -e "${RED}Error: This script must be run as root${NC}"
 20:    echo "Usage: sudo ./install.sh"
 21:    exit 1
 22: fi
 23: 
 24: # Detect script directory
 25: SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
 26: BINARY_PATH="${SCRIPT_DIR}/nftban-core"
 27: 
 28: # Check if binary exists
 29: if [ ! -f "$BINARY_PATH" ]; then
 30:     echo -e "${RED}Error: nftban-core binary not found at ${BINARY_PATH}${NC}"
 31:     echo "Please build the binary first: go build -o nftban-core"
 32:     exit 1
 33: fi
 34: 
 35: # Step 1: Install binary
 36: echo -e "${YELLOW}[1/6]${NC} Installing nftban-core binary..."
 37: install -m 0755 "$BINARY_PATH" /usr/local/bin/nftban-core
 38: echo -e "${GREEN}✓${NC} Binary installed to /usr/local/bin/nftban-core"
 39: echo
 40: 
 41: # Step 2: Create nftban group
 42: echo -e "${YELLOW}[2/6]${NC} Creating nftban group..."
 43: if ! getent group nftban > /dev/null 2>&1; then
 44:     groupadd -r nftban
 45:     echo -e "${GREEN}✓${NC} Group 'nftban' created"
 46: else
 47:     echo -e "${GREEN}✓${NC} Group 'nftban' already exists"
 48: fi
 49: echo
 50: 
 51: # Step 3: Create directories
 52: echo -e "${YELLOW}[3/6]${NC} Creating required directories..."
 53: mkdir -p /etc/nftban/{whitelist.d,blacklist.d,ports.d}
 54: mkdir -p /var/lib/nftban/feeds
 55: chown -R root:nftban /etc/nftban /var/lib/nftban
 56: chmod -R 775 /etc/nftban /var/lib/nftban
 57: echo -e "${GREEN}✓${NC} Directories created with proper permissions"
 58: echo
 59: 
 60: # Step 4: Install systemd service files
 61: echo -e "${YELLOW}[4/6]${NC} Installing systemd service files..."
 62: install -m 0644 "${SCRIPT_DIR}/systemd/nftban-core.service" /etc/systemd/system/
 63: install -m 0644 "${SCRIPT_DIR}/systemd/nftban-core-feeds.service" /etc/systemd/system/
 64: install -m 0644 "${SCRIPT_DIR}/systemd/nftban-core-feeds.timer" /etc/systemd/system/
 65: systemctl daemon-reload
 66: echo -e "${GREEN}✓${NC} Systemd services installed"
 67: echo
 68: 
 69: # Step 5: Install PolicyKit rules
 70: echo -e "${YELLOW}[5/6]${NC} Installing PolicyKit rules..."
 71: if [ -d /etc/polkit-1/rules.d ]; then
 72:     install -m 0644 "${SCRIPT_DIR}/polkit/10-nftban-core.rules" /etc/polkit-1/rules.d/
 73:     echo -e "${GREEN}✓${NC} PolicyKit rules installed"
 74: else
 75:     echo -e "${YELLOW}⚠${NC}  PolicyKit directory not found - skipping (PolicyKit may not be installed)"
 76: fi
 77: echo
 78: 
 79: # Step 6: Enable services
 80: echo -e "${YELLOW}[6/6]${NC} Enabling services..."
 81: read -p "Enable nftban-core.service on boot? (y/N) " -n 1 -r
 82: echo
 83: if [[ $REPLY =~ ^[Yy]$ ]]; then
 84:     systemctl enable nftban-core.service
 85:     echo -e "${GREEN}✓${NC} nftban-core.service enabled"
 86: fi
 87: 
 88: read -p "Enable automatic daily feed updates? (y/N) " -n 1 -r
 89: echo
 90: if [[ $REPLY =~ ^[Yy]$ ]]; then
 91:     systemctl enable nftban-core-feeds.timer
 92:     systemctl start nftban-core-feeds.timer
 93:     echo -e "${GREEN}✓${NC} nftban-core-feeds.timer enabled and started"
 94: fi
 95: echo
 96: 
 97: # Summary
 98: echo "========================================"
 99: echo -e "${GREEN}Installation Complete!${NC}"
100: echo
101: echo "Next steps:"
102: echo "  1. Add users to nftban group: usermod -aG nftban <username>"
103: echo "  2. Initialize NFTBan: sudo nftban-core init"
104: echo "  3. Start the service: sudo systemctl start nftban-core"
105: echo "  4. Check status: systemctl status nftban-core"
106: echo
107: echo "For non-root users in the nftban group, services can be managed with:"
108: echo "  systemctl start nftban-core.service"
109: echo "  systemctl stop nftban-core.service"
110: echo "  systemctl status nftban-core.service"
111: echo
112: echo "Feed updates run daily at 3:00 AM (if timer is enabled)"
113: echo "Manual update: sudo systemctl start nftban-core-feeds.service"
114: echo
</file>

<file path="cmd/nftban-core/privilege.go">
 1: package main
 2: 
 3: import (
 4: 	"fmt"
 5: 	"os"
 6: 	"syscall"
 7: 	"unsafe"
 8: )
 9: 
10: // =============================================================================
11: // NFTBan Privilege Check
12: // =============================================================================
13: // Purpose: Check for sufficient privileges to manipulate nftables
14: //
15: // Two ways to have privilege:
16: // 1. Running as root (euid == 0)
17: // 2. Having CAP_NET_ADMIN capability set on the binary
18: //
19: // The second method allows nftban-ui (running as user nftban) to call
20: // nftban-core without sudo, because:
21: //   setcap 'cap_net_admin+ep' /usr/lib/nftban/bin/nftban-core
22: // =============================================================================
23: 
24: // CAP_NET_ADMIN is capability to perform various network operations
25: const CAP_NET_ADMIN = 12
26: 
27: // hasNetAdminCapability checks if the current process has CAP_NET_ADMIN
28: func hasNetAdminCapability() bool {
29: 	// Use capget syscall to check effective capabilities
30: 	// This works on Linux only
31: 
32: 	type capHeader struct {
33: 		version uint32
34: 		pid     int32
35: 	}
36: 
37: 	type capData struct {
38: 		effective   uint32
39: 		permitted   uint32
40: 		inheritable uint32
41: 	}
42: 
43: 	// Version 3 header for Linux 2.6.25+
44: 	const LINUX_CAPABILITY_VERSION_3 = 0x20080522
45: 
46: 	hdr := capHeader{
47: 		version: LINUX_CAPABILITY_VERSION_3,
48: 		pid:     0, // 0 = current process
49: 	}
50: 
51: 	// We need 2 capData structs for 64 capabilities
52: 	data := [2]capData{}
53: 
54: 	// SYS_CAPGET = 125 on amd64
55: 	_, _, errno := syscall.Syscall(
56: 		syscall.SYS_CAPGET,
57: 		uintptr(unsafe.Pointer(&hdr)),
58: 		uintptr(unsafe.Pointer(&data[0])),
59: 		0,
60: 	)
61: 
62: 	if errno != 0 {
63: 		return false
64: 	}
65: 
66: 	// CAP_NET_ADMIN is capability 12, which is in the first 32 bits
67: 	capBit := uint32(1 << CAP_NET_ADMIN)
68: 	return (data[0].effective & capBit) != 0
69: }
70: 
71: // checkPrivilege verifies the process has sufficient privileges for nftables operations.
72: // Returns nil if privileged (root OR CAP_NET_ADMIN), error otherwise.
73: func checkPrivilege() error {
74: 	// Method 1: Running as root
75: 	if os.Geteuid() == 0 {
76: 		return nil
77: 	}
78: 
79: 	// Method 2: Has CAP_NET_ADMIN capability
80: 	if hasNetAdminCapability() {
81: 		return nil
82: 	}
83: 
84: 	return fmt.Errorf("must run as root or with CAP_NET_ADMIN capability (setcap 'cap_net_admin+ep' on binary)")
85: }
</file>

<file path="cmd/nftban-core/SYSTEMD_README.md">
  1: # NFTBan Core v1.0.0 - Systemd Integration
  2: 
  3: This document describes the systemd service integration and PolicyKit configuration for NFTBan Core v1.0.0.
  4: 
  5: ## Overview
  6: 
  7: NFTBan Core v1.0.0 introduces systemd service management with PolicyKit integration, allowing:
  8: - Automatic startup on boot
  9: - Periodic feed updates via systemd timers
 10: - Non-root user management through PolicyKit
 11: - Proper security hardening via systemd directives
 12: 
 13: ## Components
 14: 
 15: ### 1. nftban-core.service
 16: Main service that syncs NFTBan configuration to nftables on startup.
 17: 
 18: **Type**: `oneshot` with `RemainAfterExit=yes`
 19: **Runs**: `/usr/local/bin/nftban-core sync`
 20: **Security**: Hardened with ProtectSystem, PrivateTmp, resource limits
 21: 
 22: ### 2. nftban-core-feeds.service
 23: One-shot service that updates threat intelligence feeds.
 24: 
 25: **Type**: `oneshot`
 26: **Runs**: `/usr/local/bin/nftban-core feeds load`
 27: **Timeout**: 15 minutes
 28: **Resources**: Up to 512MB RAM, 80% CPU quota
 29: 
 30: ### 3. nftban-core-feeds.timer
 31: Systemd timer for automatic daily feed updates.
 32: 
 33: **Schedule**:
 34: - Daily at 3:00 AM
 35: - 15 minutes after boot
 36: - Random delay: 0-30 minutes (prevents thundering herd)
 37: - Persistent: Runs missed executions
 38: 
 39: ## Installation
 40: 
 41: ### Quick Install
 42: ```bash
 43: cd cmd/nftban-core
 44: sudo ./install.sh
 45: ```
 46: 
 47: The installer will:
 48: 1. Install nftban-core binary to `/usr/local/bin/`
 49: 2. Create `nftban` group for privileged access
 50: 3. Create required directories (`/etc/nftban`, `/var/lib/nftban/feeds`)
 51: 4. Install systemd service files
 52: 5. Install PolicyKit rules (if available)
 53: 6. Optionally enable services
 54: 
 55: ### Manual Installation
 56: 
 57: 1. **Build the binary:**
 58:    ```bash
 59:    cd cmd/nftban-core
 60:    go build -o nftban-core
 61:    ```
 62: 
 63: 2. **Install binary:**
 64:    ```bash
 65:    sudo install -m 0755 nftban-core /usr/local/bin/
 66:    ```
 67: 
 68: 3. **Create group and directories:**
 69:    ```bash
 70:    sudo groupadd -r nftban
 71:    sudo mkdir -p /etc/nftban/{whitelist.d,blacklist.d,ports.d}
 72:    sudo mkdir -p /var/lib/nftban/feeds
 73:    sudo chown -R root:nftban /etc/nftban /var/lib/nftban
 74:    sudo chmod -R 775 /etc/nftban /var/lib/nftban
 75:    ```
 76: 
 77: 4. **Install systemd files:**
 78:    ```bash
 79:    sudo cp systemd/*.service /etc/systemd/system/
 80:    sudo cp systemd/*.timer /etc/systemd/system/
 81:    sudo systemctl daemon-reload
 82:    ```
 83: 
 84: 5. **Install PolicyKit rules:**
 85:    ```bash
 86:    sudo cp polkit/10-nftban-core.rules /etc/polkit-1/rules.d/
 87:    ```
 88: 
 89: 6. **Add users to nftban group:**
 90:    ```bash
 91:    sudo usermod -aG nftban <username>
 92:    ```
 93:    *(Users need to log out and back in for group changes to take effect)*
 94: 
 95: ## Usage
 96: 
 97: ### Enable and Start Services
 98: 
 99: ```bash
100: # Enable main service on boot
101: sudo systemctl enable nftban-core.service
102: 
103: # Start main service now
104: sudo systemctl start nftban-core.service
105: 
106: # Enable automatic feed updates
107: sudo systemctl enable nftban-core-feeds.timer
108: sudo systemctl start nftban-core-feeds.timer
109: ```
110: 
111: ### Check Status
112: 
113: ```bash
114: # Check main service status
115: systemctl status nftban-core.service
116: 
117: # Check feed update timer
118: systemctl status nftban-core-feeds.timer
119: 
120: # View next scheduled feed update
121: systemctl list-timers nftban-core-feeds.timer
122: 
123: # View service logs
124: journalctl -u nftban-core.service
125: journalctl -u nftban-core-feeds.service
126: ```
127: 
128: ### Manual Operations
129: 
130: ```bash
131: # Manually trigger feed update
132: sudo systemctl start nftban-core-feeds.service
133: 
134: # Reload NFTBan configuration
135: sudo systemctl reload nftban-core.service
136: 
137: # Restart service
138: sudo systemctl restart nftban-core.service
139: ```
140: 
141: ## PolicyKit Integration
142: 
143: Users in the `nftban` group can manage nftban-core services without `sudo`:
144: 
145: ```bash
146: # Start/stop/restart services
147: systemctl start nftban-core.service
148: systemctl stop nftban-core.service
149: systemctl restart nftban-core.service
150: 
151: # Check status (always allowed)
152: systemctl status nftban-core.service
153: 
154: # Trigger feed update
155: systemctl start nftban-core-feeds.service
156: ```
157: 
158: **Note**: PolicyKit requires the user to be in the `nftban` group and may prompt for password depending on system configuration.
159: 
160: ## Security Features
161: 
162: ### Systemd Hardening
163: 
164: Both services include comprehensive security hardening:
165: 
166: - **NoNewPrivileges**: Prevents privilege escalation
167: - **PrivateTmp**: Isolated `/tmp` directory
168: - **ProtectSystem=strict**: Read-only root filesystem (except specific paths)
169: - **ProtectHome**: No access to user home directories
170: - **ReadWritePaths**: Only `/etc/nftban` and `/var/lib/nftban` writable
171: - **ProtectKernelTunables**: Prevents kernel parameter modification
172: - **ProtectKernelModules**: Prevents kernel module loading
173: - **RestrictNamespaces**: Limits namespace creation
174: - **RestrictRealtime**: No realtime scheduling
175: - **MemoryDenyWriteExecute**: W^X protection
176: - **SystemCallFilter**: Restricted to safe syscalls
177: 
178: ### Resource Limits
179: 
180: **nftban-core.service**:
181: - CPU: 50% quota
182: - Memory: 256MB max
183: - Tasks: 10 max
184: 
185: **nftban-core-feeds.service**:
186: - CPU: 80% quota
187: - Memory: 512MB max
188: - Tasks: 20 max
189: - Timeout: 15 minutes
190: 
191: ## Directory Structure
192: 
193: ```
194: /etc/nftban/
195: ├── whitelist.d/          # Whitelist files
196: ├── blacklist.d/          # Blacklist files
197: └── ports.d/              # Port configuration
198: 
199: /var/lib/nftban/
200: └── feeds/                # Threat intelligence feeds
201: 
202: /usr/local/bin/
203: └── nftban-core           # Main binary
204: 
205: /etc/systemd/system/
206: ├── nftban-core.service
207: ├── nftban-core-feeds.service
208: └── nftban-core-feeds.timer
209: 
210: /etc/polkit-1/rules.d/
211: └── 10-nftban-core.rules
212: ```
213: 
214: ## Troubleshooting
215: 
216: ### Service won't start
217: ```bash
218: # Check service status
219: systemctl status nftban-core.service
220: 
221: # View detailed logs
222: journalctl -xeu nftban-core.service
223: 
224: # Check binary permissions
225: ls -l /usr/local/bin/nftban-core
226: 
227: # Check directory permissions
228: ls -ld /etc/nftban /var/lib/nftban
229: ```
230: 
231: ### PolicyKit not working
232: ```bash
233: # Check if user is in nftban group
234: groups
235: 
236: # Verify PolicyKit rules are installed
237: ls -l /etc/polkit-1/rules.d/10-nftban-core.rules
238: 
239: # Test PolicyKit authorization
240: pkcheck --action-id org.freedesktop.systemd1.manage-units \
241:   --process $$ --list-temp
242: 
243: # Reload PolicyKit
244: sudo systemctl restart polkit
245: ```
246: 
247: ### Feed updates not running
248: ```bash
249: # Check timer status
250: systemctl status nftban-core-feeds.timer
251: 
252: # List all timers
253: systemctl list-timers --all
254: 
255: # View timer logs
256: journalctl -u nftban-core-feeds.timer
257: 
258: # Manually trigger update
259: sudo systemctl start nftban-core-feeds.service
260: ```
261: 
262: ## Upgrading
263: 
264: When upgrading to a new version:
265: 
266: 1. Build new binary
267: 2. Stop services:
268:    ```bash
269:    sudo systemctl stop nftban-core-feeds.timer
270:    sudo systemctl stop nftban-core.service
271:    ```
272: 3. Install new binary:
273:    ```bash
274:    sudo install -m 0755 nftban-core /usr/local/bin/
275:    ```
276: 4. Update systemd files if changed:
277:    ```bash
278:    sudo cp systemd/*.{service,timer} /etc/systemd/system/
279:    sudo systemctl daemon-reload
280:    ```
281: 5. Restart services:
282:    ```bash
283:    sudo systemctl start nftban-core.service
284:    sudo systemctl start nftban-core-feeds.timer
285:    ```
286: 
287: ## Uninstallation
288: 
289: ```bash
290: # Stop and disable services
291: sudo systemctl stop nftban-core-feeds.timer nftban-core.service
292: sudo systemctl disable nftban-core-feeds.timer nftban-core.service
293: 
294: # Remove systemd files
295: sudo rm /etc/systemd/system/nftban-core{,-feeds}.{service,timer}
296: sudo systemctl daemon-reload
297: 
298: # Remove PolicyKit rules
299: sudo rm /etc/polkit-1/rules.d/10-nftban-core.rules
300: 
301: # Remove binary
302: sudo rm /usr/local/bin/nftban-core
303: 
304: # Optionally remove data (WARNING: Deletes all configuration)
305: # sudo rm -rf /etc/nftban /var/lib/nftban
306: ```
307: 

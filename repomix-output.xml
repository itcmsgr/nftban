 20: func cmdPorts(action string, cfg *nftbanconf.Config) error {
 21: 	portsDir := getPortsDir(cfg)
 22: 
 23: 	switch action {
 24: 	case "list":
 25: 		return cmdPortsList(portsDir)
 26: 	case "load":
 27: 		return cmdPortsLoad(portsDir)
 28: 	case "status":
 29: 		return cmdPortsStatus(portsDir)
 30: 	default:
 31: 		return fmt.Errorf("unknown ports action: %s\nUsage: nftban-core ports [list|load|status]", action)

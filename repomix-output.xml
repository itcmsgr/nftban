<file path="cli/lib/nftban/setup/configure_grafana_datasource.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - Grafana Datasource Configuration Script
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Configure Prometheus datasource in Grafana
  7: # Location: /usr/lib/nftban/setup/configure_grafana_datasource.sh
  8: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
  9: # meta:homepage=https://nftban.com
 10: #
 11: # meta:name=configure_grafana_datasource
 12: # meta:type=setup
 13: # meta:header=Grafana Datasource Configuration
 14: # meta:version=1.0.0
 15: #
 16: # meta:created_date=2025-11-17
 17: # =============================================================================
 18: 
 19: set -Eeuo pipefail
 20: IFS=$'\n\t'
 21: 
 22: # Colors
 23: readonly RED='\033[0;31m'
 24: readonly GREEN='\033[0;32m'
 25: readonly YELLOW='\033[1;33m'
 26: readonly BLUE='\033[0;34m'
 27: readonly NC='\033[0m'
 28: 
 29: # Configuration
 30: readonly GRAFANA_URL="${GRAFANA_URL:-http://localhost:3000}"
 31: readonly GRAFANA_USER="${GRAFANA_ADMIN_USER:-admin}"
 32: readonly GRAFANA_PASS="${GRAFANA_ADMIN_PASSWORD:-admin}"
 33: readonly PROMETHEUS_URL="${PROMETHEUS_URL:-http://localhost:9090}"
 34: readonly GRAFANA_PROVISIONING_DIR="/etc/grafana/provisioning/datasources"
 35: 
 36: print_status() {
 37:     echo -e "${GREEN}[✓]${NC} $1"
 38: }
 39: 
 40: print_error() {
 41:     echo -e "${RED}[✗]${NC} $1" >&2
 42: }
 43: 
 44: print_warn() {
 45:     echo -e "${YELLOW}[!]${NC} $1"
 46: }
 47: 
 48: print_info() {
 49:     echo -e "${BLUE}[i]${NC} $1"
 50: }
 51: 
 52: check_root() {
 53:     if [[ $EUID -ne 0 ]]; then
 54:         print_error "This script must be run as root"
 55:         exit 1
 56:     fi
 57: }
 58: 
 59: check_grafana_running() {
 60:     if ! systemctl is-active --quiet grafana-server; then
 61:         print_error "Grafana is not running"
 62:         print_info "Start Grafana: systemctl start grafana-server"
 63:         exit 1
 64:     fi
 65:     print_status "Grafana is running"
 66: }
 67: 
 68: check_prometheus_running() {
 69:     if ! curl -s "$PROMETHEUS_URL/-/healthy" >/dev/null 2>&1; then
 70:         print_warn "Prometheus may not be running at $PROMETHEUS_URL"
 71:         print_info "Datasource will be created but may not work until Prometheus starts"
 72:     else
 73:         print_status "Prometheus is accessible at $PROMETHEUS_URL"
 74:     fi
 75: }
 76: 
 77: create_provisioning_config() {
 78:     print_info "Creating Prometheus datasource provisioning config..."
 79: 
 80:     mkdir -p "$GRAFANA_PROVISIONING_DIR"
 81: 
 82:     cat > "$GRAFANA_PROVISIONING_DIR/prometheus.yaml" <<EOF
 83: apiVersion: 1
 84: 
 85: datasources:
 86:   - name: Prometheus
 87:     type: prometheus
 88:     access: proxy
 89:     url: ${PROMETHEUS_URL}
 90:     isDefault: true
 91:     editable: true
 92:     jsonData:
 93:       timeInterval: 60s
 94:       queryTimeout: 60s
 95:       httpMethod: POST
 96:     version: 1
 97: EOF
 98: 
 99:     if [[ -f "$GRAFANA_PROVISIONING_DIR/prometheus.yaml" ]]; then
100:         print_status "Created datasource config: $GRAFANA_PROVISIONING_DIR/prometheus.yaml"
101:     else
102:         print_error "Failed to create datasource configuration"
103:         exit 1
104:     fi
105: }
106: 
107: restart_grafana() {
108:     print_info "Restarting Grafana to load datasource..."
109: 
110:     if systemctl restart grafana-server; then
111:         print_status "Grafana restarted"
112:         sleep 3
113:     else
114:         print_error "Failed to restart Grafana"
115:         exit 1
116:     fi
117: }
118: 
119: verify_datasource() {
120:     print_info "Verifying datasource configuration..."
121: 
122:     local retries=10
123:     local count=0
124: 
125:     while [[ $count -lt $retries ]]; do
126:         if curl -s -u "$GRAFANA_USER:$GRAFANA_PASS" "$GRAFANA_URL/api/datasources" 2>/dev/null | grep -q "Prometheus"; then
127:             print_status "Prometheus datasource configured successfully"
128:             return 0
129:         fi
130:         ((count++))
131:         sleep 1
132:     done
133: 
134:     print_warn "Could not verify datasource via API (may require manual check)"
135:     return 1
136: }
137: 
138: print_next_steps() {
139:     echo ""
140:     echo -e "${GREEN}═══════════════════════════════════════════════════════════${NC}"
141:     echo -e "${GREEN}  Prometheus Datasource Configured!${NC}"
142:     echo -e "${GREEN}═══════════════════════════════════════════════════════════${NC}"
143:     echo ""
144:     echo "Datasource Details:"
145:     echo "  Name: Prometheus"
146:     echo "  Type: Prometheus"
147:     echo "  URL: $PROMETHEUS_URL"
148:     echo "  Default: Yes"
149:     echo ""
150:     echo "Verify in Grafana:"
151:     echo "  1. Go to: $GRAFANA_URL"
152:     echo "  2. Navigate to: Configuration → Data Sources"
153:     echo "  3. Click on: Prometheus"
154:     echo "  4. Click: Save & Test"
155:     echo ""
156:     echo "Expected result: 'Data source is working'"
157:     echo ""
158:     echo "Configuration file:"
159:     echo "  $GRAFANA_PROVISIONING_DIR/prometheus.yaml"
160:     echo ""
161: }
162: 
163: main() {
164:     echo ""
165:     echo -e "${BLUE}╔═══════════════════════════════════════════════════════════╗${NC}"
166:     echo -e "${BLUE}║  NFTBan v1.0.0 - Grafana Datasource Configuration        ║${NC}"
167:     echo -e "${BLUE}╚═══════════════════════════════════════════════════════════╝${NC}"
168:     echo ""
169: 
170:     check_root
171:     check_grafana_running
172:     check_prometheus_running
173:     create_provisioning_config
174:     restart_grafana
175:     verify_datasource || true
176:     print_next_steps
177: }
178: 
179: main "$@"
</file>

<file path="cli/lib/nftban/setup/deploy_metrics.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - One-Command Metrics Deployment
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Automated end-to-end metrics deployment
  7: # Location: /usr/lib/nftban/setup/deploy_metrics.sh
  8: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
  9: # meta:homepage=https://nftban.com
 10: #
 11: # meta:name=deploy_metrics
 12: # meta:type=deployment
 13: # meta:header=Metrics Deployment Automation
 14: # meta:version=1.0.0
 15: #
 16: # meta:created_date=2025-11-17
 17: # =============================================================================
 18: 
 19: set -Eeuo pipefail
 20: IFS=$'\n\t'
 21: 
 22: # Colors

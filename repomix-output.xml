<file path="install/prometheus/alerts/nftban-metrics.yml">
  1: # =============================================================================
  2: # NFTBan Prometheus Alert Rules
  3: # =============================================================================
  4: # Location: /etc/prometheus/alerts/nftban-metrics.yml
  5: #
  6: # These alert rules monitor NFTBan metrics for issues and anomalies.
  7: #
  8: # Installation:
  9: #   1. Copy to /etc/prometheus/alerts/nftban-metrics.yml
 10: #   2. Add to prometheus.yml:
 11: #      rule_files:
 12: #        - /etc/prometheus/alerts/nftban-metrics.yml
 13: #   3. Reload Prometheus: systemctl reload prometheus
 14: #
 15: # Testing:
 16: #   promtool check rules /etc/prometheus/alerts/nftban-metrics.yml
 17: # =============================================================================
 18: 
 19: groups:
 20:   # NFTBan Metrics Exporter Health
 21:   - name: nftban_exporter
 22:     interval: 60s
 23:     rules:
 24:       # Alert if metrics exporter is down
 25:       - alert: NFTBanMetricsDown
 26:         expr: up{job="nftban"} == 0
 27:         for: 5m
 28:         labels:
 29:           severity: warning
 30:           component: metrics
 31:           service: nftban-exporter
 32:         annotations:
 33:           summary: "NFTBan metrics exporter is down"
 34:           description: "Node Exporter cannot scrape NFTBan metrics for {{ $labels.instance }}. Last successful scrape was {{ $value | humanizeDuration }} ago."
 35:           action: "Check systemctl status nftban-metrics-exporter.service and journalctl -u nftban-metrics-exporter.service"
 36: 
 37:       # Alert if metrics collection is slow
 38:       - alert: NFTBanMetricsCollectionSlow
 39:         expr: nftban_exporter_duration_seconds > 5
 40:         for: 5m
 41:         labels:
 42:           severity: warning
 43:           component: metrics
 44:           service: nftban-exporter
 45:         annotations:
 46:           summary: "NFTBan metrics collection is slow"
 47:           description: "Metrics collection taking {{ $value | humanizeDuration }} (threshold: 5s). Performance issue suspected on {{ $labels.instance }}."
 48:           action: "Check system load, disk I/O, and NFTBan service status"
 49: 
 50:       # Alert if metrics are stale
 51:       - alert: NFTBanMetricsStale
 52:         expr: (time() - nftban_last_update_timestamp) > 300
 53:         for: 5m
 54:         labels:
 55:           severity: warning
 56:           component: metrics
 57:           service: nftban-exporter
 58:         annotations:
 59:           summary: "NFTBan metrics are stale"
 60:           description: "Last metrics update was {{ $value | humanizeDuration }} ago on {{ $labels.instance }}. Exporter may be failing."
 61:           action: "Check systemctl status nftban-metrics-exporter.timer and nftban-metrics-exporter.service"
 62: 
 63:   # NFTBan Firewall Health
 64:   - name: nftban_firewall
 65:     interval: 60s
 66:     rules:
 67:       # Alert if any component is in critical state
 68:       - alert: NFTBanComponentCritical
 69:         expr: nftban_health_status >= 3
 70:         for: 2m
 71:         labels:
 72:           severity: critical
 73:           component: firewall
 74:           service: nftban
 75:         annotations:
 76:           summary: "NFTBan component in critical state"
 77:           description: "Component {{ $labels.component }} has critical health status ({{ $value }}) on {{ $labels.instance }}. Immediate attention required."
 78:           action: "Run 'nftban health' to diagnose, check journalctl -u nftban"
 79: 
 80:       # Alert if any component is in error state
 81:       - alert: NFTBanComponentError
 82:         expr: nftban_health_status == 2
 83:         for: 5m
 84:         labels:
 85:           severity: error
 86:           component: firewall
 87:           service: nftban
 88:         annotations:
 89:           summary: "NFTBan component in error state"
 90:           description: "Component {{ $labels.component }} has error status ({{ $value }}) on {{ $labels.instance }}."
 91:           action: "Run 'nftban health' to diagnose"
 92: 
 93:       # Alert if any component is in warning state
 94:       - alert: NFTBanComponentWarning
 95:         expr: nftban_health_status == 1
 96:         for: 15m
 97:         labels:
 98:           severity: warning
 99:           component: firewall
100:           service: nftban
101:         annotations:
102:           summary: "NFTBan component in warning state"
103:           description: "Component {{ $labels.component }} has warning status ({{ $value }}) on {{ $labels.instance }}."
104:           action: "Review component status with 'nftban health'"
105: 
106:   # NFTBan Block Statistics
107:   - name: nftban_blocks
108:     interval: 60s
109:     rules:
110:       # Alert if block count is very high
111:       - alert: NFTBanHighBlockCount
112:         expr: nftban_blocks_total > 10000
113:         for: 10m
114:         labels:
115:           severity: info
116:           component: firewall
117:           service: nftban
118:         annotations:
119:           summary: "High number of blocked IPs"
120:           description: "Currently blocking {{ $value }} IPs on {{ $labels.instance }}. Review block list for cleanup."
121:           action: "Consider running 'nftban firewall unblock --expired' to clean up old blocks"
122: 
123:       # Alert if blocks increasing rapidly
124:       - alert: NFTBanBlockRateSurge
125:         expr: rate(nftban_bans_total[5m]) > 10
126:         for: 10m
127:         labels:
128:           severity: warning
129:           component: firewall
130:           service: nftban
131:         annotations:
132:           summary: "Rapid increase in IP blocks"
133:           description: "Blocking rate is {{ $value | humanize }} IPs/second on {{ $labels.instance }}. Possible attack in progress."
134:           action: "Review recent bans with 'nftban firewall list-blocked --recent' and check fail2ban logs"
135: 
136:       # Alert if blocks in last 24h is unusually high
137:       - alert: NFTBanHighDailyBans
138:         expr: nftban_bans_last_24h > 1000
139:         for: 30m
140:         labels:
141:           severity: info
142:           component: firewall
143:           service: nftban
144:         annotations:
145:           summary: "High number of bans in last 24 hours"
146:           description: "{{ $value }} IPs banned in last 24h on {{ $labels.instance }}. Higher than usual activity."
147:           action: "Review ban patterns and consider adjusting fail2ban thresholds"
148: 
149:   # NFTBan System Resources
150:   - name: nftban_system
151:     interval: 60s
152:     rules:
153:       # Alert if nftables rule count is very high
154:       - alert: NFTBanHighRuleCount
155:         expr: nftban_nftables_rules_count > 10000
156:         for: 10m
157:         labels:
158:           severity: warning
159:           component: firewall
160:           service: nftables
161:         annotations:
162:           summary: "High nftables rule count"
163:           description: "nftables has {{ $value }} rules on {{ $labels.instance }}. Performance may be impacted."
164:           action: "Review and optimize nftables rules, consider cleanup"
165: 
166:       # Alert if no fail2ban jails are active
167:       - alert: NFTBanNoActiveJails
168:         expr: nftban_fail2ban_jails_active == 0
169:         for: 10m
170:         labels:
171:           severity: warning
172:           component: firewall
173:           service: fail2ban
174:         annotations:
175:           summary: "No active fail2ban jails"
176:           description: "fail2ban has no active jails on {{ $labels.instance }}. Automatic blocking may not be working."
177:           action: "Check systemctl status fail2ban and fail2ban-client status"
178: 
179:   # Geographic Anomalies
180:   - name: nftban_geographic
181:     interval: 60s
182:     rules:
183:       # Alert if blocks from single country exceed threshold
184:       - alert: NFTBanHighCountryBlocks
185:         expr: nftban_blocks_by_country > 1000
186:         for: 30m
187:         labels:
188:           severity: info
189:           component: firewall
190:           service: nftban
191:         annotations:
192:           summary: "High block count from single country"
193:           description: "{{ $value }} IPs blocked from {{ $labels.country }} on {{ $labels.instance }}."
194:           action: "Review geographic block patterns, consider country-level blocking"
195: 
196: # =============================================================================
197: # Alert Severity Levels
198: # =============================================================================
199: #
200: # critical (severity: critical)
201: #   - Immediate action required
202: #   - Service degradation or failure
203: #   - Page on-call engineer
204: #
205: # error (severity: error)
206: #   - Requires attention soon
207: #   - Potential service impact
208: #   - Send notification
209: #
210: # warning (severity: warning)
211: #   - Should be investigated
212: #   - No immediate service impact
213: #   - Create ticket
214: #
215: # info (severity: info)
216: #   - Informational only
217: #   - Review during business hours
218: #   - Optional notification
219: #
220: # =============================================================================
221: 
222: # =============================================================================
223: # Alert Actions
224: # =============================================================================
225: #
226: # Each alert includes an "action" annotation with recommended steps.
227: # Integrate with Alertmanager to send these to:
228: #   - Email
229: #   - Slack
230: #   - PagerDuty
231: #   - Custom webhook
232: #
233: # Example Alertmanager route:
234: #
235: #   route:
236: #     group_by: ['alertname', 'instance']
237: #     group_wait: 10s
238: #     group_interval: 10s
239: #     repeat_interval: 12h
240: #     receiver: 'nftban-alerts'
241: #
242: #     routes:
243: #       - match:
244: #           severity: critical
245: #         receiver: 'pagerduty'
246: #       - match:
247: #           severity: error
248: #         receiver: 'slack-alerts'
249: #       - match:
250: #           severity: warning
251: #         receiver: 'email-alerts'
252: #
253: # =============================================================================
</file>

<file path="install/prometheus/prometheus-remote-write.conf.example">
  1: # NFTBan Prometheus Remote Write Configuration
  2: # Copy to /etc/nftban/conf.d/prometheus-remote-write.conf and customize
  3: 
  4: # =============================================================================
  5: # REMOTE WRITE CONFIGURATION
  6: # =============================================================================
  7: # Enable/disable remote write to central Prometheus/Thanos/Grafana Cloud
  8: # Default: disabled (keep metrics local only)
  9: 
 10: NFTBAN_PROMETHEUS_REMOTE_WRITE_ENABLED="false"
 11: 
 12: # Remote write endpoint URL
 13: # Examples:
 14: #   - Central Prometheus: https://prometheus-central.example.com/api/v1/write
 15: #   - Thanos Receiver: https://thanos-receive.example.com/api/v1/receive
 16: #   - Grafana Cloud: https://prometheus-prod-XX.grafana.net/api/prom/push
 17: # Default: none
 18: NFTBAN_PROMETHEUS_REMOTE_WRITE_URL=""
 19: 
 20: # Authentication (Basic Auth)
 21: # Required for most remote write endpoints
 22: NFTBAN_PROMETHEUS_REMOTE_WRITE_USERNAME=""
 23: NFTBAN_PROMETHEUS_REMOTE_WRITE_PASSWORD=""
 24: 
 25: # Or use password file (more secure than inline password)
 26: # File should contain password in plain text, mode 600
 27: NFTBAN_PROMETHEUS_REMOTE_WRITE_PASSWORD_FILE="/etc/nftban/prometheus_password.secret"
 28: 
 29: # Bearer token authentication (alternative to basic auth)
 30: # Used by some cloud providers (e.g., some Grafana Cloud configs)
 31: NFTBAN_PROMETHEUS_REMOTE_WRITE_BEARER_TOKEN=""
 32: NFTBAN_PROMETHEUS_REMOTE_WRITE_BEARER_TOKEN_FILE="/etc/nftban/prometheus_token.secret"
 33: 
 34: # TLS Configuration
 35: # Skip TLS verification (for self-signed certificates)
 36: # Default: false (verify certificates)
 37: NFTBAN_PROMETHEUS_REMOTE_WRITE_INSECURE_SKIP_VERIFY="false"
 38: 
 39: # Custom CA certificate for TLS
 40: # Path to CA certificate file
 41: NFTBAN_PROMETHEUS_REMOTE_WRITE_CA_FILE=""
 42: 
 43: # Client certificate authentication (mTLS)
 44: NFTBAN_PROMETHEUS_REMOTE_WRITE_CERT_FILE=""
 45: NFTBAN_PROMETHEUS_REMOTE_WRITE_KEY_FILE=""
 46: 
 47: # =============================================================================
 48: # QUEUE CONFIGURATION
 49: # =============================================================================
 50: # Controls how metrics are batched and sent to remote
 51: 
 52: # Maximum number of samples in queue
 53: # Default: 10000
 54: NFTBAN_PROMETHEUS_REMOTE_WRITE_QUEUE_CAPACITY="10000"
 55: 
 56: # Maximum samples per send batch
 57: # Default: 500
 58: NFTBAN_PROMETHEUS_REMOTE_WRITE_MAX_SAMPLES_PER_SEND="500"
 59: 
 60: # Batch send deadline
 61: # How long to wait before sending batch (even if not full)
 62: # Default: 5s
 63: NFTBAN_PROMETHEUS_REMOTE_WRITE_BATCH_SEND_DEADLINE="5s"
 64: 
 65: # Minimum/Maximum backoff on send errors
 66: # Default: 30ms / 100ms
 67: NFTBAN_PROMETHEUS_REMOTE_WRITE_MIN_BACKOFF="30ms"
 68: NFTBAN_PROMETHEUS_REMOTE_WRITE_MAX_BACKOFF="100ms"
 69: 
 70: # Maximum number of parallel shards for sending
 71: # Default: 5
 72: NFTBAN_PROMETHEUS_REMOTE_WRITE_MAX_SHARDS="5"
 73: 
 74: # Minimum number of shards
 75: # Default: 1
 76: NFTBAN_PROMETHEUS_REMOTE_WRITE_MIN_SHARDS="1"
 77: 
 78: # =============================================================================
 79: # LABEL CONFIGURATION
 80: # =============================================================================
 81: # Add custom labels to all remote-written metrics
 82: # Useful for identifying source instance in central monitoring
 83: 
 84: # Instance label (auto-detected from hostname if empty)
 85: NFTBAN_PROMETHEUS_INSTANCE_LABEL=""
 86: 
 87: # Environment label (production, staging, development)
 88: NFTBAN_PROMETHEUS_ENVIRONMENT_LABEL="production"
 89: 
 90: # Cluster name
 91: NFTBAN_PROMETHEUS_CLUSTER_LABEL="nftban-cluster"
 92: 
 93: # Datacenter/Region
 94: NFTBAN_PROMETHEUS_REGION_LABEL=""
 95: NFTBAN_PROMETHEUS_DATACENTER_LABEL=""
 96: 
 97: # Custom labels (key=value pairs, comma-separated)
 98: # Example: "tier=firewall,team=security,customer=acme"
 99: NFTBAN_PROMETHEUS_CUSTOM_LABELS=""
100: 
101: # =============================================================================
102: # METRIC FILTERING
103: # =============================================================================
104: # Control which metrics are sent remotely (regex patterns)
105: 
106: # Only send metrics matching this regex
107: # Default: "nftban_.*" (all NFTBan metrics)
108: NFTBAN_PROMETHEUS_REMOTE_WRITE_METRIC_INCLUDE_REGEX="nftban_.*"
109: 
110: # Exclude metrics matching this regex
111: # Default: "" (no exclusions)
112: NFTBAN_PROMETHEUS_REMOTE_WRITE_METRIC_EXCLUDE_REGEX=""
113: 
114: # =============================================================================
115: # RATE LIMITING
116: # =============================================================================
117: # Limit network bandwidth used by remote write
118: 
119: # Maximum bytes per second for remote write
120: # Set to 0 for unlimited
121: # Default: 0 (unlimited)
122: # Example: 1048576 = 1 MB/s
123: NFTBAN_PROMETHEUS_REMOTE_WRITE_MAX_BYTES_PER_SECOND="0"
124: 
125: # =============================================================================
126: # RETRY CONFIGURATION
127: # =============================================================================
128: 
129: # Enable retries on send failures
130: # Default: true
131: NFTBAN_PROMETHEUS_REMOTE_WRITE_RETRY_ON_FAILURE="true"
132: 
133: # Maximum retry attempts before dropping samples
134: # Default: 3
135: NFTBAN_PROMETHEUS_REMOTE_WRITE_MAX_RETRIES="3"
136: 
137: # =============================================================================
138: # EXAMPLE CONFIGURATIONS
139: # =============================================================================
140: 
141: # --- Example 1: Central Prometheus with Basic Auth ---
142: # NFTBAN_PROMETHEUS_REMOTE_WRITE_ENABLED="true"
143: # NFTBAN_PROMETHEUS_REMOTE_WRITE_URL="https://prometheus.example.com/api/v1/write"
144: # NFTBAN_PROMETHEUS_REMOTE_WRITE_USERNAME="nftban"
145: # NFTBAN_PROMETHEUS_REMOTE_WRITE_PASSWORD_FILE="/etc/nftban/prometheus_password.secret"
146: # NFTBAN_PROMETHEUS_ENVIRONMENT_LABEL="production"
147: # NFTBAN_PROMETHEUS_CLUSTER_LABEL="firewall-prod"
148: 
149: # --- Example 2: Grafana Cloud ---
150: # NFTBAN_PROMETHEUS_REMOTE_WRITE_ENABLED="true"
151: # NFTBAN_PROMETHEUS_REMOTE_WRITE_URL="https://prometheus-prod-01-eu-west-0.grafana.net/api/prom/push"
152: # NFTBAN_PROMETHEUS_REMOTE_WRITE_USERNAME="123456"
153: # NFTBAN_PROMETHEUS_REMOTE_WRITE_PASSWORD="YOUR_GRAFANA_CLOUD_API_KEY"
154: # NFTBAN_PROMETHEUS_ENVIRONMENT_LABEL="production"
155: 
156: # --- Example 3: Thanos Receiver ---
157: # NFTBAN_PROMETHEUS_REMOTE_WRITE_ENABLED="true"
158: # NFTBAN_PROMETHEUS_REMOTE_WRITE_URL="https://thanos-receive.example.com/api/v1/receive"
159: # NFTBAN_PROMETHEUS_REMOTE_WRITE_BEARER_TOKEN_FILE="/etc/nftban/thanos_token.secret"
160: # NFTBAN_PROMETHEUS_CUSTOM_LABELS="tenant=nftban,region=us-east-1"
161: 
162: # --- Example 4: Self-Signed Certificate ---
163: # NFTBAN_PROMETHEUS_REMOTE_WRITE_ENABLED="true"
164: # NFTBAN_PROMETHEUS_REMOTE_WRITE_URL="https://prometheus.internal.example.com/api/v1/write"
165: # NFTBAN_PROMETHEUS_REMOTE_WRITE_CA_FILE="/etc/nftban/ssl/ca.pem"
166: # NFTBAN_PROMETHEUS_REMOTE_WRITE_USERNAME="nftban"
167: # NFTBAN_PROMETHEUS_REMOTE_WRITE_PASSWORD_FILE="/etc/nftban/prometheus_password.secret"
168: 
169: # =============================================================================
170: # SECURITY NOTES
171: # =============================================================================
172: #
173: # 1. NEVER commit passwords to version control
174: # 2. Use password files instead of inline passwords
175: # 3. Set proper file permissions: chmod 600 /etc/nftban/prometheus_password.secret
176: # 4. Rotate credentials regularly
177: # 5. Use TLS for all remote write endpoints
178: # 6. Consider using mTLS (client certificates) for additional security
179: # 7. Monitor failed remote write attempts in logs
180: #
181: # =============================================================================
</file>

<file path="install/prometheus/prometheus-remote.yml.example">
  1: # =============================================================================
  2: # Prometheus Configuration - Remote Write to Grafana Cloud
  3: # =============================================================================
  4: # Location: /etc/prometheus/prometheus.yml
  5: #
  6: # This configuration sends NFTBan metrics to Grafana Cloud via remote write.
  7: #
  8: # Setup:
  9: #   1. Create Grafana Cloud account (free tier available)
 10: #   2. Get your Prometheus endpoint and API key
 11: #   3. Replace placeholders below with your credentials
 12: #   4. Copy to /etc/prometheus/prometheus.yml
 13: #   5. Store API key in /etc/default/prometheus-secrets
 14: #   6. Reload Prometheus: systemctl reload prometheus
 15: # =============================================================================
 16: 
 17: # Global configuration
 18: global:
 19:   scrape_interval: 60s
 20:   evaluation_interval: 60s
 21:   scrape_timeout: 10s
 22: 
 23:   external_labels:
 24:     monitor: 'nftban-prometheus'
 25:     environment: 'production'
 26:     # These labels will be attached to all metrics sent to Grafana Cloud
 27: 
 28: # Scrape configurations (same as base config)
 29: scrape_configs:
 30:   - job_name: 'nftban'
 31:     scrape_interval: 60s
 32:     scrape_timeout: 10s
 33: 
 34:     static_configs:
 35:       - targets:
 36:           - 'localhost:9100'
 37:         labels:
 38:           instance: 'nftban-server'
 39: 
 40:     # Keep only nftban metrics
 41:     metric_relabel_configs:
 42:       - source_labels: [__name__]
 43:         regex: 'nftban_.*'
 44:         action: keep
 45: 
 46: # Remote write to Grafana Cloud
 47: remote_write:
 48:   - url: https://prometheus-prod-XX-prod-XX-XX.grafana.net/api/prom/push
 49:     # Replace with your Grafana Cloud Prometheus endpoint
 50:     # Example: https://prometheus-prod-13-prod-us-east-0.grafana.net/api/prom/push
 51: 
 52:     # Authentication
 53:     basic_auth:
 54:       username: '123456'  # Your Grafana Cloud instance ID
 55:       password: '${GRAFANA_CLOUD_API_KEY}'  # Use environment variable
 56: 
 57:     # Queue configuration (tuning for reliability)
 58:     queue_config:
 59:       capacity: 10000
 60:       max_shards: 10
 61:       min_shards: 1
 62:       max_samples_per_send: 5000
 63:       batch_send_deadline: 5s
 64:       min_backoff: 30ms
 65:       max_backoff: 100ms
 66: 
 67:     # Only send nftban metrics (save on bandwidth/storage)
 68:     write_relabel_configs:
 69:       - source_labels: [__name__]
 70:         regex: 'nftban_.*'
 71:         action: keep
 72: 
 73:     # Metadata configuration
 74:     metadata_config:
 75:       send: true
 76:       send_interval: 1m
 77: 
 78:     # Retry configuration
 79:     # If remote write fails, retry with exponential backoff
 80: 
 81: # Optional: Also keep local storage (recommended)
 82: # This allows querying even if Grafana Cloud is down
 83: storage:
 84:   tsdb:
 85:     retention.time: 7d  # Keep 7 days locally
 86:     retention.size: 5GB
 87:     path: /var/lib/prometheus/
 88: 
 89: # =============================================================================
 90: # Environment Variable Setup
 91: # =============================================================================
 92: #
 93: # Create /etc/default/prometheus-secrets:
 94: #
 95: #   GRAFANA_CLOUD_API_KEY=glc_eyJrIjoiWW91ckFwaUtleUhlcmUiLCJuIjoibmZ0YmFu...
 96: #
 97: # Set permissions:
 98: #   chmod 600 /etc/default/prometheus-secrets
 99: #   chown prometheus:prometheus /etc/default/prometheus-secrets
100: #
101: # Load in systemd service:
102: #   [Service]
103: #   EnvironmentFile=/etc/default/prometheus-secrets
104: #
105: # =============================================================================
106: 
107: # =============================================================================
108: # Getting Grafana Cloud Credentials
109: # =============================================================================
110: #
111: # 1. Sign up at https://grafana.com/auth/sign-up/create-user
112: # 2. Create a free Grafana Cloud account
113: # 3. Go to "Connections" → "Add new connection"
114: # 4. Select "Hosted Prometheus metrics"
115: # 5. Click "Configure"
116: # 6. Find:
117: #    - Remote write endpoint (URL)
118: #    - Instance ID (username)
119: #    - API key (password - generate if needed)
120: #
121: # Free tier includes:
122: #   - 10,000 series
123: #   - 14 days retention
124: #   - 3 users
125: #
126: # NFTBan metrics typically use ~250 series, well within free tier.
127: #
128: # =============================================================================
</file>


231: # =============================================================================
232: # LOG PARSING
233: # =============================================================================
234: 
235: # Find the correct log file
236: nftban_portscan_classic_find_log() {
237:     local log_file="${PORTSCAN_CLASSIC_LOG_FILE}"
238:     local alt_logs="${PORTSCAN_CLASSIC_LOG_FILE_ALT}"
239: 
240:     # Check primary log file
241:     if [[ -f "$log_file" ]]; then
242:         echo "$log_file"
243:         return 0
244:     fi
245: 
246:     # Check alternatives
247:     IFS=',' read -ra alt_array <<< "$alt_logs"
248:     for alt in "${alt_array[@]}"; do
249:         alt=$(echo "$alt" | xargs)  # trim whitespace
250:         if [[ -f "$alt" ]]; then
251:             echo "$alt"
252:             return 0
253:         fi
254:     done
255: 
256:     # Default to syslog
257:     if [[ -f "/var/log/syslog" ]]; then
258:         echo "/var/log/syslog"
259:         return 0
260:     fi
261: 
262:     return 1
263: }
264: 
265: # Parse a log line for portscan info
266: # Returns: SRC_IP|DST_IP|DST_PORT|PROTO
267: nftban_portscan_classic_parse_line() {
268:     local line="$1"
269:     local log_prefix="${PORTSCAN_CLASSIC_LOG_PREFIX}"
270: 
271:     # Check if this is our log entry
272:     [[ "$line" =~ ${log_prefix} ]] || return 1
273: 
274:     local src_ip="" dst_ip="" dst_port="" proto=""
275: 
276:     # Extract source IP
277:     if [[ "$line" =~ SRC=([0-9a-fA-F.:]+) ]]; then
278:         src_ip="${BASH_REMATCH[1]}"
279:     fi
280: 
281:     # Extract destination IP
282:     if [[ "$line" =~ DST=([0-9a-fA-F.:]+) ]]; then
283:         dst_ip="${BASH_REMATCH[1]}"
284:     fi
285: 
286:     # Extract destination port
287:     if [[ "$line" =~ DPT=([0-9]+) ]]; then
288:         dst_port="${BASH_REMATCH[1]}"
289:     fi
290: 
291:     # Extract protocol
292:     if [[ "$line" =~ PROTO=([A-Z]+) ]]; then
293:         proto="${BASH_REMATCH[1]}"
294:     fi
295: 
296:     # Validate we got required fields
297:     [[ -n "$src_ip" && -n "$dst_port" ]] || return 1
298: 
299:     echo "${src_ip}|${dst_ip}|${dst_port}|${proto}"
300:     return 0
301: }
302: 
303: # Process log entries and detect portscans
304: nftban_portscan_classic_process_logs() {
305:     local log_file
306:     log_file=$(nftban_portscan_classic_find_log) || {
307:         nftban_log "ERROR" "portscan_classic" "No log file found"
308:         return 1
309:     }
310: 
311:     local log_prefix="${PORTSCAN_CLASSIC_LOG_PREFIX}"
312:     local time_window="${PORTSCAN_CLASSIC_TIME_WINDOW}"
313:     local current_time
314:     current_time=$(date +%s)
315:     local cutoff_time
316:     cutoff_time=$((current_time - time_window))
317: 
318:     # Read recent log entries
319:     while IFS= read -r line; do
320:         local parsed
321:         parsed=$(nftban_portscan_classic_parse_line "$line") || continue
322: 
323:         IFS='|' read -r src_ip dst_ip dst_port proto <<< "$parsed"
324: 
325:         # Skip whitelisted IPs
326:         if nftban_portscan_classic_is_whitelisted "$src_ip"; then
327:             continue
328:         fi
329: 
330:         # Record this connection
331:         nftban_portscan_classic_record_connection "$src_ip" "$dst_ip" "$dst_port" "$current_time"
332: 
333:     done < <(grep "${log_prefix}" "$log_file" 2>/dev/null | tail -1000)
334: 
335:     # Analyze and block if needed
336:     nftban_portscan_classic_analyze_all
337: 
338:     return 0
339: }

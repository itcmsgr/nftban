 44: # TCP OUTPUT (outgoing connections)
 45: # Ports: FTP(20,21), SMTP(25), Time(37), WHOIS(43), DNS(53),
 46: #        HTTP(80), POP3(110), Ident(113), HTTPS(443), Submission(587),
 47: #        Rsync(873), IMAPS(993), POP3S(995), WHM(2086), WHM SSL(2087),
 48: #        cpsrvd(2089), License(2703)
 49: # NOTE: Port 22 (SSH) excluded - managed automatically as safety port
 50: NFTBAN_CPANEL_TCP_OUT="20,21,25,37,43,53,80,110,113,443,587,873,993,995,2086,2087,2089,2703"
 51: 

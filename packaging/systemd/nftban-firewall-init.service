[Unit]
Description=NFTBan Firewall Initialization (with startup delay)
Documentation=man:nftban(8)
After=network-online.target nftables.service
Wants=network-online.target
# NOTE: Don't use Before=sshd.service (would delay SSH)

[Service]
Type=forking
RemainAfterExit=yes

# Marker that we're running from systemd boot sequence
# Actual delay is controlled by NFTBAN_STARTUP_DELAY in /etc/nftban/nftban.conf
# Default: 0 (no delay). Set to 300 for 5-minute troubleshooting window.
Environment="NFTBAN_SYSTEMD_BOOT=1"

# Set PATH to ensure we find nft command (works on RHEL, Debian, Ubuntu)
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Run as root (firewall init requires root privileges)
User=root
Group=root

# SECURITY FIX: Do NOT use EnvironmentFile with bash -c variable interpolation
# Previous code had CRITICAL command injection vulnerability (CWE-78)
# Attacker could set: NFTBAN_STARTUP_DELAY='0 ]; rm -rf / #'
# This would execute: bash -c 'if [ "0 ]; rm -rf / #" -eq 0 ]; ...'
# Result: System wiped as root on boot
#
# FIX: Call immutable helper script directly (no variable interpolation)
# Helper script validates input before use (blocks injection)
ExecStart=/usr/lib/nftban/helpers/firewall-init-with-delay.sh

# NOTE: Snapshot save will be done by snapshot timer (not here)

# On stop, only remove nftban table (NEVER flush ruleset - destroys cPanel/UFW/CSF rules)
# CRITICAL FIX: v1.17.0 - Previous "flush ruleset" caused lockouts on panel servers
ExecStop=/bin/sh -c 'command -v nft >/dev/null 2>&1 && nft delete table inet nftban 2>/dev/null; nft delete table ip nftban 2>/dev/null; true'

# Don't restart on failure (would cause loops)
Restart=no

# =============================================================================
# Security Hardening (comprehensive - adapted for root firewall service)
# =============================================================================

# Filesystem Protection
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/nftban /var/log/nftban /var/cache/nftban /run/nftban /etc/nftban

# Kernel Protection
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true

# Namespace Restrictions
PrivateDevices=yes
RestrictNamespaces=true
RestrictRealtime=true

# Privilege Restrictions
# NOTE: NoNewPrivileges=no is required because service needs CAP_NET_ADMIN
# for nftables operations. However, other hardening measures compensate.
NoNewPrivileges=no

# Misc Hardening
LockPersonality=true
RestrictSUIDSGID=true
RemoveIPC=true

# Network Access (firewall service needs full network access)
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# System Call Filtering
# Allow: @system-service (basic system operations)
# Allow: @network-io (nftables requires netlink)
# Deny: @debug @mount @module @raw-io @reboot @swap @privileged @resources
SystemCallFilter=@system-service @network-io
SystemCallFilter=~@debug @mount @module @raw-io @reboot @swap @privileged @resources
SystemCallErrorNumber=EPERM

# Logging
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target

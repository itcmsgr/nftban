 25:     --text: #e9ecef;
 26:     --text-muted: #adb5bd;
 27:     --border: #495057;
 28:     --primary: #4dabf7;
 29:     --primary-hover: #339af0;
 30:     --success: #51cf66;
 31:     --danger: #ff6b6b;
 32:     --warning: #ffd43b;
 33: }
 34: 
 35: /* ============================================================================= */
 36: /* RESET & BASE */
 37: /* ============================================================================= */
 38: 
 39: * {
 40:     margin: 0;
 41:     padding: 0;
 42:     box-sizing: border-box;
 43: }
 44: 
 45: body {
 46:     font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
 47:     background: var(--bg);

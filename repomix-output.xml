1073: // Supports multiple log types with search filtering and tail mode
1074: func LogsViewerHandler(w http.ResponseWriter, r *http.Request) {
1075: 	// Get parameters
1076: 	logType := r.URL.Query().Get("log_type")
1077: 	linesStr := r.URL.Query().Get("lines")
1078: 	searchFilter := r.URL.Query().Get("search")
1079: 	tailMode := r.URL.Query().Get("tail") == "true"
1080: 
1081: 	// Default values
1082: 	lines := 100
1083: 	if linesStr != "" {
1084: 		if n, err := strconv.Atoi(linesStr); err == nil && n > 0 && n <= 10000 {
1085: 			lines = n
1086: 		}
1087: 	}
1088: 
1089: 	// Map log types to actual log files - use central config
1090: 	logFiles := getLogFiles()
1091: 
1092: 	// Validate log type
1093: 	logFile, ok := logFiles[logType]
1094: 	if !ok || logType == "" {
1095: 		respondJSON(w, http.StatusBadRequest, ErrorResponse{
1096: 			Error: "Invalid log type. Available: nftban, nftban-actions, portscan, ddos, login-alert, feeds, geoban, suricata-eve, suricata-fast, suricata-stats, suricata-log, cron, maintenance, cli-errors",
1097: 		})
1098: 		return
1099: 	}
1100: 
1101: 	// Check if log file exists
1102: 	if _, err := os.Stat(logFile); os.IsNotExist(err) {
1103: 		respondJSON(w, http.StatusOK, map[string]interface{}{
1104: 			"success":       true,
1105: 			"log_type":      logType,
1106: 			"lines":         []string{},
1107: 			"total_lines":   0,
1108: 			"visible_lines": 0,
1109: 			"message":       "Log file does not exist yet",
1110: 		})
1111: 		return
1112: 	}
1113: 
1114: 	// Read log file with tail
1115: 	var output string
1116: 	var err error
1117: 
1118: 	if searchFilter != "" {
1119: 		// Use grep for filtering
1120: 		output, err = execCommand("sh", "-c", fmt.Sprintf("tail -n %d %s | grep -i '%s'", lines, logFile, searchFilter))
1121: 	} else {
1122: 		// Just tail
1123: 		output, err = execCommand("tail", "-n", strconv.Itoa(lines), logFile)
1124: 	}
1125: 
1126: 	if err != nil {
1127: 		// If grep returns no matches, it's not an error
1128: 		if searchFilter != "" && output == "" {
1129: 			respondJSON(w, http.StatusOK, map[string]interface{}{
1130: 				"success":       true,
1131: 				"log_type":      logType,
1132: 				"lines":         []string{},
1133: 				"total_lines":   0,
1134: 				"visible_lines": 0,
1135: 				"message":       "No matching lines found",
1136: 			})
1137: 			return
1138: 		}
1139: 
1140: 		log.Printf("[ERROR] Failed to read log file %s: %v", logFile, err)
1141: 		respondJSON(w, http.StatusInternalServerError, ErrorResponse{
1142: 			Error: fmt.Sprintf("Failed to read log file: %v", err),
1143: 		})
1144: 		return
1145: 	}
1146: 
1147: 	// Split into lines
1148: 	logLines := strings.Split(strings.TrimSpace(output), "\n")
1149: 	if len(logLines) == 1 && logLines[0] == "" {
1150: 		logLines = []string{}
1151: 	}
1152: 
1153: 	// Response
1154: 	respondJSON(w, http.StatusOK, map[string]interface{}{
1155: 		"success":       true,
1156: 		"log_type":      logType,
1157: 		"lines":         logLines,
1158: 		"total_lines":   len(logLines),
1159: 		"visible_lines": len(logLines),
1160: 		"tail_mode":     tailMode,
1161: 		"search_filter": searchFilter,
1162: 	})

 41: # ==============================================================================
 42: # Shared: Start Prometheus Stack (used by both gui and metrics commands)
 43: # ==============================================================================
 44: nftban_metrics_start_stack() {
 45:     # Start Node Exporter, Prometheus, and NFTBan metrics exporter
 46:     # Returns: 0 on success, 1 on failure
 47: 
 48:     local verbose="${1:-true}"  # Show output by default
 49: 
 50:     # Create textfile collector directory
 51:     mkdir -p /var/lib/node_exporter/textfile_collector
 52:     chown -R nftban:nftban /var/lib/node_exporter/textfile_collector 2>/dev/null || true
 53: 
 54:     # Start Node Exporter (service name varies by distro/install method)
 55:     local node_exporter_started=false
 56:     local node_exporter_service=""
 57: 
 58:     for svc in node-exporter node_exporter prometheus-node-exporter; do
 59:         if systemctl list-unit-files 2>/dev/null | grep -q "^${svc}.service"; then
 60:             node_exporter_service="$svc"
 61:             systemctl enable "$svc" &>/dev/null || true
 62:             systemctl restart "$svc" &>/dev/null || true
 63:             if systemctl is-active "$svc" &>/dev/null; then
 64:                 node_exporter_started=true
 65:                 break
 66:             fi
 67:         fi
 68:     done
 69: 
 70:     if [[ "$node_exporter_started" == "true" ]]; then
 71:         [[ "$verbose" == "true" ]] && echo "  ✓ Node Exporter running ($node_exporter_service)"
 72:     else
 73:         [[ "$verbose" == "true" ]] && echo "  ❌ Node Exporter service not found"
 74:         return 1
 75:     fi
 76: 
 77:     # Start Prometheus
 78:     local prometheus_service
 79:     prometheus_service=$(nftban_distro_get_service prometheus 2>/dev/null || echo "prometheus")
 80: 
 81:     if systemctl list-unit-files 2>/dev/null | grep -q "${prometheus_service}.service"; then
 82:         systemctl enable "$prometheus_service" &>/dev/null || true
 83:         systemctl restart "$prometheus_service" &>/dev/null || true
 84:         if systemctl is-active "$prometheus_service" &>/dev/null; then
 85:             [[ "$verbose" == "true" ]] && echo "  ✓ Prometheus running ($prometheus_service)"
 86:         else
 87:             [[ "$verbose" == "true" ]] && echo "  ❌ Prometheus failed to start"
 88:             return 1
 89:         fi
 90:     else
 91:         [[ "$verbose" == "true" ]] && echo "  ❌ Prometheus service not found"
 92:         return 1
 93:     fi
 94: 
 95:     # Start NFTBan metrics exporter timer
 96:     local metrics_timer="${NFTBAN_TIMER_METRICS_EXPORTER:-nftban-metrics-exporter.timer}"
 97:     local metrics_svc="${NFTBAN_SERVICE_METRICS_EXPORTER:-nftban-metrics-exporter.service}"
 98:     if systemctl list-unit-files 2>/dev/null | grep -q "$metrics_timer"; then
 99:         systemctl enable "$metrics_timer" &>/dev/null || true
100:         systemctl restart "$metrics_timer" &>/dev/null || true
101:         # Trigger one immediate collection
102:         systemctl start "$metrics_svc" &>/dev/null || true
103:         [[ "$verbose" == "true" ]] && echo "  ✓ Metrics collection timer enabled (60s interval)"
104:     else
105:         [[ "$verbose" == "true" ]] && echo "  ⚠️  $metrics_timer not installed"
106:     fi
107: 
108:     return 0
109: }

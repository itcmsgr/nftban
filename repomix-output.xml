273:     test_command "validate" "nftban validate"
274: }
275: 
276: # =============================================================================
277: # REPORT GENERATION
278: # =============================================================================
279: 
280: generate_report() {
281:     echo ""
282:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
283:     echo "TEST RESULTS SUMMARY"
284:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
285:     echo ""
286:     echo "Total Tests:     $TESTS_TOTAL"
287:     echo -e "${GREEN}Passed:          $TESTS_PASSED${NC}"
288:     echo -e "${RED}Failed:          $TESTS_FAILED${NC}"
289:     echo -e "${RED}Timeouts:        $TESTS_TIMEOUT${NC}"
290:     echo -e "${YELLOW}No Output:       $TESTS_NO_OUTPUT${NC}"
291:     echo ""
292: 
293:     local pass_rate=0
294:     if [[ $TESTS_TOTAL -gt 0 ]]; then
295:         pass_rate=$((TESTS_PASSED * 100 / TESTS_TOTAL))
296:     fi
297: 
298:     echo "Pass Rate:       ${pass_rate}%"
299:     echo ""
300:     echo "Completed: $(date)"
301:     echo "Full log: $TEST_LOG"
302:     echo ""
303: 
304:     # Generate JSON report

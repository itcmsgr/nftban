 955: nftban_stats_cleanup_logs() {
 956:     # Rotate and cleanup old logs
 957:     # Usage: nftban_stats_cleanup_logs [days]
 958: 
 959:     local days="${1:-${STATS_RETENTION_DAYS:-90}}"
 960: 
 961:     if type -t nftban_print_status >/dev/null 2>&1; then
 962:         nftban_print_status "info" "Cleaning up logs older than ${days} days..."
 963:     else
 964:         echo "[INFO] Cleaning up logs older than ${days} days..."
 965:     fi
 966: 
 967:     local cleaned=0
 968: 
 969:     # Rotate ban log if too large (>10MB)
 970:     if [[ -f "$NFTBAN_BAN_LOG" ]]; then
 971:         local size
 972:         size=$(stat -c %s "$NFTBAN_BAN_LOG")
 973:         if [[ $size -gt 10485760 ]]; then  # 10MB
 974:             local backup
 975:             backup="${NFTBAN_BAN_LOG}.$(date +%Y%m%d-%H%M%S)"
 976:             mv "$NFTBAN_BAN_LOG" "$backup"
 977:             gzip "$backup" 2>/dev/null || true
 978:             touch "$NFTBAN_BAN_LOG"
 979:             chown nftban:nftban "$NFTBAN_BAN_LOG" 2>/dev/null || true
 980:             chmod 640 "$NFTBAN_BAN_LOG" 2>/dev/null || true
 981: 
 982:             if type -t nftban_print_status >/dev/null 2>&1; then
 983:                 nftban_print_status "success" "Rotated ban log: ${backup}.gz"
 984:             else
 985:                 echo "[SUCCESS] Rotated: ${backup}.gz"
 986:             fi
 987:             cleaned=$((cleaned + 1)) || true
 988:         fi
 989:     fi
 990: 
 991:     # Delete old compressed logs
 992:     find "$(dirname "$NFTBAN_BAN_LOG")" -name "*.log.gz" -mtime +"${days}" -type f -delete 2>/dev/null || true
 993: 
 994:     # Delete old snapshots
 995:     find "$NFTBAN_STATS_SNAPSHOTS_DIR" -type f -mtime +"${days}" -delete 2>/dev/null || true
 996: 
 997:     if type -t nftban_print_status >/dev/null 2>&1; then
 998:         nftban_print_status "success" "Log cleanup complete"
 999:     else
1000:         echo "[SUCCESS] Log cleanup complete"
1001:     fi
1002: }

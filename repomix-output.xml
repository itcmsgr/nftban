 97: /**
 98:  * Initialize page-specific functionality
 99:  */
100: function initializePage(pageName) {
101:     switch(pageName) {
102:         case 'dashboard':
103:             // Initialize dashboard stats and charts
104:             if (typeof loadDashboardStats === 'function') {
105:                 loadDashboardStats();
106:                 console.log('✅ Loaded dashboard stats');
107:             }
108:             if (typeof initDashboardCharts === 'function') {
109:                 initDashboardCharts();
110:                 console.log('✅ Initialized dashboard charts');
111:             }
112:             // Start auto-refresh for dashboard
113:             if (typeof startDashboardRefresh === 'function') {
114:                 startDashboardRefresh(30); // 30 seconds
115:             }
116:             break;
117: 
118:         case 'feeds':
119:             // Initialize feeds loading
120:             if (typeof loadFeeds === 'function') {
121:                 loadFeeds();
122:             }
123:             if (typeof updateFeedsCount === 'function') {
124:                 updateFeedsCount();
125:             }
126:             break;
127: 
128:         case 'fail2ban':
129:             // Initialize fail2ban jails loading
130:             if (typeof loadF2BJails === 'function') {
131:                 loadF2BJails();
132:             }
133:             break;
134: 
135:         case 'portscan':
136:         case 'ddos':
137:             // These pages have inline scripts that auto-execute after being loaded
138:             console.log(`✅ Page ${pageName} scripts will auto-execute`);
139:             break;

501: # =============================================================================
502: # THRESHOLD ACTIONS
503: # =============================================================================
504: 
505: # Check thresholds and take action
506: nftban_portscan_suricata_check_thresholds() {
507:     local ip="$1"
508:     local score="$2"
509: 
510:     local threshold_observe="${PORTSCAN_SURICATA_THRESHOLD_OBSERVE}"
511:     local threshold_short="${PORTSCAN_SURICATA_THRESHOLD_BLOCK_SHORT}"
512:     local threshold_long="${PORTSCAN_SURICATA_THRESHOLD_BLOCK_LONG}"
513:     local threshold_permanent="${PORTSCAN_SURICATA_THRESHOLD_BLOCK_PERMANENT}"
514: 
515:     # Use bc for float comparison
516:     local compare_result
517: 
518:     # Check permanent threshold
519:     compare_result=$(echo "$score >= $threshold_permanent" | bc -l 2>/dev/null || echo 0)
520:     if [[ "$compare_result" == "1" ]]; then
521:         nftban_portscan_suricata_block_ip "$ip" "permanent" "$score"
522:         return 0
523:     fi
524: 
525:     # Check long block threshold
526:     compare_result=$(echo "$score >= $threshold_long" | bc -l 2>/dev/null || echo 0)
527:     if [[ "$compare_result" == "1" ]]; then
528:         nftban_portscan_suricata_block_ip "$ip" "long" "$score"
529:         return 0
530:     fi
531: 
532:     # Check short block threshold
533:     compare_result=$(echo "$score >= $threshold_short" | bc -l 2>/dev/null || echo 0)
534:     if [[ "$compare_result" == "1" ]]; then
535:         nftban_portscan_suricata_block_ip "$ip" "short" "$score"
536:         return 0
537:     fi
538: 
539:     # Check observe threshold
540:     compare_result=$(echo "$score >= $threshold_observe" | bc -l 2>/dev/null || echo 0)
541:     if [[ "$compare_result" == "1" ]]; then
542:         if [[ "${PORTSCAN_SURICATA_LOG_SCORES:-true}" == "true" ]]; then
543:             nftban_log "INFO" "portscan_suricata" "Observing ${ip} score=${score}"
544:         fi
545:     fi
546: 
547:     return 0
548: }

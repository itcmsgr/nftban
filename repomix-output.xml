107: 		}
108: 		trustName := os.Args[3]
109: 		return cmdTrustEnable(trustConfig, trustName, true)
110: 	case "disable":
111: 		if len(os.Args) < 4 {
112: 			return fmt.Errorf("usage: nftban-core trust disable <TRUST_NAME>")
113: 		}
114: 		trustName := os.Args[3]
115: 		return cmdTrustEnable(trustConfig, trustName, false)
116: 	case "update":
117: 		return cmdTrustUpdate(trustDir, trustConfig)
118: 	case "load":
119: 		return cmdTrustLoad(trustDir)
120: 	default:
121: 		return fmt.Errorf("unknown trust action: %s\nUsage: nftban-core trust [list|enable|disable|update|load] [NAME]", action)
122: 	}

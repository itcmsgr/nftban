154: nftban_metrics_is_running() {
155:     # Check if all 3 services are running
156:     # Returns: 0 if all running, 1 if any stopped
157: 
158:     local prometheus_service
159:     prometheus_service=$(nftban_distro_get_service prometheus 2>/dev/null || echo "prometheus")
160: 
161:     local node_exporter_service
162:     node_exporter_service=$(nftban_distro_get_service node_exporter 2>/dev/null || echo "prometheus-node-exporter")
163: 
164:     local metrics_timer="${NFTBAN_TIMER_METRICS_EXPORTER:-nftban-metrics-exporter.timer}"
165:     if systemctl is-active "$prometheus_service" &>/dev/null && \
166:        systemctl is-active "$node_exporter_service" &>/dev/null && \
167:        systemctl is-active "$metrics_timer" &>/dev/null; then

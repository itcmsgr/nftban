#!/usr/bin/env bash
# =============================================================================
# NFTBan v0.32.6 - Go Binary Wrapper (nftban-feeds)
# =============================================================================
# SPDX-License-Identifier: MPL-2.0
# Purpose: Smart wrapper that auto-execs real Go binary if available
#
# meta:name=nftban-feeds
# meta:type=tool
# meta:header=NFTBan Feeds Parser (Go Binary Wrapper)
# meta:version=0.30.0
# meta:owner="Antonios Voulvoulis <contact@nftban.com>"
# meta:homepage=https://nftban.com
#
# **Architecture:**
# - Source installs: This wrapper runs (slower Bash fallback)
# - RPM/DEB packages: Real Go binary in .real/ directory (fast)
#
# meta:created_date=2025-10-28
# =============================================================================

set -Eeuo pipefail

# Auto-detect architecture and find real Go binary
ARCH=$(uname -m)
REAL="/usr/lib/nftban/bin/.real/nftban-feeds-${ARCH}"

# If architecture-specific binary exists, use it (10-60x faster)
if [ -x "$REAL" ]; then
    exec "$REAL" "$@"
fi

# Fallback mode (source installations without compiled binary)
printf "[nftban] ⚠️  nftban-feeds Go binary not present. Using Bash fallback.\n" >&2
printf "[nftban] For better performance, install from RPM/DEB package or build Go binaries.\n" >&2
printf "[nftban] See: https://github.com/itcmsgr/nftban/blob/main/docs/development/GO-BINARIES.md\n" >&2

# Bash fallback: Parse feeds for IPs and CIDRs
case "${1:-}" in
    parse|--list)
        # Extract IPv4 addresses and CIDRs from stdin
        # Supports: 192.168.1.1, 10.0.0.0/8, comments (#), blank lines
        grep -v '^\s*#' 2>/dev/null | \
        grep -v '^\s*$' | \
        grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}(/[0-9]{1,2})?' | \
        sort -u
        ;;
    *)
        echo "[nftban-feeds] Usage: nftban-feeds parse|--list < feed.txt" >&2
        echo "[nftban-feeds] Extracts IPs/CIDRs from threat feed files" >&2
        exit 1
        ;;
esac

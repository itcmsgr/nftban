 777:     # Create source tarball
 778:     local tarball="nftban-core-${PKG_VERSION}.tar.gz"
 779: 
 780:     # Verify all required directories exist before creating tarball
 781:     log_info "Verifying source directories for tarball..."
 782:     local missing_dirs=()
 783:     for dir in bin cli cmd pkg install etc internal packaging scripts docs; do
 784:         if [[ ! -d "${PROJECT_ROOT}/${dir}" ]]; then
 785:             missing_dirs+=("${dir}")
 786:         fi
 787:     done
 788: 
 789:     if [[ ${#missing_dirs[@]} -gt 0 ]]; then

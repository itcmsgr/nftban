 15: 
 16: // RulesDir contains paths to Suricata rules
 17: type RulesDir struct {
 18: 	BaseDir     string // /var/lib/suricata/rules
 19: 	EnabledList string // /etc/nftban/suricata/rules/enabled.list
 20: 	CustomRules string // /etc/nftban/suricata/rules/custom.rules
 21: }
 22: 
 23: // GetRulesPaths returns paths based on distro config
 24: func GetRulesPaths() (*RulesDir, error) {
 25: 	// Get distro-specific Suricata rules directory
 26: 	distro, err := nftbanConfig.LoadDistroConfig()
 27: 	if err != nil {
 28: 		return nil, err
 29: 	}
 30: 
 31: 	baseDir := distro.Paths["suricata_rules_dir"]
 32: 	if baseDir == "" {
 33: 		baseDir = "/var/lib/suricata/rules" // Fallback
 34: 	}
 35: 
 36: 	// NFTBan config directory
 37: 	cfg := nftbanconf.MustLoad()
 38: 	nftbanConfigDir := filepath.Join(cfg.ConfigDir, "suricata")
 39: 
 40: 	return &RulesDir{
 41: 		BaseDir:     baseDir,
 42: 		EnabledList: filepath.Join(nftbanConfigDir, "rules/enabled.list"),
 43: 		CustomRules: filepath.Join(nftbanConfigDir, "rules/custom.rules"),
 44: 	}, nil
 45: }
 46: 
 47: // GenerateEnabledList creates enabled.list from effective config
 48: func GenerateEnabledList() error {
 49: 	paths, err := GetRulesPaths()
 50: 	if err != nil {
 51: 		return err
 52: 	}
 53: 
 54: 	configPaths, err := suricataConfig.GetConfigPaths()
 55: 	if err != nil {
 56: 		return err
 57: 	}
 58: 
 59: 	// Ensure directories exist
 60: 	if err := os.MkdirAll(filepath.Dir(paths.EnabledList), 0755); err != nil {
 61: 		return fmt.Errorf("failed to create rules directory: %w", err)
 62: 	}
 63: 
 64: 	// Load effective config
 65: 	effectiveConfig := suricataConfig.LoadConfig(configPaths.EffectiveConf)
 66: 
 67: 	// Find all available rule files
 68: 	allRules, err := findAllRuleFiles(paths.BaseDir)
 69: 	if err != nil {
 70: 		return fmt.Errorf("failed to scan rules directory: %w", err)
 71: 	}
 72: 
 73: 	// Filter rules based on enabled categories
 74: 	enabledRules := filterRulesByCategories(allRules, effectiveConfig.EnabledCategories)
 75: 
 76: 	// Build enabled.list content
 77: 	var content strings.Builder

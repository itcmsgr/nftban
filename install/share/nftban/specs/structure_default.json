{
  "version": "2.1",
  "description": "NFTBan nftables structure specification - Separate ip/ip6 architecture",
  "last_updated": "2026-01-20",
  "architecture_notes": {
    "design": "Separate ip/ip6 tables (NOT inet combined)",
    "rationale": [
      "Cleaner: No _v4/_v6 suffixes on set names within each table",
      "Simpler: No ip/ip6 prefixes in rules (kernel knows family)",
      "Performance: Kernel routes by family first anyway",
      "Maintenance: Clear separation, easier to debug"
    ],
    "priority_design": {
      "input": -100,
      "forward": -100,
      "output": 0,
      "rationale": "Priority -100 ensures NFTBan runs BEFORE panel firewalls (CSF, Plesk, DirectAdmin use priority 0)"
    },
    "reference": "See nft_schema.sh for canonical specification"
  },
  "expected_structure": {
    "tables": {
      "ip nftban": {
        "description": "IPv4 NFTBan firewall table",
        "required": true,
        "chains": {
          "input": {
            "type": "filter",
            "hook": "input",
            "priority": -100,
            "policy": "drop",
            "required": true,
            "description": "Main input chain (priority -100: before panel firewalls)"
          },
          "forward": {
            "type": "filter",
            "hook": "forward",
            "priority": -100,
            "policy": "drop",
            "required": true,
            "description": "Forward chain (priority -100: before panel firewalls)"
          },
          "output": {
            "type": "filter",
            "hook": "output",
            "priority": 0,
            "policy": "accept",
            "required": true,
            "description": "Output chain"
          }
        },
        "sets": {
          "whitelist_ipv4": {
            "type": "ipv4_addr",
            "flags": "interval",
            "required": true,
            "description": "IPv4 whitelist - full access"
          },
          "blacklist_ipv4": {
            "type": "ipv4_addr",
            "flags": "interval,timeout",
            "required": true,
            "description": "IPv4 blacklist - permanent + temporary with timeout"
          },
          "tcp_ports": {
            "type": "inet_service",
            "required": true,
            "description": "Allowed TCP ports (22, 80, 443)"
          },
          "udp_ports": {
            "type": "inet_service",
            "required": true,
            "description": "Allowed UDP ports"
          }
        }
      },
      "ip6 nftban": {
        "description": "IPv6 NFTBan firewall table",
        "required": true,
        "chains": {
          "input": {
            "type": "filter",
            "hook": "input",
            "priority": -100,
            "policy": "drop",
            "required": true,
            "description": "Main input chain (priority -100: before panel firewalls)"
          },
          "forward": {
            "type": "filter",
            "hook": "forward",
            "priority": -100,
            "policy": "drop",
            "required": true,
            "description": "Forward chain (priority -100: before panel firewalls)"
          },
          "output": {
            "type": "filter",
            "hook": "output",
            "priority": 0,
            "policy": "accept",
            "required": true,
            "description": "Output chain"
          }
        },
        "sets": {
          "whitelist_ipv6": {
            "type": "ipv6_addr",
            "flags": "interval",
            "required": true,
            "description": "IPv6 whitelist - full access"
          },
          "blacklist_ipv6": {
            "type": "ipv6_addr",
            "flags": "interval,timeout",
            "required": true,
            "description": "IPv6 blacklist - permanent + temporary with timeout"
          },
          "tcp_ports": {
            "type": "inet_service",
            "required": true,
            "description": "Allowed TCP ports"
          },
          "udp_ports": {
            "type": "inet_service",
            "required": true,
            "description": "Allowed UDP ports"
          }
        }
      }
    },
    "deprecated_tables": {
      "description": "Tables that should NOT exist (legacy from upgrades)",
      "tables": [
        "inet nftban",
        "inet nftban_main",
        "inet nftban_runtime"
      ],
      "reason": "OLD v0.6.x dual-stack approach - migrate to ip/ip6 tables"
    },
    "priority_safety": {
      "description": "NFTBan must run BEFORE other firewall chains on same hook",
      "nftban_priority": -100,
      "safe_if": "nftban_priority < other_chain_priority",
      "panels_use_priority_0": ["CSF", "Plesk", "DirectAdmin"],
      "validation_rules": {
        "critical": "Other chain on same hook has priority <= NFTBan priority (tie or earlier)",
        "warning": "Other firewall chains detected (ip/ip6 filter) but NFTBan runs first",
        "ok": "No conflicting chains, or NFTBan is earliest"
      }
    },
    "rule_order": {
      "description": "Expected rule processing order in input chain (SECURITY CRITICAL)",
      "order": [
        {
          "position": 1,
          "pattern": "ct state invalid drop",
          "description": "Drop invalid packets first"
        },
        {
          "position": 2,
          "pattern": "iif \"lo\" accept",
          "description": "Allow loopback"
        },
        {
          "position": 3,
          "pattern": "saddr @whitelist accept",
          "description": "Whitelist (bypass all checks)"
        },
        {
          "position": 4,
          "pattern": "saddr @blacklist drop",
          "description": "Blacklist BEFORE established (security fix!)"
        },
        {
          "position": 5,
          "pattern": "ct state established,related accept",
          "description": "NOW allow established (safe after bans)"
        },
        {
          "position": 6,
          "pattern": "icmp type",
          "description": "ICMP rules"
        },
        {
          "position": 7,
          "pattern": "tcp dport @tcp_ports accept",
          "description": "Allow TCP ports"
        },
        {
          "position": 8,
          "pattern": "udp dport @udp_ports accept",
          "description": "Allow UDP ports"
        },
        {
          "position": 9,
          "pattern": "drop",
          "description": "Default deny (catch-all)"
        }
      ],
      "security_note": "Blacklist MUST come BEFORE 'ct state established' to block banned IPs immediately!"
    },
    "validation_checks": {
      "required_tables": [
        "ip nftban",
        "ip6 nftban"
      ],
      "priority_check": {
        "nftban_must_be_earliest": true,
        "nftban_priority": -100,
        "warn_if_other_chains_exist": true
      },
      "required_sets": [
        "ip nftban whitelist_ipv4",
        "ip nftban blacklist_ipv4",
        "ip nftban tcp_ports",
        "ip nftban udp_ports",
        "ip6 nftban whitelist_ipv6",
        "ip6 nftban blacklist_ipv6",
        "ip6 nftban tcp_ports",
        "ip6 nftban udp_ports"
      ],
      "policy_checks": {
        "ip nftban input": "drop",
        "ip nftban forward": "drop",
        "ip nftban output": "accept",
        "ip6 nftban input": "drop",
        "ip6 nftban forward": "drop",
        "ip6 nftban output": "accept"
      }
    }
  },
  "severity_levels": {
    "critical": {
      "description": "Security-critical issues that must be fixed immediately",
      "examples": [
        "Missing ip nftban table",
        "Wrong policy (accept instead of drop)",
        "Forbidden table exists (inet filter bypassing NFTBan)",
        "Blacklist after established (security bug)"
      ]
    },
    "warning": {
      "description": "Issues that may cause unexpected behavior",
      "examples": [
        "Missing optional sets",
        "Missing ip6 nftban table (IPv6 disabled)",
        "Rule order not matching spec"
      ]
    },
    "info": {
      "description": "Informational messages",
      "examples": [
        "Legacy tables detected (can be removed)",
        "Additional custom tables detected"
      ]
    }
  }
}

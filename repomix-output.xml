  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - Security & Capability Helper
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Capability checks and helpers for privileged operations
  7: #
  8: # meta:name=nftban_security
  9: # meta:type=core
 10: # meta:header=Security & Capability Helper
 11: # meta:version=1.0.0
 12: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 13: # meta:homepage=https://nftban.com
 14: #
 15: # **Description & Purpose**
 16: # meta:description=Provides capability checking functions for CAP_NET_ADMIN
 17: # meta:input=None
 18: # meta:output=Return codes (0=success, 1=failure)
 19: #
 20: # **Inventory & Requirements**
 21: # meta:depends=nft,bash
 22: #
 23: # meta:created_date=2025-11-05
 24: # meta:updated_date=2025-11-24
 25: # meta:contributors=ChatGPT (OpenAI) - Architecture and implementation guidance
 26: # =============================================================================
 27: 
 28: # Enhanced strict mode
 29: IFS=$'\n\t'
 30: umask 027
 31: 
 32: # Prevent double-loading
 33: [[ -n "${NFTBAN_SECURITY_LOADED:-}" ]] && return 0
 34: readonly NFTBAN_SECURITY_LOADED=1
 35: 
 36: # =============================================================================
 37: # CAPABILITY CHECKING FUNCTIONS
 38: # =============================================================================
 39: 
 40: # Check if current process has CAP_NET_ADMIN capability
 41: # Returns: 0 if capability present, 1 otherwise
 42: nftban_has_net_admin() {
 43:     # Method 1: Preferred - harmless read-only query through nft
 44:     # This works regardless of how capability was granted (ambient, file, etc.)
 45:     #
 46:     # PERFORMANCE FIX: Use 'nft -t list tables' (terse mode) instead of 'nft list tables'
 47:     # Reason: With large feed sets (5000+ IPs), 'list tables' dumps ALL table contents
 48:     #         including all IP addresses, taking 30+ seconds and 100% CPU.
 49:     #         Terse mode only lists table names, completing in <0.1 seconds.
 50:     # Impact: CAP_NET_ADMIN check goes from 30s to 0.1s
 51:     if command -v nft >/dev/null 2>&1; then
 52:         if nft -t list tables >/dev/null 2>&1; then
 53:             return 0
 54:         fi
 55:     fi
 56: 
 57:     # Method 2: Check CapEff bitmask for CAP_NET_ADMIN
 58:     # CAP_NET_ADMIN is bit 12 in Linux capabilities (0x0000000000001000 in hex)
 59:     # See: linux/capability.h
 60:     if [[ -r /proc/self/status ]]; then
 61:         local hexbits
 62:         hexbits="$(awk '/^CapEff:/ {print $2}' /proc/self/status 2>/dev/null || true)"
 63:         if [[ -n "${hexbits:-}" ]]; then
 64:             # Check if CAP_NET_ADMIN bit is set (bit 12 = 0x1000)
 65:             if (( 0x$hexbits & 0x0000000000001000 )); then
 66:                 return 0
 67:             fi
 68:         fi
 69:     fi
 70: 
 71:     return 1
 72: }
 73: 
 74: # Require CAP_NET_ADMIN or exit with clear error message
 75: # Usage: nftban_require_net_admin_or_exit
 76: nftban_require_net_admin_or_exit() {
 77:     if ! nftban_has_net_admin; then
 78:         cat <<'ERR' >&2
 79: 
 80: ╔════════════════════════════════════════════════════════════╗
 81: ║  ERROR: CAP_NET_ADMIN capability required                 ║
 82: ╚════════════════════════════════════════════════════════════╝
 83: 
 84: NFTBan requires the Linux CAP_NET_ADMIN capability to manage
 85: nftables firewall rules.
 86: 
 87: RECOMMENDED SOLUTION (service-scoped capability):
 88:   Ensure the systemd service grants CAP_NET_ADMIN:
 89: 
 90:   [Service]
 91:   User=nftban
 92:   Group=nftban
 93:   AmbientCapabilities=CAP_NET_ADMIN
 94:   CapabilityBoundingSet=CAP_NET_ADMIN
 95: 
 96: TEMPORARY WORKAROUND (not recommended):
 97:   Run the command as root:
 98: 
 99:   sudo nftban [command]
100: 
101: DOCUMENTATION:
102:   See /usr/share/nftban/docs/README.capabilities for details
103:   on NFTBan's capability-based security model.
104: 
105: SECURITY NOTE:
106:   NFTBan uses service-scoped capabilities instead of running
107:   as root, following the principle of least privilege. This
108:   grants ONLY network administration capability, not full
109:   root access.
110: 
111: ERR
112:         exit 1
113:     fi
114: }
115: 
116: # Check if running as root (for operations that genuinely need root)
117: # Usage: nftban_require_root_or_exit "operation description"
118: nftban_require_root_or_exit() {
119:     local operation="${1:-this operation}"
120: 
121:     if [[ $EUID -ne 0 ]]; then
122:         cat <<ERR >&2
123: 
124: ERROR: Root privileges required for ${operation}
125: 
126: This operation requires root access because it modifies system-level
127: resources outside of NFTBan's data directories.
128: 
129: Run as root:
130:   sudo nftban [command]
131: 
132: ERR
133:         exit 1
134:     fi
135: }
136: 
137: # =============================================================================
138: # EXPORTS
139: # =============================================================================
140: 
141: export -f nftban_has_net_admin
142: export -f nftban_require_net_admin_or_exit
143: export -f nftban_require_root_or_exit
</file>


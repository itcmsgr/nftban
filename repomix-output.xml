286: // parseLoginEvents reads login events from log and auth.log
287: func parseLoginEvents(limit int) []LoginEvent {
288: 	var events []LoginEvent
289: 
290: 	// Read from nftban login_alert.log - use central config
291: 	logPath := getLoginAlertLogPath()
292: 	file, err := os.Open(logPath)
293: 	if err == nil {
294: 		defer file.Close()
295: 		scanner := bufio.NewScanner(file)
296: 		var lines []string
297: 		for scanner.Scan() {
298: 			lines = append(lines, scanner.Text())
299: 		}
300: 		// Read last N lines
301: 		start := 0
302: 		if len(lines) > limit {
303: 			start = len(lines) - limit
304: 		}
305: 		for i := len(lines) - 1; i >= start; i-- {
306: 			if event := parseLoginLogLine(lines[i]); event != nil {
307: 				events = append(events, *event)
308: 			}
309: 		}
310: 	}
311: 
312: 	// If no events from nftban log, try auth.log for SSH events
313: 	if len(events) == 0 {
314: 		events = parseAuthLog(limit)
315: 	}
316: 
317: 	return events
318: }

 207: // AddSetElements adds IPs to a set (batch operation with chunking)
 208: // Processes in batches of 10000 IPs to avoid netlink message size limits
 209: func (m *NFTManager) AddSetElements(set *nftables.Set, ips []string) error {
 210: 	if len(ips) == 0 {
 211: 		return nil
 212: 	}
 213: 
 214: 	// For interval sets, use nft CLI (netlink doesn't handle CIDR intervals well)
 215: 	if set.Interval {
 216: 		return m.addSetElementsCLI(set, ips)
 217: 	}
 218: 
 219: 	// Process in chunks to avoid "message too long" error
 220: 	const batchSize = 10000
 221: 	for i := 0; i < len(ips); i += batchSize {
 222: 		end := i + batchSize
 223: 		if end > len(ips) {
 224: 			end = len(ips)
 225: 		}
 226: 
 227: 		batch := ips[i:end]
 228: 		if err := m.addSetElementsBatch(set, batch); err != nil {
 229: 			return fmt.Errorf("failed to add batch %d-%d: %w", i, end, err)
 230: 		}
 231: 	}
 232: 
 233: 	return nil
 234: }

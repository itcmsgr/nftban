 349:         version=$(suricata -V 2>&1 | head -1 || echo "unknown")
 350:         echo "  Installed:  ✅ YES - $version"
 351:     else
 352:         echo "  Installed:  ❌ NO"
 353:         echo ""
 354:         echo "Install with:"
 355:         echo "  nftban suricata install"
 356:         return 1
 357:     fi
 358: 
 359:     # Service status
 360:     if _suricata_is_running; then
 361:         echo "  Running:    ✅ YES"
 362:     else
 363:         echo "  Running:    ❌ NO"
 364:     fi
 365: 
 366:     if _suricata_is_enabled; then
 367:         echo "  Enabled:    ✅ YES (starts on boot)"
 368:     else
 369:         echo "  Enabled:    ❌ NO"
 370:     fi
 371: 
 372:     # Auto-update timer status
 373:     if systemctl is-enabled --quiet nftban-suricata-update.timer 2>/dev/null; then
 374:         echo "  Auto-update: ✅ YES (weekly Sunday 3 AM)"
 375:     elif [[ -f /usr/lib/systemd/system/nftban-suricata-update.timer ]]; then
 376:         echo "  Auto-update: ❌ NO (timer not enabled)"
 377:     else
 378:         echo "  Auto-update: ⊘ Timer not installed"
 379:     fi

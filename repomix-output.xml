<file path=".github/workflows/build-packages.yml">
  1: name: Build NFTBan Packages
  2: 
  3: on:
  4:   push:
  5:     branches:
  6:       - main
  7:       - master
  8:       - develop
  9:   pull_request:
 10:     branches:
 11:       - main
 12:       - master
 13:   workflow_dispatch:
 14: 
 15: jobs:
 16:   # ==========================================================================
 17:   # BUILD GO BINARIES
 18:   # ==========================================================================
 19:   build-binaries:
 20:     name: Build Go binaries
 21:     runs-on: ubuntu-latest
 22:     steps:
 23:       - name: Checkout code
 24:         uses: actions/checkout@v4
 25:         with:
 26:           fetch-depth: 0
 27: 
 28:       - name: Set up Go
 29:         uses: actions/setup-go@v5
 30:         with:
 31:           go-version: '1.21'
 32: 
 33:       - name: Install build dependencies
 34:         run: |
 35:           sudo apt-get update
 36:           sudo apt-get install -y libpam0g-dev
 37: 
 38:       - name: Build binaries
 39:         run: |
 40:           chmod +x build.sh
 41:           ./build.sh
 42:           ls -la bin/
 43: 
 44:       - name: Upload binaries
 45:         uses: actions/upload-artifact@v4
 46:         with:
 47:           name: go-binaries
 48:           path: bin/
 49:           retention-days: 1
 50: 
 51:   # ==========================================================================
 52:   # BUILD RPM PACKAGES
 53:   # ==========================================================================
 54:   build-rpm:
 55:     name: Build RPM (${{ matrix.distro }})
 56:     needs: build-binaries
 57:     runs-on: ubuntu-latest
 58:     strategy:
 59:       fail-fast: false
 60:       matrix:
 61:         include:
 62:           # EL family (covers Rocky, Alma, RHEL, CentOS Stream)
 63:           - distro: el9
 64:             container: rockylinux:9
 65:             name_suffix: el9
 66:           - distro: el10
 67:             container: almalinux:10
 68:             name_suffix: el10
 69:           # Fedora (current stable + previous)
 70:           - distro: fc42
 71:             container: fedora:42
 72:             name_suffix: fc42
 73:           - distro: fc43
 74:             container: fedora:43
 75:             name_suffix: fc43
 76: 
 77:     steps:
 78:       - name: Checkout code
 79:         uses: actions/checkout@v4
 80: 
 81:       - name: Download binaries
 82:         uses: actions/download-artifact@v4
 83:         with:
 84:           name: go-binaries
 85:           path: bin/
 86: 
 87:       - name: Build RPM in ${{ matrix.distro }} container
 88:         run: |
 89:           chmod +x bin/*
 90:           docker run --rm -v "$(pwd):/workspace" -w /workspace ${{ matrix.container }} bash -c "
 91:             # Install build dependencies
 92:             dnf -y install rpm-build rpmdevtools tar gzip systemd-rpm-macros make
 93: 
 94:             # Build RPM
 95:             chmod +x packaging/build_nftban.sh
 96:             cd packaging
 97:             ./build_nftban.sh rpm
 98: 
 99:             # Fix permissions
100:             chmod -R a+rX /workspace/build/
101:           "
102: 
103:       - name: Rename RPM with distro suffix
104:         run: |
105:           mkdir -p dist/packages
106:           for rpm in build/packages/RPMS/*/*.rpm; do
107:             if [[ -f "$rpm" ]]; then
108:               # Rename: nftban-core-1.0.0-1.el10.x86_64.rpm -> nftban-el10-x86_64.rpm
109:               newname="nftban-${{ matrix.name_suffix }}-x86_64.rpm"
110:               cp "$rpm" "dist/packages/$newname"
111:               echo "Renamed: $(basename "$rpm") -> $newname"
112:             fi
113:           done
114:           ls -la dist/packages/
115: 
116:       - name: Upload RPM packages (${{ matrix.distro }})
117:         uses: actions/upload-artifact@v4
118:         with:
119:           name: rpm-${{ matrix.distro }}
120:           path: dist/packages/*.rpm
121:           retention-days: 30
122: 
123:   # ==========================================================================
124:   # BUILD DEB PACKAGES
125:   # ==========================================================================
126:   build-deb:
127:     name: Build DEB (${{ matrix.distro }})
128:     needs: build-binaries
129:     runs-on: ubuntu-latest
130:     strategy:
131:       fail-fast: false
132:       matrix:
133:         include:
134:           - distro: ubuntu22.04
135:             container: ubuntu:22.04
136:             name_suffix: ubuntu22.04
137:           - distro: ubuntu24.04
138:             container: ubuntu:24.04
139:             name_suffix: ubuntu24.04
140:           - distro: debian12
141:             container: debian:12
142:             name_suffix: debian12
143: 
144:     steps:
145:       - name: Checkout code
146:         uses: actions/checkout@v4
147: 
148:       - name: Download binaries
149:         uses: actions/download-artifact@v4
150:         with:
151:           name: go-binaries
152:           path: bin/
153: 
154:       - name: Build DEB in ${{ matrix.distro }} container
155:         run: |
156:           chmod +x bin/*
157:           docker run --rm -v "$(pwd):/workspace" -w /workspace ${{ matrix.container }} bash -c "
158:             # Install build dependencies
159:             apt-get update
160:             apt-get install -y dpkg-dev build-essential
161: 
162:             # Build DEB
163:             chmod +x packaging/build_nftban.sh
164:             cd packaging
165:             ./build_nftban.sh deb
166: 
167:             # Fix permissions
168:             chmod -R a+rX /workspace/build/
169:           "
170: 
171:       - name: Rename DEB with distro suffix
172:         run: |
173:           mkdir -p dist/packages
174:           for deb in build/packages/*.deb; do
175:             if [[ -f "$deb" ]]; then
176:               # Rename: nftban-core_1.0.0_amd64.deb -> nftban-ubuntu22.04-amd64.deb
177:               newname="nftban-${{ matrix.name_suffix }}-amd64.deb"
178:               cp "$deb" "dist/packages/$newname"
179:               echo "Renamed: $(basename "$deb") -> $newname"
180:             fi
181:           done
182:           ls -la dist/packages/
183: 
184:       - name: Upload DEB packages (${{ matrix.distro }})
185:         uses: actions/upload-artifact@v4
186:         with:
187:           name: deb-${{ matrix.distro }}
188:           path: dist/packages/*.deb
189:           retention-days: 30
190: 
191:   # ==========================================================================
192:   # TEST INSTALLATION (RPM - CentOS Stream)
193:   # ==========================================================================
194:   test-rpm-install:
195:     name: Test RPM install (${{ matrix.distro }})
196:     needs: build-rpm
197:     runs-on: ubuntu-latest
198:     strategy:
199:       fail-fast: false
200:       matrix:
201:         include:
202:           - distro: centos-stream9
203:             container: quay.io/centos/centos:stream9
204:             rpm_artifact: rpm-el9
205:           - distro: centos-stream10
206:             container: quay.io/centos/centos:stream10
207:             rpm_artifact: rpm-el10
208:           - distro: rocky9
209:             container: rockylinux:9
210:             rpm_artifact: rpm-el9
211:           - distro: alma9
212:             container: almalinux:9
213:             rpm_artifact: rpm-el9
214: 
215:     steps:
216:       - name: Download RPM packages
217:         uses: actions/download-artifact@v4
218:         with:
219:           name: ${{ matrix.rpm_artifact }}
220:           path: ./packages
221: 
222:       - name: Test installation on ${{ matrix.distro }}
223:         run: |
224:           docker run --rm -v $(pwd)/packages:/packages ${{ matrix.container }} bash -c "
225:             dnf install -y /packages/*.rpm &&
226:             nftban --version &&
227:             systemctl list-unit-files | grep nftban
228:           " && echo "✅ ${{ matrix.distro }} install test passed" || echo "❌ ${{ matrix.distro }} install test failed"
229: 
230:   # ==========================================================================
231:   # TEST INSTALLATION (DEB)
232:   # ==========================================================================
233:   test-deb-install:
234:     name: Test DEB install (${{ matrix.distro }})
235:     needs: build-deb
236:     runs-on: ubuntu-latest
237:     strategy:
238:       fail-fast: false
239:       matrix:
240:         include:
241:           - distro: ubuntu22.04
242:             container: ubuntu:22.04
243:             deb_artifact: deb-ubuntu22.04
244:           - distro: ubuntu24.04
245:             container: ubuntu:24.04
246:             deb_artifact: deb-ubuntu24.04
247:           - distro: debian12
248:             container: debian:12
249:             deb_artifact: deb-debian12
250: 
251:     steps:
252:       - name: Download DEB packages
253:         uses: actions/download-artifact@v4
254:         with:
255:           name: ${{ matrix.deb_artifact }}
256:           path: ./packages
257: 
258:       - name: Test installation on ${{ matrix.distro }}
259:         run: |
260:           docker run --rm -v $(pwd)/packages:/packages ${{ matrix.container }} bash -c "
261:             apt-get update &&
262:             apt-get install -y /packages/*.deb &&
263:             nftban --version &&
264:             systemctl list-unit-files | grep nftban
265:           " && echo "✅ ${{ matrix.distro }} install test passed" || echo "❌ ${{ matrix.distro }} install test failed"
266: 
267:   # ==========================================================================
268:   # CONSOLIDATE ALL PACKAGES
269:   # ==========================================================================
270:   consolidate-packages:
271:     name: Consolidate all packages
272:     needs: [build-deb, build-rpm]
273:     runs-on: ubuntu-latest
274:     steps:
275:       - name: Download all artifacts
276:         uses: actions/download-artifact@v4
277:         with:
278:           path: all-packages/
279: 
280:       - name: List all packages
281:         run: |
282:           echo "=== All packages built ==="
283:           find all-packages -name "*.rpm" -o -name "*.deb" | sort
284:           echo ""
285:           echo "=== Package counts ==="
286:           echo "DEB: $(find all-packages -name '*.deb' | wc -l)"
287:           echo "RPM: $(find all-packages -name '*.rpm' | wc -l)"
288: 
289:       - name: Generate package summary
290:         run: |
291:           echo "## Built Packages" >> $GITHUB_STEP_SUMMARY
292:           echo "" >> $GITHUB_STEP_SUMMARY
293:           echo "### RPM Packages (EL + Fedora)" >> $GITHUB_STEP_SUMMARY
294:           echo "| Distro | Package |" >> $GITHUB_STEP_SUMMARY
295:           echo "|--------|---------|" >> $GITHUB_STEP_SUMMARY
296:           for rpm in $(find all-packages -name "*.rpm" | sort); do
297:             name=$(basename "$rpm")
298:             echo "| $(dirname "$rpm" | xargs basename) | $name |" >> $GITHUB_STEP_SUMMARY
299:           done
300:           echo "" >> $GITHUB_STEP_SUMMARY
301:           echo "### DEB Packages (Ubuntu + Debian)" >> $GITHUB_STEP_SUMMARY
302:           echo "| Distro | Package |" >> $GITHUB_STEP_SUMMARY
303:           echo "|--------|---------|" >> $GITHUB_STEP_SUMMARY
304:           for deb in $(find all-packages -name "*.deb" | sort); do
305:             name=$(basename "$deb")
306:             echo "| $(dirname "$deb" | xargs basename) | $name |" >> $GITHUB_STEP_SUMMARY
307:           done
308: 
309:   # ==========================================================================
310:   # UPLOAD TO GITHUB RELEASE
311:   # ==========================================================================
312:   upload-release:
313:     name: Upload packages to GitHub Release
314:     needs: [build-deb, build-rpm]
315:     runs-on: ubuntu-latest
316:     if: github.event_name == 'push' && github.ref == 'refs/heads/main'
317:     permissions:
318:       contents: write
319:     steps:
320:       - name: Checkout code
321:         uses: actions/checkout@v4
322: 
323:       - name: Get version from VERSION file
324:         id: version
325:         run: echo "version=$(cat VERSION)" >> $GITHUB_OUTPUT
326: 
327:       - name: Download all package artifacts
328:         uses: actions/download-artifact@v4
329:         with:
330:           path: release-packages/
331: 
332:       - name: Organize packages for release
333:         run: |
334:           mkdir -p release/
335:           # Copy RPM packages
336:           find release-packages -name "*.rpm" -exec cp {} release/ \;
337:           # Copy DEB packages
338:           find release-packages -name "*.deb" -exec cp {} release/ \;
339:           echo "=== Packages for release ==="
340:           ls -lh release/
341: 
342:       - name: Upload to GitHub Release
343:         uses: softprops/action-gh-release@v2
344:         with:
345:           tag_name: v${{ steps.version.outputs.version }}
346:           name: NFTBan v${{ steps.version.outputs.version }}
347:           body: |
348:             ## NFTBan v${{ steps.version.outputs.version }}
349: 
350:             **Installation packages for multiple distributions**
351: 
352:             ### 📦 RPM Packages (RHEL/Rocky/Alma/Fedora)
353:             - `nftban-el9-x86_64.rpm` - RHEL/Rocky/Alma 9
354:             - `nftban-el10-x86_64.rpm` - RHEL/Rocky/Alma 10
355:             - `nftban-fc42-x86_64.rpm` - Fedora 42
356:             - `nftban-fc43-x86_64.rpm` - Fedora 43
357: 
358:             ### 📦 DEB Packages (Ubuntu/Debian)
359:             - `nftban-ubuntu22.04-amd64.deb` - Ubuntu 22.04 LTS
360:             - `nftban-ubuntu24.04-amd64.deb` - Ubuntu 24.04 LTS
361:             - `nftban-debian12-amd64.deb` - Debian 12
362: 
363:             ### ✨ Features
364:             - **Prerequisite checks** - Validates system before installation
365:             - **GeoIP database** - Automatically downloads MaxMind GeoLite2-City (FREE)
366:             - **Auto-updates** - Weekly GeoIP and threat feed updates via systemd timers
367:             - **No manual config** - Works out of the box

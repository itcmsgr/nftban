{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.1.0",
  "description": "NFTBan GOTH GUI Component Registry",
  "last_updated": "2026-01-15",

  "build": {
    "prerequisites": {
      "templ": {
        "version": ">=0.3.977",
        "install": "go install github.com/a-h/templ/cmd/templ@latest",
        "verify": "templ version"
      },
      "go": {
        "version": ">=1.23.0",
        "verify": "go version"
      }
    },
    "commands": {
      "generate": "templ generate",
      "build": "go build -o bin/nftban-ui ./cmd/nftban-ui/",
      "dev": "templ generate --watch"
    }
  },

  "packages": {
    "ui": {
      "path": "internal/ui",
      "description": "Root UI package with layout and types",
      "files": {
        "layout.templ": {
          "type": "templ",
          "generates": "layout_templ.go",
          "exports": ["Layout", "LayoutWithNav", "Navbar"],
          "description": "Base HTML layout with dark theme"
        },
        "types.go": {
          "type": "go",
          "exports": ["SummaryData", "NavItem", "UserInfo"],
          "description": "Shared data types for templates"
        }
      }
    },
    "pages": {
      "path": "internal/ui/pages",
      "description": "Full page templates",
      "files": {
        "login.templ": {
          "type": "templ",
          "generates": "login_templ.go",
          "exports": ["Login"],
          "route": "/ui/login",
          "auth_required": false,
          "description": "PAM authentication login page"
        },
        "dashboard.templ": {
          "type": "templ",
          "generates": "dashboard_templ.go",
          "exports": ["Dashboard"],
          "route": "/ui/",
          "auth_required": true,
          "description": "Main dashboard with summary cards"
        }
      }
    },
    "components": {
      "path": "internal/ui/components",
      "description": "Reusable UI components",
      "files": {}
    }
  },

  "routes": {
    "pages": [
      {
        "method": "GET",
        "path": "/ui/login",
        "handler": "HandleLogin",
        "template": "pages.Login",
        "auth_required": false,
        "description": "Login page"
      },
      {
        "method": "GET",
        "path": "/ui/",
        "handler": "HandleDashboard",
        "template": "pages.Dashboard",
        "auth_required": true,
        "description": "Dashboard page"
      }
    ],
    "fragments": [],
    "actions": [
      {
        "method": "POST",
        "path": "/ui/action/login",
        "handler": "HandleActionLogin",
        "auth_required": false,
        "redirect_success": "/ui/",
        "redirect_error": "/ui/login?error=",
        "description": "Process login form"
      },
      {
        "method": "POST",
        "path": "/ui/action/logout",
        "handler": "HandleActionLogout",
        "auth_required": true,
        "redirect": "/ui/login",
        "description": "Process logout"
      }
    ]
  },

  "handlers": {
    "file": "cmd/nftban-ui/handlers/goth.go",
    "struct": "GOTHHandlers",
    "dependencies": {
      "auth": "pkg/auth.PAMAuth",
      "session": "pkg/session.Store"
    },
    "methods": [
      "HandleLogin",
      "HandleDashboard",
      "HandleFragSummary",
      "HandleActionLogin",
      "HandleActionLogout",
      "RequireSession"
    ]
  },

  "styles": {
    "theme": "dark",
    "css_variables": {
      "--bg-primary": "#0b0f14",
      "--bg-secondary": "#0f1520",
      "--bg-card": "#141b27",
      "--border-color": "#233043",
      "--text-primary": "#e6edf3",
      "--text-muted": "#a8b3c3",
      "--accent-blue": "#58a6ff",
      "--accent-green": "#3fb950",
      "--accent-red": "#f85149",
      "--accent-yellow": "#d29922"
    },
    "responsive_breakpoint": "768px"
  },

  "validation": {
    "checks": [
      {
        "id": "GUI-001",
        "name": "templ_files_exist",
        "description": "All .templ files exist",
        "severity": "error"
      },
      {
        "id": "GUI-002",
        "name": "generated_files_exist",
        "description": "All _templ.go files are generated",
        "severity": "error"
      },
      {
        "id": "GUI-003",
        "name": "routes_registered",
        "description": "All routes are registered in main.go",
        "severity": "error"
      },
      {
        "id": "GUI-004",
        "name": "handlers_implemented",
        "description": "All handlers are implemented",
        "severity": "error"
      },
      {
        "id": "GUI-005",
        "name": "exports_match",
        "description": "Template exports match registry",
        "severity": "warning"
      },
      {
        "id": "GUI-006",
        "name": "htmx_attributes",
        "description": "HTMX attributes are correct",
        "severity": "warning"
      }
    ]
  },

  "phases": {
    "v1.1.0": {
      "status": "complete",
      "pages": ["login", "dashboard"],
      "fragments": ["summary"],
      "features": ["PAM auth", "session management", "HTMX refresh"]
    },
    "v1.2.0": {
      "status": "pending",
      "pages": ["bans"],
      "fragments": ["bans_table", "ban_form"],
      "features": ["ban/unban", "search", "pagination"]
    },
    "v1.3.0": {
      "status": "pending",
      "pages": ["events", "whitelist"],
      "fragments": ["events_list", "whitelist_table"],
      "features": ["event viewer", "whitelist management"]
    },
    "v1.4.0": {
      "status": "pending",
      "pages": ["modules", "ports"],
      "fragments": ["modules_status", "ports_table"],
      "features": ["module control", "port management"]
    },
    "v1.5.0": {
      "status": "pending",
      "pages": ["settings"],
      "fragments": ["panel_status"],
      "features": ["panel integration", "settings editor"]
    },
    "v1.6.0": {
      "status": "pending",
      "pages": [],
      "fragments": [],
      "features": ["cleanup legacy GUI", "advanced features"]
    }
  }
}

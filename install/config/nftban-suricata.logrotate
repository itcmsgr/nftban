# NFTBan Suricata Log Rotation Configuration
# Install to: /etc/logrotate.d/nftban-suricata
#
# IMPORTANT: This file is only installed when Suricata is configured.
# It requires the 'suricata' user to exist.
# Installed by: nftban suricata setup / packaging %post
#
# If Suricata is not installed, this file should NOT be present.
# Remove with: rm /etc/logrotate.d/nftban-suricata
#
# Gate B (disk-safety), v1.222.0 R1:
# - ALL Suricata eve/fast/stats logs use copytruncate. Suricata holds these fds
#   open for its process lifetime and has no logrotate-driven log-reopen wired
#   here. USR2 is a live RULE reload, NOT a log reopen, so a rename+create+USR2
#   form would strand Suricata on the rotated-away inode (empty new file, silent
#   telemetry loss). copytruncate truncates in place — the daemon keeps writing
#   the live file with no reopen needed. Switching eve to rename+create + a
#   PROVEN log-reopen signal (e.g. SIGHUP on supported Suricata versions), with a
#   behavioral rotate-then-write test, is a deliberate future lane — not shipped
#   speculatively here.
# - Every stanza carries a `size` bound (no unbounded stanza); no `delaycompress`
#   (copytruncate snapshots compress immediately).

# Suricata eve-alerts.json (daemon path) - low volume, alert-only
# Ownership: suricata:nftban (Suricata writes, nftban reads)
# copytruncate (v1.222.0 R1): Suricata holds the eve fd open for its lifetime.
# The prior rename+create+USR2 form was a REGRESSION — USR2 triggers a live RULE
# reload, NOT a log-file reopen, so Suricata would keep writing the rotated-away
# inode and the freshly-created eve file would stay empty (silent alert loss).
# copytruncate truncates in place so the daemon keeps writing the live file with
# no reopen needed. A future lane may switch to rename+create + a PROVEN
# log-reopen signal (SIGHUP on supported versions) with a behavioral rotate test.
/var/log/nftban/suricata/eve-alerts.json {
    su suricata nftban
    daily
    rotate 7
    size 50M
    compress
    missingok
    notifempty
    create 0640 suricata nftban
    copytruncate
}

# Suricata eve-audit.json (optional, higher volume when enabled)
# copytruncate (v1.222.0 R1): same held-fd constraint as eve-alerts.
/var/log/nftban/suricata/eve-audit.json {
    su suricata nftban
    daily
    rotate 3
    size 100M
    compress
    missingok
    notifempty
    create 0640 suricata nftban
    copytruncate
}

# Suricata eve-stats.json (optional, for capacity planning)
# copytruncate retained (no USR2 reopen wired); size-bounded.
/var/log/nftban/suricata/eve-stats.json {
    su suricata nftban
    weekly
    rotate 2
    size 50M
    compress
    missingok
    notifempty
    create 0640 suricata nftban
    copytruncate
}

# Fast.log for Suricata
/var/log/nftban/suricata/fast.log {
    su suricata nftban
    weekly
    rotate 4
    size 50M
    compress
    missingok
    notifempty
    create 0640 suricata nftban
    copytruncate
}

# Stats.log for Suricata
/var/log/nftban/suricata/stats.log {
    su suricata nftban
    weekly
    rotate 4
    size 20M
    compress
    missingok
    notifempty
    create 0640 suricata nftban
    copytruncate
}

[Unit]
Description=NFTBan Suricata Rules Update
Documentation=man:nftban(8) https://nftban.com/docs
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot

# SECURITY NOTE: Runs as root for system update function
# This is similar to apt-get update - requires privilege to:
#   1. Write to /etc/suricata/rules/ (suricata-update)
#   2. Restart suricata.service (systemctl restart)
# Not in audit scope (not stats/parser/exporter)
# Bug fix v1.9.4: Removed Group=suricata (may not exist on all systems)
User=root
Group=root

# Update rules using unified pipeline (profile-aware, module-aware, dedupe)
# This replaces bare suricata-update with nftban wrapper that:
#   1. Ensures profile selected (auto-detect if missing)
#   2. Generates module overlap disables
#   3. Applies profile-specific rule filtering
#   4. Dedupes restart if rules unchanged
ExecStart=/usr/sbin/nftban suricata rules update

# =============================================================================
# SECURITY HARDENING
# =============================================================================

# Core hardening
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true

# Filesystem - needs write access for suricata rules
ReadWritePaths=/etc/suricata/rules /var/lib/suricata

# Network required for downloads
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Resource limits
CPUQuota=50%
MemoryMax=512M
TasksMax=50

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nftban-suricata-update

# Timeouts (10 minutes for downloads)
TimeoutStartSec=600
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target

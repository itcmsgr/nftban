# nftban-managed: yes
# nftban-templates-version: 1

[nftban-nginx]
enabled   = @@NFTBAN_F2B_NGINX_JAIL@@
filter    = nginx-http-auth
backend   = auto
port      = http,https
logpath   = @@NFTBAN_F2B_NGINX_LOG@@
maxretry  = @@NFTBAN_F2B_NGINX_MAX_RETRY@@
findtime  = @@NFTBAN_F2B_NGINX_FIND_TIME@@
bantime   = @@NFTBAN_F2B_NGINX_BAN_TIME@@

261:     case "$subcommand" in
262:         recent|tail)
263:             local count="${1:-30}"
264:             echo "Recent Trace Entries (last $count)"
265:             echo "════════════════════════════════════════════════════════════════"
266:             local trace_log="${NFTBAN_DEBUG_TRACE_LOG:-${NFTBAN_LOG_DIR:-/var/log/nftban}/debug_trace.log}"
267:             if [[ -f "$trace_log" ]]; then
268:                 tail -n "$count" "$trace_log"
269:             else
270:                 echo "(no trace log file)"
271:             fi
272:             ;;
273: 
274:         orphans|stuck)
275:             local minutes="${1:-5}"
276:             echo "Checking for Orphaned Traces (older than ${minutes}m)"
277:             echo "════════════════════════════════════════════════════════════════"
278:             echo ""
279:             if type nftban_trace_find_orphans &>/dev/null; then
280:                 nftban_trace_find_orphans "$minutes"
281:             else
282:                 echo "ERROR: Trace library not loaded" >&2
283:                 return 1
284:             fi
285:             ;;
286: 
287:         stats)
288:             echo "Trace Statistics"
289:             echo "════════════════════════════════════════════════════════════════"
290:             if type nftban_trace_stats &>/dev/null; then
291:                 nftban_trace_stats
292:             else
293:                 # Manual stats
294:                 local trace_log="${NFTBAN_DEBUG_TRACE_LOG:-${NFTBAN_LOG_DIR:-/var/log/nftban}/debug_trace.log}"
295:                 if [[ -f "$trace_log" ]]; then
296:                     echo "START entries: $(grep -c '\[START\]' "$trace_log" 2>/dev/null || echo 0)"
297:                     echo "END entries:   $(grep -c '\[END\]' "$trace_log" 2>/dev/null || echo 0)"
298:                     echo "ERROR entries: $(grep -c '\[ERROR\]' "$trace_log" 2>/dev/null || echo 0)"
299:                     echo "Log size:      $(du -h "$trace_log" | cut -f1)"
300:                 else
301:                     echo "(no trace log)"
302:                 fi
303:             fi
304:             ;;
305: 
306:         clear|rotate)
307:             local days="${1:-7}"
308:             echo "Rotating trace log (keeping ${days} days)..."
309:             if type nftban_trace_rotate &>/dev/null; then
310:                 nftban_trace_rotate "$days"
311:             else
312:                 local trace_log="${NFTBAN_DEBUG_TRACE_LOG:-${NFTBAN_LOG_DIR:-/var/log/nftban}/debug_trace.log}"
313:                 if [[ -f "$trace_log" ]]; then
314:                     mv "$trace_log" "${trace_log}.old"
315:                     touch "$trace_log"
316:                     echo "✅ Trace log rotated"
317:                 fi
318:             fi
319:             ;;
320: 
321:         *)
322:             echo "Unknown trace command: $subcommand"
323:             echo "Options: recent [N], orphans [minutes], stats, clear [days]"
324:             return 1
325:             ;;
326:     esac
327: }

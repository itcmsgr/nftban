1483:         # Check if NFTBAN completion file is installed
1484:         local nftban_completion="/usr/share/bash-completion/completions/nftban"
1485:         if [[ ! -f "$nftban_completion" ]]; then
1486:             # Try to auto-install if auto-heal enabled
1487:             if [[ "${NFTBAN_HEALTH_AUTO_HEAL:-false}" == "true" ]]; then
1488:                 # Try to find source file

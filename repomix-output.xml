<file path="cli/lib/nftban/setup/provision_grafana_dashboards.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - Grafana Dashboard Provisioning Script
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Automatically provision NFTBan dashboards to Grafana
  7: # Location: /usr/lib/nftban/setup/provision_grafana_dashboards.sh
  8: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
  9: # meta:homepage=https://nftban.com
 10: #
 11: # meta:name=provision_grafana_dashboards
 12: # meta:type=setup
 13: # meta:header=Grafana Dashboard Provisioning
 14: # meta:version=1.0.0
 15: #
 16: # meta:created_date=2025-11-17
 17: # =============================================================================
 18: 
 19: set -Eeuo pipefail
 20: IFS=$'\n\t'
 21: 
 22: # Colors
 23: readonly RED='\033[0;31m'
 24: readonly GREEN='\033[0;32m'
 25: readonly YELLOW='\033[1;33m'
 26: readonly BLUE='\033[0;34m'
 27: readonly NC='\033[0m'
 28: 
 29: # Configuration
 30: readonly GRAFANA_PROVISIONING_DIR="/etc/grafana/provisioning/dashboards"
 31: readonly GRAFANA_DASHBOARDS_DIR="/var/lib/grafana/dashboards/nftban"
 32: readonly NFTBAN_DASHBOARDS_SOURCE="/usr/share/nftban/grafana/dashboards"
 33: readonly GRAFANA_USER="${GRAFANA_USER:-grafana}"
 34: readonly GRAFANA_GROUP="${GRAFANA_GROUP:-grafana}"
 35: 
 36: print_status() {
 37:     echo -e "${GREEN}[✓]${NC} $1"
 38: }
 39: 
 40: print_error() {
 41:     echo -e "${RED}[✗]${NC} $1" >&2
 42: }
 43: 
 44: print_warn() {
 45:     echo -e "${YELLOW}[!]${NC} $1"
 46: }
 47: 
 48: print_info() {
 49:     echo -e "${BLUE}[i]${NC} $1"
 50: }
 51: 
 52: check_root() {
 53:     if [[ $EUID -ne 0 ]]; then
 54:         print_error "This script must be run as root"
 55:         exit 1
 56:     fi
 57: }
 58: 
 59: check_grafana_installed() {
 60:     if ! command -v grafana-server >/dev/null 2>&1 && ! systemctl list-unit-files | grep -q "grafana-server"; then
 61:         print_error "Grafana is not installed"
 62:         print_info "Install Grafana first:"
 63:         print_info "  Fedora/RHEL: dnf install grafana"
 64:         print_info "  Debian/Ubuntu: apt install grafana"
 65:         print_info "  Or visit: https://grafana.com/grafana/download"
 66:         exit 1
 67:     fi
 68:     print_status "Grafana is installed"
 69: }
 70: 
 71: check_dashboards_exist() {
 72:     if [[ ! -d "$NFTBAN_DASHBOARDS_SOURCE" ]]; then
 73:         print_error "NFTBan dashboard files not found at: $NFTBAN_DASHBOARDS_SOURCE"
 74:         print_info "Install NFTBan package first or ensure dashboards are copied to:"
 75:         print_info "  $NFTBAN_DASHBOARDS_SOURCE"
 76:         exit 1
 77:     fi
 78: 
 79:     local dashboard_count
 80:     dashboard_count=$(find "$NFTBAN_DASHBOARDS_SOURCE" -name "nftban_*.json" | wc -l)
 81: 
 82:     if [[ $dashboard_count -eq 0 ]]; then
 83:         print_error "No NFTBan dashboard JSON files found"
 84:         exit 1
 85:     fi
 86: 
 87:     print_status "Found $dashboard_count NFTBan dashboard(s)"
 88: }
 89: 
 90: create_provisioning_config() {
 91:     print_info "Creating Grafana provisioning configuration..."
 92: 
 93:     # Create provisioning directory if it doesn't exist
 94:     mkdir -p "$GRAFANA_PROVISIONING_DIR"
 95: 
 96:     # Create NFTBan dashboard provider configuration
 97:     cat > "$GRAFANA_PROVISIONING_DIR/nftban.yaml" <<'EOF'
 98: apiVersion: 1
 99: 
100: providers:
101:   - name: 'NFTBan'
102:     orgId: 1
103:     folder: 'NFTBan'
104:     type: file
105:     disableDeletion: false
106:     updateIntervalSeconds: 10
107:     allowUiUpdates: true
108:     options:
109:       path: /var/lib/grafana/dashboards/nftban
110: EOF
111: 
112:     if [[ -f "$GRAFANA_PROVISIONING_DIR/nftban.yaml" ]]; then
113:         print_status "Created provisioning configuration: $GRAFANA_PROVISIONING_DIR/nftban.yaml"
114:     else
115:         print_error "Failed to create provisioning configuration"
116:         exit 1
117:     fi
118: }
119: 
120: copy_dashboards() {
121:     print_info "Copying NFTBan dashboards to Grafana..."
122: 
123:     # Create dashboard directory
124:     mkdir -p "$GRAFANA_DASHBOARDS_DIR"
125: 
126:     # Copy all NFTBan dashboard JSON files
127:     local copied=0
128:     for dashboard in "$NFTBAN_DASHBOARDS_SOURCE"/nftban_*.json; do
129:         if [[ -f "$dashboard" ]]; then
130:             cp "$dashboard" "$GRAFANA_DASHBOARDS_DIR/"
131:             local dashboard_name
132:             dashboard_name=$(basename "$dashboard")
133:             print_status "Copied: $dashboard_name"
134:             ((copied++))
135:         fi
136:     done
137: 
138:     if [[ $copied -eq 0 ]]; then
139:         print_error "No dashboards were copied"
140:         exit 1
141:     fi
142: 
143:     print_status "Copied $copied dashboard(s) to $GRAFANA_DASHBOARDS_DIR"
144: }
145: 
146: set_permissions() {
147:     print_info "Setting permissions..."
148: 
149:     # Check if grafana user exists
150:     if ! id "$GRAFANA_USER" &>/dev/null; then
151:         print_warn "Grafana user '$GRAFANA_USER' not found, using root ownership"
152:         chown -R root:root "$GRAFANA_DASHBOARDS_DIR"
153:     else
154:         chown -R "$GRAFANA_USER:$GRAFANA_GROUP" "$GRAFANA_DASHBOARDS_DIR"
155:         print_status "Set ownership to $GRAFANA_USER:$GRAFANA_GROUP"
156:     fi
157: 
158:     chmod 755 "$GRAFANA_DASHBOARDS_DIR"
159:     chmod 644 "$GRAFANA_DASHBOARDS_DIR"/*.json
160: 
161:     print_status "Set permissions (755 for directory, 644 for JSON files)"
162: }
163: 
164: restart_grafana() {
165:     print_info "Restarting Grafana to load dashboards..."
166: 
167:     if systemctl is-active --quiet grafana-server; then
168:         if systemctl restart grafana-server; then
169:             print_status "Grafana restarted successfully"
170:             sleep 3  # Give Grafana time to start
171:         else
172:             print_error "Failed to restart Grafana"
173:             print_info "Check status: systemctl status grafana-server"
174:             exit 1
175:         fi
176:     else
177:         print_warn "Grafana is not running, attempting to start..."
178:         if systemctl start grafana-server; then
179:             print_status "Grafana started successfully"
180:             sleep 3
181:         else
182:             print_error "Failed to start Grafana"
183:             exit 1
184:         fi
185:     fi
186: }
187: 
188: verify_provisioning() {
189:     print_info "Verifying dashboard provisioning..."
190: 
191:     # Wait for Grafana to fully start
192:     local retries=10
193:     local count=0
194: 
195:     while [[ $count -lt $retries ]]; do
196:         if curl -s -o /dev/null -w "%{http_code}" http://localhost:3000/api/health 2>/dev/null | grep -q "200"; then
197:             print_status "Grafana is responding"
198:             break
199:         fi
200:         ((count++))
201:         sleep 1
202:     done
203: 
204:     if [[ $count -eq $retries ]]; then
205:         print_warn "Could not verify Grafana health endpoint (may still be starting)"
206:     fi
207: 
208:     # Check if dashboards directory is accessible
209:     if [[ -d "$GRAFANA_DASHBOARDS_DIR" ]]; then
210:         local dashboard_count
211:         dashboard_count=$(find "$GRAFANA_DASHBOARDS_DIR" -name "nftban_*.json" | wc -l)
212:         print_info "Dashboards in place: $dashboard_count"
213:     fi
214: }
215: 
216: print_next_steps() {
217:     echo ""
218:     echo -e "${GREEN}═══════════════════════════════════════════════════════════${NC}"
219:     echo -e "${GREEN}  NFTBan Dashboards Provisioned Successfully!${NC}"
220:     echo -e "${GREEN}═══════════════════════════════════════════════════════════${NC}"
221:     echo ""
222:     echo "Next steps:"
223:     echo ""
224:     echo "1. Access Grafana:"
225:     echo "   http://localhost:3000"
226:     echo "   Default credentials: admin / admin"
227:     echo ""
228:     echo "2. Configure Prometheus datasource if not already done:"
229:     echo "   - Go to: Configuration → Data Sources → Add data source"
230:     echo "   - Select: Prometheus"
231:     echo "   - URL: http://localhost:9090"
232:     echo "   - Click: Save & Test"
233:     echo ""
234:     echo "3. Access NFTBan dashboards:"
235:     echo "   - Go to: Dashboards → Browse"
236:     echo "   - Look for: NFTBan folder"
237:     echo "   - Available dashboards:"
238:     echo "     • NFTBan Overview"
239:     echo "     • NFTBan System Health"
240:     echo "     • NFTBan Geographic Analysis"
241:     echo "     • NFTBan Performance"
242:     echo ""
243:     echo "4. Verify metrics are flowing:"
244:     echo "   - Check if panels show data"
245:     echo "   - If not, verify:"
246:     echo "     • Prometheus is running: systemctl status prometheus"
247:     echo "     • Node Exporter is running: systemctl status node_exporter"
248:     echo "     • Metrics exporter is running: systemctl status nftban-metrics-exporter"
249:     echo ""
250:     echo "Configuration files:"
251:     echo "  Provisioning: $GRAFANA_PROVISIONING_DIR/nftban.yaml"
252:     echo "  Dashboards: $GRAFANA_DASHBOARDS_DIR/"
253:     echo ""
254: }
255: 
256: main() {
257:     echo ""
258:     echo -e "${BLUE}╔═══════════════════════════════════════════════════════════╗${NC}"
259:     echo -e "${BLUE}║  NFTBan v1.0.0 - Grafana Dashboard Provisioning          ║${NC}"
260:     echo -e "${BLUE}╚═══════════════════════════════════════════════════════════╝${NC}"
261:     echo ""
262: 
263:     check_root
264:     check_grafana_installed
265:     check_dashboards_exist
266:     create_provisioning_config
267:     copy_dashboards
268:     set_permissions
269:     restart_grafana
270:     verify_provisioning
271:     print_next_steps
272: }
273: 
274: main "$@"
</file>

<file path="cli/lib/nftban/setup/setup_suricata_rules.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0 - Suricata Rules Initial Setup
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Initial Suricata rules download and configuration
  7: # Location: /usr/lib/nftban/setup/setup_suricata_rules.sh
  8: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
  9: # meta:homepage=https://nftban.com
 10: #
 11: # meta:name=setup_suricata_rules
 12: # meta:type=setup
 13: # meta:header=Suricata Rules Setup
 14: # meta:version=1.0.0
 15: #
 16: # meta:created_date=2025-11-29
 17: # =============================================================================
 18: 
 19: set -Eeuo pipefail
 20: IFS=$'\n\t'
 21: 
 22: # Colors
 23: readonly RED='\033[0;31m'
 24: readonly GREEN='\033[0;32m'
 25: readonly YELLOW='\033[1;33m'
 26: readonly BLUE='\033[0;34m'
 27: readonly NC='\033[0m'
 28: 
 29: print_status() {
 30:     echo -e "${GREEN}[✓]${NC} $1" >&2
 31: }
 32: 
 33: print_error() {
 34:     echo -e "${RED}[✗]${NC} $1" >&2
 35: }
 36: 
 37: print_info() {
 38:     echo -e "${BLUE}[i]${NC} $1" >&2
 39: }
 40: 
 41: print_warning() {
 42:     echo -e "${YELLOW}[!]${NC} $1" >&2
 43: }
 44: 
 45: main() {
 46:     print_info "NFTBan Suricata Rules Setup"
 47:     echo ""
 48: 
 49:     # Check if running as root
 50:     if [[ $EUID -ne 0 ]]; then
 51:         print_error "This script must be run as root"
 52:         exit 1
 53:     fi
 54: 
 55:     # Check if suricata-update is installed
 56:     if ! command -v suricata-update >/dev/null 2>&1; then
 57:         print_error "suricata-update not found"
 58:         print_info "Install: pip3 install --upgrade suricata-update"
 59:         exit 1
 60:     fi
 61: 
 62:     # Check if Suricata is installed
 63:     if ! command -v suricata >/dev/null 2>&1; then
 64:         print_error "Suricata not found"
 65:         print_info "Install Suricata first"
 66:         exit 1
 67:     fi
 68: 
 69:     print_info "Suricata version: $(suricata --version | head -1)"
 70:     print_info "suricata-update version: $(suricata-update --version 2>&1 | grep -oP 'version \K[0-9.]+' || echo 'unknown')"
 71:     echo ""
 72: 
 73:     # Step 1: Update source index
 74:     print_info "Updating rule source index..."
 75:     if suricata-update update-sources 2>&1 | grep -q "Source index updated"; then
 76:         print_status "Source index updated"
 77:     else
 78:         print_warning "Source index may already be current"
 79:     fi
 80:     echo ""
 81: 
 82:     # Step 2: List available sources
 83:     print_info "Available rule sources:"
 84:     suricata-update list-sources 2>&1 | grep -E "^Name:|Summary:" | head -10
 85:     echo ""
 86: 
 87:     # Step 3: Enable ET Open (free ruleset)
 88:     print_info "Enabling ET/Open ruleset (free)..."
 89:     if suricata-update enable-source et/open 2>&1; then
 90:         print_status "ET/Open ruleset enabled"
 91:     else
 92:         print_warning "ET/Open may already be enabled"
 93:     fi
 94:     echo ""
 95: 
 96:     # Step 4: Download and install rules
 97:     print_info "Downloading Suricata rules (this may take a few minutes)..."
 98:     if suricata-update 2>&1 | tee /tmp/suricata-update.log | grep -q "Writing rules"; then
 99:         print_status "Rules downloaded and installed"
100: 
101:         # Show rule count
102:         local rule_count
103:         rule_count=$(find /var/lib/suricata/rules -name "*.rules" -exec cat {} \; 2>/dev/null | grep -c "^alert" || echo "0")
104:         print_info "Total alert rules: $rule_count"
105:     else
106:         print_error "Rule download failed"
107:         cat /tmp/suricata-update.log >&2
108:         exit 1
109:     fi
110:     echo ""
111: 
112:     # Step 5: Restart Suricata to load new rules
113:     print_info "Restarting Suricata to load rules..."
114:     if systemctl is-active --quiet suricata.service; then
115:         systemctl restart suricata.service
116:         sleep 2
117: 
118:         if systemctl is-active --quiet suricata.service; then
119:             print_status "Suricata restarted successfully"
120:         else
121:             print_error "Suricata failed to restart"
122:             systemctl status suricata.service --no-pager -l
123:             exit 1
124:         fi
125:     else
126:         print_warning "Suricata not running, starting it..."
127:         systemctl start suricata.service
128:         sleep 2
129: 
130:         if systemctl is-active --quiet suricata.service; then
131:             print_status "Suricata started successfully"
132:         else
133:             print_error "Suricata failed to start"
134:             systemctl status suricata.service --no-pager -l
135:             exit 1
136:         fi
137:     fi
138:     echo ""
139: 
140:     # Summary
141:     print_status "Suricata rules setup complete!"
142:     echo ""
143:     print_info "Rule Details:"
144:     echo "  Rules directory: /var/lib/suricata/rules/"
145:     echo "  Enabled sources: et/open"
146:     echo "  Update schedule: Weekly (Sunday 3 AM)"
147:     echo ""
148:     print_info "Manual update command:"
149:     echo "  suricata-update && systemctl restart suricata"
150:     echo ""
151:     print_info "Check eve.json for alerts:"
152:     echo "  tail -f /var/log/suricata/eve.json | jq 'select(.event_type==\"alert\")'"
153:     echo ""
154: }
155: 
156: main "$@"
</file>

<file path="cli/sbin/nftban-apply">
  1: #!/usr/bin/env bash
  2: # NFTBan Emergency Recovery - Apply Rules (Commit-Confirm)
  3: # Copyright (c) 2024–2026 NFTBAN Project / Antonios Voulvoulis
  4: # SPDX-License-Identifier: MPL-2.0
  5: #
  6: # This script applies nftables rules with automatic rollback protection.
  7: # Rules must be confirmed within the grace period or they will auto-rollback.
  8: 
  9: set -Eeuo pipefail
 10: 
 11: # Paths
 12: CANDIDATE="/etc/nftban/compiled.nft"
 13: BACKUP="/var/lib/nftban/backup.rules"
 14: ROLLBACK_FLAG="/run/nftban.rollback.deadline"
 15: CONFIG="/etc/default/nftban"
 16: 
 17: # Load configuration
 18: if [[ -f "$CONFIG" ]]; then
 19:     source "$CONFIG"
 20: fi
 21: 
 22: # Default values
 23: GRACE="${NFTBAN_REBOOT_GRACE_PERIOD:-300}"
 24: SSH_TEST="${NFTBAN_SSH_TEST_BEFORE_APPLY:-true}"
 25: SSH_PORT="${NFTBAN_SSH_TEST_PORT:-22}"
 26: 
 27: # Banner
 28: echo "╔════════════════════════════════════════════════════════════╗"
 29: echo "║  NFTBan Emergency Recovery - Apply Rules (Commit-Confirm) ║"
 30: echo "╚════════════════════════════════════════════════════════════╝"
 31: echo ""
 32: 
 33: # 0) Check if candidate ruleset exists
 34: if [[ ! -s "$CANDIDATE" ]]; then
 35:     echo "ERROR: No candidate ruleset found at $CANDIDATE"
 36:     echo "Generate rules first with: nftban compile"
 37:     exit 1
 38: fi
 39: 
 40: echo "[1/6] Validating candidate ruleset..."
 41: # 1) Dry-run validate candidate
 42: if ! nft -c -f "$CANDIDATE" 2>/dev/null; then
 43:     echo "ERROR: Candidate ruleset validation failed!"
 44:     echo "Check syntax with: nft -c -f $CANDIDATE"
 45:     exit 1
 46: fi
 47: echo "  ✓ Candidate ruleset is valid"
 48: echo ""
 49: 
 50: echo "[2/6] Backing up current ruleset..."
 51: # 2) Save current ruleset as last-known-good (atomic)
 52: umask 077
 53: mkdir -p "$(dirname "$BACKUP")"
 54: 
 55: if ! nft list ruleset > "${BACKUP}.tmp" 2>/dev/null; then
 56:     echo "WARNING: Could not backup current ruleset (nftables may not be running)"
 57:     echo "Creating empty backup..."
 58:     touch "${BACKUP}.tmp"
 59: fi
 60: 
 61: mv "${BACKUP}.tmp" "$BACKUP"
 62: echo "  ✓ Current ruleset backed up to $BACKUP"
 63: echo ""
 64: 
 65: echo "[3/6] Applying candidate ruleset..."
 66: # 3) Apply candidate atomically
 67: if ! nft -f "$CANDIDATE"; then
 68:     echo "ERROR: Failed to apply candidate ruleset!"
 69:     echo "Attempting rollback to backup..."
 70:     if [[ -s "$BACKUP" ]]; then
 71:         nft -f "$BACKUP" || true
 72:     fi
 73:     exit 2
 74: fi
 75: echo "  ✓ Candidate ruleset applied successfully"
 76: echo ""
 77: 
 78: echo "[4/6] Arming rollback timer (grace period: ${GRACE}s)..."
 79: # 4) Create rollback flag with deadline
 80: date -d "+${GRACE} seconds" +%s > "$ROLLBACK_FLAG" 2>/dev/null || \
 81:     date -v "+${GRACE}S" +%s > "$ROLLBACK_FLAG" 2>/dev/null || \
 82:     echo $(($(date +%s) + GRACE)) > "$ROLLBACK_FLAG"
 83: 
 84: # 5) Start rollback timer (oneshot service will check periodically)
 85: if command -v systemctl &>/dev/null; then
 86:     systemctl start nftban-rollback.timer 2>/dev/null || true
 87: fi
 88: echo "  ✓ Rollback timer armed"
 89: echo ""
 90: 
 91: echo "[5/6] Testing SSH connectivity..."
 92: # 6) Optional local SSH probe before we leave (best-effort)
 93: if [[ "$SSH_TEST" == "true" ]]; then
 94:     if timeout 3 bash -c "cat < /dev/null > /dev/tcp/127.0.0.1/${SSH_PORT}" 2>/dev/null; then
 95:         echo "  ✓ SSH connectivity test passed (port ${SSH_PORT})"
 96:     else
 97:         echo "  ✗ SSH connectivity test FAILED!"
 98:         echo ""
 99:         echo "WARNING: SSH probe failed. Rolling back immediately..."
100:         /usr/sbin/nftban-rollback --force
101:         exit 3
102:     fi
103: else
104:     echo "  ⊘ SSH test disabled (NFTBAN_SSH_TEST_BEFORE_APPLY=false)"
105: fi
106: echo ""
107: 
108: echo "[6/6] Summary"
109: echo "════════════════════════════════════════════════════════════"
110: echo ""
111: echo "✓ Candidate rules applied successfully"
112: echo "✓ Rollback protection active for ${GRACE} seconds"
113: echo ""
114: echo "IMPORTANT: You must confirm within ${GRACE} seconds!"
115: echo ""
116: echo "  To KEEP these rules:"
117: echo "    sudo nftban-confirm"
118: echo ""
119: echo "  To ROLLBACK immediately:"

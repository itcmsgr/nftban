130: # =============================================================================
131: # NFTABLES RULES
132: # =============================================================================
133: 
134: # Create nftables chain for portscan detection
135: nftban_portscan_classic_create_chain() {
136:     local table_ipv4="${PORTSCAN_NFT_TABLE_IPV4:-ip nftban}"
137:     local table_ipv6="${PORTSCAN_NFT_TABLE_IPV6:-ip6 nftban}"
138:     local chain="${PORTSCAN_NFT_CHAIN:-portscan_detection}"
139:     local log_prefix="${PORTSCAN_CLASSIC_LOG_PREFIX}"
140:     local log_rate="${PORTSCAN_CLASSIC_LOG_RATE}"
141:     local log_burst="${PORTSCAN_CLASSIC_LOG_BURST}"
142: 
143:     nftban_log "INFO" "portscan_classic" "Creating portscan detection chain"
144: 
145:     # Create IPv4 chain
146:     nft add chain ${table_ipv4} ${chain} 2>/dev/null || true
147: 
148:     # Create IPv6 chain
149:     nft add chain ${table_ipv6} ${chain} 2>/dev/null || true
150: 
151:     return 0
152: }
153: 
154: # Add logging rules for portscan detection
155: nftban_portscan_classic_add_rules() {
156:     local table_ipv4="${PORTSCAN_NFT_TABLE_IPV4:-ip nftban}"
157:     local table_ipv6="${PORTSCAN_NFT_TABLE_IPV6:-ip6 nftban}"
158:     local chain="${PORTSCAN_NFT_CHAIN:-portscan_detection}"
159:     local log_prefix="${PORTSCAN_CLASSIC_LOG_PREFIX}"
160:     local log_rate="${PORTSCAN_CLASSIC_LOG_RATE}"
161:     local log_burst="${PORTSCAN_CLASSIC_LOG_BURST}"
162: 
163:     nftban_log "INFO" "portscan_classic" "Adding portscan logging rules"
164: 
165:     # Flush existing rules in chain
166:     nft flush chain ${table_ipv4} ${chain} 2>/dev/null || true
167:     nft flush chain ${table_ipv6} ${chain} 2>/dev/null || true
168: 
169:     # IPv4 rules
170:     # Log SYN packets to closed ports (rate limited)
171:     nft add rule ${table_ipv4} ${chain} \
172:         tcp flags syn / syn,ack,fin,rst \
173:         ct state new \
174:         limit rate ${log_rate} burst ${log_burst} packets \
175:         log prefix "\"${log_prefix}SYN \"" level info 2>/dev/null || true
176: 
177:     # Log UDP to uncommon ports
178:     nft add rule ${table_ipv4} ${chain} \
179:         udp dport != { 53, 123, 443 } \
180:         ct state new \
181:         limit rate ${log_rate} burst ${log_burst} packets \
182:         log prefix "\"${log_prefix}UDP \"" level info 2>/dev/null || true
183: 
184:     # IPv6 rules
185:     nft add rule ${table_ipv6} ${chain} \
186:         tcp flags syn / syn,ack,fin,rst \
187:         ct state new \
188:         limit rate ${log_rate} burst ${log_burst} packets \
189:         log prefix "\"${log_prefix}SYN \"" level info 2>/dev/null || true
190: 
191:     nft add rule ${table_ipv6} ${chain} \
192:         udp dport != { 53, 123, 443 } \
193:         ct state new \
194:         limit rate ${log_rate} burst ${log_burst} packets \
195:         log prefix "\"${log_prefix}UDP \"" level info 2>/dev/null || true
196: 
197:     return 0
198: }

 407:             _nftban_login_set_config "NFTBAN_LOGIN_ALERT_CONSOLE" "false" "$config_local"
 408:             echo "✅ Console login monitoring disabled"
 409:             ;;
 410:         all)
 411:             _nftban_login_set_config "NFTBAN_LOGIN_ALERT_ENABLED" "false" "$config_local"
 412:             echo "✅ All login monitoring disabled"

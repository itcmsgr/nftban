# =============================================================================
# NFTBan - Maintenance Timer (Always Active)
# =============================================================================
# SPDX-License-Identifier: MPL-2.0
# meta:name="nftban-maintenance.timer"
# meta:type="systemd"
# meta:owner="Antonios Voulvoulis <contact@nftban.com>"
# meta:description="Timer for critical maintenance tasks (always active)"
# meta:inventory.files=""
# meta:inventory.binaries=""
# meta:inventory.env_vars=""
# meta:inventory.config_files=""
# meta:inventory.systemd_units="nftban-maintenance.service"
# meta:inventory.network=""
# meta:inventory.privileges="root"
#
# Purpose: Run critical maintenance tasks even when NFTBan is disabled
#
# This timer runs INDEPENDENTLY and is ALWAYS enabled.
# It performs critical safety checks to prevent lockouts and system issues.
#
# Runs every 15 minutes to:
#   - Monitor SSH port changes (lockout prevention)
#   - Monitor system IP changes (whitelist updates)
#   - Run autoheal (fix permissions, create directories)
#   - Validate critical configuration
#
# NOTE: This timer is ALWAYS enabled during installation and should NOT
# be disabled unless you are completely removing NFTBan.
# =============================================================================

[Unit]
Description=NFTBan Maintenance Timer (Always Active)
Documentation=https://nftban.com/docs/maintenance
After=network-online.target

[Timer]
# Run every 15 minutes
OnCalendar=*:0/15

# JITTER: 33% variance (5m on 15m interval) prevents thundering herd
# Old: 2m (13% coverage) - insufficient for large fleets
# New: 5m (33% coverage) - meaningful distribution across servers
RandomizedDelaySec=5m

# DETERMINISTIC: Same offset per host for predictable debugging
FixedRandomDelay=true

# Catch up on missed runs after system sleep/shutdown
Persistent=true
# Link to the service unit
Unit=nftban-maintenance.service

[Install]
WantedBy=timers.target

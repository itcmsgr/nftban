                echo "validate"
                echo "static"
                echo "runtime"
                echo "status"
                echo "groups"
                echo "rules"
                echo "test"
                echo "help"
                ;;
            login)
                echo "status"
                echo "install"
                echo "enable"
                echo "disable"
                echo "logs"
                echo "test"
                echo "run"
                echo "help"
                ;;
            enable|disable|restart)
                echo "all"
                echo "nftables"

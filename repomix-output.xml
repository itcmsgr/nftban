 614: nftban_report_schedule_add() {
 615:     # Add scheduled report
 616:     local frequency="$1"
 617:     shift
 618: 
 619:     local time="08:00"
 620:     local day=""
 621:     local email="${STATS_EMAIL_RECIPIENTS:-${NFTBAN_MAIL_RECIPIENT:-}}"
 622: 
 623:     # Parse options
 624:     while [[ $# -gt 0 ]]; do
 625:         case "$1" in
 626:             --time)
 627:                 time="$2"
 628:                 shift 2
 629:                 ;;
 630:             --day)
 631:                 day="$2"
 632:                 shift 2
 633:                 ;;
 634:             --email)
 635:                 email="$2"  # shellcheck disable=SC2034  # Reserved for email delivery
 636:                 shift 2
 637:                 ;;
 638:             *)
 639:                 shift
 640:                 ;;
 641:         esac
 642:     done
 643: 
 644:     if type -t nftban_print_status >/dev/null 2>&1; then
 645:         nftban_print_status "info" "Creating ${frequency} scheduled report..."
 646:     else
 647:         echo "[INFO] Creating schedule..."
 648:     fi
 649: 
 650:     # Create cron file
 651:     mkdir -p "$(dirname "$NFTBAN_CRON_FILE")"
 652: 
 653:     # Parse time (HH:MM)
 654:     local hour="${time%:*}"
 655:     local minute="${time#*:}"
 656: 
 657:     # Build cron entry
 658:     local cron_entry=""
 659:     case "$frequency" in
 660:         daily)
 661:             cron_entry="${minute} ${hour} * * * root /usr/bin/nftban report run daily"
 662:             ;;
 663:         weekly)
 664:             local dow=1  # Monday
 665:             case "${day,,}" in
 666:                 monday) dow=1 ;;
 667:                 tuesday) dow=2 ;;
 668:                 wednesday) dow=3 ;;
 669:                 thursday) dow=4 ;;
 670:                 friday) dow=5 ;;
 671:                 saturday) dow=6 ;;
 672:                 sunday) dow=0 ;;
 673:             esac
 674:             cron_entry="${minute} ${hour} * * ${dow} root /usr/bin/nftban report run weekly"
 675:             ;;
 676:         monthly)
 677:             local dom="${day:-1}"
 678:             cron_entry="${minute} ${hour} ${dom} * * root /usr/bin/nftban report run monthly"
 679:             ;;
 680:     esac
 681: 
 682:     # Create/update cron file
 683:     {
 684:         echo "# NFTBan Statistics Reports - Automated Scheduling"
 685:         echo "# Generated: $(date)"
 686:         echo "SHELL=/bin/bash"
 687:         echo "PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin"
 688:         echo ""
 689: 
 690:         # Add entry
 691:         echo "# ${frequency^} report"
 692:         echo "${cron_entry}"
 693:         echo ""
 694: 
 695:         # Add other standard entries
 696:         echo "# Hourly snapshot"
 697:         echo "0 * * * * root ${NFTBAN_BIN:-/usr/bin/nftban} stats snapshot >> ${NFTBAN_LOG_DIR:-/var/log/nftban}/cron.log 2>&1"
 698:         echo ""
 699:         echo "# Daily cleanup"
 700:         echo "0 3 * * * root ${NFTBAN_BIN:-/usr/bin/nftban} stats cleanup >> ${NFTBAN_LOG_DIR:-/var/log/nftban}/cron.log 2>&1"
 701:     } > "$NFTBAN_CRON_FILE"
 702: 
 703:     chmod 644 "$NFTBAN_CRON_FILE"
 704: 

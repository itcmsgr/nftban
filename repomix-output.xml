  28: PKG_VERSION=$(cat "${BASH_SOURCE[0]%/*}/../VERSION" 2>/dev/null || echo "1.0.5")
  29: readonly PKG_VERSION
  30: readonly PKG_RELEASE="1"
  31: 
  32: # Paths
  33: SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  34: readonly SCRIPT_DIR
  35: PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
  36: readonly PROJECT_ROOT
  37: readonly BUILD_DIR="${PROJECT_ROOT}/build/packages"

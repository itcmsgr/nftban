1546: // ConfigFileHandler serves configuration files from /etc/nftban/
1547: func ConfigFileHandler(w http.ResponseWriter, r *http.Request) {
1548: 	// Extract config path from URL: /api/v1/config/{path}
1549: 	parts := strings.Split(r.URL.Path, "/")
1550: 	if len(parts) < 4 {
1551: 		respondJSON(w, http.StatusBadRequest, ErrorResponse{Error: "Invalid config path"})
1552: 		return
1553: 	}
1554: 
1555: 	// Join remaining parts to support paths like "conf.d/portscan.conf"
1556: 	configPath := strings.Join(parts[4:], "/")
1557: 
1558: 	// Base directory for config files - use central config
1559: 	baseDir := getConfigDir()
1560: 
1561: 	// Security: Validate config path (prevent directory traversal)
1562: 	if strings.Contains(configPath, "..") || strings.HasPrefix(configPath, "/") {
1563: 		respondJSON(w, http.StatusForbidden, ErrorResponse{Error: "Invalid config path"})
1564: 		return
1565: 	}
1566: 
1567: 	// Allowed config files (whitelist)
1568: 	allowedFiles := map[string]bool{
1569: 		"nftban.conf":             true,
1570: 		"nftban.conf.local":       true,
1571: 		"conf.d/portscan.conf":    true,
1572: 		"conf.d/ddos.conf":        true,
1573: 		// Removed: conf.d/fail2ban.conf (v1.0 migration to Suricata)
1574: 		"conf.d/feeds.conf":       true,
1575: 		"conf.d/geoip.conf":       true,
1576: 		"conf.d/mail.conf":        true,
1577: 		"conf.d/log.conf":         true,
1578: 		"conf.d/services.conf":    true,
1579: 		"conf.d/banner.conf":      true,
1580: 		"conf.d/cloudflare.conf":  true,
1581: 		"conf.d/panels/directadmin/main.conf": true,
1582: 		"conf.d/health.conf":      true,
1583: 		"conf.d/login_alert.conf": true,
1584: 		"conf.d/nftban-go.conf":   true,
1585: 		"conf.d/recovery.conf":    true,
1586: 		"conf.d/stats.conf":       true,
1587: 	}
1588: 
1589: 	if !allowedFiles[configPath] {
1590: 		respondJSON(w, http.StatusForbidden, ErrorResponse{Error: "Config file not allowed"})
1591: 		return
1592: 	}
1593: 
1594: 	fullPath := baseDir + "/" + configPath
1595: 
1596: 	// Handle GET request (read file)
1597: 	if r.Method == "GET" {
1598: 		// Check if file exists
1599: 		fileInfo, err := os.Stat(fullPath)
1600: 		if err != nil {
1601: 			if os.IsNotExist(err) {
1602: 				respondJSON(w, http.StatusNotFound, ErrorResponse{Error: "Config file not found"})
1603: 			} else {
1604: 				respondJSON(w, http.StatusInternalServerError, ErrorResponse{Error: "Failed to access config file"})
1605: 			}
1606: 			return
1607: 		}
1608: 
1609: 		// Read file content
1610: 		data, err := os.ReadFile(fullPath)
1611: 		if err != nil {
1612: 			respondJSON(w, http.StatusInternalServerError, ErrorResponse{Error: "Failed to read config file"})
1613: 			return
1614: 		}
1615: 
1616: 		// Return config content
1617: 		respondJSON(w, http.StatusOK, map[string]interface{}{
1618: 			"content":  string(data),
1619: 			"size":     fileInfo.Size(),
1620: 			"modified": fileInfo.ModTime().Unix(),
1621: 			"path":     configPath,
1622: 		})
1623: 		return
1624: 	}
1625: 
1626: 	// Handle POST request (save file)
1627: 	if r.Method == "POST" {
1628: 		// Only allow editing .local files
1629: 		if !strings.Contains(configPath, ".local") {
1630: 			respondJSON(w, http.StatusForbidden, ErrorResponse{Error: "Only .local files can be edited"})
1631: 			return
1632: 		}
1633: 
1634: 		// Parse request body
1635: 		var req struct {
1636: 			Content string `json:"content"`
1637: 		}
1638: 		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
1639: 			respondJSON(w, http.StatusBadRequest, ErrorResponse{Error: "Invalid request body"})
1640: 			return
1641: 		}
1642: 
1643: 		// Write file (create backup first if file exists)
1644: 		if _, err := os.Stat(fullPath); err == nil {
1645: 			// Create backup
1646: 			backupPath := fullPath + ".backup"
1647: 			if _, err := execCommand("cp", fullPath, backupPath); err != nil {
1648: 				log.Printf("[WARN] Failed to create backup: %v", err)
1649: 			}
1650: 		}
1651: 
1652: 		// Write new content
1653: 		if err := os.WriteFile(fullPath, []byte(req.Content), 0640); err != nil {
1654: 			respondJSON(w, http.StatusInternalServerError, ErrorResponse{Error: "Failed to write config file"})
1655: 			return
1656: 		}
1657: 
1658: 		// Set proper ownership (nftban:nftban or root:nftban)
1659: 		if err := os.Chown(fullPath, 0, 988); err != nil {  // 988 = nftban group GID
1660: 			log.Printf("[WARN] Failed to set ownership: %v", err)
1661: 		}
1662: 
1663: 		respondJSON(w, http.StatusOK, map[string]interface{}{
1664: 			"success": true,
1665: 			"message": "Config file saved successfully",
1666: 			"path":    configPath,
1667: 		})
1668: 		return
1669: 	}
1670: 
1671: 	respondJSON(w, http.StatusMethodNotAllowed, ErrorResponse{Error: "Method not allowed"})
1672: }

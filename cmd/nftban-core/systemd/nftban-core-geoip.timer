[Unit]
Description=NFTBan Core - Weekly GeoIP Database Update Timer
Documentation=https://github.com/itcmsgr/nftban-dev
# Note: Does NOT require nftband.service - geoip update is standalone

[Timer]
# Run weekly on Sundays at 2:00 AM
OnCalendar=weekly
OnCalendar=Sun *-*-* 02:00:00
# Also run 30 minutes after boot
OnBootSec=30min
# Run if missed (e.g., system was off)
Persistent=true
# Add 0-60 minute random delay to avoid thundering herd
RandomizedDelaySec=60min

[Install]
WantedBy=timers.target

 491: 
 492:     if [[ -f "$log_file" ]]; then
 493:         total_events=$(wc -l < "$log_file" 2>/dev/null)
 494:         total_events=${total_events:-0}
 495:         success_events=$(grep -c "SUCCESS" "$log_file" 2>/dev/null) || success_events=0
 496:         failed_events=$(grep -c "FAILED" "$log_file" 2>/dev/null) || failed_events=0
 497:         today_events=$(grep -c "\[$today" "$log_file" 2>/dev/null) || today_events=0
 498:     fi

1440:             status=$HEALTH_ERROR
1441:         fi
1442:     fi
1443: 
1444:     # Verify SSH port is actually in nftables (v0.7.3: check IPv4 table)
1445:     if nft list table ${NFTBAN_TABLE_IPV4} >/dev/null 2>&1; then

# nftban-managed: yes
# nftban-templates-version: 1

[nftban-directadmin]
enabled   = @@NFTBAN_F2B_DIRECTADMIN_JAIL@@
filter    = nftban-directadmin
backend   = auto
port      = 2222
logpath   = @@NFTBAN_F2B_DIRECTADMIN_LOG@@
maxretry  = @@NFTBAN_F2B_DIRECTADMIN_MAX_RETRY@@
findtime  = @@NFTBAN_F2B_DIRECTADMIN_FIND_TIME@@
bantime   = @@NFTBAN_F2B_DIRECTADMIN_BAN_TIME@@

 21: // replaceConfigValue replaces a config variable value using regex to handle spacing variations
 22: // Pattern matches: VAR="value", VAR = "value", VAR= "value", etc.
 23: func replaceConfigValueTrust(content, varName, newValue string) string {
 24: 	// Regex pattern: varName + optional spaces + = + optional spaces + quoted value
 25: 	pattern := regexp.MustCompile(fmt.Sprintf(`(?m)^(\s*)%s\s*=\s*"[^"]*"(.*)$`, regexp.QuoteMeta(varName)))
 26: 	replacement := fmt.Sprintf(`${1}%s="%s"${2}`, varName, newValue)
 27: 	return pattern.ReplaceAllString(content, replacement)
 28: }

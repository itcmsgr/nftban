  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - FHS Specification
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Canonical FHS directory specification for NFTBan
  7: #
  8: # meta:name=nftban_fhs_spec
  9: # meta:type=core
 10: # meta:header=FHS Specification
 11: # meta:version=1.0.0
 12: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 13: # meta:homepage=https://nftban.com
 14: #
 15: # **Description & Purpose**
 16: # meta:description=Single source of truth for FHS directory specifications
 17: # meta:input=None (defines constants)
 18: # meta:output=FHS path constants and validation functions
 19: #
 20: # **Inventory & Requirements**
 21: # meta:depends=bash
 22: #
 23: # meta:created_date=2025-11-05
 24: # meta:updated_date=2025-11-24
 25: # =============================================================================
 26: 
 27: # Strict mode
 28: IFS=$'\n\t'
 29: umask 027
 30: 
 31: # Prevent double-loading
 32: [[ -n "${NFTBAN_FHS_SPEC_LOADED:-}" ]] && return 0
 33: readonly NFTBAN_FHS_SPEC_LOADED=1
 34: 
 35: # =============================================================================
 36: # CANONICAL FHS SPECIFICATION
 37: # =============================================================================
 38: 
 39: declare -g -A NFTBAN_FHS_DIRECTORIES=()
 40: 
 41: nftban_fhs_load_spec() {
 42:     # Load canonical FHS directory specification
 43:     # Format: NFTBAN_FHS_DIRECTORIES[path]="perms|owner|group|purpose"
 44: 
 45:     # ─────────────────────────────────────────────────────────────────────
 46:     # System Directories (root:root) - System libraries and binaries
 47:     # ─────────────────────────────────────────────────────────────────────
 48:     # NOTE: /usr/sbin is SECURITY-CHECK only (owner must be root:root)
 49:     # Perms vary by distro (555 on RHEL/Fedora, 755 on Debian) - use wildcard
 50:     NFTBAN_FHS_DIRECTORIES["/usr/sbin"]="*|root|root|System binaries (SECURITY: must be root:root, perms vary by OS)"
 51:     NFTBAN_FHS_DIRECTORIES["/usr/lib/nftban"]="755|root|root|Application libraries and modules"
 52:     NFTBAN_FHS_DIRECTORIES["/usr/lib/nftban/core"]="755|root|root|Core modules"
 53:     NFTBAN_FHS_DIRECTORIES["/usr/lib/nftban/cli"]="755|root|root|CLI command modules"
 54:     NFTBAN_FHS_DIRECTORIES["/usr/lib/nftban/bin"]="755|root|root|Application binaries (GO, etc.)"
 55:     NFTBAN_FHS_DIRECTORIES["/usr/lib/nftban/tests"]="755|root|root|Test scripts (smoke tests, validation)"
 56:     NFTBAN_FHS_DIRECTORIES["/usr/lib/nftban/helpers"]="755|root|root|Helper scripts (trace, autoheal)"
 57: 
 58:     # ─────────────────────────────────────────────────────────────────────
 59:     # Configuration (root:nftban, 750/640) - Daemon needs read access
 60:     # ─────────────────────────────────────────────────────────────────────
 61:     NFTBAN_FHS_DIRECTORIES["/etc/nftban"]="750|root|nftban|Configuration files (daemon readable via group)"
 62:     NFTBAN_FHS_DIRECTORIES["/etc/nftban/conf.d"]="750|root|nftban|Module configurations (daemon readable via group)"
 63:     NFTBAN_FHS_DIRECTORIES["/etc/nftban/conf.d/ddos"]="750|root|nftban|DDoS protection configuration"
 64:     NFTBAN_FHS_DIRECTORIES["/etc/nftban/conf.d/portscan"]="750|root|nftban|Port scan detection configuration"
 65:     NFTBAN_FHS_DIRECTORIES["/etc/nftban/conf.d/login"]="750|root|nftban|Login monitoring configuration"
 66:     NFTBAN_FHS_DIRECTORIES["/etc/nftban/conf.d/panels"]="750|root|nftban|Control panel configurations"
 67:     NFTBAN_FHS_DIRECTORIES["/etc/nftban/conf.d/panels/directadmin"]="750|root|nftban|DirectAdmin panel configuration"
 68:     NFTBAN_FHS_DIRECTORIES["/etc/nftban/conf.d/panels/cpanel"]="750|root|nftban|cPanel/WHM panel configuration"
 69:     NFTBAN_FHS_DIRECTORIES["/etc/nftban/conf.d/panels/cwp"]="750|root|nftban|CentOS Web Panel configuration"
 70:     NFTBAN_FHS_DIRECTORIES["/etc/nftban/conf.d/panels/cyberpanel"]="750|root|nftban|CyberPanel configuration"
 71:     NFTBAN_FHS_DIRECTORIES["/etc/nftban/conf.d/panels/interworx"]="750|root|nftban|InterWorx panel configuration"
 72:     NFTBAN_FHS_DIRECTORIES["/etc/nftban/conf.d/panels/vesta"]="750|root|nftban|VestaCP panel configuration"
 73:     NFTBAN_FHS_DIRECTORIES["/etc/nftban/conf.d/panels/generic"]="750|root|nftban|Generic server configuration"
 74: 
 75:     # ─────────────────────────────────────────────────────────────────────
 76:     # Variable Data (nftban:nftban) - Application state and runtime data
 77:     # ─────────────────────────────────────────────────────────────────────
 78:     NFTBAN_FHS_DIRECTORIES["/var/lib/nftban"]="750|nftban|nftban|Application state data"
 79:     NFTBAN_FHS_DIRECTORIES["/var/lib/nftban/reports"]="750|nftban|nftban|Generated reports (application state)"
 80:     NFTBAN_FHS_DIRECTORIES["/var/lib/nftban/reports/baseline"]="750|nftban|nftban|Baseline reports (service use)"
 81:     NFTBAN_FHS_DIRECTORIES["/var/lib/nftban/reports/watchdog"]="750|nftban|nftban|Watchdog system reports"
 82:     NFTBAN_FHS_DIRECTORIES["/var/lib/nftban/reports/auditors"]="770|root|nftban-auditors|Auditor reports (nftban-auditors group)"
 83:     NFTBAN_FHS_DIRECTORIES["/var/lib/nftban/metrics"]="750|nftban|nftban|Statistics metrics database"
 84:     NFTBAN_FHS_DIRECTORIES["/var/lib/nftban/snapshots"]="750|nftban|nftban|Hourly stats snapshots"
 85:     NFTBAN_FHS_DIRECTORIES["/var/lib/nftban/exports"]="750|nftban|nftban|User data exports (JSON, CSV)"
 86:     NFTBAN_FHS_DIRECTORIES["/var/lib/nftban/geoip"]="750|nftban|nftban|GeoIP database (group readable)"
 87: 
 88:     # ─────────────────────────────────────────────────────────────────────
 89:     # Logs (nftban:nftban, 750) - Daemon writes, group reads
 90:     # ─────────────────────────────────────────────────────────────────────
 91:     NFTBAN_FHS_DIRECTORIES["/var/log/nftban"]="750|nftban|nftban|Log files (daemon writes, group reads)"
 92:     NFTBAN_FHS_DIRECTORIES["/var/log/nftban/reports"]="750|nftban|nftban|Report files (log-style, daemon writes)"
 93:     NFTBAN_FHS_DIRECTORIES["/var/log/nftban/rbl"]="750|nftban|nftban|RBL check cache and results (temporary read files)"
 94: 
 95:     # ─────────────────────────────────────────────────────────────────────
 96:     # Cache and Runtime (nftban:nftban, 755) - Temporary files
 97:     # ─────────────────────────────────────────────────────────────────────
 98:     NFTBAN_FHS_DIRECTORIES["/var/cache/nftban"]="755|nftban|nftban|Cache files"
 99:     NFTBAN_FHS_DIRECTORIES["/var/cache/nftban/health"]="750|nftban|nftban|Health check status cache (for banner indicator)"
100:     NFTBAN_FHS_DIRECTORIES["/run/nftban"]="755|nftban|nftban|Runtime data (PID files, sockets)"
101: 
102:     # ─────────────────────────────────────────────────────────────────────
103:     # Shared Data (root:root, 755) - Read-only application data
104:     # ─────────────────────────────────────────────────────────────────────
105:     NFTBAN_FHS_DIRECTORIES["/usr/share/nftban"]="755|root|root|Shared application data"
106:     NFTBAN_FHS_DIRECTORIES["/usr/share/nftban/templates"]="755|root|root|Templates"
107:     NFTBAN_FHS_DIRECTORIES["/usr/share/nftban/templates/mail"]="755|root|root|Mail templates"
108:     NFTBAN_FHS_DIRECTORIES["/usr/share/nftban/templates/reports"]="755|root|root|Report templates"
109: }
110: 
111: # =============================================================================
112: # HELPER FUNCTIONS
113: # =============================================================================
114: 
115: nftban_fhs_get_spec() {
116:     # Get FHS specification for a path
117:     # Args: $1 = path
118:     # Output: perms|owner|group|purpose (or empty if not found)
119: 
120:     local path="$1"
121: 
122:     # Load spec if not already loaded
123:     if [[ ${#NFTBAN_FHS_DIRECTORIES[@]} -eq 0 ]]; then
124:         nftban_fhs_load_spec
125:     fi
126: 
127:     echo "${NFTBAN_FHS_DIRECTORIES[$path]:-}"
128: }
129: 
130: nftban_fhs_get_all_paths() {
131:     # Get all defined FHS paths
132:     # Output: one path per line
133: 
134:     # Load spec if not already loaded
135:     if [[ ${#NFTBAN_FHS_DIRECTORIES[@]} -eq 0 ]]; then
136:         nftban_fhs_load_spec
137:     fi
138: 
139:     printf '%s\n' "${!NFTBAN_FHS_DIRECTORIES[@]}" | sort
140: }
141: 
142: nftban_fhs_parse_spec() {
143:     # Parse FHS spec into components
144:     # Args: $1 = spec string (perms|owner|group|purpose)
145:     # Output: Sets variables FHS_PERMS, FHS_OWNER, FHS_GROUP, FHS_PURPOSE
146: 
147:     local spec="$1"
148:     IFS='|' read -r FHS_PERMS FHS_OWNER FHS_GROUP FHS_PURPOSE <<< "$spec"
149:     export FHS_PERMS FHS_OWNER FHS_GROUP FHS_PURPOSE
150: }
151: 
152: # =============================================================================
153: # INITIALIZATION
154: # =============================================================================
155: 
156: # Auto-load spec on source
157: nftban_fhs_load_spec
158: 
159: # =============================================================================
160: # EXPORTS
161: # =============================================================================
162: 
163: export -f nftban_fhs_load_spec
164: export -f nftban_fhs_get_spec
165: export -f nftban_fhs_get_all_paths
166: export -f nftban_fhs_parse_spec
167: 
168: # Export the associative array (bash 4.3+)
169: # NOTE: declare -p removed - was causing debug output in systemd journals (BUG-006)
170: # The array is already exported via declare -g -A on line 33
</file>


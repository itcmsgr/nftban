<file path="pkg/persistent/tracker.go">
  1: package persistent
  2: 
  3: import (
  4: 	"bufio"
  5: 	"fmt"
  6: 	"os"
  7: 	"strings"
  8: 	"time"
  9: )
 10: 
 11: // BanEntry represents a ban logged in bans.log (v1.0: removed fail2ban prefix)
 12: type BanEntry struct {
 13: 	Timestamp time.Time
 14: 	IP        string
 15: 	Jail      string
 16: 	Reason    string
 17: }
 18: 
 19: // LogTempBan logs a temporary ban to the tracking file for escalation tracking
 20: // This tracks temp bans to detect persistent offenders who should be escalated
 21: func LogTempBan(logPath, ip, jail, reason string) error {
 22: 	f, err := os.OpenFile(logPath, os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0644)
 23: 	if err != nil {
 24: 		return fmt.Errorf("failed to open ban log: %w", err)
 25: 	}
 26: 	defer f.Close()
 27: 
 28: 	timestamp := time.Now().Format(time.RFC3339)
 29: 	logLine := fmt.Sprintf("%s %s %s %s\n", timestamp, ip, jail, reason)
 30: 
 31: 	if _, err := f.WriteString(logLine); err != nil {
 32: 		return fmt.Errorf("failed to write to ban log: %w", err)
 33: 	}
 34: 
 35: 	return nil
 36: }
 37: 
 38: // CountRecentBans counts how many times an IP was banned in the given period
 39: func CountRecentBans(logPath, ip string, period time.Duration) (int, error) {
 40: 	f, err := os.Open(logPath)
 41: 	if err != nil {
 42: 		if os.IsNotExist(err) {
 43: 			return 0, nil // Log doesn't exist yet = 0 bans
 44: 		}
 45: 		return 0, fmt.Errorf("failed to open ban log: %w", err)
 46: 	}
 47: 	defer f.Close()
 48: 
 49: 	cutoff := time.Now().Add(-period)
 50: 	count := 0
 51: 
 52: 	scanner := bufio.NewScanner(f)
 53: 	for scanner.Scan() {
 54: 		line := scanner.Text()
 55: 		entry, err := parseBanEntry(line)
 56: 		if err != nil {
 57: 			continue // Skip malformed lines
 58: 		}
 59: 
 60: 		// Count only bans for this IP after the cutoff time
 61: 		if entry.IP == ip && entry.Timestamp.After(cutoff) {
 62: 			count++
 63: 		}
 64: 	}
 65: 
 66: 	if err := scanner.Err(); err != nil {
 67: 		return 0, fmt.Errorf("failed to read ban log: %w", err)
 68: 	}
 69: 
 70: 	return count, nil
 71: }
 72: 
 73: // parseBanEntry parses a log line into a BanEntry
 74: // Format: "2025-11-27T10:00:00Z 1.2.3.4 nftban-sshd SSH brute force"
 75: func parseBanEntry(line string) (*BanEntry, error) {
 76: 	parts := strings.Fields(line)
 77: 	if len(parts) < 3 {
 78: 		return nil, fmt.Errorf("invalid log line: %s", line)
 79: 	}
 80: 
 81: 	timestamp, err := time.Parse(time.RFC3339, parts[0])
 82: 	if err != nil {
 83: 		return nil, fmt.Errorf("invalid timestamp: %w", err)
 84: 	}
 85: 
 86: 	reason := ""
 87: 	if len(parts) > 3 {
 88: 		reason = strings.Join(parts[3:], " ")
 89: 	}
 90: 
 91: 	return &BanEntry{
 92: 		Timestamp: timestamp,
 93: 		IP:        parts[1],
 94: 		Jail:      parts[2],
 95: 		Reason:    reason,
 96: 	}, nil
 97: }
 98: 
 99: // AddToPersistentOffenders adds an IP to the persistent offenders config file
100: func AddToPersistentOffenders(confPath, ip, reason string) error {
101: 	// Check if already in file
102: 	exists, err := isInFile(confPath, ip)
103: 	if err != nil {
104: 		return err
105: 	}
106: 	if exists {
107: 		return nil // Already persistent
108: 	}
109: 
110: 	// Append to file
111: 	f, err := os.OpenFile(confPath, os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0644)
112: 	if err != nil {
113: 		return fmt.Errorf("failed to open persistent offenders file: %w", err)
114: 	}
115: 	defer f.Close()
116: 
117: 	line := fmt.Sprintf("%s  # persistent offender: %s\n", ip, reason)
118: 	if _, err := f.WriteString(line); err != nil {
119: 		return fmt.Errorf("failed to write to persistent offenders file: %w", err)
120: 	}
121: 
122: 	return nil
123: }
124: 
125: // LogPersistentOffender logs to persistent-offenders.log
126: func LogPersistentOffender(logPath, ip, jail string, banCount int) error {
127: 	f, err := os.OpenFile(logPath, os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0644)
128: 	if err != nil {
129: 		return fmt.Errorf("failed to open offenders log: %w", err)
130: 	}
131: 	defer f.Close()
132: 
133: 	timestamp := time.Now().Format(time.RFC3339)
134: 	logLine := fmt.Sprintf("%s %s %s %d bans - escalated to permanent\n",
135: 		timestamp, ip, jail, banCount)
136: 
137: 	if _, err := f.WriteString(logLine); err != nil {
138: 		return fmt.Errorf("failed to write to offenders log: %w", err)
139: 	}
140: 
141: 	return nil
142: }
143: 
144: // isInFile checks if an IP already exists in a file
145: func isInFile(path, ip string) (bool, error) {
146: 	f, err := os.Open(path)
147: 	if err != nil {
148: 		if os.IsNotExist(err) {
149: 			return false, nil
150: 		}
151: 		return false, err
152: 	}
153: 	defer f.Close()
154: 
155: 	scanner := bufio.NewScanner(f)
156: 	for scanner.Scan() {
157: 		line := strings.TrimSpace(scanner.Text())
158: 		// Skip comments and empty lines
159: 		if line == "" || strings.HasPrefix(line, "#") {
160: 			continue
161: 		}
162: 		// Extract IP (first field)
163: 		fields := strings.Fields(line)
164: 		if len(fields) > 0 && fields[0] == ip {
165: 			return true, nil
166: 		}
167: 	}
168: 
169: 	return false, scanner.Err()
170: }
</file>

<file path="pkg/ports/loader.go">
  1: package ports
  2: 
  3: import (
  4: 	"bufio"
  5: 	"fmt"
  6: 	"os"
  7: 	"path/filepath"
  8: 	"strconv"
  9: 	"strings"
 10: )
 11: 
 12: // PortRule represents a single port rule
 13: type PortRule struct {
 14: 	Port     int    // Port number (e.g., 22, 80, 443)
 15: 	Protocol string // "T" (TCP), "U" (UDP), or "B" (Both)
 16: 	Source   string // Config file where this rule came from
 17: }
 18: 
 19: // PortConfig holds all port rules loaded from configuration
 20: type PortConfig struct {
 21: 	TCPPorts  []int            // All TCP ports (from T and B rules)
 22: 	UDPPorts  []int            // All UDP ports (from U and B rules)
 23: 	AllRules  []PortRule       // All rules with metadata
 24: 	PortMap   map[int][]string // port -> protocols (for deduplication)
 25: }
 26: 
 27: // LoadPortsFromDirectory loads all port configuration files from a directory
 28: // Expected format: PORT/PROTOCOL where PROTOCOL is T (TCP), U (UDP), or B (Both)
 29: // Example: 22/T, 53/B, 80/T
 30: func LoadPortsFromDirectory(dir string) (*PortConfig, error) {
 31: 	config := &PortConfig{
 32: 		TCPPorts: []int{},
 33: 		UDPPorts: []int{},
 34: 		AllRules: []PortRule{},
 35: 		PortMap:  make(map[int][]string),
 36: 	}
 37: 
 38: 	// Check if directory exists
 39: 	if _, err := os.Stat(dir); os.IsNotExist(err) {
 40: 		// No ports directory - return empty config (valid state)
 41: 		return config, nil
 42: 	}
 43: 
 44: 	// Read all .conf files in directory
 45: 	entries, err := os.ReadDir(dir)
 46: 	if err != nil {
 47: 		return nil, fmt.Errorf("failed to read ports directory: %w", err)
 48: 	}
 49: 
 50: 	for _, entry := range entries {
 51: 		if entry.IsDir() {
 52: 			continue
 53: 		}
 54: 		if !strings.HasSuffix(entry.Name(), ".conf") {
 55: 			continue
 56: 		}
 57: 
 58: 		filePath := filepath.Join(dir, entry.Name())
 59: 		if err := loadPortFile(filePath, config); err != nil {
 60: 			fmt.Fprintf(os.Stderr, "Warning: Failed to load port file %s: %v\n", entry.Name(), err)
 61: 			continue
 62: 		}
 63: 	}
 64: 
 65: 	// Deduplicate ports
 66: 	config.deduplicatePorts()
 67: 
 68: 	return config, nil
 69: }
 70: 
 71: // LoadPortsFromFile loads port rules from a single configuration file
 72: func LoadPortsFromFile(filePath string) (*PortConfig, error) {
 73: 	config := &PortConfig{
 74: 		TCPPorts: []int{},
 75: 		UDPPorts: []int{},
 76: 		AllRules: []PortRule{},
 77: 		PortMap:  make(map[int][]string),
 78: 	}
 79: 
 80: 	if err := loadPortFile(filePath, config); err != nil {
 81: 		return nil, err
 82: 	}
 83: 
 84: 	config.deduplicatePorts()
 85: 	return config, nil
 86: }
 87: 
 88: // loadPortFile loads ports from a single file into the config
 89: func loadPortFile(filePath string, config *PortConfig) error {
 90: 	file, err := os.Open(filePath)
 91: 	if err != nil {
 92: 		return err
 93: 	}
 94: 	defer file.Close()
 95: 
 96: 	scanner := bufio.NewScanner(file)
 97: 	lineNum := 0
 98: 
 99: 	for scanner.Scan() {
100: 		lineNum++
101: 		line := strings.TrimSpace(scanner.Text())
102: 
103: 		// Skip empty lines and comments
104: 		if line == "" || strings.HasPrefix(line, "#") {
105: 			continue
106: 		}
107: 
108: 		// Handle inline comments
109: 		if idx := strings.Index(line, "#"); idx >= 0 {
110: 			line = strings.TrimSpace(line[:idx])
111: 		}
112: 
113: 		// Parse format: PORT/PROTOCOL
114: 		// Examples: 22/T, 53/B, 80/T
115: 		parts := strings.Split(line, "/")
116: 		if len(parts) != 2 {
117: 			fmt.Fprintf(os.Stderr, "Warning: Invalid port format at %s:%d: %s (expected PORT/PROTOCOL)\n",
118: 				filePath, lineNum, line)
119: 			continue
120: 		}
121: 
122: 		portStr := strings.TrimSpace(parts[0])
123: 		protocol := strings.ToUpper(strings.TrimSpace(parts[1]))
124: 
125: 		// Check for port range (e.g., 35000-35999/T)
126: 		if strings.Contains(portStr, "-") {
127: 			// Port ranges not supported yet - skip with warning
128: 			fmt.Fprintf(os.Stderr, "Warning: Port ranges not yet supported at %s:%d: %s\n",
129: 				filePath, lineNum, line)
130: 			continue
131: 		}
132: 
133: 		// Parse port number
134: 		port, err := strconv.Atoi(portStr)
135: 		if err != nil {
136: 			fmt.Fprintf(os.Stderr, "Warning: Invalid port number at %s:%d: %s\n",
137: 				filePath, lineNum, portStr)
138: 			continue
139: 		}
140: 
141: 		// Validate port range
142: 		if port < 1 || port > 65535 {
143: 			fmt.Fprintf(os.Stderr, "Warning: Port out of range (1-65535) at %s:%d: %d\n",
144: 				filePath, lineNum, port)
145: 			continue
146: 		}
147: 
148: 		// Validate protocol
149: 		if protocol != "T" && protocol != "U" && protocol != "B" {
150: 			fmt.Fprintf(os.Stderr, "Warning: Invalid protocol at %s:%d: %s (expected T, U, or B)\n",
151: 				filePath, lineNum, protocol)
152: 			continue
153: 		}
154: 
155: 		// Create rule
156: 		rule := PortRule{
157: 			Port:     port,
158: 			Protocol: protocol,
159: 			Source:   filePath,
160: 		}
161: 		config.AllRules = append(config.AllRules, rule)
162: 
163: 		// Add to port map for deduplication tracking
164: 		config.PortMap[port] = append(config.PortMap[port], protocol)
165: 	}
166: 
167: 	if err := scanner.Err(); err != nil {
168: 		return fmt.Errorf("error reading file: %w", err)
169: 	}
170: 
171: 	return nil
172: }
173: 
174: // deduplicatePorts processes all rules and creates deduplicated TCP/UDP port lists
175: func (c *PortConfig) deduplicatePorts() {
176: 	tcpSet := make(map[int]bool)
177: 	udpSet := make(map[int]bool)
178: 
179: 	for _, rule := range c.AllRules {
180: 		switch rule.Protocol {
181: 		case "T": // TCP only
182: 			tcpSet[rule.Port] = true
183: 		case "U": // UDP only
184: 			udpSet[rule.Port] = true
185: 		case "B": // Both TCP and UDP
186: 			tcpSet[rule.Port] = true
187: 			udpSet[rule.Port] = true
188: 		}
189: 	}
190: 
191: 	// Convert sets to sorted slices
192: 	for port := range tcpSet {
193: 		c.TCPPorts = append(c.TCPPorts, port)
194: 	}
195: 	for port := range udpSet {
196: 		c.UDPPorts = append(c.UDPPorts, port)
197: 	}
198: }
199: 
200: // GetTCPPorts returns all TCP ports (from T and B rules)
201: func (c *PortConfig) GetTCPPorts() []int {
202: 	return c.TCPPorts
203: }
204: 
205: // GetUDPPorts returns all UDP ports (from U and B rules)
206: func (c *PortConfig) GetUDPPorts() []int {
207: 	return c.UDPPorts
208: }
209: 
210: // GetAllPorts returns all unique ports regardless of protocol
211: func (c *PortConfig) GetAllPorts() []int {
212: 	portSet := make(map[int]bool)
213: 	for _, port := range c.TCPPorts {
214: 		portSet[port] = true
215: 	}
216: 	for _, port := range c.UDPPorts {
217: 		portSet[port] = true
218: 	}
219: 
220: 	var ports []int
221: 	for port := range portSet {
222: 		ports = append(ports, port)
223: 	}
224: 	return ports
225: }
226: 
227: // AddPortToFile adds a port rule to a configuration file
228: func AddPortToFile(filePath string, port int, protocol string) error {
229: 	// Validate inputs
230: 	if port < 1 || port > 65535 {
231: 		return fmt.Errorf("port out of range (1-65535): %d", port)
232: 	}
233: 
234: 	protocol = strings.ToUpper(protocol)
235: 	if protocol != "T" && protocol != "U" && protocol != "B" {
236: 		return fmt.Errorf("invalid protocol: %s (expected T, U, or B)", protocol)
237: 	}
238: 
239: 	// Check if port already exists
240: 	if fileExists(filePath) {
241: 		existing, err := LoadPortsFromFile(filePath)
242: 		if err != nil {
243: 			return fmt.Errorf("failed to check existing ports: %w", err)
244: 		}
245: 
246: 		// Check if this exact rule already exists
247: 		for _, rule := range existing.AllRules {
248: 			if rule.Port == port && rule.Protocol == protocol {
249: 				return nil // Already exists, nothing to do
250: 			}
251: 		}
252: 	}
253: 
254: 	// Open file for appending
255: 	f, err := os.OpenFile(filePath, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0640)
256: 	if err != nil {
257: 		return fmt.Errorf("failed to open file: %w", err)
258: 	}
259: 	defer f.Close()
260: 
261: 	// Write port rule
262: 	_, err = fmt.Fprintf(f, "%d/%s\n", port, protocol)
263: 	if err != nil {
264: 		return fmt.Errorf("failed to write port rule: %w", err)
265: 	}
266: 
267: 	return nil
268: }
269: 
270: // RemovePortFromFile removes a port rule from a configuration file
271: func RemovePortFromFile(filePath string, port int) error {
272: 	if !fileExists(filePath) {
273: 		return fmt.Errorf("file does not exist: %s", filePath)
274: 	}
275: 
276: 	// Read entire file
277: 	content, err := os.ReadFile(filePath)
278: 	if err != nil {
279: 		return fmt.Errorf("failed to read file: %w", err)
280: 	}
281: 
282: 	// Filter out lines matching this port
283: 	lines := strings.Split(string(content), "\n")
284: 	var newLines []string
285: 	portStr := fmt.Sprintf("%d/", port)
286: 
287: 	for _, line := range lines {
288: 		trimmed := strings.TrimSpace(line)
289: 		// Keep line if it doesn't start with this port number
290: 		if !strings.HasPrefix(trimmed, portStr) {
291: 			newLines = append(newLines, line)
292: 		}
293: 	}
294: 
295: 	// Write back
296: 	newContent := strings.Join(newLines, "\n")
297: 	if err := os.WriteFile(filePath, []byte(newContent), 0640); err != nil {
298: 		return fmt.Errorf("failed to write file: %w", err)
299: 	}
300: 
301: 	return nil
302: }
303: 
304: // fileExists checks if a file exists
305: func fileExists(filePath string) bool {
306: 	_, err := os.Stat(filePath)
307: 	return err == nil
308: }

<file path="install/packaging/deb/nftban.postinst">
  1: #!/bin/bash
  2: # SPDX-License-Identifier: MPL-2.0
  3: # SPDX-FileCopyrightText: Copyright (c) 2024-2025 NFTBan Development Team
  4: #
  5: # postinst script for nftban (main package)
  6: # Configure after installation
  7: 
  8: set -e
  9: 
 10: # =============================================================================
 11: # PATH DEFAULTS (can be overridden by config)
 12: # =============================================================================
 13: NFTBAN_CONFIG_DIR="${NFTBAN_CONFIG_DIR:-/etc/nftban}"
 14: NFTBAN_DATA_DIR="${NFTBAN_DATA_DIR:-/var/lib/nftban}"
 15: NFTBAN_LOG_DIR="${NFTBAN_LOG_DIR:-/var/log/nftban}"
 16: NFTBAN_CACHE_DIR="${NFTBAN_CACHE_DIR:-/var/cache/nftban}"
 17: NFTBAN_RUN_DIR="${NFTBAN_RUN_DIR:-/run/nftban}"
 18: 
 19: # Source config if exists (allows custom paths)
 20: if [ -f "${NFTBAN_CONFIG_DIR}/nftban.conf" ]; then
 21:     # shellcheck source=/dev/null
 22:     . "${NFTBAN_CONFIG_DIR}/nftban.conf" 2>/dev/null || true
 23: fi
 24: 
 25: case "$1" in
 26:     configure)
 27:         echo "Configuring NFTBan..."
 28: 
 29:         # Create user and group if not exists
 30:         if ! getent group nftban >/dev/null; then
 31:             groupadd -r nftban
 32:         fi
 33:         if ! getent group nftban-auditors >/dev/null; then
 34:             groupadd -r nftban-auditors
 35:         fi
 36:         if ! getent passwd nftban >/dev/null; then
 37:             useradd -r -g nftban -G nftban-auditors -d "${NFTBAN_DATA_DIR}" \
 38:                 -s /usr/sbin/nologin -c "NFTBan Service Account" nftban
 39:         fi
 40: 
 41:         # Create directories per FHS spec (see nftban_fhs_spec.sh)
 42:         # Config directories (root:nftban)
 43:         install -d -m 750 -o root -g nftban "${NFTBAN_CONFIG_DIR}"
 44:         install -d -m 750 -o root -g nftban "${NFTBAN_CONFIG_DIR}/conf.d"
 45: 
 46:         # Data directories (nftban:nftban)
 47:         install -d -m 750 -o nftban -g nftban "${NFTBAN_DATA_DIR}"
 48:         install -d -m 750 -o nftban -g nftban "${NFTBAN_DATA_DIR}/reports"
 49:         install -d -m 750 -o nftban -g nftban "${NFTBAN_DATA_DIR}/reports/baseline"
 50:         install -d -m 750 -o nftban -g nftban "${NFTBAN_DATA_DIR}/reports/watchdog"
 51:         install -d -m 750 -o nftban -g nftban "${NFTBAN_DATA_DIR}/metrics"
 52:         install -d -m 750 -o nftban -g nftban "${NFTBAN_DATA_DIR}/snapshots"
 53:         install -d -m 750 -o nftban -g nftban "${NFTBAN_DATA_DIR}/exports"
 54:         install -d -m 750 -o nftban -g nftban "${NFTBAN_DATA_DIR}/geoip"
 55: 
 56:         # Log directory
 57:         install -d -m 750 -o nftban -g nftban "${NFTBAN_LOG_DIR}"
 58: 
 59:         # Cache and runtime
 60:         install -d -m 755 -o nftban -g nftban "${NFTBAN_CACHE_DIR}"
 61:         install -d -m 750 -o nftban -g nftban "${NFTBAN_CACHE_DIR}/health"
 62:         install -d -m 755 -o nftban -g nftban "${NFTBAN_RUN_DIR}"
 63: 
 64:         # Auto-detect SSH port
 65:         SSH_PORT="22"
 66:         if [ -f /etc/ssh/sshd_config ]; then
 67:             DETECTED=$(grep -E "^Port\s+" /etc/ssh/sshd_config 2>/dev/null | awk '{print $2}' | head -1)
 68:             if [ -n "$DETECTED" ]; then
 69:                 SSH_PORT="$DETECTED"
 70:             fi
 71:         fi
 72: 
 73:         # Create SSH port whitelist if not exists
 74:         if [ ! -f "${NFTBAN_CONFIG_DIR}/ports.d/00-ssh.conf" ]; then
 75:             mkdir -p "${NFTBAN_CONFIG_DIR}/ports.d"
 76:             cat > "${NFTBAN_CONFIG_DIR}/ports.d/00-ssh.conf" << EOF
 77: # Auto-generated SSH port whitelist
 78: # Created by: NFTBan package installer
 79: [ssh]
 80: port=$SSH_PORT
 81: protocol=tcp
 82: direction=input
 83: EOF
 84:             chmod 644 "${NFTBAN_CONFIG_DIR}/ports.d/00-ssh.conf"
 85:             chown root:nftban "${NFTBAN_CONFIG_DIR}/ports.d/00-ssh.conf"
 86:             echo "SSH port whitelisted: $SSH_PORT/tcp"
 87:         fi
 88: 
 89:         # Auto-whitelist system IP (prevents lockout)
 90:         SYSTEM_IP=$(ip route get 1.1.1.1 2>/dev/null | grep -oP 'src \K[0-9.]+' | head -1)
 91:         if [ -z "$SYSTEM_IP" ]; then
 92:             SYSTEM_IP=$(hostname -I 2>/dev/null | awk '{print $1}')
 93:         fi
 94:         if [ -n "$SYSTEM_IP" ]; then
 95:             mkdir -p "${NFTBAN_CONFIG_DIR}/whitelist.d"
 96:             if [ ! -f "${NFTBAN_CONFIG_DIR}/whitelist.d/00-system-ip.conf" ]; then
 97:                 cat > "${NFTBAN_CONFIG_DIR}/whitelist.d/00-system-ip.conf" << EOF
 98: # Auto-generated system IP whitelist
 99: # Created by: NFTBan package installer
100: # Purpose: Prevent lockout from this server
101: $SYSTEM_IP
102: EOF
103:                 chmod 644 "${NFTBAN_CONFIG_DIR}/whitelist.d/00-system-ip.conf"
104:                 chown root:nftban "${NFTBAN_CONFIG_DIR}/whitelist.d/00-system-ip.conf"
105:                 echo "System IP whitelisted: $SYSTEM_IP"
106:             fi
107:         fi
108: 
109:         # Reload systemd
110:         systemctl daemon-reload >/dev/null 2>&1 || true
111: 
112:         # ==========================================================================
113:         # AUTO-ENABLE DEFAULT FEATURES (aligned with install.sh)
114:         # ==========================================================================
115: 
116:         # 1. Download FREE GeoIP database (DB-IP)
117:         GEOIP_DIR="${NFTBAN_DATA_DIR}/geoip"
118:         GEOIP_FILE="${GEOIP_DIR}/dbip-country-lite.mmdb"
119:         GEOIP_URL="https://download.db-ip.com/free/dbip-country-lite-$(date +%Y-%m).mmdb.gz"
120: 
121:         mkdir -p "$GEOIP_DIR"
122:         chown nftban:nftban "$GEOIP_DIR"
123: 
124:         if [ ! -f "$GEOIP_FILE" ]; then
125:             echo "Downloading FREE GeoIP database..."
126:             if curl -fsSL "$GEOIP_URL" -o "${GEOIP_FILE}.gz" 2>/dev/null; then
127:                 gunzip -f "${GEOIP_FILE}.gz" 2>/dev/null || true
128:                 chown nftban:nftban "$GEOIP_FILE" 2>/dev/null || true
129:                 chmod 644 "$GEOIP_FILE"
130:                 echo "GeoIP database downloaded"
131:             else
132:                 echo "GeoIP download failed (will retry on first use)"
133:             fi
134:         fi
135: 
136:         # 2. Enable Login Monitoring
137:         if [ -f "${NFTBAN_CONFIG_DIR}/nftban.conf" ]; then
138:             sed -i 's/^NFTBAN_LOGIN_ALERT_ENABLED=.*/NFTBAN_LOGIN_ALERT_ENABLED="true"/' "${NFTBAN_CONFIG_DIR}/nftban.conf" 2>/dev/null || true
139:             sed -i 's/^NFTBAN_LOGIN_ALERT_SSH=.*/NFTBAN_LOGIN_ALERT_SSH="true"/' "${NFTBAN_CONFIG_DIR}/nftban.conf" 2>/dev/null || true
140:         fi
141:         systemctl enable nftban-login-monitor.service >/dev/null 2>&1 || true
142:         systemctl start nftban-login-monitor.service >/dev/null 2>&1 || true
143: 
144:         # 3. Enable GeoIP Blocking
145:         if [ -f "${NFTBAN_CONFIG_DIR}/nftban.conf" ]; then
146:             sed -i 's/^NFTBAN_GEOIP_ENABLED=.*/NFTBAN_GEOIP_ENABLED="true"/' "${NFTBAN_CONFIG_DIR}/nftban.conf" 2>/dev/null || true
147:         fi
148: 
149:         # 4. Enable core timers (health, maintenance)
150:         for timer in nftban-health.timer nftban-maintenance.timer; do
151:             systemctl enable "$timer" >/dev/null 2>&1 || true
152:             systemctl start "$timer" >/dev/null 2>&1 || true
153:         done
154: 
155:         echo ""
156:         echo "NFTBan installed successfully!"
157:         echo ""
158:         echo "Auto-enabled:"
159:         echo "  - Login monitoring (SSH alerts)"
160:         echo "  - GeoIP blocking"
161:         echo "  - Core timers (health, maintenance)"
162:         echo ""
163:         echo "Enable optional features:"
164:         echo "  nftban feeds enable      # Threat intel feeds"
165:         echo "  nftban portscan enable   # Port scan detection"
166:         echo "  nftban ddos enable       # DDoS protection"
167:         echo "  nftban gui enable        # Web GUI"
168:         echo "  nftban metrics enable    # Metrics collection"
169:     ;;
170: 
171:     abort-upgrade|abort-remove|abort-deconfigure)
172:     ;;
173: 
174:     *)
175:         echo "postinst called with unknown argument \`$1'" >&2
176:         exit 1
177:     ;;
178: esac
179: 
180: exit 0
</file>

<file path="install/packaging/deb/nftban.postrm">
 1: #!/bin/bash
 2: # SPDX-License-Identifier: MPL-2.0
 3: # SPDX-FileCopyrightText: Copyright (c) 2024-2025 NFTBan Development Team
 4: #
 5: # postrm script for nftban (main package)
 6: # Cleanup after removal
 7: 
 8: set -e
 9: 
10: case "$1" in
11:     purge)
12:         echo "Purging NFTBan data..."
13: 
14:         # Remove config files
15:         rm -rf /etc/nftban 2>/dev/null || true
16: 
17:         # Remove data files
18:         rm -rf /var/lib/nftban 2>/dev/null || true
19: 
20:         # Remove logs
21:         rm -rf /var/log/nftban 2>/dev/null || true
22: 
23:         # Remove cache
24:         rm -rf /var/cache/nftban 2>/dev/null || true
25: 
26:         # Remove runtime
27:         rm -rf /run/nftban 2>/dev/null || true
28: 
29:         # Remove nftables table (optional - may want to keep firewall rules)
30:         if command -v nft &>/dev/null; then
31:             nft delete table inet nftban 2>/dev/null || true
32:         fi
33: 
34:         # Remove user and group (optional)
35:         if getent passwd nftban &>/dev/null; then
36:             userdel nftban 2>/dev/null || true
37:         fi
38:         if getent group nftban &>/dev/null; then
39:             groupdel nftban 2>/dev/null || true
40:         fi
41:         if getent group nftban-auditors &>/dev/null; then
42:             groupdel nftban-auditors 2>/dev/null || true
43:         fi
44: 
45:         echo "NFTBan data purged."
46:     ;;
47: 
48:     remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
49:         # Reload systemd daemon
50:         if [ -d /run/systemd/system ]; then
51:             systemctl daemon-reload >/dev/null 2>&1 || true
52:         fi
53:     ;;
54: 
55:     *)
56:         echo "postrm called with unknown argument \`$1'" >&2
57:         exit 1
58:     ;;
59: esac
60: 
61: exit 0
</file>

<file path="install/packaging/deb/nftban.prerm">
 1: #!/bin/bash
 2: # SPDX-License-Identifier: MPL-2.0
 3: # SPDX-FileCopyrightText: Copyright (c) 2024-2025 NFTBan Development Team
 4: #
 5: # prerm script for nftban (main package)
 6: # Stops all services before removal
 7: 
 8: set -e
 9: 
10: case "$1" in
11:     remove|upgrade|deconfigure)
12:         echo "Stopping NFTBan services..."
13: 
14:         # Stop all timers first (complete list from install.sh)
15:         TIMERS=(
16:             "nftban-health.timer"
17:             "nftban-maintenance.timer"
18:             "nftban-watchdog.timer"
19:             "nftban-snapshot.timer"
20:             "nftban-rollback.timer"
21:             "nftban-metrics-exporter.timer"
22:             "nftban-suricata-update.timer"
23:             "nftban-queue.timer"
24:             "nftban-core-geoip.timer"
25:             "nftban-core-feeds.timer"
26:         )
27: 
28:         for timer in "${TIMERS[@]}"; do
29:             if systemctl is-active --quiet "$timer" 2>/dev/null; then
30:                 echo "  Stopping: $timer"
31:                 systemctl stop "$timer" 2>/dev/null || true
32:             fi
33:             if systemctl is-enabled --quiet "$timer" 2>/dev/null; then
34:                 systemctl disable "$timer" 2>/dev/null || true
35:             fi
36:         done
37: 
38:         # Stop login monitor
39:         if systemctl is-active --quiet nftban-login-monitor.service 2>/dev/null; then
40:             echo "  Stopping: nftban-login-monitor.service"
41:             systemctl stop nftban-login-monitor.service 2>/dev/null || true
42:         fi
43:         systemctl disable nftban-login-monitor.service 2>/dev/null || true
44: 
45:         # Stop core services
46:         SERVICES=(
47:             "nftban-ui.service"
48:             "nftban.service"
49:         )
50: 
51:         for svc in "${SERVICES[@]}"; do
52:             if systemctl is-active --quiet "$svc" 2>/dev/null; then
53:                 echo "  Stopping: $svc"
54:                 systemctl stop "$svc" 2>/dev/null || true
55:             fi
56:             systemctl disable "$svc" 2>/dev/null || true
57:         done
58: 
59:         echo "NFTBan services stopped."
60:     ;;
61: 
62:     failed-upgrade)
63:     ;;
64: 
65:     *)
66:         echo "prerm called with unknown argument \`$1'" >&2
67:         exit 1
68:     ;;
69: esac
70: 
71: exit 0
</file>

<file path="install/packaging/deb/postinst">
 1: #!/bin/bash
 2: # SPDX-License-Identifier: MPL-2.0
 3: # SPDX-FileCopyrightText: Copyright (c) 2024-2025 NFTBan Development Team
 4: #
 5: # postinst script for nftban-metrics
 6: # See: dh_installdeb(1)
 7: 
 8: set -e
 9: 
10: # Summary of how this script can be called:
11: #        * <postinst> `configure' <most-recently-configured-version>
12: #        * <old-postinst> `abort-upgrade' <new version>
13: #        * <conflictor's-postinst> `abort-remove' `in-favour' <package>
14: #          <new-version>
15: #        * <postinst> `abort-remove'
16: #        * <deconfigured's-postinst> `abort-deconfigure' `in-favour'
17: #          <failed-install-package> <version> `removing'
18: #          <conflicting-package> <version>
19: # for details, see https://www.debian.org/doc/debian-policy/ or
20: # the debian-policy package
21: 
22: case "$1" in
23:     configure)
24:         # Create textfile collector directory
25:         if [ ! -d "/var/lib/node_exporter/textfile_collector" ]; then
26:             echo "Creating Node Exporter textfile collector directory..."
27:             mkdir -p /var/lib/node_exporter/textfile_collector
28: 
29:             # Set ownership if nftban user exists
30:             if id -u nftban >/dev/null 2>&1; then
31:                 chown nftban:nftban /var/lib/node_exporter/textfile_collector
32:             else
33:                 echo "Warning: nftban user not found. Install nftban package first."
34:                 echo "Setting directory ownership to root for now."
35:                 chown root:root /var/lib/node_exporter/textfile_collector
36:             fi
37: 
38:             chmod 750 /var/lib/node_exporter/textfile_collector
39:         fi
40: 
41:         # Reload systemd to recognize new service files
42:         if [ -d /run/systemd/system ]; then
43:             echo "Reloading systemd daemon..."
44:             systemctl daemon-reload >/dev/null 2>&1 || true
45:         fi
46: 
47:         # Print installation success message
48:         echo ""
49:         echo "═══════════════════════════════════════════════════════════"
50:         echo "NFTBan v0.6 Metrics installed successfully!"
51:         echo "═══════════════════════════════════════════════════════════"
52:         echo ""
53:         echo "Next steps:"

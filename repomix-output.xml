 891: nftban_watchdog_cleanup_old() {
 892:     # Remove reports older than retention period
 893:     # Returns: number of files removed
 894: 
 895:     local retention_days="${NFTBAN_WATCHDOG_REPORT_RETENTION:-7}"
 896:     local removed=0
 897: 
 898:     if [[ -d "$NFTBAN_WATCHDOG_REPORT_DIR" ]]; then
 899:         while IFS= read -r -d '' file; do
 900:             rm -f "$file"
 901:             ((removed++))
 902:         done < <(find "$NFTBAN_WATCHDOG_REPORT_DIR" -name "*.report" -type f -mtime +"$retention_days" -print0 2>/dev/null)
 903:     fi
 904: 
 905:     watchdog_log "INFO" "Cleanup: removed $removed old reports (retention: ${retention_days} days)"
 906:     echo "$removed"
 907: }

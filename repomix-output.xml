613: 	} else {
614: 		fmt.Println("   Last sync: Never")
615: 	}
616: 	fmt.Printf("   Changed file: %s\n", changedFile)
617: 	fmt.Printf("   Modified: %s\n", time.Unix(latestModTime, 0).Format("2006-01-02 15:04:05"))
618: 	fmt.Println()
619: 
620: 	// Reload feeds

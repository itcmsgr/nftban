502: function displayStats(stats) {
503:     const container = document.getElementById('geoban-stats');
504: 
505:     if (!stats || Object.keys(stats).length === 0) {
506:         container.innerHTML = '<p class="text-center text-muted">No blocking statistics available</p>';
507:         return;
508:     }
509: 
510:     let html = '<table class="whitelist-table"><thead><tr><th>Country</th><th>Code</th><th>Blocks</th><th>Unique IPs</th><th>Last Block</th></tr></thead><tbody>';
511: 
512:     // Sort by blocks descending
513:     const sorted = Object.entries(stats).sort((a, b) => (b[1].blocks || 0) - (a[1].blocks || 0));
514: 
515:     sorted.forEach(([code, data]) => {
516:         const name = window.countryNames[code] || 'Unknown';
517:         const flag = window.countryFlags[code] || '🌍';
518:         const blocks = data.blocks || data || 0;
519:         const ips = data.unique_ips || 0;
520:         const lastBlock = data.last_block || '-';
521: 
522:         html += `
523:             <tr>
524:                 <td><span style="font-size:20px;">${flag}</span> <strong>${name}</strong></td>
525:                 <td><strong>${code}</strong></td>
526:                 <td>${typeof blocks === 'number' ? blocks.toLocaleString() : blocks}</td>
527:                 <td>${ips.toLocaleString()}</td>
528:                 <td style="font-size:12px;">${lastBlock}</td>
529:             </tr>
530:         `;
531:     });
532: 
533:     html += '</tbody></table>';
534:     container.innerHTML = html;
535: }

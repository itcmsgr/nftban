212:                                         Loading connections...
213:                                     </td>
214:                                 </tr>
215:                             </tbody>
216:                         </table>
217:                     </div>
218:                 </div>
219:             </div>
220:         </div>
221:     </div>
222: 
223:     <!-- Load JavaScript -->

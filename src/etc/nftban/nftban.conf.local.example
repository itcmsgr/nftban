# =============================================================================
# NFTBan User Customizations (Example)
# =============================================================================
# Version: 0.10.0
#
# ⚠️  This file is NEVER touched by package upgrades
# ⚠️  Your customizations here are safe during updates
#
# Instructions:
#   1. Copy this file:
#      sudo cp /etc/nftban/nftban.conf.local.example \
#             /etc/nftban/nftban.conf.local
#
#   2. Edit your copy:
#      sudo nano /etc/nftban/nftban.conf.local
#
#   3. Uncomment and modify settings below
#
# =============================================================================

# =============================================================================
# Common Customizations
# =============================================================================

# Enable debug mode for troubleshooting
#NFTBAN_DEBUG_MODE="true"

# Banner settings (set in conf.d/banner.conf, can override here)
#NFTBAN_BANNER_MODE="simple"           # simple, full, minimal, none, auto
#NFTBAN_MODULE_LOAD_LEVEL="info"       # none, error, info, debug, verbose
#NFTBAN_COLOR="true"                   # true, false, auto

# =============================================================================
# DDoS Protection Overrides
# =============================================================================
# Override values from conf.d/ddos.conf
# All configs in conf.d/ are OVERWRITTEN during updates - use .local for custom values!

# Enable/Disable DDoS Protection
#DDOS_PROTECTION_ENABLED="true"

# Connection Limits (per IP)
#DDOS_CONNLIMIT_SSH="10"         # SSH connections per IP (default: 5)
#DDOS_CONNLIMIT_HTTP="150"       # HTTP connections per IP (default: 20)
#DDOS_CONNLIMIT_HTTPS="150"      # HTTPS connections per IP (default: 20)
#DDOS_CONNLIMIT_FTP="5"          # FTP connections per IP (default: 3)
#DDOS_CONNLIMIT_SMTP="10"        # SMTP connections per IP (default: 5)

# Port Flood Limits (connections/seconds)
#DDOS_PORTFLOOD_SSH="10/300"     # SSH: 10 conn per 300s (default: 5/300)
#DDOS_PORTFLOOD_HTTP="50/5"      # HTTP: 50 conn per 5s (default: 20/5)
#DDOS_PORTFLOOD_HTTPS="50/5"     # HTTPS: 50 conn per 5s (default: 20/5)

# =============================================================================
# Feeds Overrides
# =============================================================================
# Override values from conf.d/feeds.conf
# All configs in conf.d/ are OVERWRITTEN during updates - use .local for custom values!

# Auto-update feeds
#FEEDS_AUTO_UPDATE="true"
#FEEDS_UPDATE_INTERVAL="3600"    # Seconds between updates (default: 1 hour)

# =============================================================================
# GeoIP Overrides
# =============================================================================
# Override values from conf.d/geoip.conf
# All configs in conf.d/ are OVERWRITTEN during updates - use .local for custom values!

# MaxMind License Key (required for GeoIP downloads)
#MAXMIND_LICENSE_KEY="your_license_key_here"
#GEOIP_AUTO_UPDATE="true"

# =============================================================================
# Mail Overrides
# =============================================================================
# Override values from conf.d/mail.conf
# All configs in conf.d/ are OVERWRITTEN during updates - use .local for custom values!

# Email settings
#MAIL_ENABLED="true"
#MAIL_FROM="nftban@example.com"
#MAIL_TO="admin@example.com"
#MAIL_SMTP_SERVER="localhost"

# =============================================================================
# Advanced Settings (Usually Not Needed)
# =============================================================================

# Override FHS paths (not recommended unless you know what you're doing)
#NFTBAN_STATE_DIR="/custom/var/lib/nftban"
#NFTBAN_LOG_DIR="/custom/var/log/nftban"

# =============================================================================
# Custom Variables
# =============================================================================
# Add your own custom variables below for use in scripts

#MY_CUSTOM_SETTING="value"

# =============================================================================
# End of Example Configuration
# =============================================================================

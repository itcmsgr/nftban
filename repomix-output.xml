10: table ip nftban {
11:     # =========================================================================
12:     # SETS - Managed by nftban-core sync
13:     # =========================================================================
14: 
15:     # Whitelist (admin IPs + internal networks)
16:     set whitelist_ipv4 {
17:         type ipv4_addr
18:         flags interval
19:         comment "Permanent IPv4 whitelist"
20:     }
21: 
22:     # Blacklist (ALL sources consolidated: manual + feeds + geoban)
23:     # Supports both permanent and temporary bans via timeout parameter
24:     set blacklist_ipv4 {

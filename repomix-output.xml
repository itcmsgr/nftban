335: # =============================================================================
336: 
337: main() {
338:     # Check if running as root (some commands need it)
339:     if [[ $EUID -ne 0 ]]; then
340:         warn "Not running as root - some tests may fail"
341:         read -p "Continue anyway? [y/N] " -n 1 -r
342:         echo
343:         if [[ ! $REPLY =~ ^[Yy]$ ]]; then
344:             exit 1
345:         fi
346:     fi
347: 
348:     # Initialize log
349:     echo "NFTBan Command Test Suite - $(date)" > "$TEST_LOG"
350:     echo "============================================" >> "$TEST_LOG"
351:     echo "" >> "$TEST_LOG"
352: 
353:     # Run tests
354:     run_all_tests
355: 
356:     # Generate report
357:     generate_report
358: }
359: 
360: # Run if executed directly
361: if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
362:     main "$@"

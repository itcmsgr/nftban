3121: // RecentActivityHandler returns recent ban/unban/feed activity
3122: // GET /api/v1/activity/recent?limit=10
3123: func RecentActivityHandler(w http.ResponseWriter, r *http.Request) {
3124: 	limitStr := r.URL.Query().Get("limit")
3125: 	limit := 10
3126: 	if limitStr != "" {
3127: 		if l, err := strconv.Atoi(limitStr); err == nil && l > 0 && l <= 100 {
3128: 			limit = l
3129: 		}
3130: 	}
3131: 
3132: 	var activities []RecentActivity
3133: 
3134: 	// Read from nftban-actions.log (JSONL format) - use central config
3135: 	// NO FALLBACK - path must come from /etc/nftban/nftban.conf
3136: 	paths := nftbanconf.MustLoadPaths()
3137: 	logPath := paths.AuditLog
3138: 	if logPath == "" {
3139: 		logPath = getLogDir() + "/nftban-actions.log"
3140: 	}
3141: 	file, err := os.Open(logPath)
3142: 	if err != nil {
3143: 		log.Printf("[ACTIVITY] Failed to open actions log: %v", err)
3144: 		// Return empty array on error (not an API error)
3145: 		respondJSON(w, http.StatusOK, map[string]interface{}{
3146: 			"success": true,
3147: 			"data": map[string]interface{}{
3148: 				"activities": []RecentActivity{},
3149: 			},
3150: 		})
3151: 		return
3152: 	}
3153: 	defer file.Close()
3154: 
3155: 	// Read all lines and take the last N
3156: 	var lines []string
3157: 	scanner := bufio.NewScanner(file)
3158: 	for scanner.Scan() {
3159: 		lines = append(lines, scanner.Text())
3160: 	}
3161: 
3162: 	// Take last N lines (most recent)
3163: 	start := 0
3164: 	if len(lines) > limit {
3165: 		start = len(lines) - limit
3166: 	}
3167: 
3168: 	now := time.Now()
3169: 	for i := len(lines) - 1; i >= start; i-- {
3170: 		var entry map[string]interface{}
3171: 		if err := json.Unmarshal([]byte(lines[i]), &entry); err != nil {
3172: 			continue
3173: 		}
3174: 
3175: 		activity := RecentActivity{}
3176: 
3177: 		// Parse timestamp
3178: 		if ts, ok := entry["ts"].(string); ok {
3179: 			activity.Timestamp = ts
3180: 			// Calculate time ago
3181: 			if t, err := time.Parse(time.RFC3339, ts); err == nil {
3182: 				diff := now.Sub(t)
3183: 				if diff.Minutes() < 1 {
3184: 					activity.TimeAgo = "just now"
3185: 				} else if diff.Minutes() < 60 {
3186: 					activity.TimeAgo = fmt.Sprintf("%.0fm", diff.Minutes())
3187: 				} else if diff.Hours() < 24 {
3188: 					activity.TimeAgo = fmt.Sprintf("%.0fh", diff.Hours())
3189: 				} else {
3190: 					activity.TimeAgo = fmt.Sprintf("%.0fd", diff.Hours()/24)
3191: 				}
3192: 			}
3193: 		}
3194: 
3195: 		// Parse event type
3196: 		if event, ok := entry["event"].(string); ok {
3197: 			activity.Action = event
3198: 		}
3199: 
3200: 		// Parse source (portscan, ddos, fail2ban, feeds, manual, etc.)
3201: 		if source, ok := entry["source"].(string); ok {
3202: 			activity.Source = source
3203: 			// Map source to display type
3204: 			switch source {
3205: 			case "portscan":
3206: 				activity.Type = "Port scan"
3207: 			case "ddos":
3208: 				activity.Type = "DDoS blocked"
3209: 			case "fail2ban":
3210: 				activity.Type = "Fail2Ban"
3211: 			case "feeds", "feed":
3212: 				activity.Type = "Feed update"
3213: 			case "manual":
3214: 				activity.Type = "Manual"
3215: 			case "whitelist":
3216: 				activity.Type = "Whitelisted"
3217: 			case "login_monitor":
3218: 				activity.Type = "Login alert"
3219: 			default:
3220: 				activity.Type = source
3221: 			}
3222: 		}
3223: 
3224: 		// Parse IP
3225: 		if ip, ok := entry["ip"].(string); ok {
3226: 			activity.IP = ip
3227: 			activity.Details = ip
3228: 		}
3229: 
3230: 		// Parse additional details
3231: 		if reason, ok := entry["reason"].(string); ok {
3232: 			activity.Details = reason
3233: 		}
3234: 
3235: 		activities = append(activities, activity)
3236: 	}
3237: 
3238: 	respondJSON(w, http.StatusOK, map[string]interface{}{
3239: 		"success": true,
3240: 		"data": map[string]interface{}{
3241: 			"activities": activities,
3242: 		},
3243: 	})
3244: }

 522: nftban_nft_validate_set_flags() {
 523:     # Validate sets have correct type and flags
 524:     # Returns: 0 if valid, 1 if invalid
 525: 
 526:     local status=0
 527:     local set_name set_spec expected_type expected_flags
 528:     local actual_type actual_flags
 529: 
 530:     # Validate IPv4 sets
 531:     for set_name in "${!NFTBAN_IPV4_SETS[@]}"; do
 532:         set_spec="${NFTBAN_IPV4_SETS[$set_name]}"
 533:         IFS='|' read -r expected_type expected_flags _ <<< "$set_spec"
 534: 
 535:         # Check if set exists
 536:         if ! nft list set ip nftban "$set_name" &>/dev/null; then
 537:             echo "ERROR: Missing set in ip nftban: $set_name" >&2
 538:             status=1
 539:             continue
 540:         fi
 541: 
 542:         # Get actual set properties
 543:         local set_info
 544:         set_info=$(nft list set ip nftban "$set_name" 2>/dev/null)
 545: 
 546:         # Check type
 547:         actual_type=$(echo "$set_info" | grep -oP 'type \K[a-z0-9_]+' | head -1 || echo "")
 548:         if [[ "$actual_type" != "$expected_type" ]]; then
 549:             echo "ERROR: Wrong type on ip nftban $set_name: expected '$expected_type', got '$actual_type'" >&2
 550:             status=1
 551:         fi
 552: 
 553:         # Check flags (if expected)
 554:         if [[ -n "$expected_flags" ]]; then
 555:             actual_flags=$(echo "$set_info" | grep -oP 'flags \K[a-z,]+' | head -1 || echo "")
 556:             # Sort flags for comparison
 557:             local sorted_expected sorted_actual
 558:             sorted_expected=$(echo "$expected_flags" | tr ',' '\n' | sort | tr '\n' ',' | sed 's/,$//')
 559:             sorted_actual=$(echo "$actual_flags" | tr ',' '\n' | sort | tr '\n' ',' | sed 's/,$//')
 560:             if [[ "$sorted_expected" != "$sorted_actual" ]]; then
 561:                 echo "WARNING: Different flags on ip nftban $set_name: expected '$expected_flags', got '$actual_flags'" >&2
 562:             fi
 563:         fi
 564:     done
 565: 
 566:     # Validate IPv6 sets
 567:     for set_name in "${!NFTBAN_IPV6_SETS[@]}"; do
 568:         set_spec="${NFTBAN_IPV6_SETS[$set_name]}"
 569:         IFS='|' read -r expected_type expected_flags _ <<< "$set_spec"
 570: 
 571:         # Check if set exists
 572:         if ! nft list set ip6 nftban "$set_name" &>/dev/null; then
 573:             echo "WARNING: Missing set in ip6 nftban: $set_name" >&2
 574:             continue
 575:         fi
 576: 
 577:         # Get actual set properties
 578:         local set_info
 579:         set_info=$(nft list set ip6 nftban "$set_name" 2>/dev/null)
 580: 
 581:         # Check type
 582:         actual_type=$(echo "$set_info" | grep -oP 'type \K[a-z0-9_]+' | head -1 || echo "")
 583:         if [[ "$actual_type" != "$expected_type" ]]; then
 584:             echo "WARNING: Wrong type on ip6 nftban $set_name: expected '$expected_type', got '$actual_type'" >&2
 585:         fi
 586:     done
 587: 
 588:     return $status
 589: }

225: // parseLoginStatsFromLog reads and parses the login log file
226: func parseLoginStatsFromLog() LoginMonitorStats {
227: 	stats := LoginMonitorStats{
228: 		Events:  LoginEventStats{},
229: 		Service: LoginServiceStats{},
230: 	}
231: 
232: 	logPath := getLoginAlertLogPath() // Use central config
233: 	file, err := os.Open(logPath)
234: 	if err != nil {
235: 		return stats
236: 	}
237: 	defer file.Close()
238: 
239: 	today := time.Now().Format("2006-01-02")
240: 	scanner := bufio.NewScanner(file)
241: 	for scanner.Scan() {
242: 		line := scanner.Text()
243: 		stats.Events.Total++
244: 
245: 		if strings.Contains(line, "SUCCESS") {
246: 			stats.Events.Success++
247: 		} else if strings.Contains(line, "FAILED") {
248: 			stats.Events.Failed++
249: 		}
250: 
251: 		if strings.Contains(line, today) {
252: 			stats.Events.Today++
253: 		}
254: 	}
255: 
256: 	// Check service status
257: 	output, err := execNFTBanCommand("login", "status")
258: 	if err == nil && strings.Contains(output, "Service: Running") {
259: 		stats.Service.Running = true
260: 	}
261: 
262: 	return stats
263: }

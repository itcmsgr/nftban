 139: nftban_stats_count_bans() {
 140:     # Count total bans in time window
 141:     # Usage: nftban_stats_count_bans [since] [until]
 142:     # Args: since=YYYY-MM-DD (default: 1970-01-01)
 143:     #       until=YYYY-MM-DD (default: today)
 144:     # Returns: Number of bans
 145: 
 146:     local since="${1:-1970-01-01}"
 147:     local until="${2:-$(date +%Y-%m-%d)}"
 148: 
 149:     if [[ ! -f "$NFTBAN_BAN_LOG" ]]; then
 150:         echo "0"
 151:         return 0
 152:     fi
 153: 
 154:     # Try cache first
 155:     local cache_key="bans_${since}_${until}"
 156:     if nftban_stats_get_cache "$cache_key"; then
 157:         return 0
 158:     fi
 159: 
 160:     # Count bans
 161:     local count
 162:     count=$(awk -F'|' -v since="$since" -v until="$until" \
 163:         '$1 >= since && $1 <= until && $6 == "BANNED" {count++} END {print count+0}' \
 164:         "$NFTBAN_BAN_LOG")
 165: 
 166:     # Cache result
 167:     nftban_stats_set_cache "$cache_key" "$count"
 168: 
 169:     echo "$count"
 170: }

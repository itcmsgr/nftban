[Unit]
Description=NFTBan Weekly Permission Audit Timer
Documentation=man:nftban(8) https://nftban.com
Requires=nftban-permissions-audit.service

[Timer]
# Run weekly on Sundays at 02:00 AM
OnCalendar=Sun *-*-* 02:00:00

# Add 30min jitter to avoid load spikes
RandomizedDelaySec=30m

# Persist timer across reboots (catchup if system was down)
Persistent=true

# Unit to activate
Unit=nftban-permissions-audit.service

[Install]
WantedBy=timers.target

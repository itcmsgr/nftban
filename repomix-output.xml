 539: 
 540:     # Load JSON helper for --json support (optional)
 541:     if [[ -f "${NFTBAN_LIB_DIR}/json_output.sh" ]]; then
 542:         # shellcheck source=/dev/null
 543:         source "${NFTBAN_LIB_DIR}/json_output.sh"
 544:     fi
 545: 
 546:     # Load grouped help system (optional, graceful fallback)
 547:     if [[ -f "${NFTBAN_LIB_DIR}/nftban_help.sh" ]]; then
 548:         # shellcheck source=/dev/null
 549:         source "${NFTBAN_LIB_DIR}/nftban_help.sh"

  89: # =============================================================================
  90: # MAIN CLI HANDLER
  91: # =============================================================================
  92: 
  93: nftban_cmd_stats() {
  94:     # Main stats command handler
  95:     # Usage: nftban stats [subcommand] [options]
  96: 
  97:     local subcommand="${1:-dashboard}"
  98: 
  99:     # If no args or help requested, show dashboard
 100:     case "$subcommand" in
 101:         help|--help|-h)
 102:             nftban_stats_cmd_help
 103:             return 0
 104:             ;;
 105:         dashboard|summary|"")
 106:             shift || true
 107:             nftban_stats_cmd_dashboard "$@"
 108:             ;;
 109:         top)
 110:             shift
 111:             nftban_stats_cmd_top "$@"
 112:             ;;
 113:         ip)
 114:             shift
 115:             nftban_stats_cmd_ip "$@"
 116:             ;;
 117:         recent)
 118:             shift
 119:             nftban_stats_cmd_recent "$@"
 120:             ;;
 121:         monitor)
 122:             shift || true
 123:             nftban_stats_cmd_monitor "$@"
 124:             ;;
 125:         export)
 126:             shift
 127:             nftban_stats_cmd_export "$@"
 128:             ;;
 129:         snapshot)
 130:             shift || true
 131:             nftban_stats_cmd_snapshot "$@"
 132:             ;;
 133:         cleanup)
 134:             shift || true
 135:             nftban_stats_cmd_cleanup "$@"
 136:             ;;
 137:         clear-cache)
 138:             shift || true
 139:             nftban_stats_clear_cache
 140:             ;;
 141:         check-alerts)
 142:             shift || true
 143:             nftban_stats_cmd_check_alerts "$@"
 144:             ;;
 145:         trend)
 146:             shift || true
 147:             nftban_stats_cmd_trend "$@"
 148:             ;;
 149:         --today)
 150:             # Show stats for today only
 151:             local today_start
 152:             today_start=$(date +%Y-%m-%d)
 153:             shift
 154:             nftban_stats_cmd_dashboard --since "$today_start" "$@"
 155:             ;;
 156:         --week)
 157:             # Show stats for last 7 days
 158:             local week_start
 159:             week_start=$(date -d "7 days ago" +%Y-%m-%d)
 160:             shift
 161:             nftban_stats_cmd_dashboard --since "$week_start" "$@"
 162:             ;;
 163:         *)
 164:             # If it looks like an option, pass to dashboard
 165:             if [[ "$subcommand" =~ ^-- ]]; then
 166:                 nftban_stats_cmd_dashboard "$@"
 167:             else
 168:                 echo "ERROR: Unknown stats command: $subcommand" >&2
 169:                 echo "Run 'nftban stats help' for usage information" >&2
 170:                 return 1
 171:             fi
 172:             ;;
 173:     esac
 174: }

1497:                 if [[ -n "$completion_src" && -f "$completion_src" ]]; then
1498:                     mkdir -p "$(dirname "$nftban_completion")"
1499:                     if cp "$completion_src" "$nftban_completion"; then
1500:                         chmod 644 "$nftban_completion"
1501:                         completion_issues+=("Bash completion was missing - AUTO-HEALED: installed")
1502:                         status=$HEALTH_WARNING

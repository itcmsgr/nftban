 238: backup_firewall_rules() {
 239:     # Create backup directory
 240:     local backup_dir="/var/backups/nftban/firewall-migration"
 241:     local timestamp
 242:     timestamp=$(date +"%Y%m%d-%H%M%S")
 243:     local backup_path="${backup_dir}/${timestamp}"
 244: 
 245:     mkdir -p "$backup_path" 2>/dev/null || {
 246:         warn "Could not create backup directory at $backup_path"
 247:         return 1
 248:     }
 249: 
 250:     log "Backing up existing firewall rules to: $backup_path"
 251: 
 252:     # Backup iptables rules
 253:     if command -v iptables-save &>/dev/null; then
 254:         if iptables-save > "${backup_path}/iptables-rules.v4" 2>/dev/null; then
 255:             ok "Backed up IPv4 iptables rules"
 256:         fi
 257:     fi
 258: 
 259:     if command -v ip6tables-save &>/dev/null; then
 260:         if ip6tables-save > "${backup_path}/iptables-rules.v6" 2>/dev/null; then
 261:             ok "Backed up IPv6 iptables rules"
 262:         fi
 263:     fi
 264: 
 265:     # Backup UFW rules
 266:     if command -v ufw &>/dev/null && [[ -d /etc/ufw ]]; then
 267:         if tar czf "${backup_path}/ufw-config.tar.gz" /etc/ufw 2>/dev/null; then
 268:             ok "Backed up UFW configuration"
 269:         fi
 270: 
 271:         # Export UFW status
 272:         ufw status verbose > "${backup_path}/ufw-status.txt" 2>/dev/null || true
 273:     fi
 274: 
 275:     # Backup firewalld configuration
 276:     if command -v firewall-cmd &>/dev/null && systemctl is-active --quiet firewalld 2>/dev/null; then
 277:         firewall-cmd --list-all-zones > "${backup_path}/firewalld-zones.txt" 2>/dev/null || true
 278:         firewall-cmd --list-all > "${backup_path}/firewalld-default-zone.txt" 2>/dev/null || true
 279: 
 280:         if [[ -d /etc/firewalld ]]; then
 281:             tar czf "${backup_path}/firewalld-config.tar.gz" /etc/firewalld 2>/dev/null && \
 282:                 ok "Backed up firewalld configuration"
 283:         fi
 284:     fi
 285: 
 286:     # Create README
 287:     cat > "${backup_path}/README.txt" <<EOF
 288: NFTBan Firewall Migration Backup
 289: =================================
 290: Date: $(date)
 291: Host: $(hostname)
 292: 
 293: This directory contains backups of your previous firewall configuration
 294: that was disabled during NFTBan installation.
 295: 
 296: ⚠️ IMPORTANT: NFTBan does NOT automatically migrate rules!
 297: 
 298: Files in this backup:
 299: - iptables-rules.v4      : IPv4 iptables rules
 300: - iptables-rules.v6      : IPv6 iptables rules
 301: - ufw-config.tar.gz      : UFW configuration
 302: - ufw-status.txt         : UFW status output
 303: - firewalld-config.tar.gz: firewalld configuration
 304: - firewalld-zones.txt    : firewalld zones configuration
 305: 
 306: To manually review your old rules:
 307:   # For iptables:
 308:   less ${backup_path}/iptables-rules.v4
 309: 
 310:   # For UFW:
 311:   cat ${backup_path}/ufw-status.txt
 312: 
 313:   # For firewalld:
 314:   cat ${backup_path}/firewalld-zones.txt
 315: 
 316: To recreate rules in NFTBan, see:
 317:   https://github.com/itcmsgr/nftban/wiki/Migrating-from-iptables-UFW-firewalld
 318: 
 319: For help: https://github.com/itcmsgr/nftban/issues
 320: EOF
 321: 
 322:     chmod 600 "${backup_path}"/* 2>/dev/null || true
 323: 
 324:     info "Backup completed: $backup_path"
 325:     echo ""
 326:     return 0
 327: }

<file path="install/nftables/nftables.conf">
  1: #!/usr/sbin/nft -f
  2: # =============================================================================
  3: # NFTBan v0.7.3 - CLEAN Schema-Compliant Configuration
  4: # =============================================================================
  5: # This config matches nft_schema.sh EXACTLY - no deprecated features
  6: #
  7: # Architecture:
  8: # - TWO TABLES: ip nftban (IPv4) + ip6 nftban (IPv6)
  9: # - UNIFIED BLACKLIST: One set per family (permanent + temporary with timeout)
 10: # - NO temp_whitelist, NO runtime_in, NO helper chains
 11: # - THREE BASE CHAINS: input, forward, output
 12: # =============================================================================
 13: 
 14: flush ruleset
 15: 
 16: # =============================================================================
 17: # IPv4 TABLE: ip nftban
 18: # =============================================================================
 19: 
 20: table ip nftban {
 21:     # =========================================================================
 22:     # SETS (as defined in nft_schema.sh)
 23:     # =========================================================================
 24: 
 25:     # Whitelist - ALL trusted IPs
 26:     set whitelist_ipv4 {
 27:         type ipv4_addr
 28:         flags interval
 29:         comment "Whitelist (admin IPs + internal networks)"
 30:         elements = {
 31:             127.0.0.1,
 32:             10.0.0.0/8,
 33:             172.16.0.0/12,
 34:             192.168.0.0/16
 35:         }
 36:     }
 37: 
 38:     # Unified Blacklist - permanent AND temporary bans
 39:     # Temporary bans use timeout parameter (auto-expire)
 40:     # Note: auto-merge removed for nftables < 1.1.0 compatibility
 41:     set blacklist_ipv4 {
 42:         type ipv4_addr
 43:         flags interval, timeout
 44:         comment "Blacklist (permanent + temporary with timeout)"
 45:     }
 46: 
 47:     # Public TCP ports
 48:     set tcp_ports {
 49:         type inet_service
 50:         comment "Allowed TCP ports"
 51:         elements = { 22, 80, 443 }
 52:     }
 53: 
 54:     # Public UDP ports
 55:     set udp_ports {
 56:         type inet_service
 57:         comment "Allowed UDP ports"
 58:     }
 59: 
 60:     # =========================================================================
 61:     # BASE CHAINS (as defined in nft_schema.sh)
 62:     # =========================================================================
 63: 
 64:     chain input {
 65:         type filter hook input priority filter
 66:         policy drop
 67: 
 68:         # 1. Drop invalid connections FIRST
 69:         ct state invalid counter drop comment "invalid state"
 70: 
 71:         # 2. Allow loopback
 72:         iif "lo" counter accept comment "loopback"
 73: 
 74:         # 3. Whitelist (highest priority)
 75:         ip saddr @whitelist_ipv4 counter accept comment "whitelist"
 76: 
 77:         # 4. Blacklist (BEFORE established - security fix!)
 78:         ip saddr @blacklist_ipv4 counter drop comment "blacklist"
 79: 
 80:         # 5. Allow established/related (AFTER blacklist!)
 81:         ct state established,related counter accept comment "established"
 82: 
 83:         # 6. Helper chains (jump to optional protection modules)
 84:         jump portscan_detection comment "Portscan detection module"
 85:         jump ddos_protection comment "DDoS protection module"
 86: 
 87:         # 7. Allow ICMP
 88:         ip protocol icmp icmp type { echo-reply, destination-unreachable, echo-request, time-exceeded } counter accept comment "ICMPv4"
 89: 
 90:         # 8. Public TCP services
 91:         tcp dport @tcp_ports ct state new counter accept comment "TCP services"
 92: 
 93:         # 9. Public UDP services
 94:         udp dport @udp_ports ct state new counter accept comment "UDP services"
 95: 
 96:         # 10. Default deny (policy drop)
 97:         counter drop comment "default deny"
 98:     }
 99: 
100:     chain forward {
101:         type filter hook forward priority filter
102:         policy drop
103:     }
104: 
105:     chain output {
106:         type filter hook output priority filter
107:         policy accept
108:     }
109: 
110:     # =========================================================================
111:     # HELPER CHAINS (optional protection modules)
112:     # =========================================================================
113: 
114:     # Portscan detection - logs connection attempts for analysis
115:     chain portscan_detection {
116:         # Log SYN packets for portscan detection
117:         tcp flags syn ct state new limit rate 10/minute burst 20 packets \
118:             log prefix "nftban: portscan: "
119:         return
120:     }
121: 
122:     # DDoS protection - rate limits and connection limits
123:     chain ddos_protection {
124:         # SYN flood protection
125:         tcp flags syn tcp dport @tcp_ports \
126:             meter syn_flood size 65535 { ip saddr limit rate 10/second burst 20 packets } \
127:             return comment "SYN flood: rate ok"
128:         tcp flags syn tcp dport @tcp_ports drop comment "SYN flood: rate exceeded"
129: 
130:         # Connection limits per service
131:         tcp dport 22 ct state new ct count over 5 drop comment "SSH: max 5 connections per IP"
132:         tcp dport { 80, 443 } ct state new ct count over 50 drop comment "HTTP/HTTPS: max 50 connections per IP"
133: 
134:         # ICMP rate limit
135:         ip protocol icmp meter icmp_flood size 65535 { ip saddr limit rate 10/second burst 20 packets } \
136:             return comment "ICMP: rate ok"
137:         ip protocol icmp drop comment "ICMP flood: rate exceeded"
138: 
139:         return
140:     }
141: }
142: 
143: # =============================================================================
144: # IPv6 TABLE: ip6 nftban
145: # =============================================================================
146: 
147: table ip6 nftban {
148:     # =========================================================================
149:     # SETS (as defined in nft_schema.sh)
150:     # =========================================================================
151: 
152:     # Whitelist - ALL trusted IPs
153:     set whitelist_ipv6 {
154:         type ipv6_addr
155:         flags interval
156:         comment "Whitelist IPv6 (admin IPs + internal networks)"
157:         elements = { ::1, fc00::/7 }
158:     }
159: 
160:     # Unified Blacklist - permanent AND temporary bans
161:     # Note: auto-merge removed for nftables < 1.1.0 compatibility
162:     set blacklist_ipv6 {
163:         type ipv6_addr
164:         flags interval, timeout
165:         comment "Blacklist IPv6 (permanent + temporary with timeout)"
166:     }
167: 
168:     # Public TCP ports
169:     set tcp_ports {
170:         type inet_service
171:         comment "Allowed TCP ports"
172:         elements = { 22, 80, 443 }
173:     }
174: 
175:     # Public UDP ports
176:     set udp_ports {
177:         type inet_service
178:         comment "Allowed UDP ports"
179:     }
180: 
181:     # =========================================================================
182:     # BASE CHAINS (as defined in nft_schema.sh)
183:     # =========================================================================
184: 
185:     chain input {
186:         type filter hook input priority filter
187:         policy drop
188: 
189:         # 1. Drop invalid connections FIRST
190:         ct state invalid counter drop comment "invalid state"
191: 
192:         # 2. Allow loopback
193:         iif "lo" counter accept comment "loopback"
194: 
195:         # 3. Whitelist (highest priority)
196:         ip6 saddr @whitelist_ipv6 counter accept comment "whitelist"
197: 
198:         # 4. Blacklist (BEFORE established - security fix!)
199:         ip6 saddr @blacklist_ipv6 counter drop comment "blacklist"
200: 
201:         # 5. Allow established/related (AFTER blacklist!)
202:         ct state established,related counter accept comment "established"
203: 
204:         # 6. Helper chains (jump to optional protection modules)
205:         jump portscan_detection comment "Portscan detection module"
206:         jump ddos_protection comment "DDoS protection module"
207: 
208:         # 7. Allow ICMPv6 (required for IPv6)
209:         ip6 nexthdr icmpv6 icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, echo-request, echo-reply, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } counter accept comment "ICMPv6"
210: 
211:         # 8. Public TCP services
212:         tcp dport @tcp_ports ct state new counter accept comment "TCP services"
213: 
214:         # 9. Public UDP services
215:         udp dport @udp_ports ct state new counter accept comment "UDP services"
216: 
217:         # 10. Default deny (policy drop)
218:         counter drop comment "default deny"
219:     }
220: 
221:     chain forward {
222:         type filter hook forward priority filter
223:         policy drop
224:     }
225: 
226:     chain output {
227:         type filter hook output priority filter
228:         policy accept
229:     }
230: 
231:     # =========================================================================
232:     # HELPER CHAINS (optional protection modules)
233:     # =========================================================================
234: 
235:     # Portscan detection - logs connection attempts for analysis
236:     chain portscan_detection {
237:         # Log SYN packets for portscan detection
238:         tcp flags syn ct state new limit rate 10/minute burst 20 packets \
239:             log prefix "nftban: portscan: "
240:         return
241:     }
242: 
243:     # DDoS protection - rate limits and connection limits
244:     chain ddos_protection {
245:         # SYN flood protection
246:         tcp flags syn tcp dport @tcp_ports \
247:             meter syn_flood size 65535 { ip6 saddr limit rate 10/second burst 20 packets } \
248:             return comment "SYN flood: rate ok"
249:         tcp flags syn tcp dport @tcp_ports drop comment "SYN flood: rate exceeded"
250: 
251:         # Connection limits per service
252:         tcp dport 22 ct state new ct count over 5 drop comment "SSH: max 5 connections per IP"
253:         tcp dport { 80, 443 } ct state new ct count over 50 drop comment "HTTP/HTTPS: max 50 connections per IP"
254: 
255:         # ICMPv6 rate limit
256:         ip6 nexthdr icmpv6 meter icmp_flood size 65535 { ip6 saddr limit rate 10/second burst 20 packets } \
257:             return comment "ICMPv6: rate ok"
258:         ip6 nexthdr icmpv6 drop comment "ICMPv6 flood: rate exceeded"
259: 
260:         return
261:     }
262: }

<file path="pkg/safety/limits.go">
  1: package safety
  2: 
  3: import (
  4: 	"os"
  5: 	"runtime"
  6: 	"strconv"
  7: )
  8: 
  9: // Limits holds all safety thresholds for the GUI server
 10: type Limits struct {
 11: 	// GOMAXPROCS limit (CPU cores)
 12: 	GoMaxProcs int // default: 2
 13: 
 14: 	// Connection limits
 15: 	MaxConcurrentConns int // default: 100
 16: 	MaxConnsPerIP      int // default: 10
 17: 
 18: 	// Request limits
 19: 	RequestTimeoutSec  int   // default: 30
 20: 	MaxRequestBodyMB   int   // default: 10
 21: 	MaxRequestBodyBytes int64 // computed from MB
 22: 
 23: 	// Rate limiting
 24: 	RateLimitPerMin int // default: 60 requests per minute per IP
 25: 
 26: 	// Memory limits
 27: 	MaxMemoryPercent int   // default: 20% of available
 28: 	MaxMemoryBytes   int64 // default: 512 MiB
 29: 
 30: 	// Logging
 31: 	EnableMetrics bool // default: true
 32: }
 33: 
 34: func getEnvInt(k string, def int) int {
 35: 	if v := os.Getenv(k); v != "" {
 36: 		if n, err := strconv.Atoi(v); err == nil {
 37: 			return n
 38: 		}
 39: 	}
 40: 	return def
 41: }
 42: 
 43: func getEnvInt64(k string, def int64) int64 {
 44: 	if v := os.Getenv(k); v != "" {
 45: 		if n, err := strconv.ParseInt(v, 10, 64); err == nil {
 46: 			return n
 47: 		}
 48: 	}
 49: 	return def
 50: }
 51: 
 52: func getEnvBool(k string, def bool) bool {
 53: 	if v := os.Getenv(k); v != "" {
 54: 		return v == "1" || v == "true" || v == "yes"
 55: 	}
 56: 	return def
 57: }
 58: 
 59: // FromEnv returns sane defaults that can be overridden via environment variables
 60: // This matches the pattern from go-feeds/internal/safety/config.go
 61: func FromEnv() Limits {
 62: 	// Get max request body MB and convert to bytes
 63: 	maxBodyMB := getEnvInt("NFTBAN_MAX_REQUEST_BODY_MB", 10)
 64: 	maxBodyBytes := int64(maxBodyMB) << 20 // MB to bytes
 65: 
 66: 	return Limits{
 67: 		GoMaxProcs:          getEnvInt("NFTBAN_GOMAXPROCS", 2),
 68: 		MaxConcurrentConns:  getEnvInt("NFTBAN_MAX_CONCURRENT_CONNS", 100),
 69: 		MaxConnsPerIP:       getEnvInt("NFTBAN_MAX_CONNS_PER_IP", 10),
 70: 		RequestTimeoutSec:   getEnvInt("NFTBAN_REQUEST_TIMEOUT_SEC", 30),
 71: 		MaxRequestBodyMB:    maxBodyMB,
 72: 		MaxRequestBodyBytes: maxBodyBytes,
 73: 		RateLimitPerMin:     getEnvInt("NFTBAN_RATE_LIMIT_PER_MIN", 60),
 74: 		MaxMemoryPercent:    getEnvInt("NFTBAN_MAX_MEMORY_PERCENT", 20),
 75: 		MaxMemoryBytes:      getEnvInt64("NFTBAN_MAX_MEMORY_BYTES", 512<<20), // 512 MiB
 76: 		EnableMetrics:       getEnvBool("NFTBAN_ENABLE_METRICS", true),
 77: 	}
 78: }
 79: 
 80: // InitCPU sets GOMAXPROCS based on config
 81: // This prevents the Go server from consuming all CPU cores
 82: func InitCPU(lim Limits) {
 83: 	if lim.GoMaxProcs > 0 {
 84: 		runtime.GOMAXPROCS(lim.GoMaxProcs)
 85: 	}
 86: }
 87: 
 88: // InitMemory sets memory limit based on config
 89: // Uses runtime/debug SetMemoryLimit (Go 1.19+)
 90: func InitMemory(lim Limits) {
 91: 	// Get available memory
 92: 	mem := AvailableMem()
 93: 
 94: 	// Calculate target memory limit
 95: 	var targetLimit int64
 96: 
 97: 	// Use percentage of available if set
 98: 	if lim.MaxMemoryPercent > 0 && mem.Avail > 0 {
 99: 		targetLimit = (mem.Avail * int64(lim.MaxMemoryPercent)) / 100
100: 	}
101: 
102: 	// Apply absolute cap if set and smaller
103: 	if lim.MaxMemoryBytes > 0 && (targetLimit == 0 || lim.MaxMemoryBytes < targetLimit) {
104: 		targetLimit = lim.MaxMemoryBytes
105: 	}
106: 
107: 	// Set memory limit (Go 1.19+ soft limit)
108: 	if targetLimit > 0 {
109: 		// Note: debug.SetMemoryLimit() is available in Go 1.19+
110: 		// This is a soft limit - Go will try to stay under but may exceed briefly
111: 		// For older Go versions, this would need conditional compilation
112: 		// For now, we document the limit but don't enforce it hard
113: 		// runtime/debug.SetMemoryLimit(targetLimit)
114: 	}
115: }

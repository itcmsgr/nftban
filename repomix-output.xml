 13: // Body: { "add": ["1.2.3.4", "5.6.7.8"], "remove": ["9.9.9.9"] }
 14: func (api *API) HandleWhitelistIPv4Batch(w http.ResponseWriter, r *http.Request) {
 15: 	if r.Method != http.MethodPost {
 16: 		w.WriteHeader(http.StatusMethodNotAllowed)
 17: 		return
 18: 	}
 19: 
 20: 	var req BatchRequest
 21: 	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
 22: 		respondError(w, http.StatusBadRequest, "invalid JSON body: "+err.Error())
 23: 		return
 24: 	}
 25: 
 26: 	// Validate IPs

// meta:name="settings"
// meta:type="templ"
// meta:owner="Antonios Voulvoulis <contact@nftban.com>"
// meta:created_date="2026-02-06"
// meta:description="Settings configuration page for NFTBan GUI"
// =============================================================================

package pages

import (
	"github.com/itcmsgr/nftban/internal/ui"
)

// Settings renders the settings configuration page
templ Settings(data ui.SettingsData) {
	@ui.LayoutWithNav("Settings", "settings") {
		<!-- Page Header -->
		<div class="page-header">
			<h1 class="page-title">Settings</h1>
			<div style="display: flex; gap: 0.5rem; align-items: center;">
				<span id="settings-loading" class="htmx-indicator">
					<span class="loading-spinner"></span>
				</span>
				<button class="btn btn-secondary" type="button" hx-get="/ui/frag/settings-content" hx-target="#settings-content" hx-swap="innerHTML" hx-indicator="#settings-loading">
					Reload
				</button>
			</div>
		</div>

		<!-- Settings Form -->
		<form id="settings-form" hx-post="/ui/api/settings/save" hx-target="#settings-result" hx-swap="innerHTML" hx-indicator="#settings-loading">
			<div id="settings-content">
				@SettingsContentFragment(data)
			</div>

			<!-- Save/Reset Buttons -->
			<div class="card settings-actions" style="margin-top: 1.5rem;">
				<div style="display: flex; justify-content: space-between; align-items: center;">
					<div id="settings-result" style="flex: 1;"></div>
					<div style="display: flex; gap: 0.75rem;">
						<button type="button" class="btn btn-secondary" onclick="resetSettingsForm()">
							Reset to Defaults
						</button>
						<button type="submit" class="btn btn-primary">
							Save Settings
						</button>
					</div>
				</div>
			</div>
		</form>

		<script>
			function resetSettingsForm() {
				if (confirm('Reset all settings to their default values?')) {
					htmx.ajax('POST', '/ui/api/settings/reset', {target: '#settings-content', swap: 'innerHTML'});
				}
			}
		</script>
	}
}

// SettingsContentFragment renders all settings sections
templ SettingsContentFragment(data ui.SettingsData) {
	<div class="settings-grid">
		<!-- System Settings Section -->
		<div class="card">
			<div class="card-header">
				<span class="card-title">System Settings</span>
			</div>
			<div class="settings-section">
				<!-- Timezone -->
				<div class="setting-item">
					<div class="setting-info">
						<label class="setting-label" for="timezone">Timezone</label>
						<span class="setting-description">System timezone for log timestamps and scheduled tasks</span>
					</div>
					<div class="setting-control">
						<select id="timezone" name="timezone" class="form-select">
							<option value="UTC" selected?={ data.System.Timezone == "UTC" }>UTC</option>
							<option value="America/New_York" selected?={ data.System.Timezone == "America/New_York" }>America/New_York</option>
							<option value="America/Chicago" selected?={ data.System.Timezone == "America/Chicago" }>America/Chicago</option>
							<option value="America/Denver" selected?={ data.System.Timezone == "America/Denver" }>America/Denver</option>
							<option value="America/Los_Angeles" selected?={ data.System.Timezone == "America/Los_Angeles" }>America/Los_Angeles</option>
							<option value="Europe/London" selected?={ data.System.Timezone == "Europe/London" }>Europe/London</option>
							<option value="Europe/Paris" selected?={ data.System.Timezone == "Europe/Paris" }>Europe/Paris</option>
							<option value="Europe/Berlin" selected?={ data.System.Timezone == "Europe/Berlin" }>Europe/Berlin</option>
							<option value="Europe/Athens" selected?={ data.System.Timezone == "Europe/Athens" }>Europe/Athens</option>
							<option value="Asia/Tokyo" selected?={ data.System.Timezone == "Asia/Tokyo" }>Asia/Tokyo</option>
							<option value="Asia/Shanghai" selected?={ data.System.Timezone == "Asia/Shanghai" }>Asia/Shanghai</option>
							<option value="Asia/Singapore" selected?={ data.System.Timezone == "Asia/Singapore" }>Asia/Singapore</option>
							<option value="Australia/Sydney" selected?={ data.System.Timezone == "Australia/Sydney" }>Australia/Sydney</option>
						</select>
					</div>
				</div>

				<!-- Log Level -->
				<div class="setting-item">
					<div class="setting-info">
						<label class="setting-label" for="log_level">Log Level</label>
						<span class="setting-description">Verbosity level for NFTBan logging output</span>
					</div>
					<div class="setting-control">
						<select id="log_level" name="log_level" class="form-select">
							<option value="debug" selected?={ data.System.LogLevel == "debug" }>Debug</option>
							<option value="info" selected?={ data.System.LogLevel == "info" }>Info</option>
							<option value="warn" selected?={ data.System.LogLevel == "warn" }>Warning</option>
							<option value="error" selected?={ data.System.LogLevel == "error" }>Error</option>
						</select>
					</div>
				</div>

				<!-- Log Retention -->
				<div class="setting-item">
					<div class="setting-info">
						<label class="setting-label" for="log_retention">Log Retention (days)</label>
						<span class="setting-description">Number of days to keep log files before rotation</span>
					</div>
					<div class="setting-control">
						<input type="number" id="log_retention" name="log_retention" class="form-input" min="1" max="365" value={ intToStr(data.System.LogRetentionDays) }/>
					</div>
				</div>
			</div>
		</div>

		<!-- Security Settings Section -->
		<div class="card">
			<div class="card-header">
				<span class="card-title">Security Settings</span>
			</div>
			<div class="settings-section">
				<!-- Default Ban Duration -->
				<div class="setting-item">
					<div class="setting-info">
						<label class="setting-label" for="default_ban_duration">Default Ban Duration (hours)</label>
						<span class="setting-description">Default duration for temporary bans</span>
					</div>
					<div class="setting-control">
						<input type="number" id="default_ban_duration" name="default_ban_duration" class="form-input" min="1" max="8760" value={ intToStr(data.Security.DefaultBanDurationHours) }/>
					</div>
				</div>

				<!-- Permanent Ban Threshold -->
				<div class="setting-item">
					<div class="setting-info">
						<label class="setting-label" for="perm_ban_threshold">Permanent Ban Threshold</label>
						<span class="setting-description">Number of temporary bans before an IP is permanently banned</span>
					</div>
					<div class="setting-control">
						<input type="number" id="perm_ban_threshold" name="perm_ban_threshold" class="form-input" min="1" max="100" value={ intToStr(data.Security.PermBanThreshold) }/>
					</div>
				</div>

				<!-- Whitelist Management -->
				<div class="setting-item">
					<div class="setting-info">
						<label class="setting-label" for="whitelist_enabled">Whitelist Management</label>
						<span class="setting-description">Enable whitelist to protect specific IPs from being banned</span>
					</div>
					<div class="setting-control">
						<label class="toggle-switch">
							<input type="checkbox" id="whitelist_enabled" name="whitelist_enabled" checked?={ data.Security.WhitelistEnabled }/>
							<span class="toggle-slider"></span>
						</label>
					</div>
				</div>

				<!-- Auto-Whitelist Private -->
				<div class="setting-item">
					<div class="setting-info">
						<label class="setting-label" for="auto_whitelist_private">Auto-Whitelist Private IPs</label>
						<span class="setting-description">Automatically whitelist private/internal IP ranges (10.x, 192.168.x, etc.)</span>
					</div>
					<div class="setting-control">
						<label class="toggle-switch">
							<input type="checkbox" id="auto_whitelist_private" name="auto_whitelist_private" checked?={ data.Security.AutoWhitelistPrivate }/>
							<span class="toggle-slider"></span>
						</label>
					</div>
				</div>
			</div>
		</div>

		<!-- Notification Settings Section -->
		<div class="card">
			<div class="card-header">
				<span class="card-title">Notification Settings</span>
			</div>
			<div class="settings-section">
				<!-- Email Alerts -->
				<div class="setting-item">
					<div class="setting-info">
						<label class="setting-label" for="email_alerts_enabled">Email Alerts</label>
						<span class="setting-description">Send email notifications for critical security events</span>
					</div>
					<div class="setting-control">
						<label class="toggle-switch">
							<input type="checkbox" id="email_alerts_enabled" name="email_alerts_enabled" checked?={ data.Notifications.EmailEnabled }/>
							<span class="toggle-slider"></span>
						</label>
					</div>
				</div>

				<!-- Email Address -->
				<div class="setting-item">
					<div class="setting-info">
						<label class="setting-label" for="email_address">Email Address</label>
						<span class="setting-description">Recipient email address for alerts</span>
					</div>
					<div class="setting-control">
						<input type="email" id="email_address" name="email_address" class="form-input" placeholder="admin@example.com" value={ data.Notifications.EmailAddress }/>
					</div>
				</div>

				<!-- Webhook Enabled -->
				<div class="setting-item">
					<div class="setting-info">
						<label class="setting-label" for="webhook_enabled">Webhook Notifications</label>
						<span class="setting-description">Send event notifications to a webhook URL</span>
					</div>
					<div class="setting-control">
						<label class="toggle-switch">
							<input type="checkbox" id="webhook_enabled" name="webhook_enabled" checked?={ data.Notifications.WebhookEnabled }/>
							<span class="toggle-slider"></span>
						</label>
					</div>
				</div>

				<!-- Webhook URL -->
				<div class="setting-item">
					<div class="setting-info">
						<label class="setting-label" for="webhook_url">Webhook URL</label>
						<span class="setting-description">URL to receive webhook POST notifications (Slack, Discord, etc.)</span>
					</div>
					<div class="setting-control">
						<input type="url" id="webhook_url" name="webhook_url" class="form-input" placeholder="https://hooks.example.com/webhook" value={ data.Notifications.WebhookURL }/>
					</div>
				</div>

				<!-- Notify on Ban -->
				<div class="setting-item">
					<div class="setting-info">
						<label class="setting-label" for="notify_on_ban">Notify on Ban</label>
						<span class="setting-description">Send notification when an IP is banned</span>
					</div>
					<div class="setting-control">
						<label class="toggle-switch">
							<input type="checkbox" id="notify_on_ban" name="notify_on_ban" checked?={ data.Notifications.NotifyOnBan }/>
							<span class="toggle-slider"></span>
						</label>
					</div>
				</div>

				<!-- Notify on Health Warning -->
				<div class="setting-item">
					<div class="setting-info">
						<label class="setting-label" for="notify_on_health">Notify on Health Warning</label>
						<span class="setting-description">Send notification when health checks fail</span>
					</div>
					<div class="setting-control">
						<label class="toggle-switch">
							<input type="checkbox" id="notify_on_health" name="notify_on_health" checked?={ data.Notifications.NotifyOnHealth }/>
							<span class="toggle-slider"></span>
						</label>
					</div>
				</div>
			</div>
		</div>

		<!-- Module Toggles Section -->
		<div class="card">
			<div class="card-header">
				<span class="card-title">Module Toggles</span>
			</div>
			<div class="settings-section">
				<!-- Portscan Detection -->
				<div class="setting-item">
					<div class="setting-info">
						<label class="setting-label" for="module_portscan">Portscan Detection</label>
						<span class="setting-description">Detect and block port scanning attempts</span>
					</div>
					<div class="setting-control">
						<label class="toggle-switch">
							<input type="checkbox" id="module_portscan" name="module_portscan" checked?={ data.Modules.PortscanEnabled }/>
							<span class="toggle-slider"></span>
						</label>
					</div>
				</div>

				<!-- DDoS Protection -->
				<div class="setting-item">
					<div class="setting-info">
						<label class="setting-label" for="module_ddos">DDoS Protection</label>
						<span class="setting-description">Detect and mitigate DDoS attacks</span>
					</div>
					<div class="setting-control">
						<label class="toggle-switch">
							<input type="checkbox" id="module_ddos" name="module_ddos" checked?={ data.Modules.DDoSEnabled }/>
							<span class="toggle-slider"></span>
						</label>
					</div>
				</div>

				<!-- Login Monitor -->
				<div class="setting-item">
					<div class="setting-info">
						<label class="setting-label" for="module_login">Login Monitor</label>
						<span class="setting-description">Monitor and block failed SSH/login attempts</span>
					</div>
					<div class="setting-control">
						<label class="toggle-switch">
							<input type="checkbox" id="module_login" name="module_login" checked?={ data.Modules.LoginEnabled }/>
							<span class="toggle-slider"></span>
						</label>
					</div>
				</div>

				<!-- Threat Feeds -->
				<div class="setting-item">
					<div class="setting-info">
						<label class="setting-label" for="module_feeds">Threat Feeds</label>
						<span class="setting-description">Sync and block IPs from threat intelligence feeds</span>
					</div>
					<div class="setting-control">
						<label class="toggle-switch">
							<input type="checkbox" id="module_feeds" name="module_feeds" checked?={ data.Modules.FeedsEnabled }/>
							<span class="toggle-slider"></span>
						</label>
					</div>
				</div>

				<!-- GeoBan -->
				<div class="setting-item">
					<div class="setting-info">
						<label class="setting-label" for="module_geoban">GeoBan (Country Blocking)</label>
						<span class="setting-description">Block or allow traffic by country using GeoIP</span>
					</div>
					<div class="setting-control">
						<label class="toggle-switch">
							<input type="checkbox" id="module_geoban" name="module_geoban" checked?={ data.Modules.GeobanEnabled }/>
							<span class="toggle-slider"></span>
						</label>
					</div>
				</div>
			</div>
		</div>
	</div>

	<style>
		.settings-grid {
			display: grid;
			grid-template-columns: repeat(2, 1fr);
			gap: 1.5rem;
		}
		@media (max-width: 1200px) {
			.settings-grid {
				grid-template-columns: 1fr;
			}
		}

		.settings-section {
			display: flex;
			flex-direction: column;
			gap: 0;
		}

		.setting-item {
			display: flex;
			justify-content: space-between;
			align-items: center;
			padding: 1rem;
			border-bottom: 1px solid var(--border-color);
		}
		.setting-item:last-child {
			border-bottom: none;
		}

		.setting-info {
			display: flex;
			flex-direction: column;
			gap: 0.25rem;
			flex: 1;
			margin-right: 1rem;
		}

		.setting-label {
			font-weight: 500;
			color: var(--text-primary);
			font-size: 0.9rem;
		}

		.setting-description {
			font-size: 0.8rem;
			color: var(--text-muted);
		}

		.setting-control {
			flex-shrink: 0;
		}

		.form-input,
		.form-select {
			background: var(--bg-elevated);
			border: 1px solid var(--border-color);
			border-radius: 6px;
			padding: 0.5rem 0.75rem;
			color: var(--text-primary);
			font-size: 0.9rem;
			min-width: 180px;
		}
		.form-input:focus,
		.form-select:focus {
			outline: none;
			border-color: var(--accent-info);
			box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
		}
		.form-input[type="number"] {
			min-width: 100px;
		}

		/* Toggle Switch */
		.toggle-switch {
			position: relative;
			display: inline-block;
			width: 48px;
			height: 26px;
		}
		.toggle-switch input {
			opacity: 0;
			width: 0;
			height: 0;
		}
		.toggle-slider {
			position: absolute;
			cursor: pointer;
			top: 0;
			left: 0;
			right: 0;
			bottom: 0;
			background-color: var(--bg-elevated);
			border: 1px solid var(--border-color);
			transition: 0.3s;
			border-radius: 26px;
		}
		.toggle-slider:before {
			position: absolute;
			content: "";
			height: 20px;
			width: 20px;
			left: 2px;
			bottom: 2px;
			background-color: var(--text-muted);
			transition: 0.3s;
			border-radius: 50%;
		}
		.toggle-switch input:checked + .toggle-slider {
			background-color: var(--accent-safe);
			border-color: var(--accent-safe);
		}
		.toggle-switch input:checked + .toggle-slider:before {
			background-color: white;
			transform: translateX(22px);
		}
		.toggle-switch input:focus + .toggle-slider {
			box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
		}

		.settings-actions {
			padding: 1rem 1.5rem;
			background: var(--bg-surface);
		}

		/* Success/Error messages */
		.settings-result-success {
			color: var(--accent-safe);
			font-size: 0.9rem;
		}
		.settings-result-error {
			color: var(--accent-danger);
			font-size: 0.9rem;
		}
	</style>
}

// =============================================================================
// EXTENDED SETTINGS FRAGMENTS - For section-by-section HTMX updates
// =============================================================================

// SettingsGeneralFragment renders the general settings section
templ SettingsGeneralFragment(data ui.ExtendedSettingsData) {
	<div class="card">
		<div class="card-header">
			<span class="card-title">General Information</span>
		</div>
		<div class="settings-section">
			<div class="setting-item">
				<div class="setting-info">
					<label class="setting-label">NFTBan Version</label>
					<span class="setting-description">Current installed version</span>
				</div>
				<div class="setting-control">
					<span class="setting-value">{ data.General.Version }</span>
				</div>
			</div>
			<div class="setting-item">
				<div class="setting-info">
					<label class="setting-label">Config Version</label>
					<span class="setting-description">Configuration file format version</span>
				</div>
				<div class="setting-control">
					<span class="setting-value">{ data.General.ConfigVersion }</span>
				</div>
			</div>
			<div class="setting-item">
				<div class="setting-info">
					<label class="setting-label">Config Path</label>
					<span class="setting-description">Main configuration file location</span>
				</div>
				<div class="setting-control">
					<span class="setting-value monospace">{ data.ConfigPath }</span>
				</div>
			</div>
			<div class="setting-item">
				<div class="setting-info">
					<label class="setting-label">Last Modified</label>
					<span class="setting-description">When the config was last changed</span>
				</div>
				<div class="setting-control">
					<span class="setting-value">{ data.LastModified }</span>
				</div>
			</div>
		</div>
	</div>
}

// SettingsFeaturesFragment renders the feature toggles section
templ SettingsFeaturesFragment(data ui.ExtendedSettingsData) {
	<div class="card">
		<div class="card-header">
			<span class="card-title">Feature Toggles</span>
		</div>
		<div class="settings-section">
			<div class="setting-item">
				<div class="setting-info">
					<label class="setting-label" for="metrics_enabled">Metrics Collection</label>
					<span class="setting-description">Enable Prometheus/VictoriaMetrics metrics export</span>
				</div>
				<div class="setting-control">
					<label class="toggle-switch">
						<input type="checkbox" id="metrics_enabled" name="metrics_enabled" checked?={ data.Features.MetricsEnabled }/>
						<span class="toggle-slider"></span>
					</label>
				</div>
			</div>
			<div class="setting-item">
				<div class="setting-info">
					<label class="setting-label" for="geoip_enabled">GeoIP Blocking</label>
					<span class="setting-description">Enable country-based IP blocking</span>
				</div>
				<div class="setting-control">
					<label class="toggle-switch">
						<input type="checkbox" id="geoip_enabled" name="geoip_enabled" checked?={ data.Features.GeoIPEnabled }/>
						<span class="toggle-slider"></span>
					</label>
				</div>
			</div>
			<div class="setting-item">
				<div class="setting-info">
					<label class="setting-label" for="feeds_enabled">Threat Feeds</label>
					<span class="setting-description">Enable threat intelligence feed sync</span>
				</div>
				<div class="setting-control">
					<label class="toggle-switch">
						<input type="checkbox" id="feeds_enabled" name="feeds_enabled" checked?={ data.Features.FeedsEnabled }/>
						<span class="toggle-slider"></span>
					</label>
				</div>
			</div>
			<div class="setting-item">
				<div class="setting-info">
					<label class="setting-label" for="portscan_enabled">Portscan Detection</label>
					<span class="setting-description">Detect and block port scanning attempts</span>
				</div>
				<div class="setting-control">
					<label class="toggle-switch">
						<input type="checkbox" id="portscan_enabled" name="portscan_enabled" checked?={ data.Features.PortscanEnabled }/>
						<span class="toggle-slider"></span>
					</label>
				</div>
			</div>
			<div class="setting-item">
				<div class="setting-info">
					<label class="setting-label" for="ddos_enabled">DDoS Protection</label>
					<span class="setting-description">Enable DDoS detection and mitigation</span>
				</div>
				<div class="setting-control">
					<label class="toggle-switch">
						<input type="checkbox" id="ddos_enabled" name="ddos_enabled" checked?={ data.Features.DDoSEnabled }/>
						<span class="toggle-slider"></span>
					</label>
				</div>
			</div>
			<div class="setting-item">
				<div class="setting-info">
					<label class="setting-label" for="login_monitor_enabled">Login Monitor</label>
					<span class="setting-description">Monitor SSH/FTP login failures</span>
				</div>
				<div class="setting-control">
					<label class="toggle-switch">
						<input type="checkbox" id="login_monitor_enabled" name="login_monitor_enabled" checked?={ data.Features.LoginMonitorEnabled }/>
						<span class="toggle-slider"></span>
					</label>
				</div>
			</div>
			<div class="setting-item">
				<div class="setting-info">
					<label class="setting-label" for="suricata_enabled">Suricata IDS</label>
					<span class="setting-description">Enable Suricata intrusion detection integration</span>
				</div>
				<div class="setting-control">
					<label class="toggle-switch">
						<input type="checkbox" id="suricata_enabled" name="suricata_enabled" checked?={ data.Features.SuricataEnabled }/>
						<span class="toggle-slider"></span>
					</label>
				</div>
			</div>
		</div>
	</div>
}

// SettingsMetricsFragment renders the metrics settings section
templ SettingsMetricsFragment(data ui.ExtendedSettingsData) {
	<div class="card">
		<div class="card-header">
			<span class="card-title">Metrics Configuration</span>
		</div>
		<div class="settings-section">
			<div class="setting-item">
				<div class="setting-info">
					<label class="setting-label" for="metrics_backend">Backend</label>
					<span class="setting-description">Metrics storage backend type</span>
				</div>
				<div class="setting-control">
					<select id="metrics_backend" name="metrics_backend" class="form-select">
						<option value="prometheus" selected?={ data.Metrics.Backend == "prometheus" }>Prometheus</option>
						<option value="victoriametrics" selected?={ data.Metrics.Backend == "victoriametrics" }>VictoriaMetrics</option>
						<option value="textfile" selected?={ data.Metrics.Backend == "textfile" }>Textfile (node_exporter)</option>
					</select>
				</div>
			</div>
			<div class="setting-item">
				<div class="setting-info">
					<label class="setting-label" for="metrics_sampling_interval">Sampling Interval (seconds)</label>
					<span class="setting-description">How often to collect metrics</span>
				</div>
				<div class="setting-control">
					<input type="number" id="metrics_sampling_interval" name="metrics_sampling_interval" class="form-input" min="1" max="3600" value={ intToStr(data.Metrics.SamplingInterval) }/>
				</div>
			</div>
			<div class="setting-item">
				<div class="setting-info">
					<label class="setting-label" for="prometheus_dir">Prometheus Textfile Directory</label>
					<span class="setting-description">Path to node_exporter textfile collector directory</span>
				</div>
				<div class="setting-control">
					<input type="text" id="prometheus_dir" name="prometheus_dir" class="form-input" value={ data.Metrics.PrometheusDir }/>
				</div>
			</div>
			<div class="setting-item">
				<div class="setting-info">
					<label class="setting-label" for="prometheus_addr">Prometheus Address</label>
					<span class="setting-description">Prometheus server address for remote write</span>
				</div>
				<div class="setting-control">
					<input type="text" id="prometheus_addr" name="prometheus_addr" class="form-input" placeholder="localhost:9090" value={ data.Metrics.PrometheusAddr }/>
				</div>
			</div>
		</div>
	</div>
}

// SettingsGeoIPFragment renders the GeoIP settings section
templ SettingsGeoIPFragment(data ui.ExtendedSettingsData) {
	<div class="card">
		<div class="card-header">
			<span class="card-title">GeoIP Configuration</span>
		</div>
		<div class="settings-section">
			<div class="setting-item">
				<div class="setting-info">
					<label class="setting-label">Database Status</label>
					<span class="setting-description">MaxMind GeoLite2 license key status</span>
				</div>
				<div class="setting-control">
					if data.GeoIP.HasKey {
						<span class="badge badge-success">Configured</span>
					} else {
						<span class="badge badge-warning">Not configured</span>
					}
				</div>
			</div>
			<div class="setting-item">
				<div class="setting-info">
					<label class="setting-label" for="geoip_license_key">License Key</label>
					<span class="setting-description">MaxMind GeoLite2 license key (leave empty to keep current)</span>
				</div>
				<div class="setting-control">
					<input type="password" id="geoip_license_key" name="geoip_license_key" class="form-input" placeholder="Enter new key to update" value={ data.GeoIP.LicenseKey }/>
				</div>
			</div>
		</div>
	</div>
}

// SettingsSuricataFragment renders the Suricata settings section
templ SettingsSuricataFragment(data ui.ExtendedSettingsData) {
	<div class="card">
		<div class="card-header">
			<span class="card-title">Suricata IDS Configuration</span>
		</div>
		<div class="settings-section">
			<div class="setting-item">
				<div class="setting-info">
					<label class="setting-label" for="suricata_eve_log">EVE Log Path</label>
					<span class="setting-description">Path to Suricata EVE JSON log file</span>
				</div>
				<div class="setting-control">
					<input type="text" id="suricata_eve_log" name="suricata_eve_log" class="form-input" value={ data.Suricata.EveLog }/>
				</div>
			</div>
			<div class="setting-item">
				<div class="setting-info">
					<label class="setting-label" for="suricata_log_dir">Log Directory</label>
					<span class="setting-description">Directory for Suricata log files</span>
				</div>
				<div class="setting-control">
					<input type="text" id="suricata_log_dir" name="suricata_log_dir" class="form-input" value={ data.Suricata.LogDir }/>
				</div>
			</div>
			<div class="setting-item">
				<div class="setting-info">
					<label class="setting-label" for="suricata_ban_threshold">Ban Threshold</label>
					<span class="setting-description">Alert score threshold to trigger a ban</span>
				</div>
				<div class="setting-control">
					<input type="number" id="suricata_ban_threshold" name="suricata_ban_threshold" class="form-input" min="1" max="10000" value={ intToStr(data.Suricata.BanThreshold) }/>
				</div>
			</div>
			<div class="setting-item">
				<div class="setting-info">
					<label class="setting-label" for="suricata_score_decay">Score Decay (seconds)</label>
					<span class="setting-description">Time for threat scores to decay</span>
				</div>
				<div class="setting-control">
					<input type="number" id="suricata_score_decay" name="suricata_score_decay" class="form-input" min="60" max="86400" value={ intToStr(data.Suricata.ScoreDecay) }/>
				</div>
			</div>
			<div class="setting-item">
				<div class="setting-info">
					<label class="setting-label" for="suricata_cloudflare_whitelist">Cloudflare Whitelist</label>
					<span class="setting-description">Automatically whitelist Cloudflare IP ranges</span>
				</div>
				<div class="setting-control">
					<label class="toggle-switch">
						<input type="checkbox" id="suricata_cloudflare_whitelist" name="suricata_cloudflare_whitelist" checked?={ data.Suricata.CloudflareWhitelist }/>
						<span class="toggle-slider"></span>
					</label>
				</div>
			</div>
		</div>
	</div>
}

// SettingsLoggingFragment renders the logging settings section
templ SettingsLoggingFragment(data ui.ExtendedSettingsData) {
	<div class="card">
		<div class="card-header">
			<span class="card-title">Logging Configuration</span>
		</div>
		<div class="settings-section">
			<div class="setting-item">
				<div class="setting-info">
					<label class="setting-label" for="log_level">Log Level</label>
					<span class="setting-description">Verbosity level for NFTBan logging</span>
				</div>
				<div class="setting-control">
					<select id="log_level" name="log_level" class="form-select">
						<option value="DEBUG" selected?={ data.Logging.LogLevel == "DEBUG" }>Debug</option>
						<option value="INFO" selected?={ data.Logging.LogLevel == "INFO" }>Info</option>
						<option value="WARN" selected?={ data.Logging.LogLevel == "WARN" }>Warning</option>
						<option value="ERROR" selected?={ data.Logging.LogLevel == "ERROR" }>Error</option>
					</select>
				</div>
			</div>
			<div class="setting-item">
				<div class="setting-info">
					<label class="setting-label" for="color_output">Color Output</label>
					<span class="setting-description">Enable colored terminal output</span>
				</div>
				<div class="setting-control">
					<label class="toggle-switch">
						<input type="checkbox" id="color_output" name="color_output" checked?={ data.Logging.ColorOutput }/>
						<span class="toggle-slider"></span>
					</label>
				</div>
			</div>
			<div class="setting-item">
				<div class="setting-info">
					<label class="setting-label" for="debug_trace">Debug Trace</label>
					<span class="setting-description">Enable detailed debug tracing (impacts performance)</span>
				</div>
				<div class="setting-control">
					<label class="toggle-switch">
						<input type="checkbox" id="debug_trace" name="debug_trace" checked?={ data.Logging.DebugTrace }/>
						<span class="toggle-slider"></span>
					</label>
				</div>
			</div>
			<div class="setting-item">
				<div class="setting-info">
					<label class="setting-label" for="debug_trace_log">Debug Trace Log</label>
					<span class="setting-description">Path to debug trace log file</span>
				</div>
				<div class="setting-control">
					<input type="text" id="debug_trace_log" name="debug_trace_log" class="form-input" value={ data.Logging.DebugTraceLog }/>
				</div>
			</div>
		</div>
	</div>
}

// SettingsNetworkFragment renders the network settings section
templ SettingsNetworkFragment(data ui.ExtendedSettingsData) {
	<div class="card">
		<div class="card-header">
			<span class="card-title">Network Configuration</span>
		</div>
		<div class="settings-section">
			<div class="setting-item">
				<div class="setting-info">
					<label class="setting-label" for="gui_addr">GUI Address</label>
					<span class="setting-description">Web GUI listen address (host:port)</span>
				</div>
				<div class="setting-control">
					<input type="text" id="gui_addr" name="gui_addr" class="form-input" placeholder="127.0.0.1:3940" value={ data.Network.GUIAddr }/>
				</div>
			</div>
			<div class="setting-item">
				<div class="setting-info">
					<label class="setting-label" for="api_addr">API Address</label>
					<span class="setting-description">REST API listen address (host:port)</span>
				</div>
				<div class="setting-control">
					<input type="text" id="api_addr" name="api_addr" class="form-input" placeholder=":9580" value={ data.Network.APIAddr }/>
				</div>
			</div>
		</div>
	</div>
}

// SettingsPathsFragment renders the paths settings section (read-only)
templ SettingsPathsFragment(data ui.ExtendedSettingsData) {
	<div class="card">
		<div class="card-header">
			<span class="card-title">System Paths (Read-Only)</span>
		</div>
		<div class="settings-section">
			<div class="setting-item">
				<div class="setting-info">
					<label class="setting-label">Main Binary</label>
					<span class="setting-description">NFTBan CLI binary path</span>
				</div>
				<div class="setting-control">
					<span class="setting-value monospace">{ data.Paths.Bin }</span>
				</div>
			</div>
			<div class="setting-item">
				<div class="setting-info">
					<label class="setting-label">Config Directory</label>
					<span class="setting-description">Configuration files directory</span>
				</div>
				<div class="setting-control">
					<span class="setting-value monospace">{ data.Paths.ConfigDir }</span>
				</div>
			</div>
			<div class="setting-item">
				<div class="setting-info">
					<label class="setting-label">Data Directory</label>
					<span class="setting-description">Persistent data storage</span>
				</div>
				<div class="setting-control">
					<span class="setting-value monospace">{ data.Paths.DataDir }</span>
				</div>
			</div>
			<div class="setting-item">
				<div class="setting-info">
					<label class="setting-label">Log Directory</label>
					<span class="setting-description">Log files directory</span>
				</div>
				<div class="setting-control">
					<span class="setting-value monospace">{ data.Paths.LogDir }</span>
				</div>
			</div>
			<div class="setting-item">
				<div class="setting-info">
					<label class="setting-label">Cache Directory</label>
					<span class="setting-description">Cache and temporary files</span>
				</div>
				<div class="setting-control">
					<span class="setting-value monospace">{ data.Paths.CacheDir }</span>
				</div>
			</div>
			<div class="setting-item">
				<div class="setting-info">
					<label class="setting-label">Run Directory</label>
					<span class="setting-description">Runtime files (PID, socket)</span>
				</div>
				<div class="setting-control">
					<span class="setting-value monospace">{ data.Paths.RunDir }</span>
				</div>
			</div>
		</div>
	</div>
	<style>
		.monospace {
			font-family: ui-monospace, "SF Mono", Menlo, Monaco, "Cascadia Mono", "Segoe UI Mono", "Roboto Mono", "Oxygen Mono", "Ubuntu Monospace", "Source Code Pro", "Fira Mono", "Droid Sans Mono", "Courier New", monospace;
			font-size: 0.85rem;
		}
		.setting-value {
			color: var(--text-secondary);
		}
		.badge {
			display: inline-block;
			padding: 0.25rem 0.5rem;
			font-size: 0.75rem;
			font-weight: 500;
			border-radius: 4px;
		}
		.badge-success {
			background: var(--accent-safe);
			color: white;
		}
		.badge-warning {
			background: var(--accent-warning);
			color: #000;
		}
	</style>
}

// Note: intToStr is defined in health.templ and shared across all pages

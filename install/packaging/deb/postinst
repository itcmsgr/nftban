# postinst script for nftban-metrics
# See: dh_installdeb(1)

set -e

# Summary of how this script can be called:
#        * <postinst> `configure' <most-recently-configured-version>
#        * <old-postinst> `abort-upgrade' <new version>
#        * <conflictor's-postinst> `abort-remove' `in-favour' <package>
#          <new-version>
#        * <postinst> `abort-remove'
#        * <deconfigured's-postinst> `abort-deconfigure' `in-favour'
#          <failed-install-package> <version> `removing'
#          <conflicting-package> <version>
# for details, see https://www.debian.org/doc/debian-policy/ or
# the debian-policy package

case "$1" in
    configure)
        # Create textfile collector directory
        if [ ! -d "/var/lib/node_exporter/textfile_collector" ]; then
            echo "Creating Node Exporter textfile collector directory..."
            mkdir -p /var/lib/node_exporter/textfile_collector

            # Set ownership if nftban user exists
            if id -u nftban >/dev/null 2>&1; then
                chown nftban:nftban /var/lib/node_exporter/textfile_collector
            else
                echo "Warning: nftban user not found. Install nftban package first."
                echo "Setting directory ownership to root for now."
                chown root:root /var/lib/node_exporter/textfile_collector
            fi

            chmod 750 /var/lib/node_exporter/textfile_collector
        fi

        # Reload systemd to recognize new service files
        if [ -d /run/systemd/system ]; then
            echo "Reloading systemd daemon..."
            systemctl daemon-reload >/dev/null 2>&1 || true
        fi

        # Print installation success message
        echo ""
        echo "═══════════════════════════════════════════════════════════"
        echo "NFTBan v0.6 Metrics installed successfully!"
        echo "═══════════════════════════════════════════════════════════"
        echo ""
        echo "Next steps:"
        echo ""
        echo "1. Install Node Exporter (if not already installed):"
        echo "   sudo /usr/lib/nftban/setup/install_node_exporter.sh"
        echo ""
        echo "2. Install Prometheus (if not already installed):"
        echo "   sudo /usr/lib/nftban/setup/install_prometheus.sh"
        echo ""
        echo "3. Enable and start metrics collection:"
        echo "   sudo systemctl enable --now nftban-metrics-exporter.timer"
        echo ""
        echo "4. Verify metrics are being collected:"
        echo "   sudo systemctl status nftban-metrics-exporter.timer"
        echo "   cat /var/lib/node_exporter/textfile_collector/nftban.prom"
        echo ""
        echo "5. Import Grafana dashboards (optional):"
        echo "   Dashboards are in: /usr/share/nftban/grafana/dashboards/"
        echo ""
        echo "Documentation:"
        echo "  - Node Exporter: /usr/share/doc/nftban/metrics/NODE_EXPORTER_SETUP.md"
        echo "  - Prometheus: /usr/share/doc/nftban/metrics/PROMETHEUS_SETUP.md"
        echo "  - Security: /usr/share/doc/nftban/metrics/SECURITY.md"
        echo ""
        echo "═══════════════════════════════════════════════════════════"
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0

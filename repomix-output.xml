545: # Show module load message
546: # Usage: nftban_module_loaded "name" "version" "header" "type" ["depends"]
547: nftban_module_loaded() {
548:     local name="${1:-unknown}"
549:     local version="${2:-0.0.0}"
550:     local header="${3:-$name}"
551:     local type="${4:-module}"
552:     local depends="${5:-}"
553: 
554:     local level="${NFTBAN_MODULE_LOAD_LEVEL:-info}"
555:     local load_time=""
556: 
557:     # Track load order
558:     NFTBAN_MODULE_LOAD_ORDER+=("$name")
559: 
560:     # Calculate load time if timing enabled
561:     if [[ "${NFTBAN_SHOW_LOAD_TIMING:-false}" == "true" ]]; then
562:         load_time="$(nftban_get_elapsed)"
563:         # shellcheck disable=SC2034  # Used in test-banner.sh and verbose output
564:         NFTBAN_MODULE_LOAD_TIMES["$name"]="$load_time"
565:     fi
566: 
567:     case "$level" in
568:         none)
569:             return
570:             ;;
571:         error)
572:             # Only show if there's an error (not implemented here)
573:             return
574:             ;;
575:         info)
576:             nftban_module_loaded_info "$name" "$version" "$header" "$type"
577:             ;;
578:         debug)
579:             nftban_module_loaded_debug "$name" "$version" "$header" "$type" "$depends" "$load_time"
580:             ;;
581:         verbose)
582:             nftban_module_loaded_verbose "$name" "$version" "$header" "$type" "$depends" "$load_time"
583:             ;;
584:     esac
585: }
586: 
587: # Info level module load message
588: nftban_module_loaded_info() {
589:     local name="$1" version="$2" header="$3" type="$4"
590:     local format="${NFTBAN_MODULE_LOAD_FORMAT:-[INFO] {header} loaded (v{version})}"
591: 
592:     # Replace placeholders
593:     format="${format//\{name\}/$name}"
594:     format="${format//\{version\}/$version}"
595:     format="${format//\{header\}/$header}"
596:     format="${format//\{type\}/$type}"
597: 

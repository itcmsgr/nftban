694: # =============================================================================
695: # PROGRESS INDICATORS
696: # =============================================================================
697: 
698: # Progress spinner state
699: declare -g _NFTBAN_SPINNER_PID=""
700: declare -g _NFTBAN_SPINNER_MSG=""
701: 
702: # Start a background spinner for long operations
703: # Usage: nftban_progress_start "Loading feeds..."
704: nftban_progress_start() {
705:     local message="${1:-Processing...}"
706:     _NFTBAN_SPINNER_MSG="$message"
707: 
708:     # Don't start spinner if not a terminal
709:     [[ ! -t 1 ]] && return 0
710: 
711:     # Kill any existing spinner
712:     nftban_progress_end 2>/dev/null
713: 
714:     # Start spinner in background
715:     (
716:         local spinchars='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
717:         local i=0
718:         while true; do
719:             printf "\r${NFTBAN_COLOR_CYAN}%s${NFTBAN_COLOR_RESET} %s " "${spinchars:i++%${#spinchars}:1}" "$message"
720:             sleep 0.1
721:         done
722:     ) &
723:     _NFTBAN_SPINNER_PID=$!
724: 
725:     # Ensure spinner is killed on script exit
726:     trap 'nftban_progress_end 2>/dev/null' EXIT
727: }
728: 
729: # Update spinner message (optional)
730: # Usage: nftban_progress_update "Step 2 of 5..."
731: nftban_progress_update() {
732:     local message="${1:-Processing...}"
733:     _NFTBAN_SPINNER_MSG="$message"
734: 
735:     # If spinner is running, it will pick up new message on next iteration
736:     # For simplicity, restart with new message
737:     if [[ -n "$_NFTBAN_SPINNER_PID" ]] && kill -0 "$_NFTBAN_SPINNER_PID" 2>/dev/null; then
738:         nftban_progress_end
739:         nftban_progress_start "$message"
740:     fi
741: }
742: 
743: # Stop the spinner and optionally show completion message
744: # Usage: nftban_progress_end "Done!" or nftban_progress_end
745: # Function accepts optional arguments for progress customization
746: # shellcheck disable=SC2120
747: nftban_progress_end() {
748:     local message="${1:-}"
749: 
750:     # Kill spinner process
751:     if [[ -n "$_NFTBAN_SPINNER_PID" ]]; then
752:         kill "$_NFTBAN_SPINNER_PID" 2>/dev/null
753:         wait "$_NFTBAN_SPINNER_PID" 2>/dev/null
754:         _NFTBAN_SPINNER_PID=""
755:     fi
756: 
757:     # Clear line and show completion message
758:     if [[ -t 1 ]]; then
759:         printf "\r\033[K"  # Clear line
760:         if [[ -n "$message" ]]; then
761:             echo -e "${NFTBAN_COLOR_GREEN}✓${NFTBAN_COLOR_RESET} $message"
762:         fi
763:     fi
764: }
765: 
766: # Simple progress bar for operations with known count
767: # Usage: nftban_progress_bar 50 100 "Processing feeds"
768: nftban_progress_bar() {
769:     local current="${1:-0}"
770:     local total="${2:-100}"
771:     local message="${3:-Progress}"
772:     local width=40
773: 
774:     [[ ! -t 1 ]] && return 0
775:     [[ $total -eq 0 ]] && total=1
776: 
777:     local percent
778:     percent=$((current * 100 / total))
779:     local filled
780:     filled=$((current * width / total))
781:     local empty
782:     empty=$((width - filled))
783: 
784:     printf "\r${NFTBAN_COLOR_CYAN}%s${NFTBAN_COLOR_RESET} [" "$message"
785:     printf "%${filled}s" | tr ' ' '█'
786:     printf "%${empty}s" | tr ' ' '░'
787:     printf "] %3d%%" "$percent"
788: 
789:     # Newline when complete
790:     [[ $current -ge $total ]] && echo ""
791: }
792: 
793: export -f nftban_progress_start
794: export -f nftban_progress_update
795: export -f nftban_progress_end
796: export -f nftban_progress_bar
797: 
798: # =============================================================================
799: # UPDATE CHECK FUNCTIONS
800: # =============================================================================
801: 
802: # Check for updates and display notification in banner
803: nftban_check_updates_banner() {
804:     local cache_file="${NFTBAN_CACHE_DIR}/update_check"
805:     local cache_ttl="${NFTBAN_UPDATE_TTL:-86400}" # 24 hours default
806:     local repo="${NFTBAN_REPO:-itcmsgr/nftban}"
807:     local current_version latest_version
808: 
809:     # Get current version
810:     current_version="$(nftban_get_version)"
811: 
812:     # Check cache validity
813:     if [[ -f "$cache_file" ]]; then
814:         local cache_age
815:         cache_age=$(( $(date +%s) - $(stat -c %Y "$cache_file" 2>/dev/null || stat -f %m "$cache_file" 2>/dev/null || echo "0") ))
816: 
817:         # Use cached result if fresh
818:         if [[ $cache_age -lt $cache_ttl ]]; then
819:             latest_version="$(cat "$cache_file" 2>/dev/null)"
820:         fi
821:     fi
822: 
823:     # Fetch latest version if no valid cache
824:     if [[ -z "$latest_version" ]]; then
825:         # Quick check with timeout (3 seconds)
826:         latest_version=$(curl -sf --max-time 3 "https://api.github.com/repos/${repo}/releases/latest" 2>/dev/null | \
827:             grep -oP '"tag_name":\s*"v?\K[0-9]+\.[0-9]+\.[0-9]+' | head -1)
828: 
829:         # Cache the result (create dir if needed)
830:         if [[ -n "$latest_version" ]]; then
831:             mkdir -p "$(dirname "$cache_file")" 2>/dev/null
832:             echo "$latest_version" > "$cache_file" 2>/dev/null || true
833:         else
834:             # Failed to fetch, don't show anything
835:             return 0
836:         fi
837:     fi
838: 
839:     # Compare versions and show notification if update available
840:     if [[ -n "$latest_version" ]] && [[ "$latest_version" != "$current_version" ]]; then
841:         nftban_version_compare "$current_version" "$latest_version"
842:         local cmp=$?
843: 
844:         # 0 = equal, 1 = current < latest (update available), 2 = current > latest
845:         if [[ $cmp -eq 1 ]]; then
846:             echo ""
847:             echo -e "${NFTBAN_COLOR_YELLOW}╭────────────────────────────────────────────────────────────╮${NFTBAN_COLOR_RESET}"
848:             echo -e "${NFTBAN_COLOR_YELLOW}│  📦 Update Available: v${latest_version}$(printf ' %.0s' {1..28})│${NFTBAN_COLOR_RESET}"
849:             echo -e "${NFTBAN_COLOR_YELLOW}│  Current: v${current_version}                                      │${NFTBAN_COLOR_RESET}"
850:             echo -e "${NFTBAN_COLOR_YELLOW}│  Download: github.com/${repo}/releases   │${NFTBAN_COLOR_RESET}"
851:             echo -e "${NFTBAN_COLOR_YELLOW}╰────────────────────────────────────────────────────────────╯${NFTBAN_COLOR_RESET}"
852:         fi
853:     fi
854: }
855: 
856: # Compare two semantic versions (X.Y.Z)
857: # Returns: 0 if equal, 1 if v1 < v2, 2 if v1 > v2
858: nftban_version_compare() {
859:     local v1="$1" v2="$2"
860: 
861:     # Remove 'v' prefix if present
862:     v1="${v1#v}"
863:     v2="${v2#v}"
864: 
865:     # Split versions into components
866:     IFS='.' read -r v1_major v1_minor v1_patch <<< "$v1"
867:     IFS='.' read -r v2_major v2_minor v2_patch <<< "$v2"
868: 
869:     # Default to 0 if empty
870:     v1_major="${v1_major:-0}"
871:     v1_minor="${v1_minor:-0}"
872:     v1_patch="${v1_patch:-0}"
873:     v2_major="${v2_major:-0}"
874:     v2_minor="${v2_minor:-0}"
875:     v2_patch="${v2_patch:-0}"
876: 
877:     # Compare major
878:     if [[ $v1_major -lt $v2_major ]]; then
879:         return 1
880:     elif [[ $v1_major -gt $v2_major ]]; then
881:         return 2
882:     fi
883: 
884:     # Compare minor
885:     if [[ $v1_minor -lt $v2_minor ]]; then
886:         return 1
887:     elif [[ $v1_minor -gt $v2_minor ]]; then
888:         return 2
889:     fi
890: 
891:     # Compare patch
892:     if [[ $v1_patch -lt $v2_patch ]]; then
893:         return 1
894:     elif [[ $v1_patch -gt $v2_patch ]]; then
895:         return 2
896:     fi
897: 
898:     # Equal
899:     return 0
900: }
901: 
902: # =============================================================================
903: # MAIN OUTPUT FUNCTION - nftban_output
904: # =============================================================================
905: # This is the core output function used throughout the codebase
906: # Usage: nftban_output <type> <message>
907: # Types: info, success, error, warning, header, debug
908: #
909: nftban_output() {
910:     local type="${1:-info}"
911:     local message="${2:-}"
912:     local prefix=""
913:     local color_code=""
914:     local reset=""
915: 
916:     # Use colors if terminal supports it
917:     if [[ "${NFTBAN_COLOR:-true}" == "true" ]] && [[ -t 1 ]]; then
918:         reset="\033[0m"
919:         case "$type" in
920:             error)   color_code="\033[0;31m"; prefix="[ERROR]" ;;
921:             warning) color_code="\033[0;33m"; prefix="[WARN]" ;;
922:             success) color_code="\033[0;32m"; prefix="[OK]" ;;
923:             info)    color_code="\033[0;34m"; prefix="[INFO]" ;;
924:             header)  color_code="\033[1;36m"; prefix="==>" ;;
925:             debug)   color_code="\033[0;90m"; prefix="[DEBUG]" ;;
926:             *)       color_code=""; prefix="[$type]" ;;
927:         esac
928:         echo -e "${color_code}${prefix}${reset} ${message}"
929:     else
930:         case "$type" in
931:             error)   prefix="[ERROR]" ;;
932:             warning) prefix="[WARN]" ;;
933:             success) prefix="[OK]" ;;
934:             info)    prefix="[INFO]" ;;
935:             header)  prefix="==>" ;;
936:             debug)   prefix="[DEBUG]" ;;
937:             *)       prefix="[$type]" ;;
938:         esac
939:         echo "${prefix} ${message}"
940:     fi
941: }
942: 
943: # Export function for subshells
944: export -f nftban_output 2>/dev/null || true
945: 
946: # =============================================================================
947: # FOOTER - Debug & Module Info
948: # =============================================================================
949: 
950: # Auto-report module load (only if DEBUG_MODE is true)
951: # IMPORTANT: These values MUST match the meta: fields in the header above
952: #   - meta:name         → "nftban_output"
953: #   - meta:version      → "1.0.0"
954: #   - meta:header       → "Output & Banner Module"
955: #   - meta:type         → "core"
956: #   - meta:depends      → "tput,uname,hostname"
957: #
958: # This pattern should be followed by ALL modules:
959: #   nftban_module_loaded "<meta:name>" "<meta:version>" "<meta:header>" "<meta:type>" "<meta:depends>"
960: #
961: if [[ "${NFTBAN_DEBUG_MODE:-false}" == "true" ]]; then
962:     nftban_module_loaded "nftban_output" "1.0.0" "Output & Banner Module" "core" "tput,uname,hostname"
963: fi
964: 
965: # Guard: do not exit on source
966: # shellcheck disable=SC2317  # This is reachable when script is sourced
967: return 0 2>/dev/null || :
</file>

<file path="cli/lib/nftban/core/nftban_portscan_suricata.sh">
  1: #!/bin/bash
  2: # shellcheck disable=SC1083  # Braces in nftables syntax are literal, not bash
  3: # =============================================================================
  4: # NFTBan Portscan Protection - SURICATA MODE Implementation
  5: # =============================================================================
  6: # Uses Suricata IDS for intelligent portscan detection via EVE JSON alerts.
  7: # Leverages Suricata's built-in sfportscan preprocessor and signature rules.
  8: #
  9: # File: /usr/lib/nftban/core/nftban_portscan_suricata.sh
 10: # =============================================================================
 11: 
 12: # Prevent double sourcing
 13: [[ -n "${_NFTBAN_PORTSCAN_SURICATA_LOADED:-}" ]] && return 0
 14: declare -g _NFTBAN_PORTSCAN_SURICATA_LOADED=1
 15: 
 16: # =============================================================================
 17: # CONFIGURATION LOADING
 18: # =============================================================================
 19: 
 20: # Load suricata mode configuration
 21: nftban_portscan_suricata_load_config() {
 22:     local config_file="${NFTBAN_CONFIG_DIR:-/etc/nftban}/conf.d/portscan/suricata.conf"
 23:     local local_config="${config_file%.conf}.conf.local"
 24: 
 25:     # Load base config
 26:     if [[ -f "$config_file" ]]; then
 27:         # shellcheck source=/dev/null
 28:         source "$config_file"
 29:     else
 30:         nftban_log "WARN" "portscan_suricata" "Config not found: $config_file"
 31:     fi
 32: 
 33:     # Load local overrides
 34:     if [[ -f "$local_config" ]]; then
 35:         # shellcheck source=/dev/null
 36:         source "$local_config"
 37:     fi
 38: 
 39:     # Set defaults
 40:     : "${PORTSCAN_SURICATA_EVE_FILE:=/var/log/suricata/eve.json}"
 41:     : "${PORTSCAN_SURICATA_SIG_PATTERNS:=[Pp]ort[Ss]can|[Pp]ort [Ss]weep|SCAN|Nmap|masscan}"
 42:     : "${PORTSCAN_SURICATA_THRESHOLD_OBSERVE:=0.25}"
 43:     : "${PORTSCAN_SURICATA_THRESHOLD_BLOCK_SHORT:=0.45}"
 44:     : "${PORTSCAN_SURICATA_THRESHOLD_BLOCK_LONG:=0.65}"
 45:     : "${PORTSCAN_SURICATA_THRESHOLD_BLOCK_PERMANENT:=0.85}"
 46:     : "${PORTSCAN_SURICATA_BAN_DURATION_SHORT:=900}"
 47:     : "${PORTSCAN_SURICATA_BAN_DURATION_LONG:=3600}"
 48:     : "${PORTSCAN_SURICATA_BAN_DURATION_PERMANENT:=86400}"
 49:     : "${PORTSCAN_SURICATA_ALERT_WINDOW:=300}"
 50:     : "${PORTSCAN_SURICATA_SCORE_DECAY:=1800}"
 51:     : "${PORTSCAN_SURICATA_MAX_TRACKED_IPS:=10000}"
 52:     : "${PORTSCAN_SURICATA_BATCH_SIZE:=100}"
 53:     : "${PORTSCAN_SURICATA_STATE_FILE:=/var/lib/nftban/portscan-suricata-state.db}"
 54: 
 55:     return 0
 56: }
 57: 
 58: # =============================================================================
 59: # SURICATA AVAILABILITY DETECTION
 60: # =============================================================================
 61: 
 62: # Check if Suricata binary exists
 63: nftban_portscan_suricata_binary_exists() {
 64:     local binary="${PORTSCAN_SURICATA_BINARY:-/usr/bin/suricata}"
 65:     [[ -x "$binary" ]]
 66: }
 67: 
 68: # Check if Suricata service is running
 69: nftban_portscan_suricata_service_running() {
 70:     local service_name="${PORTSCAN_SURICATA_SERVICE_NAME:-suricata}"
 71: 
 72:     # Try systemctl first
 73:     if command -v systemctl &>/dev/null; then
 74:         if systemctl is-active --quiet "$service_name" 2>/dev/null; then
 75:             return 0
 76:         fi
 77:     fi
 78: 
 79:     # Fall back to pgrep
 80:     if pgrep -x suricata &>/dev/null; then
 81:         return 0
 82:     fi
 83: 
 84:     return 1
 85: }
 86: 
 87: # Check if EVE JSON file is active (being written to)
 88: nftban_portscan_suricata_eve_active() {
 89:     local eve_file="${PORTSCAN_SURICATA_EVE_FILE}"
 90:     local freshness_threshold="${PORTSCAN_EVE_FRESHNESS_THRESHOLD:-60}"
 91: 
 92:     [[ -f "$eve_file" ]] || return 1
 93: 
 94:     local file_mtime
 95:     file_mtime=$(stat -c %Y "$eve_file" 2>/dev/null) || return 1
 96: 
 97:     local current_time
 98:     current_time=$(date +%s)
 99: 
100:     local age
101:     age=$((current_time - file_mtime))
102: 
103:     [[ $age -le $freshness_threshold ]]
104: }
105: 
106: # Combined availability check
107: nftban_portscan_suricata_is_available() {
108:     local check_binary="${PORTSCAN_AUTO_CHECK_BINARY:-true}"
109:     local check_service="${PORTSCAN_AUTO_CHECK_SERVICE:-true}"
110:     local check_eve="${PORTSCAN_AUTO_CHECK_EVE_FILE:-true}"
111: 
112:     # Check binary
113:     if [[ "$check_binary" == "true" ]]; then
114:         if ! nftban_portscan_suricata_binary_exists; then
115:             return 1
116:         fi
117:     fi
118: 
119:     # Check service
120:     if [[ "$check_service" == "true" ]]; then
121:         if ! nftban_portscan_suricata_service_running; then
122:             return 1
123:         fi
124:     fi
125: 
126:     # Check EVE file
127:     if [[ "$check_eve" == "true" ]]; then
128:         if ! nftban_portscan_suricata_eve_active; then
129:             return 1
130:         fi
131:     fi
132: 
133:     return 0
134: }
135: 
136: # =============================================================================
137: # STATE TRACKING
138: # =============================================================================
139: 
140: # In-memory tracking
141: declare -gA _PORTSCAN_SURICATA_IP_SCORES       # IP -> current score
142: declare -gA _PORTSCAN_SURICATA_IP_ALERTS       # IP -> alert count
143: declare -gA _PORTSCAN_SURICATA_IP_FIRST_SEEN   # IP -> first seen timestamp
144: declare -gA _PORTSCAN_SURICATA_IP_LAST_SEEN    # IP -> last seen timestamp
145: declare -gA _PORTSCAN_SURICATA_IP_SCAN_TYPES   # IP -> scan types seen
146: declare -gA _PORTSCAN_SURICATA_IP_BLOCKED      # IP -> blocked timestamp
147: declare -g  _PORTSCAN_SURICATA_EVE_OFFSET=0    # EVE file read offset
148: 
149: # Initialize state
150: nftban_portscan_suricata_init_state() {
151:     _PORTSCAN_SURICATA_IP_SCORES=()
152:     _PORTSCAN_SURICATA_IP_ALERTS=()
153:     _PORTSCAN_SURICATA_IP_FIRST_SEEN=()
154:     _PORTSCAN_SURICATA_IP_LAST_SEEN=()
155:     _PORTSCAN_SURICATA_IP_SCAN_TYPES=()
156:     _PORTSCAN_SURICATA_IP_BLOCKED=()
157:     _PORTSCAN_SURICATA_EVE_OFFSET=0
158: 
159:     # Load persistent state
160:     if [[ -f "${PORTSCAN_SURICATA_STATE_FILE}" ]]; then
161:         nftban_portscan_suricata_load_state
162:     fi
163: 
164:     return 0
165: }
166: 
167: # Save state to disk
168: nftban_portscan_suricata_save_state() {
169:     local state_file="${PORTSCAN_SURICATA_STATE_FILE}"
170:     local state_dir
171:     state_dir=$(dirname "$state_file")
172: 
173:     [[ -d "$state_dir" ]] || mkdir -p "$state_dir"
174: 
175:     {
176:         echo "# NFTBan Portscan Suricata State - $(date -Iseconds)"
177:         echo "# Format: TYPE|IP|DATA"
178:         echo "EVE_OFFSET|0|${_PORTSCAN_SURICATA_EVE_OFFSET}"
179: 
180:         for ip in "${!_PORTSCAN_SURICATA_IP_SCORES[@]}"; do
181:             echo "SCORE|${ip}|${_PORTSCAN_SURICATA_IP_SCORES[$ip]}"
182:         done
183: 
184:         for ip in "${!_PORTSCAN_SURICATA_IP_BLOCKED[@]}"; do
185:             echo "BLOCKED|${ip}|${_PORTSCAN_SURICATA_IP_BLOCKED[$ip]}"
186:         done
187:     } > "${state_file}.tmp" && mv "${state_file}.tmp" "${state_file}"
188: 
189:     return 0
190: }
191: 
192: # Load state from disk
193: nftban_portscan_suricata_load_state() {
194:     local state_file="${PORTSCAN_SURICATA_STATE_FILE}"
195: 
196:     [[ -f "$state_file" ]] || return 0
197: 
198:     while IFS='|' read -r type key data; do
199:         [[ "$type" =~ ^# ]] && continue
200:         [[ -z "$type" ]] && continue
201: 
202:         case "$type" in
203:             EVE_OFFSET)
204:                 _PORTSCAN_SURICATA_EVE_OFFSET="$data"
205:                 ;;
206:             SCORE)
207:                 _PORTSCAN_SURICATA_IP_SCORES["$key"]="$data"
208:                 ;;
209:             BLOCKED)
210:                 _PORTSCAN_SURICATA_IP_BLOCKED["$key"]="$data"
211:                 ;;
212:         esac
213:     done < "$state_file"
214: 
215:     return 0
216: }

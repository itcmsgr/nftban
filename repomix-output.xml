 329: nftban_stats_top_ips() {
 330:     # Get top banned IPs with GeoIP
 331:     # Usage: nftban_stats_top_ips [limit] [since] [until]
 332:     # Returns: JSON array with IP, count, country, first/last seen
 333: 
 334:     local limit="${1:-${STATS_TOP_N}}"
 335:     local since="${2:-1970-01-01}"
 336:     local until="${3:-$(date +%Y-%m-%d)}"
 337: 
 338:     if [[ ! -f "$NFTBAN_BAN_LOG" ]]; then
 339:         echo "[]"
 340:         return 0
 341:     fi
 342: 
 343:     # Get top IPs into temp file to avoid subshell variable issues
 344:     local temp_file
 345:     temp_file=$(mktemp)
 346:     trap 'rm -f "$temp_file"' RETURN
 347: 
 348:     awk -F'|' -v since="$since" -v until="$until" \
 349:         '$1 >= since && $1 <= until && $6 == "BANNED" {ips[$4]++}
 350:          END {for (ip in ips) print ips[ip], ip}' \
 351:         "$NFTBAN_BAN_LOG" 2>/dev/null | \
 352:     sort -rn | head -n "$limit" > "$temp_file" || true
 353: 
 354:     # Check if we have any results
 355:     if [[ ! -s "$temp_file" ]]; then
 356:         echo "[]"
 357:         return 0
 358:     fi
 359: 
 360:     local result="["
 361:     local first=true
 362: 
 363:     while read -r count ip; do
 364:         [[ -z "$ip" ]] && continue
 365: 
 366:         local country="--"
 367:         local first_seen
 368:         local last_seen
 369: 
 370:         # Get first and last seen (use subshell to avoid errexit issues)
 371:         first_seen=$(grep "|${ip}|" "$NFTBAN_BAN_LOG" 2>/dev/null | awk -F'|' 'NR==1 {print $1; exit}' || true)
 372:         [[ -z "$first_seen" ]] && first_seen="--"
 373:         last_seen=$(grep "|${ip}|" "$NFTBAN_BAN_LOG" 2>/dev/null | awk -F'|' 'END {print $1}' || true)
 374:         [[ -z "$last_seen" ]] && last_seen="--"
 375: 
 376:         # GeoIP lookup if enabled
 377:         if [[ "${STATS_GEOIP_ENABLED}" == "true" ]] && command -v nftban-geoip &>/dev/null; then
 378:             country=$(nftban-geoip lookup "$ip" 2>/dev/null | cut -d'/' -f1 || echo "--")
 379:         fi
 380: 
 381:         # Build JSON
 382:         if [[ "$first" == "false" ]]; then
 383:             result+=","
 384:         fi
 385:         result+="{\"ip\":\"${ip}\",\"count\":${count},\"country\":\"${country}\",\"first_seen\":\"${first_seen}\",\"last_seen\":\"${last_seen}\"}"
 386:         first=false
 387:     done < "$temp_file"
 388: 
 389:     result+="]"
 390:     echo "$result"
 391: }

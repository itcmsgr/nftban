330: // GetStatus returns current sampler status
331: func (s *Sampler) GetStatus() map[string]interface{} {
332: 	s.mu.RLock()
333: 	defer s.mu.RUnlock()
334: 
335: 	return map[string]interface{}{
336: 		"running":          s.running,
337: 		"metrics_enabled":  s.metricsEnabled,
338: 		"active_sessions":  s.activeSessions,
339: 		"period_seconds":   s.period.Seconds(),
340: 		"samples_stored":   len(s.samples),
341: 		"max_samples":      s.maxSamples,
342: 		"last_sample":      s.lastSample,
343: 		"uptime_seconds":   time.Since(s.startTime).Seconds(),
344: 	}
345: }

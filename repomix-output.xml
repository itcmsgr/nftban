 1: // Package authproto defines shared authentication protocol types
 2: // Used by both pkg/auth and cmd/nftban-ui-auth to ensure consistency
 3: package authproto
 4: 
 5: // AuthRequest represents a login request
 6: type AuthRequest struct {
 7: 	Username string `json:"username"`
 8: 	Password string `json:"password"`
 9: }
10: 
11: // AuthResponse represents the authentication result
12: type AuthResponse struct {
13: 	Success bool   `json:"success"`
14: 	Message string `json:"message,omitempty"`
15: 	Error   string `json:"error,omitempty"`
16: }
17: 
18: // NewSuccessResponse creates a successful auth response
19: func NewSuccessResponse(message string) AuthResponse {
20: 	return AuthResponse{
21: 		Success: true,
22: 		Message: message,
23: 	}
24: }
25: 
26: // NewErrorResponse creates an error auth response

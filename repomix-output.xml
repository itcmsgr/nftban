408:         cat > "$file" <<'EOF'
409: # NFTBan Services - Local Overrides
410: # This file overrides settings from services.conf
411: EOF
412:         chmod 640 "$file"
413:         chown root:nftban "$file" 2>/dev/null || true
414:     fi

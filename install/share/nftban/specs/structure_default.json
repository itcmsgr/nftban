{
  "version": "1.0",
  "description": "NFTBan default nftables structure specification",
  "last_updated": "2025-11-13",
  "expected_structure": {
    "tables": {
      "inet nftban_main": {
        "description": "Main NFTBan firewall table (priority 0)",
        "required": true,
        "chains": {
          "input": {
            "type": "filter",
            "hook": "input",
            "priority": "filter",
            "policy": "drop",
            "required": true,
            "description": "Main input chain with default drop policy"
          },
          "forward": {
            "type": "filter",
            "hook": "forward",
            "priority": "filter",
            "policy": "drop",
            "required": true,
            "description": "Forward chain for routing"
          },
          "output": {
            "type": "filter",
            "hook": "output",
            "priority": "filter",
            "policy": "accept",
            "required": true,
            "description": "Output chain (typically accept)"
          }
        },
        "sets": {
          "whitelist_v4": {
            "type": "ipv4_addr",
            "required": true,
            "description": "IPv4 whitelist - full access"
          },
          "whitelist_v6": {
            "type": "ipv6_addr",
            "required": true,
            "description": "IPv6 whitelist - full access"
          },
          "blacklist_v4": {
            "type": "ipv4_addr",
            "required": true,
            "description": "IPv4 blacklist - permanent bans"
          },
          "blacklist_v6": {
            "type": "ipv6_addr",
            "required": true,
            "description": "IPv6 blacklist - permanent bans"
          },
          "tcp_ports": {
            "type": "inet_service",
            "required": true,
            "description": "Allowed TCP ports (22, 80, 443)"
          },
          "udp_ports": {
            "type": "inet_service",
            "required": true,
            "description": "Allowed UDP ports"
          }
        }
      },
      "inet nftban_runtime": {
        "description": "Runtime temporary bans and whitelists (priority -10, -5)",
        "required": true,
        "chains": {
          "input_temp_whitelist": {
            "type": "filter",
            "hook": "input",
            "priority": -10,
            "policy": "accept",
            "required": false,
            "description": "Temporary whitelist (highest priority)"
          },
          "input_tempban": {
            "type": "filter",
            "hook": "input",
            "priority": -5,
            "policy": "accept",
            "required": false,
            "description": "Temporary bans with auto-expiry"
          }
        },
        "sets": {
          "temp_whitelist_v4": {
            "type": "ipv4_addr",
            "timeout": true,
            "required": false,
            "description": "Temporary IPv4 whitelist with timeout"
          },
          "temp_whitelist_v6": {
            "type": "ipv6_addr",
            "timeout": true,
            "required": false,
            "description": "Temporary IPv6 whitelist with timeout"
          },
          "temp_ban_v4": {
            "type": "ipv4_addr",
            "timeout": true,
            "required": false,
            "description": "Temporary IPv4 bans (1h default)"
          },
          "temp_ban_v6": {
            "type": "ipv6_addr",
            "timeout": true,
            "required": false,
            "description": "Temporary IPv6 bans (1h default)"
          }
        }
      }
    },
    "forbidden_tables": {
      "description": "Tables that should NOT exist (they bypass NFTBan)",
      "patterns": [
        "inet filter",
        "ip filter",
        "ip6 filter"
      ],
      "reason": "These tables can bypass NFTBan's priority system and create security holes"
    },
    "rule_order": {
      "description": "Expected rule processing order in inet nftban_main input chain",
      "order": [
        {
          "position": 1,
          "pattern": "ct state established,related accept",
          "description": "Allow established connections"
        },
        {
          "position": 2,
          "pattern": "iif \"lo\" accept",
          "description": "Allow loopback"
        },
        {
          "position": 3,
          "pattern": "ip saddr @whitelist_v4 accept",
          "description": "Whitelist IPv4 (full access before port check)"
        },
        {
          "position": 4,
          "pattern": "ip6 saddr @whitelist_v6 accept",
          "description": "Whitelist IPv6"
        },
        {
          "position": 5,
          "pattern": "icmp type",
          "description": "ICMP rules"
        },
        {
          "position": 6,
          "pattern": "ip saddr @blacklist_v4 drop",
          "description": "Blacklist IPv4"
        },
        {
          "position": 7,
          "pattern": "tcp dport @tcp_ports accept",
          "description": "Allow TCP ports (22, 80, 443)"
        },
        {
          "position": 8,
          "pattern": "udp dport @udp_ports accept",
          "description": "Allow UDP ports"
        },
        {
          "position": 9,
          "pattern": "drop",
          "description": "Default deny (catch-all)"
        }
      ]
    },
    "validation_checks": {
      "required_tables": [
        "inet nftban_main",
        "inet nftban_runtime"
      ],
      "forbidden_table_patterns": [
        "inet filter",
        "ip filter",
        "ip6 filter"
      ],
      "required_sets": [
        "inet nftban_main whitelist_v4",
        "inet nftban_main whitelist_v6",
        "inet nftban_main blacklist_v4",
        "inet nftban_main blacklist_v6",
        "inet nftban_main tcp_ports",
        "inet nftban_main udp_ports"
      ],
      "policy_checks": {
        "inet nftban_main input": "drop",
        "inet nftban_main forward": "drop",
        "inet nftban_main output": "accept"
      },
      "priority_checks": {
        "inet nftban_runtime input_temp_whitelist": -10,
        "inet nftban_runtime input_tempban": -5,
        "inet nftban_main input": 0
      }
    }
  },
  "severity_levels": {
    "critical": {
      "description": "Security-critical issues that must be fixed immediately",
      "examples": [
        "Missing nftban_main table",
        "Wrong policy (accept instead of drop)",
        "Forbidden table exists (inet filter bypassing NFTBan)"
      ]
    },
    "warning": {
      "description": "Issues that may cause unexpected behavior",
      "examples": [
        "Missing optional sets",
        "Rule order not matching spec",
        "Unexpected chains"
      ]
    },
    "info": {
      "description": "Informational messages",
      "examples": [
        "Additional custom tables detected",
        "Non-standard set names"
      ]
    }
  }
}

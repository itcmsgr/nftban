 69: nftban_cmd_firewall() {
 70:     # Main firewall command handler
 71:     # Usage: nftban firewall <subcommand> [options]
 72: 
 73:     local subcommand="${1:-help}"
 74: 
 75:     # Check for --json flag in all args (suppress banner for JSON output)
 76:     local json_mode=false
 77:     for arg in "$@"; do
 78:         [[ "$arg" == "--json" ]] && json_mode=true && break
 79:     done
 80: 
 81:     # Show banner (skip for JSON output to avoid polluting machine-readable output)
 82:     if [[ "$json_mode" == "false" ]]; then
 83:         if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_output.sh" ]]; then
 84:             # shellcheck source=/dev/null
 85:             source "${NFTBAN_LIB_DIR}/core/nftban_output.sh"
 86:             if [[ $(type -t nftban_banner) == "function" ]]; then
 87:                 nftban_banner
 88:             fi
 89:         fi
 90:         echo ""
 91:     fi
 92: 
 93:     case "$subcommand" in
 94:         help|--help|-h)
 95:             show_firewall_help
 96:             return 0
 97:             ;;
 98:         validate)
 99:             shift
100:             firewall_validate "$@"
101:             ;;
102:         check)
103:             shift
104:             firewall_check "$@"
105:             ;;
106:         stats)
107:             shift
108:             firewall_stats "$@"
109:             ;;
110:         *)
111:             echo "Error: Unknown firewall subcommand: $subcommand" >&2
112:             echo "Try 'nftban firewall help' for more information." >&2
113:             return 1
114:             ;;
115:     esac
116: }
117: 
118: # =============================================================================
119: # SUBCOMMAND: VALIDATE
120: # =============================================================================
121: 
122: firewall_validate() {
123:     # Validate nftables structure against NFTBan specification
124:     # Args: [--json]
125: 
126:     local output_json=false
127: 
128:     # Parse arguments
129:     while [[ $# -gt 0 ]]; do
130:         case "$1" in
131:             --json)
132:                 output_json=true
133:                 shift
134:                 ;;
135:             -h|--help)
136:                 show_validate_help
137:                 return 0
138:                 ;;
139:             *)
140:                 echo "Error: Unknown option: $1" >&2
141:                 echo "Try 'nftban firewall validate --help' for more information." >&2
142:                 return 1
143:                 ;;
144:         esac
145:     done
146: 
147:     # Load core validator
148:     if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_validator.sh" ]]; then
149:         # shellcheck source=/dev/null
150:         source "${NFTBAN_LIB_DIR}/core/nftban_validator.sh"
151:     else
152:         echo "Error: Cannot find nftban_validator.sh" >&2
153:         return 1
154:     fi
155: 
156:     # Run validation
157:     if [[ "$output_json" == "true" ]]; then
158:         validate_structure "true"
159:     else
160:         validate_structure "false"
161:     fi
162: }
163: 
164: # =============================================================================
165: # SUBCOMMAND: CHECK
166: # =============================================================================
167: 
168: firewall_check() {
169:     # Check if IP or port is blocked/allowed
170:     # Args: <ip|port> [--json]
171: 
172:     local value=""
173:     local output_json=false
174: 
175:     # Parse arguments
176:     while [[ $# -gt 0 ]]; do
177:         case "$1" in
178:             --json)
179:                 output_json=true
180:                 shift
181:                 ;;
182:             -h|--help)
183:                 show_check_help
184:                 return 0
185:                 ;;
186:             -*)
187:                 echo "Error: Unknown option: $1" >&2
188:                 echo "Try 'nftban firewall check --help' for more information." >&2
189:                 return 1
190:                 ;;
191:             *)
192:                 value="$1"
193:                 shift
194:                 ;;
195:         esac
196:     done
197: 
198:     # Validate value provided
199:     if [[ -z "$value" ]]; then
200:         echo "Error: No IP or port specified" >&2
201:         echo "Try 'nftban firewall check --help' for more information." >&2
202:         return 1
203:     fi
204: 
205:     # Load core validator
206:     if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_validator.sh" ]]; then
207:         # shellcheck source=/dev/null
208:         source "${NFTBAN_LIB_DIR}/core/nftban_validator.sh"
209:     else
210:         echo "Error: Cannot find nftban_validator.sh" >&2
211:         return 1
212:     fi
213: 
214:     # Run check
215:     if [[ "$output_json" == "true" ]]; then
216:         check_ip_or_port "$value" "true"
217:     else
218:         check_ip_or_port "$value" "false"
219:     fi
220: }
221: 
222: # =============================================================================
223: # SUBCOMMAND: STATS
224: # =============================================================================
225: 
226: firewall_stats() {
227:     # Display firewall statistics
228:     # Args: [--json]
229: 
230:     local output_json=false
231: 
232:     # Parse arguments
233:     while [[ $# -gt 0 ]]; do
234:         case "$1" in
235:             --json)
236:                 output_json=true
237:                 shift
238:                 ;;
239:             -h|--help)
240:                 show_stats_help
241:                 return 0
242:                 ;;
243:             *)
244:                 echo "Error: Unknown option: $1" >&2
245:                 echo "Try 'nftban firewall stats --help' for more information." >&2
246:                 return 1
247:                 ;;
248:         esac
249:     done
250: 
251:     # Load core validator
252:     if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_validator.sh" ]]; then
253:         # shellcheck source=/dev/null
254:         source "${NFTBAN_LIB_DIR}/core/nftban_validator.sh"
255:     else
256:         echo "Error: Cannot find nftban_validator.sh" >&2
257:         return 1
258:     fi
259: 
260:     # Get statistics
261:     if [[ "$output_json" == "true" ]]; then
262:         get_firewall_stats "true"
263:     else
264:         get_firewall_stats "false"
265:     fi
266: }
267: 
268: # =============================================================================
269: # HELP FUNCTIONS
270: # =============================================================================
271: 
272: show_firewall_help() {
273:     cat <<'EOF'
274: Usage: nftban firewall <subcommand> [options]
275: 
276: Firewall structure validation, IP/port checking, and statistics.
277: 
278: Subcommands:
279:   validate      Validate nftables structure against NFTBan spec
280:   check         Check if IP or port is blocked/allowed
281:   stats         Show firewall statistics (tables, chains, sets, IPs)
282:   help          Show this help message
283: 
284: Examples:
285:   nftban firewall validate
286:   nftban firewall check 1.2.3.4
287:   nftban firewall check 22
288:   nftban firewall stats
289: 
290: Global options:
291:   --json        Output results as JSON (for GUI integration)
292:   -h, --help    Show help for specific subcommand
293: 
294: For detailed help on a subcommand:
295:   nftban firewall validate --help
296:   nftban firewall check --help
297:   nftban firewall stats --help
298: 
299: EOF
300: }
301: 
302: show_validate_help() {
303:     cat <<'EOF'
304: Usage: nftban firewall validate [OPTIONS]
305: 
306: Validate nftables structure against NFTBan specification.
307: 
308: Checks:
309:   - Required tables exist (ip nftban, ip6 nftban)
310:   - Forbidden tables don't exist (inet filter - bypasses NFTBan!)
311:   - Required sets exist (whitelist_ipv4, blacklist_ipv4, tcp_ports, etc.)
312:   - Chain policies are correct (input=drop, output=accept)
313:   - Priority order is correct (-10, -5, 0)
314: 
315: Options:
316:   --json        Output results as JSON
317:   -h, --help    Show this help message
318: 
319: Exit codes:
320:   0   All validation checks passed (OK)
321:   1   Validation warnings or errors found
322: 
323: Examples:
324:   nftban firewall validate
325:   nftban firewall validate --json
326: 
327: Spec file location (priority order):
328:   1. /etc/nftban/spec.json (user override)
329:   2. /usr/share/nftban/specs/structure_default.json (default)
330: 
331: EOF
332: }
333: 
334: show_check_help() {
335:     cat <<'EOF'
336: Usage: nftban firewall check <IP|PORT> [OPTIONS]
337: 
338: Check if IP address or port is blocked or allowed in nftables.
339: 
340: The command:
341:   1. Detects if value is an IP (contains . or :) or port (numeric)
342:   2. Checks nftables processing path (priority -10 → -5 → 0)
343:   3. Shows which rule matched (table, chain, set, verdict)
344:   4. Displays available actions (block, unblock, whitelist, etc.)
345: 
346: Arguments:
347:   IP|PORT       IP address (1.2.3.4 or 2001:db8::1) or port number (22)
348: 
349: Options:
350:   --json        Output results as JSON
351:   -h, --help    Show this help message
352: 
353: Exit codes:
354:   0   Check completed successfully
355:   1   Error (invalid input, nftables error)
356: 
357: Examples:
358:   # Check if IP is blocked
359:   nftban firewall check 1.2.3.4
360: 
361:   # Check if port is allowed
362:   nftban firewall check 22
363: 
364:   # JSON output (for GUI)
365:   nftban firewall check 1.2.3.4 --json
366: 
367: Processing Path:
368:   Priority: ip/ip6 nftban input_temp_whitelist (temp whitelist)
369:   Priority: ip/ip6 nftban input_tempban (temp bans)
370:   Priority: ip/ip6 nftban input (whitelist, blacklist, ports, default deny)
371: 
372: Output includes:
373:   - Status: allowed / blocked / unknown
374:   - Matched rule: table, chain, set/rule, verdict
375:   - Processing path: shows which chains were checked
376:   - Available actions: block, unblock, whitelist, etc.
377: 
378: EOF
379: }

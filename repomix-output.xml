 97: <script>
 98: // Analytics Page - Country-based statistics and charts
 99: let countriesChart = null;
100: let distributionChart = null;
101: let analyticsData = null;
102: 
103: // Country code to flag emoji mapping (common countries)
104: const countryFlags = {
105:     'CN': '🇨🇳', 'RU': '🇷🇺', 'US': '🇺🇸', 'KP': '🇰🇵', 'IR': '🇮🇷', 'VN': '🇻🇳',
106:     'BR': '🇧🇷', 'IN': '🇮🇳', 'ID': '🇮🇩', 'TR': '🇹🇷', 'DE': '🇩🇪', 'FR': '🇫🇷',
107:     'GB': '🇬🇧', 'IT': '🇮🇹', 'ES': '🇪🇸', 'NL': '🇳🇱', 'PL': '🇵🇱', 'UA': '🇺🇦',
108:     'KR': '🇰🇷', 'JP': '🇯🇵', 'MX': '🇲🇽', 'AR': '🇦🇷', 'CA': '🇨🇦', 'AU': '🇦🇺',
109:     'UNK': '🏴'

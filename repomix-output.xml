 170: nftban_report_cmd_generate() {
 171:     # Generate report
 172:     # Usage: nftban report generate [--format FORMAT] [--output FILE] [OPTIONS]
 173: 
 174:     local format="${REPORTS_DEFAULT_FORMAT:-html}"
 175:     local output=""
 176:     local since
 177:     since="$(date -d '7 days ago' +%Y-%m-%d)"
 178:     local until
 179:     until="$(date +%Y-%m-%d)"
 180:     local theme="${REPORTS_THEME:-dark}"
 181:     local allow_unsafe=""
 182: 
 183:     # Parse options
 184:     while [[ $# -gt 0 ]]; do
 185:         case "$1" in
 186:             --format)
 187:                 format="$2"
 188:                 shift 2
 189:                 ;;
 190:             --output)
 191:                 output="$2"
 192:                 shift 2
 193:                 ;;
 194:             --unsafe-allow-tmp)
 195:                 allow_unsafe="allow-unsafe"
 196:                 shift
 197:                 ;;
 198:             --since)
 199:                 since="$2"
 200:                 shift 2
 201:                 ;;
 202:             --until)
 203:                 until="$2"
 204:                 shift 2
 205:                 ;;
 206:             --last)
 207:                 local period="$2"
 208:                 case "$period" in
 209:                     *d) since="$(date -d "${period%d} days ago" +%Y-%m-%d)" ;;
 210:                     *h) since="$(date -d "${period%h} hours ago" +%Y-%m-%d)" ;;
 211:                 esac
 212:                 shift 2
 213:                 ;;
 214:             --theme)
 215:                 theme="$2"
 216:                 shift 2
 217:                 ;;
 218:             *)
 219:                 echo "WARNING: Unknown option: $1" >&2
 220:                 shift
 221:                 ;;
 222:         esac
 223:     done
 224: 
 225:     # Security notice for users
 226:     if [[ -n "$output" ]]; then
 227:         echo "[SECURITY] Output path validation enabled - only approved directories allowed" >&2
 228:         echo "[INFO] Approved locations: ${NFTBAN_DATA_DIR:-/var/lib/nftban}/* (reports, metrics, exports)" >&2
 229:     fi
 230: 
 231:     # Generate based on format
 232:     case "$format" in
 233:         json)
 234:             local safe_output
 235:             safe_output=$(nftban_path_get_safe_output "$output" "${NFTBAN_REPORTS_DIR}" "$allow_unsafe" ".json") || return 1
 236:             nftban_stats_export_json "$safe_output" "$since" "$until"
 237:             ;;
 238:         csv)
 239:             local safe_output
 240:             safe_output=$(nftban_path_get_safe_output "$output" "${NFTBAN_REPORTS_DIR}" "$allow_unsafe" ".csv") || return 1
 241:             nftban_stats_export_csv "$safe_output" "$since" "$until"
 242:             ;;
 243:         html)
 244:             local safe_output
 245:             safe_output=$(nftban_path_get_safe_output "$output" "${NFTBAN_REPORTS_DIR}" "$allow_unsafe" ".html") || return 1
 246:             nftban_report_generate_html "$safe_output" "$since" "$until" "$theme"
 247:             ;;
 248:         all)
 249:             local base_name
 250:             base_name="report-$(date +%Y%m%d-%H%M%S)"
 251:             local safe_json safe_csv safe_html
 252: 
 253:             # Use filename-only mode for 'all' format
 254:             safe_json=$(nftban_path_get_safe_output "${base_name}.json" "${NFTBAN_REPORTS_DIR}" "$allow_unsafe") || return 1
 255:             safe_csv=$(nftban_path_get_safe_output "${base_name}.csv" "${NFTBAN_REPORTS_DIR}" "$allow_unsafe") || return 1
 256:             safe_html=$(nftban_path_get_safe_output "${base_name}.html" "${NFTBAN_REPORTS_DIR}" "$allow_unsafe") || return 1
 257: 
 258:             nftban_stats_export_json "$safe_json" "$since" "$until"
 259:             nftban_stats_export_csv "$safe_csv" "$since" "$until"
 260:             nftban_report_generate_html "$safe_html" "$since" "$until" "$theme"
 261:             ;;
 262:         *)
 263:             echo "ERROR: Unknown format: $format" >&2
 264:             echo "Valid formats: json, csv, html, all" >&2
 265:             return 1
 266:             ;;
 267:     esac
 268: }

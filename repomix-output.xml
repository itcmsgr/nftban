507: # =============================================================================
508: # EXPORTS
509: # =============================================================================
510: 
511: export -f nftban_ddos_classic_enable
512: export -f nftban_ddos_classic_disable
513: export -f nftban_ddos_classic_status
</file>

<file path="cli/lib/nftban/core/nftban_login_alert.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0 - Login Monitor with Auto-Ban
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Login monitoring and alerting
  7: #
  8: # meta:name=nftban_login_alert
  9: # meta:type=core
 10: # meta:header=Login Alert Module
 11: # meta:version=1.0.0
 12: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 13: # meta:homepage=https://nftban.com
 14: #
 15: # **Description & Purpose**
 16: # meta:description=Monitors system logins, detects brute-force, and auto-bans attackers (replaces fail2ban)
 17: # meta:input=System login events and user sessions
 18: # meta:output=Login alerts and notifications
 19: #
 20: # **Inventory & Requirements**
 21: # meta:depends=nftban_distro_config.sh,nftban_geoip_go.sh,last,journalctl
 22: #
 23: # meta:created_date=2025-11-05
 24: # meta:updated_date=2025-11-24
 25: # =============================================================================
 26: 
 27: # Enhanced strict mode
 28: IFS=$'\n\t'
 29: umask 027
 30: 
 31: # Prevent double-loading
 32: [[ -n "${NFTBAN_LOGIN_ALERT_LOADED:-}" ]] && return 0
 33: readonly NFTBAN_LOGIN_ALERT_LOADED=1
 34: 
 35: # =============================================================================
 36: # CONFIGURATION
 37: # =============================================================================
 38: 
 39: # Load configuration
 40: # NFTBAN_LIB_DIR is set by the calling script (cmd_login.sh, etc.)
 41: # Don't set it here - just use it with fallback
 42: NFTBAN_CONFIG_DIR="${NFTBAN_CONFIG_DIR:-/etc/nftban}"
 43: 
 44: # Load main nftban.conf for NFTBAN_BIN and other core paths
 45: # This MUST be sourced before using NFTBAN_BIN variable
 46: if [[ -f "${NFTBAN_CONFIG_DIR}/nftban.conf" ]]; then
 47:     # shellcheck source=/etc/nftban/nftban.conf
 48:     source "${NFTBAN_CONFIG_DIR}/nftban.conf"
 49: fi
 50: 
 51: # Load strict mode library
 52: # shellcheck source=/usr/lib/nftban/lib/strict.sh
 53: if [[ -f "${NFTBAN_LIB_DIR:-/usr/lib/nftban}/lib/strict.sh" ]]; then
 54:     source "${NFTBAN_LIB_DIR:-/usr/lib/nftban}/lib/strict.sh"
 55: else
 56:     # Fallback to manual strict mode
 57:     set -Eeuo pipefail
 58: fi
 59: 
 60: # Load version library
 61: # shellcheck source=/usr/lib/nftban/lib/version.sh
 62: if [[ -f "${NFTBAN_LIB_DIR:-/usr/lib/nftban}/lib/version.sh" ]]; then
 63:     source "${NFTBAN_LIB_DIR:-/usr/lib/nftban}/lib/version.sh"
 64: fi
 65: 
 66: # Load distro configuration for cross-distro service name compatibility
 67: # shellcheck source=/usr/lib/nftban/lib/nftban_distro_config.sh
 68: if [[ -f "${NFTBAN_LIB_DIR:-/usr/lib/nftban}/lib/nftban_distro_config.sh" ]]; then
 69:     source "${NFTBAN_LIB_DIR:-/usr/lib/nftban}/lib/nftban_distro_config.sh"
 70: fi
 71: 
 72: # Load base config first (defaults)
 73: if [[ -f "${NFTBAN_CONFIG_DIR}/conf.d/login_alert.conf" ]]; then
 74:     source "${NFTBAN_CONFIG_DIR}/conf.d/login_alert.conf"
 75: fi
 76: 
 77: # Load local overrides (user customizations)
 78: if [[ -f "${NFTBAN_CONFIG_DIR}/conf.d/login_alert.conf.local" ]]; then
 79:     source "${NFTBAN_CONFIG_DIR}/conf.d/login_alert.conf.local"
 80: fi
 81: 
 82: # Load global mail module for centralized email
 83: if [[ -f "${NFTBAN_LIB_DIR:-/usr/lib/nftban}/core/nftban_mail.sh" ]]; then
 84:     source "${NFTBAN_LIB_DIR:-/usr/lib/nftban}/core/nftban_mail.sh"
 85: fi
 86: 
 87: # Defaults if not set (NO module-specific email - use global NFTBAN_MAIL_RECIPIENT)
 88: NFTBAN_LOGIN_ALERT_ENABLED="${NFTBAN_LOGIN_ALERT_ENABLED:-true}"
 89: NFTBAN_LOGIN_ALERT_SSH="${NFTBAN_LOGIN_ALERT_SSH:-true}"
 90: NFTBAN_LOGIN_ALERT_SU="${NFTBAN_LOGIN_ALERT_SU:-true}"
 91: NFTBAN_LOGIN_ALERT_SUDO="${NFTBAN_LOGIN_ALERT_SUDO:-true}"
 92: NFTBAN_LOGIN_ALERT_CONSOLE="${NFTBAN_LOGIN_ALERT_CONSOLE:-false}"
 93: NFTBAN_LOGIN_ALERT_GEOIP="${NFTBAN_LOGIN_ALERT_GEOIP:-true}"
 94: NFTBAN_LOGIN_ALERT_FORMAT="${NFTBAN_LOGIN_ALERT_FORMAT:-html}"
 95: NFTBAN_LOGIN_ALERT_LOG="${NFTBAN_LOGIN_ALERT_LOG:-/var/log/nftban/login_alert.log}"
 96: NFTBAN_LOGIN_MONITOR_INTERVAL="${NFTBAN_LOGIN_MONITOR_INTERVAL:-5}"
 97: NFTBAN_LOGIN_WHITELIST="${NFTBAN_LOGIN_WHITELIST:-}"
 98: NFTBAN_LOGIN_ALERT_FAILED="${NFTBAN_LOGIN_ALERT_FAILED:-true}"
 99: # Ban threshold: 10 failures in 5 minutes (300 seconds)
100: NFTBAN_LOGIN_FAILED_THRESHOLD="${NFTBAN_LOGIN_FAILED_THRESHOLD:-10}"
101: NFTBAN_LOGIN_FAILED_WINDOW="${NFTBAN_LOGIN_FAILED_WINDOW:-300}"
102: 
103: # Email alert mode: realtime, digest, or both
104: NFTBAN_LOGIN_ALERT_MODE="${NFTBAN_LOGIN_ALERT_MODE:-realtime}"
105: NFTBAN_LOGIN_DIGEST_TIME="${NFTBAN_LOGIN_DIGEST_TIME:-08:00}"
106: NFTBAN_LOGIN_DIGEST_FILE="${NFTBAN_LOGIN_DIGEST_FILE:-/var/lib/nftban/login_digest.json}"
107: 
108: # Template paths
109: NFTBAN_TEMPLATE_DIR="${NFTBAN_TEMPLATE_DIR:-/usr/share/nftban/templates/alerts}"
110: 
111: # Tracking failed attempts
112: declare -A NFTBAN_FAILED_ATTEMPTS
113: declare -A NFTBAN_FAILED_TIMESTAMPS
114: 
115: # =============================================================================
116: # HELPER FUNCTIONS
117: # =============================================================================
118: 
119: nftban_login_alert_log() {
120:     # Log to file and optionally syslog
121:     local message="$1"
122:     local timestamp
123:     timestamp=$(date '+%Y-%m-%d %H:%M:%S')
124: 
125:     # Ensure log directory exists
126:     mkdir -p "$(dirname "$NFTBAN_LOGIN_ALERT_LOG")"
127: 
128:     # Log to file
129:     echo "[$timestamp] $message" >> "$NFTBAN_LOGIN_ALERT_LOG"
130: 
131:     # Log to syslog
132:     logger -t nftban-login-alert "$message"
133: }
134: 
135: nftban_login_is_whitelisted() {
136:     # Check if IP is whitelisted
137:     local ip="$1"
138: 
139:     for whitelisted in $NFTBAN_LOGIN_WHITELIST; do
140:         if [[ "$ip" == "$whitelisted" ]]; then
141:             return 0
142:         fi
143:     done
144: 
145:     return 1
146: }
147: 
148: nftban_login_get_geoip() {
149:     # Get GeoIP information for IP
150:     local ip="$1"
151: 
152:     if [[ "$NFTBAN_LOGIN_ALERT_GEOIP" != "true" ]]; then
153:         echo "GeoIP disabled"
154:         return 0
155:     fi
156: 
157:     # Load GeoIP module if available
158:     if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_geoip_go.sh" ]]; then
159:         source "${NFTBAN_LIB_DIR}/core/nftban_geoip_go.sh"
160: 
161:         if nftban_geoip_check_available 2>/dev/null; then
162:             nftban_geoip_get_compact_full "$ip" 2>/dev/null || echo "Unknown"
163:         else
164:             echo "GeoIP unavailable"
165:         fi
166:     else
167:         echo "GeoIP not installed"
168:     fi
169: }

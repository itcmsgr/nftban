  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - Setup Utilities Library
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Common utility functions for setup scripts
  7: # Location: /usr/lib/nftban/lib/setup_utils.sh
  8: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
  9: # meta:homepage=https://nftban.com
 10: #
 11: # meta:name=setup_utils
 12: # meta:type=lib
 13: # meta:header=Setup Utilities Library
 14: # meta:version=1.0.0
 15: #
 16: # **Description & Purpose**
 17: # meta:description=Common utility functions shared across all setup scripts
 18: # meta:input=None
 19: # meta:output=Utility functions for printing, distro detection, root checks
 20: #
 21: # **Functions Provided**
 22: # - print_status(): Print success message with green checkmark
 23: # - print_error(): Print error message with red X to stderr
 24: # - print_info(): Print info message with yellow indicator
 25: # - check_root(): Verify script is running as root
 26: # - detect_distro(): Detect Linux distribution ID
 27: # - detect_pkg_manager(): Detect package manager for distro
 28: #
 29: # meta:created_date=2025-12-02
 30: # =============================================================================
 31: 
 32: # Guard against multiple sourcing
 33: [[ -n "${_NFTBAN_SETUP_UTILS_LOADED:-}" ]] && return 0
 34: readonly _NFTBAN_SETUP_UTILS_LOADED=1
 35: 
 36: # =============================================================================
 37: # COLORS
 38: # =============================================================================
 39: 
 40: # Only set colors if not already defined (allow overrides)
 41: readonly SETUP_RED="${RED:-\033[0;31m}"
 42: readonly SETUP_GREEN="${GREEN:-\033[0;32m}"
 43: readonly SETUP_YELLOW="${YELLOW:-\033[1;33m}"
 44: readonly SETUP_NC="${NC:-\033[0m}"
 45: 
 46: # =============================================================================
 47: # PRINT FUNCTIONS
 48: # =============================================================================
 49: 
 50: # Print success message with green checkmark
 51: # Usage: print_status "Message"
 52: print_status() {
 53:     echo -e "${SETUP_GREEN}[✓]${SETUP_NC} $1" >&2
 54: }
 55: 
 56: # Print error message with red X to stderr
 57: # Usage: print_error "Error message"
 58: print_error() {
 59:     echo -e "${SETUP_RED}[✗]${SETUP_NC} $1" >&2
 60: }
 61: 
 62: # Print informational message with yellow indicator
 63: # Usage: print_info "Info message"
 64: print_info() {
 65:     echo -e "${SETUP_YELLOW}[i]${SETUP_NC} $1" >&2
 66: }
 67: 
 68: # =============================================================================
 69: # SYSTEM DETECTION FUNCTIONS
 70: # =============================================================================
 71: 
 72: # Check if script is running as root
 73: # Usage: check_root || exit 1
 74: check_root() {
 75:     if [[ $EUID -ne 0 ]]; then
 76:         print_error "This script must be run as root"
 77:         return 1
 78:     fi
 79:     return 0
 80: }
 81: 
 82: # Detect Linux distribution ID
 83: # Usage: distro=$(detect_distro)
 84: # Returns: Distribution ID (e.g., "fedora", "ubuntu", "rocky", "debian")
 85: detect_distro() {
 86:     if [[ -f /etc/os-release ]]; then
 87:         # Source to get ID variable
 88:         # shellcheck source=/dev/null
 89:         . /etc/os-release
 90:         echo "${ID:-unknown}"
 91:     else
 92:         echo "unknown"
 93:     fi
 94: }
 95: 
 96: # Detect package manager for a given distribution
 97: # Usage: pkg_mgr=$(detect_pkg_manager "$distro")
 98: # Returns: "dnf", "apt", or "unknown"
 99: detect_pkg_manager() {
100:     local distro="${1:-$(detect_distro)}"
101: 
102:     case "$distro" in
103:         centos|rhel|fedora|rocky|alma*)
104:             echo "dnf"
105:             ;;
106:         debian|ubuntu)
107:             echo "apt"
108:             ;;
109:         *)
110:             echo "unknown"
111:             ;;
112:     esac
113: }
114: 
115: # =============================================================================
116: # EXPORTS
117: # =============================================================================
118: 
119: export -f print_status
120: export -f print_error
121: export -f print_info
122: export -f check_root
123: export -f detect_distro
124: export -f detect_pkg_manager
125: 

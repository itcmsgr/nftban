566: func cmdFeedsSync(feedsDir, configPath string, cfg *nftbanconf.Config) error {
567: 	// Check for privilege (root OR CAP_NET_ADMIN capability)
568: 	if err := checkPrivilege(); err != nil {
569: 		return err
570: 	}
571: 
572: 	// Path to store last config hash - use data dir from passed config
573: 	stateFile := cfg.DataDir + "/feeds.state"
574: 
575: 	// Check both .conf and .conf.local files
576: 	configFiles := []string{
577: 		configPath,
578: 		configPath + ".local",
579: 	}
580: 
581: 	// Get latest modification time from all config files
582: 	var latestModTime int64
583: 	var changedFile string
584: 	for _, cf := range configFiles {
585: 		if info, err := os.Stat(cf); err == nil {
586: 			modTime := info.ModTime().Unix()
587: 			if modTime > latestModTime {
588: 				latestModTime = modTime
589: 				changedFile = cf
590: 			}
591: 		}
592: 	}
593: 
594: 	if latestModTime == 0 {
595: 		return fmt.Errorf("no config files found")
596: 	}
597: 
598: 	// Read previous mod time from state file
599: 	var lastModTime int64
600: 	if data, err := os.ReadFile(stateFile); err == nil {
601: 		fmt.Sscanf(string(data), "%d", &lastModTime)
602: 	}
603: 
604: 	// Check if config changed
605: 	if latestModTime <= lastModTime {
606: 		fmt.Println("✅ Feeds config unchanged, no sync needed")
607: 		return nil
608: 	}
609: 
610: 	fmt.Println("🔄 Config change detected, syncing feeds...")
611: 	if lastModTime > 0 {

 429: # Helper function: Check if a port is open in nftables
 430: _nftban_panel_check_port() {
 431:     local port="$1"
 432:     local table output
 433:     local old_ifs="$IFS"
 434:     IFS=$' \t\n'  # Reset IFS to default for iteration
 435:     for table in nftban nftban_runtime nftban_filter; do
 436:         # Use command substitution to avoid SIGPIPE with pipefail
 437:         output=$(nft list table inet "$table" 2>/dev/null) || true
 438:         if echo "$output" | grep -q "dport $port"; then
 439:             IFS="$old_ifs"
 440:             return 0
 441:         fi
 442:     done
 443:     IFS="$old_ifs"
 444:     return 1
 445: }

3. Create Alert-Only Jails
Create /etc/fail2ban/jail.d/login-alerts.conf:

ini
[DEFAULT]
# Global settings for alert jails
destemail = security-alerts@yourdomain.com
bantime = -1  # Never ban - alerts only
maxretry = 1  # Alert on every successful login
findtime = 31536000  # 1 year - effectively alert every time

# SSH Successful Login Alerts
[ssh-successful-logins]
enabled = true
port = ssh
logpath = /var/log/auth.log
filter = sshd-successful
action = alert-only[destemail="ssh-alerts@yourdomain.com"]

# System-Wide Login Alerts  
[system-successful-logins]
enabled = true
logpath = /var/log/auth.log
filter = system-login-success
action = alert-only[destemail="login-alerts@yourdomain.com"]

# sudo Alerts
[sudo-usage]
enabled = true
logpath = /var/log/auth.log
filter = sudo
failregex = ^%(__prefix_line)s\s*<F-USER>(\S+)</F-USER> : TTY=\S+ ; PWD=.* ; USER=root ; COMMAND=.*$
action = alert-only[destemail="sudo-alerts@yourdomain.com"]

# Root Login Alerts (if you permit root logins)

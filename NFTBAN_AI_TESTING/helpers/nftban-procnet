import os
import json
import hashlib
import subprocess
import sys

def sha256(path):
    """Calculate SHA-256 hash of a file"""
    try:
        h = hashlib.sha256()
        with open(path, 'rb') as f:
            for chunk in iter(lambda: f.read(1 << 20), b''):
                h.update(chunk)
        return h.hexdigest()
    except Exception:
        return None

def parse_ss():
    """Parse ss output for listening sockets"""
    try:
        result = subprocess.run(
            ["ss", "-H", "-lntup"],
            capture_output=True,
            text=True,
            timeout=10
        )
        if result.returncode != 0:
            return []
    except Exception:
        return []

    items = []
    for line in result.stdout.splitlines():
        try:
            parts = line.split()
            if len(parts) < 5:
                continue

            proto = parts[0]
            state = parts[1]
            local = parts[4]
            pid = None
            exe = None

            # Extract PID from users:((\"sshd\",pid=784,fd=3))
            if "users:(" in line:
                seg = line.split("users:(", 1)[1]
                if "pid=" in seg:
                    try:
                        pid = int(seg.split("pid=", 1)[1].split(",", 1)[0].split(")", 1)[0])
                    except ValueError:
                        pass

                # Get executable path
                if pid and os.path.exists(f"/proc/{pid}/exe"):
                    try:
                        exe = os.path.realpath(f"/proc/{pid}/exe")
                    except Exception:
                        exe = None

            items.append({
                "pid": pid,
                "proto": proto,
                "local": local,
                "state": state,
                "exe": exe,
                "sha256": sha256(exe) if exe else None
            })
        except Exception:
            continue

    return items

def process_list():
    """List all running processes"""
    result = []
    try:
        for d in os.listdir("/proc"):
            if not d.isdigit():
                continue

            pid = int(d)
            base = f"/proc/{pid}"

            try:
                # Read status file
                with open(f"{base}/status") as f:
                    status_lines = f.read().splitlines()

                # Parse status
                kv = {}
                for line in status_lines:
                    if ":\t" in line:
                        key, val = line.split(":\t", 1)
                        kv[key] = val

                ppid = int(kv.get("PPid", "0") or "0")
                uid = int((kv.get("Uid", "0 0 0 0").split()[0]))

                # Get executable
                exe = None
                if os.path.exists(f"{base}/exe"):
                    try:
                        exe = os.path.realpath(f"{base}/exe")
                    except Exception:
                        pass

                # Get command line
                try:
                    with open(f"{base}/cmdline", "rb") as f:
                        cmdline = f.read().replace(b'\x00', b' ').decode(errors='replace').strip()
                except Exception:
                    cmdline = ""

                result.append({
                    "pid": pid,
                    "ppid": ppid,
                    "uid": uid,
                    "exe": exe,
                    "cmdline": cmdline,
                    "sha256": sha256(exe) if exe else None
                })
            except Exception:
                continue
    except Exception:
        pass

    return result

def main():
    """Main entry point"""
    try:
        data = {
            "time": subprocess.getoutput("date -Is"),
            "host": subprocess.getoutput("hostname -f || hostname"),
            "kernel": subprocess.getoutput("uname -r"),
            "processes": process_list(),
            "sockets": parse_ss()
        }

        print(json.dumps(data, ensure_ascii=False))
        return 0
    except Exception as e:
        print(json.dumps({"error": str(e)}), file=sys.stderr)
        return 1

if __name__ == "__main__":
    sys.exit(main())

#!/bin/bash
# =============================================================================
# NFTBan v1.75.0 - DEB Package Post-Install Script (Go installer wrapper)
# =============================================================================
# SPDX-License-Identifier: MPL-2.0
#
# meta:name="postinst"
# meta:type="packaging"
# meta:owner="Antonios Voulvoulis <contact@nftban.com>"
# meta:created_date="2025-10-26"
# meta:description="DEB postinst thin wrapper — delegates to Go nftban-installer"
# meta:input="None"
# meta:output="Configured NFTBan system"
# meta:depends="adduser,addgroup,systemctl"
# meta:inventory.files="/etc/nftban/,/var/lib/nftban/"
# meta:inventory.binaries="adduser,addgroup,usermod,systemctl"
# meta:inventory.env_vars=""
# meta:inventory.config_files="/etc/nftban/nftban.conf"
# meta:inventory.systemd_units=""
# meta:inventory.network=""
# meta:inventory.privileges="root"
#
# v1.75.0: Replaced 1,545-line shell postinst with thin Go installer wrapper.
# The Go binary (nftban-installer) handles: detection, rendering, switchop,
# services, validation, permissions, whitelist sync, panel/login enable,
# stale cleanup, post-install assertions, authority + history writes.
# This wrapper handles only DEB-idiomatic bootstrap that must run before Go.
# =============================================================================

set -Eeuo pipefail

NFTBAN_INSTALLER="/usr/lib/nftban/bin/nftban-installer"

log_info()  { echo "[NFTBan] $*"; }
log_warn()  { echo "[NFTBan WARN] $*"; }
log_error() { echo "[NFTBan ERROR] $*"; }

case "$1" in
    configure)

        # =================================================================
        # PRE-GO BOOTSTRAP (must run before any nftban binary)
        # =================================================================

        # --- CVE-2025-NFTBAN-001: conflicting inet filter table ---
        if command -v nft >/dev/null 2>&1; then
            if nft list table inet filter >/dev/null 2>&1; then
                if [ -n "${2:-}" ]; then
                    log_warn "Conflicting 'inet filter' table detected — auto-removing for upgrade"
                    nft delete table inet filter 2>/dev/null || true
                else
                    log_error "Conflicting 'inet filter' table detected!"
                    log_error "This table will bypass nftban blocking (CVE-2025-NFTBAN-001)."
                    log_error "Please run: nft delete table inet filter"
                    log_error "Then re-install the package."
                    exit 1
                fi
            fi
        fi

        # --- Remove immutable flags so package manager can overwrite files ---
        for immutable_file in /etc/nftban/nftban.conf /usr/lib/nftban/lib/nft_schema.sh; do
            if [ -f "$immutable_file" ]; then
                chattr -i "$immutable_file" 2>/dev/null || true
            fi
        done

        # --- Distro compatibility warning ---
        if [ -f /usr/lib/nftban/BUILD_TARGET ] && [ -f /etc/os-release ]; then
            # shellcheck source=/dev/null
            . /etc/os-release 2>/dev/null || true
            _build_target=$(cat /usr/lib/nftban/BUILD_TARGET 2>/dev/null || echo "unknown:0")
            _build_id="${_build_target%%:*}"
            _build_ver="${_build_target#*:}"
            if [ "$_build_id" != "unknown" ] && [ "$_build_id" != "${ID:-unknown}" ]; then
                log_warn "Package built for $_build_id but running on ${ID:-unknown}"
            elif [ "$_build_ver" != "0" ] && [ "$_build_ver" != "${VERSION_ID:-0}" ]; then
                log_warn "Package built for $_build_id $_build_ver but running on ${ID:-unknown} ${VERSION_ID:-0}"
            fi
        fi

        # --- Create system groups and user (DEB-idiomatic: adduser/addgroup) ---
        if ! getent group nftban >/dev/null 2>&1; then
            addgroup --system nftban
        fi
        if ! getent group nftban-auditor >/dev/null 2>&1; then
            addgroup --system nftban-auditor
        fi
        if ! getent group nftban-panel >/dev/null 2>&1; then
            addgroup --system nftban-panel
        fi
        if ! getent group suricata >/dev/null 2>&1; then
            addgroup --system suricata
        fi
        if ! getent passwd nftban >/dev/null 2>&1; then
            adduser --system --group --home /var/lib/nftban \
                --no-create-home --disabled-login \
                --gecos "NFTBan system user" nftban
        fi
        if ! id -nG root 2>/dev/null | grep -qw nftban; then
            usermod -a -G nftban root 2>/dev/null || true
        fi

        # --- Critical FHS dirs (Go installer needs state dir to exist) ---
        mkdir -p /var/lib/nftban/state
        mkdir -p /var/log/nftban

        # --- yq v4 linking (CLI commands called by Go installer need yq) ---
        if command -v yq >/dev/null 2>&1; then
            YQ_VER=$(yq --version 2>/dev/null | head -1 || true)
            if echo "$YQ_VER" | grep -qE "mikefarah|version v4" >/dev/null 2>&1; then
                true  # yq v4 already available
            else
                if [ -x /usr/lib/nftban/bin/yq ]; then
                    ln -sf /usr/lib/nftban/bin/yq /usr/bin/yq
                    log_info "yq v4 linked from bundled binary"
                fi
            fi
        else
            if [ -x /usr/lib/nftban/bin/yq ]; then
                ln -sf /usr/lib/nftban/bin/yq /usr/bin/yq
                log_info "yq v4 linked from bundled binary"
            fi
        fi

        # --- Reload systemd so new unit files are visible ---
        systemctl daemon-reload 2>/dev/null || true

        # =================================================================
        # GO INSTALLER
        # =================================================================

        # DEB mode detection: $2 non-empty = upgrade, empty = fresh install
        if [ -n "${2:-}" ]; then
            INSTALL_MODE="upgrade"
        else
            INSTALL_MODE="install"
        fi

        if [ -x "$NFTBAN_INSTALLER" ]; then
            log_info "Running nftban-installer --deb (mode=$INSTALL_MODE)..."

            "$NFTBAN_INSTALLER" --deb --mode="$INSTALL_MODE"
            INSTALLER_EXIT=$?

            if [ $INSTALLER_EXIT -eq 0 ]; then
                log_info "========================================"
                log_info " NFTBan — COMMITTED"
                log_info "========================================"
            elif [ $INSTALLER_EXIT -eq 1 ]; then
                log_info "========================================"
                log_info " NFTBan — DEGRADED"
                log_info "========================================"
                log_info "Some post-install checks failed."
                log_info "To fix: nftban-installer --repair"
            elif [ $INSTALLER_EXIT -eq 3 ]; then
                log_info "========================================"
                log_info " NFTBan — ABORTED"
                log_info "========================================"
                log_info "Conflicting firewalls detected, takeover not approved."
                log_info "To takeover: NFTBAN_TAKEOVER=1 dpkg --configure nftban-core"
            else
                log_error "========================================"
                log_error " NFTBan — FAILED"
                log_error "========================================"
                log_error "See log: /var/log/nftban/installer.log"
                log_error "To retry: /usr/lib/nftban/bin/nftban-installer --repair"
                log_error "Or: nftban firewall rebuild"
            fi
        else
            log_error "Installer binary not found: $NFTBAN_INSTALLER"
            log_error "Package may be corrupt. Try reinstalling."
            log_info "Files have been installed but firewall is NOT active."
        fi

        # --- Cache ownership fix (after installer) ---
        find /var/cache/nftban -type f -exec chown nftban:nftban {} \; 2>/dev/null || true
        find /var/cache/nftban -type d -exec chown nftban:nftban {} \; 2>/dev/null || true

        ;;
esac

#DEBHELPER#

exit 0

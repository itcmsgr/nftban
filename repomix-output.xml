137:       ct state established,related accept
138:       iif lo accept
139:       ip6 saddr @whitelist accept
140:       icmpv6 type { echo-request, echo-reply, nd-neighbor-solicit, nd-neighbor-advert } accept
141:       tcp dport $SSH_PORT accept
142:       ct state invalid drop
143:       ip6 saddr @temp_ban drop
144:       ip6 saddr @user_blacklist drop
145:       ip6 saddr @system_blacklist drop
146:       ip6 saddr @feeds drop
147:     }
148:   }
149: }
150: HDR
151: 
152:   # Populate sets from your compiled files if present
153:   [[ -s "$V4_WL"    ]] && echo "add element ip  \$T4_NEW whitelist        { $(tr '\n' ',' <"$V4_WL"    | sed 's/,$//') }"
154:   [[ -s "$V4_BL"    ]] && echo "add element ip  \$T4_NEW user_blacklist   { $(tr '\n' ',' <"$V4_BL"    | sed 's/,$//') }"
155:   [[ -s "$V4_FEEDS" ]] && echo "add element ip  \$T4_NEW feeds            { $(tr '\n' ',' <"$V4_FEEDS" | sed 's/,$//') }"
156: 
157:   [[ -s "$V6_WL"    ]] && echo "add element ip6 \$T6_NEW whitelist        { $(tr '\n' ',' <"$V6_WL"    | sed 's/,$//') }"
158:   [[ -s "$V6_BL"    ]] && echo "add element ip6 \$T6_NEW user_blacklist   { $(tr '\n' ',' <"$V6_BL"    | sed 's/,$//') }"
159:   [[ -s "$V6_FEEDS" ]] && echo "add element ip6 \$T6_NEW feeds            { $(tr '\n' ',' <"$V6_FEEDS" | sed 's/,$//') }"
160: }
161: 
162: # Validate batch syntactically without applying (nft -c)
163: _validate_batch() {
164:   local batchfile="$1"
165:   ${NFTBIN} -c -f "$batchfile" >/dev/null
166: }
167: 
168: # Perform *atomic* rename-swap inside a single transaction
169: _do_atomic_swap() {
170:   ${NFTBIN} -f - <<'EOF'
171: # If current tables don't exist, skip renames gracefully
172: define T4_CUR = nftban_v4
173: define T6_CUR = nftban_v6
174: define T4_OLD = nftban_v4_old
175: define T6_OLD = nftban_v6_old
176: define T4_NEW = nftban_v4_new
177: define T6_NEW = nftban_v6_new
178: 
179: # Clean previous *_old if left over
180: delete table ip   $T4_OLD 2>/dev/null
181: delete table ip6  $T6_OLD 2>/dev/null
182: 
183: # If current exist, rename to *_old
184: rename table ip  $T4_CUR $T4_OLD 2>/dev/null
185: rename table ip6 $T6_CUR $T6_OLD 2>/dev/null
186: 
187: # New → current names
188: rename table ip  $T4_NEW $T4_CUR
189: rename table ip6 $T6_NEW $T6_CUR
190: 
191: # Drop old after successful swap
192: delete table ip  $T4_OLD 2>/dev/null
193: delete table ip6 $T6_OLD 2>/dev/null
194: EOF
195: }
196: 
197: # Full atomic reload entrypoint
198: nftban_atomic_reload() {
199:   _lock
200:   trap '_unlock' EXIT
201: 
202:   local backup
203:   backup="$(backup_ruleset)"
204: 
205:   # Build batch for new tables in a temp file
206:   local tmpbatch
207:   tmpbatch="$(mktemp --tmpdir="${RUNDIR}" nftban-newtables.XXXXXX)"
208:   trap 'rm -f "$tmpbatch" || true' RETURN
209: 
210:   # Paths (adjust if you split v4/v6 into separate compiled files)
211:   local V4_WL="${NFTBAN_DATA_DIR}/compiled/whitelist.txt"
212:   local V4_BL="${NFTBAN_DATA_DIR}/compiled/blacklist.txt"
213:   local V4_FEEDS="${NFTBAN_DATA_DIR}/compiled/feeds.txt"
214:   local V6_WL="${NFTBAN_DATA_DIR}/compiled/whitelist6.txt"
215:   local V6_BL="${NFTBAN_DATA_DIR}/compiled/blacklist6.txt"
216:   local V6_FEEDS="${NFTBAN_DATA_DIR}/compiled/feeds6.txt"
217: 
218:   _build_new_tables_batch "$V4_WL" "$V4_BL" "$V4_FEEDS" "$V6_WL" "$V6_BL" "$V6_FEEDS" >"$tmpbatch"
219: 
220:   # Validate syntactically
221:   _validate_batch "$tmpbatch"
222: 
223:   # Apply creation & population of *new* tables
224:   ${NFTBIN} -f "$tmpbatch"
225: 
226:   # Atomic swap (single transaction)
227:   _do_atomic_swap
228: 
229:   # Post-check: ensure tables exist and have elements (basic sanity)
230:   ${NFTBIN} list table ip nftban_v4 >/dev/null
231:   ${NFTBIN} list table ip6 nftban_v6 >/dev/null || true  # Allow v6-less hosts
232: 
233:   echo "[OK] Atomic reload complete. Backup at: $backup"
234:   return 0
235: }
236: 
237: # Rollback helper (in the unlikely case we need manual rollback)
238: nftban_rollback_last_backup() {
239:   _lock
240:   trap '_unlock' EXIT
241:   local last="${BACKUP_DIR}/backup-latest.nft"
242:   [[ -f "$last" ]] || { echo "No backup found"; return 1; }
243:   ${NFTBIN} -f "$last"
244:   echo "[OK] Rolled back to: $(readlink -f "$last")"
245: }
</file>

<file path="cli/lib/nftban/core/nftban_path_security.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - Path Validation & Write Security Module
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Secure path validation for file writes (reports, exports, logs)
  7: #
  8: # meta:name=nftban_path_security
  9: # meta:type=core
 10: # meta:header=Path Validation & Write Security
 11: # meta:version=1.0.0
 12: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 13: # meta:homepage=https://nftban.com
 14: #
 15: # **Description & Purpose**
 16: # meta:description=Secure path validation to prevent path traversal and unauthorized writes
 17: # meta:input=File paths for validation
 18: # meta:output=Validated safe paths or rejection with error messages
 19: #
 20: # **Inventory & Requirements**
 21: # meta:depends=bash,realpath
 22: #
 23: # meta:created_date=2025-11-05
 24: # meta:updated_date=2025-11-24
 25: # =============================================================================
 26: 
 27: 
 28: # Module guard
 29: [[ -n "${NFTBAN_PATH_SECURITY_LOADED:-}" ]] && return 0
 30: declare -g NFTBAN_PATH_SECURITY_LOADED=1
 31: 
 32: # =============================================================================
 33: # SECURITY CONFIGURATION
 34: # =============================================================================
 35: 
 36: # Allowed write directories (FHS compliant)
 37: declare -ga NFTBAN_ALLOWED_WRITE_DIRS=(
 38:     "${NFTBAN_DATA_DIR}/reports"      # Application state reports
 39:     "${NFTBAN_DATA_DIR}/metrics"      # Statistics metrics database
 40:     "${NFTBAN_DATA_DIR}/snapshots"    # Hourly stats snapshots
 41:     "${NFTBAN_DATA_DIR}/exports"      # User exports
 42:     "${NFTBAN_DATA_DIR}/geoip"        # GeoIP database
 43:     "${NFTBAN_LOG_DIR}"                # Log files (daemon writes)
 44:     "${NFTBAN_LOG_DIR}/reports"        # Report files in logs
 45:     "${NFTBAN_CACHE_DIR}"              # Cache files
 46: )
 47: 
 48: # Restricted directories (require --unsafe-allow-tmp flag + warning)
 49: declare -ga NFTBAN_RESTRICTED_DIRS=(
 50:     "/tmp"
 51:     "/var/tmp"
 52: )
 53: 
 54: # Forbidden directories (NEVER allow, even with --unsafe)
 55: declare -ga NFTBAN_FORBIDDEN_DIRS=(
 56:     "/etc"             # System configuration (except /etc/nftban handled separately)
 57:     "/boot"            # Boot files
 58:     "/root"            # Root home directory
 59:     "/usr"             # System binaries and libraries
 60:     "/bin"             # Essential binaries
 61:     "/sbin"            # System binaries
 62:     "/lib"             # Essential libraries
 63:     "/lib64"           # Essential libraries (64-bit)
 64:     "/sys"             # Kernel sysfs
 65:     "/proc"            # Kernel procfs
 66:     "/dev"             # Device files
 67: )
 68: 
 69: # =============================================================================
 70: # PATH VALIDATION FUNCTIONS
 71: # =============================================================================
 72: 
 73: # -----------------------------------------------------------------------------
 74: # Validate if path is safe for writing
 75: # Arguments:
 76: #   $1 - Path to validate
 77: #   $2 - (optional) "allow-unsafe" to permit /tmp
 78: # Returns:
 79: #   0 if safe, 1 if unsafe
 80: # Output:
 81: #   Error message on stderr if unsafe
 82: # Security:
 83: #   - Blocks path traversal (..)
 84: #   - Blocks null bytes
 85: #   - Canonicalizes paths
 86: #   - Checks against forbidden/allowed/restricted lists
 87: # -----------------------------------------------------------------------------
 88: nftban_path_validate_write() {
 89:     local path="$1"
 90:     local allow_unsafe="${2:-}"
 91: 
 92:     # Empty path
 93:     if [[ -z "$path" ]]; then
 94:         echo "ERROR: Empty path not allowed" >&2
 95:         return 1
 96:     fi
 97: 
 98:     # Convert to absolute path
 99:     if [[ "$path" != /* ]]; then
100:         path="$(pwd)/$path"
101:     fi
102: 
103:     # Resolve symlinks and canonicalize (prevent symlink attacks)
104:     if command -v realpath >/dev/null 2>&1; then
105:         path="$(realpath -m "$path" 2>/dev/null || echo "$path")"
106:     fi
107: 
108:     # Check for path traversal attempts (..)
109:     if [[ "$path" =~ \.\. ]]; then
110:         echo "ERROR: Path traversal detected (..) - FORBIDDEN" >&2
111:         echo "  Path: $path" >&2
112:         nftban_path_audit_log "DENIED" "path_traversal path=$path"
113:         return 1
114:     fi
115: 
116:     # Note: Null byte check removed - bash variables can't contain null bytes anyway
117:     # (they would be stripped during variable assignment)
118:     # Real protection is at kernel syscall level
119: 
120:     # Check FORBIDDEN directories (highest priority - never allow)
121:     local forbidden_dir
122:     for forbidden_dir in "${NFTBAN_FORBIDDEN_DIRS[@]}"; do
123:         if [[ "$path" == "$forbidden_dir" ]] || [[ "$path" == "$forbidden_dir"/* ]]; then
124:             echo "ERROR: Writing to $forbidden_dir is FORBIDDEN for security" >&2
125:             echo "  Attempted path: $path" >&2
126:             echo "  Reason: System directory - potential compromise" >&2
127:             nftban_path_audit_log "DENIED" "forbidden_dir path=$path forbidden=$forbidden_dir"
128:             return 1
129:         fi
130:     done
131: 
132:     # Check ALLOWED directories (safe, no warning)
133:     local allowed_dir
134:     for allowed_dir in "${NFTBAN_ALLOWED_WRITE_DIRS[@]}"; do
135:         if [[ "$path" == "$allowed_dir"/* ]] || [[ "$path" == "$allowed_dir" ]]; then
136:             nftban_path_audit_log "ALLOWED" "safe_path path=$path allowed_dir=$allowed_dir"
137:             return 0
138:         fi
139:     done
140: 
141:     # Check RESTRICTED directories (/tmp - requires --unsafe flag)
142:     local restricted_dir
143:     for restricted_dir in "${NFTBAN_RESTRICTED_DIRS[@]}"; do
144:         if [[ "$path" == "$restricted_dir"/* ]] || [[ "$path" == "$restricted_dir" ]]; then
145:             if [[ "$allow_unsafe" == "allow-unsafe" ]]; then
146:                 echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" >&2
147:                 echo "⚠️  SECURITY WARNING: Writing to $restricted_dir" >&2
148:                 echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" >&2
149:                 echo "  Path: $path" >&2
150:                 echo "" >&2
151:                 echo "  RISKS:" >&2
152:                 echo "    • Symlink attacks (attacker creates symlink before you)" >&2
153:                 echo "    • Race conditions (TOCTOU)" >&2
154:                 echo "    • Information disclosure (world-readable by default)" >&2
155:                 echo "    • Temporary files may be preserved across reboots" >&2
156:                 echo "" >&2
157:                 echo "  This operation proceeds because --unsafe-allow-tmp was used." >&2
158:                 echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" >&2
159:                 nftban_path_audit_log "WARNING" "unsafe_tmp_allowed path=$path"
160:                 return 0
161:             else
162:                 echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" >&2
163:                 echo "❌ ERROR: Writing to $restricted_dir REQUIRES --unsafe-allow-tmp" >&2
164:                 echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" >&2
165:                 echo "  Attempted path: $path" >&2
166:                 echo "" >&2
167:                 echo "  SECURITY RISKS:" >&2
168:                 echo "    • Symlink attacks - attacker creates /tmp/report.html → /etc/passwd" >&2
169:                 echo "    • Race conditions - file created between check and write" >&2
170:                 echo "    • Information disclosure - other users can read files" >&2
171:                 echo "    • Privilege escalation - if run as root with user-controlled paths" >&2
172:                 echo "" >&2
173:                 echo "  RECOMMENDED ALTERNATIVES (safer):" >&2
174:                 echo "    1. Use default location (automatic):" >&2
175:                 echo "       nftban report generate" >&2
176:                 echo "       → /var/lib/nftban/reports/report-YYYYMMDD-HHMMSS.html" >&2
177:                 echo "" >&2
178:                 echo "    2. Use filename only (writes to safe directory):" >&2
179:                 echo "       nftban report generate --output myreport.html" >&2
180:                 echo "       → /var/lib/nftban/reports/myreport.html" >&2
181:                 echo "" >&2
182:                 echo "    3. Use --stdout and redirect (you control destination):" >&2
183:                 echo "       nftban report generate --stdout > ~/report.html" >&2
184:                 echo "" >&2
185:                 echo "  UNSAFE OPTION (not recommended):" >&2
186:                 echo "    nftban report generate --output /tmp/report.html --unsafe-allow-tmp" >&2
187:                 echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" >&2
188:                 nftban_path_audit_log "DENIED" "restricted_tmp path=$path missing_unsafe_flag=true"
189:                 return 1
190:             fi
191:         fi
192:     done
193: 
194:     # Path not in any allowed/restricted/forbidden directory
195:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" >&2
196:     echo "❌ ERROR: Path not in allowed write directories" >&2
197:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" >&2
198:     echo "  Attempted path: $path" >&2
199:     echo "" >&2
200:     echo "  ALLOWED DIRECTORIES:" >&2
201:     for allowed_dir in "${NFTBAN_ALLOWED_WRITE_DIRS[@]}"; do
202:         echo "    ✓ $allowed_dir" >&2
203:     done
204:     echo "" >&2
205:     echo "  RECOMMENDED:" >&2
206:     echo "    • Use default: nftban report generate" >&2
207:     echo "    • Use filename only: --output report.html" >&2
208:     echo "    • Use redirect: --stdout > ~/report.html" >&2
209:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" >&2
210:     nftban_path_audit_log "DENIED" "not_in_allowed_dirs path=$path"
211:     return 1
212: }
213: 
214: # -----------------------------------------------------------------------------
215: # Sanitize filename (remove dangerous characters)
216: # Arguments:
217: #   $1 - Filename to sanitize
218: # Output:
219: #   Sanitized filename
220: # Security:
221: #   - Removes path separators (/)
222: #   - Removes null bytes
223: #   - Removes newlines/control characters
224: #   - Removes leading dots (hidden files)
225: # -----------------------------------------------------------------------------
226: nftban_path_sanitize_filename() {
227:     local filename="$1"
228: 
229:     # Remove path components (keep only basename)
230:     filename="${filename##*/}"
231: 
232:     # Replace dangerous characters with underscore
233:     filename="${filename//[\\/\0\n\r\t]/_}"
234: 
235:     # Remove leading dots (prevent hidden files)
236:     filename="${filename#.}"
237: 
238:     # Remove multiple consecutive underscores
239:     filename="${filename//__/_}"
240: 
241:     # Ensure not empty
242:     if [[ -z "$filename" ]]; then
243:         filename="report-$(date +%s)"
244:     fi
245: 
246:     echo "$filename"
247: }
248: 
249: # -----------------------------------------------------------------------------
250: # Get safe output path (main function - handles all cases)
251: # Arguments:
252: #   $1 - User-provided path (can be empty, filename, or full path)
253: #   $2 - Default directory
254: #   $3 - (optional) "allow-unsafe" flag
255: # Output:
256: #   Safe validated path
257: # Returns:
258: #   0 if successful, 1 if validation failed
259: # Usage:
260: #   safe=$(nftban_path_get_safe_output "$user_input" "/var/lib/nftban/reports") || return 1
261: # -----------------------------------------------------------------------------
262: nftban_path_get_safe_output() {
263:     local user_path="$1"
264:     local default_dir="$2"
265:     local allow_unsafe="${3:-}"
266:     local default_ext="${4:-.html}"
267: 
268:     # Case 1: Empty path → use default
269:     if [[ -z "$user_path" ]]; then
270:         echo "${default_dir}/report-$(date +%Y%m%d-%H%M%S)${default_ext}"
271:         return 0
272:     fi
273: 
274:     # Case 2: Filename only (no path separators) → use default directory
275:     if [[ "$user_path" != */* ]]; then
276:         local sanitized
277:         sanitized=$(nftban_path_sanitize_filename "$user_path")
278:         local safe_path="${default_dir}/${sanitized}"
279:         echo "$safe_path"
280:         nftban_path_audit_log "ALLOWED" "filename_only input=$user_path output=$safe_path"
281:         return 0
282:     fi
283: 
284:     # Case 3: Full path → validate it
285:     if nftban_path_validate_write "$user_path" "$allow_unsafe"; then
286:         echo "$user_path"
287:         return 0
288:     else
289:         # Validation failed, error already printed
290:         return 1
291:     fi
292: }
293: 
294: # -----------------------------------------------------------------------------
295: # Create file safely (prevents symlink attacks, TOCTOU)
296: # Arguments:
297: #   $1 - Path to create
298: # Returns:
299: #   0 if successful, 1 on failure
300: # Security:
301: #   - Checks for symlinks before writing
302: #   - Creates parent directories safely
303: #   - Uses set -C (noclobber) when creating new files
304: # -----------------------------------------------------------------------------
305: nftban_path_create_file_safe() {
306:     local path="$1"
307:     local dir
308:     dir="$(dirname "$path")"
309: 
310:     # Create directory if needed
311:     if [[ ! -d "$dir" ]]; then
312:         if ! mkdir -p "$dir" 2>/dev/null; then
313:             echo "ERROR: Cannot create directory: $dir" >&2
314:             nftban_path_audit_log "DENIED" "mkdir_failed path=$dir"
315:             return 1
316:         fi
317:     fi
318: 
319:     # Check if path exists and is a symlink (BEFORE writing)
320:     if [[ -L "$path" ]]; then
321:         echo "ERROR: Target is a symbolic link - REFUSING to write" >&2
322:         echo "  Path: $path" >&2
323:         echo "  Reason: Symlink attack prevention" >&2
324:         nftban_path_audit_log "DENIED" "symlink_attack_prevented path=$path"
325:         return 1
326:     fi
327: 
328:     # If file exists, check if it's a regular file
329:     if [[ -e "$path" ]]; then
330:         if [[ ! -f "$path" ]]; then
331:             echo "ERROR: Target exists and is not a regular file" >&2
332:             echo "  Path: $path" >&2
333:             nftban_path_audit_log "DENIED" "not_regular_file path=$path"
334:             return 1
335:         fi
336:         # Regular file exists - will be overwritten
337:         nftban_path_audit_log "ALLOWED" "overwrite_file path=$path"
338:         return 0
339:     fi
340: 
341:     # Create new file with noclobber (prevents race condition)
342:     set -C
343:     if ! { : > "$path"; } 2>/dev/null; then
344:         # Failed to create (race condition - file appeared)
345:         set +C
346:         echo "ERROR: Race condition detected - file appeared during creation" >&2
347:         echo "  Path: $path" >&2
348:         nftban_path_audit_log "DENIED" "race_condition path=$path"
349:         return 1
350:     fi
351:     set +C
352: 
353:     nftban_path_audit_log "ALLOWED" "create_file path=$path"
354:     return 0
355: }
356: 
357: # =============================================================================
358: # AUDIT LOGGING
359: # =============================================================================
360: 
361: # -----------------------------------------------------------------------------
362: # Log path security event to audit log
363: # Arguments:
364: #   $1 - Event type (ALLOWED, DENIED, WARNING)
365: #   $2 - Message
366: # Output:
367: #   Appends to /var/log/nftban/security-audit.log
368: # Security:
369: #   - Logs all path validation decisions
370: #   - Includes timestamp, user, PID, action
371: # -----------------------------------------------------------------------------
372: nftban_path_audit_log() {
373:     local event_type="$1"
374:     local message="$2"
375:     local audit_log="${NFTBAN_LOG_DIR}/security-audit.log"
376: 
377:     # Only log if parent directory exists
378:     if [[ -d "$(dirname "$audit_log")" ]]; then
379:         local timestamp
380:         timestamp=$(date '+%Y-%m-%d %H:%M:%S')
381:         local user="${SUDO_USER:-${USER:-unknown}}"
382:         local pid="$$"
383:         local ppid="${PPID:-0}"
384: 
385:         # Format: timestamp [TYPE] pid=PID ppid=PPID user=USER action message
386:         echo "${timestamp} [${event_type}] pid=${pid} ppid=${ppid} user=${user} ${message}" \
387:             >> "$audit_log" 2>/dev/null || true
388:     fi
389: }
390: 
391: # =============================================================================
392: # MODULE INITIALIZATION
393: # =============================================================================
394: 
395: # Export functions for use by other modules
396: declare -fx nftban_path_validate_write
397: declare -fx nftban_path_sanitize_filename
398: declare -fx nftban_path_get_safe_output
399: declare -fx nftban_path_create_file_safe
400: declare -fx nftban_path_audit_log
401: 
402: return 0
</file>

<file path="cli/lib/nftban/core/nftban_permissions.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - Permission Hardening Module
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Enforce secure ownership and permissions on critical paths
  7: #
  8: # meta:name=nftban_permissions
  9: # meta:type=core
 10: # meta:header=Permission Hardening Module
 11: # meta:version=1.0.0
 12: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 13: # meta:homepage=https://nftban.com
 14: #
 15: # **Description & Purpose**
 16: # meta:description=Enforces strict permissions on NFTBan directories and files to prevent unauthorized access
 17: # meta:input=System paths and current permission states
 18: # meta:output=Enforced secure permissions and ownership
 19: #
 20: # **Inventory & Requirements**
 21: # meta:depends=bash,chmod,chown
 22: #
 23: # meta:created_date=2025-11-05
 24: # meta:updated_date=2025-11-24
 25: # =============================================================================
 26: 
 27: # Enhanced strict mode
 28: IFS=$'\n\t'
 29: umask 027
 30: 
 31: # Prevent double-loading
 32: [[ -n "${NFTBAN_PERMISSIONS_LOADED:-}" ]] && return 0
 33: readonly NFTBAN_PERMISSIONS_LOADED=1
 34: 
 35: # =============================================================================
 36: # CONFIGURATION
 37: # =============================================================================
 38: 
 39: # Load FHS spec for canonical paths
 40: if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_fhs_spec.sh" ]]; then
 41:     source "${NFTBAN_LIB_DIR}/core/nftban_fhs_spec.sh"
 42: fi
 43: 
 44: # Fallback paths if FHS spec not available
 45: readonly PERMS_ETC="${NFTBAN_CONFIG_DIR:-/etc/nftban}"
 46: readonly PERMS_LIB="${NFTBAN_LIB_DIR:-/usr/lib/nftban}"
 47: readonly PERMS_SBIN="${NFTBAN_SBIN_DIR:-/usr/sbin}"
 48: readonly PERMS_VAR="${NFTBAN_VAR_DIR:-/var/lib/nftban}"
 49: readonly PERMS_LOG="${NFTBAN_LOG_DIR:-/var/log/nftban}"
 50: readonly PERMS_USRSHARE="${NFTBAN_SHARE_DIR:-/usr/share/nftban}"
 51: 
 52: # Audit logging
 53: readonly PERMS_AUDIT_LOG="${PERMS_VAR}/permissions_audit.log"
 54: 
 55: # =============================================================================
 56: # HELPER FUNCTIONS
 57: # =============================================================================
 58: 
 59: perms_say() {
 60:     # Print message
 61:     # Args: message
 62:     printf "[PERMS] %s\n" "$*"
 63: }
 64: 
 65: perms_err() {
 66:     # Print error message
 67:     # Args: message
 68:     printf "[PERMS ERROR] %s\n" "$*" >&2
 69: }
 70: 
 71: perms_warn() {
 72:     # Print warning message
 73:     # Args: message
 74:     printf "[PERMS WARNING] %s\n" "$*" >&2
 75: }
 76: 
 77: perms_log_audit() {
 78:     # Log to audit trail
 79:     # Args: message
 80:     local timestamp
 81:     timestamp=$(date '+%Y-%m-%d %H:%M:%S')
 82:     local user="${SUDO_USER:-${USER:-root}}"
 83: 
 84:     # Create audit log if it doesn't exist (with correct ownership)
 85:     if [[ ! -f "$PERMS_AUDIT_LOG" ]]; then
 86:         mkdir -p "$(dirname "$PERMS_AUDIT_LOG")"
 87:         touch "$PERMS_AUDIT_LOG"
 88:         chown nftban:nftban "$PERMS_AUDIT_LOG" 2>/dev/null || true
 89:         chmod 640 "$PERMS_AUDIT_LOG"
 90:     fi
 91: 
 92:     # Write audit entry
 93:     echo "[$timestamp] [$user] $*" >> "$PERMS_AUDIT_LOG"
 94: }
 95: 
 96: perms_run() {
 97:     # Run command (or simulate in dry-run mode)
 98:     # Args: command and arguments
 99: 
100:     if [[ "${PERMS_DRYRUN:-0}" == "1" ]]; then
101:         perms_say "DRYRUN: $*"
102:     else
103:         # Log the action to audit trail
104:         perms_log_audit "EXEC: $*"
105: 
106:         "$@" || {
107:             perms_err "Command failed: $*"
108:             perms_log_audit "FAILED: $*"
109:             return 1
110:         }
111: 
112:         perms_log_audit "SUCCESS: $*"
113:     fi
114: }
115: 
116: # =============================================================================
117: # DIRECTORY CREATION WITH SAFE PERMISSIONS
118: # =============================================================================
119: 
120: perms_mkd() {
121:     # Create directory with safe permissions
122:     # Args: path, mode, owner, group
123: 
124:     local path="$1"
125:     local mode="$2"
126:     local owner="${3:-root}"
127:     local group="${4:-root}"
128: 
129:     if [[ ! -d "$path" ]]; then
130:         perms_say "Creating directory: $path ($owner:$group $mode)"
131:         perms_run install -d -o "$owner" -g "$group" -m "$mode" "$path"
132:     else
133:         # Directory exists, fix ownership and permissions
134:         perms_run chown "$owner:$group" "$path"
135:         perms_run chmod "$mode" "$path"
136:     fi
137: }
138: 
139: # =============================================================================
140: # PERMISSION ENFORCEMENT FUNCTIONS
141: # =============================================================================
142: 
143: perms_enforce_etc() {
144:     # Enforce permissions on /etc/nftban
145:     # Security: root:nftban, directories 0750, files 0640
146: 
147:     perms_say "Enforcing permissions on: $PERMS_ETC"
148: 
149:     # Check if nftban group exists
150:     if ! getent group nftban >/dev/null 2>&1; then
151:         perms_warn "Group nftban does not exist - creating it"
152:         groupadd nftban 2>/dev/null || perms_err "Failed to create nftban group"
153:     fi
154: 
155:     # Create base directory if missing
156:     perms_mkd "$PERMS_ETC" 0750 root nftban
157:     perms_mkd "$PERMS_ETC/conf.d" 0750 root nftban
158: 
159:     # Secure all files in /etc/nftban (readable by nftban group)
160:     if [[ -d "$PERMS_ETC" ]]; then
161:         perms_say "Securing config directory: $PERMS_ETC"
162:         perms_run chown -R root:nftban "$PERMS_ETC"
163:         perms_run find "$PERMS_ETC" -type d -exec chmod 0750 {} \;
164:         perms_run find "$PERMS_ETC" -type f -exec chmod 0640 {} \;
165: 
166:         # Special handling for .local files (user overrides - keep 0640)
167:         if compgen -G "$PERMS_ETC/*.local" > /dev/null 2>&1; then
168:             perms_run find "$PERMS_ETC" -type f -name "*.local" -exec chmod 0640 {} \;
169:         fi
170:     fi
171: }
172: 
173: perms_enforce_lib() {
174:     # Enforce permissions on /usr/lib/nftban
175:     # Security: root:root, directories 0755, files 0644 (immutable)
176: 
177:     perms_say "Enforcing permissions on: $PERMS_LIB"
178: 
179:     if [[ -d "$PERMS_LIB" ]]; then
180:         perms_say "Securing lib directory: $PERMS_LIB"
181:         perms_run chown -R root:root "$PERMS_LIB"
182:         perms_run find "$PERMS_LIB" -type d -exec chmod 0755 {} \;
183:         perms_run find "$PERMS_LIB" -type f -name "*.sh" -exec chmod 0644 {} \;
184:     fi
185: }
186: 
187: perms_enforce_sbin() {
188:     # Enforce permissions on /usr/sbin/nftban* binaries ONLY
189:     # Security: root:nftban, 0750 (group-restricted executable)
190:     # NOTE: We do NOT touch /usr/sbin directory itself - it's a system directory!
191: 
192:     perms_say "Enforcing permissions on: $PERMS_SBIN/nftban* binaries"
193: 
194:     # Check if nftban group exists
195:     if ! getent group nftban >/dev/null 2>&1; then
196:         perms_warn "Group nftban does not exist - creating it"
197:         groupadd nftban 2>/dev/null || perms_err "Failed to create nftban group"
198:     fi
199: 
200:     if [[ -f "$PERMS_SBIN/nftban" ]]; then
201:         perms_run chown root:nftban "$PERMS_SBIN/nftban"
202:         perms_run chmod 0750 "$PERMS_SBIN/nftban"
203:     fi
204: 
205:     # Other nftban-* binaries (also restricted)
206:     for bin in "$PERMS_SBIN"/nftban-*; do
207:         if [[ -f "$bin" ]]; then
208:             perms_run chown root:nftban "$bin"
209:             perms_run chmod 0750 "$bin"
210:         fi
211:     done
212: }
213: 
214: perms_enforce_var() {
215:     # Enforce permissions on /var/lib/nftban
216:     # Security: nftban:nftban, 0750 (mutable state data)
217: 
218:     perms_say "Enforcing permissions on: $PERMS_VAR"
219: 
220:     # Create base directory
221:     perms_mkd "$PERMS_VAR" 0750 nftban nftban
222: 
223:     # Create subdirectories per FHS spec (see nftban_fhs_spec.sh)
224:     perms_mkd "$PERMS_VAR/reports" 0750 nftban nftban
225:     perms_mkd "$PERMS_VAR/reports/baseline" 0750 nftban nftban
226:     perms_mkd "$PERMS_VAR/reports/watchdog" 0750 nftban nftban
227:     perms_mkd "$PERMS_VAR/metrics" 0750 nftban nftban
228:     perms_mkd "$PERMS_VAR/snapshots" 0750 nftban nftban
229:     perms_mkd "$PERMS_VAR/exports" 0750 nftban nftban
230:     perms_mkd "$PERMS_VAR/geoip" 0750 nftban nftban
231: 
232:     # CRITICAL: Create auditors directory with special permissions
233:     # This directory uses root:nftban-auditors (NOT nftban:nftban)
234:     # If nftban-auditors group doesn't exist, fallback to nftban:nftban
235:     if getent group nftban-auditors >/dev/null 2>&1; then
236:         perms_mkd "$PERMS_VAR/reports/auditors" 0770 root nftban-auditors
237:     else
238:         perms_mkd "$PERMS_VAR/reports/auditors" 0770 nftban nftban
239:     fi
240: 
241:     # Secure all content (excluding auditors which has special perms)
242:     if [[ -d "$PERMS_VAR" ]]; then
243:         perms_say "Securing var directory: $PERMS_VAR"
244:         # Use find to chown, but exclude auditors directory
245:         perms_run find "$PERMS_VAR" -path "$PERMS_VAR/reports/auditors" -prune -o -exec chown nftban:nftban {} \;
246:         perms_run find "$PERMS_VAR" -path "$PERMS_VAR/reports/auditors" -prune -o -type d -exec chmod 0750 {} \;
247:         perms_run find "$PERMS_VAR" -path "$PERMS_VAR/reports/auditors" -prune -o -type f -exec chmod 0640 {} \;
248:     fi
249: }
250: 
251: perms_enforce_log() {
252:     # Enforce permissions on /var/log/nftban
253:     # Security: nftban:nftban, 0750, files 0640
254:     # EXCEPTION: suricata/ subdirectory owned by suricata:nftban (Suricata writes, nftban reads)
255: 
256:     perms_say "Enforcing permissions on: $PERMS_LOG"
257: 
258:     # Create base directory
259:     perms_mkd "$PERMS_LOG" 0750 nftban nftban
260: 
261:     # Secure all log files (excluding suricata subdirectory)
262:     if [[ -d "$PERMS_LOG" ]]; then
263:         perms_say "Securing log directory: $PERMS_LOG"
264:         # Exclude suricata directory from recursive chown
265:         perms_run find "$PERMS_LOG" -mindepth 1 -maxdepth 1 -type d ! -name "suricata" -exec chown -R nftban:nftban {} \;
266:         perms_run find "$PERMS_LOG" -maxdepth 1 -type f -exec chown nftban:nftban {} \;
267:         perms_run find "$PERMS_LOG" -type d ! -path "*/suricata*" -exec chmod 0750 {} \;
268:         perms_run find "$PERMS_LOG" -type f ! -path "*/suricata*" -exec chmod 0640 {} \;
269: 
270:         # Handle suricata directory specially: suricata:nftban so Suricata can write, nftban can read
271:         if [[ -d "$PERMS_LOG/suricata" ]]; then
272:             perms_say "Securing suricata log directory (suricata:nftban)"
273:             perms_run chown -R suricata:nftban "$PERMS_LOG/suricata"
274:             perms_run chmod 0750 "$PERMS_LOG/suricata"
275:             perms_run find "$PERMS_LOG/suricata" -type f -exec chmod 0640 {} \;
276:             # Add suricata to nftban group if not already
277:             if id suricata >/dev/null 2>&1 && ! groups suricata 2>/dev/null | grep -q '\bnftban\b'; then
278:                 perms_run usermod -aG nftban suricata
279:             fi
280:         fi
281:     fi
282: }
283: 
284: perms_enforce_usrshare() {
285:     # Enforce permissions on /usr/share/nftban
286:     # Security: root:root, directories 0755, files 0644
287: 
288:     perms_say "Enforcing permissions on: $PERMS_USRSHARE"
289: 
290:     if [[ -d "$PERMS_USRSHARE" ]]; then
291:         perms_say "Securing share directory: $PERMS_USRSHARE"
292:         perms_run chown -R root:root "$PERMS_USRSHARE"
293:         perms_run find "$PERMS_USRSHARE" -type d -exec chmod 0755 {} \;
294:         perms_run find "$PERMS_USRSHARE" -type f -exec chmod 0644 {} \;
295:     fi
296: }
297: 
298: # =============================================================================
299: # MAIN ENFORCEMENT FUNCTION
300: # =============================================================================
301: 
302: nftban_permissions_enforce_all() {
303:     # Enforce all permission rules
304:     # Args: none
305:     # Returns: 0 on success, 1 on error
306: 
307:     perms_say "Starting permission enforcement (dry-run: ${PERMS_DRYRUN:-0})"
308:     perms_say ""
309: 
310:     local errors=0
311: 
312:     # Enforce permissions on each path (count failures for error tracking)
313:     if ! perms_enforce_etc; then
314:         errors=$((errors + 1))
315:     fi
316:     if ! perms_enforce_lib; then
317:         errors=$((errors + 1))
318:     fi
319:     if ! perms_enforce_sbin; then
320:         errors=$((errors + 1))
321:     fi
322:     if ! perms_enforce_var; then
323:         errors=$((errors + 1))
324:     fi
325:     if ! perms_enforce_log; then
326:         errors=$((errors + 1))
327:     fi
328:     if ! perms_enforce_usrshare; then
329:         errors=$((errors + 1))
330:     fi
331: 
332:     perms_say ""
333:     if ((errors > 0)); then
334:         perms_err "Permission enforcement completed with $errors error(s)"
335:         return 1
336:     else
337:         perms_say "✅ Permission enforcement completed successfully"
338:         return 0
339:     fi
340: }
341: 
342: # =============================================================================
343: # VALIDATION FUNCTIONS
344: # =============================================================================
345: 
346: nftban_permissions_check() {
347:     # Check current permissions and report issues
348:     # Args: none
349:     # Returns: 0 if all OK, 1 if issues found
350: 
351:     perms_say "Checking current permissions..."
352:     perms_say ""
353: 
354:     local issues=0
355: 
356:     # Check /etc/nftban
357:     if [[ -d "$PERMS_ETC" ]]; then
358:         local owner
359:         owner="$(stat -c '%U:%G' "$PERMS_ETC" 2>/dev/null || stat -f '%Su:%Sg' "$PERMS_ETC")"
360:         local mode
361:         mode="$(stat -c '%a' "$PERMS_ETC" 2>/dev/null || stat -f '%Lp' "$PERMS_ETC")"
362: 
363:         if [[ "$owner" != "root:nftban" ]]; then
364:             perms_warn "$PERMS_ETC has wrong ownership: $owner (expected: root:nftban)"
365:             ((issues++))
366:         fi
367: 
368:         if [[ "$mode" != "750" ]]; then
369:             perms_warn "$PERMS_ETC has wrong permissions: $mode (expected: 750)"
370:             ((issues++))
371:         fi
372:     fi
373: 
374:     # Check /var/lib/nftban
375:     if [[ -d "$PERMS_VAR" ]]; then
376:         local owner
377:         owner="$(stat -c '%U:%G' "$PERMS_VAR" 2>/dev/null || stat -f '%Su:%Sg' "$PERMS_VAR")"
378:         local mode
379:         mode="$(stat -c '%a' "$PERMS_VAR" 2>/dev/null || stat -f '%Lp' "$PERMS_VAR")"
380: 
381:         if [[ "$owner" != "nftban:nftban" ]]; then
382:             perms_warn "$PERMS_VAR has wrong ownership: $owner (expected: nftban:nftban)"
383:             ((issues++))
384:         fi
385: 
386:         if [[ "$mode" != "750" ]]; then
387:             perms_warn "$PERMS_VAR has wrong permissions: $mode (expected: 750)"
388:             ((issues++))
389:         fi
390:     fi
391: 
392:     perms_say ""
393:     if ((issues > 0)); then
394:         perms_warn "Found $issues permission issue(s)"
395:         perms_say "Run 'nftban permissions enforce' to fix"
396:         return 1
397:     else
398:         perms_say "✅ All permissions are correct"
399:         return 0
400:     fi
401: }
402: 
403: # =============================================================================
404: # EXPORTS
405: # =============================================================================
406: 
407: export -f nftban_permissions_enforce_all
408: export -f nftban_permissions_check
</file>

<file path="cli/lib/nftban/core/nftban_report_email.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - Email Report Generator
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Generate and send HTML email reports with real firewall stats
  7: #
  8: # meta:name=nftban_report_email
  9: # meta:type=core
 10: # meta:header=Email Report Generator
 11: # meta:version=1.0.0
 12: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 13: # meta:homepage=https://nftban.com
 14: #
 15: # meta:description=Generates HTML email reports with real firewall statistics
 16: # meta:depends=bash,nft,sendmail
 17: #
 18: # meta:created_date=2025-12-03
 19: # meta:updated_date=2025-12-03
 20: # =============================================================================
 21: 
 22: # Load main configuration (service names, paths)
 23: if [[ -f "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf" ]]; then
 24:     source "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf"
 25: fi
 26: 
 27: # Prevent double-loading
 28: [[ -n "${NFTBAN_REPORT_EMAIL_LOADED:-}" ]] && return 0
 29: readonly NFTBAN_REPORT_EMAIL_LOADED=1
 30: 
 31: # =============================================================================
 32: # GENERATE EMAIL REPORT
 33: # =============================================================================
 34: 
 35: nftban_report_email_generate() {
 36:     local recipient="${1:-${NFTBAN_MAIL_RECIPIENT:-}}"
 37:     local template="/usr/share/nftban/templates/email/report_template.html"
 38: 
 39:     if [[ -z "$recipient" ]]; then
 40:         echo "ERROR: No recipient specified" >&2
 41:         return 1
 42:     fi
 43: 
 44:     if [[ ! -f "$template" ]]; then
 45:         echo "ERROR: Email template not found: $template" >&2
 46:         return 1
 47:     fi
 48: 
 49:     # Get hostname and date
 50:     local hostname
 51:     hostname=$(hostname -f 2>/dev/null || hostname)
 52:     local date_now
 53:     date_now=$(date '+%Y-%m-%d %H:%M')
 54:     local report_id
 55:     report_id=$(date +%Y%m%d%H%M%S)-$(head -c 4 /dev/urandom | xxd -p)
 56: 
 57:     # ==========================================================================
 58:     # GET REAL DATA FROM NFTABLES
 59:     # ==========================================================================
 60: 
 61:     # Count blocked IPs from nft blacklist set
 62:     local blocked_ips=0
 63:     if nft list set ip nftban blacklist_ipv4 &>/dev/null; then
 64:         blocked_ips=$(nft list set ip nftban blacklist_ipv4 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+(/[0-9]+)?' | wc -l || echo 0)
 65:     fi
 66: 
 67:     # Count whitelist
 68:     local whitelist_count=0
 69:     if nft list set ip nftban whitelist_ipv4 &>/dev/null; then
 70:         whitelist_count=$(nft list set ip nftban whitelist_ipv4 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+(/[0-9]+)?' | wc -l || echo 0)
 71:     fi
 72: 
 73:     # ==========================================================================
 74:     # GET THREAT FEEDS STATUS
 75:     # ==========================================================================
 76: 
 77:     local feeds_status=""
 78:     local feeds_dir="${NFTBAN_DATA_DIR}/feeds"
 79: 
 80:     if [[ -d "$feeds_dir" ]]; then
 81:         local feed_count=0
 82:         for feed_file in "$feeds_dir"/*.txt; do
 83:             [[ ! -f "$feed_file" ]] && continue
 84:             local feed_name
 85:             feed_name=$(basename "$feed_file" .txt | tr '[:lower:]' '[:upper:]')
 86:             local ip_count
 87:             ip_count=$(wc -l < "$feed_file" 2>/dev/null || echo 0)
 88:             local last_update
 89:             last_update=$(date -r "$feed_file" '+%Y-%m-%d %H:%M' 2>/dev/null || echo "unknown")
 90: 
 91:             ((feed_count++))
 92:             local border="border-bottom:1px solid #475569;"
 93: 
 94:             feeds_status+="<tr>
 95:                 <td style=\"padding:12px 16px;${border}\">
 96:                     <span style=\"color:#f1f5f9;\">${feed_name}</span>
 97:                     <div style=\"font-size:11px;color:#64748b;\">Updated: ${last_update}</div>
 98:                 </td>
 99:                 <td style=\"padding:12px 16px;text-align:right;${border}\">
100:                     <span style=\"color:#22c55e;font-weight:bold;\">${ip_count} IPs</span>
101:                 </td>
102:             </tr>"
103:         done
104: 
105:         if [[ $feed_count -eq 0 ]]; then
106:             feeds_status="<tr><td style=\"padding:16px;text-align:center;color:#64748b;\" colspan=\"2\">No feeds loaded</td></tr>"
107:         fi
108:     else
109:         feeds_status="<tr><td style=\"padding:16px;text-align:center;color:#64748b;\" colspan=\"2\">Feeds directory not found</td></tr>"
110:     fi
111: 
112:     # ==========================================================================
113:     # GET NEW BANS FROM LOG (Last 24h)
114:     # ==========================================================================
115: 
116:     local login_bans=0 portscan_bans=0 ddos_bans=0 manual_bans=0
117:     local yesterday
118:     yesterday=$(date -d '1 day ago' '+%Y-%m-%d')
119:     local today
120:     today=$(date '+%Y-%m-%d')
121: 
122:     # Count login bans from login_alert.log (primary source)
123:     local login_alert_log="${NFTBAN_LOG_DIR}/login_alert.log"
124:     if [[ -f "$login_alert_log" ]]; then
125:         # Count actual "Banning" entries from yesterday and today
126:         login_bans=$(grep "Banning IP" "$login_alert_log" 2>/dev/null | grep -E "^\[${yesterday}|^\[${today}" | wc -l)
127:         login_bans=${login_bans//[^0-9]/}  # Strip non-digits
128:         login_bans=${login_bans:-0}
129:     fi
130: 
131:     # Count portscan bans
132:     local portscan_log="${NFTBAN_LOG_DIR}/portscan.log"
133:     if [[ -f "$portscan_log" ]]; then
134:         portscan_bans=$(grep -Ei "ban|block" "$portscan_log" 2>/dev/null | grep -E "^\[${yesterday}|^\[${today}" | wc -l)
135:         portscan_bans=${portscan_bans//[^0-9]/}
136:         portscan_bans=${portscan_bans:-0}
137:     fi
138: 
139:     # Count DDoS bans
140:     local ddos_log="${NFTBAN_LOG_DIR}/ddos.log"
141:     if [[ -f "$ddos_log" ]]; then
142:         ddos_bans=$(grep -Ei "ban|block" "$ddos_log" 2>/dev/null | grep -E "^\[${yesterday}|^\[${today}" | wc -l)
143:         ddos_bans=${ddos_bans//[^0-9]/}
144:         ddos_bans=${ddos_bans:-0}
145:     fi
146: 
147:     # Fallback: try bans.log if it exists
148:     local ban_log="${NFTBAN_LOG_DIR}/bans.log"
149:     if [[ -f "$ban_log" ]]; then
150:         local bans_login bans_portscan bans_ddos
151:         bans_login=$(awk -F'|' -v since="$yesterday" '$1 >= since && $3 ~ /login|ssh|auth/ {count++} END {print count+0}' "$ban_log")
152:         bans_portscan=$(awk -F'|' -v since="$yesterday" '$1 >= since && $3 ~ /portscan|scan/ {count++} END {print count+0}' "$ban_log")
153:         bans_ddos=$(awk -F'|' -v since="$yesterday" '$1 >= since && $3 ~ /ddos|flood/ {count++} END {print count+0}' "$ban_log")
154:         manual_bans=$(awk -F'|' -v since="$yesterday" '$1 >= since && $3 == "manual" {count++} END {print count+0}' "$ban_log")
155:         # Strip non-digits and ensure defaults
156:         bans_login=${bans_login//[^0-9]/}; bans_login=${bans_login:-0}
157:         bans_portscan=${bans_portscan//[^0-9]/}; bans_portscan=${bans_portscan:-0}
158:         bans_ddos=${bans_ddos//[^0-9]/}; bans_ddos=${bans_ddos:-0}
159:         manual_bans=${manual_bans//[^0-9]/}; manual_bans=${manual_bans:-0}
160:         # Add to totals
161:         login_bans=$((login_bans + bans_login))
162:         portscan_bans=$((portscan_bans + bans_portscan))
163:         ddos_bans=$((ddos_bans + bans_ddos))
164:     fi
165: 
166:     # ==========================================================================
167:     # GET PROTECTION STATUS
168:     # ==========================================================================
169: 
170:     local protection_status=""
171:     local modules=("ddos:DDoS Protection" "portscan:Port Scan Detection" "login:Login Monitor" "feeds:Threat Feeds" "geoip:GeoIP Blocking")
172: 
173:     for mod_info in "${modules[@]}"; do
174:         local mod="${mod_info%%:*}"
175:         local name="${mod_info#*:}"
176:         local status="Disabled"
177:         local color="#ef4444"
178:         local icon="&#10008;"
179: 
180:         case "$mod" in
181:             ddos)
182:                 # Check via nftban ddos status or config
183:                 local ddos_output
184:                 ddos_output=$(nftban ddos status 2>/dev/null | grep -E "Module Enabled:|Master Switch:" | head -1) || true
185:                 if [[ "$ddos_output" =~ "true" ]] || [[ "$ddos_output" =~ "ENABLED" ]]; then
186:                     status="Active"; color="#22c55e"; icon="&#10004;"
187:                 fi
188:                 ;;
189:             portscan)
190:                 # Check via nftban portscan status or config
191:                 local portscan_output
192:                 portscan_output=$(nftban portscan status 2>/dev/null | grep -E "Module Enabled:|Master Switch:|Status:" | head -1) || true
193:                 if [[ "$portscan_output" =~ "true" ]] || [[ "$portscan_output" =~ "ENABLED" ]] || [[ "$portscan_output" =~ "Running" ]]; then
194:                     status="Active"; color="#22c55e"; icon="&#10004;"
195:                 fi
196:                 ;;
197:             login)
198:                 # Check both nftban-login-monitor service and login alert status
199:                 local login_svc="${NFTBAN_SERVICE_LOGIN_MONITOR:-nftban-login-monitor.service}"
200:                 if systemctl is-active "$login_svc" &>/dev/null 2>&1 || \
201:                    systemctl is-active nftban-login &>/dev/null 2>&1 || \
202:                    [[ -f /var/run/nftban/login.pid ]] || \
203:                    [[ "$(grep -s 'NFTBAN_LOGIN_ALERT_ENABLED=true' /etc/nftban/conf.d/login_alert.conf* 2>/dev/null)" ]]; then
204:                     status="Active"; color="#22c55e"; icon="&#10004;"
205:                 fi
206:                 ;;
207:             feeds)
208:                 # Feeds are active if we have feed files with content
209:                 local feed_total=0
210:                 for f in /var/lib/nftban/feeds/*.txt; do
211:                     [[ -f "$f" ]] && feed_total=$((feed_total + $(wc -l < "$f" 2>/dev/null || echo 0)))
212:                 done
213:                 if [[ $feed_total -gt 0 ]]; then
214:                     status="Active"; color="#22c55e"; icon="&#10004;"
215:                 fi
216:                 ;;
217:             geoip)
218:                 if nft list set ip nftban geo_block &>/dev/null 2>&1; then
219:                     status="Active"; color="#22c55e"; icon="&#10004;"
220:                 fi
221:                 ;;
222:         esac
223: 
224:         protection_status+="<tr>
225:             <td style=\"padding:12px 16px;border-bottom:1px solid #475569;\">
226:                 <span style=\"color:#94a3b8;\">${name}</span>
227:             </td>
228:             <td style=\"padding:12px 16px;text-align:right;border-bottom:1px solid #475569;\">
229:                 <span style=\"color:${color};font-weight:bold;\">${icon} ${status}</span>
230:             </td>
231:         </tr>"
232:     done
233: 
234:     # ==========================================================================
235:     # GET TOP BLOCKED IPs (from nftables blacklist with GeoIP lookup)
236:     # ==========================================================================
237: 
238:     local top_ips=""
239:     local ip_count=0
240:     local geoip_db="${NFTBAN_DATA_DIR}/geoip/GeoLite2-City.mmdb"
241: 
242:     # Helper: Check if IP is public (not private/reserved)
243:     is_public_ip() {
244:         local ip="$1"
245:         # Filter out private, loopback, link-local, multicast, reserved
246:         [[ "$ip" =~ ^10\. ]] && return 1
247:         [[ "$ip" =~ ^172\.(1[6-9]|2[0-9]|3[01])\. ]] && return 1
248:         [[ "$ip" =~ ^192\.168\. ]] && return 1
249:         [[ "$ip" =~ ^127\. ]] && return 1
250:         [[ "$ip" =~ ^169\.254\. ]] && return 1
251:         [[ "$ip" =~ ^224\. ]] && return 1
252:         [[ "$ip" =~ ^0\. ]] && return 1
253:         [[ "$ip" =~ ^100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\. ]] && return 1
254:         [[ "$ip" =~ ^192\.0\.(0|2)\. ]] && return 1
255:         [[ "$ip" =~ ^198\.(1[89])\. ]] && return 1
256:         [[ "$ip" =~ ^203\.0\.113\. ]] && return 1  # TEST-NET-3
257:         return 0
258:     }
259: 
260:     # Helper: Get country from GeoIP
261:     get_country() {
262:         local ip="$1"
263:         local country="Unknown"
264: 
265:         # Try mmdblookup if available
266:         if command -v mmdblookup &>/dev/null && [[ -f "$geoip_db" ]]; then
267:             country=$(mmdblookup --file "$geoip_db" --ip "$ip" country names en 2>/dev/null | grep -oP '"\K[^"]+' | head -1)
268:         # Fallback: try geoiplookup
269:         elif command -v geoiplookup &>/dev/null; then
270:             country=$(geoiplookup "$ip" 2>/dev/null | head -1 | sed 's/.*: //' | cut -d',' -f2 | xargs)
271:         fi
272: 
273:         [[ -z "$country" ]] && country="Unknown"
274:         echo "$country"
275:     }
276: 
277:     # Get IPs from actual nftables blacklist (not config files)
278:     local blacklist_ips=""
279:     if nft list set ip nftban blacklist_ipv4 &>/dev/null; then
280:         blacklist_ips=$(nft list set ip nftban blacklist_ipv4 2>/dev/null | \
281:             grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | \
282:             sort -u | head -50)  # Get more than 5 to filter private IPs
283:     fi
284: 
285:     # Process IPs: filter private, lookup country, build HTML
286:     while IFS= read -r ip; do
287:         [[ -z "$ip" ]] && continue
288: 
289:         # Skip private/reserved IPs
290:         if ! is_public_ip "$ip"; then
291:             continue
292:         fi
293: 
294:         ((ip_count++))
295:         [[ $ip_count -gt 5 ]] && break
296: 
297:         # Get country
298:         local country
299:         country=$(get_country "$ip")
300: 
301:         local border="border-bottom:1px solid #475569;"
302:         [[ $ip_count -eq 5 ]] && border=""
303: 
304:         top_ips+="<tr>
305:             <td style=\"padding:12px 16px;${border}\">
306:                 <span style=\"color:#f1f5f9;font-family:monospace;\">${ip}</span>
307:             </td>
308:             <td style=\"padding:12px 16px;text-align:right;${border}\">
309:                 <span style=\"color:#f59e0b;font-weight:bold;\">${country}</span>
310:             </td>
311:         </tr>"
312:     done <<< "$blacklist_ips"
313: 
314:     # Fallback message if no public IPs found
315:     if [[ -z "$top_ips" ]]; then
316:         top_ips="<tr><td style=\"padding:16px;text-align:center;color:#64748b;\" colspan=\"2\">No public IPs in blacklist</td></tr>"
317:     fi
318: 
319:     # ==========================================================================
320:     # BUILD HTML FROM TEMPLATE
321:     # ==========================================================================
322: 
323:     local html
324:     html=$(cat "$template")
325: 
326:     # Escape & in replacement strings (& is special in bash substitution)
327:     # For variables containing HTML entities like &#10004;, we must escape &
328:     local feeds_status_escaped="${feeds_status//&/\\&}"
329:     local protection_status_escaped="${protection_status//&/\\&}"
330:     local top_ips_escaped="${top_ips//&/\\&}"
331: 
332:     html="${html//\{\{HOSTNAME\}\}/$hostname}"
333:     html="${html//\{\{DATE\}\}/$date_now}"
334:     html="${html//\{\{BLOCKED_IPS\}\}/$blocked_ips}"
335:     html="${html//\{\{WHITELIST_COUNT\}\}/$whitelist_count}"
336:     html="${html//\{\{FEEDS_STATUS\}\}/$feeds_status_escaped}"
337:     html="${html//\{\{LOGIN_BANS\}\}/$login_bans}"
338:     html="${html//\{\{PORTSCAN_BANS\}\}/$portscan_bans}"
339:     html="${html//\{\{DDOS_BANS\}\}/$ddos_bans}"
340:     html="${html//\{\{MANUAL_BANS\}\}/$manual_bans}"
341:     html="${html//\{\{PROTECTION_STATUS\}\}/$protection_status_escaped}"
342:     html="${html//\{\{TOP_IPS\}\}/$top_ips_escaped}"
343:     html="${html//\{\{REPORT_ID\}\}/$report_id}"
344: 
345:     # ==========================================================================
346:     # SEND EMAIL
347:     # ==========================================================================
348: 
349:     local sender="${NFTBAN_SENDER:-nftban@${hostname}}"
350:     local subject
351:     subject="[NFTBan] Security Report - ${hostname} - $(date +%Y-%m-%d)"
352: 
353:     if command -v sendmail &>/dev/null; then
354:         {
355:             echo "From: NFTBan <${sender}>"
356:             echo "To: ${recipient}"
357:             echo "Subject: ${subject}"
358:             echo "MIME-Version: 1.0"
359:             echo "Content-Type: text/html; charset=UTF-8"
360:             echo ""
361:             echo "$html"
362:         } | sendmail -t
363: 
364:         echo "[SUCCESS] Report sent to ${recipient}"
365:         return 0
366:     else
367:         echo "ERROR: sendmail not available" >&2
368:         return 1
369:     fi
370: }
371: 
372: # CLI wrapper
373: nftban_cmd_report_send() {
374:     local recipient="${1:-}"
375:     if [[ -z "$recipient" ]]; then
376:         echo "Usage: nftban report send <email@example.com>" >&2
377:         return 1
378:     fi
379:     nftban_report_email_generate "$recipient"
380: }
381: 
382: export -f nftban_report_email_generate
383: export -f nftban_cmd_report_send
</file>

<file path="cli/lib/nftban/core/nftban_secure_mode.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - Secure Mode Directive
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Generic security wrapper - source this to enable automatic security
  7: #
  8: # meta:name=nftban_secure_mode
  9: # meta:type=core
 10: # meta:header=Secure Mode Directive
 11: # meta:version=1.0.0
 12: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 13: # meta:homepage=https://nftban.com
 14: #
 15: # **Description & Purpose**
 16: # meta:description=Secure-by-default environment with automatic file write validation and path security
 17: # meta:input=Scripts sourcing this module
 18: # meta:output=Automatically secured file operations with audit logging
 19: #
 20: # **Inventory & Requirements**
 21: # meta:depends=nftban_path_security.sh
 22: #
 23: # meta:created_date=2025-11-05
 24: # meta:updated_date=2025-11-24
 25: # =============================================================================
 26: 
 27: 
 28: # Module guard
 29: [[ -n "${NFTBAN_SECURE_MODE_LOADED:-}" ]] && return 0
 30: declare -g NFTBAN_SECURE_MODE_LOADED=1
 31: 
 32: # =============================================================================
 33: # AUTO-LOAD DEPENDENCIES
 34: # =============================================================================
 35: 
 36: # Load path security module if not already loaded
 37: if ! declare -f nftban_path_validate_write >/dev/null 2>&1; then
 38:     if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_path_security.sh" ]]; then
 39:         source "${NFTBAN_LIB_DIR}/core/nftban_path_security.sh" || {
 40:             echo "ERROR: Failed to load path security module" >&2
 41:             return 1
 42:         }
 43:     else
 44:         echo "ERROR: Path security module not found" >&2
 45:         return 1
 46:     fi
 47: fi
 48: 
 49: # =============================================================================
 50: # SECURE MODE CONFIGURATION
 51: # =============================================================================
 52: 
 53: # Enable/disable secure mode (default: enabled)
 54: : "${NFTBAN_SECURE_MODE_ENABLED:=1}"
 55: 
 56: # Allow unsafe operations with explicit flag (default: require flag)
 57: : "${NFTBAN_SECURE_MODE_ALLOW_UNSAFE:=}"
 58: 
 59: # Audit all file operations (default: yes)
 60: : "${NFTBAN_SECURE_MODE_AUDIT:=1}"
 61: 
 62: # Fail on security violations (default: yes, 0=warn only)
 63: : "${NFTBAN_SECURE_MODE_STRICT:=1}"
 64: 
 65: # =============================================================================
 66: # SAFE FILE WRITE WRAPPERS
 67: # =============================================================================
 68: 
 69: # -----------------------------------------------------------------------------
 70: # Safe file write wrapper
 71: # Usage: nftban_secure_write "content" "/path/to/file"
 72: # Returns: 0 if successful, 1 if blocked
 73: # -----------------------------------------------------------------------------
 74: nftban_secure_write() {
 75:     local content="$1"
 76:     local path="$2"
 77:     local allow_unsafe="${NFTBAN_SECURE_MODE_ALLOW_UNSAFE}"
 78: 
 79:     # Validate path
 80:     if ! nftban_path_validate_write "$path" "$allow_unsafe"; then
 81:         [[ "$NFTBAN_SECURE_MODE_STRICT" == "1" ]] && return 1
 82:         echo "WARNING: Proceeding with insecure write (strict mode disabled)" >&2
 83:     fi
 84: 
 85:     # Create file safely (prevents symlink attacks)
 86:     if ! nftban_path_create_file_safe "$path"; then
 87:         echo "ERROR: Failed to create file safely: $path" >&2
 88:         return 1
 89:     fi
 90: 
 91:     # Write content
 92:     echo "$content" > "$path"
 93: 
 94:     # Audit log
 95:     [[ "$NFTBAN_SECURE_MODE_AUDIT" == "1" ]] && \
 96:         nftban_path_audit_log "WRITE" "secure_write path=$path size=${#content}"
 97: 
 98:     return 0
 99: }
100: 
101: # -----------------------------------------------------------------------------
102: # Safe file append wrapper
103: # Usage: nftban_secure_append "content" "/path/to/file"
104: # -----------------------------------------------------------------------------
105: nftban_secure_append() {
106:     local content="$1"
107:     local path="$2"
108:     local allow_unsafe="${NFTBAN_SECURE_MODE_ALLOW_UNSAFE}"
109: 
110:     # Validate path
111:     if ! nftban_path_validate_write "$path" "$allow_unsafe"; then
112:         [[ "$NFTBAN_SECURE_MODE_STRICT" == "1" ]] && return 1
113:     fi
114: 
115:     # Ensure file exists and is safe
116:     if [[ ! -e "$path" ]]; then
117:         nftban_path_create_file_safe "$path" || return 1
118:     elif [[ -L "$path" ]]; then
119:         echo "ERROR: Target is a symlink - refusing to append" >&2
120:         return 1
121:     fi
122: 
123:     # Append content
124:     echo "$content" >> "$path"
125: 
126:     # Audit log
127:     [[ "$NFTBAN_SECURE_MODE_AUDIT" == "1" ]] && \
128:         nftban_path_audit_log "APPEND" "secure_append path=$path size=${#content}"
129: 
130:     return 0
131: }
132: 
133: # -----------------------------------------------------------------------------
134: # Safe file copy with path validation
135: # Usage: nftban_secure_copy "/source/file" "/dest/file"
136: # -----------------------------------------------------------------------------
137: nftban_secure_copy() {
138:     local source="$1"
139:     local dest="$2"
140:     local allow_unsafe="${NFTBAN_SECURE_MODE_ALLOW_UNSAFE}"
141: 
142:     # Validate destination path
143:     if ! nftban_path_validate_write "$dest" "$allow_unsafe"; then
144:         [[ "$NFTBAN_SECURE_MODE_STRICT" == "1" ]] && return 1
145:     fi
146: 
147:     # Check source exists
148:     if [[ ! -f "$source" ]]; then
149:         echo "ERROR: Source file not found: $source" >&2
150:         return 1
151:     fi
152: 
153:     # Ensure destination is safe
154:     if ! nftban_path_create_file_safe "$dest"; then
155:         return 1
156:     fi
157: 
158:     # Copy file
159:     cp -f "$source" "$dest" || {
160:         echo "ERROR: Copy failed: $source → $dest" >&2
161:         return 1
162:     }
163: 
164:     # Audit log
165:     [[ "$NFTBAN_SECURE_MODE_AUDIT" == "1" ]] && \
166:         nftban_path_audit_log "COPY" "secure_copy source=$source dest=$dest"
167: 
168:     return 0
169: }
170: 
171: # -----------------------------------------------------------------------------
172: # Safe output redirection helper
173: # Usage: command | nftban_secure_tee "/path/to/file"
174: # -----------------------------------------------------------------------------
175: nftban_secure_tee() {
176:     local path="$1"
177:     local allow_unsafe="${NFTBAN_SECURE_MODE_ALLOW_UNSAFE}"
178: 
179:     # Validate path
180:     if ! nftban_path_validate_write "$path" "$allow_unsafe"; then
181:         [[ "$NFTBAN_SECURE_MODE_STRICT" == "1" ]] && return 1
182:         echo "WARNING: Proceeding with insecure tee (strict mode disabled)" >&2
183:     fi
184: 
185:     # Ensure file is safe
186:     if ! nftban_path_create_file_safe "$path"; then
187:         return 1
188:     fi
189: 
190:     # Use tee
191:     tee "$path"
192: 
193:     # Audit log
194:     [[ "$NFTBAN_SECURE_MODE_AUDIT" == "1" ]] && \
195:         nftban_path_audit_log "TEE" "secure_tee path=$path"
196: 
197:     return 0
198: }
199: 
200: # =============================================================================
201: # HIGHER-LEVEL API (RECOMMENDED)
202: # =============================================================================
203: 
204: # -----------------------------------------------------------------------------
205: # Get safe output path (main API for user-provided paths)
206: # Usage: safe_path=$(nftban_get_output_path "$user_path" [default_dir])
207: # Examples:
208: #   safe_path=$(nftban_get_output_path "$user_input")
209: #   safe_path=$(nftban_get_output_path "$user_input" "/var/lib/nftban/reports")
210: #   safe_path=$(nftban_get_output_path "" "/var/lib/nftban/reports" ".html")
211: # -----------------------------------------------------------------------------
212: nftban_get_output_path() {
213:     local user_path="${1:-}"
214:     local default_dir="${2:-/var/lib/nftban/reports}"
215:     local allow_unsafe="${NFTBAN_SECURE_MODE_ALLOW_UNSAFE}"
216:     local default_ext="${3:-.html}"
217: 
218:     nftban_path_get_safe_output "$user_path" "$default_dir" "$allow_unsafe" "$default_ext"
219: }
220: 
221: # -----------------------------------------------------------------------------
222: # Write to safe file (combines path validation + write)
223: # Usage: nftban_write_safe "/path/to/file" "content"
224: # Or:    nftban_write_safe "$(nftban_get_output_path "$user_path")" "content"
225: # -----------------------------------------------------------------------------
226: nftban_write_safe() {
227:     local path="$1"
228:     local content="$2"
229: 
230:     # If path looks user-provided (no validation yet), validate it
231:     if [[ "$path" == *"/"* ]] && ! nftban_path_validate_write "$path" "${NFTBAN_SECURE_MODE_ALLOW_UNSAFE}"; then
232:         return 1
233:     fi
234: 
235:     nftban_secure_write "$content" "$path"
236: }
237: 
238: # -----------------------------------------------------------------------------
239: # Append to safe file
240: # Usage: nftban_append_safe "/path/to/file" "content"
241: # -----------------------------------------------------------------------------
242: nftban_append_safe() {
243:     local path="$1"
244:     local content="$2"
245: 
246:     nftban_secure_append "$content" "$path"
247: }
248: 
249: # =============================================================================
250: # SECURE MODE CONTROL
251: # =============================================================================
252: 
253: # -----------------------------------------------------------------------------
254: # Enable secure mode
255: # Usage: nftban_secure_mode_enable
256: # -----------------------------------------------------------------------------
257: nftban_secure_mode_enable() {
258:     export NFTBAN_SECURE_MODE_ENABLED=1
259:     export NFTBAN_SECURE_MODE_STRICT=1
260:     echo "[SECURE MODE] Enabled - all file writes validated" >&2
261: }
262: 
263: # -----------------------------------------------------------------------------
264: # Disable secure mode (not recommended)
265: # Usage: nftban_secure_mode_disable
266: # -----------------------------------------------------------------------------
267: nftban_secure_mode_disable() {
268:     export NFTBAN_SECURE_MODE_ENABLED=0
269:     export NFTBAN_SECURE_MODE_STRICT=0
270:     echo "[SECURE MODE] Disabled - WARNING: file writes NOT validated" >&2
271: }
272: 
273: # -----------------------------------------------------------------------------
274: # Allow unsafe operations (e.g., /tmp writes)
275: # Usage: nftban_secure_mode_allow_unsafe
276: # -----------------------------------------------------------------------------
277: nftban_secure_mode_allow_unsafe() {
278:     export NFTBAN_SECURE_MODE_ALLOW_UNSAFE="allow-unsafe"
279:     echo "[SECURE MODE] Unsafe operations allowed - use with caution" >&2
280: }
281: 
282: # -----------------------------------------------------------------------------
283: # Disallow unsafe operations (default, recommended)
284: # Usage: nftban_secure_mode_disallow_unsafe
285: # -----------------------------------------------------------------------------
286: nftban_secure_mode_disallow_unsafe() {
287:     export NFTBAN_SECURE_MODE_ALLOW_UNSAFE=""
288:     echo "[SECURE MODE] Unsafe operations blocked (recommended)" >&2
289: }
290: 
291: # =============================================================================
292: # DEVELOPER-FRIENDLY SHORTCUTS
293: # =============================================================================
294: 
295: # Shorter aliases for common operations
296: alias secure_write='nftban_secure_write'
297: alias secure_append='nftban_secure_append'
298: alias secure_copy='nftban_secure_copy'
299: alias secure_tee='nftban_secure_tee'
300: alias get_safe_path='nftban_get_output_path'
301: 
302: # =============================================================================
303: # USAGE EXAMPLES (COMMENTED)
304: # =============================================================================
305: 
306: : <<'USAGE_EXAMPLES'
307: 
308: # Example 1: Basic secure write
309: source /usr/lib/nftban/core/nftban_secure_mode.sh
310: nftban_secure_write "Hello World" "/var/lib/nftban/reports/test.txt"
311: 
312: # Example 2: User-provided path
313: user_path="/tmp/report.html"  # User input
314: safe_path=$(nftban_get_output_path "$user_path") || exit 1
315: nftban_secure_write "<html>..." "$safe_path"
316: 
317: # Example 3: Default path
318: safe_path=$(nftban_get_output_path "")  # Empty = use default
319: echo "Report" > "$safe_path"
320: 
321: # Example 4: Filename only
322: safe_path=$(nftban_get_output_path "myreport.html")
323: # → /var/lib/nftban/reports/myreport.html
324: 
325: # Example 5: Append to log
326: nftban_secure_append "Log entry" "/var/log/nftban/custom.log"
327: 
328: # Example 6: Copy with validation
329: nftban_secure_copy "/tmp/source.txt" "/var/lib/nftban/reports/dest.txt"
330: 
331: # Example 7: Pipe with tee
332: echo "Data" | nftban_secure_tee "/var/lib/nftban/reports/output.txt"
333: 
334: # Example 8: Allow unsafe (not recommended)
335: nftban_secure_mode_allow_unsafe
336: safe_path=$(nftban_get_output_path "/tmp/test.html")
337: nftban_secure_write "Content" "$safe_path"
338: nftban_secure_mode_disallow_unsafe
339: 

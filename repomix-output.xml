<file path="install/prometheus/web.yml.example">
  1: # =============================================================================
  2: # Prometheus Web Configuration - Authentication & TLS
  3: # =============================================================================
  4: # Location: /etc/prometheus/web.yml
  5: #
  6: # This file configures authentication and TLS for Prometheus web UI.
  7: #
  8: # Usage:
  9: #   1. Generate bcrypt password hash (see below)
 10: #   2. Copy this file to /etc/prometheus/web.yml
 11: #   3. Update prometheus.service to use --web.config.file=/etc/prometheus/web.yml
 12: #   4. Reload: systemctl restart prometheus
 13: # =============================================================================
 14: 
 15: # Basic authentication
 16: basic_auth_users:
 17:   # Username: admin
 18:   # Password: change-this-password
 19:   # Hash generated with: htpasswd -nBC 10 "" | tr -d ':\n'
 20:   admin: $2y$10$hKq3P7HhWYJGbHZU5I5YpeLhQMPgJmKGUqJcF7vZnJZpvVXqXqXqm
 21: 
 22:   # Add more users as needed:
 23:   # viewer: $2y$10$anotherHashHere
 24: 
 25: # Optional: TLS configuration
 26: # tls_server_config:
 27: #   # Certificate and key
 28: #   cert_file: /etc/prometheus/tls/prometheus.crt
 29: #   key_file: /etc/prometheus/tls/prometheus.key
 30: #
 31: #   # Minimum TLS version
 32: #   min_version: TLS12
 33: #
 34: #   # Cipher suites (optional, use strong ciphers)
 35: #   cipher_suites:
 36: #     - TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
 37: #     - TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384
 38: #     - TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256
 39: #     - TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384
 40: #
 41: #   # Prefer server cipher suites
 42: #   prefer_server_cipher_suites: true
 43: #
 44: #   # Client certificate authentication (optional)
 45: #   # client_auth_type: RequireAndVerifyClientCert
 46: #   # client_ca_file: /etc/prometheus/tls/ca.crt
 47: 
 48: # =============================================================================
 49: # Generating Password Hashes
 50: # =============================================================================
 51: #
 52: # Method 1: Using htpasswd (recommended)
 53: #
 54: #   # Install htpasswd
 55: #   dnf install httpd-tools          # RHEL/Fedora
 56: #   apt-get install apache2-utils    # Debian/Ubuntu
 57: #
 58: #   # Generate hash (will prompt for password)
 59: #   htpasswd -nBC 10 "" | tr -d ':\n'
 60: #
 61: #   Example output:
 62: #   $2y$10$hKq3P7HhWYJGbHZU5I5YpeLhQMPgJmKGUqJcF7vZnJZpvVXqXqXqm
 63: #
 64: # Method 2: Using Python
 65: #
 66: #   python3 -c 'import bcrypt; print(bcrypt.hashpw(b"yourpassword", bcrypt.gensalt(rounds=10)).decode())'
 67: #
 68: # Method 3: Using online tool (NOT RECOMMENDED for production)
 69: #
 70: #   https://bcrypt-generator.com/
 71: #
 72: # =============================================================================
 73: 
 74: # =============================================================================
 75: # TLS Certificate Generation
 76: # =============================================================================
 77: #
 78: # Self-signed certificate (testing only):
 79: #
 80: #   mkdir -p /etc/prometheus/tls
 81: #   cd /etc/prometheus/tls
 82: #
 83: #   openssl req -new -newkey rsa:2048 -days 365 -nodes -x509 \
 84: #     -keyout prometheus.key \
 85: #     -out prometheus.crt \
 86: #     -subj "/CN=prometheus.local/O=NFTBan/C=US"
 87: #
 88: #   chmod 600 prometheus.key
 89: #   chown prometheus:prometheus prometheus.key prometheus.crt
 90: #
 91: # Let's Encrypt (production):
 92: #
 93: #   # Install certbot
 94: #   dnf install certbot                    # RHEL/Fedora
 95: #   apt-get install certbot                # Debian/Ubuntu
 96: #
 97: #   # Get certificate
 98: #   certbot certonly --standalone -d prometheus.example.com
 99: #
100: #   # Link to Prometheus directory
101: #   ln -s /etc/letsencrypt/live/prometheus.example.com/fullchain.pem \
102: #         /etc/prometheus/tls/prometheus.crt
103: #   ln -s /etc/letsencrypt/live/prometheus.example.com/privkey.pem \
104: #         /etc/prometheus/tls/prometheus.key
105: #
106: #   # Set permissions
107: #   chown -h prometheus:prometheus /etc/prometheus/tls/*
108: #
109: #   # Auto-renewal
110: #   echo "0 0 * * * certbot renew --quiet --deploy-hook 'systemctl reload prometheus'" | crontab -
111: #
112: # =============================================================================
113: 
114: # =============================================================================
115: # Systemd Service Configuration
116: # =============================================================================
117: #
118: # Update /etc/systemd/system/prometheus.service.d/web-config.conf:
119: #
120: #   [Service]
121: #   ExecStart=
122: #   ExecStart=/usr/bin/prometheus \
123: #     --config.file=/etc/prometheus/prometheus.yml \
124: #     --storage.tsdb.path=/var/lib/prometheus/ \
125: #     --web.console.templates=/etc/prometheus/consoles \
126: #     --web.console.libraries=/etc/prometheus/console_libraries \
127: #     --web.config.file=/etc/prometheus/web.yml \
128: #     --web.listen-address=127.0.0.1:9090
129: #
130: # Then reload:
131: #   systemctl daemon-reload
132: #   systemctl restart prometheus
133: #
134: # =============================================================================
135: 
136: # =============================================================================
137: # Testing Authentication
138: # =============================================================================
139: #
140: # Without authentication (should fail with 401):
141: #   curl http://localhost:9090/metrics
142: #
143: # With authentication:
144: #   curl -u admin:yourpassword http://localhost:9090/metrics
145: #
146: # With TLS:
147: #   curl -u admin:yourpassword https://localhost:9090/metrics
148: #
149: # Access in browser:
150: #   http://localhost:9090
151: #   (will prompt for username/password)
152: #
153: # =============================================================================
154: 
155: # =============================================================================
156: # Security Best Practices
157: # =============================================================================
158: #
159: # 1. Use strong passwords (16+ characters, mixed case, symbols)
160: # 2. Enable TLS for production deployments
161: # 3. Use bcrypt cost factor of 10 or higher
162: # 4. Bind to localhost if using reverse proxy
163: # 5. Use reverse proxy (nginx/apache) for public access
164: # 6. Regularly rotate passwords
165: # 7. Use client certificate auth for service-to-service
166: # 8. Monitor failed authentication attempts
167: # 9. Use Prometheus behind VPN for sensitive environments
168: # 10. Never commit this file with real passwords to git
169: #
170: # =============================================================================
</file>


 13: )
 14: 
 15: // Config represents Suricata rule configuration
 16: type Config struct {
 17: 	EnabledCategories []string
 18: 	DisabledCategories []string
 19: 	EnabledSIDs       []string
 20: 	DisabledSIDs      []string
 21: 	DropSIDs          []string // IPS mode SIDs
 22: }
 23: 
 24: // ConfigPaths contains paths to config files
 25: type ConfigPaths struct {
 26: 	LocalConf     string // User manual config (never overwritten)
 27: 	AutoConf      string // Auto-detected config (generated)
 28: 	EffectiveConf string // Merged result (generated)
 29: 	WhitelistGroups string
 30: 	BlacklistGroups string
 31: 	WhitelistSIDs   string
 32: 	BlacklistSIDs   string
 33: 	DropSIDs        string
 34: }
 35: 
 36: // GetConfigPaths returns paths based on central NFTBan config
 37: func GetConfigPaths() (*ConfigPaths, error) {
 38: 	cfg := nftbanconf.MustLoad()
 39: 	configDir := filepath.Join(cfg.ConfigDir, "suricata/config")
 40: 
 41: 	return &ConfigPaths{
 42: 		LocalConf:       filepath.Join(configDir, "suricata.local.conf"),
 43: 		AutoConf:        filepath.Join(configDir, "suricata.auto.conf"),
 44: 		EffectiveConf:   filepath.Join(configDir, "suricata.effective.conf"),
 45: 		WhitelistGroups: filepath.Join(configDir, "whitelist-groups.conf"),
 46: 		BlacklistGroups: filepath.Join(configDir, "blacklist-groups.conf"),
 47: 		WhitelistSIDs:   filepath.Join(configDir, "whitelist-sids.conf"),
 48: 		BlacklistSIDs:   filepath.Join(configDir, "blacklist-sids.conf"),
 49: 		DropSIDs:        filepath.Join(configDir, "drop-sids.conf"),
 50: 	}, nil
 51: }
 52: 
 53: // GenerateAutoConf creates auto.conf from scan results
 54: func GenerateAutoConf(scanResult *scanner.ScanResult) error {
 55: 	paths, err := GetConfigPaths()
 56: 	if err != nil {
 57: 		return err
 58: 	}
 59: 
 60: 	// Ensure directory exists
 61: 	if err := os.MkdirAll(filepath.Dir(paths.AutoConf), 0755); err != nil {
 62: 		return fmt.Errorf("failed to create config directory: %w", err)
 63: 	}
 64: 
 65: 	// Build auto.conf content
 66: 	var content strings.Builder
 67: 	content.WriteString("# NFTBan Suricata Auto-Detected Configuration\n")
 68: 	content.WriteString(fmt.Sprintf("# Generated: %s\n", time.Now().Format(time.RFC3339)))
 69: 	content.WriteString("# DO NOT EDIT - This file is automatically generated\n")
 70: 	content.WriteString("#\n")
 71: 	content.WriteString("# To override these settings, edit suricata.local.conf\n")
 72: 	content.WriteString("#\n\n")
 73: 
 74: 	// Detected services
 75: 	content.WriteString("# Detected Services:\n")
 76: 	for _, svc := range scanResult.Services {
 77: 		content.WriteString(fmt.Sprintf("#   %s (port %d)\n", svc.Name, svc.Port))
 78: 	}
 79: 	content.WriteString("\n")
 80: 
 81: 	// Enabled categories
 82: 	content.WriteString("# Auto-Enabled Rule Categories\n")
 83: 	sort.Strings(scanResult.RuleCategories)
 84: 	for _, cat := range scanResult.RuleCategories {
 85: 		content.WriteString(fmt.Sprintf("ENABLE_CATEGORY=%s\n", cat))
 86: 	}
 87: 
 88: 	// Write file
 89: 	if err := os.WriteFile(paths.AutoConf, []byte(content.String()), 0644); err != nil {
 90: 		return fmt.Errorf("failed to write auto.conf: %w", err)
 91: 	}
 92: 
 93: 	fmt.Printf("Generated: %s\n", paths.AutoConf)
 94: 	return nil
 95: }
 96: 
 97: // MergeConfigs creates effective.conf from local + auto
 98: func MergeConfigs() error {
 99: 	paths, err := GetConfigPaths()
100: 	if err != nil {
101: 		return err
102: 	}
103: 
104: 	// Load configurations
105: 	localConfig := loadConfig(paths.LocalConf)
106: 	autoConfig := loadConfig(paths.AutoConf)
107: 	whitelistGroups := loadList(paths.WhitelistGroups)
108: 	blacklistGroups := loadList(paths.BlacklistGroups)
109: 	whitelistSIDs := loadList(paths.WhitelistSIDs)
110: 	blacklistSIDs := loadList(paths.BlacklistSIDs)
111: 	dropSIDs := loadList(paths.DropSIDs)
112: 
113: 	// Merge: local overrides auto
114: 	effective := &Config{
115: 		EnabledCategories:  mergeUnique(autoConfig.EnabledCategories, localConfig.EnabledCategories),
116: 		DisabledCategories: localConfig.DisabledCategories,
117: 		EnabledSIDs:        mergeUnique(autoConfig.EnabledSIDs, localConfig.EnabledSIDs),
118: 		DisabledSIDs:       localConfig.DisabledSIDs,
119: 		DropSIDs:           dropSIDs,
120: 	}
121: 
122: 	// Apply whitelist/blacklist
123: 	effective.EnabledCategories = applyFilters(effective.EnabledCategories, whitelistGroups, blacklistGroups)
124: 	effective.EnabledSIDs = applyFilters(effective.EnabledSIDs, whitelistSIDs, blacklistSIDs)
125: 
126: 	// Build effective.conf content
127: 	var content strings.Builder
128: 	content.WriteString("# NFTBan Suricata Effective Configuration\n")
129: 	content.WriteString(fmt.Sprintf("# Generated: %s\n", time.Now().Format(time.RFC3339)))
130: 	content.WriteString("# DO NOT EDIT - This file is automatically generated\n")
131: 	content.WriteString("#\n")
132: 	content.WriteString("# This is the merged result of:\n")
133: 	content.WriteString("#   1. suricata.auto.conf (auto-detected)\n")
134: 	content.WriteString("#   2. suricata.local.conf (user manual overrides)\n")
135: 	content.WriteString("#   3. whitelist/blacklist filters\n")
136: 	content.WriteString("#\n\n")
137: 
138: 	// Enabled categories
139: 	if len(effective.EnabledCategories) > 0 {
140: 		content.WriteString("# Enabled Rule Categories\n")
141: 		sort.Strings(effective.EnabledCategories)
142: 		for _, cat := range effective.EnabledCategories {
143: 			content.WriteString(fmt.Sprintf("ENABLE_CATEGORY=%s\n", cat))
144: 		}
145: 		content.WriteString("\n")
146: 	}
147: 
148: 	// Disabled categories
149: 	if len(effective.DisabledCategories) > 0 {
150: 		content.WriteString("# Disabled Rule Categories\n")
151: 		sort.Strings(effective.DisabledCategories)
152: 		for _, cat := range effective.DisabledCategories {
153: 			content.WriteString(fmt.Sprintf("DISABLE_CATEGORY=%s\n", cat))
154: 		}
155: 		content.WriteString("\n")
156: 	}
157: 
158: 	// Enabled SIDs
159: 	if len(effective.EnabledSIDs) > 0 {
160: 		content.WriteString("# Enabled Specific SIDs\n")
161: 		sort.Strings(effective.EnabledSIDs)
162: 		for _, sid := range effective.EnabledSIDs {
163: 			content.WriteString(fmt.Sprintf("ENABLE_SID=%s\n", sid))
164: 		}
165: 		content.WriteString("\n")
166: 	}
167: 
168: 	// Disabled SIDs
169: 	if len(effective.DisabledSIDs) > 0 {
170: 		content.WriteString("# Disabled Specific SIDs\n")
171: 		sort.Strings(effective.DisabledSIDs)
172: 		for _, sid := range effective.DisabledSIDs {
173: 			content.WriteString(fmt.Sprintf("DISABLE_SID=%s\n", sid))
174: 		}
175: 		content.WriteString("\n")
176: 	}
177: 
178: 	// DROP mode SIDs (IPS)
179: 	if len(effective.DropSIDs) > 0 {
180: 		content.WriteString("# IPS Mode - DROP SIDs\n")
181: 		sort.Strings(effective.DropSIDs)
182: 		for _, sid := range effective.DropSIDs {
183: 			content.WriteString(fmt.Sprintf("DROP_SID=%s\n", sid))
184: 		}
185: 		content.WriteString("\n")
186: 	}
187: 
188: 	// Summary
189: 	content.WriteString(fmt.Sprintf("# Summary: %d categories, %d SIDs enabled\n",
190: 		len(effective.EnabledCategories), len(effective.EnabledSIDs)))
191: 
192: 	// Write file
193: 	if err := os.WriteFile(paths.EffectiveConf, []byte(content.String()), 0644); err != nil {
194: 		return fmt.Errorf("failed to write effective.conf: %w", err)
195: 	}
196: 
197: 	fmt.Printf("Generated: %s\n", paths.EffectiveConf)
198: 	return nil
199: }

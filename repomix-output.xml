242:     return "${WATCHDOG_RESULTS[overall_status]:-0}"
243: }
244: 
245: # =============================================================================
246: # HISTORY COMMAND
247: # =============================================================================
248: 
249: nftban_watchdog_cmd_history() {
250:     # Show saved reports for auditing
251:     local last_count=10
252:     local format="text"
253: 
254:     # Parse args
255:     for arg in "$@"; do
256:         case "$arg" in
257:             --last=*) last_count="${arg#--last=}" ;;
258:             --format=*) format="${arg#--format=}" ;;
259:         esac
260:     done
261: 
262:     local report_dir="${NFTBAN_WATCHDOG_REPORT_DIR:-/var/lib/nftban/reports/watchdog}"
263: 
264:     if [[ ! -d "$report_dir" ]]; then
265:         echo "No reports found (directory does not exist: $report_dir)"
266:         return 0
267:     fi
268: 
269:     # Get list of reports
270:     local -a reports
271:     mapfile -t reports < <(find "$report_dir" -name "*.report" -type f 2>/dev/null | sort -r | head -"$last_count")
272: 
273:     if [[ ${#reports[@]} -eq 0 ]]; then
274:         echo "No reports found in $report_dir"
275:         return 0
276:     fi
277: 
278:     if [[ "$format" == "json" ]]; then
279:         echo "["
280:         local first=true
281:         for report in "${reports[@]}"; do
282:             local filename
283:             filename=$(basename "$report")
284:             local timestamp="${filename%.report}"
285:             local size
286:             size=$(stat -c %s "$report" 2>/dev/null || echo 0)
287: 
288:             [[ "$first" == "true" ]] || echo ","
289:             first=false
290: 
291:             printf '  {"file": "%s", "timestamp": "%s", "size": %d}' "$report" "$timestamp" "$size"
292:         done
293:         echo ""
294:         echo "]"
295:     else
296:         echo "Watchdog Reports (last $last_count):"
297:         echo "=============================================="
298:         printf "%-25s  %8s  %s\n" "TIMESTAMP" "SIZE" "PATH"
299:         echo "----------------------------------------------"
300: 
301:         for report in "${reports[@]}"; do
302:             local filename
303:             filename=$(basename "$report")
304:             local timestamp="${filename%.report}"
305:             local size
306:             size=$(stat -c %s "$report" 2>/dev/null || echo 0)
307: 
308:             # Convert size to human-readable
309:             local size_hr
310:             if [[ $size -gt 1048576 ]]; then
311:                 size_hr="$((size / 1048576)) MB"
312:             elif [[ $size -gt 1024 ]]; then
313:                 size_hr="$((size / 1024)) KB"
314:             else
315:                 size_hr="$size B"
316:             fi
317: 
318:             printf "%-25s  %8s  %s\n" "$timestamp" "$size_hr" "$report"
319:         done
320: 
321:         echo ""
322:         echo "To view a report: cat /var/lib/nftban/reports/watchdog/<timestamp>.report"
323:     fi
324: }
325: 
326: # =============================================================================
327: # ENABLE/DISABLE COMMANDS
328: # =============================================================================
329: 
330: nftban_watchdog_cmd_enable() {
331:     # Enable watchdog timer
332: 
333:     echo "Enabling NFTBan Watchdog..."
334: 
335:     # Check if timer exists
336:     if ! systemctl list-unit-files nftban-watchdog.timer >/dev/null 2>&1; then
337:         echo "Error: nftban-watchdog.timer not found"
338:         echo "The watchdog timer needs to be installed first."
339:         return 1
340:     fi
341: 
342:     # Enable and start the timer
343:     if systemctl enable nftban-watchdog.timer 2>/dev/null; then
344:         echo "  Timer enabled"
345:     else
346:         echo "  Warning: Could not enable timer"
347:     fi
348: 
349:     if systemctl start nftban-watchdog.timer 2>/dev/null; then
350:         echo "  Timer started"
351:     else
352:         echo "  Warning: Could not start timer"
353:     fi
354: 
355:     # Update config file to set ENABLED=true
356:     local conf_file="${NFTBAN_CONFIG_DIR:-/etc/nftban}/conf.d/watchdog.conf"
357:     if [[ -f "$conf_file" ]]; then
358:         if grep -q "^NFTBAN_WATCHDOG_ENABLED=" "$conf_file"; then
359:             sed -i 's/^NFTBAN_WATCHDOG_ENABLED=.*/NFTBAN_WATCHDOG_ENABLED="true"/' "$conf_file"
360:         else
361:             echo 'NFTBAN_WATCHDOG_ENABLED="true"' >> "$conf_file"
362:         fi
363:         echo "  Config updated: $conf_file"
364:     fi
365: 
366:     echo ""
367:     echo "Watchdog enabled. Checks will run every 90 seconds."
368:     echo "View status: nftban watchdog status"
369: 
370:     # Show timer status
371:     systemctl status nftban-watchdog.timer --no-pager 2>/dev/null || true
372: }
373: 
374: nftban_watchdog_cmd_disable() {
375:     # Disable watchdog timer
376: 
377:     echo "Disabling NFTBan Watchdog..."
378: 
379:     # Stop and disable the timer
380:     if systemctl stop nftban-watchdog.timer 2>/dev/null; then
381:         echo "  Timer stopped"
382:     fi
383: 
384:     if systemctl disable nftban-watchdog.timer 2>/dev/null; then
385:         echo "  Timer disabled"
386:     fi
387: 
388:     # Update config file to set ENABLED=false
389:     local conf_file="${NFTBAN_CONFIG_DIR:-/etc/nftban}/conf.d/watchdog.conf"
390:     if [[ -f "$conf_file" ]]; then
391:         if grep -q "^NFTBAN_WATCHDOG_ENABLED=" "$conf_file"; then
392:             sed -i 's/^NFTBAN_WATCHDOG_ENABLED=.*/NFTBAN_WATCHDOG_ENABLED="false"/' "$conf_file"
393:         fi
394:         echo "  Config updated: $conf_file"
395:     fi
396: 
397:     echo ""
398:     echo "Watchdog disabled."
399: }
400: 
401: # =============================================================================
402: # TREND COMMAND
403: # =============================================================================
404: 
405: nftban_watchdog_cmd_trend() {
406:     # Display system resource trends (7-day rolling history)
407:     # Usage: nftban watchdog trend [--json]
408: 
409:     local json_mode=0
410: 
411:     for arg in "$@"; do
412:         [[ "$arg" == "--json" ]] && json_mode=1
413:     done
414: 
415:     # Ensure trend functions are available
416:     if ! declare -f nftban_watchdog_trend_display >/dev/null 2>&1; then
417:         echo "ERROR: Trend functions not loaded" >&2
418:         return 1
419:     fi
420: 
421:     if [[ $json_mode -eq 1 ]]; then
422:         nftban_watchdog_trend_display --json
423:     else
424:         nftban_watchdog_trend_display
425:     fi
426: }
427: 
428: # =============================================================================
429: # MAIN CLI HANDLER
430: # =============================================================================
431: 
432: nftban_cmd_watchdog() {
433:     # Main watchdog command handler
434:     # Args: subcommand [options]
435: 
436:     local subcommand="${1:-status}"
437:     shift || true
438: 
439:     # Load output module (for banner)
440:     if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_output.sh" ]]; then
441:         # shellcheck source=/dev/null
442:         source "${NFTBAN_LIB_DIR}/core/nftban_output.sh"
443:     fi
444: 
445:     # Show banner for detailed commands (not for quick status)
446:     # This keeps "nftban watchdog status" as a one-liner for scripts
447:     # while showing banner for interactive commands
448:     case "$subcommand" in
449:         status)
450:             # Quick one-liner - no banner for scripting compatibility
451:             ;;
452:         *)
453:             # Show banner for all other commands (report, check, history, etc.)
454:             if [[ $(type -t nftban_banner) == "function" ]]; then
455:                 nftban_banner
456:             fi
457:             echo ""
458:             ;;
459:     esac
460: 
461:     case "$subcommand" in
462:         status)
463:             nftban_watchdog_cmd_status "$@"
464:             ;;
465:         check)
466:             nftban_watchdog_cmd_check "$@"
467:             ;;
468:         report)
469:             nftban_watchdog_cmd_report "$@"
470:             ;;
471:         history)
472:             nftban_watchdog_cmd_history "$@"
473:             ;;
474:         enable)
475:             nftban_watchdog_cmd_enable "$@"
476:             ;;
477:         disable)
478:             nftban_watchdog_cmd_disable "$@"
479:             ;;
480:         trend)
481:             nftban_watchdog_cmd_trend "$@"
482:             ;;
483:         help|--help|-h)
484:             nftban_watchdog_help
485:             ;;
486:         *)
487:             echo "Unknown command: $subcommand"
488:             echo ""
489:             nftban_watchdog_help
490:             return 1
491:             ;;
492:     esac
493: }
494: 
495: # =============================================================================
496: # EXPORTS
497: # =============================================================================
498: 
499: export -f nftban_cmd_watchdog
</file>


 342: # Calculate bandwidth in Mbps from byte deltas
 343: calculate_mbps() {
 344:     local bytes_delta=$1
 345:     local time_delta=$2
 346: 
 347:     if [[ $time_delta -eq 0 ]]; then
 348:         echo "0"
 349:         return
 350:     fi
 351: 
 352:     # bytes/second -> bits/second -> megabits/second
 353:     local mbps
 354:     mbps=$(awk -v bd="$bytes_delta" -v td="$time_delta" 'BEGIN {printf "%.2f", (bd / td) * 8 / 1000000}')
 355:     echo "$mbps"
 356: }

588: 
589:     # Install suricata-update
590:     install_suricata_update || exit 1
591:     echo ""
592: 
593:     # Configure Suricata
594:     configure_suricata || exit 1
595:     echo ""
596: 
597:     # Cleanup
598:     cleanup "$(dirname "$source_dir")"

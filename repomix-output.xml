 259: nftban_stats_ban_sources() {
 260:     # Get ban breakdown by source (login, portscan, ddos, manual, feeds)
 261:     # Usage: nftban_stats_ban_sources [since] [until]
 262:     # Returns: JSON {"login":N,"portscan":N,"ddos":N,"manual":N,"feeds":N}
 263: 
 264:     local since="${1:-1970-01-01}"
 265:     local until="${2:-$(date +%Y-%m-%d)}"
 266: 
 267:     if [[ ! -f "$NFTBAN_BAN_LOG" ]]; then
 268:         echo "{\"login\":0,\"portscan\":0,\"ddos\":0,\"manual\":0,\"feeds\":0}"
 269:         return 0
 270:     fi
 271: 
 272:     # Try cache
 273:     local cache_key="sources_${since}_${until}"
 274:     if nftban_stats_get_cache "$cache_key"; then
 275:         return 0
 276:     fi
 277: 
 278:     # Analyze sources
 279:     local result
 280:     result=$(awk -F'|' -v since="$since" -v until="$until" '
 281:     BEGIN {login=0; portscan=0; ddos=0; manual=0; feeds=0}
 282:     $1 >= since && $1 <= until && $6 == "BANNED" {
 283:         if ($3 ~ /login|ssh|auth|fail2ban/) login++
 284:         else if ($3 ~ /portscan|scan/) portscan++
 285:         else if ($3 ~ /ddos|flood|synflood/) ddos++
 286:         else if ($3 == "manual" || $3 == "user") manual++
 287:         else if ($3 ~ /feed/) feeds++
 288:     }
 289:     END {
 290:         printf "{\"login\":%d,\"portscan\":%d,\"ddos\":%d,\"manual\":%d,\"feeds\":%d}", login, portscan, ddos, manual, feeds
 291:     }' "$NFTBAN_BAN_LOG")
 292: 
 293:     nftban_stats_set_cache "$cache_key" "$result"
 294:     echo "$result"
 295: }

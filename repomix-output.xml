16: [Install]
17: WantedBy=timers.target
</file>

<file path="install/systemd/nftban-maintenance.service">
 1: # =============================================================================
 2: # NFTBan v1.0.0 - Maintenance Service (Always Active)
 3: # =============================================================================
 4: # SPDX-License-Identifier: MPL-2.0
 5: # Purpose: Critical maintenance tasks that run even when NFTBan is disabled
 6: #
 7: # This service performs safety-critical checks:
 8: #   - SSH port monitoring (prevents lockout)
 9: #   - System IP monitoring (updates whitelists)
10: #   - Autoheal (fixes permissions, creates directories)
11: #   - Configuration validation
12: #
13: # Runs every 15 minutes via nftban-maintenance.timer
14: # =============================================================================
15: 
16: [Unit]
17: Description=NFTBan Maintenance Service (Safety Checks)
18: Documentation=https://nftban.com/docs/maintenance
19: After=network-online.target
20: Wants=network-online.target
21: 
22: [Service]
23: Type=oneshot
24: User=root
25: Group=root
26: 
27: # Run maintenance script
28: ExecStart=/usr/lib/nftban/cron/maintenance.sh
29: 
30: # Security hardening
31: NoNewPrivileges=yes
32: PrivateTmp=true
33: ProtectSystem=strict
34: ProtectHome=true
35: RestrictSUIDSGID=true
36: 
37: # Allow only required write locations (maintenance.sh writes to specific paths)
38: ReadWritePaths=/var/lib/nftban /var/log/nftban /var/cache/nftban /run/nftban /etc/nftban/ports.d /etc/nftban/whitelist.d
39: 
40: # Allow netlink + network access (used by nft, curl, ss, ip commands)
41: RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
42: 
43: # Resource limits
44: CPUQuota=50%
45: MemoryMax=256M
46: TasksMax=20
47: 
48: # Logging
49: StandardOutput=journal
50: StandardError=journal
51: SyslogIdentifier=nftban-maintenance
52: 
53: # Restart on failure
54: Restart=on-failure
55: RestartSec=5min
</file>

<file path="install/systemd/nftban-rbl-check.service">
 1: # =============================================================================
 2: # NFTBan RBL Check Service
 3: # =============================================================================
 4: # SPDX-License-Identifier: MPL-2.0
 5: # Purpose: Automated RBL checking service (triggered by timer)
 6: # =============================================================================
 7: 
 8: [Unit]
 9: Description=NFTBan RBL Check Service
10: Documentation=https://nftban.com/docs/rbl
11: After=network-online.target nftables.service
12: Wants=network-online.target
13: 
14: [Service]
15: Type=oneshot
16: User=nftban
17: Group=nftban
18: 
19: # Run RBL check with quiet mode and alert
20: ExecStart=/usr/sbin/nftban rbl check --quiet --alert
21: 
22: # Logging
23: StandardOutput=journal
24: StandardError=journal
25: SyslogIdentifier=nftban-rbl
26: 
27: # Security hardening
28: NoNewPrivileges=true
29: PrivateTmp=true
30: ProtectSystem=strict
31: ProtectHome=true
32: ReadWritePaths=/var/log/nftban/rbl

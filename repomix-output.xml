2493: // PrometheusMetricsHandler fetches metrics from Prometheus exporter textfile
2494: func PrometheusMetricsHandler(w http.ResponseWriter, r *http.Request) {
2495: 	// Use central config for metrics file path
2496: 	metricsFile := getPrometheusFile()
2497: 
2498: 	// Check if metrics file exists
2499: 	if _, err := os.Stat(metricsFile); os.IsNotExist(err) {
2500: 		respondJSON(w, http.StatusOK, map[string]interface{}{
2501: 			"available": false,
2502: 			"message":   "Metrics not available - exporter not running",
2503: 		})
2504: 		return
2505: 	}
2506: 
2507: 	// Read metrics file
2508: 	content, err := os.ReadFile(metricsFile)
2509: 	if err != nil {
2510: 		respondJSON(w, http.StatusInternalServerError, ErrorResponse{Error: "Failed to read metrics file"})
2511: 		return
2512: 	}
2513: 
2514: 	// Parse Prometheus metrics format
2515: 	metrics := parsePrometheusMetrics(string(content))
2516: 
2517: 	respondJSON(w, http.StatusOK, map[string]interface{}{
2518: 		"available": true,
2519: 		"metrics":   metrics,
2520: 		"timestamp": time.Now().Unix(),
2521: 	})
2522: }
2523: 
2524: // parsePrometheusMetrics parses Prometheus text exposition format
2525: func parsePrometheusMetrics(content string) map[string]interface{} {
2526: 	metrics := make(map[string]interface{})
2527: 	lines := strings.Split(content, "\n")
2528: 
2529: 	for _, line := range lines {
2530: 		line = strings.TrimSpace(line)
2531: 		if line == "" || strings.HasPrefix(line, "#") {
2532: 			continue
2533: 		}
2534: 
2535: 		// Parse metric line: metric_name{labels} value
2536: 		parts := strings.Fields(line)
2537: 		if len(parts) >= 2 {
2538: 			metricName := parts[0]
2539: 			metricValue := parts[1]
2540: 
2541: 			// Skip lines that are just numbers (malformed exporter output)
2542: 			// Valid lines must start with metric name (letters/underscores)
2543: 			if len(metricName) > 0 && (metricName[0] >= 'a' && metricName[0] <= 'z' || metricName[0] == '_') {
2544: 				// Handle labeled metrics (e.g., nftban_health_status{component="nftables"} 0)
2545: 				if strings.Contains(metricName, "{") {
2546: 					// Store the full metric name with labels as the key
2547: 					// This way GUI can access: metrics["nftban_health_status{component=\"nftables\"}"]
2548: 					metrics[metricName] = metricValue
2549: 				} else {
2550: 					// Simple metric without labels
2551: 					metrics[metricName] = metricValue
2552: 				}
2553: 			}
2554: 		}
2555: 	}
2556: 
2557: 	return metrics
2558: }

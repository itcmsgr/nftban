# nftban-managed: yes
# nftban-templates-version: 1

[nftban-wordpress]
enabled   = @@NFTBAN_F2B_WORDPRESS_JAIL@@
filter    = nftban-wordpress
backend   = auto
port      = http,https
logpath   = @@NFTBAN_F2B_WORDPRESS_LOG@@
maxretry  = @@NFTBAN_F2B_WORDPRESS_MAX_RETRY@@
findtime  = @@NFTBAN_F2B_WORDPRESS_FIND_TIME@@
bantime   = @@NFTBAN_F2B_WORDPRESS_BAN_TIME@@

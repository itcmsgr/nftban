543: # =============================================================================
544: # HELP
545: # =============================================================================
546: 
547: cmd_wizard_help() {
548:     cat << 'EOF'
549: 
550: NFTBan Installation Wizard
551: 
552: USAGE:
553:     nftban wizard <command>
554: 
555: COMMANDS:
556:     install     Run the interactive installation wizard
557:     env         Show detected environment only (no changes)
558:     help        Show this help message
559: 
560: DESCRIPTION:
561:     The wizard detects your environment (CPU, RAM, open ports) and asks
562:     3 simple questions to configure NFTBan optimally for your server.
563: 
564:     Questions asked:
565:     1. Security Level (standard/strict/paranoid)
566:     2. Traffic Level (low/medium/high)
567:     3. Optional Features (feeds, IDS, GUI)
568: 
569:     The wizard then:
570:     - Generates /etc/nftban/nftban.conf.local
571:     - Enables appropriate modules
572:     - Suggests feeds based on detected services
573: 
574: DEFAULTS:
575:     - SSH login monitor: ALWAYS enabled
576:     - Feeds: OFF (user must opt-in)
577:     - GUI/Metrics: OFF on small environments
578:     - IDS: OFF on small environments
579: 
580: EXAMPLES:
581:     sudo nftban wizard install    # Run full wizard
582:     nftban wizard env             # Just show environment
583: 
584: EOF
585: }
586: 
587: # =============================================================================
588: # COMMAND ROUTER
589: # =============================================================================
590: 
591: nftban_cmd_wizard() {
592:     local action="${1:-help}"
593:     shift || true
594: 
595:     case "$action" in
596:         install)
597:             cmd_wizard_install "$@"
598:             ;;
599:         env|environment)
600:             cmd_wizard_env "$@"
601:             ;;
602:         help|--help|-h)
603:             cmd_wizard_help
604:             ;;
605:         *)
606:             echo "ERROR: Unknown wizard command: $action"
607:             echo "Run 'nftban wizard help' for usage"
608:             return 1
609:             ;;
610:     esac
611: }
612: 
613: # Export for main CLI
614: export -f nftban_cmd_wizard
615: 
616: # Execute if called directly
617: if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
618:     nftban_cmd_wizard "$@"
619: fi

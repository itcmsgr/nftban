// =============================================================================
// NFTBan Core v1.0 - Polkit Authorization Rules
// =============================================================================
// SPDX-License-Identifier: MPL-2.0
// Purpose: Grant nftban group permission to manage NFTBan core services
// Location: /etc/polkit-1/rules.d/10-nftban-core.rules
//
// Security Model:
// - Members of 'nftban' group can manage NFTBan systemd services without sudo
// - Scope limited to specific nftban-* units (whitelist approach)
// - nftables access ONLY via nftban-core (root + CAP_NET_ADMIN)
// - NO direct nft command execution via polkit
//
// Groups:
//   nftban: All NFTBan operators (CLI, services, web UI)
//
// Allowed Actions:
//   - start/stop/restart/reload/enable/disable specific nftban units
//   - reload systemd daemon
//   - query service status
//
// Does NOT Grant:
//   - Direct nft command execution
//   - File system modifications
//   - Management of non-nftban services
//   - Arbitrary systemd unit access
//
// Security Philosophy:
//   ✓ Whitelist-only unit access (explicit unit names)
//   ✓ Verb-based action control
//   ✓ Group-based access control
//   ✓ nftables isolation (only via nftban-core root daemon)
//   ✓ Principle of least privilege
// =============================================================================

polkit.addRule(function (action, subject) {
    // Only trust local users in the nftban service group
    if (!subject.isInGroup("nftban")) {
        return polkit.Result.NOT_HANDLED;
    }

    // Allow managing specific nftban core + Suricata wrapper units
    if (action.id == "org.freedesktop.systemd1.manage-units" ||
        action.id == "org.freedesktop.systemd1.manage-unit-files") {

        var verb = action.lookup("verb");
        var unit = action.lookup("unit");

        // Allowed service lifecycle operations
        var allowedVerbs = [
            "start",
            "stop",
            "restart",
            "reload",
            "enable",
            "disable",
            "try-restart",
            "reload-or-restart",
            "try-reload-or-restart"
        ];

        // Whitelist: ONLY these units can be managed
        var allowedUnits = [
            // Core services
            "nftban-core.service",
            "nftban-core-feeds.service",
            "nftban-core-feeds.timer",
            "nftban-core-geoip.service",
            "nftban-core-geoip.timer",

            // Suricata integration (wrapper units - v1.0 replaces fail2ban)
            "nftban-suricata.service",
            "nftban-suricata-update.service",
            "nftban-suricata-update.timer",

            // Login monitor
            "nftban-login-monitor.service",

            // Main timer
            "nftban.timer"
        ];

        if (allowedVerbs.indexOf(verb) >= 0 &&
            allowedUnits.indexOf(unit) >= 0) {
            return polkit.Result.YES;
        }
    }

    // Allow daemon-reload from nftban group (needed after unit file changes)
    if (action.id == "org.freedesktop.systemd1.reload-daemon") {
        return polkit.Result.YES;
    }

    return polkit.Result.NOT_HANDLED;
});

// =============================================================================
// SECURITY NOTES
// =============================================================================
//
// nftables Security Model:
// - NO polkit authorization for 'nft' commands
// - nftables ONLY accessible via nftban-core running as:
//     User=root
//     Group=root
//     AmbientCapabilities=CAP_NET_ADMIN
//     CapabilityBoundingSet=CAP_NET_ADMIN
// - All firewall operations go through audited Go code
//
// Suricata Integration:
// - nftban manages Suricata via wrapper units (nftban-suricata.service)
// - Wrapper runs as root with SupplementaryGroups=suricata,nftban
// - For direct suricata.service management, use separate 20-nftban-suricata.rules
//
// Auth Helper Security:
// - /usr/libexec/nftban-auth-helper must be:
//     owned by root:root
//     mode 0755 or 0750
//     NOT writable by nftban groups
//
// To verify rule is loaded:
//   pkaction --action-id org.freedesktop.systemd1.manage-units --verbose
//
// To test authorization (as nftban group member):
//   systemctl restart nftban-suricata.service  # Should work without sudo
//   systemctl status nftban-core.service       # Should work
//
// To add user to group:
//   sudo usermod -a -G nftban username
//   # User must log out and back in for group membership to take effect
//
// =============================================================================

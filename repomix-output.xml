 805:     # Usage: nftban_stats_export_json [output_file] [since] [until]
 806: 
 807:     local output_file="${1:-/tmp/nftban-stats-$(date +%Y%m%d-%H%M%S).json}"
 808:     local since="${2:-$(date -d '30 days ago' +%Y-%m-%d)}"
 809:     local until="${3:-$(date +%Y-%m-%d)}"
 810: 
 811:     if type -t nftban_print_status >/dev/null 2>&1; then
 812:         nftban_print_status "info" "Exporting statistics to JSON: $output_file"
 813:     else
 814:         echo "[INFO] Exporting to: $output_file"
 815:     fi
 816: 
 817:     # Build JSON structure
 818:     cat > "$output_file" <<EOF
 819: {
 820:   "schema_version": "1.0.0",
 821:   "report": {
 822:     "type": "export",
 823:     "period": {
 824:       "since": "${since}",
 825:       "until": "${until}"
 826:     },
 827:     "generated_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
 828:     "hostname": "$(hostname)"
 829:   },
 830:   "summary": {
 831:     "total_bans": $(nftban_stats_count_bans "$since" "$until"),
 832:     "unique_ips": $(nftban_stats_count_unique_ips "$since" "$until"),
 833:     "active_bans": $(nftban_stats_count_active_bans),
 834:     "whitelist_total": $(nftban_stats_count_whitelist)
 835:   },
 836:   "ban_sources": $(nftban_stats_ban_sources "$since" "$until"),
 837:   "top_sources": $(nftban_stats_top_sources 10 "$since" "$until"),
 838:   "top_ips": $(nftban_stats_top_ips 20 "$since" "$until"),
 839:   "top_countries": $(nftban_stats_top_countries 10 "$since" "$until"),
 840:   "timeline": $(nftban_stats_timeline "$since 00:00:00" "$until 23:59:59" "day")
 841: }
 842: EOF
 843: 
 844:     if type -t nftban_print_status >/dev/null 2>&1; then
 845:         nftban_print_status "success" "Statistics exported to: $output_file"
 846:     else
 847:         echo "[SUCCESS] Exported to: $output_file"
 848:     fi
 849: 
 850:     echo "$output_file"
 851: }

100: 			samplingInterval = 10 // default 10 seconds if not set
101: 		}
102: 		maxSamples := cfg.MetricsMaxSamples
103: 		if maxSamples <= 0 {
104: 			maxSamples = 360 // default 1 hour at 10s if not set
105: 		}

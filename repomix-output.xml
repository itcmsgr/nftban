192: func cmdTrustEnable(configPath, trustName string, enable bool) error {
193: 	// Check for privilege (root OR CAP_NET_ADMIN capability)
194: 	if err := checkPrivilege(); err != nil {
195: 		return err
196: 	}
197: 
198: 	trustName = strings.ToUpper(trustName)
199: 
200: 	// Verify trust exists
201: 	found := false
202: 	for _, tf := range builtInTrustFeeds {
203: 		if tf.Name == trustName {
204: 			found = true
205: 			break
206: 		}
207: 	}
208: 	if !found {
209: 		return fmt.Errorf("unknown trust feed: %s\nUse 'nftban trust list' to see available feeds", trustName)
210: 	}
211: 
212: 	// Ensure config directory exists
213: 	configDir := filepath.Dir(configPath)
214: 	if err := os.MkdirAll(configDir, 0750); err != nil {
215: 		return fmt.Errorf("failed to create config directory: %w", err)
216: 	}
217: 
218: 	// Read existing config or create new
219: 	content := ""
220: 	if data, err := os.ReadFile(configPath); err == nil {
221: 		content = string(data)
222: 	} else {
223: 		// Create header for new config
224: 		content = `# =============================================================================
225: # NFTBan v1.0.0 - Trust Feeds Configuration (Whitelists)
226: # =============================================================================
227: # Trust feeds are IP ranges from cloud providers, CDNs, etc. that should be
228: # whitelisted and never blocked by nftban.
229: # =============================================================================
230: 
231: `
232: 	}
233: 
234: 	varName := fmt.Sprintf("TRUST_%s_ENABLED", trustName)
235: 	newValue := "false"
236: 	if enable {
237: 		newValue = "true"
238: 	}
239: 
240: 	// Check if variable exists
241: 	if strings.Contains(content, varName) {
242: 		// Replace existing value using regex-based replacement (handles spacing variations)
243: 		content = replaceConfigValueTrust(content, varName, newValue)
244: 	} else {
245: 		// Add new variable
246: 		content += fmt.Sprintf(`%s="%s"`+"\n", varName, newValue)
247: 	}
248: 
249: 	// Write config
250: 	if err := os.WriteFile(configPath, []byte(content), 0640); err != nil {
251: 		return fmt.Errorf("failed to write config: %w", err)
252: 	}
253: 
254: 	action := "disabled"
255: 	if enable {
256: 		action = "enabled"
257: 	}
258: 	fmt.Printf("✅ Trust feed '%s' %s\n", trustName, action)
259: 
260: 	if enable {
261: 		fmt.Println()
262: 		fmt.Println("Next: Run 'sudo nftban trust update' to download and apply")
263: 	}
264: 
265: 	return nil
266: }

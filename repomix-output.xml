 727: // addIPWithTimeoutCLI adds a single IP to an interval set using nft CLI
 728: // This avoids the corrupted interval range bug in netlink library
 729: func (m *NFTManager) addIPWithTimeoutCLI(set *nftables.Set, ipStr string, timeout time.Duration) error {
 730: 	// Determine table family
 731: 	family := nftFamily(set.Table.Family == nftables.TableFamilyIPv4)
 732: 
 733: 	// Build element string with optional timeout
 734: 	var elementStr string
 735: 	if timeout > 0 {
 736: 		// Format: { IP timeout Xs }
 737: 		elementStr = fmt.Sprintf("{ %s timeout %ds }", ipStr, int(timeout.Seconds()))
 738: 	} else {
 739: 		elementStr = fmt.Sprintf("{ %s }", ipStr)
 740: 	}
 741: 
 742: 	// Use centralized add element (ignores interval overlaps and file exists)
 743: 	return nftAddElement(family, set.Table.Name, set.Name, elementStr)
 744: }

<file path="cli/lib/nftban/lib/validation.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - Input Validation Library
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Comprehensive input validation and sanitization
  7: #
  8: # meta:name=validation
  9: # meta:type=library
 10: # meta:header=Input Validation Library
 11: # meta:version=1.0.0
 12: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 13: # meta:homepage=https://nftban.com
 14: #
 15: # **Description & Purpose**
 16: # meta:description=Validates and sanitizes all user inputs to prevent injection attacks
 17: # meta:input=User-provided strings, IPs, ports, paths, etc.
 18: # meta:output=Boolean validation results and sanitized values
 19: #
 20: # **Inventory & Requirements**
 21: # meta:depends=bash>=4.0
 22: #
 23: # **Usage**
 24: # Source this file to validate inputs:
 25: #   source "${NFTBAN_LIB_DIR}/lib/validation.sh"
 26: #   nftban_validate_ip "192.168.1.1" || echo "Invalid IP"
 27: #
 28: # **Security Notes**
 29: # Protects against:
 30: # - Command injection
 31: # - Path traversal
 32: # - SQL injection (for database operations)
 33: # - XSS (for GUI operations)
 34: # - Integer overflow
 35: # - Format string attacks
 36: #
 37: # meta:created_date=2025-11-24
 38: # =============================================================================
 39: 
 40: # =============================================================================
 41: # GUARD: Prevent double-loading
 42: # =============================================================================
 43: 
 44: [[ -n "${NFTBAN_VALIDATION_LOADED:-}" ]] && return 0
 45: 
 46: # =============================================================================
 47: # IP ADDRESS VALIDATION
 48: # =============================================================================
 49: 
 50: nftban_validate_ipv4() {
 51:     # Validate IPv4 address
 52:     # Args: $1 = IP address
 53:     # Returns: 0 if valid, 1 if invalid
 54: 
 55:     local ip="$1"
 56: 
 57:     # Check format: 4 octets separated by dots
 58:     if [[ ! "$ip" =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]]; then
 59:         return 1
 60:     fi
 61: 
 62:     # Check each octet is 0-255
 63:     local IFS='.'
 64:     # shellcheck disable=SC2206  # Word splitting intentional with IFS='.'
 65:     local -a octets=($ip)
 66:     for octet in "${octets[@]}"; do
 67:         # Remove leading zeros for arithmetic comparison
 68:         octet=$((10#$octet))
 69:         if [[ $octet -lt 0 || $octet -gt 255 ]]; then
 70:             return 1
 71:         fi
 72:     done
 73: 
 74:     return 0
 75: }
 76: 
 77: nftban_validate_ipv6() {
 78:     # Validate IPv6 address
 79:     # Args: $1 = IP address
 80:     # Returns: 0 if valid, 1 if invalid
 81: 
 82:     local ip="$1"
 83: 
 84:     # Basic IPv6 format check (simplified)
 85:     # Full: 8 groups of 4 hex digits separated by colons
 86:     # Compressed: allows :: for consecutive zeros
 87:     if [[ "$ip" =~ ^([0-9a-fA-F]{0,4}:){2,7}[0-9a-fA-F]{0,4}$ ]] || \
 88:        [[ "$ip" =~ ^::([0-9a-fA-F]{0,4}:){0,6}[0-9a-fA-F]{0,4}$ ]] || \
 89:        [[ "$ip" =~ ^([0-9a-fA-F]{0,4}:){1,6}:([0-9a-fA-F]{0,4}:){0,5}[0-9a-fA-F]{0,4}$ ]]; then
 90:         return 0
 91:     fi
 92: 
 93:     return 1
 94: }
 95: 
 96: nftban_validate_ip() {
 97:     # Validate any IP address (IPv4 or IPv6)
 98:     # Args: $1 = IP address
 99:     # Returns: 0 if valid, 1 if invalid
100: 
101:     local ip="$1"
102: 
103:     nftban_validate_ipv4 "$ip" || nftban_validate_ipv6 "$ip"
104: }
105: 
106: nftban_validate_cidr() {
107:     # Validate CIDR notation (IP/prefix)
108:     # Args: $1 = CIDR (e.g., "192.168.1.0/24")
109:     # Returns: 0 if valid, 1 if invalid
110: 
111:     local cidr="$1"
112: 
113:     # Split IP and prefix
114:     if [[ ! "$cidr" =~ ^(.+)/([0-9]+)$ ]]; then
115:         return 1
116:     fi
117: 
118:     local ip="${BASH_REMATCH[1]}"
119:     local prefix="${BASH_REMATCH[2]}"
120: 
121:     # Validate IP part
122:     if ! nftban_validate_ip "$ip"; then
123:         return 1
124:     fi
125: 
126:     # Validate prefix
127:     if nftban_validate_ipv4 "$ip"; then
128:         # IPv4: prefix must be 0-32
129:         [[ $prefix -ge 0 && $prefix -le 32 ]]
130:     else
131:         # IPv6: prefix must be 0-128
132:         [[ $prefix -ge 0 && $prefix -le 128 ]]
133:     fi
134: }
135: 
136: # =============================================================================
137: # PORT VALIDATION
138: # =============================================================================
139: 
140: nftban_validate_port() {
141:     # Validate port number
142:     # Args: $1 = port number
143:     # Returns: 0 if valid, 1 if invalid
144: 
145:     local port="$1"
146: 
147:     # Must be numeric
148:     if [[ ! "$port" =~ ^[0-9]+$ ]]; then
149:         return 1
150:     fi
151: 
152:     # Must be 1-65535
153:     [[ $port -ge 1 && $port -le 65535 ]]
154: }
155: 
156: nftban_validate_port_range() {
157:     # Validate port range (e.g., "80-443")
158:     # Args: $1 = port range
159:     # Returns: 0 if valid, 1 if invalid
160: 
161:     local range="$1"
162: 
163:     # Check format
164:     if [[ ! "$range" =~ ^([0-9]+)-([0-9]+)$ ]]; then
165:         return 1
166:     fi
167: 
168:     local start="${BASH_REMATCH[1]}"
169:     local end="${BASH_REMATCH[2]}"
170: 
171:     # Validate both ports
172:     nftban_validate_port "$start" || return 1
173:     nftban_validate_port "$end" || return 1
174: 
175:     # Start must be <= end
176:     [[ $start -le $end ]]
177: }
178: 
179: # =============================================================================
180: # PROTOCOL VALIDATION
181: # =============================================================================
182: 
183: nftban_validate_protocol() {
184:     # Validate network protocol
185:     # Args: $1 = protocol (tcp, udp, icmp, etc.)
186:     # Returns: 0 if valid, 1 if invalid
187: 
188:     local proto="$1"
189: 
190:     case "${proto,,}" in
191:         tcp|udp|icmp|icmpv6|esp|ah|sctp|gre|all)
192:             return 0
193:             ;;
194:         *)
195:             return 1
196:             ;;
197:     esac
198: }
199: 
200: # =============================================================================
201: # TIME DURATION VALIDATION
202: # =============================================================================
203: 
204: nftban_validate_duration() {
205:     # Validate time duration (e.g., "1h", "30m", "2d")
206:     # Args: $1 = duration string
207:     # Returns: 0 if valid, 1 if invalid
208: 
209:     local duration="$1"
210: 
211:     # Format: number followed by s/m/h/d/w
212:     if [[ "$duration" =~ ^([0-9]+)([smhdw])$ ]]; then
213:         local num="${BASH_REMATCH[1]}"
214:         local unit="${BASH_REMATCH[2]}"
215: 
216:         # Check reasonable limits
217:         case "$unit" in
218:             s) [[ $num -le 86400 ]] ;;     # Max 1 day in seconds
219:             m) [[ $num -le 1440 ]] ;;      # Max 1 day in minutes
220:             h) [[ $num -le 720 ]] ;;       # Max 30 days in hours
221:             d) [[ $num -le 365 ]] ;;       # Max 1 year in days
222:             w) [[ $num -le 52 ]] ;;        # Max 1 year in weeks
223:             *) return 1 ;;
224:         esac
225:     else
226:         return 1
227:     fi
228: }
229: 
230: # =============================================================================
231: # PATH VALIDATION
232: # =============================================================================
233: 
234: nftban_validate_path() {
235:     # Validate file path (prevent path traversal)
236:     # Args: $1 = path, $2 = allowed base path (optional)
237:     # Returns: 0 if valid, 1 if invalid
238: 
239:     local path="$1"
240:     local base="${2:-}"
241: 
242:     # Reject null bytes (check if string contains actual null byte)
243:     if [[ "${#path}" -ne "$(printf '%s' "$path" | wc -c)" ]]; then
244:         return 1
245:     fi
246: 
247:     # Reject path traversal attempts
248:     if [[ "$path" =~ \.\./|\.\.\\ ]]; then
249:         return 1
250:     fi
251: 
252:     # If base path provided, ensure path is within it
253:     if [[ -n "$base" ]]; then
254:         local real_path
255:         real_path=$(realpath -m "$path" 2>/dev/null) || return 1
256:         local real_base
257:         real_base=$(realpath -m "$base" 2>/dev/null) || return 1
258: 
259:         # Path must start with base
260:         [[ "$real_path" == "$real_base"* ]]
261:     fi
262: 
263:     return 0
264: }
265: 
266: nftban_validate_filename() {
267:     # Validate filename (no path components, no special chars)
268:     # Args: $1 = filename
269:     # Returns: 0 if valid, 1 if invalid
270: 
271:     local filename="$1"
272: 
273:     # Must not be empty
274:     [[ -n "$filename" ]] || return 1
275: 
276:     # Must not contain path separators or null bytes
277:     [[ ! "$filename" =~ [/\\$'\0'] ]] || return 1
278: 
279:     # Must not be . or ..
280:     [[ "$filename" != "." && "$filename" != ".." ]] || return 1
281: 
282:     # Should only contain safe characters: alphanumeric, dash, underscore, dot
283:     [[ "$filename" =~ ^[a-zA-Z0-9._-]+$ ]]
284: }
285: 
286: # =============================================================================
287: # STRING SANITIZATION
288: # =============================================================================
289: 
290: nftban_sanitize_shell() {
291:     # Sanitize string for safe shell usage (prevent command injection)
292:     # Args: $1 = input string
293:     # Output: Sanitized string to stdout
294: 
295:     local input="$1"
296: 
297:     # Escape shell metacharacters
298:     printf '%s' "$input" | sed 's/[`$"\\]/\\&/g'
299: }
300: 
301: nftban_sanitize_sql() {
302:     # Sanitize string for SQL (prevent SQL injection)
303:     # Args: $1 = input string
304:     # Output: Sanitized string to stdout
305: 
306:     local input="$1"
307: 
308:     # Escape single quotes (double them)
309:     printf '%s' "$input" | sed "s/'/''/g"
310: }
311: 
312: nftban_sanitize_html() {
313:     # Sanitize string for HTML output (prevent XSS)
314:     # Args: $1 = input string
315:     # Output: HTML-escaped string to stdout
316: 
317:     local input="$1"
318: 
319:     # Escape HTML special characters
320:     printf '%s' "$input" | \
321:         sed 's/&/\&amp;/g' | \
322:         sed 's/</\&lt;/g' | \
323:         sed 's/>/\&gt;/g' | \
324:         sed 's/"/\&quot;/g' | \
325:         sed "s/'/\&#39;/g"
326: }
327: 
328: nftban_sanitize_log() {
329:     # Sanitize string for log files (prevent log injection)
330:     # Args: $1 = input string
331:     # Output: Sanitized string to stdout
332: 
333:     local input="$1"
334: 
335:     # Remove control characters and newlines
336:     printf '%s' "$input" | tr -d '\000-\037\177'
337: }
338: 
339: # =============================================================================
340: # COUNTRY CODE VALIDATION
341: # =============================================================================
342: 
343: nftban_validate_country_code() {
344:     # Validate ISO 3166-1 alpha-2 country code
345:     # Args: $1 = country code (e.g., "US", "GB")
346:     # Returns: 0 if valid format, 1 if invalid
347: 
348:     local code="$1"
349: 
350:     # Must be exactly 2 uppercase letters
351:     [[ "$code" =~ ^[A-Z]{2}$ ]]
352: }
353: 
354: # =============================================================================
355: # INTEGER VALIDATION
356: # =============================================================================
357: 
358: nftban_validate_integer() {
359:     # Validate integer within range
360:     # Args: $1 = value, $2 = min (optional), $3 = max (optional)
361:     # Returns: 0 if valid, 1 if invalid
362: 
363:     local value="$1"
364:     local min="${2:-}"
365:     local max="${3:-}"
366: 
367:     # Must be numeric
368:     if [[ ! "$value" =~ ^-?[0-9]+$ ]]; then
369:         return 1
370:     fi
371: 
372:     # Check min
373:     if [[ -n "$min" ]] && [[ $value -lt $min ]]; then
374:         return 1
375:     fi
376: 
377:     # Check max
378:     if [[ -n "$max" ]] && [[ $value -gt $max ]]; then
379:         return 1
380:     fi
381: 
382:     return 0
383: }
384: 
385: # =============================================================================
386: # BOOLEAN VALIDATION
387: # =============================================================================
388: 
389: nftban_validate_boolean() {
390:     # Validate boolean value
391:     # Args: $1 = value
392:     # Returns: 0 if valid, 1 if invalid
393: 
394:     local value="${1,,}"  # lowercase
395: 
396:     case "$value" in
397:         true|false|yes|no|1|0|on|off|enabled|disabled)
398:             return 0
399:             ;;
400:         *)
401:             return 1
402:             ;;
403:     esac
404: }
405: 
406: # =============================================================================
407: # COMPOSITE VALIDATION
408: # =============================================================================
409: 
410: nftban_validate_ban_target() {
411:     # Validate ban target (IP, CIDR, or country code)
412:     # Args: $1 = target
413:     # Returns: 0 if valid, 1 if invalid
414: 
415:     local target="$1"
416: 
417:     # Try IP
418:     nftban_validate_ip "$target" && return 0
419: 
420:     # Try CIDR
421:     nftban_validate_cidr "$target" && return 0
422: 
423:     # Try country code
424:     nftban_validate_country_code "$target" && return 0
425: 
426:     return 1
427: }
428: 
429: # =============================================================================
430: # EXPORT FUNCTIONS
431: # =============================================================================
432: 
433: export -f nftban_validate_ipv4
434: export -f nftban_validate_ipv6
435: export -f nftban_validate_ip
436: export -f nftban_validate_cidr
437: export -f nftban_validate_port
438: export -f nftban_validate_port_range
439: export -f nftban_validate_protocol
440: export -f nftban_validate_duration
441: export -f nftban_validate_path
442: export -f nftban_validate_filename
443: export -f nftban_sanitize_shell
444: export -f nftban_sanitize_sql
445: export -f nftban_sanitize_html
446: export -f nftban_sanitize_log
447: export -f nftban_validate_country_code
448: export -f nftban_validate_integer
449: export -f nftban_validate_boolean
450: export -f nftban_validate_ban_target
451: 
452: # =============================================================================
453: # MARK AS LOADED
454: # =============================================================================

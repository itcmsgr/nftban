// meta:created_date="2026-01-26"
// meta:description="Threat feeds management page showing feed status and sync"
// =============================================================================

package pages

import (
	"fmt"
	"github.com/itcmsgr/nftban/internal/ui"
)

// Feeds renders the threat feeds management page
templ Feeds(data ui.FeedsPageData) {
	@ui.LayoutWithNav("Feeds", "feeds") {
		<!-- Page Header -->
		<div class="page-header">
			<h1 class="page-title">Threat Feeds</h1>
			<div style="display: flex; gap: 0.5rem;">
				<button class="btn btn-primary" hx-post="/ui/action/sync-feeds" hx-confirm="Sync all feeds now?">
					Sync All
				</button>
				<button class="btn btn-secondary" hx-get="/ui/frag/feeds" hx-target="#feeds-content" hx-swap="innerHTML">
					Refresh
				</button>
			</div>
		</div>

		<div id="feeds-content" hx-get="/ui/frag/feeds" hx-trigger="every 30s" hx-swap="innerHTML">
			@FeedsContentFragment(data)
		</div>
	}
}

// FeedsContentFragment renders all feeds content sections
templ FeedsContentFragment(data ui.FeedsPageData) {
	<!-- Summary Stats Row -->
	<div class="feeds-stats-row">
		<div class="stat-card">
			<div class="stat-value">{ intToStr(data.TotalFeeds) }</div>
			<div class="stat-label">Total Feeds</div>
		</div>
		<div class="stat-card active">
			<div class="stat-value">{ intToStr(data.ActiveFeeds) }</div>
			<div class="stat-label">Active</div>
		</div>
		<div class="stat-card warning">
			<div class="stat-value">{ intToStr(data.StaleFeeds) }</div>
			<div class="stat-label">Stale</div>
		</div>
		<div class="stat-card danger">
			<div class="stat-value">{ intToStr(data.ErrorFeeds) }</div>
			<div class="stat-label">Errors</div>
		</div>
		<div class="stat-card info">
			<div class="stat-value">{ formatLargeNumber(int64(data.TotalIPs)) }</div>
			<div class="stat-label">Total IPs</div>
		</div>
	</div>

	<!-- Feeds Table -->
	<div class="card" style="margin-bottom: 1.5rem;">
		<div class="card-header">
			<span class="card-title">Feed Status</span>
			<span class="badge badge-muted">Last updated: { data.LastCheck }</span>
		</div>
		<table class="data-table">
			<thead>
				<tr>
					<th>Feed</th>
					<th>Status</th>
					<th>IP Count</th>
					<th>Last Sync</th>
					<th>Next Sync</th>
					<th>Errors</th>
					<th>Action</th>
				</tr>
			</thead>
			<tbody>
				for _, feed := range data.Feeds {
					<tr>
						<td>
							<div style="font-weight: 500;">{ feed.Name }</div>
							if feed.Description != "" {
								<div style="font-size: 0.8rem; color: var(--text-muted);">{ feed.Description }</div>
							}
						</td>
						<td>
							<span class={ "badge", getFeedStatusBadge(feed.Status) }>{ feed.Status }</span>
						</td>
						<td style="font-family: monospace; font-weight: 500;">{ formatLargeNumber(int64(feed.IPCount)) }</td>
						<td style="font-size: 0.85rem; color: var(--text-muted);">{ feed.LastSync }</td>
						<td style="font-size: 0.85rem; color: var(--text-muted);">{ feed.NextSync }</td>
						<td>
							if feed.SyncErrors > 0 {
								<span class="badge badge-danger">{ intToStr(feed.SyncErrors) }</span>
							} else {
								<span class="badge badge-muted">0</span>
							}
						</td>
						<td>
							<div style="display: flex; gap: 0.25rem;">
								<button
									class="btn btn-sm btn-primary"
									hx-post={ fmt.Sprintf("/ui/action/sync-feed/%s", feed.Name) }
									hx-confirm={ fmt.Sprintf("Sync %s now?", feed.Name) }
									title="Sync now"
								>
									Sync
								</button>
								if feed.Enabled {
									<button
										class="btn btn-sm btn-secondary"
										hx-post={ fmt.Sprintf("/ui/action/feed-toggle/%s", feed.Name) }
										hx-confirm={ fmt.Sprintf("Disable %s?", feed.Name) }
										title="Disable feed"
									>
										Disable
									</button>
								} else {
									<button
										class="btn btn-sm btn-secondary"
										hx-post={ fmt.Sprintf("/ui/action/feed-toggle/%s", feed.Name) }
										hx-confirm={ fmt.Sprintf("Enable %s?", feed.Name) }
										title="Enable feed"
									>
										Enable
									</button>
								}
							</div>
						</td>
					</tr>
				}
				if len(data.Feeds) == 0 {
					<tr>
						<td colspan="7" style="text-align: center; color: var(--text-muted); padding: 2rem;">
							No threat feeds configured
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>

	<!-- Feed Details Grid -->
	<div class="feeds-detail-grid">
		<!-- Top Feeds by IP Count -->
		<div class="card">
			<div class="card-header">
				<span class="card-title">Top Feeds by IP Count</span>
			</div>
			<div class="feed-chart-list">
				for _, feed := range data.TopFeeds {
					<div class="feed-chart-item">
						<div class="feed-chart-header">
							<span class="feed-chart-name">{ feed.Name }</span>
							<span class="feed-chart-count">{ formatLargeNumber(int64(feed.IPCount)) }</span>
						</div>
						<div class="feed-chart-bar">
							<div class="feed-chart-fill" style={ fmt.Sprintf("width: %.0f%%", feed.Percent) }></div>
						</div>
					</div>
				}
				if len(data.TopFeeds) == 0 {
					<div class="empty-state">No feed data available</div>
				}
			</div>
		</div>

		<!-- Recent Sync Activity -->
		<div class="card">
			<div class="card-header">
				<span class="card-title">Recent Sync Activity</span>
			</div>
			<div class="sync-activity-list">
				for _, activity := range data.RecentActivity {
					<div class="sync-activity-item">
						<div class="activity-main">
							<span class={ "activity-icon", activity.Status }>
								if activity.Status == "success" {
									&#x2714;
								} else if activity.Status == "error" {
									&#x2716;
								} else {
									&#x21BB;
								}
							</span>
							<span class="activity-feed">{ activity.FeedName }</span>
						</div>
						<div class="activity-info">
							<span class="activity-ips">
								if activity.IPsAdded > 0 {
									+{ intToStr(activity.IPsAdded) }
								}
								if activity.IPsRemoved > 0 {
									-{ intToStr(activity.IPsRemoved) }
								}
							</span>
							<span class="activity-time">{ activity.Timestamp }</span>
						</div>
					</div>
				}
				if len(data.RecentActivity) == 0 {
					<div class="empty-state">No recent sync activity</div>
				}
			</div>
		</div>
	</div>

	<!-- Quick Commands -->
	<div class="card" style="margin-top: 1.5rem;">
		<div class="card-header">
			<span class="card-title">CLI Commands</span>
		</div>
		<div class="command-grid">
			<div class="command-item">
				<code>nftban feeds list</code>
				<span>List all feeds</span>
			</div>
			<div class="command-item">
				<code>nftban feeds status</code>
				<span>Show feed status</span>
			</div>
			<div class="command-item">
				<code>nftban feeds sync</code>
				<span>Sync all feeds</span>
			</div>
			<div class="command-item">
				<code>nftban feeds sync &lt;name&gt;</code>
				<span>Sync specific feed</span>
			</div>
			<div class="command-item">
				<code>nftban feeds enable &lt;name&gt;</code>
				<span>Enable a feed</span>
			</div>
			<div class="command-item">
				<code>nftban feeds disable &lt;name&gt;</code>
				<span>Disable a feed</span>
			</div>
		</div>
	</div>

	<style>
		.feeds-stats-row {
			display: grid;
			grid-template-columns: repeat(5, 1fr);
			gap: 1rem;
			margin-bottom: 1.5rem;
		}
		@media (max-width: 1024px) {
			.feeds-stats-row {
				grid-template-columns: repeat(3, 1fr);
			}
		}
		@media (max-width: 768px) {
			.feeds-stats-row {
				grid-template-columns: repeat(2, 1fr);
			}
		}

		.stat-card {
			background: var(--bg-surface);
			border: 1px solid var(--border-color);
			border-radius: 8px;
			padding: 1rem;
			text-align: center;
		}
		.stat-card.active {
			border-left: 4px solid var(--accent-safe);
		}
		.stat-card.warning {
			border-left: 4px solid var(--accent-warning);
		}
		.stat-card.danger {
			border-left: 4px solid var(--accent-danger);
		}
		.stat-card.info {
			border-left: 4px solid var(--accent-info);
		}

		.stat-value {
			font-size: 1.5rem;
			font-weight: 700;
			font-family: 'SF Mono', Monaco, monospace;
		}
		.stat-card.active .stat-value { color: var(--accent-safe); }
		.stat-card.warning .stat-value { color: var(--accent-warning); }
		.stat-card.danger .stat-value { color: var(--accent-danger); }
		.stat-card.info .stat-value { color: var(--accent-info); }

		.stat-label {
			font-size: 0.75rem;
			color: var(--text-muted);
			text-transform: uppercase;
		}

		.feeds-detail-grid {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 1.5rem;
		}
		@media (max-width: 1024px) {
			.feeds-detail-grid {
				grid-template-columns: 1fr;
			}
		}

		.feed-chart-list {
			padding: 0.5rem;
		}
		.feed-chart-item {
			padding: 0.75rem 0;
			border-bottom: 1px solid var(--border-color);
		}
		.feed-chart-item:last-child {
			border-bottom: none;
		}
		.feed-chart-header {
			display: flex;
			justify-content: space-between;
			margin-bottom: 0.5rem;
		}
		.feed-chart-name {
			font-weight: 500;
		}
		.feed-chart-count {
			font-family: monospace;
			color: var(--accent-info);
		}
		.feed-chart-bar {
			height: 6px;
			background: var(--bg-elevated);
			border-radius: 3px;
			overflow: hidden;
		}
		.feed-chart-fill {
			height: 100%;
			background: var(--accent-info);
			border-radius: 3px;
		}

		.sync-activity-list {
			padding: 0.5rem;
			max-height: 400px;
			overflow-y: auto;
		}
		.sync-activity-item {
			display: flex;
			justify-content: space-between;
			align-items: center;
			padding: 0.75rem;
			border-bottom: 1px solid var(--border-color);
		}
		.sync-activity-item:last-child {
			border-bottom: none;
		}
		.activity-main {
			display: flex;
			align-items: center;
			gap: 0.75rem;
		}
		.activity-icon {
			font-size: 1rem;
		}
		.activity-icon.success { color: var(--accent-safe); }
		.activity-icon.error { color: var(--accent-danger); }
		.activity-icon.syncing { color: var(--accent-warning); }
		.activity-feed {
			font-weight: 500;
		}
		.activity-info {
			display: flex;
			gap: 1rem;
			font-size: 0.85rem;
		}
		.activity-ips {
			font-family: monospace;
			color: var(--accent-info);
		}
		.activity-time {
			color: var(--text-muted);
		}

		.command-grid {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 1rem;
			padding: 1rem;
		}
		@media (max-width: 1024px) {
			.command-grid {
				grid-template-columns: repeat(2, 1fr);
			}
		}
		@media (max-width: 768px) {
			.command-grid {
				grid-template-columns: 1fr;
			}
		}
		.command-item {
			display: flex;
			flex-direction: column;
			gap: 0.25rem;
		}
		.command-item code {
			background: var(--bg-elevated);
			padding: 0.5rem;
			border-radius: 4px;
			font-size: 0.85rem;
		}
		.command-item span {
			font-size: 0.8rem;
			color: var(--text-muted);
		}

		.empty-state {
			padding: 2rem;
			text-align: center;
			color: var(--text-muted);
		}
	</style>
}

// FeedsTableFragment renders just the feeds table for HTMX updates
templ FeedsTableFragment(feeds []ui.FeedEntry) {
	for _, feed := range feeds {
		<tr>
			<td>
				<div style="font-weight: 500;">{ feed.Name }</div>
				if feed.Description != "" {
					<div style="font-size: 0.8rem; color: var(--text-muted);">{ feed.Description }</div>
				}
			</td>
			<td>
				<span class={ "badge", getFeedStatusBadge(feed.Status) }>{ feed.Status }</span>
			</td>
			<td style="font-family: monospace; font-weight: 500;">{ formatLargeNumber(int64(feed.IPCount)) }</td>
			<td style="font-size: 0.85rem; color: var(--text-muted);">{ feed.LastSync }</td>
			<td style="font-size: 0.85rem; color: var(--text-muted);">{ feed.NextSync }</td>
			<td>
				if feed.SyncErrors > 0 {
					<span class="badge badge-danger">{ intToStr(feed.SyncErrors) }</span>
				} else {
					<span class="badge badge-muted">0</span>
				}
			</td>
			<td>
				<button
					class="btn btn-sm btn-primary"
					hx-post={ fmt.Sprintf("/ui/action/sync-feed/%s", feed.Name) }
					hx-confirm={ fmt.Sprintf("Sync %s now?", feed.Name) }
				>
					Sync
				</button>
			</td>
		</tr>
	}
	if len(feeds) == 0 {
		<tr>
			<td colspan="7" style="text-align: center; color: var(--text-muted); padding: 2rem;">
				No threat feeds configured
			</td>
		</tr>
	}
}

<file path="pkg/api/ddos_handlers.go">
  1: package api
  2: 
  3: import (
  4: 	"encoding/json"
  5: 	"log"
  6: 	"net/http"
  7: 	"strings"
  8: )
  9: 
 10: // DdosStats represents DDoS protection statistics
 11: type DdosStats struct {
 12: 	PacketsDropped    int    `json:"packets_dropped"`
 13: 	BytesDropped      int    `json:"bytes_dropped"`
 14: 	Blocked24h        int    `json:"blocked_24h"`
 15: 	BlockedTotal      int    `json:"blocked_total"`
 16: 	Enabled           bool   `json:"enabled"`
 17: 	RateLimit         int    `json:"rate_limit"`
 18: 	Mode              string `json:"mode"`               // classic, suricata, hybrid
 19: 	SuricataAvailable bool   `json:"suricata_available"` // is Suricata service running
 20: }
 21: 
 22: // DdosStatsHandler returns DDoS protection statistics
 23: // GET /api/v1/ddos/stats
 24: func DdosStatsHandler(w http.ResponseWriter, r *http.Request) {
 25: 	// Execute: nftban ddos stats --json (dedicated DDoS stats command)
 26: 	output, err := execNFTBanCommand("ddos", "stats", "--json")
 27: 	if err != nil {
 28: 		log.Printf("[ERROR] Failed to get ddos stats: %v", err)
 29: 		// Return default stats on error
 30: 		respondJSON(w, http.StatusOK, map[string]interface{}{
 31: 			"success": true,
 32: 			"data": map[string]interface{}{
 33: 				"ddos": DdosStats{
 34: 					Enabled: false,
 35: 				},
 36: 			},
 37: 		})
 38: 		return
 39: 	}
 40: 
 41: 	// Strip any non-JSON output (comments, warnings, etc.) before parsing
 42: 	// Look for the first '{' and last '}' to extract only the JSON portion
 43: 	output = strings.TrimSpace(output)
 44: 	startIdx := strings.Index(output, "{")
 45: 	endIdx := strings.LastIndex(output, "}")
 46: 
 47: 	if startIdx == -1 || endIdx == -1 || startIdx > endIdx {
 48: 		log.Printf("[ERROR] No valid JSON found in ddos stats output: %s", output)
 49: 		// Return default stats on invalid JSON
 50: 		respondJSON(w, http.StatusOK, map[string]interface{}{
 51: 			"success": true,
 52: 			"data": map[string]interface{}{
 53: 				"ddos": DdosStats{
 54: 					Enabled: false,
 55: 				},
 56: 			},
 57: 		})
 58: 		return
 59: 	}
 60: 
 61: 	jsonOutput := output[startIdx : endIdx+1]
 62: 
 63: 	// Parse the JSON output
 64: 	var result struct {
 65: 		Success bool `json:"success"`
 66: 		Data    struct {
 67: 			Ddos DdosStats `json:"ddos"`
 68: 		} `json:"data"`
 69: 	}
 70: 
 71: 	if err := json.Unmarshal([]byte(jsonOutput), &result); err != nil {
 72: 		log.Printf("[ERROR] Failed to parse ddos stats output: %v - Output: %s", err, jsonOutput)
 73: 		// Return default stats on parse error
 74: 		respondJSON(w, http.StatusOK, map[string]interface{}{
 75: 			"success": true,
 76: 			"data": map[string]interface{}{
 77: 				"ddos": DdosStats{
 78: 					Enabled: false,
 79: 				},
 80: 			},
 81: 		})
 82: 		return
 83: 	}
 84: 
 85: 	respondJSON(w, http.StatusOK, result)
 86: }

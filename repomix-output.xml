3580:     echo ""
3581:     printf "  Summary: %d/%d config files OK\n" "$cfg_ok" "${#required_configs[@]}"
3582:     echo ""
3583: 
3584:     # ─────────────────────────────────────────────────────────────────────
3585:     # 6. OPTIONAL COMPONENTS

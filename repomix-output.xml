172:     if (distributionCtx) {
173:         distributionChart = new Chart(distributionCtx, {
174:             type: 'doughnut',
175:             data: {
176:                 labels: [],
177:                 datasets: [{
178:                     data: [],
179:                     backgroundColor: [
180:                         '#ff6b6b', '#4dabf7', '#51cf66', '#ffd43b', '#a78bfa',

329: # =============================================================================
330: # LOGS
331: # =============================================================================
332: 
333: nftban_debug_logs() {
334:     local log_type="${1:-main}"
335:     local count="${2:-50}"
336:     local log_dir="${NFTBAN_LOG_DIR:-/var/log/nftban}"
337: 
338:     local log_file=""
339:     case "$log_type" in
340:         main|nftban)
341:             log_file="${log_dir}/nftban.log"
342:             ;;
343:         trace)
344:             log_file="${log_dir}/debug_trace.log"
345:             ;;
346:         login)
347:             log_file="${log_dir}/login-monitor.log"
348:             ;;
349:         bans)
350:             log_file="${log_dir}/bans.log"
351:             ;;
352:         all)
353:             echo "Available log files:"
354:             echo "─────────────────────────────────────────"
355:             for f in "${log_dir}"/*.log; do
356:                 if [[ -f "$f" ]]; then
357:                     local size
358:                     size=$(du -h "$f" 2>/dev/null | cut -f1)
359:                     printf "  %-40s %s\n" "$f" "$size"
360:                 fi
361:             done
362:             return 0
363:             ;;
364:         *)
365:             # Treat as filename
366:             if [[ -f "$log_type" ]]; then
367:                 log_file="$log_type"
368:             elif [[ -f "${log_dir}/${log_type}.log" ]]; then
369:                 log_file="${log_dir}/${log_type}.log"
370:             else
371:                 echo "Unknown log type: $log_type"
372:                 echo "Options: main, trace, login, bans, all"
373:                 return 1
374:             fi
375:             ;;
376:     esac
377: 
378:     echo "Log: $log_file (last $count lines)"
379:     echo "════════════════════════════════════════════════════════════════"
380: 
381:     if [[ -f "$log_file" ]]; then
382:         tail -n "$count" "$log_file"
383:     else
384:         echo "(log file does not exist)"
385:     fi
386: }
387: 
388: # =============================================================================
389: # DUMP
390: # =============================================================================
391: 
392: nftban_debug_dump() {
393:     local what="${1:-all}"
394: 
395:     echo "NFTBan Debug Dump"
396:     echo "════════════════════════════════════════════════════════════════"
397:     echo "Generated: $(date)"
398:     echo ""
399: 
400:     case "$what" in
401:         config)
402:             echo "=== Configuration ==="
403:             if [[ -f "${NFTBAN_CONFIG_DIR}/nftban.conf" ]]; then
404:                 grep -v '^#' "${NFTBAN_CONFIG_DIR}/nftban.conf" | grep -v '^$'
405:             fi
406:             ;;
407: 
408:         env)
409:             echo "=== Environment Variables ==="
410:             env | grep -E '^NFTBAN_' | sort
411:             ;;
412: 
413:         services)
414:             echo "=== NFTBan Services ==="
415:             systemctl list-units 'nftban*' --no-pager 2>/dev/null || echo "(no systemd services)"
416:             ;;
417: 
418:         nft)
419:             echo "=== nftables Sets ==="
420:             nft list sets 2>/dev/null | head -50 || echo "(nft not available)"
421:             ;;
422: 
423:         all)
424:             nftban_debug_dump config
425:             echo ""
426:             nftban_debug_dump env
427:             echo ""
428:             nftban_debug_dump services
429:             echo ""
430:             nftban_debug_dump nft
431:             ;;
432: 
433:         *)
434:             echo "Unknown dump type: $what"
435:             echo "Options: config, env, services, nft, all"
436:             return 1
437:             ;;
438:     esac
439: }
440: 
441: # =============================================================================
442: # USAGE
443: # =============================================================================
444: 
445: nftban_cmd_debug_usage() {
446:     cat <<EOF
447: Usage: nftban debug <command> [OPTIONS]
448: 
449: Debug and troubleshooting tools.
450: 
451: Commands:
452:   status                 Show debug status
453:   enable [trace|verbose] Enable debug trace or verbose logging
454:   disable [trace|verbose] Disable debug trace or verbose logging
455:   trace recent [N]       Show last N trace entries (default: 30)
456:   trace orphans [MIN]    Find stuck scripts (older than MIN minutes)
457:   trace stats            Show trace statistics
458:   trace clear [DAYS]     Rotate trace log, keep DAYS (default: 7)
459:   logs [TYPE] [N]        View log file (main, trace, login, bans, all)
460:   dump [WHAT]            Dump debug info (config, env, services, nft, all)
461: 
462: Examples:
463:   nftban debug status              # Show debug status
464:   nftban debug enable              # Enable debug trace
465:   nftban debug enable verbose      # Also enable verbose logging
466:   nftban debug disable             # Disable debug trace
467:   nftban debug trace recent 50     # Show last 50 trace entries
468:   nftban debug trace orphans       # Find stuck/crashed scripts
469:   nftban debug logs main 100       # Show last 100 main log entries
470:   nftban debug dump all            # Full debug dump
471: 
472: Debug Trace:
473:   When enabled, each script logs START/END with unique trace ID.
474:   If a script has START without matching END = script is stuck/crashed.
475: 
476:   Enable:  nftban debug enable
477:   Check:   nftban debug trace orphans
478:   Disable: nftban debug disable
479: 
480: EOF
481: }
482: 
483: # Export functions
484: export -f nftban_cmd_debug
485: export -f nftban_cmd_debug_usage
</file>

<file path="cli/lib/nftban/cli/cmd_emulate.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan CLI: emulate command
  4: # =============================================================================
  5: # Simulate packet evaluation to show what nftban would do
  6: #
  7: # Usage:
  8: #   nftban emulate <ip>
  9: #   nftban emulate <ip> --proto tcp --port 22 --direction in
 10: #   nftban emulate <ip> --json
 11: #
 12: # Version: 1.0.0
 13: # =============================================================================
 14: 
 15: set -Eeuo pipefail
 16: 
 17: # Source core emulation module
 18: NFTBAN_LIB_DIR="${NFTBAN_LIB_DIR:-/usr/lib/nftban}"
 19: # shellcheck source=/dev/null
 20: source "${NFTBAN_LIB_DIR}/core/nftban_emulate.sh"
 21: 
 22: # =============================================================================
 23: # COMMAND HANDLER
 24: # =============================================================================
 25: 
 26: nftban_cmd_emulate() {
 27:     local ip=""
 28:     local proto=""
 29:     local port=""
 30:     local direction="in"
 31:     local json_output=false
 32:     local help=false
 33: 
 34:     # Parse arguments
 35:     while [[ $# -gt 0 ]]; do
 36:         case "$1" in
 37:             -h|--help)
 38:                 help=true
 39:                 shift
 40:                 ;;
 41:             -j|--json)
 42:                 json_output=true
 43:                 shift
 44:                 ;;
 45:             -p|--proto|--protocol)
 46:                 proto="$2"
 47:                 shift 2
 48:                 ;;
 49:             --port)
 50:                 port="$2"
 51:                 shift 2
 52:                 ;;
 53:             -d|--direction|--dir)
 54:                 direction="$2"
 55:                 shift 2
 56:                 ;;
 57:             -*)
 58:                 nftban_banner 2>/dev/null || true
 59:                 echo "Error: Unknown option: $1" >&2
 60:                 echo "Use 'nftban emulate --help' for usage" >&2
 61:                 exit 1
 62:                 ;;
 63:             *)
 64:                 if [[ -z "$ip" ]]; then
 65:                     ip="$1"
 66:                 else
 67:                     nftban_banner 2>/dev/null || true
 68:                     echo "Error: Unexpected argument: $1" >&2
 69:                     exit 1
 70:                 fi
 71:                 shift
 72:                 ;;
 73:         esac
 74:     done
 75: 
 76:     # Show help
 77:     if [[ "$help" == "true" ]]; then
 78:         _emulate_help
 79:         return 0
 80:     fi
 81: 
 82:     # Validate IP
 83:     if [[ -z "$ip" ]]; then
 84:         nftban_banner 2>/dev/null || true
 85:         echo "Error: IP address required" >&2
 86:         echo "Usage: nftban emulate <ip> [options]" >&2
 87:         exit 1
 88:     fi
 89: 
 90:     # Validate IP format
 91:     if ! _validate_ip "$ip"; then
 92:         nftban_banner 2>/dev/null || true
 93:         echo "Error: Invalid IP address: $ip" >&2
 94:         exit 1
 95:     fi
 96: 
 97:     # Validate protocol if specified
 98:     if [[ -n "$proto" ]]; then
 99:         case "$proto" in
100:             tcp|udp|icmp|icmpv6) ;;
101:             *)
102:                 nftban_banner 2>/dev/null || true
103:                 echo "Error: Invalid protocol: $proto (use tcp, udp, icmp)" >&2
104:                 exit 1
105:                 ;;
106:         esac
107:     fi
108: 
109:     # Validate port if specified
110:     if [[ -n "$port" ]]; then
111:         if ! [[ "$port" =~ ^[0-9]+$ ]] || [[ "$port" -lt 1 ]] || [[ "$port" -gt 65535 ]]; then
112:             nftban_banner 2>/dev/null || true
113:             echo "Error: Invalid port: $port (must be 1-65535)" >&2
114:             exit 1
115:         fi
116:     fi
117: 
118:     # Validate direction
119:     case "$direction" in
120:         in|input|out|output|fwd|forward) ;;
121:         *)
122:             nftban_banner 2>/dev/null || true
123:             echo "Error: Invalid direction: $direction (use in, out, fwd)" >&2
124:             exit 1
125:             ;;
126:     esac
127: 
128:     # Run emulation
129:     local result
130:     result=$(nftban_emulate_packet "$ip" "$proto" "$port" "$direction")
131: 
132:     if [[ "$json_output" == "true" ]]; then
133:         echo "$result"
134:     else
135:         nftban_emulate_format_text "$result"
136:     fi
137: 
138:     # Return exit code based on decision
139:     local decision
140:     decision=$(echo "$result" | grep -o '"decision": *"[^"]*"' | cut -d'"' -f4)
141:     [[ "$decision" == "block" ]] && return 2
142:     return 0
143: }
144: 
145: # Validate IP address format
146: _validate_ip() {
147:     local ip="$1"
148: 
149:     # IPv4 validation
150:     if [[ "$ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
151:         local IFS='.'
152:         read -ra octets <<< "$ip"
153:         for octet in "${octets[@]}"; do
154:             [[ "$octet" -gt 255 ]] && return 1
155:         done
156:         return 0
157:     fi
158: 
159:     # IPv6 validation (basic)
160:     if [[ "$ip" =~ ^[0-9a-fA-F:]+$ ]]; then
161:         return 0
162:     fi
163: 
164:     return 1
165: }
166: 
167: # Show help
168: _emulate_help() {
169:     cat <<'EOF'
170: NFTBan Emulate - Simulate packet decision
171: 
172: USAGE:
173:     nftban emulate <ip> [options]
174: 
175: DESCRIPTION:
176:     Simulates what nftban would do with a packet from the specified IP.
177:     Shows whether the packet would be ALLOWED or BLOCKED, and explains
178:     which rule/set/module would make the decision.
179: 
180: ARGUMENTS:
181:     <ip>                IP address to test (IPv4 or IPv6)
182: 
183: OPTIONS:
184:     -p, --proto <proto> Protocol: tcp, udp, icmp (optional)
185:     --port <port>       Port number: 1-65535 (optional)
186:     -d, --direction     Direction: in, out, fwd (default: in)
187:     -j, --json          Output as JSON
188:     -h, --help          Show this help
189: 
190: EXAMPLES:
191:     # Basic IP check
192:     nftban emulate 8.8.8.8
193: 
194:     # Check with protocol and port
195:     nftban emulate 8.8.8.8 --proto tcp --port 22
196: 
197:     # Check outbound traffic
198:     nftban emulate 1.2.3.4 --direction out
199: 
200:     # JSON output for scripts/API
201:     nftban emulate 8.8.8.8 --json
202: 
203:     # Check if internal IP is whitelisted
204:     nftban emulate 10.0.0.1
205: 
206: EXIT CODES:
207:     0    Packet would be ALLOWED
208:     1    Error (invalid input, etc.)
209:     2    Packet would be BLOCKED
210: 
211: EVALUATION ORDER:
212:     1. Whitelist check (if match → ALLOW)
213:     2. Blacklist check (if match → BLOCK)
214:     3. GeoBan check (if match → BLOCK)
215:     4. Port filter (if port not allowed → BLOCK)
216:     5. Default policy (usually → ALLOW established, DROP new)
217: 
218: OUTPUT FIELDS:
219:     Module          Which nftban module made the decision
220:     Source          Specific source (feed name, config file, etc.)
221:     List type       Which nft set was matched
222:     Matching entry  The actual CIDR or IP that matched
223:     Table/Chain     NFTables table and chain
224:     Rule handle     NFTables rule handle number
225: 
226: SEE ALSO:
227:     nftban list          Show current bans
228:     nftban whitelist     Manage whitelist
229:     nftban search        Search for IP in sets
230: EOF
231: }
232: 
233: # Subcommand aliases (note: nftban_cmd_test removed - conflicts with cmd_test.sh)
234: nftban_cmd_simulate() {
235:     nftban_cmd_emulate "$@"
236: }
237: 
238: nftban_cmd_explain() {
239:     nftban_cmd_emulate "$@"
240: }
241: 
242: # Export functions
243: export -f nftban_cmd_emulate
244: export -f nftban_cmd_simulate
245: export -f nftban_cmd_explain
</file>

<file path="cli/lib/nftban/cli/cmd_fhs.sh">
  1: #!/usr/bin/env bash
  2: 
  3: # =============================================================================
  4: 
  5: # Load JSON helper for --json support
  6: [[ -z "${NFTBAN_LIB_DIR:-}" ]] && readonly NFTBAN_LIB_DIR="/usr/lib/nftban"
  7: 
  8: # Load strict mode library
  9: # shellcheck source=/usr/lib/nftban/lib/strict.sh
 10: if [[ -f "${NFTBAN_LIB_DIR}/lib/strict.sh" ]]; then
 11:     source "${NFTBAN_LIB_DIR}/lib/strict.sh"
 12: else
 13:     # Fallback to manual strict mode
 14:     set -Eeuo pipefail
 15: fi
 16: 
 17: # Load version library
 18: # shellcheck source=/usr/lib/nftban/lib/version.sh
 19: if [[ -f "${NFTBAN_LIB_DIR}/lib/version.sh" ]]; then
 20:     source "${NFTBAN_LIB_DIR}/lib/version.sh"
 21: fi
 22: JSON_HELPER="${NFTBAN_LIB_DIR}/helpers/json_output.sh"
 23: if [[ -f "$JSON_HELPER" ]]; then
 24:     # shellcheck source=/dev/null
 25:     source "$JSON_HELPER"
 26: fi
 27: # NFTBan v1.0.0 - FHS CLI Handler
 28: # =============================================================================
 29: 
 30: # SPDX-License-Identifier: MPL-2.0
 31: # Purpose: Handle FHS compliance CLI commands
 32: #
 33: # meta:name=cmd_fhs
 34: # meta:type=cli
 35: # meta:header=FHS CLI Command
 36: # meta:version=1.0.0
 37: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 38: # meta:homepage=https://nftban.com
 39: #
 40: # **Description & Purpose**
 41: # meta:description=CLI interface for FHS compliance reporting
 42: # meta:input=Output format, mail options
 43: # meta:output=FHS compliance reports (terminal, HTML, mail)
 44: #
 45: # **Inventory & Requirements**
 46: # meta:depends=bash,nftban_report_fhs.sh
 47: #
 48: # meta:created_date=2025-11-05
 49: # meta:updated_date=2025-11-24
 50: # =============================================================================
 51: 
 52: 
 53: # Strict mode
 54: IFS=$'\n\t'
 55: umask 027
 56: 
 57: # Load dependencies
 58: SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
 59: LIB_DIR="$(dirname "$SCRIPT_DIR")"
 60: 
 61: # Load FHS report core module if not already loaded
 62: if [[ ! $(type -t nftban_fhs_report_status) == "function" ]]; then
 63:     if [[ -f "${LIB_DIR}/core/nftban_report_fhs.sh" ]]; then
 64:         # shellcheck source=/dev/null
 65:         source "${LIB_DIR}/core/nftban_report_fhs.sh"
 66:     else
 67:         echo "ERROR: nftban_report_fhs.sh not found at ${LIB_DIR}/core" >&2
 68:         exit 1
 69:     fi
 70: fi
 71: 
 72: # Load mail module for mail-report functionality
 73: if [[ ! $(type -t nftban_mail_send) == "function" ]]; then
 74:     if [[ -f "${LIB_DIR}/core/nftban_mail.sh" ]]; then
 75:         # shellcheck source=/dev/null
 76:         source "${LIB_DIR}/core/nftban_mail.sh"
 77:     fi
 78: fi
 79: 
 80: # =============================================================================
 81: 
 82: # FHS COMMAND HANDLER
 83: # =============================================================================
 84: 
 85: 
 86: nftban_cmd_fhs() {
 87:     # Handle FHS subcommands
 88:     # Args: $@ = fhs subcommand and arguments
 89: 
 90:     local subcmd="${1:-status}"
 91:     shift || true
 92: 
 93:     # Show banner for main commands (not help/json)
 94:     if [[ "$subcmd" != "help" && "$subcmd" != "json" ]]; then
 95:         if type -t nftban_banner >/dev/null 2>&1; then
 96:             nftban_banner "fhs"
 97:             echo ""
 98:         fi
 99:     fi
100: 
101:     case "$subcmd" in
102:         status|check|detailed|"")
103:             # Show FHS compliance status (terminal output - default detailed)
104:             # NOTE: 'check' is deprecated, use 'status' instead
105:             export NFTBAN_FHS_OUTPUT_FORMAT="table"
106:             local result=0
107:             nftban_fhs_report_status || result=$?
108:             return $result
109:             ;;
110: 
111:         summary)
112:             # Show one-line summary
113:             nftban_fhs_report_summary
114:             return $?
115:             ;;
116: 
117:         json)
118:             # Show JSON output
119:             nftban_fhs_report_json
120:             return $?
121:             ;;
122: 
123:         html-report)
124:             # Generate HTML report
125:             echo "Generating HTML FHS compliance report..."
126:             local report_file
127:             report_file=$(nftban_fhs_generate_html_report)
128:             if [[ $? -eq 0 && -f "$report_file" ]]; then
129:                 echo "✓ HTML report generated successfully:"
130:                 echo "  $report_file"
131:                 echo
132:                 echo "View with: firefox '$report_file' (or your preferred browser)"
133:                 return 0
134:             else
135:                 echo "ERROR: Failed to generate HTML report" >&2
136:                 return 1
137:             fi
138:             ;;
139: 
140:         mail-report)
141:             # Mail FHS report
142:             # Args: [path] [recipient]
143:             local report_path="${1:-}"
144:             local recipient="${2:-${NFTBAN_MAIL_REPORT_RECIPIENT:-}}"
145: 
146:             # If no path and recipient is first arg (email pattern)
147:             if [[ -z "$recipient" && "$report_path" =~ @ ]]; then
148:                 recipient="$report_path"
149:                 report_path=""
150:             fi
151: 
152:             if [[ -z "$recipient" ]]; then
153:                 echo "ERROR: No recipient specified" >&2
154:                 echo "Set NFTBAN_MAIL_REPORT_RECIPIENT in config or provide recipient as argument" >&2
155:                 echo "Usage: nftban fhs mail-report [path] [recipient]" >&2
156:                 echo "   or: nftban fhs mail-report recipient@example.com" >&2
157:                 return 1
158:             fi
159: 
160:             # Check if mail module is available
161:             if [[ ! $(type -t nftban_mail_send) == "function" ]]; then
162:                 echo "ERROR: Mail module not available" >&2
163:                 echo "Please ensure nftban_mail.sh is installed" >&2
164:                 return 1
165:             fi
166: 
167:             # If path provided, mail that file
168:             if [[ -n "$report_path" ]]; then
169:                 if [[ ! -f "$report_path" ]]; then
170:                     echo "ERROR: Report file not found: $report_path" >&2
171:                     return 1
172:                 fi
173:                 echo "Sending FHS report to $recipient..."
174:                 nftban_mail_send "$report_path" "$recipient"
175:                 return $?
176:             else
177:                 # Generate report and mail it
178:                 echo "Generating HTML report and sending to $recipient..."
179:                 local report_file
180:                 report_file=$(nftban_fhs_generate_html_report)
181:                 if [[ $? -eq 0 && -f "$report_file" ]]; then
182:                     echo "✓ Report generated: $report_file"
183:                     echo "Sending via email..."
184:                     nftban_mail_send "$report_file" "$recipient"
185:                     return $?
186:                 else
187:                     echo "ERROR: Failed to generate HTML report" >&2
188:                     return 1
189:                 fi
190:             fi
191:             ;;
192: 
193:         help|--help|-h)
194:             # Show help
195:             # Load output module for standard banner
196:             source "${LIB_DIR}/core/nftban_output.sh"
197:             nftban_banner
198:             echo ""
199:             echo "Usage:"
200:             echo "  nftban fhs [detailed]            # Show FHS compliance (default)"
201:             echo "  nftban fhs summary               # Show one-line summary"
202:             echo "  nftban fhs json                  # Show JSON output"
203:             echo "  nftban fhs html-report           # Generate HTML report"
204:             echo "  nftban fhs mail-report [path] [recipient]  # Mail report"
205:             echo "  nftban fhs help                  # Show this help"
206:             echo ""
207:             echo "Examples:"
208:             echo "  nftban fhs                       # Show FHS compliance (FHS-style table)"
209:             echo "  nftban fhs summary               # Output: 'FHS: 5 OK, 12 errors, 3 missing'"
210:             echo "  nftban fhs json | jq .           # JSON output for parsing"
211:             echo "  nftban fhs mail-report admin@example.com"
212:             echo "  nftban fhs mail-report /var/lib/nftban/reports/fhs_report.html admin@example.com"
213:             echo ""
214:             echo "Output Columns:"
215:             echo "  DIRECTORY - Directory path"
216:             echo "  EXPECTED  - Expected permissions and ownership"
217:             echo "  ACTUAL    - Actual permissions and ownership"
218:             echo "  STATUS    - Compliance status (OK, ERROR, MISSING)"
219:             echo "  NOTES     - Additional information or issues"
220:             echo ""
221:             echo "Status Values:"
222:             echo "  ✔ OK      - Directory matches expected permissions/ownership"
223:             echo "  ✖ ERROR   - Permissions or ownership mismatch"
224:             echo "  ⚠ MISSING - Directory does not exist"
225:             echo ""
226:             echo "Checked Directories:"
227:             echo "  /usr/lib/nftban          - Application libraries (755 root:root)"
228:             echo "  /etc/nftban              - Configuration files (755 root:root)"
229:             echo "  /var/lib/nftban          - Application state (750 nftban:nftban)"
230:             echo "  /var/log/nftban          - Log files (750 nftban:nftban)"
231:             echo "  /var/cache/nftban        - Cache files (750 nftban:nftban)"
232:             echo "  /run/nftban              - Runtime data (755 nftban:nftban)"
233:             echo "  /usr/share/nftban        - Shared data (755 root:root)"
234:             echo ""
235:             echo "Notes:"
236:             echo "  - No special privileges required (reads permissions only)"
237:             echo "  - Checks against FHS (Filesystem Hierarchy Standard)"
238:             echo "  - Helps ensure proper security posture"
239:             echo ""
240:             return 0
241:             ;;
242: 
243:         *)
244:             echo "ERROR: Unknown fhs command: $subcmd" >&2
245:             echo "Run 'nftban fhs help' for available commands" >&2
246:             return 1
247:             ;;
248:     esac
249: }
250: 
251: # Export function for auto-loading
252: export -f nftban_cmd_fhs
</file>


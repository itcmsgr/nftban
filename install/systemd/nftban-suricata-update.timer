# meta:inventory.privileges="root"
# =============================================================================

[Unit]
Description=NFTBan Suricata Rules Weekly Update Timer
Documentation=man:nftban(8) https://nftban.com/docs
# v1.19.0: Removed Requires= — causes timer to stop when oneshot completes (Task 47)

[Timer]
# Run weekly on Sunday at 03:40 AM (staggered from health@03:00, feeds@03:20)
# COLLISION FIX: Previously all at 03:00, now spread across 40-minute window
# Suricata is heaviest (downloads rules), so placed last in sequence
OnCalendar=Sun *-*-* 03:40:00

# Run 30 minutes after boot if missed (was 5min — increased to avoid boot congestion)
OnBootSec=30min

# JITTER: 30m variance (was 1h - reduced since we're staggered now)
RandomizedDelaySec=30m

# DETERMINISTIC: Same offset per host for predictable behavior
FixedRandomDelay=true

# Persistent: if system was off during scheduled time, run when it comes back
Persistent=true

[Install]
WantedBy=timers.target

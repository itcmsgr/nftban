721: nftban_login_monitor_ssh() {
722:     # Monitor SSH logins via journalctl
723: 
724:     # Get correct SSH service name for this distribution
725:     local ssh_service="sshd"  # Default fallback
726:     local ssh_session_service=""
727:     if declare -f nftban_distro_get_service >/dev/null 2>&1; then
728:         ssh_service=$(nftban_distro_get_service "sshd")
729:         ssh_session_service=$(nftban_distro_get_service "sshd_session")
730:         # If empty, fall back to sshd
731:         ssh_service="${ssh_service:-sshd}"
732:     fi
733: 
734:     # Build journalctl units from distro config
735:     # sshd_session is defined in distro config for systems that use separate session unit
736:     local -a journal_units=("-u" "${ssh_service}")
737:     if [[ -n "${ssh_session_service}" ]]; then
738:         journal_units+=("-u" "${ssh_session_service}")
739:         nftban_login_alert_log "Monitoring SSH services: ${ssh_service}, ${ssh_session_service}"
740:     else
741:         nftban_login_alert_log "Monitoring SSH service: ${ssh_service}"
742:     fi
743: 
744:     journalctl "${journal_units[@]}" -f -n 0 --output=json 2>/dev/null | \
745:     while read -r line; do
746:         # Parse JSON log entry
747:         local message
748:         message=$(echo "$line" | jq -r '.MESSAGE // empty')
749: 
750:         # Successful login
751:         if [[ "$message" =~ ^Accepted\ (password|publickey)\ for\ ([^[:space:]]+)\ from\ ([0-9.]+) ]]; then
752:             local method="${BASH_REMATCH[1]}"
753:             local user="${BASH_REMATCH[2]}"
754:             local ip="${BASH_REMATCH[3]}"
755: 
756:             # Check whitelist
757:             if ! nftban_login_is_whitelisted "$ip"; then
758:                 nftban_login_alert_log "SSH login: $user from $ip (method: $method)"
759:                 nftban_login_send_alert "SSH Login" "$user" "$ip" "SSH" "SUCCESS" "Authentication method: $method"
760:             fi
761:         fi
762: 
763:         # Failed login (existing user)
764:         if [[ "$message" =~ ^Failed\ (password|publickey)\ for\ ([^[:space:]]+)\ from\ ([0-9.]+) ]]; then
765:             local method="${BASH_REMATCH[1]}"
766:             local user="${BASH_REMATCH[2]}"
767:             local ip="${BASH_REMATCH[3]}"
768: 
769:             nftban_login_track_failed "$user" "$ip" "SSH"
770:         fi
771: 
772:         # Invalid user (username enumeration attack)
773:         if [[ "$message" =~ ^Invalid\ user\ ([^[:space:]]+)\ from\ ([0-9.]+) ]]; then
774:             local user="${BASH_REMATCH[1]}"
775:             local ip="${BASH_REMATCH[2]}"
776: 
777:             nftban_login_track_failed "$user" "$ip" "SSH"
778:         fi
779: 
780:         # Failed password for invalid user
781:         if [[ "$message" =~ ^Failed\ password\ for\ invalid\ user\ ([^[:space:]]+)\ from\ ([0-9.]+) ]]; then
782:             local user="${BASH_REMATCH[1]}"
783:             local ip="${BASH_REMATCH[2]}"
784: 
785:             nftban_login_track_failed "$user" "$ip" "SSH"
786:         fi
787: 
788:         # Too many authentication failures (rapid brute-force indicator)
789:         if [[ "$message" =~ ^Received\ disconnect\ from\ ([0-9.]+).*[Tt]oo\ many\ authentication\ failures ]]; then
790:             local ip="${BASH_REMATCH[1]}"
791: 
792:             nftban_login_track_failed "unknown" "$ip" "SSH"
793:         fi
794:     done
795: }
796: 
797: nftban_login_track_failed() {
798:     # Track failed login attempts
799:     local user="$1"
800:     local ip="$2"
801:     local service="$3"
802: 
803:     local key="${user}@${ip}"
804:     local now
805:     now=$(date +%s)
806: 
807:     # Initialize if first attempt
808:     if [[ -z "${NFTBAN_FAILED_ATTEMPTS[$key]:-}" ]]; then
809:         NFTBAN_FAILED_ATTEMPTS[$key]=1
810:         NFTBAN_FAILED_TIMESTAMPS[$key]=$now
811:     else
812:         # Check if within time window
813:         local first_attempt="${NFTBAN_FAILED_TIMESTAMPS[$key]}"
814:         local elapsed
815:         elapsed=$((now - first_attempt))
816: 
817:         if [[ $elapsed -lt $NFTBAN_LOGIN_FAILED_WINDOW ]]; then
818:             # Increment counter
819:             NFTBAN_FAILED_ATTEMPTS[$key]=$((${NFTBAN_FAILED_ATTEMPTS[$key]} + 1))
820: 
821:             # Check threshold
822:             if [[ ${NFTBAN_FAILED_ATTEMPTS[$key]} -ge $NFTBAN_LOGIN_FAILED_THRESHOLD ]]; then
823:                 nftban_login_alert_log "Multiple failed attempts: $user from $ip ($service)"
824: 
825:                 # Send alert
826:                 nftban_login_send_alert "Failed Login Attempts" "$user" "$ip" "$service" "FAILED" \
827:                     "Failed attempts: ${NFTBAN_FAILED_ATTEMPTS[$key]} in ${elapsed} seconds"
828: 
829:                 # BAN THE IP (v1.0 replaces fail2ban)
830:                 nftban_login_alert_log "Banning IP $ip for ${service} brute-force (${NFTBAN_FAILED_ATTEMPTS[$key]} failures)"
831:                 # Use centralized NFTBAN_BIN path (set in /etc/nftban/nftban.conf)
832:                 local nftban_cmd="${NFTBAN_BIN:-/usr/bin/nftban}"
833:                 "$nftban_cmd" ban "$ip" --source login --reason "${service}_brute_force (${NFTBAN_FAILED_ATTEMPTS[$key]} failed attempts)" 2>/dev/null || \
834:                     nftban_login_alert_log "Failed to ban $ip (nftban command not found at $nftban_cmd or error)"
835: 
836:                 # Reset counter
837:                 unset 'NFTBAN_FAILED_ATTEMPTS[$key]'
838:                 unset 'NFTBAN_FAILED_TIMESTAMPS[$key]'
839:             fi
840:         else
841:             # Reset if outside window
842:             NFTBAN_FAILED_ATTEMPTS[$key]=1
843:             NFTBAN_FAILED_TIMESTAMPS[$key]=$now
844:         fi
845:     fi
846: }
847: 
848: nftban_login_monitor_all() {
849:     # Monitor all configured login types
850: 
851:     nftban_login_alert_log "Starting login monitoring (interval: ${NFTBAN_LOGIN_MONITOR_INTERVAL}s)"
852: 
853:     if [[ "$NFTBAN_LOGIN_ALERT_SSH" == "true" ]]; then
854:         nftban_login_monitor_ssh &
855:     fi
856: 
857:     # Wait for all background jobs
858:     wait
859: }
860: 
861: # =============================================================================
862: # TEST FUNCTIONS
863: # =============================================================================

  1: // =============================================================================
  2: // NFTBan UI Auth Daemon - PAM Authentication Service
  3: // =============================================================================
  4: // SPDX-License-Identifier: MPL-2.0
  5: // Purpose: Socket-activated PAM authentication daemon for NFTBan Web GUI
  6: // Usage: Systemd socket-activated, listens on /run/nftban-ui/auth.sock
  7: // Architecture: Root daemon + UNIX socket + direct PAM (no su, no setuid)
  8: // =============================================================================
  9: 
 10: package main
 11: 
 12: import (
 13: 	"bufio"
 14: 	"encoding/json"
 15: 	"fmt"
 16: 	"net"
 17: 	"os"
 18: 	"os/signal"
 19: 	"strings"
 20: 	"syscall"
 21: 	"time"
 22: 
 23: 	pam "github.com/msteinert/pam/v2"
 24: 
 25: 	"github.com/itcmsgr/nftban/internal/authproto"
 26: 	"github.com/itcmsgr/nftban/pkg/auth"
 27: 	"github.com/itcmsgr/nftban/pkg/system"
 28: )
 29: 
 30: const (
 31: 	Version    = "1.0.0"
 32: 	SocketPath = "/run/nftban-ui/auth.sock"
 33: )
 34: 
 35: // Build-time variables (injected by -ldflags)
 36: var (
 37: 	GitCommit = "dev"
 38: 	BuildDate = "unknown"
 39: )
 40: 
 41: // Use shared types from authproto package
 42: type AuthRequest = authproto.AuthRequest
 43: type AuthResponse = authproto.AuthResponse
 44: 
 45: func main() {
 46: 	// Check for version flag
 47: 	if len(os.Args) > 1 && (os.Args[1] == "--version" || os.Args[1] == "-v") {
 48: 		fmt.Printf("nftban-ui-auth v%s (git %s, build %s)\n", Version, GitCommit, BuildDate)
 49: 		os.Exit(0)
 50: 	}
 51: 
 52: 	// Must run as root for PAM authentication
 53: 	if os.Geteuid() != 0 {
 54: 		fmt.Fprintln(os.Stderr, "[AUTH] FATAL: Must run as root for PAM authentication")
 55: 		os.Exit(1)
 56: 	}
 57: 
 58: 	fmt.Fprintf(os.Stderr, "[AUTH] NFTBan UI Auth Daemon v%s starting\n", Version)
 59: 
 60: 	// Create socket directory if needed
 61: 	if err := os.MkdirAll("/run/nftban-ui", 0750); err != nil {
 62: 		fmt.Fprintf(os.Stderr, "[AUTH] Failed to create socket directory: %v\n", err)
 63: 		os.Exit(1)
 64: 	}
 65: 
 66: 	// Clean any stale socket
 67: 	_ = os.Remove(SocketPath)
 68: 
 69: 	// Create Unix socket listener
 70: 	ln, err := net.Listen("unix", SocketPath)
 71: 	if err != nil {
 72: 		fmt.Fprintf(os.Stderr, "[AUTH] Failed to create socket: %v\n", err)
 73: 		os.Exit(1)
 74: 	}
 75: 	defer ln.Close()
 76: 
 77: 	// Set socket permissions (root:nftban 0770)
 78: 	if err := os.Chmod(SocketPath, 0770); err != nil {
 79: 		fmt.Fprintf(os.Stderr, "[AUTH] Warning: Failed to set socket permissions: %v\n", err)
 80: 	}
 81: 
 82: 	// Set socket group ownership to nftban
 83: 	if err := setSocketOwnership(SocketPath); err != nil {
 84: 		fmt.Fprintf(os.Stderr, "[AUTH] Warning: Failed to set socket ownership: %v\n", err)
 85: 	}
 86: 
 87: 	fmt.Fprintf(os.Stderr, "[AUTH] Listening on %s\n", SocketPath)
 88: 
 89: 	// Handle shutdown gracefully
 90: 	sigChan := make(chan os.Signal, 1)
 91: 	signal.Notify(sigChan, syscall.SIGINT, syscall.SIGTERM)
 92: 
 93: 	go func() {
 94: 		<-sigChan
 95: 		fmt.Fprintln(os.Stderr, "[AUTH] Shutting down...")
 96: 		ln.Close()
 97: 		os.Exit(0)
 98: 	}()
 99: 
100: 	// Accept connections
101: 	for {
102: 		_ = ln.(*net.UnixListener).SetDeadline(time.Now().Add(5 * time.Minute))
103: 		conn, err := ln.Accept()
104: 		if err != nil {
105: 			if strings.Contains(err.Error(), "use of closed network connection") {
106: 				break
107: 			}
108: 			// Timeout or transient error, continue
109: 			continue
110: 		}
111: 
112: 		go handleConnection(conn)
113: 	}
114: }
115: 
116: func handleConnection(conn net.Conn) {
117: 	defer conn.Close()
118: 
119: 	// Set per-connection deadline
120: 	_ = conn.SetDeadline(time.Now().Add(10 * time.Second))
121: 
122: 	// Read request
123: 	scanner := bufio.NewScanner(conn)
124: 	if !scanner.Scan() {
125: 		sendError(conn, "Failed to read request")
126: 		return
127: 	}
128: 
129: 	// Parse request
130: 	var req AuthRequest
131: 	if err := json.Unmarshal(scanner.Bytes(), &req); err != nil {
132: 		fmt.Fprintf(os.Stderr, "[AUTH] Invalid JSON request: %v\n", err)
133: 		sendError(conn, "Invalid JSON request")
134: 		return
135: 	}
136: 
137: 	username := strings.TrimSpace(req.Username)
138: 	password := req.Password
139: 
140: 	// Validate username using shared validation
141: 	if !auth.ValidUsernameDefault(username) {
142: 		fmt.Fprintf(os.Stderr, "[AUTH] Invalid username format: %s\n", username)
143: 		sendError(conn, "Invalid username")
144: 		return
145: 	}
146: 
147: 	// Validate password not empty
148: 	if password == "" {
149: 		fmt.Fprintf(os.Stderr, "[AUTH] Empty password for user: %s\n", username)
150: 		sendError(conn, "Password required")
151: 		return
152: 	}
153: 
154: 	// Block root login
155: 	if username == "root" {
156: 		fmt.Fprintln(os.Stderr, "[AUTH] BLOCKED: Root login attempt")
157: 		sendError(conn, "Root login is disabled")
158: 		return
159: 	}
160: 
161: 	// Authenticate via PAM (direct library call, no su)
162: 	if pamAuthenticate(username, password) {
163: 		fmt.Fprintf(os.Stderr, "[AUTH] SUCCESS: User %s authenticated\n", username)
164: 		sendSuccess(conn, "Authentication successful")
165: 	} else {
166: 		fmt.Fprintf(os.Stderr, "[AUTH] FAILED: User %s authentication failed\n", username)
167: 		sendError(conn, "Authentication failed")
168: 	}
169: }
170: 
171: // pamAuthenticate validates credentials using PAM directly
172: // This runs as root, so pam_unix/unix_chkpwd works correctly
173: // Compatible with NoNewPrivileges=true systemd hardening
174: func pamAuthenticate(username, password string) bool {
175: 	// PAM conversation handler - provides password when prompted
176: 	conv := func(s pam.Style, msg string) (string, error) {
177: 		switch s {
178: 		case pam.PromptEchoOff:
179: 			return password, nil
180: 		case pam.PromptEchoOn, pam.ErrorMsg, pam.TextInfo:
181: 			return "", nil
182: 		default:
183: 			return "", nil
184: 		}
185: 	}
186: 
187: 	// Start PAM transaction using "nftban-ui" service
188: 	// This uses /etc/pam.d/nftban-ui configuration
189: 	t, err := pam.StartFunc("nftban-ui", username, conv)
190: 	if err != nil {
191: 		fmt.Fprintf(os.Stderr, "[AUTH] PAM start error for %s: %v\n", username, err)
192: 		return false
193: 	}
194: 
195: 	// Authenticate (verify password)
196: 	if err = t.Authenticate(0); err != nil {
197: 		fmt.Fprintf(os.Stderr, "[AUTH] PAM authenticate failed for %s: %v\n", username, err)
198: 		return false
199: 	}
200: 
201: 	// Account management (check account validity, expiry, etc.)
202: 	if err = t.AcctMgmt(0); err != nil {
203: 		fmt.Fprintf(os.Stderr, "[AUTH] PAM acct_mgmt failed for %s: %v\n", username, err)
204: 		return false
205: 	}
206: 
207: 	return true
208: }
209: 
210: func sendSuccess(conn net.Conn, message string) {
211: 	resp := AuthResponse{
212: 		Success: true,
213: 		Message: message,
214: 	}
215: 	data, _ := json.Marshal(resp)
216: 	conn.Write(append(data, '\n'))
217: }
218: 
219: func sendError(conn net.Conn, message string) {
220: 	resp := AuthResponse{
221: 		Success: false,
222: 		Error:   message,
223: 	}
224: 	data, _ := json.Marshal(resp)
225: 	conn.Write(append(data, '\n'))
226: }
227: 
228: // setSocketOwnership sets socket group to nftban
229: func setSocketOwnership(path string) error {
230: 	// Get nftban group ID using shared lookup function
231: 	gid, err := system.LookupGroupID("nftban")
232: 	if err != nil {
233: 		return fmt.Errorf("nftban group not found: %w", err)
234: 	}
235: 
236: 	// Set ownership (root:nftban)
237: 	return os.Chown(path, 0, gid)
238: }
</file>

<file path="cmd/nftband/main.go">
  1: // =============================================================================
  2: // NFTBan v1.0 - nftband Daemon
  3: // =============================================================================
  4: // SPDX-License-Identifier: MPL-2.0
  5: // Binary: nftband
  6: // Purpose: Single daemon that runs all nftban modules
  7: //
  8: // Architecture:
  9: // - Runs all modules as goroutines
 10: // - Provides event bus for inter-module communication
 11: // - Serves HTTP API for GUI and external access
 12: // - Serves Unix socket for fast CLI communication
 13: // - Handles graceful shutdown with SIGTERM/SIGINT
 14: //
 15: // Usage:
 16: //   nftband              # Run daemon
 17: //   nftband --version    # Show version
 18: //   nftband --help       # Show help
 19: //
 20: // =============================================================================
 21: 
 22: package main
 23: 
 24: import (
 25: 	"context"
 26: 	"encoding/json"
 27: 	"fmt"
 28: 	"log"
 29: 	"net"
 30: 	"net/http"
 31: 	"os"
 32: 	"os/signal"
 33: 	"syscall"
 34: 	"time"
 35: 
 36: 	"github.com/itcmsgr/nftban/pkg/ddos"
 37: 	"github.com/itcmsgr/nftban/pkg/eventbus"
 38: 	"github.com/itcmsgr/nftban/pkg/loginmon"
 39: 	"github.com/itcmsgr/nftban/pkg/module"
 40: 	"github.com/itcmsgr/nftban/pkg/nftbanconf"
 41: 	"github.com/itcmsgr/nftban/pkg/portscan"
 42: )
 43: 
 44: const (
 45: 	Version = "1.0.0"
 46: 
 47: 	// HTTP API
 48: 	HTTPAddr = ":8080"
 49: )
 50: 
 51: // Build-time variables (injected by -ldflags)
 52: var (
 53: 	GitCommit = "dev"
 54: 	BuildDate = "unknown"
 55: )
 56: 
 57: // getDaemonPaths returns paths from central config
 58: // NO FALLBACK - paths must come from /etc/nftban/nftban.conf
 59: func getDaemonPaths() (runDir, configDir, dataDir, logDir string) {
 60: 	cfg := nftbanconf.MustLoad()
 61: 	return cfg.RunDir, cfg.ConfigDir, cfg.DataDir, cfg.LogDir
 62: }
 63: 
 64: // getSocketPath returns socket path from central config
 65: func getSocketPath() string {
 66: 	runDir, _, _, _ := getDaemonPaths()
 67: 	return runDir + "/nftband.sock"
 68: }
 69: 
 70: // getPidFile returns PID file path from central config
 71: func getPidFile() string {
 72: 	runDir, _, _, _ := getDaemonPaths()
 73: 	return runDir + "/nftband.pid"
 74: }
 75: 
 76: // Daemon holds the main daemon state
 77: type Daemon struct {
 78: 	bus       *eventbus.Bus
 79: 	registry  *module.Registry
 80: 	ctx       context.Context
 81: 	cancel    context.CancelFunc
 82: 	socketLn  net.Listener
 83: 	httpSrv   *http.Server
 84: }
 85: 
 86: func main() {
 87: 	// Handle version/help
 88: 	if len(os.Args) > 1 {
 89: 		switch os.Args[1] {
 90: 		case "--version", "-v":
 91: 			fmt.Printf("nftband v%s (git %s, build %s)\n", Version, GitCommit, BuildDate)
 92: 			return
 93: 		case "--help", "-h":
 94: 			printHelp()
 95: 			return
 96: 		}
 97: 	}
 98: 
 99: 	// Create daemon
100: 	d := &Daemon{
101: 		bus:      eventbus.New(),
102: 		registry: module.NewRegistry(),
103: 	}
104: 
105: 	// Run
106: 	if err := d.Run(); err != nil {
107: 		log.Fatalf("Daemon error: %v", err)
108: 	}
109: }
110: 
111: func printHelp() {
112: 	fmt.Println("nftband - NFTBan Daemon")
113: 	fmt.Println()
114: 	fmt.Println("Usage:")
115: 	fmt.Println("  nftband              Run the daemon")
116: 	fmt.Println("  nftband --version    Show version")
117: 	fmt.Println("  nftband --help       Show this help")
118: 	fmt.Println()
119: 	fmt.Println("The daemon:")
120: 	fmt.Println("  - Runs all nftban modules as goroutines")
121: 	fmt.Println("  - Provides HTTP API on", HTTPAddr)
122: 	fmt.Println("  - Provides Unix socket at", getSocketPath())
123: 	fmt.Println("  - Handles graceful shutdown on SIGTERM/SIGINT")
124: 	fmt.Println()
125: }
126: 
127: // Run starts the daemon and blocks until shutdown
128: func (d *Daemon) Run() error {
129: 	log.Printf("nftband v%s starting...", Version)
130: 
131: 	// Create context for lifecycle management
132: 	d.ctx, d.cancel = context.WithCancel(context.Background())
133: 	defer d.cancel()
134: 
135: 	// Ensure directories exist
136: 	if err := d.ensureDirectories(); err != nil {
137: 		return fmt.Errorf("failed to create directories: %w", err)
138: 	}
139: 
140: 	// Write PID file
141: 	if err := d.writePidFile(); err != nil {
142: 		return fmt.Errorf("failed to write PID file: %w", err)
143: 	}
144: 	defer os.Remove(getPidFile())
145: 
146: 	// Register modules
147: 	d.registerModules()
148: 
149: 	// Initialize all modules with event bus
150: 	log.Println("Initializing modules...")
151: 	if err := d.registry.InitAll(d.bus); err != nil {
152: 		return fmt.Errorf("failed to initialize modules: %w", err)
153: 	}
154: 
155: 	// Subscribe event bus logger
156: 	d.bus.SubscribeAll(func(e eventbus.Event) {
157: 		log.Printf("[EVENT] %s: %s ip=%s user=%s msg=%s",
158: 			e.Type, e.Source, e.IP, e.User, e.Message)
159: 	})
160: 
161: 	// Start Unix socket
162: 	log.Println("Starting Unix socket...")
163: 	if err := d.startSocket(); err != nil {
164: 		return fmt.Errorf("failed to start socket: %w", err)
165: 	}
166: 	defer d.socketLn.Close()
167: 
168: 	// Start HTTP server
169: 	log.Println("Starting HTTP API...")
170: 	if err := d.startHTTP(); err != nil {
171: 		return fmt.Errorf("failed to start HTTP: %w", err)
172: 	}
173: 
174: 	// Start all modules
175: 	log.Println("Starting modules...")
176: 	if err := d.registry.StartAll(d.ctx); err != nil {
177: 		return fmt.Errorf("failed to start modules: %w", err)
178: 	}
179: 
180: 	// Publish startup event
181: 	d.bus.Publish(eventbus.NewEvent(eventbus.EventModuleStart, "nftband").
182: 		WithMessage("NFTBan daemon started").
183: 		WithSeverity(eventbus.SeverityInfo))
184: 
185: 	log.Printf("nftband ready - HTTP %s, Socket %s", HTTPAddr, getSocketPath())
186: 
187: 	// Wait for shutdown signal
188: 	d.waitForShutdown()
189: 
190: 	return nil
191: }
192: 
193: // ensureDirectories creates required directories
194: func (d *Daemon) ensureDirectories() error {
195: 	runDir, configDir, dataDir, logDir := getDaemonPaths()
196: 	dirs := []string{
197: 		runDir,
198: 		configDir,
199: 		dataDir,
200: 		logDir,
201: 	}
202: 
203: 	for _, dir := range dirs {
204: 		if err := os.MkdirAll(dir, 0755); err != nil {
205: 			return fmt.Errorf("mkdir %s: %w", dir, err)
206: 		}
207: 	}
208: 
209: 	return nil
210: }
211: 
212: // writePidFile writes the daemon PID
213: func (d *Daemon) writePidFile() error {
214: 	return os.WriteFile(getPidFile(), []byte(fmt.Sprintf("%d\n", os.Getpid())), 0644)
215: }
216: 
217: // registerModules registers all nftban modules
218: func (d *Daemon) registerModules() {
219: 	// Register DDoS protection module
220: 	d.registry.Register(ddos.New(), ddos.Descriptor())
221: 
222: 	// Register Portscan detection module
223: 	d.registry.Register(portscan.New(), portscan.Descriptor())
224: 
225: 	// Register Login Monitor module (pure Go - replaces fail2ban)
226: 	d.registry.Register(loginmon.New(), loginmon.Descriptor())
227: 
228: 	// TODO: Register more modules as they are implemented
229: 	// d.registry.Register(suricata.NewWatcher(), suricata.Descriptor())
230: 
231: 	log.Printf("Registered %d modules", len(d.registry.All()))
232: }
233: 
234: // startSocket starts the Unix socket listener
235: func (d *Daemon) startSocket() error {
236: 	socketPath := getSocketPath()
237: 
238: 	// Remove stale socket
239: 	os.Remove(socketPath)
240: 
241: 	ln, err := net.Listen("unix", socketPath)
242: 	if err != nil {
243: 		return err
244: 	}
245: 	d.socketLn = ln
246: 
247: 	// Set permissions
248: 	os.Chmod(socketPath, 0660)
249: 
250: 	// Handle connections
251: 	go d.acceptSocketConnections()
252: 
253: 	return nil
254: }
255: 
256: // acceptSocketConnections handles incoming socket connections
257: func (d *Daemon) acceptSocketConnections() {
258: 	for {
259: 		conn, err := d.socketLn.Accept()
260: 		if err != nil {
261: 			// Check if we're shutting down
262: 			select {
263: 			case <-d.ctx.Done():
264: 				return
265: 			default:
266: 				log.Printf("Socket accept error: %v", err)
267: 				continue
268: 			}
269: 		}
270: 
271: 		go d.handleSocketConnection(conn)
272: 	}
273: }
274: 
275: // SocketRequest is the format for CLI→daemon requests
276: type SocketRequest struct {
277: 	Method string         `json:"method"`
278: 	Params map[string]any `json:"params"`
279: }
280: 
281: // SocketResponse is the format for daemon→CLI responses
282: type SocketResponse struct {
283: 	Success bool   `json:"success"`
284: 	Data    any    `json:"data,omitempty"`
285: 	Error   string `json:"error,omitempty"`
286: }
287: 
288: // handleSocketConnection processes a single socket connection
289: func (d *Daemon) handleSocketConnection(conn net.Conn) {
290: 	defer conn.Close()
291: 
292: 	// Set timeout
293: 	conn.SetDeadline(time.Now().Add(30 * time.Second))
294: 
295: 	// Read request
296: 	decoder := json.NewDecoder(conn)
297: 	var req SocketRequest
298: 	if err := decoder.Decode(&req); err != nil {
299: 		d.writeSocketResponse(conn, SocketResponse{
300: 			Success: false,
301: 			Error:   "invalid request: " + err.Error(),
302: 		})
303: 		return
304: 	}
305: 
306: 	// Handle request
307: 	resp := d.handleSocketRequest(req)
308: 	d.writeSocketResponse(conn, resp)
309: }
310: 
311: // writeSocketResponse sends a response to the socket
312: func (d *Daemon) writeSocketResponse(conn net.Conn, resp SocketResponse) {
313: 	encoder := json.NewEncoder(conn)
314: 	encoder.Encode(resp)
315: }
316: 
317: // handleSocketRequest processes a socket request
318: func (d *Daemon) handleSocketRequest(req SocketRequest) SocketResponse {
319: 	switch req.Method {
320: 	case "status":
321: 		return d.handleStatusRequest()
322: 	case "modules":
323: 		return d.handleModulesRequest()
324: 	case "ban":
325: 		return d.handleBanRequest(req.Params)
326: 	case "unban":
327: 		return d.handleUnbanRequest(req.Params)
328: 	case "ping":
329: 		return SocketResponse{Success: true, Data: "pong"}
330: 	default:
331: 		return SocketResponse{
332: 			Success: false,
333: 			Error:   "unknown method: " + req.Method,
334: 		}
335: 	}
336: }
337: 
338: // handleStatusRequest returns daemon status
339: func (d *Daemon) handleStatusRequest() SocketResponse {
340: 	stats := d.bus.Stats()
341: 	return SocketResponse{
342: 		Success: true,
343: 		Data: map[string]any{
344: 			"version":       Version,
345: 			"uptime":        "TODO",
346: 			"modules":       len(d.registry.All()),
347: 			"events_total":  stats.Published,
348: 			"subscriptions": stats.Subscriptions,
349: 		},
350: 	}
351: }
352: 
353: // handleModulesRequest returns module statuses
354: func (d *Daemon) handleModulesRequest() SocketResponse {
355: 	statuses := d.registry.StatusAll()
356: 	return SocketResponse{
357: 		Success: true,
358: 		Data:    statuses,
359: 	}
360: }
361: 
362: // handleBanRequest bans an IP
363: func (d *Daemon) handleBanRequest(params map[string]any) SocketResponse {
364: 	ip, ok := params["ip"].(string)
365: 	if !ok || ip == "" {
366: 		return SocketResponse{Success: false, Error: "missing ip parameter"}
367: 	}
368: 
369: 	// Publish ban event
370: 	d.bus.Publish(eventbus.NewEvent(eventbus.EventBan, "cli").
371: 		WithIP(ip).
372: 		WithMessage("Manual ban via CLI").
373: 		WithSeverity(eventbus.SeverityInfo))
374: 
375: 	// TODO: Actually perform the ban via NFT manager
376: 
377: 	return SocketResponse{
378: 		Success: true,
379: 		Data: map[string]any{
380: 			"ip":     ip,
381: 			"status": "banned",
382: 		},
383: 	}
384: }
385: 
386: // handleUnbanRequest unbans an IP
387: func (d *Daemon) handleUnbanRequest(params map[string]any) SocketResponse {
388: 	ip, ok := params["ip"].(string)
389: 	if !ok || ip == "" {
390: 		return SocketResponse{Success: false, Error: "missing ip parameter"}
391: 	}
392: 
393: 	// Publish unban event
394: 	d.bus.Publish(eventbus.NewEvent(eventbus.EventUnban, "cli").
395: 		WithIP(ip).
396: 		WithMessage("Manual unban via CLI").
397: 		WithSeverity(eventbus.SeverityInfo))
398: 
399: 	// TODO: Actually perform the unban via NFT manager
400: 
401: 	return SocketResponse{
402: 		Success: true,
403: 		Data: map[string]any{
404: 			"ip":     ip,
405: 			"status": "unbanned",
406: 		},
407: 	}
408: }
409: 
410: // startHTTP starts the HTTP API server
411: func (d *Daemon) startHTTP() error {
412: 	mux := http.NewServeMux()
413: 
414: 	// Health check
415: 	mux.HandleFunc("/health", func(w http.ResponseWriter, r *http.Request) {
416: 		json.NewEncoder(w).Encode(map[string]any{
417: 			"status":  "ok",
418: 			"version": Version,
419: 		})
420: 	})
421: 
422: 	// Status endpoint
423: 	mux.HandleFunc("/api/v1/status", func(w http.ResponseWriter, r *http.Request) {
424: 		stats := d.bus.Stats()
425: 		json.NewEncoder(w).Encode(map[string]any{
426: 			"success": true,
427: 			"data": map[string]any{
428: 				"version":      Version,
429: 				"modules":      len(d.registry.All()),
430: 				"events_total": stats.Published,
431: 			},
432: 		})
433: 	})
434: 
435: 	// Modules endpoint
436: 	mux.HandleFunc("/api/v1/modules", func(w http.ResponseWriter, r *http.Request) {
437: 		statuses := d.registry.StatusAll()
438: 		json.NewEncoder(w).Encode(map[string]any{
439: 			"success": true,
440: 			"data":    statuses,
441: 		})
442: 	})
443: 
444: 	// TODO: Mount existing pkg/api handlers here
445: 	// mux.Handle("/api/v1/", api.NewRouter())
446: 
447: 	d.httpSrv = &http.Server{
448: 		Addr:    HTTPAddr,
449: 		Handler: mux,
450: 	}
451: 
452: 	go func() {
453: 		if err := d.httpSrv.ListenAndServe(); err != http.ErrServerClosed {
454: 			log.Printf("HTTP server error: %v", err)
455: 		}
456: 	}()
457: 
458: 	return nil
459: }
460: 
461: // waitForShutdown blocks until SIGTERM/SIGINT
462: func (d *Daemon) waitForShutdown() {
463: 	sigCh := make(chan os.Signal, 1)
464: 	signal.Notify(sigCh, syscall.SIGTERM, syscall.SIGINT)
465: 
466: 	sig := <-sigCh
467: 	log.Printf("Received %v, shutting down...", sig)
468: 
469: 	// Publish shutdown event
470: 	d.bus.Publish(eventbus.NewEvent(eventbus.EventModuleStop, "nftband").
471: 		WithMessage("NFTBan daemon shutting down").
472: 		WithSeverity(eventbus.SeverityInfo))
473: 
474: 	// Shutdown HTTP server
475: 	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
476: 	defer cancel()
477: 	if err := d.httpSrv.Shutdown(ctx); err != nil {
478: 		log.Printf("HTTP shutdown error: %v", err)
479: 	}
480: 
481: 	// Stop all modules
482: 	if err := d.registry.StopAll(); err != nil {
483: 		log.Printf("Module stop error: %v", err)
484: 	}
485: 
486: 	// Close event bus
487: 	d.bus.Close()
488: 
489: 	// Cancel context
490: 	d.cancel()
491: 
492: 	log.Println("nftband stopped")
493: }
</file>


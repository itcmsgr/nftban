  1: // =============================================================================
  2: // NFTBan v1.0 - Event Bus
  3: // =============================================================================
  4: // SPDX-License-Identifier: MPL-2.0
  5: // Package: eventbus
  6: // Purpose: Central event distribution for inter-module communication
  7: //
  8: // Architecture:
  9: // - All modules publish events to the bus
 10: // - Subscribers receive events asynchronously
 11: // - Supports type-specific and wildcard subscriptions
 12: // - Thread-safe for concurrent access
 13: //
 14: // Usage:
 15: //
 16: //	bus := eventbus.New()
 17: //	bus.Subscribe(eventbus.EventBan, func(e eventbus.Event) {
 18: //	    log.Printf("IP %s was banned: %s", e.IP, e.Message)
 19: //	})
 20: //	bus.Publish(eventbus.Event{Type: eventbus.EventBan, IP: "1.2.3.4"})
 21: //
 22: // =============================================================================
 23: 
 24: package eventbus
 25: 
 26: import (
 27: 	"crypto/rand"
 28: 	"encoding/hex"
 29: 	"sync"
 30: 	"time"
 31: )
 32: 
 33: // EventType categorizes events for routing
 34: type EventType string
 35: 
 36: const (
 37: 	// Ban/Unban events
 38: 	EventBan   EventType = "ban"
 39: 	EventUnban EventType = "unban"
 40: 
 41: 	// Login events
 42: 	EventLoginFail    EventType = "login_fail"
 43: 	EventLoginFailed  EventType = "login_failed"  // Alias for consistency
 44: 	EventLoginSuccess EventType = "login_success"
 45: 	EventLoginAlert   EventType = "login_alert"
 46: 
 47: 	// Security detection events
 48: 	EventSuricataAlert EventType = "suricata_alert"
 49: 	EventDDoSDetected  EventType = "ddos_detected"
 50: 	EventPortscan      EventType = "portscan_detected"
 51: 
 52: 	// Feed events
 53: 	EventFeedSync   EventType = "feed_sync"
 54: 	EventFeedUpdate EventType = "feed_update"
 55: 
 56: 	// System events
 57: 	EventHealthCheck EventType = "health_check"
 58: 	EventModuleStart EventType = "module_start"
 59: 	EventModuleStop  EventType = "module_stop"
 60: 	EventError       EventType = "error"
 61: 
 62: 	// GeoIP events
 63: 	EventGeoIPUpdate EventType = "geoip_update"
 64: 	EventCountryBan  EventType = "country_ban"
 65: )
 66: 
 67: // Severity levels for events
 68: type Severity int
 69: 
 70: const (
 71: 	SeverityDebug Severity = iota
 72: 	SeverityInfo
 73: 	SeverityWarning
 74: 	SeverityCritical
 75: )
 76: 
 77: // String returns human-readable severity
 78: func (s Severity) String() string {
 79: 	switch s {
 80: 	case SeverityDebug:
 81: 		return "DEBUG"
 82: 	case SeverityInfo:
 83: 		return "INFO"
 84: 	case SeverityWarning:
 85: 		return "WARNING"
 86: 	case SeverityCritical:
 87: 		return "CRITICAL"
 88: 	default:
 89: 		return "UNKNOWN"
 90: 	}
 91: }
 92: 
 93: // Event is the universal event structure passed between modules
 94: type Event struct {
 95: 	ID        string         `json:"id"`        // Unique event ID
 96: 	Type      EventType      `json:"type"`      // Event type for routing
 97: 	Severity  Severity       `json:"severity"`  // Severity level
 98: 	Timestamp time.Time      `json:"timestamp"` // When event occurred
 99: 	Source    string         `json:"source"`    // Module that generated event
100: 	IP        string         `json:"ip"`        // Related IP address (if any)
101: 	User      string         `json:"user"`      // Related username (if any)
102: 	Message   string         `json:"message"`   // Human-readable message
103: 	Data      map[string]any `json:"data"`      // Additional structured data
104: }
105: 
106: // NewEvent creates a new event with auto-generated ID and timestamp
107: func NewEvent(eventType EventType, source string) Event {
108: 	return Event{
109: 		ID:        generateID(),
110: 		Type:      eventType,
111: 		Severity:  SeverityInfo,
112: 		Timestamp: time.Now(),
113: 		Source:    source,
114: 		Data:      make(map[string]any),
115: 	}
116: }
117: 
118: // WithIP sets the IP field
119: func (e Event) WithIP(ip string) Event {
120: 	e.IP = ip
121: 	return e
122: }
123: 
124: // WithUser sets the User field
125: func (e Event) WithUser(user string) Event {
126: 	e.User = user
127: 	return e
128: }
129: 
130: // WithMessage sets the Message field
131: func (e Event) WithMessage(msg string) Event {
132: 	e.Message = msg
133: 	return e
134: }
135: 
136: // WithSeverity sets the Severity field
137: func (e Event) WithSeverity(sev Severity) Event {
138: 	e.Severity = sev
139: 	return e
140: }
141: 
142: // WithData adds a key-value pair to Data
143: func (e Event) WithData(key string, value any) Event {
144: 	if e.Data == nil {
145: 		e.Data = make(map[string]any)
146: 	}
147: 	e.Data[key] = value
148: 	return e
149: }
150: 
151: // Handler is a function that receives events
152: type Handler func(Event)
153: 
154: // Subscription represents a registered handler
155: type Subscription struct {
156: 	id        string
157: 	eventType EventType // Empty string means all events
158: 	handler   Handler
159: }
160: 
161: // Bus is the central event distributor
162: type Bus struct {
163: 	subscriptions []Subscription
164: 	mu            sync.RWMutex
165: 	closed        bool
166: 
167: 	// Metrics
168: 	published   int64
169: 	delivered   int64
170: 	errors      int64
171: 	metricsMu   sync.Mutex
172: }
173: 
174: // New creates a new event bus
175: func New() *Bus {
176: 	return &Bus{
177: 		subscriptions: make([]Subscription, 0),
178: 	}
179: }
180: 
181: // Subscribe registers a handler for a specific event type
182: // Returns a subscription ID that can be used to unsubscribe
183: func (b *Bus) Subscribe(eventType EventType, handler Handler) string {
184: 	b.mu.Lock()
185: 	defer b.mu.Unlock()
186: 
187: 	id := generateID()
188: 	b.subscriptions = append(b.subscriptions, Subscription{
189: 		id:        id,
190: 		eventType: eventType,
191: 		handler:   handler,
192: 	})
193: 
194: 	return id
195: }
196: 
197: // SubscribeAll registers a handler for ALL events
198: // Useful for logging, metrics, GUI updates
199: func (b *Bus) SubscribeAll(handler Handler) string {
200: 	b.mu.Lock()
201: 	defer b.mu.Unlock()
202: 
203: 	id := generateID()
204: 	b.subscriptions = append(b.subscriptions, Subscription{
205: 		id:        id,
206: 		eventType: "", // Empty means all
207: 		handler:   handler,
208: 	})
209: 
210: 	return id
211: }
212: 
213: // SubscribeMultiple registers a handler for multiple event types
214: func (b *Bus) SubscribeMultiple(eventTypes []EventType, handler Handler) []string {
215: 	ids := make([]string, len(eventTypes))
216: 	for i, et := range eventTypes {
217: 		ids[i] = b.Subscribe(et, handler)
218: 	}
219: 	return ids
220: }
221: 
222: // Unsubscribe removes a subscription by ID
223: func (b *Bus) Unsubscribe(id string) bool {
224: 	b.mu.Lock()
225: 	defer b.mu.Unlock()
226: 
227: 	for i, sub := range b.subscriptions {
228: 		if sub.id == id {
229: 			// Remove by swapping with last and truncating
230: 			b.subscriptions[i] = b.subscriptions[len(b.subscriptions)-1]
231: 			b.subscriptions = b.subscriptions[:len(b.subscriptions)-1]
232: 			return true
233: 		}
234: 	}
235: 	return false
236: }
237: 
238: // Publish sends an event to all matching subscribers
239: // Handlers are called asynchronously in goroutines
240: func (b *Bus) Publish(e Event) {
241: 	b.mu.RLock()
242: 	if b.closed {
243: 		b.mu.RUnlock()
244: 		return
245: 	}
246: 
247: 	// Ensure event has ID and timestamp
248: 	if e.ID == "" {
249: 		e.ID = generateID()
250: 	}
251: 	if e.Timestamp.IsZero() {
252: 		e.Timestamp = time.Now()
253: 	}
254: 
255: 	// Copy subscriptions to avoid holding lock during handler execution
256: 	subs := make([]Subscription, len(b.subscriptions))
257: 	copy(subs, b.subscriptions)
258: 	b.mu.RUnlock()
259: 
260: 	b.metricsMu.Lock()
261: 	b.published++
262: 	b.metricsMu.Unlock()
263: 
264: 	// Dispatch to matching handlers
265: 	for _, sub := range subs {
266: 		if sub.eventType == "" || sub.eventType == e.Type {
267: 			b.metricsMu.Lock()
268: 			b.delivered++
269: 			b.metricsMu.Unlock()
270: 
271: 			// Call handler in goroutine for async delivery
272: 			go func(h Handler, ev Event) {
273: 				defer func() {
274: 					if r := recover(); r != nil {
275: 						b.metricsMu.Lock()
276: 						b.errors++
277: 						b.metricsMu.Unlock()
278: 					}
279: 				}()
280: 				h(ev)
281: 			}(sub.handler, e)
282: 		}
283: 	}
284: }
285: 
286: // PublishSync sends an event and waits for all handlers to complete
287: // Use sparingly - blocks the caller
288: func (b *Bus) PublishSync(e Event) {
289: 	b.mu.RLock()
290: 	if b.closed {
291: 		b.mu.RUnlock()
292: 		return
293: 	}
294: 
295: 	if e.ID == "" {
296: 		e.ID = generateID()
297: 	}
298: 	if e.Timestamp.IsZero() {
299: 		e.Timestamp = time.Now()
300: 	}
301: 
302: 	subs := make([]Subscription, len(b.subscriptions))
303: 	copy(subs, b.subscriptions)
304: 	b.mu.RUnlock()
305: 
306: 	b.metricsMu.Lock()
307: 	b.published++
308: 	b.metricsMu.Unlock()
309: 
310: 	var wg sync.WaitGroup
311: 	for _, sub := range subs {
312: 		if sub.eventType == "" || sub.eventType == e.Type {
313: 			b.metricsMu.Lock()
314: 			b.delivered++
315: 			b.metricsMu.Unlock()
316: 
317: 			wg.Add(1)
318: 			go func(h Handler, ev Event) {
319: 				defer wg.Done()
320: 				defer func() {
321: 					if r := recover(); r != nil {
322: 						b.metricsMu.Lock()
323: 						b.errors++
324: 						b.metricsMu.Unlock()
325: 					}
326: 				}()
327: 				h(ev)
328: 			}(sub.handler, e)
329: 		}
330: 	}
331: 	wg.Wait()
332: }
333: 
334: // Close stops the bus from accepting new events
335: func (b *Bus) Close() {
336: 	b.mu.Lock()
337: 	defer b.mu.Unlock()
338: 	b.closed = true
339: }
340: 
341: // Stats returns bus statistics
342: type Stats struct {
343: 	Subscriptions int   `json:"subscriptions"`
344: 	Published     int64 `json:"published"`
345: 	Delivered     int64 `json:"delivered"`
346: 	Errors        int64 `json:"errors"`
347: }
348: 
349: // Stats returns current bus statistics
350: func (b *Bus) Stats() Stats {
351: 	b.mu.RLock()
352: 	subCount := len(b.subscriptions)
353: 	b.mu.RUnlock()
354: 
355: 	b.metricsMu.Lock()
356: 	defer b.metricsMu.Unlock()
357: 
358: 	return Stats{
359: 		Subscriptions: subCount,
360: 		Published:     b.published,
361: 		Delivered:     b.delivered,
362: 		Errors:        b.errors,
363: 	}
364: }
365: 
366: // generateID creates a random 8-byte hex ID
367: func generateID() string {
368: 	b := make([]byte, 8)
369: 	rand.Read(b)
370: 	return hex.EncodeToString(b)
371: }
</file>

<file path="pkg/loginmon/types.go">
  1: // =============================================================================
  2: // NFTBan v1.0 - Login Monitor Types
  3: // =============================================================================
  4: // SPDX-License-Identifier: MPL-2.0
  5: // Package: loginmon
  6: // Purpose: Smart login monitoring with risk-based scoring (replaces fail2ban)
  7: //
  8: // Architecture:
  9: // - Monitors successful logins (failures added later)
 10: // - Uses GeoIP + reputation feeds + behavioral analysis
 11: // - Detects: new IPs, country changes, bad ASN, credential stuffing
 12: // - Integrates with Suricata + SSH parser + nftban brain
 13: //
 14: // This is what fail2ban CANNOT do: multi-source correlation with risk scoring
 15: // =============================================================================
 16: 
 17: package loginmon
 18: 
 19: import (
 20: 	"sync"
 21: 	"time"
 22: )
 23: 
 24: // LoginEvent represents a single login attempt (success or failure)
 25: type LoginEvent struct {
 26: 	User      string            // Username that logged in
 27: 	IP        string            // Source IP address
 28: 	Time      time.Time         // When the login occurred
 29: 	Service   string            // Service name (ssh, directadmin, webmail, panel, etc.)
 30: 	Success   bool              // true = successful login, false = failed attempt
 31: 	Method    string            // Auth method (password, publickey, session, etc.)
 32: 	Extra     map[string]string // Additional metadata (port, protocol, etc.)
 33: 	Timestamp int64             // Unix timestamp for correlation
 34: }
 35: 
 36: // LoginProfile tracks historical behavior for a single user
 37: type LoginProfile struct {
 38: 	User          string               // Username
 39: 	LastIP        string               // Last IP this user logged in from
 40: 	LastCountry   string               // Last country (from GeoIP)
 41: 	LastASN       string               // Last ASN (ISP/provider)
 42: 	LastLoginTime time.Time            // Last successful login timestamp
 43: 	KnownIPs      map[string]time.Time // All IPs this user has logged in from (IP -> last seen)
 44: 	FailedLogins  int                  // Count of recent failed attempts
 45: 	TotalLogins   int                  // Total successful logins
 46: 	FirstSeen     time.Time            // When we first saw this user
 47: }
 48: 
 49: // IPProfile tracks login activity from a single IP
 50: type IPProfile struct {
 51: 	IP            string               // IP address
 52: 	Users         map[string]time.Time // All users that logged in from this IP (user -> last seen)
 53: 	FailedLogins  int                  // Count of recent failed attempts from this IP
 54: 	TotalLogins   int                  // Total successful logins from this IP
 55: 	LastCountry   string               // Last known country for this IP
 56: 	LastASN       string               // Last known ASN for this IP
 57: 	FirstSeen     time.Time            // When we first saw this IP
 58: 	LastActivity  time.Time            // Last login attempt (success or fail)
 59: }
 60: 
 61: // LoginState maintains in-memory state for all users and IPs
 62: type LoginState struct {
 63: 	Users map[string]*LoginProfile // User -> profile
 64: 	IPs   map[string]*IPProfile    // IP -> profile
 65: 	_     sync.RWMutex             // Reserved for future concurrent access protection
 66: }
 67: 
 68: // GeoInfo contains geographic/network information for an IP
 69: type GeoInfo struct {
 70: 	Country     string // ISO country code (e.g., "US", "CN", "RU")
 71: 	CountryName string // Human-readable country name
 72: 	City        string // City name (optional)
 73: 	ASN         string // Autonomous System Number (ISP identifier)
 74: 	ASNOrg      string // Organization name for the ASN
 75: 	IsProxy     bool   // Known proxy/VPN/Tor exit node
 76: 	IsTor       bool   // Known Tor exit node
 77: 	IsHosting   bool   // Hosting provider (often used for bots)
 78: }
 79: 
 80: // ReputationInfo contains threat intelligence for an IP
 81: type ReputationInfo struct {
 82: 	BadFeeds      int       // Number of threat feeds containing this IP
 83: 	SuricataHits  int       // Number of Suricata alerts for this IP
 84: 	NFTBanHistory int       // Number of times previously banned by NFTBan
 85: 	LastBanTime   time.Time // When this IP was last banned
 86: 	BanReason     string    // Reason for last ban (ssh_brute, web_exploit, etc.)
 87: 	IsWhitelisted bool      // Is this IP in the whitelist?
 88: }
 89: 
 90: // RiskScore represents the computed risk level for a login event
 91: type RiskScore struct {
 92: 	Score       float64           // Overall risk score (0.0 = safe, 1.0 = maximum risk)
 93: 	Factors     map[string]float64 // Individual risk factors and their contributions
 94: 	Reason      string            // Human-readable explanation
 95: 	Recommended string            // Recommended action (allow, alert, block_short, block_long, block_permanent)
 96: }
 97: 
 98: // Action represents a decision made by the login monitor
 99: type Action struct {
100: 	Type     string        // Action type: "allow", "alert_only", "block_short", "block_long", "block_permanent"
101: 	IP       string        // IP to act on
102: 	Duration time.Duration // Ban duration (0 = permanent)
103: 	Reason   string        // Why this action was taken
104: 	Risk     float64       // Risk score that triggered this action
105: 	Event    *LoginEvent   // The login event that caused this action
106: }
107: 
108: // Config contains configuration for the login monitor
109: type Config struct {
110: 	// Module control
111: 	Enabled bool // Whether the module is enabled (default: true)
112: 
113: 	// Risk thresholds
114: 	BlockHighRisk   float64 // Block if risk >= this (default: 0.8)
115: 	BlockMediumRisk float64 // Block if risk >= this (default: 0.6)
116: 	AlertRisk       float64 // Alert if risk >= this (default: 0.4)
117: 
118: 	// Ban durations
119: 	HighRiskDuration   time.Duration // Ban duration for high risk (default: 24h)
120: 	MediumRiskDuration time.Duration // Ban duration for medium risk (default: 1h)
121: 	LowRiskDuration    time.Duration // Ban duration for low risk (default: 10m)
122: 
123: 	// Behavioral analysis
124: 	NewIPWeight       float64 // Risk weight for new IP (default: 0.3)
125: 	NewCountryWeight  float64 // Risk weight for new country (default: 0.3)
126: 	BadReputationWeight float64 // Risk weight for bad reputation (default: 0.4)
127: 	MultipleUsersWeight float64 // Risk weight for multiple users from same IP (default: 0.2)
128: 
129: 	// Time windows
130: 	FailureWindow     time.Duration // Window to count failed attempts (default: 10m)
131: 	ProfileRetention  time.Duration // How long to keep user profiles (default: 30d)
132: 
133: 	// Thresholds
134: 	MaxFailedAttempts int // Max failed attempts before blocking (default: 5)
135: 	MaxUsersPerIP     int // Max different users from same IP before suspicious (default: 3)
136: }
137: 
138: // NewLoginState creates a new login monitor state
139: func NewLoginState() *LoginState {
140: 	return &LoginState{
141: 		Users: make(map[string]*LoginProfile),
142: 		IPs:   make(map[string]*IPProfile),
143: 	}
144: }
145: 
146: // DefaultConfig returns default configuration
147: func DefaultConfig() *Config {
148: 	return &Config{
149: 		BlockHighRisk:       0.8,
150: 		BlockMediumRisk:     0.6,
151: 		AlertRisk:           0.4,
152: 		HighRiskDuration:    24 * time.Hour,
153: 		MediumRiskDuration:  1 * time.Hour,
154: 		LowRiskDuration:     10 * time.Minute,
155: 		NewIPWeight:         0.3,
156: 		NewCountryWeight:    0.3,
157: 		BadReputationWeight: 0.4,
158: 		MultipleUsersWeight: 0.2,
159: 		FailureWindow:       10 * time.Minute,
160: 		ProfileRetention:    30 * 24 * time.Hour,
161: 		MaxFailedAttempts:   5,
162: 		MaxUsersPerIP:       3,
163: 	}
164: }
</file>


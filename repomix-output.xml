 421: cmd_suricata_rules() {
 422:     local action="${1:-help}"
 423: 
 424:     case "$action" in
 425:         update)
 426:             _check_root "rules update" || return 1
 427: 
 428:             echo ""
 429:             echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
 430:             echo "  🛡️  Updating Suricata Rules"
 431:             echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
 432:             echo ""
 433: 
 434:             if ! command -v suricata-update &>/dev/null; then
 435:                 echo "✗ suricata-update not installed"
 436:                 echo ""
 437:                 echo "Install:"
 438:                 echo "  pip3 install --upgrade suricata-update"
 439:                 return 1
 440:             fi
 441: 
 442:             echo "  → Downloading latest rules from ET/Open..."
 443:             suricata-update || {
 444:                 echo "  ✗ Rule update failed"
 445:                 return 1
 446:             }
 447: 
 448:             echo ""
 449:             echo "  → Restarting Suricata to load new rules..."
 450:             systemctl restart "$SURICATA_SERVICE" || {
 451:                 echo "  ✗ Failed to restart Suricata"
 452:                 return 1
 453:             }
 454: 
 455:             sleep 2
 456:             if _suricata_is_running; then
 457:                 echo "  ✓ Suricata restarted successfully"
 458:             else
 459:                 echo "  ✗ Suricata failed to restart"
 460:                 return 1
 461:             fi
 462: 
 463:             echo ""
 464:             echo "✅ Rules updated successfully"
 465:             echo ""
 466:             ;;
 467: 
 468:         list)
 469:             echo ""
 470:             echo "Suricata Rule Files:"
 471:             if [[ -d /var/lib/suricata/rules ]]; then
 472:                 ls -lh /var/lib/suricata/rules/*.rules 2>/dev/null || echo "No rule files found"
 473:             else
 474:                 echo "Rules directory not found"
 475:             fi
 476:             echo ""
 477:             ;;
 478: 
 479:         generate)
 480:             _check_root "rules generate" || return 1
 481: 
 482:             echo ""

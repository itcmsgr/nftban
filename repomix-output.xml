2379: // ConfigResetHandler handles POST /api/v1/config/:module/reset
2380: func ConfigResetHandler(w http.ResponseWriter, r *http.Request) {
2381: 	vars := mux.Vars(r)
2382: 	module := vars["module"]
2383: 
2384: 	// Validate module name (all NFTBan configuration files)
2385: 	allowedModules := map[string]bool{
2386: 		"main":     true,
2387: 		"firewall": true,
2388: 		"feeds":    true,
2389: 		// Removed: "fail2ban" (v1.0 migration to Suricata)
2390: 		"portscan": true,
2391: 		"ddos":     true,
2392: 		"geoip":    true,
2393: 	}
2394: 
2395: 	if !allowedModules[module] {
2396: 		respondJSON(w, http.StatusBadRequest, ErrorResponse{Error: "Invalid module name"})
2397: 		return
2398: 	}
2399: 
2400: 	// Parse request body - accept multiple formats:
2401: 	// 1. {"keys": ["KEY1", "KEY2"]} - array of keys
2402: 	// 2. {"key": "KEY"} - single key (from frontend)
2403: 	// 3. {"reset_all": true} or {"all": true} - reset all
2404: 	// 4. empty body - reset all
2405: 	var req struct {
2406: 		Key      string   `json:"key"`       // single key (frontend format)
2407: 		Keys     []string `json:"keys"`      // array of keys
2408: 		ResetAll bool     `json:"reset_all"` // reset all flag
2409: 		All      bool     `json:"all"`       // alternate reset all flag
2410: 	}
2411: 
2412: 	// Decode body - if empty or invalid, treat as reset all
2413: 	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
2414: 		// Empty body means reset all
2415: 		req.ResetAll = true
2416: 	}
2417: 
2418: 	// Handle single key format (convert to array)
2419: 	if req.Key != "" && len(req.Keys) == 0 {
2420: 		req.Keys = []string{req.Key}
2421: 	}
2422: 
2423: 	// Check for reset all (both formats)
2424: 	resetAll := req.ResetAll || req.All || (len(req.Keys) == 0 && req.Key == "")
2425: 
2426: 	// Reset all configuration
2427: 	if resetAll {
2428: 		_, err := execNFTBanCommand("config", "reset-all", module)
2429: 		if err != nil {
2430: 			respondJSON(w, http.StatusInternalServerError, ErrorResponse{
2431: 				Error: fmt.Sprintf("Failed to reset configuration: %v", err),
2432: 			})
2433: 			return
2434: 		}
2435: 
2436: 		respondJSON(w, http.StatusOK, map[string]interface{}{
2437: 			"success": true,
2438: 			"message": fmt.Sprintf("All %s configuration reset to defaults", module),
2439: 		})
2440: 		return
2441: 	}
2442: 
2443: 	// Reset specific keys
2444: 	var errors []string
2445: 	for _, key := range req.Keys {
2446: 		_, err := execNFTBanCommand("config", "reset", module, key)
2447: 		if err != nil {
2448: 			errors = append(errors, fmt.Sprintf("%s: %v", key, err))
2449: 		}
2450: 	}
2451: 
2452: 	if len(errors) > 0 {
2453: 		respondJSON(w, http.StatusInternalServerError, ErrorResponse{
2454: 			Error: fmt.Sprintf("Failed to reset some values: %s", strings.Join(errors, "; ")),
2455: 		})
2456: 		return
2457: 	}
2458: 
2459: 	respondJSON(w, http.StatusOK, map[string]interface{}{
2460: 		"success": true,
2461: 		"message": fmt.Sprintf("Reset %d configuration values", len(req.Keys)),
2462: 		"reset":   len(req.Keys),
2463: 	})
2464: }

 591: nftban_nft_validate_rule_order() {
 592:     # Validate critical rule order in input chain
 593:     # SECURITY-CRITICAL: blacklist must come BEFORE ct state established
 594:     # Returns: 0 if valid, 1 if invalid
 595: 
 596:     local status=0
 597:     local rules
 598:     local family
 599: 
 600:     # Check both IPv4 and IPv6
 601:     for family in ip ip6; do
 602:         local whitelist_set="whitelist_ipv4"
 603:         local blacklist_set="blacklist_ipv4"
 604:         [[ "$family" == "ip6" ]] && whitelist_set="whitelist_ipv6" && blacklist_set="blacklist_ipv6"
 605: 
 606:         # Get input chain rules with handles
 607:         rules=$(nft -a list chain "$family" nftban input 2>/dev/null)
 608: 
 609:         if [[ -z "$rules" ]]; then
 610:             if [[ "$family" == "ip" ]]; then
 611:                 echo "ERROR: Cannot read ip nftban input chain" >&2
 612:                 return 1
 613:             else
 614:                 # IPv6 chain missing is just a warning
 615:                 continue
 616:             fi
 617:         fi
 618: 
 619:         # Extract rule order (by handle number which indicates order)
 620:         local whitelist_handle=0
 621:         local blacklist_handle=0
 622:         local established_handle=0
 623: 
 624:         # Find handles for key rules
 625:         whitelist_handle=$(echo "$rules" | grep -E "@${whitelist_set}.*accept" | grep -oP 'handle \K[0-9]+' | head -1 || echo 0)
 626:         blacklist_handle=$(echo "$rules" | grep -E "@${blacklist_set}.*drop" | grep -oP 'handle \K[0-9]+' | head -1 || echo 0)
 627:         established_handle=$(echo "$rules" | grep -E 'ct state.*established' | grep -oP 'handle \K[0-9]+' | head -1 || echo 0)
 628: 
 629:         # Validate order: whitelist < blacklist < established
 630:         if [[ $whitelist_handle -gt 0 && $blacklist_handle -gt 0 ]]; then
 631:             if [[ $whitelist_handle -gt $blacklist_handle ]]; then
 632:                 echo "WARNING: ${family} nftban: Whitelist rule should come BEFORE blacklist rule" >&2
 633:             fi
 634:         fi
 635: 
 636:         if [[ $blacklist_handle -gt 0 && $established_handle -gt 0 ]]; then
 637:             if [[ $blacklist_handle -gt $established_handle ]]; then
 638:                 echo "CRITICAL: ${family} nftban: Blacklist MUST come BEFORE 'ct state established' rule!" >&2
 639:                 echo "  Current order allows banned IPs to maintain established connections!" >&2
 640:                 status=1
 641:             fi
 642:         fi
 643:     done
 644: 
 645:     return $status
 646: }

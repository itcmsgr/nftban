211: _nftban_nftables_cmd_status() {
212:     # Load output module for standard banner
213:     source "${NFTBAN_LIB_DIR}/core/nftban_output.sh"
214: 
215:     # Show standard banner
216:     nftban_banner
217:     echo ""
218: 
219:     echo "NFTables Service Status:"
220:     echo "════════════════════════════════════════════════════════════"
221:     echo ""
222: 
223:     systemctl status "${NFTABLES_SERVICE}" --no-pager
224: 
225:     echo ""
226:     echo "NFTables Binary:"
227:     echo "────────────────────────────────────────────────────────────"
228:     if command -v nft &>/dev/null; then
229:         echo "  Location: $(command -v nft)"

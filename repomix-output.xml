 69:     display: none !important;
 70: }
 71: 
 72: .container {
 73:     display: flex;
 74:     height: calc(100vh - 60px);
 75: }
 76: 
 77: /* Header */
 78: header {
 79:     height: 60px;
 80:     background: var(--bg-alt);

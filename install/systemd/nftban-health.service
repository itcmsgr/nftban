[Unit]
Description=NFTBan Periodic Health Check with Auto-Heal
Documentation=man:nftban(8)
After=network.target nftables.service

[Service]
Type=oneshot

# Runs as nftban; auto-heal actions are constrained by systemd + polkit + CAP_NET_ADMIN.
# Polkit allowlist (10-nftban-systemd.rules) controls which units can be restarted.
# Root-only operations (chown, system config) are skipped gracefully.
# For full root-level fixes: systemctl start nftban-health-fix.service (manual)
User=nftban
Group=nftban

# --auto-heal: Fix what nftban user can (services via polkit, nftables via CAP_NET_ADMIN)
# --cache-status: Write health result for banner display
# flock: Prevent timer+manual overlap (non-blocking, exit if already running)
# NOTE: Lock file in /var/cache/nftban (owned by nftban:nftban) NOT /run/nftban
#       to avoid chicken-and-egg: health check can't run if /run/nftban perms broken
ExecStart=/usr/bin/flock -n /var/cache/nftban/health.lock /usr/sbin/nftban health check --auto-heal --cache-status

# NOTE: Root-level permission fixes (nftban-health-fix.service) are NOT
# auto-triggered from the periodic health check. The fix-all service runs
# 9 steps including firewall conflict removal, rebuild, and GeoIP download
# which violates bounded auto-fix scope (INV-I-011).
# Root permission fixes run only during:
#   1. Install/update (phaseValidate → permissions enforce)
#   2. Manual operator invocation (systemctl start nftban-health-fix)
# Future: introduce a bounded 'nftban health fix safe' target if needed.

# CAP_NET_ADMIN required for nft list/add operations (health checks + auto-heal)
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN

# Exit codes: 0=OK, 1=warnings, 2=errors
SuccessExitStatus=0 1 2

# =============================================================================
# SECURITY HARDENING
# =============================================================================

# Core hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

# Minimal filesystem access (includes /run/nftban for flock)
ReadWritePaths=/var/lib/nftban /var/cache/nftban /var/log/nftban /run/nftban

# Network for nft list operations
RestrictAddressFamilies=AF_UNIX AF_NETLINK

# Resource limits — CONSERVATIVE PACKAGED FALLBACK (v1.222.1).
# The EFFECTIVE, host-appropriate budget is supplied by the installer-generated
# drop-in /etc/systemd/system/nftban-health.service.d/20-nftban-resource-profile.conf,
# derived from the canonical safety RAM tier (small 256M / medium 384M / large 512M
# hard, with a matching soft MemoryHigh and a min-host RAM clamp). These packaged
# values are the SAFE FALLBACK if that generated drop-in is absent (e.g. generation
# failed): 256M hard is the only universally min-host-safe static cap (25% of a 1GiB
# host), and the 192M soft MemoryHigh adds graceful reclaim before the hard kill —
# strictly better than the pre-v1.222.1 pure hard cap.
#
# Root cause (v1.222.1): the OOM was a UNIT cgroup OOM, not host exhaustion — the Go
# nftban-validate validator buffers the full `nft -j list ruleset` (+ transient 2x)
# and 16 `nft -j list set` element reads; peak scales with ban-set/geoban/feeds
# element count (tier-capped), NOT CPU/journal/concurrency (the check path is
# strictly serial). The v1.174 "concurrent child RSS / journal" attribution was
# inaccurate. ExecStart behavior is unchanged. A separate lane
# (PERF-VALIDATOR-NFT-JSON-OVERFETCH) investigates terse nft queries to shrink the
# buffer itself.
MemoryHigh=192M
MemoryMax=256M
# Mirror of the nftban-core-geoip.service TasksMax fix (#525). The health
# check shells out to nftban-core subcommands, including geoip status,
# which exercise the same Go 1.25 runtime + finalizer-goroutine surface.
# Raising the cgroup pids.max limit prevents the same clone(2) EAGAIN
# class of fatal trace from recurring here.
TasksMax=64

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nftban-health

[Install]
WantedBy=multi-user.target

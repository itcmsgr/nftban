[Unit]
Description=NFTBan Suricata Statistics Collector
Documentation=man:nftban(8) https://nftban.com/docs
After=network.target suricata.service
Requires=suricata.service
PartOf=suricata.service

[Service]
Type=simple

# SECURITY FIX: Run as unprivileged nftban user (not root)
# Reads: /var/log/nftban/suricata/eve-alerts.json (via suricata group membership)
# Writes: /var/lib/nftban/cache/ (nftban group writable)
# No firewall operations, no root required
# See: SYSTEMD-SERVICE-CLASSIFICATION.md
User=nftban
Group=nftban
SupplementaryGroups=suricata

# Daemon command
ExecStart=/usr/lib/nftban/bin/nftban-core suricata stats-daemon

# Restart on failure
Restart=on-failure
RestartSec=10

# =============================================================================
# SECURITY HARDENING
# =============================================================================

# Core hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

# Minimal filesystem access
# Read: /var/log/suricata (via suricata group)
# Write: /var/lib/nftban/cache
ReadWritePaths=/var/lib/nftban /var/cache/nftban

# No network required (local file parsing)
RestrictAddressFamilies=AF_UNIX

# Resource limits (lighter than main daemon)
MemoryMax=256M
TasksMax=20
LimitNOFILE=8192
LimitNPROC=64

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nftban-suricata-stats

# Working directory
WorkingDirectory=/var/lib/nftban

[Install]
WantedBy=multi-user.target

 712: nftban_stats_cmd_ip() {
 713:     # Show ban history for specific IP
 714:     # Usage: nftban stats ip <IP> [--detailed] [--json]
 715: 
 716:     local ip="${1:-}"
 717:     local json_mode=false
 718: 
 719:     if [[ -z "$ip" ]]; then
 720:         if [[ "$json_mode" == "true" ]] && declare -f json_output >/dev/null 2>&1; then
 721:             json_output "false" '{}' "IP address required"
 722:         else
 723:             echo "ERROR: IP address required" >&2
 724:             echo "Usage: nftban stats ip <IP>" >&2
 725:         fi
 726:         return 1
 727:     fi
 728: 
 729:     shift
 730:     local detailed=false
 731: 
 732:     # Parse options
 733:     while [[ $# -gt 0 ]]; do
 734:         case "$1" in
 735:             --json)
 736:                 json_mode=true
 737:                 shift
 738:                 ;;
 739:             --detailed)
 740:                 detailed=true  # shellcheck disable=SC2034  # Reserved for detailed mode
 741:                 shift
 742:                 ;;
 743:             *)
 744:                 shift
 745:                 ;;
 746:         esac
 747:     done
 748: 
 749:     # Get history
 750:     local history
 751:     if declare -f nftban_stats_ip_history >/dev/null 2>&1; then
 752:         history=$(nftban_stats_ip_history "$ip" 2>/dev/null || echo "[]")
 753:     else
 754:         history="[]"
 755:     fi
 756: 
 757:     # JSON output mode
 758:     if [[ "$json_mode" == "true" ]] && declare -f json_output >/dev/null 2>&1; then
 759:         local data
 760:         if command -v jq &>/dev/null; then
 761:             local total
 762:             total=$(echo "$history" | jq '. | length' 2>/dev/null || echo "0")
 763:             data=$(jq -n \
 764:                 --arg ip "$ip" \
 765:                 --arg total "$total" \
 766:                 --argjson history "$history" \
 767:                 '{
 768:                     ip: $ip,
 769:                     total_events: ($total | tonumber),
 770:                     history: $history
 771:                 }')
 772:         else
 773:             data="{\"ip\":\"$ip\",\"total_events\":0,\"history\":$history}"
 774:         fi
 775: 
 776:         json_output "true" "$data"
 777:         return 0
 778:     fi
 779: 
 780:     # Human-readable output mode
 781:     echo ""
 782:     if type -t nftban_render_separator >/dev/null 2>&1; then
 783:         nftban_render_separator "═"
 784:     else
 785:         echo "═══════════════════════════════════════════════════════════════"
 786:     fi
 787:     echo "Ban History for ${ip}"
 788:     if type -t nftban_render_separator >/dev/null 2>&1; then
 789:         nftban_render_separator "═"
 790:     else
 791:         echo "═══════════════════════════════════════════════════════════════"
 792:     fi
 793:     echo ""
 794: 
 795:     if command -v jq &>/dev/null; then
 796:         local total
 797:         total=$(echo "$history" | jq '. | length')
 798: 
 799:         if [[ $total -eq 0 ]]; then
 800:             echo "No ban records found for ${ip}"
 801:             echo ""
 802:             return 0
 803:         fi
 804: 
 805:         echo "Total events: ${total}"
 806:         echo ""
 807: 
 808:         # Display events
 809:         echo "$history" | jq -r '.[] | "[\(.action)] \(.timestamp)\n  Jail: \(.jail)\n  Reason: \(.reason)\n"'
 810:     else
 811:         echo "ERROR: jq is required for formatted output" >&2
 812:         return 1
 813:     fi
 814: 
 815:     echo ""
 816: }

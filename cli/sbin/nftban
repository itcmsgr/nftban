                echo "test"
                echo "help"
                ;;
            botscan)
                echo "enable"
                echo "disable"
                echo "status"
                echo "stats"
                echo "check"
                echo "patterns"
                echo "history"
                echo "test"
                echo "help"
                ;;
            botguard)
                echo "enable"
                echo "disable"
                echo "status"
                echo "test"
                echo "list"

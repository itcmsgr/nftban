537: async function banCountry() {
538:     const code = document.getElementById('ban-country-code').value.trim().toUpperCase();
539: 
540:     if (!code || code.length !== 2) {
541:         console.log('[warning]', 'Please enter a valid 2-letter country code (e.g., CN, RU)');
542:         return;
543:     }
544: 
545:     const name = window.countryNames[code] || code;
546: 
547:     if (!confirm(`Ban all traffic from ${name} (${code})?`)) return;
548: 
549:     try {
550:         const response = await apiRequest(`/geoban/ban/${code}`, { method: 'POST' });
551: 
552:         if (response.success) {
553:             console.log('[success]', `Country ${code} has been banned successfully`);
554:             document.getElementById('ban-country-code').value = '';
555:             setTimeout(loadGeoBanData, 1000);
556:         } else {
557:             console.log('[error]', response.error || 'Failed to ban country');
558:         }
559:     } catch (error) {
560:         console.log('[error]', 'Error: ' + error.message);
561:     }
562: }

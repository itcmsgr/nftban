199:                 // Load DDoS statistics
200:                 async function loadDdosStats() {
201:                     const toggle = document.getElementById('ddos-toggle');
202:                     const statusEl = document.getElementById('ddos-toggle-status');
203:                     const modeEl = document.getElementById('ddos-mode');
204:                     const suricataBadge = document.getElementById('ddos-suricata-badge');
205: 
206:                     try {
207:                         const response = await fetch('/api/v1/ddos/stats', {
208:                             headers: getAuthHeaders()
209:                         });
210:                         const result = await response.json();
211: 
212:                         if (response.ok && result.success && result.data && result.data.ddos) {
213:                             const ddos = result.data.ddos;
214: 
215:                             // Update statistics
216:                             document.getElementById('ddos-rate-limit').textContent = ddos.rate_limit || 0;
217:                             document.getElementById('ddos-blocked-24h').textContent = ddos.blocked_24h || 0;
218:                             document.getElementById('ddos-blocked-total').textContent = ddos.blocked_total || 0;
219: 
220:                             // Update mode indicator
221:                             const mode = ddos.mode || 'classic';
222:                             const modeDisplay = mode.charAt(0).toUpperCase() + mode.slice(1);
223:                             modeEl.textContent = modeDisplay;
224: 
225:                             // Show Suricata badge if available
226:                             if (ddos.suricata_available) {
227:                                 suricataBadge.classList.remove('hidden');
228:                             } else {
229:                                 suricataBadge.classList.add('hidden');
230:                             }
231: 
232:                             // Update toggle state
233:                             toggle.checked = ddos.enabled || false;
234:                             toggle.disabled = false;
235: 
236:                             // Update status text with mode info
237:                             if (ddos.enabled) {
238:                                 statusEl.textContent = `Enabled - ${modeDisplay} mode`;
239:                             } else {
240:                                 statusEl.textContent = 'Disabled';
241:                             }
242:                         } else {
243:                             statusEl.textContent = 'Failed to load status';
244:                         }
245:                     } catch (err) {
246:                         console.error('[DDOS] Failed to load stats:', err);
247:                         statusEl.textContent = 'Error loading status';
248:                     }
249:                 }
250: 
251:                 // Store config data for tracking changes
252:                 var ddosConfigData = {};
253:                 var ddosModifiedValues = {};
254: 
255:                 // Load DDoS configuration table
256:                 async function loadDdosConfig() {
257:                     const tbody = document.getElementById('ddos-config-table');
258:                     try {
259:                         const response = await fetch('/api/v1/config/ddos', {
260:                             headers: getAuthHeaders()
261:                         });
262:                         const result = await response.json();
263: 
264:                         if (response.ok && result.success && result.data) {
265:                             // Convert API response format to parameters format
266:                             const data = result.data;
267:                             ddosConfigData = {};
268:                             const defaults = data.defaults || {};
269:                             const overrides = data.overrides || {};
270:                             const merged = data.merged || {};
271: 
272:                             Object.keys(merged).forEach(key => {
273:                                 ddosConfigData[key] = {
274:                                     default: defaults[key] || '',
275:                                     current: merged[key] || '',
276:                                     is_local: overrides.hasOwnProperty(key)
277:                                 };
278:                             });
279: 
280:                             ddosModifiedValues = {};
281:                             renderDdosConfigTable();
282:                         } else {
283:                             tbody.innerHTML = '<tr><td colspan="4" class="txt-c py-8 text-danger">Error loading config: ' + (result.error || 'Unknown') + '</td></tr>';
284:                         }
285:                     } catch (err) {
286:                         tbody.innerHTML = '<tr><td colspan="4" class="txt-c py-8 text-danger">Error: ' + err.message + '</td></tr>';
287:                     }
288:                 }
289: 
290:                 function renderDdosConfigTable() {
291:                     const tbody = document.getElementById('ddos-config-table');
292:                     const params = Object.keys(ddosConfigData).sort();
293: 
294:                     if (params.length === 0) {
295:                         tbody.innerHTML = '<tr><td colspan="4" class="txt-c py-8 text-muted">No parameters found</td></tr>';
296:                         return;
297:                     }
298: 
299:                     let html = '';
300:                     params.forEach(key => {
301:                         const param = ddosConfigData[key];
302:                         const defaultVal = param.default || '';
303:                         const currentVal = ddosModifiedValues[key] !== undefined ? ddosModifiedValues[key] : (param.current || defaultVal);
304:                         const isModified = param.is_local || ddosModifiedValues[key] !== undefined;
305:                         const bgColor = isModified ? 'background: #fef3c7;' : '';
306: 
307:                         html += `
308:                         <tr>
309:                             <td class="px-15 py-8 main-border fs-13 fw-bold">${key}</td>
310:                             <td class="px-15 py-8 main-border fs-13 text-muted">${defaultVal}</td>
311:                             <td class="px-15 py-8 main-border" style="${bgColor}">
312:                                 <input type="text" id="ddos-cfg-${key}" value="${currentVal}"
313:                                        onchange="ddosConfigChanged('${key}')"
314:                                        class="w-full px-10 py-5 main-border rad-4 fs-13" style="${bgColor}">
315:                             </td>
316:                             <td class="px-15 py-8 main-border txt-c">
317:                                 <button onclick="resetDdosParam('${key}')" class="px-10 py-5 bg-orange-500 text-white rad-4 fs-11 hover:bg-orange-600">Reset</button>
318:                             </td>
319:                         </tr>`;
320:                     });
321:                     tbody.innerHTML = html;
322:                 }
323: 
324:                 function ddosConfigChanged(key) {
325:                     const input = document.getElementById('ddos-cfg-' + key);
326:                     ddosModifiedValues[key] = input.value;
327:                     input.style.background = '#fef3c7';
328:                 }
329: 
330:                 async function saveAllDdosConfig() {
331:                     const msgEl = document.getElementById('ddos-config-msg');
332:                     if (Object.keys(ddosModifiedValues).length === 0) {
333:                         msgEl.className = 'bg-yellow-100 text-yellow-800 p-15 rad-6';
334:                         msgEl.textContent = '⚠️ No changes to save';
335:                         msgEl.classList.remove('hidden');
336:                         return;
337:                     }
338: 
339:                     try {
340:                         const response = await fetch('/api/v1/config/ddos', {
341:                             method: 'POST',
342:                             headers: { ...getAuthHeaders(), 'Content-Type': 'application/json' },
343:                             body: JSON.stringify(ddosModifiedValues)
344:                         });
345:                         const result = await response.json();
346: 
347:                         if (response.ok && result.success) {
348:                             msgEl.className = 'bg-green-100 text-green-800 p-15 rad-6';
349:                             msgEl.textContent = '✅ Configuration saved to /etc/nftban/nftban.conf.local';
350:                             ddosModifiedValues = {};
351:                             await loadDdosConfig();
352:                         } else {
353:                             msgEl.className = 'bg-red-100 text-red-800 p-15 rad-6';
354:                             msgEl.textContent = '❌ Failed: ' + (result.error || 'Unknown error');
355:                         }
356:                         msgEl.classList.remove('hidden');
357:                     } catch (err) {
358:                         msgEl.className = 'bg-red-100 text-red-800 p-15 rad-6';
359:                         msgEl.textContent = '❌ Error: ' + err.message;
360:                         msgEl.classList.remove('hidden');
361:                     }
362:                 }
363: 
364:                 async function resetDdosParam(key) {
365:                     try {
366:                         const response = await fetch('/api/v1/config/ddos/reset', {
367:                             method: 'POST',
368:                             headers: { ...getAuthHeaders(), 'Content-Type': 'application/json' },
369:                             body: JSON.stringify({ key: key })
370:                         });
371:                         if (response.ok) {
372:                             delete ddosModifiedValues[key];
373:                             await loadDdosConfig();
374:                         }
375:                     } catch (err) {
376:                         console.error('Reset failed:', err);
377:                     }
378:                 }
379: 
380:                 async function resetAllDdosConfig() {
381:                     if (!confirm('Reset ALL DDoS parameters to defaults?')) return;
382:                     try {
383:                         const response = await fetch('/api/v1/config/ddos/reset', {
384:                             method: 'POST',
385:                             headers: { ...getAuthHeaders(), 'Content-Type': 'application/json' },
386:                             body: JSON.stringify({ all: true })
387:                         });
388:                         if (response.ok) {
389:                             ddosModifiedValues = {};
390:                             await loadDdosConfig();
391:                         }
392:                     } catch (err) {
393:                         console.error('Reset all failed:', err);
394:                     }
395:                 }
396: 
397:                 // Load DDoS attack log
398:                 async function loadDdosLog() {
399:                     const viewer = document.getElementById('ddos-log-viewer');
400:                     try {
401:                         const response = await fetch('/api/v1/logs/file?path=/var/log/nftban/ddos.log&lines=100', {
402:                             headers: getAuthHeaders()
403:                         });
404:                         const result = await response.json();
405: 
406:                         if (response.ok && result.success && result.data) {
407:                             viewer.textContent = result.data.content || 'No log entries';
408:                         } else {
409:                             viewer.textContent = 'Error loading log: ' + (result.error || 'Unknown error');
410:                         }
411:                     } catch (err) {
412:                         viewer.textContent = 'Error loading log: ' + err.message;
413:                     }
414:                 }
415: 
416:                 // Load DDoS actions log (bans)
417:                 async function loadDdosActionsLog() {
418:                     const viewer = document.getElementById('ddos-actions-log-viewer');
419:                     try {
420:                         const response = await fetch('/api/v1/logs/file?path=/var/log/nftban/nftban-actions.log&lines=100', {
421:                             headers: getAuthHeaders()
422:                         });
423:                         const result = await response.json();
424: 
425:                         if (response.ok && result.success && result.data) {
426:                             // Filter for DDoS-related actions
427:                             const content = result.data.content || '';
428:                             const lines = content.split('\n').filter(line => line.includes('"source":"ddos"'));
429:                             viewer.textContent = lines.length > 0 ? lines.join('\n') : 'No DDoS ban actions found';
430:                         } else {
431:                             viewer.textContent = 'Error loading log: ' + (result.error || 'Unknown error');
432:                         }
433:                     } catch (err) {
434:                         viewer.textContent = 'Error loading log: ' + err.message;
435:                     }
436:                 }
437: 
438:                 // Auto-load when page is shown
439:                 // Use setTimeout to ensure DOM is ready
440:                 setTimeout(() => {
441:                     const panel = document.getElementById('panel-ddos');
442:                     console.log('[DDOS] Auto-load check, panel exists:', !!panel);
443: 
444:                     if (panel) {
445:                         console.log('[DDOS] Auto-loading page data...');
446:                         try {
447:                             loadDdosStats();
448:                             loadDdosConfig();
449:                             loadDdosLog();
450:                             loadDdosActionsLog();
451:                         } catch (err) {
452:                             console.error('[DDOS] Auto-load error:', err);
453:                         }
454:                     } else {
455:                         console.warn('[DDOS] Panel not found, retrying in 200ms...');
456:                         setTimeout(() => {
457:                             if (document.getElementById('panel-ddos')) {
458:                                 console.log('[DDOS] Retry: Auto-loading page data...');
459:                                 loadDdosStats();
460:                                 loadDdosConfig();
461:                                 loadDdosLog();
462:                                 loadDdosActionsLog();
463:                             }
464:                         }, 200);
465:                     }
466:                 }, 50);
467:                 </script>
</file>


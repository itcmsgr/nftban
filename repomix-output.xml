481: // aggregateUserStats aggregates login stats per user
482: func aggregateUserStats() []LoginUser {
483: 	userMap := make(map[string]*LoginUser)
484: 
485: 	// Get events
486: 	events := parseLoginEvents(500)
487: 
488: 	for _, event := range events {
489: 		if event.User == "" {
490: 			continue
491: 		}
492: 
493: 		user, exists := userMap[event.User]
494: 		if !exists {
495: 			user = &LoginUser{Username: event.User}
496: 			userMap[event.User] = user
497: 		}
498: 
499: 		user.Total++
500: 		if event.Status == "SUCCESS" {
501: 			user.Success++
502: 			if user.LastLogin == "" || event.Timestamp > user.LastLogin {
503: 				user.LastLogin = event.Timestamp
504: 			}
505: 		} else {
506: 			user.Failed++
507: 		}
508: 	}
509: 
510: 	// Convert to slice
511: 	var users []LoginUser
512: 	for _, user := range userMap {
513: 		users = append(users, *user)
514: 	}
515: 
516: 	return users
517: }

170: step3_install_prometheus() {
171:     print_step "3" "Install and Configure Prometheus"
172: 
173:     if [[ "$DEPLOYMENT_MODE" == "minimal" ]]; then
174:         print_info "Skipping Prometheus (minimal mode)"
175:         return 0
176:     fi
177: 
178:     if [[ "$DEPLOYMENT_MODE" == "grafana-cloud" ]]; then
179:         print_info "Skipping local Prometheus (using Grafana Cloud)"

143: # =============================================================================
144: # MAIL STATUS CHECKING
145: # =============================================================================
146: 
147: nftban_mail_check_status() {
148:     # Check if mail system is available and working
149:     # Returns: Exit code 0=OK, 1=not found, 2=not running, 3=ports blocked
150: 
151:     local mta
152:     mta="$(nftban_mail_detect_mta)"
153: 
154:     if [[ "$mta" == "none" ]]; then
155:         echo "✗ No mail system found"
156:         echo ""
157:         echo "Options to enable mail:"
158:         echo "  1. Install local MTA: postfix, exim, or sendmail"
159:         echo "  2. Install msmtp (lightweight relay)"
160:         echo "  3. Configure direct SMTP in /etc/nftban/conf.d/mail.conf:"
161:         echo "       NFTBAN_SMTP_HOST=\"smtp.example.com\""
162:         echo "       NFTBAN_SMTP_USER=\"user@example.com\""
163:         echo "       NFTBAN_SMTP_PASS=\"password\""
164:         return 1
165:     fi
166: 
167:     # Check if mail daemon is running (for postfix/sendmail/exim)
168:     case "$mta" in
169:         postfix)
170:             if ! systemctl is-active postfix &>/dev/null && ! pgrep -x master &>/dev/null; then
171:                 echo "✗ Postfix is installed but not running"
172:                 return 2
173:             fi
174:             ;;
175:         sendmail)
176:             if ! pgrep -x sendmail &>/dev/null; then
177:                 echo "⚠ Sendmail binary available but daemon may not be running"
178:                 # Don't fail - sendmail can work without daemon for outbound
179:             fi
180:             ;;
181:         exim)
182:             if ! pgrep -x exim &>/dev/null && ! systemctl is-active exim4 &>/dev/null 2>&1; then
183:                 echo "✗ Exim is installed but not running"
184:                 return 2
185:             fi
186:             ;;
187:         curl)
188:             # Verify SMTP settings
189:             if [[ -z "${NFTBAN_SMTP_HOST:-}" ]]; then
190:                 echo "✗ curl SMTP selected but NFTBAN_SMTP_HOST not configured"
191:                 return 2
192:             fi
193:             echo "  SMTP Host: ${NFTBAN_SMTP_HOST}:${NFTBAN_SMTP_PORT:-587}"
194:             [[ -n "${NFTBAN_SMTP_USER:-}" ]] && echo "  Auth User: ${NFTBAN_SMTP_USER}"
195:             ;;
196:         msmtp)
197:             echo "  Config: $(ls /etc/msmtprc ~/.msmtprc 2>/dev/null | head -1)"
198:             ;;
199:     esac
200: 
201:     # Check if mail ports are blocked (basic check for port 25 outbound)
202:     if command -v nft &>/dev/null; then
203:         local ruleset
204:         ruleset="$(nft list ruleset 2>/dev/null || true)"
205: 
206:         # Check if port 25 is explicitly blocked outbound
207:         if echo "$ruleset" | grep -qE "tcp dport 25.*drop|tcp dport 25.*reject"; then
208:             echo "⚠ Mail port 25 may be blocked in firewall"
209:             # Don't fail - other ports might work
210:         fi
211:     fi
212: 
213:     echo "✓ Mail System: $mta (ready)"
214:     return 0
215: }

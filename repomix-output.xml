 853: nftban_stats_export_csv() {
 854:     # Export ban log to CSV
 855:     # Usage: nftban_stats_export_csv [output_file] [since] [until]
 856: 
 857:     local output_file="${1:-/tmp/nftban-stats-$(date +%Y%m%d-%H%M%S).csv}"
 858:     local since="${2:-$(date -d '30 days ago' +%Y-%m-%d)}"
 859:     local until="${3:-$(date +%Y-%m-%d)}"
 860: 
 861:     if type -t nftban_print_status >/dev/null 2>&1; then

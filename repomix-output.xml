<file path="cli/lib/nftban/core/nftban_login_classic.sh">
  1: #!/usr/bin/env bash
  2: # shellcheck disable=SC1090  # Dynamic config paths, cannot follow
  3: # =============================================================================
  4: # NFTBan v1.0 - Login Monitor Classic Mode Module
  5: # =============================================================================
  6: # SPDX-License-Identifier: MPL-2.0
  7: # Purpose: journalctl/log file based login monitoring
  8: #
  9: # meta:name=nftban_login_classic
 10: # meta:type=core
 11: # meta:header=Login Monitor Classic Mode
 12: # meta:version=1.0.0
 13: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 14: # meta:homepage=https://nftban.com
 15: #
 16: # **Description & Purpose**
 17: # meta:description=Classic mode login monitoring using journalctl and log files
 18: # meta:input=System journals and log files
 19: # meta:output=Failed login detection and ban actions
 20: #
 21: # **Inventory & Requirements**
 22: # meta:depends=bash>=4.0,journalctl,nftban_login.sh
 23: # meta:optional=jq
 24: #
 25: # meta:created_date=2025-12-01
 26: # meta:updated_date=2025-12-01
 27: # =============================================================================
 28: 
 29: IFS=$'\n\t'
 30: umask 027
 31: 
 32: # =============================================================================
 33: # MODULE GUARD
 34: # =============================================================================
 35: 
 36: [[ -n "${NFTBAN_LOGIN_CLASSIC_LOADED:-}" ]] && return 0
 37: readonly NFTBAN_LOGIN_CLASSIC_LOADED=1
 38: 
 39: # =============================================================================
 40: # MODULE METADATA
 41: # =============================================================================
 42: 
 43: # shellcheck disable=SC2034  # Module metadata used when sourced
 44: readonly LOGIN_CLASSIC_MODULE_NAME="nftban_login_classic"
 45: readonly LOGIN_CLASSIC_MODULE_VERSION="1.0.0"
 46: 
 47: # =============================================================================
 48: # STATE TRACKING
 49: # =============================================================================
 50: 
 51: # Failed attempt tracking (IP -> count)
 52: declare -gA _LOGIN_CLASSIC_FAIL_COUNT=()
 53: # Failed attempt first timestamp (IP -> timestamp)
 54: declare -gA _LOGIN_CLASSIC_FAIL_FIRST=()
 55: # Last seen service per IP (IP -> service)
 56: declare -gA _LOGIN_CLASSIC_LAST_SERVICE=()
 57: # Running flag
 58: declare -g _LOGIN_CLASSIC_RUNNING=0
 59: # PIDs of background monitors
 60: declare -gA _LOGIN_CLASSIC_MONITOR_PIDS=()
 61: 
 62: # =============================================================================
 63: # INITIALIZATION
 64: # =============================================================================
 65: 
 66: nftban_login_classic_init() {
 67:     nftban_login_log "INFO" "Initializing classic mode..."
 68: 
 69:     # Load state from disk if exists
 70:     local state_file="${LOGIN_CLASSIC_STATE_FILE:-/var/lib/nftban/login-classic-state.db}"
 71:     if [[ -f "$state_file" ]]; then
 72:         source "$state_file" 2>/dev/null || true
 73:     fi
 74: 
 75:     # Ban threshold: 10 failures in 5 minutes (300 seconds) for all services
 76:     : "${LOGIN_CLASSIC_FAIL_THRESHOLD:=10}"
 77:     : "${LOGIN_CLASSIC_FAIL_WINDOW:=300}"
 78:     : "${LOGIN_CLASSIC_SCORE_FAILED:=0.10}"
 79:     : "${LOGIN_CLASSIC_SCORE_INVALID_USER:=0.15}"
 80:     : "${LOGIN_CLASSIC_SCORE_ROOT_ATTEMPT:=0.25}"
 81:     : "${LOGIN_CLASSIC_THRESHOLD_BLOCK_SHORT:=0.45}"
 82:     : "${LOGIN_CLASSIC_THRESHOLD_BLOCK_LONG:=0.65}"
 83:     : "${LOGIN_CLASSIC_BAN_DURATION_SHORT:=900}"
 84:     : "${LOGIN_CLASSIC_BAN_DURATION_LONG:=3600}"
 85: 
 86:     return 0
 87: }
 88: 
 89: # =============================================================================
 90: # JOURNALCTL MONITORING
 91: # =============================================================================
 92: 
 93: # Start monitoring a specific service via journalctl
 94: _nftban_login_classic_monitor_journal() {
 95:     local service="$1"
 96:     local units="$2"
 97:     local pattern_failed="$3"
 98:     local pattern_invalid="${4:-}"
 99: 
100:     nftban_login_log "INFO" "Starting journal monitor for $service (units: $units)"
101: 
102:     # Build journalctl command
103:     local -a journal_cmd=(journalctl -f -n 0)
104: 
105:     # Add units
106:     IFS=',' read -ra unit_array <<< "$units"
107:     for unit in "${unit_array[@]}"; do
108:         journal_cmd+=(-u "$unit")
109:     done
110: 
111:     # Use JSON output if jq is available
112:     if command -v jq &>/dev/null && [[ "${LOGIN_CLASSIC_JOURNALCTL_JSON:-true}" == "true" ]]; then
113:         journal_cmd+=(--output=json)
114:         "${journal_cmd[@]}" 2>/dev/null | while read -r line; do
115:             local message
116:             message=$(echo "$line" | jq -r '.MESSAGE // empty' 2>/dev/null) || continue
117:             [[ -z "$message" ]] && continue
118:             _nftban_login_classic_process_message "$service" "$message" "$pattern_failed" "$pattern_invalid"
119:         done
120:     else
121:         # Fallback to text parsing
122:         "${journal_cmd[@]}" 2>/dev/null | while read -r line; do
123:             _nftban_login_classic_process_message "$service" "$line" "$pattern_failed" "$pattern_invalid"
124:         done
125:     fi
126: }
127: 
128: # Process a log message and extract IP/user
129: _nftban_login_classic_process_message() {
130:     local service="$1"
131:     local message="$2"
132:     local pattern_failed="$3"
133:     local pattern_invalid="${4:-}"
134: 
135:     local ip=""
136:     local user=""
137:     local event_type="failed"
138: 
139:     # SSH patterns
140:     if [[ "$service" == "ssh" ]]; then
141:         # Failed password for user from IP
142:         if [[ "$message" =~ Failed\ password\ for\ ([^[:space:]]+)\ from\ ([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+) ]]; then
143:             user="${BASH_REMATCH[1]}"
144:             ip="${BASH_REMATCH[2]}"
145:         # Failed password for invalid user
146:         elif [[ "$message" =~ Failed\ password\ for\ invalid\ user\ ([^[:space:]]+)\ from\ ([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+) ]]; then
147:             user="${BASH_REMATCH[1]}"
148:             ip="${BASH_REMATCH[2]}"
149:             event_type="invalid_user"
150:         # Invalid user from IP
151:         elif [[ "$message" =~ Invalid\ user\ ([^[:space:]]+)\ from\ ([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+) ]]; then
152:             user="${BASH_REMATCH[1]}"
153:             ip="${BASH_REMATCH[2]}"
154:             event_type="invalid_user"
155:         # Disconnected preauth (potential scan)
156:         elif [[ "$message" =~ Disconnected\ from.*\ ([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+).*preauth ]]; then
157:             ip="${BASH_REMATCH[1]}"
158:             user="unknown"
159:             event_type="preauth"
160:         # Too many authentication failures
161:         elif [[ "$message" =~ ([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+).*[Tt]oo\ many\ authentication\ failures ]]; then
162:             ip="${BASH_REMATCH[1]}"
163:             user="unknown"
164:             event_type="too_many"
165:         fi
166:     fi
167: 
168:     # Mail patterns (Dovecot, Exim, Postfix)
169:     if [[ "$service" == "dovecot" ]] || [[ "$service" == "exim" ]] || [[ "$service" == "postfix" ]]; then
170:         # Generic: auth failure from IP
171:         if [[ "$message" =~ [Aa]uth.*fail.*rip=([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+) ]]; then
172:             ip="${BASH_REMATCH[1]}"
173:             user="unknown"
174:         elif [[ "$message" =~ [Aa]uthentication\ fail.*from\ ([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+) ]]; then
175:             ip="${BASH_REMATCH[1]}"
176:             user="unknown"
177:         # SASL authentication failed (Postfix)
178:         elif [[ "$message" =~ SASL.*authentication\ failed.*\[([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+)\] ]]; then
179:             ip="${BASH_REMATCH[1]}"
180:             user="unknown"
181:         fi
182:     fi
183: 
184:     # FTP patterns (Pure-FTPd, vsftpd)
185:     if [[ "$service" == "pureftpd" ]] || [[ "$service" == "vsftpd" ]] || [[ "$service" == "proftpd" ]]; then
186:         if [[ "$message" =~ [Aa]uthentication\ fail.*@([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+) ]]; then
187:             ip="${BASH_REMATCH[1]}"
188:             user="unknown"
189:         elif [[ "$message" =~ FAIL\ LOGIN.*from\ ([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+) ]]; then
190:             ip="${BASH_REMATCH[1]}"
191:             user="unknown"
192:         elif [[ "$message" =~ \[([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+)\].*Login\ failed ]]; then
193:             ip="${BASH_REMATCH[1]}"
194:             user="unknown"
195:         fi
196:     fi
197: 
198:     # If we found an IP, process the event
199:     if [[ -n "$ip" ]]; then
200:         _nftban_login_classic_process_event "$ip" "$user" "$service" "$event_type"
201:     fi
202: }
203: 
204: # =============================================================================
205: # LOG FILE MONITORING
206: # =============================================================================
207: 
208: # Monitor a log file for patterns
209: _nftban_login_classic_monitor_file() {
210:     local service="$1"
211:     local log_file="$2"
212:     local pattern="$3"
213: 
214:     [[ ! -f "$log_file" ]] && return 1
215: 
216:     nftban_login_log "INFO" "Starting file monitor for $service ($log_file)"
217: 
218:     tail -F "$log_file" 2>/dev/null | while read -r line; do
219:         _nftban_login_classic_process_web_log "$service" "$line" "$pattern"
220:     done
221: }
222: 
223: # Process web log line (Apache/Nginx)
224: _nftban_login_classic_process_web_log() {
225:     local service="$1"
226:     local line="$2"
227:     local pattern="$3"
228: 
229:     local ip=""
230: 
231:     # WordPress/XML-RPC: POST to wp-login.php or xmlrpc.php
232:     if [[ "$service" == "wordpress" ]] || [[ "$service" == "xmlrpc" ]]; then
233:         if [[ "$line" =~ ^([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+).*POST.*/wp-login\.php ]]; then
234:             ip="${BASH_REMATCH[1]}"
235:             _nftban_login_classic_process_event "$ip" "unknown" "wordpress" "login_attempt"
236:         elif [[ "$line" =~ ^([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+).*POST.*/xmlrpc\.php ]]; then
237:             ip="${BASH_REMATCH[1]}"
238:             _nftban_login_classic_process_event "$ip" "unknown" "xmlrpc" "xmlrpc_post"
239:         fi
240:     fi
241: 
242:     # Apache/Nginx HTTP auth failure (401)
243:     if [[ "$service" == "apache" ]] || [[ "$service" == "nginx" ]]; then
244:         if [[ "$line" =~ user.*authentication\ failure.*client:\ ([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+) ]]; then
245:             ip="${BASH_REMATCH[1]}"
246:             _nftban_login_classic_process_event "$ip" "unknown" "$service" "http_auth"
247:         fi
248:     fi
249: 
250:     # DirectAdmin
251:     if [[ "$service" == "directadmin" ]]; then
252:         if [[ "$line" =~ FAILED\ LOGIN.*ip=([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+) ]]; then
253:             ip="${BASH_REMATCH[1]}"
254:             _nftban_login_classic_process_event "$ip" "unknown" "directadmin" "failed"
255:         fi
256:     fi
257: }
258: 
259: # =============================================================================
260: # EVENT PROCESSING
261: # =============================================================================
262: 
263: # Process a detected failed login event
264: _nftban_login_classic_process_event() {
265:     local ip="$1"
266:     local user="$2"
267:     local service="$3"
268:     local event_type="$4"
269:     local now
270:     now=$(date +%s)
271: 
272:     # Skip whitelisted IPs
273:     if _nftban_login_classic_is_whitelisted "$ip"; then
274:         return 0
275:     fi
276: 
277:     # Get service-specific thresholds
278:     local threshold_var="LOGIN_SERVICE_${service^^}_FAIL_THRESHOLD"
279:     local window_var="LOGIN_SERVICE_${service^^}_FAIL_WINDOW"
280:     local threshold="${!threshold_var:-${LOGIN_CLASSIC_FAIL_THRESHOLD:-5}}"
281:     local window="${!window_var:-${LOGIN_CLASSIC_FAIL_WINDOW:-300}}"
282: 
283:     # Track the attempt
284:     local key="${service}:${ip}"
285: 
286:     if [[ -z "${_LOGIN_CLASSIC_FAIL_FIRST[$key]:-}" ]]; then
287:         # First failure
288:         _LOGIN_CLASSIC_FAIL_COUNT[$key]=1
289:         _LOGIN_CLASSIC_FAIL_FIRST[$key]=$now
290:     else
291:         # Check if within window
292:         local first="${_LOGIN_CLASSIC_FAIL_FIRST[$key]}"
293:         local elapsed
294:         elapsed=$((now - first))
295: 
296:         if [[ $elapsed -lt $window ]]; then
297:             # Within window - increment
298:             ((_LOGIN_CLASSIC_FAIL_COUNT[$key]++))
299:         else
300:             # Outside window - reset
301:             _LOGIN_CLASSIC_FAIL_COUNT[$key]=1
302:             _LOGIN_CLASSIC_FAIL_FIRST[$key]=$now
303:         fi
304:     fi
305: 
306:     local count="${_LOGIN_CLASSIC_FAIL_COUNT[$key]}"
307:     _LOGIN_CLASSIC_LAST_SERVICE[$ip]="$service"
308: 
309:     nftban_login_log "DEBUG" "Event: $service $event_type from $ip (user: $user, count: $count/$threshold)"
310: 
311:     # Calculate score
312:     local score
313:     score=$(_nftban_login_classic_calculate_score "$ip" "$user" "$service" "$event_type" "$count")
314: 
315:     # Check thresholds
316:     if (( $(echo "$score >= ${LOGIN_CLASSIC_THRESHOLD_BLOCK_LONG:-0.65}" | bc -l) )); then
317:         # Long ban
318:         local duration="${LOGIN_CLASSIC_BAN_DURATION_LONG:-3600}"
319:         nftban_login_log "INFO" "Banning $ip (long) - score: $score, service: $service"
320:         nftban_login_ban "$ip" "${service}_brute_force" "$duration" "$service"
321:         _nftban_login_classic_clear_ip "$ip"
322:     elif (( $(echo "$score >= ${LOGIN_CLASSIC_THRESHOLD_BLOCK_SHORT:-0.45}" | bc -l) )); then
323:         # Short ban
324:         local duration="${LOGIN_CLASSIC_BAN_DURATION_SHORT:-900}"
325:         nftban_login_log "INFO" "Banning $ip (short) - score: $score, service: $service"
326:         nftban_login_ban "$ip" "${service}_brute_force" "$duration" "$service"
327:         _nftban_login_classic_clear_ip "$ip"
328:     elif [[ $count -ge $threshold ]]; then
329:         # Threshold-based ban (fallback)
330:         local duration="${LOGIN_CLASSIC_BAN_DURATION_SHORT:-900}"
331:         nftban_login_log "INFO" "Banning $ip (threshold) - count: $count, service: $service"
332:         nftban_login_ban "$ip" "${service}_threshold" "$duration" "$service"
333:         _nftban_login_classic_clear_ip "$ip"
334:     fi
335: }
336: 
337: # Calculate risk score for an event
338: _nftban_login_classic_calculate_score() {
339:     local ip="$1"
340:     local user="$2"
341:     local service="$3"
342:     local event_type="$4"
343:     local count="$5"
344: 
345:     local score=0
346: 
347:     # Base score for failed attempt
348:     score=$(echo "$score + ${LOGIN_CLASSIC_SCORE_FAILED:-0.10}" | bc -l)
349: 
350:     # Invalid user penalty
351:     if [[ "$event_type" == "invalid_user" ]]; then
352:         score=$(echo "$score + ${LOGIN_CLASSIC_SCORE_INVALID_USER:-0.15}" | bc -l)
353:     fi
354: 
355:     # Root login attempt penalty
356:     if [[ "$user" == "root" ]] || [[ "$user" == "admin" ]] || [[ "$user" == "administrator" ]]; then
357:         score=$(echo "$score + ${LOGIN_CLASSIC_SCORE_ROOT_ATTEMPT:-0.25}" | bc -l)
358:     fi
359: 
360:     # Honeypot user penalty
361:     local honeypot_users="${LOGIN_CLASSIC_HONEYPOT_USERS:-admin,root,test,guest,user,administrator,oracle,mysql,postgres}"
362:     if [[ ",$honeypot_users," == *",$user,"* ]]; then
363:         score=$(echo "$score + ${LOGIN_CLASSIC_SCORE_HONEYPOT_USER:-0.20}" | bc -l)
364:     fi
365: 
366:     # Repetition bonuses
367:     if [[ $count -ge 10 ]]; then
368:         score=$(echo "$score + ${LOGIN_CLASSIC_SCORE_REPEAT_10:-0.25}" | bc -l)
369:     elif [[ $count -ge 5 ]]; then
370:         score=$(echo "$score + ${LOGIN_CLASSIC_SCORE_REPEAT_5:-0.15}" | bc -l)
371:     elif [[ $count -ge 3 ]]; then
372:         score=$(echo "$score + ${LOGIN_CLASSIC_SCORE_REPEAT_3:-0.10}" | bc -l)
373:     fi
374: 
375:     # Multi-service attack
376:     local service_count=0
377:     for key in "${!_LOGIN_CLASSIC_FAIL_COUNT[@]}"; do
378:         if [[ "$key" == *":$ip" ]]; then
379:             ((service_count++))
380:         fi
381:     done
382:     if [[ $service_count -gt 1 ]]; then
383:         score=$(echo "$score + ${LOGIN_CLASSIC_SCORE_MULTI_SERVICE:-0.15}" | bc -l)
384:     fi
385: 
386:     # Service-specific multiplier
387:     local multiplier_var="LOGIN_SERVICE_${service^^}_RISK_MULTIPLIER"
388:     local multiplier="${!multiplier_var:-1.0}"
389:     score=$(echo "$score * $multiplier" | bc -l)
390: 
391:     # Cap at 1.0
392:     if (( $(echo "$score > 1.0" | bc -l) )); then
393:         score="1.0"
394:     fi
395: 
396:     echo "$score"
397: }
398: 
399: # Check if IP is whitelisted
400: _nftban_login_classic_is_whitelisted() {
401:     local ip="$1"
402: 
403:     # Localhost
404:     if [[ "${LOGIN_WHITELIST_LOCALHOST:-true}" == "true" ]]; then
405:         [[ "$ip" == "127.0.0.1" ]] && return 0
406:         [[ "$ip" == "::1" ]] && return 0
407:     fi
408: 
409:     # Private networks
410:     if [[ "${LOGIN_WHITELIST_PRIVATE:-true}" == "true" ]]; then
411:         [[ "$ip" =~ ^10\. ]] && return 0
412:         [[ "$ip" =~ ^172\.(1[6-9]|2[0-9]|3[0-1])\. ]] && return 0
413:         [[ "$ip" =~ ^192\.168\. ]] && return 0
414:     fi
415: 
416:     # Whitelist file
417:     local whitelist_file="${LOGIN_WHITELIST_FILE:-/etc/nftban/whitelist.d/login-whitelist.conf}"
418:     if [[ -f "$whitelist_file" ]]; then
419:         grep -q "^$ip$" "$whitelist_file" && return 0
420:     fi
421: 
422:     return 1
423: }
424: 
425: # Clear tracking for an IP after ban
426: _nftban_login_classic_clear_ip() {
427:     local ip="$1"
428: 
429:     for key in "${!_LOGIN_CLASSIC_FAIL_COUNT[@]}"; do
430:         if [[ "$key" == *":$ip" ]]; then
431:             unset "_LOGIN_CLASSIC_FAIL_COUNT[$key]"
432:             unset "_LOGIN_CLASSIC_FAIL_FIRST[$key]"
433:         fi
434:     done
435:     unset "_LOGIN_CLASSIC_LAST_SERVICE[$ip]"
436: }
437: 
438: # =============================================================================
439: # MAIN OPERATIONS
440: # =============================================================================
441: 
442: # Start classic mode monitoring
443: nftban_login_classic_start() {
444:     if [[ $_LOGIN_CLASSIC_RUNNING -eq 1 ]]; then
445:         nftban_login_log "WARN" "Classic mode already running"
446:         return 0
447:     fi
448: 
449:     _LOGIN_CLASSIC_RUNNING=1
450:     nftban_login_log "INFO" "Starting classic mode monitoring"
451: 
452:     # Start SSH monitor if detected
453:     if nftban_login_service_detected "ssh"; then
454:         local units="${LOGIN_SERVICE_SSH_UNITS:-sshd,ssh}"
455:         _nftban_login_classic_monitor_journal "ssh" "$units" "" &
456:         _LOGIN_CLASSIC_MONITOR_PIDS[ssh]=$!
457:     fi
458: 
459:     # Start Dovecot monitor
460:     if nftban_login_service_detected "dovecot"; then
461:         local units="${LOGIN_SERVICE_DOVECOT_UNITS:-dovecot}"
462:         _nftban_login_classic_monitor_journal "dovecot" "$units" "" &
463:         _LOGIN_CLASSIC_MONITOR_PIDS[dovecot]=$!
464:     fi
465: 
466:     # Start Exim monitor
467:     if nftban_login_service_detected "exim"; then
468:         local units="${LOGIN_SERVICE_EXIM_UNITS:-exim,exim4}"
469:         _nftban_login_classic_monitor_journal "exim" "$units" "" &
470:         _LOGIN_CLASSIC_MONITOR_PIDS[exim]=$!
471:     fi
472: 
473:     # Start Postfix monitor
474:     if nftban_login_service_detected "postfix"; then
475:         local units="${LOGIN_SERVICE_POSTFIX_UNITS:-postfix}"
476:         _nftban_login_classic_monitor_journal "postfix" "$units" "" &
477:         _LOGIN_CLASSIC_MONITOR_PIDS[postfix]=$!
478:     fi
479: 
480:     # Start Pure-FTPd monitor
481:     if nftban_login_service_detected "pureftpd"; then
482:         local units="${LOGIN_SERVICE_PUREFTPD_UNITS:-pure-ftpd}"
483:         _nftban_login_classic_monitor_journal "pureftpd" "$units" "" &
484:         _LOGIN_CLASSIC_MONITOR_PIDS[pureftpd]=$!
485:     fi
486: 
487:     # Start vsftpd monitor
488:     if nftban_login_service_detected "vsftpd"; then
489:         local units="${LOGIN_SERVICE_VSFTPD_UNITS:-vsftpd}"
490:         _nftban_login_classic_monitor_journal "vsftpd" "$units" "" &
491:         _LOGIN_CLASSIC_MONITOR_PIDS[vsftpd]=$!
492:     fi
493: 
494:     # Start WordPress monitor (file-based)
495:     if nftban_login_service_detected "wordpress"; then
496:         local log_file=""
497:         for f in "${LOGIN_SERVICE_WORDPRESS_LOG_APACHE:-/var/log/apache2/access.log}" \
498:                  "${LOGIN_SERVICE_WORDPRESS_LOG_HTTPD:-/var/log/httpd/access_log}" \
499:                  "${LOGIN_SERVICE_WORDPRESS_LOG_NGINX:-/var/log/nginx/access.log}"; do
500:             [[ -f "$f" ]] && log_file="$f" && break
501:         done
502: 
503:         if [[ -n "$log_file" ]]; then
504:             _nftban_login_classic_monitor_file "wordpress" "$log_file" "" &
505:             _LOGIN_CLASSIC_MONITOR_PIDS[wordpress]=$!
506:         fi
507:     fi
508: 
509:     # Start DirectAdmin monitor (file-based)
510:     if nftban_login_service_detected "directadmin"; then
511:         local log_file="${LOGIN_SERVICE_DIRECTADMIN_LOG:-/var/log/directadmin/login.log}"
512:         if [[ -f "$log_file" ]]; then
513:             _nftban_login_classic_monitor_file "directadmin" "$log_file" "" &
514:             _LOGIN_CLASSIC_MONITOR_PIDS[directadmin]=$!
515:         fi
516:     fi
517: 
518:     # Wait for all monitors
519:     wait
520: }
521: 
522: # Stop classic mode monitoring
523: nftban_login_classic_stop() {
524:     _LOGIN_CLASSIC_RUNNING=0
525: 
526:     for service in "${!_LOGIN_CLASSIC_MONITOR_PIDS[@]}"; do
527:         local pid="${_LOGIN_CLASSIC_MONITOR_PIDS[$service]}"
528:         if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
529:             kill "$pid" 2>/dev/null
530:             nftban_login_log "INFO" "Stopped $service monitor (PID: $pid)"
531:         fi
532:         unset "_LOGIN_CLASSIC_MONITOR_PIDS[$service]"
533:     done
534: 
535:     # Save state
536:     _nftban_login_classic_save_state
537: }
538: 
539: # Save state to disk
540: _nftban_login_classic_save_state() {
541:     local state_file="${LOGIN_CLASSIC_STATE_FILE:-/var/lib/nftban/login-classic-state.db}"
542:     mkdir -p "$(dirname "$state_file")"
543: 
544:     {
545:         echo "# Login Classic State - $(date)"
546:         for key in "${!_LOGIN_CLASSIC_FAIL_COUNT[@]}"; do
547:             echo "_LOGIN_CLASSIC_FAIL_COUNT[$key]=${_LOGIN_CLASSIC_FAIL_COUNT[$key]}"
548:         done
549:         for key in "${!_LOGIN_CLASSIC_FAIL_FIRST[@]}"; do
550:             echo "_LOGIN_CLASSIC_FAIL_FIRST[$key]=${_LOGIN_CLASSIC_FAIL_FIRST[$key]}"
551:         done
552:     } > "$state_file"
553: }
554: 
555: # Get status
556: nftban_login_classic_status() {
557:     echo "Classic Mode Status:"
558:     echo "  Running: $_LOGIN_CLASSIC_RUNNING"
559:     echo "  Active Monitors:"
560:     for service in "${!_LOGIN_CLASSIC_MONITOR_PIDS[@]}"; do
561:         local pid="${_LOGIN_CLASSIC_MONITOR_PIDS[$service]}"
562:         local status="stopped"
563:         [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null && status="running (PID: $pid)"
564:         echo "    - $service: $status"
565:     done
566:     echo "  Tracked IPs: ${#_LOGIN_CLASSIC_FAIL_COUNT[@]}"
567: }
568: 
569: # Enable classic mode
570: nftban_login_classic_enable() {
571:     nftban_login_log "INFO" "Enabling classic mode"
572:     return 0
573: }
574: 
575: # Disable classic mode
576: nftban_login_classic_disable() {
577:     nftban_login_classic_stop
578:     return 0
579: }
580: 
581: # Test classic mode
582: nftban_login_classic_test() {
583:     echo "Classic Mode Test:"
584:     echo "  jq available: $(command -v jq &>/dev/null && echo "yes" || echo "no")"
585:     echo "  journalctl available: $(command -v journalctl &>/dev/null && echo "yes" || echo "no")"
586: 
587:     # Test pattern matching
588:     local test_line='Failed password for root from 192.168.1.100 port 22 ssh2'
589:     echo "  Testing pattern match..."
590:     if [[ "$test_line" =~ Failed\ password\ for\ ([^[:space:]]+)\ from\ ([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+) ]]; then
591:         echo "    User: ${BASH_REMATCH[1]}, IP: ${BASH_REMATCH[2]}"
592:         echo "    Pattern matching: OK"
593:     else
594:         echo "    Pattern matching: FAILED"
595:     fi
596: }
597: 
598: # =============================================================================
599: # EXPORTS
600: # =============================================================================
601: 
602: export -f nftban_login_classic_init
603: export -f nftban_login_classic_start
604: export -f nftban_login_classic_stop
605: export -f nftban_login_classic_status
606: export -f nftban_login_classic_enable
607: export -f nftban_login_classic_disable
608: export -f nftban_login_classic_test
</file>

<file path="cli/lib/nftban/core/nftban_output.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - Output & Banner Core Module
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Standardized output, banners, and formatting for all modules
  7: #
  8: # meta:name=nftban_output
  9: # meta:type=core
 10: # meta:header=Output & Banner Module
 11: # meta:version=1.0.0
 12: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 13: # meta:homepage=https://nftban.com
 14: #
 15: # **Description & Purpose**
 16: # meta:description=Core output module providing banners, formatting, and module load messages
 17: # meta:input=Configuration from conf.d/banner.conf, module meta fields
 18: # meta:output=Formatted banners, module load messages, error messages
 19: #
 20: # **Inventory & Requirements**
 21: # meta:depends=tput,uname,hostname,nft (optional)
 22: # meta:requires_env=NFTBAN_BANNER_MODE,NFTBAN_COLOR
 23: #
 24: # meta:created_date=2025-11-05
 25: # meta:updated_date=2025-11-24
 26: # meta:modified_date=2025-10-26
 27: 
 28: 
 29: # =============================================================================
 30: # PREVENT DOUBLE-LOADING
 31: # =============================================================================
 32: [[ -n "${NFTBAN_OUTPUT_LOADED:-}" ]] && return 0
 33: NFTBAN_OUTPUT_LOADED="true"
 34: 
 35: # =============================================================================
 36: # GLOBAL VARIABLES
 37: # =============================================================================
 38: 
 39: # Terminal detection
 40: NFTBAN_TTY="${NFTBAN_TTY:-$([ -t 1 ] && echo "true" || echo "false")}"
 41: 
 42: # Terminal width
 43: if [[ "${NFTBAN_WIDTH:-auto}" == "auto" ]]; then
 44:     NFTBAN_WIDTH="$(tput cols 2>/dev/null || echo 80)"
 45:     [[ $NFTBAN_WIDTH -lt 60 ]] && NFTBAN_WIDTH=60
 46:     [[ $NFTBAN_WIDTH -gt 120 ]] && NFTBAN_WIDTH=120
 47: fi
 48: 
 49: # Color support (respects NO_COLOR standard)
 50: if [[ "${NFTBAN_COLOR:-auto}" == "auto" ]]; then
 51:     NFTBAN_COLOR="$NFTBAN_TTY"
 52: fi
 53: [[ -n "${NO_COLOR:-}" ]] && NFTBAN_COLOR="false"
 54: 
 55: # Emoji/Unicode support

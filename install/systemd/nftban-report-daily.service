# =============================================================================
# NFTBan - Daily Report Service
# =============================================================================
# SPDX-License-Identifier: MPL-2.0
# meta:name="nftban-report-daily.service"
# meta:type="systemd"
# meta:owner="Antonios Voulvoulis <contact@nftban.com>"
# meta:description="Oneshot service for daily report generation"
# meta:inventory.files=""
# meta:inventory.binaries="/usr/sbin/nftban"
# meta:inventory.env_vars=""
# meta:inventory.config_files="/etc/nftban/nftban.conf"
# meta:inventory.systemd_units=""
# meta:inventory.network=""
# meta:inventory.privileges="root"
# =============================================================================

[Unit]
Description=NFTBan Daily Report Generation
Documentation=man:nftban(8)
After=nftband.service
Wants=nftband.service

[Service]
Type=oneshot

# Generate and optionally email the daily report
ExecStart=/usr/sbin/nftban report run daily

# Exit codes: 0=OK, non-zero=failure.
#
# v1.228.5 UNIT-TRUTH: this unit previously declared `SuccessExitStatus=0 1`, whose own
# comment described 1 as "error". systemd was therefore instructed to report a FAILED report
# run as a successful one. Combined with an unchecked write in the generator, a clean EL9
# Enforcing host produced a 0-byte report and a green unit — the failure was invisible to
# `systemctl status`, to `is-failed`, and to every gate that asserted on unit result.
#
# There is no separately documented, safe, non-error meaning for exit 1 anywhere in the
# report command path: `nftban report run` returns 1 only from its own error branches
# (unknown frequency, generation failure). The directive is removed rather than narrowed,
# so systemd's default applies: exit 0 succeeds, anything else fails.
# Type=oneshot units are not restarted on failure, so removing this does NOT introduce a
# restart loop — the concern the original comment was reaching for.

# =============================================================================
# SECURITY HARDENING
# =============================================================================

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

# Filesystem access
ReadOnlyPaths=/etc/nftban /var/lib/nftban /var/log/nftban
# v1.228.5: reports moved to /var/log/nftban/reports. The unit marked /var/log/nftban
# ReadOnly, so repointing the writer without this grant would fail EROFS — the sandbox
# would forbid the very destination the migration created.
ReadWritePaths=/var/log/nftban/reports /var/lib/nftban/reports

# Network for email delivery
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# Resource limits
MemoryMax=128M
TasksMax=10
TimeoutStartSec=300

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nftban-report-daily

[Install]
WantedBy=multi-user.target

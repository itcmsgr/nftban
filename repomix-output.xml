 180: nftban_watchdog_check_load() {
 181:     # Check system load average from /proc/loadavg
 182:     # Returns: status code, sets WATCHDOG_RESULTS
 183: 
 184:     if [[ "$NFTBAN_WATCHDOG_LOAD_ENABLED" != "true" ]]; then
 185:         return 0
 186:     fi
 187: 
 188:     # Structured read from /proc/loadavg - only some fields used
 189:     # shellcheck disable=SC2034
 190:     local load1 load5 load15 running_procs total_procs last_pid
 191:     # Must use default IFS (space) for reading space-separated values
 192:     if ! IFS=' ' read -r load1 load5 load15 running_procs last_pid < /proc/loadavg 2>/dev/null; then
 193:         WATCHDOG_RESULTS[load_status]="ERROR"
 194:         WATCHDOG_RESULTS[load_error]="Cannot read /proc/loadavg"
 195:         return $WATCHDOG_CRITICAL
 196:     fi
 197: 
 198:     # Parse running/total processes
 199:     local running total
 200:     running="${running_procs%/*}"
 201:     total="${running_procs#*/}"
 202: 
 203:     WATCHDOG_RESULTS[load_1m]="$load1"
 204:     WATCHDOG_RESULTS[load_5m]="$load5"
 205:     WATCHDOG_RESULTS[load_15m]="$load15"
 206:     WATCHDOG_RESULTS[procs_running]="$running"
 207:     WATCHDOG_RESULTS[procs_total]="$total"
 208: 
 209:     # Determine which load to check based on config
 210:     local check_load
 211:     case "$NFTBAN_WATCHDOG_LOAD_AVG" in
 212:         1)  check_load="$load1" ;;
 213:         15) check_load="$load15" ;;
 214:         *)  check_load="$load5" ;;
 215:     esac
 216: 
 217:     WATCHDOG_RESULTS[load_checked]="$check_load"
 218:     WATCHDOG_RESULTS[load_avg_type]="$NFTBAN_WATCHDOG_LOAD_AVG"
 219: 
 220:     # Compare using bc for floating point (or awk if bc not available)
 221:     local status=$WATCHDOG_OK
 222:     if command -v bc >/dev/null 2>&1; then
 223:         if (( $(echo "$check_load >= $NFTBAN_WATCHDOG_LOAD_CRITICAL" | bc -l) )); then
 224:             status=$WATCHDOG_CRITICAL
 225:             WATCHDOG_RESULTS[load_status]="CRITICAL"
 226:             if watchdog_should_alert "load"; then
 227:                 watchdog_alert "CRITICAL" "Load average CRITICAL: ${check_load} >= ${NFTBAN_WATCHDOG_LOAD_CRITICAL}"
 228:             fi
 229:         elif (( $(echo "$check_load >= $NFTBAN_WATCHDOG_LOAD_WARNING" | bc -l) )); then
 230:             status=$WATCHDOG_WARNING
 231:             WATCHDOG_RESULTS[load_status]="WARNING"
 232:             if watchdog_should_alert "load"; then
 233:                 watchdog_alert "WARNING" "Load average exceeded: ${check_load} >= ${NFTBAN_WATCHDOG_LOAD_WARNING}"
 234:             fi
 235:         else
 236:             WATCHDOG_RESULTS[load_status]="OK"
 237:         fi
 238:     else
 239:         # Fallback: use awk for comparison
 240:         if awk "BEGIN {exit !($check_load >= $NFTBAN_WATCHDOG_LOAD_CRITICAL)}"; then
 241:             status=$WATCHDOG_CRITICAL
 242:             WATCHDOG_RESULTS[load_status]="CRITICAL"
 243:             if watchdog_should_alert "load"; then
 244:                 watchdog_alert "CRITICAL" "Load average CRITICAL: ${check_load} >= ${NFTBAN_WATCHDOG_LOAD_CRITICAL}"
 245:             fi
 246:         elif awk "BEGIN {exit !($check_load >= $NFTBAN_WATCHDOG_LOAD_WARNING)}"; then
 247:             status=$WATCHDOG_WARNING
 248:             WATCHDOG_RESULTS[load_status]="WARNING"
 249:             if watchdog_should_alert "load"; then
 250:                 watchdog_alert "WARNING" "Load average exceeded: ${check_load} >= ${NFTBAN_WATCHDOG_LOAD_WARNING}"
 251:             fi
 252:         else
 253:             WATCHDOG_RESULTS[load_status]="OK"
 254:         fi
 255:     fi
 256: 
 257:     return $status
 258: }

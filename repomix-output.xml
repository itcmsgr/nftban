346: nftban_module_check_license() {
347:     # Check license compliance (INFORMATIONAL ONLY)
348:     # Reports: MPL-2.0 vs GPL vs missing licenses
349:     # Does NOT fix anything
350: 
351:     echo
352:     echo "════════════════════════════════════════════════════════════════════════════════════"
353:     printf "%s License Compliance Report — %s %s\n" "${C_BOLD:-}" "$NFTBAN_MODULE_TIMESTAMP" "${C_RESET:-}"
354:     echo "════════════════════════════════════════════════════════════════════════════════════"
355:     echo
356: 
357:     # Scan modules if not already done
358:     if [[ ${#NFTBAN_MODULE_INVENTORY[@]} -eq 0 ]]; then
359:         nftban_module_scan
360:     fi
361: 
362:     local total=0
363:     local mpl_count=0
364:     local gpl_count=0
365:     local missing_count=0
366:     local other_count=0
367: 
368:     local -a mpl_files=()
369:     local -a gpl_files=()
370:     local -a missing_files=()
371:     local -a other_files=()
372: 
373:     for file in "${!NFTBAN_MODULE_INVENTORY[@]}"; do
374:         total=$((total + 1))
375:         local license
376:         license="$(nftban_module_extract_license "$file")"
377: 
378:         if [[ "$license" == "MPL-2.0" ]]; then
379:             mpl_count=$((mpl_count + 1))
380:             mpl_files+=("$file")
381:         elif [[ "$license" =~ GPL ]]; then
382:             gpl_count=$((gpl_count + 1))
383:             gpl_files+=("$file")
384:         elif [[ -z "$license" ]]; then
385:             missing_count=$((missing_count + 1))
386:             missing_files+=("$file")
387:         else
388:             other_count=$((other_count + 1))
389:             other_files+=("$file")
390:         fi
391:     done
392: 
393:     echo "Summary:"
394:     echo "  Total Modules:      $total"
395:     echo "  ${C_GREEN:-}✔ MPL-2.0 (correct):${C_RESET:-}   $mpl_count ($(( mpl_count * 100 / total ))%)"
396:     echo "  ${C_RED:-}✖ GPL (wrong):${C_RESET:-}       $gpl_count"
397:     echo "  ${C_YELLOW:-}⚠ Missing License:${C_RESET:-}  $missing_count"
398:     [[ $other_count -gt 0 ]] && echo "  ${C_YELLOW:-}⚠ Other License:${C_RESET:-}    $other_count"
399:     echo
400: 
401:     if [[ $gpl_count -gt 0 ]]; then
402:         echo "${C_RED:-}CRITICAL: Scripts with GPL license (should be MPL-2.0):${C_RESET:-}"
403:         for file in "${gpl_files[@]}"; do
404:             local license
405:             license="$(nftban_module_extract_license "$file")"
406:             printf "  ✖ %-60s License: %s\n" "$(basename "$file")" "$license"
407:             echo "    Path: $file"
408:         done
409:         echo
410:     fi
411: 
412:     if [[ $missing_count -gt 0 ]]; then
413:         echo "${C_YELLOW:-}WARNING: Scripts missing SPDX license:${C_RESET:-}"
414:         for file in "${missing_files[@]}"; do
415:             printf "  ⚠ %s\n" "$(basename "$file")"
416:             echo "    Path: $file"
417:         done
418:         echo
419:     fi
420: 
421:     echo "Note: This is informational only. No files were modified."
422:     echo "      Standard: All scripts should have SPDX-License-Identifier: MPL-2.0"
423:     echo
424: }

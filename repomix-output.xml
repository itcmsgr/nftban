<file path="cli/lib/nftban/setup/validate_node_exporter.sh">
  1: #!/usr/bin/env bash
  2: # shellcheck disable=SC2034  # verbose used in eval context
  3: # =============================================================================
  4: # NFTBan v1.0.0 - Node Exporter Validation Script
  5: # =============================================================================
  6: # SPDX-License-Identifier: MPL-2.0
  7: # Purpose: Validate Node Exporter installation and configuration
  8: # Location: /usr/lib/nftban/setup/validate_node_exporter.sh
  9: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 10: # meta:homepage=https://nftban.com
 11: # nftban — Simplifying Linux Firewall Management
 12: #
 13: # meta:name=validate_node_exporter
 14: # meta:type=setup
 15: # meta:header=Node Exporter Validation
 16: # meta:version=1.0.0
 17: #
 18: # **Description & Purpose**
 19: # meta:description=Validate Node Exporter installation and NFTBan metrics integration
 20: # meta:input=Running Node Exporter instance
 21: # meta:output=Validation report with pass/fail status
 22: #
 23: # **Inventory & Requirements**
 24: # meta:depends=bash,curl,systemctl,netstat|ss
 25: #
 26: # meta:created_date=2025-11-17
 27: # =============================================================================
 28: 
 29: # Enhanced strict mode
 30: set -Eeuo pipefail
 31: IFS=$'\n\t'
 32: umask 027
 33: 
 34: # =============================================================================
 35: # CONFIGURATION
 36: # =============================================================================
 37: 
 38: SCRIPT_NAME="$(basename "${BASH_SOURCE[0]}")"
 39: readonly SCRIPT_NAME
 40: readonly NODE_EXPORTER_PORT=9100
 41: readonly TEXTFILE_COLLECTOR_DIR="/var/lib/node_exporter/textfile_collector"
 42: readonly NFTBAN_METRICS_FILE="${TEXTFILE_COLLECTOR_DIR}/nftban.prom"
 43: 
 44: # Colors for output
 45: readonly RED='\033[0;31m'
 46: readonly GREEN='\033[0;32m'
 47: readonly YELLOW='\033[0;33m'
 48: readonly BLUE='\033[0;34m'
 49: readonly NC='\033[0m' # No Color
 50: 
 51: # Test counters
 52: TOTAL_TESTS=0
 53: PASSED_TESTS=0
 54: FAILED_TESTS=0
 55: WARNING_TESTS=0
 56: 
 57: # =============================================================================
 58: # FUNCTIONS
 59: # =============================================================================
 60: 
 61: # Print colored message
 62: print_color() {
 63:     local color="$1"
 64:     shift
 65:     echo -e "${color}$*${NC}"
 66: }
 67: 
 68: # Print test header
 69: test_header() {
 70:     echo ""
 71:     print_color "$BLUE" "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
 72:     print_color "$BLUE" "TEST: $*"
 73:     print_color "$BLUE" "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
 74: }
 75: 
 76: # Print test result
 77: test_result() {
 78:     local status="$1"
 79:     local message="$2"
 80: 
 81:     TOTAL_TESTS=$((TOTAL_TESTS + 1))
 82: 
 83:     case "$status" in
 84:         PASS)
 85:             print_color "$GREEN" "✓ PASS: $message"
 86:             PASSED_TESTS=$((PASSED_TESTS + 1))
 87:             ;;
 88:         FAIL)
 89:             print_color "$RED" "✗ FAIL: $message"
 90:             FAILED_TESTS=$((FAILED_TESTS + 1))
 91:             ;;
 92:         WARN)
 93:             print_color "$YELLOW" "⚠ WARN: $message"
 94:             WARNING_TESTS=$((WARNING_TESTS + 1))
 95:             ;;
 96:     esac
 97: }
 98: 
 99: # Print usage
100: usage() {
101:     cat <<EOF
102: Usage: $SCRIPT_NAME [OPTIONS]
103: 
104: Validate Node Exporter installation and NFTBan metrics integration.
105: 
106: OPTIONS:
107:     --verbose               Show detailed output
108:     --skip-nftban-metrics  Skip NFTBan metrics validation (test Node Exporter only)
109:     --help                  Show this help message
110: 
111: EXAMPLES:
112:     # Standard validation
113:     $SCRIPT_NAME
114: 
115:     # Verbose mode
116:     $SCRIPT_NAME --verbose
117: 
118:     # Test Node Exporter only (without NFTBan metrics)
119:     $SCRIPT_NAME --skip-nftban-metrics
120: 
121: EXIT CODES:
122:     0 - All tests passed
123:     1 - One or more tests failed
124:     2 - Critical failure (Node Exporter not running)
125: 
126: EOF
127: }
128: 
129: # Test 1: Service status
130: test_service_status() {
131:     test_header "Service Status"
132: 
133:     # Detect service name
134:     local service_name=""
135:     if systemctl list-unit-files | grep -q "^node_exporter.service"; then
136:         service_name="node_exporter.service"
137:     elif systemctl list-unit-files | grep -q "^prometheus-node-exporter.service"; then
138:         service_name="prometheus-node-exporter.service"
139:     else
140:         test_result "FAIL" "Node Exporter service not found"
141:         return 1
142:     fi
143: 
144:     test_result "PASS" "Service found: $service_name"
145: 
146:     # Check if enabled
147:     if systemctl is-enabled --quiet "$service_name"; then
148:         test_result "PASS" "Service is enabled (starts on boot)"
149:     else
150:         test_result "WARN" "Service is not enabled (won't start on boot)"
151:     fi
152: 
153:     # Check if active
154:     if systemctl is-active --quiet "$service_name"; then
155:         test_result "PASS" "Service is active (running)"
156:     else
157:         test_result "FAIL" "Service is not running"
158:         echo "Check logs: journalctl -u $service_name -n 50"
159:         return 1
160:     fi
161: 
162:     # Check uptime
163:     local start_time
164:     start_time=$(systemctl show "$service_name" -p ActiveEnterTimestamp --value)
165:     if [[ -n "$start_time" ]]; then
166:         test_result "PASS" "Service started: $start_time"
167:     fi
168: 
169:     return 0
170: }
171: 
172: # Test 2: Network binding
173: test_network_binding() {
174:     test_header "Network Binding"
175: 
176:     # Check if listening on port
177:     if command -v netstat &>/dev/null; then
178:         local binding
179:         binding=$(netstat -tulnp 2>/dev/null | grep ":${NODE_EXPORTER_PORT}" | awk '{print $4}')
180: 
181:         if [[ -z "$binding" ]]; then
182:             test_result "FAIL" "Not listening on port $NODE_EXPORTER_PORT"
183:             return 1
184:         fi
185: 
186:         test_result "PASS" "Listening on: $binding"
187: 
188:         # Check if localhost-only
189:         if echo "$binding" | grep -q "127.0.0.1"; then
190:             test_result "PASS" "Bound to localhost only (SECURE)"
191:         elif echo "$binding" | grep -q "0.0.0.0"; then
192:             test_result "FAIL" "Bound to all interfaces (SECURITY RISK!)"
193:         else
194:             test_result "WARN" "Bound to specific IP: $binding"
195:         fi
196:     elif command -v ss &>/dev/null; then
197:         local binding
198:         binding=$(ss -tlnp 2>/dev/null | grep ":${NODE_EXPORTER_PORT}" | awk '{print $4}')
199: 
200:         if [[ -z "$binding" ]]; then
201:             test_result "FAIL" "Not listening on port $NODE_EXPORTER_PORT"
202:             return 1
203:         fi
204: 
205:         test_result "PASS" "Listening on: $binding"
206: 
207:         if echo "$binding" | grep -q "127.0.0.1"; then
208:             test_result "PASS" "Bound to localhost only (SECURE)"
209:         else
210:             test_result "WARN" "Not bound to localhost"
211:         fi
212:     else
213:         test_result "WARN" "Cannot check binding (netstat/ss not available)"
214:     fi
215: 
216:     return 0
217: }
218: 
219: # Test 3: Metrics endpoint
220: test_metrics_endpoint() {
221:     test_header "Metrics Endpoint"
222: 
223:     # Test HTTP connection
224:     if curl -s --max-time 5 "http://localhost:${NODE_EXPORTER_PORT}/metrics" >/dev/null; then
225:         test_result "PASS" "Metrics endpoint is accessible"
226:     else
227:         test_result "FAIL" "Cannot access metrics endpoint"
228:         return 1
229:     fi
230: 
231:     # Check for Node Exporter metrics
232:     if curl -s "http://localhost:${NODE_EXPORTER_PORT}/metrics" | grep -q "node_exporter_build_info"; then
233:         test_result "PASS" "Node Exporter metrics are present"

 441: nftban_nft_get_set_name() {
 442:     # Get the correct set name for an IP and operation
 443:     # Args: $1 = IP address, $2 = operation
 444:     # Returns: set name
 445: 
 446:     local ip="$1"
 447:     local operation="$2"
 448:     local suffix
 449: 
 450:     # Determine suffix based on IP version
 451:     if [[ "$ip" == *:* ]]; then
 452:         suffix="ipv6"
 453:     else
 454:         suffix="ipv4"
 455:     fi
 456: 
 457:     case "$operation" in
 458:         ban|unban|blacklist)
 459:             echo "blacklist_${suffix}"
 460:             ;;
 461:         whitelist)
 462:             echo "whitelist_${suffix}"
 463:             ;;
 464:         tempban|fail2ban)
 465:             echo "temp_ban_${suffix}"
 466:             ;;
 467:         feeds)
 468:             # Feeds are managed by nftban-core, not individual IPs
 469:             # Return set for individual IPs (not CIDRs)
 470:             echo "feeds_${suffix}"
 471:             ;;
 472:         *)
 473:             echo "ERROR: Unknown operation: $operation" >&2
 474:             return 1
 475:             ;;
 476:     esac
 477: }

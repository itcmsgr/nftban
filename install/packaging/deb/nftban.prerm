#!/bin/bash
# SPDX-License-Identifier: MPL-2.0
# SPDX-FileCopyrightText: Copyright (c) 2024-2025 NFTBan Development Team
#
# prerm script for nftban (main package)
# Stops all services before removal

set -e

case "$1" in
    remove|upgrade|deconfigure)
        # ==========================================================================
        # SECURITY: Remove immutable flag before uninstall/upgrade
        # ==========================================================================
        # Remove immutable flag to allow package manager to replace/remove the file
        # This runs on BOTH uninstall (remove) and upgrade
        if [ -f /usr/lib/nftban/lib/nft_schema.sh ]; then
            chattr -i /usr/lib/nftban/lib/nft_schema.sh 2>/dev/null || true
        fi

        echo "Stopping NFTBan services..."

        # Stop all timers first (complete list from install.sh)
        TIMERS=(
            "nftban-health.timer"
            "nftban-maintenance.timer"
            "nftban-watchdog.timer"
            "nftban-snapshot.timer"
            "nftban-rollback.timer"
            "nftban-metrics-exporter.timer"
            "nftban-suricata-update.timer"
            "nftban-queue.timer"
            "nftban-core-geoip.timer"
            "nftban-core-feeds.timer"
        )

        for timer in "${TIMERS[@]}"; do
            if systemctl is-active --quiet "$timer" 2>/dev/null; then
                echo "  Stopping: $timer"
                systemctl stop "$timer" 2>/dev/null || true
            fi
            if systemctl is-enabled --quiet "$timer" 2>/dev/null; then
                systemctl disable "$timer" 2>/dev/null || true
            fi
        done

        # Stop login monitor
        if systemctl is-active --quiet nftban-login-monitor.service 2>/dev/null; then
            echo "  Stopping: nftban-login-monitor.service"
            systemctl stop nftban-login-monitor.service 2>/dev/null || true
        fi
        systemctl disable nftban-login-monitor.service 2>/dev/null || true

        # Stop core services
        SERVICES=(
            "nftban-ui.service"
            "nftban.service"
        )

        for svc in "${SERVICES[@]}"; do
            if systemctl is-active --quiet "$svc" 2>/dev/null; then
                echo "  Stopping: $svc"
                systemctl stop "$svc" 2>/dev/null || true
            fi
            systemctl disable "$svc" 2>/dev/null || true
        done

        echo "NFTBan services stopped."
    ;;

    failed-upgrade)
    ;;

    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

exit 0

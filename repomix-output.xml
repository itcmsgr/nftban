<file path="cmd/nftban-ui/web/static/bandwidth/js/bandwidth.js">
  1: // SPDX-License-Identifier: MPL-2.0
  2: // SPDX-FileCopyrightText: Copyright (c) 2024-2025 NFTBan Development Team
  3: //
  4: // Bandwidth Monitoring Panel - Main JavaScript
  5: // Handles data fetching, chart updates, and UI interactions
  6: 
  7: /**
  8:  * Bandwidth Panel Controller
  9:  */
 10: class BandwidthPanel {
 11:     constructor() {
 12:         this.charts = {};
 13:         this.sparklines = {};
 14:         this.updateInterval = null;
 15:         this.refreshRate = 10000; // 10 seconds
 16:         this.useMockData = true; // Set to false when API is ready
 17:         this.mockDataPath = 'shared/api_test_data.json';
 18:         this.apiBasePath = '/api/v1/bandwidth';
 19: 
 20:         this.init();
 21:     }
 22: 
 23:     /**
 24:      * Initialize the bandwidth panel
 25:      */
 26:     async init() {
 27:         console.log('🚀 Initializing Bandwidth Panel...');
 28: 
 29:         // Wait for DOM to be ready
 30:         if (document.readyState === 'loading') {
 31:             document.addEventListener('DOMContentLoaded', () => this.setup());
 32:         } else {
 33:             this.setup();
 34:         }
 35:     }
 36: 
 37:     /**
 38:      * Setup the panel
 39:      */
 40:     async setup() {
 41:         try {
 42:             // Initialize charts
 43:             this.initializeCharts();
 44: 
 45:             // Load initial data
 46:             await this.loadData();
 47: 
 48:             // Start auto-refresh
 49:             this.startAutoRefresh();
 50: 
 51:             // Setup event listeners
 52:             this.setupEventListeners();
 53: 
 54:             console.log('✅ Bandwidth Panel initialized successfully');
 55:         } catch (error) {
 56:             console.error('❌ Failed to initialize Bandwidth Panel:', error);
 57:             this.showError('Failed to initialize bandwidth monitoring');
 58:         }
 59:     }
 60: 
 61:     /**
 62:      * Initialize all charts
 63:      */
 64:     initializeCharts() {
 65:         // Main bandwidth time-series chart
 66:         const bandwidthCanvas = document.getElementById('bandwidthChart');
 67:         if (bandwidthCanvas) {
 68:             const colors = getColors();
 69:             this.charts.bandwidth = createRealtimeChart(bandwidthCanvas, [
 70:                 {
 71:                     label: 'Receive (Mbps)',
 72:                     data: [],
 73:                     borderColor: colors.primary,
 74:                     backgroundColor: `${colors.primary}20`,
 75:                     tension: 0.4,
 76:                     fill: true
 77:                 },
 78:                 {
 79:                     label: 'Transmit (Mbps)',
 80:                     data: [],
 81:                     borderColor: colors.secondary,
 82:                     backgroundColor: `${colors.secondary}20`,
 83:                     tension: 0.4,
 84:                     fill: true
 85:                 }
 86:             ]);
 87:         }
 88: 
 89:         // Interface bar chart
 90:         const interfaceCanvas = document.getElementById('interfaceChart');
 91:         if (interfaceCanvas) {
 92:             this.charts.interface = createInterfaceBarChart(interfaceCanvas, [], [], []);
 93:         }
 94: 
 95:         // Protocol doughnut chart
 96:         const protocolCanvas = document.getElementById('protocolChart');
 97:         if (protocolCanvas) {
 98:             this.charts.protocol = createProtocolChart(protocolCanvas, {});
 99:         }
100: 
101:         // Sparklines for stat cards
102:         this.initializeSparklines();
103:     }
104: 
105:     /**
106:      * Initialize sparkline charts in stat cards
107:      */
108:     initializeSparklines() {
109:         const sparklineConfigs = [
110:             { id: 'sparklineRx', color: getColors().primary },
111:             { id: 'sparklineTx', color: getColors().secondary },
112:             { id: 'sparklineConnections', color: getColors().success },
113:             { id: 'sparklinePeak', color: getColors().warning }
114:         ];
115: 
116:         sparklineConfigs.forEach(config => {
117:             const canvas = document.getElementById(config.id);
118:             if (canvas) {
119:                 // Initialize with empty data
120:                 this.sparklines[config.id] = createSparkline(canvas, Array(30).fill(0), config.color);
121:             }
122:         });
123:     }
124: 
125:     /**
126:      * Load bandwidth data
127:      */
128:     async loadData() {
129:         try {
130:             this.showLoading(true);
131: 
132:             let data;
133:             if (this.useMockData) {
134:                 data = await this.loadMockData();
135:             } else {
136:                 data = await this.loadApiData();
137:             }
138: 
139:             this.updateUI(data);
140:             this.showLoading(false);
141:         } catch (error) {
142:             console.error('Failed to load data:', error);
143:             this.showError('Failed to load bandwidth data');
144:             this.showLoading(false);
145:         }
146:     }
147: 
148:     /**
149:      * Load mock data for development
150:      */
151:     async loadMockData() {
152:         try {
153:             const response = await fetch(this.mockDataPath);
154:             if (!response.ok) {
155:                 throw new Error(`HTTP ${response.status}`);
156:             }
157:             return await response.json();
158:         } catch (error) {
159:             console.error('Failed to load mock data:', error);
160:             throw error;
161:         }
162:     }
163: 
164:     /**
165:      * Load data from real API
166:      */
167:     async loadApiData() {
168:         try {
169:             const [current, history, interfaces] = await Promise.all([
170:                 fetch(`${this.apiBasePath}/current`).then(r => r.json()),
171:                 fetch(`${this.apiBasePath}/history?minutes=5`).then(r => r.json()),
172:                 fetch(`${this.apiBasePath}/interfaces`).then(r => r.json())
173:             ]);
174: 
175:             return {
176:                 bandwidth_current: current,
177:                 bandwidth_history: history,
178:                 bandwidth_interfaces: interfaces
179:             };
180:         } catch (error) {
181:             console.error('Failed to load API data:', error);
182:             throw error;
183:         }
184:     }
185: 
186:     /**
187:      * Update UI with new data
188:      */
189:     updateUI(data) {
190:         if (!data) return;
191: 
192:         // Update stat cards
193:         this.updateStatCards(data.bandwidth_current);
194: 
195:         // Update time-series chart
196:         this.updateBandwidthChart(data.bandwidth_history);
197: 
198:         // Update interface chart
199:         this.updateInterfaceChart(data.bandwidth_interfaces);
200: 
201:         // Update protocol chart
202:         if (data.bandwidth_current?.protocols) {
203:             this.updateProtocolChart(data.bandwidth_current.protocols);
204:         }
205: 
206:         // Update connections table
207:         if (data.bandwidth_connections) {
208:             this.updateConnectionsTable(data.bandwidth_connections);
209:         }
210: 
211:         // Update sparklines
212:         this.updateSparklines(data.bandwidth_history);
213: 
214:         // Update timestamp
215:         this.updateTimestamp();
216:     }
217: 
218:     /**
219:      * Update stat cards with current values
220:      */
221:     updateStatCards(current) {
222:         if (!current) return;
223: 
224:         // RX Bandwidth
225:         const rxElement = document.getElementById('statRxBandwidth');
226:         if (rxElement && current.total) {
227:             rxElement.textContent = formatBandwidth(current.total.rx_mbps);
228:         }
229: 
230:         // TX Bandwidth
231:         const txElement = document.getElementById('statTxBandwidth');
232:         if (txElement && current.total) {
233:             txElement.textContent = formatBandwidth(current.total.tx_mbps);
234:         }
235: 
236:         // Active Connections
237:         const connElement = document.getElementById('statConnections');
238:         if (connElement && current.connections) {
239:             connElement.textContent = current.connections.active.toLocaleString();
240:         }
241: 
242:         // Peak RX
243:         const peakElement = document.getElementById('statPeakRx');
244:         if (peakElement && current.peaks_5min) {
245:             peakElement.textContent = formatBandwidth(current.peaks_5min.rx_mbps);
246:         }
247:     }
248: 
249:     /**
250:      * Update bandwidth time-series chart
251:      */
252:     updateBandwidthChart(history) {
253:         if (!history || !history.data || !this.charts.bandwidth) return;
254: 
255:         const rxData = history.data.map(d => ({
256:             x: new Date(d.timestamp * 1000),
257:             y: d.rx_mbps
258:         }));
259: 
260:         const txData = history.data.map(d => ({
261:             x: new Date(d.timestamp * 1000),
262:             y: d.tx_mbps
263:         }));
264: 
265:         this.charts.bandwidth.data.datasets[0].data = rxData;
266:         this.charts.bandwidth.data.datasets[1].data = txData;
267:         this.charts.bandwidth.update('none');
268:     }
269: 
270:     /**
271:      * Update interface bar chart
272:      */
273:     updateInterfaceChart(interfaceData) {
274:         if (!interfaceData || !interfaceData.interfaces || !this.charts.interface) return;
275: 
276:         const labels = interfaceData.interfaces.map(i => i.name);
277:         const rxData = interfaceData.interfaces.map(i => i.rx_mbps);
278:         const txData = interfaceData.interfaces.map(i => i.tx_mbps);
279: 
280:         this.charts.interface.data.labels = labels;
281:         this.charts.interface.data.datasets[0].data = rxData;
282:         this.charts.interface.data.datasets[1].data = txData;
283:         this.charts.interface.update('none');
284:     }
285: 
286:     /**
287:      * Update protocol doughnut chart
288:      */
289:     updateProtocolChart(protocols) {
290:         if (!protocols || !this.charts.protocol) return;
291: 
292:         const data = [
293:             protocols.tcp?.packets || 0,
294:             protocols.udp?.packets || 0,
295:             protocols.icmp?.packets || 0
296:         ];
297: 
298:         this.charts.protocol.data.datasets[0].data = data;
299:         this.charts.protocol.update('none');
300:     }
301: 
302:     /**
303:      * Update sparklines with historical data
304:      */
305:     updateSparklines(history) {
306:         if (!history || !history.data) return;
307: 
308:         // Get last 30 data points
309:         const recentData = history.data.slice(-30);
310: 
311:         // RX sparkline
312:         if (this.sparklines.sparklineRx) {
313:             const rxData = recentData.map(d => d.rx_mbps);
314:             this.sparklines.sparklineRx.data.datasets[0].data = rxData;
315:             this.sparklines.sparklineRx.update('none');
316:         }
317: 
318:         // TX sparkline
319:         if (this.sparklines.sparklineTx) {
320:             const txData = recentData.map(d => d.tx_mbps);
321:             this.sparklines.sparklineTx.data.datasets[0].data = txData;
322:             this.sparklines.sparklineTx.update('none');
323:         }
324: 
325:         // Connections sparkline (use RX as proxy for now)
326:         if (this.sparklines.sparklineConnections) {
327:             const connData = recentData.map(d => d.rx_mbps + d.tx_mbps);
328:             this.sparklines.sparklineConnections.data.datasets[0].data = connData;
329:             this.sparklines.sparklineConnections.update('none');
330:         }
331: 
332:         // Peak sparkline
333:         if (this.sparklines.sparklinePeak) {
334:             const peakData = recentData.map(d => Math.max(d.rx_mbps, d.tx_mbps));
335:             this.sparklines.sparklinePeak.data.datasets[0].data = peakData;
336:             this.sparklines.sparklinePeak.update('none');
337:         }
338:     }
339: 
340:     /**
341:      * Update connections table
342:      */
343:     updateConnectionsTable(connectionsData) {
344:         const tbody = document.getElementById('connectionsTableBody');
345:         if (!tbody || !connectionsData || !connectionsData.connections) return;
346: 
347:         tbody.innerHTML = '';
348: 
349:         connectionsData.connections.slice(0, 10).forEach(conn => {
350:             const row = tbody.insertRow();
351:             row.innerHTML = `
352:                 <td class="px-4 py-2 text-sm">${conn.remote_ip}</td>
353:                 <td class="px-4 py-2 text-sm">${conn.remote_port}</td>
354:                 <td class="px-4 py-2 text-sm uppercase">${conn.protocol}</td>
355:                 <td class="px-4 py-2 text-sm">${conn.state}</td>
356:                 <td class="px-4 py-2 text-sm">${formatBytes(conn.rx_bytes)}</td>
357:                 <td class="px-4 py-2 text-sm">${formatBytes(conn.tx_bytes)}</td>
358:             `;
359:         });
360: 
361:         if (connectionsData.connections.length === 0) {
362:             const row = tbody.insertRow();
363:             row.innerHTML = '<td colspan="6" class="px-4 py-4 text-center text-sm text-gray-500">No active connections</td>';
364:         }
365:     }
366: 
367:     /**
368:      * Update last updated timestamp
369:      */
370:     updateTimestamp() {
371:         const element = document.getElementById('lastUpdated');
372:         if (element) {
373:             const now = new Date();
374:             element.textContent = now.toLocaleTimeString();
375:         }
376:     }
377: 
378:     /**
379:      * Start auto-refresh interval
380:      */
381:     startAutoRefresh() {
382:         // Clear existing interval
383:         if (this.updateInterval) {
384:             clearInterval(this.updateInterval);
385:         }
386: 
387:         // Set new interval
388:         this.updateInterval = setInterval(() => {
389:             this.loadData();
390:         }, this.refreshRate);
391: 
392:         console.log(`🔄 Auto-refresh started (every ${this.refreshRate / 1000}s)`);
393:     }
394: 
395:     /**
396:      * Stop auto-refresh interval
397:      */
398:     stopAutoRefresh() {
399:         if (this.updateInterval) {
400:             clearInterval(this.updateInterval);
401:             this.updateInterval = null;
402:             console.log('⏸️ Auto-refresh stopped');
403:         }
404:     }
405: 
406:     /**
407:      * Setup event listeners
408:      */
409:     setupEventListeners() {
410:         // Refresh button
411:         const refreshBtn = document.getElementById('refreshBtn');
412:         if (refreshBtn) {
413:             refreshBtn.addEventListener('click', () => this.loadData());
414:         }
415: 
416:         // Pause/Resume button
417:         const pauseBtn = document.getElementById('pauseBtn');
418:         if (pauseBtn) {
419:             pauseBtn.addEventListener('click', () => this.toggleAutoRefresh());
420:         }
421: 
422:         // Listen for panel visibility changes
423:         document.addEventListener('visibilitychange', () => {
424:             if (document.hidden) {
425:                 this.stopAutoRefresh();
426:             } else {
427:                 this.startAutoRefresh();
428:                 this.loadData();
429:             }
430:         });
431:     }
432: 
433:     /**
434:      * Toggle auto-refresh on/off
435:      */
436:     toggleAutoRefresh() {
437:         if (this.updateInterval) {
438:             this.stopAutoRefresh();
439:         } else {
440:             this.startAutoRefresh();
441:         }
442:     }
443: 
444:     /**
445:      * Show loading indicator
446:      */
447:     showLoading(show) {
448:         const indicator = document.getElementById('loadingIndicator');
449:         if (indicator) {
450:             indicator.style.display = show ? 'block' : 'none';
451:         }
452:     }
453: 
454:     /**
455:      * Show error message
456:      */
457:     showError(message) {
458:         const errorElement = document.getElementById('errorMessage');
459:         if (errorElement) {
460:             errorElement.textContent = message;
461:             errorElement.style.display = 'block';
462: 
463:             // Auto-hide after 5 seconds
464:             setTimeout(() => {
465:                 errorElement.style.display = 'none';
466:             }, 5000);
467:         }
468:     }
469: 
470:     /**
471:      * Cleanup when panel is destroyed
472:      */
473:     destroy() {
474:         this.stopAutoRefresh();
475: 
476:         // Destroy charts
477:         Object.values(this.charts).forEach(chart => {
478:             if (chart) chart.destroy();
479:         });
480: 
481:         Object.values(this.sparklines).forEach(chart => {
482:             if (chart) chart.destroy();
483:         });
484: 
485:         console.log('🧹 Bandwidth Panel destroyed');
486:     }
487: }
488: 
489: // Initialize bandwidth panel when script loads
490: let bandwidthPanel;
491: 
492: if (document.readyState === 'loading') {
493:     document.addEventListener('DOMContentLoaded', () => {
494:         bandwidthPanel = new BandwidthPanel();
495:     });
496: } else {
497:     bandwidthPanel = new BandwidthPanel();
498: }
499: 
500: // Export for use in other modules
501: if (typeof module !== 'undefined' && module.exports) {
502:     module.exports = BandwidthPanel;
503: }
</file>

<file path="cmd/nftban-ui/web/static/bandwidth/js/chart-utils.js">
  1: // SPDX-License-Identifier: MPL-2.0
  2: // SPDX-FileCopyrightText: Copyright (c) 2024-2025 NFTBan Development Team
  3: //
  4: // Chart.js Utilities for NFTBan Bandwidth Monitoring
  5: // Provides reusable chart configurations and helpers
  6: 
  7: /**
  8:  * Chart color schemes for dark and light themes
  9:  */
 10: const ChartColors = {
 11:     dark: {
 12:         primary: 'rgb(59, 130, 246)',      // Blue
 13:         secondary: 'rgb(249, 115, 22)',    // Orange
 14:         success: 'rgb(34, 197, 94)',       // Green
 15:         warning: 'rgb(251, 146, 60)',      // Amber
 16:         danger: 'rgb(239, 68, 68)',        // Red
 17:         text: 'rgb(248, 249, 250)',        // Light gray
 18:         grid: 'rgba(45, 49, 57, 0.5)',     // Dark gray
 19:         background: 'rgba(26, 29, 35, 0.8)'
 20:     },
 21:     light: {
 22:         primary: 'rgb(59, 130, 246)',
 23:         secondary: 'rgb(249, 115, 22)',
 24:         success: 'rgb(34, 197, 94)',
 25:         warning: 'rgb(251, 146, 60)',
 26:         danger: 'rgb(239, 68, 68)',
 27:         text: 'rgb(11, 12, 14)',
 28:         grid: 'rgba(229, 231, 235, 0.5)',
 29:         background: 'rgba(255, 255, 255, 0.8)'
 30:     }
 31: };
 32: 
 33: /**
 34:  * Current theme ('dark' or 'light')
 35:  */
 36: let currentTheme = document.documentElement.classList.contains('light') ? 'light' : 'dark';
 37: 
 38: /**
 39:  * Get colors for current theme
 40:  */
 41: function getColors() {
 42:     return ChartColors[currentTheme];
 43: }
 44: 
 45: /**
 46:  * Update Chart.js global defaults for theme
 47:  */
 48: function updateChartDefaults() {
 49:     const colors = getColors();
 50: 
 51:     Chart.defaults.color = colors.text;
 52:     Chart.defaults.borderColor = colors.grid;
 53:     Chart.defaults.backgroundColor = colors.background;
 54: 
 55:     Chart.defaults.plugins.legend.labels.color = colors.text;
 56:     Chart.defaults.plugins.tooltip.backgroundColor = colors.background;
 57:     Chart.defaults.plugins.tooltip.titleColor = colors.text;
 58:     Chart.defaults.plugins.tooltip.bodyColor = colors.text;
 59:     Chart.defaults.plugins.tooltip.borderColor = colors.grid;
 60:     Chart.defaults.plugins.tooltip.borderWidth = 1;
 61: 
 62:     Chart.defaults.scale.grid.color = colors.grid;
 63:     Chart.defaults.scale.ticks.color = colors.text;
 64: }
 65: 
 66: /**
 67:  * Create base chart configuration
 68:  * @param {string} type - Chart type (line, bar, doughnut, etc.)
 69:  * @param {Object} options - Additional options to merge
 70:  * @returns {Object} Chart configuration
 71:  */
 72: function createChartConfig(type, options = {}) {
 73:     const colors = getColors();
 74: 
 75:     const baseConfig = {
 76:         type: type,
 77:         options: {
 78:             responsive: true,
 79:             maintainAspectRatio: false,
 80:             interaction: {
 81:                 intersect: false,
 82:                 mode: 'index'
 83:             },
 84:             plugins: {
 85:                 legend: {
 86:                     display: true,
 87:                     position: 'top',
 88:                     labels: {
 89:                         usePointStyle: true,
 90:                         padding: 15,
 91:                         font: {
 92:                             size: 12,
 93:                             family: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif'
 94:                         }
 95:                     }
 96:                 },
 97:                 tooltip: {
 98:                     enabled: true,
 99:                     backgroundColor: colors.background,
100:                     titleColor: colors.text,
101:                     bodyColor: colors.text,
102:                     borderColor: colors.grid,
103:                     borderWidth: 1,
104:                     padding: 12,
105:                     displayColors: true,
106:                     callbacks: {
107:                         label: function(context) {
108:                             let label = context.dataset.label || '';
109:                             if (label) {
110:                                 label += ': ';
111:                             }
112:                             if (context.parsed.y !== null) {
113:                                 label += context.parsed.y.toFixed(2);
114:                             }
115:                             return label;
116:                         }
117:                     }
118:                 }
119:             },
120:             scales: {
121:                 x: {
122:                     grid: {
123:                         display: true,
124:                         color: colors.grid
125:                     },
126:                     ticks: {
127:                         color: colors.text
128:                     }
129:                 },
130:                 y: {
131:                     grid: {
132:                         display: true,
133:                         color: colors.grid
134:                     },
135:                     ticks: {
136:                         color: colors.text
137:                     }
138:                 }
139:             }
140:         }
141:     };
142: 
143:     // Deep merge options
144:     return deepMerge(baseConfig, options);
145: }
146: 
147: /**
148:  * Create real-time line chart for bandwidth monitoring
149:  * @param {HTMLCanvasElement} canvas - Canvas element
150:  * @param {Array} datasets - Dataset configurations
151:  * @returns {Chart} Chart instance
152:  */
153: function createRealtimeChart(canvas, datasets = []) {
154:     const colors = getColors();
155: 
156:     const config = createChartConfig('line', {
157:         data: {
158:             datasets: datasets
159:         },
160:         options: {
161:             scales: {
162:                 x: {
163:                     type: 'time',
164:                     time: {
165:                         unit: 'second',
166:                         displayFormats: {
167:                             second: 'HH:mm:ss'
168:                         },
169:                         tooltipFormat: 'HH:mm:ss'
170:                     },
171:                     title: {
172:                         display: true,
173:                         text: 'Time',
174:                         color: colors.text
175:                     }
176:                 },
177:                 y: {
178:                     beginAtZero: true,
179:                     title: {
180:                         display: true,
181:                         text: 'Bandwidth (Mbps)',
182:                         color: colors.text
183:                     }
184:                 }
185:             },
186:             animation: {
187:                 duration: 300
188:             }
189:         }
190:     });
191: 
192:     return new Chart(canvas, config);
193: }
194: 
195: /**
196:  * Create sparkline chart (minimal chart for stat cards)
197:  * @param {HTMLCanvasElement} canvas - Canvas element
198:  * @param {Array} data - Data points
199:  * @param {string} color - Line color
200:  * @returns {Chart} Chart instance
201:  */
202: function createSparkline(canvas, data, color) {
203:     const colors = getColors();
204: 
205:     return new Chart(canvas, {
206:         type: 'line',
207:         data: {
208:             labels: data.map((_, i) => i),
209:             datasets: [{
210:                 data: data,
211:                 borderColor: color || colors.primary,
212:                 backgroundColor: `${color || colors.primary}20`,
213:                 borderWidth: 2,
214:                 fill: true,
215:                 pointRadius: 0,
216:                 tension: 0.4
217:             }]
218:         },
219:         options: {
220:             responsive: true,
221:             maintainAspectRatio: false,
222:             plugins: {
223:                 legend: { display: false },
224:                 tooltip: { enabled: false }
225:             },
226:             scales: {
227:                 x: { display: false },
228:                 y: { display: false }
229:             },
230:             elements: {
231:                 line: {
232:                     borderWidth: 2
233:                 }
234:             }
235:         }
236:     });
237: }
238: 
239: /**
240:  * Create horizontal bar chart for interface comparison
241:  * @param {HTMLCanvasElement} canvas - Canvas element
242:  * @param {Array} labels - Interface names
243:  * @param {Array} rxData - Receive data
244:  * @param {Array} txData - Transmit data
245:  * @returns {Chart} Chart instance
246:  */
247: function createInterfaceBarChart(canvas, labels, rxData, txData) {
248:     const colors = getColors();
249: 
250:     const config = createChartConfig('bar', {
251:         data: {
252:             labels: labels,
253:             datasets: [
254:                 {
255:                     label: 'Receive (Mbps)',
256:                     data: rxData,
257:                     backgroundColor: `${colors.primary}80`,
258:                     borderColor: colors.primary,
259:                     borderWidth: 1
260:                 },
261:                 {
262:                     label: 'Transmit (Mbps)',
263:                     data: txData,
264:                     backgroundColor: `${colors.secondary}80`,
265:                     borderColor: colors.secondary,
266:                     borderWidth: 1
267:                 }
268:             ]
269:         },
270:         options: {
271:             indexAxis: 'y',
272:             scales: {
273:                 x: {
274:                     beginAtZero: true,
275:                     title: {
276:                         display: true,
277:                         text: 'Bandwidth (Mbps)',
278:                         color: colors.text
279:                     }
280:                 },
281:                 y: {
282:                     title: {
283:                         display: true,
284:                         text: 'Interface',
285:                         color: colors.text
286:                     }
287:                 }
288:             }
289:         }
290:     });
291: 
292:     return new Chart(canvas, config);
293: }
294: 
295: /**
296:  * Create doughnut chart for protocol breakdown
297:  * @param {HTMLCanvasElement} canvas - Canvas element
298:  * @param {Object} protocolData - Protocol data {tcp, udp, icmp}
299:  * @returns {Chart} Chart instance
300:  */
301: function createProtocolChart(canvas, protocolData) {
302:     const colors = getColors();
303: 
304:     const labels = ['TCP', 'UDP', 'ICMP'];
305:     const data = [
306:         protocolData.tcp?.packets || 0,
307:         protocolData.udp?.packets || 0,
308:         protocolData.icmp?.packets || 0
309:     ];
310: 
311:     const backgroundColors = [
312:         `${colors.primary}80`,
313:         `${colors.secondary}80`,
314:         `${colors.success}80`
315:     ];
316: 
317:     const borderColors = [
318:         colors.primary,
319:         colors.secondary,
320:         colors.success
321:     ];
322: 
323:     return new Chart(canvas, {
324:         type: 'doughnut',
325:         data: {
326:             labels: labels,
327:             datasets: [{
328:                 data: data,
329:                 backgroundColor: backgroundColors,
330:                 borderColor: borderColors,
331:                 borderWidth: 2
332:             }]
333:         },
334:         options: {
335:             responsive: true,
336:             maintainAspectRatio: false,
337:             plugins: {
338:                 legend: {
339:                     display: true,
340:                     position: 'right'
341:                 },
342:                 tooltip: {
343:                     callbacks: {
344:                         label: function(context) {
345:                             const label = context.label || '';
346:                             const value = context.parsed || 0;
347:                             const total = context.dataset.data.reduce((a, b) => a + b, 0);
348:                             const percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
349:                             return `${label}: ${value.toLocaleString()} (${percentage}%)`;
350:                         }
351:                     }
352:                 }
353:             }
354:         }
355:     });
356: }
357: 
358: /**
359:  * Update all charts when theme changes
360:  * @param {string} theme - New theme ('dark' or 'light')
361:  */
362: function updateChartsTheme(theme) {
363:     currentTheme = theme;
364:     updateChartDefaults();
365: 
366:     // Update all existing chart instances
367:     Chart.instances.forEach(chart => {
368:         chart.update('none'); // Update without animation
369:     });
370: }
371: 
372: /**
373:  * Format bytes to human readable format
374:  * @param {number} bytes - Bytes
375:  * @param {number} decimals - Decimal places
376:  * @returns {string} Formatted string
377:  */
378: function formatBytes(bytes, decimals = 2) {
379:     if (bytes === 0) return '0 Bytes';
380: 
381:     const k = 1024;
382:     const dm = decimals < 0 ? 0 : decimals;
383:     const sizes = ['Bytes', 'KB', 'MB', 'GB', 'TB'];
384: 
385:     const i = Math.floor(Math.log(bytes) / Math.log(k));
386: 
387:     return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + ' ' + sizes[i];
388: }
389: 
390: /**
391:  * Format Mbps with appropriate unit
392:  * @param {number} mbps - Megabits per second
393:  * @returns {string} Formatted string
394:  */
395: function formatBandwidth(mbps) {
396:     if (mbps < 1) {
397:         return (mbps * 1000).toFixed(0) + ' Kbps';
398:     } else if (mbps < 1000) {
399:         return mbps.toFixed(2) + ' Mbps';
400:     } else {
401:         return (mbps / 1000).toFixed(2) + ' Gbps';
402:     }
403: }
404: 
405: /**
406:  * Deep merge two objects
407:  * @param {Object} target - Target object
408:  * @param {Object} source - Source object
409:  * @returns {Object} Merged object
410:  */
411: function deepMerge(target, source) {
412:     const output = Object.assign({}, target);
413: 
414:     if (isObject(target) && isObject(source)) {
415:         Object.keys(source).forEach(key => {
416:             if (isObject(source[key])) {
417:                 if (!(key in target)) {
418:                     Object.assign(output, { [key]: source[key] });
419:                 } else {
420:                     output[key] = deepMerge(target[key], source[key]);
421:                 }
422:             } else {
423:                 Object.assign(output, { [key]: source[key] });
424:             }
425:         });
426:     }
427: 
428:     return output;
429: }
430: 
431: /**
432:  * Check if value is an object
433:  * @param {*} item - Value to check
434:  * @returns {boolean} True if object
435:  */
436: function isObject(item) {
437:     return item && typeof item === 'object' && !Array.isArray(item);
438: }
439: 
440: // Initialize Chart.js defaults
441: updateChartDefaults();
442: 
443: // Export functions (if using modules)
444: if (typeof module !== 'undefined' && module.exports) {
445:     module.exports = {
446:         createChartConfig,
447:         createRealtimeChart,
448:         createSparkline,
449:         createInterfaceBarChart,
450:         createProtocolChart,
451:         updateChartsTheme,
452:         formatBytes,
453:         formatBandwidth,
454:         getColors
455:     };
456: }
</file>


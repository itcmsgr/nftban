# =============================================================================
# NFTBan v1.0.0 - System Watchdog Timer
# =============================================================================
# SPDX-License-Identifier: MPL-2.0
# Purpose: Systemd timer unit for NFTBan system watchdog
#
# meta:name="nftban_watchdog_timer"
# meta:type="config"
# meta:owner="Antonios Voulvoulis <contact@nftban.com>"
# meta:created_date="2025-10-26"
# meta:description="Timer that triggers NFTBan watchdog every 120 seconds (2 minutes)"
# meta:input="None"
# meta:output="Triggers nftban-watchdog.service"
# meta:depends="nftban-watchdog.service"
#
# meta:inventory.files=""
# meta:inventory.binaries=""
# meta:inventory.env_vars=""
# meta:inventory.config_files=""
# meta:inventory.systemd_units="nftban-watchdog.service"
# meta:inventory.network=""
# meta:inventory.privileges="none"
# =============================================================================

[Unit]
Description=NFTBan System Watchdog Timer
Documentation=man:nftban(8)
# v1.19.0: Removed Requires= — causes timer to stop when oneshot completes (Task 47)

[Timer]
# Start 2 minutes after boot
OnBootSec=2min

# Run every 120 seconds (2 minutes) for responsive alerting
# CSF uses 60s, we use 120s for less overhead while maintaining responsiveness
OnUnitActiveSec=120s

# Allow some variance to prevent load spikes
AccuracySec=10s

# JITTER: ~12.5% variance (15s on 120s interval)
RandomizedDelaySec=15s

# DETERMINISTIC: Same offset per host for predictable behavior
FixedRandomDelay=true

# Persist timer across reboots
Persistent=true

# Unit to activate
Unit=nftban-watchdog.service

[Install]
WantedBy=timers.target

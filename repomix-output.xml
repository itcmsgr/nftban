  96: nftban_cmd_port() {
  97:     # Handle port subcommands
  98:     # Args: $@ = port subcommand and arguments
  99: 
 100:     local subcmd="${1:-status}"
 101:     shift || true
 102: 
 103:     # Check root for port scanning
 104:     if [[ $EUID -ne 0 ]]; then
 105:         echo "ERROR: Port scanning requires root privileges" >&2
 106:         echo "Please run: sudo nftban port $subcmd" >&2
 107:         exit 1
 108:     fi
 109: 
 110:     case "$subcmd" in
 111:         status|list)
 112:             # Show port status (terminal output)
 113:             # Optional: port filter as argument
 114:             # NOTE: 'list' is deprecated, use 'status' instead
 115: 
 116:             # Check for --json flag
 117:             if [[ "${1:-}" == "--json" ]]; then
 118:                 export NFTBAN_PORT_FILTER_PORTS="${2:-}"
 119:                 export NFTBAN_PORT_DETAILED=0
 120:                 export NFTBAN_PORT_OUTPUT_FORMAT="json"
 121:                 nftban_port_report_status
 122:                 return $?
 123:             fi
 124: 
 125:             # Show standard banner
 126:             nftban_banner
 127: 
 128:             export NFTBAN_PORT_FILTER_PORTS="${1:-}"
 129:             export NFTBAN_PORT_DETAILED=0
 130:             export NFTBAN_PORT_OUTPUT_FORMAT="table"
 131:             nftban_port_report_status
 132:             return $?
 133:             ;;
 134: 
 135:         detailed)
 136:             # Show detailed port status with BIND and PROCESS columns
 137: 
 138:             # Show standard banner
 139:             nftban_banner
 140: 
 141:             export NFTBAN_PORT_FILTER_PORTS="${1:-}"
 142:             export NFTBAN_PORT_DETAILED=1
 143:             export NFTBAN_PORT_OUTPUT_FORMAT="table"
 144:             nftban_port_report_status
 145:             return $?
 146:             ;;
 147: 
 148:         html-report)
 149:             # Generate HTML report
 150:             echo "Generating HTML port report..."
 151:             local report_file
 152:             report_file=$(nftban_port_generate_html_report)
 153:             if [[ $? -eq 0 && -f "$report_file" ]]; then
 154:                 echo "✓ HTML report generated successfully:"
 155:                 echo "  $report_file"
 156:                 echo
 157:                 echo "View with: firefox '$report_file' (or your preferred browser)"
 158:                 return 0
 159:             else
 160:                 echo "ERROR: Failed to generate HTML report" >&2
 161:                 return 1
 162:             fi
 163:             ;;
 164: 
 165:         mail-report)
 166:             # Mail port report
 167:             # Args: [path] [recipient]
 168:             local report_path="${1:-}"
 169:             local recipient="${2:-${NFTBAN_MAIL_REPORT_RECIPIENT:-}}"
 170: 
 171:             if [[ -z "$recipient" ]]; then
 172:                 echo "ERROR: No recipient specified" >&2
 173:                 echo "Set NFTBAN_MAIL_REPORT_RECIPIENT in config or provide recipient as argument" >&2
 174:                 echo "Usage: nftban port mail-report [path] [recipient]" >&2
 175:                 return 1
 176:             fi
 177: 
 178:             # Check if mail module is available
 179:             if [[ ! $(type -t nftban_mail_send) == "function" ]]; then
 180:                 echo "ERROR: Mail module not available" >&2
 181:                 echo "Please ensure nftban_mail.sh is installed" >&2
 182:                 return 1
 183:             fi
 184: 
 185:             # If path provided, mail that file
 186:             if [[ -n "$report_path" ]]; then
 187:                 if [[ ! -f "$report_path" ]]; then
 188:                     echo "ERROR: Report file not found: $report_path" >&2
 189:                     return 1
 190:                 fi
 191:                 echo "Sending port report to $recipient..."
 192:                 nftban_mail_send "$report_path" "$recipient"
 193:                 return $?
 194:             else
 195:                 # Generate report and mail it
 196:                 echo "Generating HTML report and sending to $recipient..."
 197:                 local report_file
 198:                 report_file=$(nftban_port_generate_html_report)
 199:                 if [[ $? -eq 0 && -f "$report_file" ]]; then
 200:                     echo "✓ Report generated: $report_file"
 201:                     echo "Sending via email..."
 202:                     nftban_mail_send "$report_file" "$recipient"
 203:                     return $?
 204:                 else
 205:                     echo "ERROR: Failed to generate HTML report" >&2
 206:                     return 1
 207:                 fi
 208:             fi
 209:             ;;
 210: 
 211:         add)
 212:             # Add port to whitelist
 213:             # Args: <port> [protocol]
 214:             local port="${1:-}"
 215:             local proto="${2:-both}"  # Default to BOTH protocols
 216: 
 217:             if [[ -z "$port" ]]; then
 218:                 echo "ERROR: Port number required" >&2
 219:                 echo "Usage: nftban port add <port> [protocol]" >&2
 220:                 echo "       protocol: both (default), tcp, or udp" >&2
 221:                 echo "" >&2
 222:                 echo "Examples:" >&2
 223:                 echo "  nftban port add 8080           # Add TCP+UDP port 8080 (safest)" >&2
 224:                 echo "  nftban port add 53 udp         # Add only UDP port 53" >&2
 225:                 echo "  nftban port add 443 tcp        # Add only TCP port 443" >&2
 226:                 return 1
 227:             fi
 228: 
 229:             # Validate port number
 230:             if ! [[ "$port" =~ ^[0-9]+$ ]] || [[ "$port" -lt 1 ]] || [[ "$port" -gt 65535 ]]; then
 231:                 echo "ERROR: Invalid port number: $port" >&2
 232:                 echo "Port must be between 1-65535" >&2
 233:                 return 1
 234:             fi
 235: 
 236:             # Normalize protocol
 237:             case "${proto,,}" in
 238:                 tcp|t)
 239:                     proto="T"
 240:                     proto_name="TCP"
 241:                     ;;
 242:                 udp|u)
 243:                     proto="U"
 244:                     proto_name="UDP"
 245:                     ;;
 246:                 both|b|tcp+udp)
 247:                     proto="B"
 248:                     proto_name="TCP+UDP"
 249:                     ;;
 250:                 *)
 251:                     echo "ERROR: Invalid protocol: $proto" >&2
 252:                     echo "Valid protocols: tcp, udp, both" >&2
 253:                     return 1
 254:                     ;;
 255:             esac
 256: 
 257:             # Create ports.d directory if missing
 258:             mkdir -p ${NFTBAN_CONFIG_DIR}/ports.d
 259:             chmod 750 ${NFTBAN_CONFIG_DIR}/ports.d
 260:             chown root:nftban ${NFTBAN_CONFIG_DIR}/ports.d 2>/dev/null || true
 261: 
 262:             # Use 90-custom.conf for user-added ports
 263:             local config_file="${NFTBAN_CONFIG_DIR}/ports.d/90-custom.conf"
 264: 
 265:             # Check if port already exists
 266:             if [[ -f "$config_file" ]] && grep -qE "^${port}\|" "$config_file" 2>/dev/null; then
 267:                 echo "⚠ Port $port already in whitelist: $config_file" >&2
 268:                 echo "Current entry:" >&2
 269:                 grep -E "^${port}\|" "$config_file" 2>/dev/null
 270:                 return 0
 271:             fi
 272: 
 273:             # Add port to config
 274:             echo "# Added by: nftban port add $port $proto_name ($(date '+%Y-%m-%d %H:%M:%S'))" >> "$config_file"
 275:             echo "${port}|${proto}" >> "$config_file"
 276:             chmod 640 "$config_file"
 277:             chown root:nftban "$config_file" 2>/dev/null || true
 278: 
 279:             echo "✓ Port $port ($proto_name) added to whitelist: $config_file"
 280:             echo ""
 281: 
 282:             # Atomically add to nftables (if firewall is active)
 283:             if nft list table ${NFTBAN_TABLE_IPV4} >/dev/null 2>&1; then
 284:                 echo "⚡ Atomically adding port to firewall..."
 285: 
 286:                 local add_success=true
 287: 
 288:                 # Add to tcp_ports set (if TCP or both)
 289:                 if [[ "$proto" == "T" || "$proto" == "B" ]]; then
 290:                     if nft add element ${NFTBAN_TABLE_IPV4} tcp_ports "{ $port }" 2>/dev/null; then
 291:                         echo "  ✓ TCP port $port added to nftables (immediate)"
 292:                     else
 293:                         echo "  ⚠ Could not add TCP port atomically" >&2
 294:                         add_success=false
 295:                     fi
 296:                 fi
 297: 
 298:                 # Add to udp_ports set (if UDP or both)
 299:                 if [[ "$proto" == "U" || "$proto" == "B" ]]; then
 300:                     if nft add element ${NFTBAN_TABLE_IPV4} udp_ports "{ $port }" 2>/dev/null; then
 301:                         echo "  ✓ UDP port $port added to nftables (immediate)"
 302:                     else
 303:                         echo "  ⚠ Could not add UDP port atomically" >&2
 304:                         add_success=false
 305:                     fi
 306:                 fi
 307: 
 308:                 # Fallback to full reload if atomic failed
 309:                 if [[ "$add_success" == "false" ]]; then
 310:                     echo ""
 311:                     echo "⚠ Atomic add failed, performing full firewall reload..."
 312:                     if nftban firewall reload >/dev/null 2>&1; then
 313:                         echo "✓ Firewall reloaded successfully"
 314:                     else
 315:                         echo "❌ Firewall reload failed" >&2
 316:                         echo "Run manually: nftban firewall reload" >&2
 317:                         return 1
 318:                     fi
 319:                 fi
 320: 
 321:                 echo ""
 322:                 echo "✅ Port $port is now active in firewall (no restart needed)"
 323:             else
 324:                 echo "⚠ Firewall not initialized - port saved but not active yet"
 325:                 echo "Run: nftban firewall init"
 326:             fi
 327: 
 328:             echo ""
 329:             echo "To remove this port later, use:"
 330:             echo "  nftban port remove $port"
 331: 
 332:             return 0
 333:             ;;
 334: 
 335:         remove)
 336:             # Remove port from whitelist
 337:             # Args: <port>
 338:             local port="${1:-}"
 339: 
 340:             if [[ -z "$port" ]]; then
 341:                 echo "ERROR: Port number required" >&2
 342:                 echo "Usage: nftban port remove <port>" >&2
 343:                 echo "" >&2
 344:                 echo "Examples:" >&2
 345:                 echo "  nftban port remove 8080" >&2
 346:                 echo "  nftban port remove 53" >&2
 347:                 return 1
 348:             fi
 349: 
 350:             # Validate port number
 351:             if ! [[ "$port" =~ ^[0-9]+$ ]] || [[ "$port" -lt 1 ]] || [[ "$port" -gt 65535 ]]; then
 352:                 echo "ERROR: Invalid port number: $port" >&2
 353:                 echo "Port must be between 1-65535" >&2
 354:                 return 1
 355:             fi
 356: 
 357:             # CRITICAL: Protect current SSH port from being removed
 358:             local current_ssh_port="${SSH_CLIENT:+${SSH_CLIENT##* }}"
 359:             if [[ "$port" == "$current_ssh_port" ]]; then
 360:                 echo "❌ ERROR: Cannot remove port $port - this is your ACTIVE SSH port!" >&2
 361:                 echo "" >&2
 362:                 echo "⚠️  DANGER: Removing this port will lock you out of the server!" >&2
 363:                 echo "   Your SSH connection is using port $port right now." >&2
 364:                 echo "" >&2
 365:                 echo "If you really need to remove this port:" >&2
 366:                 echo "  1. Connect via console or alternate SSH port" >&2
 367:                 echo "  2. Then run: nftban port remove $port" >&2
 368:                 return 1
 369:             fi
 370: 
 371:             # Find all config files containing this port
 372:             local found_files=()
 373:             local protected_files=()
 374: 
 375:             if [[ -d ${NFTBAN_CONFIG_DIR}/ports.d ]]; then
 376:                 while IFS= read -r file; do
 377:                     # Check if file contains the port
 378:                     if grep -qE "^${port}\|" "$file" 2>/dev/null; then
 379:                         # Check if it's a protected file (00-*.conf)
 380:                         if [[ "$(basename "$file")" =~ ^00- ]]; then
 381:                             protected_files+=("$file")
 382:                         else
 383:                             found_files+=("$file")
 384:                         fi
 385:                     fi
 386:                 done < <(find ${NFTBAN_CONFIG_DIR}/ports.d -type f -name "*.conf" 2>/dev/null)
 387:             fi
 388: 
 389:             # Show protected files (don't remove)
 390:             if [[ ${#protected_files[@]} -gt 0 ]]; then
 391:                 echo "⚠ WARNING: Port $port found in protected system files:" >&2
 392:                 for file in "${protected_files[@]}"; do
 393:                     echo "  - $file (PROTECTED - will not remove)" >&2
 394:                     grep -E "^${port}\|" "$file" 2>/dev/null | sed 's/^/    /' >&2
 395:                 done
 396:                 echo "" >&2
 397: 
 398:                 # If ONLY in protected files, abort
 399:                 if [[ ${#found_files[@]} -eq 0 ]]; then
 400:                     echo "ERROR: Cannot remove port $port - only exists in protected files" >&2
 401:                     echo "Protected files (00-*.conf) contain critical system ports." >&2
 402:                     echo "To remove, edit manually: ${protected_files[0]}" >&2
 403:                     return 1
 404:                 fi
 405:             fi
 406: 
 407:             # Remove from non-protected files
 408:             if [[ ${#found_files[@]} -eq 0 ]]; then
 409:                 echo "ERROR: Port $port not found in whitelist" >&2
 410:                 echo "Checked: ${NFTBAN_CONFIG_DIR}/ports.d/*.conf" >&2
 411:                 return 1
 412:             fi
 413: 
 414:             local removed_count=0
 415:             local removed_proto=""
 416: 
 417:             for file in "${found_files[@]}"; do
 418:                 echo "Removing port $port from: $file"
 419: 
 420:                 # Show what we're removing and capture protocol
 421:                 local port_line
 422:                 port_line=$(grep -E "^${port}\|" "$file" 2>/dev/null)
 423:                 echo "  - $port_line"
 424: 
 425:                 # Extract protocol from line (format: PORT|PROTO)
 426:                 removed_proto=$(echo "$port_line" | cut -d'|' -f2)
 427: 
 428:                 # Create backup
 429:                 cp "$file" "${file}.backup.$(date +%Y%m%d-%H%M%S)"
 430: 
 431:                 # Remove port and its comment line (if immediately before)
 432:                 sed -i "/^# Added by: nftban port add ${port} /d; /^${port}|/d" "$file"
 433: 
 434:                 removed_count=$((removed_count + 1))
 435:             done
 436: 
 437:             echo ""
 438:             echo "✓ Port $port removed from $removed_count file(s)"
 439:             echo ""
 440: 
 441:             # Atomically remove from nftables (if firewall is active)
 442:             if nft list table ${NFTBAN_TABLE_IPV4} >/dev/null 2>&1 && [[ -n "$removed_proto" ]]; then
 443:                 echo "⚡ Atomically removing port from firewall..."
 444: 
 445:                 local remove_success=true
 446: 
 447:                 # Remove from tcp_ports set (if TCP or both)
 448:                 if [[ "$removed_proto" == "T" || "$removed_proto" == "B" ]]; then
 449:                     if nft delete element ${NFTBAN_TABLE_IPV4} tcp_ports "{ $port }" 2>/dev/null; then
 450:                         echo "  ✓ TCP port $port removed from nftables (immediate)"
 451:                     else
 452:                         echo "  ⚠ Could not remove TCP port atomically (may not exist)" >&2
 453:                         remove_success=false
 454:                     fi
 455:                 fi
 456: 
 457:                 # Remove from udp_ports set (if UDP or both)
 458:                 if [[ "$removed_proto" == "U" || "$removed_proto" == "B" ]]; then
 459:                     if nft delete element ${NFTBAN_TABLE_IPV4} udp_ports "{ $port }" 2>/dev/null; then
 460:                         echo "  ✓ UDP port $port removed from nftables (immediate)"
 461:                     else
 462:                         echo "  ⚠ Could not remove UDP port atomically (may not exist)" >&2
 463:                         remove_success=false
 464:                     fi
 465:                 fi
 466: 
 467:                 # Fallback to full reload if atomic failed
 468:                 if [[ "$remove_success" == "false" ]]; then
 469:                     echo ""
 470:                     echo "⚠ Atomic remove failed, performing full firewall reload..."
 471:                     if nftban firewall reload >/dev/null 2>&1; then
 472:                         echo "✓ Firewall reloaded successfully"
 473:                     else
 474:                         echo "❌ Firewall reload failed" >&2
 475:                         echo "Run manually: nftban firewall reload" >&2
 476:                         return 1
 477:                     fi
 478:                 fi
 479: 
 480:                 echo ""
 481:                 echo "✅ Port $port is now blocked in firewall (no restart needed)"
 482:             else
 483:                 echo "⚠ Firewall not initialized - port removed from config only"
 484:             fi
 485: 
 486:             return 0
 487:             ;;
 488: 
 489:         block)
 490:             # Block port (remove from whitelist)
 491:             # Default: blocks TCP+UDP on both IPv4+IPv6
 492:             # Args: <port>
 493:             local port="${1:-}"
 494: 
 495:             if [[ -z "$port" ]]; then
 496:                 echo "ERROR: Port number required" >&2
 497:                 echo "Usage: nftban port block <port>" >&2
 498:                 echo "" >&2
 499:                 echo "Examples:" >&2
 500:                 echo "  nftban port block 8080    # Block TCP+UDP port 8080 (safest)" >&2
 501:                 echo "" >&2
 502:                 echo "Note: This removes the port from the firewall whitelist." >&2
 503:                 echo "      The port will be blocked by the default DROP policy." >&2
 504:                 return 1
 505:             fi
 506: 
 507:             # CRITICAL: Protect current SSH port from being blocked
 508:             local current_ssh_port="${SSH_CLIENT:+${SSH_CLIENT##* }}"
 509:             if [[ "$port" == "$current_ssh_port" ]]; then
 510:                 echo "❌ ERROR: Cannot block port $port - this is your ACTIVE SSH port!" >&2
 511:                 echo "" >&2
 512:                 echo "⚠️  DANGER: Blocking this port will lock you out of the server!" >&2
 513:                 echo "   Your SSH connection is using port $port right now." >&2
 514:                 echo "" >&2
 515:                 echo "If you really need to block this port:" >&2
 516:                 echo "  1. Connect via console or alternate SSH port" >&2
 517:                 echo "  2. Then run: nftban port block $port" >&2
 518:                 return 1
 519:             fi
 520: 
 521:             echo "🛡️  Blocking port $port (TCP+UDP on IPv4+IPv6)..."
 522:             echo ""
 523: 
 524:             # Call remove to take it out of whitelist
 525:             nftban_cmd_port remove "$port"
 526:             local result=$?
 527: 
 528:             if [[ $result -eq 0 ]]; then
 529:                 echo ""
 530:                 echo "✅ Port $port is now BLOCKED by firewall"
 531:                 echo ""
 532:                 echo "To unblock this port later, use:"
 533:                 echo "  nftban port unblock $port"
 534:             fi
 535: 
 536:             return $result
 537:             ;;
 538: 
 539:         unblock)
 540:             # Unblock port (add to whitelist)
 541:             # Default: unblocks TCP+UDP on both IPv4+IPv6
 542:             # Args: <port>
 543:             local port="${1:-}"
 544: 
 545:             if [[ -z "$port" ]]; then
 546:                 echo "ERROR: Port number required" >&2
 547:                 echo "Usage: nftban port unblock <port>" >&2
 548:                 echo "" >&2
 549:                 echo "Examples:" >&2
 550:                 echo "  nftban port unblock 8080    # Allow TCP+UDP port 8080 (safest)" >&2
 551:                 echo "" >&2
 552:                 echo "Note: This adds the port to the firewall whitelist." >&2
 553:                 return 1
 554:             fi
 555: 
 556:             echo "✅ Unblocking port $port (TCP+UDP on IPv4+IPv6)..."
 557:             echo ""
 558: 
 559:             # Call add with 'both' to allow TCP+UDP
 560:             nftban_cmd_port add "$port" "both"
 561:             local result=$?
 562: 
 563:             if [[ $result -eq 0 ]]; then
 564:                 echo ""
 565:                 echo "To block this port again, use:"
 566:                 echo "  nftban port block $port"
 567:             fi
 568: 
 569:             return $result
 570:             ;;
 571: 
 572:         allow-panel)
 573:             # Allow control panel ports in firewall
 574:             # Args: <panel_name>
 575:             local panel="${1:-}"
 576: 
 577:             if [[ -z "$panel" ]]; then
 578:                 echo "ERROR: Panel name required" >&2
 579:                 echo "Usage: nftban port allow-panel <panel_name>" >&2
 580:                 echo "Available panels: directadmin" >&2
 581:                 return 1
 582:             fi
 583: 
 584:             case "$panel" in
 585:                 directadmin|da)
 586:                     nftban_port_allow_directadmin
 587:                     return $?
 588:                     ;;
 589:                 *)
 590:                     echo "ERROR: Unknown panel: $panel" >&2
 591:                     echo "Available panels: directadmin" >&2
 592:                     return 1
 593:                     ;;
 594:             esac
 595:             ;;
 596: 
 597:         help|--help|-h)
 598:             # Show help
 599:             # Load output module for standard banner
 600:             source "${LIB_DIR}/core/nftban_output.sh"
 601:             nftban_banner
 602:             echo ""
 603:             echo "Usage:"
 604:             echo "  nftban port status [ports]       # Show port status (all or filtered)"
 605:             echo "  nftban port detailed [ports]     # Show detailed status with BIND and PROCESS"
 606:             echo "  nftban port add <port> [proto]   # Add port to whitelist (proto: both, tcp, udp)"
 607:             echo "  nftban port remove <port>        # Remove port from whitelist"
 608:             echo "  nftban port block <port>         # Block port (TCP+UDP, IPv4+IPv6)"
 609:             echo "  nftban port unblock <port>       # Unblock port (TCP+UDP, IPv4+IPv6)"
 610:             echo "  nftban port html-report          # Generate HTML report (coming soon)"
 611:             echo "  nftban port mail-report [path] [recipient]  # Mail report"
 612:             echo "  nftban port allow-panel <panel>  # Allow control panel ports in firewall"
 613:             echo "  nftban port help                 # Show this help"
 614:             echo ""
 615:             echo "Examples :"
 616:             echo "  nftban port status               # Show all listening ports"
 617:             echo "  nftban port status 22,80,443     # Show only SSH, HTTP, HTTPS"
 618:             echo "  nftban port detailed             # Show detailed info with bind addresses"
 619:             echo "  nftban port add 8080             # Allow TCP+UDP port 8080 (safest)"
 620:             echo "  nftban port remove 8080          # Remove port 8080 from whitelist"
 621:             echo "  nftban port block 3389           # Block RDP port (TCP+UDP)"
 622:             echo "  nftban port unblock 3389         # Unblock RDP port (TCP+UDP)"
 623:             echo ""
 624:             echo "Examples (Expert - specific protocols):"
 625:             echo "  nftban port add 53 udp           # Allow only UDP port 53 (DNS)"
 626:             echo "  nftban port add 443 tcp          # Allow only TCP port 443 (HTTPS)"
 627:             echo "  nftban port mail-report ${NFTBAN_DATA_DIR}/reports/port_report.html admin@example.com"
 628:             echo "  nftban port allow-panel directadmin  # Allow DirectAdmin panel ports"
 629:             echo ""
 630:             echo "Note: For full panel management, use: nftban panel directadmin <action>"
 631:             echo "      Actions: enable, disable, status, report, repair, test"
 632:             echo ""
 633:             echo "Output Columns:"
 634:             echo "  SERVICE  - Service name (from /etc/services or process name)"
 635:             echo "  PORT     - Port number"
 636:             echo "  PROTO    - Protocol (tcp/udp)"
 637:             echo "  RUNNING  - Is service listening?"
 638:             echo "  IPv4 IN  - IPv4 inbound firewall status"
 639:             echo "  IPv4 OUT - IPv4 outbound firewall status"
 640:             echo "  IPv6 IN  - IPv6 inbound firewall status"
 641:             echo "  IPv6 OUT - IPv6 outbound firewall status"
 642:             echo "  NOTES    - Additional info (bind scope, generic rules, etc.)"
 643:             echo ""
 644:             echo "Detailed Mode Adds:"

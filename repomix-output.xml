 559:     fi
 560: 
 561:     if [[ -f "$cmd_file" ]]; then
 562:         # shellcheck source=/dev/null
 563:         source "$cmd_file"
 564: 
 565:         # Convert hyphens to underscores for function name (whitelist-system -> whitelist_system)
 566:         local func_cmd="${cmd//-/_}"
 567: 
 568:         # Some modules define nftban_cmd_X, others just use case statements
 569:         if declare -f "nftban_cmd_${func_cmd}" >/dev/null 2>&1; then
 570:             shift
 571:             "nftban_cmd_${func_cmd}" "$@"
 572:             return $?
 573:         else
 574:             # Module handles args directly (like cmd_whitelist_system.sh)
 575:             return 0
 576:         fi
 577:     fi

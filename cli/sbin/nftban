                echo "victoriametrics"
                ;;
            *)
                # No further completions
                ;;
        esac
        return 0
    fi
}

# =============================================================================
# MAIN CLI
# =============================================================================

main() {
    # v1.39.0: Parse global flags before command dispatch
    local _args=("$@")
    local _filtered=()
    for _arg in "${_args[@]}"; do
        case "$_arg" in
            --no-banner)
                export NFTBAN_BANNER_MODE="none"
                ;;
            *)
                _filtered+=("$_arg")
                ;;
        esac
    done
    set -- "${_filtered[@]+"${_filtered[@]}"}"

    local cmd="${1:-hello}"

    # Special completion endpoint for bash completion
    # IMPORTANT: Check this BEFORE loading modules (for performance)
    if [[ "$cmd" == "__complete" ]]; then
        shift
        nftban_complete "$@"
        return 0
    fi

    # Load core modules (only if not doing completion)
    if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_output.sh" ]]; then
        # shellcheck source=/dev/null
        source "${NFTBAN_LIB_DIR}/core/nftban_output.sh"
    else
        echo "ERROR: Core module not found: ${NFTBAN_LIB_DIR}/core/nftban_output.sh" >&2
        exit 1
    fi

    # Load JSON helper for --json support (optional)
    if [[ -f "${NFTBAN_LIB_DIR}/json_output.sh" ]]; then
        # shellcheck source=/dev/null
        source "${NFTBAN_LIB_DIR}/json_output.sh"
    fi

    # Load grouped help system (optional, graceful fallback)
    if [[ -f "${NFTBAN_LIB_DIR}/nftban_help.sh" ]]; then
        # shellcheck source=/dev/null
        source "${NFTBAN_LIB_DIR}/nftban_help.sh"
    fi

    # Auto-load modular commands from cli/ directory
    # This keeps the main CLI small and manageable
    local cmd_file="${NFTBAN_LIB_DIR}/cli/cmd_${cmd}.sh"

    # Special case: whitelist-system uses underscore in filename
    if [[ "$cmd" == "whitelist-system" ]]; then
        cmd_file="${NFTBAN_LIB_DIR}/cli/cmd_whitelist_system.sh"
    fi

    # Special case: firewall-logs uses underscore in filename
    if [[ "$cmd" == "firewall-logs" ]]; then
        cmd_file="${NFTBAN_LIB_DIR}/cli/cmd_firewall_logs.sh"
    fi

    # Special case: support-bundle is an alias for support
    if [[ "$cmd" == "support-bundle" ]]; then
        cmd_file="${NFTBAN_LIB_DIR}/cli/cmd_support.sh"
    fi

    if [[ -f "$cmd_file" ]]; then
        # shellcheck source=/dev/null
        source "$cmd_file"

        # Convert hyphens to underscores for function name (whitelist-system -> whitelist_system)
        local func_cmd="${cmd//-/_}"

        # Some modules define nftban_cmd_X, others just use case statements
        if declare -f "nftban_cmd_${func_cmd}" >/dev/null 2>&1; then
            shift
            # SF-1 (v1.100.2): use `|| return $?` so a legitimate non-zero
            # exit from a command module (e.g. `nftban health` returning 2
            # for DOWN on a released host) is propagated cleanly to the
            # caller instead of triggering the ERR trap, which would print
            # "ERROR: Script failed" on top of the command's own output.
            "nftban_cmd_${func_cmd}" "$@" || return $?
            return 0
        else
            # Module handles args directly (like cmd_whitelist_system.sh)
            return 0
        fi
    fi

    case "$cmd" in
        cloudflare)
            # H28 fix: 'cloudflare' is an alias for 'trust' (Cloudflare IPs managed via trust module)
            if [[ -f "${NFTBAN_LIB_DIR}/cli/cmd_trust.sh" ]]; then
                # shellcheck source=/dev/null
                source "${NFTBAN_LIB_DIR}/cli/cmd_trust.sh"
                shift
                nftban_cmd_trust "$@"
                return $?
            else
                echo "ERROR: cmd_trust.sh not found" >&2
                exit 1
            fi
            ;;

        enable|disable|restart)
            # Route to system enable/disable/restart command
            if [[ -f "${NFTBAN_LIB_DIR}/cli/cmd_system.sh" ]]; then
                # shellcheck source=/dev/null
                source "${NFTBAN_LIB_DIR}/cli/cmd_system.sh"
                shift
                nftban_cmd_system "$cmd" "$@"
                return $?
            else
                echo "ERROR: cmd_system.sh not found" >&2
                exit 1
            fi
            ;;

        verify|explain)
            # v1.39.0 P3-17: 'verify' and 'explain' are aliases for 'emulate'
            if [[ -f "${NFTBAN_LIB_DIR}/cli/cmd_emulate.sh" ]]; then
                # shellcheck source=/dev/null
                source "${NFTBAN_LIB_DIR}/cli/cmd_emulate.sh"
                shift
                nftban_cmd_emulate "$@"
                return $?
            else
                echo "ERROR: cmd_emulate.sh not found" >&2
                exit 1
            fi
            ;;

        service)
            # Alias: 'service' (singular) → 'services' (plural)
            if [[ -f "${NFTBAN_LIB_DIR}/cli/cmd_services.sh" ]]; then
                # shellcheck source=/dev/null
                source "${NFTBAN_LIB_DIR}/cli/cmd_services.sh"
                shift
                nftban_cmd_services "$@"
                return $?
            else
                echo "ERROR: cmd_services.sh not found" >&2
                exit 1
            fi
            ;;

        export)
            # Alias: 'nftban export' → 'nftban stats export'
            if [[ -f "${NFTBAN_LIB_DIR}/cli/cmd_stats.sh" ]]; then
                # shellcheck source=/dev/null
                source "${NFTBAN_LIB_DIR}/cli/cmd_stats.sh"
                shift
                nftban_cmd_stats "export" "$@"
                return $?
            else
                echo "ERROR: cmd_stats.sh not found" >&2
                exit 1
            fi
            ;;

        rollback)
            # Alias: 'nftban rollback' → 'nftban update rollback'
            if [[ -f "${NFTBAN_LIB_DIR}/cli/cmd_update.sh" ]]; then
                # shellcheck source=/dev/null
                source "${NFTBAN_LIB_DIR}/cli/cmd_update.sh"
                shift
                nftban_cmd_update "rollback" "$@"
                return $?
            else
                echo "ERROR: cmd_update.sh not found" >&2
                exit 1
            fi
            ;;

        hello|"")
            # v1.52.0: Use unified banner (same as all other commands)
            nftban_banner_unified "hello" 2>/dev/null || nftban_banner "hello" 2>/dev/null || true

            echo ""

            # V127 UX-1 item 1.1: explicitly source cmd_status.sh so that
            # _nftban_protection_state() and the shared $_NFTBAN_VALIDATOR_CACHE
            # are guaranteed available — pre-V127 the dashboard relied on lazy
            # auto-load and silently fell back to "UNKNOWN" → UNPROTECTED display
            # when cmd_status.sh wasn't loaded yet, while `nftban health` and
            # `nftban status` independently loaded it and got the PROTECTED
            # verdict — producing the contradictory same-host-same-minute output
            # the V126 live UX audit flagged. The Go validator cache (line 222
            # of cmd_status.sh) means this source is essentially free on a hot
            # dashboard call: no duplicate validator invocations.
            # (Scope: AUDIT_190_LIFECYCLE/V127_FULL_UX_CORRECTION_UMBRELLA_SCOPE.md UX-1 item 1.1)
            if [[ -f "${NFTBAN_LIB_DIR}/cli/cmd_status.sh" ]]; then
                # shellcheck source=/dev/null
                source "${NFTBAN_LIB_DIR}/cli/cmd_status.sh" 2>/dev/null || true
            fi

            # v1.46.0: Compact dashboard — protection state + module status
            local _prot_state="UNKNOWN"
            if declare -f _nftban_protection_state >/dev/null 2>&1; then
                _prot_state=$(_nftban_protection_state)
            fi

            case "$_prot_state" in
                PROTECTED)   echo "  Protection:  PROTECTED" ;;
                MONITORING)  echo "  Protection:  MONITORING (no detection modules enabled)" ;;
                DEGRADED*)   echo "  Protection:  ${_prot_state}" ;;
                DISABLED)    echo "  Protection:  DISABLED" ;;
                DOWN)        echo "  Protection:  DOWN" ;;
                *)           echo "  Protection:  UNPROTECTED" ;;
            esac

            echo ""

            # Module status (2-column, parallel systemctl checks)
            local _tmpdir
            _tmpdir=$(mktemp -d)
            systemctl is-active nftband                 >"${_tmpdir}/daemon_active" 2>/dev/null &
            systemctl is-active nftban-watchdog.timer   >"${_tmpdir}/watchdog_active" 2>/dev/null &
            wait

            # DDoS
            local ddos_st="Disabled"
            local _ddos_conf="${NFTBAN_CONFIG_DIR:-/etc/nftban}/conf.d/ddos/main.conf.local"
            local _ddos_main="${NFTBAN_CONFIG_DIR:-/etc/nftban}/conf.d/ddos/main.conf"
            if grep -q '^DDOS_ENABLED="true"' "$_ddos_conf" 2>/dev/null || \
               grep -q '^DDOS_ENABLED="true"' "$_ddos_main" 2>/dev/null; then
                ddos_st="Enabled"
            fi

            # Portscan
            local ps_st="Disabled"
            local _ps_conf="${NFTBAN_CONFIG_DIR:-/etc/nftban}/conf.d/portscan/main.conf.local"
            local _ps_main="${NFTBAN_CONFIG_DIR:-/etc/nftban}/conf.d/portscan/main.conf"
            if grep -q '^PORTSCAN_ENABLED="true"' "$_ps_conf" 2>/dev/null || \
               grep -q '^PORTSCAN_ENABLED="true"' "$_ps_main" 2>/dev/null; then
                ps_st="Enabled"
            fi

            # V127 UX-1 item 1.1: Login Monitor truth source unified with `nftban health`
            # via the Go validator's loginmon.effective axis (cached in $_NFTBAN_VALIDATOR_CACHE
            # from the Protection-state call above). Pre-V127 the dashboard grep-read
            # NFTBAN_LOGIN_MONITOR_ENABLED (the central observability gate, distinct from the
            # loginmon module activation state per V104 Lane M Decision B) which produced
            # "Login Mon: Disabled" while `nftban health` showed loginmon enabled/running.
            # Falls back to the prior grep path if the validator cache is unavailable.
            local login_st="Disabled"
            if [[ -n "${_NFTBAN_VALIDATOR_CACHE:-}" ]] && command -v jq &>/dev/null; then
                local _lm_eff
                _lm_eff=$(echo "$_NFTBAN_VALIDATOR_CACHE" | jq -r '.modules.loginmon.effective // empty' 2>/dev/null)
                case "$_lm_eff" in
                    on|enabled|active|running) login_st="Active" ;;
                    off|disabled|"")           login_st="Disabled" ;;
                    *)                          login_st="$_lm_eff" ;;
                esac
            elif grep -q "^active" "${_tmpdir}/daemon_active" 2>/dev/null; then
                # Fallback: prior grep path (only when validator cache absent)
                local _lm_conf="${NFTBAN_CONFIG_DIR:-/etc/nftban}/conf.d/login/main.conf"
                local _lm_en="false"
                [[ -f "${_lm_conf}.local" ]] && _lm_en=$(grep -m1 '^NFTBAN_LOGIN_MONITOR_ENABLED=' "${_lm_conf}.local" 2>/dev/null | cut -d'"' -f2 || echo "false")
                [[ "$_lm_en" != "true" ]] && [[ -f "$_lm_conf" ]] && _lm_en=$(grep -m1 '^NFTBAN_LOGIN_MONITOR_ENABLED=' "$_lm_conf" 2>/dev/null | cut -d'"' -f2 || echo "false")
                [[ "$_lm_en" == "true" ]] && login_st="Active"
            fi

            # V127 UX-4: Suricata row de-surfaced from no-args dashboard per
            # Option A full de-surface (operator authorization 2026-05-24).
            # Production cmd_suricata.sh + cmd_suricata_setup.sh + the
            # nftban_{login,portscan,ddos}_suricata.sh engine code remain
            # functional and reachable via `nftban suricata <subcmd>`; only
            # the default operator-facing dashboard row is suppressed here.
            # Reversible by re-introducing the Suricata block and the
            # systemctl is-active background probes above.
            # (Scope: AUDIT_190_LIFECYCLE/V127_FULL_UX_CORRECTION_UMBRELLA_SCOPE.md UX-4)

            # Watchdog
            local wd_st="Disabled"
            grep -q "^active" "${_tmpdir}/watchdog_active" 2>/dev/null && wd_st="Active"

            rm -rf "${_tmpdir}" 2>/dev/null || true

            printf "  %-14s %-12s  %-14s %s\n" "DDoS:" "$ddos_st" "Portscan:" "$ps_st"
            printf "  %-14s %-12s  %-14s %s\n" "Login Mon:" "$login_st" "Watchdog:" "$wd_st"

            echo ""
            echo "  nftban status          Detailed status"
            echo "  nftban help            Essential commands"
            echo "  nftban health          Run diagnostics"
            echo ""
            ;;

        # BUG-L9 FIX: Removed dead case blocks for version, gui, metrics, timers
        # -- all handled by auto-loader at line 736 (cmd_*.sh + nftban_cmd_*())

        help|--help|-h)
            # v1.46.0: Pass remaining args so --all works (nftban help --all)
            shift
            if declare -f nftban_print_help >/dev/null 2>&1; then
                nftban_print_help "$@"
            else
                # Fallback to old help (if help module fails to load)
                nftban_render_banner simple
                echo ""
                echo "NFTBan v${NFTBAN_VERSION} - Available Commands"
                echo ""
                echo "Run 'nftban <command> help' for command-specific help"
                echo ""
            fi
            ;;

        *)
            # Check if nftban-core recognizes this command (silently)
            # Only forward if nftban-core explicitly handles it
            if command -v /usr/lib/nftban/bin/nftban-core &>/dev/null; then
                # List of known nftban-core commands
                case "$cmd" in
                    init|sync|check|feeds|trust|country|ports|geoip|suricata|analytics|profile-sync)
                        # These are valid nftban-core commands, forward them
                        /usr/lib/nftban/bin/nftban-core "$@"
                        return $?
                        ;;
                esac
            fi

            # Show banner
            nftban_render_banner simple
            echo ""

            # Error message
            echo -e "${NFTBAN_COLOR_RED}${NFTBAN_COLOR_BOLD}ERROR: Unknown command '${cmd}'${NFTBAN_COLOR_RESET}"
            echo ""

            # Suggest similar commands (typo detection)
            local suggestion=""
            case "$cmd" in
                satus|staus|sattus|statsu|satuts)
                    suggestion="status"
                    ;;
                hfs|HSF|hsf)
                    suggestion="fhs"
                    ;;
                helth|heath|healt|heatlh)
                    suggestion="health"
                    ;;
                geo|geoip-lookup|geo-lookup)
                    suggestion="geoip"
                    ;;
                login-alert|loginalert|logn|lgin)
                    suggestion="login"
                    ;;
                analytic|analyse|analyze)
                    suggestion="analytics"
                    ;;
                bna|bann)
                    suggestion="ban"
                    ;;
                ubnan|unabn)
                    suggestion="unban"
                    ;;
                ddso|dods)
                    suggestion="ddos"
                    ;;
                botgaurd|botgurd|bodguard|bot-guard)
                    suggestion="botguard"
                    ;;
                portscna|portsacn|posrtscan)
                    suggestion="portscan"
                    ;;
                feeed|feds|feed)
                    suggestion="feeds"
                    ;;
                firewll|firewal|firwall)
                    suggestion="firewall"
                    ;;
                modul|moduel)
                    suggestion="module"
                    ;;
                stat|stast)
                    suggestion="stats"
                    ;;
                servcies|servies|serivces)
                    suggestion="services"
                    ;;
                whtielist|whitelsit|whiltelist)
                    suggestion="whitelist"
                    ;;
                blacklsit|blcklist|balcklist|blocklist)
                    suggestion="blacklist"
                    ;;
                searh|serach|seach|sreach|searhc|fnd|find)
                    suggestion="search"
                    ;;
                cofnig|confg|conifg|ocnfig)
                    suggestion="config"
                    ;;
                updaet|updtae|upate|upadte)
                    suggestion="update"
                    ;;
                instal|insatll|intall|intsal)
                    suggestion="install"
                    ;;
                verison|vesion|verion|vsersion)
                    suggestion="version"
                    ;;
                rebulid|rebuid|reubiild)
                    suggestion="rebuild"
                    ;;
                tiemrs|tmiers|itmer)
                    suggestion="timers"
                    ;;
                mterics|metrcs|metircs)
                    suggestion="metrics"
                    ;;
                exprot|exort|exoprt)
                    suggestion="export"
                    ;;
                geoban|geo-ban)
                    suggestion="geoban"
                    ;;
                wathcdog|watchdgo|wacthdog)
                    suggestion="watchdog"
                    ;;
                emualte|emualet|emluate|vreify|verfiy|veirfy)
                    suggestion="emulate"
                    ;;
                suricat|surikata|sruicata)
                    suggestion="suricata"
                    ;;
                unintsall|unisntall|uninstll)
                    suggestion="uninstall"
                    ;;
                configtest)
                    suggestion="config validate"
                    ;;
                configaudit)
                    suggestion="config audit"
                    ;;
            esac

            if [[ -n "$suggestion" ]]; then
                echo "Did you mean: ${NFTBAN_COLOR_GREEN}nftban ${suggestion}${NFTBAN_COLOR_RESET}?"
                echo ""
            fi

            echo "Run '${NFTBAN_COLOR_CYAN}nftban help${NFTBAN_COLOR_RESET}' for available commands"
            echo ""
            exit 1
            ;;
    esac
}

# Execute
# SF-1 (v1.100.2): `|| exit $?` so a legitimate non-zero exit from a
# command (e.g. `nftban health` returning 2 for DOWN on a released
# host) propagates as the script's exit code without triggering the
# ERR trap that would print "ERROR: Script failed".
main "$@" || exit $?

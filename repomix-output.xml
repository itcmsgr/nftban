 107: nftban_cmd_report() {
 108:     # Main report command handler
 109:     # Usage: nftban report [subcommand] [options]
 110: 
 111:     local subcommand="${1:-help}"
 112: 
 113:     # Show banner
 114:     if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_output.sh" ]]; then
 115:         # shellcheck source=/dev/null
 116:         source "${NFTBAN_LIB_DIR}/core/nftban_output.sh"
 117:         if [[ $(type -t nftban_banner) == "function" ]]; then
 118:             nftban_banner
 119:         fi
 120:     fi
 121:     echo ""
 122: 
 123:     case "$subcommand" in
 124:         help|--help|-h)
 125:             nftban_report_cmd_help
 126:             return 0
 127:             ;;
 128:         generate)
 129:             shift
 130:             nftban_report_cmd_generate "$@"
 131:             ;;
 132:         email)
 133:             shift
 134:             nftban_report_cmd_email "$@"
 135:             ;;
 136:         email-setup)
 137:             shift
 138:             nftban_report_cmd_email_setup "$@"
 139:             ;;
 140:         schedule)
 141:             shift
 142:             nftban_report_cmd_schedule "$@"
 143:             ;;
 144:         run)
 145:             shift
 146:             nftban_report_cmd_run "$@"
 147:             ;;
 148:         list)
 149:             shift || true
 150:             nftban_report_cmd_list "$@"
 151:             ;;
 152:         status)
 153:             shift || true
 154:             nftban_report_cmd_status "$@"
 155:             ;;
 156:         *)
 157:             echo "ERROR: Unknown report command: $subcommand" >&2

288: 	fmt.Println("  nftban geoban CN --ban")
289: 	fmt.Println("  nftban ban 1.2.3.4")
290: 	fmt.Println()
291: 	fmt.Println("⚠️  IMPORTANT: Keep emergency_whitelist.conf safe!")
292: 	fmt.Printf("   Location: %s\n", emergencyFile)
293: 	fmt.Println()
294: 
295: 	return nil
296: }

#!/usr/bin/env bash
# =============================================================================
# NFTBan v1.0.0 - Queue Processor Worker
# =============================================================================
# SPDX-License-Identifier: MPL-2.0
# Purpose: Process tasks from NFTBan queue with retry/DLQ support
#
# meta:name="nftban_queue_processor"
# meta:type="worker"
# meta:owner="Antonios Voulvoulis <contact@nftban.com>"
# meta:created_date="2025-11-05"
#
# meta:description="Systemd worker that processes tasks from NFTBan queue"
# meta:input="None (reads from queue directories)"
# meta:output="Task execution results, logs to queue.log"
# meta:depends="bash,nftban_task_queue.sh"
#
# meta:trigger="systemd-timer"
# meta:systemd_timer="nftban-queue.timer"
# meta:systemd_service="nftban-queue.service"
# meta:interval_seconds="120"
#
# meta:inventory.files="nftban_task_queue.sh"
# meta:inventory.binaries=""
# meta:inventory.env_vars="NFTBAN_LIB_DIR"
# meta:inventory.config_files=""
# meta:inventory.systemd_units="nftban-queue.timer,nftban-queue.service"
# meta:inventory.network=""
# meta:inventory.privileges="nftban"
#
# Exit codes:
#   0 - Task processed successfully OR no tasks pending
#   1 - Task processing failed (will retry via DLQ system)
#   2 - Lock held by another instance (normal, skip)
# =============================================================================

set -Eeuo pipefail

# Set NFTBan library directory
readonly NFTBAN_LIB_DIR="${NFTBAN_LIB_DIR:-/usr/lib/nftban}"

# Source task queue helper
# shellcheck source=/dev/null
if [[ ! -f "${NFTBAN_LIB_DIR}/helpers/nftban_task_queue.sh" ]]; then
    echo "ERROR: Cannot find nftban_task_queue.sh at ${NFTBAN_LIB_DIR}/helpers/nftban_task_queue.sh" >&2
    exit 1
fi
source "${NFTBAN_LIB_DIR}/helpers/nftban_task_queue.sh"

# Log startup
_queue_log "INFO" "Queue processor started by systemd timer"

# Process tasks (one at a time, with retry support)
result=0
nftban_queue_process_next || result=$?

case $result in
    0)
        # Task processed successfully
        _queue_log "INFO" "Queue cycle completed successfully"
        exit 0
        ;;
    1)
        # No eligible tasks in queue (normal - may have tasks waiting for backoff)
        pending_count=$(nftban_queue_count 2>/dev/null || echo "0")
        if [[ "$pending_count" -gt 0 ]]; then
            _queue_log "DEBUG" "No eligible tasks ($pending_count pending, waiting for backoff)"
        fi
        exit 0
        ;;
    2)
        # Already locked (another instance running)
        _queue_log "DEBUG" "Queue processor already running, skipping this cycle"
        exit 0
        ;;
    *)
        # Processing error (task will be retried via DLQ system)
        _queue_log "WARN" "Task processing returned error (rc=$result), retry scheduled"
        # Exit 0 because the DLQ system handles retries - don't trigger OnFailure
        exit 0
        ;;
esac

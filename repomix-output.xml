325: # JSON-aware wrapper for feeds status
326: nftban_feeds_status_json() {
327:     local json_mode="${1:-false}"
328: 
329:     if [[ "$json_mode" == "true" ]] && declare -f json_output >/dev/null 2>&1; then
330:         # Get all feeds
331:         local all_feeds
332:         all_feeds=$(nftban_feeds_discover_all 2>/dev/null || echo "")
333: 
334:         # Build enabled feeds list
335:         local -a enabled_feeds=()
336:         local enabled_count=0
337:         local total_count=0
338:         local total_ips=0
339: 
340:         for feed in $all_feeds; do
341:             total_count=$((total_count + 1))
342:             local enabled
343:             enabled=$(nftban_feeds_get_property "$feed" "ENABLED" 2>/dev/null || echo "false")
344: 
345:             if [[ "$enabled" == "true" ]]; then
346:                 enabled_count=$((enabled_count + 1))
347:                 local feed_lower="${feed,,}"  # Convert to lowercase
348:                 local feed_file="${NFTBAN_DATA_DIR:-/var/lib/nftban}/feeds/${feed_lower}.txt"
349:                 local count=0
350:                 local mtime=""
351: 
352:                 if [[ -f "$feed_file" ]]; then
353:                     count=$(wc -l < "$feed_file" 2>/dev/null || echo "0")
354:                     mtime=$(date -r "$feed_file" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo "unknown")
355:                     total_ips=$((total_ips + count))
356:                 fi
357: 
358:                 enabled_feeds+=("{\"name\":\"$feed\",\"enabled\":true,\"ip_count\":$count,\"last_update\":\"$mtime\"}")
359:             fi
360:         done
361: 
362:         # Build JSON array
363:         local feeds_json="["
364:         local first=true
365:         for feed_json in "${enabled_feeds[@]}"; do
366:             [[ "$first" == "false" ]] && feeds_json+=","
367:             feeds_json+="$feed_json"
368:             first=false
369:         done
370:         feeds_json+="]"
371: 
372:         # Build response
373:         local data
374:         if command -v jq &>/dev/null; then
375:             data=$(jq -n \
376:                 --arg enabled_count "$enabled_count" \
377:                 --arg total_count "$total_count" \
378:                 --arg total_ips "$total_ips" \
379:                 --argjson feeds "$feeds_json" \
380:                 '{
381:                     summary: {
382:                         enabled_count: ($enabled_count | tonumber),
383:                         total_count: ($total_count | tonumber),
384:                         total_ips: ($total_ips | tonumber)
385:                     },
386:                     enabled_feeds: $feeds
387:                 }')
388:         else
389:             data="{\"summary\":{\"enabled_count\":$enabled_count,\"total_count\":$total_count,\"total_ips\":$total_ips},\"enabled_feeds\":$feeds_json}"
390:         fi
391: 
392:         json_output "true" "$data"
393:         return 0
394:     fi
395: 
396:     # Human-readable mode
397:     nftban_feeds_status
398: }

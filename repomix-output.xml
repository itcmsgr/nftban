201: // LoadConfig reads a config file (exported for rules package)
202: func LoadConfig(path string) *Config {
203: 	return loadConfig(path)
204: }
205: 
206: // loadConfig reads a config file
207: func loadConfig(path string) *Config {
208: 	config := &Config{
209: 		EnabledCategories:  make([]string, 0),
210: 		DisabledCategories: make([]string, 0),
211: 		EnabledSIDs:        make([]string, 0),
212: 		DisabledSIDs:       make([]string, 0),
213: 	}
214: 
215: 	data, err := os.ReadFile(path)
216: 	if err != nil {
217: 		return config // File doesn't exist yet
218: 	}
219: 
220: 	lines := strings.Split(string(data), "\n")
221: 	for _, line := range lines {
222: 		line = strings.TrimSpace(line)
223: 		if line == "" || strings.HasPrefix(line, "#") {
224: 			continue
225: 		}
226: 
227: 		if strings.HasPrefix(line, "ENABLE_CATEGORY=") {
228: 			cat := strings.TrimPrefix(line, "ENABLE_CATEGORY=")
229: 			config.EnabledCategories = append(config.EnabledCategories, cat)
230: 		} else if strings.HasPrefix(line, "DISABLE_CATEGORY=") {
231: 			cat := strings.TrimPrefix(line, "DISABLE_CATEGORY=")
232: 			config.DisabledCategories = append(config.DisabledCategories, cat)
233: 		} else if strings.HasPrefix(line, "ENABLE_SID=") {
234: 			sid := strings.TrimPrefix(line, "ENABLE_SID=")
235: 			config.EnabledSIDs = append(config.EnabledSIDs, sid)
236: 		} else if strings.HasPrefix(line, "DISABLE_SID=") {
237: 			sid := strings.TrimPrefix(line, "DISABLE_SID=")
238: 			config.DisabledSIDs = append(config.DisabledSIDs, sid)
239: 		}
240: 	}
241: 
242: 	return config
243: }
244: 
245: // loadList reads a simple list file
246: func loadList(path string) []string {
247: 	data, err := os.ReadFile(path)
248: 	if err != nil {
249: 		return []string{}
250: 	}
251: 
252: 	list := make([]string, 0)
253: 	lines := strings.Split(string(data), "\n")
254: 	for _, line := range lines {
255: 		line = strings.TrimSpace(line)
256: 		if line != "" && !strings.HasPrefix(line, "#") {
257: 			list = append(list, line)
258: 		}
259: 	}
260: 	return list
261: }
262: 
263: // mergeUnique merges two slices and removes duplicates
264: func mergeUnique(a, b []string) []string {
265: 	seen := make(map[string]bool)
266: 	result := make([]string, 0)
267: 
268: 	for _, item := range a {
269: 		if !seen[item] {
270: 			seen[item] = true
271: 			result = append(result, item)
272: 		}
273: 	}
274: 	for _, item := range b {
275: 		if !seen[item] {
276: 			seen[item] = true
277: 			result = append(result, item)
278: 		}
279: 	}
280: 
281: 	return result
282: }
283: 
284: // applyFilters applies whitelist/blacklist to a list
285: func applyFilters(items, whitelist, blacklist []string) []string {
286: 	// If whitelist exists, only include whitelisted items
287: 	if len(whitelist) > 0 {
288: 		whitelistMap := make(map[string]bool)
289: 		for _, item := range whitelist {
290: 			whitelistMap[item] = true
291: 		}
292: 
293: 		filtered := make([]string, 0)
294: 		for _, item := range items {
295: 			if whitelistMap[item] {
296: 				filtered = append(filtered, item)
297: 			}
298: 		}
299: 		items = filtered
300: 	}
301: 
302: 	// Remove blacklisted items
303: 	if len(blacklist) > 0 {
304: 		blacklistMap := make(map[string]bool)
305: 		for _, item := range blacklist {
306: 			blacklistMap[item] = true
307: 		}
308: 
309: 		filtered := make([]string, 0)
310: 		for _, item := range items {
311: 			if !blacklistMap[item] {
312: 				filtered = append(filtered, item)
313: 			}
314: 		}
315: 		items = filtered
316: 	}
317: 
318: 	return items
319: }
320: 
321: // InitializeLocalConf creates default local.conf if it doesn't exist
322: func InitializeLocalConf() error {
323: 	paths, err := GetConfigPaths()
324: 	if err != nil {
325: 		return err
326: 	}
327: 
328: 	// Don't overwrite existing local.conf
329: 	if _, err := os.Stat(paths.LocalConf); err == nil {
330: 		return nil
331: 	}
332: 
333: 	// Ensure directory exists
334: 	if err := os.MkdirAll(filepath.Dir(paths.LocalConf), 0755); err != nil {
335: 		return err
336: 	}
337: 
338: 	content := `# NFTBan Suricata Local Configuration
339: #
340: # This file is for MANUAL user overrides and is NEVER overwritten.
341: #
342: # Use this to:
343: #   - Enable/disable specific rule categories
344: #   - Enable/disable specific SIDs
345: #   - Override auto-detected settings
346: #
347: # Examples:
348: #   ENABLE_CATEGORY=emerging-malware
349: #   DISABLE_CATEGORY=emerging-policy
350: #   ENABLE_SID=2024218
351: #   DISABLE_SID=2019401
352: #
353: # After editing, run: nftban suricata rules generate
354: #
355: 
356: `
357: 
358: 	if err := os.WriteFile(paths.LocalConf, []byte(content), 0644); err != nil {
359: 		return fmt.Errorf("failed to create local.conf: %w", err)
360: 	}
361: 
362: 	fmt.Printf("Created: %s\n", paths.LocalConf)
363: 	return nil
364: }

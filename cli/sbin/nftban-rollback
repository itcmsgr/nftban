#!/usr/bin/env bash
# =============================================================================
# NFTBan - nftban-rollback (v1.235: wrapper over the repaired commit-confirm engine)
# =============================================================================
# SPDX-License-Identifier: MPL-2.0
# SPDX-FileCopyrightText: Copyright (c) 2024-2026 Antonios Voulvoulis <contact@nftban.com>
# meta:name="nftban-rollback"
# meta:type="cli"
# meta:version="1.235.0"
# meta:owner="Antonios Voulvoulis <contact@nftban.com>"
# meta:description="Rolls back the pending apply now: nftban firewall rollback [APPLY_ID]. The legacy --force mode is refused: it restored a stale whole-ruleset backup by merging. The pre-v1.235 implementation (whole-ruleset backup restored by merging, rollback armed after the change, fixed 5-minute --force timer, no apply identity) is retired; see NFTBAN_ROADMAP/CLI_AUDIT_V1235/ROW486_BEHAVIOUR_CONTRACT_V1235.md section 4."
# =============================================================================
set -Eeuo pipefail
NFTBAN="${NFTBAN_BIN:-/usr/sbin/nftban}"
for a in "$@"; do
    if [[ "$a" == "--force" || "$a" == "--legacy-unit" ]]; then
        echo "nftban-rollback: the legacy --force rollback is retired (it merged a stale whole-ruleset backup)." >&2
        echo "  Commit-confirm now uses per-apply rollback units. Use: nftban firewall rollback [APPLY_ID]" >&2
        exit 0
    fi
done
exec "$NFTBAN" firewall rollback "$@"

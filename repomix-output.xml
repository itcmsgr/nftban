402: # =============================================================================
403: # SCORING ENGINE
404: # =============================================================================
405: 
406: # Calculate score for an IP
407: nftban_portscan_suricata_calculate_score() {
408:     local ip="$1"
409:     local severity="$2"
410:     local scan_type="$3"
411: 
412:     local score=0.0
413:     local current_score="${_PORTSCAN_SURICATA_IP_SCORES[$ip]:-0}"
414: 
415:     # Apply score decay
416:     local last_seen="${_PORTSCAN_SURICATA_IP_LAST_SEEN[$ip]:-0}"
417:     local current_time
418:     current_time=$(date +%s)
419:     local score_decay="${PORTSCAN_SURICATA_SCORE_DECAY}"
420: 
421:     if [[ $last_seen -gt 0 && -n "$current_score" ]]; then
422:         local time_diff
423:         time_diff=$((current_time - last_seen))
424:         if [[ $time_diff -gt $score_decay ]]; then
425:             current_score=0
426:         else
427:             # Linear decay
428:             local decay_factor
429:             decay_factor=$(echo "scale=4; 1 - ($time_diff / $score_decay)" | bc 2>/dev/null || echo "0.5")
430:             current_score=$(echo "scale=4; $current_score * $decay_factor" | bc 2>/dev/null || echo "0")
431:         fi
432:     fi
433: 
434:     score="$current_score"
435: 
436:     # Add severity score (1=High, 2=Medium, 3=Low, 4=Info - matches Go)
437:     local severity_score=0
438:     case "$severity" in
439:         1) severity_score="${PORTSCAN_SURICATA_SCORE_SEVERITY_1:-0.50}" ;;
440:         2) severity_score="${PORTSCAN_SURICATA_SCORE_SEVERITY_2:-0.35}" ;;
441:         3) severity_score="${PORTSCAN_SURICATA_SCORE_SEVERITY_3:-0.20}" ;;
442:         4) severity_score="${PORTSCAN_SURICATA_SCORE_SEVERITY_4:-0.10}" ;;
443:     esac
444: 
445:     score=$(echo "scale=4; $score + $severity_score" | bc 2>/dev/null || echo "$score")
446: 
447:     # Add scan type bonus
448:     local type_score=0
449:     case "$scan_type" in
450:         portscan)    type_score="${PORTSCAN_SURICATA_SCORE_PORTSCAN:-0.15}" ;;
451:         portsweep)   type_score="${PORTSCAN_SURICATA_SCORE_PORTSWEEP:-0.20}" ;;
452:         decoy)       type_score="${PORTSCAN_SURICATA_SCORE_DECOY:-0.25}" ;;
453:         distributed) type_score="${PORTSCAN_SURICATA_SCORE_DISTRIBUTED:-0.30}" ;;
454:         nmap|masscan) type_score="${PORTSCAN_SURICATA_SCORE_KNOWN_TOOL:-0.20}" ;;
455:     esac
456: 
457:     score=$(echo "scale=4; $score + $type_score" | bc 2>/dev/null || echo "$score")
458: 
459:     # Add repetition bonus
460:     local alert_count="${_PORTSCAN_SURICATA_IP_ALERTS[$ip]:-0}"
461:     local repeat_score=0
462: 
463:     if [[ $alert_count -ge 20 ]]; then
464:         repeat_score="${PORTSCAN_SURICATA_SCORE_REPEAT_20:-0.30}"
465:     elif [[ $alert_count -ge 10 ]]; then
466:         repeat_score="${PORTSCAN_SURICATA_SCORE_REPEAT_10:-0.20}"
467:     elif [[ $alert_count -ge 5 ]]; then
468:         repeat_score="${PORTSCAN_SURICATA_SCORE_REPEAT_5:-0.10}"
469:     fi
470: 
471:     score=$(echo "scale=4; $score + $repeat_score" | bc 2>/dev/null || echo "$score")
472: 
473:     # Add reputation bonus if feeds integration enabled
474:     if [[ "${PORTSCAN_SURICATA_USE_FEEDS:-true}" == "true" ]]; then
475:         if type -t nftban_feeds_is_known_bad &>/dev/null; then
476:             if nftban_feeds_is_known_bad "$ip" 2>/dev/null; then
477:                 local rep_score="${PORTSCAN_SURICATA_SCORE_BAD_REPUTATION:-0.15}"
478:                 score=$(echo "scale=4; $score + $rep_score" | bc 2>/dev/null || echo "$score")
479:             fi
480:         fi
481:     fi
482: 
483:     # Add GeoIP risk if enabled
484:     if [[ "${PORTSCAN_SURICATA_USE_GEOIP:-true}" == "true" ]]; then
485:         if type -t nftban_geoip_is_high_risk &>/dev/null; then
486:             if nftban_geoip_is_high_risk "$ip" 2>/dev/null; then
487:                 local geo_score="${PORTSCAN_SURICATA_SCORE_HIGH_RISK_GEO:-0.10}"
488:                 score=$(echo "scale=4; $score + $geo_score" | bc 2>/dev/null || echo "$score")
489:             fi
490:         fi
491:     fi
492: 
493:     # Cap score at 1.0
494:     if (( $(echo "$score > 1.0" | bc -l 2>/dev/null || echo 0) )); then
495:         score="1.0"
496:     fi
497: 
498:     echo "$score"
499: }

 418: nftban_watchdog_check_disk() {
 419:     # Check disk usage using df command
 420:     # Returns: status code, sets WATCHDOG_RESULTS
 421: 
 422:     if [[ "$NFTBAN_WATCHDOG_DISK_ENABLED" != "true" ]]; then
 423:         return 0
 424:     fi
 425: 
 426:     local path="$NFTBAN_WATCHDOG_DISK_PATH"
 427: 
 428:     # Use df -P for POSIX output
 429:     local df_output
 430:     if ! df_output=$(df -P "$path" 2>/dev/null | tail -1); then
 431:         WATCHDOG_RESULTS[disk_status]="ERROR"
 432:         WATCHDOG_RESULTS[disk_error]="Cannot check disk for $path"
 433:         return $WATCHDOG_CRITICAL
 434:     fi
 435: 
 436:     # Parse: Filesystem 1024-blocks Used Available Capacity Mounted
 437:     local -a df_vals
 438:     # Must use default IFS (space) for reading space-separated values
 439:     IFS=' ' read -ra df_vals <<< "$df_output"
 440: 
 441:     local total="${df_vals[1]:-0}"
 442:     local used="${df_vals[2]:-0}"
 443:     local available="${df_vals[3]:-0}"
 444:     local percent="${df_vals[4]:-0%}"
 445:     local mount="${df_vals[5]:-$path}"
 446: 
 447:     # Remove % from percent
 448:     percent="${percent%\%}"
 449: 
 450:     # Store in GB for readability
 451:     WATCHDOG_RESULTS[disk_path]="$path"
 452:     WATCHDOG_RESULTS[disk_mount]="$mount"
 453:     WATCHDOG_RESULTS[disk_total_gb]=$((total / 1024 / 1024))
 454:     WATCHDOG_RESULTS[disk_used_gb]=$((used / 1024 / 1024))
 455:     WATCHDOG_RESULTS[disk_available_gb]=$((available / 1024 / 1024))
 456:     WATCHDOG_RESULTS[disk_used_percent]="$percent"
 457: 
 458:     # Check thresholds
 459:     local status=$WATCHDOG_OK
 460: 
 461:     if [[ $percent -ge $NFTBAN_WATCHDOG_DISK_CRITICAL ]]; then
 462:         status=$WATCHDOG_CRITICAL
 463:         WATCHDOG_RESULTS[disk_status]="CRITICAL"
 464:         if watchdog_should_alert "disk"; then
 465:             watchdog_alert "CRITICAL" "Disk usage CRITICAL on $path: ${percent}% >= ${NFTBAN_WATCHDOG_DISK_CRITICAL}%"
 466:         fi
 467:     elif [[ $percent -ge $NFTBAN_WATCHDOG_DISK_WARNING ]]; then
 468:         status=$WATCHDOG_WARNING
 469:         WATCHDOG_RESULTS[disk_status]="WARNING"
 470:         if watchdog_should_alert "disk"; then
 471:             watchdog_alert "WARNING" "Disk usage high on $path: ${percent}% >= ${NFTBAN_WATCHDOG_DISK_WARNING}%"
 472:         fi
 473:     else
 474:         WATCHDOG_RESULTS[disk_status]="OK"
 475:     fi
 476: 
 477:     return $status
 478: }

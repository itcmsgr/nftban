# NFTBan Log Rotation Configuration
# Install to: /etc/logrotate.d/nftban
#
# Rotates:
# - /var/log/nftban/*.log (weekly, 4 weeks)
# - /var/lib/nftban/reports/* (monthly, 3 months)
# - Suricata logs (handled separately)
#
# Policy: Compress old files, keep reasonable history

# Main application logs
# v1.137 (B-05): use copytruncate — these files have multiple writers
# (daemon, watchdog, various scripts) that do NOT all reopen on a single
# service reload, so the prior rename+create+reload approach left non-
# login-monitor writers appending to the rotated-away inode. copytruncate
# truncates in place so every writer keeps writing to the live file.
/var/log/nftban/nftban.log
/var/log/nftban/login-monitor.log
/var/log/nftban/service-alerts.log {
    weekly
    rotate 4
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    create 0640 nftban nftban
}

# =============================================================================
# Ban Activity Log - CRITICAL for metrics and audit trail
# =============================================================================
# bans.log is the SINGLE SOURCE OF TRUTH for ban activity history.
# Used by: nftban_unified_exporter.sh, nftban_stats.sh
# Format: DATE|TIME|SOURCE|IP|COUNTRY|STATUS|REASON
#
# Use copytruncate: Processes hold open file handles during reads.
# The mv approach (used in nftban_stats_cleanup_logs) can cause data loss.
/var/log/nftban/bans.log {
    weekly
    rotate 12
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    size 10M
    create 0640 nftban nftban
}

# Mail, queue, and maintenance logs - bash scripts appending via >>
# Use copytruncate: safer for transient appenders, no reload needed
/var/log/nftban/mail.log
/var/log/nftban/queue.log
/var/log/nftban/maintenance.log {
    weekly
    rotate 4
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}

# =============================================================================
# Module-specific logs (DDoS, Login, Portscan, Trust)
# =============================================================================
# These can grow rapidly during attacks - daily rotation with size trigger
# Use copytruncate for bash scripts appending via >>
# v1.137: ddos.log + portscan.log are the live module operational/detection logs
# (nftban_ddos.sh _nftban_ddos_log, nftban_portscan.sh) — previously matched by
# no stanza (the split -classic/-suricata variants were covered, these were not)
# → unbounded. Same policy class as the other module logs.
/var/log/nftban/ddos.log
/var/log/nftban/ddos-classic.log
/var/log/nftban/ddos-suricata.log
/var/log/nftban/login-suricata.log
/var/log/nftban/portscan.log
/var/log/nftban/portscan-suricata.log
/var/log/nftban/portscan-classic.log
/var/log/nftban/trust.log {
    daily
    rotate 30
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    size 100M
    create 0640 nftban nftban
}

# =============================================================================
# Additional module logs (Feeds, GeoBan, Botscan, etc.)
# =============================================================================
# These modules write logs that were previously missing from rotation
/var/log/nftban/feeds.log
/var/log/nftban/geoban.log
/var/log/nftban/botscan.log
/var/log/nftban/login_alert.log
/var/log/nftban/cron.log
/var/log/nftban/soak/cron.log
/var/log/nftban/rbl.log {
    weekly
    rotate 12
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    create 0640 nftban nftban
}

# =============================================================================
# Suricata logs — MOVED to /etc/logrotate.d/nftban-suricata
# =============================================================================
# Suricata log rotation is in a separate file to avoid breaking logrotate
# when Suricata is not installed (user 'suricata' doesn't exist).
# File: /etc/logrotate.d/nftban-suricata (installed by nftban suricata setup)

# =============================================================================
# Tunnel Suspicion logs (v1.30.0 — DNS tunnel detection)
# =============================================================================
# Advisory-only module; logs suspicion scores and scan results
/var/log/nftban/tunnel.log {
    weekly
    rotate 12
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    create 0640 nftban nftban
}

# =============================================================================
# Bot Guard logs (v1.20.0 — HTTP crawler detection)
# =============================================================================
# Bot Guard Go daemon writes classification decisions and suspect tracking
/var/log/nftban/botguard/botguard.log
/var/log/nftban/botguard/decisions.log {
    daily
    rotate 30
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    size 100M
    create 0640 nftban nftban
}

# =============================================================================
# Watchdog subdirectory logs (alerts, stats, profiles)
# =============================================================================
# These are in a subdirectory of /var/log/nftban/ and need separate rotation
/var/log/nftban/watchdog/alerts.log
/var/log/nftban/watchdog/stats.log
/var/log/nftban/watchdog/profiles.log {
    weekly
    rotate 4
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    create 0640 nftban nftban
}

# =============================================================================
# Audit trail logs (actions + PAM audit)
# =============================================================================
# JSON-structured audit entries — ban/unban/config/whitelist actions + PAM events
# Has in-code rotation at 50MB (nftban_audit_rotate) but needs logrotate as safety net
/var/log/nftban/nftban-actions.log
/var/log/nftban/audit.log {
    daily
    rotate 90
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    size 50M
    create 0640 nftban nftban
}

# =============================================================================
# Health & diagnostic logs (v1.44.0 — quality tracking)
# =============================================================================
# health-incidents.log: Structured hung-process incidents, auto-heal actions
# cli-errors.log: CLI error traces from strict mode
# debug_trace.log: Debug trace entries (can be large)
# watchdog.log: Watchdog check results
/var/log/nftban/health-incidents.log
/var/log/nftban/cli-errors.log
/var/log/nftban/debug_trace.log
/var/log/nftban/watchdog.log {
    weekly
    rotate 12
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    create 0640 nftban nftban
}

# =============================================================================
# Suricata Events Log (v1.46.0 — nftban's own suricata event processing log)
# =============================================================================
# This is NFTBan's suricata event processing log, NOT suricata's own logs.
# Suricata's native logs are rotated by /etc/logrotate.d/nftban-suricata.
/var/log/nftban/suricata-events.log {
    daily
    rotate 30
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    size 100M
    create 0640 nftban nftban
}

# =============================================================================
# Installer + update lifecycle logs (v1.137 — B-09)
# =============================================================================
# Written by short-lived processes (nftban-installer, `nftban update`); were
# previously matched by NO stanza (this file enumerates paths, no *.log
# wildcard) → unbounded growth. copytruncate is safe for append-then-exit writers.
/var/log/nftban/installer.log
/var/log/nftban/update.log {
    weekly
    rotate 8
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    create 0640 nftban nftban
}

# Generated reports - monthly rotation, keep 3 months
/var/lib/nftban/reports/*.html /var/lib/nftban/reports/*.txt /var/lib/nftban/reports/*.json {
    monthly
    rotate 3
    compress
    delaycompress
    missingok
    notifempty
    olddir /var/lib/nftban/reports/archive
    createolddir 0750 nftban nftban
}

# Daily reports subdirectory
/var/lib/nftban/reports/daily/*.html /var/lib/nftban/reports/daily/*.txt {
    monthly
    rotate 3
    compress
    delaycompress
    missingok
    notifempty
}

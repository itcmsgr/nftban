 488: # Get list of active network interfaces
 489: get_active_interfaces() {
 490:     local interfaces=()
 491:     local line
 492: 
 493:     while IFS= read -r line; do
 494:         # Skip header lines
 495:         [[ "$line" =~ ^(Inter-|face) ]] && continue
 496: 
 497:         # Extract interface name
 498:         local iface
 499:         iface=$(echo "$line" | awk -F: '{print $1}' | tr -d ' ')
 500: 
 501:         # Skip unwanted interfaces
 502:         local skip=0
 503:         local skip_pattern
 504:         for skip_pattern in $SKIP_INTERFACES; do
 505:             if [[ "$iface" =~ ^${skip_pattern} ]]; then
 506:                 skip=1
 507:                 break
 508:             fi
 509:         done
 510: 
 511:         [[ $skip -eq 1 ]] && continue
 512: 
 513:         # Check if interface is up
 514:         if [[ -d "/sys/class/net/$iface" ]]; then
 515:             local operstate
 516:             operstate=$(cat "/sys/class/net/$iface/operstate" 2>/dev/null || echo "unknown")
 517:             if [[ "$operstate" == "up" ]]; then
 518:                 interfaces+=("$iface")
 519:             fi
 520:         fi
 521:     done < /proc/net/dev
 522: 
 523:     printf '%s\n' "${interfaces[@]}"
 524: }

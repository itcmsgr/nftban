# =============================================================================
# NFTBan - Service Failure Alert (Template Unit)
# =============================================================================
# SPDX-License-Identifier: MPL-2.0
# Purpose: Send alert when a critical NFTBan service fails
#
# meta:name="nftban_alert_service"
# meta:type="config"
# meta:tier="OPTIONAL"
# meta:owner="Antonios Voulvoulis <contact@nftban.com>"
# meta:created_date="2026-01-07"
# meta:description="Template service unit for NFTBan service failure alerts"
# meta:input="Failed service name via %i substitution"
# meta:output="Alert logs and optional email notifications"
# meta:depends="nftban-service-alert"
#
# meta:inventory.files=""
# meta:inventory.binaries=""
# meta:inventory.env_vars="NFTBAN_LIB_DIR,NFTBAN_CONFIG_DIR,NFTBAN_LOG_DIR,NFTBAN_DATA_DIR"
# meta:inventory.config_files=""
# meta:inventory.systemd_units=""
# meta:inventory.network=""
# meta:inventory.privileges="nftban"
#
# Usage: Add "OnFailure=nftban-alert@%n.service" to critical services
# This is a template unit - %i is replaced with the failed service name
# Example: nftban-alert@nftban-queue.service
# =============================================================================

[Unit]
Description=NFTBan Service Failure Alert for %i
Documentation=https://nftban.com/docs/alerts

# Don't start if another alert is already running for same service
# This prevents alert storms
After=network.target

[Service]
Type=oneshot

# Run as nftban user
User=nftban
Group=nftban

# Environment
Environment="NFTBAN_LIB_DIR=/usr/lib/nftban"
Environment="NFTBAN_CONFIG_DIR=/etc/nftban"
Environment="NFTBAN_LOG_DIR=/var/log/nftban"
Environment="NFTBAN_DATA_DIR=/var/lib/nftban"

# Execute alert script with failed service name
ExecStart=/usr/lib/nftban/sbin/nftban-service-alert %i

# Timeout - alert should complete quickly
TimeoutStartSec=60

# Security hardening (v1.19.0: full sandboxing — R13)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
PrivateDevices=yes
RestrictNamespaces=true
LockPersonality=true
RestrictSUIDSGID=true
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=128M
TasksMax=25
ReadWritePaths=/var/log/nftban /var/lib/nftban

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nftban-alert

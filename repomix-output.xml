<file path="cli/lib/nftban/tests/polkit_test.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0 - Polkit Authorization Test Suite
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Verify Polkit rules grant correct permissions without privilege escalation
  7: # Usage: sudo bash tests/polkit_test.sh [username]
  8: # =============================================================================
  9: 
 10: set -euo pipefail
 11: 
 12: # Colors
 13: readonly GREEN='\033[0;32m'
 14: readonly RED='\033[0;31m'
 15: readonly YELLOW='\033[1;33m'
 16: readonly BLUE='\033[0;34m'
 17: readonly NC='\033[0m'
 18: 
 19: log_info() { echo -e "${BLUE}[INFO]${NC} $*"; }
 20: log_pass() { echo -e "${GREEN}[PASS]${NC} $*"; }
 21: log_fail() { echo -e "${RED}[FAIL]${NC} $*"; }
 22: log_warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
 23: 
 24: # Check if running as root
 25: if [ "$(id -u)" -ne 0 ]; then
 26:     log_fail "Must run as root to test polkit authorization"
 27:     exit 1
 28: fi
 29: 
 30: # Get test user (default: first user in nftban group)
 31: TEST_USER="${1:-}"
 32: if [ -z "$TEST_USER" ]; then
 33:     TEST_USER=$(getent group nftban | cut -d: -f4 | cut -d, -f1)
 34:     if [ -z "$TEST_USER" ]; then
 35:         log_fail "No users found in nftban group. Please specify test user."
 36:         exit 1
 37:     fi
 38: fi
 39: 
 40: log_info "================================================================="
 41: log_info "NFTBan v1.0 Polkit Authorization Test Suite"
 42: log_info "================================================================="
 43: log_info "Test User: $TEST_USER"
 44: log_info ""
 45: 
 46: # =============================================================================
 47: # Test 1: Verify Polkit rules are installed
 48: # =============================================================================
 49: log_info "Test 1: Verifying Polkit rules installation..."
 50: 
 51: # NFTBan v1.0.19 consolidated polkit rules (3-group RBAC model)
 52: RULES=(
 53:     "/etc/polkit-1/rules.d/10-nftban-systemd.rules"
 54:     "/etc/polkit-1/rules.d/20-nftban-auditor.rules"
 55:     "/etc/polkit-1/rules.d/30-nftban-panel.rules"
 56: )
 57: 
 58: for rule in "${RULES[@]}"; do
 59:     if [ -f "$rule" ]; then
 60:         log_pass "Found: $rule"
 61:     else
 62:         log_warn "Missing: $rule"
 63:     fi
 64: done
 65: 
 66: echo ""
 67: 
 68: # =============================================================================
 69: # Test 2: Verify group memberships
 70: # =============================================================================
 71: log_info "Test 2: Verifying group memberships for $TEST_USER..."
 72: 
 73: # NFTBan v1.0 simplified 2-group model
 74: GROUPS=(
 75:     "nftban"
 76:     "nftban-auditors"
 77: )
 78: 
 79: for group in "${GROUPS[@]}"; do
 80:     if id -nG "$TEST_USER" | grep -qw "$group"; then
 81:         log_pass "User '$TEST_USER' is in group: $group"
 82:     else
 83:         log_warn "User '$TEST_USER' NOT in group: $group"
 84:     fi
 85: done
 86: 
 87: echo ""
 88: 
 89: # =============================================================================
 90: # Test 3: Test nftban-core service management (10-nftban-core.rules)
 91: # =============================================================================
 92: log_info "Test 3: Testing nftban-core service management..."
 93: 
 94: CORE_UNITS=(
 95:     "nftban-core.service"
 96:     "nftban-suricata.service"
 97:     "nftban-login-monitor.service"
 98:     "nftban.timer"
 99: )
100: 
101: for unit in "${CORE_UNITS[@]}"; do
102:     if systemctl list-unit-files "$unit" &>/dev/null; then
103:         # Test as nftban group member
104:         if su - "$TEST_USER" -c "systemctl status $unit" &>/dev/null; then
105:             log_pass "✓ $TEST_USER can query: $unit"
106:         else
107:             log_fail "✗ $TEST_USER CANNOT query: $unit"
108:         fi
109: 
110:         # Test restart (dry-run via pkcheck)
111:         if pkcheck --action-id org.freedesktop.systemd1.manage-units \
112:                    --process "$(pgrep -u "$TEST_USER" | head -1)" \
113:                    --allow-user-interaction 2>/dev/null; then
114:             log_pass "✓ $TEST_USER authorized to manage: $unit"
115:         else
116:             log_warn "✗ $TEST_USER NOT authorized to manage: $unit"
117:         fi
118:     else
119:         log_warn "Unit not installed: $unit"
120:     fi
121: done
122: 
123: echo ""
124: 
125: # =============================================================================
126: # Test 4: Test Suricata direct management (20-nftban-suricata.rules)
127: # =============================================================================
128: log_info "Test 4: Testing direct Suricata service management..."
129: 
130: SURICATA_UNITS=(
131:     "suricata.service"
132:     "suricata-update.service"
133: )
134: 
135: for unit in "${SURICATA_UNITS[@]}"; do
136:     if systemctl list-unit-files "$unit" &>/dev/null; then
137:         if su - "$TEST_USER" -c "systemctl status $unit" &>/dev/null; then
138:             log_pass "✓ $TEST_USER can query: $unit"
139:         else
140:             log_fail "✗ $TEST_USER CANNOT query: $unit"
141:         fi
142:     else
143:         log_warn "Suricata not installed: $unit"
144:     fi
145: done
146: 
147: echo ""
148: 
149: # =============================================================================
150: # Test 5: Test auth helper (50-nftban-auth.rules)
151: # =============================================================================
152: log_info "Test 5: Testing auth helper access..."
153: 
154: AUTH_HELPER="/usr/libexec/nftban-auth-helper"
155: if [ -f "$AUTH_HELPER" ]; then
156:     # Check ownership and permissions
157:     OWNER=$(stat -c '%U:%G' "$AUTH_HELPER")
158:     PERMS=$(stat -c '%a' "$AUTH_HELPER")
159: 
160:     if [ "$OWNER" = "root:root" ]; then
161:         log_pass "✓ Auth helper owned by root:root"
162:     else
163:         log_fail "✗ Auth helper owned by: $OWNER (should be root:root)"
164:     fi
165: 
166:     if [ "$PERMS" = "755" ] || [ "$PERMS" = "750" ]; then
167:         log_pass "✓ Auth helper permissions: $PERMS"
168:     else
169:         log_warn "Auth helper permissions: $PERMS (should be 755 or 750)"
170:     fi
171: else
172:     log_warn "Auth helper not found: $AUTH_HELPER"
173: fi
174: 
175: echo ""
176: 
177: # =============================================================================
178: # Test 6: Test nftables isolation (should FAIL for non-root)
179: # =============================================================================
180: log_info "Test 6: Testing nftables isolation (should deny non-root)..."
181: 
182: if su - "$TEST_USER" -c "nft list tables" &>/dev/null; then
183:     log_fail "✗ SECURITY ISSUE: $TEST_USER can run 'nft' directly!"
184: else
185:     log_pass "✓ nftables properly isolated (user cannot run 'nft')"
186: fi
187: 
188: echo ""
189: 
190: # =============================================================================
191: # Test 7: Test systemd daemon-reload
192: # =============================================================================
193: log_info "Test 7: Testing systemd daemon-reload authorization..."
194: 
195: if pkcheck --action-id org.freedesktop.systemd1.reload-daemon \
196:            --process "$(pgrep -u "$TEST_USER" | head -1)" \
197:            --allow-user-interaction 2>/dev/null; then
198:     log_pass "✓ $TEST_USER authorized for daemon-reload"
199: else
200:     log_warn "✗ $TEST_USER NOT authorized for daemon-reload"
201: fi
202: 
203: echo ""
204: 
205: # =============================================================================
206: # Test 8: Verify nftban-core runs with correct capabilities
207: # =============================================================================
208: log_info "Test 8: Verifying nftban-core systemd service capabilities..."
209: 
210: if systemctl show nftban-suricata.service -p User | grep -q "User=root"; then
211:     log_pass "✓ nftban-suricata runs as root"
212: else
213:     log_warn "nftban-suricata NOT running as root"
214: fi
215: 
216: if systemctl show nftban-suricata.service -p SupplementaryGroups | grep -q "suricata"; then
217:     log_pass "✓ nftban-suricata has supplementary group: suricata"
218: else
219:     log_warn "nftban-suricata missing supplementary group: suricata"
220: fi
221: 
222: if systemctl show nftban-suricata.service -p SupplementaryGroups | grep -q "nftban"; then
223:     log_pass "✓ nftban-suricata has supplementary group: nftban"
224: else
225:     log_warn "nftban-suricata missing supplementary group: nftban"
226: fi
227: 
228: echo ""
229: 
230: # =============================================================================
231: # Summary
232: # =============================================================================
233: log_info "================================================================="
234: log_info "Test Summary"
235: log_info "================================================================="
236: log_info "Polkit rules tested for user: $TEST_USER"
237: log_info ""
238: log_info "Expected Results:"
239: log_info "  ✓ User CAN manage nftban-* services (via 10-nftban-core.rules)"
240: log_info "  ✓ User CAN manage suricata services (via 20-nftban-suricata.rules)"
241: log_info "  ✓ User CANNOT run 'nft' directly (nftables isolated)"
242: log_info "  ✓ nftban-suricata runs as root with CAP_NET_ADMIN"
243: log_info ""
244: log_info "Manual Testing Commands (run as $TEST_USER):"
245: log_info "  systemctl status nftban-suricata.service   # Should work"
246: log_info "  systemctl restart nftban-suricata.service  # Should work without sudo"
247: log_info "  systemctl status suricata.service          # Should work"
248: log_info "  nft list tables                            # Should FAIL (permission denied)"
249: log_info ""
250: log_info "================================================================="
251: 
252: exit 0
</file>

<file path="cli/lib/nftban/tests/smoke_test.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - Smoke Test Suite
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Quick health check of CLI - detects stuck/failed scripts
  7: #
  8: # meta:name=smoke_test
  9: # meta:type=test
 10: # meta:header=Smoke Test Suite
 11: # meta:version=1.0.0
 12: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 13: # meta:homepage=https://nftban.com
 14: #
 15: # **How It Works**
 16: # 1. Enables debug trace temporarily
 17: # 2. Runs key commands with timeout
 18: # 3. Checks trace log for START without END (stuck scripts)
 19: # 4. Reports any failures
 20: #
 21: # **Usage**
 22: #   ./smoke_test.sh              # Run all tests
 23: #   ./smoke_test.sh --quick      # Quick test (core commands only)
 24: #   ./smoke_test.sh --check      # Just check trace log for orphans
 25: #
 26: # meta:created_date=2025-12-04
 27: # meta:updated_date=2025-12-04
 28: # =============================================================================
 29: 
 30: set -u
 31: 
 32: # =============================================================================
 33: # CONFIGURATION
 34: # =============================================================================
 35: 
 36: # shellcheck disable=SC2034  # Reserved for future logging
 37: readonly SCRIPT_NAME="smoke_test"
 38: readonly SCRIPT_VERSION="1.0.0"
 39: DEFAULT_TIMEOUT=30            # seconds per command (default)
 40: QUICK_TIMEOUT=15              # seconds for quick tests
 41: CURRENT_TIMEOUT=$DEFAULT_TIMEOUT  # actual timeout to use
 42: readonly TRACE_LOG="/var/log/nftban/debug_trace.log"
 43: SMOKE_LOG="/tmp/nftban_smoke_$(date +%Y%m%d_%H%M%S).log"
 44: readonly SMOKE_LOG
 45: # shellcheck disable=SC2034  # Reserved for future trace tracking
 46: readonly SMOKE_TRACE_PREFIX="smoke_test"
 47: 
 48: # Colors
 49: readonly RED='\033[0;31m'
 50: readonly GREEN='\033[0;32m'
 51: readonly YELLOW='\033[1;33m'
 52: readonly BLUE='\033[0;34m'
 53: readonly NC='\033[0m'
 54: 
 55: # Counters
 56: TESTS_TOTAL=0
 57: TESTS_PASSED=0
 58: TESTS_FAILED=0
 59: TESTS_TIMEOUT=0
 60: TESTS_ORPHANS=0
 61: 
 62: # Trace IDs for this run (reserved for future trace tracking)
 63: # shellcheck disable=SC2034
 64: declare -a SMOKE_TRACE_IDS=()
 65: 
 66: # =============================================================================
 67: # HELPER FUNCTIONS
 68: # =============================================================================
 69: 
 70: log() { echo -e "$*" | tee -a "$SMOKE_LOG"; }
 71: log_info() { log "${BLUE}[INFO]${NC} $*"; }
 72: log_pass() { log "${GREEN}[PASS]${NC} $*"; }
 73: log_fail() { log "${RED}[FAIL]${NC} $*"; }
 74: log_warn() { log "${YELLOW}[WARN]${NC} $*"; }
 75: log_timeout() { log "${RED}[TIMEOUT]${NC} $*"; }
 76: 
 77: banner() {
 78:     cat <<'BANNER'
 79: ╔══════════════════════════════════════════════════════════════╗
 80: ║  🔬 NFTBan Smoke Test Suite v1.0                             ║
 81: ║  Quick CLI health check with trace analysis                  ║
 82: ╚══════════════════════════════════════════════════════════════╝
 83: BANNER
 84: }
 85: 
 86: # =============================================================================
 87: # TRACE MANAGEMENT
 88: # =============================================================================
 89: 
 90: # Enable debug trace for this test run
 91: enable_trace() {
 92:     export NFTBAN_DEBUG_TRACE="true"
 93:     export NFTBAN_DEBUG_TRACE_LOG="$TRACE_LOG"
 94: 
 95:     # Ensure log directory exists
 96:     local log_dir
 97:     log_dir=$(dirname "$TRACE_LOG")
 98:     [[ ! -d "$log_dir" ]] && mkdir -p "$log_dir" 2>/dev/null
 99: 
100:     # Mark test start in trace log
101:     echo "[$(date '+%Y-%m-%d %H:%M:%S.%N')] [SMOKE] [START] Smoke test run started PID=$$" >> "$TRACE_LOG"
102: }
103: 
104: # Disable debug trace
105: disable_trace() {
106:     echo "[$(date '+%Y-%m-%d %H:%M:%S.%N')] [SMOKE] [END]   Smoke test run completed PID=$$" >> "$TRACE_LOG"
107:     export NFTBAN_DEBUG_TRACE="false"
108: }
109: 
110: # Check for orphaned traces from this smoke test run
111: check_orphans() {
112:     log ""
113:     log "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
114:     log "TRACE ANALYSIS - Checking for stuck/crashed scripts"
115:     log "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
116: 
117:     [[ ! -f "$TRACE_LOG" ]] && log_warn "No trace log found" && return 0
118: 
119:     local orphan_count=0
120: 
121:     # Find START without matching END
122:     while IFS= read -r line; do
123:         # Extract trace ID
124:         local trace_id
125:         trace_id=$(echo "$line" | grep -oP '\[\K[a-z_]+-[0-9]+_[0-9]+_[0-9]+-[0-9]+(?=\])')
126:         [[ -z "$trace_id" ]] && continue
127: 
128:         # Check if there's a matching END
129:         if ! grep -q "\[END\].*\[$trace_id\]" "$TRACE_LOG"; then
130:             ((orphan_count++))
131:             log_fail "ORPHAN TRACE: $trace_id"
132:             log "  $line"
133:         fi
134:     done < <(grep '\[START\]' "$TRACE_LOG" | tail -50)
135: 
136:     TESTS_ORPHANS=$orphan_count
137: 
138:     if [[ $orphan_count -eq 0 ]]; then
139:         log_pass "No orphaned traces found - all scripts completed normally"
140:     else
141:         log_fail "Found $orphan_count orphaned trace(s) - scripts may have crashed!"
142:     fi
143: 
144:     return $orphan_count
145: }
146: 
147: # =============================================================================
148: # TEST COMMAND FUNCTION
149: # =============================================================================
150: 
151: # Run a command with timeout and check results
152: # Usage: smoke_test_cmd <name> <command>
153: smoke_test_cmd() {
154:     local name="$1"
155:     shift
156:     local cmd="$*"
157:     local timeout_val="${CURRENT_TIMEOUT}"
158: 
159:     ((TESTS_TOTAL++))
160: 
161:     log ""
162:     log "─────────────────────────────────────────────────────────────────"
163:     log "TEST #$TESTS_TOTAL: $name"
164:     log "Command: $cmd"
165: 
166:     # Temp files for output
167:     local output_file="/tmp/smoke_output_$$.txt"
168:     local exit_file="/tmp/smoke_exit_$$.txt"
169: 
170:     # Run with timeout
171:     local start_time
172:     start_time=$(date +%s.%N)
173: 
174:     timeout "$timeout_val" bash -c "
175:         # Source trace library for this command
176:         if [[ -f /usr/lib/nftban/helpers/nftban_trace.sh ]]; then
177:             source /usr/lib/nftban/helpers/nftban_trace.sh
178:         fi
179:         export NFTBAN_DEBUG_TRACE=true
180:         export NFTBAN_DEBUG_TRACE_LOG='$TRACE_LOG'
181:         $cmd
182:         echo \$? > '$exit_file'
183:     " > "$output_file" 2>&1
184:     local timeout_exit=$?
185: 
186:     local end_time
187:     end_time=$(date +%s.%N)
188:     local duration
189:     duration=$(echo "$end_time - $start_time" | bc 2>/dev/null || echo "?")
190: 
191:     # Check timeout
192:     if [[ $timeout_exit -eq 124 ]]; then
193:         log_timeout "$name - exceeded ${timeout_val}s"
194:         ((TESTS_TIMEOUT++))
195:         rm -f "$output_file" "$exit_file"
196:         return 1
197:     fi
198: 
199:     # Get exit code
200:     local exit_code=999
201:     [[ -f "$exit_file" ]] && exit_code=$(cat "$exit_file")
202: 
203:     # Get output
204:     local output=""
205:     [[ -f "$output_file" ]] && output=$(cat "$output_file")
206: 
207:     # Evaluate result
208:     local output_len=${#output}
209: 
210:     if [[ -z "$output" ]]; then
211:         log_fail "$name - NO OUTPUT (${duration}s)"
212:         ((TESTS_FAILED++))
213:     elif [[ "$exit_code" == "0" ]]; then
214:         log_pass "$name - OK (exit=0, ${output_len} chars, ${duration}s)"
215:         ((TESTS_PASSED++))
216:     elif [[ "$exit_code" == "1" ]] && [[ "$name" == "health summary" ]]; then
217:         # Health exit code 1 = warnings only (acceptable)
218:         log_pass "$name - OK with warnings (exit=1, ${output_len} chars, ${duration}s)"
219:         ((TESTS_PASSED++))
220:     elif [[ "$exit_code" == "4" ]] && [[ "$name" == "health summary" ]]; then
221:         # Health exit code 4 = permission fixes applied (acceptable)
222:         log_pass "$name - OK, fixes applied (exit=4, ${output_len} chars, ${duration}s)"
223:         ((TESTS_PASSED++))
224:     elif [[ "$exit_code" == "2" ]] && [[ "$name" == "health summary" ]]; then
225:         # Health exit code 2 = errors present (failure)
226:         log_fail "$name - ERRORS detected (exit=2, ${duration}s)"
227:         ((TESTS_FAILED++))
228:     else
229:         # All other non-zero exits are failures
230:         log_fail "$name - FAILED (exit=$exit_code, ${duration}s)"
231:         ((TESTS_FAILED++))
232:     fi
233: 
234:     # Show output preview
235:     if [[ -n "$output" ]]; then
236:         log "  Output preview: $(echo "$output" | head -1 | cut -c1-60)..."
237:     fi
238: 
239:     rm -f "$output_file" "$exit_file"
240: }

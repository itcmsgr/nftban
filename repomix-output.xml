234: // loadFromFile reads and parses the config file
235: func loadFromFile(path string) (*Config, error) {
236: 	// Start with defaults
237: 	cfg := defaultConfig()
238: 
239: 	file, err := os.Open(path)
240: 	if err != nil {
241: 		if os.IsNotExist(err) {
242: 			// Config file doesn't exist - use defaults
243: 			return cfg, nil
244: 		}
245: 		return nil, err
246: 	}
247: 	defer file.Close()
248: 
249: 	scanner := bufio.NewScanner(file)
250: 	for scanner.Scan() {
251: 		line := strings.TrimSpace(scanner.Text())
252: 
253: 		// Skip empty lines and comments
254: 		if line == "" || strings.HasPrefix(line, "#") {
255: 			continue
256: 		}
257: 
258: 		// Skip bash-specific lines
259: 		if strings.HasPrefix(line, "[[") || strings.HasPrefix(line, "_NFTBAN") {
260: 			continue
261: 		}
262: 
263: 		// Parse KEY="value" or KEY=value
264: 		parts := strings.SplitN(line, "=", 2)
265: 		if len(parts) != 2 {
266: 			continue
267: 		}
268: 
269: 		key := strings.TrimSpace(parts[0])
270: 		value := strings.TrimSpace(parts[1])
271: 		value = strings.Trim(value, `"'`)
272: 
273: 		// Map to struct fields
274: 		switch key {
275: 		// Version
276: 		case "NFTBAN_VERSION":
277: 			cfg.Version = value
278: 		case "NFTBAN_CONFIG_VERSION":
279: 			cfg.ConfigVersion = value
280: 
281: 		// Binary paths
282: 		case "NFTBAN_BIN":
283: 			cfg.Bin = value
284: 		case "NFTBAN_CORE_BIN":
285: 			cfg.CoreBin = value
286: 		case "NFTBAN_UI_BIN":
287: 			cfg.UIBin = value
288: 		case "NFTBAN_AUTH_BIN":
289: 			cfg.AuthBin = value
290: 
291: 		// Directory paths
292: 		case "NFTBAN_LIB_DIR":
293: 			cfg.LibDir = value
294: 		case "NFTBAN_CONFIG_DIR":
295: 			cfg.ConfigDir = value
296: 		case "NFTBAN_DATA_DIR":
297: 			cfg.DataDir = value
298: 		case "NFTBAN_LOG_DIR":
299: 			cfg.LogDir = value
300: 		case "NFTBAN_CACHE_DIR":
301: 			cfg.CacheDir = value
302: 		case "NFTBAN_RUN_DIR":
303: 			cfg.RunDir = value
304: 
305: 		// Features
306: 		case "NFTBAN_METRICS_ENABLED":
307: 			cfg.MetricsEnabled = parseBool(value)
308: 		case "NFTBAN_METRICS_BACKEND":
309: 			cfg.MetricsBackend = value
310: 		case "NFTBAN_METRICS_SAMPLING_INTERVAL":
311: 			cfg.MetricsSamplingInterval = parseInt(value, 10)
312: 		case "NFTBAN_METRICS_MAX_SAMPLES":
313: 			cfg.MetricsMaxSamples = parseInt(value, 360)
314: 		case "NFTBAN_PROMETHEUS_DIR":
315: 			cfg.PrometheusDir = value
316: 		case "NFTBAN_METRICS_PROMETHEUS_ADDR":
317: 			cfg.MetricsPrometheusAddr = value
318: 		case "NFTBAN_METRICS_NODE_EXPORTER_ADDR":
319: 			cfg.MetricsNodeExporterAddr = value
320: 		case "NFTBAN_METRICS_VICTORIA_ADDR":
321: 			cfg.MetricsVictoriaAddr = value
322: 		case "NFTBAN_GEOIP_ENABLED":
323: 			cfg.GeoIPEnabled = parseBool(value)
324: 		case "NFTBAN_GEOIP_LICENSE_KEY":
325: 			cfg.GeoIPLicenseKey = value
326: 		case "NFTBAN_FEEDS_ENABLED":
327: 			cfg.FeedsEnabled = parseBool(value)
328: 		case "NFTBAN_FEEDS_AUTO_UPDATE":
329: 			cfg.FeedsAutoUpdate = parseBool(value)
330: 		case "NFTBAN_SURICATA_ENABLED":
331: 			cfg.SuricataEnabled = parseBool(value)
332: 		case "NFTBAN_GUI_ENABLED":
333: 			cfg.GUIEnabled = parseBool(value)
334: 		case "NFTBAN_GUI_ADDR":
335: 			cfg.GUIAddr = value
336: 		case "NFTBAN_PORTSCAN_ENABLED":
337: 			cfg.PortscanEnabled = parseBool(value)
338: 		case "NFTBAN_DDOS_ENABLED":
339: 			cfg.DDoSEnabled = parseBool(value)
340: 		case "NFTBAN_LOGIN_MONITOR_ENABLED":
341: 			cfg.LoginMonitorEnabled = parseBool(value)
342: 
343: 		// Suricata
344: 		case "NFTBAN_SURICATA_EVE_LOG":
345: 			cfg.SuricataEveLog = value
346: 		case "NFTBAN_SURICATA_LOG_DIR":
347: 			cfg.SuricataLogDir = value
348: 		case "NFTBAN_SURICATA_BAN_THRESHOLD":
349: 			cfg.SuricataBanThreshold = parseInt(value, 100)
350: 		case "NFTBAN_SURICATA_SCORE_DECAY":
351: 			cfg.SuricataScoreDecay = parseInt(value, 3600)
352: 		case "NFTBAN_SURICATA_CLOUDFLARE_WHITELIST":
353: 			cfg.SuricataCloudflareWhitelist = parseBool(value)
354: 
355: 		// Grafana
356: 		case "NFTBAN_GRAFANA_ENABLED":
357: 			cfg.GrafanaEnabled = parseBool(value)
358: 		case "NFTBAN_GRAFANA_URL":
359: 			cfg.GrafanaURL = value
360: 		case "NFTBAN_GRAFANA_API_KEY":
361: 			cfg.GrafanaAPIKey = value
362: 
363: 		// Logging
364: 		case "NFTBAN_LOG_LEVEL":
365: 			cfg.LogLevel = value
366: 		case "NFTBAN_COLOR_OUTPUT":
367: 			cfg.ColorOutput = parseBool(value)
368: 		case "NFTBAN_DEBUG_TRACE":
369: 			cfg.DebugTrace = parseBool(value)
370: 		case "NFTBAN_DEBUG_TRACE_LOG":
371: 			cfg.DebugTraceLog = value
372: 
373: 		// Distro
374: 		case "NFTBAN_DISTRO_CONF_DIR":
375: 			cfg.DistroConfDir = value
376: 		}
377: 	}
378: 
379: 	return cfg, scanner.Err()
380: }

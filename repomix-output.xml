 40: NFTBAN is an enterprise-grade firewall management engine built on Linux nftables.
 41: It replaces legacy firewall scripts with a modern architecture featuring atomic
 42: rule updates, strict privilege separation via Polkit, and AI-assisted threat
 43: intelligence.
 44: 
 45: Named for NFTables BAN actions, NFTBAN provides deterministic, high-performance
 46: packet filtering at the kernel level. Moving beyond traditional iptables-based
 47: tools, it delivers a resilient, self-healing network defense layer.
 48: 
 49: Features: Atomic updates, Polkit security, threat intelligence feeds, GeoIP
 50: blocking, port scan/DDoS detection, hosting panel integration, and full
 51: observability via Prometheus/Grafana.
 52: 
 53: %prep
 54: %setup -q
 55: 
 56: %install
 57: # Installation handled by install.sh during build
 58: 
 59: %pre
 60: # Pre-install: Create user and group
 61: getent group nftban >/dev/null || groupadd -r nftban
 62: getent group nftban-auditors >/dev/null || groupadd -r nftban-auditors
 63: getent passwd nftban >/dev/null || \
 64:     useradd -r -g nftban -G nftban-auditors -d /var/lib/nftban \
 65:     -s /sbin/nologin -c "NFTBan Service Account" nftban
 66: exit 0
 67: 
 68: %post
 69: # Post-install: Configure and enable services
 70: 
 71: # ==========================================================================
 72: # STEP 0: Check for Conflicting Firewalls
 73: # ==========================================================================
 74: echo "Checking for conflicting firewalls..."
 75: 
 76: CONFLICTS_FOUND=0
 77: FIREWALL_ISSUES=""
 78: 
 79: # Check firewalld
 80: if command -v firewall-cmd >/dev/null 2>&1; then
 81:     if systemctl is-active --quiet firewalld 2>/dev/null; then
 82:         FIREWALL_ISSUES="${FIREWALL_ISSUES}firewalld (ACTIVE) "
 83:         CONFLICTS_FOUND=1
 84:     elif systemctl is-enabled --quiet firewalld 2>/dev/null; then
 85:         FIREWALL_ISSUES="${FIREWALL_ISSUES}firewalld (ENABLED) "
 86:         CONFLICTS_FOUND=1
 87:     fi
 88: fi
 89: 
 90: # Check iptables service
 91: if systemctl is-active --quiet iptables 2>/dev/null || \
 92:    systemctl is-active --quiet iptables.service 2>/dev/null || \
 93:    systemctl is-active --quiet ip6tables.service 2>/dev/null; then
 94:     FIREWALL_ISSUES="${FIREWALL_ISSUES}iptables-services (ACTIVE) "
 95:     CONFLICTS_FOUND=1
 96: fi
 97: 
 98: # Check ufw
 99: if command -v ufw >/dev/null 2>&1; then
100:     if ufw status 2>/dev/null | grep -q "Status: active"; then
101:         FIREWALL_ISSUES="${FIREWALL_ISSUES}ufw (ACTIVE) "
102:         CONFLICTS_FOUND=1
103:     fi
104: fi
105: 
106: if [ $CONFLICTS_FOUND -eq 1 ]; then
107:     echo ""
108:     echo "=========================================="
109:     echo " ERROR: CONFLICTING FIREWALL(S) DETECTED!"
110:     echo "=========================================="
111:     echo ""
112:     echo "NFTBan cannot coexist with: ${FIREWALL_ISSUES}"
113:     echo ""
114:     echo "These firewalls will cause:"
115:     echo "  • Duplicate filtering rules"
116:     echo "  • Unpredictable blocking behavior"
117:     echo "  • NFTBan blocks may not work"
118:     echo ""
119:     echo "Please disable conflicting firewalls:"
120:     echo ""
121: 
122:     if echo "$FIREWALL_ISSUES" | grep -q "firewalld"; then
123:         echo "  systemctl stop firewalld"
124:         echo "  systemctl disable firewalld"
125:         echo ""
126:     fi
127: 
128:     if echo "$FIREWALL_ISSUES" | grep -q "iptables"; then
129:         echo "  systemctl stop iptables"
130:         echo "  systemctl disable iptables"
131:         echo "  systemctl stop ip6tables"
132:         echo "  systemctl disable ip6tables"
133:         echo ""
134:     fi
135: 
136:     if echo "$FIREWALL_ISSUES" | grep -q "ufw"; then
137:         echo "  ufw disable"
138:         echo "  systemctl stop ufw"
139:         echo "  systemctl disable ufw"
140:         echo ""
141:     fi
142: 
143:     echo "Then re-install: dnf reinstall nftban"
144:     echo ""
145:     exit 1
146: fi
147: 
148: echo "  No conflicting firewalls detected"
149: 
150: # ==========================================================================
151: # STEP 0.5: Ensure EPEL and CRB Repositories (RHEL Family)
152: # ==========================================================================
153: echo "Ensuring required repositories..."
154: 
155: # Detect RHEL version
156: if [ -f /etc/os-release ]; then
157:     . /etc/os-release
158:     VERSION_ID_MAJOR="${VERSION_ID%%.*}"
159: fi
160: 
161: # Determine CRB/PowerTools name based on version
162: if [ "${VERSION_ID_MAJOR}" -ge 9 ]; then
163:     CRB_NAME="crb"
164: else
165:     CRB_NAME="powertools"
166: fi
167: 
168: # Install EPEL if not present
169: if ! rpm -qa | grep -q epel-release; then
170:     echo "  Installing EPEL repository..."
171:     dnf install -y epel-release 2>/dev/null || yum install -y epel-release 2>/dev/null || true
172:     echo "  EPEL repository installed"
173: else
174:     echo "  EPEL repository already installed"
175: fi
176: 
177: # Enable CRB/PowerTools repository
178: if command -v dnf &>/dev/null; then
179:     if ! dnf repolist enabled 2>/dev/null | grep -q "${CRB_NAME}"; then
180:         echo "  Enabling ${CRB_NAME} repository..."
181:         dnf config-manager --set-enabled "${CRB_NAME}" 2>/dev/null || true
182:         echo "  ${CRB_NAME} repository enabled"
183:     else
184:         echo "  ${CRB_NAME} repository already enabled"
185:     fi
186: elif command -v yum &>/dev/null; then
187:     if ! yum repolist enabled 2>/dev/null | grep -q "${CRB_NAME}"; then
188:         echo "  Enabling ${CRB_NAME} repository..."
189:         yum-config-manager --enable "${CRB_NAME}" 2>/dev/null || true
190:         echo "  ${CRB_NAME} repository enabled"
191:     else
192:         echo "  ${CRB_NAME} repository already enabled"
193:     fi
194: fi
195: 
196: # Disable conflicting testing repositories
197: for repo in epel-testing epel-modular epel-next epel-next-testing; do
198:     if dnf repolist enabled 2>/dev/null | grep -q "$repo" || yum repolist enabled 2>/dev/null | grep -q "$repo"; then
199:         dnf config-manager --set-disabled "$repo" 2>/dev/null || yum-config-manager --disable "$repo" 2>/dev/null || true
200:     fi
201: done
202: 
203: echo "  Repository setup complete"
204: 
205: # Create directories
206: install -d -m 750 -o root -g nftban /etc/nftban/ports.d 2>/dev/null || true
207: install -d -m 750 -o root -g nftban /etc/nftban/whitelist.d 2>/dev/null || true
208: install -d -m 750 -o nftban -g nftban /var/log/nftban 2>/dev/null || true
209: 
210: # Auto-detect SSH port
211: SSH_PORT="22"
212: if [ -f /etc/ssh/sshd_config ]; then
213:     DETECTED=$(grep -E "^Port[[:space:]]+" /etc/ssh/sshd_config 2>/dev/null | awk '{print $2}' | head -1)
214:     if [ -n "$DETECTED" ]; then
215:         SSH_PORT="$DETECTED"
216:     fi
217: fi
218: 
219: # Create SSH port whitelist if not exists
220: if [ ! -f /etc/nftban/ports.d/00-ssh.conf ]; then
221:     cat > /etc/nftban/ports.d/00-ssh.conf << EOF
222: # Auto-generated SSH port whitelist
223: # Created by: NFTBan RPM package
224: [ssh]
225: port=$SSH_PORT
226: protocol=tcp
227: direction=input
228: EOF
229:     chmod 644 /etc/nftban/ports.d/00-ssh.conf
230:     chown root:nftban /etc/nftban/ports.d/00-ssh.conf 2>/dev/null || true
231:     echo "SSH port whitelisted: $SSH_PORT/tcp"
232: fi
233: 
234: # Auto-whitelist system IP (prevents lockout)
235: SYSTEM_IP=$(ip route get 1.1.1.1 2>/dev/null | grep -oP 'src \K[0-9.]+' | head -1)
236: if [ -z "$SYSTEM_IP" ]; then
237:     SYSTEM_IP=$(hostname -I 2>/dev/null | awk '{print $1}')
238: fi
239: if [ -n "$SYSTEM_IP" ]; then
240:     if [ ! -f /etc/nftban/whitelist.d/00-system-ip.conf ]; then
241:         cat > /etc/nftban/whitelist.d/00-system-ip.conf << EOF
242: # Auto-generated system IP whitelist
243: # Created by: NFTBan RPM package
244: # Purpose: Prevent lockout from this server
245: $SYSTEM_IP
246: EOF
247:         chmod 644 /etc/nftban/whitelist.d/00-system-ip.conf
248:         chown root:nftban /etc/nftban/whitelist.d/00-system-ip.conf 2>/dev/null || true
249:         echo "System IP whitelisted: $SYSTEM_IP"
250:     fi
251: fi
252: 
253: systemctl daemon-reload >/dev/null 2>&1 || true
254: 
255: # ==========================================================================
256: # AUTO-ENABLE DEFAULT FEATURES (aligned with install.sh)
257: # ==========================================================================
258: 
259: # 1. Download FREE GeoIP database (DB-IP)
260: GEOIP_DIR="/var/lib/nftban/geoip"
261: GEOIP_FILE="${GEOIP_DIR}/dbip-country-lite.mmdb"
262: GEOIP_URL="https://download.db-ip.com/free/dbip-country-lite-$(date +%Y-%m).mmdb.gz"
263: 
264: mkdir -p "$GEOIP_DIR"
265: chown nftban:nftban "$GEOIP_DIR" 2>/dev/null || true
266: 
267: if [ ! -f "$GEOIP_FILE" ]; then
268:     echo "Downloading FREE GeoIP database..."
269:     if curl -fsSL "$GEOIP_URL" -o "${GEOIP_FILE}.gz" 2>/dev/null; then
270:         gunzip -f "${GEOIP_FILE}.gz" 2>/dev/null || true
271:         chown nftban:nftban "$GEOIP_FILE" 2>/dev/null || true
272:         chmod 644 "$GEOIP_FILE"
273:         echo "GeoIP database downloaded"
274:     else
275:         echo "GeoIP download failed (will retry on first use)"
276:     fi
277: fi
278: 
279: # 2. Enable Login Monitoring
280: if [ -f /etc/nftban/nftban.conf ]; then
281:     sed -i 's/^NFTBAN_LOGIN_ALERT_ENABLED=.*/NFTBAN_LOGIN_ALERT_ENABLED="true"/' /etc/nftban/nftban.conf 2>/dev/null || true
282:     sed -i 's/^NFTBAN_LOGIN_ALERT_SSH=.*/NFTBAN_LOGIN_ALERT_SSH="true"/' /etc/nftban/nftban.conf 2>/dev/null || true
283: fi
284: systemctl enable nftban-login-monitor.service >/dev/null 2>&1 || true
285: systemctl start nftban-login-monitor.service >/dev/null 2>&1 || true
286: 
287: # 3. Enable GeoIP Blocking
288: if [ -f /etc/nftban/nftban.conf ]; then
289:     sed -i 's/^NFTBAN_GEOIP_ENABLED=.*/NFTBAN_GEOIP_ENABLED="true"/' /etc/nftban/nftban.conf 2>/dev/null || true
290: fi
291: 
292: # 4. Enable core timers (health, maintenance)
293: for timer in nftban-health.timer nftban-maintenance.timer; do
294:     systemctl enable "$timer" >/dev/null 2>&1 || true
295:     systemctl start "$timer" >/dev/null 2>&1 || true
296: done
297: 
298: echo ""
299: echo "NFTBan installed successfully!"
300: echo ""
301: echo "Auto-enabled:"
302: echo "  - Login monitoring (SSH alerts)"
303: echo "  - GeoIP blocking"
304: echo "  - Core timers (health, maintenance)"
305: echo ""
306: echo "Enable optional features:"
307: echo "  nftban feeds enable      # Threat intel feeds"
308: echo "  nftban portscan enable   # Port scan detection"
309: echo "  nftban ddos enable       # DDoS protection"
310: echo "  nftban gui enable        # Web GUI"
311: echo "  nftban metrics enable    # Metrics collection"
312: 
313: %preun
314: # Pre-uninstall: Stop all services
315: if [ $1 -eq 0 ]; then
316:     echo "Stopping NFTBan services..."
317: 
318:     # Stop all timers (complete list from install.sh)
319:     for timer in nftban-health.timer nftban-maintenance.timer \
320:                  nftban-watchdog.timer nftban-snapshot.timer \
321:                  nftban-rollback.timer nftban-metrics-exporter.timer \
322:                  nftban-suricata-update.timer nftban-queue.timer \
323:                  nftban-core-geoip.timer nftban-core-feeds.timer; do
324:         systemctl stop "$timer" >/dev/null 2>&1 || true
325:         systemctl disable "$timer" >/dev/null 2>&1 || true
326:     done
327: 
328:     # Stop login monitor
329:     systemctl stop nftban-login-monitor.service >/dev/null 2>&1 || true
330:     systemctl disable nftban-login-monitor.service >/dev/null 2>&1 || true
331: 
332:     # Stop core services
333:     for svc in nftban-ui.service nftban.service; do
334:         systemctl stop "$svc" >/dev/null 2>&1 || true
335:         systemctl disable "$svc" >/dev/null 2>&1 || true
336:     done
337: fi
338: 
339: %postun
340: # Post-uninstall: Cleanup
341: systemctl daemon-reload >/dev/null 2>&1 || true
342: 
343: if [ $1 -eq 0 ]; then
344:     # Full removal (not upgrade)
345:     echo "NFTBan removed. Config files preserved in /etc/nftban"
346:     echo "Run 'rm -rf /etc/nftban /var/lib/nftban /var/log/nftban' to purge all data"
347: fi
348: 
349: %files
350: # File list generated during build
351: 
352: %changelog
353: * Tue Dec 17 2024 NFTBan Team <contact@nftban.com> - 1.0.0-1
354: - Initial release
355: - Modular architecture with Go binaries
356: - GeoIP blocking, threat feeds, login monitoring
357: - Suricata IDS integration
358: - Web GUI with Prometheus metrics
</file>

<file path="install/systemd/nftban-core-feeds.service">
 1: [Unit]
 2: Description=NFTBan Core - Feed Update
 3: Documentation=https://github.com/itcmsgr/nftban-dev
 4: After=network-online.target
 5: 
 6: [Service]
 7: Type=oneshot
 8: # Log to both journal AND file for easy viewing
 9: ExecStart=/bin/bash -c '/usr/bin/nftban feeds update 2>&1 | tee -a /var/log/nftban/feeds.log'
10: StandardOutput=journal
11: StandardError=journal
12: SyslogIdentifier=nftban-feeds
13: 
14: # Security hardening
15: NoNewPrivileges=true
16: PrivateTmp=true
17: ProtectSystem=strict
18: ProtectHome=true
19: ReadWritePaths=/etc/nftban /var/lib/nftban /var/log/nftban
20: ProtectKernelTunables=true
21: ProtectKernelModules=true
22: ProtectControlGroups=true
23: RestrictRealtime=true
24: RestrictNamespaces=true
25: LockPersonality=true
26: # IMPORTANT: MemoryDenyWriteExecute is intentionally NOT set for Go services.
27: # It breaks Go runtime on Ubuntu 24.04 (AppArmor + Landlock) and potentially
28: # future SELinux-enforcing distributions. Security is maintained through
29: # other hardening measures. See: docs/architecture/SYSTEMD_GO_HARDENING.md
30: RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
31: SystemCallFilter=@system-service
32: SystemCallErrorNumber=EPERM
33: 
34: # Resource limits
35: CPUQuota=80%
36: MemoryMax=512M
37: TasksMax=20
38: TimeoutStartSec=15min
39: 
40: [Install]
41: WantedBy=multi-user.target
</file>

<file path="install/systemd/nftban-core-feeds.timer">
 1: [Unit]
 2: Description=NFTBan Core - Daily Feed Update Timer
 3: Documentation=https://github.com/itcmsgr/nftban-dev

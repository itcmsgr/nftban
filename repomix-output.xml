2831:             existing_gid="${NFTBAN_GID:-}"
2832:             existing_auditors_gid="${NFTBAN_AUDITORS_GID:-}"
2833: 
2834:             if [[ "$existing_uid" != "$nftban_uid" ]] || \
2835:                [[ "$existing_gid" != "$nftban_gid" ]] || \
2836:                [[ "$existing_auditors_gid" != "$nftban_auditors_gid" ]]; then
2837:                 needs_update=1
2838:                 echo "  → System config outdated (UID/GID changed), will update"
2839:             fi
2840:         else
2841:             needs_update=1
2842:             echo "  → System config corrupted, will recreate"
2843:         fi
2844:     fi
2845: 
2846:     # Create/update if needed
2847:     if [[ $needs_update -eq 1 ]]; then
2848:         cat > "$system_conf" <<EOF
2849: # =============================================================================
2850: # NFTBan System Configuration (AUTO-GENERATED - DO NOT EDIT)
2851: # =============================================================================
2852: # Generated: $(date -u +"%Y-%m-%d %H:%M:%S UTC")
2853: # Hostname: $(hostname)
2854: #
2855: # ⚠️  WARNING: DO NOT EDIT THIS FILE MANUALLY

<file path="install/systemd/nftban-watchdog.service">
 1: [Unit]
 2: Description=NFTBan System Watchdog Check
 3: Documentation=man:nftban(8)
 4: After=network.target nftables.service
 5: 
 6: [Service]
 7: Type=oneshot
 8: 
 9: # Run as unprivileged nftban user
10: User=nftban
11: Group=nftban
12: 
13: # Run watchdog checks and export metrics
14: # Uses the core watchdog module which:
15: # - Reads system metrics from /proc
16: # - Saves reports to /var/lib/nftban/reports/watchdog/
17: # - Exports Prometheus metrics to /var/lib/nftban/metrics/
18: # - Sends alerts to syslog when thresholds exceeded
19: ExecStart=/usr/bin/nftban watchdog report --save
20: 
21: # Exit codes: 0=OK, 1=warnings, 2=critical - all are valid check results
22: SuccessExitStatus=0 1 2
23: 
24: # Logging
25: StandardOutput=journal
26: StandardError=journal
27: SyslogIdentifier=nftban-watchdog
28: 
29: # Security hardening - read-only except for output directories
30: PrivateTmp=yes
31: NoNewPrivileges=yes
32: ProtectSystem=full
33: ProtectHome=yes
34: ReadOnlyPaths=/etc /usr /proc
35: ReadWritePaths=/var/log/nftban /var/lib/nftban /run/nftban
36: 
37: [Install]
38: WantedBy=multi-user.target
</file>


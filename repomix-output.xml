 526: rm -f /usr/share/polkit-1/actions/com.nftban.suricata.policy 2>/dev/null || true
 527: 
 528: # Remove obsolete port-status rules (v1.0.15 and earlier - security risk)
 529: rm -f /etc/polkit-1/rules.d/50-nftban-port-status.rules 2>/dev/null || true
 530: rm -f /etc/polkit-1/rules.d/50-nftban-port-status.rules.in 2>/dev/null || true
 531: rm -f /usr/share/polkit-1/rules.d/50-nftban-port-status.rules 2>/dev/null || true
 532: 
 533: echo "[NFTBan] Obsolete file cleanup complete"
 534: 
 535: # =============================================================================
 536: # Rest of install flow continues below...
 537: # =============================================================================
 538: # This prevents lockout by ensuring whitelist is in place BEFORE firewall is active.
 539: 
 540: echo "[NFTBan] Configuring NFTBan v1.0.0..."
 541: 
 542: # STEP 1: Remove old systemd overrides (prevent conflicts with new package files)
 543: echo "[NFTBan] Removing old systemd overrides..."
 544: rm -f /etc/systemd/system/nftban-*.service 2>/dev/null || true
 545: rm -f /etc/systemd/system/nftban-*.timer 2>/dev/null || true
 546: rm -rf /etc/systemd/system/nftban-*.service.d 2>/dev/null || true
 547: systemctl daemon-reload 2>/dev/null || true
 548: 
 549: # STEP 2: Create FHS directories
 550: echo "[NFTBan] Creating FHS directories..."
 551: mkdir -p /etc/nftban/{conf.d,distros,whitelist.d,blacklist.d,ports.d}
 552: mkdir -p /etc/nftban/conf.d/{ddos,portscan,login,panels}
 553: mkdir -p /var/lib/nftban/{banned,whitelist,feeds,geoip,reports,config,state,metrics,snapshots,exports,panels}
 554: mkdir -p /var/lib/nftban/reports/{baseline,auditors}
 555: mkdir -p /var/log/nftban/reports
 556: mkdir -p /var/cache/nftban/health
 557: mkdir -p /run/nftban
 558: mkdir -p /usr/share/nftban/templates/{mail,reports}
 559: 
 560: # STEP 3: Set permissions
 561: echo "[NFTBan] Setting permissions..."
 562: chown root:nftban /etc/nftban 2>/dev/null || true
 563: chmod 750 /etc/nftban 2>/dev/null || true
 564: chown -R nftban:nftban /var/lib/nftban /var/log/nftban /var/cache/nftban 2>/dev/null || true
 565: chmod 750 /var/lib/nftban /var/log/nftban 2>/dev/null || true
 566: chmod 755 /var/cache/nftban 2>/dev/null || true
 567: 
 568: # Set executable on shell scripts
 569: find /usr/lib/nftban -name "*.sh" -exec chmod 755 {} \; 2>/dev/null || true
 570: 
 571: # Set capabilities for nftban-core (allows non-root nftables operations)
 572: if [ -x /usr/lib/nftban/bin/nftban-core ]; then
 573:     setcap 'cap_net_admin+ep' /usr/lib/nftban/bin/nftban-core 2>/dev/null || \
 574:         echo "[NFTBan WARN] Could not set CAP_NET_ADMIN on nftban-core"
 575: fi
 576: 
 577: # Set capabilities for nft binary (required for CLI fallback operations)
 578: if [ -x /usr/sbin/nft ]; then
 579:     setcap 'cap_net_admin+ep' /usr/sbin/nft 2>/dev/null || \
 580:         echo "[NFTBan WARN] Could not set CAP_NET_ADMIN on nft"
 581: fi
 582: 
 583: # STEP 4: Polkit
 584: echo "[NFTBan] Installing polkit policies..."
 585: mkdir -p /usr/share/polkit-1/rules.d /etc/polkit-1/rules.d
 586: systemctl restart polkit 2>/dev/null || true
 587: 
 588: # STEP 5: **SAFETY** Auto-whitelist system IPs
 589: # CRITICAL: This MUST happen BEFORE enabling any firewall services
 590: echo "[NFTBan] Auto-whitelisting system IPs (lockout prevention)..."
 591: if command -v nftban >/dev/null 2>&1; then
 592:     nftban whitelist-system sync 2>/dev/null || echo "[NFTBan WARN] Auto-whitelist failed"
 593: fi
 594: 
 595: # STEP 6: Download GeoIP database (free DB-IP version)
 596: echo "[NFTBan] Downloading GeoIP database..."
 597: if [ -x /usr/lib/nftban/bin/nftban-core ]; then
 598:     /usr/lib/nftban/bin/nftban-core geoip update 2>/dev/null || echo "[NFTBan WARN] GeoIP download failed (will retry via timer)"
 599: fi
 600: 
 601: # STEP 7: Health check
 602: if command -v nftban >/dev/null 2>&1; then
 603:     nftban health check --quiet 2>/dev/null || true
 604: fi
 605: 
 606: # STEP 8: Enable services (AFTER whitelist is in place)
 607: echo "[NFTBan] Enabling systemd services..."
 608: %systemd_post nftban-maintenance.service nftban-maintenance.timer nftban-health.service nftban-health.timer nftban-login-monitor.service nftban-core-geoip.timer nftban-core-feeds.timer
 609: 
 610: # Enable nftables
 611: systemctl enable nftables 2>/dev/null || true
 612: 
 613: # Enable and start essential timers
 614: echo "[NFTBan] Starting essential timers..."
 615: systemctl enable --now nftban-maintenance.timer 2>/dev/null || true
 616: systemctl enable --now nftban-health.timer 2>/dev/null || true
 617: systemctl enable --now nftban-core-geoip.timer 2>/dev/null || true
 618: systemctl enable --now nftban-core-feeds.timer 2>/dev/null || true
 619: systemctl enable --now nftban-queue.timer 2>/dev/null || true
 620: 
 621: # Enable and start login monitor
 622: systemctl enable --now nftban-login-monitor.service 2>/dev/null || true
 623: 
 624: # STEP 9: Configure nftables to load NFTBan config (distro-aware)
 625: echo "[NFTBan] Configuring nftables service..."
 626: # Source distro config library to get correct paths
 627: if [ -f /usr/lib/nftban/lib/nftban_distro_config.sh ]; then
 628:     source /usr/lib/nftban/lib/nftban_distro_config.sh 2>/dev/null || true
 629: 
 630:     # Get distro-specific nftables.conf path
 631:     nftban_distro_load_config 2>/dev/null || true
 632:     SYSTEM_NFT_CONF=\$(nftban_distro_get_path "nftables_conf" 2>/dev/null)
 633: 
 634:     if [ -n "\$SYSTEM_NFT_CONF" ] && [ -f "\$SYSTEM_NFT_CONF" ]; then
 635:         # Check if already configured
 636:         if ! grep -q "/etc/nftban/nftables.conf" "\$SYSTEM_NFT_CONF" 2>/dev/null; then
 637:             echo "# NFTBan firewall configuration" >> "\$SYSTEM_NFT_CONF"
 638:             echo "include \\"/etc/nftban/nftables.conf\\"" >> "\$SYSTEM_NFT_CONF"
 639:             echo "[NFTBan] Added NFTBan config to \$SYSTEM_NFT_CONF"
 640:         fi
 641:     fi
 642: fi
 643: 
 644: # Load nftables configuration
 645: systemctl reload nftables 2>/dev/null || systemctl restart nftables 2>/dev/null || true
 646: 
 647: # STEP 10: Sync whitelist.d files to nftables sets
 648: # The nftables template has only default IPs, this loads the actual detected system IPs
 649: echo "[NFTBan] Syncing whitelist files to nftables..."
 650: if [ -x /usr/lib/nftban/bin/nftban-core ]; then
 651:     /usr/lib/nftban/bin/nftban-core sync 2>/dev/null || echo "[NFTBan WARN] Whitelist sync failed (run manually: nftban-core sync)"
 652: fi
 653: 
 654: echo "[NFTBan] Installation complete. Your IP has been auto-whitelisted."
 655: echo "[NFTBan] Essential timers started. Run 'nftban timers enable' to start all optional timers."

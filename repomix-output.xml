2767: // DashboardMetricsHandler provides all metrics for impressive dashboard in one call
2768: // OPTIMIZED: Removed slow nftban health call (9+ seconds), use Prometheus metrics instead
2769: func DashboardMetricsHandler(w http.ResponseWriter, r *http.Request) {
2770: 	// Get authenticated user
2771: 	claims, ok := r.Context().Value(middleware.UserContextKey).(*auth.Claims)
2772: 	if !ok {
2773: 		respondJSON(w, http.StatusUnauthorized, ErrorResponse{Error: "Unauthorized"})
2774: 		return
2775: 	}
2776: 	markUserActive(claims.Username)
2777: 
2778: 	// Aggregate all metrics in one response for impressive dashboard
2779: 	response := make(map[string]interface{})
2780: 
2781: 	// 1. Prometheus metrics (if available) - includes CPU, RAM, Disk, Uptime
2782: 	// Use central config for metrics file path
2783: 	if content, err := os.ReadFile(getPrometheusFile()); err == nil {
2784: 		promMetrics := parsePrometheusMetrics(string(content))
2785: 		response["prometheus"] = promMetrics
2786: 
2787: 		// Extract system stats for dashboard (cpu, ram, disk, uptime)
2788: 		// parsePrometheusMetrics returns map[string]interface{}, so use it directly
2789: 		// CPU usage from node_cpu_seconds_total
2790: 		if cpu, ok := promMetrics["node_cpu_seconds_total"].(float64); ok {
2791: 			response["cpu"] = fmt.Sprintf("%.1f%%", cpu)
2792: 		}
2793: 
2794: 		// RAM usage from node_memory_MemAvailable_bytes
2795: 		if memAvail, ok := promMetrics["node_memory_MemAvailable_bytes"].(float64); ok {
2796: 			if memTotal, ok2 := promMetrics["node_memory_MemTotal_bytes"].(float64); ok2 && memTotal > 0 {
2797: 				usedPercent := ((memTotal - memAvail) / memTotal) * 100
2798: 				response["ram"] = fmt.Sprintf("%.1f%%", usedPercent)
2799: 			}
2800: 		}
2801: 
2802: 		// Disk usage from node_filesystem_avail_bytes (root partition)
2803: 		if diskAvail, ok := promMetrics["node_filesystem_avail_bytes"].(float64); ok {
2804: 			if diskTotal, ok2 := promMetrics["node_filesystem_size_bytes"].(float64); ok2 && diskTotal > 0 {
2805: 				usedPercent := ((diskTotal - diskAvail) / diskTotal) * 100
2806: 				response["disk"] = fmt.Sprintf("%.1f%%", usedPercent)
2807: 			}
2808: 		}
2809: 
2810: 		// Uptime from node_boot_time_seconds
2811: 		if bootTime, ok := promMetrics["node_boot_time_seconds"].(float64); ok {
2812: 			uptimeSeconds := time.Now().Unix() - int64(bootTime)
2813: 			days := uptimeSeconds / 86400
2814: 			hours := (uptimeSeconds % 86400) / 3600
2815: 			response["uptime"] = fmt.Sprintf("%dd %dh", days, hours)
2816: 		}
2817: 	} else {
2818: 		// Fallback: If Prometheus metrics not available, use basic system info
2819: 		response["cpu"] = "N/A"
2820: 		response["ram"] = "N/A"
2821: 		response["disk"] = "N/A"
2822: 		response["uptime"] = "N/A"
2823: 	}
2824: 
2825: 	// 2. Current stats (from cache)
2826: 	statsCacheMux.RLock()
2827: 	response["stats"] = statsCache
2828: 	statsCacheMux.RUnlock()
2829: 
2830: 	// 3. REMOVED: Slow nftban health call (9+ seconds)
2831: 	// Health data available via separate /api/v1/health endpoint if needed
2832: 
2833: 	// 4. Grafana availability (fast check) - use service name from central config
2834: 	grafanaServiceName := "grafana-server"
2835: 	if svc := nftbanconf.GetServices(); svc != nil {
2836: 		grafanaServiceName = svc.Grafana
2837: 	}
2838: 	cmd := exec.Command("systemctl", "is-active", grafanaServiceName)
2839: 	grafanaOutput, _ := cmd.Output()
2840: 	response["grafana_available"] = strings.TrimSpace(string(grafanaOutput)) == "active"
2841: 
2842: 	// 5. REMOVED: Recent bans call (can be slow)
2843: 	// Use stats cache instead, which is updated periodically
2844: 
2845: 	// 6. REMOVED: Top countries call (can be slow)
2846: 	// Available via separate /api/v1/stats/countries endpoint
2847: 
2848: 	response["timestamp"] = time.Now().Unix()
2849: 
2850: 	respondJSON(w, http.StatusOK, response)
2851: }

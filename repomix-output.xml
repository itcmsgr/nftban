206: nftban_cmd_rbl_check() {
207:     # Check IPs against RBL servers
208:     # Options: --ip, --fresh, --json, --verbose, --quiet, --alert
209: 
210:     local ip=""
211:     local fresh=0
212:     local format="text"
213:     local verbose=0
214:     local quiet=0
215:     local alert=0
216: 
217:     # Parse arguments
218:     while [[ $# -gt 0 ]]; do
219:         case "$1" in
220:             --ip)
221:                 ip="$2"
222:                 shift 2
223:                 ;;
224:             --fresh)
225:                 fresh=1
226:                 shift
227:                 ;;
228:             --json)
229:                 format="json"
230:                 shift
231:                 ;;
232:             --verbose)
233:                 verbose=1
234:                 export NFTBAN_RBL_VERBOSE="YES"
235:                 shift
236:                 ;;
237:             --quiet)
238:                 quiet=1
239:                 shift
240:                 ;;
241:             --alert)
242:                 alert=1
243:                 shift
244:                 ;;
245:             *)
246:                 echo "Error: Unknown option: $1" >&2
247:                 return 1
248:                 ;;
249:         esac
250:     done
251: 
252:     # Get IPs to check
253:     local ips_to_check=()
254: 
255:     if [[ -n "$ip" ]]; then
256:         # Check specific IP
257:         ips_to_check+=("$ip")
258:     else
259:         # Auto-discover IPs
260:         if [[ "${NFTBAN_RBL_AUTO_DISCOVER_IPS:-YES}" == "YES" ]]; then
261:             while IFS= read -r discovered_ip; do
262:                 ips_to_check+=("$discovered_ip")
263:             done < <(nftban_rbl_get_public_ips)
264:         fi
265: 
266:         # Add critical IPs
267:         while IFS=: read -r critical_ip tag; do
268:             ips_to_check+=("$critical_ip:$tag")
269:         done < <(nftban_rbl_get_critical_ips)
270:     fi
271: 
272:     if [[ ${#ips_to_check[@]} -eq 0 ]]; then
273:         echo "Error: No IPs to check" >&2
274:         return 1
275:     fi
276: 
277:     # Check each IP
278:     local any_listed=0
279:     for ip_entry in "${ips_to_check[@]}"; do
280:         local check_ip="${ip_entry%%:*}"
281:         local ip_tag="${ip_entry#*:}"
282:         [[ "$ip_tag" == "$check_ip" ]] && ip_tag=""
283: 
284:         [[ $quiet -eq 0 ]] && echo ""
285:         [[ $quiet -eq 0 ]] && [[ -n "$ip_tag" ]] && echo "Checking: $check_ip (tag: $ip_tag)"
286:         [[ $quiet -eq 0 ]] && [[ -z "$ip_tag" ]] && echo "Checking: $check_ip"
287: 
288:         # Check cache if not fresh
289:         local cache_file
290:         if [[ $fresh -eq 0 ]] && cache_file=$(nftban_rbl_cache_get "$check_ip"); then
291:             [[ $quiet -eq 0 ]] && echo "(Using cached results)"
292:             cat "$cache_file"
293:         else
294:             # Perform fresh check
295:             local results
296:             results=$(nftban_rbl_check_ip "$check_ip" "$format")
297: 
298:             # Cache results
299:             echo "$results" | nftban_rbl_cache_set "$check_ip"
300: 
301:             # Output results
302:             echo "$results"
303: 
304:             # Check if listed and send alert if requested
305:             if [[ $alert -eq 1 ]] && echo "$results" | grep -q "LISTED"; then
306:                 any_listed=1
307:                 # Extract first RBL and reason for alert
308:                 local first_rbl
309:                 local first_reason
310:                 first_rbl=$(echo "$results" | grep "LISTED:" | head -n1 | awk '{print $3}')
311:                 first_reason=$(echo "$results" | grep "Reason:" | head -n1 | sed 's/.*Reason: //')
312: 
313:                 if [[ "${NFTBAN_RBL_ALERT_ON_NEW_LISTING:-YES}" == "YES" ]]; then
314:                     if nftban_rbl_check_new_listing "$check_ip" "listed"; then
315:                         nftban_rbl_send_alert "$check_ip" "$first_rbl" "$first_reason" "$ip_tag"
316:                     fi
317:                 fi
318: 
319:                 # Update state
320:                 nftban_rbl_update_state "$check_ip" "listed"
321:             else
322:                 nftban_rbl_update_state "$check_ip" "clean"
323:             fi
324:         fi
325:     done
326: 
327:     # Update last check timestamp
328:     mkdir -p "${NFTBAN_RBL_CACHE_DIR}"
329:     date -Iseconds > "${NFTBAN_RBL_CACHE_DIR}/last_check"
330: 
331:     # Return exit code based on listings
332:     return $any_listed
333: }

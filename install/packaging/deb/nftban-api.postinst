#!/bin/bash
# NFTBan API - Post-installation script
set -e

# Create system group
if ! getent group nftban-web >/dev/null; then
    addgroup --system nftban-web
fi

# Create system user
if ! getent passwd nftban-www >/dev/null; then
    adduser --system --ingroup nftban-web --home /var/lib/nftban-www \
        --no-create-home --shell /usr/sbin/nologin \
        --gecos "NFTBan Web API" nftban-www
fi

# Create TLS directory
mkdir -p /etc/nftban/tls
chown nftban-www:nftban-web /etc/nftban/tls
chmod 750 /etc/nftban/tls

# Generate self-signed TLS certificate if not exists
if [[ ! -f /etc/nftban/tls/cert.pem ]]; then
    openssl req -x509 -newkey rsa:4096 -nodes \
        -keyout /etc/nftban/tls/key.pem \
        -out /etc/nftban/tls/cert.pem \
        -days 365 -subj "/CN=$(hostname)" &>/dev/null || true

    if [[ -f /etc/nftban/tls/cert.pem ]]; then
        chown nftban-www:nftban-web /etc/nftban/tls/*.pem
        chmod 600 /etc/nftban/tls/key.pem
        chmod 644 /etc/nftban/tls/cert.pem
    fi
fi

# Reload systemd
systemctl daemon-reload || true

# Enable (but don't start) service
systemctl enable nftban-api.service || true

echo ""
echo "NFTBan Web API installed successfully!"
echo ""
echo "To start the service:"
echo "  sudo systemctl start nftban-api"
echo ""
echo "Or use the CLI:"
echo "  sudo nftban gui enable"
echo ""

#DEBHELPER#

exit 0

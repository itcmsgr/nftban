400: // run is the main sampling loop
401: func (s *Sampler) run() {
402: 	for {
403: 		select {
404: 		case <-s.ticker.C:
405: 			s.takeSample()
406: 
407: 		case <-s.stopChan:
408: 			log.Println("[METRICS] Sampler stopped")
409: 			return
410: 		}
411: 	}
412: }

<file path="cli/lib/nftban/core/nftban_cloudflare.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - Cloudflare Core Module
  4: # Part of NFTBan v1.0.0 - FHS-Compliant Architecture
  5: # =============================================================================
  6: # SPDX-License-Identifier: MPL-2.0
  7: # Purpose: Cloudflare IP range management and whitelist integration
  8: #
  9: # meta:name=nftban_cloudflare
 10: # meta:type=module
 11: # meta:header=Cloudflare Integration Module
 12: # meta:version=1.0.0
 13: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 14: # meta:homepage=https://nftban.com
 15: #
 16: # **Description & Purpose**
 17: # meta:description=Downloads and manages Cloudflare IP ranges for whitelisting
 18: # meta:input=Cloudflare API endpoints
 19: # meta:output=Whitelist files and nftables integration
 20: #
 21: # **Inventory & Requirements**
 22: # meta:depends=bash,curl,nftban_output.sh,nftban_system_ip.sh
 23: #
 24: # meta:created_date=2025-11-05
 25: # meta:updated_date=2025-11-24
 26: # =============================================================================
 27: 
 28: IFS=$'\n\t'
 29: umask 027
 30: 
 31: # Module guard - prevent double-loading
 32: [[ -n "${NFTBAN_CLOUDFLARE_LOADED:-}" ]] && return 0
 33: readonly NFTBAN_CLOUDFLARE_LOADED=1
 34: 
 35: # =============================================================================
 36: # MODULE CONFIGURATION
 37: # =============================================================================
 38: # shellcheck disable=SC2034  # Module metadata used when sourced
 39: readonly MODULE_NAME="nftban_cloudflare"
 40: # Module metadata - reserved for future module registry
 41: readonly MODULE_VERSION="0.7.3"
 42: # shellcheck disable=SC2034
 43: 
 44: # FHS Paths (loaded from conf.d/cloudflare.conf)
 45: readonly CF_CACHE_DIR="${CLOUDFLARE_CACHE_DIR:-/var/cache/nftban/cloudflare}"
 46: readonly CF_DATA_DIR="${CLOUDFLARE_DATA_DIR:-/var/lib/nftban/cloudflare}"
 47: readonly CF_WHITELIST_FILE="${CLOUDFLARE_WHITELIST_FILE:-/etc/nftban/whitelist.d/20-cloudflare.conf}"
 48: readonly CF_LOG="${CLOUDFLARE_LOG_FILE:-/var/log/nftban/cloudflare.log}"
 49: 
 50: # Cache files
 51: readonly CF_IPV4_CACHE="${CF_CACHE_DIR}/cloudflare-ipv4.txt"
 52: readonly CF_IPV6_CACHE="${CF_CACHE_DIR}/cloudflare-ipv6.txt"
 53: 
 54: # Download URLs (from config)
 55: CF_IPV4_URL="${CLOUDFLARE_IPV4_URL:-https://www.cloudflare.com/ips-v4}"
 56: CF_IPV6_URL="${CLOUDFLARE_IPV6_URL:-https://www.cloudflare.com/ips-v6}"
 57: 
 58: # Validation limits (from config)
 59: CF_MIN_IPV4="${CLOUDFLARE_MIN_IPV4_RANGES:-10}"
 60: CF_MIN_IPV6="${CLOUDFLARE_MIN_IPV6_RANGES:-5}"
 61: CF_MAX_IPV4="${CLOUDFLARE_MAX_IPV4_RANGES:-100}"
 62: CF_MAX_IPV6="${CLOUDFLARE_MAX_IPV6_RANGES:-50}"
 63: 
 64: # =============================================================================
 65: # ERROR TRAP
 66: # =============================================================================
 67: _nftban_cloudflare_on_err() {
 68:     local rc=$?
 69:     local line="${1:-unknown}"
 70:     local func="${2:-main}"
 71: 
 72:     if declare -f nftban_log_error >/dev/null 2>&1; then
 73:         nftban_log_error "CLOUDFLARE MODULE ERROR in ${func} at line ${line}; exit status ${rc}"
 74:     else
 75:         echo "ERROR: CLOUDFLARE MODULE in ${func} at line ${line}; exit status ${rc}" >&2
 76:     fi
 77: 
 78:     return $rc
 79: }
 80: 
 81: trap '_nftban_cloudflare_on_err ${LINENO} ${FUNCNAME[0]:-main}' ERR
 82: 
 83: # =============================================================================
 84: # LOGGING
 85: # =============================================================================
 86: _cf_log() {
 87:     local level="$1"; shift
 88:     local message="$*"
 89:     local timestamp
 90:     timestamp=$(date '+%Y-%m-%d %H:%M:%S')
 91: 
 92:     mkdir -p "$(dirname "$CF_LOG")"
 93: 
 94:     # FHS-compliant: Ensure log file has correct ownership for auditors
 95:     # Fix: cloudflare.log was owned by root:root, blocking nftban-auditors access
 96:     if [[ ! -f "$CF_LOG" ]]; then
 97:         touch "$CF_LOG"
 98:         # Prefer nftban-auditors group for audit access, fallback to nftban
 99:         if getent group nftban-auditors >/dev/null 2>&1; then
100:             chown nftban:nftban-auditors "$CF_LOG" 2>/dev/null || chown nftban:nftban "$CF_LOG"
101:         else
102:             chown nftban:nftban "$CF_LOG"
103:         fi
104:         chmod 640 "$CF_LOG"
105:     fi
106: 
107:     echo "[${timestamp}] [${level}] ${message}" >> "$CF_LOG"
108: 
109:     # Also log to system if nftban_log_* available
110:     local log_func="nftban_log_${level,,}"
111:     if declare -f "$log_func" >/dev/null 2>&1; then
112:         "$log_func" "CLOUDFLARE: ${message}"
113:     fi
114: }
115: 
116: # =============================================================================
117: # BANNER
118: # =============================================================================
119: nftban_cloudflare_banner() {
120:     cat <<'BANNER'
121: ╔══════════════════════════════════════════════════════════╗
122: ║  ☁️  Cloudflare Integration                              ║
123: ║  nftban — Simplifying Linux Firewall Management         ║
124: ╚══════════════════════════════════════════════════════════╝
125: BANNER
126: }
127: 
128: # =============================================================================
129: # INITIALIZATION
130: # =============================================================================
131: nftban_cloudflare_init() {
132:     # Create required directories
133:     mkdir -p "$CF_CACHE_DIR" "$CF_DATA_DIR" "$(dirname "$CF_WHITELIST_FILE")"
134: 
135:     # Create log directory
136:     mkdir -p "$(dirname "$CF_LOG")"
137: 
138:     _cf_log "INFO" "Cloudflare module initialized"
139: }
140: 
141: # =============================================================================
142: # DOWNLOAD CLOUDFLARE IP RANGES
143: # =============================================================================
144: nftban_cloudflare_download_ips() {
145:     _cf_log "INFO" "Downloading Cloudflare IP ranges..."
146: 
147:     local ipv4_enabled="${CLOUDFLARE_IPV4_ENABLED:-true}"
148:     local ipv6_enabled="${CLOUDFLARE_IPV6_ENABLED:-true}"
149:     local success=true
150: 
151:     # Download IPv4
152:     if [[ "$ipv4_enabled" == "true" ]]; then
153:         _cf_log "INFO" "Downloading IPv4 ranges from: $CF_IPV4_URL"
154: 
155:         if curl -sf --max-time 30 "$CF_IPV4_URL" -o "${CF_IPV4_CACHE}.tmp" 2>/dev/null; then
156:             local count
157:             count=$(wc -l < "${CF_IPV4_CACHE}.tmp")
158: 
159:             # Validate count
160:             if (( count < CF_MIN_IPV4 )); then
161:                 _cf_log "ERROR" "IPv4 validation failed: only $count ranges (minimum: $CF_MIN_IPV4)"
162:                 rm -f "${CF_IPV4_CACHE}.tmp"
163:                 success=false
164:             elif (( count > CF_MAX_IPV4 )); then
165:                 _cf_log "WARN" "IPv4 count unusually high: $count ranges (expected < $CF_MAX_IPV4)"
166:                 mv "${CF_IPV4_CACHE}.tmp" "$CF_IPV4_CACHE"
167:                 _cf_log "INFO" "Downloaded $count IPv4 ranges"
168:             else
169:                 mv "${CF_IPV4_CACHE}.tmp" "$CF_IPV4_CACHE"
170:                 _cf_log "INFO" "Downloaded $count IPv4 ranges"
171:             fi
172:         else
173:             _cf_log "ERROR" "Failed to download IPv4 ranges"
174:             rm -f "${CF_IPV4_CACHE}.tmp"
175:             success=false
176:         fi
177:     fi
178: 
179:     # Download IPv6
180:     if [[ "$ipv6_enabled" == "true" ]]; then
181:         _cf_log "INFO" "Downloading IPv6 ranges from: $CF_IPV6_URL"
182: 
183:         if curl -sf --max-time 30 "$CF_IPV6_URL" -o "${CF_IPV6_CACHE}.tmp" 2>/dev/null; then
184:             local count
185:             count=$(wc -l < "${CF_IPV6_CACHE}.tmp")
186: 
187:             # Validate count
188:             if (( count < CF_MIN_IPV6 )); then
189:                 _cf_log "ERROR" "IPv6 validation failed: only $count ranges (minimum: $CF_MIN_IPV6)"
190:                 rm -f "${CF_IPV6_CACHE}.tmp"
191:                 success=false
192:             elif (( count > CF_MAX_IPV6 )); then
193:                 _cf_log "WARN" "IPv6 count unusually high: $count ranges (expected < $CF_MAX_IPV6)"
194:                 mv "${CF_IPV6_CACHE}.tmp" "$CF_IPV6_CACHE"
195:                 _cf_log "INFO" "Downloaded $count IPv6 ranges"
196:             else
197:                 mv "${CF_IPV6_CACHE}.tmp" "$CF_IPV6_CACHE"
198:                 _cf_log "INFO" "Downloaded $count IPv6 ranges"
199:             fi
200:         else
201:             _cf_log "ERROR" "Failed to download IPv6 ranges"
202:             rm -f "${CF_IPV6_CACHE}.tmp"
203:             success=false
204:         fi
205:     fi
206: 
207:     if $success; then
208:         return 0
209:     else
210:         return 1
211:     fi
212: }
213: 
214: # =============================================================================
215: # WRITE TO WHITELIST FILE (v0.6.0)
216: # =============================================================================
217: nftban_cloudflare_write_to_whitelist() {
218:     _cf_log "INFO" "Writing Cloudflare IPs to whitelist file: $CF_WHITELIST_FILE"
219: 
220:     # Create whitelist file with header
221:     cat > "$CF_WHITELIST_FILE" << 'EOF'
222: # =============================================================================
223: # NFTBan Cloudflare Whitelist (Auto-managed)
224: # =============================================================================
225: # This file is automatically managed by nftban cloudflare module
226: # Generated: __TIMESTAMP__
227: #
228: # DO NOT EDIT MANUALLY - Changes will be overwritten on next update
229: #
230: # Contains Cloudflare IP ranges for CDN/Proxy whitelisting
231: # When you use Cloudflare, all traffic comes from these IPs
232: # =============================================================================
233: 
234: EOF
235: 
236:     # Replace timestamp
237:     sed -i "s/__TIMESTAMP__/$(date -Iseconds)/" "$CF_WHITELIST_FILE"
238: 
239:     # Append IPv4 ranges
240:     if [[ -f "$CF_IPV4_CACHE" ]]; then
241:         {
242:             echo ""
243:             echo "# Cloudflare IPv4 Ranges"
244:             cat "$CF_IPV4_CACHE"
245:         } >> "$CF_WHITELIST_FILE"
246:     fi
247: 
248:     # Append IPv6 ranges
249:     if [[ -f "$CF_IPV6_CACHE" ]]; then
250:         {
251:             echo ""
252:             echo "# Cloudflare IPv6 Ranges"
253:             cat "$CF_IPV6_CACHE"
254:         } >> "$CF_WHITELIST_FILE"
255:     fi
256: 
257:     # Set correct permissions so autoheal/periodic sync can read it
258:     chmod 640 "$CF_WHITELIST_FILE"
259:     chown root:nftban "$CF_WHITELIST_FILE" 2>/dev/null || true
260: 
261:     local total
262:     total=$({ grep -v "^#" "$CF_WHITELIST_FILE" | grep -v "^$" || true; } | wc -l)
263: 
264:     _cf_log "INFO" "Wrote $total Cloudflare IP ranges to whitelist"
265:     _cf_log "INFO" "Whitelist will be synced to nftables by autoheal mechanism"
266: 
267:     return 0
268: }
269: 
270: # =============================================================================
271: # CLEAR WHITELIST FILE
272: # =============================================================================
273: nftban_cloudflare_clear_whitelist() {
274:     _cf_log "INFO" "Clearing Cloudflare whitelist file"
275: 
276:     cat > "$CF_WHITELIST_FILE" << 'EOF'
277: # =============================================================================
278: # NFTBan Cloudflare Whitelist (Auto-managed)
279: # =============================================================================
280: # Cloudflare integration is currently DISABLED
281: # This file will be populated when integration is re-enabled
282: #
283: # To enable: nftban cloudflare enable
284: # =============================================================================
285: 
286: EOF
287: 
288:     # Remove cache files
289:     rm -f "$CF_IPV4_CACHE" "$CF_IPV6_CACHE"
290: 
291:     _cf_log "INFO" "Cloudflare whitelist cleared"
292: }
293: 
294: # =============================================================================
295: # ENABLE CLOUDFLARE INTEGRATION
296: # =============================================================================
297: nftban_cloudflare_enable() {
298:     nftban_cloudflare_banner
299:     echo ""
300:     echo "Enabling Cloudflare Integration..."
301:     echo ""
302: 
303:     # Initialize directories
304:     nftban_cloudflare_init
305: 
306:     # Download IP ranges
307:     echo "⏳ Downloading Cloudflare IP ranges..."
308:     if ! nftban_cloudflare_download_ips; then
309:         echo "❌ Failed to download Cloudflare IPs"
310:         _cf_log "ERROR" "Failed to enable Cloudflare integration"
311:         return 1
312:     fi
313:     echo "✅ IP ranges downloaded successfully"
314: 
315:     # Write to whitelist file
316:     echo "⏳ Writing to whitelist file..."
317:     nftban_cloudflare_write_to_whitelist
318:     echo "✅ Whitelist file updated: $CF_WHITELIST_FILE"
319: 
320:     # Trigger system whitelist rebuild (v0.6.0)
321:     if declare -f nftban_system_ip_rebuild >/dev/null 2>&1; then
322:         echo "⏳ Rebuilding system whitelist..."
323:         nftban_system_ip_rebuild
324:         echo "✅ System whitelist rebuilt"
325:     fi
326: 
327:     # Trigger atomic reload (v0.6.0)
328:     if declare -f nftban_atomic_reload >/dev/null 2>&1; then
329:         echo "⏳ Applying to nftables..."
330:         nftban_atomic_reload
331:         echo "✅ nftables updated"
332:     fi
333: 
334:     # Update configuration
335:     local config_local="${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf.local"
336: 
337:     # Create config file if it doesn't exist
338:     if [[ ! -f "$config_local" ]]; then
339:         touch "$config_local"
340:         chmod 644 "$config_local"
341:     fi
342: 
343:     # Update CLOUDFLARE_ENABLED setting
344:     if ! grep -q "^CLOUDFLARE_ENABLED=" "$config_local" 2>/dev/null; then
345:         echo 'CLOUDFLARE_ENABLED="true"' >> "$config_local"
346:     else
347:         sed -i 's/^CLOUDFLARE_ENABLED=.*/CLOUDFLARE_ENABLED="true"/' "$config_local"
348:     fi
349: 
350:     echo ""
351:     echo "╔══════════════════════════════════════════════════════════╗"
352:     echo "║  ✅ Cloudflare Integration ENABLED                       ║"
353:     echo "╚══════════════════════════════════════════════════════════╝"
354:     echo ""
355: 
356:     # Show stats
357:     local ipv4_count=0 ipv6_count=0
358:     [[ -f "$CF_IPV4_CACHE" ]] && ipv4_count=$(wc -l < "$CF_IPV4_CACHE")
359:     [[ -f "$CF_IPV6_CACHE" ]] && ipv6_count=$(wc -l < "$CF_IPV6_CACHE")
360: 
361:     echo "📊 Statistics:"
362:     echo "   IPv4 ranges: $ipv4_count"
363:     echo "   IPv6 ranges: $ipv6_count"
364:     echo "   Whitelist file: $CF_WHITELIST_FILE"
365:     echo ""
366: 
367:     _cf_log "INFO" "Cloudflare integration enabled ($ipv4_count IPv4, $ipv6_count IPv6)"
368: 
369:     return 0
370: }
371: 
372: # =============================================================================
373: # DISABLE CLOUDFLARE INTEGRATION
374: # =============================================================================
375: nftban_cloudflare_disable() {
376:     nftban_cloudflare_banner
377:     echo ""
378:     echo "Disabling Cloudflare Integration..."
379:     echo ""
380: 
381:     # Clear whitelist file
382:     echo "⏳ Clearing whitelist file..."
383:     nftban_cloudflare_clear_whitelist
384:     echo "✅ Whitelist file cleared"
385: 
386:     # Trigger system whitelist rebuild (v0.6.0)
387:     if declare -f nftban_system_ip_rebuild >/dev/null 2>&1; then
388:         echo "⏳ Rebuilding system whitelist..."
389:         nftban_system_ip_rebuild
390:         echo "✅ System whitelist rebuilt"
391:     fi
392: 
393:     # Trigger atomic reload (v0.6.0)
394:     if declare -f nftban_atomic_reload >/dev/null 2>&1; then
395:         echo "⏳ Applying to nftables..."
396:         nftban_atomic_reload
397:         echo "✅ nftables updated"
398:     fi
399: 
400:     # Update configuration
401:     if [[ -f "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf.local" ]]; then
402:         if ! grep -q "^CLOUDFLARE_ENABLED=" "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf.local" 2>/dev/null; then
403:             echo 'CLOUDFLARE_ENABLED="false"' >> "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf.local"
404:         else
405:             sed -i 's/^CLOUDFLARE_ENABLED=.*/CLOUDFLARE_ENABLED="false"/' "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf.local"
406:         fi
407:     fi
408: 
409:     echo ""
410:     echo "╔══════════════════════════════════════════════════════════╗"
411:     echo "║  ✅ Cloudflare Integration DISABLED                      ║"
412:     echo "╚══════════════════════════════════════════════════════════╝"
413:     echo ""
414: 
415:     _cf_log "INFO" "Cloudflare integration disabled"
416: 
417:     return 0
418: }
419: 
420: # =============================================================================
421: # UPDATE CLOUDFLARE IP RANGES
422: # =============================================================================
423: nftban_cloudflare_update() {
424:     local cf_enabled="${CLOUDFLARE_ENABLED:-false}"
425: 
426:     if [[ "$cf_enabled" != "true" ]]; then
427:         echo "❌ Cloudflare integration is disabled"

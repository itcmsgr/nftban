 36: 
 37: # Default paths (may be overridden by caller)
 38: : "${NFTBAN_LIB_DIR:=/usr/lib/nftban}"
 39: 
 40: # Load dependencies
 41: if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_file_ops.sh" ]]; then
 42:     source "${NFTBAN_LIB_DIR}/core/nftban_file_ops.sh"
 43: fi
 44: 
 45: : "${NFTBAN_WHITELIST_SYSTEM:=/etc/nftban/whitelist.d/00-system.conf}"
 46: 
 47: # =============================================================================
 48: # PUBLIC IP DETECTION
 49: # =============================================================================
 50: 
 51: nftban_get_public_ip() {
 52:     local ip_type="$1"  # ipv4 or ipv6
 53:     local ip=""
 54: 
 55:     # Primary method: Use ip command (fast, reliable, no network dependency)
 56:     if command -v ip &>/dev/null; then
 57:         if [[ "$ip_type" == "ipv4" ]]; then
 58:             # Get first global IPv4 (excluding loopback)
 59:             ip=$(ip -4 addr show scope global 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | head -1)
 60:         else
 61:             # Get first global IPv6 (excluding link-local fe80::)
 62:             ip=$(ip -6 addr show scope global 2>/dev/null | grep -oP '(?<=inet6\s)[0-9a-f:]+' | grep -v '^fe80:' | head -1)
 63:         fi
 64: 
 65:         # Return if found via ip command
 66:         if [[ -n "$ip" ]]; then
 67:             echo "$ip"
 68:             return 0
 69:         fi
 70:     fi
 71: 
 72:     # Fallback method: External services (if ip command unavailable or no result)
 73:     local services=(
 74:         "https://api.ipify.org"
 75:         "https://icanhazip.com"
 76:         "https://ident.me"
 77:         "https://ifconfig.me/ip"
 78:     )
 79: 
 80:     for service in "${services[@]}"; do
 81:         if command -v curl &>/dev/null; then
 82:             if [[ "$ip_type" == "ipv4" ]]; then
 83:                 ip=$(curl -4 -s --connect-timeout 3 "$service" 2>/dev/null | grep -Eo '([0-9]{1,3}\.){3}[0-9]{1,3}' | head -1)
 84:             else
 85:                 # Fixed IPv6 regex - more strict to avoid matching timestamps
 86:                 ip=$(curl -6 -s --connect-timeout 3 "$service" 2>/dev/null | grep -Eo '(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))' | head -1)
 87:             fi
 88:             [[ -n "$ip" ]] && break
 89:         elif command -v wget &>/dev/null; then
 90:             if [[ "$ip_type" == "ipv4" ]]; then
 91:                 ip=$(wget -4 -q -O - --timeout=3 "$service" 2>/dev/null | grep -Eo '([0-9]{1,3}\.){3}[0-9]{1,3}' | head -1)
 92:             else
 93:                 # Fixed IPv6 regex - more strict to avoid matching timestamps
 94:                 ip=$(wget -6 -q -O - --timeout=3 "$service" 2>/dev/null | grep -Eo '(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))' | head -1)
 95:             fi
 96:             [[ -n "$ip" ]] && break
 97:         fi
 98:     done
 99: 
100:     echo "$ip"
101: }
102: 
103: # =============================================================================
104: # CURRENT USER IP DETECTION
105: # =============================================================================
106: 
107: nftban_get_current_user_ip() {
108:     # Try SSH_CLIENT first (most reliable for SSH connections)
109:     local ssh_client="${SSH_CLIENT%% *}"
110:     if [[ -n "$ssh_client" ]]; then
111:         echo "$ssh_client"
112:         return 0
113:     fi
114: 
115:     # Try SSH_CONNECTION
116:     if [[ -n "${SSH_CONNECTION}" ]]; then
117:         echo "${SSH_CONNECTION%% *}"
118:         return 0
119:     fi
120: 
121:     # Try who command
122:     local who_output
123:     who_output=$(who -u 2>/dev/null | awk '{print $NF}' | tr -d '()' | head -1)
124:     if [[ -n "$who_output" && "$who_output" != "0.0.0.0" && "$who_output" != ":0" ]]; then
125:         echo "$who_output"
126:         return 0
127:     fi
128: 
129:     # Try last command
130:     local last_ip
131:     last_ip=$(last -i 2>/dev/null | grep "still logged in" | awk '{print $3}' | head -1)
132:     if [[ -n "$last_ip" && "$last_ip" != "0.0.0.0" ]]; then
133:         echo "$last_ip"
134:         return 0
135:     fi
136: 
137:     # No remote connection detected
138:     return 1
139: }
140: 
141: # =============================================================================
142: # INTERFACE IP DETECTION
143: # =============================================================================
144: 
145: nftban_get_interface_ips() {
146:     # Get all IPv4 and IPv6 addresses from all interfaces
147:     # Excludes 127.0.0.1 and ::1 (handled separately)
148:     ip -o addr show 2>/dev/null | \
149:         awk '/inet/ {gsub(/\/.*/, "", $4); print $4}' | \
150:         grep -v "^127\." | \
151:         grep -v "^::1$" | \
152:         sort -u
153: }
154: 
155: # =============================================================================
156: # CHECK IF IP ALREADY WHITELISTED
157: # =============================================================================
158: 
159: nftban_is_ip_whitelisted() {
160:     local ip="$1"
161: 
162:     # Check if IP exists in system whitelist
163:     [[ -f "$NFTBAN_WHITELIST_SYSTEM" ]] || return 1
164: 
165:     # Match IP at start of line (with optional CIDR)
166:     grep -qE "^${ip}([[:space:]]|/|$)" "$NFTBAN_WHITELIST_SYSTEM" 2>/dev/null
167: }
168: 
169: # =============================================================================
170: # ADD IP TO SYSTEM WHITELIST (ATOMIC)
171: # =============================================================================
172: 
173: nftban_add_system_ip() {
174:     local ip="$1"
175:     local comment="$2"
176: 
177:     # Skip if already whitelisted
178:     if nftban_is_ip_whitelisted "$ip"; then
179:         echo "[SKIP] Already whitelisted: $ip"
180:         return 0
181:     fi
182: 
183:     # Ensure whitelist file exists
184:     if [[ ! -f "$NFTBAN_WHITELIST_SYSTEM" ]]; then
185:         mkdir -p "$(dirname "$NFTBAN_WHITELIST_SYSTEM")"
186:         cat > "$NFTBAN_WHITELIST_SYSTEM" <<'HEADER'
187: # NFTBan System Whitelist - Auto-Generated
188: # DO NOT EDIT MANUALLY - Use: nftban whitelist-system sync
189: # This file contains auto-detected system IPs (localhost, interfaces, public IPs)
190: HEADER
191:     fi
192: 
193:     # Add IP using atomic append
194:     if declare -f nftban_atomic_append >/dev/null 2>&1; then
195:         echo "$ip  # $comment (added: $(date -u +'%Y-%m-%d %H:%M:%S UTC'))" | \
196:             nftban_atomic_append "$NFTBAN_WHITELIST_SYSTEM"
197:     else
198:         # Fallback to regular append if atomic not available
199:         echo "$ip  # $comment (added: $(date -u +'%Y-%m-%d %H:%M:%S UTC'))" >> "$NFTBAN_WHITELIST_SYSTEM"
200:     fi
201: 
202:     echo "[ADD] Whitelisted: $ip ($comment)"
203: }
204: 
205: # =============================================================================
206: # REMOVE IP FROM BLACKLISTS
207: # =============================================================================
208: 
209: nftban_remove_from_blacklists() {
210:     local ip="$1"
211:     local removed=0
212: 
213:     # Find all blacklist files
214:     local blacklist_files=(
215:         /etc/nftban/blacklist.d/*.conf
216:     )
217: 
218:     for file in "${blacklist_files[@]}"; do
219:         [[ ! -f "$file" ]] && continue
220: 
221:         # Check if IP exists in this blacklist
222:         if grep -qE "^${ip}([[:space:]]|/|$)" "$file" 2>/dev/null; then
223:             echo "  [REMOVE] Removing $ip from $(basename "$file")"
224: 
225:             # Remove IP using atomic operation
226:             if declare -f nftban_atomic_write >/dev/null 2>&1; then
227:                 grep -vE "^${ip}([[:space:]]|/|$)" "$file" | nftban_atomic_write "$file"
228:             else
229:                 # Fallback to temp file
230:                 local tmpfile
231:                 tmpfile=$(mktemp)
232:                 grep -vE "^${ip}([[:space:]]|/|$)" "$file" > "$tmpfile"
233:                 mv "$tmpfile" "$file"
234:             fi
235: 
236:             removed=$((removed + 1)) || true
237:         fi
238:     done
239: 
240:     return $removed
241: }
242: 
243: # =============================================================================
244: # AUTO-DETECT AND WHITELIST ALL SYSTEM IPS
245: # =============================================================================
246: 
247: nftban_whitelist_system_sync() {
248:     echo "═══════════════════════════════════════════════════════"
249:     echo "NFTBan System IP Auto-Detection"
250:     echo "═══════════════════════════════════════════════════════"
251:     echo ""
252: 
253:     local protected=0
254:     local removed_from_blacklist=0
255: 
256:     # 1. Localhost IPs
257:     echo "[1/5] Protecting localhost..."
258:     for ip in "127.0.0.1" "::1"; do
259:         if nftban_add_system_ip "$ip" "Localhost (critical)"; then
260:             protected=$((protected + 1)) || true
261:         fi
262:         # Ensure not in blacklist
263:         if nftban_remove_from_blacklists "$ip"; then
264:             removed_from_blacklist=$((removed_from_blacklist + 1)) || true
265:         fi
266:     done
267:     echo ""
268: 
269:     # 2. Interface IPs
270:     echo "[2/5] Protecting server interface IPs..."
271:     while IFS= read -r ip; do
272:         [[ -z "$ip" ]] && continue
273:         if nftban_add_system_ip "$ip" "Server interface (auto-detected)"; then
274:             protected=$((protected + 1)) || true
275:         fi
276:         # Ensure not in blacklist
277:         if nftban_remove_from_blacklists "$ip"; then
278:             removed_from_blacklist=$((removed_from_blacklist + 1)) || true
279:         fi
280:     done < <(nftban_get_interface_ips)
281:     echo ""
282: 
283:     # 3. Public IPs
284:     echo "[3/5] Detecting public IPs..."
285: 
286:     # Public IPv4
287:     local public_ipv4
288:     public_ipv4=$(nftban_get_public_ip "ipv4")
289:     if [[ -n "$public_ipv4" ]]; then
290:         if nftban_add_system_ip "$public_ipv4" "Server public IPv4 (auto-detected)"; then
291:             protected=$((protected + 1)) || true
292:         fi
293:         # Ensure not in blacklist
294:         if nftban_remove_from_blacklists "$public_ipv4"; then
295:             removed_from_blacklist=$((removed_from_blacklist + 1)) || true
296:         fi
297:     else
298:         echo "[SKIP] No public IPv4 detected"
299:     fi
300: 
301:     # Public IPv6
302:     local public_ipv6
303:     public_ipv6=$(nftban_get_public_ip "ipv6")
304:     if [[ -n "$public_ipv6" ]]; then
305:         if nftban_add_system_ip "$public_ipv6" "Server public IPv6 (auto-detected)"; then
306:             protected=$((protected + 1)) || true
307:         fi
308:         # Ensure not in blacklist
309:         if nftban_remove_from_blacklists "$public_ipv6"; then
310:             removed_from_blacklist=$((removed_from_blacklist + 1)) || true
311:         fi
312:     else
313:         echo "[SKIP] No public IPv6 detected"
314:     fi
315:     echo ""
316: 
317:     # 4. Cleanup blacklists
318:     echo "[4/5] Ensuring system IPs not in blacklists..."
319:     if [[ $removed_from_blacklist -gt 0 ]]; then
320:         echo "  ✓ Removed $removed_from_blacklist IP(s) from blacklists"
321:     else
322:         echo "  ✓ No conflicts found"
323:     fi
324:     echo ""
325: 
326:     # 5. Summary
327:     echo "[5/5] Summary"
328:     echo "  • Protected: $protected system IP(s)"
329:     echo "  • Removed from blacklists: $removed_from_blacklist IP(s)"
330:     echo ""
331: 
332:     # Show whitelist contents
333:     if [[ -f "$NFTBAN_WHITELIST_SYSTEM" ]]; then
334:         echo "System whitelist: $NFTBAN_WHITELIST_SYSTEM"
335:         echo "Contents:"
336:         grep -vE "^[[:space:]]*#|^[[:space:]]*$" "$NFTBAN_WHITELIST_SYSTEM" | \
337:             awk '{print "  • " $1 " " $2 " " $3 " " $4}' || echo "  (empty)"
338:     fi
339: 
340:     echo ""
341:     echo "═══════════════════════════════════════════════════════"
342: 
343:     # Reload nftables if atomic reload available
344:     if declare -f nftban_atomic_reload >/dev/null 2>&1; then
345:         echo ""
346:         echo "Syncing to nftables..."
347:         nftban_atomic_reload
348:     fi
349: }
350: 
351: # =============================================================================
352: # WHITELIST CURRENT USER (whitelistme)
353: # =============================================================================
354: 
355: nftban_whitelistme() {
356:     echo "═══════════════════════════════════════════════════════"
357:     echo "NFTBan: Whitelist Current User"
358:     echo "═══════════════════════════════════════════════════════"
359:     echo ""
360: 
361:     # Detect current user IP
362:     local current_ip
363:     current_ip=$(nftban_get_current_user_ip)
364: 
365:     if [[ -z "$current_ip" ]]; then
366:         echo "❌ ERROR: Could not detect your IP address"
367:         echo ""
368:         echo "Possible reasons:"
369:         echo "  • You are on the local console (not SSH)"
370:         echo "  • Connection info not available"
371:         echo ""
372:         echo "To manually whitelist your IP:"
373:         echo "  nftban whitelist add <YOUR_IP>"
374:         echo ""
375:         return 1
376:     fi
377: 
378:     echo "Detected your IP: $current_ip"
379:     echo ""
380: 
381:     # Check if already whitelisted
382:     if nftban_is_ip_whitelisted "$current_ip"; then
383:         echo "✓ Your IP is already whitelisted!"
384:         echo ""
385:         return 0
386:     fi
387: 
388:     # Ask for confirmation
389:     echo "⚠️  This will add your IP to the system whitelist"
390:     echo "   (You will NEVER be banned from this server)"
391:     echo ""
392:     read -p "Type 'YES' to confirm: " confirm
393: 
394:     if [[ "$confirm" != "YES" ]]; then
395:         echo "Cancelled."
396:         return 1
397:     fi
398: 
399:     # Add to whitelist
400:     if nftban_add_system_ip "$current_ip" "Current user (whitelistme on $(date +'%Y-%m-%d'))"; then
401:         echo ""
402:         echo "✓ SUCCESS! Your IP has been whitelisted"
403:         echo ""
404:         echo "IP: $current_ip"
405:         echo "Status: Protected from all bans"
406:         echo ""
407: 
408:         # Reload nftables if available
409:         if declare -f nftban_atomic_reload >/dev/null 2>&1; then
410:             echo "Syncing to nftables..."
411:             nftban_atomic_reload
412:             echo ""
413:         fi
414: 
415:         echo "═══════════════════════════════════════════════════════"
416:         return 0
417:     else
418:         echo ""
419:         echo "❌ ERROR: Failed to whitelist your IP"
420:         return 1
421:     fi
422: }
423: 
424: # =============================================================================
425: # SHOW SYSTEM WHITELIST
426: # =============================================================================
427: 
428: nftban_show_system_whitelist() {
429:     # Check for --json flag
430:     local json_output=false
431:     if [[ "${1:-}" == "--json" ]]; then
432:         json_output=true
433:     fi
434: 
435:     if [[ ! -f "$NFTBAN_WHITELIST_SYSTEM" ]]; then
436:         if [[ "$json_output" == true ]]; then
437:             json_output_error "System whitelist not found: $NFTBAN_WHITELIST_SYSTEM"
438:         else
439:             echo "❌ System whitelist not found: $NFTBAN_WHITELIST_SYSTEM"
440:             echo ""
441:             echo "Run: nftban whitelist-system sync"
442:         fi
443:         return 1
444:     fi
445: 
446:     # Extract IPs
447:     local ipv4_list ipv6_list
448:     ipv4_list=$(grep -E "^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+" "$NFTBAN_WHITELIST_SYSTEM" 2>/dev/null | awk '{print $1}' || true)
449:     ipv6_list=$(grep -E "^[0-9a-fA-F]*:[0-9a-fA-F:]*" "$NFTBAN_WHITELIST_SYSTEM" 2>/dev/null | awk '{print $1}' || true)
450: 
451:     if [[ "$json_output" == true ]]; then
452:         # JSON output
453:         local ipv4_json ipv6_json
454:         if [[ -n "$ipv4_list" ]]; then
455:             ipv4_json=$(echo "$ipv4_list" | jq -R -s -c 'split("\n") | map(select(length > 0))')
456:         else
457:             ipv4_json="[]"
458:         fi
459: 
460:         if [[ -n "$ipv6_list" ]]; then
461:             ipv6_json=$(echo "$ipv6_list" | jq -R -s -c 'split("\n") | map(select(length > 0))')
462:         else
463:             ipv6_json="[]"
464:         fi
465: 
466:         cat <<EOF
467: {
468:   "success": true,
469:   "data": {
470:     "file": "$NFTBAN_WHITELIST_SYSTEM",
471:     "ipv4": $ipv4_json,
472:     "ipv6": $ipv6_json,
473:     "total": $(echo "$ipv4_list $ipv6_list" | wc -w)
474:   }
475: }
476: EOF
477:     else
478:         # Human-readable output
479:         echo "═══════════════════════════════════════════════════════"
480:         echo "NFTBan System Whitelist"
481:         echo "═══════════════════════════════════════════════════════"
482:         echo ""
483:         echo "File: $NFTBAN_WHITELIST_SYSTEM"
484:         echo ""
485: 
486:         # Count IPs
487:         local ipv4_count ipv6_count
488:         ipv4_count=$(echo "$ipv4_list" | wc -w)
489:         ipv6_count=$(echo "$ipv6_list" | wc -w)
490: 
491:         echo "IPv4: $ipv4_count entries"
492:         echo "IPv6: $ipv6_count entries"
493:         echo ""
494: 
495:         echo "Protected IPs:"
496:         echo ""
497: 
498:         # Show all IPs with comments
499:         grep -vE "^[[:space:]]*#|^[[:space:]]*$" "$NFTBAN_WHITELIST_SYSTEM" | \
500:             awk '{
501:                 ip = $1
502:                 comment = ""
503:                 for(i=3; i<=NF; i++) comment = comment $i " "
504:                 printf "  %-40s %s\n", ip, comment
505:             }' || echo "  (empty)"
506: 
507:         echo ""
508:         echo "═══════════════════════════════════════════════════════"
509:     fi
510: }
511: 
512: # =============================================================================
513: # EXPORT FUNCTIONS
514: # =============================================================================
515: export -f nftban_get_public_ip
516: export -f nftban_get_current_user_ip
517: export -f nftban_get_interface_ips
518: export -f nftban_is_ip_whitelisted
519: export -f nftban_add_system_ip
520: export -f nftban_whitelist_system_sync
521: export -f nftban_whitelistme
522: export -f nftban_show_system_whitelist
</file>

<file path="cli/lib/nftban/cron/run.sh">
 1: #!/usr/bin/env bash
 2: # =============================================================================
 3: # NFTBan v1.0.0 - Periodic Maintenance Runner
 4: # =============================================================================
 5: # SPDX-License-Identifier: MPL-2.0
 6: # Purpose: Run periodic maintenance tasks (feeds, GeoIP, cleanup)
 7: #
 8: # meta:name=cron_run
 9: # meta:type=cron
10: # meta:header=Periodic Maintenance Runner
11: # meta:version=1.0.0
12: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
13: # meta:homepage=https://nftban.com
14: #
15: # **Description & Purpose**
16: # meta:description=Automated periodic maintenance tasks including feed updates and GeoIP database refresh
17: # meta:input=System time and configuration settings
18: # meta:output=Updated threat feeds and GeoIP databases
19: #
20: # **Inventory & Requirements**
21: # meta:depends=bash,date,systemctl
22: #
23: # meta:created_date=2025-11-05
24: # =============================================================================
25: 
26: set -Eeuo pipefail
27: 
28: # Source central config for canonical paths (NO HARDCODED FALLBACKS)
29: # shellcheck source=/etc/nftban/nftban.conf
30: [[ -f "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf" ]] && source "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf"
31: 
32: # Configuration
33: readonly GEOIP_UPDATE_DAY="0"  # Sunday (0=Sunday, 1=Monday, etc.)
34: readonly GEOIP_UPDATE_HOUR="2" # 2 AM
35: readonly GEOIP_LOCKFILE="${NFTBAN_DATA_DIR}/.geoip_updated_this_week"
36: 
37: # =============================================================================
38: # Weekly GeoIP Update (Sundays at 2 AM)
39: # =============================================================================
40: 
41: _should_update_geoip() {
42:     # SC2155: Declare and assign separately
43:     local current_day
44:     current_day=$(date +%u)  # 1=Monday, 7=Sunday
45:     local current_hour
46:     current_hour=$(date +%H)
47: 
48:     # Convert Sunday from 7 to 0 for easier comparison
49:     [[ "$current_day" == "7" ]] && current_day="0"
50: 
51:     # Check if it's the right day and hour
52:     if [[ "$current_day" == "$GEOIP_UPDATE_DAY" ]] && [[ "$current_hour" == "$GEOIP_UPDATE_HOUR" ]]; then
53:         # Check if already updated this week
54:         if [[ -f "$GEOIP_LOCKFILE" ]]; then
55:             local lockfile_age=$(( ($(date +%s) - $(stat -c %Y "$GEOIP_LOCKFILE")) / 86400 ))
56:             if [[ $lockfile_age -lt 6 ]]; then
57:                 return 1  # Already updated this week
58:             fi
59:         fi
60:         return 0  # Time to update
61:     fi
62:     return 1  # Not the right time
63: }
64: 
65: _update_geoip() {
66:     # Check if GeoIP is enabled
67:     if [[ -f "${NFTBAN_CONFIG_DIR}/conf.d/geoip.conf" ]]; then
68:         source "${NFTBAN_CONFIG_DIR}/conf.d/geoip.conf"
69:         if [[ "${GEOIP_AUTO_UPDATE:-false}" == "true" ]] && [[ -n "${MAXMIND_LICENSE_KEY:-}" ]]; then
70:             echo "[$(date '+%Y-%m-%d %H:%M:%S')] [INFO] Weekly GeoIP update started"
71:             if "${NFTBAN_LIB_DIR}/core/nftban_geoip_download.sh" download >/dev/null 2>&1; then
72:                 echo "[$(date '+%Y-%m-%d %H:%M:%S')] [INFO] GeoIP update completed"
73:                 touch "$GEOIP_LOCKFILE"
74:             else
75:                 echo "[$(date '+%Y-%m-%d %H:%M:%S')] [ERROR] GeoIP update failed"
76:             fi
77:         fi
78:     fi
79: }
80: 
81: # =============================================================================
82: # Main Execution
83: # =============================================================================
84: 
85: # Run GeoIP update if it's time
86: if _should_update_geoip; then
87:     _update_geoip

#!/usr/bin/env bash
# =============================================================================
# NFTBan - nftban-apply (v1.235: wrapper over the repaired commit-confirm engine)
# =============================================================================
# SPDX-License-Identifier: MPL-2.0
# SPDX-FileCopyrightText: Copyright (c) 2024-2026 Antonios Voulvoulis <contact@nftban.com>
# meta:name="nftban-apply"
# meta:type="cli"
# meta:version="1.235.0"
# meta:owner="Antonios Voulvoulis <contact@nftban.com>"
# meta:description="Applies the current NFTBan configuration as a PENDING change: nftban firewall rebuild --confirm[=SECONDS]. The pre-v1.235 implementation (whole-ruleset backup restored by merging, rollback armed after the change, fixed 5-minute --force timer, no apply identity) is retired; see NFTBAN_ROADMAP/CLI_AUDIT_V1235/ROW486_BEHAVIOUR_CONTRACT_V1235.md section 4."
# =============================================================================
set -Eeuo pipefail
NFTBAN="${NFTBAN_BIN:-/usr/sbin/nftban}"
grace=""
for a in "$@"; do
    case "$a" in
        --grace=*) grace="${a#--grace=}" ;;
        [0-9]*)    grace="$a" ;;
        -h|--help) echo "Usage: nftban-apply [--grace=SECONDS]   (= nftban firewall rebuild --confirm[=SECONDS])"; exit 0 ;;
        *) echo "nftban-apply: unknown argument: $a" >&2; exit 2 ;;
    esac
done
exec "$NFTBAN" firewall rebuild --confirm${grace:+=$grace}

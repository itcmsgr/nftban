 565: // addSetElementsBatch adds a single batch of IPs or CIDRs
 566: func (m *NFTManager) addSetElementsBatch(set *nftables.Set, ips []string) error {
 567: 	var elements []nftables.SetElement
 568: 	for _, ipStr := range ips {
 569: 		var key []byte
 570: 
 571: 		// Check if this is a CIDR range or single IP
 572: 		if strings.Contains(ipStr, "/") {
 573: 			// CIDR notation - parse as network
 574: 			_, ipNet, err := net.ParseCIDR(ipStr)
 575: 			if err != nil {
 576: 				return fmt.Errorf("invalid CIDR: %s (%w)", ipStr, err)
 577: 			}
 578: 
 579: 			// For interval sets, use the network address
 580: 			if set.KeyType == nftables.TypeIPAddr {
 581: 				// IPv4 CIDR
 582: 				if ipNet.IP.To4() == nil {
 583: 					return fmt.Errorf("CIDR %s is not IPv4", ipStr)
 584: 				}
 585: 				key = ipNet.IP.To4()
 586: 			} else {
 587: 				// IPv6 CIDR
 588: 				if ipNet.IP.To4() != nil {
 589: 					return fmt.Errorf("CIDR %s is not IPv6", ipStr)
 590: 				}
 591: 				key = ipNet.IP.To16()
 592: 			}
 593: 
 594: 			// Add CIDR with mask
 595: 			elements = append(elements, nftables.SetElement{
 596: 				Key:         key,
 597: 				IntervalEnd: false,
 598: 			})
 599: 
 600: 			// Calculate and add the interval end (broadcast address)
 601: 			broadcastIP := make(net.IP, len(ipNet.IP))
 602: 			copy(broadcastIP, ipNet.IP)
 603: 			for i := range broadcastIP {
 604: 				broadcastIP[i] |= ^ipNet.Mask[i]
 605: 			}
 606: 
 607: 			var endKey []byte
 608: 			if set.KeyType == nftables.TypeIPAddr {
 609: 				endKey = broadcastIP.To4()
 610: 			} else {
 611: 				endKey = broadcastIP.To16()
 612: 			}
 613: 
 614: 			// Increment by 1 for interval end
 615: 			for i := len(endKey) - 1; i >= 0; i-- {
 616: 				endKey[i]++
 617: 				if endKey[i] != 0 {
 618: 					break
 619: 				}
 620: 			}
 621: 
 622: 			elements = append(elements, nftables.SetElement{
 623: 				Key:         endKey,
 624: 				IntervalEnd: true,
 625: 			})
 626: 		} else {
 627: 			// Single IP
 628: 			ip := net.ParseIP(ipStr)
 629: 			if ip == nil {
 630: 				return fmt.Errorf("invalid IP: %s", ipStr)
 631: 			}
 632: 
 633: 			// Convert to appropriate format
 634: 			if set.KeyType == nftables.TypeIPAddr {
 635: 				// IPv4 - use To4()
 636: 				ip = ip.To4()
 637: 				if ip == nil {
 638: 					return fmt.Errorf("IP %s is not IPv4", ipStr)
 639: 				}
 640: 			} else {
 641: 				// IPv6 - use To16()
 642: 				ip = ip.To16()
 643: 				if ip == nil {
 644: 					return fmt.Errorf("IP %s is not IPv6", ipStr)
 645: 				}
 646: 			}
 647: 
 648: 			elements = append(elements, nftables.SetElement{
 649: 				Key: ip,
 650: 			})
 651: 		}
 652: 	}
 653: 
 654: 	if err := m.conn.SetAddElements(set, elements); err != nil {
 655: 		return fmt.Errorf("failed to add elements: %w", err)
 656: 	}
 657: 
 658: 	if err := m.conn.Flush(); err != nil {
 659: 		return fmt.Errorf("failed to flush add elements: %w", err)
 660: 	}
 661: 
 662: 	return nil
 663: }

 611: # Download FREE GeoIP database (MaxMind GeoLite2-City)
 612: download_geoip_database() {
 613:     log "Downloading FREE GeoIP database (MaxMind GeoLite2)..."
 614: 
 615:     local geoip_dir="/var/lib/nftban/geoip"
 616:     local db_file="${geoip_dir}/GeoLite2-City.mmdb"
 617: 
 618:     mkdir -p "$geoip_dir"
 619:     chown nftban:nftban "$geoip_dir" 2>/dev/null || true
 620:     chmod 750 "$geoip_dir"
 621: 
 622:     # Check if recent database exists (less than 30 days old)
 623:     if [[ -f "$db_file" ]]; then
 624:         local file_age
 625:         local now_ts
 626:         local file_ts
 627:         now_ts=$(date +%s)
 628:         file_ts=$(stat -c %Y "$db_file" 2>/dev/null || echo 0)
 629:         file_age=$(( (now_ts - file_ts) / 86400 ))
 630:         if [[ $file_age -lt 30 ]]; then
 631:             ok "GeoIP database exists (${file_age} days old)"
 632:             return 0
 633:         fi
 634:     fi
 635: 
 636:     # Use nftban-core to download (same as RPM/DEB packages)
 637:     if [[ -x "/usr/lib/nftban/bin/nftban-core" ]]; then
 638:         log "Using nftban-core to download GeoIP database..."
 639:         if /usr/lib/nftban/bin/nftban-core geoip update 2>/dev/null; then
 640:             ok "GeoIP database downloaded successfully"
 641:         else
 642:             warn "Could not download GeoIP database (will retry via timer)"
 643:             info "Manual download: nftban geoip update"
 644:         fi
 645:     else
 646:         warn "nftban-core not found, skipping GeoIP download"
 647:         info "Will download on first use via: nftban geoip update"
 648:     fi
 649: }

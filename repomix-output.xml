2813:         return 1
2814:     fi
2815: 
2816:     # nftban-auditors is optional, warn if missing but don't fail
2817:     if [[ "$nftban_auditors_gid" == "MISSING" ]]; then
2818:         echo "  ⚠ WARNING: nftban-auditors group not found (optional, for inventory helpers)" >&2
2819:     fi
2820: 
2821:     # Check if update needed
2822:     local needs_update=0

10: // respondJSON sends a JSON response
11: func respondJSON(w http.ResponseWriter, status int, data interface{}) {
12: 	w.Header().Set("Content-Type", "application/json")
13: 	w.WriteHeader(status)
14: 	if err := json.NewEncoder(w).Encode(data); err != nil {
15: 		// Best effort; can't do much if encoding fails
16: 		return
17: 	}
18: }
19: 
20: // respondError sends an error response
21: func respondError(w http.ResponseWriter, status int, message string) {
22: 	w.Header().Set("Content-Type", "application/json")
23: 	w.WriteHeader(status)
24: 	json.NewEncoder(w).Encode(map[string]interface{}{
25: 		"success": false,
26: 		"error":   message,
27: 	})
28: }

 5: // MaxUsernameLength is the default maximum username length
 6: const MaxUsernameLength = 32
 7: 
 8: // ValidUsername checks if a username is valid
 9: // - Not empty
10: // - Not too long (maxLen, default 32)
11: // - No path separators, whitespace, or null bytes
12: func ValidUsername(u string, maxLen int) bool {
13: 	if maxLen <= 0 {
14: 		maxLen = MaxUsernameLength
15: 	}
16: 	if u == "" || len(u) > maxLen {
17: 		return false
18: 	}
19: 	// Reject path separators, whitespace, and null bytes
20: 	if strings.ContainsAny(u, "/ \t\n\r\x00") {
21: 		return false
22: 	}
23: 	return true
24: }
25: 
26: // ValidUsernameDefault checks username with default max length
27: func ValidUsernameDefault(u string) bool {
28: 	return ValidUsername(u, MaxUsernameLength)

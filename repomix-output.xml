 66: _nftban_nftables_help() {
 67:     # Load output module for standard banner
 68:     source "${NFTBAN_LIB_DIR}/core/nftban_output.sh"
 69: 
 70:     # Show standard banner
 71:     nftban_banner
 72: 
 73:     cat <<'HELP'
 74: 
 75: USAGE:
 76:     nftban nftables <command>
 77: 
 78: COMMANDS:
 79:     start               Start nftables service
 80:     stop                Stop nftables service
 81:     restart             Restart nftables service
 82:     reload              Reload nftables ruleset
 83: 
 84:     enable              Enable nftables service at boot
 85:     disable             Disable nftables service at boot
 86: 
 87:     status              Show nftables service status
 88:     check               Check nftables configuration
 89:     list                List current nftables ruleset
 90: 
 91:     help                Show this help message
 92: 
 93: DESCRIPTION:
 94:     Manage the nftables firewall service. NFTBan uses nftables as its
 95:     underlying firewall system. These commands allow you to control the
 96:     nftables systemd service and view the current ruleset.
 97: 
 98: EXAMPLES:
 99:     # Check nftables status
100:     nftban nftables status
101: 
102:     # Restart nftables service
103:     sudo nftban nftables restart
104: 
105:     # Enable nftables at boot
106:     sudo nftban nftables enable
107: 
108:     # View current ruleset
109:     nftban nftables list
110: 
111:     # Check configuration
112:     sudo nftban nftables check
113: 
114: NOTES:
115:     - Most commands require root privileges
116:     - NFTBan manages nftables rules automatically
117:     - Manual changes to nftables rules may be overwritten by NFTBan
118: 
119: SERVICE INFORMATION:
120:     Service:  nftables.service
121:     Binary:   /usr/sbin/nft
122:     Config:   /etc/nftables/nftban.nft
123: 
124: HELP
125: }
126: 
127: # =============================================================================
128: 
129: # COMMAND FUNCTIONS
130: # =============================================================================
131: 
132: 
133: _nftban_nftables_cmd_start() {
134:     echo "Starting nftables service..."
135:     systemctl start "${NFTABLES_SERVICE}"
136:     local result=$?
137: 
138:     if [[ $result -eq 0 ]]; then
139:         echo "✓ nftables service started successfully"
140:     else
141:         echo "ERROR: Failed to start nftables service" >&2
142:         return $result
143:     fi
144: }
145: 
146: _nftban_nftables_cmd_stop() {
147:     echo "Stopping nftables service..."
148:     systemctl stop "${NFTABLES_SERVICE}"
149:     local result=$?
150: 
151:     if [[ $result -eq 0 ]]; then
152:         echo "✓ nftables service stopped successfully"
153:     else
154:         echo "ERROR: Failed to stop nftables service" >&2
155:         return $result
156:     fi
157: }
158: 
159: _nftban_nftables_cmd_restart() {
160:     echo "Restarting nftables service..."
161:     systemctl restart "${NFTABLES_SERVICE}"
162:     local result=$?
163: 
164:     if [[ $result -eq 0 ]]; then
165:         echo "✓ nftables service restarted successfully"
166:     else
167:         echo "ERROR: Failed to restart nftables service" >&2
168:         return $result
169:     fi
170: }
171: 
172: _nftban_nftables_cmd_reload() {
173:     echo "Reloading nftables ruleset..."
174:     systemctl reload "${NFTABLES_SERVICE}" 2>/dev/null || nft -f /etc/nftables/nftban.nft
175:     local result=$?
176: 
177:     if [[ $result -eq 0 ]]; then
178:         echo "✓ nftables ruleset reloaded successfully"
179:     else
180:         echo "ERROR: Failed to reload nftables ruleset" >&2
181:         return $result
182:     fi
183: }
184: 
185: _nftban_nftables_cmd_enable() {
186:     echo "Enabling nftables service at boot..."
187:     systemctl enable "${NFTABLES_SERVICE}"
188:     local result=$?
189: 
190:     if [[ $result -eq 0 ]]; then
191:         echo "✓ nftables service enabled at boot"
192:     else
193:         echo "ERROR: Failed to enable nftables service" >&2
194:         return $result
195:     fi
196: }
197: 
198: _nftban_nftables_cmd_disable() {
199:     echo "Disabling nftables service at boot..."
200:     systemctl disable "${NFTABLES_SERVICE}"
201:     local result=$?
202: 
203:     if [[ $result -eq 0 ]]; then
204:         echo "✓ nftables service disabled at boot"

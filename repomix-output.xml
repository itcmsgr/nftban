340: // generateRuleset creates the nftables configuration file with populated sets
341: func generateRuleset(path string, config *model.FirewallConfig, templatePath string) error {
342: 	// Read template
343: 	tmplContent, err := os.ReadFile(templatePath)
344: 	if err != nil {
345: 		return fmt.Errorf("failed to read template: %w", err)
346: 	}
347: 
348: 	// Parse template
349: 	tmpl, err := template.New("nftables").Parse(string(tmplContent))
350: 	if err != nil {
351: 		return fmt.Errorf("failed to parse template: %w", err)
352: 	}
353: 
354: 	// Prepare template data with aggregated feed IPs
355: 	type TemplateData struct {
356: 		*model.FirewallConfig
357: 		FeedIPv4      []string
358: 		FeedIPv6      []string
359: 		FeedIPv4Count int
360: 		FeedIPv6Count int
361: 	}
362: 
363: 	data := &TemplateData{FirewallConfig: config}
364: 
365: 	// Aggregate all feed IPs into flat arrays
366: 	for _, feedData := range config.Feeds {
367: 		data.FeedIPv4 = append(data.FeedIPv4, feedData.IPv4...)
368: 		data.FeedIPv6 = append(data.FeedIPv6, feedData.IPv6...)
369: 	}
370: 	data.FeedIPv4Count = len(data.FeedIPv4)
371: 	data.FeedIPv6Count = len(data.FeedIPv6)
372: 
373: 	// Render template with enhanced data
374: 	var buf bytes.Buffer
375: 	if err := tmpl.Execute(&buf, data); err != nil {
376: 		return fmt.Errorf("failed to execute template: %w", err)
377: 	}
378: 
379: 	// Write to file
380: 	return os.WriteFile(path, buf.Bytes(), 0640)
381: }

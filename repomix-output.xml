444: // cleanupSnapshots keeps only the N most recent snapshots
445: func cleanupSnapshots(dir string, keep int) {
446: 	entries, err := os.ReadDir(dir)
447: 	if err != nil {
448: 		return
449: 	}
450: 
451: 	if len(entries) <= keep {
452: 		return
453: 	}
454: 
455: 	// Remove oldest files
456: 	for i := 0; i < len(entries)-keep; i++ {
457: 		path := filepath.Join(dir, entries[i].Name())
458: 		os.Remove(path)
459: 	}
460: }

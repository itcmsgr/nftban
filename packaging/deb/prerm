#!/bin/sh
set -e

# Remove immutable flag before upgrade/remove (security protection on nft_schema.sh)
if [ -f /usr/lib/nftban/lib/nft_schema.sh ]; then
    chattr -i /usr/lib/nftban/lib/nft_schema.sh 2>/dev/null || true
fi

case "$1" in
    remove|deconfigure)
        # Stop NFTBand daemon (single nftables writer) - stop socket first
        deb-systemd-invoke stop nftband.socket >/dev/null 2>&1 || true
        deb-systemd-invoke stop nftband.service >/dev/null 2>&1 || true

        # Stop unified exporter (metrics collection)
        deb-systemd-invoke stop nftban-unified-exporter.timer >/dev/null 2>&1 || true
        deb-systemd-invoke stop nftban-unified-exporter.service >/dev/null 2>&1 || true

        # Stop core timers
        deb-systemd-invoke stop nftban-maintenance.timer >/dev/null 2>&1 || true
        deb-systemd-invoke stop nftban-health.timer >/dev/null 2>&1 || true

        # Stop Web UI services
        deb-systemd-invoke stop nftban-ui.service >/dev/null || true
        deb-systemd-invoke stop nftban-ui-auth.socket >/dev/null || true
        deb-systemd-invoke stop nftban-ui-auth.service >/dev/null || true
        ;;
esac

#DEBHELPER#

exit 0

# =============================================================================
# NFTBan - Tunnel Suspicion Scan Service
# =============================================================================
# SPDX-License-Identifier: MPL-2.0
# meta:name="nftban-tunnel.service"
# meta:type="systemd"
# meta:owner="Antonios Voulvoulis <contact@nftban.com>"
# meta:description="DNS tunnel suspicion scanner (advisory-only, never bans)"
# meta:input="None"
# meta:output="Systemd unit"
# meta:depends=""
# meta:inventory.files=""
# meta:inventory.binaries="/usr/sbin/nftban"
# meta:inventory.env_vars=""
# meta:inventory.config_files="/etc/nftban/conf.d/tunnel/main.conf"
# meta:inventory.systemd_units="nftban-tunnel.timer"
# meta:inventory.network=""
# meta:inventory.privileges="root"
# =============================================================================

[Unit]
# v1.235 R-DEC: kernel parameter nftban=disabled = per-boot emergency bypass of NFTBan.
# systemd enforces this on every start path (socket, Requires=, timer, installer, self-heal).
ConditionKernelCommandLine=!nftban=disabled
# v1.235 D10: while a commit-confirm rollback has FAILED, nothing may apply another state.
ConditionPathExists=!/var/lib/nftban/state/commit-confirm.rollback-failed
Description=NFTBan Tunnel Suspicion Scanner
Documentation=https://nftban.com/docs/tunnel
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root

# Run tunnel scan
ExecStart=/usr/sbin/nftban tunnel scan --quiet

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nftban-tunnel

# =============================================================================
# SECURITY HARDENING
# =============================================================================
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true

# Filesystem access: read DNS logs, write state/logs
ReadWritePaths=/var/lib/nftban /var/log/nftban

# Allow AF_INET/AF_INET6 for sendmail alerting on non-Postfix MTAs
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Resource limits
CPUQuota=50%
MemoryMax=256M
TasksMax=10
TimeoutStartSec=5min

[Install]
WantedBy=multi-user.target

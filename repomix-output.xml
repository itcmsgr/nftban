 543: nftban_stats_cmd_top() {
 544:     # Show top lists (IPs, countries, jails)
 545:     # Usage: nftban stats top [ips|countries|jails] [LIMIT] [--json]
 546: 
 547:     local type="${1:-ips}"
 548:     local limit="${2:-${STATS_TOP_N:-10}}"
 549:     local since
 550:     since="$(date -d '30 days ago' +%Y-%m-%d)"
 551:     local until
 552:     until="$(date +%Y-%m-%d)"
 553:     local json_mode=false
 554: 
 555:     # Parse additional options
 556:     shift 2 2>/dev/null || shift $# 2>/dev/null || true
 557:     while [[ $# -gt 0 ]]; do
 558:         case "$1" in
 559:             --json)
 560:                 json_mode=true
 561:                 shift
 562:                 ;;
 563:             --since)
 564:                 since="$2"
 565:                 shift 2
 566:                 ;;
 567:             --until)
 568:                 until="$2"
 569:                 shift 2
 570:                 ;;
 571:             --last)
 572:                 local period="$2"
 573:                 case "$period" in
 574:                     *h)
 575:                         since="$(date -d "${period%h} hours ago" +%Y-%m-%d)"
 576:                         ;;
 577:                     *d)
 578:                         since="$(date -d "${period%d} days ago" +%Y-%m-%d)"
 579:                         ;;
 580:                 esac
 581:                 shift 2
 582:                 ;;
 583:             *)
 584:                 shift
 585:                 ;;
 586:         esac
 587:     done
 588: 
 589:     # JSON output mode
 590:     if [[ "$json_mode" == "true" ]] && declare -f json_output >/dev/null 2>&1; then
 591:         local result_data="[]"
 592: 
 593:         case "$type" in
 594:             ips|ip)
 595:                 if declare -f nftban_stats_top_ips >/dev/null 2>&1; then
 596:                     result_data=$(nftban_stats_top_ips "$limit" "$since" "$until" 2>/dev/null || echo "[]")
 597:                 fi
 598:                 ;;
 599:             countries|country)
 600:                 if declare -f nftban_stats_top_countries >/dev/null 2>&1; then
 601:                     result_data=$(nftban_stats_top_countries "$limit" "$since" "$until" 2>/dev/null || echo "[]")
 602:                 fi
 603:                 ;;
 604:             jails|jail)
 605:                 if declare -f nftban_stats_top_jails >/dev/null 2>&1; then
 606:                     result_data=$(nftban_stats_top_jails "$limit" "$since" "$until" 2>/dev/null || echo "[]")
 607:                 fi
 608:                 ;;
 609:             *)
 610:                 json_output "false" '{}' "Unknown top type: $type. Valid types: ips, countries, jails"
 611:                 return 1
 612:                 ;;
 613:         esac
 614: 
 615:         local data
 616:         if command -v jq &>/dev/null; then
 617:             data=$(jq -n \
 618:                 --arg type "$type" \
 619:                 --arg limit "$limit" \
 620:                 --arg since "$since" \
 621:                 --arg until "$until" \
 622:                 --argjson items "$result_data" \
 623:                 '{
 624:                     type: $type,
 625:                     limit: ($limit | tonumber),
 626:                     period: {since: $since, until: $until},
 627:                     items: $items,
 628:                     count: ($items | length)
 629:                 }')
 630:         else
 631:             # Fallback without jq
 632:             local count
 633:             count=$(echo "$result_data" | { grep -o "}" || true; } | wc -l)
 634:             data="{\"type\":\"$type\",\"limit\":$limit,\"period\":{\"since\":\"$since\",\"until\":\"$until\"},\"items\":$result_data,\"count\":$count}"
 635:         fi
 636: 
 637:         json_output "true" "$data"
 638:         return 0
 639:     fi
 640: 
 641:     # Human-readable output mode
 642:     echo ""
 643:     if type -t nftban_render_separator >/dev/null 2>&1; then
 644:         nftban_render_separator "─"
 645:     else
 646:         echo "───────────────────────────────────────────────────────────────"
 647:     fi
 648: 
 649:     case "$type" in
 650:         ips|ip)
 651:             echo "Top ${limit} Banned IPs (${since} to ${until})"
 652:             if type -t nftban_render_separator >/dev/null 2>&1; then
 653:                 nftban_render_separator "─"
 654:             else
 655:                 echo "───────────────────────────────────────────────────────────────"
 656:             fi
 657:             echo ""
 658:             if command -v jq &>/dev/null; then
 659:                 nftban_stats_top_ips "$limit" "$since" "$until" | \
 660:                     jq -r '.[] | "\(.ip) (\(.country)): \(.count) bans"'
 661:             else
 662:                 echo "ERROR: jq is required for formatted output" >&2
 663:                 return 1
 664:             fi
 665:             ;;
 666:         countries|country)
 667:             echo "Top ${limit} Countries (${since} to ${until})"
 668:             if type -t nftban_render_separator >/dev/null 2>&1; then
 669:                 nftban_render_separator "─"
 670:             else
 671:                 echo "───────────────────────────────────────────────────────────────"
 672:             fi
 673:             echo ""
 674:             if command -v jq &>/dev/null; then
 675:                 nftban_stats_top_countries "$limit" "$since" "$until" | \
 676:                     jq -r '.[] | "\(.country): \(.count) bans"'
 677:             else
 678:                 echo "ERROR: jq is required for formatted output" >&2
 679:                 return 1
 680:             fi
 681:             ;;
 682:         jails|jail)
 683:             echo "Top ${limit} Jails (${since} to ${until})"
 684:             if type -t nftban_render_separator >/dev/null 2>&1; then
 685:                 nftban_render_separator "─"

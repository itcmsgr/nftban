# nftban-managed: yes
# nftban-templates-version: 1

[nftban-xmlrpc]
enabled   = @@NFTBAN_F2B_XMLRPC_JAIL@@
filter    = nftban-xmlrpc
backend   = auto
port      = http,https
logpath   = @@NFTBAN_F2B_XMLRPC_LOG@@
maxretry  = @@NFTBAN_F2B_XMLRPC_MAX_RETRY@@
findtime  = @@NFTBAN_F2B_XMLRPC_FIND_TIME@@
bantime   = @@NFTBAN_F2B_XMLRPC_BAN_TIME@@

</file>

<file path="cli/lib/nftban/core/nftban_report_fhs.sh">
  1: #!/usr/bin/env bash
  2: 
  3: # =============================================================================
  4: # NFTBan v1.0.0 - FHS Report Core Module
  5: # =============================================================================
  6: # SPDX-License-Identifier: MPL-2.0
  7: # Purpose: FHS directory permissions and ownership audit
  8: #
  9: # meta:name=nftban_report_fhs
 10: # meta:type=core
 11: # meta:header=FHS Report Core
 12: # meta:version=1.0.0
 13: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 14: # meta:homepage=https://nftban.com
 15: #
 16: # **Description & Purpose**
 17: # meta:description=Audits NFTBan directory permissions and ownership against FHS standards
 18: # meta:input=Output format options
 19: # meta:output=FHS compliance reports (terminal, HTML, mail)
 20: #
 21: # **Inventory & Requirements**
 22: # meta:depends=bash,stat
 23: #
 24: # meta:created_date=2025-11-05
 25: # meta:updated_date=2025-11-24
 26: # =============================================================================
 27: 
 28: # Strict mode
 29: IFS=$'\n\t'
 30: umask 027
 31: 
 32: # =============================================================================
 33: # GLOBALS
 34: # =============================================================================
 35: 
 36: declare -g -A NFTBAN_FHS_DIRECTORIES=()  # key: path -> "expected_perms|expected_owner|expected_group|purpose"
 37: declare -g -A NFTBAN_FHS_STATUS=()       # key: path -> "OK|ERROR|WARNING"
 38: declare -g NFTBAN_FHS_TIMESTAMP
 39: NFTBAN_FHS_TIMESTAMP="$(date --iso-8601=seconds)"
 40: declare -g NFTBAN_FHS_OUTPUT_FORMAT="${NFTBAN_FHS_OUTPUT_FORMAT:-table}"
 41: 
 42: # Color symbols
 43: if type -t nftban_render_banner >/dev/null 2>&1; then
 44:     NFTBAN_FHS_SYM_OK="✔"
 45:     NFTBAN_FHS_SYM_KO="✖"
 46:     NFTBAN_FHS_SYM_WARN="⚠"
 47: else
 48:     NFTBAN_FHS_SYM_OK="✔"
 49:     NFTBAN_FHS_SYM_KO="✖"
 50:     NFTBAN_FHS_SYM_WARN="⚠"
 51:     C_RESET="\e[0m"
 52:     C_RED="\e[31m"
 53:     C_GREEN="\e[32m"
 54:     C_YELLOW="\e[33m"
 55:     C_BOLD="\e[1m"
 56: fi
 57: 
 58: # =============================================================================
 59: # FHS DIRECTORY DEFINITIONS
 60: # =============================================================================
 61: 
 62: nftban_fhs_define_directories() {
 63:     # Load canonical FHS specification from single source of truth
 64:     # IMPORTANT: Do NOT define directories here - use nftban_fhs_spec.sh
 65: 
 66:     if ! declare -f nftban_fhs_load_spec >/dev/null 2>&1; then
 67:         source /usr/lib/nftban/core/nftban_fhs_spec.sh || {
 68:             echo "ERROR: Failed to load canonical FHS specification" >&2
 69:             return 1
 70:         }
 71:     fi
 72: 
 73:     # Ensure spec is loaded
 74:     if [[ ${#NFTBAN_FHS_DIRECTORIES[@]} -eq 0 ]]; then
 75:         nftban_fhs_load_spec
 76:     fi
 77: }
 78: 
 79: # =============================================================================
 80: # HELPER FUNCTIONS
 81: # =============================================================================
 82: 
 83: nftban_fhs_trim() {
 84:     local s="${*-}"
 85:     s="${s#"${s%%[![:space:]]*}"}"
 86:     s="${s%"${s##*[![:space:]]}"}"
 87:     printf '%s' "$s"
 88: }
 89: 
 90: nftban_fhs_get_perms() {
 91:     # Get octal permissions for a path
 92:     # Args: $1 = path
 93:     # Output: octal permissions (e.g., "755") or empty if not exists
 94: 
 95:     local path="$1"
 96:     [[ ! -e "$path" ]] && return 1
 97: 
 98:     stat -c "%a" "$path" 2>/dev/null || stat -f "%Op" "$path" 2>/dev/null | tail -c 4
 99: }
100: 
101: nftban_fhs_get_owner() {
102:     # Get owner for a path
103:     # Args: $1 = path
104:     # Output: owner name or empty if not exists
105: 
106:     local path="$1"
107:     [[ ! -e "$path" ]] && return 1
108: 
109:     stat -c "%U" "$path" 2>/dev/null || stat -f "%Su" "$path" 2>/dev/null
110: }
111: 
112: nftban_fhs_get_group() {
113:     # Get group for a path
114:     # Args: $1 = path
115:     # Output: group name or empty if not exists
116: 
117:     local path="$1"
118:     [[ ! -e "$path" ]] && return 1
119: 
120:     stat -c "%G" "$path" 2>/dev/null || stat -f "%Sg" "$path" 2>/dev/null
121: }
122: 
123: # =============================================================================
124: # FHS CHECKING FUNCTIONS
125: # =============================================================================
126: 
127: nftban_fhs_check_directory() {
128:     # Check a single directory against expected values
129:     # Args: $1 = path
130:     # Populates: NFTBAN_FHS_STATUS
131: 
132:     local path="$1"
133:     local expected="${NFTBAN_FHS_DIRECTORIES[$path]}"
134: 
135:     IFS='|' read -r exp_perms exp_owner exp_group purpose <<< "$expected"
136: 
137:     # Check if directory exists
138:     if [[ ! -e "$path" ]]; then
139:         NFTBAN_FHS_STATUS["$path"]="MISSING"
140:         return 1
141:     fi
142: 
143:     # Check if it's a directory
144:     if [[ ! -d "$path" ]]; then
145:         NFTBAN_FHS_STATUS["$path"]="NOT_DIR"
146:         return 1
147:     fi
148: 
149:     # Get actual values
150:     local act_perms act_owner act_group
151:     act_perms="$(nftban_fhs_get_perms "$path")"
152:     act_owner="$(nftban_fhs_get_owner "$path")"
153:     act_group="$(nftban_fhs_get_group "$path")"
154: 
155:     # Compare
156:     local issues=()
157:     # Skip permission check if expected is "*" (OS-managed directory)
158:     [[ "$exp_perms" != "*" && "$act_perms" != "$exp_perms" ]] && issues+=("perms")
159:     [[ "$act_owner" != "$exp_owner" ]] && issues+=("owner")
160:     [[ "$act_group" != "$exp_group" ]] && issues+=("group")
161: 
162:     if [[ ${#issues[@]} -eq 0 ]]; then
163:         NFTBAN_FHS_STATUS["$path"]="OK"
164:     else
165:         # Join issues with commas (save/restore IFS to avoid newline issues)
166:         local old_ifs="$IFS"
167:         IFS=","
168:         NFTBAN_FHS_STATUS["$path"]="ERROR:${issues[*]}"
169:         IFS="$old_ifs"
170:     fi
171: }
172: 
173: nftban_fhs_check_all() {
174:     # Check all defined directories
175: 
176:     nftban_fhs_define_directories
177: 
178:     local path
179:     for path in "${!NFTBAN_FHS_DIRECTORIES[@]}"; do
180:         # Ignore return value - missing/incorrect directories are tracked in NFTBAN_FHS_STATUS
181:         nftban_fhs_check_directory "$path" || true
182:     done
183: }
184: 
185: # =============================================================================
186: # REPORT RENDERING FUNCTIONS
187: # =============================================================================
188: 
189: nftban_fhs_render_table() {
190:     # Render FHS audit report as terminal table
191: 
192:     if [[ "$NFTBAN_FHS_OUTPUT_FORMAT" == "table" ]]; then
193:         echo
194:         echo "════════════════════════════════════════════════════════════════════════════════════"
195:         printf "%s FHS Compliance Report — %s %s\n" "${C_BOLD:-}" "$NFTBAN_FHS_TIMESTAMP" "${C_RESET:-}"
196:         echo "════════════════════════════════════════════════════════════════════════════════════"
197:         printf "%-40s %-18s %-18s %-10s %s\n" \
198:             "DIRECTORY" "EXPECTED" "ACTUAL" "STATUS" "NOTES"
199:         echo "------------------------------------------------------------------------------------"
200:     elif [[ "$NFTBAN_FHS_OUTPUT_FORMAT" == "md" ]]; then
201:         echo "| DIRECTORY | EXPECTED | ACTUAL | STATUS | NOTES |"
202:         echo "|:---|:---|:---|:---:|:---|"
203:     elif [[ "$NFTBAN_FHS_OUTPUT_FORMAT" == "csv" ]]; then
204:         echo "DIRECTORY,EXPECTED,ACTUAL,STATUS,NOTES"
205:     fi
206: 
207:     # Sort paths - use mapfile which is more reliable with strict mode
208:     local -a sorted_paths=()
209:     local path
210: 
211:     # First collect all paths
212:     local -a temp_paths=()
213:     for path in "${!NFTBAN_FHS_DIRECTORIES[@]}"; do
214:         temp_paths+=("$path")
215:     done
216: 
217:     # Sort using mapfile (readarray)
218:     mapfile -t sorted_paths < <(printf '%s\n' "${temp_paths[@]}" | sort)
219: 
220:     local ok_count=0 error_count=0 missing_count=0
221: 
222:     for path in "${sorted_paths[@]}"; do
223:         local expected="${NFTBAN_FHS_DIRECTORIES[$path]}"
224:         local status="${NFTBAN_FHS_STATUS[$path]:-UNKNOWN}"
225: 
226:         IFS='|' read -r exp_perms exp_owner exp_group purpose <<< "$expected"
227: 
228:         local exp_str="${exp_perms} ${exp_owner}:${exp_group}"
229:         local act_str notes=""
230: 
231:         if [[ "$status" == "MISSING" ]]; then
232:             act_str="(not found)"
233:             notes="Directory does not exist"
234:             missing_count=$((missing_count + 1))
235:         elif [[ "$status" == "NOT_DIR" ]]; then
236:             act_str="(not a directory)"
237:             notes="Path exists but is not a directory"
238:             error_count=$((error_count + 1))
239:         elif [[ "$status" == "OK" ]]; then
240:             local act_perms act_owner act_group
241:             act_perms="$(nftban_fhs_get_perms "$path")"
242:             act_owner="$(nftban_fhs_get_owner "$path")"
243:             act_group="$(nftban_fhs_get_group "$path")"
244:             act_str="${act_perms} ${act_owner}:${act_group}"
245:             notes="$purpose"
246:             ok_count=$((ok_count + 1))
247:         else
248:             # ERROR with issues
249:             local act_perms act_owner act_group
250:             act_perms="$(nftban_fhs_get_perms "$path")"
251:             act_owner="$(nftban_fhs_get_owner "$path")"
252:             act_group="$(nftban_fhs_get_group "$path")"
253:             act_str="${act_perms} ${act_owner}:${act_group}"
254:             notes="${status#ERROR:}"
255:             notes="Mismatch: ${notes// /, }"
256:             error_count=$((error_count + 1))
257:         fi
258: 
259:         # Render row
260:         if [[ "$NFTBAN_FHS_OUTPUT_FORMAT" == "table" ]]; then
261:             local status_badge
262:             if [[ "$status" == "OK" ]]; then
263:                 status_badge="${C_GREEN:-}${NFTBAN_FHS_SYM_OK}${C_RESET:-} OK"
264:             elif [[ "$status" == "MISSING" ]]; then
265:                 status_badge="${C_YELLOW:-}${NFTBAN_FHS_SYM_WARN}${C_RESET:-} MISSING"
266:             else
267:                 status_badge="${C_RED:-}${NFTBAN_FHS_SYM_KO}${C_RESET:-} ERROR"
268:             fi
269: 
270:             printf "%-40s %-18s %-18s %-10s %s\n" \
271:                 "${path:0:39}" \
272:                 "${exp_str:0:17}" \
273:                 "${act_str:0:17}" \
274:                 "$status_badge" \
275:                 "$notes"
276: 
277:         elif [[ "$NFTBAN_FHS_OUTPUT_FORMAT" == "md" ]]; then
278:             printf "| %s | %s | %s | %s | %s |\n" \
279:                 "$path" "$exp_str" "$act_str" "$status" "$notes"
280: 
281:         else # csv
282:             printf "%s,%s,%s,%s,%s\n" \
283:                 "\"$path\"" "\"$exp_str\"" "\"$act_str\"" "$status" "\"$notes\""
284:         fi
285:     done
286: 
287:     if [[ "$NFTBAN_FHS_OUTPUT_FORMAT" == "table" ]]; then
288:         echo
289:         local total="${#NFTBAN_FHS_DIRECTORIES[@]}"
290:         echo "Total directories: $total | ${C_GREEN:-}OK: $ok_count${C_RESET:-} | ${C_RED:-}Errors: $error_count${C_RESET:-} | ${C_YELLOW:-}Missing: $missing_count${C_RESET:-}"
291:         echo
292:         if (( error_count > 0 || missing_count > 0 )); then
293:             echo "${C_YELLOW:-}${NFTBAN_FHS_SYM_WARN}${C_RESET:-} FHS compliance issues detected. Review errors above."
294:             echo
295:         fi
296:     fi
297: }

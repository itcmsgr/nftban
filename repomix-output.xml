218: # =============================================================================
219: # EVE JSON PARSING
220: # =============================================================================
221: 
222: # Read new alerts from EVE file
223: nftban_portscan_suricata_read_eve() {
224:     local eve_file="${PORTSCAN_SURICATA_EVE_FILE}"
225:     local batch_size="${PORTSCAN_SURICATA_BATCH_SIZE}"
226:     local sig_patterns="${PORTSCAN_SURICATA_SIG_PATTERNS}"
227: 
228:     [[ -f "$eve_file" ]] || return 1
229: 
230:     # Check if file was rotated (smaller than offset)
231:     local file_size
232:     file_size=$(stat -c %s "$eve_file" 2>/dev/null) || return 1
233: 
234:     if [[ $file_size -lt $_PORTSCAN_SURICATA_EVE_OFFSET ]]; then
235:         _PORTSCAN_SURICATA_EVE_OFFSET=0
236:     fi
237: 
238:     # Read new entries
239:     local count=0
240:     while IFS= read -r line; do
241:         nftban_portscan_suricata_process_alert "$line"
242:         ((count++))
243:         [[ $count -ge $batch_size ]] && break
244:     done < <(tail -c +$((_PORTSCAN_SURICATA_EVE_OFFSET + 1)) "$eve_file" 2>/dev/null | \
245:              grep -E '"event_type"\s*:\s*"alert"' | \
246:              grep -iE "$sig_patterns" | \
247:              head -n "$batch_size")
248: 
249:     # Update offset
250:     _PORTSCAN_SURICATA_EVE_OFFSET=$file_size
251: 
252:     return 0
253: }
254: 
255: # Process a single EVE alert
256: nftban_portscan_suricata_process_alert() {
257:     local alert_json="$1"
258: 
259:     # Check if jq is available
260:     if ! command -v jq &>/dev/null; then
261:         nftban_portscan_suricata_process_alert_regex "$alert_json"
262:         return $?
263:     fi
264: 
265:     # Parse with jq
266:     local src_ip severity signature category
267: 
268:     src_ip=$(echo "$alert_json" | jq -r '.src_ip // empty' 2>/dev/null)
269:     [[ -z "$src_ip" ]] && return 1
270: 
271:     severity=$(echo "$alert_json" | jq -r '.alert.severity // 3' 2>/dev/null)
272:     signature=$(echo "$alert_json" | jq -r '.alert.signature // ""' 2>/dev/null)
273:     category=$(echo "$alert_json" | jq -r '.alert.category // ""' 2>/dev/null)
274: 
275:     # Process the alert
276:     nftban_portscan_suricata_record_alert "$src_ip" "$severity" "$signature" "$category"
277: 
278:     return 0
279: }
280: 
281: # Fallback regex parser for EVE alerts
282: nftban_portscan_suricata_process_alert_regex() {
283:     local alert_json="$1"
284: 
285:     local src_ip="" severity="3" signature="" category=""
286: 
287:     # Extract src_ip
288:     if [[ "$alert_json" =~ \"src_ip\"[[:space:]]*:[[:space:]]*\"([^\"]+)\" ]]; then
289:         src_ip="${BASH_REMATCH[1]}"
290:     fi
291: 
292:     [[ -z "$src_ip" ]] && return 1
293: 
294:     # Extract severity
295:     if [[ "$alert_json" =~ \"severity\"[[:space:]]*:[[:space:]]*([0-9]+) ]]; then
296:         severity="${BASH_REMATCH[1]}"
297:     fi
298: 
299:     # Extract signature
300:     if [[ "$alert_json" =~ \"signature\"[[:space:]]*:[[:space:]]*\"([^\"]+)\" ]]; then
301:         signature="${BASH_REMATCH[1]}"
302:     fi
303: 
304:     # Extract category
305:     if [[ "$alert_json" =~ \"category\"[[:space:]]*:[[:space:]]*\"([^\"]+)\" ]]; then
306:         category="${BASH_REMATCH[1]}"
307:     fi
308: 
309:     nftban_portscan_suricata_record_alert "$src_ip" "$severity" "$signature" "$category"
310: 
311:     return 0
312: }

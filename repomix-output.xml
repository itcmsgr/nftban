<file path="cli/lib/nftban/core/nftban_config_safe.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - Safe Configuration Loader
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Secure configuration file parser - prevents code execution
  7: #
  8: # meta:name=nftban_config_safe
  9: # meta:type=core
 10: # meta:header=Safe Configuration Loader
 11: # meta:version=1.0.0
 12: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 13: # meta:homepage=https://nftban.com
 14: #
 15: # **Description & Purpose**
 16: # meta:description=Secure configuration file parser that prevents arbitrary code execution
 17: # meta:input=Configuration files with key=value pairs
 18: # meta:output=Safely loaded environment variables
 19: #
 20: # **Inventory & Requirements**
 21: # meta:depends=bash
 22: #
 23: # meta:created_date=2025-11-05
 24: # meta:updated_date=2025-11-24
 25: # =============================================================================
 26: 
 27: # Enhanced strict mode
 28: IFS=$'\n\t'
 29: umask 027
 30: 
 31: # Prevent double-loading
 32: [[ -n "${NFTBAN_CONFIG_SAFE_LOADED:-}" ]] && return 0
 33: readonly NFTBAN_CONFIG_SAFE_LOADED=1
 34: 
 35: # =============================================================================
 36: # ERROR HANDLING
 37: # =============================================================================
 38: 
 39: __envsafe_err() {
 40:     # Print error message to stderr
 41:     # Args: error message
 42:     printf "[CONFIG SECURITY] %s\n" "$*" >&2
 43: }
 44: 
 45: __envsafe_warn() {
 46:     # Print warning message to stderr
 47:     # Args: warning message
 48:     printf "[CONFIG WARNING] %s\n" "$*" >&2
 49: }
 50: 
 51: # =============================================================================
 52: # VALIDATION FUNCTIONS
 53: # =============================================================================
 54: 
 55: __envsafe_validate_line() {
 56:     # Validate a single config line for dangerous patterns
 57:     # Args: line_number, line_content
 58:     # Returns: 0 if safe, 1 if dangerous
 59: 
 60:     local line_num="$1"
 61:     local line="$2"
 62:     local file="${3:-unknown}"
 63: 
 64:     # Check for command substitution
 65:     if [[ "$line" == *'$('* ]] || [[ "$line" == *'`'* ]]; then
 66:         __envsafe_err "$file:$line_num: Command substitution detected: \$(…) or \`…\`"
 67:         return 2
 68:     fi
 69: 
 70:     # Check for shell operators (outside of quoted strings)
 71:     # This is a simplified check - more sophisticated parsing would be needed for perfect detection
 72:     if [[ "$line" == *';'* ]] || [[ "$line" == *'&&'* ]] || [[ "$line" == *'||'* ]]; then
 73:         # Allow these inside double quotes (simplified - matches KEY="value;with;semicolons")
 74:         if [[ ! "$line" =~ ^[A-Z0-9_]+=[\"\'][^\"\']*[\"\']$ ]]; then
 75:             __envsafe_err "$file:$line_num: Shell operator detected outside quotes: ; && ||"
 76:             return 2
 77:         fi
 78:     fi
 79: 
 80:     # Check for pipe operators
 81:     if [[ "$line" == *'|'* ]] && [[ ! "$line" =~ ^[A-Z0-9_]+=\"[^\"]*\|[^\"]*\"$ ]]; then
 82:         __envsafe_err "$file:$line_num: Pipe operator detected: |"
 83:         return 2
 84:     fi
 85: 
 86:     # Check for function definitions
 87:     if [[ "$line" =~ ^[a-zA-Z_][a-zA-Z0-9_]*\(\) ]] || [[ "$line" == *'function '* ]]; then
 88:         __envsafe_err "$file:$line_num: Function definition detected"
 89:         return 2
 90:     fi
 91: 
 92:     # Check for control structures
 93:     if [[ "$line" =~ ^(if|for|while|case|select)[[:space:]] ]]; then
 94:         __envsafe_err "$file:$line_num: Control structure detected: ${BASH_REMATCH[1]}"
 95:         return 2
 96:     fi
 97: 
 98:     return 0
 99: }
100: 
101: __envsafe_parse_assignment() {
102:     # Parse and validate a KEY=VALUE assignment
103:     # Args: line
104:     # Sets: __ENVSAFE_KEY, __ENVSAFE_VALUE
105:     # Returns: 0 if valid, 1 if invalid
106: 
107:     local line="$1"
108: 
109:     # Match KEY=VALUE where KEY is [A-Z0-9_]+
110:     if [[ "$line" =~ ^([A-Z0-9_]+)=(.*)$ ]]; then
111:         __ENVSAFE_KEY="${BASH_REMATCH[1]}"
112:         local raw="${BASH_REMATCH[2]}"
113: 
114:         # Strip optional quotes; allow simple escapes \" and \\ inside double quotes
115:         if [[ "$raw" =~ ^\"(([^\"]|\\\"|\\\\)*)\"$ ]]; then
116:             # Double-quoted value
117:             __ENVSAFE_VALUE="${BASH_REMATCH[1]}"
118:             # Unescape \" and \\
119:             __ENVSAFE_VALUE="${__ENVSAFE_VALUE//\\\"/\"}"
120:             __ENVSAFE_VALUE="${__ENVSAFE_VALUE//\\\\/\\}"
121:         elif [[ "$raw" =~ ^\'([^\']*)\'$ ]]; then
122:             # Single-quoted value (no escaping needed)
123:             __ENVSAFE_VALUE="${BASH_REMATCH[1]}"
124:         else
125:             # Unquoted value (strip trailing whitespace)
126:             __ENVSAFE_VALUE="${raw%%[[:space:]]*}"
127:         fi
128: 
129:         return 0
130:     else
131:         return 1
132:     fi
133: }
134: 
135: # =============================================================================
136: # MAIN LOADING FUNCTIONS
137: # =============================================================================
138: 
139: load_env_file() {
140:     # Load NAME=VALUE pairs from a file into current shell as globals
141:     # If PREFIX is provided, variables are exported as ${PREFIX}_NAME to avoid collisions
142:     #
143:     # Args:
144:     #   $1: file path (required)
145:     #   $2: prefix (optional, e.g., "NFTBAN")
146:     #
147:     # Returns:
148:     #   0: success
149:     #   1: file not readable
150:     #   2: syntax error or forbidden pattern detected
151:     #
152:     # Example:
153:     #   load_env_file "/etc/nftban/nftban.conf" "NFTBAN"
154:     #   # Sets: NFTBAN_VAR1=value1, NFTBAN_VAR2=value2, etc.
155: 
156:     local file="${1:?ERROR: load_env_file requires file path}"
157:     local prefix="${2:-}"
158: 
159:     # Check file exists and is readable
160:     if [[ ! -f "$file" ]]; then
161:         __envsafe_warn "File not found: $file"
162:         return 0  # Not an error - file might not exist yet
163:     fi
164: 
165:     if [[ ! -r "$file" ]]; then
166:         __envsafe_err "Cannot read file: $file (permission denied)"
167:         return 1
168:     fi
169: 
170:     # Validate file ownership (should be root:root or nftban:nftban)
171:     local file_owner
172:     file_owner="$(stat -c '%U' "$file" 2>/dev/null || stat -f '%Su' "$file" 2>/dev/null || echo "unknown")"
173:     if [[ "$file_owner" != "root" ]] && [[ "$file_owner" != "nftban" ]]; then
174:         __envsafe_err "File has dangerous ownership: $file (owner: $file_owner, expected: root or nftban)"
175:         return 2
176:     fi
177: 
178:     local line n=0 key val
179:     local __ENVSAFE_KEY __ENVSAFE_VALUE
180:     local errors=0
181: 
182:     while IFS= read -r line || [[ -n "$line" ]]; do
183:         ((n++))
184: 
185:         # Trim leading/trailing spaces
186:         line="${line##+([[:space:]])}"
187:         line="${line%%+([[:space:]])}"
188: 
189:         # Skip blank lines and comments
190:         [[ -z "$line" ]] && continue
191:         [[ "${line:0:1}" == "#" ]] && continue
192: 
193:         # Validate line for dangerous patterns
194:         if ! __envsafe_validate_line "$n" "$line" "$file"; then
195:             ((errors++))
196:             continue
197:         fi
198: 
199:         # Parse assignment
200:         if ! __envsafe_parse_assignment "$line"; then
201:             __envsafe_err "$file:$n: Invalid assignment syntax (expected: NAME=VALUE)"
202:             ((errors++))
203:             continue
204:         fi
205: 
206:         key="$__ENVSAFE_KEY"
207:         val="$__ENVSAFE_VALUE"
208: 
209:         # Export variable with optional prefix
210:         if [[ -n "$prefix" ]]; then
211:             # Namespaced variable: PREFIX_KEY
212:             export "${prefix}_${key}=${val}"
213:         else
214:             # Global variable: KEY
215:             export "${key}=${val}"
216:         fi
217: 
218:     done < "$file"
219: 
220:     # Return error if any dangerous patterns detected
221:     if ((errors > 0)); then
222:         __envsafe_err "Configuration file has $errors error(s): $file"
223:         __envsafe_err "REFUSING to load unsafe configuration!"
224:         return 2
225:     fi
226: 
227:     return 0
228: }
229: 
230: load_env_dir() {
231:     # Load all *.conf files from a directory
232:     # Files are loaded in alphabetical order
233:     #
234:     # Args:
235:     #   $1: directory path (required)
236:     #   $2: prefix (optional, e.g., "NFTBAN")
237:     #
238:     # Returns:
239:     #   0: success (or directory doesn't exist)
240:     #   1: error reading files
241:     #   2: syntax error in one or more files
242:     #
243:     # Example:
244:     #   load_env_dir "/etc/nftban/conf.d" "NFTBAN"
245: 
246:     local dir="${1:?ERROR: load_env_dir requires directory path}"
247:     local prefix="${2:-}"
248: 
249:     # Check directory exists
250:     if [[ ! -d "$dir" ]]; then
251:         return 0  # Not an error - directory might not exist yet
252:     fi
253: 
254:     local conf_file
255:     local errors=0
256:     local loaded=0
257: 
258:     # Load all *.conf files in alphabetical order
259:     for conf_file in "$dir"/*.conf; do
260:         # Skip if glob didn't match any files
261:         [[ -f "$conf_file" ]] || continue
262: 
263:         # Load file
264:         if load_env_file "$conf_file" "$prefix"; then
265:             ((loaded++))
266:         else
267:             ((errors++))
268:         fi
269:     done
270: 
271:     if ((errors > 0)); then
272:         __envsafe_err "Failed to load $errors configuration file(s) from: $dir"
273:         return 2
274:     fi
275: 
276:     return 0
277: }
278: 
279: # =============================================================================
280: # MIGRATION HELPERS
281: # =============================================================================
282: 
283: migrate_from_source() {
284:     # Helper function to migrate from 'source' to 'load_env_file'
285:     # Prints migration instructions for a file
286:     #
287:     # Args:
288:     #   $1: file path
289:     #   $2: prefix (optional)
290:     #
291:     # Example:
292:     #   migrate_from_source "/etc/nftban/nftban.conf" "NFTBAN"
293: 
294:     local file="$1"
295:     local prefix="${2:-}"
296: 
297:     echo "=== Migration Instructions ==="
298:     echo ""
299:     echo "OLD (DANGEROUS):"
300:     echo "  source \"$file\""
301:     echo ""
302:     echo "NEW (SAFE):"
303:     if [[ -n "$prefix" ]]; then
304:         echo "  load_env_file \"$file\" \"$prefix\""
305:         echo ""
306:         echo "Access variables with prefix:"
307:         echo "  \${${prefix}_VARIABLE_NAME}"
308:     else
309:         echo "  load_env_file \"$file\""
310:         echo ""
311:         echo "Access variables normally:"
312:         echo "  \${VARIABLE_NAME}"
313:     fi
314:     echo ""
315:     echo "=== End Migration Instructions ==="
316: }
317: 
318: # =============================================================================
319: # TESTING & VALIDATION
320: # =============================================================================
321: 
322: test_config_safety() {
323:     # Test function to validate a config file without loading it
324:     # Args: file path
325:     # Returns: 0 if safe, non-zero if dangerous
326: 
327:     local file="${1:?ERROR: test_config_safety requires file path}"
328: 
329:     if [[ ! -f "$file" ]]; then
330:         echo "ERROR: File not found: $file"
331:         return 1
332:     fi
333: 
334:     echo "Testing configuration file: $file"
335:     echo ""
336: 
337:     local line n=0
338:     local errors=0
339:     local warnings=0  # shellcheck disable=SC2034  # Reserved for warning count
340: 
341:     while IFS= read -r line || [[ -n "$line" ]]; do
342:         ((n++))
343: 
344:         # Trim
345:         line="${line##+([[:space:]])}"
346:         line="${line%%+([[:space:]])}"
347: 
348:         # Skip blank/comments
349:         [[ -z "$line" ]] && continue
350:         [[ "${line:0:1}" == "#" ]] && continue
351: 
352:         # Validate
353:         if ! __envsafe_validate_line "$n" "$line" "$file"; then
354:             ((errors++))
355:         fi
356:     done < "$file"
357: 
358:     echo ""
359:     if ((errors == 0)); then
360:         echo "✅ Configuration file is SAFE"
361:         return 0
362:     else
363:         echo "❌ Configuration file has $errors SECURITY ERROR(S)"
364:         echo "   REFUSING to load this file!"
365:         return 2
366:     fi
367: }
368: 
369: # =============================================================================
370: # EXPORTS
371: # =============================================================================
372: 
373: # Export main functions
374: export -f load_env_file
375: export -f load_env_dir
376: export -f test_config_safety
377: export -f migrate_from_source
</file>

<file path="cli/lib/nftban/core/nftban_ddos_classic.sh">
  1: #!/usr/bin/env bash
  2: # shellcheck disable=SC1083  # Braces in nftables syntax are literal, not bash
  3: # =============================================================================
  4: # NFTBan v1.0 - DDoS Protection Module - CLASSIC MODE
  5: # =============================================================================
  6: # SPDX-License-Identifier: MPL-2.0
  7: # Purpose: Standalone DDoS protection using native nftables (no Suricata)
  8: #
  9: # meta:name=nftban_ddos_classic
 10: # meta:type=core
 11: # meta:header=DDoS Protection (Classic)
 12: # meta:version=1.0.0
 13: #
 14: # **Description**
 15: # Pure nftables-based DDoS protection using:
 16: # - Rate limiting meters (SYN flood, ICMP flood, UDP flood)
 17: # - Connection tracking limits (per-service)
 18: # - Auto-tuning based on system resources (optional)
 19: #
 20: # **When to use Classic Mode:**
 21: # - Suricata is NOT installed
 22: # - Minimal resource footprint required
 23: # - Simple rate-limiting is sufficient
 24: # - Edge/embedded systems
 25: #
 26: # meta:depends=bash>=4.0,nftables>=0.9.0
 27: # meta:created_date=2025-12-01
 28: # meta:updated_date=2025-12-01
 29: # =============================================================================
 30: 
 31: # =============================================================================
 32: # MODULE GUARD
 33: # =============================================================================
 34: 
 35: [[ -n "${NFTBAN_DDOS_CLASSIC_LOADED:-}" ]] && return 0
 36: readonly NFTBAN_DDOS_CLASSIC_LOADED=1
 37: 
 38: # =============================================================================
 39: # CONFIGURATION LOADING
 40: # =============================================================================
 41: 
 42: # Load classic mode config
 43: _nftban_ddos_classic_load_config() {
 44:     local config_file="${NFTBAN_CONFIG_DIR:-/etc/nftban}/conf.d/ddos/classic.conf"
 45: 
 46:     if [[ -f "$config_file" ]]; then
 47:         # shellcheck source=/dev/null
 48:         source "$config_file"
 49:     fi
 50: 
 51:     # Set defaults if not configured
 52:     : "${DDOS_CLASSIC_SYN_RATE:=25/second}"
 53:     : "${DDOS_CLASSIC_SYN_BURST:=50}"
 54:     : "${DDOS_CLASSIC_SSH_CONN_LIMIT:=10}"
 55:     : "${DDOS_CLASSIC_HTTP_CONN_LIMIT:=100}"
 56:     : "${DDOS_CLASSIC_HTTPS_CONN_LIMIT:=100}"
 57:     : "${DDOS_CLASSIC_SMTP_CONN_LIMIT:=20}"
 58:     : "${DDOS_CLASSIC_DNS_CONN_LIMIT:=50}"
 59:     : "${DDOS_CLASSIC_GENERIC_CONN_LIMIT:=50}"
 60:     : "${DDOS_CLASSIC_ICMP_RATE:=10/second}"
 61:     : "${DDOS_CLASSIC_ICMP_BURST:=20}"
 62:     : "${DDOS_CLASSIC_ICMPV6_RATE:=10/second}"
 63:     : "${DDOS_CLASSIC_ICMPV6_BURST:=20}"
 64:     : "${DDOS_CLASSIC_UDP_RATE:=100/second}"
 65:     : "${DDOS_CLASSIC_UDP_BURST:=200}"
 66:     : "${DDOS_CLASSIC_PORT_FLOOD_RATE:=50/second}"
 67:     : "${DDOS_CLASSIC_PORT_FLOOD_BURST:=100}"
 68:     : "${DDOS_CLASSIC_AUTO_TUNE:=true}"
 69:     : "${DDOS_CLASSIC_BAN_DURATION_SHORT:=300}"
 70:     : "${DDOS_CLASSIC_BAN_DURATION_MEDIUM:=1800}"
 71:     : "${DDOS_CLASSIC_BAN_DURATION_LONG:=3600}"
 72:     : "${DDOS_CLASSIC_LOG_FILE:=/var/log/nftban/ddos-classic.log}"
 73:     : "${DDOS_CLASSIC_LOG_LEVEL:=INFO}"
 74:     : "${DDOS_CLASSIC_SYN_METER:=ddos_syn_flood}"
 75:     : "${DDOS_CLASSIC_ICMP_METER:=ddos_icmp_flood}"
 76:     : "${DDOS_CLASSIC_UDP_METER:=ddos_udp_flood}"
 77:     : "${DDOS_CLASSIC_BLOCK_SET:=ddos_blocked}"
 78: }
 79: 
 80: # =============================================================================
 81: # LOGGING
 82: # =============================================================================
 83: 
 84: _nftban_ddos_classic_log() {
 85:     local level="$1"
 86:     local message="$2"
 87:     local log_file="${DDOS_CLASSIC_LOG_FILE:-/var/log/nftban/ddos-classic.log}"
 88: 
 89:     # Create log directory if needed
 90:     mkdir -p "$(dirname "$log_file")" 2>/dev/null
 91: 
 92:     echo "[$(date '+%Y-%m-%d %H:%M:%S')] [CLASSIC] [$level] $message" >> "$log_file"
 93: }
 94: 
 95: # =============================================================================
 96: # AUTO-TUNING (Based on System Resources)
 97: # =============================================================================
 98: 
 99: _nftban_ddos_classic_auto_tune() {
100:     if [[ "${DDOS_CLASSIC_AUTO_TUNE}" != "true" ]]; then
101:         return 0
102:     fi
103: 
104:     local cores
105:     cores=$(nproc 2>/dev/null || echo 1)
106: 
107:     local mem_kb
108:     mem_kb=$(grep MemTotal /proc/meminfo 2>/dev/null | awk '{print $2}')
109:     local mem_gb
110:     mem_gb=$(( mem_kb / 1024 / 1024 ))
111: 
112:     _nftban_ddos_classic_log "INFO" "Auto-tuning: cores=$cores, mem=${mem_gb}GB"
113: 
114:     # Scale connection limits based on resources
115:     if [[ $cores -ge 4 && $mem_gb -ge 4 ]]; then
116:         # High-end system: more generous limits
117:         DDOS_CLASSIC_SYN_RATE="50/second"
118:         DDOS_CLASSIC_SYN_BURST="100"
119:         DDOS_CLASSIC_HTTP_CONN_LIMIT="200"
120:         DDOS_CLASSIC_HTTPS_CONN_LIMIT="200"
121:         _nftban_ddos_classic_log "INFO" "Auto-tune: HIGH profile applied"
122:     elif [[ $cores -ge 2 && $mem_gb -ge 2 ]]; then
123:         # Medium system: default limits
124:         _nftban_ddos_classic_log "INFO" "Auto-tune: MEDIUM profile (defaults)"
125:     else
126:         # Low-end system: stricter limits
127:         DDOS_CLASSIC_SYN_RATE="15/second"
128:         DDOS_CLASSIC_SYN_BURST="30"
129:         DDOS_CLASSIC_HTTP_CONN_LIMIT="50"
130:         DDOS_CLASSIC_HTTPS_CONN_LIMIT="50"
131:         DDOS_CLASSIC_SSH_CONN_LIMIT="5"
132:         _nftban_ddos_classic_log "INFO" "Auto-tune: LOW profile applied"
133:     fi
134: }
135: 
136: # =============================================================================
137: # NFTABLES HELPERS
138: # =============================================================================
139: 
140: _nftban_ddos_classic_chain_exists() {
141:     local table="$1"
142:     local chain="$2"
143:     nft list chain $table "$chain" &>/dev/null
144: }
145: 
146: _nftban_ddos_classic_jump_exists() {
147:     local table="$1"
148:     local chain="$2"
149:     nft list chain $table input 2>/dev/null | grep -q "jump $chain"
150: }
151: 
152: _nftban_ddos_classic_add_jump_rule() {
153:     local table="$1"
154:     local chain="$2"
155: 
156:     # Find position after "ct state established,related accept"
157:     local handle=""
158:     local chain_output
159:     chain_output=$(nft -a list chain $table input 2>/dev/null) || true
160:     if [[ -n "$chain_output" ]]; then
161:         handle=$(echo "$chain_output" | grep "ct state established,related accept" | grep -oP 'handle \K[0-9]+' | head -1) || true
162:     fi
163: 
164:     if [[ -n "$handle" ]]; then
165:         nft add rule $table input position "$handle" jump "$chain" \
166:             comment "\"DDoS classic protection\"" 2>/dev/null || true
167:     else
168:         nft insert rule $table input jump "$chain" \
169:             comment "\"DDoS classic protection\"" 2>/dev/null || true
170:     fi
171: }
172: 
173: _nftban_ddos_classic_remove_jump_rule() {
174:     local table="$1"
175:     local chain="$2"
176: 
177:     local handles
178:     handles=$(nft -a list chain $table input 2>/dev/null | \
179:         grep "jump $chain" | grep -oP 'handle \K[0-9]+')
180: 
181:     while IFS= read -r handle; do
182:         [[ -n "$handle" ]] && nft delete rule $table input handle "$handle" 2>/dev/null || true
183:     done <<< "$handles"
184: }
185: 
186: # =============================================================================
187: # SETUP PROTECTION (IPv4)
188: # =============================================================================
189: 
190: _nftban_ddos_classic_setup_ipv4() {
191:     local table="${DDOS_NFT_TABLE_IPV4:-ip nftban}"
192:     local chain="${DDOS_NFT_CHAIN:-ddos_protection}"
193: 
194:     echo "  [IPv4] Setting up Classic DDoS protection..."
195: 
196:     # Create chain if not exists
197:     if ! _nftban_ddos_classic_chain_exists "$table" "$chain"; then
198:         nft add chain $table "$chain" 2>/dev/null || {
199:             echo "  [IPv4] ERROR: Failed to create chain"
200:             return 1
201:         }
202:         echo "     Created chain: $chain"
203:     fi
204: 
205:     # Flush existing rules
206:     nft flush chain $table "$chain" 2>/dev/null || true
207: 
208:     # --- SYN Flood Protection ---
209:     nft add rule $table "$chain" \
210:         tcp flags syn \
211:         meter "${DDOS_CLASSIC_SYN_METER}" { ip saddr limit rate "${DDOS_CLASSIC_SYN_RATE}" burst "${DDOS_CLASSIC_SYN_BURST}" packets } \
212:         return \
213:         comment "\"SYN: rate OK\"" 2>/dev/null || true
214: 
215:     nft add rule $table "$chain" \
216:         tcp flags syn \
217:         counter drop \
218:         comment "\"SYN flood: rate exceeded\"" 2>/dev/null || true
219: 
220:     # --- Connection Limits per Service ---
221:     # SSH
222:     nft add rule $table "$chain" \
223:         tcp dport 22 ct state new \
224:         ct count over "${DDOS_CLASSIC_SSH_CONN_LIMIT}" \
225:         counter drop \
226:         comment "\"SSH: max ${DDOS_CLASSIC_SSH_CONN_LIMIT} conn/IP\"" 2>/dev/null || true
227: 
228:     # HTTP
229:     nft add rule $table "$chain" \
230:         tcp dport 80 ct state new \
231:         ct count over "${DDOS_CLASSIC_HTTP_CONN_LIMIT}" \
232:         counter drop \
233:         comment "\"HTTP: max ${DDOS_CLASSIC_HTTP_CONN_LIMIT} conn/IP\"" 2>/dev/null || true
234: 
235:     # HTTPS
236:     nft add rule $table "$chain" \
237:         tcp dport 443 ct state new \
238:         ct count over "${DDOS_CLASSIC_HTTPS_CONN_LIMIT}" \
239:         counter drop \
240:         comment "\"HTTPS: max ${DDOS_CLASSIC_HTTPS_CONN_LIMIT} conn/IP\"" 2>/dev/null || true
241: 
242:     # SMTP
243:     nft add rule $table "$chain" \
244:         tcp dport 25 ct state new \
245:         ct count over "${DDOS_CLASSIC_SMTP_CONN_LIMIT}" \
246:         counter drop \
247:         comment "\"SMTP: max ${DDOS_CLASSIC_SMTP_CONN_LIMIT} conn/IP\"" 2>/dev/null || true
248: 
249:     # --- ICMP Rate Limiting ---
250:     nft add rule $table "$chain" \
251:         ip protocol icmp \
252:         meter "${DDOS_CLASSIC_ICMP_METER}" { ip saddr limit rate "${DDOS_CLASSIC_ICMP_RATE}" burst "${DDOS_CLASSIC_ICMP_BURST}" packets } \
253:         return \
254:         comment "\"ICMP: rate OK\"" 2>/dev/null || true
255: 
256:     nft add rule $table "$chain" \
257:         ip protocol icmp \
258:         counter drop \
259:         comment "\"ICMP flood: rate exceeded\"" 2>/dev/null || true
260: 
261:     # --- UDP Flood Protection ---
262:     nft add rule $table "$chain" \
263:         ip protocol udp \
264:         meter "${DDOS_CLASSIC_UDP_METER}" { ip saddr limit rate "${DDOS_CLASSIC_UDP_RATE}" burst "${DDOS_CLASSIC_UDP_BURST}" packets } \
265:         return \
266:         comment "\"UDP: rate OK\"" 2>/dev/null || true
267: 
268:     nft add rule $table "$chain" \
269:         ip protocol udp \
270:         counter drop \
271:         comment "\"UDP flood: rate exceeded\"" 2>/dev/null || true
272: 
273:     # --- Return to input chain ---
274:     nft add rule $table "$chain" return 2>/dev/null || true
275: 
276:     # Add jump rule if not exists
277:     if ! _nftban_ddos_classic_jump_exists "$table" "$chain"; then
278:         _nftban_ddos_classic_add_jump_rule "$table" "$chain"
279:         echo "     Added jump rule to input chain"
280:     fi
281: 
282:     echo "  [IPv4] Classic DDoS protection enabled"
283:     _nftban_ddos_classic_log "INFO" "IPv4 classic protection enabled"
284: 
285:     return 0
286: }
287: 
288: # =============================================================================
289: # SETUP PROTECTION (IPv6)
290: # =============================================================================
291: 
292: _nftban_ddos_classic_setup_ipv6() {
293:     local table="${DDOS_NFT_TABLE_IPV6:-ip6 nftban}"
294:     local chain="${DDOS_NFT_CHAIN:-ddos_protection}"
295: 
296:     # Check if IPv6 table exists
297:     if ! nft list table $table &>/dev/null; then
298:         echo "  [IPv6] Table not found, skipping"
299:         return 0
300:     fi
301: 
302:     echo "  [IPv6] Setting up Classic DDoS protection..."
303: 
304:     # Create chain if not exists
305:     if ! _nftban_ddos_classic_chain_exists "$table" "$chain"; then
306:         nft add chain $table "$chain" 2>/dev/null || {
307:             echo "  [IPv6] ERROR: Failed to create chain"
308:             return 1
309:         }
310:         echo "     Created chain: $chain"
311:     fi
312: 
313:     # Flush existing rules
314:     nft flush chain $table "$chain" 2>/dev/null || true
315: 
316:     # --- SYN Flood Protection ---
317:     nft add rule $table "$chain" \
318:         tcp flags syn \
319:         meter "${DDOS_CLASSIC_SYN_METER}6" { ip6 saddr limit rate "${DDOS_CLASSIC_SYN_RATE}" burst "${DDOS_CLASSIC_SYN_BURST}" packets } \
320:         return \
321:         comment "\"SYN: rate OK\"" 2>/dev/null || true
322: 
323:     nft add rule $table "$chain" \
324:         tcp flags syn \
325:         counter drop \
326:         comment "\"SYN flood: rate exceeded\"" 2>/dev/null || true
327: 
328:     # --- Connection Limits ---
329:     nft add rule $table "$chain" \
330:         tcp dport 22 ct state new \
331:         ct count over "${DDOS_CLASSIC_SSH_CONN_LIMIT}" \
332:         counter drop \
333:         comment "\"SSH: max ${DDOS_CLASSIC_SSH_CONN_LIMIT} conn/IP\"" 2>/dev/null || true
334: 
335:     nft add rule $table "$chain" \
336:         tcp dport { 80, 443 } ct state new \
337:         ct count over "${DDOS_CLASSIC_HTTP_CONN_LIMIT}" \
338:         counter drop \
339:         comment "\"HTTP(S): max ${DDOS_CLASSIC_HTTP_CONN_LIMIT} conn/IP\"" 2>/dev/null || true
340: 
341:     # --- ICMPv6 Rate Limiting ---
342:     nft add rule $table "$chain" \
343:         meta l4proto icmpv6 \
344:         meter "${DDOS_CLASSIC_ICMP_METER}6" { ip6 saddr limit rate "${DDOS_CLASSIC_ICMPV6_RATE}" burst "${DDOS_CLASSIC_ICMPV6_BURST}" packets } \
345:         return \
346:         comment "\"ICMPv6: rate OK\"" 2>/dev/null || true
347: 
348:     nft add rule $table "$chain" \
349:         meta l4proto icmpv6 \
350:         counter drop \
351:         comment "\"ICMPv6 flood: rate exceeded\"" 2>/dev/null || true
352: 
353:     # --- Return ---
354:     nft add rule $table "$chain" return 2>/dev/null || true
355: 
356:     # Add jump rule
357:     if ! _nftban_ddos_classic_jump_exists "$table" "$chain"; then
358:         _nftban_ddos_classic_add_jump_rule "$table" "$chain"
359:         echo "     Added jump rule to input chain"
360:     fi
361: 
362:     echo "  [IPv6] Classic DDoS protection enabled"
363:     _nftban_ddos_classic_log "INFO" "IPv6 classic protection enabled"
364: 
365:     return 0
366: }
367: 
368: # =============================================================================
369: # REMOVE PROTECTION
370: # =============================================================================
371: 
372: _nftban_ddos_classic_remove_ipv4() {
373:     local table="${DDOS_NFT_TABLE_IPV4:-ip nftban}"
374:     local chain="${DDOS_NFT_CHAIN:-ddos_protection}"
375: 
376:     echo "  [IPv4] Removing Classic DDoS protection..."
377: 
378:     # Remove jump rule first
379:     _nftban_ddos_classic_remove_jump_rule "$table" "$chain"
380: 
381:     # Delete chain
382:     if _nftban_ddos_classic_chain_exists "$table" "$chain"; then
383:         nft flush chain $table "$chain" 2>/dev/null || true
384:         nft delete chain $table "$chain" 2>/dev/null || true
385:         echo "     Deleted chain: $chain"
386:     fi
387: 
388:     _nftban_ddos_classic_log "INFO" "IPv4 classic protection disabled"
389: }
390: 
391: _nftban_ddos_classic_remove_ipv6() {
392:     local table="${DDOS_NFT_TABLE_IPV6:-ip6 nftban}"
393:     local chain="${DDOS_NFT_CHAIN:-ddos_protection}"
394: 
395:     if ! nft list table $table &>/dev/null; then
396:         return 0
397:     fi
398: 
399:     echo "  [IPv6] Removing Classic DDoS protection..."
400: 
401:     _nftban_ddos_classic_remove_jump_rule "$table" "$chain"
402: 
403:     if _nftban_ddos_classic_chain_exists "$table" "$chain"; then
404:         nft flush chain $table "$chain" 2>/dev/null || true
405:         nft delete chain $table "$chain" 2>/dev/null || true
406:         echo "     Deleted chain: $chain"
407:     fi
408: 
409:     _nftban_ddos_classic_log "INFO" "IPv6 classic protection disabled"
410: }
411: 
412: # =============================================================================
413: # PUBLIC API
414: # =============================================================================
415: 
416: nftban_ddos_classic_enable() {
417:     _nftban_ddos_classic_load_config
418:     _nftban_ddos_classic_auto_tune
419: 
420:     echo ""
421:     echo "Enabling Classic DDoS Protection..."
422:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
423: 
424:     _nftban_ddos_classic_setup_ipv4
425:     _nftban_ddos_classic_setup_ipv6
426: 
427:     echo ""
428:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
429:     echo "Thresholds:"
430:     echo "  SYN Rate:    ${DDOS_CLASSIC_SYN_RATE} burst ${DDOS_CLASSIC_SYN_BURST}"
431:     echo "  SSH Conn:    max ${DDOS_CLASSIC_SSH_CONN_LIMIT}/IP"
432:     echo "  HTTP Conn:   max ${DDOS_CLASSIC_HTTP_CONN_LIMIT}/IP"
433:     echo "  ICMP Rate:   ${DDOS_CLASSIC_ICMP_RATE} burst ${DDOS_CLASSIC_ICMP_BURST}"
434:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
435:     echo ""
436: 
437:     return 0
438: }
439: 
440: nftban_ddos_classic_disable() {
441:     _nftban_ddos_classic_load_config
442: 
443:     echo ""
444:     echo "Disabling Classic DDoS Protection..."
445:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
446: 
447:     _nftban_ddos_classic_remove_ipv4
448:     _nftban_ddos_classic_remove_ipv6
449: 
450:     echo ""
451:     echo "Classic DDoS protection disabled"
452:     echo ""
453: 
454:     return 0
455: }
456: 
457: nftban_ddos_classic_status() {
458:     _nftban_ddos_classic_load_config
459: 
460:     local table_v4="${DDOS_NFT_TABLE_IPV4:-ip nftban}"
461:     local table_v6="${DDOS_NFT_TABLE_IPV6:-ip6 nftban}"
462:     local chain="${DDOS_NFT_CHAIN:-ddos_protection}"
463: 
464:     echo ""
465:     echo "Classic DDoS Protection Status"
466:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
467: 
468:     # IPv4 Status
469:     if _nftban_ddos_classic_chain_exists "$table_v4" "$chain"; then
470:         if _nftban_ddos_classic_jump_exists "$table_v4" "$chain"; then
471:             echo "  IPv4: ENABLED (chain + jump active)"
472:         else
473:             echo "  IPv4: PARTIAL (chain exists, no jump)"
474:         fi
475:     else
476:         echo "  IPv4: DISABLED"
477:     fi
478: 
479:     # IPv6 Status
480:     if nft list table $table_v6 &>/dev/null; then
481:         if _nftban_ddos_classic_chain_exists "$table_v6" "$chain"; then
482:             if _nftban_ddos_classic_jump_exists "$table_v6" "$chain"; then
483:                 echo "  IPv6: ENABLED (chain + jump active)"
484:             else
485:                 echo "  IPv6: PARTIAL (chain exists, no jump)"
486:             fi
487:         else
488:             echo "  IPv6: DISABLED"
489:         fi
490:     else
491:         echo "  IPv6: N/A (table not found)"
492:     fi
493: 
494:     echo ""
495:     echo "Configuration:"
496:     echo "  SYN Rate:    ${DDOS_CLASSIC_SYN_RATE} burst ${DDOS_CLASSIC_SYN_BURST}"
497:     echo "  SSH Conn:    max ${DDOS_CLASSIC_SSH_CONN_LIMIT}/IP"
498:     echo "  HTTP Conn:   max ${DDOS_CLASSIC_HTTP_CONN_LIMIT}/IP"
499:     echo "  ICMP Rate:   ${DDOS_CLASSIC_ICMP_RATE} burst ${DDOS_CLASSIC_ICMP_BURST}"
500:     echo "  Auto-tune:   ${DDOS_CLASSIC_AUTO_TUNE}"
501:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
502:     echo ""
503: 
504:     return 0
505: }

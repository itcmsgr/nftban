242: // downloadFile downloads a file from URL to the specified path with progress
243: func downloadFile(url, filepath string) error {
244: 	// Create temp file
245: 	tmpFile := filepath + ".tmp"
246: 	out, err := os.Create(tmpFile)
247: 	if err != nil {
248: 		return err
249: 	}
250: 	defer out.Close()
251: 
252: 	// Get the data
253: 	client := &http.Client{
254: 		Timeout: 5 * time.Minute,
255: 	}
256: 
257: 	resp, err := client.Get(url)
258: 	if err != nil {
259: 		os.Remove(tmpFile)
260: 		return err
261: 	}
262: 	defer resp.Body.Close()
263: 
264: 	if resp.StatusCode != http.StatusOK {
265: 		os.Remove(tmpFile)
266: 		return fmt.Errorf("bad status: %s", resp.Status)
267: 	}
268: 
269: 	// Write the body to file with progress
270: 	totalSize := resp.ContentLength
271: 	downloaded := int64(0)
272: 	lastProgress := 0
273: 
274: 	buffer := make([]byte, 32*1024) // 32KB buffer
275: 	for {
276: 		n, err := resp.Body.Read(buffer)
277: 		if n > 0 {
278: 			_, writeErr := out.Write(buffer[:n])
279: 			if writeErr != nil {
280: 				os.Remove(tmpFile)
281: 				return writeErr
282: 			}
283: 			downloaded += int64(n)
284: 
285: 			// Print progress every 10%
286: 			if totalSize > 0 {
287: 				progress := int(float64(downloaded) / float64(totalSize) * 100)
288: 				if progress >= lastProgress+10 {
289: 					fmt.Printf("  Progress: %d%% (%.1f MB / %.1f MB)\n",
290: 						progress,
291: 						float64(downloaded)/1024/1024,
292: 						float64(totalSize)/1024/1024)
293: 					lastProgress = progress
294: 				}
295: 			}
296: 		}
297: 		if err == io.EOF {
298: 			break
299: 		}
300: 		if err != nil {
301: 			os.Remove(tmpFile)
302: 			return err
303: 		}
304: 	}
305: 
306: 	// Move temp file to final location
307: 	if err := os.Rename(tmpFile, filepath); err != nil {
308: 		os.Remove(tmpFile)
309: 		return err
310: 	}
311: 
312: 	return nil
313: }

126:         type inet_service
127:         comment "Allowed TCP ports"
128:         elements = { 22, 80, 443, 3940 }
129:     }
130: 
131:     set udp_ports {
132:         type inet_service
133:         comment "Allowed UDP ports"
134:     }
135: 
136:     # =========================================================================
137:     # REGULAR CHAINS (non-base)
138:     # =========================================================================
139: 
140:     chain runtime_in {
141:         # Temp whitelist - highest priority override (emergency access)
142:         ip saddr @temp_whitelist_v4 counter accept comment "temp whitelist v4"
143:         ip6 saddr @temp_whitelist_v6 counter accept comment "temp whitelist v6"
144:         # No default verdict - returns to caller
145:     }
146: 
147:     chain portscan_detection {
148:         # Rate-limit SYN floods and log potential port scans
149:         tcp flags syn ct state new \
150:             limit rate 100/second burst 200 packets \
151:             log prefix "nftban: portscan: " \
152:             counter
153:         return
154:     }
155: 
156:     chain services_in {
157:         # Public services (applied after all filtering)
158:         tcp dport @tcp_ports counter accept comment "TCP services"
159:         udp dport @udp_ports counter accept comment "UDP services"
160:         return
161:     }
162: 
163:     # =========================================================================
164:     # BASE CHAINS - Single input hook (priority filter)
165:     # =========================================================================
166:     # CRITICAL: Rule order determines security
167:     # Drops MUST come before established accept to prevent bypass
168:     # =========================================================================
169: 
170:     chain input {
171:         type filter hook input priority filter
172:         policy drop
173: 
174:         # 0. Drop invalid connections early
175:         ct state invalid counter drop comment "invalid state"
176: 
177:         # 1. Allow loopback (safe, no blocking needed)
178:         iif "lo" counter accept comment "loopback"
179: 
180:         # 2. Runtime whitelist/bans (temp_whitelist overrides EVERYTHING)
181:         jump runtime_in
182: 
183:         # 3. Permanent blacklist (manual CLI/UI bans)
184:         ip saddr @blacklist_v4 counter drop comment "manual blacklist v4"
185:         ip6 saddr @blacklist_v6 counter drop comment "manual blacklist v6"
186: 
187:         # 4. Fail2Ban runtime bans (BEFORE established!)
188:         ip saddr @temp_ban_v4 counter drop comment "runtime ban v4 (Fail2Ban)"
189:         ip6 saddr @temp_ban_v6 counter drop comment "runtime ban v6 (Fail2Ban)"
190: 
191:         # 5. Permanent whitelist (admins, internal networks)
192:         # Bypasses feeds/geoban (your IPs stay safe even if country blocked)
193:         ip saddr @whitelist_v4 counter accept comment "whitelist v4 - full access"
194:         ip6 saddr @whitelist_v6 counter accept comment "whitelist v6 - full access"
195: 
196:         # 6. External Feeds (Spamhaus, FireHOL, etc - loaded by Go)
197:         ip saddr @feed_v4 counter drop comment "feed blacklists v4"
198:         ip6 saddr @feed_v6 counter drop comment "feed blacklists v6"
199: 
200:         # 7. GeoBan (country-based blocking - loaded by Go)
201:         ip saddr @geoban_blocked_v4 counter drop comment "GeoBan blocked countries v4"
202:         ip6 saddr @geoban_blocked_v6 counter drop comment "GeoBan blocked countries v6"
203: 
204:         # 8. Established/related (AFTER all drops!)
205:         # This ensures blocked IPs can't bypass via established connections
206:         ct state established,related counter accept comment "established connections"
207: 
208:         # 9. Port scan detection
209:         jump portscan_detection
210: 
211:         # 10. Allow ICMP
212:         ip protocol icmp icmp type { echo-reply, destination-unreachable, echo-request, time-exceeded } counter accept comment "ICMPv4"
213:         ip6 nexthdr ipv6-icmp icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, echo-request, echo-reply } counter accept comment "ICMPv6"
214: 
215:         # 11. Public services
216:         jump services_in
217: 
218:         # 12. Default deny (policy drop also covers this)
219:         counter drop comment "default deny"
220:     }
221: 
222:     chain forward {
223:         type filter hook forward priority filter
224:         policy drop
225:     }
226: 
227:     chain output {
228:         type filter hook output priority filter
229:         policy accept
230:     }
231: }
232: 
233: # =============================================================================
234: # EXECUTION ORDER (single table, single input hook):
235: # =============================================================================
236: # 1. ct state invalid drop
237: # 2. loopback accept
238: # 3. jump runtime_in
239: #    - temp_whitelist accept (emergency override)
240: # 4. blacklist drop (manual permanent)
241: # 5. temp_ban drop (Fail2Ban runtime)
242: # 6. whitelist accept (permanent, bypasses feeds/geoban)
243: # 7. feed drop (external blocklists)
244: # 8. geoban drop (country blocking)
245: # 9. ct state established,related accept (AFTER all drops!)
246: # 10. portscan detection
247: # 11. ICMP
248: # 12. services (SSH, HTTP, HTTPS, GUI)
249: # 13. default deny
250: # =============================================================================
251: #
252: # Key Principles:
253: # - Simplicity: ONE table, ONE hook, predictable packet flow
254: # - Correctness: Proper precedence (drops BEFORE established)
255: # - Performance: Go-based netlink for feeds/geoban loading
256: # - Reliability: Atomic reload preserves Fail2Ban runtime state
257: # - Observability: Counters on all rules for metrics
258: # =============================================================================
</file>


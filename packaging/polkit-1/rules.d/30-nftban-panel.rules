// meta:type="polkit"
// meta:owner="Antonios Voulvoulis <contact@nftban.com>"
// meta:created_date="2025-10-26"
// meta:description="Polkit rules granting nftban-panel group limited systemd access"
// meta:inventory.files=""
// meta:inventory.binaries=""
// meta:inventory.env_vars=""
// meta:inventory.config_files="/etc/polkit-1/rules.d/30-nftban-panel.rules"
// meta:inventory.systemd_units=""
// meta:inventory.network=""
// meta:inventory.privileges="polkit"
// Purpose: Grant nftban-panel group LIMITED systemd access for panel integration
// Location: /etc/polkit-1/rules.d/30-nftban-panel.rules
//
// Security Model:
// - Members of 'nftban-panel' group have LIMITED systemd access
// - Can query status of NFTBan services
// - Can RELOAD specific core services (NOT start/stop/restart)
// - CANNOT modify firewall rules
// - CANNOT ban/unban IPs
// - CANNOT sync or enable/disable modules
//
// Groups:
//   nftban-panel: Panel UI service accounts (nftban-da, nftban-cp, nftban-pl, nftban-wm)
//
// Service Accounts:
//   - nftban-da: DirectAdmin panel integration
//   - nftban-cp: cPanel/WHM panel integration
//   - nftban-pl: Plesk panel integration
//   - nftban-wm: Webmin panel integration
//
// Allowed Actions:
//   - systemctl status <allowlisted units>
//   - systemctl show <allowlisted units>
//   - systemctl reload <allowlisted units>  ← ONLY reload, NOT restart
//   - systemctl is-active <allowlisted units>
//   - systemctl is-enabled <allowlisted units>
//
// Does NOT Grant:
//   ✗ start/stop/restart services (panels cannot start/stop NFTBan)
//   ✗ enable/disable services (no boot config changes)
//   ✗ daemon-reload (no unit file modifications)
//   ✗ pkexec access (no arbitrary command execution)
//   ✗ Ban/unban operations (must use nftban-panelctl wrapper)
//   ✗ Firewall sync (operator-only via CLI)
//   ✗ GeoIP management (operator-only)
//
// Panel Integration Philosophy:
//   ✓ Panels should NEVER modify firewall rules directly
//   ✓ Panels call nftban-panelctl wrapper (enforces registry RBAC)
//   ✓ Panels can only reload services (apply config changes)
//   ✓ Panels can view status/stats/reports (read-only data)
//   ✓ Defense in depth: Group + Polkit + Wrapper + Registry
//
// Use Cases:
//   - DirectAdmin "NFTBan Manager" plugin
//   - cPanel/WHM "Security Center" integration
//   - Plesk "Security Advisor" extension
//   - Webmin "NFTBan" module
//
// Version History:
//   v1.0.19: Created for panel integration Phase 1
//            Provides minimal privileges needed for panel UIs
//            Complements nftban-panelctl wrapper security
// =============================================================================

polkit.addRule(function (action, subject) {
    // Only handle requests from nftban-panel group members
    if (!subject.isInGroup("nftban-panel")) {
        return polkit.Result.NOT_HANDLED;
    }

    // Allow limited systemd operations on allowlisted units
    if (action.id == "org.freedesktop.systemd1.manage-units") {
        var verb = action.lookup("verb");
        var unit = action.lookup("unit");

        // ALLOWED VERBS: Read-only queries + reload ONLY
        // CRITICAL: NO start/stop/restart (panels cannot control service lifecycle)
        var allowedVerbs = [
            // Read-only operations
            "status",
            "show",
            "is-active",
            "is-enabled",
            "is-failed",

            // Limited control (reload ONLY - apply config changes without restart)
            "reload"
        ];

        // ALLOWED UNITS: Core services only (NOT login-monitor, NOT suricata)
        // Panels can reload NFTBan core services but not attack detection modules
        var allowedUnits = [
            "nftband.service",
            "nftban-core-feeds.service",
            "nftban-core-geoip.service"
        ];

        // Read-only for timers (status only - no reload)
        // See docs/systemd/UNITS.md for canonical list
        var readOnlyUnits = [
            "nftban-core-feeds.timer",
            "nftban-core-geoip.timer"
        ];

        // Check verb + unit combination
        if (allowedVerbs.indexOf(verb) >= 0) {
            // Reload allowed only on services (not timers)
            if (verb === "reload" && allowedUnits.indexOf(unit) >= 0) {
                return polkit.Result.YES;
            }

            // Read-only verbs allowed on services + timers
            var readOnlyVerbs = ["status", "show", "is-active", "is-enabled", "is-failed"];
            if (readOnlyVerbs.indexOf(verb) >= 0) {
                if (allowedUnits.indexOf(unit) >= 0 || readOnlyUnits.indexOf(unit) >= 0) {
                    return polkit.Result.YES;
                }
            }
        }

        // Explicitly DENY dangerous operations
        var deniedVerbs = [
            "start",           // Panels cannot start services
            "stop",            // Panels cannot stop services
            "restart",         // Panels cannot restart (use reload instead)
            "enable",          // Panels cannot change boot config
            "disable",         // Panels cannot change boot config
            "try-restart",
            "reload-or-restart",  // Would allow restart fallback
            "try-reload-or-restart",
            "kill",
            "reset-failed"
        ];

        if (deniedVerbs.indexOf(verb) >= 0) {
            return polkit.Result.NO;  // Explicit denial
        }
    }

    // DENY daemon-reload (panels cannot modify unit files)
    if (action.id == "org.freedesktop.systemd1.reload-daemon") {
        return polkit.Result.NO;
    }

    // DENY all pkexec attempts (panels use nftban-panelctl wrapper only)
    if (action.id == "org.freedesktop.policykit.exec") {
        return polkit.Result.NO;
    }

    return polkit.Result.NOT_HANDLED;
});

// =============================================================================
// SECURITY NOTES
// =============================================================================
//
// Why Panels Only Get Reload (NOT Restart):
// - reload: Graceful config reload without service interruption
// - restart: Stops service then starts (downtime + potential failure loop)
// - Panels should not have power to disrupt NFTBan availability
// - If config is bad, reload will fail safely (service stays running)
//
// Why Panels Cannot Manage Suricata:
// - Suricata is complex IDS system (not panel responsibility)
// - Misconfiguration could break intrusion detection
// - Operators should manage via CLI/SSH, not panel
//
// Why Panels Cannot Manage Login Monitor:
// - Login monitor blocks SSH brute force attacks
// - Panels should not disable attack detection
// - Risk of locking out legitimate SSH access
//
// Panel Integration Architecture:
//
//   ┌─────────────────────┐
//   │   Panel UI (CGI)    │  ← DirectAdmin/cPanel/Plesk web interface
//   └──────────┬──────────┘
//              │ Calls
//              ▼
//   ┌─────────────────────┐
//   │  nftban-panelctl    │  ← Wrapper enforces registry RBAC
//   │  (Service Account)  │     - Validates command is panel_expose=true
//   └──────────┬──────────┘     - Checks nftban-panel group membership
//              │ Delegates       - Logs all actions
//              ▼                 - Returns JSON
//   ┌─────────────────────┐
//   │  systemctl reload   │  ← Polkit checks THIS FILE (30-nftban-panel.rules)
//   │  NFTBan Core        │     - Allows reload on core services
//   └─────────────────────┘     - Denies start/stop/restart
//
// Defense in Depth Layers:
//   1. Unix Groups: Service account must be in nftban-panel group
//   2. Polkit Rules: THIS FILE grants limited systemd access
//   3. nftban-panelctl: Wrapper validates registry RBAC (panel_expose=true)
//   4. Registry: commands.registry.yml defines panel-allowed commands
//   5. SELinux/AppArmor: (future) Mandatory Access Control
//
// Registry Integration:
// - commands.registry.yml defines which CLI commands panels can run
// - Commands with panel_expose=true are exposed to nftban-panelctl
// - Examples: status, health, list, report, stats
// - Blocked commands: ban, unban, sync, geoban, firewall
//
// Testing:
//   # As panel service account (nftban-da)
//   sudo -u nftban-da systemctl status nftband.service    # ✅ Should work
//   sudo -u nftban-da systemctl reload nftband.service    # ✅ Should work
//   sudo -u nftban-da systemctl restart nftband.service   # ❌ Should FAIL
//   sudo -u nftban-da systemctl stop nftband.service      # ❌ Should FAIL
//   sudo -u nftban-da systemctl status suricata.service       # ❌ Should FAIL (not allowlisted)
//
// Creating Service Accounts:
//   # DirectAdmin
//   sudo useradd -r -s /sbin/nologin -c "DirectAdmin NFTBan Integration" nftban-da
//   sudo usermod -a -G nftban-panel nftban-da
//
//   # cPanel/WHM
//   sudo useradd -r -s /sbin/nologin -c "cPanel NFTBan Integration" nftban-cp
//   sudo usermod -a -G nftban-panel nftban-cp
//
//   # Plesk
//   sudo useradd -r -s /sbin/nologin -c "Plesk NFTBan Integration" nftban-pl
//   sudo usermod -a -G nftban-panel nftban-pl
//
//   # Webmin
//   sudo useradd -r -s /sbin/nologin -c "Webmin NFTBan Integration" nftban-wm
//   sudo usermod -a -G nftban-panel nftban-wm
//
// Related Files:
// - 10-nftban-systemd.rules: Operator group (full access)
// - 20-nftban-auditor.rules: Auditor group (read-only)
// - nftban-panelctl: Wrapper binary (enforces registry RBAC)
// - commands.registry.yml: Defines panel_expose field
//
// Related Documentation:
// - Panel Integration Phase 1: Foundation (v1.0.19)
//
// =============================================================================

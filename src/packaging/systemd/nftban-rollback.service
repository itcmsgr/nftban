[Unit]
Description=NFTBan Rollback Check (Auto-Rollback if Not Confirmed)
Documentation=man:nftban(8) https://nftban.com/docs/recovery
After=nftables.service

[Service]
Type=oneshot
ExecStart=/usr/sbin/nftban-rollback
StandardOutput=journal
StandardError=journal

# Security hardening
ProtectSystem=strict
ReadWritePaths=/var/lib/nftban /var/log/nftban /run/nftban
PrivateTmp=yes
NoNewPrivileges=yes

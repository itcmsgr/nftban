                echo "timers"
                ;;
            services)
                echo "status"
                echo "--json"
                ;;
            mail)
                echo "test"
                echo "send"
                echo "spool"
                echo "status"
                echo "configure"
                echo "help"
                ;;
            queue)
                echo "status"
                echo "list"
                echo "process"
                echo "dlq"
                echo "metrics"
                echo "help"
                ;;
            cloudflare)
                echo "enable"
                echo "disable"
                echo "update"
                echo "status"
                echo "download"
                echo "help"
                ;;
            ddos)
                echo "enable"
                echo "disable"
                echo "status"
                echo "test"
                echo "help"
                ;;
            portscan)
                echo "enable"
                echo "disable"
                echo "status"
                echo "check"

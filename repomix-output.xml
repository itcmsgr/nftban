<file path="cli/lib/nftban/core/nftban_geoip_go.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - GO GeoIP Wrapper Module
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Wrapper for nftban-geoip GO binary
  7: #
  8: # meta:name=nftban_geoip_go
  9: # meta:type=core
 10: # meta:header=GO GeoIP Wrapper
 11: # meta:version=1.0.0
 12: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 13: # meta:homepage=https://nftban.com
 14: #
 15: # **Description & Purpose**
 16: # meta:description=Fast microsecond GeoIP lookups using GO binary with MaxMind GeoLite2
 17: # meta:input=IP addresses for geolocation lookup
 18: # meta:output=Country codes and geographic information
 19: #
 20: # **Inventory & Requirements**
 21: # meta:depends=nftban-geoip,GeoLite2-Country.mmdb
 22: #
 23: # meta:created_date=2025-11-05
 24: # meta:updated_date=2025-11-24
 25: # =============================================================================
 26: 
 27: # Enhanced strict mode
 28: IFS=$'\n\t'
 29: umask 027
 30: 
 31: # Prevent double-loading
 32: [[ -n "${NFTBAN_GEOIP_GO_LOADED:-}" ]] && return 0
 33: readonly NFTBAN_GEOIP_GO_LOADED=1
 34: 
 35: # =============================================================================
 36: # CONFIGURATION
 37: # =============================================================================
 38: readonly NFTBAN_GEOIP_BIN="${NFTBAN_GEOIP_BIN:-/usr/lib/nftban/bin/nftban-geoip}"
 39: readonly NFTBAN_GEOIP_TIMEOUT="${NFTBAN_GEOIP_TIMEOUT:-1}"  # seconds
 40: 
 41: # =============================================================================
 42: # CORE FUNCTIONS
 43: # =============================================================================
 44: 
 45: nftban_geoip_check_available() {
 46:     # Check if GO GeoIP binary is available
 47:     # Returns: 0 if available, 1 if not
 48: 
 49:     if [[ ! -x "$NFTBAN_GEOIP_BIN" ]]; then
 50:         return 1
 51:     fi
 52: 
 53:     # Check if database exists
 54:     if ! timeout "$NFTBAN_GEOIP_TIMEOUT" "$NFTBAN_GEOIP_BIN" status &>/dev/null; then
 55:         return 1
 56:     fi
 57: 
 58:     return 0
 59: }
 60: 
 61: nftban_geoip_lookup_fast() {
 62:     # Fast IP geolocation lookup using GO binary
 63:     # Args: $1 = IP address
 64:     # Returns: JSON with geo data
 65:     # Speed: 50-200 microseconds
 66: 
 67:     local ip="$1"
 68: 
 69:     if [[ -z "$ip" ]]; then
 70:         echo '{"error":"IP address required"}'
 71:         return 1
 72:     fi
 73: 
 74:     # Validate IP format (basic)
 75:     if [[ ! "$ip" =~ ^[0-9a-fA-F:.]+$ ]]; then
 76:         echo '{"error":"Invalid IP format"}'
 77:         return 1
 78:     fi
 79: 
 80:     # Call GO binary with timeout
 81:     local result
 82:     result=$(timeout "$NFTBAN_GEOIP_TIMEOUT" "$NFTBAN_GEOIP_BIN" lookup "$ip" 2>/dev/null)
 83: 
 84:     if [[ $? -eq 0 && -n "$result" ]]; then
 85:         echo "$result"
 86:         return 0
 87:     else
 88:         echo '{"error":"Lookup failed or timed out"}'
 89:         return 1
 90:     fi
 91: }
 92: 
 93: nftban_geoip_get_country() {
 94:     # Get country name from IP
 95:     # Args: $1 = IP address
 96:     # Returns: Country name or "Unknown"
 97: 
 98:     local ip="$1"
 99:     local json
100: 
101:     json=$(nftban_geoip_lookup_fast "$ip" 2>/dev/null)
102: 
103:     if command -v jq &>/dev/null; then
104:         echo "$json" | jq -r '.country // "Unknown"' 2>/dev/null || echo "Unknown"
105:     else
106:         # Fallback without jq
107:         echo "$json" | grep -o '"country":"[^"]*"' | cut -d'"' -f4 | head -1 || echo "Unknown"
108:     fi
109: }
110: 
111: nftban_geoip_get_country_code() {
112:     # Get country code from IP
113:     # Args: $1 = IP address
114:     # Returns: Country code (e.g., "US", "CN") or "??"
115: 
116:     local ip="$1"
117:     local json
118: 
119:     json=$(nftban_geoip_lookup_fast "$ip" 2>/dev/null)
120: 
121:     if command -v jq &>/dev/null; then
122:         echo "$json" | jq -r '.country_code // "??"' 2>/dev/null || echo "??"
123:     else
124:         # Fallback without jq
125:         echo "$json" | grep -o '"country_code":"[^"]*"' | cut -d'"' -f4 | head -1 || echo "??"
126:     fi
127: }
128: 
129: nftban_geoip_get_city() {
130:     # Get city name from IP
131:     # Args: $1 = IP address
132:     # Returns: City name or "Unknown"
133: 
134:     local ip="$1"
135:     local json
136: 
137:     json=$(nftban_geoip_lookup_fast "$ip" 2>/dev/null)
138: 
139:     if command -v jq &>/dev/null; then
140:         echo "$json" | jq -r '.city // "Unknown"' 2>/dev/null || echo "Unknown"
141:     else
142:         # Fallback without jq
143:         echo "$json" | grep -o '"city":"[^"]*"' | cut -d'"' -f4 | head -1 || echo "Unknown"
144:     fi
145: }
146: 
147: nftban_geoip_get_compact() {
148:     # Get compact geo info: Country/City
149:     # Args: $1 = IP address
150:     # Returns: "Country/City" with spaces replaced by underscores
151: 
152:     local ip="$1"
153:     local json
154: 
155:     json=$(nftban_geoip_lookup_fast "$ip" 2>/dev/null)
156: 
157:     local country city
158: 
159:     if command -v jq &>/dev/null; then
160:         country=$(echo "$json" | jq -r '.country // "Unknown"' 2>/dev/null || echo "Unknown")
161:         city=$(echo "$json" | jq -r '.city // "Unknown"' 2>/dev/null || echo "Unknown")
162:     else
163:         # Fallback without jq
164:         country=$(echo "$json" | grep -o '"country":"[^"]*"' | cut -d'"' -f4 | head -1 || echo "Unknown")
165:         city=$(echo "$json" | grep -o '"city":"[^"]*"' | cut -d'"' -f4 | head -1 || echo "Unknown")
166:     fi
167: 
168:     echo "${country}/${city}" | tr ' ' '_'
169: }
170: 
171: nftban_geoip_get_compact_full() {
172:     # Get full compact geo info: CountryCode/City/Timezone
173:     # Args: $1 = IP address
174:     # Returns: "CC/City/Timezone" with spaces replaced by underscores
175: 
176:     local ip="$1"
177:     local json
178: 
179:     json=$(nftban_geoip_lookup_fast "$ip" 2>/dev/null)
180: 
181:     local country_code city timezone
182: 
183:     if command -v jq &>/dev/null; then
184:         country_code=$(echo "$json" | jq -r '.country_code // "??"' 2>/dev/null || echo "??")
185:         city=$(echo "$json" | jq -r '.city // "Unknown"' 2>/dev/null || echo "Unknown")
186:         timezone=$(echo "$json" | jq -r '.timezone // ""' 2>/dev/null || echo "")
187:     else
188:         # Fallback without jq
189:         country_code=$(echo "$json" | grep -o '"country_code":"[^"]*"' | cut -d'"' -f4 | head -1 || echo "??")
190:         city=$(echo "$json" | grep -o '"city":"[^"]*"' | cut -d'"' -f4 | head -1 || echo "Unknown")
191:         timezone=$(echo "$json" | grep -o '"timezone":"[^"]*"' | cut -d'"' -f4 | head -1 || echo "")
192:     fi
193: 
194:     if [[ -n "$timezone" ]]; then
195:         echo "${country_code}/${city}/${timezone}" | tr ' ' '_'
196:     else
197:         echo "${country_code}/${city}" | tr ' ' '_'
198:     fi
199: }
200: 
201: nftban_geoip_bulk_lookup() {
202:     # Bulk lookup from file or stdin
203:     # Args: $1 = input file (optional, uses stdin if not provided)
204:     # Returns: JSONL output (one JSON per line)
205: 
206:     local input_file="${1:-}"
207: 
208:     if [[ -n "$input_file" && -f "$input_file" ]]; then
209:         timeout "$NFTBAN_GEOIP_TIMEOUT" "$NFTBAN_GEOIP_BIN" bulk < "$input_file" 2>/dev/null
210:     else
211:         timeout "$NFTBAN_GEOIP_TIMEOUT" "$NFTBAN_GEOIP_BIN" bulk 2>/dev/null
212:     fi
213: }
214: 
215: nftban_geoip_status() {
216:     # Get GeoIP system status
217:     # Returns: JSON with status info
218: 
219:     timeout "$NFTBAN_GEOIP_TIMEOUT" "$NFTBAN_GEOIP_BIN" status 2>/dev/null || echo '{"status":"error","message":"GeoIP binary not available"}'
220: }
221: 
222: # =============================================================================
223: # UTILITY FUNCTIONS
224: # =============================================================================
225: 
226: nftban_geoip_format_for_log() {
227:     # Format geo data for log entry: [CC/City]
228:     # Args: $1 = IP address
229:     # Returns: "[CC/City]" or "[??/Unknown]" if lookup fails
230: 
231:     local ip="$1"
232:     local compact
233: 
234:     compact=$(nftban_geoip_get_compact_full "$ip" 2>/dev/null)
235: 
236:     if [[ -n "$compact" && "$compact" != "Unknown/Unknown" ]]; then
237:         echo "[$compact]"
238:     else
239:         echo "[??/Unknown]"
240:     fi
241: }
242: 
243: nftban_geoip_is_local_ip() {
244:     # Check if IP is local/private
245:     # Args: $1 = IP address
246:     # Returns: 0 if local, 1 if public
247: 
248:     local ip="$1"
249: 
250:     # Check for private IPv4 ranges
251:     if [[ "$ip" =~ ^10\. ]] || \
252:        [[ "$ip" =~ ^172\.(1[6-9]|2[0-9]|3[01])\. ]] || \
253:        [[ "$ip" =~ ^192\.168\. ]] || \
254:        [[ "$ip" =~ ^127\. ]] || \
255:        [[ "$ip" =~ ^169\.254\. ]]; then
256:         return 0
257:     fi
258: 
259:     # Check for private IPv6 ranges
260:     if [[ "$ip" =~ ^fe80: ]] || \
261:        [[ "$ip" =~ ^fc00: ]] || \
262:        [[ "$ip" =~ ^fd00: ]] || \
263:        [[ "$ip" == "::1" ]]; then
264:         return 0
265:     fi
266: 
267:     return 1
268: }
269: 
270: # =============================================================================
271: # EXPORTS
272: # =============================================================================
273: 
274: # Export functions for use by other modules
275: export -f nftban_geoip_check_available
276: export -f nftban_geoip_lookup_fast
277: export -f nftban_geoip_get_country
278: export -f nftban_geoip_get_country_code
279: export -f nftban_geoip_get_city
280: export -f nftban_geoip_get_compact
281: export -f nftban_geoip_get_compact_full
282: export -f nftban_geoip_bulk_lookup
283: export -f nftban_geoip_status
284: export -f nftban_geoip_format_for_log
285: export -f nftban_geoip_is_local_ip
286: 
287: # Log module load
288: if declare -f nftban_log_debug >/dev/null 2>&1; then
289:     nftban_log_debug "GO GeoIP wrapper module loaded (fast microsecond lookups)"
290: fi
</file>


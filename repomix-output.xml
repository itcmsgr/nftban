  65: # shellcheck source=/usr/lib/nftban/lib/nft_schema.sh
  66: if [[ -f "${NFTBAN_LIB_DIR:-/usr/lib/nftban}/lib/nft_schema.sh" ]]; then
  67:     source "${NFTBAN_LIB_DIR:-/usr/lib/nftban}/lib/nft_schema.sh"

{
  "schema_version": "2.1",
  "description": "NFTBan v2.1 - Directional Stateful Architecture with CIDR aggregation",

  "modules": {
    "description": "Modules are DISABLED by default. When disabled, they are NOT loaded (zero overhead).",
    "available": {
      "ddos": {
        "default": "disabled",
        "config": "/etc/nftban/conf.d/ddos/classic.conf",
        "override": "/etc/nftban/conf.d/ddos/classic.conf.local",
        "enable": "nftban ddos enable",
        "provides": ["ct_limits", "syn_rate_limit", "icmp_rate_limit"]
      },
      "portscan": {
        "default": "disabled",
        "config": "/etc/nftban/conf.d/portscan/portscan.conf",
        "override": "/etc/nftban/conf.d/portscan/portscan.conf.local",
        "enable": "nftban portscan enable",
        "provides": ["portscan_detection", "auto_ban"]
      },
      "feeds": {
        "default": "disabled",
        "config": "/etc/nftban/conf.d/feeds/feeds.conf",
        "override": "/etc/nftban/conf.d/feeds/feeds.conf.local",
        "enable": "nftban feeds enable",
        "provides": ["threat_intelligence", "auto_update"],
        "target_set": "blacklist_{family}"
      },
      "geoban": {
        "default": "disabled",
        "config": "/etc/nftban/conf.d/geoban/geoban.conf",
        "override": "/etc/nftban/conf.d/geoban/geoban.conf.local",
        "enable": "nftban geoban enable",
        "provides": ["country_blocking"],
        "target_set": "blacklist_{family}"
      },
      "login": {
        "default": "disabled",
        "config": "/etc/nftban/conf.d/login/login.conf",
        "override": "/etc/nftban/conf.d/login/login.conf.local",
        "enable": "nftban login enable",
        "provides": ["ssh_brute_force", "pam_integration"],
        "target_set": "blacklist_{family}"
      }
    },
    "config_hierarchy": [
      "Module config: /etc/nftban/conf.d/<module>/<module>.conf (defaults)",
      "User override: /etc/nftban/conf.d/<module>/<module>.conf.local (survives upgrades)"
    ]
  },

  "nftables": {
    "tables": {
      "ip nftban": {
        "family": "ip",
        "sets": {
          "whitelist_ipv4": {
            "type": "ipv4_addr",
            "flags": ["interval"],
            "description": "Permanent trusted IPv4 addresses"
          },
          "blacklist_ipv4": {
            "type": "ipv4_addr",
            "flags": ["interval", "timeout"],
            "description": "All banned IPv4 addresses (manual + feeds + geoip + temp bans)"
          },
          "tcp_ports_in": {
            "type": "inet_service",
            "flags": [],
            "description": "Allowed inbound TCP service ports (INPUT chain)"
          },
          "tcp_ports_out": {
            "type": "inet_service",
            "flags": [],
            "description": "Allowed outbound TCP service ports (OUTPUT chain)"
          },
          "udp_ports_in": {
            "type": "inet_service",
            "flags": [],
            "description": "Allowed inbound UDP service ports (INPUT chain)"
          },
          "udp_ports_out": {
            "type": "inet_service",
            "flags": [],
            "description": "Allowed outbound UDP service ports (OUTPUT chain)"
          }
        },
        "chains": {
          "input": {
            "type": "filter",
            "hook": "input",
            "priority": 0,
            "policy": "drop",
            "rule_order": [
              "ct_invalid_drop",
              "loopback_accept",
              "whitelist_accept",
              "blacklist_drop",
              "ct_established_accept",
              "icmp_allow",
              "ct_limits",
              "tcp_in_allow",
              "udp_in_allow",
              "default_drop"
            ]
          },
          "forward": {
            "type": "filter",
            "hook": "forward",
            "priority": 0,
            "policy": "drop"
          },
          "output": {
            "type": "filter",
            "hook": "output",
            "priority": 0,
            "policy": "accept",
            "optional_enforcement": ["tcp_ports_out", "udp_ports_out"]
          }
        }
      },

      "ip6 nftban": {
        "family": "ip6",
        "sets": {
          "whitelist_ipv6": {
            "type": "ipv6_addr",
            "flags": ["interval"],
            "description": "Permanent trusted IPv6 addresses"
          },
          "blacklist_ipv6": {
            "type": "ipv6_addr",
            "flags": ["interval", "timeout"],
            "description": "All banned IPv6 addresses (manual + feeds + geoip + temp bans)"
          },
          "tcp_ports_in": {
            "type": "inet_service",
            "flags": [],
            "description": "Allowed inbound TCP service ports (INPUT chain)"
          },
          "tcp_ports_out": {
            "type": "inet_service",
            "flags": [],
            "description": "Allowed outbound TCP service ports (OUTPUT chain)"
          },
          "udp_ports_in": {
            "type": "inet_service",
            "flags": [],
            "description": "Allowed inbound UDP service ports (INPUT chain)"
          },
          "udp_ports_out": {
            "type": "inet_service",
            "flags": [],
            "description": "Allowed outbound UDP service ports (OUTPUT chain)"
          }
        },
        "chains": {
          "input": {
            "type": "filter",
            "hook": "input",
            "priority": 0,
            "policy": "drop",
            "rule_order": [
              "ct_invalid_drop",
              "loopback_accept",
              "whitelist_accept",
              "blacklist_drop",
              "ct_established_accept",
              "icmpv6_allow_nd",
              "ct_limits",
              "tcp_in_allow",
              "udp_in_allow",
              "default_drop"
            ]
          },
          "forward": {
            "type": "filter",
            "hook": "forward",
            "priority": 0,
            "policy": "drop"
          },
          "output": {
            "type": "filter",
            "hook": "output",
            "priority": 0,
            "policy": "accept",
            "optional_enforcement": ["tcp_ports_out", "udp_ports_out"]
          }
        }
      }
    },

    "ban_pipeline": {
      "all_bans_target_set": "blacklist_{family}",
      "sources": {
        "manual": { "target": "blacklist_{family}", "timeout_supported": true },
        "feeds": { "target": "blacklist_{family}", "timeout_supported": false },
        "geoip": { "target": "blacklist_{family}", "timeout_supported": false },
        "temp": { "target": "blacklist_{family}", "timeout_supported": true }
      }
    },

    "connection_limits": {
      "enabled": true,
      "mode": "ct_count",
      "default_threshold": 100,
      "applies_to": ["ip nftban:input", "ip6 nftban:input"],
      "configurable_via": "ddos.conf",
      "note": "Connection limits remain chain rules (not sets). Whitelisted IPs bypass all limits."
    },

    "directional_ports": {
      "enabled": true,
      "sets": ["tcp_ports_in", "tcp_ports_out", "udp_ports_in", "udp_ports_out"],
      "directions": ["in", "out", "inout"]
    },

    "icmp_policy": {
      "ipv4": "essential_only",
      "ipv6": "essential_plus_neighbor_discovery"
    }
  }
}

 479: nftban_nft_validate_chains() {
 480:     # Validate chains exist with correct type/hook/priority/policy
 481:     # Returns: 0 if valid, 1 if invalid
 482: 
 483:     local status=0
 484:     local chain_name chain_spec chain_type chain_hook chain_priority chain_policy
 485:     local actual_type actual_hook actual_policy
 486: 
 487:     # Validate IPv4 chains
 488:         # shellcheck disable=SC2034  # Structured read - only some fields validated
 489:     for chain_name in "${!NFTBAN_IPV4_CHAINS[@]}"; do
 490:         chain_spec="${NFTBAN_IPV4_CHAINS[$chain_name]}"
 491:         IFS='|' read -r chain_type chain_hook chain_priority chain_policy _ <<< "$chain_spec"
 492: 
 493:         # Check if chain exists
 494:         if ! nft list chain ip nftban "$chain_name" &>/dev/null; then
 495:             echo "ERROR: Missing chain in ip nftban: $chain_name" >&2
 496:             status=1
 497:             continue
 498:         fi
 499: 
 500:         # Get actual chain properties
 501:         local chain_info
 502:         chain_info=$(nft list chain ip nftban "$chain_name" 2>/dev/null | head -3)
 503: 
 504:         # Check policy
 505:         actual_policy=$(echo "$chain_info" | grep -oP 'policy \K[a-z]+' || echo "")
 506:         if [[ -n "$actual_policy" && "$actual_policy" != "$chain_policy" ]]; then
 507:             echo "ERROR: Wrong policy on ip nftban $chain_name: expected '$chain_policy', got '$actual_policy'" >&2
 508:             status=1
 509:         fi
 510:     done
 511: 
 512:     # Validate IPv6 chains (warning only)
 513:     for chain_name in "${!NFTBAN_IPV6_CHAINS[@]}"; do
 514:         if ! nft list chain ip6 nftban "$chain_name" &>/dev/null; then
 515:             echo "WARNING: Missing chain in ip6 nftban: $chain_name" >&2
 516:         fi
 517:     done
 518: 
 519:     return $status
 520: }

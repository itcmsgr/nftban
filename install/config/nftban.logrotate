# NFTBan Log Rotation Configuration
# Install to: /etc/logrotate.d/nftban
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │ SHIPPED BASELINE POLICY.                                                  │
# │ On a host with the capacity-derived retention feature active, this file  │
# │ is REGENERATED as the effective policy (see `nftban logs retention       │
# │ status`); operators must NOT hand-edit it — overrides live in            │
# │ /etc/nftban/conf.d/logs.conf. This baseline is the conservative fallback │
# │ applied at install and if generation fails: it is bounded (every stanza  │
# │ has a size trigger) but not capacity-tailored.                           │
# └─────────────────────────────────────────────────────────────────────────┘
#
# Rotates (this file enumerates EXACT paths, not a *.log wildcard — every
# nftban-owned log must be listed in an explicit stanza below or it is NOT
# rotated; the logs.go LogInventory() + drift-test is the bridge that proves
# every inventoried /var/log/nftban log is covered here):
# - Enumerated /var/log/nftban/*.log files (see stanzas below; frequencies vary)
# - One /var/log/nftban/permissions_audit.log audit log (weekly, 12)
# - /var/log/nftban/reports/* (monthly, 3 months)  [v1.228.5: moved from /var/lib]
# - Suricata logs (handled separately, /etc/logrotate.d/nftban-suricata)
#
# NOTE: there is intentionally no catch-all `/var/log/nftban/*.log` safety
# stanza (it would double-rotate the exact-path stanzas and silently mask a
# missing inventory entry). Add new logs as explicit stanzas + a logs.go entry.
#
# Policy (Gate B — disk-safety):
# - Every stanza carries a `size`/`maxsize` trigger so no log can grow unbounded
#   between cadence runs (UNBOUNDED_STANZAS = 0).
# - `delaycompress` is used ONLY where a writer may still hold the rotated-away
#   inode for one cycle (rename+create writers: bans.log; Suricata eve-* via
#   USR2). copytruncate stanzas do NOT use delaycompress — the rotated copy is a
#   static snapshot and is compressed immediately (removing the prior waste of a
#   permanently-uncompressed active + .1 pair on the high-volume 100M logs).
# - copytruncate is retained for plaintext shell appenders and held-fd daemon
#   writers (their reader/writer contract is not yet migration-tested; tracked as
#   OPEN_COPYTRUNCATE_SAFE_PLAINTEXT_MIGRATION). Only the record-corruption cases
#   (Suricata eve-alerts/eve-audit JSON) and the metrics source-of-truth
#   (bans.log) move to rename+create in this release.

# Main application logs
# copytruncate retained here conservatively: nftban.log/login-monitor.log/
# service-alerts.log have multiple plaintext appenders (each opens-appends-closes
# per message, so they are technically rename+create-safe, but the full
# reader/writer contract is not yet migration-tested — see
# OPEN_COPYTRUNCATE_SAFE_PLAINTEXT_MIGRATION). Truncate-in-place keeps every
# writer on the live inode with no reload.
/var/log/nftban/nftban.log
/var/log/nftban/login-monitor.log
/var/log/nftban/service-alerts.log {
    weekly
    rotate 4
    size 50M
    compress
    missingok
    notifempty
    copytruncate
    create 0640 nftban nftban
}

# =============================================================================
# Ban Activity Log - CRITICAL for metrics and audit trail
# =============================================================================
# bans.log is the SINGLE SOURCE OF TRUTH for ban activity history.
# Used by: nftban_unified_exporter.sh, nftban_stats.sh
# Format: DATE|TIME|SOURCE|IP|COUNTRY|STATUS|REASON|BAN_ID|TIMEOUT|CLASS
#
# Gate B: rename+create (NOT copytruncate). The Go writer (internal/banlog)
# opens O_APPEND and closes per entry under a mutex, so it re-resolves the path
# on the next entry and lands in the freshly-created file — copytruncate's
# copy→truncate loss window (a dropped line = a lost ban metric) is eliminated.
# `delaycompress` is kept because a rename can momentarily precede the writer's
# next open; the .1 stays uncompressed for one cycle so no in-flight entry is
# compressed away. All readers use path-following (tail -F, or whole-file re-read).
/var/log/nftban/bans.log {
    weekly
    rotate 12
    size 10M
    compress
    delaycompress
    missingok
    notifempty
    create 0640 nftban nftban
}

# Mail, queue, and maintenance logs - bash scripts appending via >>
# copytruncate: safe for transient appenders, no reload needed
/var/log/nftban/mail.log
/var/log/nftban/queue.log
/var/log/nftban/maintenance.log {
    weekly
    rotate 4
    size 20M
    compress
    missingok
    notifempty
    copytruncate
    create 0640 nftban nftban
}

# =============================================================================
# Module-specific logs (DDoS, Login, Portscan, Trust)
# =============================================================================
# These can grow rapidly during attacks - daily rotation with size trigger.
# copytruncate for bash appenders; no delaycompress (snapshot compresses now).
/var/log/nftban/ddos.log
/var/log/nftban/ddos-classic.log
/var/log/nftban/ddos-suricata.log
/var/log/nftban/login-suricata.log
/var/log/nftban/portscan.log
/var/log/nftban/portscan-suricata.log
/var/log/nftban/portscan-classic.log
/var/log/nftban/trust.log {
    daily
    rotate 30
    size 100M
    compress
    missingok
    notifempty
    copytruncate
    create 0640 nftban nftban
}

# =============================================================================
# Additional module logs (Feeds, GeoBan, Botscan, etc.)
# =============================================================================
/var/log/nftban/feeds.log
/var/log/nftban/geoban.log
/var/log/nftban/botscan.log
/var/log/nftban/login_alert.log
/var/log/nftban/cron.log
/var/log/nftban/soak/cron.log
/var/log/nftban/rbl.log {
    weekly
    rotate 12
    size 50M
    compress
    missingok
    notifempty
    copytruncate
    create 0640 nftban nftban
}

# =============================================================================
# Security audit log (v1.150 — LOG-01)
# =============================================================================
# Writer: nftban_path_security.sh appends path-security audit events (per-msg).
/var/log/nftban/security-audit.log {
    weekly
    rotate 12
    size 20M
    compress
    missingok
    notifempty
    copytruncate
    create 0640 nftban nftban
}

# =============================================================================
# Portscan events log (v1.150 — LOG-02)
# =============================================================================
# Writer: nftban_portscan_classic.sh appends per-event scan records. High volume
# during an active scan — daily + size cap.
/var/log/nftban/portscan-events.log {
    daily
    rotate 30
    size 100M
    compress
    missingok
    notifempty
    copytruncate
    create 0640 nftban nftban
}

# =============================================================================
# Suricata logs — MOVED to /etc/logrotate.d/nftban-suricata
# =============================================================================
# Suricata log rotation is in a separate file to avoid breaking logrotate
# when Suricata is not installed (user 'suricata' doesn't exist).
# File: /etc/logrotate.d/nftban-suricata (installed by nftban suricata setup)

# =============================================================================
# Tunnel Suspicion logs (v1.30.0 — DNS tunnel detection)
# =============================================================================
# Advisory-only module; logs suspicion scores and scan results
/var/log/nftban/tunnel.log {
    weekly
    rotate 12
    size 20M
    compress
    missingok
    notifempty
    copytruncate
    create 0640 nftban nftban
}

# =============================================================================
# Bot Guard logs (v1.20.0 — HTTP crawler detection)
# =============================================================================
# Bot Guard Go daemon holds these fds open for its lifetime with no reopen
# handler → copytruncate is mandatory (rename+create would strand the daemon on
# the rotated-away inode). Migrating this requires a daemon Reopen()+signal path
# (tracked separately, not in this release).
# ⛔ v1.229.3 P1-1: these paths previously named a `botguard/` SUBDIRECTORY that no
# writer ever used. internal/botguard/guard.go:62-66 returns
# `cfg.LogDir + "/botguard.log"`, and guard.go:194 takes filepath.Dir() of it, so
# NewLogger writes /var/log/nftban/botguard.log and /var/log/nftban/decisions.log at
# the TOP LEVEL. No stanza matched either file, leaving two held-fd logs unbounded.
#
# The stanza is aligned to the writer rather than the writer to the stanza: moving the
# writer would orphan the operator's existing top-level logs, and no migration for them
# exists in this release.
/var/log/nftban/botguard.log
/var/log/nftban/decisions.log {
    daily
    rotate 30
    size 100M
    compress
    missingok
    notifempty
    copytruncate
    create 0640 nftban nftban
}

# =============================================================================
# Watchdog subdirectory logs (alerts, stats, profiles)
# =============================================================================
/var/log/nftban/watchdog/alerts.log
/var/log/nftban/watchdog/stats.log
/var/log/nftban/watchdog/profiles.log {
    weekly
    rotate 4
    size 20M
    compress
    missingok
    notifempty
    copytruncate
    create 0640 nftban nftban
}

# =============================================================================
# Audit trail logs (actions + PAM audit)
# =============================================================================
# JSON-structured audit entries — ban/unban/config/whitelist actions + PAM events.
# logrotate is the SINGLE rotation authority for these files (the historical
# in-code rotator nftban_audit_rotate was dead code and has been retired — Gate B).
# Writer opens-appends-closes per message; copytruncate retained pending the
# plaintext/JSONL migration (OPEN_COPYTRUNCATE_SAFE_PLAINTEXT_MIGRATION).
/var/log/nftban/nftban-actions.log
/var/log/nftban/audit.log {
    daily
    rotate 90
    size 50M
    compress
    missingok
    notifempty
    copytruncate
    create 0640 nftban nftban
}

# =============================================================================
# Health & diagnostic logs (v1.44.0 — quality tracking)
# =============================================================================
# debug_trace.log can be large — now bounded by the size trigger.
/var/log/nftban/health-incidents.log
/var/log/nftban/cli-errors.log
/var/log/nftban/debug_trace.log
/var/log/nftban/watchdog.log {
    weekly
    rotate 12
    size 50M
    compress
    missingok
    notifempty
    copytruncate
    create 0640 nftban nftban
}

# =============================================================================
# Suricata Events Log (v1.46.0 — nftban's own suricata event processing log)
# =============================================================================
# NFTBan's Go suricata daemon holds this fd open for its lifetime with no reopen
# handler → copytruncate is mandatory (same constraint as botguard).
/var/log/nftban/suricata-events.log {
    daily
    rotate 30
    size 100M
    compress
    missingok
    notifempty
    copytruncate
    create 0640 nftban nftban
}

# =============================================================================
# Installer + update lifecycle logs (v1.137 — B-09)
# =============================================================================
# Short-lived processes (nftban-installer, `nftban update`). The Go installer
# logger holds a single fd for the process lifetime (append-then-exit) →
# copytruncate is the safe choice.
/var/log/nftban/installer.log
/var/log/nftban/update.log {
    weekly
    rotate 8
    size 20M
    compress
    missingok
    notifempty
    copytruncate
    create 0640 nftban nftban
}

# =============================================================================
# Permissions audit log (v1.150 — LOG-11)
# =============================================================================
# Under /var/lib (the data dir), NOT /var/log — its own explicit stanza.
/var/log/nftban/permissions_audit.log
/var/log/nftban/permissions_audit.log.pre-v1.228.5 {
    weekly
    rotate 12
    size 10M
    compress
    missingok
    notifempty
    copytruncate
    create 0640 nftban nftban
}

# Generated reports - monthly rotation, keep 3 months.
# Report files are written whole (not appended) so they are bounded per file by
# their generator; `maxsize` is a backstop against a pathologically large report.
/var/log/nftban/reports/*.html /var/log/nftban/reports/*.txt /var/log/nftban/reports/*.json {
    monthly
    rotate 3
    maxsize 50M
    compress
    missingok
    notifempty
    olddir /var/log/nftban/reports/archive
    createolddir 0750 nftban nftban
}

# Daily reports subdirectory
/var/log/nftban/reports/daily/*.html /var/log/nftban/reports/daily/*.txt /var/log/nftban/reports/daily/*.json {
    monthly
    rotate 3
    maxsize 20M
    compress
    missingok
    notifempty
}

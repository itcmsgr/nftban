279:     echo "✅ NFTBan ENABLED - Your Server is Now Protected!"
280:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
281:     echo ""

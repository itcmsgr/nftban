  62: // GetOrCreateTable gets or creates the nftban table
  63: // Uses caching to avoid repeated ListTables() calls for performance
  64: func (m *NFTManager) GetOrCreateTable(family nftables.TableFamily) (*nftables.Table, error) {
  65: 	// Check cache first
  66: 	if cached, ok := m.cachedTables[family]; ok {
  67: 		return cached, nil
  68: 	}
  69: 
  70: 	// Try to get existing table
  71: 	tables, err := m.conn.ListTables()
  72: 	if err != nil {
  73: 		return nil, fmt.Errorf("failed to list tables: %w", err)
  74: 	}
  75: 
  76: 	for _, table := range tables {
  77: 		if table.Name == "nftban" && table.Family == family {
  78: 			m.cachedTables[family] = table // Cache it
  79: 			return table, nil
  80: 		}
  81: 	}
  82: 
  83: 	// Create new table
  84: 	table := m.conn.AddTable(&nftables.Table{
  85: 		Family: family,
  86: 		Name:   "nftban",
  87: 	})
  88: 
  89: 	if err := m.conn.Flush(); err != nil {
  90: 		return nil, fmt.Errorf("failed to create table: %w", err)
  91: 	}
  92: 
  93: 	m.cachedTables[family] = table // Cache newly created table
  94: 	return table, nil
  95: }

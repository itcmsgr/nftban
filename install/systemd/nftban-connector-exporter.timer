# =============================================================================
# NFTBan v1.3.0 - Connector Exporter Timer
# =============================================================================
# SPDX-License-Identifier: MPL-2.0
# Purpose: Periodic execution of NFTBan connector export (ES, Kafka, file)
#
# DEPRECATED: Use nftban-unified-exporter.timer instead
# =============================================================
# This timer is maintained for backward compatibility only.
# The unified exporter provides single metric collection for
# Prometheus + Zabbix + Connectors with 66% less overhead.
#
# Migration: systemctl disable nftban-connector-exporter.timer
#            systemctl enable nftban-unified-exporter.timer
# =============================================================
#
# meta:name="nftban-connector-exporter.timer"
# meta:type="systemd"
# meta:header="Connector Exporter Timer"
# meta:version="1.3.0"
# meta:owner="Antonios Voulvoulis <contact@nftban.com>"
# meta:homepage="https://nftban.com"
#
# meta:description="Timer that triggers NFTBan connector export at configured interval"
# meta:inventory.files=""
# meta:inventory.binaries=""
# meta:inventory.env_vars=""
# meta:inventory.config_files="/etc/nftban/nftban.conf"
# meta:inventory.systemd_units="nftban-connector-exporter.service"
# meta:inventory.network=""
# meta:inventory.privileges="none"
#
# meta:created_date="2026-01-22"
# meta:updated_date="2026-01-22"
# =============================================================================

[Unit]
Description=NFTBan Connector Exporter Timer
Documentation=https://nftban.com/docs/connectors
Requires=nftban-connector-exporter.service
After=nftban.service

[Timer]
# STAGGERED: Different offset from other exporters (75s boot)
OnBootSec=75s
OnUnitActiveSec=60s

# CRITICAL: Catch up missed exports after downtime
Persistent=true

# Allow systemd batching
AccuracySec=10s

# SMART JITTER: 50% variance, deterministic per host
RandomizedDelaySec=30s
FixedRandomDelay=true

[Install]
WantedBy=timers.target

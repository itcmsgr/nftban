// =============================================================================
// NFTBan Port Status - Polkit Authorization Rule (TEMPLATE)
// =============================================================================
// SPDX-License-Identifier: MPL-2.0
// Purpose: Allow nftban user to run nftban CLI via pkexec as root
//
// THIS IS A TEMPLATE FILE - DO NOT INSTALL DIRECTLY
// The @NFTBAN_BIN@ placeholder is replaced at install time with the
// value from /etc/nftban/nftban.conf
//
// Install generates: /etc/polkit-1/rules.d/50-nftban-port-status.rules
// =============================================================================

polkit.addRule(function(action, subject) {
    // Allow nftban user to run nftban CLI via pkexec as root
    // Path is replaced at install time from NFTBAN_BIN in nftban.conf
    if (action.id == "org.freedesktop.policykit.exec" &&
        action.lookup("polkit.exec.path") == "@NFTBAN_BIN@" &&
        subject.user == "nftban") {

        // No authentication, run as root
        return polkit.Result.YES;
    }
});

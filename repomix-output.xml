152:                 // Toggle DDoS protection
153:                 async function toggleDdos() {
154:                     const toggle = document.getElementById('ddos-toggle');
155:                     const msgEl = document.getElementById('ddos-msg');
156:                     const statusEl = document.getElementById('ddos-toggle-status');
157:                     const isEnabled = toggle.checked;
158: 
159:                     // Disable toggle during operation
160:                     toggle.disabled = true;
161: 
162:                     try {
163:                         const endpoint = isEnabled ? '/api/v1/ddos/enable' : '/api/v1/ddos/disable';
164:                         const response = await fetch(endpoint, {
165:                             method: 'POST',
166:                             headers: getAuthHeaders()
167:                         });
168:                         const result = await response.json();
169: 
170:                         if (response.ok && result.success) {
171:                             msgEl.className = 'bg-green-100 text-green-800 p-15 rad-6 mt-15';
172:                             msgEl.textContent = isEnabled ? '✅ DDoS protection enabled successfully' : '✅ DDoS protection disabled successfully';
173:                             msgEl.classList.remove('hidden');
174: 
175:                             // Update status text
176:                             statusEl.textContent = isEnabled ? 'Enabled - Protection active' : 'Disabled';
177: 
178:                             // Refresh stats
179:                             await loadDdosStats();
180:                         } else {
181:                             // Revert toggle on error
182:                             toggle.checked = !isEnabled;
183:                             msgEl.className = 'bg-red-100 text-red-800 p-15 rad-6 mt-15';
184:                             msgEl.textContent = '❌ Failed: ' + (result.error || 'Unknown error');
185:                             msgEl.classList.remove('hidden');
186:                         }
187:                     } catch (err) {
188:                         // Revert toggle on error
189:                         toggle.checked = !isEnabled;
190:                         msgEl.className = 'bg-red-100 text-red-800 p-15 rad-6 mt-15';
191:                         msgEl.textContent = '❌ Error: ' + err.message;
192:                         msgEl.classList.remove('hidden');
193:                     } finally {
194:                         // Re-enable toggle
195:                         toggle.disabled = false;
196:                     }
197:                 }

# Purpose: Pre-removal cleanup for DEB packages
# =============================================================================

set -e

case "$1" in
    remove|deconfigure)
        # Stop services
        deb-systemd-invoke stop nftban.timer || true
        deb-systemd-invoke stop nftban-health.timer || true
        ;;
esac

#DEBHELPER#

exit 0

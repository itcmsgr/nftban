194: # =============================================================================
195: # DYNAMIC DISCOVERY PATTERN (DO NOT MODIFY)
196: # =============================================================================
197: # The system automatically discovers feeds by scanning for:
198: #   FEED_*_URL
199: #
200: # For each discovered feed, the system expects:
201: #   FEED_<name>_ENABLED       (required, default: false)
202: #   FEED_<name>_CATEGORY      (required, default: "other")
203: #   FEED_<name>_DESCRIPTION   (required, default: "No description")
204: #   FEED_<name>_INTERVAL      (optional, default: DAILY)
205: #   FEED_<name>_SIZE          (optional, for display only)
206: #
207: # To add a new feed:
208: # 1. Add FEED_<name>_URL with the feed URL
209: # 2. Add FEED_<name>_ENABLED="false"  (MUST be false for safety!)
210: # 3. Add FEED_<name>_CATEGORY="protection|ssh|web|email"
211: # 4. Add FEED_<name>_DESCRIPTION="Description here"
212: # 5. Add FEED_<name>_INTERVAL="HOURLY|DAILY|WEEKLY" (optional)
213: # 6. Add FEED_<name>_SIZE="~X IPs" (optional, for display)
214: #
215: # The system will automatically discover your new feed!
216: # =============================================================================
217: 
218: # =============================================================================
219: # USAGE INSTRUCTIONS
220: # =============================================================================
221: #
222: # INTERACTIVE SELECTION (RECOMMENDED):
223: #   sudo nftban feeds select
224: #   → Shows beautiful numbered menu
225: #   → Select by number, range, or category
226: #
227: # ENABLE SPECIFIC FEED:
228: #   sudo nftban feeds enable SPAMHAUS_DROP
229: #
230: # ENABLE CATEGORY:
231: #   sudo nftban feeds enable-category ssh
232: #
233: # LIST ALL FEEDS:
234: #   nftban feeds list
235: #
236: # UPDATE ENABLED FEEDS:
237: #   sudo nftban feeds update
238: #
239: # TROUBLESHOOTING:
240: #   tail -f /var/log/nftban/feeds.log
241: #   nftban feeds status
242: #
243: # =============================================================================
</file>

<file path="install/config/nftban.conf">
  1: # =============================================================================
  2: # NFTBan Main Configuration File
  3: # =============================================================================
  4: # This file contains system-wide configuration settings for NFTBan.
  5: # User-specific overrides can be placed in /etc/nftban/conf.d/*.conf
  6: #
  7: # Format: KEY="value"
  8: # Lines starting with # are comments
  9: # =============================================================================
 10: 
 11: # Prevent double-sourcing (for bash scripts)
 12: [[ -n "${_NFTBAN_CONF_LOADED:-}" ]] && return 0 2>/dev/null || true
 13: _NFTBAN_CONF_LOADED=1
 14: 
 15: # -----------------------------------------------------------------------------
 16: # SYSTEM INFORMATION
 17: # -----------------------------------------------------------------------------
 18: NFTBAN_VERSION="1.0.0"
 19: NFTBAN_CONFIG_VERSION="2"
 20: 
 21: # -----------------------------------------------------------------------------
 22: # METRICS BACKEND
 23: # -----------------------------------------------------------------------------
 24: # Choose metrics collection backend:
 25: #   - prometheus       (default, industry standard)
 26: #   - victoriametrics  (10x compression, 20x faster queries, 12-month retention)
 27: #
 28: NFTBAN_METRICS_BACKEND="prometheus"
 29: 
 30: # Metrics collection enabled
 31: NFTBAN_METRICS_ENABLED="false"
 32: 
 33: # Metrics endpoints (used by health checks and status commands)
 34: NFTBAN_METRICS_PROMETHEUS_ADDR="localhost:9090"
 35: NFTBAN_METRICS_NODE_EXPORTER_ADDR="localhost:9100"
 36: NFTBAN_METRICS_VICTORIA_ADDR="localhost:8428"
 37: 
 38: # -----------------------------------------------------------------------------
 39: # GEOIP CONFIGURATION
 40: # -----------------------------------------------------------------------------
 41: # Enable GeoIP blocking functionality
 42: NFTBAN_GEOIP_ENABLED="false"
 43: 
 44: # MaxMind License Key (required for GeoIP database updates)
 45: # Get your free key at: https://www.maxmind.com/en/geolite2/signup
 46: #NFTBAN_GEOIP_LICENSE_KEY=""
 47: 
 48: # -----------------------------------------------------------------------------
 49: # THREAT FEEDS
 50: # -----------------------------------------------------------------------------
 51: # Enable threat intelligence feeds
 52: NFTBAN_FEEDS_ENABLED="false"
 53: 
 54: # Automatic feed updates
 55: NFTBAN_FEEDS_AUTO_UPDATE="true"
 56: 
 57: # -----------------------------------------------------------------------------
 58: # SURICATA IDS INTEGRATION
 59: # -----------------------------------------------------------------------------
 60: # Enable Suricata IDS integration (replaces fail2ban in v1.0)
 61: NFTBAN_SURICATA_ENABLED="true"
 62: 
 63: # Suricata eve.json monitoring (under NFTBan control)
 64: NFTBAN_SURICATA_EVE_LOG="/var/log/nftban/suricata/eve.json"
 65: NFTBAN_SURICATA_LOG_DIR="/var/log/nftban/suricata"
 66: 
 67: # IP scoring threshold (ban after this score)
 68: NFTBAN_SURICATA_BAN_THRESHOLD="100"
 69: 
 70: # Score decay time (seconds)
 71: NFTBAN_SURICATA_SCORE_DECAY="3600"
 72: 
 73: # Cloudflare IP whitelist
 74: NFTBAN_SURICATA_CLOUDFLARE_WHITELIST="false"
 75: 
 76: # -----------------------------------------------------------------------------
 77: # WEB GUI
 78: # -----------------------------------------------------------------------------
 79: # Enable web GUI
 80: NFTBAN_GUI_ENABLED="false"
 81: 
 82: # GUI listen address
 83: NFTBAN_GUI_ADDR="127.0.0.1:3940"
 84: 
 85: # -----------------------------------------------------------------------------
 86: # SECURITY FEATURES
 87: # -----------------------------------------------------------------------------
 88: # Enable port scan detection
 89: NFTBAN_PORTSCAN_ENABLED="false"
 90: 
 91: # Enable DDoS protection
 92: NFTBAN_DDOS_ENABLED="false"
 93: 
 94: # Enable login monitoring (built-in, no fail2ban dependency)
 95: # Monitors /var/log/auth.log or /var/log/secure for SSH brute force attacks
 96: NFTBAN_LOGIN_MONITOR_ENABLED="true"
 97: 
 98: # -----------------------------------------------------------------------------
 99: # LOGGING
100: # -----------------------------------------------------------------------------
101: # Log level: DEBUG, INFO, WARN, ERROR
102: NFTBAN_LOG_LEVEL="INFO"
103: 
104: # Enable colored output
105: NFTBAN_COLOR_OUTPUT="true"
106: 
107: # -----------------------------------------------------------------------------
108: # DEBUG TRACE (For troubleshooting stuck/failed scripts)
109: # -----------------------------------------------------------------------------
110: # When enabled, each script logs START/END with unique trace ID
111: # If a script has START without matching END = script is stuck/crashed
112: # Debug trace log: /var/log/nftban/debug_trace.log
113: NFTBAN_DEBUG_TRACE="false"
114: 
115: # Debug trace log file
116: NFTBAN_DEBUG_TRACE_LOG="/var/log/nftban/debug_trace.log"
117: 
118: # -----------------------------------------------------------------------------
119: # TIMEOUTS (seconds)
120: # -----------------------------------------------------------------------------
121: # Network and command timeouts - used across CLI and Go components
122: NFTBAN_TIMEOUT_FAST="5"           # Quick operations (curl connect, simple checks)
123: NFTBAN_TIMEOUT_MEDIUM="30"        # Standard operations (nft commands, API calls)
124: NFTBAN_TIMEOUT_SLOW="120"         # Long operations (large feed downloads)
125: NFTBAN_TIMEOUT_HTTP_DEFAULT="60"  # Default HTTP client timeout
126: NFTBAN_TIMEOUT_HTTP_LONG="300"    # Extended HTTP timeout (GeoIP downloads)
127: 
128: # -----------------------------------------------------------------------------
129: # HEALTH CHECK PARAMETERS
130: # -----------------------------------------------------------------------------
131: # Health monitoring thresholds
132: NFTBAN_HEALTH_FILE_AGE_THRESHOLD="600"    # seconds - max age for monitored files
133: NFTBAN_HEALTH_MEMORY_WARNING="600"        # MB - memory usage warning threshold
134: NFTBAN_ALERT_THROTTLE_SECONDS="3600"      # seconds - throttle repeated alerts
135: 
136: # -----------------------------------------------------------------------------
137: # CACHE CONTROL
138: # -----------------------------------------------------------------------------
139: # Cache TTL settings (seconds)
140: NFTBAN_STATS_CACHE_TTL="300"              # Stats cache (5 minutes)
141: NFTBAN_BANDWIDTH_CACHE_TTL="10"           # Bandwidth metrics cache
142: 
143: # -----------------------------------------------------------------------------
144: # PATHS (DO NOT MODIFY UNLESS YOU KNOW WHAT YOU'RE DOING)
145: # -----------------------------------------------------------------------------
146: # Canonical binary paths - used by all scripts for consistency
147: NFTBAN_BIN="/usr/bin/nftban"
148: NFTBAN_CORE_BIN="/usr/lib/nftban/bin/nftban-core"
149: NFTBAN_UI_BIN="/usr/sbin/nftban-ui"
150: NFTBAN_AUTH_BIN="/usr/libexec/nftban-ui-auth"
151: 
152: # Directory paths
153: NFTBAN_LIB_DIR="/usr/lib/nftban"
154: NFTBAN_SHARE_DIR="/usr/share/nftban"
155: NFTBAN_TESTS_DIR="/usr/lib/nftban/tests"
156: NFTBAN_CONFIG_DIR="/etc/nftban"
157: NFTBAN_DATA_DIR="/var/lib/nftban"
158: NFTBAN_LOG_DIR="/var/log/nftban"
159: NFTBAN_CACHE_DIR="/var/cache/nftban"
160: NFTBAN_RUN_DIR="/run/nftban"
161: NFTBAN_POLKIT_RULES_DIR="/etc/polkit-1/rules.d"
162: 
163: # Log files (all under NFTBAN_LOG_DIR)
164: NFTBAN_BAN_LOG="${NFTBAN_LOG_DIR}/bans.log"
165: NFTBAN_ACTIONS_LOG="${NFTBAN_LOG_DIR}/nftban-actions.log"
166: NFTBAN_PORTSCAN_LOG="${NFTBAN_LOG_DIR}/portscan.log"
167: NFTBAN_LOGIN_MONITOR_LOG="${NFTBAN_LOG_DIR}/login_alert.log"
168: NFTBAN_CLOUDFLARE_LOG="${NFTBAN_LOG_DIR}/cloudflare.log"
169: NFTBAN_MAINTENANCE_LOG="${NFTBAN_LOG_DIR}/maintenance.log"
170: NFTBAN_CLI_ERROR_LOG="${NFTBAN_LOG_DIR}/cli-errors.log"
171: 
172: # -----------------------------------------------------------------------------
173: # DISTRO CONFIGURATION
174: # -----------------------------------------------------------------------------
175: # Distro config directory (auto-detected distro config loaded from here)
176: NFTBAN_DISTRO_CONF_DIR="/etc/nftban/distros"
177: 
178: # -----------------------------------------------------------------------------
179: # NFTBAN SYSTEMD SERVICE NAMES (Central Reference)
180: # -----------------------------------------------------------------------------
181: # NFTBan's own services - same across all distros
182: # External services (prometheus, node_exporter) are in distros/*.conf
183: 
184: # Core services
185: NFTBAN_SERVICE_CORE="nftban-core.service"
186: NFTBAN_SERVICE_UI="nftban-ui.service"
187: 
188: # Timer-based services
189: NFTBAN_SERVICE_QUEUE="nftban-queue.service"
190: NFTBAN_SERVICE_MAINTENANCE="nftban-maintenance.service"
191: NFTBAN_SERVICE_HEALTH="nftban-health.service"
192: NFTBAN_SERVICE_METRICS_EXPORTER="nftban-metrics-exporter.service"
193: NFTBAN_SERVICE_BANDWIDTH_EXPORTER="nftban-bandwidth-exporter.service"
194: 
195: # Feature services
196: NFTBAN_SERVICE_LOGIN_MONITOR="nftban-login-monitor.service"
197: NFTBAN_SERVICE_SURICATA="nftban-suricata.service"
198: 
199: # Timers
200: NFTBAN_TIMER_QUEUE="nftban-queue.timer"
201: NFTBAN_TIMER_MAINTENANCE="nftban-maintenance.timer"
202: NFTBAN_TIMER_HEALTH="nftban-health.timer"
203: NFTBAN_TIMER_METRICS_EXPORTER="nftban-metrics-exporter.timer"
204: NFTBAN_TIMER_BANDWIDTH_EXPORTER="nftban-bandwidth-exporter.timer"
205: NFTBAN_TIMER_FEEDS="nftban-core-feeds.timer"
206: NFTBAN_TIMER_GEOIP="nftban-core-geoip.timer"
207: NFTBAN_TIMER_SURICATA_UPDATE="nftban-suricata-update.timer"
208: NFTBAN_TIMER_WATCHDOG="nftban-watchdog.timer"
209: NFTBAN_SERVICE_WATCHDOG="nftban-watchdog.service"
210: 
211: # -----------------------------------------------------------------------------
212: # SYSTEM WATCHDOG (Resource Monitoring)
213: # -----------------------------------------------------------------------------
214: # Monitor system resources (load, memory, I/O, disk) for troubleshooting
215: # Does NOT overlap with DDoS (connections) or Health (services)
216: NFTBAN_WATCHDOG_ENABLED="false"
217: NFTBAN_WATCHDOG_INTERVAL="90"
218: NFTBAN_WATCHDOG_ALERT_THROTTLE="3600"
219: 
220: # Watchdog paths
221: NFTBAN_WATCHDOG_LOG="${NFTBAN_LOG_DIR}/watchdog.log"
222: NFTBAN_WATCHDOG_REPORT_DIR="${NFTBAN_DATA_DIR}/reports/watchdog"
223: NFTBAN_WATCHDOG_METRICS_FILE="${NFTBAN_DATA_DIR}/metrics/watchdog.prom"
224: NFTBAN_WATCHDOG_REPORT_RETENTION="7"
225: 
226: # -----------------------------------------------------------------------------
227: # EXTERNAL SERVICE REFERENCES (mapped per-distro in distros/*.conf)
228: # -----------------------------------------------------------------------------
229: # These vary by distro - use nftban_distro_get_service() to resolve:
230: #   - prometheus        : Metrics collection (or victoriametrics)
231: #   - node_exporter     : System metrics (prometheus-node-exporter on RHEL)
232: #   - suricata          : Suricata IDS
233: #   - nftables          : Kernel firewall
234: #   - cron              : Cron daemon (crond on RHEL, cron on Debian)
235: 
236: # =============================================================================
237: # END OF CONFIGURATION
238: # =============================================================================
</file>

<file path="install/man/man8/nftban-suricata.8">
  1: .TH NFTBAN-SURICATA 8 "2025-12-28" "NFTBan 1.0.14" "NFTBan Manual"
  2: .SH NAME
  3: nftban\-suricata \- Suricata IDS/IPS integration for NFTBan
  4: .SH SYNOPSIS
  5: .B nftban suricata
  6: .I command
  7: .RI [ options ]
  8: .SH DESCRIPTION
  9: .B nftban suricata
 10: provides automated installation, configuration, and management of Suricata IDS (Intrusion Detection System) integration with NFTBan firewall.
 11: 
 12: Suricata analyzes network traffic for threats using signature-based detection rules and generates alerts in EVE JSON format. NFTBan processes these alerts and automatically blocks malicious IPs using nftables.
 13: 
 14: .SH COMMANDS
 15: .TP
 16: .B install
 17: Automatically install Suricata IDS with NFTBan-optimized configuration.
 18: Checks for package availability (EPEL/APT), downloads ET/Open ruleset, and configures systemd services.
 19: 
 20: .TP
 21: .B enable
 22: Enable and start Suricata service. Also enables weekly automatic rule updates timer.
 23: 
 24: .TP
 25: .B disable
 26: Stop and disable Suricata service and automatic updates.
 27: 
 28: .TP
 29: .B status
 30: Display comprehensive status including:
 31: .RS
 32: - Installation and version information
 33: .RE
 34: .RS
 35: - Service running/enabled status
 36: .RE
 37: .RS
 38: - Automatic update timer status
 39: .RE
 40: .RS
 41: - Rule count and recent alerts
 42: .RE
 43: 
 44: .TP
 45: .B rules update
 46: Manually download latest detection rules from ET/Open source and restart Suricata.
 47: 
 48: .TP
 49: .B rules list
 50: List all installed rule files in /var/lib/suricata/rules/
 51: 
 52: .TP
 53: .B help
 54: Display detailed help message with examples.
 55: 
 56: .SH EXAMPLES
 57: .TP
 58: Complete automated installation:
 59: .B sudo nftban suricata install && sudo nftban suricata enable
 60: 
 61: .TP
 62: Check status:
 63: .B nftban suricata status
 64: 
 65: .TP
 66: View live alerts:
 67: .B tail -f /var/log/suricata/eve.json | jq 'select(.event_type=="alert")'
 68: 
 69: .TP
 70: Manual rule update:
 71: .B sudo nftban suricata rules update
 72: 
 73: .SH FILES
 74: .TP
 75: .I /etc/suricata/suricata.yaml
 76: Main Suricata configuration file (NFTBan-optimized)
 77: 
 78: .TP
 79: .I /var/lib/suricata/rules/
 80: Installed detection rules (ET/Open ruleset)
 81: 
 82: .TP
 83: .I /var/log/suricata/eve.json
 84: Alert output in EVE JSON format
 85: 
 86: .TP
 87: .I /etc/systemd/system/nftban-suricata-update.timer
 88: Systemd timer for weekly rule updates (Sunday 3 AM)
 89: 
 90: .TP
 91: .I /etc/nftban/nftban.conf
 92: NFTBan configuration with IDS integration flags
 93: 
 94: .SH INTEGRATION
 95: .SS DDoS Module
 96: Enable IDS-assisted DDoS detection:
 97: .PP
 98: .RS
 99: .B nftban ddos enable
100: .br
101: .B echo "DDOS_MODE=suricata" >> /etc/nftban/conf.d/ddos.conf
102: .RE
103: 
104: .SS Portscan Module
105: Enable IDS-assisted portscan detection:
106: .PP
107: .RS
108: .B nftban portscan enable
109: .br
110: .B echo "PORTSCAN_MODE=suricata" >> /etc/nftban/conf.d/portscan.conf
111: .RE
112: 
113: .SH REQUIREMENTS
114: .TP
115: .B System
116: 2+ CPU cores, 2+ GB RAM, 1+ GB free disk
117: 
118: .TP
119: .B Software
120: NFTBan v1.0.14+, Python 3, pip3, EPEL repository (RHEL/Rocky)
121: 

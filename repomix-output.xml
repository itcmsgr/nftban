3504:             bin_path="${DISTRO_PATHS[$name]}"
3505:             printf "  ✔ %-15s OK (%s)\n" "$name" "$bin_path"
3506:             bin_ok=$((bin_ok + 1))
3507:         elif command -v "$name" &>/dev/null; then
3508:             bin_path=$(command -v "$name")
3509:             printf "  ✔ %-15s OK (%s)\n" "$name" "$bin_path"

<file path="pkg/netutil/ip.go">
  1: // Package netutil provides network utility functions for NFTBan
  2: // Centralizes IP address handling, whitelist checking, and CIDR operations
  3: package netutil
  4: 
  5: import (
  6: 	"bufio"
  7: 	"fmt"
  8: 	"net"
  9: 	"net/http"
 10: 	"os"
 11: 	"strings"
 12: )
 13: 
 14: // =============================================================================
 15: // Client IP Extraction
 16: // =============================================================================
 17: 
 18: // GetClientIP extracts the real client IP address from an HTTP request
 19: // Checks headers in order: X-Forwarded-For, X-Real-IP, RemoteAddr
 20: func GetClientIP(r *http.Request) string {
 21: 	// Check X-Forwarded-For header (may contain multiple IPs)
 22: 	if xff := r.Header.Get("X-Forwarded-For"); xff != "" {
 23: 		ips := strings.Split(xff, ",")
 24: 		if len(ips) > 0 {
 25: 			return strings.TrimSpace(ips[0])
 26: 		}
 27: 	}
 28: 
 29: 	// Check X-Real-IP header
 30: 	if xri := r.Header.Get("X-Real-IP"); xri != "" {
 31: 		return xri
 32: 	}
 33: 
 34: 	// Fall back to RemoteAddr
 35: 	ip, _, err := net.SplitHostPort(r.RemoteAddr)
 36: 	if err != nil {
 37: 		return r.RemoteAddr
 38: 	}
 39: 
 40: 	return ip
 41: }
 42: 
 43: // =============================================================================
 44: // IP Whitelist Checking
 45: // =============================================================================
 46: 
 47: // IsIPWhitelisted checks if an IP is in a whitelist file
 48: // Returns (true, nil) if IP is whitelisted
 49: // Returns (false, nil) if IP is not whitelisted or file doesn't exist
 50: // Returns (false, error) on file read errors
 51: func IsIPWhitelisted(clientIP string, whitelistFile string) (bool, error) {
 52: 	// Parse client IP
 53: 	ip := net.ParseIP(clientIP)
 54: 	if ip == nil {
 55: 		return false, nil
 56: 	}
 57: 
 58: 	// Open whitelist file
 59: 	file, err := os.Open(whitelistFile)
 60: 	if err != nil {
 61: 		// If file doesn't exist, deny access (security default)
 62: 		if os.IsNotExist(err) {
 63: 			return false, nil
 64: 		}
 65: 		return false, err
 66: 	}
 67: 	defer file.Close()
 68: 
 69: 	// Read whitelist entries
 70: 	scanner := bufio.NewScanner(file)
 71: 	for scanner.Scan() {
 72: 		line := strings.TrimSpace(scanner.Text())
 73: 
 74: 		// Skip comments and empty lines
 75: 		if line == "" || strings.HasPrefix(line, "#") {
 76: 			continue
 77: 		}
 78: 
 79: 		// Check if line is CIDR or single IP
 80: 		if strings.Contains(line, "/") {
 81: 			// Parse CIDR
 82: 			_, ipnet, err := net.ParseCIDR(line)
 83: 			if err != nil {
 84: 				continue
 85: 			}
 86: 			if ipnet.Contains(ip) {
 87: 				return true, nil
 88: 			}
 89: 		} else {
 90: 			// Parse single IP
 91: 			whiteIP := net.ParseIP(line)
 92: 			if whiteIP != nil && whiteIP.Equal(ip) {
 93: 				return true, nil
 94: 			}
 95: 		}
 96: 	}
 97: 
 98: 	if err := scanner.Err(); err != nil {
 99: 		return false, err
100: 	}
101: 
102: 	return false, nil
103: }
104: 
105: // =============================================================================
106: // IP Parsing and Validation
107: // =============================================================================
108: 
109: // ParseIP parses an IP address string and returns the net.IP
110: // Returns nil if the string is not a valid IP
111: func ParseIP(ipStr string) net.IP {
112: 	return net.ParseIP(ipStr)
113: }
114: 
115: // ParseCIDR parses a CIDR string and returns the IP and network
116: func ParseCIDR(cidr string) (net.IP, *net.IPNet, error) {
117: 	return net.ParseCIDR(cidr)
118: }
119: 
120: // IsIPv4 checks if an IP string represents an IPv4 address
121: func IsIPv4(ipStr string) bool {
122: 	ip := net.ParseIP(ipStr)
123: 	return ip != nil && ip.To4() != nil
124: }
125: 
126: // IsIPv6 checks if an IP string represents an IPv6 address
127: func IsIPv6(ipStr string) bool {
128: 	ip := net.ParseIP(ipStr)
129: 	return ip != nil && ip.To4() == nil
130: }
131: 
132: // IsCIDR checks if a string is a valid CIDR notation
133: func IsCIDR(s string) bool {
134: 	_, _, err := net.ParseCIDR(s)
135: 	return err == nil
136: }
137: 
138: // IsValidIP checks if a string is a valid IP address (v4 or v6)
139: func IsValidIP(ipStr string) bool {
140: 	return net.ParseIP(ipStr) != nil
141: }
142: 
143: // =============================================================================
144: // IP Network Operations
145: // =============================================================================
146: 
147: // IPContainedInCIDR checks if an IP is contained within a CIDR range
148: func IPContainedInCIDR(ipStr, cidr string) bool {
149: 	ip := net.ParseIP(ipStr)
150: 	if ip == nil {
151: 		return false
152: 	}
153: 
154: 	_, ipnet, err := net.ParseCIDR(cidr)
155: 	if err != nil {
156: 		return false
157: 	}
158: 
159: 	return ipnet.Contains(ip)
160: }
161: 
162: // GetIPFamily returns "ipv4" or "ipv6" based on the IP address
163: func GetIPFamily(ipStr string) string {
164: 	ip := net.ParseIP(ipStr)
165: 	if ip == nil {
166: 		return ""
167: 	}
168: 	if ip.To4() != nil {
169: 		return "ipv4"
170: 	}
171: 	return "ipv6"
172: }
173: 
174: // NormalizeIP returns a normalized string representation of an IP
175: // Useful for consistent map keys and comparisons
176: func NormalizeIP(ipStr string) string {
177: 	ip := net.ParseIP(ipStr)
178: 	if ip == nil {
179: 		return ipStr // Return original if not valid
180: 	}
181: 	return ip.String()
182: }
183: 
184: // =============================================================================
185: // Private IP Detection
186: // =============================================================================
187: 
188: // Private IP ranges
189: var (
190: 	privateIPv4Ranges = []string{
191: 		"10.0.0.0/8",
192: 		"172.16.0.0/12",
193: 		"192.168.0.0/16",
194: 		"127.0.0.0/8",
195: 	}
196: 	privateIPv6Ranges = []string{
197: 		"::1/128",
198: 		"fc00::/7",
199: 		"fe80::/10",
200: 	}
201: )
202: 
203: // IsPrivateIP checks if an IP is a private/local address
204: func IsPrivateIP(ipStr string) bool {
205: 	ip := net.ParseIP(ipStr)
206: 	if ip == nil {
207: 		return false
208: 	}
209: 
210: 	// Check IPv4 private ranges
211: 	if ip.To4() != nil {
212: 		for _, cidr := range privateIPv4Ranges {
213: 			_, ipnet, _ := net.ParseCIDR(cidr)
214: 			if ipnet.Contains(ip) {
215: 				return true
216: 			}
217: 		}
218: 	} else {
219: 		// Check IPv6 private ranges
220: 		for _, cidr := range privateIPv6Ranges {
221: 			_, ipnet, _ := net.ParseCIDR(cidr)
222: 			if ipnet.Contains(ip) {
223: 				return true
224: 			}
225: 		}
226: 	}
227: 
228: 	return false
229: }
230: 
231: // IsPublicIP checks if an IP is a public/routable address
232: func IsPublicIP(ipStr string) bool {
233: 	return IsValidIP(ipStr) && !IsPrivateIP(ipStr)
234: }
235: 
236: // =============================================================================
237: // IP Validation for Lists (blacklist/whitelist)
238: // =============================================================================
239: 
240: // ValidateAndNormalizeIP validates and normalizes an IP or CIDR
241: // Returns: (normalized string, isIPv4, error)
242: // Used by blacklist/whitelist loaders for consistent IP handling
243: func ValidateAndNormalizeIP(ipStr string) (string, bool, error) {
244: 	ipStr = strings.TrimSpace(ipStr)
245: 	if ipStr == "" {
246: 		return "", false, fmt.Errorf("empty IP string")
247: 	}
248: 
249: 	// Handle CIDR
250: 	if strings.Contains(ipStr, "/") {
251: 		_, ipNet, err := net.ParseCIDR(ipStr)
252: 		if err != nil {
253: 			return "", false, fmt.Errorf("invalid CIDR: %s", ipStr)
254: 		}
255: 		return ipNet.String(), ipNet.IP.To4() != nil, nil
256: 	}
257: 
258: 	// Handle single IP
259: 	ip := net.ParseIP(ipStr)
260: 	if ip == nil {
261: 		return "", false, fmt.Errorf("invalid IP: %s", ipStr)
262: 	}
263: 
264: 	return ip.String(), ip.To4() != nil, nil
265: }
</file>

<file path="pkg/network/detect.go">
  1: package network
  2: 
  3: import (
  4: 	"fmt"
  5: 	"net"
  6: )
  7: 
  8: // IPFamilySupport represents which IP families are available on the system
  9: type IPFamilySupport struct {
 10: 	HasIPv4 bool // System has at least one IPv4 address
 11: 	HasIPv6 bool // System has at least one IPv6 address
 12: }
 13: 
 14: // DetectIPFamilySupport checks which IP families the system actually has
 15: // This is critical for nftables: we should only create tables/chains for
 16: // IP families that exist on the system
 17: func DetectIPFamilySupport() (*IPFamilySupport, error) {
 18: 	support := &IPFamilySupport{
 19: 		HasIPv4: false,
 20: 		HasIPv6: false,
 21: 	}
 22: 
 23: 	// Get all network interfaces
 24: 	ifaces, err := net.Interfaces()
 25: 	if err != nil {
 26: 		return nil, fmt.Errorf("failed to get network interfaces: %w", err)
 27: 	}
 28: 
 29: 	for _, iface := range ifaces {
 30: 		// Skip loopback - we want real network connectivity
 31: 		if iface.Flags&net.FlagLoopback != 0 {
 32: 			continue
 33: 		}
 34: 
 35: 		// Skip down interfaces
 36: 		if iface.Flags&net.FlagUp == 0 {
 37: 			continue
 38: 		}
 39: 
 40: 		// Get addresses for this interface
 41: 		addrs, err := iface.Addrs()
 42: 		if err != nil {
 43: 			continue
 44: 		}
 45: 
 46: 		for _, addr := range addrs {
 47: 			var ip net.IP
 48: 			switch v := addr.(type) {
 49: 			case *net.IPNet:
 50: 				ip = v.IP
 51: 			case *net.IPAddr:
 52: 				ip = v.IP
 53: 			}
 54: 
 55: 			if ip == nil || ip.IsLoopback() {
 56: 				continue
 57: 			}
 58: 
 59: 			// Check if IPv4
 60: 			if ip.To4() != nil {
 61: 				support.HasIPv4 = true
 62: 			} else if ip.To16() != nil {
 63: 				// IPv6 (but not IPv4-mapped)
 64: 				support.HasIPv6 = true
 65: 			}
 66: 
 67: 			// Early exit if we found both
 68: 			if support.HasIPv4 && support.HasIPv6 {
 69: 				return support, nil
 70: 			}
 71: 		}
 72: 	}
 73: 
 74: 	return support, nil
 75: }
 76: 
 77: // String returns a human-readable description
 78: func (s *IPFamilySupport) String() string {
 79: 	if s.HasIPv4 && s.HasIPv6 {
 80: 		return "IPv4 + IPv6 (dual-stack)"
 81: 	} else if s.HasIPv4 {
 82: 		return "IPv4 only"
 83: 	} else if s.HasIPv6 {
 84: 		return "IPv6 only"
 85: 	}
 86: 	return "No IP connectivity detected"
 87: }
 88: 
 89: // ShouldCreateIPv4Rules returns true if IPv4 nftables rules should be created
 90: func (s *IPFamilySupport) ShouldCreateIPv4Rules() bool {
 91: 	return s.HasIPv4
 92: }
 93: 
 94: // ShouldCreateIPv6Rules returns true if IPv6 nftables rules should be created
 95: func (s *IPFamilySupport) ShouldCreateIPv6Rules() bool {
 96: 	return s.HasIPv6
 97: }
 98: 
 99: // GetActiveFamilies returns a list of active IP families for logging
100: func (s *IPFamilySupport) GetActiveFamilies() []string {
101: 	var families []string
102: 	if s.HasIPv4 {
103: 		families = append(families, "IPv4")
104: 	}
105: 	if s.HasIPv6 {
106: 		families = append(families, "IPv6")
107: 	}
108: 	return families
109: }
</file>


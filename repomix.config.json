{
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "headerText": "NFTBan Firewall Platform - Complete Codebase + Wiki",
    "instructionFilePath": "repomix-instruction.md",
    "showLineNumbers": true,
    "removeComments": false,
    "removeEmptyLines": false
  },
  "include": [
    "**/*.sh",
    "**/*.go",
    "**/*.md",
    "**/*.conf",
    "**/*.service",
    "**/*.timer",
    "**/*.yml",
    "**/*.yaml",
    "**/*.json",
    "**/*.xml",
    "wiki/**",
    "docs/wiki/**",
    "cli/**",
    "cmd/**",
    "pkg/**",
    "install/**",
    "README.md",
    "ARCHITECTURE.md",
    "CONTRIBUTING.md"
  ],
  "ignore": {
    "customPatterns": [
      "**/node_modules/**",
      "**/vendor/**",
      "**/.git/**",
      "**/repomix-output.*",
      "**/repomix.config.json",
      "**/*.log",
      "**/*.tmp",
      "**/test_data/**",
      "**/testdata/**"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}

784:         # Type badge
785:         local type_badge="<span class=\"badge badge-${type}\">${type}</span>"
786: 
787:         # Status badge
788:         local status_badge
789:         if [[ "$status" == "ENABLED" ]]; then
790:             status_badge="<span class=\"badge badge-enabled\">ENABLED</span>"
791:         else
792:             status_badge="<span class=\"badge badge-disabled\">DISABLED</span>"
793:         fi
794: 
795:         table_rows+="                <tr>
796:                     <td><strong>${name}</strong></td>
797:                     <td>${version}</td>
798:                     <td>${type_badge}</td>
799:                     <td>${status_badge}</td>
800:                     <td>${created:-N/A}</td>
801:                     <td class=\"path-text\">${module_path}</td>
802:                     <td>${depends:-none}</td>
803:                 </tr>
804: "
805:     done
806: 
807:     # Read template
808:     local html_content
809:     html_content=$(cat "$template_path")
810: 
811:     # Get system info
812:     local hostname
813:     hostname=$(hostname -f 2>/dev/null || hostname)
814:     local server_ip
815:     server_ip=$(hostname -I 2>/dev/null | awk '{print $1}' || echo "N/A")
816:     local current_date
817:     current_date=$(date +%Y-%m-%d)
818:     local current_time
819:     current_time=$(date +%H:%M:%S)

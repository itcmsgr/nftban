<file path="pkg/suricata/processor.go">
  1: package suricata
  2: 
  3: import (
  4: 	"fmt"
  5: 	"os"
  6: 	"time"
  7: 
  8: 	"github.com/itcmsgr/nftban/pkg/nftbanconf"
  9: )
 10: 
 11: // Processor handles the main Suricata event processing loop
 12: type Processor struct {
 13: 	config     *Config
 14: 	matcher    *FilterMatcher
 15: 	scorer     *Scorer
 16: 	logger     *EventLogger
 17: 	reader     *EveReader
 18: 	eventChan  chan *Event
 19: 	stopChan   chan struct{}
 20: 	banHandler BanHandler
 21: }
 22: 
 23: // BanHandler defines the interface for banning IPs
 24: type BanHandler interface {
 25: 	BanIP(ip string, duration time.Duration, reason string) error
 26: }
 27: 
 28: // ProcessorConfig holds configuration for the processor
 29: type ProcessorConfig struct {
 30: 	ConfigDir   string
 31: 	EvePath     string
 32: 	LogPath     string
 33: 	BanHandler  BanHandler
 34: }
 35: 
 36: // NewProcessor creates a new Suricata event processor
 37: func NewProcessor(cfg *ProcessorConfig) (*Processor, error) {
 38: 	// Load configuration
 39: 	config, err := LoadConfig(cfg.ConfigDir)
 40: 	if err != nil {
 41: 		return nil, fmt.Errorf("failed to load config: %w", err)
 42: 	}
 43: 
 44: 	if !config.GlobalEnabled {
 45: 		return nil, fmt.Errorf("suricata integration is disabled in config")
 46: 	}
 47: 
 48: 	// Create filter matcher
 49: 	matcher := NewFilterMatcher(config)
 50: 
 51: 	// Create scorer
 52: 	scorer := NewScorer(config)
 53: 
 54: 	// Create event logger
 55: 	logger, err := NewEventLogger(cfg.LogPath)
 56: 	if err != nil {
 57: 		return nil, fmt.Errorf("failed to create logger: %w", err)
 58: 	}
 59: 
 60: 	// Create eve.json reader
 61: 	reader, err := NewEveReader(cfg.EvePath, matcher)
 62: 	if err != nil {
 63: 		logger.Close()
 64: 		return nil, fmt.Errorf("failed to create eve reader: %w", err)
 65: 	}
 66: 
 67: 	p := &Processor{
 68: 		config:     config,
 69: 		matcher:    matcher,
 70: 		scorer:     scorer,
 71: 		logger:     logger,
 72: 		reader:     reader,
 73: 		eventChan:  make(chan *Event, 1000), // Buffer 1000 events
 74: 		stopChan:   make(chan struct{}),
 75: 		banHandler: cfg.BanHandler,
 76: 	}
 77: 
 78: 	return p, nil
 79: }
 80: 
 81: // Start starts the processor
 82: func (p *Processor) Start() error {
 83: 	// Get config dir from central config
 84: 	// NO FALLBACK - path must come from /etc/nftban/nftban.conf
 85: 	cfg := nftbanconf.MustLoad()
 86: 	configDir := cfg.ConfigDir
 87: 
 88: 	fmt.Printf("🛡️  NFTBan Suricata Processor Starting...\n")
 89: 	fmt.Printf("   Config Dir: %s\n", configDir)
 90: 	fmt.Printf("   Eve Log:    %s\n", p.reader.path)
 91: 	fmt.Printf("   Event Log:  %s\n", p.logger.path)
 92: 	fmt.Printf("   Filters:    %d enabled\n\n", len(p.config.GetEnabledFilters()))
 93: 
 94: 	// Start reader goroutine
 95: 	go func() {
 96: 		if err := p.reader.ReadEvents(p.eventChan, p.stopChan); err != nil {
 97: 			fmt.Fprintf(os.Stderr, "Eve reader error: %v\n", err)
 98: 		}
 99: 	}()
100: 
101: 	// Start processing goroutine
102: 	go p.processEvents()
103: 
104: 	fmt.Println("✅ Suricata processor started")
105: 	return nil
106: }
107: 
108: // Stop stops the processor
109: func (p *Processor) Stop() error {
110: 	fmt.Println("⏹️  Stopping Suricata processor...")
111: 
112: 	// Signal stop
113: 	close(p.stopChan)
114: 
115: 	// Close resources
116: 	if p.reader != nil {
117: 		p.reader.Close()
118: 	}
119: 	if p.logger != nil {
120: 		p.logger.Close()
121: 	}
122: 	if p.scorer != nil {
123: 		p.scorer.Stop()
124: 	}
125: 
126: 	fmt.Println("✅ Suricata processor stopped")
127: 	return nil
128: }
129: 
130: // processEvents processes incoming events
131: func (p *Processor) processEvents() {
132: 	for {
133: 		select {
134: 		case <-p.stopChan:
135: 			return
136: 		case event := <-p.eventChan:
137: 			if event != nil {
138: 				p.handleEvent(event)
139: 			}
140: 		}
141: 	}
142: }
143: 
144: // handleEvent handles a single Suricata event
145: func (p *Processor) handleEvent(event *Event) {
146: 	// Skip if no filter matched
147: 	if event.Filter == "" {
148: 		return
149: 	}
150: 
151: 	// Get filter config
152: 	filter, ok := p.config.GetFilter(event.Filter)
153: 	if !ok || !filter.Enabled {
154: 		return
155: 	}
156: 
157: 	// Add event and calculate score
158: 	score := p.scorer.AddEvent(event)
159: 
160: 	// Determine decision based on action and score
161: 	decision := "LOG"
162: 	shouldBan := false
163: 
164: 	switch filter.Action {
165: 	case "log":
166: 		// Just log, never ban
167: 		decision = "LOG"
168: 		shouldBan = false
169: 
170: 	case "observe":
171: 		// Log and track, but don't ban
172: 		if score >= filter.Threshold {
173: 			decision = "OBSERVE"
174: 		} else {
175: 			decision = "TRACK"
176: 		}
177: 		shouldBan = false
178: 
179: 	case "ban":
180: 		// Ban if score exceeds threshold
181: 		if score >= filter.Threshold {
182: 			decision = "BAN"
183: 			shouldBan = true
184: 		} else {
185: 			decision = "MONITOR"
186: 		}
187: 	}
188: 
189: 	// Log the event
190: 	if err := p.logger.LogEvent(event, score, filter.Threshold, filter.Action, decision); err != nil {
191: 		fmt.Fprintf(os.Stderr, "Failed to log event: %v\n", err)
192: 	}
193: 
194: 	// Execute ban if needed
195: 	if shouldBan && p.banHandler != nil {
196: 		// Determine ban duration based on ban_type
197: 		banDuration := filter.BanTime
198: 		banType := "temporary"
199: 		reason := fmt.Sprintf("Suricata: %s (score=%d)", event.Signature, score)
200: 
201: 		if filter.BanType == "permanent" {
202: 			// Always permanent
203: 			banDuration = 0 // 0 = permanent in nftban
204: 			banType = "permanent"
205: 		} else if filter.BanType == "escalate" {
206: 			// Check ban history for escalation
207: 			ipScore := p.scorer.GetIPScore(event.SrcIP)
208: 			if ipScore != nil && filter.MaxBans > 0 && filter.Period > 0 {
209: 				// Count bans in the escalation period
210: 				cutoff := time.Now().Add(-filter.Period)
211: 				recentBans := 0
212: 				for _, t := range ipScore.Events {
213: 					if t.After(cutoff) {
214: 						recentBans++
215: 					}
216: 				}
217: 
218: 				// If exceeded threshold, escalate to permanent
219: 				if recentBans >= filter.MaxBans {
220: 					banDuration = 0 // permanent
221: 					banType = "permanent (escalated)"
222: 					reason = fmt.Sprintf("Suricata: %s (score=%d, %d bans in %s - ESCALATED)",
223: 						event.Signature, score, recentBans, filter.Period)
224: 				}
225: 			}
226: 		}
227: 
228: 		// Execute the ban
229: 		if err := p.banHandler.BanIP(event.SrcIP, banDuration, reason); err != nil {
230: 			p.logger.LogError(fmt.Sprintf("Failed to ban %s", event.SrcIP), err)
231: 		} else {
232: 			// Log successful ban action
233: 			p.logger.LogBanAction(event.SrcIP, filter.Name, score, filter.Threshold, banDuration, reason+" ["+banType+"]")
234: 			// Don't reset score - keep tracking for escalation
235: 		}
236: 	}
237: }
238: 
239: // GetStats returns current processor statistics
240: func (p *Processor) GetStats() map[string]interface{} {
241: 	scores := p.scorer.GetAllScores()
242: 
243: 	stats := map[string]interface{}{
244: 		"enabled_filters": len(p.config.GetEnabledFilters()),
245: 		"total_filters":   len(p.config.Filters),
246: 		"tracked_ips":     len(scores),
247: 		"event_queue":     len(p.eventChan),
248: 	}
249: 
250: 	return stats
251: }
252: 
253: // GetScores returns all current IP scores
254: func (p *Processor) GetScores() map[string]*IPScore {
255: 	return p.scorer.GetAllScores()
256: }
</file>

<file path="pkg/sync/apply.go">
  1: package sync
  2: 
  3: import (
  4: 	"github.com/google/nftables"
  5: 	"github.com/itcmsgr/nftban/pkg/util"
  6: )
  7: 
  8: // ApplyStringDiffToSet applies a DiffResult[string] to a nftables set via NFTManager.
  9: // This centralizes all add/remove logic so it can be reused by:
 10: // - Full sync operations (SyncSetToNFT)
 11: // - Incremental API operations (single IP add/remove)
 12: // - Batch API operations (multiple IPs at once)
 13: // - Suricata alert processing (future v1.0)
 14: //
 15: // Benefits of centralization:
 16: // - Single place for all nftables set updates
 17: // - Consistent error handling
 18: // - Easy to add hooks (logging, metrics, validation)
 19: // - Reusable across all v1.0 features
 20: //
 21: // Performance characteristics:
 22: // - Batched operations (not one-by-one)
 23: // - Atomic updates via NFTManager
 24: // - Efficient for both small and large diffs
 25: //
 26: // Example usage:
 27: //
 28: //	// Single IP add
 29: //	diff := util.DiffResult[string]{
 30: //	    ToAdd: []string{"1.2.3.4"},
 31: //	}
 32: //	err := ApplyStringDiffToSet(nft, whitelistSet, diff)
 33: //
 34: //	// Batch update
 35: //	diff := util.DiffResult[string]{
 36: //	    ToAdd:    []string{"1.2.3.4", "5.6.7.8"},
 37: //	    ToRemove: []string{"9.9.9.9"},
 38: //	}
 39: //	err := ApplyStringDiffToSet(nft, blacklistSet, diff)
 40: func ApplyStringDiffToSet(
 41: 	nft *NFTManager,
 42: 	set *nftables.Set,
 43: 	diff util.DiffResult[string],
 44: ) error {
 45: 	// Add new IPs if any
 46: 	if len(diff.ToAdd) > 0 {
 47: 		if err := nft.AddSetElements(set, diff.ToAdd); err != nil {
 48: 			return err
 49: 		}
 50: 	}
 51: 
 52: 	// Remove old IPs if any
 53: 	if len(diff.ToRemove) > 0 {
 54: 		if err := nft.DeleteSetElements(set, diff.ToRemove); err != nil {
 55: 			return err
 56: 		}
 57: 	}
 58: 
 59: 	return nil
 60: }
 61: 
 62: // ApplyDiffToSetWithStats is like ApplyStringDiffToSet but also returns statistics.
 63: // This is useful for operations that need detailed metrics.
 64: //
 65: // The stats include:
 66: // - Number of IPs successfully added
 67: // - Number of IPs successfully removed
 68: // - Number of IPs that were unchanged
 69: //
 70: // Example usage:
 71: //
 72: //	stats := ApplyDiffToSetWithStats(nft, set, diff)
 73: //	log.Printf("Applied: +%d -%d =%d", stats.Added, stats.Removed, stats.Unchanged)
 74: func ApplyDiffToSetWithStats(
 75: 	nft *NFTManager,
 76: 	set *nftables.Set,
 77: 	diff util.DiffResult[string],
 78: ) (added, removed, unchanged int, err error) {
 79: 	added = len(diff.ToAdd)
 80: 	removed = len(diff.ToRemove)
 81: 	unchanged = diff.Unchanged
 82: 
 83: 	err = ApplyStringDiffToSet(nft, set, diff)
 84: 	return
 85: }
 86: 
 87: // BatchApplyDiff applies multiple diffs to multiple sets in sequence.
 88: // This is useful for operations that need to update several sets atomically.
 89: //
 90: // All diffs are applied in order. If any diff fails, the function stops
 91: // and returns the error immediately.
 92: //
 93: // Example usage:
 94: //
 95: //	diffs := []DiffApplication{
 96: //	    {Set: whitelistIPv4Set, Diff: whitelistIPv4Diff},
 97: //	    {Set: whitelistIPv6Set, Diff: whitelistIPv6Diff},
 98: //	    {Set: blacklistIPv4Set, Diff: blacklistIPv4Diff},
 99: //	}
100: //	err := BatchApplyDiff(nft, diffs)
101: type DiffApplication struct {
102: 	Set  *nftables.Set
103: 	Diff util.DiffResult[string]
104: }
105: 
106: func BatchApplyDiff(nft *NFTManager, applications []DiffApplication) error {
107: 	for _, app := range applications {
108: 		if err := ApplyStringDiffToSet(nft, app.Set, app.Diff); err != nil {
109: 			return err
110: 		}
111: 	}
112: 	return nil
113: }
</file>


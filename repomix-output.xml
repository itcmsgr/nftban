 35: # meta:version=1.0.0
 36: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 37: # meta:homepage=https://nftban.com
 38: #
 39: # **Description & Purpose**
 40: # meta:description=CLI interface for permission management and auditing
 41: # meta:input=Command line arguments for permission operations
 42: # meta:output=Permission status, audit results, and enforcement reports
 43: #
 44: # **Inventory & Requirements**

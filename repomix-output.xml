 69: # ==============================================================================
 70: # Cleanup Functions
 71: # ==============================================================================
 72: nftban_gui_cleanup_old_state() {
 73:     echo "Step 1/5: Cleaning old state..."
 74: 
 75:     # Stop any running services (don't fail if not running)
 76:     systemctl stop nftban-ui &>/dev/null || true
 77:     systemctl stop prometheus &>/dev/null || true
 78:     systemctl stop node_exporter &>/dev/null || true
 79:     systemctl stop nftban-metrics-exporter.timer &>/dev/null || true
 80:     systemctl stop "${NFTBAN_SERVICE_METRICS_EXPORTER:-nftban-metrics-exporter.service}" &>/dev/null || true
 81: 
 82:     # Clean old metrics files
 83:     if [[ -d "/var/lib/node_exporter/textfile_collector" ]]; then
 84:         rm -f /var/lib/node_exporter/textfile_collector/*.prom 2>/dev/null || true
 85:         echo "  ✓ Cleaned old metrics files"
 86:     fi
 87: 
 88:     # Remove old placeholder stubs from .real/ directory
 89:     if [[ -d "/usr/lib/nftban/bin/.real" ]]; then
 90:         for stub in /usr/lib/nftban/bin/.real/*; do
 91:             if [[ -f "$stub" ]] && [[ $(stat -c%s "$stub") -lt 200 ]]; then
 92:                 rm -f "$stub" 2>/dev/null || true
 93:             fi
 94:         done
 95:         echo "  ✓ Removed placeholder stubs"
 96:     fi

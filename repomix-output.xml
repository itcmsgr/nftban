292: # FILE PATH VALIDATION
293: # =============================================================================
294: 
295: nftban_mail_validate_path() {
296:     # Validate file path is allowed to be sent
297:     # Args: $1 = file path
298:     # Returns: 0 if allowed, 1 if not allowed
299: 
300:     local file="$1"
301:     local allowed_paths="${NFTBAN_MAIL_ALLOWED_PATHS:-/var/lib/nftban}"
302: 
303:     # Must be absolute path
304:     if [[ ! "$file" =~ ^/ ]]; then
305:         [[ "${NFTBAN_MAIL_DEBUG:-false}" == "true" ]] && echo "[DEBUG] Not an absolute path: $file" >&2
306:         return 1
307:     fi
308: 
309:     # File must exist and be readable
310:     if [[ ! -f "$file" ]] || [[ ! -r "$file" ]]; then
311:         [[ "${NFTBAN_MAIL_DEBUG:-false}" == "true" ]] && echo "[DEBUG] File not found or not readable: $file" >&2
312:         return 1
313:     fi
314: 
315:     # Check file size
316:     local max_size="${NFTBAN_MAIL_MAX_FILE_SIZE:-10240}"  # KB
317:     local file_size
318:     file_size="$(du -k "$file" | cut -f1)"
319: 
320:     if (( file_size > max_size )); then
321:         [[ "${NFTBAN_MAIL_DEBUG:-false}" == "true" ]] && echo "[DEBUG] File too large: ${file_size}KB > ${max_size}KB" >&2
322:         return 1
323:     fi
324: 
325:     # Check against allowed paths
326:     local path_allowed=0
327:     IFS=':' read -ra PATHS <<< "$allowed_paths"
328:     for path in "${PATHS[@]}"; do
329:         if [[ "$file" == "$path"* ]]; then
330:             path_allowed=1
331:             break
332:         fi
333:     done
334: 
335:     if (( path_allowed == 0 )); then
336:         [[ "${NFTBAN_MAIL_DEBUG:-false}" == "true" ]] && echo "[DEBUG] File not in allowed paths: $file" >&2
337:         return 1
338:     fi
339: 
340:     return 0
341: }

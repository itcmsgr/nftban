284:     return 0
285: }
286: 
287: # =============================================================================
288: # AUTO-WHITELIST HELPERS
289: # =============================================================================
290: 
291: # Auto-whitelist system's primary IP address
292: _nftban_auto_whitelist_system_ip() {
293:     local whitelist_dir="${NFTBAN_CONFIG_DIR}/whitelist.d"
294:     local whitelist_file="${whitelist_dir}/00-system-ip.conf"
295: 
296:     # Get primary IP (non-loopback)
297:     local system_ip
298:     system_ip=$(ip route get 1.1.1.1 2>/dev/null | grep -oP 'src \K[0-9.]+' | head -1)
299: 
300:     if [[ -z "$system_ip" ]]; then
301:         # Fallback: get first non-loopback IP
302:         system_ip=$(hostname -I 2>/dev/null | awk '{print $1}')
303:     fi
304: 
305:     if [[ -n "$system_ip" ]]; then
306:         mkdir -p "$whitelist_dir"
307:         if [[ ! -f "$whitelist_file" ]] || ! grep -q "$system_ip" "$whitelist_file" 2>/dev/null; then
308:             cat > "$whitelist_file" << EOF
309: # Auto-generated system IP whitelist
310: # Created by: nftban system enable
311: # Date: $(date -Iseconds)
312: $system_ip
313: EOF
314:             chmod 644 "$whitelist_file"
315:             echo "  ✅ System IP whitelisted: $system_ip"
316:         else
317:             echo "  ✅ System IP already whitelisted: $system_ip"
318:         fi
319:     else
320:         echo "  ⚠️  Could not detect system IP"
321:     fi
322: }
323: 
324: # Auto-detect SSH port from sshd_config and whitelist it
325: _nftban_auto_whitelist_ssh_port() {
326:     local ports_dir="${NFTBAN_CONFIG_DIR}/ports.d"
327:     local ssh_conf="${ports_dir}/00-ssh.conf"
328:     local sshd_config="/etc/ssh/sshd_config"
329:     local ssh_port="22"
330: 
331:     # Try to detect SSH port from sshd_config
332:     if [[ -f "$sshd_config" ]]; then
333:         local detected_port
334:         detected_port=$(grep -E "^Port\s+" "$sshd_config" 2>/dev/null | awk '{print $2}' | head -1)
335:         if [[ -n "$detected_port" && "$detected_port" =~ ^[0-9]+$ ]]; then
336:             ssh_port="$detected_port"
337:         fi
338:     fi
339: 
340:     mkdir -p "$ports_dir"
341: 
342:     # Create or update SSH port config

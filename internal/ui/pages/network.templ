package pages

import (
	"fmt"
	"github.com/itcmsgr/nftban/internal/ui"
)

// Network renders the network monitoring page
templ Network(data ui.NetworkPageData) {
	@ui.LayoutWithNav("Network", "network") {
		<!-- Page Header -->
		<div class="page-header">
			<h1 class="page-title">Network Monitor</h1>
			<button class="btn btn-primary" hx-get="/ui/frag/network-stats" hx-target="#network-content" hx-swap="innerHTML">
				Refresh
			</button>
		</div>

		<div id="network-content" hx-get="/ui/frag/network-stats" hx-trigger="every 5s" hx-swap="innerHTML">
			@NetworkContentFragment(data)
		</div>
	}
}

// NetworkContentFragment renders all network content sections
templ NetworkContentFragment(data ui.NetworkPageData) {
	<!-- Summary Stats Row -->
	<div class="network-stats-row">
		<div class="stat-card rx">
			<div class="stat-icon">&#x2B07;</div>
			<div class="stat-info">
				<div class="stat-value">{ fmt.Sprintf("%.2f", data.TotalRxMbps) }</div>
				<div class="stat-unit">Mbps IN</div>
				<div class="stat-detail">Today: { data.TotalRxToday }</div>
			</div>
		</div>
		<div class="stat-card tx">
			<div class="stat-icon">&#x2B06;</div>
			<div class="stat-info">
				<div class="stat-value">{ fmt.Sprintf("%.2f", data.TotalTxMbps) }</div>
				<div class="stat-unit">Mbps OUT</div>
				<div class="stat-detail">Today: { data.TotalTxToday }</div>
			</div>
		</div>
		<div class="stat-card conn">
			<div class="stat-icon">&#x1F517;</div>
			<div class="stat-info">
				<div class="stat-value">{ intToStr(data.ActiveConns) }</div>
				<div class="stat-unit">Connections</div>
			</div>
		</div>
		<div class="stat-card drop">
			<div class="stat-icon">&#x1F6AB;</div>
			<div class="stat-info">
				<div class="stat-value">{ fmt.Sprintf("%d", data.DroppedPackets) }</div>
				<div class="stat-unit">Dropped Packets</div>
			</div>
		</div>
	</div>

	<!-- Interfaces Table -->
	<div class="card" style="margin-bottom: 1.5rem;">
		<div class="card-header">
			<span class="card-title">Network Interfaces</span>
		</div>
		<table class="data-table">
			<thead>
				<tr>
					<th>Interface</th>
					<th>Status</th>
					<th>IP Address</th>
					<th>MAC</th>
					<th>MTU</th>
					<th>RX Rate</th>
					<th>TX Rate</th>
					<th>RX Total</th>
					<th>TX Total</th>
					<th>Packets (RX/TX)</th>
					<th>Errors</th>
					<th>Dropped</th>
				</tr>
			</thead>
			<tbody>
				for _, iface := range data.Interfaces {
					<tr>
						<td style="font-weight: 500; font-family: monospace;">{ iface.Name }</td>
						<td>
							if iface.Status == "up" {
								<span class="badge badge-success">UP</span>
							} else {
								<span class="badge badge-muted">DOWN</span>
							}
						</td>
						<td style="font-family: monospace;">{ iface.IPAddress }</td>
						<td style="font-family: monospace; font-size: 0.8rem; color: var(--text-muted);">{ iface.MACAddress }</td>
						<td>{ intToStr(iface.MTU) }</td>
						<td class="traffic-rx">
							<span class="traffic-value">{ fmt.Sprintf("%.2f", iface.RxMbps) }</span>
							<span class="traffic-unit">Mbps</span>
						</td>
						<td class="traffic-tx">
							<span class="traffic-value">{ fmt.Sprintf("%.2f", iface.TxMbps) }</span>
							<span class="traffic-unit">Mbps</span>
						</td>
						<td>{ formatBytes64(iface.RxBytes) }</td>
						<td>{ formatBytes64(iface.TxBytes) }</td>
						<td style="font-size: 0.85rem;">{ formatLargeNumber(iface.RxPackets) } / { formatLargeNumber(iface.TxPackets) }</td>
						<td>
							if iface.RxErrors > 0 || iface.TxErrors > 0 {
								<span class="badge badge-warning">{ fmt.Sprintf("%d/%d", iface.RxErrors, iface.TxErrors) }</span>
							} else {
								<span class="text-muted">0</span>
							}
						</td>
						<td>
							if iface.Dropped > 0 {
								<span class="badge badge-danger">{ fmt.Sprintf("%d", iface.Dropped) }</span>
							} else {
								<span class="text-muted">0</span>
							}
						</td>
					</tr>
				}
				if len(data.Interfaces) == 0 {
					<tr>
						<td colspan="12" style="text-align: center; color: var(--text-muted);">No interfaces found</td>
					</tr>
				}
			</tbody>
		</table>
	</div>

	<!-- Main Content Grid -->
	<div class="network-content-grid">
		<!-- Traffic History (Placeholder for chart) -->
		<div class="card">
			<div class="card-header">
				<span class="card-title">Traffic History</span>
				<span class="badge badge-info">Last 60 min</span>
			</div>
			<div class="traffic-chart-placeholder">
				<div class="traffic-history-list">
					for i, sample := range data.TrafficHistory {
						if i < 20 {
							<div class="traffic-sample">
								<span class="sample-time">{ sample.Timestamp }</span>
								<span class="sample-rx">&#x2193; { fmt.Sprintf("%.1f", sample.RxMbps) }</span>
								<span class="sample-tx">&#x2191; { fmt.Sprintf("%.1f", sample.TxMbps) }</span>
							</div>
						}
					}
					if len(data.TrafficHistory) == 0 {
						<div class="empty-state">No traffic history available</div>
					}
				</div>
			</div>
		</div>

		<!-- Top Connections -->
		<div class="card">
			<div class="card-header">
				<span class="card-title">Active Connections</span>
				<span class="badge badge-muted">{ intToStr(len(data.TopConnections)) } shown</span>
			</div>
			<div class="connections-list">
				for _, conn := range data.TopConnections {
					<div class="connection-item">
						<div class="conn-main">
							<span class="conn-protocol">{ conn.Protocol }</span>
							<span class="conn-local">{ conn.LocalAddr }</span>
							<span class="conn-arrow">&#x2192;</span>
							<span class="conn-remote">{ conn.RemoteAddr }</span>
						</div>
						<div class="conn-info">
							<span class="conn-state">{ conn.State }</span>
							if conn.Process != "" {
								<span class="conn-process">{ conn.Process } (PID: { intToStr(conn.PID) })</span>
							}
						</div>
					</div>
				}
				if len(data.TopConnections) == 0 {
					<div class="empty-state">No active connections</div>
				}
			</div>
		</div>
	</div>

	<!-- Dropped Traffic Analysis -->
	<div class="dropped-traffic-grid" style="margin-top: 1.5rem;">
		<!-- Dropped by Country -->
		<div class="card">
			<div class="card-header">
				<span class="card-title">Dropped by Country</span>
			</div>
			<div class="dropped-list">
				for _, country := range data.DroppedByCountry {
					<div class="dropped-item">
						<span class="dropped-name">
							<span class="country-flag">{ getCountryFlag(country.Code) }</span>
							{ country.Name }
						</span>
						<span class="dropped-stats">
							<span class="dropped-packets">{ formatLargeNumber(country.Blocked) } blocked</span>
						</span>
					</div>
				}
				if len(data.DroppedByCountry) == 0 {
					<div class="empty-state">No dropped traffic by country</div>
				}
			</div>
		</div>

		<!-- Dropped by Port -->
		<div class="card">
			<div class="card-header">
				<span class="card-title">Dropped by Port</span>
			</div>
			<div class="dropped-list">
				for _, port := range data.DroppedByPort {
					<div class="dropped-item">
						<span class="dropped-name">
							<span class="port-number">{ intToStr(port.Port) }</span>
							<span class="port-proto">/{ port.Protocol }</span>
						</span>
						<span class="dropped-stats">
							<span class="dropped-packets">{ formatLargeNumber(port.Blocked) } blocked</span>
						</span>
					</div>
				}
				if len(data.DroppedByPort) == 0 {
					<div class="empty-state">No dropped traffic by port</div>
				}
			</div>
		</div>
	</div>

	<!-- Quick Commands -->
	<div class="card" style="margin-top: 1.5rem;">
		<div class="card-header">
			<span class="card-title">CLI Commands</span>
		</div>
		<div class="command-grid">
			<div class="command-item">
				<code>nftban network bandwidth</code>
				<span>Show bandwidth stats</span>
			</div>
			<div class="command-item">
				<code>nftban network connections</code>
				<span>List active connections</span>
			</div>
			<div class="command-item">
				<code>nftban network interfaces</code>
				<span>Show interface stats</span>
			</div>
			<div class="command-item">
				<code>ss -tuln</code>
				<span>Show listening ports</span>
			</div>
			<div class="command-item">
				<code>nft list counters</code>
				<span>Show nftables counters</span>
			</div>
			<div class="command-item">
				<code>iftop -i eth0</code>
				<span>Live traffic monitor</span>
			</div>
		</div>
	</div>

	<style>
		.network-stats-row {
			display: grid;
			grid-template-columns: repeat(4, 1fr);
			gap: 1rem;
			margin-bottom: 1.5rem;
		}
		@media (max-width: 1024px) {
			.network-stats-row {
				grid-template-columns: repeat(2, 1fr);
			}
		}
		@media (max-width: 768px) {
			.network-stats-row {
				grid-template-columns: 1fr;
			}
		}

		.stat-card {
			background: var(--bg-surface);
			border: 1px solid var(--border-color);
			border-radius: 8px;
			padding: 1rem;
			display: flex;
			align-items: center;
			gap: 1rem;
		}
		.stat-card.rx { border-left: 4px solid var(--accent-safe); }
		.stat-card.tx { border-left: 4px solid var(--accent-info); }
		.stat-card.conn { border-left: 4px solid var(--accent-warning); }
		.stat-card.drop { border-left: 4px solid var(--accent-danger); }

		.stat-icon {
			font-size: 2rem;
			opacity: 0.6;
		}
		.stat-info {
			flex: 1;
		}
		.stat-value {
			font-size: 1.75rem;
			font-weight: 700;
			font-family: 'SF Mono', Monaco, monospace;
		}
		.stat-card.rx .stat-value { color: var(--accent-safe); }
		.stat-card.tx .stat-value { color: var(--accent-info); }
		.stat-card.conn .stat-value { color: var(--accent-warning); }
		.stat-card.drop .stat-value { color: var(--accent-danger); }
		.stat-unit {
			font-size: 0.8rem;
			color: var(--text-muted);
			text-transform: uppercase;
		}
		.stat-detail {
			font-size: 0.75rem;
			color: var(--text-muted);
		}

		.traffic-rx .traffic-value { color: var(--accent-safe); }
		.traffic-tx .traffic-value { color: var(--accent-info); }
		.traffic-value {
			font-family: 'SF Mono', Monaco, monospace;
			font-weight: 500;
		}
		.traffic-unit {
			font-size: 0.75rem;
			color: var(--text-muted);
			margin-left: 0.25rem;
		}

		.network-content-grid {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 1.5rem;
		}
		@media (max-width: 1200px) {
			.network-content-grid {
				grid-template-columns: 1fr;
			}
		}

		.traffic-chart-placeholder {
			padding: 1rem;
			max-height: 400px;
			overflow-y: auto;
		}
		.traffic-history-list {
			display: flex;
			flex-direction: column;
			gap: 0.5rem;
		}
		.traffic-sample {
			display: flex;
			align-items: center;
			gap: 1rem;
			padding: 0.5rem;
			background: var(--bg-elevated);
			border-radius: 4px;
			font-size: 0.85rem;
		}
		.sample-time {
			color: var(--text-muted);
			width: 80px;
		}
		.sample-rx {
			color: var(--accent-safe);
			font-family: monospace;
		}
		.sample-tx {
			color: var(--accent-info);
			font-family: monospace;
		}

		.connections-list {
			padding: 0.5rem;
			max-height: 400px;
			overflow-y: auto;
		}
		.connection-item {
			padding: 0.75rem;
			border-bottom: 1px solid var(--border-color);
		}
		.connection-item:last-child {
			border-bottom: none;
		}
		.conn-main {
			display: flex;
			align-items: center;
			gap: 0.5rem;
			margin-bottom: 0.25rem;
		}
		.conn-protocol {
			font-weight: 600;
			text-transform: uppercase;
			font-size: 0.75rem;
			background: var(--bg-elevated);
			padding: 0.125rem 0.375rem;
			border-radius: 3px;
		}
		.conn-local, .conn-remote {
			font-family: monospace;
			font-size: 0.85rem;
		}
		.conn-arrow {
			color: var(--text-muted);
		}
		.conn-info {
			display: flex;
			gap: 1rem;
			font-size: 0.8rem;
			color: var(--text-muted);
		}
		.conn-state {
			text-transform: uppercase;
		}

		.dropped-traffic-grid {
			display: grid;
			grid-template-columns: repeat(2, 1fr);
			gap: 1.5rem;
		}
		@media (max-width: 1024px) {
			.dropped-traffic-grid {
				grid-template-columns: 1fr;
			}
		}

		.dropped-list {
			padding: 0.5rem;
			max-height: 300px;
			overflow-y: auto;
		}
		.dropped-item {
			display: flex;
			justify-content: space-between;
			align-items: center;
			padding: 0.5rem;
			border-bottom: 1px solid var(--border-color);
		}
		.dropped-item:last-child {
			border-bottom: none;
		}
		.dropped-name {
			display: flex;
			align-items: center;
			gap: 0.5rem;
		}
		.country-flag {
			font-size: 1.25rem;
		}
		.port-number {
			font-family: monospace;
			font-weight: 500;
		}
		.port-proto {
			color: var(--text-muted);
			font-size: 0.85rem;
		}
		.dropped-packets {
			color: var(--accent-danger);
			font-size: 0.85rem;
		}

		.command-grid {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 1rem;
			padding: 1rem;
		}
		@media (max-width: 1024px) {
			.command-grid {
				grid-template-columns: repeat(2, 1fr);
			}
		}
		@media (max-width: 768px) {
			.command-grid {
				grid-template-columns: 1fr;
			}
		}
		.command-item {
			display: flex;
			flex-direction: column;
			gap: 0.25rem;
		}
		.command-item code {
			background: var(--bg-elevated);
			padding: 0.5rem;
			border-radius: 4px;
			font-size: 0.85rem;
		}
		.command-item span {
			font-size: 0.8rem;
			color: var(--text-muted);
		}

		.empty-state {
			padding: 2rem;
			text-align: center;
			color: var(--text-muted);
		}
		.text-muted {
			color: var(--text-muted);
		}
	</style>
}

// Helper function to format bytes
func formatBytes64(bytes int64) string {
	const unit = 1024
	if bytes < unit {
		return fmt.Sprintf("%d B", bytes)
	}
	div, exp := int64(unit), 0
	for n := bytes / unit; n >= unit; n /= unit {
		div *= unit
		exp++
	}
	return fmt.Sprintf("%.1f %cB", float64(bytes)/float64(div), "KMGTPE"[exp])
}

#!/bin/sh
set -e

case "$1" in
    purge)
        # Remove UI-specific configuration files (only if they exist)
        [ -f /etc/nftban/ui.conf ] && rm -f /etc/nftban/ui.conf
        [ -f /etc/nftban/ui-whitelist.conf ] && rm -f /etc/nftban/ui-whitelist.conf
        [ -f /etc/nftban/ui-jwt-secret ] && rm -f /etc/nftban/ui-jwt-secret

        # Remove UI SSL certificates (only if directory exists and is not empty)
        if [ -d /etc/nftban/ssl ]; then
            [ -f /etc/nftban/ssl/cert.pem ] && rm -f /etc/nftban/ssl/cert.pem
            [ -f /etc/nftban/ssl/key.pem ] && rm -f /etc/nftban/ssl/key.pem
            rmdir /etc/nftban/ssl 2>/dev/null || true  # Only if empty
        fi

        # Remove UI log files
        rm -f /var/log/nftban/ui-*.log 2>/dev/null || true

        # Runtime directories will be removed automatically by systemd on service stop
        # But clean them manually if still exist
        [ -d /run/nftban-ui ] && rm -rf /run/nftban-ui
        [ -S /run/nftban/nftband.sock ] && rm -f /run/nftban/nftband.sock
        [ -d /run/nftban ] && rmdir /run/nftban 2>/dev/null || true

        # Disable NFTBand daemon units
        deb-systemd-helper purge nftband.socket >/dev/null 2>&1 || true
        deb-systemd-helper purge nftband.service >/dev/null 2>&1 || true
        deb-systemd-helper unmask nftband.socket >/dev/null 2>&1 || true
        deb-systemd-helper unmask nftband.service >/dev/null 2>&1 || true

        # Disable unified exporter units
        deb-systemd-helper purge nftban-unified-exporter.timer >/dev/null 2>&1 || true
        deb-systemd-helper purge nftban-unified-exporter.service >/dev/null 2>&1 || true
        deb-systemd-helper unmask nftban-unified-exporter.timer >/dev/null 2>&1 || true
        deb-systemd-helper unmask nftban-unified-exporter.service >/dev/null 2>&1 || true

        # Disable core timer units
        deb-systemd-helper purge nftban-maintenance.timer >/dev/null 2>&1 || true
        deb-systemd-helper purge nftban-maintenance.service >/dev/null 2>&1 || true
        deb-systemd-helper purge nftban-health.timer >/dev/null 2>&1 || true
        deb-systemd-helper purge nftban-health.service >/dev/null 2>&1 || true

        # Disable Web UI systemd units
        deb-systemd-helper purge nftban-ui.service >/dev/null || true
        deb-systemd-helper purge nftban-ui-auth.socket >/dev/null || true
        deb-systemd-helper purge nftban-ui-auth.service >/dev/null || true
        deb-systemd-helper unmask nftban-ui.service >/dev/null || true
        deb-systemd-helper unmask nftban-ui-auth.socket >/dev/null || true
        deb-systemd-helper unmask nftban-ui-auth.service >/dev/null || true

        # Informational message
        echo "nftban-ui: Configuration files in /etc/nftban/ and /etc/pam.d/ have been removed."
        echo "nftban-ui: User accounts and groups have NOT been removed (manual cleanup required if needed)."
        ;;

    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        # Nothing to do
        ;;
esac

#DEBHELPER#

exit 0

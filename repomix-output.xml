488: 
489:                 // Extract chains
490:                 const chainMatches = tableBlock.match(/chain\s+(\w+)/g);
491:                 if (chainMatches) {
492:                     chainMatches.forEach((chain, cidx) => {
493:                         const chainName = chain.replace('chain ', '');
494:                         const chainPrefix = isLast ? '    ' : '│   ';
495:                         const chainSymbol = cidx === chainMatches.length - 1 ? '└──' : '├──';
496:                         html += `${chainPrefix}${chainSymbol} <span class="chain">Chain: ${chainName}</span>\n`;
497:                     });
498:                 }
499: 
500:                 // Extract sets
501:                 const setMatches = tableBlock.match(/set\s+(\w+)/g);
502:                 if (setMatches) {
503:                     setMatches.forEach((set, sidx) => {
504:                         const setName = set.replace('set ', '');
505:                         const setPrefix = isLast ? '    ' : '│   ';
506:                         const setSymbol = sidx === setMatches.length - 1 ? '└──' : '├──';
507:                         html += `${setPrefix}${setSymbol} <span class="rule">Set: ${setName}</span>\n`;
508:                     });
509:                 }
510:             }
511:         });
512:     }
513: 
514:     diagram.innerHTML = html;
515: }
516: 
517: // Initialize - load ruleset on page load
518: checkRuleset();
519: </script>
</file>


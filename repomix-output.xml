<file path="pkg/util/set.go">
  1: package util
  2: 
  3: // Set is a generic set implementation using Go's map type.
  4: // Uses struct{} as value type for zero memory overhead.
  5: //
  6: // This replaces map[string]bool and similar patterns throughout the codebase
  7: // with a consistent, efficient, and type-safe API.
  8: //
  9: // Benefits over map[T]bool:
 10: // - Zero memory overhead for values (struct{} vs bool)
 11: // - Consistent API across all set operations
 12: // - Type-safe
 13: // - Self-documenting code
 14: type Set[T comparable] map[T]struct{}
 15: 
 16: // NewSet creates a new set and optionally adds initial values.
 17: // Preallocates map with correct capacity if initial values provided.
 18: //
 19: // Example:
 20: //
 21: //	// Empty set
 22: //	ips := util.NewSet[string]()
 23: //
 24: //	// Set with initial values
 25: //	ports := util.NewSet(80, 443, 8080)
 26: func NewSet[T comparable](values ...T) Set[T] {
 27: 	s := make(Set[T], len(values))
 28: 	for _, v := range values {
 29: 		s[v] = struct{}{}
 30: 	}
 31: 	return s
 32: }
 33: 
 34: // Add adds a value to the set.
 35: // Safe to call multiple times with same value (idempotent).
 36: func (s Set[T]) Add(v T) {
 37: 	s[v] = struct{}{}
 38: }
 39: 
 40: // Has checks if a value exists in the set.
 41: // O(1) average time complexity.
 42: func (s Set[T]) Has(v T) bool {
 43: 	_, ok := s[v]
 44: 	return ok
 45: }
 46: 
 47: // Remove removes a value from the set.
 48: // Safe to call even if value doesn't exist.
 49: func (s Set[T]) Remove(v T) {
 50: 	delete(s, v)
 51: }
 52: 
 53: // ToSlice converts the set to a slice.
 54: // Order is not guaranteed (map iteration is random).
 55: // Preallocates slice with exact capacity to avoid resizing.
 56: func (s Set[T]) ToSlice() []T {
 57: 	out := make([]T, 0, len(s))
 58: 	for v := range s {
 59: 		out = append(out, v)
 60: 	}
 61: 	return out
 62: }
 63: 
 64: // Len returns the number of elements in the set.
 65: func (s Set[T]) Len() int {
 66: 	return len(s)
 67: }
 68: 
 69: // Clear removes all elements from the set.
 70: // More efficient than creating a new set if you plan to reuse.
 71: func (s Set[T]) Clear() {
 72: 	for k := range s {
 73: 		delete(s, k)
 74: 	}
 75: }
 76: 
 77: // Clone creates a shallow copy of the set.
 78: // Useful when you need to preserve the original.
 79: func (s Set[T]) Clone() Set[T] {
 80: 	clone := make(Set[T], len(s))
 81: 	for k := range s {
 82: 		clone[k] = struct{}{}
 83: 	}
 84: 	return clone
 85: }
 86: 
 87: // Union returns a new set containing all elements from both sets.
 88: func (s Set[T]) Union(other Set[T]) Set[T] {
 89: 	result := make(Set[T], len(s)+len(other))
 90: 	for k := range s {
 91: 		result[k] = struct{}{}
 92: 	}
 93: 	for k := range other {
 94: 		result[k] = struct{}{}
 95: 	}
 96: 	return result
 97: }
 98: 
 99: // Intersection returns a new set containing only elements present in both sets.
100: func (s Set[T]) Intersection(other Set[T]) Set[T] {
101: 	result := make(Set[T])
102: 	for k := range s {
103: 		if other.Has(k) {
104: 			result[k] = struct{}{}
105: 		}
106: 	}
107: 	return result
108: }
109: 
110: // Difference returns a new set containing elements in s but not in other.
111: func (s Set[T]) Difference(other Set[T]) Set[T] {
112: 	result := make(Set[T])
113: 	for k := range s {
114: 		if !other.Has(k) {
115: 			result[k] = struct{}{}
116: 		}
117: 	}
118: 	return result
119: }
</file>

<file path="scripts/bump-version.sh">
 1: #!/usr/bin/env bash
 2: # =============================================================================
 3: # NFTBan Version Bumper
 4: # =============================================================================
 5: # Automatically bumps version number in the VERSION file
 6: #
 7: # Usage:
 8: #   ./scripts/bump-version.sh major    # 1.0.5 -> 2.0.0
 9: #   ./scripts/bump-version.sh minor    # 1.0.5 -> 1.1.0
10: #   ./scripts/bump-version.sh patch    # 1.0.5 -> 1.0.6
11: #   ./scripts/bump-version.sh 1.2.3    # Set to specific version
12: # =============================================================================
13: 
14: set -euo pipefail
15: 
16: SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
17: VERSION_FILE="$SCRIPT_DIR/../VERSION"
18: 
19: # Read current version
20: CURRENT=$(cat "$VERSION_FILE" | tr -d '[:space:]')
21: 
22: # Parse version
23: IFS='.' read -r MAJOR MINOR PATCH <<< "$CURRENT"
24: 
25: # Determine new version
26: case "${1:-patch}" in
27:     major)
28:         NEW_VERSION="$((MAJOR + 1)).0.0"
29:         ;;
30:     minor)
31:         NEW_VERSION="$MAJOR.$((MINOR + 1)).0"
32:         ;;
33:     patch)
34:         NEW_VERSION="$MAJOR.$MINOR.$((PATCH + 1))"
35:         ;;
36:     [0-9]*)
37:         NEW_VERSION="$1"
38:         ;;
39:     *)
40:         echo "Usage: $0 {major|minor|patch|X.Y.Z}"
41:         echo "Current version: $CURRENT"
42:         exit 1
43:         ;;
44: esac
45: 
46: echo "Bumping version: $CURRENT → $NEW_VERSION"
47: 
48: # Update VERSION file
49: echo "$NEW_VERSION" > "$VERSION_FILE"
50: 
51: echo "✅ VERSION file updated to $NEW_VERSION"
52: echo ""
53: echo "Next steps:"
54: echo "  1. Review changes: git diff VERSION"
55: echo "  2. Commit: git add VERSION && git commit -m \"chore: Bump version to $NEW_VERSION\""
56: echo "  3. Tag: git tag v$NEW_VERSION && git push origin v$NEW_VERSION"
57: echo ""
58: echo "The version will be automatically used in:"
59: echo "  - Go binaries (via ldflags)"
60: echo "  - Bash scripts (via version.sh)"
61: echo "  - RPM packages (via build_nftban.sh)"
62: echo "  - DEB packages (via build_nftban.sh)"
</file>

<file path="scripts/export_cli_inventory.sh">
  1: #!/bin/bash
  2: # =============================================================================
  3: # NFTBan CLI Inventory Export Script
  4: # =============================================================================
  5: # Exports all CLI commands with metadata to various formats
  6: #
  7: # Usage:
  8: #   ./export_cli_inventory.sh [format]
  9: #
 10: # Formats:
 11: #   table    - Markdown table (default)
 12: #   json     - JSON output
 13: #   list     - Simple command list
 14: #   help     - Export all help text
 15: #
 16: # =============================================================================
 17: 
 18: set -euo pipefail
 19: 
 20: CLI_DIR="${NFTBAN_LIB_DIR:-/usr/lib/nftban}/cli"
 21: FORMAT="${1:-table}"
 22: 
 23: # Fallback for development environment
 24: if [[ ! -d "$CLI_DIR" ]]; then
 25:     CLI_DIR="/home/gituser/github/nftban-v1.0-dev/cli/lib/nftban/cli"
 26: fi
 27: 
 28: if [[ ! -d "$CLI_DIR" ]]; then
 29:     echo "ERROR: CLI directory not found: $CLI_DIR" >&2
 30:     exit 1
 31: fi
 32: 
 33: # Count commands
 34: CMD_COUNT=$(ls "$CLI_DIR"/cmd_*.sh 2>/dev/null | wc -l)
 35: 
 36: case "$FORMAT" in
 37:     list)
 38:         # Simple command list
 39:         for cmd_file in "$CLI_DIR"/cmd_*.sh; do
 40:             basename "$cmd_file" .sh | sed 's/cmd_//' | sed 's/_/-/g'
 41:         done | sort
 42:         ;;
 43: 
 44:     json)
 45:         # JSON output
 46:         echo "{"
 47:         echo '  "version": "1.0.0",'
 48:         echo '  "generated": "'"$(date -Iseconds)"'",'
 49:         echo '  "total_commands": '$CMD_COUNT','
 50:         echo '  "commands": ['
 51: 
 52:         first=true
 53:         for cmd_file in "$CLI_DIR"/cmd_*.sh; do
 54:             name=$(basename "$cmd_file" .sh | sed 's/cmd_//' | sed 's/_/-/g')
 55:             desc=$(grep -oP 'meta:description=\K.*' "$cmd_file" 2>/dev/null | head -1 || echo "")
 56:             ver=$(grep -oP 'meta:version=\K[0-9.]+' "$cmd_file" 2>/dev/null | head -1 || echo "1.0.0")
 57: 
 58:             [[ "$first" != "true" ]] && echo ","
 59:             first=false
 60: 
 61:             # Escape quotes in description
 62:             desc=$(echo "$desc" | sed 's/"/\\"/g')
 63: 
 64:             printf '    {"name": "%s", "version": "%s", "description": "%s"}' \
 65:                 "$name" "$ver" "$desc"
 66:         done
 67: 
 68:         echo ""
 69:         echo "  ]"
 70:         echo "}"
 71:         ;;
 72: 
 73:     help)
 74:         # Export all help text
 75:         OUTPUT_DIR="${2:-/tmp/nftban_help_export}"
 76:         mkdir -p "$OUTPUT_DIR"
 77: 
 78:         echo "Exporting help text to: $OUTPUT_DIR"
 79:         echo ""
 80: 
 81:         for cmd_file in "$CLI_DIR"/cmd_*.sh; do
 82:             cmd_name=$(basename "$cmd_file" .sh | sed 's/cmd_//' | sed 's/_/-/g')
 83:             echo "  Exporting: nftban $cmd_name"
 84: 
 85:             # Source and extract help
 86:             (
 87:                 export NFTBAN_LIB_DIR="${NFTBAN_LIB_DIR:-/usr/lib/nftban}"
 88:                 [[ -f /etc/nftban/nftban.conf ]] && source /etc/nftban/nftban.conf 2>/dev/null || true
 89:                 # shellcheck source=/dev/null
 90:                 source "$cmd_file" 2>/dev/null || true
 91: 
 92:                 # Try different help function patterns
 93:                 func_name="${cmd_name//-/_}"
 94:                 for func in "_nftban_${func_name}_help" "show_${func_name}_help" "show_usage"; do
 95:                     if declare -f "$func" >/dev/null 2>&1; then
 96:                         "$func" 2>/dev/null
 97:                         exit 0
 98:                     fi
 99:                 done
100:                 echo "No help function found"
101:             ) > "$OUTPUT_DIR/${cmd_name}.txt" 2>/dev/null || echo "  (error)"
102:         done
103: 
104:         echo ""
105:         echo "Exported $CMD_COUNT commands to: $OUTPUT_DIR"
106:         ;;
107: 
108:     table|*)
109:         # Markdown table (default)
110:         echo "# NFTBan CLI Commands"
111:         echo ""
112:         echo "**Total Commands:** $CMD_COUNT"
113:         echo "**Generated:** $(date '+%Y-%m-%d %H:%M:%S')"
114:         echo ""
115:         echo "| Command | Version | Description |"
116:         echo "|---------|---------|-------------|"
117: 
118:         for cmd_file in "$CLI_DIR"/cmd_*.sh; do
119:             name=$(basename "$cmd_file" .sh | sed 's/cmd_//' | sed 's/_/-/g')
120:             desc=$(grep -oP 'meta:description=\K.*' "$cmd_file" 2>/dev/null | head -1 || echo "-")
121:             ver=$(grep -oP 'meta:version=\K[0-9.]+' "$cmd_file" 2>/dev/null | head -1 || echo "1.0.0")
122: 
123:             echo "| \`nftban $name\` | $ver | $desc |"
124:         done | sort
125:         ;;
126: esac
</file>

<file path="scripts/test_installation.sh">
  1: #!/bin/bash
  2: # =============================================================================
  3: # NFTBan Installation Verification Script
  4: # =============================================================================
  5: # Tests that installation completed correctly
  6: #
  7: # Usage: ./scripts/test_installation.sh [mode]
  8: #        mode: cli (default), gui, all
  9: #
 10: # =============================================================================
 11: 
 12: set -uo pipefail
 13: 
 14: GREEN='\033[0;32m'
 15: RED='\033[0;31m'
 16: YELLOW='\033[1;33m'
 17: BLUE='\033[0;34m'
 18: NC='\033[0m'
 19: 
 20: MODE="${1:-cli}"
 21: ERRORS=0
 22: WARNINGS=0
 23: TESTS=0
 24: 
 25: pass() { echo -e "${GREEN}[PASS]${NC} $*"; ((TESTS++)); }
 26: fail() { echo -e "${RED}[FAIL]${NC} $*"; ((ERRORS++)); ((TESTS++)); }
 27: warn() { echo -e "${YELLOW}[WARN]${NC} $*"; ((WARNINGS++)); }
 28: info() { echo -e "${BLUE}[INFO]${NC} $*"; }
 29: 
 30: check_file() {
 31:     local file="$1"
 32:     local desc="${2:-$file}"
 33:     if [[ -f "$file" ]]; then
 34:         pass "$desc exists"
 35:         return 0
 36:     else
 37:         fail "$desc MISSING"
 38:         return 1
 39:     fi
 40: }
 41: 
 42: check_dir() {
 43:     local dir="$1"
 44:     local desc="${2:-$dir}"
 45:     if [[ -d "$dir" ]]; then
 46:         pass "$desc exists"
 47:         return 0
 48:     else
 49:         fail "$desc MISSING"
 50:         return 1
 51:     fi
 52: }
 53: 
 54: check_command() {
 55:     local cmd="$1"
 56:     local desc="${2:-$cmd}"
 57:     if command -v "$cmd" &>/dev/null; then
 58:         pass "$desc available"
 59:         return 0
 60:     else
 61:         fail "$desc NOT FOUND"
 62:         return 1
 63:     fi
 64: }
 65: 
 66: check_service() {
 67:     local svc="$1"
 68:     if systemctl is-enabled "$svc" &>/dev/null; then
 69:         pass "Service $svc enabled"
 70:     else
 71:         warn "Service $svc not enabled"
 72:     fi
 73: }
 74: 
 75: echo "=============================================="
 76: echo "NFTBan Installation Verification"
 77: echo "=============================================="
 78: echo "Mode: $MODE"
 79: echo "Date: $(date)"
 80: echo ""
 81: 
 82: # -----------------------------------------------------------------------------
 83: # 1. BINARIES
 84: # -----------------------------------------------------------------------------
 85: info "=== Checking Binaries ==="
 86: 
 87: check_file "/usr/bin/nftban" "Main CLI"
 88: 
 89: if [[ "$MODE" == "all" || "$MODE" == "gui" ]]; then
 90:     check_file "/usr/lib/nftban/bin/nftban-core" "nftban-core binary"
 91: fi
 92: 
 93: if [[ "$MODE" == "gui" ]]; then
 94:     check_file "/usr/sbin/nftban-ui" "nftban-ui binary"
 95: fi
 96: 
 97: echo ""
 98: 
 99: # -----------------------------------------------------------------------------
100: # 2. LIBRARIES
101: # -----------------------------------------------------------------------------
102: info "=== Checking Libraries ==="
103: 
104: check_dir "/usr/lib/nftban" "Library directory"
105: check_dir "/usr/lib/nftban/cli" "CLI handlers"
106: check_dir "/usr/lib/nftban/core" "Core modules"
107: check_dir "/usr/lib/nftban/helpers" "Helper scripts"
108: check_dir "/usr/lib/nftban/lib" "Shared libs"
109: 
110: # Count CLI commands
111: CLI_COUNT=$(ls -1 /usr/lib/nftban/cli/cmd_*.sh 2>/dev/null | wc -l)
112: if [[ $CLI_COUNT -ge 40 ]]; then
113:     pass "CLI commands: $CLI_COUNT (expected 43)"
114: else
115:     fail "CLI commands: $CLI_COUNT (expected 43)"
116: fi
117: 
118: echo ""
119: 
120: # -----------------------------------------------------------------------------
121: # 3. CONFIGURATION
122: # -----------------------------------------------------------------------------
123: info "=== Checking Configuration ==="
124: 
125: check_dir "/etc/nftban" "Config directory"
126: check_file "/etc/nftban/nftban.conf" "Main config"
127: check_dir "/etc/nftban/conf.d" "Config drop-in"
128: 
129: echo ""
130: 
131: # -----------------------------------------------------------------------------
132: # 4. DATA DIRECTORIES
133: # -----------------------------------------------------------------------------
134: info "=== Checking Data Directories ==="
135: 
136: check_dir "/var/lib/nftban" "Data directory"
137: check_dir "/var/log/nftban" "Log directory"
138: check_dir "/var/cache/nftban" "Cache directory"
139: 
140: echo ""
141: 
142: # -----------------------------------------------------------------------------
143: # 5. USER/GROUP
144: # -----------------------------------------------------------------------------
145: info "=== Checking User/Group ==="
146: 
147: if id nftban &>/dev/null; then
148:     pass "User 'nftban' exists"
149: else
150:     fail "User 'nftban' MISSING"
151: fi
152: 
153: if getent group nftban &>/dev/null; then
154:     pass "Group 'nftban' exists"
155: else
156:     fail "Group 'nftban' MISSING"
157: fi
158: 
159: # v1.0: 2-group model - nftban handles both CLI and Web GUI
160: if getent group nftban-auditors &>/dev/null; then
161:     pass "Group 'nftban-auditors' exists"
162: else
163:     warn "Group 'nftban-auditors' missing (auditors only)"
164: fi
165: 
166: echo ""
167: 
168: # -----------------------------------------------------------------------------
169: # 6. NFTABLES
170: # -----------------------------------------------------------------------------
171: info "=== Checking NFTables ==="
172: 
173: if nft list table ip nftban &>/dev/null; then
174:     pass "Table 'ip nftban' exists"
175: else
176:     fail "Table 'ip nftban' MISSING"
177: fi
178: 
179: if nft list table ip6 nftban &>/dev/null; then
180:     pass "Table 'ip6 nftban' exists"
181: else
182:     warn "Table 'ip6 nftban' missing (optional)"
183: fi
184: 
185: echo ""
186: 
187: # -----------------------------------------------------------------------------
188: # 7. SYSTEMD
189: # -----------------------------------------------------------------------------
190: info "=== Checking Systemd ==="
191: 
192: check_service "nftban-health.timer"
193: 
194: if [[ "$MODE" == "gui" ]]; then
195:     check_service "nftban-ui"
196: fi
197: 
198: echo ""
199: 
200: # -----------------------------------------------------------------------------
201: # 8. CLI FUNCTIONALITY
202: # -----------------------------------------------------------------------------
203: info "=== Testing CLI ==="
204: 
205: if nftban version &>/dev/null; then
206:     VERSION=$(nftban version 2>/dev/null | grep -oP 'v?\d+\.\d+\.\d+' | head -1 || echo "unknown")
207:     pass "nftban version: $VERSION"
208: else
209:     fail "nftban version FAILED"
210: fi
211: 
212: if nftban help &>/dev/null; then
213:     pass "nftban help works"
214: else
215:     fail "nftban help FAILED"
216: fi
217: 
218: # Quick smoke test
219: if timeout 10 nftban health summary &>/dev/null; then
220:     pass "nftban health summary works"
221: else
222:     warn "nftban health summary failed or timed out"
223: fi
224: 
225: echo ""
226: 
227: # -----------------------------------------------------------------------------
228: # 9. PERMISSIONS
229: # -----------------------------------------------------------------------------
230: info "=== Checking Permissions ==="
231: 
232: # Check /etc/nftban ownership
233: CONF_OWNER=$(stat -c '%U:%G' /etc/nftban 2>/dev/null || echo "unknown")
234: if [[ "$CONF_OWNER" == "root:nftban" ]]; then
235:     pass "/etc/nftban ownership: $CONF_OWNER"
236: else
237:     warn "/etc/nftban ownership: $CONF_OWNER (expected root:nftban)"
238: fi
239: 
240: # Check /var/lib/nftban ownership
241: DATA_OWNER=$(stat -c '%U:%G' /var/lib/nftban 2>/dev/null || echo "unknown")
242: if [[ "$DATA_OWNER" == "nftban:nftban" ]]; then
243:     pass "/var/lib/nftban ownership: $DATA_OWNER"
244: else
245:     warn "/var/lib/nftban ownership: $DATA_OWNER (expected nftban:nftban)"
246: fi
247: 
248: echo ""
249: 
250: # -----------------------------------------------------------------------------
251: # SUMMARY
252: # -----------------------------------------------------------------------------
253: echo "=============================================="
254: echo "VERIFICATION SUMMARY"
255: echo "=============================================="
256: echo ""
257: echo "Tests:    $TESTS"
258: echo "Passed:   $((TESTS - ERRORS))"
259: echo "Failed:   $ERRORS"
260: echo "Warnings: $WARNINGS"
261: echo ""
262: 
263: if [[ $ERRORS -eq 0 ]]; then
264:     echo -e "${GREEN}SUCCESS: Installation verified!${NC}"
265:     echo ""
266:     echo "Next steps:"
267:     echo "  nftban status"
268:     echo "  nftban smoke quick"
269:     exit 0
270: else
271:     echo -e "${RED}FAILED: $ERRORS errors found${NC}"
272:     echo ""
273:     echo "Please fix the errors and re-run verification."
274:     exit 1
275: fi
</file>

<file path="scripts/update_man_page.sh">
  1: #!/bin/bash
  2: # =============================================================================
  3: # NFTBan Man Page Update Script
  4: # =============================================================================
  5: # Updates man page version, date, and optionally adds new commands
  6: #
  7: # Usage:
  8: #   ./update_man_page.sh version <version>     - Update version number
  9: #   ./update_man_page.sh preview               - Preview man page
 10: #   ./update_man_page.sh install               - Install man page
 11: #   ./update_man_page.sh check                 - Check for syntax errors
 12: #   ./update_man_page.sh add <command>         - Generate section for new command
 13: #
 14: # =============================================================================
 15: 
 16: set -euo pipefail
 17: 
 18: SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
 19: PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
 20: MAN_SOURCE="$PROJECT_DIR/install/man/man8/nftban.8"
 21: MAN_DEST="/usr/share/man/man8/nftban.8"
 22: 
 23: ACTION="${1:-help}"
 24: 
 25: case "$ACTION" in
 26:     version)
 27:         VERSION="${2:-}"
 28:         if [[ -z "$VERSION" ]]; then
 29:             echo "Usage: $0 version <version>"
 30:             echo "Example: $0 version 1.0.1"
 31:             exit 1
 32:         fi
 33: 
 34:         DATE=$(date "+%B %Y")
 35: 

# =============================================================================
# NFTBan Bot Scanner - Directory/File Scanner Patterns
# =============================================================================
# Format: NAME|PATTERN|MATCH_TYPE|THRESHOLD|WINDOW|BAN|ENABLED|DESCRIPTION
# v1.234.0 match types (generic; see nftban_botscan_match_url_g):
#   url-404/url-any/url-get/url-post   regex on the full request target (path + query); every
#                                       matching request counts (exploit payloads, rate abuse)
#   path-404/path-any/path-get/path-post  regex on the request PATH only (query excluded);
#                                       every matching request counts (exploit routes)
#   distinct-404/-any/-get/-post        regex on the full target; each DISTINCT target counts
#                                       once per IP (probing and enumeration are evidenced by
#                                       variety; one URL requested repeatedly is ordinary
#                                       application activity). Write route boundaries into the
#                                       regex, e.g. `/x(\?|$)`.
#   useragent                           regex on the User-Agent; every request counts
# THRESHOLD/WINDOW are evaluated in REQUEST time (the line's own timestamp): THRESHOLD events
# within any WINDOW-second span.
# =============================================================================

# -----------------------------------------------------------------------------
# Backup File Scanners
# -----------------------------------------------------------------------------
SCAN_BACKUP_ZIP|\.zip(\?|$)|distinct-404|5|60|1800|true|ZIP backup probe
SCAN_BACKUP_TAR|\.tar\.gz(\?|$)|distinct-404|5|60|1800|true|TAR backup probe
SCAN_BACKUP_SQL|\.(sql|sql\.gz)(\?|$)|distinct-404|3|60|3600|true|SQL backup probe
SCAN_BACKUP_BAK|\.bak(\?|$)|distinct-404|5|60|1800|true|BAK file probe
SCAN_BACKUP_OLD|\.old(\?|$)|distinct-404|5|60|1800|true|OLD file probe
SCAN_BACKUP_SAVE|\.save(\?|$)|distinct-404|5|60|1800|true|SAVE file probe
SCAN_BACKUP_ORIG|\.orig(\?|$)|distinct-404|5|60|1800|true|ORIG file probe
SCAN_BACKUP_SWP|\.swp(\?|$)|distinct-404|3|60|1800|true|VIM swap probe

# -----------------------------------------------------------------------------
# Admin Panel Scanners
# -----------------------------------------------------------------------------
SCAN_ADMIN|^/admin|distinct-404|10|60|1800|true|Admin panel probe
SCAN_ADMINISTRATOR|/administrator|distinct-404|5|60|1800|true|Administrator probe
SCAN_CPANEL|/cpanel|distinct-404|3|60|1800|true|cPanel probe
SCAN_PLESK|/plesk|distinct-404|3|60|1800|true|Plesk probe
SCAN_WEBMIN|/webmin|distinct-404|3|60|1800|true|Webmin probe
SCAN_MANAGER|/manager|distinct-404|5|60|1800|true|Manager probe
SCAN_CONSOLE|/console|distinct-404|5|60|1800|true|Console probe
SCAN_DASHBOARD|/dashboard|distinct-404|10|60|1800|true|Dashboard probe

# -----------------------------------------------------------------------------
# Directory Scanners (common dirb/dirbuster patterns)
# -----------------------------------------------------------------------------
SCAN_HIDDEN|^/\.[a-z]|distinct-404|10|60|1800|true|Hidden file probe
SCAN_DEV|^/dev|distinct-404|10|60|1800|true|Dev directory probe
SCAN_TEST|^/test|distinct-404|10|60|1800|true|Test directory probe
SCAN_TMP|^/tmp|distinct-404|5|60|1800|true|Tmp directory probe
SCAN_TEMP|^/temp|distinct-404|5|60|1800|true|Temp directory probe
SCAN_LOGS|^/logs|distinct-404|5|60|1800|true|Logs directory probe
SCAN_BACKUP|^/backup|distinct-404|5|60|1800|true|Backup directory probe
SCAN_DATA|^/data|distinct-404|10|60|1800|true|Data directory probe
SCAN_CONFIG|^/config|distinct-404|5|60|1800|true|Config directory probe

# -----------------------------------------------------------------------------
# Version Control Exposure
# -----------------------------------------------------------------------------
SCAN_GIT|/\.git/|url-any|2|60|7200|true|Git repo exposure
SCAN_SVN|/\.svn/|url-any|2|60|7200|true|SVN repo exposure
SCAN_HG|/\.hg/|url-any|2|60|7200|true|Mercurial repo exposure
SCAN_CVS|/CVS/|url-any|3|60|3600|true|CVS repo exposure

# -----------------------------------------------------------------------------
# Install/Setup Scanners
# -----------------------------------------------------------------------------
SCAN_INSTALL|/install\.php|distinct-404|3|60|1800|true|Install script probe
SCAN_SETUP|/setup\.php|distinct-404|3|60|1800|true|Setup script probe
SCAN_INSTALLER|/installer|distinct-404|5|60|1800|true|Installer probe
SCAN_UPGRADE|/upgrade\.php|distinct-404|3|60|1800|true|Upgrade script probe

# -----------------------------------------------------------------------------
# API/Endpoint Scanners
# -----------------------------------------------------------------------------
SCAN_API|^/api/|distinct-404|20|60|1800|true|API endpoint probe
SCAN_V1|^/v1/|distinct-404|10|60|1800|true|API v1 probe
SCAN_V2|^/v2/|distinct-404|10|60|1800|true|API v2 probe
SCAN_REST|^/rest/|distinct-404|10|60|1800|true|REST endpoint probe
SCAN_AJAX|^/ajax|distinct-404|15|60|1800|true|AJAX endpoint probe

# -----------------------------------------------------------------------------
# Well-Known Path Abuse
# -----------------------------------------------------------------------------
SCAN_WELLKNOWN|/\.well-known/.*[^a-z-]|distinct-404|5|60|1800|true|Well-known abuse
SCAN_ACME|/\.well-known/acme-challenge/.*\.php|url-any|1|60|7200|true|ACME PHP probe

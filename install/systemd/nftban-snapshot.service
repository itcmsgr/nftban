[Unit]
Description=NFTBan Configuration Snapshot Service
Documentation=man:nftban(8)
Documentation=https://nftban.com/docs
After=network-online.target nftables.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/nftban snapshot create
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nftban-snapshot

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/etc/nftban /var/lib/nftban /var/log/nftban

# Resource limits
TimeoutStartSec=2min

[Install]
WantedBy=multi-user.target

466: nftban_port_render_table() {
467:     # Render port report as terminal table or JSON
468:     # Uses: NFTBAN_PORT_OUTPUT_FORMAT, NFTBAN_PORT_DETAILED, NFTBAN_PORT_FILTER_PORTS
469: 
470:     # Handle JSON output first (early return)
471:     if [[ "$NFTBAN_PORT_OUTPUT_FORMAT" == "json" ]]; then
472:         nftban_port_render_json
473:         return $?
474:     fi
475: 
476:     if [[ "$NFTBAN_PORT_OUTPUT_FORMAT" == "table" ]]; then
477:         local short_ts
478:         short_ts=$(date +"%Y-%m-%d %H:%M")
479:         echo ""
480:         echo "╔══════════════════════════════════════════════════════════════════════════════════╗"
481:         printf "║  Port Status                    %-12s                                      ║\n" "$short_ts"
482:         echo "╚══════════════════════════════════════════════════════════════════════════════════╝"
483:         echo ""
484:         if (( NFTBAN_PORT_DETAILED )); then
485:             printf "%-12s %-10s %-10s %-12s %-20s %-9s %-9s %-9s %-9s %-12s\n" \
486:                 "PORT/PROTO" "SERVICE" "STATUS" "BIND" "PROCESS" "IPv4 IN" "IPv4 OUT" "IPv6 IN" "IPv6 OUT" "ACCESS"
487:         else
488:             printf "%-12s %-10s %-10s %-9s %-9s %-9s %-9s %-12s\n" \
489:                 "PORT/PROTO" "SERVICE" "STATUS" "IPv4 IN" "IPv4 OUT" "IPv6 IN" "IPv6 OUT" "ACCESS"
490:         fi
491:         echo "──────────────────────────────────────────────────────────────────────────────────"
492:     elif [[ "$NFTBAN_PORT_OUTPUT_FORMAT" == "md" ]]; then
493:         if (( NFTBAN_PORT_DETAILED )); then
494:             echo "| SERVICE | PORT | PROTO | RUNNING | BIND | PROCESS | IPv4 IN | IPv4 OUT | IPv6 IN | IPv6 OUT | NOTES |"
495:             echo "|---:|---:|:---:|:---:|:---|:---|:---:|:---:|:---:|:---:|:---|"
496:         else
497:             echo "| SERVICE | PORT | PROTO | RUNNING | IPv4 IN | IPv4 OUT | IPv6 IN | IPv6 OUT | NOTES |"
498:             echo "|---:|---:|:---:|:---:|:---:|:---:|:---:|:---:|:---|"
499:         fi
500:     elif [[ "$NFTBAN_PORT_OUTPUT_FORMAT" == "csv" ]]; then
501:         if (( NFTBAN_PORT_DETAILED )); then
502:             echo "SERVICE,PORT,PROTO,RUNNING,BIND,PROCESS,IPv4 IN,IPv4 OUT,IPv6 IN,IPv6 OUT,NOTES"
503:         else
504:             echo "SERVICE,PORT,PROTO,RUNNING,IPv4 IN,IPv4 OUT,IPv6 IN,IPv6 OUT,NOTES"
505:         fi
506:     fi
507: 
508:     # Parse filter ports if provided
509:     local -a filter_ports_arr=()
510:     if [[ -n "$NFTBAN_PORT_FILTER_PORTS" ]]; then
511:         IFS=',' read -ra filter_ports_arr <<< "$NFTBAN_PORT_FILTER_PORTS"
512:     fi
513: 
514:     # Sorted iteration
515:     local -a keys=()
516:     local k
517:     for k in "${!NFTBAN_PORT_SEEN[@]}"; do keys+=("$k"); done
518:     IFS=$'\n' read -r -d '' -a sorted < <(printf '%s\n' "${keys[@]}" | sort -t_ -k1n -k2 && printf '\0') || true
519: 
520:     local entry
521:     for entry in "${sorted[@]}"; do
522:         local port="${entry%%_*}" proto="${entry##*_}"
523: 
524:         # Filter (if any)
525:         if [[ ${#filter_ports_arr[@]} -gt 0 ]]; then
526:             local match=0 pf
527:             for pf in "${filter_ports_arr[@]}"; do
528:                 [[ "$pf" == "$port" ]] && match=1
529:             done
530:             (( match == 1 )) || continue
531:         fi
532: 
533:         local svcinfo
534:         svcinfo="$(nftban_port_detect_service "$port" "$proto")"
535:         local svc running procinfo bind scope
536:         svc="$(cut -d'|' -f1 <<<"$svcinfo")"
537:         running="$(cut -d'|' -f2 <<<"$svcinfo")"
538:         procinfo="$(cut -d'|' -f3 <<<"$svcinfo")"
539:         bind="$(cut -d'|' -f4 <<<"$svcinfo")"
540:         scope="$(cut -d'|' -f5 <<<"$svcinfo")"
541: 
542:         # Show port if EITHER: (1) service is listening, OR (2) port is in firewall rules
543:         # This ensures user-added ports show up even if nothing is listening yet
544:         local in_firewall=false
545:         if [[ -n "${NFTBAN_PORT_NFT_GENERIC["${port}_${proto}_input"]+x}" ]] || \
546:            [[ -n "${NFTBAN_PORT_NFT_RULES["${port}_${proto}_input_ipv4"]+x}" ]] || \
547:            [[ -n "${NFTBAN_PORT_NFT_RULES["${port}_${proto}_input_ipv6"]+x}" ]]; then
548:             in_firewall=true
549:         fi
550: 
551:         # Skip only if: NOT listening AND NOT in firewall
552:         if [[ "$running" != "yes" ]] && [[ "$in_firewall" == "false" ]]; then
553:             continue
554:         fi
555: 
556:         local status_line
557:         status_line="$(nftban_port_determine_status "$port" "$proto")"
558:         local v4in v4out v6in v6out notes
559:         v4in="$(cut -d'|' -f1 <<< "$status_line")"
560:         v4out="$(cut -d'|' -f2 <<< "$status_line")"
561:         v6in="$(cut -d'|' -f3 <<< "$status_line")"
562:         v6out="$(cut -d'|' -f4 <<< "$status_line")"
563:         notes="$(cut -d'|' -f5 <<< "$status_line")"
564:         [[ -n "$scope" ]] && notes="$(nftban_port_trim "$notes $scope")"
565: 
566:         badge() {
567:             case "$1" in
568:                 Allowed) echo -e "${C_GREEN:-}✔${C_RESET:-}" ;;
569:                 Blocked) echo -e "${C_RED:-}✖${C_RESET:-}" ;;
570:                 "No-rule") echo -e "${C_YELLOW:-}−${C_RESET:-}" ;;
571:                 Unknown) echo -e "${C_YELLOW:-}?${C_RESET:-}" ;;
572:                 *) echo "$1" ;;
573:             esac
574:         }
575: 
576:         access_icon() {
577:             local scope_notes="$1"
578: 
579:             # If service not running, no access
580:             if [[ "$running" != "yes" ]]; then
581:                 echo "−"
582:                 return
583:             fi
584: 
585:             # If bound to localhost only, always local
586:             if [[ "$scope_notes" == *"LOCAL-ONLY"* ]] || [[ "$scope_notes" == *"local"* ]]; then
587:                 echo "🔒 Local"
588:                 return
589:             fi
590: 
591:             # If firewall explicitly allows (port in nftables sets), it's public
592:             if [[ "$v4in" == "Allowed" ]] || [[ "$v6in" == "Allowed" ]]; then
593:                 echo "🌍 Public"
594:                 return
595:             fi
596: 
597:             # Service is running, bound to public interface, but NOT in firewall allow list
598:             # This means default deny policy blocks it
599:             if [[ "$scope_notes" == *"PUBLIC"* ]] || [[ "$scope_notes" == *"public"* ]]; then
600:                 echo "❌ Blocked"
601:                 return
602:             fi
603: 
604:             # Fallback
605:             echo "−"
606:         }
607: 
608:         status_icon() {
609:             local run="$1"
610:             if [[ "$run" == "yes" ]]; then
611:                 echo -e "${C_GREEN:-}✓ Running${C_RESET:-}"
612:             else
613:                 echo -e "${C_YELLOW:-}− Stopped${C_RESET:-}"
614:             fi
615:         }
616: 
617:         # Add note if port is open but not listening
618:         if [[ "$running" != "yes" ]] && [[ "$in_firewall" == "true" ]]; then
619:             notes="$(nftban_port_trim "$notes OPEN-NO-LISTENER")"
620:         fi
621: 
622:         if [[ "$NFTBAN_PORT_OUTPUT_FORMAT" == "table" ]]; then
623:             local port_proto="${port}/${proto^^}"  # Combine port/proto as "22/TCP"
624:             local status_display access_display
625:             status_display="$(status_icon "$running")"
626:             access_display="$(access_icon "$notes")"
627: 
628:             if (( NFTBAN_PORT_DETAILED )); then
629:                 printf "%-12s %-10s %-10s %-12s %-20s %-9s %-9s %-9s %-9s %-12s\n" \
630:                     "$port_proto" "$svc" "$status_display" "${bind:-?}" "${procinfo:-?}" \
631:                     "$(badge "$v4in")" "$(badge "$v4out")" "$(badge "$v6in")" "$(badge "$v6out")" "$access_display"
632:             else
633:                 printf "%-12s %-10s %-10s %-9s %-9s %-9s %-9s %-12s\n" \
634:                     "$port_proto" "$svc" "$status_display" \
635:                     "$(badge "$v4in")" "$(badge "$v4out")" "$(badge "$v6in")" "$(badge "$v6out")" "$access_display"
636:             fi
637:         elif [[ "$NFTBAN_PORT_OUTPUT_FORMAT" == "md" ]]; then
638:             if (( NFTBAN_PORT_DETAILED )); then
639:                 printf "| %s | %s | %s | %s | %s | %s | %s | %s | %s | %s | %s |\n" \
640:                     "$svc" "$port" "$proto" "$running" "${bind:-?}" "${procinfo:-?}" \
641:                     "$v4in" "$v4out" "$v6in" "$v6out" "$(nftban_port_trim "$notes")"
642:             else
643:                 printf "| %s | %s | %s | %s | %s | %s | %s | %s | %s |\n" \
644:                     "$svc" "$port" "$proto" "$running" "$v4in" "$v4out" "$v6in" "$v6out" "$(nftban_port_trim "$notes")"
645:             fi
646:         else # csv
647:             if (( NFTBAN_PORT_DETAILED )); then
648:                 printf "%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s\n" \
649:                     "$svc" "$port" "$proto" "$running" "\"${bind:-}\"" "\"${procinfo:-}\"" \
650:                     "$v4in" "$v4out" "$v6in" "$v6out" "\"$(nftban_port_trim "$notes")\""
651:             else
652:                 printf "%s,%s,%s,%s,%s,%s,%s,%s,%s\n" \
653:                     "$svc" "$port" "$proto" "$running" "$v4in" "$v4out" "$v6in" "$v6out" "\"$(nftban_port_trim "$notes")\""
654:             fi
655:         fi
656:     done
657: 
658:     if [[ "$NFTBAN_PORT_OUTPUT_FORMAT" == "table" ]]; then
659:         echo
660:         echo "Firewall Rules:"
661:         echo -e "  ${C_GREEN:-}✔${C_RESET:-} Allowed   ${C_RED:-}✖${C_RESET:-} Blocked   ${C_YELLOW:-}−${C_RESET:-} No-rule"
662:         echo
663:         echo "Access:"
664:         echo "  🌍 Public   - Accessible from internet"
665:         echo "  🔒 Local    - Localhost only"
666:         echo "  ❌ Blocked  - Firewall blocked"
667:         echo
668:     fi
669: }

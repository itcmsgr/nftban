# =============================================================================
# NFTBan v1.0.0 - Maintenance Service (Always Active)
# =============================================================================
# SPDX-License-Identifier: MPL-2.0
# Purpose: Critical maintenance tasks that run even when NFTBan is disabled
#
# This service performs safety-critical checks:
#   - SSH port monitoring (prevents lockout)
#   - System IP monitoring (updates whitelists)
#   - Autoheal (fixes permissions, creates directories)
#   - Configuration validation
#
# Runs every 15 minutes via nftban-maintenance.timer
# =============================================================================

[Unit]
Description=NFTBan Maintenance Service (Safety Checks)
Documentation=https://nftban.com/docs/maintenance
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root

# Run maintenance script
ExecStart=/usr/lib/nftban/cron/maintenance.sh

# Security hardening
NoNewPrivileges=yes
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true

# Allow only required write locations (maintenance.sh writes to specific paths)
ReadWritePaths=/var/lib/nftban /var/log/nftban /var/cache/nftban /run/nftban /etc/nftban/ports.d /etc/nftban/whitelist.d

# Allow netlink + network access (used by nft, curl, ss, ip commands)
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# Resource limits
CPUQuota=50%
MemoryMax=256M
TasksMax=20

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nftban-maintenance

# Restart on failure
Restart=on-failure
RestartSec=5min

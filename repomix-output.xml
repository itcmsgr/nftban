1078:             fi
1079:         fi
1080:     fi
1081: 
1082:     # Store results
1083:     if [[ ${#config_issues[@]} -gt 0 ]]; then
1084:         NFTBAN_HEALTH_ISSUES["config"]="${config_issues[*]}"
1085:         if [[ $status -eq $HEALTH_ERROR ]]; then
1086:             NFTBAN_HEALTH_ERRORS+=("Config issues: ${config_issues[*]}")
1087:         else
1088:             NFTBAN_HEALTH_WARNINGS+=("Config issues: ${config_issues[*]}")

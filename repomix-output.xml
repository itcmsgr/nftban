 818: nftban_login_cmd_digest() {
 819:     # Manage login digest
 820:     # Usage: nftban login digest <status|send|clear>
 821: 
 822:     local action="${1:-status}"
 823: 
 824:     case "$action" in
 825:         status)
 826:             local digest_file="${NFTBAN_LOGIN_DIGEST_FILE:-${NFTBAN_DATA_DIR:-/var/lib/nftban}/login_digest.json}"
 827:             local count=0
 828: 
 829:             if [[ -f "$digest_file" ]] && command -v jq &>/dev/null; then
 830:                 count=$(jq 'length' "$digest_file" 2>/dev/null || echo "0")
 831:             fi
 832: 
 833:             echo "Login Digest Status"
 834:             echo "==================="
 835:             echo ""
 836:             echo "File: $digest_file"
 837:             echo "Pending alerts: $count"
 838:             echo ""
 839: 
 840:             if [[ "$count" -gt 0 ]] && command -v jq &>/dev/null; then
 841:                 echo "Recent alerts:"
 842:                 jq -r '.[-5:] | .[] | "  [\(.timestamp)] \(.user)@\(.ip) - \(.status)"' "$digest_file" 2>/dev/null || true
 843:             fi
 844:             ;;
 845:         send)
 846:             echo "Sending login digest..."
 847:             if type -t nftban_login_digest_send >/dev/null 2>&1; then
 848:                 nftban_login_digest_send
 849:             else
 850:                 echo "ERROR: Digest send function not available" >&2
 851:                 return 1
 852:             fi
 853:             ;;
 854:         clear)
 855:             echo "Clearing login digest..."
 856:             if type -t nftban_login_digest_clear >/dev/null 2>&1; then
 857:                 nftban_login_digest_clear
 858:                 echo "✅ Digest cleared"
 859:             else
 860:                 local digest_file="${NFTBAN_LOGIN_DIGEST_FILE:-${NFTBAN_DATA_DIR:-/var/lib/nftban}/login_digest.json}"
 861:                 echo "[]" > "$digest_file"
 862:                 echo "✅ Digest cleared"
 863:             fi
 864:             ;;
 865:         *)
 866:             echo "ERROR: Unknown action: $action" >&2
 867:             echo "Usage: nftban login digest <status|send|clear>" >&2
 868:             return 1
 869:             ;;
 870:     esac
 871: }

[DEFAULT]
# A list of IP addresses, CIDR masks or DNS hostnames to be ignored by Fail2ban.
# You can use a separate file for this.
ignoreip.conf = /etc/fail2ban/ignoreip.conf

# This defines a default banaction.
banaction = nftables-multiport

# The time in seconds that a host is banned.
bantime = 48h
# The time frame for maxretry.
findtime = 10m
# The number of failed login attempts before a ban is issued.
maxretry = 5

# Sender and destination email addresses
sender = Fail2Ban@dns1.mywebhost.gr
sendername = Fail2Ban
destemail = support@rotame.com

# This defines a combined action that performs the ban AND sends an email with log lines.
# It uses the ban action defined above and the mta-whois-lines action.
# This is a robust way to ensure both events happen.
#action_mwl = %(banaction)s[name=%(__name__)s, port="%(port)s", protocol="%(protocol)s", chain="%(chain)s"]
#             mail[name=%(__name__)s, dest="%(destemail)s", sender="%(sender)s", mta="%(mta)s", logpath="%(logpath)s"]
action_mwl = %(banaction)s[name=%(__name__)s, port="%(port)s", protocol="%(protocol)s", chain="%(chain)s"]
             sendmail-whois[name=%(__name__)s, dest="%(destemail)s", sender="%(sender)s"]
             itcms-custom-log

# You cannot directly embed shell commands like echo into the jail.local file itself.
# Instead, you must define a separate action file under /etc/fail2ban/action.d/, and then reference that action in your jail configuration.

# This sets the global default action for all jails to the combined ban and email action.
action = %(action_mwl)s

# ==================================
# SSHD Jail
# ==================================
[sshd]
enabled = true
# The port to monitor. "ssh" is the default service name for port 22.
port = ssh
# The filter file to use.
filter = sshd
# The log file to monitor.
logpath = /var/log/secure
#logpath  = /var/log/auth.log   # Debian/Ubuntu
# This jail will inherit all settings from [DEFAULT], including the action.
# No need to specify a separate 'action = ...' line.
bantime = 2d
maxretry = 5
findtime = 10m

# ==================================
# Exim Mail Server Jail
# ==================================
[exim]
enabled = true
maxretry = 15
# The ports for all mail services (SMTP, POP, IMAP)
port = smtp,ssmtp,pop3,pop3s,imap,imaps,http,https
# The log file to monitor
logpath = /var/log/exim/mainlog
# This jail will inherit all settings from [DEFAULT].
bantime = 1d

[exim-spam]
enabled = true
maxretry = 15
# The ports for all mail services (SMTP, POP, IMAP)
port = smtp,ssmtp,pop3,pop3s,imap,imaps,http,https
# The log file to monitor
logpath = /var/log/exim/mainlog
# This jail will inherit all settings from [DEFAULT].

# ==================================
# DirectAdmin Jail
# ==================================
[dalogin]
enabled = true
port = 2222
filter = directadmin
logpath = /var/log/directadmin/login.log
bantime = 1h
maxretry = 5
findtime = 10m
# This jail will inherit all settings from [DEFAULT].

# ==================================
# FTP Pureftpd Jail
# ==================================
[pure-ftpd]
enabled = true
port = ftp,ftp-data,ftps,ftps-data
filter = pure-ftpd
logpath = /var/log/messages
maxretry = 9
findtime = 1200
bantime = 2h
backend = auto
# This jail will inherit all settings from [DEFAULT].
#
#
[roundcube-auth]
enabled = true
port     = http,https
maxretry = 9         ; Number of attempts before a ban
findtime = 600       ; Time window for the attempts (10 minutes)
bantime = 3600       ; Ban time (1 hour)
logpath  = /var/www/html/roundcube/logs/errors.log

[dovecot-itcms]
enabled = true
filter = itcmsgr-dovecot-custom
logpath = /var/log/maillog
maxretry = 9
bantime = 3600
findtime = 600
backend = auto

# ==================================
# Persistent Banned IP Jail
# ==================================
[persistent-offenders-itcms]
enabled = true
# This jail will monitor the log file created by Fail2Ban itself.
logpath = /var/log/itcms-fail2ban.log
# This filter will look for repeat bans.
filter = itcmsgr-persistent-offenders
findtime = 86400
maxretry = 3
bantime = 604800


#===== FOR CHECK DEFAULTS NEED INVESTIGATIONS ==========================
[modsecurity-itcms]
#This check for forbiden messages 403
enabled = true
filter = itcmsgr-modsecurity-custom
port     = http,https
logpath = /var/log/httpd/modsec_audit.log
maxretry = 9         ; Number of attempts before a ban
findtime = 600       ; Time window for the attempts (10 minutes)
bantime = 3600       ; Ban time (1 hour)

#For xml & wp-login csf was 3600 #
[xmlrpc-attack-itcms]
#This check for xmlrpc attacks
enabled = true
port = http,https
filter = itcmsgr-apache-xmlrpc-custom
logpath = /var/log/httpd/domains/*.log
maxretry = 9
findtime = 1200       ; Time window for the attempts (20 minutes)
bantime = 2h

[wp-login-attacks-itcms]
#This check for xmlrpc attacks
enabled = true
port = http,https
filter = itcmsgr-apache-wp-login-custom
logpath = /var/log/httpd/domains/*.log
findtime = 1200       ; Time window for the attempts (20 minutes)
maxretry = 10
bantime = 2h

[apache-scan-attack-itcms]
#common attack pattern known as a reconnaissance scan or file enumeration attack.
#ans IPs that are hitting many non-existent or protected files in a very short amount of time.
enabled = true
port = http,https
filter = itcmsgr-apache-scan-custom
logpath = /var/log/httpd/domains/*.log
maxretry = 10
findtime = 60
bantime = 1h



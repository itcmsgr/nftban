447:     echo "  Commands"
448:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
449:     echo ""
450:     echo "  nftban ddos enable            - Enable DDoS protection"
451:     echo "  nftban ddos disable           - Disable DDoS protection"
452:     echo "  nftban ddos test              - Test protection rules"
453:     echo "  nftban ddos help              - Show all available commands"
454:     echo ""
455: 
456:     return 0
457: }
458: 
459: # =============================================================================
460: # PUBLIC API - TEST (For scripting/automation)
461: # =============================================================================
462: 
463: nftban_ddos_test() {
464:     _nftban_ddos_load_config
465: 
466:     local mode
467:     mode=$(_nftban_ddos_detect_mode)
468: 
469:     echo "mode=$mode"
470:     echo "enabled=$DDOS_ENABLED"
471:     echo "configured_mode=$DDOS_MODE"
472: 
473:     if type -t nftban_ddos_suricata_is_available &>/dev/null; then
474:         if nftban_ddos_suricata_is_available; then
475:             echo "suricata_available=true"
476:         else
477:             echo "suricata_available=false"
478:         fi
479:     else
480:         echo "suricata_available=unknown"
481:     fi
482: 
483:     return 0
484: }
485: 
486: # =============================================================================
487: # CLI DISPATCHER (for direct script execution)
488: # =============================================================================
489: 
490: _nftban_ddos_cli() {
491:     local cmd="${1:-status}"
492:     shift || true
493: 
494:     case "$cmd" in
495:         enable)
496:             nftban_ddos_enable "$@"
497:             ;;
498:         disable)
499:             nftban_ddos_disable "$@"
500:             ;;
501:         status)
502:             nftban_ddos_status "$@"
503:             ;;
504:         test)
505:             nftban_ddos_test "$@"
506:             ;;
507:         mode)
508:             nftban_ddos_get_mode
509:             ;;
510:         help|--help|-h)
511:             echo "Usage: nftban ddos <command>"
512:             echo ""
513:             echo "Commands:"
514:             echo "  enable     Enable DDoS protection (auto-detects mode)"
515:             echo "  disable    Disable DDoS protection"
516:             echo "  status     Show current status"
517:             echo "  mode       Show active mode (classic/suricata/hybrid)"
518:             echo "  test       Output status in key=value format"
519:             echo ""
520:             echo "Modes:"
521:             echo "  auto       Auto-detect (use Suricata if available, else Classic)"
522:             echo "  classic    Force Classic mode (nftables-only)"
523:             echo "  suricata   Force Suricata mode (requires Suricata)"
524:             echo "  hybrid     Both: Classic Layer 0 + Suricata Layer 1"
525:             echo ""
526:             echo "Configuration:"
527:             echo "  ${NFTBAN_DDOS_CONFIG_DIR}/conf.d/ddos/main.conf"
528:             echo "  ${NFTBAN_DDOS_CONFIG_DIR}/conf.d/ddos/classic.conf"
529:             echo "  ${NFTBAN_DDOS_CONFIG_DIR}/conf.d/ddos/suricata.conf"
530:             echo ""
531:             ;;
532:         *)
533:             echo "Unknown command: $cmd"
534:             echo "Run 'nftban ddos help' for usage"
535:             return 1
536:             ;;
537:     esac
538: }
539: 
540: # Run CLI if executed directly
541: if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
542:     _nftban_ddos_cli "$@"
543: fi
544: 
545: # =============================================================================
546: # EXPORTS
547: # =============================================================================
548: 
549: export -f nftban_ddos_enable
550: export -f nftban_ddos_disable
551: export -f nftban_ddos_status
552: export -f nftban_ddos_test
553: export -f nftban_ddos_get_mode
554: export -f nftban_ddos_suricata_available
</file>


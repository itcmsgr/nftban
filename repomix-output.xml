  14: #
  15: # **Description & Purpose**
  16: # meta:description=User-friendly CLI for Suricata IDS installation and management
  17: # meta:input=Commands: install, enable, disable, status, rules
  18: # meta:output=Automated Suricata setup and control
  19: #
  20: # meta:created_date=2025-12-28
  21: # =============================================================================
  22: 
  23: set -Eeuo pipefail
  24: 
  25: # Prevent double-loading
  26: [[ -n "${NFTBAN_CMD_SURICATA_LOADED:-}" ]] && return 0
  27: NFTBAN_CMD_SURICATA_LOADED="true"
  28: 
  29: # =============================================================================
  30: # CONFIGURATION
  31: # =============================================================================
  32: 
  33: NFTBAN_LIB_DIR="${NFTBAN_LIB_DIR:-/usr/lib/nftban}"
  34: NFTBAN_CONF_DIR="${NFTBAN_CONF_DIR:-/etc/nftban}"
  35: 
  36: # Load output library
  37: if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_output.sh" ]]; then
  38:     # shellcheck source=/dev/null
  39:     source "${NFTBAN_LIB_DIR}/core/nftban_output.sh"
  40: fi
  41: 
  42: # Suricata paths
  43: readonly SURICATA_SETUP_SCRIPT="${NFTBAN_LIB_DIR}/setup/install_suricata.sh"
  44: readonly SURICATA_RULES_SCRIPT="${NFTBAN_LIB_DIR}/setup/setup_suricata_rules.sh"
  45: readonly SURICATA_SERVICE="suricata.service"
  46: 
  47: # =============================================================================
  48: # HELPER FUNCTIONS
  49: # =============================================================================
  50: 
  51: _suricata_is_installed() {
  52:     command -v suricata &>/dev/null
  53: }
  54: 
  55: _suricata_is_running() {
  56:     systemctl is-active --quiet "$SURICATA_SERVICE" 2>/dev/null
  57: }
  58: 
  59: _suricata_is_enabled() {
  60:     systemctl is-enabled --quiet "$SURICATA_SERVICE" 2>/dev/null
  61: }
  62: 
  63: _check_root() {
  64:     if [[ $EUID -ne 0 ]]; then
  65:         echo "ERROR: This command requires root privileges"
  66:         echo "Usage: sudo nftban suricata $1"
  67:         return 1
  68:     fi
  69: }

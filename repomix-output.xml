189: // EmulateBatchHandler handles POST /api/v1/emulate/batch
190: // Accepts array of IPs to check
191: func EmulateBatchHandler(w http.ResponseWriter, r *http.Request) {
192: 	var request struct {
193: 		IPs []string `json:"ips"`
194: 	}
195: 
196: 	if err := json.NewDecoder(r.Body).Decode(&request); err != nil {
197: 		respondJSON(w, http.StatusBadRequest, ErrorResponse{Error: "Invalid request body"})
198: 		return
199: 	}
200: 
201: 	if len(request.IPs) == 0 {
202: 		respondJSON(w, http.StatusBadRequest, ErrorResponse{Error: "No IPs provided"})
203: 		return
204: 	}
205: 
206: 	if len(request.IPs) > 100 {
207: 		respondJSON(w, http.StatusBadRequest, ErrorResponse{Error: "Maximum 100 IPs per batch"})
208: 		return
209: 	}
210: 
211: 	results := make([]map[string]string, 0, len(request.IPs))
212: 
213: 	for _, ip := range request.IPs {
214: 		// Validate IP
215: 		if net.ParseIP(ip) == nil {
216: 			results = append(results, map[string]string{
217: 				"ip":       ip,
218: 				"decision": "error",
219: 				"error":    "invalid IP",
220: 			})
221: 			continue
222: 		}
223: 
224: 		// Execute quick check - use central config for CLI path
225: 		cmd := exec.Command(getNFTBanCLI(), "emulate", ip, "--json")
226: 		output, _ := cmd.Output()
227: 
228: 		var response struct {
229: 			Result struct {
230: 				Decision string `json:"decision"`
231: 			} `json:"result"`
232: 		}
233: 		if err := json.Unmarshal(output, &response); err != nil {
234: 			results = append(results, map[string]string{
235: 				"ip":       ip,
236: 				"decision": "error",
237: 				"error":    "parse failed",
238: 			})
239: 			continue
240: 		}
241: 
242: 		results = append(results, map[string]string{
243: 			"ip":       ip,
244: 			"decision": response.Result.Decision,
245: 		})
246: 	}
247: 
248: 	respondJSON(w, http.StatusOK, map[string]interface{}{
249: 		"results": results,
250: 		"total":   len(results),
251: 	})
252: }

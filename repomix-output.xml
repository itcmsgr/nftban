 349: nftban_watchdog_check_iowait() {
 350:     # Check I/O wait percentage from /proc/stat
 351:     # Returns: status code, sets WATCHDOG_RESULTS
 352: 
 353:     if [[ "$NFTBAN_WATCHDOG_IOWAIT_ENABLED" != "true" ]]; then
 354:         return 0
 355:     fi
 356: 
 357:     # Read CPU line from /proc/stat
 358:     # Format: cpu user nice system idle iowait irq softirq steal guest guest_nice
 359:     local cpu_line
 360:     cpu_line=$(head -1 /proc/stat)
 361: 
 362:     local -a cpu_vals
 363:     # Must use default IFS (space) for reading space-separated values
 364:     IFS=' ' read -ra cpu_vals <<< "$cpu_line"
 365: 
 366:     # cpu_vals[0] = "cpu", [1] = user, [2] = nice, [3] = system, [4] = idle, [5] = iowait
 367:     local user="${cpu_vals[1]:-0}"
 368:     local nice="${cpu_vals[2]:-0}"
 369:     local system="${cpu_vals[3]:-0}"
 370:     local idle="${cpu_vals[4]:-0}"
 371:     local iowait="${cpu_vals[5]:-0}"
 372:     local irq="${cpu_vals[6]:-0}"
 373:     local softirq="${cpu_vals[7]:-0}"
 374: 
 375:     local total
 376:     total=$((user + nice + system + idle + iowait + irq + softirq))
 377: 
 378:     # Calculate percentages
 379:     local iowait_percent=0
 380:     local user_percent=0
 381:     local system_percent=0
 382:     local idle_percent=0
 383: 
 384:     if [[ $total -gt 0 ]]; then
 385:         iowait_percent=$((iowait * 100 / total))
 386:         user_percent=$((user * 100 / total))
 387:         system_percent=$((system * 100 / total))
 388:         idle_percent=$((idle * 100 / total))
 389:     fi
 390: 
 391:     WATCHDOG_RESULTS[cpu_user_percent]="$user_percent"
 392:     WATCHDOG_RESULTS[cpu_system_percent]="$system_percent"
 393:     WATCHDOG_RESULTS[cpu_idle_percent]="$idle_percent"
 394:     WATCHDOG_RESULTS[cpu_iowait_percent]="$iowait_percent"
 395: 
 396:     # Check thresholds
 397:     local status=$WATCHDOG_OK
 398: 
 399:     if [[ $iowait_percent -ge $NFTBAN_WATCHDOG_IOWAIT_CRITICAL ]]; then
 400:         status=$WATCHDOG_CRITICAL
 401:         WATCHDOG_RESULTS[iowait_status]="CRITICAL"
 402:         if watchdog_should_alert "iowait"; then
 403:             watchdog_alert "CRITICAL" "I/O Wait CRITICAL: ${iowait_percent}% >= ${NFTBAN_WATCHDOG_IOWAIT_CRITICAL}%"
 404:         fi
 405:     elif [[ $iowait_percent -ge $NFTBAN_WATCHDOG_IOWAIT_WARNING ]]; then
 406:         status=$WATCHDOG_WARNING
 407:         WATCHDOG_RESULTS[iowait_status]="WARNING"
 408:         if watchdog_should_alert "iowait"; then
 409:             watchdog_alert "WARNING" "I/O Wait high: ${iowait_percent}% >= ${NFTBAN_WATCHDOG_IOWAIT_WARNING}%"
 410:         fi
 411:     else
 412:         WATCHDOG_RESULTS[iowait_status]="OK"
 413:     fi
 414: 
 415:     return $status
 416: }

287: // getBandwidthMetrics reads and parses the Prometheus metrics file
288: func getBandwidthMetrics() (*BandwidthMetrics, error) {
289: 	// Check cache
290: 	bandwidthCacheMux.RLock()
291: 	if bandwidthCache != nil && time.Since(bandwidthCacheTime) < bandwidthCacheTTL {
292: 		defer bandwidthCacheMux.RUnlock()
293: 		return bandwidthCache, nil
294: 	}
295: 	bandwidthCacheMux.RUnlock()
296: 
297: 	// Read metrics file from central config path
298: 	file, err := os.Open(getBandwidthMetricsFile())
299: 	if err != nil {
300: 		return nil, fmt.Errorf("failed to open metrics file: %w", err)
301: 	}
302: 	defer file.Close()
303: 
304: 	metrics := &BandwidthMetrics{
305: 		Timestamp:  time.Now(),
306: 		Interfaces: make(map[string]*BandwidthInterface),
307: 		Protocols:  make(map[string]*ProtocolStats),
308: 	}
309: 
310: 	scanner := bufio.NewScanner(file)
311: 	for scanner.Scan() {
312: 		line := scanner.Text()
313: 
314: 		// Skip comments and empty lines
315: 		if strings.HasPrefix(line, "#") || strings.TrimSpace(line) == "" {
316: 			continue
317: 		}
318: 
319: 		// Parse interface metrics
320: 		if matches := metricPatternInterface.FindStringSubmatch(line); len(matches) == 5 {
321: 			direction := matches[1] // rx or tx
322: 			metric := matches[2]    // bytes, packets, mbps
323: 			iface := matches[3]
324: 			value := matches[4]
325: 
326: 			// Initialize interface if needed
327: 			if metrics.Interfaces[iface] == nil {
328: 				metrics.Interfaces[iface] = &BandwidthInterface{
329: 					Name:   iface,
330: 					Status: "up", // Assume up if we have metrics
331: 				}
332: 			}
333: 
334: 			// Parse and set value
335: 			if metric == "bytes" {
336: 				if v, err := strconv.ParseUint(value, 10, 64); err == nil {
337: 					if direction == "rx" {
338: 						metrics.Interfaces[iface].RxBytes = v
339: 					} else {
340: 						metrics.Interfaces[iface].TxBytes = v
341: 					}
342: 				}
343: 			} else if metric == "packets" {
344: 				if v, err := strconv.ParseUint(value, 10, 64); err == nil {
345: 					if direction == "rx" {
346: 						metrics.Interfaces[iface].RxPackets = v
347: 					} else {
348: 						metrics.Interfaces[iface].TxPackets = v
349: 					}
350: 				}
351: 			} else if metric == "mbps" {
352: 				if v, err := strconv.ParseFloat(value, 64); err == nil {
353: 					if direction == "rx" {
354: 						metrics.Interfaces[iface].RxMbps = v
355: 					} else {
356: 						metrics.Interfaces[iface].TxMbps = v
357: 					}
358: 				}
359: 			}
360: 			continue
361: 		}
362: 
363: 		// Parse total bandwidth
364: 		if matches := metricPatternTotal.FindStringSubmatch(line); len(matches) == 3 {
365: 			direction := matches[1]
366: 			value := matches[2]
367: 			if v, err := strconv.ParseFloat(value, 64); err == nil {
368: 				if direction == "rx" {
369: 					metrics.TotalRxMbps = v
370: 				} else {
371: 					metrics.TotalTxMbps = v
372: 				}
373: 			}
374: 			continue
375: 		}
376: 
377: 		// Parse protocol metrics
378: 		if matches := metricPatternProtocol.FindStringSubmatch(line); len(matches) == 4 {
379: 			metric := matches[1]  // bytes or packets
380: 			protocol := matches[2]
381: 			value := matches[3]
382: 
383: 			// Initialize protocol if needed
384: 			if metrics.Protocols[protocol] == nil {
385: 				metrics.Protocols[protocol] = &ProtocolStats{}
386: 			}
387: 
388: 			// Parse and set value
389: 			if v, err := strconv.ParseUint(value, 10, 64); err == nil {
390: 				if metric == "bytes" {
391: 					metrics.Protocols[protocol].Bytes = v
392: 				} else {
393: 					metrics.Protocols[protocol].Packets = v
394: 				}
395: 			}
396: 			continue
397: 		}
398: 
399: 		// Parse connection metrics
400: 		if matches := metricPatternConnection.FindStringSubmatch(line); len(matches) == 3 {
401: 			connType := matches[1]
402: 			value := matches[2]
403: 			if v, err := strconv.Atoi(value); err == nil {
404: 				switch connType {
405: 				case "active":
406: 					metrics.Connections.Active = v
407: 				case "established":
408: 					metrics.Connections.Established = v
409: 				case "time_wait":
410: 					metrics.Connections.TimeWait = v
411: 				case "close_wait":
412: 					metrics.Connections.CloseWait = v
413: 				}
414: 			}
415: 			continue
416: 		}
417: 
418: 		// Parse peak bandwidth
419: 		if matches := metricPatternPeak.FindStringSubmatch(line); len(matches) == 3 {
420: 			direction := matches[1]
421: 			value := matches[2]
422: 			if v, err := strconv.ParseFloat(value, 64); err == nil {
423: 				if direction == "rx" {
424: 					metrics.Peaks.RxMbps = v
425: 				} else {
426: 					metrics.Peaks.TxMbps = v
427: 				}
428: 			}
429: 			continue
430: 		}
431: 	}
432: 
433: 	if err := scanner.Err(); err != nil {
434: 		return nil, fmt.Errorf("error reading metrics file: %w", err)
435: 	}
436: 
437: 	// Update cache
438: 	bandwidthCacheMux.Lock()
439: 	bandwidthCache = metrics
440: 	bandwidthCacheTime = time.Now()
441: 	bandwidthCacheMux.Unlock()
442: 
443: 	return metrics, nil
444: }

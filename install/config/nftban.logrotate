# NFTBan Log Rotation Configuration
# Install to: /etc/logrotate.d/nftban
#
# Rotates:
# - /var/log/nftban/*.log (weekly, 4 weeks)
# - /var/lib/nftban/reports/* (monthly, 3 months)
# - Suricata logs (handled separately)
#
# Policy: Compress old files, keep reasonable history

# Main application logs (services that can be reloaded)
/var/log/nftban/nftban.log
/var/log/nftban/login-monitor.log
/var/log/nftban/service-alerts.log {
    weekly
    rotate 4
    compress
    delaycompress
    missingok
    notifempty
    create 0640 nftban nftban
    sharedscripts
    postrotate
        # Reload any services that need to reopen log files
        systemctl reload nftban-login-monitor >/dev/null 2>&1 || true
    endscript
}

# Mail and queue logs - bash scripts appending via >>
# Use copytruncate: safer for transient appenders, no reload needed
/var/log/nftban/mail.log
/var/log/nftban/queue.log {
    weekly
    rotate 4
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}

# Suricata eve-alerts.json (daemon path) - low volume, alert-only
/var/log/nftban/suricata/eve-alerts.json {
    daily
    rotate 7
    compress
    delaycompress
    missingok
    notifempty
    create 0640 suricata nftban
    copytruncate
    size 50M
    postrotate
        # Signal Suricata to reopen log file
        systemctl kill -s USR2 suricata.service >/dev/null 2>&1 || true
    endscript
}

# Suricata eve-audit.json (optional, higher volume when enabled)
/var/log/nftban/suricata/eve-audit.json {
    daily
    rotate 3
    compress
    delaycompress
    missingok
    notifempty
    create 0640 suricata nftban
    copytruncate
    size 100M
    postrotate
        systemctl kill -s USR2 suricata.service >/dev/null 2>&1 || true
    endscript
}

# Suricata eve-stats.json (optional, for capacity planning)
/var/log/nftban/suricata/eve-stats.json {
    weekly
    rotate 2
    compress
    delaycompress
    missingok
    notifempty
    create 0640 suricata nftban
    copytruncate
}

# Fast.log for Suricata
/var/log/nftban/suricata/fast.log {
    weekly
    rotate 4
    compress
    delaycompress
    missingok
    notifempty
    create 0640 suricata nftban
    copytruncate
}

# Stats.log for Suricata
/var/log/nftban/suricata/stats.log {
    weekly
    rotate 4
    compress
    delaycompress
    missingok
    notifempty
    create 0640 suricata nftban
    copytruncate
}

# Generated reports - monthly rotation, keep 3 months
/var/lib/nftban/reports/*.html /var/lib/nftban/reports/*.txt /var/lib/nftban/reports/*.json {
    monthly
    rotate 3
    compress
    delaycompress
    missingok
    notifempty
    olddir /var/lib/nftban/reports/archive
    createolddir 0750 nftban nftban
}

# Daily reports subdirectory
/var/lib/nftban/reports/daily/*.html /var/lib/nftban/reports/daily/*.txt {
    monthly
    rotate 3
    compress
    delaycompress
    missingok
    notifempty
}

 81: # MAIN CLI HANDLER
 82: # =============================================================================
 83: 
 84: 
 85: nftban_cmd_permissions() {
 86:     # Main permissions command handler
 87:     # Usage: nftban permissions [subcommand] [options]
 88: 
 89:     local subcommand="${1:-help}"
 90: 
 91:     # Show banner
 92:     if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_output.sh" ]]; then
 93:         # shellcheck source=/dev/null
 94:         source "${NFTBAN_LIB_DIR}/core/nftban_output.sh"
 95:         if [[ $(type -t nftban_banner) == "function" ]]; then
 96:             nftban_banner
 97:         fi
 98:     fi
 99:     echo ""
100: 
101:     case "$subcommand" in
102:         help|--help|-h)
103:             nftban_permissions_cmd_help
104:             return 0
105:             ;;
106:         check)
107:             shift || true
108:             nftban_permissions_cmd_check "$@"
109:             ;;
110:         enforce|fix)
111:             shift || true
112:             nftban_permissions_cmd_enforce "$@"
113:             ;;
114:         *)
115:             echo "ERROR: Unknown permissions command: $subcommand" >&2
116:             echo "Run 'nftban permissions help' for usage information" >&2
117:             return 1
118:             ;;
119:     esac
120: }
121: 
122: # =============================================================================
123: 
124: # SUBCOMMAND: HELP
125: # =============================================================================
126: 
127: 
128: nftban_permissions_cmd_help() {
129:     cat <<'EOF'
130: Usage: nftban permissions <subcommand> [options]
131: 
132: Manage and audit file permissions and ownership for NFTBan.
133: 
134: SUBCOMMANDS:
135:   check                Check current permissions and report issues
136:   enforce, fix         Enforce secure permissions on all NFTBan files
137:   help                 Show this help message
138: 
139: OPTIONS:
140:   --dry-run           Show what would be changed without making changes
141: 
142: EXAMPLES:
143:   # Check current permissions
144:   sudo nftban permissions check
145: 
146:   # Enforce secure permissions
147:   sudo nftban permissions enforce
148: 
149:   # Preview changes without applying
150:   sudo nftban permissions enforce --dry-run
151: 
152: SECURITY MODEL:
153:   /etc/nftban/*        → root:root, 0750/0640 (configs are code-sensitive!)
154:   /usr/lib/nftban/*    → root:root, 0755/0644 (immutable system code)
155:   /var/lib/nftban/*    → nftban:nftban, 0750 (mutable state data)
156:   /var/log/nftban/*    → nftban:nftban, 0750 (log files)
157: 
158: NOTES:
159:   - This command requires root privileges
160:   - Permissions are automatically enforced during FHS auto-heal
161:   - Regular permission audits run via 'nftban health check'
162: 
163: For more information, see: nftban health help
164: EOF
165: }
166: 
167: # =============================================================================
168: 
169: # SUBCOMMAND: CHECK
170: # =============================================================================
171: 
172: 
173: nftban_permissions_cmd_check() {
174:     # Check current permissions
175:     # Args: options
176: 
177:     echo "NFTBan Permission Audit"
178:     echo "======================="
179:     echo ""
180: 
181:     local result=0
182:     nftban_permissions_check || result=$?
183: 
184:     return $result
185: }
186: 
187: # =============================================================================
188: 
189: # SUBCOMMAND: ENFORCE
190: # =============================================================================
191: 
192: 
193: nftban_permissions_cmd_enforce() {
194:     # Enforce secure permissions
195:     # Args: options
196: 
197:     local dry_run=0
198: 
199:     # Parse options
200:     while [[ $# -gt 0 ]]; do
201:         case "$1" in
202:             --dry-run)
203:                 dry_run=1
204:                 shift
205:                 ;;
206:             *)
207:                 echo "ERROR: Unknown option: $1" >&2
208:                 return 1
209:                 ;;
210:         esac
211:     done
212: 
213:     # Set dry-run mode
214:     export PERMS_DRYRUN=$dry_run
215: 
216:     if [[ $dry_run == 1 ]]; then
217:         echo "NFTBan Permission Enforcement (DRY-RUN MODE)"
218:         echo "============================================="
219:         echo ""
220:         echo "⚠️  DRY-RUN: No changes will be made"
221:         echo ""
222:     else
223:         echo "NFTBan Permission Enforcement"
224:         echo "============================="
225:         echo ""
226:     fi
227: 
228:     # Check if running as root
229:     if [[ $EUID -ne 0 ]]; then
230:         echo "ERROR: This command must be run as root" >&2
231:         return 1
232:     fi
233: 
234:     # Run enforcement
235:     local result=0
236:     nftban_permissions_enforce_all || result=$?
237: 
238:     if [[ $result -eq 0 ]]; then
239:         if [[ $dry_run == 1 ]]; then
240:             echo ""
241:             echo "✅ DRY-RUN completed successfully"
242:             echo "   Run without --dry-run to apply changes"
243:         else
244:             echo ""
245:             echo "✅ Permissions enforced successfully"
246:         fi
247:     else
248:         echo ""
249:         echo "❌ Permission enforcement failed with errors"
250:     fi
251: 
252:     return $result
253: }

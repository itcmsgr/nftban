379: // CreateBackup creates a timestamped backup of custom.rules
380: func (m *Manager) CreateBackup() error {
381: 	// Check if custom.rules exists
382: 	if _, err := os.Stat(m.customFile); os.IsNotExist(err) {
383: 		return nil // Nothing to backup
384: 	}
385: 
386: 	// Read current content
387: 	content, err := os.ReadFile(m.customFile)
388: 	if err != nil {
389: 		return fmt.Errorf("failed to read custom.rules: %w", err)
390: 	}
391: 
392: 	// Create backup filename with timestamp
393: 	timestamp := time.Now().Format("20060102-150405")
394: 	backupFile := filepath.Join(m.backupDir, fmt.Sprintf("custom.rules.%s", timestamp))
395: 
396: 	// Write backup
397: 	if err := os.WriteFile(backupFile, content, 0644); err != nil {
398: 		return fmt.Errorf("failed to write backup: %w", err)
399: 	}
400: 
401: 	// Cleanup old backups (keep last 10)
402: 	if err := m.cleanupOldBackups(10); err != nil {
403: 		// Log but don't fail
404: 		fmt.Printf("Warning: failed to cleanup old backups: %v\n", err)
405: 	}
406: 
407: 	return nil
408: }

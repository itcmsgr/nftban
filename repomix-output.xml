 443:     # Store results
 444:     if [[ ${#service_issues[@]} -gt 0 ]]; then
 445:         NFTBAN_HEALTH_ISSUES["services"]="${service_issues[*]}"
 446:         NFTBAN_HEALTH_WARNINGS+=("Service issues: ${service_issues[*]}")

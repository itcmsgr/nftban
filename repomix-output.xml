  4: Name:           nftban-metrics
  5: Version:        1.0.0
  6: Release:        1%{?dist}
  7: Summary:        NFTBAN Metrics - Prometheus/Grafana observability for nftables firewall
  8: 
  9: License:        MPL-2.0
 10: URL:            https://github.com/nftban/nftban
 11: Source0:        %{name}-%{version}.tar.gz
 12: 
 13: BuildArch:      noarch
 14: Requires:       systemd >= 232
 15: Requires:       nftban >= 1.0.0
 16: Recommends:     node_exporter
 17: Recommends:     prometheus
 18: Recommends:     grafana
 19: Suggests:       mailx
 20: 
 21: %description
 22: Prometheus metrics collection and Grafana dashboards for NFTBAN firewall
 23: monitoring. Provides real-time observability into nftables-based firewall
 24: operations, ban statistics, and threat detection events.
 25: 
 26: Features:
 27:  - Prometheus metrics exporter for NFTBan statistics
 28:  - Node Exporter integration via textfile collector
 29:  - 4 pre-built Grafana dashboards (Overview, Health, Geographic, Performance)
 30:  - Automated installation scripts for Node Exporter and Prometheus
 31:  - 15+ alert rules for proactive monitoring
 32:  - Security-hardened systemd services
 33:  - Multi-distro support (RHEL, Fedora, Debian, Ubuntu)
 34: 
 35: The metrics exporter collects NFTBan firewall statistics and exports them
 36: in Prometheus format via Node Exporter's textfile collector. Dashboards
 37: provide visualization for block statistics, system health, geographic
 38: distribution, and performance metrics.
 39: 
 40: %prep
 41: %setup -q
 42: 
 43: %build
 44: # No build required - shell scripts and configuration files
 45: 
 46: %install
 47: rm -rf %{buildroot}
 48: 
 49: # Create directory structure
 50: install -d %{buildroot}%{_prefix}/lib/nftban/exporters
 51: install -d %{buildroot}%{_prefix}/lib/nftban/setup
 52: install -d %{buildroot}%{_unitdir}/node_exporter.service.d
 53: install -d %{buildroot}%{_datadir}/nftban/prometheus/alerts
 54: install -d %{buildroot}%{_datadir}/nftban/grafana/dashboards
 55: install -d %{buildroot}%{_docdir}/nftban/metrics
 56: 
 57: # Install Track 1: Core Metrics Exporter
 58: install -m 0755 work/track1/nftban_prometheus_exporter.sh \
 59:     %{buildroot}%{_prefix}/lib/nftban/exporters/nftban_prometheus_exporter.sh
 60: install -m 0644 work/track1/nftban-metrics-exporter.service \
 61:     %{buildroot}%{_unitdir}/nftban-metrics-exporter.service
 62: install -m 0644 work/track1/nftban-metrics-exporter.timer \
 63:     %{buildroot}%{_unitdir}/nftban-metrics-exporter.timer
 64: 
 65: # Install Track 2: Node Exporter Setup
 66: install -m 0755 cli/lib/nftban/setup/install_node_exporter.sh \
 67:     %{buildroot}%{_prefix}/lib/nftban/setup/install_node_exporter.sh
 68: install -m 0755 cli/lib/nftban/setup/validate_node_exporter.sh \
 69:     %{buildroot}%{_prefix}/lib/nftban/setup/validate_node_exporter.sh
 70: install -m 0644 install/systemd/node_exporter.service.d/textfile-collector.conf \
 71:     %{buildroot}%{_unitdir}/node_exporter.service.d/textfile-collector.conf
 72: install -m 0644 install/systemd/node_exporter.service.d/hardening.conf \
 73:     %{buildroot}%{_unitdir}/node_exporter.service.d/hardening.conf
 74: install -m 0644 docs/metrics/NODE_EXPORTER_SETUP.md \
 75:     %{buildroot}%{_docdir}/nftban/metrics/NODE_EXPORTER_SETUP.md
 76: 
 77: # Install Track 3: Grafana Dashboards
 78: install -m 0644 install/grafana/dashboards/nftban_overview.json \
 79:     %{buildroot}%{_datadir}/nftban/grafana/dashboards/nftban_overview.json
 80: install -m 0644 install/grafana/dashboards/nftban_health.json \
 81:     %{buildroot}%{_datadir}/nftban/grafana/dashboards/nftban_health.json
 82: install -m 0644 install/grafana/dashboards/nftban_geographic.json \
 83:     %{buildroot}%{_datadir}/nftban/grafana/dashboards/nftban_geographic.json
 84: install -m 0644 install/grafana/dashboards/nftban_performance.json \
 85:     %{buildroot}%{_datadir}/nftban/grafana/dashboards/nftban_performance.json
 86: 
 87: # Install Track 4: Prometheus Configuration
 88: install -m 0755 cli/lib/nftban/setup/install_prometheus.sh \
 89:     %{buildroot}%{_prefix}/lib/nftban/setup/install_prometheus.sh
 90: install -m 0755 cli/lib/nftban/setup/validate_prometheus.sh \
 91:     %{buildroot}%{_prefix}/lib/nftban/setup/validate_prometheus.sh
 92: install -m 0644 install/prometheus/prometheus.yml.example \
 93:     %{buildroot}%{_datadir}/nftban/prometheus/prometheus.yml.example
 94: install -m 0644 install/prometheus/prometheus-remote.yml.example \
 95:     %{buildroot}%{_datadir}/nftban/prometheus/prometheus-remote.yml.example
 96: install -m 0644 install/prometheus/web.yml.example \
 97:     %{buildroot}%{_datadir}/nftban/prometheus/web.yml.example
 98: install -m 0644 install/prometheus/alerts/nftban-metrics.yml \
 99:     %{buildroot}%{_datadir}/nftban/prometheus/alerts/nftban-metrics.yml
100: install -m 0644 docs/metrics/PROMETHEUS_SETUP.md \
101:     %{buildroot}%{_docdir}/nftban/metrics/PROMETHEUS_SETUP.md
102: 
103: # Install Track 10: Security
104: install -m 0755 install/firewall/metrics-firewall-rules.sh \
105:     %{buildroot}%{_prefix}/lib/nftban/setup/metrics-firewall-rules.sh
106: install -m 0644 docs/metrics/SECURITY.md \
107:     %{buildroot}%{_docdir}/nftban/metrics/SECURITY.md
108: 
109: %files
110: %license LICENSE
111: %doc README.md
112: 
113: # Track 1: Core Metrics Exporter
114: %{_prefix}/lib/nftban/exporters/nftban_prometheus_exporter.sh
115: %{_unitdir}/nftban-metrics-exporter.service
116: %{_unitdir}/nftban-metrics-exporter.timer
117: 
118: # Track 2: Node Exporter Setup
119: %{_prefix}/lib/nftban/setup/install_node_exporter.sh
120: %{_prefix}/lib/nftban/setup/validate_node_exporter.sh
121: %{_unitdir}/node_exporter.service.d/textfile-collector.conf
122: %{_unitdir}/node_exporter.service.d/hardening.conf
123: %{_docdir}/nftban/metrics/NODE_EXPORTER_SETUP.md
124: 
125: # Track 3: Grafana Dashboards
126: %{_datadir}/nftban/grafana/dashboards/nftban_overview.json
127: %{_datadir}/nftban/grafana/dashboards/nftban_health.json
128: %{_datadir}/nftban/grafana/dashboards/nftban_geographic.json
129: %{_datadir}/nftban/grafana/dashboards/nftban_performance.json
130: 
131: # Track 4: Prometheus Configuration
132: %{_prefix}/lib/nftban/setup/install_prometheus.sh
133: %{_prefix}/lib/nftban/setup/validate_prometheus.sh
134: %{_datadir}/nftban/prometheus/prometheus.yml.example
135: %{_datadir}/nftban/prometheus/prometheus-remote.yml.example
136: %{_datadir}/nftban/prometheus/web.yml.example
137: %{_datadir}/nftban/prometheus/alerts/nftban-metrics.yml
138: %{_docdir}/nftban/metrics/PROMETHEUS_SETUP.md
139: 
140: # Track 10: Security
141: %{_prefix}/lib/nftban/setup/metrics-firewall-rules.sh
142: %{_docdir}/nftban/metrics/SECURITY.md
143: 
144: %pre
145: # Create nftban user if it doesn't exist (usually handled by main nftban package)
146: if ! id -u nftban >/dev/null 2>&1; then
147:     useradd --system --home-dir /var/lib/nftban --shell /usr/sbin/nologin nftban
148: fi
149: 
150: %post
151: # Create textfile collector directory
152: if [ ! -d "/var/lib/node_exporter/textfile_collector" ]; then
153:     mkdir -p /var/lib/node_exporter/textfile_collector
154:     chown nftban:nftban /var/lib/node_exporter/textfile_collector
155:     chmod 750 /var/lib/node_exporter/textfile_collector
156: fi
157: 
158: # Reload systemd daemon
159: %systemd_post nftban-metrics-exporter.service nftban-metrics-exporter.timer
160: 
161: # Print installation message
162: cat <<'EOF'
163: 
164: ═══════════════════════════════════════════════════════════
165: NFTBan v0.6 Metrics installed successfully!
166: ═══════════════════════════════════════════════════════════
167: 
168: Next steps:
169: 
170: 1. Install Node Exporter (if not already installed):
171:    sudo /usr/lib/nftban/setup/install_node_exporter.sh
172: 
173: 2. Install Prometheus (if not already installed):
174:    sudo /usr/lib/nftban/setup/install_prometheus.sh
175: 
176: 3. Enable and start metrics collection:
177:    sudo systemctl enable --now nftban-metrics-exporter.timer
178: 
179: 4. Verify metrics are being collected:
180:    sudo systemctl status nftban-metrics-exporter.timer
181:    cat /var/lib/node_exporter/textfile_collector/nftban.prom
182: 
183: 5. Import Grafana dashboards (optional):
184:    Dashboards are in: /usr/share/nftban/grafana/dashboards/
185: 
186: Documentation:
187:   - Node Exporter: /usr/share/doc/nftban/metrics/NODE_EXPORTER_SETUP.md
188:   - Prometheus: /usr/share/doc/nftban/metrics/PROMETHEUS_SETUP.md
189:   - Security: /usr/share/doc/nftban/metrics/SECURITY.md
190: 
191: ═══════════════════════════════════════════════════════════
192: EOF
193: 
194: %preun
195: %systemd_preun nftban-metrics-exporter.timer nftban-metrics-exporter.service
196: 
197: %postun
198: %systemd_postun_with_restart nftban-metrics-exporter.timer nftban-metrics-exporter.service
199: 
200: # Remove metrics file on package removal (but not upgrade)
201: if [ $1 -eq 0 ]; then
202:     rm -f /var/lib/node_exporter/textfile_collector/nftban.prom 2>/dev/null || true
203:     rm -f /var/lib/node_exporter/textfile_collector/nftban.prom.tmp 2>/dev/null || true
204: fi

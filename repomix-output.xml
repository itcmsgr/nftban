482:                 usage
483:                 exit 1
484:                 ;;
485:         esac
486:     done
487: 
488:     # Check root
489:     if [[ $EUID -ne 0 ]]; then
490:         log_warn "Not running as root - some tests may fail"
491:     fi
492: 
493:     # Handle check-only mode
494:     if [[ "$mode" == "check" ]]; then
495:         echo "Checking trace log for orphaned traces..."
496:         source /usr/lib/nftban/helpers/nftban_trace.sh 2>/dev/null || true

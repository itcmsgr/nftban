#!/usr/bin/make -f

# Debian rules file for nftban-ui
export DH_VERBOSE = 1
export CGO_ENABLED = 1

# Go build flags
export GOFLAGS = -buildmode=pie -mod=readonly -modcacherw

%:
	dh $@ --with systemd

override_dh_auto_build:
	# Generate templ files (compiled templates -> Go source)
	if ! command -v templ >/dev/null 2>&1; then \
		go install github.com/a-h/templ/cmd/templ@v0.3.977; \
	fi
	templ generate

	# Build GUI server
	cd cmd/nftban-ui && \
	go build -trimpath -ldflags="-linkmode=external -s -w -X main.version=$(shell dpkg-parsechangelog -S Version)" \
	    -o ../../bin/nftban-ui .

	# Build authentication service
	go build -trimpath -ldflags="-linkmode=external -s -w -X main.version=$(shell dpkg-parsechangelog -S Version)" \
	    -o bin/nftban-ui-auth ./cmd/nftban-ui-auth

override_dh_auto_install:
	# Install binaries
	install -D -m 0755 bin/nftban-ui debian/nftban-ui/usr/sbin/nftban-ui
	install -D -m 0755 bin/nftban-ui-auth debian/nftban-ui/usr/libexec/nftban-ui-auth

	# Install systemd units
	install -D -m 0644 install/systemd/nftban-ui.service debian/nftban-ui/lib/systemd/system/nftban-ui.service
	install -D -m 0644 install/systemd/nftban-ui-auth.service debian/nftban-ui/lib/systemd/system/nftban-ui-auth.service
	install -D -m 0644 install/systemd/nftban-ui-auth.socket debian/nftban-ui/lib/systemd/system/nftban-ui-auth.socket

	# Install PAM configuration
	install -D -m 0644 install/pam/nftban-ui debian/nftban-ui/etc/pam.d/nftban-ui

	# Install config files
	install -D -m 0644 install/config/allowed-gui-groups debian/nftban-ui/etc/nftban/allowed-gui-groups

	# Install distro config parser module
	install -D -m 0755 cli/lib/nftban/lib/nftban_distro_config.sh debian/nftban-ui/usr/lib/nftban/lib/nftban_distro_config.sh

	# Install distro config files
	mkdir -p debian/nftban-ui/etc/nftban/distros
	install -m 0644 etc/nftban/distros/*.conf debian/nftban-ui/etc/nftban/distros/

	# Create conf.d directory for custom overrides
	mkdir -p debian/nftban-ui/etc/nftban/conf.d

	# Create log directory
	mkdir -p debian/nftban-ui/var/log/nftban

override_dh_auto_clean:
	rm -rf bin/
	rm -f go.sum

override_dh_auto_test:
	# Skip tests for now

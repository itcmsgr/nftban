 479: // appendFilterToLocal appends a filter configuration to the .local file
 480: func appendFilterToLocal(localPath string, filter *suricata.FilterConfig) error {
 481: 	// Read existing .local file
 482: 	var existingLines []string
 483: 	if data, err := os.ReadFile(localPath); err == nil {
 484: 		existingLines = strings.Split(string(data), "\n")
 485: 	}
 486: 
 487: 	// Remove existing entry for this filter
 488: 	newLines := []string{}
 489: 	inFiltersSection := false
 490: 	for _, line := range existingLines {
 491: 		trimmed := strings.TrimSpace(line)
 492: 
 493: 		// Track if we're in [filters] section
 494: 		if trimmed == "[filters]" {
 495: 			inFiltersSection = true
 496: 			newLines = append(newLines, line)
 497: 			continue
 498: 		}
 499: 		if strings.HasPrefix(trimmed, "[") && trimmed != "[filters]" {
 500: 			inFiltersSection = false
 501: 		}
 502: 
 503: 		// Skip line if it's this filter
 504: 		if inFiltersSection && strings.HasPrefix(trimmed, filter.Name+" =") {
 505: 			continue
 506: 		}
 507: 
 508: 		newLines = append(newLines, line)
 509: 	}
 510: 
 511: 	// Add [filters] section if not present
 512: 	hasFiltersSection := false
 513: 	for _, line := range newLines {
 514: 		if strings.TrimSpace(line) == "[filters]" {
 515: 			hasFiltersSection = true
 516: 			break
 517: 		}
 518: 	}
 519: 
 520: 	if !hasFiltersSection {
 521: 		newLines = append(newLines, "", "[filters]")
 522: 	}
 523: 
 524: 	// Format filter line
 525: 	keywords := strings.Join(filter.Keywords, ",")
 526: 	enabled := "false"
 527: 	if filter.Enabled {
 528: 		enabled = "true"
 529: 	}
 530: 
 531: 	// Format ban type
 532: 	banTypeStr := filter.BanType
 533: 	if filter.BanType == "escalate" {
 534: 		banTypeStr = fmt.Sprintf("escalate:%d:%s", filter.MaxBans, filter.Period)
 535: 	}
 536: 
 537: 	filterLine := fmt.Sprintf("%s = %s | %s | %d | %s | %s | %s | %s",
 538: 		filter.Name,
 539: 		enabled,
 540: 		keywords,
 541: 		filter.Threshold,
 542: 		filter.BanTime,
 543: 		filter.Action,
 544: 		banTypeStr,
 545: 		filter.Description,
 546: 	)
 547: 
 548: 	// Append new filter line
 549: 	newLines = append(newLines, filterLine)
 550: 
 551: 	// Write back to file
 552: 	content := strings.Join(newLines, "\n")
 553: 	if err := os.WriteFile(localPath, []byte(content), 0644); err != nil {
 554: 		return fmt.Errorf("failed to write file: %w", err)
 555: 	}
 556: 
 557: 	return nil
 558: }

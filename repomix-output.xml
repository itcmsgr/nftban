217: # =============================================================================
218: # MAIL PORT CHECKING
219: # =============================================================================
220: 
221: nftban_mail_check_ports() {
222:     # Check mail ports in nftables
223:     # Shows which ports are allowed/blocked
224: 
225:     if ! command -v nft &>/dev/null; then
226:         echo "⚠ nft command not found - cannot check firewall ports"
227:         return 1
228:     fi
229: 
230:     local ruleset
231:     ruleset="$(nft list ruleset 2>/dev/null || true)"
232: 
233:     if [[ -z "$ruleset" ]]; then
234:         echo "⚠ No nftables rules found"
235:         return 1
236:     fi
237: 
238:     # Define mail ports to check
239:     declare -A MAIL_PORTS=(
240:         [25]="SMTP (outbound)"
241:         [587]="Submission (outbound)"
242:         [465]="SMTPS (outbound)"
243:         [143]="IMAP (inbound)"
244:         [993]="IMAPS (inbound)"
245:         [110]="POP3 (inbound)"
246:         [995]="POP3S (inbound)"
247:     )
248: 
249:     echo "Mail Port Firewall Status:"
250: 
251:     for port in 25 587 465 143 993 110 995; do
252:         local status="unknown"
253:         local desc="${MAIL_PORTS[$port]}"
254: 
255:         # Check for explicit accept
256:         if echo "$ruleset" | grep -qE "tcp dport $port.*accept"; then
257:             status="${NFTBAN_COLOR_GREEN}✓${NFTBAN_COLOR_RESET} Allowed"
258:         # Check for explicit drop/reject
259:         elif echo "$ruleset" | grep -qE "tcp dport $port.*(drop|reject)"; then
260:             status="${NFTBAN_COLOR_RED}✗${NFTBAN_COLOR_RESET} Blocked"
261:         else
262:             status="${NFTBAN_COLOR_YELLOW}?${NFTBAN_COLOR_RESET} No-rule"
263:         fi
264: 
265:         printf "  Port %-4s %-25s %s\n" "$port" "($desc)" "$status"
266:     done
267: 
268:     echo ""
269:     echo "Legend: ✓ allowed   ✗ blocked   ? no-rule (default policy applies)"
270: }

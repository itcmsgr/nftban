 98: func cmdPortsStatus(portsDir string) error {
 99: 	fmt.Println(version.BannerWithEmoji("🔌", "Port Status"))
100: 	fmt.Println(strings.Repeat("=", 70))
101: 	fmt.Println()
102: 
103: 	// Detect IP family support
104: 	fmt.Println("Step 1: Detecting IP family support...")
105: 	ipSupport, err := network.DetectIPFamilySupport()
106: 	if err != nil {
107: 		return fmt.Errorf("failed to detect IP families: %w", err)
108: 	}
109: 	fmt.Printf("  ✅ System: %s\n", ipSupport.String())
110: 	if ipSupport.HasIPv4 {
111: 		fmt.Println("  ✅ IPv4 is available")
112: 	}
113: 	if ipSupport.HasIPv6 {
114: 		fmt.Println("  ✅ IPv6 is available")
115: 	}
116: 	if !ipSupport.HasIPv4 && !ipSupport.HasIPv6 {
117: 		fmt.Println("  ⚠️  WARNING: No IP connectivity detected!")
118: 	}
119: 	fmt.Println()
120: 
121: 	// Load port configuration
122: 	fmt.Println("Step 2: Loading port configuration...")
123: 	config, err := ports.LoadPortsFromDirectory(portsDir)
124: 	if err != nil {
125: 		return fmt.Errorf("failed to load ports: %w", err)
126: 	}
127: 	fmt.Printf("  ✅ Loaded %d TCP ports\n", len(config.TCPPorts))
128: 	fmt.Printf("  ✅ Loaded %d UDP ports\n", len(config.UDPPorts))
129: 	fmt.Println()
130: 
131: 	// Check nftables status
132: 	fmt.Println("Step 3: Checking nftables status...")
133: 	nft, err := sync.NewNFTManager()
134: 	if err != nil {
135: 		return fmt.Errorf("failed to connect to nftables: %w", err)
136: 	}
137: 	defer nft.Close()
138: 
139: 	// Check for inet table (dual-stack)
140: 	inetTable, _ := nft.GetOrCreateTable(nftables.TableFamilyINet)
141: 	if inetTable != nil {
142: 		fmt.Println("  ✅ Found inet (dual-stack) table")
143: 	}
144: 
145: 	// Check IPv4 table (only if system has IPv4)
146: 	if ipSupport.HasIPv4 {
147: 		ipv4Table, _ := nft.GetOrCreateTable(nftables.TableFamilyIPv4)
148: 		if ipv4Table != nil {
149: 			fmt.Println("  ✅ Found IPv4 table")
150: 		}
151: 	} else {
152: 		fmt.Println("  ℹ️  IPv4 table skipped (system has no IPv4)")
153: 	}
154: 
155: 	// Check IPv6 table (only if system has IPv6)
156: 	if ipSupport.HasIPv6 {
157: 		ipv6Table, _ := nft.GetOrCreateTable(nftables.TableFamilyIPv6)
158: 		if ipv6Table != nil {
159: 			fmt.Println("  ✅ Found IPv6 table")
160: 		}
161: 	} else {
162: 		fmt.Println("  ℹ️  IPv6 table skipped (system has no IPv6)")
163: 	}
164: 	fmt.Println()
165: 
166: 	return nil
167: }

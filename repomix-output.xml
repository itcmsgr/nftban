<file path="cli/lib/nftban/cli/cmd_menu.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - Interactive TUI Menu Command
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Interactive TUI menu system for NFTBan
  7: #
  8: # meta:name=cmd_menu
  9: # meta:type=cli
 10: # meta:header=NFTBan Interactive Menu
 11: # meta:version=1.0.0
 12: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 13: # meta:homepage=https://nftban.com
 14: #
 15: # **Description & Purpose**
 16: # meta:description=Interactive TUI menu using whiptail/dialog for easier navigation
 17: # meta:input=User menu selections
 18: # meta:output=Executes selected commands and displays results
 19: #
 20: # **Inventory & Requirements**
 21: # meta:depends=bash,whiptail|dialog
 22: #
 23: # meta:created_date=2025-11-05
 24: # meta:updated_date=2025-11-24
 25: 
 26: set -Eeuo pipefail
 27: 
 28: # =============================================================================
 29: # CONFIGURATION
 30: # =============================================================================
 31: 
 32: TITLE="NFTBAN — Interactive Menu"
 33: BACKTITLE="Adaptive firewall & ban management"
 34: 
 35: # =============================================================================
 36: # UTILITY FUNCTIONS
 37: # =============================================================================
 38: 
 39: have_cmd() {
 40:     # Check if command exists
 41:     command -v "$1" >/dev/null 2>&1
 42: }
 43: 
 44: # Detect UI backend
 45: detect_ui() {
 46:     if have_cmd whiptail; then
 47:         echo "whiptail"
 48:     elif have_cmd dialog; then
 49:         echo "dialog"
 50:     else
 51:         echo "select"
 52:     fi
 53: }
 54: 
 55: UI="$(detect_ui)"
 56: 
 57: # =============================================================================
 58: # UI WRAPPER FUNCTIONS
 59: # =============================================================================
 60: 
 61: ui_menu() {
 62:     # Display menu and return choice
 63:     # Args: title backtitle item1 desc1 item2 desc2 ...
 64:     local title="$1"; local back="$2"; shift 2
 65:     case "$UI" in
 66:         whiptail)
 67:             whiptail --title "$title" --backtitle "$back" --menu "" 20 70 12 "$@" 3>&1 1>&2 2>&3
 68:             ;;
 69:         dialog)
 70:             dialog --title "$title" --backtitle "$back" --menu "" 20 70 12 "$@" 3>&1 1>&2 2>&3
 71:             ;;
 72:         select)
 73:             local -a items=("$@")
 74:             echo "$title"
 75:             local i=0; for ((i=0; i<${#items[@]}; i+=2)); do
 76:                 printf "%2d) %-18s %s\n" $((i/2+1)) "${items[i]}" "${items[i+1]}"
 77:             done
 78:             printf "Choose [1-%d] (or empty to quit): " $(( ${#items[@]}/2 ))
 79:             read -r choice || exit 1
 80:             [[ -z "$choice" ]] && return 1
 81:             local index
 82:             index=$(( (choice-1)*2 ))
 83:             if (( index >= 0 && index < ${#items[@]} )); then
 84:                 echo "${items[index]}"
 85:             else
 86:                 return 1
 87:             fi
 88:             ;;
 89:     esac
 90: }
 91: 
 92: ui_msg() {
 93:     # Display message box
 94:     # Args: title message
 95:     local title="$1"; local msg="$2"
 96:     case "$UI" in
 97:         whiptail) whiptail --title "$title" --msgbox "$msg" 16 72 ;;
 98:         dialog) dialog --title "$title" --msgbox "$msg" 16 72 ;;
 99:         select) echo -e "\n[$title]\n$msg\n" ;;
100:     esac
101: }
102: 
103: ui_yesno() {
104:     # Display yes/no dialog
105:     # Args: title message
106:     local title="$1"; local msg="$2"
107:     case "$UI" in
108:         whiptail) whiptail --title "$title" --yesno "$msg" 10 68 ;;
109:         dialog) dialog --title "$title" --yesno "$msg" 10 68 ;;
110:         select)
111:             read -r -p "$msg [y/N]: " ans
112:             [[ "${ans,,}" == "y" || "${ans,,}" == "yes" ]]
113:             ;;
114:     esac
115: }
116: 
117: ui_input() {
118:     # Get text input from user
119:     # Args: title prompt [default_value]
120:     local title="$1"; local prompt="$2"; local default="${3:-}"
121:     case "$UI" in
122:         whiptail)
123:             whiptail --title "$title" --inputbox "$prompt" 10 60 "$default" 3>&1 1>&2 2>&3
124:             ;;
125:         dialog)
126:             dialog --title "$title" --inputbox "$prompt" 10 60 "$default" 3>&1 1>&2 2>&3
127:             ;;
128:         select)
129:             echo ""
130:             echo "[$title]"
131:             if [[ -n "$default" ]]; then
132:                 read -r -p "$prompt [$default]: " ans
133:                 echo "${ans:-$default}"
134:             else
135:                 read -r -p "$prompt: " ans
136:                 echo "$ans"
137:             fi
138:             ;;
139:     esac
140: }
141: 
142: require_root() {
143:     # Check root permissions and show error if not root
144:     if [[ $EUID -ne 0 ]]; then
145:         ui_msg "Permission required" "This action needs root. Re-run: sudo nftban menu"
146:         return 1
147:     fi
148: }
149: 
150: run_cmd() {
151:     # Execute command and display output
152:     # Args: title command args...
153:     local title="$1"; shift
154:     local cmd=( "$@" )
155: 
156:     if [[ "$UI" == "select" ]]; then
157:         echo -e "\n> ${cmd[*]}\n"
158:         "${cmd[@]}" || true
159:         read -r -p "Press Enter to continue..." _
160:     else
161:         local output
162:         output="$("${cmd[@]}" 2>&1 || true)"
163:         ui_msg "$title" "$output"
164:     fi
165: }

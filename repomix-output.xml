<file path="cli/lib/nftban/lib/version.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - Version Management Library
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Single source of truth for all version numbers
  7: #
  8: # meta:name=version
  9: # meta:type=library
 10: # meta:header=Version Management
 11: # meta:version=1.0.0
 12: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 13: # meta:homepage=https://nftban.com
 14: #
 15: # **Description & Purpose**
 16: # meta:description=Centralized version management for all NFTBan components
 17: # meta:input=None (sourced by other scripts)
 18: # meta:output=Version constants and functions
 19: #
 20: # **Inventory & Requirements**
 21: # meta:depends=bash>=4.0
 22: #
 23: # **Usage**
 24: # Source this file to get version information:
 25: #   source "${NFTBAN_LIB_DIR}/lib/version.sh"
 26: #   echo "$NFTBAN_VERSION"
 27: #
 28: # meta:created_date=2025-11-24
 29: # =============================================================================
 30: 
 31: # =============================================================================
 32: # GUARD: Prevent double-loading
 33: # =============================================================================
 34: 
 35: [[ -n "${NFTBAN_VERSION_LOADED:-}" ]] && return 0
 36: 
 37: # =============================================================================
 38: # VERSION CONSTANTS
 39: # =============================================================================
 40: 
 41: # Read version from VERSION file (single source of truth)
 42: _nftban_read_version() {
 43:     local version_file
 44:     # Try multiple possible locations
 45:     for path in \
 46:         "${BASH_SOURCE[0]%/*}/../../../../../VERSION" \
 47:         "/usr/lib/nftban/VERSION" \
 48:         "${NFTBAN_ROOT:-}/VERSION" \
 49:         "$PWD/VERSION"; do
 50:         if [[ -f "$path" ]]; then
 51:             version_file="$path"
 52:             break
 53:         fi
 54:     done
 55: 
 56:     if [[ -f "$version_file" ]]; then
 57:         cat "$version_file" | tr -d '[:space:]'
 58:     else
 59:         echo "1.0.5"  # Fallback if VERSION file not found
 60:     fi
 61: }
 62: 
 63: # Main NFTBan version (read from VERSION file)
 64: NFTBAN_VERSION=$(_nftban_read_version)
 65: readonly NFTBAN_VERSION
 66: 
 67: # Parse version components
 68: IFS='.' read -r NFTBAN_VERSION_MAJOR NFTBAN_VERSION_MINOR NFTBAN_VERSION_PATCH <<< "$NFTBAN_VERSION"
 69: readonly NFTBAN_VERSION_MAJOR
 70: readonly NFTBAN_VERSION_MINOR
 71: readonly NFTBAN_VERSION_PATCH
 72: 
 73: # Version details
 74: readonly NFTBAN_VERSION_NAME="Unified Security Platform"
 75: readonly NFTBAN_VERSION_DATE="2025-12-01"
 76: NFTBAN_BUILD_DATE="$(date '+%Y-%m-%d %H:%M:%S')"
 77: readonly NFTBAN_BUILD_DATE
 78: 
 79: # Component versions (kept in sync with main version)
 80: readonly NFTBAN_CLI_VERSION="$NFTBAN_VERSION"
 81: readonly NFTBAN_CORE_VERSION="$NFTBAN_VERSION"
 82: readonly NFTBAN_GUI_VERSION="$NFTBAN_VERSION"
 83: readonly NFTBAN_API_VERSION="$NFTBAN_VERSION"
 84: 
 85: # Compatibility
 86: readonly NFTBAN_MIN_BASH_VERSION="4.0"
 87: readonly NFTBAN_MIN_NFT_VERSION="0.9.3"
 88: 
 89: # =============================================================================
 90: # VERSION INFORMATION FUNCTIONS
 91: # =============================================================================
 92: 
 93: nftban_version_full() {
 94:     # Get full version string
 95:     # Returns: "NFTBan v0.6.5 (Strict Mode) - 2025-11-24"
 96:     echo "NFTBan v${NFTBAN_VERSION} (${NFTBAN_VERSION_NAME}) - ${NFTBAN_VERSION_DATE}"
 97: }
 98: 
 99: nftban_version_short() {
100:     # Get short version string
101:     # Returns: "0.6.5"
102:     echo "$NFTBAN_VERSION"
103: }
104: 
105: nftban_version_numeric() {
106:     # Get numeric version for comparison
107:     # Returns: 605 (for 0.6.5)
108:     echo "$((NFTBAN_VERSION_MAJOR * 10000 + NFTBAN_VERSION_MINOR * 100 + NFTBAN_VERSION_PATCH))"
109: }
110: 
111: nftban_version_check() {
112:     # Check if a version requirement is met
113:     # Args: $1 = required version (e.g., "0.6.0")
114:     # Returns: 0 if current version >= required, 1 otherwise
115: 
116:     local required="$1"
117:     local required_major required_minor required_patch
118: 
119:     IFS='.' read -r required_major required_minor required_patch <<< "$required"
120: 
121:     local required_numeric=$((required_major * 10000 + required_minor * 100 + required_patch))
122:     local current_numeric
123:     current_numeric=$(nftban_version_numeric)
124: 
125:     [[ $current_numeric -ge $required_numeric ]]
126: }
127: 
128: nftban_version_info() {
129:     # Print detailed version information
130:     cat <<EOF
131: ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
132: NFTBan Version Information
133: ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
134: 
135: Version:        ${NFTBAN_VERSION}
136: Name:           ${NFTBAN_VERSION_NAME}
137: Release Date:   ${NFTBAN_VERSION_DATE}
138: Build Date:     ${NFTBAN_BUILD_DATE}
139: 
140: Components:
141:   CLI:          ${NFTBAN_CLI_VERSION}
142:   Core:         ${NFTBAN_CORE_VERSION}
143:   GUI:          ${NFTBAN_GUI_VERSION}
144:   API:          ${NFTBAN_API_VERSION}
145: 
146: Requirements:
147:   Bash:         >= ${NFTBAN_MIN_BASH_VERSION}
148:   nftables:     >= ${NFTBAN_MIN_NFT_VERSION}
149: 
150: ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
151: EOF
152: }
153: 
154: # =============================================================================
155: # COMPATIBILITY CHECK
156: # =============================================================================
157: 
158: nftban_version_check_requirements() {
159:     # Check if system meets minimum requirements
160:     # Returns: 0 if all requirements met, 1 otherwise
161: 
162:     local status=0
163: 
164:     # Check bash version
165:     if [[ "${BASH_VERSINFO[0]}.${BASH_VERSINFO[1]}" < "$NFTBAN_MIN_BASH_VERSION" ]]; then
166:         echo "ERROR: Bash ${BASH_VERSINFO[0]}.${BASH_VERSINFO[1]} is too old. Need >= $NFTBAN_MIN_BASH_VERSION" >&2
167:         status=1
168:     fi
169: 
170:     # Check nftables version (if nft is available)
171:     if command -v nft &>/dev/null; then
172:         local nft_version
173:         nft_version=$(nft --version 2>&1 | grep -oP 'v\K[0-9]+\.[0-9]+\.[0-9]+' | head -1)
174: 
175:         if [[ -n "$nft_version" ]]; then
176:             # Simple version comparison (works for most cases)
177:             if [[ "$nft_version" < "$NFTBAN_MIN_NFT_VERSION" ]]; then
178:                 echo "WARNING: nftables $nft_version may be too old. Recommend >= $NFTBAN_MIN_NFT_VERSION" >&2
179:             fi
180:         fi
181:     fi
182: 
183:     return $status
184: }
185: 
186: # =============================================================================
187: # EXPORT FUNCTIONS
188: # =============================================================================
189: 
190: export -f nftban_version_full
191: export -f nftban_version_short
192: export -f nftban_version_numeric
193: export -f nftban_version_check
194: export -f nftban_version_info
195: export -f nftban_version_check_requirements
196: 
197: # =============================================================================
198: # MARK AS LOADED
199: # =============================================================================
200: 
201: readonly NFTBAN_VERSION_LOADED=1
202: export NFTBAN_VERSION_LOADED
203: 
204: # =============================================================================
205: # MODULE LOADED SUCCESSFULLY
206: # =============================================================================
207: 
208: # Silent - no output on load
209: true
</file>

<file path="cli/lib/nftban/setup/install_suricata.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0 - Suricata IDS Installation Script
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Install and configure Suricata IDS for NFTBan (from source)
  7: # Location: /usr/lib/nftban/setup/install_suricata.sh
  8: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
  9: # meta:homepage=https://nftban.com
 10: #
 11: # meta:name=install_suricata
 12: # meta:type=setup
 13: # meta:header=Suricata IDS Installation
 14: # meta:version=1.0.0
 15: #
 16: # meta:created_date=2025-11-29
 17: # =============================================================================
 18: #
 19: # This script compiles Suricata from source for distributions where
 20: # packages are not available (e.g., CentOS Stream 10).
 21: #
 22: # Similar to install_victoriametrics.sh pattern.
 23: # =============================================================================
 24: 
 25: set -Eeuo pipefail
 26: IFS=$'\n\t'
 27: 
 28: # =============================================================================
 29: # LIBRARY LOADING
 30: # =============================================================================
 31: 
 32: # Determine library path
 33: NFTBAN_LIB_DIR="${NFTBAN_LIB_DIR:-/usr/lib/nftban}"
 34: 
 35: # Source common setup utilities
 36: if [[ -f "${NFTBAN_LIB_DIR}/lib/setup_utils.sh" ]]; then
 37:     # shellcheck source=/dev/null
 38:     source "${NFTBAN_LIB_DIR}/lib/setup_utils.sh"
 39: elif [[ -f "$(dirname "${BASH_SOURCE[0]}")/../lib/setup_utils.sh" ]]; then
 40:     # shellcheck source=/dev/null
 41:     source "$(dirname "${BASH_SOURCE[0]}")/../lib/setup_utils.sh"
 42: else
 43:     # Fallback: define functions inline if library not found
 44:     echo "[WARN] setup_utils.sh not found, using inline definitions" >&2
 45:     readonly RED='\033[0;31m'
 46:     readonly GREEN='\033[0;32m'
 47:     readonly YELLOW='\033[1;33m'
 48:     readonly NC='\033[0m'
 49:     print_status() { echo -e "${GREEN}[✓]${NC} $1" >&2; }
 50:     print_error() { echo -e "${RED}[✗]${NC} $1" >&2; }
 51:     print_info() { echo -e "${YELLOW}[i]${NC} $1" >&2; }
 52:     detect_distro() { [[ -f /etc/os-release ]] && { . /etc/os-release; echo "${ID:-unknown}"; } || echo "unknown"; }
 53: fi
 54: 
 55: # =============================================================================
 56: # CONFIGURATION
 57: # =============================================================================
 58: 
 59: # Suricata configuration
 60: readonly SURICATA_VERSION="${SURICATA_VERSION:-7.0.7}"
 61: readonly SURICATA_URL="https://www.openinfosecfoundation.org/download/suricata-${SURICATA_VERSION}.tar.gz"
 62: readonly SURICATA_USER="suricata"
 63: readonly SURICATA_GROUP="suricata"
 64: readonly SURICATA_BIN="/usr/bin/suricata"
 65: readonly SURICATA_CONF_DIR="/etc/suricata"
 66: readonly SURICATA_DATA_DIR="/var/lib/suricata"
 67: readonly SURICATA_LOG_DIR="/var/log/nftban/suricata"  # NFTBan HFS
 68: readonly NFTBAN_TEMPLATES="/home/gituser/github/nftban-v1.0-dev/install/templates"
 69: 
 70: # Note: print_status, print_error, print_info, detect_distro are now
 71: # loaded from setup_utils.sh library
 72: 
 73: detect_pkg_manager() {
 74:     local distro="$1"
 75: 
 76:     case "$distro" in
 77:         centos|rhel|fedora|rocky|alma*)
 78:             echo "dnf"
 79:             ;;
 80:         debian|ubuntu)
 81:             echo "apt"
 82:             ;;
 83:         *)
 84:             echo "unknown"
 85:             ;;
 86:     esac
 87: }
 88: 
 89: install_build_deps() {
 90:     local pkg_mgr="$1"
 91: 
 92:     print_info "Installing build dependencies..."
 93: 
 94:     case "$pkg_mgr" in
 95:         dnf)
 96:             dnf install -y \
 97:                 gcc gcc-c++ make automake autoconf libtool \
 98:                 pcre2-devel libyaml-devel zlib-devel libcap-ng-devel \
 99:                 jansson-devel file-devel nss-devel libnetfilter_queue-devel \
100:                 libnet-devel rust cargo python3-pip \
101:                 libpcap-devel libnfnetlink-devel \
102:                 ethtool || {
103:                 print_error "Failed to install build dependencies"
104:                 return 1
105:             }
106:             ;;
107:         apt)
108:             apt-get update
109:             apt-get install -y \
110:                 build-essential autoconf automake libtool \
111:                 libpcre2-dev libyaml-dev zlib1g-dev libcap-ng-dev \
112:                 libjansson-dev libmagic-dev libnss3-dev libnetfilter-queue-dev \
113:                 libnet1-dev rustc cargo python3-pip \
114:                 libpcap-dev libnfnetlink-dev \
115:                 ethtool || {
116:                 print_error "Failed to install build dependencies"
117:                 return 1
118:             }
119:             ;;
120:         *)
121:             print_error "Unknown package manager"
122:             return 1
123:             ;;
124:     esac
125: 
126:     print_status "Build dependencies installed"
127: }
128: 
129: download_suricata() {
130:     local version="$1"
131:     local tmp_dir="/tmp/suricata-install-$$"
132: 
133:     print_info "Downloading Suricata ${version}..."
134: 
135:     mkdir -p "$tmp_dir"
136:     cd "$tmp_dir"
137: 
138:     curl -L "$SURICATA_URL" -o suricata.tar.gz || {
139:         print_error "Download failed from $SURICATA_URL"
140:         return 1
141:     }
142: 
143:     tar xzf suricata.tar.gz || {
144:         print_error "Failed to extract tarball"
145:         return 1
146:     }
147: 
148:     cd "suricata-${version}"
149: 
150:     print_status "Suricata source downloaded and extracted"
151:     pwd
152: }
153: 
154: compile_suricata() {
155:     local source_dir="$1"
156: 
157:     print_info "Configuring Suricata..."
158:     cd "$source_dir"
159: 
160:     ./configure \
161:         --prefix=/usr \
162:         --sysconfdir=/etc \
163:         --localstatedir=/var \
164:         --enable-nfqueue \
165:         --enable-af-packet || {
166:         print_error "Configuration failed"
167:         return 1
168:     }
169: 
170:     print_status "Configuration complete"
171: 
172:     print_info "Building Suricata (this may take several minutes)..."
173:     make -j"$(nproc)" || {
174:         print_error "Build failed"
175:         return 1
176:     }
177: 
178:     print_status "Build complete"
179: }
180: 
181: install_suricata() {
182:     local source_dir="$1"
183: 
184:     print_info "Installing Suricata binaries..."
185:     cd "$source_dir"
186: 
187:     make install || {
188:         print_error "Installation failed"
189:         return 1
190:     }
191: 
192:     print_status "Binaries installed"
193: 
194:     print_info "Installing default configuration..."
195:     make install-conf || {
196:         print_error "Config installation failed"
197:         return 1
198:     }
199: 
200:     print_status "Configuration files installed"
201: }
202: 
203: create_user() {
204:     print_info "Creating Suricata user and group..."
205: 
206:     # Create group if doesn't exist
207:     if ! getent group "$SURICATA_GROUP" >/dev/null 2>&1; then
208:         groupadd --system "$SURICATA_GROUP"
209:         print_status "Created group: $SURICATA_GROUP"
210:     else
211:         print_info "Group already exists: $SURICATA_GROUP"
212:     fi
213: 
214:     # Create user if doesn't exist
215:     if ! getent passwd "$SURICATA_USER" >/dev/null 2>&1; then
216:         useradd --system --no-create-home --shell /usr/sbin/nologin \
217:                 --gid "$SURICATA_GROUP" "$SURICATA_USER"
218:         print_status "Created user: $SURICATA_USER"
219:     else
220:         print_info "User already exists: $SURICATA_USER"
221:     fi
222: }
223: 
224: create_directories() {
225:     print_info "Creating Suricata directories (NFTBan HFS)..."
226: 
227:     # NFTBan-controlled directories
228:     mkdir -p "$SURICATA_CONF_DIR"
229:     mkdir -p "$SURICATA_DATA_DIR/rules"
230:     mkdir -p /var/log/nftban  # Parent directory
231:     mkdir -p "$SURICATA_LOG_DIR"  # /var/log/nftban/suricata
232:     mkdir -p /var/run/suricata
233: 
234:     # Set ownership
235:     chown -R "$SURICATA_USER:$SURICATA_GROUP" "$SURICATA_DATA_DIR"
236:     chown -R "$SURICATA_USER:$SURICATA_GROUP" "$SURICATA_LOG_DIR"
237:     chown -R "$SURICATA_USER:$SURICATA_GROUP" /var/run/suricata
238: 
239:     # Set permissions (NFTBan HFS compliance)
240:     chmod 755 "$SURICATA_CONF_DIR"
241:     chmod 750 "$SURICATA_DATA_DIR"
242:     chmod 750 /var/log/nftban
243:     chmod 750 "$SURICATA_LOG_DIR"
244:     chmod 755 /var/run/suricata
245: 
246:     print_status "Directories created (logs under NFTBan control)"
247: }
248: 
249: create_systemd_service() {
250:     print_info "Creating systemd service with resource limits..."
251: 
252:     # Detect CPU count for affinity
253:     local cpu_count
254:     cpu_count=$(nproc)
255:     local cpu_limit="150%"  # Default: allow 1.5 cores
256: 
257:     if [[ $cpu_count -ge 4 ]]; then
258:         cpu_limit="200%"  # 4+ cores: allow 2 cores
259:     fi
260: 
261:     cat > /etc/systemd/system/suricata.service << EOF
262: [Unit]
263: Description=Suricata Intrusion Detection Service
264: Documentation=https://suricata.io/documentation/
265: After=network.target
266: 
267: [Service]
268: Type=simple
269: User=root
270: Group=root
271: ExecStart=/usr/bin/suricata -c /etc/suricata/suricata.yaml --af-packet
272: ExecReload=/bin/kill -USR2 \$MAINPID
273: Restart=on-failure
274: RestartSec=5
275: 
276: # Resource limits (optimized for NFTBan use-case)
277: MemoryMax=1G
278: MemoryHigh=800M
279: CPUQuota=$cpu_limit
280: CPUAccounting=yes
281: MemoryAccounting=yes
282: 
283: # Security hardening
284: PrivateTmp=yes
285: ProtectSystem=strict
286: ReadWritePaths=/var/log/nftban/suricata /var/lib/suricata /var/run/suricata
287: NoNewPrivileges=yes
288: CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_IPC_LOCK
289: 
290: [Install]
291: WantedBy=multi-user.target
292: EOF
293: 
294:     systemctl daemon-reload
295:     print_status "Systemd service created (CPU: $cpu_limit, RAM: max 1GB)"
296: }
297: 
298: install_suricata_update() {
299:     print_info "Installing suricata-update..."
300: 
301:     pip3 install --upgrade suricata-update || {
302:         print_error "Failed to install suricata-update"
303:         return 1
304:     }
305: 
306:     print_status "suricata-update installed"
307: }
308: 
309: apply_sysctl_tuning() {
310:     print_info "Applying network buffer tuning..."
311: 
312:     # Increase network buffers for AF_PACKET capture
313:     cat > /etc/sysctl.d/90-suricata.conf << 'EOF'
314: # =============================================================================
315: # Suricata Network Buffer Tuning
316: # =============================================================================
317: # Increase receive buffer size for AF_PACKET capture
318: # Prevents packet drops under burst traffic
319: 
320: # Default: 212992 (208 KB)
321: # Optimized: 67108864 (64 MB)
322: net.core.rmem_max = 67108864
323: 
324: # Default: 1000
325: # Optimized: 10000 (handle burst better)
326: net.core.netdev_max_backlog = 10000
327: 
328: # Optional: Increase send buffer (if Suricata forwards traffic)
329: net.core.wmem_max = 67108864
330: EOF
331: 
332:     sysctl -p /etc/sysctl.d/90-suricata.conf >/dev/null 2>&1
333:     print_status "Network buffers increased (rmem_max: 64MB, backlog: 10k)"
334: }
335: 
336: tune_nic_for_ids() {
337:     print_info "Tuning NIC for optimal Suricata capture..."
338: 
339:     # Detect primary interface (used by Suricata)
340:     local iface
341:     iface=$(ip route get 8.8.8.8 2>/dev/null | awk '{print $5; exit}')
342: 
343:     if [[ -z "$iface" ]]; then
344:         print_info "Could not detect primary interface, skipping NIC tuning"
345:         return 0
346:     fi
347: 
348:     print_info "Primary interface: $iface"
349: 
350:     # Check if ethtool is available
351:     if ! command -v ethtool &>/dev/null; then
352:         print_info "ethtool not installed, skipping NIC tuning"
353:         return 0
354:     fi
355: 
356:     # 1. Disable NIC offloads (CRITICAL for accurate DPI)
357:     # GRO/LRO merge packets - Suricata needs to see original packets
358:     # TSO/GSO segment packets - same issue
359:     print_info "Disabling NIC offloads for accurate packet inspection..."
360: 
361:     # Disable each individually (some may not be supported)
362:     ethtool -K "$iface" gro off 2>/dev/null || true   # Generic Receive Offload
363:     ethtool -K "$iface" lro off 2>/dev/null || true   # Large Receive Offload
364:     ethtool -K "$iface" gso off 2>/dev/null || true   # Generic Segmentation Offload
365:     ethtool -K "$iface" tso off 2>/dev/null || true   # TCP Segmentation Offload
366: 
367:     # 2. Increase NIC ring buffers (handle burst traffic)
368:     print_info "Increasing NIC ring buffers..."
369: 
370:     # Get max supported values
371:     local rx_max tx_max
372:     rx_max=$(ethtool -g "$iface" 2>/dev/null | grep -A4 "Pre-set maximums" | awk '/^RX:/ {print $2}')
373:     tx_max=$(ethtool -g "$iface" 2>/dev/null | grep -A4 "Pre-set maximums" | awk '/^TX:/ {print $2}')
374: 
375:     # Set to max (or 4096 if smaller)
376:     if [[ -n "$rx_max" ]]; then
377:         local rx_set=$((rx_max < 4096 ? rx_max : 4096))
378:         local tx_set=$((tx_max < 4096 ? tx_max : 4096))
379:         ethtool -G "$iface" rx "$rx_set" tx "$tx_set" 2>/dev/null || true
380:         print_info "Ring buffers set: RX=$rx_set TX=$tx_set"
381:     fi
382: 
383:     # 3. Create persistent script for reboot
384:     cat > /etc/NetworkManager/dispatcher.d/99-suricata-nic-tune << EOF
385: #!/bin/bash
386: # NFTBan: Suricata NIC tuning (applied on interface up)
387: # Location: /etc/NetworkManager/dispatcher.d/99-suricata-nic-tune
388: 
389: IFACE="\$1"
390: ACTION="\$2"
391: 
392: # Only apply for primary interface on "up" event
393: if [[ "\$ACTION" != "up" ]] || [[ "\$IFACE" != "$iface" ]]; then
394:     exit 0
395: fi
396: 
397: # Disable offloads for Suricata DPI accuracy
398: ethtool -K "\$IFACE" gro off lro off gso off tso off 2>/dev/null || true
399: 
400: # Increase ring buffers if supported
401: ethtool -G "\$IFACE" rx 4096 tx 4096 2>/dev/null || true
402: 
403: logger "NFTBan: Suricata NIC tuning applied to \$IFACE"
404: EOF
405:     chmod +x /etc/NetworkManager/dispatcher.d/99-suricata-nic-tune 2>/dev/null || true
406: 
407:     # Alternative: create systemd oneshot for non-NetworkManager systems
408:     cat > /etc/systemd/system/suricata-nic-tune.service << EOF
409: [Unit]
410: Description=Tune NIC for Suricata IDS
411: After=network.target
412: Before=suricata.service
413: 
414: [Service]
415: Type=oneshot
416: RemainAfterExit=yes
417: ExecStart=/bin/bash -c 'ethtool -K $iface gro off lro off gso off tso off 2>/dev/null || true; ethtool -G $iface rx 4096 tx 4096 2>/dev/null || true'
418: 
419: [Install]
420: WantedBy=multi-user.target
421: EOF
422:     systemctl daemon-reload
423:     systemctl enable suricata-nic-tune.service 2>/dev/null || true
424: 
425:     print_status "NIC tuning applied: offloads disabled, ring buffers increased"
426:     print_info "Tuning will persist across reboots"
427: }
428: 
429: configure_suricata() {
430:     print_info "Applying optimized Suricata configuration..."
431: 
432:     # 1. Apply optimized suricata.yaml template
433:     if [[ -f "$NFTBAN_TEMPLATES/suricata.yaml.optimized" ]]; then
434:         cp "$NFTBAN_TEMPLATES/suricata.yaml.optimized" "$SURICATA_CONF_DIR/suricata.yaml"
435:         print_status "Applied optimized suricata.yaml (10-30% CPU target)"
436:     else
437:         print_error "Optimized template not found: $NFTBAN_TEMPLATES/suricata.yaml.optimized"
438:         return 1
439:     fi
440: 
441:     # 2. Copy rule enable/disable/filters configs
442:     local etc_suricata_src="/home/gituser/github/nftban-v1.0-dev/etc/suricata"
443: 
444:     if [[ -d "$etc_suricata_src" ]]; then
445:         cp "$etc_suricata_src/enable.conf" "$SURICATA_CONF_DIR/"
446:         cp "$etc_suricata_src/disable.conf" "$SURICATA_CONF_DIR/"
447:         cp "$etc_suricata_src/filters.conf" "$SURICATA_CONF_DIR/"
448:         cp "$etc_suricata_src/README.md" "$SURICATA_CONF_DIR/"
449: 
450:         # Copy .local.example files (users will create .local themselves)
451:         cp "$etc_suricata_src/enable.conf.local.example" "$SURICATA_CONF_DIR/"
452:         cp "$etc_suricata_src/disable.conf.local.example" "$SURICATA_CONF_DIR/"
453:         cp "$etc_suricata_src/filters.conf.local.example" "$SURICATA_CONF_DIR/"
454: 
455:         print_status "Copied rule management configs (enable/disable/filters)"
456:     else
457:         print_error "Rule configs not found: $etc_suricata_src"
458:         return 1
459:     fi
460: 
461:     # 3. Apply sysctl tuning
462:     apply_sysctl_tuning || return 1
463: 
464:     # 4. Apply NIC tuning (offloads + ring buffers)
465:     tune_nic_for_ids || return 1
466: 
467:     # 5. Update Suricata rules
468:     print_info "Updating Suricata rules with enable/disable configs..."
469:     if command -v suricata-update &>/dev/null; then
470:         cd "$SURICATA_CONF_DIR"
471:         suricata-update \
472:             --suricata "$SURICATA_BIN" \
473:             --suricata-conf "$SURICATA_CONF_DIR/suricata.yaml" || {
474:             print_error "suricata-update failed"
475:             return 1
476:         }
477:         print_status "Rules updated and optimized"
478:     else
479:         print_error "suricata-update not found"
480:         return 1
481:     fi
482: 
483:     # 5. Verify configuration
484:     print_info "Verifying Suricata configuration..."
485:     if "$SURICATA_BIN" -T -c "$SURICATA_CONF_DIR/suricata.yaml" >/dev/null 2>&1; then
486:         print_status "Configuration validated successfully"
487:     else
488:         print_error "Configuration validation failed"
489:         "$SURICATA_BIN" -T -c "$SURICATA_CONF_DIR/suricata.yaml"
490:         return 1
491:     fi
492: 
493:     print_status "Suricata fully optimized for NFTBan"
494:     echo ""
495:     print_info "Optimization Summary:"
496:     echo "  - AF_PACKET: ring-size 300k, cluster_flow"
497:     echo "  - HTTP body inspection: DISABLED (40-60% CPU savings)"
498:     echo "  - Flow timeouts: 60s (was 300s, RAM savings)"
499:     echo "  - Protocols: SSH, HTTP, DNS, TLS enabled"
500:     echo "  - Protocols: SMB, FTP, SMTP disabled by default"
501:     echo "  - Eve.json: $SURICATA_LOG_DIR/eve.json"
502:     echo "  - Network buffers: rmem_max 64MB, backlog 10k"
503:     echo "  - NIC offloads: GRO/LRO/GSO/TSO disabled"
504:     echo "  - NIC ring buffers: Increased (up to 4096)"
505:     echo "  - Expected: 10-30% CPU, 300-600MB RAM"
506: }
507: 
508: cleanup() {
509:     local tmp_dir="$1"
510: 
511:     if [[ -n "$tmp_dir" && -d "$tmp_dir" ]]; then
512:         print_info "Cleaning up temporary files..."
513:         cd /
514:         rm -rf "$tmp_dir"
515:         print_status "Cleanup complete"
516:     fi
517: }
518: 
519: main() {
520:     print_info "NFTBan Suricata Installation (From Source)"
521:     echo ""
522: 
523:     # Check root
524:     if [[ $EUID -ne 0 ]]; then
525:         print_error "This script must be run as root"
526:         exit 1
527:     fi
528: 
529:     # Check if already installed
530:     if [[ -f "$SURICATA_BIN" ]]; then
531:         local current_version
532:         current_version=$("$SURICATA_BIN" --build-info 2>&1 | grep -oP 'Suricata version \K[0-9.]+' | head -1 || echo "unknown")
533:         print_info "Suricata already installed: $current_version"
534: 
535:         read -p "Reinstall? [y/N] " -n 1 -r
536:         echo
537:         if [[ ! $REPLY =~ ^[Yy]$ ]]; then
538:             exit 0
539:         fi
540:     fi
541: 
542:     # Detect distribution
543:     local distro
544:     distro=$(detect_distro)
545:     print_info "Detected distribution: $distro"
546: 
547:     # Detect package manager

   1: #!/usr/bin/env bash
   2: # =============================================================================
   3: # NFTBan Installation Script
   4: # =============================================================================
   5: # SPDX-License-Identifier: MPL-2.0
   6: # Purpose: Install NFTBan on the local system
   7: # Usage: ./install.sh
   8: #
   9: # Installs:
  10: #   - Go binaries (nftban-core, nftban-ui)
  11: #   - CLI modules and libraries
  12: #   - Polkit rules
  13: #   - Systemd timers
  14: #   - NFTables base config
  15: #   - GeoIP database (free)
  16: #
  17: # One question: Enable metrics? (prometheus/victoriametrics)
  18: #
  19: # Later (via CLI):
  20: #   - nftban gui enable
  21: #   - nftban suricata setup
  22: # =============================================================================
  23: 
  24: set -euo pipefail
  25: 
  26: # Colors for output
  27: GREEN='\033[0;32m'
  28: BLUE='\033[0;34m'
  29: YELLOW='\033[1;33m'
  30: RED='\033[0;31m'
  31: CYAN='\033[0;36m'
  32: NC='\033[0m' # No Color
  33: 
  34: log()   { echo -e "${BLUE}[INSTALL]${NC} $*"; }
  35: ok()    { echo -e "${GREEN}[  OK   ]${NC} $*"; }
  36: warn()  { echo -e "${YELLOW}[ WARN  ]${NC} $*"; }
  37: error() { echo -e "${RED}[ ERROR ]${NC} $*" >&2; }
  38: info()  { echo -e "${CYAN}[  INFO ]${NC} $*"; }
  39: 
  40: # Get script directory
  41: SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  42: cd "$SCRIPT_DIR"
  43: 
  44: # Configuration
  45: BIN_DIR="$SCRIPT_DIR/bin"
  46: 
  47: # Installation paths
  48: CORE_BIN_DIR="/usr/lib/nftban/bin"
  49: CORE_INSTALL_PATH="$CORE_BIN_DIR/nftban-core"
  50: CLI_INSTALL_PATH="/usr/bin/nftban"

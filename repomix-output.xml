 530: # Get NFTables set sizes (number of elements in each set)
 531: get_nftables_set_sizes() {
 532:     if ! command -v nft &>/dev/null; then
 533:         return
 534:     fi
 535: 
 536:     # List all sets in inet nftban table
 537:     local sets
 538:     sets=$(nft -j list table inet nftban 2>/dev/null | \
 539:         jq -r '.nftables[] | select(.set != null) | .set.name' 2>/dev/null || \
 540:         nft list table ${NFTBAN_TABLE_IPV4} 2>/dev/null | grep -oP 'set \K\w+' || echo "")
 541: 
 542:     if [[ -z "$sets" ]]; then
 543:         # Fallback: try common set names (v0.6.2: fixed geoban set names)
 544:         sets="whitelist_v4 whitelist_v6 blacklist_v4 blacklist_v6 temp_ban_v4 temp_ban_v6 feed_v4 feed_v6 geoban_blocked_v4 geoban_blocked_v6"
 545:     fi
 546: 
 547:     # Count elements in each set
 548:     local set_name
 549:     for set_name in $sets; do
 550:         # Check if set exists first
 551:         if nft list set inet nftban "$set_name" &>/dev/null; then
 552:             local count
 553:             count=$(nft list set inet nftban "$set_name" 2>/dev/null | \
 554:                 grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}|([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}' | \
 555:                 wc -l || echo "0")
 556:             echo "${set_name} ${count:-0}"
 557:         fi
 558:     done
 559: }

357: 
358:     # Write safely
359:     nftban_write_safe "$safe_path" "$report"
360: 
361:     echo "[SUCCESS] Report: $safe_path"
362: }
363: 
364: # Usage: generate_report "myreport.html"
365: # Or:    generate_report "/var/lib/nftban/reports/custom.html"
366: # Or:    generate_report ""  # Uses default
367: 
368: USAGE_EXAMPLES
369: 
370: # =============================================================================
371: # MODULE INITIALIZATION
372: # =============================================================================
373: 
374: # Auto-enable secure mode on load
375: if [[ "${NFTBAN_SECURE_MODE_ENABLED}" == "1" ]]; then
376:     echo "[SECURE MODE] Auto-enabled - file writes will be validated" >&2
377: fi
378: 
379: # Export all functions
380: declare -fx nftban_secure_write
381: declare -fx nftban_secure_append
382: declare -fx nftban_secure_copy
383: declare -fx nftban_secure_tee

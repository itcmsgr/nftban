196: 			return feeds, nil
197: 		}
198: 		return nil, fmt.Errorf("failed to read feeds directory: %w", err)
199: 	}
200: 
201: 	// Files to exclude (helper/library files, not actual feeds)
202: 	excludeFiles := map[string]bool{
203: 		"library": true, // Internal library/helper file
204: 	}
205: 
206: 	for _, entry := range entries {
207: 		if entry.IsDir() {
208: 			continue
209: 		}
210: 		if strings.HasSuffix(entry.Name(), ".txt") {
211: 			feedName := strings.TrimSuffix(entry.Name(), ".txt")
212: 
213: 			// Skip excluded files
214: 			if excludeFiles[feedName] {
215: 				continue
216: 			}
217: 
218: 			feeds = append(feeds, feedName)
219: 		}
220: 	}
221: 
222: 	return feeds, nil

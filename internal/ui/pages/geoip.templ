package pages

import (
	"fmt"
	"strings"
	"github.com/itcmsgr/nftban/internal/ui"
)

// GeoIP renders the GeoIP/GeoBan management page
templ GeoIP(data ui.GeoIPPageData) {
	@ui.LayoutWithNav("GeoIP", "geoip") {
		<!-- Page Header -->
		<div class="page-header">
			<h1 class="page-title">GeoIP / Country Blocking</h1>
			<div style="display: flex; gap: 0.5rem;">
				if data.BlockingEnabled {
					<span class="badge badge-success">Blocking Enabled</span>
				} else {
					<span class="badge badge-muted">Blocking Disabled</span>
				}
				<button class="btn btn-primary" hx-get="/ui/frag/geoip" hx-target="#geoip-content" hx-swap="innerHTML">
					Refresh
				</button>
			</div>
		</div>

		<!-- Database Info Banner -->
		<div class="card info-banner" style="margin-bottom: 1.5rem;">
			<div class="geoip-info-grid">
				<div class="info-item">
					<span class="info-label">Database</span>
					<span class="info-value">{ data.DatabaseVersion }</span>
				</div>
				<div class="info-item">
					<span class="info-label">Last Update</span>
					<span class="info-value">{ data.LastUpdate }</span>
				</div>
				<div class="info-item">
					<span class="info-label">Size</span>
					<span class="info-value">{ data.DatabaseSize }</span>
				</div>
				<div class="info-item">
					<span class="info-label">Mode</span>
					<span class="info-value">{ data.BlockingMode }</span>
				</div>
				<div class="info-item">
					<span class="info-label">Next Update</span>
					<span class="info-value">{ data.NextUpdate }</span>
				</div>
				<div class="info-item">
					<span class="info-label">Auto-Update</span>
					<span class="info-value">
						if data.UpdateEnabled {
							Enabled
						} else {
							Disabled
						}
					</span>
				</div>
			</div>
		</div>

		<div id="geoip-content">
			@GeoIPContentFragment(data)
		</div>
	}
}

// GeoIPContentFragment renders all GeoIP content sections
templ GeoIPContentFragment(data ui.GeoIPPageData) {
	<!-- Summary Stats Row -->
	<div class="geoip-stats-row">
		<div class="stat-card">
			<div class="stat-value">{ intToStr(data.TotalCountries) }</div>
			<div class="stat-label">Total Countries</div>
		</div>
		<div class="stat-card danger">
			<div class="stat-value">{ intToStr(data.BlockedCountries) }</div>
			<div class="stat-label">Blocked</div>
		</div>
		<div class="stat-card safe">
			<div class="stat-value">{ intToStr(data.AllowedCountries) }</div>
			<div class="stat-label">Allowed</div>
		</div>
		<div class="stat-card">
			<div class="stat-value">{ intToStr(data.TotalRanges) }</div>
			<div class="stat-label">IP Ranges</div>
		</div>
		<div class="stat-card">
			<div class="stat-value">{ formatLargeNumber(data.TotalIPs) }</div>
			<div class="stat-label">Total IPs Blocked</div>
		</div>
	</div>

	<!-- Main Content Grid -->
	<div class="geoip-content-grid">
		<!-- Countries Table -->
		<div class="card">
			<div class="card-header">
				<span class="card-title">Country Status</span>
				<div class="table-controls">
					<input
						type="text"
						class="search-input search-input-sm"
						placeholder="Search country..."
						hx-get="/ui/frag/geoip-countries"
						hx-trigger="keyup changed delay:300ms"
						hx-target="#countries-table"
						name="search"
					/>
				</div>
			</div>
			<div id="countries-table" class="countries-table-container">
				@GeoIPCountriesTableFragment(data.Countries)
			</div>
		</div>

		<!-- Recent Blocks -->
		<div class="card">
			<div class="card-header">
				<span class="card-title">Recent Geo-Blocks</span>
				<span class="badge badge-info">Live</span>
			</div>
			<div id="recent-blocks" hx-get="/ui/frag/geoip-recent" hx-trigger="every 5s" hx-swap="innerHTML">
				@GeoIPRecentBlocksFragment(data.RecentBlocks)
			</div>
		</div>
	</div>

	<!-- Quick Commands -->
	<div class="card" style="margin-top: 1.5rem;">
		<div class="card-header">
			<span class="card-title">CLI Commands</span>
		</div>
		<div class="command-grid">
			<div class="command-item">
				<code>nftban geoip status</code>
				<span>Show GeoIP status</span>
			</div>
			<div class="command-item">
				<code>nftban geoip lookup &lt;ip&gt;</code>
				<span>Lookup IP location</span>
			</div>
			<div class="command-item">
				<code>nftban geoip block &lt;CC&gt;</code>
				<span>Block country code</span>
			</div>
			<div class="command-item">
				<code>nftban geoip unblock &lt;CC&gt;</code>
				<span>Unblock country code</span>
			</div>
			<div class="command-item">
				<code>nftban geoip update</code>
				<span>Update GeoIP database</span>
			</div>
			<div class="command-item">
				<code>nftban geoip list</code>
				<span>List blocked countries</span>
			</div>
		</div>
	</div>

	<style>
		.geoip-info-grid {
			display: grid;
			grid-template-columns: repeat(6, 1fr);
			gap: 1rem;
		}
		@media (max-width: 1200px) {
			.geoip-info-grid {
				grid-template-columns: repeat(3, 1fr);
			}
		}
		@media (max-width: 768px) {
			.geoip-info-grid {
				grid-template-columns: repeat(2, 1fr);
			}
		}
		.info-item {
			display: flex;
			flex-direction: column;
			gap: 0.25rem;
		}
		.info-label {
			font-size: 0.7rem;
			color: var(--text-muted);
			text-transform: uppercase;
		}
		.info-value {
			font-weight: 500;
		}

		.geoip-stats-row {
			display: grid;
			grid-template-columns: repeat(5, 1fr);
			gap: 1rem;
			margin-bottom: 1.5rem;
		}
		@media (max-width: 1024px) {
			.geoip-stats-row {
				grid-template-columns: repeat(3, 1fr);
			}
		}
		@media (max-width: 768px) {
			.geoip-stats-row {
				grid-template-columns: repeat(2, 1fr);
			}
		}
		.stat-card {
			background: var(--bg-surface);
			border: 1px solid var(--border-color);
			border-radius: 8px;
			padding: 1rem;
			text-align: center;
		}
		.stat-card.danger {
			border-left: 4px solid var(--accent-danger);
		}
		.stat-card.safe {
			border-left: 4px solid var(--accent-safe);
		}
		.stat-value {
			font-size: 1.5rem;
			font-weight: 700;
			font-family: 'SF Mono', Monaco, monospace;
		}
		.stat-card.danger .stat-value { color: var(--accent-danger); }
		.stat-card.safe .stat-value { color: var(--accent-safe); }
		.stat-label {
			font-size: 0.75rem;
			color: var(--text-muted);
			text-transform: uppercase;
		}

		.geoip-content-grid {
			display: grid;
			grid-template-columns: 2fr 1fr;
			gap: 1.5rem;
		}
		@media (max-width: 1200px) {
			.geoip-content-grid {
				grid-template-columns: 1fr;
			}
		}

		.countries-table-container {
			max-height: 500px;
			overflow-y: auto;
		}

		.search-input-sm {
			padding: 0.375rem 0.75rem;
			font-size: 0.85rem;
			width: 200px;
		}

		.country-row {
			display: flex;
			align-items: center;
			padding: 0.5rem 0.75rem;
			border-bottom: 1px solid var(--border-color);
		}
		.country-row:hover {
			background: var(--bg-elevated);
		}
		.country-flag {
			font-size: 1.25rem;
			margin-right: 0.75rem;
		}
		.country-name {
			flex: 1;
			font-weight: 500;
		}
		.country-code {
			font-family: monospace;
			color: var(--text-muted);
			width: 40px;
		}
		.country-stats {
			display: flex;
			gap: 1rem;
			color: var(--text-muted);
			font-size: 0.85rem;
		}
		.country-status {
			width: 80px;
			text-align: center;
		}

		.recent-block-item {
			display: flex;
			align-items: center;
			padding: 0.75rem;
			border-bottom: 1px solid var(--border-color);
			gap: 0.75rem;
		}
		.recent-block-item:last-child {
			border-bottom: none;
		}
		.block-ip {
			font-family: monospace;
			font-weight: 500;
			color: var(--accent-danger);
		}
		.block-country {
			display: flex;
			align-items: center;
			gap: 0.5rem;
		}
		.block-time {
			font-size: 0.8rem;
			color: var(--text-muted);
			margin-left: auto;
		}

		.command-grid {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 1rem;
			padding: 1rem;
		}
		@media (max-width: 1024px) {
			.command-grid {
				grid-template-columns: repeat(2, 1fr);
			}
		}
		@media (max-width: 768px) {
			.command-grid {
				grid-template-columns: 1fr;
			}
		}
		.command-item {
			display: flex;
			flex-direction: column;
			gap: 0.25rem;
		}
		.command-item code {
			background: var(--bg-elevated);
			padding: 0.5rem;
			border-radius: 4px;
			font-size: 0.85rem;
		}
		.command-item span {
			font-size: 0.8rem;
			color: var(--text-muted);
		}
	</style>
}

// GeoIPCountriesTableFragment renders the countries table
templ GeoIPCountriesTableFragment(countries []ui.GeoCountryEntry) {
	if len(countries) == 0 {
		<div class="empty-state" style="padding: 2rem; text-align: center; color: var(--text-muted);">
			No country data available
		</div>
	} else {
		for _, country := range countries {
			<div class="country-row">
				<span class="country-flag">{ getCountryFlag(country.Code) }</span>
				<span class="country-code">{ country.Code }</span>
				<span class="country-name">{ country.Name }</span>
				<span class="country-stats">
					if country.IPCount > 0 {
						<span title="Total IPs in ranges">{ formatLargeNumber(country.IPCount) } IPs</span>
					}
					<span title="IP Ranges">{ intToStr(country.RangeCount) } ranges</span>
					<span title="Bans from this country">{ intToStr(country.BansFromHere) } bans</span>
				</span>
				<span class="country-status">
					if country.Blocked {
						<span class="badge badge-danger">Blocked</span>
					} else {
						<span class="badge badge-success">Allowed</span>
					}
				</span>
			</div>
		}
	}
}

// GeoIPRecentBlocksFragment renders recent geo-blocks
templ GeoIPRecentBlocksFragment(blocks []ui.GeoBlockEntry) {
	if len(blocks) == 0 {
		<div class="empty-state" style="padding: 2rem; text-align: center; color: var(--text-muted);">
			No recent geo-blocks
		</div>
	} else {
		for _, block := range blocks {
			<div class="recent-block-item">
				<span class="block-ip">{ block.IP }</span>
				<span class="block-country">
					<span>{ getCountryFlag(block.CountryCode) }</span>
					<span>{ block.Country }</span>
				</span>
				<span class="block-time">{ block.Timestamp }</span>
			</div>
		}
	}
}

// Helper to format large numbers
func formatLargeNumber(n int64) string {
	if n >= 1000000000 {
		return fmt.Sprintf("%.1fB", float64(n)/1000000000)
	} else if n >= 1000000 {
		return fmt.Sprintf("%.1fM", float64(n)/1000000)
	} else if n >= 1000 {
		return fmt.Sprintf("%.1fK", float64(n)/1000)
	}
	return fmt.Sprintf("%d", n)
}

// getCountryFlag returns emoji flag for country code
func getCountryFlag(code string) string {
	if len(code) != 2 {
		return "🌍"
	}
	// Convert country code to regional indicator symbols
	// A = 🇦 (U+1F1E6), etc.
	code = strings.ToUpper(code)
	r1 := rune(code[0]) - 'A' + 0x1F1E6
	r2 := rune(code[1]) - 'A' + 0x1F1E6
	return string([]rune{r1, r2})
}

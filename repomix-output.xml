231:     else
232:         echo "  ERROR: nft binary not found" >&2
233:     fi
234: 
235:     echo ""
236:     echo "Boot Status:"
237:     echo "────────────────────────────────────────────────────────────"
238:     if systemctl is-enabled "${NFTABLES_SERVICE}" &>/dev/null; then
239:         echo "  Enabled at boot: ✓ YES"
240:     else
241:         echo "  Enabled at boot: ✗ NO"
242:     fi
243: }
244: 
245: _nftban_nftables_cmd_check() {
246:     echo "Checking nftables configuration..."
247:     echo ""
248: 
249:     # Check if nft binary exists
250:     if ! command -v nft &>/dev/null; then
251:         echo "ERROR: nft binary not found" >&2
252:         echo "Install nftables: sudo dnf install nftables" >&2
253:         return 1
254:     fi
255: 
256:     # Check if service is available (loaded or exists)
257:     if ! systemctl list-units --all --full | grep -q "${NFTABLES_SERVICE}"; then
258:         if ! systemctl status "${NFTABLES_SERVICE}" &>/dev/null; then
259:             echo "WARNING: nftables service not found"
260:             return 1
261:         fi
262:     fi
263: 
264:     # Check configuration syntax
265:     if [[ -f /etc/nftables/nftban.nft ]]; then
266:         echo "Checking NFTBan configuration..."
267:         nft -c -f /etc/nftables/nftban.nft
268:         if [[ $? -eq 0 ]]; then
269:             echo "✓ Configuration syntax is valid"
270:         else
271:             echo "ERROR: Configuration syntax error" >&2
272:             return 1
273:         fi
274:     fi
275: 
276:     # Check if service is active
277:     if systemctl is-active "${NFTABLES_SERVICE}" &>/dev/null; then
278:         echo "✓ Service is running"
279:     else
280:         echo "WARNING: Service is not running"
281:     fi
282: 
283:     echo ""
284:     echo "✓ All checks passed"
285: }
286: 
287: _nftban_nftables_cmd_list() {
288:     echo "Current NFTables Ruleset:"

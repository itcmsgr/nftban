195: // ValidateSIDAvailable checks if a SID is already in use
196: func ValidateSIDAvailable(sid int, rulesDir string) (bool, error) {
197: 	// Check if SID is in valid range
198: 	if sid < MinCustomSID || sid > MaxCustomSID {
199: 		return false, fmt.Errorf("SID must be in range %d-%d", MinCustomSID, MaxCustomSID)
200: 	}
201: 
202: 	// Search for SID in custom rules directory
203: 	cmd := exec.Command("grep", "-r", fmt.Sprintf("sid:%d;", sid), rulesDir)
204: 	output, err := cmd.CombinedOutput()
205: 
206: 	if err != nil {
207: 		// grep returns error code 1 if no match (which means SID is available)
208: 		if exitErr, ok := err.(*exec.ExitError); ok && exitErr.ExitCode() == 1 {
209: 			return true, nil // SID available
210: 		}
211: 		// Other errors
212: 		return false, fmt.Errorf("failed to check SID availability: %w", err)
213: 	}
214: 
215: 	// SID found in output
216: 	if len(output) > 0 {
217: 		return false, nil // SID in use
218: 	}
219: 
220: 	return true, nil // SID available
221: }
222: 
223: // SanitizeRule removes extra whitespace and normalizes formatting
224: func SanitizeRule(rule string) string {
225: 	rule = strings.TrimSpace(rule)
226: 
227: 	// Normalize multiple spaces to single space
228: 	spaceRegex := regexp.MustCompile(`\s+`)
229: 	rule = spaceRegex.ReplaceAllString(rule, " ")
230: 
231: 	// Ensure semicolons have no space before them
232: 	rule = strings.ReplaceAll(rule, " ;", ";")
233: 
234: 	return rule
235: }
236: 
237: // GetNextAvailableSID finds the next available SID in custom range
238: func GetNextAvailableSID(rulesDir string) (int, error) {
239: 	// Start from minimum custom SID
240: 	for sid := MinCustomSID; sid <= MaxCustomSID; sid++ {
241: 		available, err := ValidateSIDAvailable(sid, rulesDir)
242: 		if err != nil {
243: 			return 0, err
244: 		}
245: 		if available {
246: 			return sid, nil
247: 		}
248: 	}
249: 
250: 	return 0, fmt.Errorf("no available SIDs in custom range %d-%d", MinCustomSID, MaxCustomSID)
251: }
</file>

<file path="pkg/suricata/profile/applier.go">
  1: package profile
  2: 
  3: import (
  4: 	"fmt"
  5: 	"os"
  6: 	"path/filepath"
  7: 
  8: 	"github.com/itcmsgr/nftban/pkg/config"
  9: 	"github.com/itcmsgr/nftban/pkg/nftbanconf"
 10: )
 11: 
 12: // getPaths loads distro-specific paths from central config
 13: func getPaths() (profilesDir, suricataYAML, profileConf string, err error) {
 14: 	// Load distro config for paths
 15: 	distro, err := config.LoadDistroConfig()
 16: 	if err != nil {
 17: 		return "", "", "", fmt.Errorf("failed to load distro config: %w", err)
 18: 	}
 19: 
 20: 	// Get suricata_yaml path from distro config
 21: 	suricataYAML, ok := distro.Paths["suricata_yaml"]
 22: 	if !ok {
 23: 		// Fallback to standard path if not defined
 24: 		suricataYAML = "/etc/suricata/suricata.yaml"
 25: 	}
 26: 
 27: 	// Profile paths are NFTBan-specific, use central config dir
 28: 	cfg := nftbanconf.MustLoad()
 29: 	profilesDir = filepath.Join(cfg.ConfigDir, "suricata/profiles")
 30: 	profileConf = filepath.Join(cfg.ConfigDir, "suricata/config/profile.conf")
 31: 
 32: 	return profilesDir, suricataYAML, profileConf, nil
 33: }
 34: 
 35: // ApplyProfile creates/updates the symlink to the selected profile YAML
 36: func ApplyProfile(profile ProfileType) error {
 37: 	profilesDir, suricataYAML, profileConf, err := getPaths()
 38: 	if err != nil {
 39: 		return err
 40: 	}
 41: 
 42: 	profileName := profile.String()
 43: 	profilePath := filepath.Join(profilesDir, profileName+".yaml")
 44: 
 45: 	// Check if profile template exists
 46: 	if _, err := os.Stat(profilePath); err != nil {
 47: 		return fmt.Errorf("profile template not found: %s (run nftban install first)", profilePath)
 48: 	}
 49: 
 50: 	// Create symlink atomically
 51: 	tmpLink := suricataYAML + ".tmp"
 52: 
 53: 	// Remove old temp link if exists
 54: 	_ = os.Remove(tmpLink)
 55: 
 56: 	// Create temp symlink
 57: 	if err := os.Symlink(profilePath, tmpLink); err != nil {
 58: 		return fmt.Errorf("failed to create symlink: %w", err)
 59: 	}
 60: 
 61: 	// Atomic rename
 62: 	if err := os.Rename(tmpLink, suricataYAML); err != nil {
 63: 		_ = os.Remove(tmpLink)
 64: 		return fmt.Errorf("failed to replace symlink: %w", err)
 65: 	}
 66: 
 67: 	// Save profile name to config file
 68: 	if err := saveProfileConfig(profileName, profileConf); err != nil {
 69: 		return fmt.Errorf("failed to save profile config: %w", err)
 70: 	}
 71: 
 72: 	return nil
 73: }
 74: 
 75: // GetCurrentProfile reads the current active profile
 76: func GetCurrentProfile() (ProfileType, error) {
 77: 	_, suricataYAML, profileConf, err := getPaths()
 78: 	if err != nil {
 79: 		return ProfileStandard, err
 80: 	}
 81: 
 82: 	// Try reading from config file first
 83: 	if data, err := os.ReadFile(profileConf); err == nil {
 84: 		profileName := string(data)
 85: 		if profile, err := ProfileFromString(profileName); err == nil {
 86: 			return profile, nil
 87: 		}
 88: 	}
 89: 
 90: 	// Fallback: read symlink target
 91: 	target, err := os.Readlink(suricataYAML)
 92: 	if err != nil {
 93: 		return ProfileStandard, fmt.Errorf("no active profile (symlink not found)")
 94: 	}
 95: 
 96: 	// Extract profile name from path
 97: 	base := filepath.Base(target)
 98: 	profileName := base[:len(base)-len(".yaml")]
 99: 
100: 	profile, err := ProfileFromString(profileName)
101: 	if err != nil {
102: 		return ProfileStandard, err
103: 	}
104: 
105: 	return profile, nil
106: }
107: 
108: // saveProfileConfig writes the profile name to config file
109: func saveProfileConfig(profileName string, profileConf string) error {
110: 	// Ensure config directory exists
111: 	configDir := filepath.Dir(profileConf)
112: 	if err := os.MkdirAll(configDir, 0755); err != nil {
113: 		return err
114: 	}
115: 
116: 	// Write profile name
117: 	return os.WriteFile(profileConf, []byte(profileName), 0644)
118: }
119: 
120: // ValidateProfile checks if the current profile symlink is valid
121: func ValidateProfile() error {
122: 	profilesDir, suricataYAML, _, err := getPaths()
123: 	if err != nil {
124: 		return err
125: 	}
126: 
127: 	// Check if symlink exists
128: 	target, err := os.Readlink(suricataYAML)
129: 	if err != nil {
130: 		return fmt.Errorf("suricata.yaml symlink not found or broken")
131: 	}
132: 
133: 	// Check if target exists
134: 	if _, err := os.Stat(target); err != nil {
135: 		return fmt.Errorf("profile template not found: %s", target)
136: 	}
137: 
138: 	// Check if target is in correct directory
139: 	if !filepath.HasPrefix(target, profilesDir) {
140: 		return fmt.Errorf("profile symlink points outside profiles directory: %s", target)
141: 	}
142: 
143: 	return nil
144: }
145: 
146: // GetProfileYAMLPath returns the path to the YAML file for a profile
147: func GetProfileYAMLPath(profile ProfileType) (string, error) {
148: 	profilesDir, _, _, err := getPaths()
149: 	if err != nil {
150: 		return "", err
151: 	}
152: 	return filepath.Join(profilesDir, profile.String()+".yaml"), nil
153: }
154: 
155: // GetSuricataConfigPath returns the path to the active Suricata config (symlink)
156: func GetSuricataConfigPath() (string, error) {
157: 	_, suricataYAML, _, err := getPaths()
158: 	if err != nil {
159: 		return "", err
160: 	}
161: 	return suricataYAML, nil
162: }
163: 
164: // EnsureProfilesExist checks if all profile templates are installed
165: func EnsureProfilesExist() error {
166: 	for _, profile := range []ProfileType{ProfileMinimal, ProfileStandard, ProfileMaximum} {
167: 		path, err := GetProfileYAMLPath(profile)
168: 		if err != nil {
169: 			return err
170: 		}
171: 		if _, err := os.Stat(path); err != nil {
172: 			return fmt.Errorf("missing profile template: %s", path)
173: 		}
174: 	}
175: 	return nil
176: }
</file>

<file path="pkg/suricata/profile/detector.go">
  1: package profile
  2: 
  3: import (
  4: 	"fmt"
  5: 	"os"
  6: 	"regexp"
  7: 	"runtime"
  8: 	"strconv"
  9: 	"strings"
 10: )
 11: 
 12: // ProfileType represents the Suricata performance profile
 13: type ProfileType int
 14: 
 15: const (
 16: 	// ProfileMinimal is for 2 cores / 2 GB RAM
 17: 	ProfileMinimal ProfileType = iota
 18: 	// ProfileStandard is for 4 cores / 4-8 GB RAM (DEFAULT)
 19: 	ProfileStandard
 20: 	// ProfileMaximum is for 8+ cores / 8-16 GB RAM
 21: 	ProfileMaximum
 22: )
 23: 
 24: // String returns the profile name
 25: func (p ProfileType) String() string {
 26: 	switch p {
 27: 	case ProfileMinimal:
 28: 		return "minimal"
 29: 	case ProfileStandard:
 30: 		return "standard"
 31: 	case ProfileMaximum:
 32: 		return "maximum"
 33: 	default:
 34: 		return "unknown"
 35: 	}
 36: }
 37: 
 38: // ProfileFromString parses a profile name
 39: func ProfileFromString(s string) (ProfileType, error) {
 40: 	switch strings.ToLower(s) {
 41: 	case "minimal", "min", "low", "a":
 42: 		return ProfileMinimal, nil
 43: 	case "standard", "std", "medium", "b", "default":
 44: 		return ProfileStandard, nil
 45: 	case "maximum", "max", "high", "c":
 46: 		return ProfileMaximum, nil
 47: 	default:
 48: 		return ProfileStandard, fmt.Errorf("unknown profile: %s", s)
 49: 	}
 50: }
 51: 
 52: // DetectionResult contains system resource detection results
 53: type DetectionResult struct {
 54: 	Profile    ProfileType `json:"profile"`
 55: 	ProfileStr string      `json:"profile_name"`
 56: 	CPUCount   int         `json:"cpu_count"`
 57: 	RAMGB      float64     `json:"ram_gb"`
 58: 	Reason     string      `json:"reason"`
 59: }
 60: 
 61: // DetectOptimalProfile auto-detects the best Suricata profile based on system resources
 62: func DetectOptimalProfile() (*DetectionResult, error) {
 63: 	cpus := runtime.NumCPU()
 64: 	ramGB, err := getTotalMemoryGB()
 65: 	if err != nil {
 66: 		return nil, fmt.Errorf("failed to detect RAM: %w", err)
 67: 	}
 68: 
 69: 	var profile ProfileType
 70: 	var reason string
 71: 
 72: 	// Decision tree based on design document
 73: 	if cpus >= 8 && ramGB >= 8 {
 74: 		profile = ProfileMaximum
 75: 		reason = fmt.Sprintf("High-end server: %d cores, %.1f GB RAM - Deep inspection enabled", cpus, ramGB)
 76: 	} else if cpus >= 4 && ramGB >= 4 {
 77: 		profile = ProfileStandard
 78: 		reason = fmt.Sprintf("Standard server: %d cores, %.1f GB RAM - Balanced performance (default)", cpus, ramGB)
 79: 	} else {
 80: 		profile = ProfileMinimal
 81: 		reason = fmt.Sprintf("Resource-constrained: %d cores, %.1f GB RAM - Stability prioritized", cpus, ramGB)
 82: 	}
 83: 
 84: 	return &DetectionResult{
 85: 		Profile:    profile,
 86: 		ProfileStr: profile.String(),
 87: 		CPUCount:   cpus,
 88: 		RAMGB:      ramGB,
 89: 		Reason:     reason,
 90: 	}, nil
 91: }
 92: 
 93: // getTotalMemoryGB reads total system RAM from /proc/meminfo
 94: func getTotalMemoryGB() (float64, error) {
 95: 	data, err := os.ReadFile("/proc/meminfo")
 96: 	if err != nil {
 97: 		return 0, fmt.Errorf("failed to read /proc/meminfo: %w", err)
 98: 	}
 99: 
100: 	// Parse MemTotal line
101: 	re := regexp.MustCompile(`MemTotal:\s+(\d+)\s+kB`)
102: 	matches := re.FindSubmatch(data)
103: 	if len(matches) < 2 {
104: 		return 0, fmt.Errorf("failed to parse MemTotal from /proc/meminfo")
105: 	}
106: 
107: 	// Convert KB to GB
108: 	kb, err := strconv.ParseInt(string(matches[1]), 10, 64)
109: 	if err != nil {
110: 		return 0, fmt.Errorf("failed to parse memory value: %w", err)
111: 	}
112: 
113: 	gb := float64(kb) / 1024 / 1024
114: 	return gb, nil
115: }
116: 
117: // ProfileSpec contains profile characteristics
118: type ProfileSpec struct {
119: 	Profile       ProfileType
120: 	Name          string
121: 	MinCPU        int
122: 	MinRAMGB      float64
123: 	RingSize      int
124: 	FlowTimeout   int // seconds for established flows
125: 	HTTPBodyLimit string
126: 	DetectProfile string
127: 	UseCase       string
128: }
129: 
130: // GetProfileSpec returns the specification for a given profile
131: func GetProfileSpec(p ProfileType) ProfileSpec {
132: 	switch p {
133: 	case ProfileMinimal:
134: 		return ProfileSpec{
135: 			Profile:       ProfileMinimal,
136: 			Name:          "minimal",
137: 			MinCPU:        2,
138: 			MinRAMGB:      2,
139: 			RingSize:      50000,
140: 			FlowTimeout:   60,
141: 			HTTPBodyLimit: "0 (disabled)",
142: 			DetectProfile: "low",
143: 			UseCase:       "Tiny VPS, stability first",
144: 		}
145: 	case ProfileStandard:
146: 		return ProfileSpec{
147: 			Profile:       ProfileStandard,
148: 			Name:          "standard",
149: 			MinCPU:        4,
150: 			MinRAMGB:      4,
151: 			RingSize:      100000,
152: 			FlowTimeout:   120,
153: 			HTTPBodyLimit: "10-30KB",
154: 			DetectProfile: "medium",
155: 			UseCase:       "Most servers, balanced (recommended)",
156: 		}
157: 	case ProfileMaximum:
158: 		return ProfileSpec{
159: 			Profile:       ProfileMaximum,
160: 			Name:          "maximum",
161: 			MinCPU:        8,
162: 			MinRAMGB:      8,
163: 			RingSize:      300000,
164: 			FlowTimeout:   300,
165: 			HTTPBodyLimit: "30KB",
166: 			DetectProfile: "high",
167: 			UseCase:       "High traffic, deep inspection",
168: 		}
169: 	default:
170: 		return GetProfileSpec(ProfileStandard)
171: 	}
172: }
173: 
174: // GetAllProfiles returns specifications for all profiles
175: func GetAllProfiles() []ProfileSpec {
176: 	return []ProfileSpec{
177: 		GetProfileSpec(ProfileMinimal),
178: 		GetProfileSpec(ProfileStandard),
179: 		GetProfileSpec(ProfileMaximum),
180: 	}
181: }
</file>

<file path="pkg/suricata/recommendations/analyzer.go">
  1: package recommendations
  2: 
  3: import (
  4: 	"fmt"
  5: 	"sort"
  6: 	"time"
  7: 
  8: 	"github.com/itcmsgr/nftban/pkg/suricata/stats"
  9: )
 10: 
 11: // RecommendationType represents the type of recommendation
 12: type RecommendationType string
 13: 
 14: const (
 15: 	FalsePositive    RecommendationType = "false_positive"
 16: 	NoiseReduction   RecommendationType = "noise_reduction"
 17: 	DropMode         RecommendationType = "drop_mode"
 18: 	DisableRule      RecommendationType = "disable_rule"
 19: 	InvestigateFurther RecommendationType = "investigate"
 20: )
 21: 
 22: // Recommendation represents a single recommendation
 23: type Recommendation struct {
 24: 	Type        RecommendationType
 25: 	SID         string
 26: 	Signature   string
 27: 	Category    string
 28: 	Severity    string // high, medium, low
 29: 	Reason      string
 30: 	Evidence    []string
 31: 	Action      string
 32: 	TriggerCount int
 33: 	SourceCount  int
 34: 	Ratio       float64 // Triggers per unique source
 35: }
 36: 
 37: // Analyzer analyzes SID statistics and generates recommendations
 38: type Analyzer struct {
 39: 	cache *stats.Cache
 40: }
 41: 
 42: // NewAnalyzer creates a new recommendations analyzer
 43: func NewAnalyzer(cache *stats.Cache) *Analyzer {
 44: 	return &Analyzer{
 45: 		cache: cache,
 46: 	}
 47: }
 48: 
 49: // AnalyzeAll generates all recommendations
 50: func (a *Analyzer) AnalyzeAll() ([]*Recommendation, error) {
 51: 	recommendations := make([]*Recommendation, 0)
 52: 
 53: 	// Get all SID statistics
 54: 	allStats := a.cache.GetAllStats()
 55: 
 56: 	// Analyze each SID
 57: 	for _, sidStats := range allStats {
 58: 		// Skip if no triggers
 59: 		if sidStats.TriggerCount == 0 {
 60: 			continue
 61: 		}
 62: 
 63: 		// Check for various patterns
 64: 		if rec := a.analyzeFalsePositive(sidStats); rec != nil {
 65: 			recommendations = append(recommendations, rec)
 66: 		}
 67: 		if rec := a.analyzeNoiseReduction(sidStats); rec != nil {
 68: 			recommendations = append(recommendations, rec)
 69: 		}
 70: 		if rec := a.analyzeDropMode(sidStats); rec != nil {
 71: 			recommendations = append(recommendations, rec)
 72: 		}
 73: 		if rec := a.analyzeDisableRule(sidStats); rec != nil {
 74: 			recommendations = append(recommendations, rec)
 75: 		}
 76: 	}
 77: 
 78: 	// Sort by severity
 79: 	sort.Slice(recommendations, func(i, j int) bool {
 80: 		severityOrder := map[string]int{"high": 3, "medium": 2, "low": 1}
 81: 		return severityOrder[recommendations[i].Severity] > severityOrder[recommendations[j].Severity]
 82: 	})
 83: 
 84: 	return recommendations, nil
 85: }
 86: 
 87: // analyzeFalsePositive detects potential false positives
 88: // Pattern: Very high trigger count from very few unique sources
 89: func (a *Analyzer) analyzeFalsePositive(sidStats *stats.SIDStats) *Recommendation {
 90: 	// Calculate ratio
 91: 	ratio := float64(sidStats.TriggerCount) / float64(sidStats.SourceCount)
 92: 
 93: 	// Thresholds:
 94: 	// - More than 100 triggers
 95: 	// - From 1-3 sources
 96: 	// - Ratio > 50 (50+ triggers per source on average)
 97: 	if sidStats.TriggerCount > 100 && sidStats.SourceCount <= 3 && ratio > 50 {
 98: 		severity := "medium"
 99: 		if ratio > 200 {
100: 			severity = "high"
101: 		}
102: 
103: 		evidence := []string{
104: 			fmt.Sprintf("%d triggers from only %d unique source(s)", sidStats.TriggerCount, sidStats.SourceCount),
105: 			fmt.Sprintf("Ratio: %.1f triggers per source", ratio),
106: 		}
107: 
108: 		if sidStats.SourceCount == 1 {
109: 			evidence = append(evidence, "All triggers from single IP (likely misconfiguration or testing)")
110: 		}
111: 
112: 		return &Recommendation{
113: 			Type:         FalsePositive,
114: 			SID:          sidStats.SID,
115: 			Signature:    sidStats.Signature,
116: 			Category:     sidStats.Category,
117: 			Severity:     severity,
118: 			Reason:       "Potential false positive: High triggers from very few sources",
119: 			Evidence:     evidence,
120: 			Action:       "Review rule configuration and consider tuning threshold or disabling",
121: 			TriggerCount: sidStats.TriggerCount,
122: 			SourceCount:  sidStats.SourceCount,
123: 			Ratio:        ratio,
124: 		}
125: 	}
126: 
127: 	return nil
128: }
129: 
130: // analyzeNoiseReduction detects noisy rules
131: // Pattern: Extremely high trigger count from many sources (common activity)
132: func (a *Analyzer) analyzeNoiseReduction(sidStats *stats.SIDStats) *Recommendation {
133: 	ratio := float64(sidStats.TriggerCount) / float64(sidStats.SourceCount)
134: 
135: 	// Thresholds:
136: 	// - More than 1000 triggers
137: 	// - From many sources (>20)
138: 	// - But ratio is low (<20) indicating distributed common activity
139: 	if sidStats.TriggerCount > 1000 && sidStats.SourceCount > 20 && ratio < 20 {
140: 		severity := "low"
141: 		if sidStats.TriggerCount > 10000 {
142: 			severity = "medium"
143: 		}
144: 
145: 		evidence := []string{
146: 			fmt.Sprintf("%d triggers from %d unique sources", sidStats.TriggerCount, sidStats.SourceCount),
147: 			fmt.Sprintf("Ratio: %.1f triggers per source (widespread activity)", ratio),
148: 			"May be detecting normal/benign traffic patterns",
149: 		}
150: 
151: 		return &Recommendation{
152: 			Type:         NoiseReduction,
153: 			SID:          sidStats.SID,
154: 			Signature:    sidStats.Signature,
155: 			Category:     sidStats.Category,
156: 			Severity:     severity,
157: 			Reason:       "Noisy rule: High volume from many sources",
158: 			Evidence:     evidence,
159: 			Action:       "Consider tightening rule conditions or increasing threshold",
160: 			TriggerCount: sidStats.TriggerCount,
161: 			SourceCount:  sidStats.SourceCount,
162: 			Ratio:        ratio,
163: 		}
164: 	}
165: 
166: 	return nil
167: }
168: 
169: // analyzeDropMode recommends switching to drop mode
170: // Pattern: Moderate triggers from many different sources (distributed attack)
171: func (a *Analyzer) analyzeDropMode(sidStats *stats.SIDStats) *Recommendation {
172: 	ratio := float64(sidStats.TriggerCount) / float64(sidStats.SourceCount)
173: 
174: 	// Thresholds:
175: 	// - More than 50 triggers
176: 	// - From many sources (>10)
177: 	// - Ratio between 2-10 (targeted but distributed)
178: 	// - Category indicates attack pattern
179: 	attackCategories := []string{
180: 		"exploit", "attack", "shellcode", "trojan",
181: 		"malware", "web-application-attack", "sql-injection",
182: 	}
183: 
184: 	isAttackCategory := false
185: 	for _, cat := range attackCategories {
186: 		if contains(sidStats.Category, cat) {
187: 			isAttackCategory = true
188: 			break
189: 		}
190: 	}
191: 
192: 	if sidStats.TriggerCount > 50 && sidStats.SourceCount > 10 && ratio >= 2 && ratio <= 10 && isAttackCategory {
193: 		severity := "high"
194: 		if sidStats.TriggerCount > 500 {
195: 			severity = "high"
196: 		} else {
197: 			severity = "medium"
198: 		}
199: 
200: 		evidence := []string{
201: 			fmt.Sprintf("%d triggers from %d unique sources", sidStats.TriggerCount, sidStats.SourceCount),
202: 			fmt.Sprintf("Category: %s (attack pattern)", sidStats.Category),
203: 			"Distributed attack pattern detected",
204: 		}
205: 
206: 		return &Recommendation{
207: 			Type:         DropMode,
208: 			SID:          sidStats.SID,
209: 			Signature:    sidStats.Signature,
210: 			Category:     sidStats.Category,
211: 			Severity:     severity,
212: 			Reason:       "Active attack pattern: Consider blocking mode",
213: 			Evidence:     evidence,
214: 			Action:       "Switch rule from 'alert' to 'drop' mode to actively block attacks",
215: 			TriggerCount: sidStats.TriggerCount,
216: 			SourceCount:  sidStats.SourceCount,
217: 			Ratio:        ratio,
218: 		}
219: 	}
220: 
221: 	return nil
222: }
223: 
224: // analyzeDisableRule recommends disabling extremely noisy rules
225: // Pattern: Excessive triggers that provide minimal security value
226: func (a *Analyzer) analyzeDisableRule(sidStats *stats.SIDStats) *Recommendation {
227: 	// Thresholds:
228: 	// - More than 10,000 triggers in total
229: 	// - Very recent activity (within last hour)
230: 	// - Very high frequency
231: 
232: 	hourAgo := time.Now().Add(-1 * time.Hour)
233: 	isVeryRecent := sidStats.LastTrigger.After(hourAgo)
234: 
235: 	if sidStats.TriggerCount > 10000 && isVeryRecent {
236: 		evidence := []string{
237: 			fmt.Sprintf("%d total triggers (excessive volume)", sidStats.TriggerCount),
238: 			fmt.Sprintf("%d unique sources", sidStats.SourceCount),
239: 			fmt.Sprintf("Last trigger: %s (very recent)", sidStats.LastTrigger.Format("2006-01-02 15:04:05")),
240: 			"Extremely high volume may indicate rule misconfiguration",
241: 		}
242: 
243: 		return &Recommendation{
244: 			Type:         DisableRule,
245: 			SID:          sidStats.SID,
246: 			Signature:    sidStats.Signature,
247: 			Category:     sidStats.Category,
248: 			Severity:     "high",
249: 			Reason:       "Extremely noisy rule: Consider disabling",
250: 			Evidence:     evidence,
251: 			Action:       "Disable this rule and investigate why it's triggering so frequently",
252: 			TriggerCount: sidStats.TriggerCount,
253: 			SourceCount:  sidStats.SourceCount,
254: 			Ratio:        float64(sidStats.TriggerCount) / float64(sidStats.SourceCount),
255: 		}
256: 	}
257: 
258: 	return nil
259: }
260: 
261: // GetTopNoisyRules returns rules with highest trigger counts
262: func (a *Analyzer) GetTopNoisyRules(n int) []*stats.SIDStats {
263: 	return a.cache.GetTopSIDs(n)
264: }
265: 
266: // GetRecentThreats returns recently triggered rules
267: func (a *Analyzer) GetRecentThreats(duration time.Duration) []*stats.SIDStats {
268: 	return a.cache.GetRecentSIDs(duration)
269: }
270: 
271: // GenerateSummary creates a summary report
272: func (a *Analyzer) GenerateSummary() map[string]interface{} {
273: 	allStats := a.cache.GetAllStats()
274: 	recommendations, _ := a.AnalyzeAll()
275: 
276: 	// Count by type
277: 	typeCounts := make(map[string]int)
278: 	for _, rec := range recommendations {
279: 		typeCounts[string(rec.Type)]++
280: 	}
281: 
282: 	// Count by severity
283: 	severityCounts := make(map[string]int)
284: 	for _, rec := range recommendations {
285: 		severityCounts[rec.Severity]++
286: 	}
287: 
288: 	return map[string]interface{}{
289: 		"total_sids":              len(allStats),
290: 		"total_recommendations":   len(recommendations),
291: 		"by_type":                 typeCounts,
292: 		"by_severity":             severityCounts,
293: 		"high_severity_count":     severityCounts["high"],
294: 		"medium_severity_count":   severityCounts["medium"],
295: 		"low_severity_count":      severityCounts["low"],
296: 	}
297: }
298: 
299: // Helper function
300: func contains(s, substr string) bool {
301: 	return len(s) >= len(substr) && s[:len(substr)] == substr
302: }

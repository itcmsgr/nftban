210: 	var totalDuration time.Duration
211: 	var record struct {
212: 		Country struct {
213: 			ISOCode string `maxminddb:"iso_code"`
214: 		} `maxminddb:"country"`
215: 	}
216: 
217: 	for i := 0; i < 10; i++ {
218: 		start := time.Now()
219: 		db.Lookup(testIPs[i%3], &record)
220: 		totalDuration += time.Since(start)
221: 	}
222: 
223: 	avgMicroseconds := totalDuration.Microseconds() / 10
224: 	fmt.Printf("  Average lookup time: %d microseconds\n", avgMicroseconds)
225: 
226: 	if avgMicroseconds < 1000 {
227: 		fmt.Println("  Performance: ✅ EXCELLENT (<1ms)")
228: 	} else if avgMicroseconds < 5000 {
229: 		fmt.Println("  Performance: ✅ GOOD (<5ms)")
230: 	} else {
231: 		fmt.Println("  Performance: ⚠️  SLOW (>5ms)")
232: 	}
233: 	fmt.Println()
234: 
235: 	fmt.Println(strings.Repeat("=", 70))
236: 	fmt.Println("Status: ✅ OK")

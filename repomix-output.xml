254: 
255: EOF
256: }
257: 
258: # =============================================================================
259: # EXPORTS
260: # =============================================================================
261: 
262: export -f nftban_cmd_test
263: 
264: # =============================================================================
265: # DIRECT EXECUTION SUPPORT
266: # =============================================================================
267: 
268: # If executed directly (not sourced), run the command handler
269: if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
270:     nftban_cmd_test "$@"
271: fi

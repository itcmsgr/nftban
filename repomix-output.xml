 3: Documentation=man:nftban(8)
 4: Requires=nftban-ui-auth.socket
 5: After=nftban-ui-auth.socket
 6: 
 7: [Service]
 8: Type=simple
 9: ExecStart=/usr/libexec/nftban-ui-auth
10: Restart=on-failure
11: RestartSec=5s
12: 
13: # Runtime directory
14: RuntimeDirectory=nftban-ui
15: RuntimeDirectoryMode=0750
16: 
17: # Run as root with nftban group for socket access
18: User=root
19: Group=nftban
20: UMask=0077
21: 
22: # Security hardening - all compatible with direct PAM library (no su/setuid)
23: NoNewPrivileges=yes
24: PrivateTmp=yes
25: ProtectSystem=strict
26: ProtectHome=yes
27: ProtectKernelTunables=yes
28: ProtectKernelModules=yes
29: ProtectControlGroups=yes
30: RestrictRealtime=yes
31: RestrictNamespaces=yes
32: LockPersonality=yes
33: # NOTE: MemoryDenyWriteExecute is intentionally NOT set here.
34: # It breaks Go binaries on some kernel + LSM combinations
35: # (e.g. Ubuntu 24.04 with AppArmor + Landlock, future SELinux distros).
36: # Security is maintained via non-root user, capabilities bounding, and other restrictions.
37: SystemCallFilter=@system-service
38: 
39: # Logging
40: StandardOutput=journal
41: StandardError=journal
42: SyslogIdentifier=nftban-ui-auth
43: 
44: [Install]
45: WantedBy=multi-user.target
</file>


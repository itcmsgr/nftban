318: // GetAdminEndpoints returns endpoints that require admin privileges
319: func GetAdminEndpoints() []string {
320: 	var adminPaths []string
321: 	for _, ep := range AllEndpoints() {
322: 		if ep.Admin {
323: 			adminPaths = append(adminPaths, ep.Path)
324: 		}
325: 	}
326: 	return adminPaths
327: }
328: 
329: // GetPublicEndpoints returns endpoints that don't require authentication
330: func GetPublicEndpoints() []string {
331: 	var publicPaths []string
332: 	for _, ep := range AllEndpoints() {
333: 		if !ep.Auth {
334: 			publicPaths = append(publicPaths, ep.Path)
335: 		}
336: 	}
337: 	return publicPaths
338: }
339: 
340: // IsAdminEndpoint checks if a path requires admin privileges
341: func IsAdminEndpoint(path string) bool {
342: 	for _, ep := range AllEndpoints() {
343: 		if ep.Path == path {
344: 			return ep.Admin
345: 		}
346: 	}
347: 	return false
348: }
349: 
350: // FullPath returns the full API path including version prefix
351: func FullPath(endpoint string) string {
352: 	return APIPathPrefix + endpoint
353: }

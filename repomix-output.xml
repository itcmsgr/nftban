 461: nftban_stats_timeline() {
 462:     # Get ban timeline with hourly/daily aggregation
 463:     # Usage: nftban_stats_timeline [since] [until] [interval]
 464:     # Args: interval = "hour" or "day"
 465:     # Returns: JSON array [{"timestamp":"...",  "count":N},...]
 466: 
 467:     local since="${1:-$(date -d '24 hours ago' +%Y-%m-%d\ %H:%M:%S)}"
 468:     local until="${2:-$(date +%Y-%m-%d\ %H:%M:%S)}"
 469:     local interval="${3:-hour}"
 470: 
 471:     if [[ ! -f "$NFTBAN_BAN_LOG" ]]; then
 472:         echo "[]"
 473:         return 0
 474:     fi
 475: 
 476:     local temp_file
 477:     temp_file=$(mktemp)
 478: 
 479:     case "$interval" in
 480:         hour)
 481:             awk -F'|' -v since="$since" -v until="$until" '
 482:             $1 >= since && $1 <= until && $6 == "BANNED" {
 483:                 hour=substr($1,1,13)":00:00"
 484:                 hours[hour]++
 485:             }
 486:             END {
 487:                 for (h in hours) printf "%s|%d\n", h, hours[h]
 488:             }' "$NFTBAN_BAN_LOG" | sort > "$temp_file"
 489:             ;;
 490:         day)
 491:             awk -F'|' -v since="$since" -v until="$until" '
 492:             $1 >= since && $1 <= until && $6 == "BANNED" {
 493:                 day=substr($1,1,10)
 494:                 days[day]++
 495:             }
 496:             END {
 497:                 for (d in days) printf "%s|%d\n", d, days[d]
 498:             }' "$NFTBAN_BAN_LOG" | sort > "$temp_file"
 499:             ;;
 500:     esac
 501: 
 502:     # Convert to JSON
 503:     awk -F'|' 'BEGIN{printf "["}
 504:                NR>1{printf ","}
 505:                {printf "{\"timestamp\":\"%s\",\"count\":%d}", $1, $2}
 506:                END{printf "]"}' "$temp_file"
 507: 
 508:     rm -f "$temp_file"
 509: }

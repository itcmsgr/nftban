 60: // EmulateHandler handles GET /api/v1/emulate
 61: // Query parameters: ip (required), proto, port, direction
 62: func EmulateHandler(w http.ResponseWriter, r *http.Request) {
 63: 	// Get query parameters
 64: 	ip := r.URL.Query().Get("ip")
 65: 	if ip == "" {
 66: 		respondJSON(w, http.StatusBadRequest, ErrorResponse{Error: "IP address required"})
 67: 		return
 68: 	}
 69: 
 70: 	// Validate IP
 71: 	if net.ParseIP(ip) == nil {
 72: 		respondJSON(w, http.StatusBadRequest, ErrorResponse{Error: "Invalid IP address"})
 73: 		return
 74: 	}
 75: 
 76: 	proto := r.URL.Query().Get("proto")
 77: 	portStr := r.URL.Query().Get("port")
 78: 	direction := r.URL.Query().Get("direction")
 79: 
 80: 	// Validate protocol
 81: 	if proto != "" {
 82: 		proto = strings.ToLower(proto)
 83: 		if proto != "tcp" && proto != "udp" && proto != "icmp" && proto != "icmpv6" {
 84: 			respondJSON(w, http.StatusBadRequest, ErrorResponse{Error: "Invalid protocol (use tcp, udp, icmp)"})
 85: 			return
 86: 		}
 87: 	}
 88: 
 89: 	// Validate port
 90: 	var port int
 91: 	if portStr != "" {
 92: 		var err error
 93: 		port, err = strconv.Atoi(portStr)
 94: 		if err != nil || port < 1 || port > 65535 {
 95: 			respondJSON(w, http.StatusBadRequest, ErrorResponse{Error: "Invalid port (must be 1-65535)"})
 96: 			return
 97: 		}
 98: 	}
 99: 
100: 	// Validate direction
101: 	if direction == "" {
102: 		direction = "in"
103: 	} else {
104: 		direction = strings.ToLower(direction)
105: 		if direction != "in" && direction != "out" && direction != "fwd" {
106: 			respondJSON(w, http.StatusBadRequest, ErrorResponse{Error: "Invalid direction (use in, out, fwd)"})
107: 			return
108: 		}
109: 	}
110: 
111: 	// Build CLI command
112: 	args := []string{"emulate", ip, "--json"}
113: 	if proto != "" {
114: 		args = append(args, "--proto", proto)
115: 	}
116: 	if port > 0 {
117: 		args = append(args, "--port", strconv.Itoa(port))
118: 	}
119: 	if direction != "" {
120: 		args = append(args, "--direction", direction)
121: 	}
122: 
123: 	// Execute nftban emulate - use central config for CLI path
124: 	cmd := exec.Command(getNFTBanCLI(), args...)
125: 	output, err := cmd.Output()
126: 	if err != nil {
127: 		// Exit code 2 means blocked (still valid)
128: 		if exitErr, ok := err.(*exec.ExitError); ok && exitErr.ExitCode() == 2 {
129: 			// Blocked - output is still valid JSON
130: 		} else {
131: 			respondJSON(w, http.StatusInternalServerError, ErrorResponse{
132: 				Error: "Failed to execute emulation: " + err.Error(),
133: 			})
134: 			return
135: 		}
136: 	}
137: 
138: 	// Parse the JSON output from CLI
139: 	var response EmulateResponse
140: 	if err := json.Unmarshal(output, &response); err != nil {
141: 		// Try to return raw output for debugging
142: 		respondJSON(w, http.StatusInternalServerError, ErrorResponse{
143: 			Error: "Failed to parse emulation result: " + err.Error(),
144: 		})
145: 		return
146: 	}
147: 
148: 	respondJSON(w, http.StatusOK, response)
149: }

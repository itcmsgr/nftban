<file path="pkg/sync/cidr.go">
  1: package sync
  2: 
  3: import (
  4: 	"encoding/binary"
  5: 	"fmt"
  6: 	"math/big"
  7: 	"net"
  8: 	"sort"
  9: )
 10: 
 11: // ipv4Interval represents an IPv4 range as [start, end] inclusive
 12: type ipv4Interval struct {
 13: 	Start uint32
 14: 	End   uint32
 15: }
 16: 
 17: // ipv6Interval represents an IPv6 range as [start, end] inclusive
 18: type ipv6Interval struct {
 19: 	Start *big.Int
 20: 	End   *big.Int
 21: }
 22: 
 23: // MergeStats contains statistics about CIDR canonicalization
 24: type MergeStats struct {
 25: 	InputCIDRs     int     // Number of input CIDRs
 26: 	OutputRanges   int     // Number of output ranges after merging
 27: 	OverlapsMerged int     // Number of overlaps/duplicates that were merged
 28: 	ReductionPct   float64 // Percentage reduction in entries
 29: }
 30: 
 31: // MergeCIDRs merges overlapping and adjacent CIDRs (auto-detects IPv4/IPv6)
 32: // Returns minimal CIDR set and statistics
 33: func MergeCIDRs(cidrs []string) ([]string, *MergeStats, error) {
 34: 	if len(cidrs) == 0 {
 35: 		return nil, &MergeStats{}, nil
 36: 	}
 37: 
 38: 	// Separate IPv4 and IPv6 CIDRs
 39: 	ipv4Cidrs := make([]string, 0)
 40: 	ipv6Cidrs := make([]string, 0)
 41: 
 42: 	for _, cidr := range cidrs {
 43: 		ip, _, err := net.ParseCIDR(cidr)
 44: 		if err != nil {
 45: 			return nil, nil, fmt.Errorf("invalid CIDR %s: %w", cidr, err)
 46: 		}
 47: 
 48: 		if ip.To4() != nil {
 49: 			ipv4Cidrs = append(ipv4Cidrs, cidr)
 50: 		} else {
 51: 			ipv6Cidrs = append(ipv6Cidrs, cidr)
 52: 		}
 53: 	}
 54: 
 55: 	// Merge IPv4 and IPv6 separately
 56: 	result := make([]string, 0, len(cidrs))
 57: 	var combinedStats MergeStats
 58: 
 59: 	if len(ipv4Cidrs) > 0 {
 60: 		merged, stats, err := mergeCIDRsIPv4WithStats(ipv4Cidrs)
 61: 		if err != nil {
 62: 			return nil, nil, fmt.Errorf("failed to merge IPv4 CIDRs: %w", err)
 63: 		}
 64: 		result = append(result, merged...)
 65: 		combinedStats.InputCIDRs += stats.InputCIDRs
 66: 		combinedStats.OutputRanges += stats.OutputRanges
 67: 		combinedStats.OverlapsMerged += stats.OverlapsMerged
 68: 	}
 69: 
 70: 	if len(ipv6Cidrs) > 0 {
 71: 		merged, stats, err := mergeCIDRsIPv6WithStats(ipv6Cidrs)
 72: 		if err != nil {
 73: 			return nil, nil, fmt.Errorf("failed to merge IPv6 CIDRs: %w", err)
 74: 		}
 75: 		result = append(result, merged...)
 76: 		combinedStats.InputCIDRs += stats.InputCIDRs
 77: 		combinedStats.OutputRanges += stats.OutputRanges
 78: 		combinedStats.OverlapsMerged += stats.OverlapsMerged
 79: 	}
 80: 
 81: 	// Calculate combined reduction percentage
 82: 	if combinedStats.InputCIDRs > 0 {
 83: 		combinedStats.ReductionPct = float64(combinedStats.OverlapsMerged) / float64(combinedStats.InputCIDRs) * 100
 84: 	}
 85: 
 86: 	return result, &combinedStats, nil
 87: }
 88: 
 89: // mergeCIDRsIPv4WithStats merges overlapping/adjacent IPv4 CIDRs
 90: // Returns minimal CIDR set, statistics, or error
 91: func mergeCIDRsIPv4WithStats(cidrs []string) ([]string, *MergeStats, error) {
 92: 	if len(cidrs) == 0 {
 93: 		return nil, &MergeStats{}, nil
 94: 	}
 95: 
 96: 	// Parse CIDRs to intervals
 97: 	intervals := make([]ipv4Interval, 0, len(cidrs))
 98: 	for _, cidr := range cidrs {
 99: 		_, ipNet, err := net.ParseCIDR(cidr)
100: 		if err != nil {
101: 			return nil, nil, err
102: 		}
103: 
104: 		start := ipToUint32(ipNet.IP)
105: 		// Calculate end: broadcast address of the network
106: 		ones, bits := ipNet.Mask.Size()
107: 		hostBits := uint32(bits - ones)
108: 		end := start + (1 << hostBits) - 1
109: 
110: 		intervals = append(intervals, ipv4Interval{Start: start, End: end})
111: 	}
112: 
113: 	// Sort by start address
114: 	sort.Slice(intervals, func(i, j int) bool {
115: 		return intervals[i].Start < intervals[j].Start
116: 	})
117: 
118: 	// Merge overlapping and adjacent ranges
119: 	merged := make([]ipv4Interval, 0, len(intervals))
120: 	current := intervals[0]
121: 
122: 	for i := 1; i < len(intervals); i++ {
123: 		next := intervals[i]
124: 
125: 		// Check if ranges overlap or are adjacent
126: 		if next.Start <= current.End+1 {
127: 			// Merge: extend current range if needed
128: 			if next.End > current.End {
129: 				current.End = next.End
130: 			}
131: 		} else {
132: 			// No overlap: save current and start new range
133: 			merged = append(merged, current)
134: 			current = next
135: 		}
136: 	}
137: 	// Don't forget the last range
138: 	merged = append(merged, current)
139: 
140: 	// Convert merged intervals back to CIDRs
141: 	result := make([]string, 0)
142: 	for _, interval := range merged {
143: 		cidrs := rangeToCIDRsIPv4(interval.Start, interval.End)
144: 		result = append(result, cidrs...)
145: 	}
146: 
147: 	// Calculate statistics
148: 	stats := &MergeStats{
149: 		InputCIDRs:     len(cidrs),
150: 		OutputRanges:   len(result),
151: 		OverlapsMerged: len(cidrs) - len(result),
152: 	}
153: 	if len(cidrs) > 0 {
154: 		stats.ReductionPct = float64(stats.OverlapsMerged) / float64(len(cidrs)) * 100
155: 	}
156: 
157: 	return result, stats, nil
158: }
159: 
160: // mergeCIDRsIPv6WithStats merges overlapping/adjacent IPv6 CIDRs
161: // Returns minimal CIDR set, statistics, or error
162: func mergeCIDRsIPv6WithStats(cidrs []string) ([]string, *MergeStats, error) {
163: 	if len(cidrs) == 0 {
164: 		return nil, &MergeStats{}, nil
165: 	}
166: 
167: 	// Parse CIDRs to intervals
168: 	intervals := make([]ipv6Interval, 0, len(cidrs))
169: 	for _, cidr := range cidrs {
170: 		_, ipNet, err := net.ParseCIDR(cidr)
171: 		if err != nil {
172: 			return nil, nil, err
173: 		}
174: 
175: 		start := ipv6ToBigInt(ipNet.IP)
176: 
177: 		// Calculate end address
178: 		ones, bits := ipNet.Mask.Size()
179: 		hostBits := bits - ones
180: 
181: 		// end = start + (2^hostBits - 1)
182: 		hostCount := new(big.Int).Lsh(big.NewInt(1), uint(hostBits))
183: 		end := new(big.Int).Add(start, hostCount)
184: 		end.Sub(end, big.NewInt(1))
185: 
186: 		intervals = append(intervals, ipv6Interval{Start: start, End: end})
187: 	}
188: 
189: 	// Sort by start address
190: 	sort.Slice(intervals, func(i, j int) bool {
191: 		return intervals[i].Start.Cmp(intervals[j].Start) < 0
192: 	})
193: 
194: 	// Merge overlapping and adjacent ranges
195: 	merged := make([]ipv6Interval, 0, len(intervals))
196: 	current := ipv6Interval{
197: 		Start: new(big.Int).Set(intervals[0].Start),
198: 		End:   new(big.Int).Set(intervals[0].End),
199: 	}
200: 
201: 	for i := 1; i < len(intervals); i++ {
202: 		next := intervals[i]
203: 
204: 		// Check if ranges overlap or are adjacent
205: 		// adjacent if next.Start == current.End + 1
206: 		adjacentThreshold := new(big.Int).Add(current.End, big.NewInt(1))
207: 
208: 		if next.Start.Cmp(adjacentThreshold) <= 0 {
209: 			// Merge: extend current range if needed
210: 			if next.End.Cmp(current.End) > 0 {
211: 				current.End = new(big.Int).Set(next.End)
212: 			}
213: 		} else {
214: 			// No overlap: save current and start new range
215: 			merged = append(merged, current)
216: 			current = ipv6Interval{
217: 				Start: new(big.Int).Set(next.Start),
218: 				End:   new(big.Int).Set(next.End),
219: 			}
220: 		}
221: 	}
222: 	// Don't forget the last range
223: 	merged = append(merged, current)
224: 
225: 	// Convert merged intervals back to CIDRs
226: 	result := make([]string, 0)
227: 	for _, interval := range merged {
228: 		cidrs := rangeToCIDRsIPv6(interval.Start, interval.End)
229: 		result = append(result, cidrs...)
230: 	}
231: 
232: 	// Calculate statistics
233: 	stats := &MergeStats{
234: 		InputCIDRs:     len(cidrs),
235: 		OutputRanges:   len(result),
236: 		OverlapsMerged: len(cidrs) - len(result),
237: 	}
238: 	if len(cidrs) > 0 {
239: 		stats.ReductionPct = float64(stats.OverlapsMerged) / float64(len(cidrs)) * 100
240: 	}
241: 
242: 	return result, stats, nil
243: }
244: 
245: // ipToUint32 converts an IPv4 address to uint32
246: func ipToUint32(ip net.IP) uint32 {
247: 	ip = ip.To4()
248: 	return binary.BigEndian.Uint32(ip)
249: }
250: 
251: // uint32ToIP converts uint32 to IPv4 address
252: func uint32ToIP(n uint32) net.IP {
253: 	ip := make(net.IP, 4)
254: 	binary.BigEndian.PutUint32(ip, n)
255: 	return ip
256: }
257: 
258: // ipv6ToBigInt converts an IPv6 address to big.Int
259: func ipv6ToBigInt(ip net.IP) *big.Int {
260: 	ip = ip.To16()
261: 	return new(big.Int).SetBytes(ip)
262: }
263: 
264: // bigIntToIPv6 converts big.Int to IPv6 address
265: func bigIntToIPv6(n *big.Int) net.IP {
266: 	bytes := n.Bytes()
267: 	// Pad to 16 bytes if necessary
268: 	if len(bytes) < 16 {
269: 		padded := make([]byte, 16)
270: 		copy(padded[16-len(bytes):], bytes)
271: 		return net.IP(padded)
272: 	}
273: 	return net.IP(bytes)
274: }
275: 
276: // rangeToCIDRsIPv4 converts an IPv4 range [start, end] to minimal CIDR set
277: func rangeToCIDRsIPv4(start, end uint32) []string {
278: 	cidrs := make([]string, 0)
279: 
280: 	for start <= end {
281: 		// Find the largest prefix that fits within [start, end]
282: 		maxPrefixLen := uint32(32)
283: 
284: 		// Find trailing zeros in start (determines max CIDR size)
285: 		for i := uint32(0); i < 32; i++ {
286: 			if (start & (1 << i)) != 0 {
287: 				maxPrefixLen = i
288: 				break
289: 			}
290: 		}
291: 
292: 		// Calculate max block size that fits in range
293: 		rangeSize := end - start + 1
294: 		blockSize := uint32(1) << maxPrefixLen
295: 
296: 		// Don't exceed remaining range
297: 		for blockSize > rangeSize {
298: 			maxPrefixLen--
299: 			blockSize = 1 << maxPrefixLen
300: 		}
301: 
302: 		// Create CIDR
303: 		ip := uint32ToIP(start)
304: 		prefixLen := 32 - maxPrefixLen
305: 		cidr := fmt.Sprintf("%s/%d", ip.String(), prefixLen)
306: 		cidrs = append(cidrs, cidr)
307: 
308: 		// Move to next block
309: 		start += blockSize
310: 	}
311: 
312: 	return cidrs
313: }
314: 
315: // rangeToCIDRsIPv6 converts an IPv6 range [start, end] to minimal CIDR set
316: func rangeToCIDRsIPv6(start, end *big.Int) []string {
317: 	cidrs := make([]string, 0)
318: 
319: 	current := new(big.Int).Set(start)
320: 	one := big.NewInt(1)
321: 
322: 	for current.Cmp(end) <= 0 {
323: 		// Find the largest prefix that fits within [current, end]
324: 		maxPrefixLen := 128
325: 
326: 		// Find trailing zeros in current (determines max CIDR size)
327: 		temp := new(big.Int).Set(current)
328: 		for i := 0; i < 128; i++ {
329: 			if temp.Bit(i) != 0 {
330: 				maxPrefixLen = i
331: 				break
332: 			}
333: 		}
334: 
335: 		// Calculate max block size that fits in range
336: 		rangeSize := new(big.Int).Sub(end, current)
337: 		rangeSize.Add(rangeSize, one) // +1 because range is inclusive
338: 
339: 		blockSize := new(big.Int).Lsh(one, uint(maxPrefixLen))
340: 
341: 		// Don't exceed remaining range
342: 		for blockSize.Cmp(rangeSize) > 0 && maxPrefixLen > 0 {
343: 			maxPrefixLen--
344: 			blockSize = new(big.Int).Lsh(one, uint(maxPrefixLen))
345: 		}
346: 
347: 		// Create CIDR
348: 		ip := bigIntToIPv6(current)
349: 		prefixLen := 128 - maxPrefixLen
350: 		cidr := fmt.Sprintf("%s/%d", ip.String(), prefixLen)
351: 		cidrs = append(cidrs, cidr)
352: 
353: 		// Move to next block
354: 		current.Add(current, blockSize)
355: 	}
356: 
357: 	return cidrs
358: }

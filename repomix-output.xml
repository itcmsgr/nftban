 567:             echo ""
 568:         fi
 569:     fi
 570: 
 571:     echo ""
 572:     echo "═══════════════════════════════════════════════════════════════"
 573:     echo "  Email Configuration Complete"
 574:     echo "═══════════════════════════════════════════════════════════════"
 575:     echo ""
 576:     echo "Test email:    nftban mail test"
 577:     echo "Send report:   nftban report email $user_email"
 578:     echo "View config:   cat $mail_conf"
 579:     echo ""
 580: }

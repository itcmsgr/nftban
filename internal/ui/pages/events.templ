package pages

import (
	"fmt"
	"strconv"
	"github.com/itcmsgr/nftban/internal/ui"
)

// Events renders the events/activity log page
templ Events(data ui.EventsData) {
	@ui.LayoutWithNav("Events", "events") {
		<!-- Page Header with Stats -->
		<div class="page-header">
			<h1>Security Events</h1>
			<div class="header-stats">
				<span class="stat-badge">{ strconv.Itoa(data.TotalEvents) } Total</span>
				<span class="stat-badge info">Last Hour: { strconv.Itoa(data.EventsLastHour) }</span>
				<span class="stat-badge danger">Bans: { strconv.Itoa(data.BanEvents) }</span>
				<span class="stat-badge success">Unbans: { strconv.Itoa(data.UnbanEvents) }</span>
				<span class="stat-badge warning">Warnings: { strconv.Itoa(data.WarningEvents) }</span>
			</div>
		</div>

		<!-- Toolbar -->
		<div class="toolbar">
			<div class="search-group">
				<input
					type="text"
					class="search-input"
					placeholder="Search by IP or message..."
					name="search"
					hx-get="/ui/frag/events-table"
					hx-trigger="keyup changed delay:300ms"
					hx-target="#events-table"
					hx-include="[name='filter'], [name='date_from'], [name='date_to']"
				/>
			</div>
			<div class="filter-group">
				<select name="filter" class="filter-select" hx-get="/ui/frag/events-table" hx-trigger="change" hx-target="#events-table" hx-include="[name='search'], [name='date_from'], [name='date_to']">
					<option value="all" selected?={ data.Filter == "all" }>All Events</option>
					<option value="bans" selected?={ data.Filter == "bans" }>Bans Only</option>
					<option value="unbans" selected?={ data.Filter == "unbans" }>Unbans Only</option>
					<option value="warnings" selected?={ data.Filter == "warnings" }>Warnings</option>
					<option value="errors" selected?={ data.Filter == "errors" }>Errors</option>
				</select>
			</div>
			<div class="date-filters">
				<input type="date" name="date_from" class="date-input" hx-get="/ui/frag/events-table" hx-trigger="change" hx-target="#events-table" hx-include="[name='search'], [name='filter'], [name='date_to']" placeholder="From"/>
				<input type="date" name="date_to" class="date-input" hx-get="/ui/frag/events-table" hx-trigger="change" hx-target="#events-table" hx-include="[name='search'], [name='filter'], [name='date_from']" placeholder="To"/>
			</div>
			<div class="action-group">
				<button class="btn btn-secondary" hx-get="/ui/frag/events-table" hx-target="#events-table" hx-include="[name='search'], [name='filter']" title="Refresh events">
					Refresh
				</button>
				<button class="btn btn-outline" onclick="exportEvents()" title="Export events to CSV">
					Export
				</button>
			</div>
		</div>

		<!-- Events Table -->
		<div class="card">
			<div id="events-table" hx-get="/ui/frag/events-table" hx-trigger="every 15s" hx-swap="innerHTML">
				@EventsTableFragment(data)
			</div>
		</div>

		@eventsScript()
		@eventsStyles()
	}
}

// EventsTableFragment renders just the table (for HTMX updates)
templ EventsTableFragment(data ui.EventsData) {
	<table class="data-table events-table">
		<thead>
			<tr>
				<th class="time-col">Timestamp</th>
				<th class="level-col">Level</th>
				<th class="module-col">Module</th>
				<th class="action-col">Action</th>
				<th class="ip-col">IP Address</th>
				<th class="country-col">Country</th>
				<th class="message-col">Message</th>
			</tr>
		</thead>
		<tbody>
			if len(data.Events) == 0 {
				<tr>
					<td colspan="7" class="empty-state">No events found</td>
				</tr>
			} else {
				for _, event := range data.Events {
					<tr class={ "event-row", getEventRowClass(event.Level) }>
						<td class="time-cell">
							<span class="timestamp" title={ event.Timestamp }>{ formatEventTime(event.Timestamp) }</span>
						</td>
						<td class="level-cell">
							<span class={ "level-badge", getLevelBadgeClass(event.Level) }>{ event.Level }</span>
						</td>
						<td class="module-cell">
							<span class="module-badge">{ event.Module }</span>
						</td>
						<td class="action-cell">
							<span class={ "action-badge", getActionBadgeClass(event.Action) }>{ event.Action }</span>
						</td>
						<td class="ip-cell">
							if event.IP != "" {
								<code class="ip-address">{ event.IP }</code>
							} else {
								<span class="text-muted">--</span>
							}
						</td>
						<td class="country-cell">
							if event.CountryCode != "" {
								<span class="country-flag" title={ event.Country }>{ event.CountryCode }</span>
							} else {
								<span class="text-muted">--</span>
							}
						</td>
						<td class="message-cell" title={ event.Message }>
							{ truncateEvent(event.Message, 60) }
							if event.Details != "" {
								<button class="details-toggle" data-eventid={ event.ID } onclick="toggleDetails(this.dataset.eventid)" title="Show details">...</button>
								<div id={ fmt.Sprintf("details-%s", event.ID) } class="event-details" style="display: none;">
									{ event.Details }
								</div>
							}
						</td>
					</tr>
				}
			}
		</tbody>
	</table>

	<!-- Pagination -->
	if data.TotalPages > 1 {
		<div class="pagination">
			if data.Page > 1 {
				<button
					class="page-btn"
					hx-get={ fmt.Sprintf("/ui/frag/events-table?page=%d", data.Page-1) }
					hx-target="#events-table"
				>
					&laquo; Prev
				</button>
			}
			for i := 1; i <= data.TotalPages; i++ {
				if showPageButton(i, data.Page, data.TotalPages) {
					<button
						class={ "page-btn", templ.KV("active", i == data.Page) }
						hx-get={ fmt.Sprintf("/ui/frag/events-table?page=%d", i) }
						hx-target="#events-table"
					>
						{ strconv.Itoa(i) }
					</button>
				} else if i == data.Page-3 || i == data.Page+3 {
					<span class="page-ellipsis">...</span>
				}
			}
			if data.Page < data.TotalPages {
				<button
					class="page-btn"
					hx-get={ fmt.Sprintf("/ui/frag/events-table?page=%d", data.Page+1) }
					hx-target="#events-table"
				>
					Next &raquo;
				</button>
			}
		</div>
	}
}

// Helper functions

func getEventRowClass(level string) string {
	switch level {
	case "ERROR":
		return "event-error"
	case "WARN":
		return "event-warning"
	case "BAN":
		return "event-ban"
	case "UNBAN":
		return "event-unban"
	default:
		return ""
	}
}

func getLevelBadgeClass(level string) string {
	switch level {
	case "ERROR":
		return "danger"
	case "WARN":
		return "warning"
	case "BAN":
		return "danger"
	case "UNBAN":
		return "success"
	case "INFO":
		return "info"
	default:
		return "secondary"
	}
}

func getActionBadgeClass(action string) string {
	switch action {
	case "ban":
		return "danger"
	case "unban":
		return "success"
	case "block":
		return "danger"
	case "detect":
		return "warning"
	case "warning":
		return "warning"
	case "error":
		return "danger"
	default:
		return "secondary"
	}
}

func truncateEvent(s string, max int) string {
	if len(s) <= max {
		return s
	}
	return s[:max-3] + "..."
}

func formatEventTime(ts string) string {
	// Return just the time portion if same day, otherwise full timestamp
	// For now just truncate to reasonable length
	if len(ts) > 19 {
		return ts[:19]
	}
	return ts
}

func showPageButton(i, current, total int) bool {
	// Always show first, last, and pages near current
	if i == 1 || i == total {
		return true
	}
	if i >= current-2 && i <= current+2 {
		return true
	}
	return false
}

// eventsScript renders JavaScript for events page
templ eventsScript() {
	<script>
		function toggleDetails(eventId) {
			const details = document.getElementById('details-' + eventId);
			if (details) {
				details.style.display = details.style.display === 'none' ? 'block' : 'none';
			}
		}

		function exportEvents() {
			// Get current filter params
			const search = document.querySelector('[name="search"]').value || '';
			const filter = document.querySelector('[name="filter"]').value || 'all';
			const dateFrom = document.querySelector('[name="date_from"]').value || '';
			const dateTo = document.querySelector('[name="date_to"]').value || '';

			// Build export URL
			const params = new URLSearchParams({
				search: search,
				filter: filter,
				date_from: dateFrom,
				date_to: dateTo,
				format: 'csv'
			});

			window.location.href = '/ui/api/events/export?' + params.toString();
		}
	</script>
}

// eventsStyles renders CSS for events page
templ eventsStyles() {
	<style>
		.date-filters {
			display: flex;
			gap: 0.5rem;
		}

		.date-input {
			padding: 0.5rem;
			border: 1px solid var(--border-color, #3a3a5e);
			border-radius: 6px;
			background: var(--bg-secondary, #1e1e2e);
			color: var(--text-primary, #fff);
			font-size: 0.9rem;
		}

		.events-table {
			font-size: 0.9rem;
		}

		.time-col { width: 150px; }
		.level-col { width: 80px; }
		.module-col { width: 100px; }
		.action-col { width: 90px; }
		.ip-col { width: 140px; }
		.country-col { width: 70px; }
		.message-col { flex: 1; }

		.event-row.event-error {
			background: rgba(239, 68, 68, 0.08);
		}

		.event-row.event-warning {
			background: rgba(245, 158, 11, 0.08);
		}

		.event-row.event-ban {
			background: rgba(239, 68, 68, 0.05);
			border-left: 3px solid var(--color-danger, #ef4444);
		}

		.event-row.event-unban {
			background: rgba(16, 185, 129, 0.05);
			border-left: 3px solid var(--color-success, #10b981);
		}

		.level-badge, .action-badge {
			display: inline-block;
			padding: 0.2rem 0.5rem;
			border-radius: 4px;
			font-size: 0.75rem;
			font-weight: 600;
			text-transform: uppercase;
		}

		.level-badge.danger, .action-badge.danger {
			background: rgba(239, 68, 68, 0.2);
			color: var(--color-danger, #ef4444);
		}

		.level-badge.warning, .action-badge.warning {
			background: rgba(245, 158, 11, 0.2);
			color: var(--color-warning, #f59e0b);
		}

		.level-badge.success, .action-badge.success {
			background: rgba(16, 185, 129, 0.2);
			color: var(--color-success, #10b981);
		}

		.level-badge.info, .action-badge.info {
			background: rgba(59, 130, 246, 0.2);
			color: var(--color-info, #3b82f6);
		}

		.level-badge.secondary, .action-badge.secondary {
			background: rgba(107, 114, 128, 0.2);
			color: var(--text-muted, #6b7280);
		}

		.module-badge {
			display: inline-block;
			padding: 0.2rem 0.5rem;
			background: var(--bg-tertiary, #2a2a3e);
			border-radius: 4px;
			font-size: 0.8rem;
			color: var(--text-secondary, #a0a0a0);
		}

		.ip-address {
			font-family: monospace;
			background: var(--bg-tertiary, #2a2a3e);
			padding: 0.2rem 0.4rem;
			border-radius: 4px;
			font-size: 0.85rem;
		}

		.country-flag {
			font-size: 0.9rem;
		}

		.details-toggle {
			background: none;
			border: none;
			color: var(--color-primary, #6366f1);
			cursor: pointer;
			font-weight: bold;
			margin-left: 0.5rem;
		}

		.details-toggle:hover {
			text-decoration: underline;
		}

		.event-details {
			margin-top: 0.5rem;
			padding: 0.5rem;
			background: var(--bg-tertiary, #2a2a3e);
			border-radius: 4px;
			font-size: 0.85rem;
			color: var(--text-secondary, #a0a0a0);
			white-space: pre-wrap;
			word-break: break-word;
		}

		.page-ellipsis {
			padding: 0.5rem;
			color: var(--text-muted, #6b7280);
		}

		.btn-outline {
			background: transparent;
			border: 1px solid var(--border-color, #3a3a5e);
			color: var(--text-primary, #fff);
		}

		.btn-outline:hover {
			background: var(--bg-tertiary, #2a2a3e);
		}
	</style>
}

<file path="pkg/util/diff.go">
 1: package util
 2: 
 3: // DiffResult is a generic diff result between two slices of comparable values.
 4: // This replaces the old string-specific diff and can be reused for IPs, ports,
 5: // feed IDs, alert types, or any comparable type.
 6: type DiffResult[T comparable] struct {
 7: 	ToAdd     []T
 8: 	ToRemove  []T
 9: 	Unchanged int
10: }
11: 
12: // ComputeDiff returns which items should be added/removed to transform
13: // `current` into `desired`.
14: //
15: // This is the foundation for all sync operations in nftban v1.0:
16: // - IP set synchronization (whitelist/blacklist)
17: // - Threat feed updates
18: // - Suricata alert type management
19: // - Port set updates
20: // - Any set-based diff operation
21: //
22: // Performance characteristics:
23: // - O(n + m) time complexity where n=len(desired), m=len(current)
24: // - Preallocated maps with capacity hints for efficiency
25: // - Zero allocations for unchanged items
26: //
27: // Example usage:
28: //
29: //	desired := []string{"1.2.3.4", "5.6.7.8"}
30: //	current := []string{"5.6.7.8", "9.9.9.9"}
31: //	diff := util.ComputeDiff(desired, current)
32: //	// Result: ToAdd=["1.2.3.4"], ToRemove=["9.9.9.9"], Unchanged=1
33: func ComputeDiff[T comparable](desired, current []T) DiffResult[T] {
34: 	// Preallocate maps with exact capacity to avoid resizing
35: 	desiredSet := make(map[T]struct{}, len(desired))
36: 	for _, v := range desired {
37: 		desiredSet[v] = struct{}{}
38: 	}
39: 
40: 	currentSet := make(map[T]struct{}, len(current))
41: 	for _, v := range current {
42: 		currentSet[v] = struct{}{}
43: 	}
44: 
45: 	result := DiffResult[T]{
46: 		ToAdd:    make([]T, 0),
47: 		ToRemove: make([]T, 0),
48: 	}
49: 
50: 	// Find items in desired but not in current → add
51: 	for v := range desiredSet {
52: 		if _, ok := currentSet[v]; !ok {
53: 			result.ToAdd = append(result.ToAdd, v)
54: 		} else {
55: 			result.Unchanged++
56: 		}
57: 	}
58: 
59: 	// Find items in current but not in desired → remove
60: 	for v := range currentSet {
61: 		if _, ok := desiredSet[v]; !ok {
62: 			result.ToRemove = append(result.ToRemove, v)
63: 		}
64: 	}
65: 
66: 	return result
67: }
</file>

<file path="pkg/util/fileloader.go">
  1: package util
  2: 
  3: import (
  4: 	"bufio"
  5: 	"fmt"
  6: 	"os"
  7: )
  8: 
  9: // LoadLines reads a file line-by-line and calls the handler for each line.
 10: // Designed for efficient processing of large files (threat feeds, logs, configs).
 11: //
 12: // Key optimizations:
 13: // - Preallocated 64KB buffer prevents allocations for typical lines
 14: // - 1MB max line length handles pathological cases safely
 15: // - Single pass, streaming design for memory efficiency
 16: // - Early error returns prevent partial processing
 17: //
 18: // The handler function receives each line as a string and can:
 19: // - Return nil to continue processing
 20: // - Return error to stop and propagate error
 21: //
 22: // Use cases in nftban v1.0:
 23: // - Whitelist/blacklist file loading
 24: // - Threat feed parsing
 25: // - Suricata eve.json tailing
 26: // - Mail/panel log parsing
 27: // - Any line-oriented file processing
 28: //
 29: // Example usage:
 30: //
 31: //	err := util.LoadLines("/etc/nftban/whitelist.conf", func(line string) error {
 32: //	    line = strings.TrimSpace(line)
 33: //	    if line == "" || strings.HasPrefix(line, "#") {
 34: //	        return nil // skip empty lines and comments
 35: //	    }
 36: //	    // process line...
 37: //	    return nil
 38: //	})
 39: func LoadLines(path string, handle func(line string) error) error {
 40: 	f, err := os.Open(path)
 41: 	if err != nil {
 42: 		return err
 43: 	}
 44: 	defer f.Close()
 45: 
 46: 	scanner := bufio.NewScanner(f)
 47: 
 48: 	// Prevent allocation on long lines
 49: 	// - Initial buffer: 64KB (typical case, no allocation needed)
 50: 	// - Max buffer: 1MB (handles pathological cases like base64 blobs)
 51: 	// This is critical for threat feeds which may have long comment lines
 52: 	buf := make([]byte, 0, 64*1024)
 53: 	scanner.Buffer(buf, 1024*1024)
 54: 
 55: 	for scanner.Scan() {
 56: 		if err := handle(scanner.Text()); err != nil {
 57: 			return err
 58: 		}
 59: 	}
 60: 
 61: 	return scanner.Err()
 62: }
 63: 
 64: // RemoveLineFromFile removes lines from a file that match the given predicate.
 65: // The predicate function receives each line and returns true if the line should be removed.
 66: // Returns whether any lines were removed.
 67: //
 68: // This is used by both whitelist and blacklist packages to remove IPs from config files.
 69: // The atomic write pattern (write to tmp, then rename) ensures file integrity.
 70: //
 71: // Example usage:
 72: //
 73: //	removed, err := util.RemoveLineFromFile("/etc/nftban/blacklist.d/99-manual.conf",
 74: //	    func(line string) bool {
 75: //	        ip := strings.Fields(strings.TrimSpace(line))[0]
 76: //	        return ip == "192.168.1.100"
 77: //	    })
 78: func RemoveLineFromFile(filePath string, shouldRemove func(line string) bool) (bool, error) {
 79: 	file, err := os.Open(filePath)
 80: 	if err != nil {
 81: 		return false, err
 82: 	}
 83: 	defer file.Close()
 84: 
 85: 	var lines []string
 86: 	found := false
 87: 	scanner := bufio.NewScanner(file)
 88: 
 89: 	// Use same buffer settings as LoadLines for consistency
 90: 	buf := make([]byte, 0, 64*1024)
 91: 	scanner.Buffer(buf, 1024*1024)
 92: 
 93: 	for scanner.Scan() {
 94: 		line := scanner.Text()
 95: 		if shouldRemove(line) {
 96: 			found = true
 97: 			continue // Skip this line
 98: 		}
 99: 		lines = append(lines, line)
100: 	}
101: 
102: 	if err := scanner.Err(); err != nil {
103: 		return false, err
104: 	}
105: 
106: 	if !found {
107: 		return false, nil
108: 	}
109: 
110: 	// Atomic write: create temp file, write, then rename
111: 	tmpFile := filePath + ".tmp"
112: 	f, err := os.Create(tmpFile)
113: 	if err != nil {
114: 		return false, err
115: 	}
116: 
117: 	for _, line := range lines {
118: 		if _, err := fmt.Fprintln(f, line); err != nil {
119: 			f.Close()
120: 			os.Remove(tmpFile)
121: 			return false, err
122: 		}
123: 	}
124: 
125: 	if err := f.Close(); err != nil {
126: 		os.Remove(tmpFile)
127: 		return false, err
128: 	}
129: 
130: 	// Replace original file atomically
131: 	if err := os.Rename(tmpFile, filePath); err != nil {
132: 		os.Remove(tmpFile)
133: 		return false, err
134: 	}
135: 
136: 	return true, nil
137: }
</file>


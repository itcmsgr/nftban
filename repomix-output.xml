 782: # =============================================================================
 783: # COMPLETE INPUT CHAIN EXAMPLE (IPv4)
 784: # =============================================================================
 785: #
 786: # This is the CANONICAL input chain structure for ip nftban table.
 787: # ALL RULES MUST FOLLOW THIS ORDER!
 788: #
 789: # table ip nftban {
 790: #   # === SETS ===
 791: #   set whitelist_ipv4 {
 792: #     type ipv4_addr
 793: #     flags interval
 794: #     comment "Permanent whitelist (admin IPs, internal networks)"
 795: #   }
 796: #
 797: #   set blacklist_ipv4 {
 798: #     type ipv4_addr
 799: #     flags interval,auto-merge
 800: #     comment "Consolidated blacklist (manual + feeds + geoban + country)"
 801: #   }
 802: #
 803: #   set temp_ban_ipv4 {
 804: #     type ipv4_addr
 805: #     timeout 1h
 806: #     comment "Temporary bans from fail2ban"
 807: #   }
 808: #
 809: #   set tcp_ports {
 810: #     type inet_service
 811: #     comment "Allowed TCP ports"
 812: #     elements = { 22, 80, 443 }
 813: #   }
 814: #
 815: #   set udp_ports {
 816: #     type inet_service
 817: #     comment "Allowed UDP ports"
 818: #   }
 819: #
 820: #   # === INPUT CHAIN ===
 821: #   chain input {
 822: #     type filter hook input priority filter; policy drop;
 823: #
 824: #     # 1. Drop invalid packets
 825: #     ct state invalid drop comment "invalid state"
 826: #
 827: #     # 2. Always allow loopback
 828: #     iif lo accept comment "loopback"
 829: #
 830: #     # 3. Whitelist (bypass all checks)
 831: #     ip saddr @whitelist_ipv4 accept comment "whitelist - full access"
 832: #
 833: #     # 4. PERMANENT BLACKLIST (manual bans)
 834: #     ip saddr @blacklist_ipv4 drop comment "blacklist"
 835: #
 836: #     # 5. TEMPORARY BANS (fail2ban)
 837: #     ip saddr @temp_ban_ipv4 drop comment "temporary ban"
 838: #
 839: #     # 6. NOW allow established connections (safe after all bans checked)
 840: #     ct state established,related accept comment "established connections"
 841: #
 842: #     # 7. ICMP (ping, traceroute, etc.)
 843: #     ip protocol icmp icmp type { echo-reply, destination-unreachable, \
 844: #       echo-request, time-exceeded } accept comment "ICMPv4"
 845: #
 846: #     # 8. CT LIMITS + RATE LIMITS (DDoS protection)
 847: #     tcp flags syn ct state new \
 848: #       meter syn_flood { ip saddr limit rate 100/second burst 200 } \
 849: #       log prefix "nftban: portscan: "
 850: #
 851: #     ct state new tcp dport 22 ct count over 5 drop \
 852: #       comment "SSH: max 5 concurrent per IP"
 853: #
 854: #     ct state new tcp dport { 80, 443 } ct count over 50 drop \
 855: #       comment "HTTP(S): max 50 concurrent per IP"
 856: #
 857: #     # 9. TCP SERVICES (with ct limits applied above)
 858: #     tcp dport @tcp_ports accept comment "TCP services"
 859: #
 860: #     # 10. UDP SERVICES
 861: #     udp dport @udp_ports accept comment "UDP services"
 862: #
 863: #     # 11. DEFAULT DENY (log dropped packets)
 864: #     log prefix "nftban: drop: " limit rate 10/minute
 865: #     drop comment "default deny"
 866: #   }
 867: #
 868: #   chain forward {
 869: #     type filter hook forward priority filter; policy drop;
 870: #   }
 871: #
 872: #   chain output {
 873: #     type filter hook output priority filter; policy accept;
 874: #   }
 875: # }
 876: #
 877: # =============================================================================
 878: # MANAGEMENT HIERARCHY - SIMPLE & CONSOLIDATED
 879: # =============================================================================
 880: #
 881: # NFTBan uses SIMPLE nftables structure with ALL blocking consolidated:
 882: #
 883: # 1. WHITELIST (permanent trusted IPs) - HIGHEST PRIORITY
 884: #    - Management:
 885: #      * CLI: nftban whitelist add <ip>
 886: #      * GUI/Panel: Web interface adds to config files
 887: #      * Manual: Edit any file in /etc/nftban/whitelist.d/*.conf
 888: #    - Sources (ALL files consolidated):
 889: #      * /etc/nftban/whitelist.d/00-local.conf (manual edits)
 890: #      * /etc/nftban/whitelist.d/50-panel.conf (GUI/panel additions)
 891: #      * /etc/nftban/whitelist.d/*.conf (any user-created files)
 892: #    - Examples: Admin IPs, internal networks (10.0.0.0/8, 192.168.0.0/16)
 893: #    - Processing: nftban-core sync reads ALL files, deduplicates, loads to nftables
 894: #    - **WHITELIST PRECEDENCE RULE (ALWAYS ENFORCED)**:
 895: #      ✅ Whitelist ALWAYS wins (highest priority in firewall rule order)
 896: #      ✅ Adding IP to whitelist → AUTO-REMOVES from blacklist + temp_ban
 897: #      ✅ If IP exists in blacklist/temp_ban → removed automatically during sync
 898: #      ✅ Whitelisted IPs bypass ALL checks (blacklist, temp_ban, feeds, geoban)
 899: #      ⚠️ User informed if IP was in blacklist: "Removed from blacklist"
 900: #      ⚠️ User informed if IP was in temp_ban: "Removed from temp_ban"
 901: #
 902: # 2. BLACKLIST (ALL blocked IPs consolidated into ONE set)
 903: #    - Management:
 904: #      * CLI: nftban ban <ip> [--reason "text"]
 905: #      * CLI: nftban unban <ip>
 906: #      * GUI/Panel: Web interface adds to config files
 907: #      * Manual: Edit any file in /etc/nftban/blacklist.d/*.conf
 908: #      * Feeds: nftban-core feeds [list|load|stats]
 909: #      * GeoIP: nftban geoban add/remove <country-code>
 910: #    - **BLACKLIST PROTECTION (before adding)**:
 911: #      ⚠️ Trying to ban whitelisted IP → REJECTED with error message:
 912: #         "ERROR: Cannot ban 1.2.3.4 - IP is whitelisted!"
 913: #         "To ban this IP, first remove from whitelist: nftban whitelist remove 1.2.3.4"
 914: #      ⚠️ User must explicitly remove from whitelist first (safety check)
 915: #    - Sources (ALL consolidated by nftban-core):
 916: #      * /etc/nftban/blacklist.d/00-local.conf (manual edits)
 917: #      * /etc/nftban/blacklist.d/50-panel.conf (GUI/panel additions)
 918: #      * /etc/nftban/blacklist.d/99-manual.conf (CLI ban command)
 919: #      * /etc/nftban/blacklist.d/*.conf (any user-created files)
 920: #      * /var/lib/nftban/feeds/*.txt (threat feeds: Spamhaus, EmergingThreats, etc.)
 921: #      * MaxMind GeoIP database (country → CIDR ranges, e.g., CN, RU, KP)
 922: #    - Processing pipeline (ALL handled by nftban-core Go binary):
 923: #      a) Read ALL config files from blacklist.d/ (supports unlimited files!)
 924: #      b) Read ALL feed files from feeds/
 925: #      c) Query GeoIP database for blocked countries
 926: #      d) Consolidate ALL sources into one dataset
 927: #      e) Deduplicate (remove duplicates across ALL sources - NO DUPLICATES!)
 928: #      f) Merge overlapping CIDRs (10.0.0.0/24 + 10.0.1.0/24 → 10.0.0.0/23)
 929: #      g) Consolidate individual IPs into CIDRs where possible
 930: #      h) Sync to nftables via NETLINK (fast, direct kernel communication)
 931: #      i) Load into ONE final blacklist_ipv4 / blacklist_ipv6 set
 932: #    - Performance: 20-80% reduction after consolidation, netlink = microsecond sync
 933: #
 934: # 3. TEMP_BAN (temporary automatic bans) - HYBRID APPROACH
 935: #    - Management:
 936: #      * fail2ban (automatic via nftban-tempban action)
 937: #      * nftban tempban <ip> [duration] (manual temporary ban)
 938: #      * nftban tempban stats (view stats from file)
 939: #
 940: #    - Storage: **HYBRID (file + nftables with timer)**
 941: #
 942: #      A) **File tracking** (/var/lib/nftban/temp_bans.db):
 943: #         * Format: timestamp|ip|reason|duration|expires_at|status
 944: #         * Purpose: Historical records, stats, search, metadata
 945: #         * Advantages:
 946: #           ✅ Easy to search/grep (file is fast, nft list is slow)
 947: #           ✅ Stats available (when banned, by whom, reason, history)
 948: #           ✅ Comments/metadata preserved (nftables doesn't support this)
 949: #           ✅ No CPU crash when large (10,000+ temp bans)
 950: #           ✅ Historical tracking (bans that expired still in log)
 951: #
 952: #      B) **NFT set with timeout** (temp_ban_ipv4/ipv6):
 953: #         * Active temp bans loaded to nftables with timeout flag
 954: #         * Kernel handles auto-expiry (no manual cleanup!)
 955: #         * Fast firewall enforcement
 956: #         * Advantages:
 957: #           ✅ Auto-expiry built-in (kernel removes expired IPs)
 958: #           ✅ Fast enforcement (kernel-level)
 959: #           ✅ No sync daemon needed (timeout is automatic)
 960: #
 961: #    - Workflow:
 962: #      1. fail2ban bans IP → writes to /var/lib/nftban/temp_bans.db
 963: #      2. nftban-core sync reads file, loads to temp_ban_ipv4/ipv6 with timeout
 964: #      3. Kernel automatically expires after timeout (1h default)
 965: #      4. File keeps historical record for stats
 966: #      5. Admin can review: "keep banned" → move to blacklist permanently
 967: #      6. Admin can review: "trust" → move to whitelist
 968: #
 969: #    - Migration after expiry:
 970: #      * Option 1: IP expires, removed from NFT, stays in file as "expired"
 971: #      * Option 2: Admin promotes to permanent blacklist (nftban ban <ip>)
 972: #      * Option 3: Admin promotes to whitelist (nftban whitelist add <ip>)
 973: #
 974: #    - Examples: Brute force attempts, repeated login failures, port scans
 975: #    - Timeout: Configurable (default 1h), auto-expires via kernel timer
 976: #    - Stats command: nftban tempban stats (fast grep on file, no NFT query)
 977: #
 978: # =============================================================================
 979: # CONFLICT RESOLUTION & PRECEDENCE
 980: # =============================================================================
 981: #
 982: # When the same IP exists in multiple lists, nftban-core enforces this order:
 983: #
 984: # PRECEDENCE ORDER (highest to lowest):
 985: # -------------------------------------
 986: # 1. WHITELIST (always wins)
 987: # 2. BLACKLIST (permanent bans)
 988: # 3. TEMP_BAN (temporary bans)
 989: #
 990: # CONFLICT RESOLUTION RULES:
 991: # ---------------------------
 992: # A) **Adding to whitelist**:
 993: #    - nftban whitelist add 1.2.3.4
 994: #    - Go checks if IP exists in blacklist → removes from blacklist
 995: #    - Go checks if IP exists in temp_ban → removes from temp_ban
 996: #    - Go checks if IP exists in feeds → excluded from feeds during sync
 997: #    - User informed: "✅ Added to whitelist, ⚠️ Removed from blacklist"
 998: #
 999: # B) **Adding to blacklist**:
1000: #    - nftban ban 1.2.3.4
1001: #    - Go checks if IP exists in whitelist → REJECTS with error:
1002: #      "❌ ERROR: Cannot ban 1.2.3.4 - IP is whitelisted!"
1003: #      "To ban this IP: nftban whitelist remove 1.2.3.4"
1004: #    - User must explicitly remove from whitelist first (safety check)
1005: #
1006: # C) **Sync operation** (nftban-core sync):
1007: #    - Loads whitelist first
1008: #    - Loads blacklist, excludes any IPs in whitelist
1009: #    - Loads temp_ban, excludes any IPs in whitelist
1010: #    - Loads feeds, excludes any IPs in whitelist
1011: #    - Result: Whitelist IPs NEVER appear in blacklist sets (guaranteed)
1012: #
1013: # D) **Feed updates**:
1014: #    - nftban-core feeds load
1015: #    - If feed contains whitelisted IP → automatically excluded
1016: #    - User informed: "⚠️ Excluded N whitelisted IPs from feeds"
1017: #
1018: # WHY THIS PREVENTS MISTAKES:
1019: # ============================
1020: # ✅ Cannot accidentally ban admin IPs (whitelist protection)
1021: # ✅ Cannot have IP in both whitelist and blacklist (auto-cleanup)
1022: # ✅ Clear error messages guide user to fix conflicts
1023: # ✅ Feeds automatically respect whitelist (no manual exclusion)
1024: # ✅ Whitelist always checked FIRST in firewall rules (security)
1025: #
1026: # WHY THIS IS EASIER:
1027: # ===================
1028: # ✅ ONE blacklist set (not multiple feeds/geoban/manual sets)
1029: # ✅ Go handles ALL complexity internally (parsing, dedup, CIDR merging)
1030: # ✅ Supports UNLIMITED config files (*.conf in whitelist.d/ and blacklist.d/)
1031: # ✅ NO DUPLICATES guaranteed (Go deduplicates across ALL sources)
1032: # ✅ NETLINK sync (microsecond performance, direct kernel communication)
1033: # ✅ GUI/Panel can add files without touching existing ones
1034: # ✅ Temp bans: HYBRID approach (file for stats + NFT timer for auto-expiry)
1035: # ✅ Easy stats (grep file, no slow NFT queries on large sets)
1036: # ✅ Auto-expiry (kernel timer, no daemon needed)
1037: # ✅ Historical tracking (temp_bans.db keeps all records)
1038: # ✅ Flexible migration (temp → permanent blacklist/whitelist)
1039: # ✅ Less room for mistakes (no manual set management)
1040: # ✅ Efficient lookups (ONE set lookup, not multiple)
1041: # ✅ CIDR optimization happens automatically
1042: # ✅ Clear separation: whitelist / blacklist / temp_ban
1043: # ✅ Easy to understand rule order
1044: # ✅ Simpler debugging (check ONE blacklist, not many sets)
1045: # ✅ Expandable (users can add custom .conf files anytime)
1046: #
1047: # =============================================================================
1048: # USAGE NOTES
1049: # =============================================================================
1050: #
1051: # This schema file serves as the CANONICAL REFERENCE for NFTBan's nftables
1052: # structure. When modifying nftables configuration:
1053: #
1054: # 1. Update this schema file FIRST
1055: # 2. Update implementation code to match
1056: # 3. Run validation to verify alignment
1057: #
1058: # To validate current system:
1059: #   source /usr/lib/nftban/lib/nft_schema.sh
1060: #   nftban_nft_report_status
1061: #
1062: # To get correct table for an IP:
1063: #   table=$(nftban_nft_get_table_for_ip "1.2.3.4")      # Returns: ip nftban
1064: #   table=$(nftban_nft_get_table_for_ip "2001:db8::1")  # Returns: ip6 nftban
1065: #
1066: # To get correct set name:
1067: #   set=$(nftban_nft_get_set_name "1.2.3.4" "ban")     # Returns: blacklist_ipv4
1068: #   set=$(nftban_nft_get_set_name "2001:db8::1" "ban") # Returns: blacklist_ipv6
1069: #
1070: # To add a ban:
1071: #   nftban ban 1.2.3.4
1072: #   # Adds to /etc/nftban/blacklist.d/99-manual.conf
1073: #   # Then run: nftban-core sync
1074: #
1075: # To sync ALL sources to nftables:
1076: #   nftban-core sync
1077: #   # Reads ALL config files (whitelist.d/*.conf + blacklist.d/*.conf)
1078: #   # Reads ALL feeds (/var/lib/nftban/feeds/*.txt)
1079: #   # Reads GeoIP database for country blocks
1080: #   # Consolidates, deduplicates, merges CIDRs
1081: #   # Syncs to nftables via netlink (differential sync - only changes applied)
1082: #
1083: # =============================================================================
</file>


233: 
234: # =============================================================================
235: # HELP TEXT
236: # =============================================================================
237: 
238: _nftban_geoip_help() {
239:     nftban_banner "geoip"
240: 
241:     cat <<'HELP'
242: 
243: USAGE:
244:     nftban geoip <command>
245: 
246: COMMANDS:
247:     download        Download GeoIP database (first time)
248:     update          Update GeoIP database

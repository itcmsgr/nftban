<file path="install/tmpfiles.d/nftban.conf">
 1: # =============================================================================
 2: # NFTBan v1.0 - tmpfiles.d Configuration
 3: # =============================================================================
 4: # SPDX-License-Identifier: MPL-2.0
 5: # Purpose: Create runtime directories on boot
 6: # Location: /etc/tmpfiles.d/nftban.conf or /usr/lib/tmpfiles.d/nftban.conf
 7: #
 8: # This file ensures NFTBan runtime directories exist after boot.
 9: # Directories in /run are volatile (tmpfs) and need recreation.
10: #
11: # Format: Type Path Mode User Group Age Argument
12: # See: man tmpfiles.d(5)
13: # =============================================================================
14: 
15: # Runtime directory (volatile - needs recreation on boot)
16: d /run/nftban 0755 nftban nftban -
17: 
18: # Runtime subdirectories
19: d /run/nftban/sockets 0750 nftban nftban -
20: 
21: # PID file cleanup (remove stale PID files on boot)
22: r /run/nftban/*.pid
23: 
24: # Cache directory (persistent but may need cleanup)
25: d /var/cache/nftban 0755 nftban nftban -
26: 
27: # Ensure log directory exists with correct permissions
28: d /var/log/nftban 0750 nftban nftban -
29: 
30: # Ensure state directory exists
31: d /var/lib/nftban 0750 nftban nftban -
32: 
33: # State subdirectories
34: d /var/lib/nftban/config 0750 nftban nftban -
35: d /var/lib/nftban/state 0750 nftban nftban -
36: d /var/lib/nftban/feeds 0750 nftban nftban -
37: d /var/lib/nftban/geoip 0750 nftban nftban -
38: d /var/lib/nftban/reports 0750 nftban nftban -
39: d /var/lib/nftban/metrics 0750 nftban nftban -
40: d /var/lib/nftban/snapshots 0750 nftban nftban -
41: d /var/lib/nftban/exports 0750 nftban nftban -

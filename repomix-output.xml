410: // cleanupOldBackups removes old backups, keeping only the most recent N
411: func (m *Manager) cleanupOldBackups(keep int) error {
412: 	files, err := filepath.Glob(filepath.Join(m.backupDir, "custom.rules.*"))
413: 	if err != nil {
414: 		return err
415: 	}
416: 
417: 	if len(files) <= keep {
418: 		return nil // Nothing to cleanup
419: 	}
420: 
421: 	// Sort by modification time (oldest first)
422: 	// Since we use timestamp in filename, alphabetical sort works
423: 	// Remove oldest files
424: 	for i := 0; i < len(files)-keep; i++ {
425: 		if err := os.Remove(files[i]); err != nil {
426: 			return err
427: 		}
428: 	}
429: 
430: 	return nil
431: }

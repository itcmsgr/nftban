 797:     echo "# HELP nftban_network_tx_bytes Total transmitted bytes per interface" >> "$TEMP_FILE"
 798:     echo "# TYPE nftban_network_tx_bytes counter" >> "$TEMP_FILE"
 799:     echo "# HELP nftban_network_rx_packets Total received packets per interface" >> "$TEMP_FILE"
 800:     echo "# TYPE nftban_network_rx_packets counter" >> "$TEMP_FILE"
 801:     echo "# HELP nftban_network_tx_packets Total transmitted packets per interface" >> "$TEMP_FILE"
 802:     echo "# TYPE nftban_network_tx_packets counter" >> "$TEMP_FILE"
 803:     echo "# HELP nftban_network_rx_mbps Current receive bandwidth in Mbps" >> "$TEMP_FILE"
 804:     echo "# TYPE nftban_network_rx_mbps gauge" >> "$TEMP_FILE"
 805:     echo "# HELP nftban_network_tx_mbps Current transmit bandwidth in Mbps" >> "$TEMP_FILE"
 806:     echo "# TYPE nftban_network_tx_mbps gauge" >> "$TEMP_FILE"
 807: 
 808:     # Collect per-interface statistics
 809:     local total_rx_bytes=0
 810:     local total_tx_bytes=0
 811:     local total_rx_packets=0
 812:     local total_tx_packets=0
 813:     local total_rx_mbps=0
 814:     local total_tx_mbps=0
 815:     local iface
 816: 
 817:     # Get list of interfaces first (avoid process substitution)
 818:     local active_interfaces
 819:     active_interfaces=$(get_active_interfaces)
 820: 
 821:     for iface in $active_interfaces; do
 822:         local stats
 823:         local rx_bytes
 824:         local rx_packets
 825:         local tx_bytes
 826:         local tx_packets
 827:         stats=$(get_interface_stats "$iface") || continue
 828: 
 829:         rx_bytes=$(echo "$stats" | awk '{print $1}')
 830:         rx_packets=$(echo "$stats" | awk '{print $2}')
 831:         tx_bytes=$(echo "$stats" | awk '{print $3}')
 832:         tx_packets=$(echo "$stats" | awk '{print $4}')
 833: 
 834:         # Output counter metrics
 835:         echo "nftban_network_rx_bytes{interface=\"${iface}\"} ${rx_bytes}" >> "$TEMP_FILE"
 836:         echo "nftban_network_tx_bytes{interface=\"${iface}\"} ${tx_bytes}" >> "$TEMP_FILE"
 837:         echo "nftban_network_rx_packets{interface=\"${iface}\"} ${rx_packets}" >> "$TEMP_FILE"
 838:         echo "nftban_network_tx_packets{interface=\"${iface}\"} ${tx_packets}" >> "$TEMP_FILE"
 839: 
 840:         # Calculate bandwidth (Mbps) from previous state
 841:         if [[ -f "$STATE_FILE" ]]; then
 842:             local prev_data
 843:             prev_data=$(grep "^${iface} " "$STATE_FILE" 2>/dev/null || echo "")
 844: 
 845:             if [[ -n "$prev_data" ]]; then
 846:                 local prev_ts
 847:                 local prev_rx
 848:                 local prev_tx
 849:                 local time_delta
 850:                 local rx_delta
 851:                 local tx_delta
 852:                 local rx_mbps
 853:                 local tx_mbps
 854: 
 855:                 prev_ts=$(echo "$prev_data" | awk '{print $2}')
 856:                 prev_rx=$(echo "$prev_data" | awk '{print $3}')
 857:                 prev_tx=$(echo "$prev_data" | awk '{print $4}')
 858: 
 859:                 time_delta=$(( START_TIME_UNIX - prev_ts ))
 860:                 rx_delta=$(( rx_bytes - prev_rx ))
 861:                 tx_delta=$(( tx_bytes - prev_tx ))
 862: 
 863:                 # Handle counter resets
 864:                 [[ $rx_delta -lt 0 ]] && rx_delta=$rx_bytes
 865:                 [[ $tx_delta -lt 0 ]] && tx_delta=$tx_bytes
 866: 
 867:                 rx_mbps=$(calculate_mbps "$rx_delta" "$time_delta")
 868:                 tx_mbps=$(calculate_mbps "$tx_delta" "$time_delta")
 869: 
 870:                 echo "nftban_network_rx_mbps{interface=\"${iface}\"} ${rx_mbps}" >> "$TEMP_FILE"
 871:                 echo "nftban_network_tx_mbps{interface=\"${iface}\"} ${tx_mbps}" >> "$TEMP_FILE"
 872: 
 873:                 total_rx_mbps=$(awk -v a="$total_rx_mbps" -v b="$rx_mbps" 'BEGIN {printf "%.2f", a + b}')
 874:                 total_tx_mbps=$(awk -v a="$total_tx_mbps" -v b="$tx_mbps" 'BEGIN {printf "%.2f", a + b}')
 875:             fi
 876:         fi
 877: 
 878:         # Accumulate totals
 879:         total_rx_bytes=$(( total_rx_bytes + rx_bytes ))
 880:         total_tx_bytes=$(( total_tx_bytes + tx_bytes ))
 881:         total_rx_packets=$(( total_rx_packets + rx_packets ))
 882:         total_tx_packets=$(( total_tx_packets + tx_packets ))
 883: 
 884:     done
 885: 
 886:     echo "" >> "$TEMP_FILE"
 887: 
 888:     # Output total bandwidth
 889:     echo "# HELP nftban_network_total_rx_mbps Total receive bandwidth across all interfaces" >> "$TEMP_FILE"
 890:     echo "# TYPE nftban_network_total_rx_mbps gauge" >> "$TEMP_FILE"
 891:     echo "nftban_network_total_rx_mbps ${total_rx_mbps}" >> "$TEMP_FILE"
 892:     echo "# HELP nftban_network_total_tx_mbps Total transmit bandwidth across all interfaces" >> "$TEMP_FILE"
 893:     echo "# TYPE nftban_network_total_tx_mbps gauge" >> "$TEMP_FILE"
 894:     echo "nftban_network_total_tx_mbps ${total_tx_mbps}" >> "$TEMP_FILE"
 895:     echo "" >> "$TEMP_FILE"
 896: 
 897:     # Protocol statistics
 898:     echo "# HELP nftban_protocol_bytes Total bytes per protocol" >> "$TEMP_FILE"
 899:     echo "# TYPE nftban_protocol_bytes counter" >> "$TEMP_FILE"
 900:     echo "nftban_protocol_bytes{protocol=\"tcp\"} $(get_protocol_stats tcp bytes)" >> "$TEMP_FILE"
 901:     echo "nftban_protocol_bytes{protocol=\"udp\"} $(get_protocol_stats udp bytes)" >> "$TEMP_FILE"
 902:     echo "nftban_protocol_bytes{protocol=\"icmp\"} $(get_protocol_stats icmp bytes)" >> "$TEMP_FILE"
 903:     echo "" >> "$TEMP_FILE"
 904: 
 905:     echo "# HELP nftban_protocol_packets Total packets per protocol" >> "$TEMP_FILE"
 906:     echo "# TYPE nftban_protocol_packets counter" >> "$TEMP_FILE"
 907:     echo "nftban_protocol_packets{protocol=\"tcp\"} $(get_protocol_stats tcp packets)" >> "$TEMP_FILE"
 908:     echo "nftban_protocol_packets{protocol=\"udp\"} $(get_protocol_stats udp packets)" >> "$TEMP_FILE"
 909:     echo "nftban_protocol_packets{protocol=\"icmp\"} $(get_protocol_stats icmp packets)" >> "$TEMP_FILE"
 910:     echo "" >> "$TEMP_FILE"
 911: 
 912:     # Connection statistics
 913:     echo "# HELP nftban_connections_active Total active TCP connections" >> "$TEMP_FILE"
 914:     echo "# TYPE nftban_connections_active gauge" >> "$TEMP_FILE"
 915:     echo "nftban_connections_active $(get_connection_stats active)" >> "$TEMP_FILE"
 916:     echo "" >> "$TEMP_FILE"
 917: 
 918:     echo "# HELP nftban_connections_established Established TCP connections" >> "$TEMP_FILE"
 919:     echo "# TYPE nftban_connections_established gauge" >> "$TEMP_FILE"
 920:     echo "nftban_connections_established $(get_connection_stats established)" >> "$TEMP_FILE"
 921:     echo "" >> "$TEMP_FILE"
 922: 
 923:     echo "# HELP nftban_connections_time_wait TCP connections in TIME_WAIT state" >> "$TEMP_FILE"
 924:     echo "# TYPE nftban_connections_time_wait gauge" >> "$TEMP_FILE"
 925:     echo "nftban_connections_time_wait $(get_connection_stats time_wait)" >> "$TEMP_FILE"
 926:     echo "" >> "$TEMP_FILE"
 927: 
 928:     echo "# HELP nftban_connections_close_wait TCP connections in CLOSE_WAIT state" >> "$TEMP_FILE"
 929:     echo "# TYPE nftban_connections_close_wait gauge" >> "$TEMP_FILE"
 930:     echo "nftban_connections_close_wait $(get_connection_stats close_wait)" >> "$TEMP_FILE"
 931:     echo "" >> "$TEMP_FILE"
 932: 
 933:     # Peak tracking
 934:     local peaks
 935:     local peak_rx
 936:     local peak_tx
 937:     peaks=$(update_peaks "$total_rx_mbps" "$total_tx_mbps" "$START_TIME_UNIX")
 938:     peak_rx=$(echo "$peaks" | awk '{print $1}')
 939:     peak_tx=$(echo "$peaks" | awk '{print $2}')
 940: 
 941:     echo "# HELP nftban_bandwidth_peak_rx_mbps Peak receive bandwidth in last 5 minutes" >> "$TEMP_FILE"
 942:     echo "# TYPE nftban_bandwidth_peak_rx_mbps gauge" >> "$TEMP_FILE"
 943:     echo "nftban_bandwidth_peak_rx_mbps ${peak_rx}" >> "$TEMP_FILE"
 944:     echo "" >> "$TEMP_FILE"
 945: 
 946:     echo "# HELP nftban_bandwidth_peak_tx_mbps Peak transmit bandwidth in last 5 minutes" >> "$TEMP_FILE"
 947:     echo "# TYPE nftban_bandwidth_peak_tx_mbps gauge" >> "$TEMP_FILE"
 948:     echo "nftban_bandwidth_peak_tx_mbps ${peak_tx}" >> "$TEMP_FILE"
 949:     echo "" >> "$TEMP_FILE"
 950: 
 951:     # Update state file for next run
 952:     {
 953:         for iface in $active_interfaces; do
 954:             local stats
 955:             local rx_bytes
 956:             local tx_bytes
 957:             stats=$(get_interface_stats "$iface") || continue
 958:             rx_bytes=$(echo "$stats" | awk '{print $1}')
 959:             tx_bytes=$(echo "$stats" | awk '{print $3}')
 960:             echo "${iface} ${START_TIME_UNIX} ${rx_bytes} ${tx_bytes}"
 961:         done
 962:     } > "${STATE_FILE}.new"
 963:     mv -f "${STATE_FILE}.new" "$STATE_FILE" 2>/dev/null || true
 964: 
 965:     # -------------------------------------------------------------------------
 966:     # Call Sub-Exporters (v0.6.1+)
 967:     # -------------------------------------------------------------------------
 968: 
 969:     # Run additional exporters if they exist
 970:     local exporter_dir="${NFTBAN_LIB_DIR}/exporters"
 971: 
 972:     if [[ -x "${exporter_dir}/nftban_firewall_exporter.sh" ]]; then
 973:         "${exporter_dir}/nftban_firewall_exporter.sh" 2>/dev/null || true
 974:     fi
 975: 
 976:     if [[ -x "${exporter_dir}/nftban_geoban_exporter.sh" ]]; then
 977:         "${exporter_dir}/nftban_geoban_exporter.sh" 2>/dev/null || true
 978:     fi
 979: 
 980:     if [[ -x "${exporter_dir}/nftban_portscan_exporter.sh" ]]; then
 981:         "${exporter_dir}/nftban_portscan_exporter.sh" 2>/dev/null || true
 982:     fi
 983: 
 984:     # -------------------------------------------------------------------------
 985:     # Finalize
 986:     # -------------------------------------------------------------------------
 987: 
 988:     # Atomic write: move temp file to final location
 989:     mv "$TEMP_FILE" "$OUTPUT_FILE"
 990: 
 991:     # Set permissions (readable by node_exporter)
 992:     chmod 644 "$OUTPUT_FILE"
 993: }
 994: 
 995: # =============================================================================
 996: # MAIN
 997: # =============================================================================
 998: 
 999: main() {
1000:     # Ensure output directory exists
1001:     local output_dir
1002:     output_dir=$(dirname "$OUTPUT_FILE")
1003: 
1004:     if [[ ! -d "$output_dir" ]]; then
1005:         mkdir -p "$output_dir"
1006:         # Set ownership if running as root
1007:         if [[ $EUID -eq 0 ]]; then
1008:             chown -R nftban:nftban "$output_dir" 2>/dev/null || true
1009:         fi
1010:     fi
1011: 
1012:     # Collect and write metrics
1013:     collect_metrics
1014: 
1015:     # Log to syslog if available
1016:     if command -v logger &>/dev/null; then
1017:         logger -t nftban-exporter "Metrics exported successfully to $OUTPUT_FILE"
1018:     fi
1019: 
1020:     exit 0
1021: }
1022: 
1023: # Run main function
1024: main "$@"

 836: // Helper function to count lines in a file
 837: func countLinesInFile(filePath string) int {
 838: 	file, err := os.Open(filePath)
 839: 	if err != nil {
 840: 		return 0
 841: 	}
 842: 	defer file.Close()
 843: 
 844: 	count := 0
 845: 	scanner := bufio.NewScanner(file)
 846: 	for scanner.Scan() {
 847: 		line := strings.TrimSpace(scanner.Text())
 848: 		// Skip empty lines and comments
 849: 		if line != "" && !strings.HasPrefix(line, "#") {
 850: 			count++
 851: 		}
 852: 	}
 853: 	return count
 854: }

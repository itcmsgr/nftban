<file path="cli/lib/nftban/setup/install_victoriametrics.sh">
  1: #!/usr/bin/env bash
  2: # shellcheck disable=SC2120  # Function designed to accept optional args
  3: # =============================================================================
  4: # NFTBan v1.0.0 - VictoriaMetrics Installation Script
  5: # =============================================================================
  6: # SPDX-License-Identifier: MPL-2.0
  7: # Purpose: Install and configure VictoriaMetrics for NFTBan metrics
  8: # Location: /usr/lib/nftban/setup/install_victoriametrics.sh
  9: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 10: # meta:homepage=https://nftban.com
 11: #
 12: # meta:name=install_victoriametrics
 13: # meta:type=setup
 14: # meta:header=VictoriaMetrics Installation
 15: # meta:version=1.0.0
 16: #
 17: # meta:created_date=2025-11-28
 18: # =============================================================================
 19: 
 20: set -Eeuo pipefail
 21: IFS=$'\n\t'
 22: 
 23: # Colors
 24: readonly RED='\033[0;31m'
 25: readonly GREEN='\033[0;32m'
 26: readonly YELLOW='\033[1;33m'
 27: readonly NC='\033[0m'
 28: 
 29: # VictoriaMetrics configuration
 30: readonly VM_VERSION="${VM_VERSION:-v1.99.0}"
 31: readonly VM_USER="victoriametrics"
 32: readonly VM_GROUP="victoriametrics"
 33: readonly VM_DIR="/etc/victoriametrics"
 34: readonly VM_DATA_DIR="/var/lib/victoriametrics"
 35: readonly VM_BIN="/usr/local/bin/victoria-metrics-prod"
 36: 
 37: print_status() {
 38:     echo -e "${GREEN}[✓]${NC} $1"
 39: }
 40: 
 41: print_error() {
 42:     echo -e "${RED}[✗]${NC} $1" >&2
 43: }
 44: 
 45: print_info() {
 46:     echo -e "${YELLOW}[i]${NC} $1"
 47: }
 48: 
 49: detect_arch() {
 50:     local arch
 51:     arch=$(uname -m)
 52: 
 53:     case "$arch" in
 54:         x86_64)
 55:             echo "amd64"
 56:             ;;
 57:         aarch64|arm64)
 58:             echo "arm64"
 59:             ;;
 60:         *)
 61:             print_error "Unsupported architecture: $arch"
 62:             exit 1
 63:             ;;
 64:     esac
 65: }
 66: 
 67: install_via_binary() {
 68:     local version="${1:-$VM_VERSION}"
 69:     local arch
 70:     arch=$(detect_arch)
 71: 
 72:     print_info "Installing VictoriaMetrics ${version} for ${arch}..."
 73: 
 74:     # Create user/group if doesn't exist
 75:     if ! id "$VM_USER" &>/dev/null; then
 76:         useradd --system --no-create-home --shell /usr/sbin/nologin "$VM_USER"
 77:         print_status "Created victoriametrics user"
 78:     fi
 79: 
 80:     # Download and extract
 81:     local tmp_dir="/tmp/victoriametrics-install"
 82:     mkdir -p "$tmp_dir"
 83:     cd "$tmp_dir"
 84: 
 85:     local url="https://github.com/VictoriaMetrics/VictoriaMetrics/releases/download/${version}/victoria-metrics-linux-${arch}-${version}.tar.gz"
 86: 
 87:     print_info "Downloading from: $url"
 88:     curl -sL "$url" -o victoriametrics.tar.gz || {
 89:         print_error "Download failed"
 90:         return 1
 91:     }
 92: 
 93:     tar xzf victoriametrics.tar.gz
 94: 
 95:     # Install binary
 96:     cp victoria-metrics-prod /usr/local/bin/
 97:     chmod +x /usr/local/bin/victoria-metrics-prod
 98: 
 99:     # Create directories
100:     mkdir -p "$VM_DIR" "$VM_DATA_DIR"
101: 
102:     # Set ownership
103:     chown -R "$VM_USER:$VM_GROUP" "$VM_DIR" "$VM_DATA_DIR"
104: 
105:     # Cleanup
106:     cd /
107:     rm -rf "$tmp_dir"
108: 
109:     print_status "VictoriaMetrics binary installed"
110: }
111: 
112: create_systemd_service() {
113:     print_info "Creating systemd service..."
114: 
115:     cat > /etc/systemd/system/victoriametrics.service << 'EOF'
116: [Unit]
117: Description=VictoriaMetrics - High-Performance Time Series Database
118: Documentation=https://docs.victoriametrics.com/
119: Wants=network-online.target
120: After=network-online.target
121: 
122: [Service]
123: Type=simple
124: User=victoriametrics
125: Group=victoriametrics
126: ExecStart=/usr/local/bin/victoria-metrics-prod \
127:   -storageDataPath=/var/lib/victoriametrics \
128:   -retentionPeriod=12 \
129:   -httpListenAddr=127.0.0.1:8428 \
130:   -promscrape.config=/etc/victoriametrics/scrape.yml
131: 
132: SyslogIdentifier=victoriametrics
133: Restart=always
134: RestartSec=5
135: 
136: # Security hardening
137: PrivateTmp=yes
138: ProtectSystem=strict
139: ProtectHome=yes
140: NoNewPrivileges=yes
141: ReadWritePaths=/var/lib/victoriametrics
142: 
143: [Install]
144: WantedBy=multi-user.target
145: EOF
146: 
147:     systemctl daemon-reload
148:     print_status "Systemd service created"
149: }
150: 
151: configure_victoriametrics() {
152:     print_info "Configuring VictoriaMetrics for NFTBan..."
153: 
154:     # Backup existing config
155:     if [[ -f "$VM_DIR/scrape.yml" ]]; then
156:         cp "$VM_DIR/scrape.yml" "$VM_DIR/scrape.yml.backup"
157:     fi
158: 
159:     # Create scrape configuration (VictoriaMetrics format - no evaluation_interval)
160:     cat > "$VM_DIR/scrape.yml" << 'EOF'
161: global:
162:   scrape_interval: 60s
163: 
164: scrape_configs:
165:   - job_name: 'nftban'
166:     static_configs:
167:       - targets: ['localhost:9100']
168:     metric_relabel_configs:
169:       # Keep NFTBan metrics and essential node_exporter metrics
170:       - source_labels: [__name__]
171:         regex: '(nftban_.*|node_(cpu|memory|disk|network).*)'
172:         action: keep
173: EOF
174: 
175:     chown "$VM_USER:$VM_GROUP" "$VM_DIR/scrape.yml"
176:     print_status "VictoriaMetrics configured for NFTBan"
177: }
178: 
179: main() {
180:     print_info "NFTBan VictoriaMetrics Installation"
181:     echo ""
182: 
183:     # Check root
184:     if [[ $EUID -ne 0 ]]; then
185:         print_error "This script must be run as root"
186:         exit 1
187:     fi
188: 
189:     # Check if already installed
190:     if [[ -f "$VM_BIN" ]]; then
191:         local current_version
192:         current_version=$($VM_BIN -version 2>&1 | grep -oP 'victoria-metrics-\d{8}-.*' | head -1 || echo "unknown")
193:         print_info "VictoriaMetrics already installed: $current_version"
194: 
195:         read -p "Reinstall? [y/N] " -n 1 -r
196:         echo
197:         if [[ ! $REPLY =~ ^[Yy]$ ]]; then
198:             exit 0
199:         fi
200:     fi
201: 
202:     # Install binary
203:     install_via_binary
204: 
205:     # Create systemd service
206:     create_systemd_service
207: 
208:     # Configure
209:     configure_victoriametrics
210: 
211:     # Enable and start
212:     systemctl enable victoriametrics
213:     systemctl start victoriametrics
214: 
215:     # Wait and check
216:     sleep 3
217:     if systemctl is-active --quiet victoriametrics; then
218:         print_status "VictoriaMetrics is running"
219:         print_info "Web UI: http://127.0.0.1:8428/vmui"
220:         print_info "API: http://127.0.0.1:8428"
221:         print_info "Config: $VM_DIR/scrape.yml"
222:         print_info "Data: $VM_DATA_DIR"
223:         print_info "Retention: 12 months"
224:     else
225:         print_error "VictoriaMetrics failed to start"
226:         systemctl status victoriametrics
227:         exit 1
228:     fi
229: 
230:     echo ""
231:     print_status "VictoriaMetrics installation complete!"
232:     echo ""
233:     print_info "Next steps:"
234:     echo "  1. Ensure node_exporter is running: systemctl start prometheus-node-exporter"
235:     echo "  2. Enable NFTBan metrics: nftban metrics enable --backend victoriametrics"
236:     echo "  3. Access UI: http://127.0.0.1:8428/vmui"
237:     echo ""
238: }
239: 
240: main "$@"
</file>

<file path="cli/lib/nftban/setup/validate_prometheus.sh">
  1: #!/usr/bin/env bash
  2: # shellcheck disable=SC2034  # verbose used in eval context
  3: # =============================================================================
  4: # NFTBan v1.0.0 - Prometheus Validation Script
  5: # =============================================================================
  6: # SPDX-License-Identifier: MPL-2.0
  7: # Purpose: Validate Prometheus installation and NFTBan metrics integration
  8: # Location: /usr/lib/nftban/setup/validate_prometheus.sh
  9: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 10: # meta:homepage=https://nftban.com
 11: # nftban — Simplifying Linux Firewall Management
 12: #
 13: # meta:name=validate_prometheus
 14: # meta:type=setup
 15: # meta:header=Prometheus Validation
 16: # meta:version=1.0.0
 17: #
 18: # **Description & Purpose**
 19: # meta:description=Validate Prometheus installation and NFTBan metrics collection
 20: # meta:input=Running Prometheus instance
 21: # meta:output=Validation report with pass/fail status
 22: #
 23: # **Inventory & Requirements**
 24: # meta:depends=bash,curl,systemctl,jq
 25: #
 26: # meta:created_date=2025-11-17
 27: # =============================================================================
 28: 
 29: # Enhanced strict mode
 30: set -Eeuo pipefail
 31: IFS=$'\n\t'
 32: umask 027
 33: 
 34: # =============================================================================
 35: # CONFIGURATION
 36: # =============================================================================
 37: 
 38: SCRIPT_NAME="$(basename "${BASH_SOURCE[0]}")"
 39: readonly SCRIPT_NAME
 40: readonly PROMETHEUS_PORT=9090
 41: 
 42: # Colors for output
 43: readonly RED='\033[0;31m'
 44: readonly GREEN='\033[0;32m'
 45: readonly YELLOW='\033[0;33m'
 46: readonly BLUE='\033[0;34m'
 47: readonly NC='\033[0m' # No Color
 48: 
 49: # Test counters
 50: TOTAL_TESTS=0
 51: PASSED_TESTS=0
 52: FAILED_TESTS=0
 53: WARNING_TESTS=0
 54: 
 55: # =============================================================================
 56: # FUNCTIONS
 57: # =============================================================================
 58: 
 59: # Print colored message
 60: print_color() {
 61:     local color="$1"
 62:     shift
 63:     echo -e "${color}$*${NC}"
 64: }
 65: 
 66: # Print test header
 67: test_header() {
 68:     echo ""
 69:     print_color "$BLUE" "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
 70:     print_color "$BLUE" "TEST: $*"
 71:     print_color "$BLUE" "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
 72: }
 73: 
 74: # Print test result
 75: test_result() {
 76:     local status="$1"
 77:     local message="$2"
 78: 
 79:     TOTAL_TESTS=$((TOTAL_TESTS + 1))
 80: 
 81:     case "$status" in
 82:         PASS)
 83:             print_color "$GREEN" "✓ PASS: $message"
 84:             PASSED_TESTS=$((PASSED_TESTS + 1))
 85:             ;;
 86:         FAIL)
 87:             print_color "$RED" "✗ FAIL: $message"
 88:             FAILED_TESTS=$((FAILED_TESTS + 1))
 89:             ;;
 90:         WARN)
 91:             print_color "$YELLOW" "⚠ WARN: $message"
 92:             WARNING_TESTS=$((WARNING_TESTS + 1))
 93:             ;;
 94:     esac
 95: }
 96: 
 97: # Print usage
 98: usage() {
 99:     cat <<EOF
100: Usage: $SCRIPT_NAME [OPTIONS]
101: 
102: Validate Prometheus installation and NFTBan metrics integration.
103: 
104: OPTIONS:
105:     --verbose               Show detailed output
106:     --skip-metrics         Skip metrics validation (test Prometheus only)
107:     --help                 Show this help message
108: 
109: EXAMPLES:
110:     # Standard validation
111:     $SCRIPT_NAME
112: 
113:     # Verbose mode
114:     $SCRIPT_NAME --verbose
115: 
116:     # Test Prometheus only
117:     $SCRIPT_NAME --skip-metrics
118: 
119: EXIT CODES:
120:     0 - All tests passed
121:     1 - One or more tests failed
122:     2 - Critical failure (Prometheus not running)
123: 
124: EOF
125: }
126: 
127: # Test 1: Service status
128: test_service_status() {
129:     test_header "Service Status"
130: 
131:     # Check if service exists
132:     if ! systemctl list-unit-files | grep -q "prometheus.service"; then
133:         test_result "FAIL" "Prometheus service not found"
134:         return 1
135:     fi
136:     test_result "PASS" "Service found: prometheus.service"
137: 
138:     # Check if enabled
139:     if systemctl is-enabled --quiet prometheus; then
140:         test_result "PASS" "Service is enabled (starts on boot)"
141:     else
142:         test_result "WARN" "Service is not enabled (won't start on boot)"
143:     fi
144: 
145:     # Check if active
146:     if systemctl is-active --quiet prometheus; then
147:         test_result "PASS" "Service is active (running)"
148:     else
149:         test_result "FAIL" "Service is not running"
150:         echo "Check logs: journalctl -u prometheus -n 50"
151:         return 1
152:     fi
153: 
154:     # Check uptime
155:     local start_time
156:     start_time=$(systemctl show prometheus -p ActiveEnterTimestamp --value)
157:     if [[ -n "$start_time" ]]; then
158:         test_result "PASS" "Service started: $start_time"
159:     fi
160: 
161:     return 0
162: }
163: 
164: # Test 2: Web UI access
165: test_web_ui() {
166:     test_header "Web UI Access"
167: 
168:     # Check if web UI is accessible
169:     if curl -s --max-time 5 "http://localhost:${PROMETHEUS_PORT}/-/healthy" >/dev/null; then
170:         test_result "PASS" "Web UI is accessible"
171:     else
172:         test_result "FAIL" "Cannot access Web UI"
173:         return 1
174:     fi
175: 
176:     # Check health endpoint
177:     local health
178:     health=$(curl -s "http://localhost:${PROMETHEUS_PORT}/-/healthy")
179:     if echo "$health" | grep -q "Prometheus is Healthy"; then
180:         test_result "PASS" "Health check passed"
181:     else
182:         test_result "FAIL" "Health check failed: $health"
183:         return 1
184:     fi
185: 
186:     # Check ready endpoint
187:     if curl -s "http://localhost:${PROMETHEUS_PORT}/-/ready" | grep -q "Prometheus is Ready"; then
188:         test_result "PASS" "Prometheus is ready"
189:     else
190:         test_result "WARN" "Prometheus not ready yet"
191:     fi
192: 
193:     # Get version
194:     local version
195:     version=$(curl -s "http://localhost:${PROMETHEUS_PORT}/api/v1/status/buildinfo" | grep -o '"version":"[^"]*"' | cut -d'"' -f4)
196:     if [[ -n "$version" ]]; then
197:         test_result "PASS" "Prometheus version: $version"
198:     fi
199: 
200:     return 0
201: }
202: 
203: # Test 3: Configuration
204: test_configuration() {
205:     test_header "Configuration"
206: 
207:     # Check config file exists
208:     if [[ -f /etc/prometheus/prometheus.yml ]]; then
209:         test_result "PASS" "Configuration file exists"
210:     else
211:         test_result "FAIL" "Configuration file missing: /etc/prometheus/prometheus.yml"
212:         return 1
213:     fi
214: 
215:     # Check config is valid
216:     if promtool check config /etc/prometheus/prometheus.yml &>/dev/null; then
217:         test_result "PASS" "Configuration is valid"
218:     else
219:         test_result "FAIL" "Configuration has errors"
220:         echo "Run: promtool check config /etc/prometheus/prometheus.yml"
221:         return 1
222:     fi
223: 
224:     # Check for nftban job
225:     if grep -q "job_name.*nftban" /etc/prometheus/prometheus.yml; then
226:         test_result "PASS" "NFTBan scrape job configured"
227:     else
228:         test_result "FAIL" "NFTBan scrape job not found in config"
229:         return 1
230:     fi
231: 
232:     # Check scrape interval
233:     local scrape_interval
234:     scrape_interval=$(grep "scrape_interval" /etc/prometheus/prometheus.yml | head -1 | grep -o "[0-9]*s")
235:     if [[ -n "$scrape_interval" ]]; then
236:         test_result "PASS" "Scrape interval: $scrape_interval"
237:     fi
238: 
239:     return 0
240: }
241: 
242: # Test 4: Targets
243: test_targets() {
244:     test_header "Scrape Targets"
245: 
246:     # Get targets from API
247:     local targets_json
248:     targets_json=$(curl -s "http://localhost:${PROMETHEUS_PORT}/api/v1/targets")
249: 
250:     # Check if we can parse JSON (jq optional)
251:     if command -v jq &>/dev/null; then
252:         # Count active targets
253:         local active_targets
254:         active_targets=$(echo "$targets_json" | jq -r '.data.activeTargets | length')
255: 
256:         if [[ $active_targets -gt 0 ]]; then
257:             test_result "PASS" "$active_targets active target(s) found"
258:         else
259:             test_result "FAIL" "No active targets found"
260:             return 1
261:         fi
262: 
263:         # Check nftban target
264:         local nftban_health
265:         nftban_health=$(echo "$targets_json" | jq -r '.data.activeTargets[] | select(.labels.job=="nftban") | .health')
266: 
267:         if [[ "$nftban_health" == "up" ]]; then
268:             test_result "PASS" "NFTBan target is up"
269:         elif [[ "$nftban_health" == "down" ]]; then
270:             test_result "FAIL" "NFTBan target is down"
271:             return 1
272:         else
273:             test_result "WARN" "NFTBan target status unknown"
274:         fi
275: 
276:         # Get last scrape time
277:         local last_scrape
278:         last_scrape=$(echo "$targets_json" | jq -r '.data.activeTargets[] | select(.labels.job=="nftban") | .lastScrape')
279:         if [[ -n "$last_scrape" && "$last_scrape" != "null" ]]; then
280:             test_result "PASS" "Last scrape: $last_scrape"
281:         fi
282: 
283:     else
284:         # Fallback without jq
285:         if echo "$targets_json" | grep -q '"health":"up"'; then
286:             test_result "PASS" "At least one target is up"
287:         else
288:             test_result "WARN" "Cannot verify targets (jq not installed)"
289:         fi
290:     fi
291: 
292:     return 0
293: }
294: 
295: # Test 5: NFTBan metrics
296: test_nftban_metrics() {
297:     test_header "NFTBan Metrics Collection"
298: 
299:     # Wait a bit for metrics to be scraped
300:     sleep 2
301: 
302:     # Query for nftban metrics
303:     local query_result
304:     query_result=$(curl -s "http://localhost:${PROMETHEUS_PORT}/api/v1/query?query=nftban_blocks_total")
305: 
306:     if echo "$query_result" | grep -q '"status":"success"'; then
307:         test_result "PASS" "Successfully queried NFTBan metrics"
308:     else
309:         test_result "FAIL" "Failed to query NFTBan metrics"
310:         return 1
311:     fi
312: 
313:     # Check if data exists
314:     if echo "$query_result" | grep -q '"result":\[\]'; then
315:         test_result "WARN" "No data returned for nftban_blocks_total (may need to wait 60s for first scrape)"
316:     elif echo "$query_result" | grep -q '"value"'; then
317:         test_result "PASS" "NFTBan metrics data found"
318: 
319:         # Get the value if jq available
320:         if command -v jq &>/dev/null; then
321:             local blocks_total
322:             blocks_total=$(echo "$query_result" | jq -r '.data.result[0].value[1]')
323:             if [[ -n "$blocks_total" && "$blocks_total" != "null" ]]; then
324:                 test_result "PASS" "Current blocked IPs: $blocks_total"
325:             fi
326:         fi
327:     fi
328: 
329:     # Check for other key metrics
330:     local metrics_to_check=(
331:         "nftban_health_status"
332:         "nftban_exporter_duration_seconds"
333:         "nftban_last_update_timestamp"
334:     )
335: 
336:     for metric in "${metrics_to_check[@]}"; do
337:         if curl -s "http://localhost:${PROMETHEUS_PORT}/api/v1/query?query=${metric}" | grep -q '"status":"success"'; then
338:             test_result "PASS" "Metric available: $metric"
339:         else
340:             test_result "WARN" "Metric not available: $metric"
341:         fi
342:     done
343: 
344:     return 0
345: }
346: 
347: # Test 6: Alert rules
348: test_alert_rules() {
349:     test_header "Alert Rules"
350: 
351:     # Check if rules file exists
352:     if [[ -f /etc/prometheus/alerts/nftban-metrics.yml ]]; then
353:         test_result "PASS" "Alert rules file exists"
354:     else
355:         test_result "WARN" "Alert rules file not found"
356:         return 0
357:     fi
358: 
359:     # Validate rules file
360:     if promtool check rules /etc/prometheus/alerts/nftban-metrics.yml &>/dev/null; then
361:         test_result "PASS" "Alert rules are valid"
362:     else
363:         test_result "FAIL" "Alert rules have errors"
364:         echo "Run: promtool check rules /etc/prometheus/alerts/nftban-metrics.yml"
365:         return 1
366:     fi
367: 
368:     # Get loaded rules from API
369:     local rules_json
370:     rules_json=$(curl -s "http://localhost:${PROMETHEUS_PORT}/api/v1/rules")
371: 
372:     if echo "$rules_json" | grep -q "NFTBan"; then
373:         test_result "PASS" "NFTBan alert rules are loaded"
374:     else
375:         test_result "WARN" "NFTBan alert rules may not be loaded"
376:     fi
377: 
378:     # Count rules if jq available
379:     if command -v jq &>/dev/null; then
380:         local rule_count
381:         rule_count=$(echo "$rules_json" | jq -r '.data.groups[].rules | length' | awk '{s+=$1} END {print s}')
382:         if [[ -n "$rule_count" && "$rule_count" -gt 0 ]]; then
383:             test_result "PASS" "$rule_count alert rule(s) loaded"
384:         fi
385:     fi
386: 
387:     return 0
388: }
389: 
390: # Test 7: Storage
391: test_storage() {
392:     test_header "Storage & Retention"
393: 
394:     # Check data directory exists
395:     if [[ -d /var/lib/prometheus ]]; then
396:         test_result "PASS" "Data directory exists"
397:     else
398:         test_result "FAIL" "Data directory missing: /var/lib/prometheus"
399:         return 1
400:     fi
401: 
402:     # Check permissions
403:     local owner
404:     owner=$(stat -c "%U:%G" /var/lib/prometheus 2>/dev/null || stat -f "%Su:%Sg" /var/lib/prometheus 2>/dev/null)
405:     if [[ "$owner" == "prometheus:prometheus" ]]; then
406:         test_result "PASS" "Data directory ownership correct: $owner"
407:     else
408:         test_result "WARN" "Data directory ownership: $owner (expected prometheus:prometheus)"
409:     fi
410: 
411:     # Check disk usage
412:     local disk_usage
413:     disk_usage=$(du -sh /var/lib/prometheus 2>/dev/null | awk '{print $1}')
414:     if [[ -n "$disk_usage" ]]; then
415:         test_result "PASS" "Current storage usage: $disk_usage"
416:     fi
417: 
418:     # Check for TSDB
419:     if [[ -d /var/lib/prometheus/wal ]]; then
420:         test_result "PASS" "TSDB WAL directory found"
421:     else
422:         test_result "WARN" "TSDB WAL directory not found (may be new installation)"
423:     fi
424: 
425:     return 0
426: }
427: 
428: # Test 8: Security
429: test_security() {
430:     test_header "Security Configuration"
431: 
432:     # Check if running as root (bad)
433:     local pid
434:     pid=$(systemctl show prometheus -p MainPID --value)
435:     if [[ -n "$pid" && "$pid" != "0" ]]; then
436:         local user
437:         user=$(ps -o user= -p "$pid" 2>/dev/null || true)
438:         if [[ "$user" != "root" ]]; then
439:             test_result "PASS" "Running as non-root user: $user"
440:         else
441:             test_result "FAIL" "Running as root (security risk!)"
442:         fi
443:     fi
444: 
445:     # Check binding address
446:     if netstat -tulnp 2>/dev/null | grep ":${PROMETHEUS_PORT}" | grep -q "127.0.0.1"; then
447:         test_result "PASS" "Bound to localhost only (SECURE)"
448:     elif netstat -tulnp 2>/dev/null | grep ":${PROMETHEUS_PORT}" | grep -q "0.0.0.0"; then
449:         test_result "WARN" "Bound to all interfaces (consider localhost-only for security)"
450:     fi
451: 
452:     # Check for authentication
453:     if [[ -f /etc/prometheus/web.yml ]]; then
454:         test_result "PASS" "Web authentication config exists"
455:     else
456:         test_result "WARN" "No web authentication configured (consider adding for production)"
457:     fi
458: 
459:     # Check systemd security directives
460:     if systemctl cat prometheus | grep -q "PrivateTmp=yes"; then
461:         test_result "PASS" "PrivateTmp enabled"
462:     else
463:         test_result "WARN" "PrivateTmp not enabled"
464:     fi
465: 
466:     if systemctl cat prometheus | grep -q "ProtectSystem"; then
467:         test_result "PASS" "ProtectSystem enabled"
468:     else
469:         test_result "WARN" "ProtectSystem not enabled"
470:     fi
471: 
472:     return 0
473: }
474: 
475: # Print summary
476: print_summary() {
477:     echo ""
478:     print_color "$BLUE" "═══════════════════════════════════════════════════════════════"
479:     print_color "$BLUE" " Validation Summary"
480:     print_color "$BLUE" "═══════════════════════════════════════════════════════════════"
481:     echo ""
482: 
483:     print_color "$GREEN" "Passed:   $PASSED_TESTS/$TOTAL_TESTS tests"
484:     print_color "$RED" "Failed:   $FAILED_TESTS/$TOTAL_TESTS tests"
485:     print_color "$YELLOW" "Warnings: $WARNING_TESTS/$TOTAL_TESTS tests"
486: 
487:     echo ""
488: 
489:     if [[ $FAILED_TESTS -eq 0 ]]; then
490:         print_color "$GREEN" "✓ Prometheus validation PASSED"
491: 
492:         if [[ $WARNING_TESTS -gt 0 ]]; then
493:             print_color "$YELLOW" "⚠ Review warnings above for optimization opportunities"
494:         fi
495: 
496:         echo ""
497:         print_color "$BLUE" "═══════════════════════════════════════════════════════════════"
498:         echo "Prometheus is ready to collect NFTBan metrics!"
499:         echo ""
500:         echo "Web UI:    http://localhost:${PROMETHEUS_PORT}"
501:         echo "Targets:   http://localhost:${PROMETHEUS_PORT}/targets"
502:         echo "Graphs:    http://localhost:${PROMETHEUS_PORT}/graph"
503:         echo ""
504:         echo "Example queries:"
505:         echo "  nftban_blocks_total"
506:         echo "  rate(nftban_bans_total[5m])"
507:         echo "  nftban_health_status{component=\"nftables\"}"
508:         echo ""
509:         print_color "$BLUE" "═══════════════════════════════════════════════════════════════"
510: 
511:         return 0
512:     else
513:         print_color "$RED" "✗ Prometheus validation FAILED"
514:         echo ""
515:         echo "Review failed tests above and fix issues before continuing."
516:         echo ""
517:         print_color "$BLUE" "═══════════════════════════════════════════════════════════════"
518: 
519:         return 1
520:     fi
521: }
522: 
523: # =============================================================================
524: # MAIN
525: # =============================================================================
526: 
527: main() {
528:     # shellcheck disable=SC2034  # verbose reserved for future use
529:     local verbose=false
530:     local skip_metrics=false
531: 
532:     # Parse arguments
533:     while [[ $# -gt 0 ]]; do
534:         case "$1" in
535:             --verbose)
536:                 verbose=true
537:                 shift
538:                 ;;
539:             --skip-metrics)
540:                 skip_metrics=true
541:                 shift
542:                 ;;
543:             --help)
544:                 usage
545:                 exit 0
546:                 ;;
547:             *)
548:                 echo "Unknown option: $1"
549:                 usage
550:                 exit 1
551:                 ;;
552:         esac
553:     done
554: 
555:     print_color "$BLUE" "═══════════════════════════════════════════════════════════════"
556:     print_color "$BLUE" " NFTBan Prometheus Validation"
557:     print_color "$BLUE" "═══════════════════════════════════════════════════════════════"
558: 
559:     # Run tests
560:     test_service_status || true
561:     test_web_ui || true
562:     test_configuration || true
563:     test_targets || true
564: 
565:     if [[ "$skip_metrics" != "true" ]]; then
566:         test_nftban_metrics || true
567:     fi
568: 
569:     test_alert_rules || true
570:     test_storage || true
571:     test_security || true
572: 
573:     # Print summary
574:     print_summary
575: }
576: 
577: # Run main function
578: main "$@"
579: 

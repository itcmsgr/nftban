2451: nftban_health_fix_permissions() {
2452:     # Fix ALL permissions and ownership to match FHS specification
2453:     # Uses the new permissions enforcement module if available, otherwise legacy fix
2454:     # Smart about privileges: fixes what it can, reports what needs root
2455: 
2456:     local running_as_root=0
2457:     [[ $EUID -eq 0 ]] && running_as_root=1
2458: 
2459:     echo "Fixing permissions and ownership..."
2460: 
2461:     # Try to use new permissions enforcement module (more comprehensive)
2462:     if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_permissions.sh" ]]; then
2463:         if source "${NFTBAN_LIB_DIR}/core/nftban_permissions.sh" 2>/dev/null; then
2464:             # Log audit entry before fixing
2465:             if declare -f perms_log_audit >/dev/null 2>&1; then
2466:                 perms_log_audit "Health auto-fix: Starting permission enforcement"
2467:             fi
2468: 
2469:             echo "  Using enhanced permission enforcement module"
2470:             nftban_permissions_enforce_all
2471:             return $?
2472:         fi
2473:     fi
2474: 
2475:     # Fall back to legacy implementation
2476:     echo "  Using legacy permission fix"
2477: 
2478:     # Load canonical FHS specification
2479:     if ! declare -f nftban_fhs_load_spec >/dev/null 2>&1; then
2480:         source "${NFTBAN_LIB_DIR}/core/nftban_fhs_spec.sh" || {
2481:             echo "  ✖ ERROR: Failed to load FHS specification" >&2
2482:             return 1
2483:         }
2484:     fi
2485: 
2486:     # Ensure spec is loaded
2487:     if [[ ${#NFTBAN_FHS_DIRECTORIES[@]} -eq 0 ]]; then
2488:         nftban_fhs_load_spec
2489:     fi
2490: 
2491:     local fixed_count=0
2492:     local need_root_count=0
2493:     declare -a need_root_fixes=()
2494: 
2495:     for dir in "${!NFTBAN_FHS_DIRECTORIES[@]}"; do
2496:         if [[ -d "$dir" ]]; then
2497:             IFS='|' read -r expected_perms expected_owner expected_group _purpose <<< "${NFTBAN_FHS_DIRECTORIES[$dir]}"
2498: 
2499:             # Get current perms/owner/group
2500:             local current_perms
2501:             current_perms=$(stat -c "%a" "$dir" 2>/dev/null || echo "")
2502:             local current_owner
2503:             current_owner=$(stat -c "%U" "$dir" 2>/dev/null || echo "")
2504:             local current_group
2505:             current_group=$(stat -c "%G" "$dir" 2>/dev/null || echo "")
2506: 
2507:             local can_fix=0
2508:             local issues=()
2509: 
2510:             # Check if we own this directory (can fix permissions)
2511:             if [[ "$current_owner" == "nftban" ]] || [[ $running_as_root -eq 1 ]]; then
2512:                 can_fix=1
2513:             fi
2514: 
2515:             # Check permissions
2516:             if [[ "$current_perms" != "$expected_perms" ]]; then
2517:                 if [[ $can_fix -eq 1 ]]; then
2518:                     if chmod "$expected_perms" "$dir" 2>/dev/null; then
2519:                         issues+=("perms: $current_perms → $expected_perms")
2520:                     fi
2521:                 else
2522:                     need_root_fixes+=("$dir: chmod $expected_perms (currently $current_perms, owned by $current_owner)")
2523:                     ((need_root_count++))
2524:                 fi
2525:             fi
2526: 
2527:             # Check ownership
2528:             if [[ "$current_owner" != "$expected_owner" ]] || [[ "$current_group" != "$expected_group" ]]; then
2529:                 if [[ $running_as_root -eq 1 ]]; then
2530:                     # Verify user/group exists before changing
2531:                     if [[ "$expected_owner" == "nftban" ]] && ! id -u nftban >/dev/null 2>&1; then
2532:                         continue  # Skip if nftban user doesn't exist
2533:                     fi
2534:                     local target_group="$expected_group"
2535:                     if [[ "$expected_group" == "nftban" ]] && ! getent group nftban >/dev/null 2>&1; then
2536:                         target_group="$expected_owner"  # Fallback to owner
2537:                     fi
2538: 
2539:                     if chown "${expected_owner}:${target_group}" "$dir" 2>/dev/null; then
2540:                         issues+=("owner: $current_owner:$current_group → ${expected_owner}:${target_group}")
2541:                     fi
2542:                 else
2543:                     # Not root, can't change ownership
2544:                     need_root_fixes+=("$dir: chown ${expected_owner}:${expected_group} (currently $current_owner:$current_group)")
2545:                     ((need_root_count++))
2546:                 fi
2547:             fi
2548: 
2549:             # Report what we fixed
2550:             if [[ ${#issues[@]} -gt 0 ]]; then
2551:                 echo "  ✓ Fixed $dir → ${issues[*]}"
2552:                 : $((fixed_count++))
2553:             fi
2554:         fi
2555:     done
2556: 
2557:     # Fix system binaries (only if root)
2558:     if [[ $running_as_root -eq 1 ]]; then
2559:         # Fix /usr/sbin directory ownership (FHS compliance)
2560:         if [[ -d "/usr/sbin" ]]; then
2561:             local sbin_owner sbin_group
2562:             sbin_owner=$(stat -c '%U' /usr/sbin 2>/dev/null || echo "unknown")
2563:             sbin_group=$(stat -c '%G' /usr/sbin 2>/dev/null || echo "unknown")
2564: 
2565:             if [[ "$sbin_owner" != "root" ]] || [[ "$sbin_group" != "root" ]]; then
2566:                 chown root:root /usr/sbin 2>/dev/null && \
2567:                 chmod 755 /usr/sbin 2>/dev/null && \
2568:                 echo "  ✓ Fixed /usr/sbin directory ownership (was $sbin_owner:$sbin_group)" && \
2569:                 : $((fixed_count++))
2570:             fi
2571:         fi
2572: 
2573:         if [[ -f "/usr/sbin/nftban" ]]; then
2574:             chmod 755 /usr/sbin/nftban 2>/dev/null && \
2575:             chown root:root /usr/sbin/nftban 2>/dev/null && \
2576:             echo "  ✓ Fixed /usr/sbin/nftban binary" && \
2577:             : $((fixed_count++))
2578:         fi
2579: 
2580:         if [[ -f "${NFTBAN_LIB_DIR}/bin/nftban-geoip" ]]; then
2581:             chmod 755 "${NFTBAN_LIB_DIR}/bin/nftban-geoip" 2>/dev/null && \
2582:             chown root:root "${NFTBAN_LIB_DIR}/bin/nftban-geoip" 2>/dev/null && \
2583:             echo "  ✓ Fixed ${NFTBAN_LIB_DIR}/bin/nftban-geoip" && \
2584:             : $((fixed_count++))
2585:         fi
2586: 
2587:         # Recursively fix ownership for system libraries (both directories AND files)
2588:         if [[ -d "${NFTBAN_LIB_DIR}" ]]; then
2589:             # Fix directory ownership and permissions first
2590:             find "${NFTBAN_LIB_DIR}" -type d -exec chown root:root {} \; 2>/dev/null
2591:             find "${NFTBAN_LIB_DIR}" -type d -exec chmod 755 {} \; 2>/dev/null
2592: 
2593:             # Fix file ownership and permissions
2594:             find "${NFTBAN_LIB_DIR}" -type f -name "*.sh" -exec chown root:root {} \; 2>/dev/null
2595:             find "${NFTBAN_LIB_DIR}" -type f -name "*.sh" -exec chmod 644 {} \; 2>/dev/null
2596: 
2597:             # Fix binary permissions (if they exist)
2598:             find "${NFTBAN_LIB_DIR}/bin" -type f 2>/dev/null | while read -r binary; do
2599:                 chown root:root "$binary" 2>/dev/null
2600:                 chmod 755 "$binary" 2>/dev/null
2601:             done
2602: 
2603:             echo "  ✓ Fixed ${NFTBAN_LIB_DIR} directory and file ownership (root:root)"
2604:             : $((fixed_count++))
2605:         fi
2606: 
2607:         if [[ -d "/usr/share/nftban" ]]; then
2608:             chown -R root:root /usr/share/nftban 2>/dev/null && \
2609:             echo "  ✓ Fixed /usr/share/nftban ownership (root:root)" && \
2610:             : $((fixed_count++))
2611:         fi
2612: 
2613:         # Fix Suricata permissions for NFTBan integration
2614:         # Suricata writes to LOG_DIR/suricata/, nftban needs to read eve.json
2615:         if [[ -d "${NFTBAN_LOG_DIR}/suricata" ]]; then
2616:             local suricata_fixed=0
2617: 
2618:             # Add suricata user to nftban group (if not already)
2619:             if id suricata >/dev/null 2>&1; then
2620:                 if ! groups suricata 2>/dev/null | grep -q '\bnftban\b'; then
2621:                     usermod -aG nftban suricata 2>/dev/null && suricata_fixed=1
2622:                 fi
2623:             fi
2624: 
2625:             # Fix directory: suricata:nftban with group read
2626:             chgrp -R nftban "${NFTBAN_LOG_DIR}/suricata" 2>/dev/null
2627:             chmod 750 "${NFTBAN_LOG_DIR}/suricata" 2>/dev/null
2628: 
2629:             # Fix eve.json: suricata:nftban 640 so nftban can read
2630:             if [[ -f "${NFTBAN_LOG_DIR}/suricata/eve.json" ]]; then
2631:                 chown suricata:nftban "${NFTBAN_LOG_DIR}/suricata/eve.json" 2>/dev/null
2632:                 chmod 640 "${NFTBAN_LOG_DIR}/suricata/eve.json" 2>/dev/null
2633:                 suricata_fixed=1
2634:             fi
2635: 
2636:             # Fix suricata.log similarly
2637:             if [[ -f "${NFTBAN_LOG_DIR}/suricata/suricata.log" ]]; then
2638:                 chown suricata:nftban "${NFTBAN_LOG_DIR}/suricata/suricata.log" 2>/dev/null
2639:                 chmod 640 "${NFTBAN_LOG_DIR}/suricata/suricata.log" 2>/dev/null
2640:             fi
2641: 
2642:             if [[ $suricata_fixed -eq 1 ]]; then
2643:                 echo "  ✓ Fixed ${NFTBAN_LOG_DIR}/suricata permissions (suricata:nftban)"
2644:                 : $((fixed_count++))
2645:             fi
2646:         fi
2647:     fi
2648: 
2649:     if [[ $fixed_count -eq 0 ]] && [[ $need_root_count -eq 0 ]]; then
2650:         echo "  ✓ All permissions already correct"
2651:     fi
2652: 
2653:     # Report what needs root
2654:     if [[ $need_root_count -gt 0 ]]; then
2655:         echo ""
2656:         echo "  ⚠️  Cannot fix $need_root_count permission/ownership issues (need root privileges):"
2657:         for item in "${need_root_fixes[@]}"; do
2658:             echo "     - $item"
2659:         done
2660:         echo ""
2661:         echo "  💡 Run with root privileges to fix:"
2662:         echo "     sudo nftban health fix permissions"
2663:     fi
2664:     return 0
2665: }

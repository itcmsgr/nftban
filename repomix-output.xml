<file path="cli/lib/nftban/tests/test_distro_integration.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan Distro Config Integration Test
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Test parser module with distribution configs
  7: # Usage: ./test_distro_integration.sh [parser_path] [config_dir]
  8: #
  9: # Tests:
 10: # - Parser loading
 11: # - Config file detection
 12: # - Package name lookups
 13: # - Service name lookups
 14: # - Path lookups
 15: # - Function execution
 16: # =============================================================================
 17: 
 18: set -Eeuo pipefail
 19: 
 20: # Colors
 21: RED='\033[0;31m'
 22: GREEN='\033[0;32m'
 23: YELLOW='\033[1;33m'
 24: BLUE='\033[0;34m'
 25: NC='\033[0m'
 26: 
 27: # Configuration
 28: PARSER_PATH="${1:-../track1/nftban_distro_config.sh}"
 29: CONFIG_DIR="${2:-../track2}"
 30: TESTS_PASSED=0
 31: TESTS_FAILED=0
 32: TESTS_SKIPPED=0
 33: 
 34: # =============================================================================
 35: # TEST FRAMEWORK
 36: # =============================================================================
 37: 
 38: print_header() {
 39:     echo ""
 40:     echo "═══════════════════════════════════════════════════════════"
 41:     echo "  NFTBan Distro Config Integration Tests"
 42:     echo "═══════════════════════════════════════════════════════════"
 43:     echo ""
 44: }
 45: 
 46: print_summary() {
 47:     echo ""
 48:     echo "═══════════════════════════════════════════════════════════"
 49:     echo "  Test Results"
 50:     echo "═══════════════════════════════════════════════════════════"
 51:     echo ""
 52:     echo -e "${GREEN}✓ Passed: ${TESTS_PASSED}${NC}"
 53:     echo -e "${RED}✗ Failed: ${TESTS_FAILED}${NC}"
 54:     echo -e "${YELLOW}⊘ Skipped: ${TESTS_SKIPPED}${NC}"
 55:     echo ""
 56: 
 57:     local total=$((TESTS_PASSED + TESTS_FAILED + TESTS_SKIPPED))
 58:     local pass_rate=0
 59:     if [[ $total -gt 0 ]]; then
 60:         pass_rate=$((TESTS_PASSED * 100 / total))
 61:     fi
 62: 
 63:     echo "Pass rate: ${pass_rate}%"
 64:     echo ""
 65: 
 66:     if [[ $TESTS_FAILED -eq 0 ]]; then
 67:         echo -e "${GREEN}All tests passed!${NC}"
 68:         return 0
 69:     else
 70:         echo -e "${RED}${TESTS_FAILED} test(s) failed${NC}"
 71:         return 1
 72:     fi
 73: }
 74: 
 75: test_assert_equal() {
 76:     local expected="$1"
 77:     local actual="$2"
 78:     local test_name="$3"
 79: 

383:     cat <<EOF
384: {
385:   "master_enabled": $master_enabled,
386:   "services": {
387:     "nftables": {"config_enabled": $nft_config, "status": "$nft_status"},
388:     "suricata": {"config_enabled": $suri_config, "status": "$suri_status"},
389:     "login_monitor": {"config_enabled": $login_config, "status": "$login_status"}
390:   }

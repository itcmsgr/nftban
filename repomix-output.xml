  1: // =============================================================================
  2: // NFTBan v1.0 - Module Interface
  3: // =============================================================================
  4: // SPDX-License-Identifier: MPL-2.0
  5: // Package: module
  6: // Purpose: Defines the interface all nftban modules must implement
  7: //
  8: // Architecture:
  9: // - Each module is a self-contained unit
 10: // - Modules communicate via the event bus
 11: // - Modules have lifecycle: Init → Start → Stop
 12: // - Modules report their status on demand
 13: //
 14: // Example implementation:
 15: //
 16: //	type MyModule struct {
 17: //	    bus    *eventbus.Bus
 18: //	    cancel context.CancelFunc
 19: //	}
 20: //
 21: //	func (m *MyModule) Name() string { return "my-module" }
 22: //	func (m *MyModule) Init(bus *eventbus.Bus) error { m.bus = bus; return nil }
 23: //	func (m *MyModule) Start(ctx context.Context) error { ... }
 24: //	func (m *MyModule) Stop() error { m.cancel(); return nil }
 25: //	func (m *MyModule) Status() module.Status { ... }
 26: //
 27: // =============================================================================
 28: 
 29: package module
 30: 
 31: import (
 32: 	"context"
 33: 	"time"
 34: 
 35: 	"github.com/itcmsgr/nftban/pkg/eventbus"
 36: )
 37: 
 38: // Module is the interface all nftban modules must implement
 39: type Module interface {
 40: 	// Name returns the unique module identifier
 41: 	// Examples: "login-monitor", "suricata-watcher", "feeds-sync"
 42: 	Name() string
 43: 
 44: 	// Init initializes the module with the event bus
 45: 	// Called once before Start
 46: 	// Should set up internal state but NOT start background work
 47: 	Init(bus *eventbus.Bus) error
 48: 
 49: 	// Start begins the module's background work
 50: 	// Called after Init
 51: 	// Should spawn goroutines for continuous work
 52: 	// The context is cancelled when the daemon shuts down
 53: 	Start(ctx context.Context) error
 54: 
 55: 	// Stop gracefully shuts down the module
 56: 	// Called when daemon is stopping
 57: 	// Should clean up resources and wait for goroutines to finish
 58: 	Stop() error
 59: 
 60: 	// Status returns the current module status
 61: 	// Called on demand for health checks and API responses
 62: 	Status() Status
 63: }
 64: 
 65: // Status contains runtime status information for a module
 66: type Status struct {
 67: 	Name        string    `json:"name"`         // Module name
 68: 	Enabled     bool      `json:"enabled"`      // Whether module is enabled in config
 69: 	Running     bool      `json:"running"`      // Whether module is currently running
 70: 	Healthy     bool      `json:"healthy"`      // Whether module is functioning correctly
 71: 	LastRun     time.Time `json:"last_run"`     // Last time module performed its main task
 72: 	LastError   string    `json:"last_error"`   // Last error message (empty if none)
 73: 	ErrorCount  int       `json:"error_count"`  // Total errors since start
 74: 	EventCount  int64     `json:"event_count"`  // Total events processed
 75: 	StartTime   time.Time `json:"start_time"`   // When module was started
 76: 	Uptime      string    `json:"uptime"`       // Human-readable uptime
 77: 	Extra       ExtraInfo `json:"extra"`        // Module-specific status info
 78: }
 79: 
 80: // ExtraInfo holds module-specific status information
 81: type ExtraInfo map[string]any
 82: 
 83: // NewStatus creates a new Status with defaults
 84: func NewStatus(name string) Status {
 85: 	return Status{
 86: 		Name:    name,
 87: 		Enabled: true,
 88: 		Healthy: true,
 89: 		Extra:   make(ExtraInfo),
 90: 	}
 91: }
 92: 
 93: // MarkRunning updates status to indicate module is running
 94: func (s *Status) MarkRunning() {
 95: 	s.Running = true
 96: 	s.StartTime = time.Now()
 97: }
 98: 
 99: // MarkStopped updates status to indicate module is stopped
100: func (s *Status) MarkStopped() {
101: 	s.Running = false
102: }
103: 
104: // RecordError records an error
105: func (s *Status) RecordError(err error) {
106: 	s.ErrorCount++
107: 	if err != nil {
108: 		s.LastError = err.Error()
109: 		s.Healthy = false
110: 	}
111: }
112: 
113: // RecordEvent increments the event counter
114: func (s *Status) RecordEvent() {
115: 	s.EventCount++
116: 	s.LastRun = time.Now()
117: }
118: 
119: // ClearError clears the last error
120: func (s *Status) ClearError() {
121: 	s.LastError = ""
122: 	s.Healthy = true
123: }
124: 
125: // UpdateUptime calculates and updates the uptime string
126: func (s *Status) UpdateUptime() {
127: 	if s.StartTime.IsZero() || !s.Running {
128: 		s.Uptime = "-"
129: 		return
130: 	}
131: 	d := time.Since(s.StartTime)
132: 	s.Uptime = formatDuration(d)
133: }
134: 
135: // formatDuration creates a human-readable duration string
136: func formatDuration(d time.Duration) string {
137: 	if d < time.Minute {
138: 		return d.Round(time.Second).String()
139: 	}
140: 	if d < time.Hour {
141: 		return d.Round(time.Minute).String()
142: 	}
143: 	if d < 24*time.Hour {
144: 		h := d / time.Hour
145: 		m := (d % time.Hour) / time.Minute
146: 		return formatPlural(int(h), "hour") + " " + formatPlural(int(m), "min")
147: 	}
148: 	days := d / (24 * time.Hour)
149: 	hours := (d % (24 * time.Hour)) / time.Hour
150: 	return formatPlural(int(days), "day") + " " + formatPlural(int(hours), "hour")
151: }
152: 
153: func formatPlural(n int, unit string) string {
154: 	if n == 1 {
155: 		return "1 " + unit
156: 	}
157: 	return string(rune('0'+n%10)) + string(rune('0'+n/10%10))[1:] + " " + unit + "s"
158: }

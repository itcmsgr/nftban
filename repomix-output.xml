746: async function loadWhitelist() {
747:     const listEl = document.getElementById('whitelist-list');
748: 
749:     try {
750:         listEl.innerHTML = '<p class="text-center text-muted"><i class="fa fa-spinner fa-spin"></i> Loading...</p>';
751: 
752:         const response = await apiRequest('/whitelist');
753:         let data = response;
754:         if (data.data) data = data.data;
755: 
756:         // Combine ipv4 and ipv6 arrays
757:         const allIPs = [...(data.ipv4 || []), ...(data.ipv6 || [])];
758: 
759:         if (allIPs.length === 0) {
760:             listEl.innerHTML = '<p class="text-center text-muted">No whitelisted IPs</p>';
761:             return;
762:         }
763: 
764:         let html = '<table class="whitelist-table"><thead><tr><th>IP/CIDR</th><th>Type</th><th>Actions</th></tr></thead><tbody>';

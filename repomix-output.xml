<file path=".github/workflows/health.yml">
 1: ---
 2: name: Project Health
 3: 
 4: "on":
 5:   push:
 6:     branches: ["**"]  # run on all branches
 7:   pull_request:  # and on PRs
 8:   workflow_dispatch:  # manual trigger
 9:   schedule:
10:     - cron: "17 3 * * 1"  # weekly (Mon 03:17 UTC)
11: 
12: concurrency:
13:   group: ${{ github.workflow }}-${{ github.ref }}
14:   cancel-in-progress: true
15: 
16: permissions:
17:   contents: read  # default: read-only (security best practice)
18: 
19: jobs:
20:   health:
21:     runs-on: ubuntu-latest
22:     permissions:
23:       contents: write  # elevated only for auto-commit step
24:       security-events: write  # for secret scanning results
25: 
26:     steps:
27:       - name: Checkout
28:         uses: actions/checkout@v4
29:         with:
30:           fetch-depth: 0  # full clone not strictly needed, but safe
31:           persist-credentials: false  # security: don't persist token
32: 
33:       - name: Ensure health script is executable
34:         run: chmod +x .github/ci/health_check.sh
35: 
36:       - name: Set up Node.js (for jscpd / markdownlint-cli2)
37:         uses: actions/setup-node@v4
38:         with:
39:           node-version: '20'
40: 
41:       - name: Install linters & tools
42:         run: |
43:           sudo apt-get update
44:           sudo apt-get install -y shellcheck shfmt yamllint jq \
45:             devscripts nftables
46:           npm i -g markdownlint-cli2
47: 
48:       - name: Run health check
49:         run: .github/ci/health_check.sh
50: 
51:       - name: Secret scan with TruffleHog
52:         uses: trufflesecurity/trufflehog@v3.88.1
53:         with:
54:           base: >-
55:             ${{ github.event_name == 'pull_request' &&
56:             github.event.pull_request.base.sha || '' }}
57:           head: ${{ github.sha }}
58:           extra_args: --only-verified
59: 
60:       - name: Upload STATUS.md as artifact
61:         uses: actions/upload-artifact@v4
62:         with:
63:           name: project-status
64:           path: STATUS.md
65:           if-no-files-found: error
66:           retention-days: 7
67: 
68:       # Optional: commit STATUS.md changes back to main
69:       # (keeps README link always fresh)
70:       - name: Auto-commit STATUS.md (main branch only)
71:         if: >-
72:           github.event_name == 'push' &&
73:           github.ref == 'refs/heads/main'
74:         run: |
75:           if ! git diff --quiet -- STATUS.md; then
76:             # Re-authenticate for push (persist-credentials: false above)
77:             git config user.name "github-actions[bot]"
78:             git config user.email \
79:               "41898282+github-actions[bot]@users.noreply.github.com"
80:             git add STATUS.md
81:             git commit -m "chore: update STATUS.md [skip ci]"
82:             # Use GITHUB_TOKEN for push
83:             REPO_URL="https://x-access-token:${{ secrets.GITHUB_TOKEN }}"
84:             REPO_URL="${REPO_URL}@github.com/${{ github.repository }}.git"
85:             git push "${REPO_URL}" HEAD:main
86:           fi
</file>

<file path=".github/workflows/release.yml">
  1: # =============================================================================
  2: # NFTBan v1.0.0 - GitHub Actions Release Workflow
  3: # =============================================================================
  4: # SPDX-License-Identifier: MPL-2.0
  5: # Purpose: Automated package building and release on version tags
  6: # Triggers: Push to v* tags (e.g., v1.0.0, v1.0.1)
  7: #
  8: # What this does:
  9: #   1. Builds Go binaries (nftban-core, nftban-api-server) for x86_64
 10: #   2. Creates RPM packages for EL9, EL10, Fedora 42, Fedora 43
 11: #   3. Creates DEB packages for Ubuntu 22.04/24.04, Debian 12
 12: #   4. Generates SHA256SUMS for all artifacts
 13: #   5. Creates distro-specific package names (nftban-el9-x86_64.rpm, etc.)
 14: #   6. Creates MANIFEST.txt (file inventory)
 15: #   7. Uploads everything to GitHub Release
 16: # =============================================================================
 17: 
 18: name: Release Packages
 19: 
 20: on:
 21:   push:
 22:     tags:
 23:       - "v*"
 24: 
 25: permissions:
 26:   contents: write  # Required to create/edit GitHub Releases
 27: 
 28: jobs:
 29:   # ==========================================================================
 30:   # BUILD GO BINARIES
 31:   # ==========================================================================
 32:   build-binaries:
 33:     name: Build Go binaries
 34:     runs-on: ubuntu-latest
 35:     steps:
 36:       - name: Checkout code
 37:         uses: actions/checkout@v4
 38:         with:
 39:           fetch-depth: 0
 40: 
 41:       - name: Set up Go
 42:         uses: actions/setup-go@v5
 43:         with:
 44:           go-version: '1.21'
 45: 
 46:       - name: Build binaries
 47:         run: |
 48:           chmod +x build.sh
 49:           ./build.sh
 50:           ls -la bin/
 51: 
 52:       - name: Upload binaries
 53:         uses: actions/upload-artifact@v4
 54:         with:
 55:           name: go-binaries
 56:           path: bin/
 57:           retention-days: 1
 58: 
 59:   # ==========================================================================
 60:   # BUILD RPM PACKAGES
 61:   # ==========================================================================
 62:   build-rpm:
 63:     name: Build RPM (${{ matrix.distro }})
 64:     needs: build-binaries
 65:     runs-on: ubuntu-latest
 66:     strategy:
 67:       fail-fast: false
 68:       matrix:
 69:         include:
 70:           - distro: el9
 71:             container: rockylinux:9
 72:             name_suffix: el9
 73:           - distro: el10
 74:             container: almalinux:10
 75:             name_suffix: el10
 76:           - distro: fc42
 77:             container: fedora:42
 78:             name_suffix: fc42
 79:           - distro: fc43
 80:             container: fedora:43
 81:             name_suffix: fc43
 82: 
 83:     steps:
 84:       - name: Checkout code
 85:         uses: actions/checkout@v4
 86: 
 87:       - name: Download binaries
 88:         uses: actions/download-artifact@v4
 89:         with:
 90:           name: go-binaries
 91:           path: bin/
 92: 
 93:       - name: Build RPM in ${{ matrix.distro }} container
 94:         run: |
 95:           chmod +x bin/*
 96:           docker run --rm -v "$(pwd):/workspace" -w /workspace ${{ matrix.container }} bash -c "
 97:             # Install build dependencies
 98:             dnf -y install rpm-build rpmdevtools tar gzip systemd-rpm-macros make
 99: 
100:             # Build RPM
101:             chmod +x packaging/build_nftban.sh
102:             cd packaging
103:             ./build_nftban.sh rpm
104: 
105:             # Fix permissions
106:             chmod -R a+rX /workspace/build/
107:           "
108: 
109:       - name: Rename RPM with distro suffix
110:         run: |
111:           mkdir -p dist/packages
112:           for rpm in build/packages/RPMS/*/*.rpm; do
113:             if [[ -f "$rpm" ]]; then
114:               # Create distro-specific name: nftban-el9-x86_64.rpm
115:               cp "$rpm" "dist/packages/nftban-${{ matrix.name_suffix }}-x86_64.rpm"
116:             fi
117:           done
118:           ls -la dist/packages/
119: 
120:       - name: Upload RPM packages (${{ matrix.distro }})
121:         uses: actions/upload-artifact@v4
122:         with:
123:           name: rpm-${{ matrix.distro }}
124:           path: dist/packages/*.rpm
125:           retention-days: 30
126: 
127:   # ==========================================================================
128:   # BUILD DEB PACKAGES
129:   # ==========================================================================
130:   build-deb:
131:     name: Build DEB (${{ matrix.distro }})
132:     needs: build-binaries
133:     runs-on: ubuntu-latest
134:     strategy:
135:       fail-fast: false
136:       matrix:
137:         include:
138:           - distro: ubuntu22.04
139:             container: ubuntu:22.04
140:             name_suffix: ubuntu22.04
141:           - distro: ubuntu24.04
142:             container: ubuntu:24.04
143:             name_suffix: ubuntu24.04
144:           - distro: debian12
145:             container: debian:12
146:             name_suffix: debian12
147: 
148:     steps:
149:       - name: Checkout code
150:         uses: actions/checkout@v4
151: 
152:       - name: Download binaries
153:         uses: actions/download-artifact@v4
154:         with:
155:           name: go-binaries
156:           path: bin/
157: 
158:       - name: Build DEB in ${{ matrix.distro }} container
159:         run: |
160:           chmod +x bin/*
161:           docker run --rm -v "$(pwd):/workspace" -w /workspace ${{ matrix.container }} bash -c "
162:             # Install build dependencies
163:             apt-get update
164:             apt-get install -y dpkg-dev build-essential
165: 
166:             # Build DEB
167:             chmod +x packaging/build_nftban.sh
168:             cd packaging
169:             ./build_nftban.sh deb
170: 
171:             # Fix permissions
172:             chmod -R a+rX /workspace/build/
173:           "
174: 
175:       - name: Rename DEB with distro suffix
176:         run: |
177:           mkdir -p dist/packages
178:           for deb in build/packages/*.deb; do
179:             if [[ -f "$deb" ]]; then
180:               # Create distro-specific name: nftban-ubuntu22.04-amd64.deb
181:               cp "$deb" "dist/packages/nftban-${{ matrix.name_suffix }}-amd64.deb"
182:             fi
183:           done
184:           ls -la dist/packages/
185: 
186:       - name: Upload DEB packages (${{ matrix.distro }})
187:         uses: actions/upload-artifact@v4
188:         with:
189:           name: deb-${{ matrix.distro }}
190:           path: dist/packages/*.deb
191:           retention-days: 30
192: 
193:   # ==========================================================================
194:   # CREATE RELEASE
195:   # ==========================================================================
196:   create-release:
197:     name: Create GitHub Release
198:     needs: [build-rpm, build-deb]
199:     runs-on: ubuntu-latest
200:     steps:
201:       - name: Checkout code
202:         uses: actions/checkout@v4
203: 
204:       - name: Download all artifacts
205:         uses: actions/download-artifact@v4
206:         with:
207:           path: all-packages/
208: 
209:       - name: Consolidate packages
210:         run: |
211:           mkdir -p dist/packages
212: 
213:           # Copy all RPM packages
214:           find all-packages -name "*.rpm" -exec cp {} dist/packages/ \;
215: 
216:           # Copy all DEB packages
217:           find all-packages -name "*.deb" -exec cp {} dist/packages/ \;
218: 
219:           echo "=== All packages ==="
220:           ls -lh dist/packages/
221: 
222:       - name: Generate SHA256SUMS
223:         run: |
224:           cd dist/packages
225:           rm -f SHA256SUMS
226: 
227:           # Generate checksums for all packages
228:           shopt -s nullglob
229:           packages=(*.rpm *.deb)
230:           if [ ${#packages[@]} -gt 0 ]; then
231:             sha256sum "${packages[@]}" | sort > SHA256SUMS
232:             echo "=== SHA256SUMS ==="
233:             cat SHA256SUMS
234:           else
235:             echo "WARNING: No packages found"
236:             touch SHA256SUMS
237:           fi
238: 
239:       - name: Generate MANIFEST.txt
240:         run: |
241:           cd dist/packages
242:           VERSION="${GITHUB_REF#refs/tags/}"
243: 
244:           cat > MANIFEST.txt << MANIFEST_EOF
245:           NFTBan ${VERSION} - Release Artifacts
246:           ===================================
247: 
248:           RPM Packages (EL Family + Fedora):
249:             nftban-el9-x86_64.rpm      Rocky / Alma / RHEL / CentOS Stream 9
250:             nftban-el10-x86_64.rpm     Rocky / Alma / RHEL / CentOS Stream 10
251:             nftban-fc42-x86_64.rpm     Fedora 42
252:             nftban-fc43-x86_64.rpm     Fedora 43
253: 
254:           DEB Packages (Ubuntu + Debian):
255:             nftban-ubuntu22.04-amd64.deb   Ubuntu 22.04 (Jammy)
256:             nftban-ubuntu24.04-amd64.deb   Ubuntu 24.04 (Noble)
257:             nftban-debian12-amd64.deb      Debian 12 (Bookworm)
258: 
259:           Package Sizes:
260:           MANIFEST_EOF
261: 
262:           # Remove leading spaces from heredoc
263:           sed -i 's/^          //' MANIFEST.txt
264: 
265:           for file in *.rpm *.deb; do
266:             if [ -f "$file" ]; then
267:               size=$(stat -c%s "$file" 2>/dev/null || stat -f%z "$file" 2>/dev/null || echo "0")
268:               printf "  %-35s %12d bytes\n" "$file" "$size" >> MANIFEST.txt
269:             fi
270:           done
271: 
272:           echo "=== MANIFEST.txt ==="
273:           cat MANIFEST.txt
274: 
275:       - name: Create VERIFY.txt
276:         run: |
277:           cd dist/packages
278:           VERSION="${GITHUB_REF#refs/tags/}"
279: 
280:           cat > VERIFY.txt << 'VERIFY_EOF'
281:           NFTBan - Package Verification & Installation Guide
282:           ===================================================
283: 
284:           1. Download the package for your distribution:
285: 
286:              # Rocky / Alma / RHEL / CentOS Stream 9
287:              wget https://github.com/itcmsgr/nftban/releases/latest/download/nftban-el9-x86_64.rpm
288: 
289:              # Rocky / Alma / RHEL / CentOS Stream 10
290:              wget https://github.com/itcmsgr/nftban/releases/latest/download/nftban-el10-x86_64.rpm
291: 
292:              # Fedora 42
293:              wget https://github.com/itcmsgr/nftban/releases/latest/download/nftban-fc42-x86_64.rpm
294: 
295:              # Fedora 43
296:              wget https://github.com/itcmsgr/nftban/releases/latest/download/nftban-fc43-x86_64.rpm
297: 
298:              # Ubuntu 22.04
299:              wget https://github.com/itcmsgr/nftban/releases/latest/download/nftban-ubuntu22.04-amd64.deb
300: 
301:              # Ubuntu 24.04
302:              wget https://github.com/itcmsgr/nftban/releases/latest/download/nftban-ubuntu24.04-amd64.deb
303: 
304:              # Debian 12
305:              wget https://github.com/itcmsgr/nftban/releases/latest/download/nftban-debian12-amd64.deb
306: 
307:           2. Verify package integrity:
308: 
309:              wget https://github.com/itcmsgr/nftban/releases/latest/download/SHA256SUMS
310:              sha256sum -c SHA256SUMS --ignore-missing
311: 
312:           3. Install package:
313: 
314:              # Rocky / Alma / Fedora / RHEL
315:              sudo dnf install -y nftban-<distro>-x86_64.rpm
316: 
317:              # Ubuntu / Debian
318:              sudo dpkg -i nftban-<distro>-amd64.deb
319:              sudo apt-get install -f -y
320: 
321:           4. Enable and verify:
322: 
323:              sudo nftban enable
324:              nftban --version
325:              nftban health summary
326: 
327:           Documentation: https://github.com/itcmsgr/nftban#readme
328:           VERIFY_EOF
329: 
330:           # Remove leading spaces from heredoc
331:           sed -i 's/^          //' VERIFY.txt
332: 
333:       - name: Extract release notes
334:         run: |
335:           VERSION="${GITHUB_REF#refs/tags/}"
336: 
337:           if [ -f "CHANGELOG.md" ]; then
338:             awk "/^## \[${VERSION}\]/,/^## \[/" CHANGELOG.md | \
339:               sed '/^## \[/d' | head -n -1 > dist/packages/RELEASE_NOTES.md || \
340:               echo "Release ${VERSION}" > dist/packages/RELEASE_NOTES.md
341:           else
342:             echo "Release ${VERSION}" > dist/packages/RELEASE_NOTES.md
343:           fi
344: 
345:           # Add package list to release notes
346:           cat >> dist/packages/RELEASE_NOTES.md << 'NOTES_EOF'
347: 
348:           ## Available Packages
349: 
350:           ### RPM (x86_64)
351:           | Distribution | Package |
352:           |--------------|---------|
353:           | Rocky / Alma / RHEL / CentOS Stream 9 | `nftban-el9-x86_64.rpm` |
354:           | Rocky / Alma / RHEL / CentOS Stream 10 | `nftban-el10-x86_64.rpm` |
355:           | Fedora 42 | `nftban-fc42-x86_64.rpm` |
356:           | Fedora 43 | `nftban-fc43-x86_64.rpm` |
357: 
358:           ### DEB (amd64)
359:           | Distribution | Package |
360:           |--------------|---------|
361:           | Ubuntu 22.04 (Jammy) | `nftban-ubuntu22.04-amd64.deb` |
362:           | Ubuntu 24.04 (Noble) | `nftban-ubuntu24.04-amd64.deb` |
363:           | Debian 12 (Bookworm) | `nftban-debian12-amd64.deb` |
364:           NOTES_EOF
365: 
366:           # Remove leading spaces from heredoc
367:           sed -i 's/^          //' dist/packages/RELEASE_NOTES.md
368: 
369:           echo "=== RELEASE_NOTES.md ==="
370:           cat dist/packages/RELEASE_NOTES.md
371: 
372:       - name: Upload to GitHub Release
373:         uses: softprops/action-gh-release@v2
374:         with:
375:           files: |
376:             dist/packages/*.rpm
377:             dist/packages/*.deb
378:             dist/packages/SHA256SUMS
379:             dist/packages/MANIFEST.txt
380:             dist/packages/VERIFY.txt
381:           body_path: dist/packages/RELEASE_NOTES.md
382:           draft: false
383:           prerelease: false
384:         env:
385:           GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
</file>

<file path=".github/workflows/secure-go.yml">
  1: name: Secure Go
  2: 
  3: on:
  4:   push:
  5:     branches: [ main, master, develop ]
  6:   pull_request:
  7: 
  8: permissions:
  9:   contents: read
 10:   security-events: write   # needed to upload SARIF
 11:   actions: read
 12: 
 13: jobs:
 14:   filter:
 15:     name: Detect Go changes
 16:     runs-on: ubuntu-latest
 17:     outputs:
 18:       go_changed: ${{ steps.filter.outputs.go }}
 19:     steps:
 20:       - uses: actions/checkout@v4
 21:       - id: filter
 22:         uses: dorny/paths-filter@v3
 23:         with:
 24:           filters: |
 25:             go:
 26:               - '**/*.go'
 27:               - 'go.mod'
 28:               - 'go.sum'
 29:               - 'cmd/**'
 30:               - 'pkg/**'
 31: 
 32:   analyze:
 33:     name: Build, Test, Scan (Go)
 34:     needs: filter
 35:     if: needs.filter.outputs.go_changed == 'true'
 36:     runs-on: ubuntu-latest
 37: 
 38:     steps:
 39:       - name: Checkout
 40:         uses: actions/checkout@v4
 41: 
 42:       - name: Set up Go
 43:         uses: actions/setup-go@v5
 44:         with:
 45:           go-version: '1.21'
 46: 
 47:       - name: Install build dependencies
 48:         run: sudo apt-get update && sudo apt-get install -y libpam0g-dev
 49: 
 50:       - name: Cache Go build
 51:         uses: actions/cache@v4
 52:         with:
 53:           path: |
 54:             ~/go/pkg/mod
 55:             ~/.cache/go-build
 56:           key: ${{ runner.os }}-go-${{ hashFiles('**/go.sum') }}
 57:           restore-keys: ${{ runner.os }}-go-
 58: 
 59:       - name: Verify modules tidy
 60:         run: |
 61:           go mod tidy
 62:           git diff --exit-code || (echo "::error ::Run 'go mod tidy' locally and commit changes" && exit 1)
 63: 
 64:       - name: Build
 65:         run: go build ./...
 66: 
 67:       - name: Unit tests (race + coverage)
 68:         run: go test -race -cover -v ./...
 69: 
 70:       # ---- Staticcheck: Go code quality ----
 71:       - name: Install staticcheck
 72:         run: go install honnef.co/go/tools/cmd/staticcheck@latest
 73: 
 74:       - name: Run staticcheck
 75:         run: $(go env GOPATH)/bin/staticcheck ./...
 76: 
 77:       # ---- Gosec: security lint with SARIF upload ----
 78:       - name: Install gosec
 79:         run: go install github.com/securego/gosec/v2/cmd/gosec@latest
 80: 
 81:       - name: Run gosec (SARIF)
 82:         run: $(go env GOPATH)/bin/gosec -fmt sarif -out gosec.sarif ./... || true
 83: 
 84:       - name: Upload gosec SARIF
 85:         uses: github/codeql-action/upload-sarif@v3
 86:         with:
 87:           sarif_file: gosec.sarif
 88:           category: gosec
 89: 
 90:       # ---- govulncheck: vulnerability intelligence with SARIF ----
 91:       - name: Install govulncheck
 92:         run: go install golang.org/x/vuln/cmd/govulncheck@latest
 93: 
 94:       - name: Run govulncheck (JSON)
 95:         run: $(go env GOPATH)/bin/govulncheck -json ./... > govulncheck.json || true
 96: 
 97:       - name: Convert govulncheck to SARIF
 98:         run: |
 99:           python3 << 'PY'
100:           import json
101:           import sys
102: 
103:           try:
104:               with open('govulncheck.json', 'r') as f:
105:                   findings = [json.loads(line) for line in f if line.strip()]
106: 
107:               results = []
108:               for finding in findings:
109:                   if finding.get('finding'):
110:                       vuln = finding['finding']
111:                       osv = vuln.get('osv', {})
112:                       results.append({
113:                           "ruleId": osv.get('id', 'UNKNOWN'),
114:                           "message": {"text": osv.get('summary', 'Vulnerability detected')},
115:                           "level": "warning",
116:                           "locations": [{
117:                               "physicalLocation": {
118:                                   "artifactLocation": {"uri": "go.mod"},
119:                                   "region": {"startLine": 1, "startColumn": 1}
120:                               }
121:                           }]
122:                       })
123: 
124:               sarif = {
125:                   "version": "2.1.0",
126:                   "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
127:                   "runs": [{
128:                       "tool": {
129:                           "driver": {
130:                               "name": "govulncheck",
131:                               "informationUri": "https://golang.org/x/vuln/cmd/govulncheck",
132:                               "version": "latest"
133:                           }
134:                       },
135:                       "results": results
136:                   }]
137:               }
138: 
139:               with open('govulncheck.sarif', 'w') as f:
140:                   json.dump(sarif, f, indent=2)
141:           except Exception as e:
142:               print(f"Error converting govulncheck to SARIF: {e}", file=sys.stderr)
143:               # Create empty SARIF if conversion fails
144:               sarif = {
145:                   "version": "2.1.0",
146:                   "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
147:                   "runs": [{
148:                       "tool": {
149:                           "driver": {
150:                               "name": "govulncheck",
151:                               "informationUri": "https://golang.org/x/vuln/cmd/govulncheck",
152:                               "version": "latest"
153:                           }
154:                       },
155:                       "results": []
156:                   }]
157:               }
158:               with open('govulncheck.sarif', 'w') as f:
159:                   json.dump(sarif, f, indent=2)
160:           PY
161: 
162:       - name: Upload govulncheck SARIF
163:         uses: github/codeql-action/upload-sarif@v3
164:         with:
165:           sarif_file: govulncheck.sarif
166:           category: govulncheck
167: 
168:       # ---- Generate security summary ----
169:       - name: Generate security summary
170:         if: always()
171:         run: |
172:           echo "## Go Security Scan Results" >> $GITHUB_STEP_SUMMARY
173:           echo "" >> $GITHUB_STEP_SUMMARY
174:           echo "### Tools Run" >> $GITHUB_STEP_SUMMARY
175:           echo "- ✅ **staticcheck**: Go code quality and bug detection" >> $GITHUB_STEP_SUMMARY
176:           echo "- ✅ **gosec**: Security vulnerability scanner" >> $GITHUB_STEP_SUMMARY
177:           echo "- ✅ **govulncheck**: Go vulnerability database scanner" >> $GITHUB_STEP_SUMMARY
178:           echo "" >> $GITHUB_STEP_SUMMARY
179:           echo "### Results" >> $GITHUB_STEP_SUMMARY
180:           echo "Check the Security → Code scanning alerts tab for detailed findings." >> $GITHUB_STEP_SUMMARY
181:           echo "" >> $GITHUB_STEP_SUMMARY
182:           echo "### Verification" >> $GITHUB_STEP_SUMMARY
183:           echo "All Go code has been analyzed for:" >> $GITHUB_STEP_SUMMARY
184:           echo "- Known CVEs in dependencies (govulncheck)" >> $GITHUB_STEP_SUMMARY
185:           echo "- Insecure coding patterns (gosec)" >> $GITHUB_STEP_SUMMARY
186:           echo "- Code quality issues (staticcheck)" >> $GITHUB_STEP_SUMMARY
187:           echo "- Race conditions (go test -race)" >> $GITHUB_STEP_SUMMARY
</file>

<file path=".github/workflows/shellcheck.yml">
  1: name: ShellCheck
  2: 
  3: on:
  4:   push:
  5:     branches:
  6:       - main
  7:       - master
  8:       - develop
  9:   pull_request:
 10:     branches:
 11:       - main
 12:       - master
 13: 
 14: jobs:
 15:   shellcheck:
 16:     name: ShellCheck - Find bash errors
 17:     runs-on: ubuntu-latest
 18: 
 19:     steps:
 20:       - name: Checkout code
 21:         uses: actions/checkout@v4
 22: 
 23:       - name: Run ShellCheck on all shell scripts
 24:         uses: ludeeus/action-shellcheck@master
 25:         with:
 26:           scandir: '.'
 27:           severity: error
 28:           ignore_paths: |
 29:             node_modules
 30:             .git
 31:             build
 32:           ignore_names: |
 33:             .husky
 34:           format: gcc
 35: 
 36:       - name: ShellCheck report
 37:         if: always()
 38:         run: |
 39:           echo "## ShellCheck Results" >> $GITHUB_STEP_SUMMARY
 40:           echo "" >> $GITHUB_STEP_SUMMARY
 41:           echo "All shell scripts checked for common errors:" >> $GITHUB_STEP_SUMMARY
 42:           echo "- Syntax errors" >> $GITHUB_STEP_SUMMARY
 43:           echo "- Undefined variables" >> $GITHUB_STEP_SUMMARY
 44:           echo "- Quoting issues" >> $GITHUB_STEP_SUMMARY
 45:           echo "- Deprecated syntax" >> $GITHUB_STEP_SUMMARY
 46:           echo "- Security vulnerabilities" >> $GITHUB_STEP_SUMMARY
 47: 
 48:   detailed-shellcheck:
 49:     name: Detailed ShellCheck - Core scripts
 50:     runs-on: ubuntu-latest
 51: 
 52:     steps:
 53:       - name: Checkout code
 54:         uses: actions/checkout@v4
 55: 
 56:       - name: Install ShellCheck
 57:         run: |
 58:           sudo apt-get update
 59:           sudo apt-get install -y shellcheck
 60: 
 61:       - name: Check CLI scripts
 62:         run: |
 63:           echo "Checking CLI scripts..."
 64:           find cli/lib/nftban/cli -name "*.sh" -type f -exec shellcheck -x -S warning {} + || true
 65: 
 66:       - name: Check Core scripts
 67:         run: |
 68:           echo "Checking Core scripts..."
 69:           find cli/lib/nftban/core -name "*.sh" -type f -exec shellcheck -x -S warning {} + || true
 70: 
 71:       - name: Check Library scripts
 72:         run: |
 73:           echo "Checking Library scripts..."
 74:           find cli/lib/nftban/lib -name "*.sh" -type f -exec shellcheck -x -S warning {} + || true
 75: 
 76:       - name: Check Setup scripts
 77:         run: |
 78:           echo "Checking Setup scripts..."
 79:           find cli/lib/nftban/setup -name "*.sh" -type f -exec shellcheck -x -S warning {} + || true
 80: 
 81:       - name: Check Install scripts
 82:         run: |
 83:           echo "Checking Install scripts..."
 84:           find install -name "*.sh" -type f -exec shellcheck -x -S warning {} + || true
 85: 
 86:       - name: Check main build script
 87:         run: |
 88:           echo "Checking build.sh..."
 89:           shellcheck -x -S warning build.sh || true
 90: 
 91:       - name: Check install script
 92:         run: |
 93:           echo "Checking install.sh..."
 94:           shellcheck -x -S warning install.sh || true
 95: 
 96:       - name: Check packaging scripts
 97:         run: |
 98:           echo "Checking packaging scripts..."
 99:           find packaging -name "*.sh" -type f -exec shellcheck -x -S warning {} + || true
100: 
101:       - name: Generate report
102:         if: always()
103:         run: |
104:           echo "## Detailed ShellCheck Analysis" >> $GITHUB_STEP_SUMMARY
105:           echo "" >> $GITHUB_STEP_SUMMARY
106:           echo "Checked directories:" >> $GITHUB_STEP_SUMMARY
107:           echo "- cli/lib/nftban/cli/ ($(find cli/lib/nftban/cli -name '*.sh' | wc -l) scripts)" >> $GITHUB_STEP_SUMMARY
108:           echo "- cli/lib/nftban/core/ ($(find cli/lib/nftban/core -name '*.sh' | wc -l) scripts)" >> $GITHUB_STEP_SUMMARY
109:           echo "- cli/lib/nftban/lib/ ($(find cli/lib/nftban/lib -name '*.sh' | wc -l) scripts)" >> $GITHUB_STEP_SUMMARY
110:           echo "- cli/lib/nftban/setup/ ($(find cli/lib/nftban/setup -name '*.sh' | wc -l) scripts)" >> $GITHUB_STEP_SUMMARY
111:           echo "- install/ ($(find install -name '*.sh' | wc -l) scripts)" >> $GITHUB_STEP_SUMMARY
112:           echo "- packaging/ ($(find packaging -name '*.sh' | wc -l) scripts)" >> $GITHUB_STEP_SUMMARY
</file>

<file path=".github/workflows/slsa-go-releaser.yml">
  1: # =============================================================================
  2: # NFTBan v1.0.0 - SLSA Level 3 Go Builder
  3: # =============================================================================
  4: # SPDX-License-Identifier: MPL-2.0
  5: # Purpose: Build Go binaries with SLSA Level 3 compliance and provenance
  6: # Triggers: Published releases OR manual dispatch
  7: #
  8: # This workflow uses OpenSSF's SLSA Go builder instead of manual go build.
  9: # Benefits:
 10: #   - Isolated, hermetic build environment
 11: #   - Signed provenance (.intoto.jsonl files)
 12: #   - Cryptographically verifiable artifacts
 13: #   - SLSA Level 3 compliance (high security standard)
 14: #
 15: # Builds:
 16: #   - nftban-core (main CLI for firewall operations)
 17: #   - nftban-ui (web GUI server)
 18: #   - nftban-ui-auth (PAM authentication daemon)
 19: # =============================================================================
 20: 
 21: name: SLSA Go Releaser
 22: 
 23: on:
 24:   release:
 25:     types: [published]
 26:   workflow_dispatch:
 27:     inputs:
 28:       version:
 29:         description: 'Version tag (e.g., v1.0.0)'
 30:         required: true
 31:         default: 'v1.0.0'
 32: 
 33: permissions:
 34:   contents: write      # To upload release assets
 35:   id-token: write      # For SLSA provenance signing
 36:   actions: read        # To read workflow
 37: 
 38: jobs:
 39:   # ============================================================================
 40:   # Job 1: Build nftban-core with SLSA provenance
 41:   # ============================================================================
 42:   build-nftban-core:
 43:     name: Build nftban-core (SLSA3)
 44:     permissions:
 45:       id-token: write
 46:       contents: write
 47:       actions: read
 48:     uses: slsa-framework/slsa-github-generator/.github/workflows/builder_go_slsa3.yml@v2.0.0
 49:     with:
 50:       go-version: "1.22"
 51:       # Config file specifies build parameters
 52:       config-file: .github/slsa/nftban-core.yml
 53:       evaluated-envs: "VERSION:${{ github.ref_name }}"
 54: 
 55:   # ============================================================================
 56:   # Job 2: Build nftban-ui with SLSA provenance
 57:   # ============================================================================
 58:   build-nftban-ui:
 59:     name: Build nftban-ui (SLSA3)
 60:     permissions:
 61:       id-token: write
 62:       contents: write
 63:       actions: read
 64:     uses: slsa-framework/slsa-github-generator/.github/workflows/builder_go_slsa3.yml@v2.0.0
 65:     with:
 66:       go-version: "1.22"
 67:       config-file: .github/slsa/nftban-ui.yml
 68:       evaluated-envs: "VERSION:${{ github.ref_name }}"
 69: 
 70:   # ============================================================================
 71:   # Job 3: Build nftban-ui-auth with SLSA provenance
 72:   # ============================================================================
 73:   build-nftban-ui-auth:
 74:     name: Build nftban-ui-auth (SLSA3)
 75:     permissions:
 76:       id-token: write
 77:       contents: write
 78:       actions: read
 79:     uses: slsa-framework/slsa-github-generator/.github/workflows/builder_go_slsa3.yml@v2.0.0
 80:     with:
 81:       go-version: "1.22"
 82:       config-file: .github/slsa/nftban-ui-auth.yml
 83:       evaluated-envs: "VERSION:${{ github.ref_name }}"
 84: 
 85:   # ============================================================================
 86:   # Job 4: Assemble all artifacts and upload to release
 87:   # ============================================================================
 88:   assemble-release:
 89:     name: Assemble Release Artifacts
 90:     needs: [build-nftban-core, build-nftban-ui, build-nftban-ui-auth]
 91:     runs-on: ubuntu-latest
 92:     if: github.event_name == 'release'
 93: 
 94:     steps:
 95:       - name: Download nftban-core artifacts
 96:         uses: actions/download-artifact@v4
 97:         with:
 98:           name: ${{ needs.build-nftban-core.outputs.go-binary-name }}
 99:           path: dist/
100: 
101:       - name: Download nftban-core provenance
102:         uses: actions/download-artifact@v4
103:         with:
104:           name: ${{ needs.build-nftban-core.outputs.go-provenance-name }}
105:           path: dist/
106: 
107:       - name: Download nftban-ui artifacts
108:         uses: actions/download-artifact@v4
109:         with:
110:           name: ${{ needs.build-nftban-ui.outputs.go-binary-name }}
111:           path: dist/
112: 
113:       - name: Download nftban-ui provenance
114:         uses: actions/download-artifact@v4
115:         with:
116:           name: ${{ needs.build-nftban-ui.outputs.go-provenance-name }}
117:           path: dist/
118: 
119:       - name: Download nftban-ui-auth artifacts
120:         uses: actions/download-artifact@v4
121:         with:
122:           name: ${{ needs.build-nftban-ui-auth.outputs.go-binary-name }}
123:           path: dist/
124: 
125:       - name: Download nftban-ui-auth provenance
126:         uses: actions/download-artifact@v4
127:         with:
128:           name: ${{ needs.build-nftban-ui-auth.outputs.go-provenance-name }}
129:           path: dist/
130: 
131:       - name: List artifacts
132:         run: ls -la dist/
133: 
134:       - name: Generate SHA256SUMS
135:         working-directory: dist
136:         run: |
137:           rm -f SHA256SUMS
138:           for f in nftban-*; do
139:             [ -f "$f" ] && sha256sum "$f" >> SHA256SUMS
140:           done
141:           cat SHA256SUMS
142: 
143:       - name: Upload to GitHub Release
144:         uses: softprops/action-gh-release@v2
145:         with:
146:           files: |
147:             dist/nftban-*
148:             dist/*.intoto.jsonl
149:             dist/SHA256SUMS
150:         env:
151:           GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
152: 
153:       - name: Generate SLSA Summary
154:         run: |
155:           echo "## SLSA Level 3 Build Complete" >> $GITHUB_STEP_SUMMARY
156:           echo "" >> $GITHUB_STEP_SUMMARY
157:           echo "### Artifacts Built" >> $GITHUB_STEP_SUMMARY
158:           echo "| Binary | Architecture | Provenance |" >> $GITHUB_STEP_SUMMARY
159:           echo "|--------|--------------|------------|" >> $GITHUB_STEP_SUMMARY
160:           for f in dist/nftban-*; do
161:             if [[ ! "$f" =~ \.intoto\.jsonl$ ]] && [[ ! "$f" =~ SHA256SUMS$ ]]; then
162:               basename=$(basename "$f")
163:               provenance="${basename}.intoto.jsonl"
164:               if [ -f "dist/$provenance" ]; then
165:                 echo "| $basename | linux | ✅ Signed |" >> $GITHUB_STEP_SUMMARY
166:               else
167:                 echo "| $basename | linux | ❌ Missing |" >> $GITHUB_STEP_SUMMARY
168:               fi
169:             fi
170:           done
171:           echo "" >> $GITHUB_STEP_SUMMARY
172:           echo "### Verification" >> $GITHUB_STEP_SUMMARY
173:           echo "Users can verify provenance using:" >> $GITHUB_STEP_SUMMARY
174:           echo '```bash' >> $GITHUB_STEP_SUMMARY
175:           echo 'slsa-verifier verify-artifact nftban-core-linux-amd64 \' >> $GITHUB_STEP_SUMMARY
176:           echo '  --provenance-path nftban-core-linux-amd64.intoto.jsonl \' >> $GITHUB_STEP_SUMMARY
177:           echo '  --source-uri github.com/itcmsgr/nftban' >> $GITHUB_STEP_SUMMARY
178:           echo '```' >> $GITHUB_STEP_SUMMARY
</file>

<file path=".github/BUG_REPORTING_GUIDE.md">
  1: # 🐛 How to Report Bugs in NFTBan
  2: 
  3: Thank you for helping improve NFTBan! This guide will help you submit effective bug reports.
  4: 
  5: ---
  6: 
  7: ## 📍 Where to Report Bugs
  8: 
  9: We have **two channels** for bug reports:
 10: 
 11: ### 1. 🔴 GitHub Issues (For Confirmed Bugs)
 12: 
 13: **Use GitHub Issues when:**
 14: - You've confirmed it's actually a bug (not a configuration issue)
 15: - You can provide reproduction steps
 16: - You've checked it's not already reported
 17: 
 18: **Create an issue:** https://github.com/itcmsgr/nftban/issues/new/choose
 19: 
 20: ### 2. 💬 GitHub Discussions (For Questions/Help)
 21: 
 22: **Use Discussions when:**
 23: - You're not sure if it's a bug or configuration issue
 24: - You need help troubleshooting
 25: - You want community input first
 26: 
 27: **Start a discussion:** https://github.com/itcmsgr/nftban/discussions/categories/q-a
 28: 
 29: ---
 30: 
 31: ## ✅ Before You Report
 32: 
 33: **Check these first:**
 34: 
 35: 1. **Search existing issues:** https://github.com/itcmsgr/nftban/issues
 36:    - Your bug might already be reported
 37:    - You can add your +1 or additional info
 38: 
 39: 2. **Search discussions:** https://github.com/itcmsgr/nftban/discussions
 40:    - Others might have found a workaround
 41: 
 42: 3. **Check the documentation:**
 43:    - README: https://github.com/itcmsgr/nftban#readme
 44:    - Man page: `man nftban`
 45:    - Docs: https://github.com/itcmsgr/nftban/tree/main/docs
 46: 
 47: 4. **Run health check:**
 48:    ```bash
 49:    nftban health check --auto-heal
 50:    ```
 51:    - This fixes common issues automatically
 52: 
 53: ---
 54: 
 55: ## 📝 What Makes a Good Bug Report
 56: 
 57: ### Required Information
 58: 
 59: When creating an issue, please include:
 60: 
 61: #### 1. Environment
 62: ```bash
 63: # Run this command and paste output:
 64: nftban health check --json > health-report.json
 65: cat health-report.json
 66: 
 67: # Also include:
 68: cat /etc/os-release
 69: uname -a
 70: nftban --version
 71: ```
 72: 
 73: #### 2. Bug Description
 74: - **What happened?** (actual behavior)
 75: - **What did you expect?** (expected behavior)
 76: - **When did it start?** (after update? fresh install?)
 77: 
 78: #### 3. Reproduction Steps
 79: ```
 80: Step-by-step instructions:
 81: 1. Run command X
 82: 2. Do action Y
 83: 3. Observe error Z
 84: ```
 85: 
 86: #### 4. Logs
 87: ```bash
 88: # Get recent logs
 89: sudo journalctl -u nftban-main.service -n 100 --no-pager
 90: 
 91: # Or specific error logs
 92: sudo tail -100 /var/log/nftban/nftban.log
 93: ```
 94: 
 95: #### 5. Configuration
 96: ```bash
 97: # Show your config (redact sensitive info!)
 98: cat /etc/nftban/nftban.conf
 99: ```
100: 
101: ---
102: 
103: ## 🎯 Bug Report Template
104: 
105: Use this template when creating an issue:
106: 
107: ```markdown
108: ## Environment
109: 
110: - **OS:** (Rocky 9 / Ubuntu 24.04 / etc)
111: - **NFTBan Version:** (run `nftban --version`)
112: - **Architecture:** (x86_64 / aarch64)
113: - **Installation Method:** (RPM / DEB / from source)
114: 
115: ## Bug Description
116: 
117: **What happened:**
118: 
119: 
120: **What I expected:**
121: 
122: 
123: ## Reproduction Steps
124: 
125: 1.
126: 2.
127: 3.
128: 
129: ## Logs
130: 
131: <details>
132: <summary>Click to expand logs</summary>
133: 
134: \`\`\`
135: Paste logs here
136: \`\`\`
137: 
138: </details>
139: 
140: ## Configuration
141: 
142: <details>
143: <summary>Click to expand config</summary>
144: 
145: \`\`\`bash
146: Paste config here (redact secrets!)
147: \`\`\`
148: 
149: </details>
150: 
151: ## Additional Context
152: 
153: (Screenshots, network setup, etc.)
154: ```
155: 
156: ---
157: 
158: ## 🚨 Critical/Security Bugs
159: 
160: **For security vulnerabilities:**
161: 
162: **DO NOT** create a public issue!
163: 
164: Instead:
165: 1. Email: contact@nftban.com
166: 2. Subject: "SECURITY: NFTBan Vulnerability Report"
167: 3. Include:
168:    - Vulnerability description
169:    - Impact assessment
170:    - Proof of concept (if applicable)
171:    - Your contact info
172: 
173: We'll respond within 48 hours.
174: 
175: See: https://github.com/itcmsgr/nftban/blob/main/SECURITY.md
176: 
177: ---
178: 
179: ## 🏷️ Issue Labels
180: 
181: When creating an issue, select the appropriate template:
182: 
183: | Label | When to Use |
184: |-------|-------------|
185: | 🐛 **Bug Report** | Something isn't working correctly |
186: | ⚡ **Performance** | Slow performance or resource issues |
187: | 📦 **Package/Install** | RPM/DEB installation problems |
188: | 🔒 **Security** | Security-related issues |
189: | 📚 **Documentation** | Docs are wrong or unclear |
190: | 💡 **Enhancement** | Feature request or improvement |
191: 
192: ---
193: 
194: ## 💬 Getting Help
195: 
196: **Not sure if it's a bug?** Ask in Discussions first!
197: 
198: - **Q&A:** https://github.com/itcmsgr/nftban/discussions/categories/q-a
199: - **Ideas:** https://github.com/itcmsgr/nftban/discussions/categories/ideas
200: - **General:** https://github.com/itcmsgr/nftban/discussions/categories/general
201: 
202: ---
203: 
204: ## ⚡ Common Issues & Solutions
205: 
206: ### Issue: "Permission denied"
207: ```bash
208: # Add yourself to nftban group (v1.0 uses unified group for CLI + Web GUI)
209: sudo usermod -aG nftban $USER
210: 
211: # Re-login for changes to take effect
212: exit
213: # SSH back in
214: ```
215: 
216: ### Issue: "Service not found"
217: ```bash
218: # Reload systemd
219: sudo systemctl daemon-reload
220: 
221: # Check if service exists
222: systemctl list-unit-files | grep nftban
223: ```
224: 
225: ### Issue: "nftables ruleset not found"
226: ```bash
227: # Run initial setup
228: sudo nftban system setup
229: 
230: # Verify nftables
231: sudo nft list ruleset
232: ```
233: 
234: ### Issue: "Go binary not found"
235: ```bash
236: # Check binary location
237: ls -la /usr/lib/nftban/bin/.real/
238: 
239: # Check wrapper scripts
240: ls -la /usr/lib/nftban/bin/
241: 
242: # Verify architecture
243: uname -m
244: ```
245: 
246: ---
247: 
248: ## 📊 After You Report
249: 
250: **What happens next:**
251: 
252: 1. **Triage** - Maintainers review within 24-48 hours
253: 2. **Labels** - Issue gets labeled for tracking
254: 3. **Response** - Maintainers may ask for more info
255: 4. **Fix** - If confirmed, bug gets fixed in next release
256: 5. **Notification** - You'll be notified when fixed
257: 
258: **You can help by:**

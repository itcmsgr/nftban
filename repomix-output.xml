504: // downloadTrustFeed downloads a trust feed and returns IP count
505: func downloadTrustFeed(tf TrustConfig, outputFile string) (int, error) {
506: 	client := &http.Client{
507: 		Timeout: 60 * time.Second,
508: 	}
509: 
510: 	var allIPs []string
511: 
512: 	// Download main URL

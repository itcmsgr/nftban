306:     cat > "$json_report" <<EOF
307: {
308:   "timestamp": "$(date -u '+%Y-%m-%dT%H:%M:%SZ')",
309:   "summary": {
310:     "total": $TESTS_TOTAL,
311:     "passed": $TESTS_PASSED,
312:     "failed": $TESTS_FAILED,
313:     "timeout": $TESTS_TIMEOUT,
314:     "no_output": $TESTS_NO_OUTPUT,
315:     "pass_rate": $pass_rate
316:   },
317:   "log_file": "$TEST_LOG"
318: }
319: EOF
320:     echo "JSON report: $json_report"
321:     echo ""
322: 
323:     # Exit with error if any tests failed
324:     if [[ $TESTS_FAILED -gt 0 ]] || [[ $TESTS_TIMEOUT -gt 0 ]]; then
325:         echo -e "${RED}❌ SOME TESTS FAILED${NC}"
326:         return 1
327:     else
328:         echo -e "${GREEN}✅ ALL TESTS PASSED${NC}"
329:         return 0
330:     fi
331: }
332: 
333: # =============================================================================

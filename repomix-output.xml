740: nftban_module_generate_html_report() {
741:     # Generate HTML report from module data
742:     # Returns: Path to generated HTML file
743: 
744:     local template_path="${NFTBAN_TEMPLATE_DIR:-/usr/share/nftban/templates}/reports/module_report.html"
745:     local report_dir="${NFTBAN_REPORT_DIR:-/var/lib/nftban/reports}"
746:     local timestamp
747:     timestamp=$(date +%Y%m%d_%H%M%S)
748:     local report_file="${report_dir}/module_report_${timestamp}.html"
749: 
750:     # Ensure report directory exists
751:     mkdir -p "$report_dir" 2>/dev/null || true
752: 
753:     # Check if template exists
754:     if [[ ! -f "$template_path" ]]; then
755:         echo "ERROR: Template not found: $template_path" >&2
756:         return 1
757:     fi
758: 
759:     # Scan modules if not already scanned
760:     if [[ ${#NFTBAN_MODULE_INVENTORY[@]} -eq 0 ]]; then
761:         nftban_module_scan
762:     fi
763: 
764:     # Calculate statistics
765:     local total_modules=${#NFTBAN_MODULE_INVENTORY[@]}
766:     local enabled_modules=0
767:     local disabled_modules=0
768:     local core_modules=0
769: 
770:     for module_path in "${!NFTBAN_MODULE_INVENTORY[@]}"; do
771:         local info="${NFTBAN_MODULE_INVENTORY[$module_path]}"
772:         IFS='|' read -r name version type status created depends owner <<< "$info"
773: 
774:         [[ "$status" == "ENABLED" ]] && enabled_modules=$((enabled_modules + 1)) || disabled_modules=$((disabled_modules + 1))
775:         [[ "$type" == "core" ]] && core_modules=$((core_modules + 1)) || true
776:     done
777: 
778:     # Generate HTML table rows
779:     local table_rows=""
780:     for module_path in $(printf '%s\n' "${!NFTBAN_MODULE_INVENTORY[@]}" | sort); do
781:         local info="${NFTBAN_MODULE_INVENTORY[$module_path]}"
782:         IFS='|' read -r name version type status created depends owner <<< "$info"

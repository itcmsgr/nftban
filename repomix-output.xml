139: 
140:             printf "%3d. %-4s %-25s %-12s (%s)\n" "$feed_num" "$status_icon" "${feed:0:25}" "${size:-~? IPs}" "${interval:-DAILY}"
141:             printf "      └─ %s\n" "$description"
142:             echo ""
143:         done
144:     done
145: 
146:     echo "════════════════════════════════════════════════════════════════════"
147:     echo ""
148:     echo "SELECTION OPTIONS:"
149:     echo "  • Enter number(s):  1 3 6        (enable feeds 1, 3, and 6)"
150:     echo "  • Range:            1-5          (enable feeds 1 through 5)"
151:     echo "  • Category:         ssh          (enable all SSH feeds)"
152:     echo "  • Multiple:         1,3,ssh      (enable 1, 3, and all SSH)"
153:     echo "  • All:              all          (enable ALL feeds)"
154:     echo "  • Quit:             q            (exit without changes)"
155:     echo ""
156: 
157:     # Show current status
158:     local stats
159:     stats=$(nftban_feeds_get_stats)
160:     echo "Current status: $stats"
161:     echo ""
162: 
163:     # Read user selection
164:     echo -n "Select feeds to enable: "
165:     read -r selection
166: 
167:     # Handle quit
168:     if [[ "$selection" == "q" ]] || [[ "$selection" == "Q" ]]; then
169:         echo "Exited without changes."
170:         return 0
171:     fi
172: 
173:     # Process selection
174:     local feeds_to_enable=()
175: 
176:     # Handle "all"
177:     if [[ "$selection" == "all" ]]; then
178:         feeds_to_enable=("${feed_array[@]}")
179:     # Handle category
180:     elif [[ "$selection" =~ ^(protection|ssh|web|email)$ ]]; then
181:         local cat_feeds
182:         cat_feeds=$(nftban_feeds_get_by_category "$selection")
183:         for feed in $cat_feeds; do
184:             feeds_to_enable+=("$feed")
185:         done
186:     else
187:         # Parse numbers, ranges, and comma-separated
188:         # Split by comma first
189:         IFS=',' read -ra parts <<< "$selection"
190: 
191:         for part in "${parts[@]}"; do
192:             part=$(echo "$part" | xargs)  # trim whitespace
193: 
194:             # Check if category
195:             if [[ "$part" =~ ^(protection|ssh|web|email)$ ]]; then
196:                 local cat_feeds
197:                 cat_feeds=$(nftban_feeds_get_by_category "$part")
198:                 for feed in $cat_feeds; do
199:                     feeds_to_enable+=("$feed")
200:                 done
201:             # Check if range (e.g., 1-5)
202:             elif [[ "$part" =~ ^([0-9]+)-([0-9]+)$ ]]; then
203:                 local start="${BASH_REMATCH[1]}"
204:                 local end="${BASH_REMATCH[2]}"
205: 
206:                 for ((i=start; i<=end; i++)); do
207:                     if [[ -n "${feed_array[$i]:-}" ]]; then
208:                         feeds_to_enable+=("${feed_array[$i]}")
209:                     fi
210:                 done
211:             # Single number
212:             elif [[ "$part" =~ ^[0-9]+$ ]]; then
213:                 if [[ -n "${feed_array[$part]:-}" ]]; then
214:                     feeds_to_enable+=("${feed_array[$part]}")
215:                 fi
216:             fi
217:         done
218:     fi
219: 
220:     # Deduplicate
221:     local unique_feeds=()
222:     mapfile -t unique_feeds < <(printf '%s\n' "${feeds_to_enable[@]}" | sort -u)
223: 
224:     if [[ ${#unique_feeds[@]} -eq 0 ]]; then
225:         echo "No feeds selected."
226:         return 0

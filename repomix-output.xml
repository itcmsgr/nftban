 20: // NetworkStats represents network bandwidth statistics
 21: type NetworkStats struct {
 22: 	Timestamp     time.Time              `json:"timestamp"`
 23: 	Interfaces    []InterfaceStats       `json:"interfaces"`
 24: 	Total         InterfaceStats         `json:"total"`
 25: 	RecentSamples []metrics.Sample       `json:"recent_samples,omitempty"`
 26: }
 27: 
 28: // InterfaceStats represents stats for a single network interface
 29: type InterfaceStats struct {
 30: 	Name          string  `json:"name"`
 31: 	RxBytes       uint64  `json:"rx_bytes"`
 32: 	TxBytes       uint64  `json:"tx_bytes"`
 33: 	RxPackets     uint64  `json:"rx_packets"`
 34: 	TxPackets     uint64  `json:"tx_packets"`
 35: 	RxMbps        float64 `json:"rx_mbps,omitempty"`
 36: 	TxMbps        float64 `json:"tx_mbps,omitempty"`
 37: }
 38: 
 39: // Connection represents a network connection from ss output
 40: type Connection struct {
 41: 	State       string  `json:"state"`
 42: 	LocalAddr   string  `json:"local_addr"`
 43: 	LocalPort   string  `json:"local_port"`
 44: 	PeerAddr    string  `json:"peer_addr"`
 45: 	PeerPort    string  `json:"peer_port"`
 46: 	Timer       string  `json:"timer,omitempty"`        // Timer name (keepalive, on, off, etc.)
 47: 	TimerValue  string  `json:"timer_value,omitempty"`  // Timer value (e.g., "30sec")
 48: 	Protocol    string  `json:"protocol"`
 49: 	RecvQ       int     `json:"recv_q"`       // Receive queue size
 50: 	SendQ       int     `json:"send_q"`       // Send queue size
 51: 	UID         string  `json:"uid,omitempty"` // User ID (if available)
 52: 	ProcessInfo string  `json:"process,omitempty"` // Process info (if available)
 53: }
 54: 
 55: // ConnectionStats represents connection statistics
 56: type ConnectionStats struct {
 57: 	Timestamp   time.Time    `json:"timestamp"`
 58: 	Total       int          `json:"total"`
 59: 	ByState     map[string]int `json:"by_state"`
 60: 	ByProtocol  map[string]int `json:"by_protocol"`
 61: 	Connections []Connection `json:"connections,omitempty"`
 62: }
 63: 
 64: // BandwidthHandler returns current bandwidth statistics
 65: // GET /api/network/bandwidth
 66: func BandwidthHandler(w http.ResponseWriter, r *http.Request) {
 67: 	// Get samples parameter
 68: 	samplesStr := r.URL.Query().Get("samples")
 69: 	includeSamples := samplesStr != ""
 70: 
 71: 	var sampleCount int
 72: 	if samplesStr != "" {
 73: 		if count, err := strconv.Atoi(samplesStr); err == nil && count > 0 {
 74: 			sampleCount = count
 75: 		} else {
 76: 			sampleCount = 60 // Default to last 60 samples (10 minutes at 10s interval)
 77: 		}
 78: 	}
 79: 
 80: 	stats, err := getNetworkStats(includeSamples, sampleCount)
 81: 	if err != nil {
 82: 		log.Printf("[API] Failed to get network stats: %v", err)
 83: 		respondJSON(w, http.StatusInternalServerError, ErrorResponse{
 84: 			Error: "Failed to get network statistics",
 85: 		})
 86: 		return
 87: 	}
 88: 
 89: 	respondJSON(w, http.StatusOK, stats)
 90: }
 91: 
 92: // ConnectionsHandler returns current network connections
 93: // GET /api/network/connections?protocol=tcp&limit=100
 94: func ConnectionsHandler(w http.ResponseWriter, r *http.Request) {
 95: 	protocol := r.URL.Query().Get("protocol")
 96: 	if protocol == "" {
 97: 		protocol = "tcp" // Default to TCP
 98: 	}
 99: 
100: 	limitStr := r.URL.Query().Get("limit")
101: 	limit := 100 // Default limit
102: 	if limitStr != "" {
103: 		if l, err := strconv.Atoi(limitStr); err == nil && l > 0 {
104: 			limit = l
105: 		}
106: 	}
107: 
108: 	stats, err := getConnectionStats(protocol, limit)
109: 	if err != nil {
110: 		log.Printf("[API] Failed to get connection stats: %v", err)
111: 		respondJSON(w, http.StatusInternalServerError, ErrorResponse{
112: 			Error: "Failed to get connection statistics",
113: 		})
114: 		return
115: 	}
116: 
117: 	respondJSON(w, http.StatusOK, stats)
118: }
119: 
120: // getNetworkStats reads /proc/net/dev and returns current statistics
121: func getNetworkStats(includeSamples bool, sampleCount int) (*NetworkStats, error) {
122: 	cmd := exec.Command("cat", "/proc/net/dev")
123: 	output, err := cmd.Output()
124: 	if err != nil {
125: 		return nil, err
126: 	}
127: 
128: 	stats := &NetworkStats{
129: 		Timestamp:  time.Now(),
130: 		Interfaces: []InterfaceStats{},
131: 		Total:      InterfaceStats{Name: "total"},
132: 	}
133: 
134: 	scanner := bufio.NewScanner(strings.NewReader(string(output)))
135: 
136: 	// Skip first two header lines
137: 	scanner.Scan()
138: 	scanner.Scan()
139: 
140: 	for scanner.Scan() {
141: 		line := scanner.Text()
142: 		fields := strings.Fields(line)
143: 		if len(fields) < 10 {
144: 			continue
145: 		}
146: 
147: 		// Parse interface name
148: 		iface := strings.TrimSuffix(fields[0], ":")
149: 
150: 		// Parse RX stats
151: 		rxBytes, _ := strconv.ParseUint(fields[1], 10, 64)
152: 		rxPackets, _ := strconv.ParseUint(fields[2], 10, 64)
153: 
154: 		// Parse TX stats
155: 		txBytes, _ := strconv.ParseUint(fields[9], 10, 64)
156: 		txPackets, _ := strconv.ParseUint(fields[10], 10, 64)
157: 
158: 		ifaceStats := InterfaceStats{
159: 			Name:      iface,
160: 			RxBytes:   rxBytes,
161: 			TxBytes:   txBytes,
162: 			RxPackets: rxPackets,
163: 			TxPackets: txPackets,
164: 		}
165: 
166: 		stats.Interfaces = append(stats.Interfaces, ifaceStats)
167: 
168: 		// Skip loopback for totals
169: 		if iface != "lo" {
170: 			stats.Total.RxBytes += rxBytes
171: 			stats.Total.TxBytes += txBytes
172: 			stats.Total.RxPackets += rxPackets
173: 			stats.Total.TxPackets += txPackets
174: 		}
175: 	}
176: 
177: 	// Add recent samples from metrics sampler if requested
178: 	if includeSamples {
179: 		sampler := metrics.GetSampler()
180: 		samples := sampler.GetRecentSamples(sampleCount)
181: 		stats.RecentSamples = samples
182: 
183: 		// Calculate current rates from most recent sample
184: 		if len(samples) > 0 {
185: 			lastSample := samples[len(samples)-1]
186: 			stats.Total.RxMbps = lastSample.NetworkRxMbps
187: 			stats.Total.TxMbps = lastSample.NetworkTxMbps
188: 		}
189: 	}
190: 
191: 	return stats, nil
192: }
193: 
194: // getConnectionStats uses ss command to get connection statistics
195: // Optimized with -o flag to include timer information
196: func getConnectionStats(protocol string, limit int) (*ConnectionStats, error) {
197: 	// Build ss command based on protocol
198: 	// -t: TCP, -u: UDP, -a: all states, -n: numeric, -o: show timer info
199: 	// Using -o flag speeds up parsing and includes timer values directly
200: 	var cmd *exec.Cmd
201: 	switch protocol {
202: 	case "tcp":
203: 		cmd = exec.Command("ss", "-tano")
204: 	case "udp":
205: 		cmd = exec.Command("ss", "-uano")
206: 	case "all":
207: 		cmd = exec.Command("ss", "-tuano")
208: 	default:
209: 		cmd = exec.Command("ss", "-tano")
210: 	}
211: 
212: 	output, err := cmd.Output()
213: 	if err != nil {
214: 		return nil, err
215: 	}
216: 
217: 	stats := &ConnectionStats{
218: 		Timestamp:   time.Now(),
219: 		ByState:     make(map[string]int),
220: 		ByProtocol:  make(map[string]int),
221: 		Connections: make([]Connection, 0, limit), // Pre-allocate capacity
222: 	}
223: 
224: 	scanner := bufio.NewScanner(strings.NewReader(string(output)))
225: 
226: 	// Skip header line
227: 	scanner.Scan()
228: 
229: 	connectionCount := 0
230: 	for scanner.Scan() && connectionCount < limit {
231: 		line := scanner.Text()
232: 		fields := strings.Fields(line)
233: 		if len(fields) < 5 {
234: 			continue
235: 		}
236: 
237: 		// Parse connection
238: 		// Format with -o flag:
239: 		// State Recv-Q Send-Q Local_Address:Port Peer_Address:Port timer:(name,value,retransmissions)
240: 		// Example: ESTAB 0 0 192.168.1.100:22 192.168.1.1:54321 timer:(keepalive,30sec,0)
241: 
242: 		conn := Connection{
243: 			State:    fields[0],
244: 			Protocol: "tcp", // Will be determined from context
245: 		}
246: 
247: 		// Parse Recv-Q and Send-Q
248: 		if recvQ, err := strconv.Atoi(fields[1]); err == nil {
249: 			conn.RecvQ = recvQ
250: 		}
251: 		if sendQ, err := strconv.Atoi(fields[2]); err == nil {
252: 			conn.SendQ = sendQ
253: 		}
254: 
255: 		// Parse local address:port
256: 		localAddr := fields[3]
257: 		if idx := strings.LastIndex(localAddr, ":"); idx != -1 {
258: 			conn.LocalAddr = localAddr[:idx]
259: 			conn.LocalPort = localAddr[idx+1:]
260: 		}
261: 
262: 		// Parse peer address:port
263: 		peerAddr := fields[4]
264: 		if idx := strings.LastIndex(peerAddr, ":"); idx != -1 {
265: 			conn.PeerAddr = peerAddr[:idx]
266: 			conn.PeerPort = peerAddr[idx+1:]
267: 		}
268: 
269: 		// Parse timer information (field 5+)
270: 		// Format: timer:(name,value,retrans) or timer:(name,value)
271: 		// Examples:
272: 		//   timer:(keepalive,30sec,0)
273: 		//   timer:(on,238ms,0)
274: 		//   timer:(off)
275: 		for i := 5; i < len(fields); i++ {
276: 			field := fields[i]
277: 
278: 			// Check for timer
279: 			if strings.HasPrefix(field, "timer:(") {
280: 				timerInfo := strings.TrimPrefix(field, "timer:(")
281: 				timerInfo = strings.TrimSuffix(timerInfo, ")")
282: 				parts := strings.Split(timerInfo, ",")
283: 
284: 				if len(parts) > 0 {
285: 					conn.Timer = parts[0] // Timer name (keepalive, on, off, etc.)
286: 				}
287: 				if len(parts) > 1 {
288: 					conn.TimerValue = parts[1] // Timer value (30sec, 238ms, etc.)
289: 				}
290: 			}
291: 
292: 			// Check for uid
293: 			if strings.HasPrefix(field, "uid:") {
294: 				conn.UID = strings.TrimPrefix(field, "uid:")
295: 			}
296: 
297: 			// Check for process info
298: 			if strings.HasPrefix(field, "users:") {
299: 				conn.ProcessInfo = strings.TrimPrefix(field, "users:")
300: 			}
301: 		}
302: 
303: 		// Determine protocol from state or context
304: 		if conn.State == "UNCONN" {
305: 			conn.Protocol = "udp"
306: 		} else {
307: 			conn.Protocol = "tcp"
308: 		}
309: 
310: 		stats.Connections = append(stats.Connections, conn)
311: 		stats.ByState[conn.State]++
312: 		stats.ByProtocol[conn.Protocol]++
313: 		stats.Total++
314: 		connectionCount++
315: 	}
316: 
317: 	return stats, nil
318: }
319: 
320: // MetricsSamplesHandler returns recent metric samples
321: // GET /api/network/metrics/samples?count=60
322: func MetricsSamplesHandler(w http.ResponseWriter, r *http.Request) {
323: 	countStr := r.URL.Query().Get("count")
324: 	count := 60 // Default to last 60 samples (10 minutes)
325: 

 543:         fi
 544: 
 545:         local data
 546:         if command -v jq &>/dev/null; then
 547:             data=$(jq -n \
 548:                 --arg total "$total_events" \
 549:                 --arg success "$success_events" \
 550:                 --arg failed "$failed_events" \
 551:                 --arg today "$today_events" \
 552:                 --arg running "$service_running" \
 553:                 --arg uptime "$service_uptime" \
 554:                 '{
 555:                     events: {
 556:                         total: ($total | tonumber),
 557:                         success: ($success | tonumber),
 558:                         failed: ($failed | tonumber),
 559:                         today: ($today | tonumber)
 560:                     },
 561:                     service: {
 562:                         running: ($running == "true"),
 563:                         uptime: $uptime
 564:                     }
 565:                 }')
 566:         else
 567:             data="{\"total\":$total_events,\"success\":$success_events,\"failed\":$failed_events,\"today\":$today_events,\"service_running\":$service_running}"
 568:         fi
 569: 
 570:         json_output "true" "$data"
 571:         return 0
 572:     fi
 573: 
 574:     nftban_login_cmd_stats
 575: }

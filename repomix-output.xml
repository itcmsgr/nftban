<file path="cli/lib/nftban/cli/cmd_wizard.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - Installation Wizard
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Interactive wizard for NFTBan configuration
  7: #
  8: # meta:name=cmd_wizard
  9: # meta:type=cli
 10: # meta:header=NFTBan Installation Wizard
 11: # meta:version=1.0.0
 12: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 13: # meta:homepage=https://nftban.com
 14: #
 15: # **Description & Purpose**
 16: # meta:description=Interactive wizard that detects environment and configures NFTBan
 17: # meta:input=User answers to 3 simple questions
 18: # meta:output=Generated configuration + enabled modules
 19: #
 20: # **Inventory & Requirements**
 21: # meta:depends=bash,nproc,awk,ss
 22: #
 23: # meta:created_date=2025-12-05
 24: # =============================================================================
 25: 
 26: set -Eeuo pipefail
 27: 
 28: # Prevent double-loading
 29: [[ -n "${NFTBAN_CMD_WIZARD_LOADED:-}" ]] && return 0
 30: NFTBAN_CMD_WIZARD_LOADED="true"
 31: 
 32: # Load required modules
 33: [[ -z "${NFTBAN_LIB_DIR:-}" ]] && readonly NFTBAN_LIB_DIR="/usr/lib/nftban"
 34: # shellcheck source=/dev/null
 35: source "${NFTBAN_LIB_DIR}/core/nftban_output.sh" 2>/dev/null || true
 36: 
 37: # =============================================================================
 38: # CONFIGURATION
 39: # =============================================================================
 40: 
 41: readonly NFTBAN_CONFIG_LOCAL="${NFTBAN_CONFIG_LOCAL:-/etc/nftban/nftban.conf.local}"
 42: readonly NFTBAN_PROFILE_CURRENT="${NFTBAN_PROFILE_CURRENT:-/var/lib/nftban/profile.current}"
 43: 
 44: # =============================================================================
 45: # ENVIRONMENT DETECTION
 46: # =============================================================================
 47: 
 48: _wizard_detect_env() {
 49:     # CPU cores
 50:     CPU_CORES=$(nproc 2>/dev/null || echo 1)
 51: 
 52:     # RAM in MB
 53:     TOTAL_RAM_MB=$(awk '/MemTotal/ {print int($2/1024)}' /proc/meminfo 2>/dev/null || echo 512)
 54: 
 55:     # Disk free in GB
 56:     DISK_FREE_GB=$(df -Pm / 2>/dev/null | awk 'NR==2 {print int($4/1024)}' || echo 10)
 57: 
 58:     # Classify environment size
 59:     if [[ "$TOTAL_RAM_MB" -le 1024 ]] || [[ "$CPU_CORES" -le 1 ]]; then
 60:         PROFILE_ENV="small"
 61:     elif [[ "$TOTAL_RAM_MB" -le 8192 ]]; then
 62:         PROFILE_ENV="medium"
 63:     else
 64:         PROFILE_ENV="large"
 65:     fi
 66: 
 67:     # Detect open ports and roles
 68:     ROLE_SSH=0
 69:     ROLE_WEB=0
 70:     ROLE_MAIL=0
 71:     ROLE_DB=0
 72: 
 73:     local open_ports
 74:     open_ports=$(ss -lnt 2>/dev/null | awk 'NR>1 {print $4}' | sed 's/.*://' | sort -u)
 75: 
 76:     echo "$open_ports" | grep -qE '^22$' && ROLE_SSH=1
 77:     echo "$open_ports" | grep -qE '^(80|443)$' && ROLE_WEB=1
 78:     echo "$open_ports" | grep -qE '^(25|465|587|993|995)$' && ROLE_MAIL=1
 79:     echo "$open_ports" | grep -qE '^(3306|5432|27017|6379)$' && ROLE_DB=1
 80: 
 81:     # Build detected ports strings
 82:     SSH_PORTS="22"
 83:     WEB_TCP_PORTS=""
 84:     MAIL_TCP_PORTS=""
 85:     DB_TCP_PORTS=""
 86: 
 87:     [[ "$ROLE_WEB" -eq 1 ]] && WEB_TCP_PORTS="80,443"
 88:     [[ "$ROLE_MAIL" -eq 1 ]] && MAIL_TCP_PORTS="25,465,587,993,995"
 89:     [[ "$ROLE_DB" -eq 1 ]] && DB_TCP_PORTS="3306,5432"
 90: }
 91: 
 92: _wizard_show_env() {
 93:     echo ""
 94:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
 95:     echo "  Environment Detection"
 96:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
 97:     echo ""
 98:     echo "  Hardware:"
 99:     echo "    CPU cores:    $CPU_CORES"
100:     echo "    RAM:          ${TOTAL_RAM_MB} MB"
101:     echo "    Disk free:    ${DISK_FREE_GB} GB"
102:     echo "    Environment:  ${PROFILE_ENV^^}"
103:     echo ""
104:     echo "  Detected Services:"
105:     [[ "$ROLE_SSH" -eq 1 ]] && echo "    ✓ SSH (port 22)"
106:     [[ "$ROLE_WEB" -eq 1 ]] && echo "    ✓ Web (ports 80, 443)"
107:     [[ "$ROLE_MAIL" -eq 1 ]] && echo "    ✓ Mail (ports 25, 465, 587, 993, 995)"
108:     [[ "$ROLE_DB" -eq 1 ]] && echo "    ✓ Database (ports 3306, 5432)"
109:     [[ "$ROLE_SSH" -eq 0 && "$ROLE_WEB" -eq 0 && "$ROLE_MAIL" -eq 0 && "$ROLE_DB" -eq 0 ]] && echo "    (no common services detected)"
110:     echo ""
111: }
112: 
113: # =============================================================================
114: # WIZARD QUESTIONS (Only 3!)
115: # =============================================================================
116: 
117: _wizard_ask_questions() {
118:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
119:     echo "  Configuration Questions"
120:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
121:     echo ""
122: 
123:     # Question 1: Security Level
124:     echo "  1) Security Level:"
125:     echo ""
126:     echo "     1. Standard   - Good balance, low false positives"
127:     echo "     2. Strict     - Stronger blocking, some false positives possible"
128:     echo "     3. Paranoid   - Maximum protection, may block legit traffic"
129:     echo ""
130:     read -rp "     Select [1-3, default=1]: " SEC_CHOICE
131:     case "$SEC_CHOICE" in
132:         2) PROFILE_SECURITY_LEVEL="strict" ;;
133:         3) PROFILE_SECURITY_LEVEL="paranoid" ;;
134:         *) PROFILE_SECURITY_LEVEL="standard" ;;
135:     esac
136:     echo ""
137: 
138:     # Question 2: Traffic Level
139:     echo "  2) Expected Traffic Level:"
140:     echo ""
141:     echo "     1. Low      - Development, small site, internal"
142:     echo "     2. Medium   - Normal production"
143:     echo "     3. High     - Heavy traffic, possible DDoS target"
144:     echo ""
145:     read -rp "     Select [1-3, default=2]: " TRAF_CHOICE
146:     case "$TRAF_CHOICE" in
147:         1) PROFILE_TRAFFIC_LEVEL="low" ;;
148:         3) PROFILE_TRAFFIC_LEVEL="high" ;;
149:         *) PROFILE_TRAFFIC_LEVEL="medium" ;;
150:     esac
151:     echo ""
152: 
153:     # Question 3: Optional Features
154:     echo "  3) Optional Features:"
155:     echo ""
156: 
157:     # Feeds - suggest based on role
158:     local feeds_suggest=""
159:     [[ "$ROLE_SSH" -eq 1 ]] && feeds_suggest="BLOCKLIST_DE_SSH"
160:     [[ "$ROLE_WEB" -eq 1 ]] && feeds_suggest="${feeds_suggest:+$feeds_suggest, }SPAMHAUS_DROP"
161:     [[ -n "$feeds_suggest" ]] && echo "     (Suggested feeds for your services: $feeds_suggest)"
162: 
163:     read -rp "     Enable threat intelligence feeds? [y/N]: " FEEDS_CHOICE
164:     [[ "${FEEDS_CHOICE,,}" == "y" ]] && WANT_FEEDS=1 || WANT_FEEDS=0
165: 
166:     # IDS - only ask if not small environment
167:     WANT_IDS=0
168:     if [[ "$PROFILE_ENV" != "small" ]]; then
169:         read -rp "     Enable IDS integration (Suricata) if available? [y/N]: " IDS_CHOICE
170:         [[ "${IDS_CHOICE,,}" == "y" ]] && WANT_IDS=1
171:     else
172:         echo "     IDS integration: Skipped (not recommended for small environments)"
173:     fi
174: 
175:     # GUI/Metrics - only ask if not small environment
176:     WANT_GUI=0
177:     WANT_METRICS=0
178:     if [[ "$PROFILE_ENV" != "small" ]]; then
179:         read -rp "     Enable web GUI & metrics? [y/N]: " GUI_CHOICE
180:         if [[ "${GUI_CHOICE,,}" == "y" ]]; then
181:             WANT_GUI=1
182:             WANT_METRICS=1  # shellcheck disable=SC2034  # Reserved for metrics setup
183:         fi
184:     else
185:         echo "     GUI & metrics: Skipped (not recommended for small environments)"
186:     fi
187: 
188:     echo ""
189: }
190: 
191: # =============================================================================
192: # COMPUTE CONFIGURATION
193: # =============================================================================
194: 
195: _wizard_compute_config() {
196:     # Login monitor - ALWAYS enabled
197:     ENABLE_LOGIN_MONITOR=1
198: 
199:     # SSH protect level based on security level
200:     case "$PROFILE_SECURITY_LEVEL" in
201:         strict)   SSH_PROTECT_LEVEL=1 ;;
202:         paranoid) SSH_PROTECT_LEVEL=2 ;;
203:         *)        SSH_PROTECT_LEVEL=0 ;;
204:     esac
205: 
206:     # DDoS - enable if traffic is not low
207:     ENABLE_DDOS=0
208:     if [[ "$PROFILE_TRAFFIC_LEVEL" != "low" ]]; then
209:         ENABLE_DDOS=1
210:     fi
211: 
212:     # Portscan - enable if security is not standard
213:     ENABLE_PORTSCAN=0
214:     if [[ "$PROFILE_SECURITY_LEVEL" != "standard" ]]; then
215:         ENABLE_PORTSCAN=1
216:     fi
217: 
218:     # High traffic or paranoid = enable both
219:     if [[ "$PROFILE_TRAFFIC_LEVEL" == "high" ]] || [[ "$PROFILE_SECURITY_LEVEL" == "paranoid" ]]; then
220:         ENABLE_DDOS=1
221:         ENABLE_PORTSCAN=1
222:     fi
223: 
224:     # Feeds - only if user wants AND not tiny env
225:     ENABLE_FEEDS=0
226:     if [[ "$WANT_FEEDS" -eq 1 ]]; then
227:         ENABLE_FEEDS=1
228:     fi
229: 
230:     # IDS - only if user wants AND not small
231:     ENABLE_IDS_INTEGRATION=0
232:     if [[ "$WANT_IDS" -eq 1 ]] && [[ "$PROFILE_ENV" != "small" ]]; then
233:         ENABLE_IDS_INTEGRATION=1
234:     fi

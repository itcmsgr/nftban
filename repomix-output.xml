 423: // fullSetRefreshExcludingIP flushes the set and re-adds all elements except the specified IP.
 424: // This is the nuclear option when range splitting doesn't work due to kernel auto-merge.
 425: func (m *NFTManager) fullSetRefreshExcludingIP(set *nftables.Set, family, excludeIP string) error {
 426: 	// Step 1: Get all current elements
 427: 	output, err := nftListSet(family, set.Table.Name, set.Name)
 428: 	if err != nil {
 429: 		return fmt.Errorf("failed to list set: %w", err)
 430: 	}
 431: 
 432: 	// Step 2: Parse all elements (IPs and ranges)
 433: 	elements := m.parseSetElements(output)
 434: 	if len(elements) == 0 {
 435: 		return nil // Nothing to do
 436: 	}
 437: 
 438: 	// Step 3: Filter out the IP to exclude
 439: 	var filteredElements []string
 440: 	excludeIPVal, err := ipv4ToUint32(net.ParseIP(excludeIP))
 441: 	if err != nil {
 442: 		return fmt.Errorf("invalid exclude IP: %s", excludeIP)
 443: 	}
 444: 
 445: 	for _, elem := range elements {
 446: 		if strings.Contains(elem, "-") {
 447: 			// It's a range - check if excludeIP is inside
 448: 			parts := strings.Split(elem, "-")
 449: 			if len(parts) != 2 {
 450: 				filteredElements = append(filteredElements, elem)
 451: 				continue
 452: 			}
 453: 
 454: 			startIP := net.ParseIP(strings.TrimSpace(parts[0]))
 455: 			endIP := net.ParseIP(strings.TrimSpace(parts[1]))
 456: 			if startIP == nil || endIP == nil {
 457: 				filteredElements = append(filteredElements, elem)
 458: 				continue
 459: 			}
 460: 
 461: 			startVal, _ := ipv4ToUint32(startIP)
 462: 			endVal, _ := ipv4ToUint32(endIP)
 463: 
 464: 			if excludeIPVal < startVal || excludeIPVal > endVal {
 465: 				// IP not in this range, keep it
 466: 				filteredElements = append(filteredElements, elem)
 467: 			} else {
 468: 				// IP is inside range - split it
 469: 				if startVal < excludeIPVal {
 470: 					// Left part
 471: 					if startVal == excludeIPVal-1 {
 472: 						filteredElements = append(filteredElements, uint32ToIPv4(startVal).String())
 473: 					} else {
 474: 						filteredElements = append(filteredElements, uint32ToIPv4(startVal).String()+"-"+uint32ToIPv4(excludeIPVal-1).String())
 475: 					}
 476: 				}
 477: 				if excludeIPVal < endVal {
 478: 					// Right part
 479: 					if excludeIPVal+1 == endVal {
 480: 						filteredElements = append(filteredElements, uint32ToIPv4(endVal).String())
 481: 					} else {
 482: 						filteredElements = append(filteredElements, uint32ToIPv4(excludeIPVal+1).String()+"-"+uint32ToIPv4(endVal).String())
 483: 					}
 484: 				}
 485: 			}
 486: 		} else {
 487: 			// Single IP
 488: 			if strings.TrimSpace(elem) != excludeIP {
 489: 				filteredElements = append(filteredElements, elem)
 490: 			}
 491: 		}
 492: 	}
 493: 
 494: 	// Step 4: Flush the set
 495: 	if err := nftFlushSet(family, set.Table.Name, set.Name); err != nil {
 496: 		return fmt.Errorf("failed to flush set: %w", err)
 497: 	}
 498: 
 499: 	// Step 5: Re-add filtered elements in batches
 500: 	// First, filter out any empty strings that may have crept in
 501: 	var cleanElements []string
 502: 	for _, elem := range filteredElements {
 503: 		elem = strings.TrimSpace(elem)
 504: 		if elem != "" {
 505: 			cleanElements = append(cleanElements, elem)
 506: 		}
 507: 	}
 508: 
 509: 	if len(cleanElements) == 0 {
 510: 		return nil // Nothing to add back
 511: 	}
 512: 
 513: 	// Use centralized batch add (500 elements per batch for safety)
 514: 	if err := nftAddElementsBatch(family, set.Table.Name, set.Name, cleanElements, 500); err != nil {
 515: 		// Log but continue - partial success is better than full failure
 516: 		fmt.Fprintf(os.Stderr, "Warning: batch add partial failure: %v\n", err)
 517: 	}
 518: 
 519: 	return nil
 520: }

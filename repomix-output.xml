126: # Strip ANSI color codes from text
127: nftban_strip_ansi() {
128:     sed -r 's/\x1B\[[0-9;]*[A-Za-z]//g'
129: }
130: 
131: # Center text in terminal
132: nftban_center_text() {
133:     local text="$1"
134:     local width="${2:-$NFTBAN_WIDTH}"
135: 
136:     # Strip ANSI codes for length calculation
137:     local raw_text
138:     raw_text="$(echo -e "$text" | nftban_strip_ansi)"
139: 
140:     local len=${#raw_text}
141: 
142:     if [[ $len -ge $width ]]; then
143:         echo -e "$text"
144:         return
145:     fi
146: 
147:     local pad
148:     pad=$(( (width - len) / 2 ))
149:     printf "%*s%b%*s\n" "$pad" "" "$text" $(( width - len - pad )) ""
150: }
151: 
152: # Repeat character
153: nftban_repeat_char() {
154:     local count="$1"
155:     local char="${2:- }"
156:     printf "%*s" "$count" "" | tr ' ' "$char"
157: }

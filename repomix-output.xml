 897: nftban_stats_check_high_ban_rate() {
 898:     # Check for high ban rate (alerts)
 899:     # Usage: nftban_stats_check_high_ban_rate [threshold]
 900:     # Returns: 0=alert triggered, 1=no alert
 901: 
 902:     local threshold="${1:-${STATS_ALERT_HIGH_BAN_RATE:-100}}"
 903:     local since
 904:     local until
 905:     since="$(date -d '1 hour ago' +%Y-%m-%d\ %H:%M:%S)"
 906:     until="$(date +%Y-%m-%d\ %H:%M:%S)"
 907: 
 908:     local recent_bans
 909:     recent_bans=$(nftban_stats_count_bans "$since" "$until")
 910: 
 911:     if [[ $recent_bans -gt $threshold ]]; then
 912:         if type -t nftban_print_status >/dev/null 2>&1; then
 913:             nftban_print_status "warn" "High ban rate detected: ${recent_bans} bans in last hour (threshold: ${threshold})"
 914:         else
 915:             echo "[WARN] High ban rate: ${recent_bans} bans/hour (threshold: ${threshold})"
 916:         fi
 917:         return 0  # Alert triggered
 918:     fi
 919: 
 920:     return 1  # No alert
 921: }

<file path="cli/lib/nftban/core/nftban_login_suricata.sh">
  1: #!/usr/bin/env bash
  2: # shellcheck disable=SC1090  # Dynamic config paths, cannot follow
  3: # =============================================================================
  4: # NFTBan v1.0 - Login Monitor Suricata Mode Module
  5: # =============================================================================
  6: # SPDX-License-Identifier: MPL-2.0
  7: # Purpose: Suricata EVE JSON based login/auth failure monitoring
  8: #
  9: # meta:name=nftban_login_suricata
 10: # meta:type=core
 11: # meta:header=Login Monitor Suricata Mode
 12: # meta:version=1.0.0
 13: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 14: # meta:homepage=https://nftban.com
 15: #
 16: # **Description & Purpose**
 17: # meta:description=Suricata mode login monitoring using EVE JSON auth alerts
 18: # meta:input=Suricata EVE JSON log file
 19: # meta:output=Auth failure detection and ban actions
 20: #
 21: # **Inventory & Requirements**
 22: # meta:depends=bash>=4.0,jq,nftban_login.sh,suricata
 23: #
 24: # meta:created_date=2025-12-01
 25: # meta:updated_date=2025-12-01
 26: # =============================================================================
 27: 
 28: IFS=$'\n\t'
 29: umask 027
 30: 
 31: # =============================================================================
 32: # MODULE GUARD
 33: # =============================================================================
 34: 
 35: [[ -n "${NFTBAN_LOGIN_SURICATA_LOADED:-}" ]] && return 0
 36: readonly NFTBAN_LOGIN_SURICATA_LOADED=1
 37: 
 38: # =============================================================================
 39: # MODULE METADATA
 40: # =============================================================================
 41: 
 42: # shellcheck disable=SC2034  # Module metadata used when sourced
 43: readonly LOGIN_SURICATA_MODULE_NAME="nftban_login_suricata"
 44: # Module metadata - reserved for future module registry
 45: readonly LOGIN_SURICATA_MODULE_VERSION="1.0.0"
 46: # shellcheck disable=SC2034
 47: 
 48: # =============================================================================
 49: # STATE TRACKING
 50: # =============================================================================
 51: 
 52: # Alert counts per IP (IP -> count)
 53: declare -gA _LOGIN_SURICATA_ALERT_COUNT=()
 54: # First alert timestamp per IP (IP -> timestamp)
 55: declare -gA _LOGIN_SURICATA_ALERT_FIRST=()
 56: # Accumulated score per IP (IP -> score)
 57: declare -gA _LOGIN_SURICATA_SCORES=()
 58: # Running flag
 59: declare -g _LOGIN_SURICATA_RUNNING=0
 60: # Monitor PID
 61: declare -g _LOGIN_SURICATA_MONITOR_PID=""
 62: # Last processed position
 63: declare -g _LOGIN_SURICATA_LAST_POS=0
 64: 
 65: # =============================================================================
 66: # INITIALIZATION
 67: # =============================================================================
 68: 
 69: nftban_login_suricata_init() {
 70:     nftban_login_log "INFO" "Initializing Suricata mode..."
 71: 
 72:     # Check jq availability
 73:     if ! command -v jq &>/dev/null; then
 74:         nftban_login_log "ERROR" "jq is required for Suricata mode but not installed"
 75:         return 1
 76:     fi
 77: 
 78:     # Load state from disk if exists
 79:     local state_file="${LOGIN_SURICATA_STATE_FILE:-/var/lib/nftban/login-suricata-state.db}"
 80:     if [[ -f "$state_file" ]]; then
 81:         source "$state_file" 2>/dev/null || true
 82:     fi
 83: 
 84:     # Set defaults
 85:     : "${LOGIN_SURICATA_EVE_FILE:=/var/log/suricata/eve.json}"
 86:     : "${LOGIN_SURICATA_SIG_PATTERNS:=[Aa]uth|[Ll]ogin|[Pp]assword|[Cc]redential|[Bb]rute|SSH|FTP|SMTP|POP3|IMAP}"
 87:     : "${LOGIN_SURICATA_ALERT_WINDOW:=300}"
 88:     # Severity scoring (1=High, 2=Medium, 3=Low, 4=Info - matches Go)
 89:     : "${LOGIN_SURICATA_SCORE_SEVERITY_1:=0.50}"
 90:     : "${LOGIN_SURICATA_SCORE_SEVERITY_2:=0.35}"
 91:     : "${LOGIN_SURICATA_SCORE_SEVERITY_3:=0.20}"
 92:     : "${LOGIN_SURICATA_SCORE_SEVERITY_4:=0.10}"
 93:     : "${LOGIN_SURICATA_SCORE_BRUTE_FORCE:=0.25}"
 94:     : "${LOGIN_SURICATA_THRESHOLD_BLOCK_SHORT:=0.45}"
 95:     : "${LOGIN_SURICATA_THRESHOLD_BLOCK_LONG:=0.65}"
 96:     : "${LOGIN_SURICATA_BAN_DURATION_SHORT:=900}"
 97:     : "${LOGIN_SURICATA_BAN_DURATION_LONG:=3600}"
 98:     : "${LOGIN_SURICATA_POLL_INTERVAL_MS:=500}"
 99: 
100:     return 0
101: }
102: 
103: # =============================================================================
104: # EVE JSON PARSING
105: # =============================================================================
106: 
107: # Monitor EVE JSON file for auth-related alerts
108: _nftban_login_suricata_monitor_eve() {
109:     local eve_file="${LOGIN_SURICATA_EVE_FILE:-/var/log/suricata/eve.json}"
110:     local poll_ms="${LOGIN_SURICATA_POLL_INTERVAL_MS:-500}"
111:     local poll_sec
112:     poll_sec=$(echo "scale=3; $poll_ms / 1000" | bc)
113: 
114:     nftban_login_log "INFO" "Starting EVE JSON monitor: $eve_file"
115: 
116:     if [[ ! -f "$eve_file" ]]; then
117:         nftban_login_log "ERROR" "EVE file not found: $eve_file"
118:         return 1
119:     fi
120: 
121:     # Start tailing from current position
122:     tail -F -n 0 "$eve_file" 2>/dev/null | while read -r line; do
123:         [[ -z "$line" ]] && continue
124: 
125:         # Parse JSON and check if relevant
126:         _nftban_login_suricata_process_eve_line "$line"
127: 
128:         # Small sleep to prevent CPU spinning
129:         sleep "$poll_sec"
130:     done
131: }
132: 
133: # Process a single EVE JSON line
134: _nftban_login_suricata_process_eve_line() {
135:     local line="$1"
136: 
137:     # Parse JSON
138:     local event_type src_ip signature signature_id severity
139: 
140:     event_type=$(echo "$line" | jq -r '.event_type // empty' 2>/dev/null) || return 0
141:     [[ -z "$event_type" ]] && return 0
142: 
143:     # Get source IP
144:     src_ip=$(echo "$line" | jq -r '.src_ip // empty' 2>/dev/null)
145:     [[ -z "$src_ip" ]] && return 0
146: 
147:     # Skip whitelisted
148:     if _nftban_login_suricata_is_whitelisted "$src_ip"; then
149:         return 0
150:     fi
151: 
152:     local processed=0
153: 
154:     # Handle alert events
155:     if [[ "$event_type" == "alert" ]]; then
156:         signature=$(echo "$line" | jq -r '.alert.signature // empty' 2>/dev/null)
157:         signature_id=$(echo "$line" | jq -r '.alert.signature_id // empty' 2>/dev/null)
158:         severity=$(echo "$line" | jq -r '.alert.severity // 2' 2>/dev/null)
159: 
160:         # Check if auth-related
161:         local patterns="${LOGIN_SURICATA_SIG_PATTERNS}"
162:         if [[ "$signature" =~ $patterns ]]; then
163:             _nftban_login_suricata_process_alert "$src_ip" "$signature" "$signature_id" "$severity"
164:             processed=1
165:         fi
166:     fi
167: 
168:     # Handle SSH events (Suricata SSH protocol logging)
169:         client_proto=$(echo "$line" | jq -r '.ssh.client.proto_version // empty' 2>/dev/null)  # shellcheck disable=SC2034  # Reserved for protocol analysis
170:         local client_proto client_software
171:         client_proto=$(echo "$line" | jq -r '.ssh.client.proto_version // empty' 2>/dev/null)
172:         client_software=$(echo "$line" | jq -r '.ssh.client.software_version // empty' 2>/dev/null)
173: 
174:         # Check for scanner patterns
175:         local scanner_patterns="${LOGIN_SURICATA_SSH_SCANNER_PATTERNS:-[Nn]map|[Ss]can|[Aa]udit|[Bb]rute}"
176:         if [[ "$client_software" =~ $scanner_patterns ]]; then
177:             _nftban_login_suricata_process_ssh_scanner "$src_ip" "$client_software"
178:             processed=1
179:         fi
180:     fi
181: 
182:     # Handle anomaly events
183:     if [[ "$event_type" == "anomaly" ]]; then
184:         local anomaly_type
185:         anomaly_type=$(echo "$line" | jq -r '.anomaly.type // empty' 2>/dev/null)
186: 
187:         # Auth-related anomalies
188:             processed=1  # shellcheck disable=SC2034  # Reserved for processing stats
189:             _nftban_login_suricata_process_anomaly "$src_ip" "$anomaly_type"
190:             processed=1
191:         fi
192:     fi
193: 
194:     return 0
195: }
196: 
197: # Process an auth-related alert
198: _nftban_login_suricata_process_alert() {
199:     local sig_id="$3"  # shellcheck disable=SC2034  # Reserved for SID filtering
200:     local signature="$2"
201:     local sig_id="$3"
202:     local severity="${4:-2}"
203:     local now
204:     now=$(date +%s)
205: 
206:     local window="${LOGIN_SURICATA_ALERT_WINDOW:-300}"
207: 
208:     # Track alert count
209:     if [[ -z "${_LOGIN_SURICATA_ALERT_FIRST[$ip]:-}" ]]; then
210:         _LOGIN_SURICATA_ALERT_COUNT[$ip]=1
211:         _LOGIN_SURICATA_ALERT_FIRST[$ip]=$now
212:         _LOGIN_SURICATA_SCORES[$ip]="0"
213:     else
214:         local first="${_LOGIN_SURICATA_ALERT_FIRST[$ip]}"
215:         local elapsed
216:         elapsed=$((now - first))
217: 
218:         if [[ $elapsed -lt $window ]]; then
219:             ((_LOGIN_SURICATA_ALERT_COUNT[$ip]++))
220:         else
221:             _LOGIN_SURICATA_ALERT_COUNT[$ip]=1
222:             _LOGIN_SURICATA_ALERT_FIRST[$ip]=$now
223:             _LOGIN_SURICATA_SCORES[$ip]="0"
224:         fi
225:     fi
226: 
227:     local count="${_LOGIN_SURICATA_ALERT_COUNT[$ip]}"
228: 
229:     # Calculate score
230:     local score
231:     score=$(_nftban_login_suricata_calculate_score "$ip" "$signature" "$severity" "$count")
232:     _LOGIN_SURICATA_SCORES[$ip]="$score"
233: 
234:     nftban_login_log "DEBUG" "Alert: $ip - sig: $signature (severity: $severity, count: $count, score: $score)"
235: 
236:     # Check thresholds
237:     _nftban_login_suricata_check_threshold "$ip" "$score" "alert"
238: }
239: 
240: # Process SSH scanner detection
241: _nftban_login_suricata_process_ssh_scanner() {
242:     local ip="$1"
243:     local client_software="$2"
244:     local now
245:     now=$(date +%s)
246: 
247:     nftban_login_log "INFO" "SSH scanner detected from $ip: $client_software"
248: 
249:     # Initialize tracking
250:     if [[ -z "${_LOGIN_SURICATA_SCORES[$ip]:-}" ]]; then
251:         _LOGIN_SURICATA_ALERT_COUNT[$ip]=1
252:         _LOGIN_SURICATA_ALERT_FIRST[$ip]=$now
253:         _LOGIN_SURICATA_SCORES[$ip]="0"
254:     fi
255: 
256:     # Add scanner penalty
257:     local current_score="${_LOGIN_SURICATA_SCORES[$ip]:-0}"
258:     local tool_score="${LOGIN_SURICATA_SCORE_KNOWN_TOOL:-0.20}"
259:     local new_score
260:     new_score=$(echo "$current_score + $tool_score" | bc -l)
261:     _LOGIN_SURICATA_SCORES[$ip]="$new_score"
262: 
263:     _nftban_login_suricata_check_threshold "$ip" "$new_score" "ssh_scanner"
264: }
265: 
266: # Process anomaly event
267: _nftban_login_suricata_process_anomaly() {
268:     local ip="$1"
269:     local anomaly_type="$2"
270:     local now
271:     now=$(date +%s)
272: 
273:     # Initialize tracking
274:     if [[ -z "${_LOGIN_SURICATA_SCORES[$ip]:-}" ]]; then
275:         _LOGIN_SURICATA_ALERT_COUNT[$ip]=1
276:         _LOGIN_SURICATA_ALERT_FIRST[$ip]=$now
277:         _LOGIN_SURICATA_SCORES[$ip]="0"
278:     fi
279: 
280:     # Add anomaly penalty (lower than alerts)
281:     local current_score="${_LOGIN_SURICATA_SCORES[$ip]:-0}"
282:     local anomaly_score="0.10"
283:     local new_score
284:     new_score=$(echo "$current_score + $anomaly_score" | bc -l)
285:     _LOGIN_SURICATA_SCORES[$ip]="$new_score"
286: 
287:     ((_LOGIN_SURICATA_ALERT_COUNT[$ip]++))
288: 
289:     nftban_login_log "DEBUG" "Anomaly: $ip - type: $anomaly_type (score: $new_score)"
290: 
291:     _nftban_login_suricata_check_threshold "$ip" "$new_score" "anomaly"
292: }
293: 
294: # Calculate score for an alert
295: _nftban_login_suricata_calculate_score() {
296:     local ip="$1"
297:     local signature="$2"
298:     local severity="$3"
299:     local count="$4"
300: 
301:     local current_score="${_LOGIN_SURICATA_SCORES[$ip]:-0}"
302:     local additional=0
303: 
304:     # Severity-based score (1=High, 2=Medium, 3=Low, 4=Info - matches Go)
305:     case "$severity" in
306:         1) additional=$(echo "$additional + ${LOGIN_SURICATA_SCORE_SEVERITY_1:-0.50}" | bc -l) ;;
307:         2) additional=$(echo "$additional + ${LOGIN_SURICATA_SCORE_SEVERITY_2:-0.35}" | bc -l) ;;
308:         3) additional=$(echo "$additional + ${LOGIN_SURICATA_SCORE_SEVERITY_3:-0.20}" | bc -l) ;;
309:         4) additional=$(echo "$additional + ${LOGIN_SURICATA_SCORE_SEVERITY_4:-0.10}" | bc -l) ;;
310:     esac
311: 
312:     # Brute force signature bonus
313:     if [[ "$signature" =~ [Bb]rute ]]; then
314:         additional=$(echo "$additional + ${LOGIN_SURICATA_SCORE_BRUTE_FORCE:-0.25}" | bc -l)
315:     fi
316: 
317:     # Credential stuffing/dictionary bonus
318:     if [[ "$signature" =~ [Cc]redential|[Dd]ictionary ]]; then
319:         additional=$(echo "$additional + ${LOGIN_SURICATA_SCORE_CREDENTIAL_STUFFING:-0.30}" | bc -l)
320:     fi
321: 
322:     # Repetition bonuses
323:     if [[ $count -ge 10 ]]; then
324:         additional=$(echo "$additional + ${LOGIN_SURICATA_SCORE_REPEAT_10:-0.25}" | bc -l)
325:     elif [[ $count -ge 5 ]]; then
326:         additional=$(echo "$additional + ${LOGIN_SURICATA_SCORE_REPEAT_5:-0.15}" | bc -l)
327:     elif [[ $count -ge 3 ]]; then
328:         additional=$(echo "$additional + ${LOGIN_SURICATA_SCORE_REPEAT_3:-0.10}" | bc -l)
329:     fi
330: 
331:     local new_score
332:     new_score=$(echo "$current_score + $additional" | bc -l)
333: 
334:     # Cap at 1.0
335:     if (( $(echo "$new_score > 1.0" | bc -l) )); then
336:         new_score="1.0"
337:     fi
338: 
339:     echo "$new_score"
340: }
341: 
342: # Check threshold and take action
343: _nftban_login_suricata_check_threshold() {
344:     local ip="$1"
345:     local score="$2"
346:     local source="$3"
347: 
348:     if (( $(echo "$score >= ${LOGIN_SURICATA_THRESHOLD_BLOCK_LONG:-0.65}" | bc -l) )); then
349:         # Long ban
350:         local duration="${LOGIN_SURICATA_BAN_DURATION_LONG:-3600}"
351:         nftban_login_log "INFO" "Banning $ip (long) - score: $score, source: $source"
352:         nftban_login_ban "$ip" "suricata_${source}" "$duration" "suricata"
353:         _nftban_login_suricata_clear_ip "$ip"
354:     elif (( $(echo "$score >= ${LOGIN_SURICATA_THRESHOLD_BLOCK_SHORT:-0.45}" | bc -l) )); then
355:         # Short ban
356:         local duration="${LOGIN_SURICATA_BAN_DURATION_SHORT:-900}"
357:         nftban_login_log "INFO" "Banning $ip (short) - score: $score, source: $source"
358:         nftban_login_ban "$ip" "suricata_${source}" "$duration" "suricata"
359:         _nftban_login_suricata_clear_ip "$ip"
360:     fi
361: }
362: 
363: # Check if IP is whitelisted
364: _nftban_login_suricata_is_whitelisted() {
365:     local ip="$1"
366: 
367:     # Localhost
368:     if [[ "${LOGIN_WHITELIST_LOCALHOST:-true}" == "true" ]]; then
369:         [[ "$ip" == "127.0.0.1" ]] && return 0
370:         [[ "$ip" == "::1" ]] && return 0
371:     fi
372: 
373:     # Private networks
374:     if [[ "${LOGIN_WHITELIST_PRIVATE:-true}" == "true" ]]; then
375:         [[ "$ip" =~ ^10\. ]] && return 0
376:         [[ "$ip" =~ ^172\.(1[6-9]|2[0-9]|3[0-1])\. ]] && return 0
377:         [[ "$ip" =~ ^192\.168\. ]] && return 0
378:     fi
379: 
380:     # Whitelist file
381:     local whitelist_file="${LOGIN_WHITELIST_FILE:-/etc/nftban/whitelist.d/login-whitelist.conf}"
382:     if [[ -f "$whitelist_file" ]]; then
383:         grep -q "^$ip$" "$whitelist_file" && return 0
384:     fi
385: 
386:     return 1
387: }
388: 
389: # Clear tracking for an IP
390: _nftban_login_suricata_clear_ip() {
391:     local ip="$1"
392:     unset "_LOGIN_SURICATA_ALERT_COUNT[$ip]"
393:     unset "_LOGIN_SURICATA_ALERT_FIRST[$ip]"
394:     unset "_LOGIN_SURICATA_SCORES[$ip]"
395: }
396: 
397: # =============================================================================
398: # MAIN OPERATIONS
399: # =============================================================================
400: 
401: # Start Suricata mode monitoring
402: nftban_login_suricata_start() {
403:     if [[ $_LOGIN_SURICATA_RUNNING -eq 1 ]]; then
404:         nftban_login_log "WARN" "Suricata mode already running"
405:         return 0
406:     fi
407: 
408:     _LOGIN_SURICATA_RUNNING=1
409:     nftban_login_log "INFO" "Starting Suricata mode monitoring"
410: 
411:     _nftban_login_suricata_monitor_eve &
412:     _LOGIN_SURICATA_MONITOR_PID=$!
413: 
414:     wait $_LOGIN_SURICATA_MONITOR_PID
415: }
416: 
417: # Stop Suricata mode monitoring
418: nftban_login_suricata_stop() {
419:     _LOGIN_SURICATA_RUNNING=0
420: 
421:     if [[ -n "$_LOGIN_SURICATA_MONITOR_PID" ]] && kill -0 "$_LOGIN_SURICATA_MONITOR_PID" 2>/dev/null; then
422:         kill "$_LOGIN_SURICATA_MONITOR_PID" 2>/dev/null
423:         nftban_login_log "INFO" "Stopped EVE monitor (PID: $_LOGIN_SURICATA_MONITOR_PID)"
424:     fi
425:     _LOGIN_SURICATA_MONITOR_PID=""
426: 
427:     # Save state
428:     _nftban_login_suricata_save_state
429: }
430: 
431: # Save state to disk
432: _nftban_login_suricata_save_state() {
433:     local state_file="${LOGIN_SURICATA_STATE_FILE:-/var/lib/nftban/login-suricata-state.db}"
434:     mkdir -p "$(dirname "$state_file")"
435: 
436:     {
437:         echo "# Login Suricata State - $(date)"
438:         for key in "${!_LOGIN_SURICATA_ALERT_COUNT[@]}"; do
439:             echo "_LOGIN_SURICATA_ALERT_COUNT[$key]=${_LOGIN_SURICATA_ALERT_COUNT[$key]}"
440:         done
441:         for key in "${!_LOGIN_SURICATA_ALERT_FIRST[@]}"; do
442:             echo "_LOGIN_SURICATA_ALERT_FIRST[$key]=${_LOGIN_SURICATA_ALERT_FIRST[$key]}"
443:         done
444:         for key in "${!_LOGIN_SURICATA_SCORES[@]}"; do
445:             echo "_LOGIN_SURICATA_SCORES[$key]=${_LOGIN_SURICATA_SCORES[$key]}"
446:         done
447:     } > "$state_file"
448: }
449: 
450: # Get status
451: nftban_login_suricata_status() {
452:     echo "Suricata Mode Status:"
453:     echo "  Running: $_LOGIN_SURICATA_RUNNING"
454:     echo "  EVE File: ${LOGIN_SURICATA_EVE_FILE:-/var/log/suricata/eve.json}"
455: 
456:     local eve_exists="no"
457:     [[ -f "${LOGIN_SURICATA_EVE_FILE:-/var/log/suricata/eve.json}" ]] && eve_exists="yes"
458:     echo "  EVE Exists: $eve_exists"
459: 
460:     if [[ -n "$_LOGIN_SURICATA_MONITOR_PID" ]]; then
461:         local status="stopped"
462:         kill -0 "$_LOGIN_SURICATA_MONITOR_PID" 2>/dev/null && status="running (PID: $_LOGIN_SURICATA_MONITOR_PID)"
463:         echo "  Monitor: $status"
464:     fi
465: 
466:     echo "  Tracked IPs: ${#_LOGIN_SURICATA_ALERT_COUNT[@]}"
467: 
468:     if [[ ${#_LOGIN_SURICATA_SCORES[@]} -gt 0 ]]; then
469:         echo "  Current Scores:"
470:         for ip in "${!_LOGIN_SURICATA_SCORES[@]}"; do
471:             echo "    $ip: ${_LOGIN_SURICATA_SCORES[$ip]}"
472:         done
473:     fi
474: }
475: 
476: # Enable Suricata mode
477: nftban_login_suricata_enable() {
478:     nftban_login_log "INFO" "Enabling Suricata mode"
479:     return 0
480: }
481: 
482: # Disable Suricata mode
483: nftban_login_suricata_disable() {
484:     nftban_login_suricata_stop
485:     return 0
486: }
487: 
488: # Test Suricata mode
489: nftban_login_suricata_test() {
490:     echo "Suricata Mode Test:"
491:     echo "  jq available: $(command -v jq &>/dev/null && echo "yes" || echo "no")"
492: 
493:     local eve_file="${LOGIN_SURICATA_EVE_FILE:-/var/log/suricata/eve.json}"
494:     echo "  EVE file: $eve_file"
495:     echo "  EVE exists: $([[ -f "$eve_file" ]] && echo "yes" || echo "no")"
496: 
497:     if [[ -f "$eve_file" ]]; then
498:         local last_line
499:         last_line=$(tail -1 "$eve_file" 2>/dev/null)
500:         if [[ -n "$last_line" ]]; then
501:             echo "  Last event type: $(echo "$last_line" | jq -r '.event_type // "unknown"' 2>/dev/null)"
502:             echo "  EVE is being updated: yes"
503:         fi
504:     fi
505: 
506:     # Test JSON parsing
507:     local test_json='{"event_type":"alert","src_ip":"192.168.1.100","alert":{"signature":"ET SCAN SSH Brute Force","severity":2}}'
508:     echo "  Testing JSON parsing..."
509:     local parsed_type
510:     parsed_type=$(echo "$test_json" | jq -r '.event_type' 2>/dev/null)
511:     if [[ "$parsed_type" == "alert" ]]; then
512:         echo "    JSON parsing: OK"
513:     else
514:         echo "    JSON parsing: FAILED"
515:     fi
516: }
517: 
518: # =============================================================================
519: # EXPORTS
520: # =============================================================================
521: 
522: export -f nftban_login_suricata_init
523: export -f nftban_login_suricata_start
524: export -f nftban_login_suricata_stop
525: export -f nftban_login_suricata_status
526: export -f nftban_login_suricata_enable
527: export -f nftban_login_suricata_disable
528: export -f nftban_login_suricata_test
</file>

<file path="cli/lib/nftban/core/nftban_login.sh">
  1: #!/usr/bin/env bash
  2: # shellcheck disable=SC1090  # Dynamic config paths, cannot follow
  3: # =============================================================================
  4: # NFTBan v1.0 - Login Monitor Module (Dual-Mode Controller)
  5: # =============================================================================
  6: # SPDX-License-Identifier: MPL-2.0
  7: # Purpose: Master controller for login monitoring with dual-mode support
  8: #
  9: # meta:name=nftban_login
 10: # meta:type=core
 11: # meta:header=Login Monitor
 12: # meta:version=1.0.0
 13: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 14: # meta:homepage=https://nftban.com
 15: #
 16: # **Description & Purpose**
 17: # meta:description=Monitors login attempts and auto-bans attackers (replaces fail2ban)
 18: # meta:input=Configuration from /etc/nftban/conf.d/login/
 19: # meta:output=Login alerts and ban actions
 20: #
 21: # **Dual-Mode Architecture**
 22: # - Classic Mode: journalctl/log file parsing (no IDS required)
 23: # - Suricata Mode: Uses Suricata EVE JSON auth failure alerts
 24: # - Auto Mode: Automatically selects mode based on Suricata availability
 25: # - Hybrid Mode: Classic for immediate response + Suricata for correlation
 26: #
 27: # **Inventory & Requirements**
 28: # meta:depends=bash>=4.0,nftban_output.sh,nftban_distro_config.sh
 29: # meta:optional=suricata,jq
 30: #
 31: # meta:created_date=2025-12-01
 32: # meta:updated_date=2025-12-01
 33: # meta:replaces=fail2ban
 34: # =============================================================================
 35: 
 36: IFS=$'\n\t'
 37: umask 027
 38: 
 39: # =============================================================================
 40: # MODULE GUARD
 41: # =============================================================================
 42: 
 43: [[ -n "${NFTBAN_LOGIN_LOADED:-}" ]] && return 0
 44: readonly NFTBAN_LOGIN_LOADED=1
 45: 
 46: # =============================================================================
 47: # MODULE METADATA
 48: # =============================================================================
 49: 
 50: # shellcheck disable=SC2034  # Module metadata used when sourced
 51: readonly LOGIN_MODULE_NAME="nftban_login"
 52: # Module metadata - reserved for future module registry
 53: readonly LOGIN_MODULE_VERSION="1.0.0"
 54: # shellcheck disable=SC2034
 55: readonly LOGIN_MODULE_TYPE="core"
 56: readonly LOGIN_MODULE_DESCRIPTION="Login Monitor Module (Dual-Mode)"
 57: 
 58: # =============================================================================
 59: # LOAD MAIN CONFIG FOR NFTBAN_BIN AND OTHER PATHS
 60: # =============================================================================
 61: 
 62: # Source main nftban.conf for NFTBAN_BIN, NFTBAN_CONFIG_DIR, etc.
 63: # This MUST be sourced before using these variables
 64: if [[ -f "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf" ]]; then
 65:     # shellcheck source=/etc/nftban/nftban.conf
 66:     source "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf"
 67: fi
 68: 
 69: # =============================================================================
 70: # FHS COMPLIANT PATHS (uses central config from nftban.conf)
 71: # =============================================================================
 72: 
 73: readonly NFTBAN_LOGIN_CONFIG_DIR="${NFTBAN_CONFIG_DIR}/conf.d/login"
 74: readonly NFTBAN_LOGIN_DATA_DIR="${LOGIN_DATA_DIR:-${NFTBAN_DATA_DIR}/login}"
 75: readonly NFTBAN_LOGIN_CACHE_DIR="${LOGIN_CACHE_DIR:-${NFTBAN_CACHE_DIR}/login}"
 76: readonly NFTBAN_LOGIN_LOG_FILE="${LOGIN_LOG_FILE:-${NFTBAN_LOG_DIR}/login-monitor.log}"
 77: 
 78: # =============================================================================
 79: # RUNTIME STATE
 80: # =============================================================================
 81: 
 82: declare -g _LOGIN_ACTIVE_MODE=""          # Currently active mode
 83: declare -g _LOGIN_INITIALIZED=0           # Initialization flag
 84: declare -gA _LOGIN_DETECTED_SERVICES=()   # Services detected on system
 85: 
 86: # =============================================================================
 87: # BANNER FUNCTION
 88: # =============================================================================
 89: 
 90: nftban_login_banner() {
 91:     cat <<'BANNER'
 92: ╔══════════════════════════════════════════════════════════╗
 93: ║  🔐 Login Monitor (v1.0 Dual-Mode)                       ║
 94: ║  nftban — Simplifying Linux Firewall Management          ║
 95: ╚══════════════════════════════════════════════════════════╝
 96: BANNER
 97: }
 98: 
 99: # =============================================================================
100: # CONFIGURATION LOADING
101: # =============================================================================
102: 
103: # Load main login configuration
104: nftban_login_load_config() {
105:     local config_dir="${NFTBAN_LOGIN_CONFIG_DIR}"
106: 
107:     # Load main config
108:     local main_config="${config_dir}/main.conf"
109:     local main_local="${config_dir}/main.conf.local"
110: 
111:     if [[ -f "$main_config" ]]; then
112:         # shellcheck source=/dev/null
113:         source "$main_config"
114:     fi
115: 
116:     if [[ -f "$main_local" ]]; then
117:         # shellcheck source=/dev/null
118:         source "$main_local"
119:     fi
120: 
121:     # Set defaults
122:     : "${LOGIN_ENABLED:=true}"
123:     : "${LOGIN_MODE:=auto}"
124:     : "${LOGIN_AUTO_CHECK_SERVICE:=true}"
125:     : "${LOGIN_AUTO_CHECK_BINARY:=true}"
126:     : "${LOGIN_AUTO_CHECK_EVE_FILE:=true}"
127:     : "${LOGIN_SURICATA_SERVICE_NAME:=suricata}"
128:     : "${LOGIN_SURICATA_BINARY:=/usr/bin/suricata}"
129:     : "${LOGIN_EVE_FRESHNESS_THRESHOLD:=60}"
130:     : "${LOGIN_AUTO_DETECT_SERVICES:=true}"
131:     : "${LOGIN_ACTION_MODE:=both}"
132:     : "${LOGIN_BAN_COMMAND:=${NFTBAN_BIN:-/usr/bin/nftban} ban}"
133:     : "${LOGIN_DEFAULT_BAN_DURATION:=3600}"
134: 
135:     return 0
136: }
137: 
138: # Load mode-specific configuration
139: nftban_login_load_mode_config() {
140:     local mode="$1"
141:     local config_dir="${NFTBAN_LOGIN_CONFIG_DIR}"
142: 
143:     case "$mode" in
144:         classic)
145:             local classic_config="${config_dir}/classic.conf"
146:             local classic_local="${config_dir}/classic.conf.local"
147: 
148:             [[ -f "$classic_config" ]] && source "$classic_config"
149:             [[ -f "$classic_local" ]] && source "$classic_local"
150:             ;;
151:         suricata)
152:             local suricata_config="${config_dir}/suricata.conf"
153:             local suricata_local="${config_dir}/suricata.conf.local"
154: 
155:             [[ -f "$suricata_config" ]] && source "$suricata_config"
156:             [[ -f "$suricata_local" ]] && source "$suricata_local"
157:             ;;
158:         hybrid)
159:             # Load both
160:             nftban_login_load_mode_config "classic"
161:             nftban_login_load_mode_config "suricata"
162:             ;;
163:     esac
164: 
165:     # Load services configuration
166:     local services_config="${config_dir}/services.conf"
167:     local services_local="${config_dir}/services.conf.local"
168: 
169:     [[ -f "$services_config" ]] && source "$services_config"
170:     [[ -f "$services_local" ]] && source "$services_local"
171: 
172:     return 0
173: }
174: 
175: # =============================================================================
176: # MODE DETECTION
177: # =============================================================================
178: 
179: # Check if Suricata binary exists
180: _nftban_login_suricata_binary_exists() {
181:     local binary="${LOGIN_SURICATA_BINARY:-/usr/bin/suricata}"
182:     [[ -x "$binary" ]]
183: }
184: 
185: # Check if Suricata service is running
186: _nftban_login_suricata_service_running() {
187:     local service_name="${LOGIN_SURICATA_SERVICE_NAME:-suricata}"
188: 
189:     # Try systemctl first
190:     if command -v systemctl &>/dev/null; then
191:         if systemctl is-active --quiet "$service_name" 2>/dev/null; then
192:             return 0
193:         fi
194:     fi
195: 
196:     # Fall back to pgrep
197:     if pgrep -x suricata &>/dev/null; then
198:         return 0
199:     fi
200: 
201:     return 1
202: }
203: 
204: # Check if EVE JSON file exists and is fresh
205: _nftban_login_eve_file_fresh() {
206:     local eve_file="${LOGIN_SURICATA_EVE_FILE:-/var/log/suricata/eve.json}"
207:     local threshold="${LOGIN_EVE_FRESHNESS_THRESHOLD:-60}"
208: 
209:     if [[ ! -f "$eve_file" ]]; then
210:         return 1
211:     fi
212: 
213:     local file_mtime
214:     file_mtime=$(stat -c %Y "$eve_file" 2>/dev/null) || return 1
215:     local now
216:     now=$(date +%s)
217:     local age
218:     age=$((now - file_mtime))
219: 
220:     [[ $age -lt $threshold ]]
221: }
222: 
223: # Detect if Suricata is available for login monitoring
224: nftban_login_suricata_available() {
225:     local score=0
226: 
227:     if [[ "${LOGIN_AUTO_CHECK_BINARY:-true}" == "true" ]]; then
228:         _nftban_login_suricata_binary_exists && ((score++))
229:     fi
230: 
231:     if [[ "${LOGIN_AUTO_CHECK_SERVICE:-true}" == "true" ]]; then
232:         _nftban_login_suricata_service_running && ((score++))
233:     fi
234: 
235:     if [[ "${LOGIN_AUTO_CHECK_EVE_FILE:-true}" == "true" ]]; then
236:         _nftban_login_eve_file_fresh && ((score++))
237:     fi
238: 
239:     # Need at least 2 checks to pass
240:     [[ $score -ge 2 ]]
241: }
242: 
243: # Determine which mode to use
244: nftban_login_detect_mode() {
245:     local configured_mode="${LOGIN_MODE:-auto}"
246: 
247:     case "$configured_mode" in
248:         classic)
249:             echo "classic"
250:             ;;
251:         suricata)
252:             # Force Suricata mode - fail if not available
253:             if nftban_login_suricata_available; then
254:                 echo "suricata"
255:             else
256:                 nftban_login_log "ERROR" "Suricata mode forced but Suricata not available"
257:                 return 1
258:             fi
259:             ;;
260:         hybrid)
261:             echo "hybrid"
262:             ;;
263:         auto|*)
264:             # Auto-detect: prefer Suricata if available
265:             if nftban_login_suricata_available; then
266:                 echo "suricata"
267:             else
268:                 echo "classic"
269:             fi
270:             ;;
271:     esac
272: }
273: 
274: # =============================================================================
275: # SERVICE DETECTION
276: # =============================================================================
277: 
278: # Detect installed services that we can monitor
279: nftban_login_detect_services() {
280:     _LOGIN_DETECTED_SERVICES=()
281: 
282:     # SSH - always check
283:     if _nftban_login_service_exists "sshd" || _nftban_login_service_exists "ssh"; then
284:         _LOGIN_DETECTED_SERVICES[ssh]=1
285:     fi
286: 
287:     # Dovecot
288:     if _nftban_login_service_exists "dovecot"; then
289:         _LOGIN_DETECTED_SERVICES[dovecot]=1
290:     fi
291: 
292:     # Exim
293:     if _nftban_login_service_exists "exim" || _nftban_login_service_exists "exim4"; then
294:         _LOGIN_DETECTED_SERVICES[exim]=1
295:     fi
296: 
297:     # Postfix
298:     if _nftban_login_service_exists "postfix"; then
299:         _LOGIN_DETECTED_SERVICES[postfix]=1
300:     fi
301: 
302:     # Pure-FTPd
303:     if _nftban_login_service_exists "pure-ftpd"; then
304:         _LOGIN_DETECTED_SERVICES[pureftpd]=1
305:     fi
306: 
307:     # vsftpd
308:     if _nftban_login_service_exists "vsftpd"; then
309:         _LOGIN_DETECTED_SERVICES[vsftpd]=1
310:     fi
311: 
312:     # ProFTPD
313:     if _nftban_login_service_exists "proftpd"; then
314:         _LOGIN_DETECTED_SERVICES[proftpd]=1
315:     fi
316: 
317:     # Apache
318:     if _nftban_login_service_exists "apache2" || _nftban_login_service_exists "httpd"; then
319:         _LOGIN_DETECTED_SERVICES[apache]=1
320:     fi
321: 
322:     # Nginx
323:     if _nftban_login_service_exists "nginx"; then
324:         _LOGIN_DETECTED_SERVICES[nginx]=1
325:     fi
326: 
327:     # DirectAdmin
328:     if [[ -d "/usr/local/directadmin" ]]; then
329:         _LOGIN_DETECTED_SERVICES[directadmin]=1
330:     fi
331: 
332:     # WordPress - check if Apache/Nginx is running and wp-config.php exists somewhere
333:     if [[ -n "${_LOGIN_DETECTED_SERVICES[apache]:-}" ]] || [[ -n "${_LOGIN_DETECTED_SERVICES[nginx]:-}" ]]; then
334:         if find /var/www -name "wp-config.php" -type f 2>/dev/null | head -1 | grep -q .; then
335:             _LOGIN_DETECTED_SERVICES[wordpress]=1
336:             _LOGIN_DETECTED_SERVICES[xmlrpc]=1
337:         fi
338:     fi
339: 
340:     # Roundcube
341:     if [[ -d "/usr/share/roundcubemail" ]] || [[ -d "/var/lib/roundcube" ]]; then
342:         _LOGIN_DETECTED_SERVICES[roundcube]=1
343:     fi
344: }
345: 
346: # Check if a service exists
347: _nftban_login_service_exists() {
348:     local service="$1"
349: 
350:     # Check systemd
351:     if command -v systemctl &>/dev/null; then
352:         systemctl list-unit-files "${service}.service" 2>/dev/null | grep -q "$service" && return 0
353:     fi
354: 
355:     # Check SysV init
356:     [[ -f "/etc/init.d/$service" ]] && return 0
357: 
358:     # Check binary
359:     command -v "$service" &>/dev/null && return 0
360: 
361:     return 1
362: }
363: 
364: # Get list of detected services
365: nftban_login_get_detected_services() {
366:     echo "${!_LOGIN_DETECTED_SERVICES[@]}"
367: }
368: 
369: # Check if a specific service is detected
370: nftban_login_service_detected() {
371:     local service="$1"
372:     [[ -n "${_LOGIN_DETECTED_SERVICES[$service]:-}" ]]
373: }
374: 
375: # =============================================================================
376: # LOGGING
377: # =============================================================================
378: 
379: nftban_login_log() {
380:     local level="$1"
381:     shift
382:     local message="$*"
383:     local timestamp
384:     timestamp=$(date '+%Y-%m-%d %H:%M:%S')
385: 
386:     # Ensure log directory exists
387:     mkdir -p "$(dirname "$NFTBAN_LOGIN_LOG_FILE")"
388: 
389:     # Log to file
390:     echo "[$timestamp] [$level] $message" >> "$NFTBAN_LOGIN_LOG_FILE"
391: 
392:     # Log to syslog
393:     logger -t "nftban-login" -p "auth.$level" "$message"
394: }
395: 
396: # =============================================================================
397: # INITIALIZATION
398: # =============================================================================
399: 
400: # Initialize the login monitor
401: nftban_login_init() {
402:     [[ $_LOGIN_INITIALIZED -eq 1 ]] && return 0
403: 
404:     nftban_login_log "INFO" "Initializing login monitor..."
405: 
406:     # Load configuration
407:     nftban_login_load_config
408: 
409:     # Check if enabled
410:     if [[ "${LOGIN_ENABLED:-true}" != "true" ]]; then
411:         nftban_login_log "INFO" "Login monitor is disabled in configuration"
412:         return 0
413:     fi
414: 
415:     # Detect mode
416:     _LOGIN_ACTIVE_MODE=$(nftban_login_detect_mode) || return 1
417:     nftban_login_log "INFO" "Selected mode: $_LOGIN_ACTIVE_MODE"
418: 
419:     # Load mode-specific configuration
420:     nftban_login_load_mode_config "$_LOGIN_ACTIVE_MODE"
421: 
422:     # Detect services
423:     if [[ "${LOGIN_AUTO_DETECT_SERVICES:-true}" == "true" ]]; then
424:         nftban_login_detect_services
425:         local services
426:         services=$(nftban_login_get_detected_services)
427:         nftban_login_log "INFO" "Detected services: $services"
428:     fi
429: 
430:     # Ensure directories exist
431:     mkdir -p "$NFTBAN_LOGIN_DATA_DIR" "$NFTBAN_LOGIN_CACHE_DIR"
432: 
433:     # Load the appropriate module
434:     local lib_dir="${NFTBAN_LIB_DIR:-/usr/lib/nftban}"
435: 
436:     case "$_LOGIN_ACTIVE_MODE" in
437:         classic)
438:             if [[ -f "${lib_dir}/core/nftban_login_classic.sh" ]]; then
439:                 source "${lib_dir}/core/nftban_login_classic.sh"
440:                 nftban_login_classic_init
441:             else
442:                 nftban_login_log "ERROR" "Classic module not found"
443:                 return 1
444:             fi
445:             ;;
446:         suricata)
447:             if [[ -f "${lib_dir}/core/nftban_login_suricata.sh" ]]; then
448:                 source "${lib_dir}/core/nftban_login_suricata.sh"
449:                 nftban_login_suricata_init
450:             else
451:                 nftban_login_log "ERROR" "Suricata module not found"
452:                 return 1
453:             fi
454:             ;;
455:         hybrid)
456:             # Load both modules
457:             if [[ -f "${lib_dir}/core/nftban_login_classic.sh" ]]; then
458:                 source "${lib_dir}/core/nftban_login_classic.sh"
459:                 nftban_login_classic_init
460:             fi
461:             if [[ -f "${lib_dir}/core/nftban_login_suricata.sh" ]]; then
462:                 source "${lib_dir}/core/nftban_login_suricata.sh"
463:                 nftban_login_suricata_init
464:             fi
465:             ;;
466:     esac
467: 
468:     _LOGIN_INITIALIZED=1
469:     nftban_login_log "INFO" "Login monitor initialized successfully"
470:     return 0
471: }
472: 
473: # =============================================================================
474: # MAIN OPERATIONS
475: # =============================================================================
476: 
477: # Start monitoring
478: nftban_login_start() {
479:     nftban_login_init || return 1
480: 
481:     if [[ "${LOGIN_ENABLED:-true}" != "true" ]]; then
482:         echo "Login monitor is disabled"
483:         return 0
484:     fi
485: 
486:     nftban_login_banner
487:     echo "Mode: $_LOGIN_ACTIVE_MODE"
488:     echo "Services: $(nftban_login_get_detected_services)"
489:     echo ""
490: 
491:     nftban_login_log "INFO" "Starting login monitor in $_LOGIN_ACTIVE_MODE mode"
492: 
493:     case "$_LOGIN_ACTIVE_MODE" in
494:         classic)
495:             nftban_login_classic_start
496:             ;;
497:         suricata)
498:             nftban_login_suricata_start
499:             ;;
500:         hybrid)
501:             # Start both in background
502:             nftban_login_classic_start &
503:             local classic_pid=$!
504:             nftban_login_suricata_start &
505:             local suricata_pid=$!
506: 
507:             # Wait for both
508:             wait $classic_pid $suricata_pid
509:             ;;
510:     esac
511: }
512: 
513: # Stop monitoring
514: nftban_login_stop() {
515:     nftban_login_log "INFO" "Stopping login monitor"
516: 
517:     case "$_LOGIN_ACTIVE_MODE" in
518:         classic)
519:             nftban_login_classic_stop 2>/dev/null
520:             ;;
521:         suricata)
522:             nftban_login_suricata_stop 2>/dev/null
523:             ;;
524:         hybrid)
525:             nftban_login_classic_stop 2>/dev/null
526:             nftban_login_suricata_stop 2>/dev/null
527:             ;;
528:     esac
529: 
530:     return 0
531: }
532: 
533: # Get status
534: nftban_login_status() {
535:     nftban_login_init || return 1
536: 
537:     nftban_login_banner
538: 
539:     echo "=== Login Monitor Status ==="
540:     echo ""
541:     echo "Enabled:  ${LOGIN_ENABLED:-true}"
542:     echo "Mode:     $_LOGIN_ACTIVE_MODE"
543:     echo "Action:   ${LOGIN_ACTION_MODE:-both}"
544:     echo ""
545: 
546:     echo "=== Suricata Availability ==="
547:     echo -n "Binary:   "
548:     _nftban_login_suricata_binary_exists && echo "✓ Found" || echo "✗ Not found"
549:     echo -n "Service:  "
550:     _nftban_login_suricata_service_running && echo "✓ Running" || echo "✗ Not running"
551:     echo -n "EVE File: "
552:     _nftban_login_eve_file_fresh && echo "✓ Fresh" || echo "✗ Stale/Missing"
553:     echo ""
554: 
555:     echo "=== Detected Services ==="
556:     for service in $(nftban_login_get_detected_services); do
557:         local enabled_var="LOGIN_SERVICE_${service^^}_ENABLED"
558:         local enabled="${!enabled_var:-true}"
559:         local status="enabled"
560:         [[ "$enabled" != "true" ]] && status="disabled"
561:         echo "  $service: $status"
562:     done
563:     echo ""
564: 
565:     # Mode-specific status
566:     case "$_LOGIN_ACTIVE_MODE" in
567:         classic)
568:             if declare -f nftban_login_classic_status &>/dev/null; then
569:                 nftban_login_classic_status
570:             fi
571:             ;;
572:         suricata)
573:             if declare -f nftban_login_suricata_status &>/dev/null; then
574:                 nftban_login_suricata_status
575:             fi
576:             ;;
577:         hybrid)
578:             echo "=== Classic Mode Status ==="
579:             declare -f nftban_login_classic_status &>/dev/null && nftban_login_classic_status
580:             echo ""
581:             echo "=== Suricata Mode Status ==="
582:             declare -f nftban_login_suricata_status &>/dev/null && nftban_login_suricata_status
583:             ;;
584:     esac
585: 
586:     return 0
587: }
588: 
589: # Enable login monitoring
590: nftban_login_enable() {
591:     nftban_login_init || return 1
592: 
593:     nftban_login_log "INFO" "Enabling login monitor"
594: 
595:     case "$_LOGIN_ACTIVE_MODE" in
596:         classic)
597:             nftban_login_classic_enable
598:             ;;
599:         suricata)
600:             nftban_login_suricata_enable
601:             ;;
602:         hybrid)
603:             nftban_login_classic_enable
604:             nftban_login_suricata_enable
605:             ;;
606:     esac
607: 
608:     echo "Login monitor enabled in $_LOGIN_ACTIVE_MODE mode"
609:     return 0
610: }
611: 
612: # Disable login monitoring
613: nftban_login_disable() {
614:     nftban_login_log "INFO" "Disabling login monitor"
615: 
616:     case "$_LOGIN_ACTIVE_MODE" in
617:         classic)
618:             nftban_login_classic_disable 2>/dev/null
619:             ;;
620:         suricata)
621:             nftban_login_suricata_disable 2>/dev/null
622:             ;;
623:         hybrid)
624:             nftban_login_classic_disable 2>/dev/null
625:             nftban_login_suricata_disable 2>/dev/null
626:             ;;
627:     esac
628: 
629:     echo "Login monitor disabled"
630:     return 0
631: }
632: 
633: # =============================================================================
634: # BAN OPERATIONS
635: # =============================================================================
636: 
637: # Ban an IP for login failures
638: nftban_login_ban() {
639:     local ip="$1"
640:     local reason="${2:-login_brute_force}"
641:     local duration="${3:-${LOGIN_DEFAULT_BAN_DURATION:-3600}}"
642:     local service="${4:-unknown}"
643: 
644:     if [[ "${LOGIN_ACTION_MODE:-both}" == "alert" ]]; then
645:         nftban_login_log "INFO" "Would ban $ip (alert-only mode)"
646:         return 0
647:     fi
648: 
649:     nftban_login_log "INFO" "Banning $ip for $duration seconds (service: $service, reason: $reason)"
650: 
651:     # Use nftban ban command
652:     local ban_cmd="${LOGIN_BAN_COMMAND:-${NFTBAN_BIN:-/usr/bin/nftban} ban}"
653: 
654:     if $ban_cmd "$ip" --timeout "$duration" --reason "${LOGIN_BAN_REASON_PREFIX:-login-monitor}:${reason}" --source "$service" 2>/dev/null; then
655:         nftban_login_log "INFO" "Successfully banned $ip"
656:         return 0
657:     else
658:         nftban_login_log "ERROR" "Failed to ban $ip"
659:         return 1
660:     fi
661: }
662: 
663: # =============================================================================
664: # CLI INTERFACE
665: # =============================================================================
666: 
667: # Main entry point for CLI
668: nftban_login_main() {
669:     local cmd="${1:-status}"
670:     shift || true
671: 
672:     case "$cmd" in
673:         start)
674:             nftban_login_start "$@"
675:             ;;
676:         stop)
677:             nftban_login_stop "$@"
678:             ;;
679:         status)
680:             nftban_login_status "$@"
681:             ;;
682:         enable)
683:             nftban_login_enable "$@"
684:             ;;
685:         disable)
686:             nftban_login_disable "$@"
687:             ;;
688:         services)
689:             nftban_login_init
690:             echo "Detected services:"
691:             for service in $(nftban_login_get_detected_services); do
692:                 echo "  - $service"
693:             done
694:             ;;
695:         test)
696:             nftban_login_test "$@"
697:             ;;
698:         help|--help|-h)
699:             nftban_login_help
700:             ;;
701:         *)
702:             echo "Unknown command: $cmd"
703:             nftban_login_help
704:             return 1
705:             ;;
706:     esac
707: }
708: 
709: # Help message
710: nftban_login_help() {
711:     cat <<'HELP'
712: NFTBan Login Monitor - Dual-Mode (Classic/Suricata)
713: 
714: USAGE:
715:     nftban login <command> [options]
716: 
717: COMMANDS:
718:     status      Show login monitor status (default)
719:     start       Start login monitoring
720:     stop        Stop login monitoring
721:     enable      Enable login protection
722:     disable     Disable login protection
723:     services    List detected services
724:     test        Test login alert system
725:     help        Show this help message
726: 
727: MODES:
728:     auto        Auto-detect Suricata, fallback to Classic
729:     classic     Force journalctl/log parsing mode
730:     suricata    Force Suricata EVE JSON mode
731:     hybrid      Use both for maximum detection
732: 
733: CONFIGURATION:
734:     /etc/nftban/conf.d/login/main.conf      Main configuration
735:     /etc/nftban/conf.d/login/classic.conf   Classic mode settings
736:     /etc/nftban/conf.d/login/suricata.conf  Suricata mode settings
737:     /etc/nftban/conf.d/login/services.conf  Per-service settings
738: 
739: EXAMPLES:
740:     nftban login status
741:     nftban login start
742:     nftban login services
743: 
744: HELP
745: }
746: 
747: # Test function
748: nftban_login_test() {
749:     nftban_login_init || return 1
750: 
751:     echo "Testing NFTBan Login Monitor"
752:     echo "============================"
753:     echo ""
754: 
755:     echo "Configuration:"
756:     echo "  Enabled: ${LOGIN_ENABLED:-true}"
757:     echo "  Mode: $_LOGIN_ACTIVE_MODE"
758:     echo "  Action: ${LOGIN_ACTION_MODE:-both}"
759:     echo ""
760: 
761:     echo "Detected Services:"
762:     for service in $(nftban_login_get_detected_services); do
763:         echo "  ✓ $service"
764:     done
765:     echo ""
766: 
767:     # Test mode-specific
768:     case "$_LOGIN_ACTIVE_MODE" in
769:         classic)
770:             declare -f nftban_login_classic_test &>/dev/null && nftban_login_classic_test
771:             ;;
772:         suricata)
773:             declare -f nftban_login_suricata_test &>/dev/null && nftban_login_suricata_test
774:             ;;
775:     esac
776: 
777:     echo "✓ Test complete"
778: }
779: 
780: # =============================================================================
781: # EXPORTS
782: # =============================================================================
783: 
784: export -f nftban_login_banner
785: export -f nftban_login_load_config
786: export -f nftban_login_load_mode_config
787: export -f nftban_login_suricata_available
788: export -f nftban_login_detect_mode
789: export -f nftban_login_detect_services
790: export -f nftban_login_get_detected_services
791: export -f nftban_login_service_detected
792: export -f nftban_login_log
793: export -f nftban_login_init
794: export -f nftban_login_start
795: export -f nftban_login_stop
796: export -f nftban_login_status
797: export -f nftban_login_enable
798: export -f nftban_login_disable
799: export -f nftban_login_ban
800: export -f nftban_login_main
801: export -f nftban_login_help
802: export -f nftban_login_test
</file>

<file path="cli/lib/nftban/core/nftban_mail.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - Mail Core Module
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Email sending mechanism for all NFTBan modules
  7: #
  8: # meta:name=nftban_mail
  9: # meta:type=core
 10: # meta:header=Mail Module
 11: # meta:version=1.0.0
 12: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 13: # meta:homepage=https://nftban.com
 14: #
 15: # **Description & Purpose**
 16: # meta:description=Provides email sending capabilities for all modules
 17: # meta:input=Email content (text or file path), recipient
 18: # meta:output=Sent emails with HTML templates
 19: #
 20: # **Inventory & Requirements**
 21: # meta:depends=bash,sendmail,nft,hostname
 22: #
 23: # meta:created_date=2025-11-05
 24: # meta:updated_date=2025-11-24
 25: # =============================================================================
 26: 
 27: 
 28: # =============================================================================
 29: # MAIL SYSTEM DETECTION
 30: # =============================================================================
 31: 
 32: nftban_mail_detect_mta() {
 33:     # Detect available Mail Transfer Agent
 34:     # Returns: "postfix", "sendmail", "exim", "msmtp", "curl", "mailx", or "none"
 35:     #
 36:     # Priority order:
 37:     #   1. postfix (local MTA, fastest)
 38:     #   2. sendmail (local MTA)
 39:     #   3. exim (local MTA)
 40:     #   4. msmtp (lightweight relay)
 41:     #   5. curl (direct SMTP - no local MTA needed)
 42:     #   6. mailx (basic fallback)
 43:     #
 44:     # Force specific method via NFTBAN_MAIL_METHOD config
 45: 
 46:     # If user explicitly set a method, use it (after checking availability)
 47:     if [[ -n "${NFTBAN_MAIL_METHOD:-}" ]]; then
 48:         case "${NFTBAN_MAIL_METHOD}" in
 49:             postfix|sendmail|exim|msmtp|curl|mailx)
 50:                 # Verify the requested method is available
 51:                 if _nftban_mail_method_available "${NFTBAN_MAIL_METHOD}"; then
 52:                     echo "${NFTBAN_MAIL_METHOD}"
 53:                     return 0
 54:                 else
 55:                     [[ "${NFTBAN_MAIL_DEBUG:-false}" == "true" ]] && \
 56:                         echo "[DEBUG] Requested method ${NFTBAN_MAIL_METHOD} not available, auto-detecting" >&2
 57:                 fi
 58:                 ;;
 59:         esac
 60:     fi
 61: 
 62:     # Auto-detect: Check Postfix (highest priority - local MTA)
 63:     if [[ -x /usr/sbin/postfix ]]; then
 64:         if systemctl is-active postfix &>/dev/null 2>&1 || pgrep -x master &>/dev/null; then
 65:             echo "postfix"
 66:             return 0
 67:         fi
 68:     fi
 69: 
 70:     # Check Sendmail
 71:     if [[ -x /usr/sbin/sendmail ]]; then
 72:         if pgrep -x sendmail &>/dev/null || [[ -f /var/run/sendmail.pid ]]; then
 73:             echo "sendmail"
 74:             return 0
 75:         fi
 76:         # Sendmail binary exists even if not running - check if it's actually sendmail or postfix wrapper
 77:         if /usr/sbin/sendmail -bv root &>/dev/null; then
 78:             echo "sendmail"
 79:             return 0
 80:         fi
 81:     fi
 82: 
 83:     # Check Exim
 84:     if [[ -x /usr/sbin/exim ]] || [[ -x /usr/sbin/exim4 ]]; then
 85:         if pgrep -x exim &>/dev/null || systemctl is-active exim4 &>/dev/null 2>&1; then
 86:             echo "exim"
 87:             return 0
 88:         fi
 89:     fi
 90: 
 91:     # Check msmtp (lightweight SMTP relay client)
 92:     if [[ -x /usr/bin/msmtp ]] && [[ -f /etc/msmtprc || -f ~/.msmtprc ]]; then
 93:         echo "msmtp"
 94:         return 0
 95:     fi
 96: 
 97:     # Check curl with SMTP config (direct SMTP - no local MTA required)
 98:     if command -v curl &>/dev/null && [[ -n "${NFTBAN_SMTP_HOST:-}" ]]; then
 99:         echo "curl"
100:         return 0
101:     fi
102: 
103:     # Check mailx (basic fallback)
104:     if [[ -x /usr/bin/mailx ]] || [[ -x /bin/mailx ]]; then
105:         echo "mailx"
106:         return 0
107:     fi
108: 
109:     # No mail system found
110:     echo "none"
111:     return 1
112: }
113: 
114: # Helper: Check if specific mail method is available
115: _nftban_mail_method_available() {
116:     local method="$1"
117:     case "$method" in
118:         postfix)
119:             [[ -x /usr/sbin/postfix ]] && \
120:                 (systemctl is-active postfix &>/dev/null 2>&1 || pgrep -x master &>/dev/null)
121:             ;;
122:         sendmail)
123:             [[ -x /usr/sbin/sendmail ]]
124:             ;;
125:         exim)
126:             [[ -x /usr/sbin/exim ]] || [[ -x /usr/sbin/exim4 ]]
127:             ;;
128:         msmtp)
129:             [[ -x /usr/bin/msmtp ]] && [[ -f /etc/msmtprc || -f ~/.msmtprc ]]
130:             ;;
131:         curl)
132:             command -v curl &>/dev/null && [[ -n "${NFTBAN_SMTP_HOST:-}" ]]
133:             ;;
134:         mailx)
135:             [[ -x /usr/bin/mailx ]] || [[ -x /bin/mailx ]]
136:             ;;
137:         *)
138:             return 1
139:             ;;
140:     esac

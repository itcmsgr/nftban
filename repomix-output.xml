2804:     local nftban_uid nftban_gid nftban_auditors_gid
2805:     nftban_uid=$(id -u nftban 2>/dev/null || echo "MISSING")
2806:     nftban_gid=$(id -g nftban 2>/dev/null || echo "MISSING")

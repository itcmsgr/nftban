172:         echo "$NFTBAN_VERSION"
173:     elif command -v nftban >/dev/null 2>&1; then
174:         nftban --version 2>/dev/null | sed -n 's/.*\([0-9]\+\.[0-9]\+\.[0-9]\+\).*/\1/p' || echo "0.31.0"
175:     else
176:         echo "0.31.0"
177:     fi

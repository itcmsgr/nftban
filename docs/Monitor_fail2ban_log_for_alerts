1. Create a Custom "Alert-Only" Action
Create /etc/fail2ban/action.d/alert-only.conf:

ini
[Definition]

# Action for when monitoring starts
actionstart = 
    if [ "%(<notify_start>s)" = "true" ]; then
        printf "Fail2Ban alert monitoring %(<name>)s started at %(timestamp)s\n" | 
        mail -s "Fail2Ban Alert: %(<name>)s monitoring started" "%(<destemail>)s"
    fi

# Action for when monitoring stops
actionstop = 
    if [ "%(<notify_stop>s)" = "true" ]; then
        printf "Fail2Ban alert monitoring %(<name>)s stopped at %(timestamp)s\n" | 
        mail -s "Fail2Ban Alert: %(<name>)s monitoring stopped" "%(<destemail>)s"
    fi

# Main action - sends alert but DOES NOT BAN
actionban = 
    IP=<ip>
    SUBJECT="ALERT: Successful login detected on %(<name>)s"
    BODY="SUCCESSFUL LOGIN ALERT:\n\n"
    BODY="$BODY IP: $IP\n"
    BODY="$BODY Host: %(<host>)s\n"
    BODY="$BODY User: %(<user>)s\n"
    BODY="$BODY Service: %(<name>)s\n"
    BODY="$BODY Time: %(timestamp)s\n"
    BODY="$BODY Log: %(<logpath>)s\n"
    
    # Add whois info if enabled
    if [ "%(<include_whois>s)" = "true" ] && [ -x "$(command -v whois)" ]; then
        WHOIS=$(whois $IP 2>/dev/null | head -20)
        BODY="$BODY\nWhois Info:\n$WHOIS\n"
    fi
    
    printf "$BODY" | mail -s "$SUBJECT" "%(<destemail>)s"
    
    echo "Alert sent for successful login from IP: $IP"

# No unban action needed since we don't ban
actionunban =


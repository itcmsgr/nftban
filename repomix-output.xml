<file path="cmd/nftban-core/systemd/nftban-core-feeds.service">
 1: [Unit]
 2: Description=NFTBan Core - Feed Update
 3: Documentation=https://github.com/itcmsgr/nftban-dev
 4: After=network-online.target nftban-core.service
 5: Requires=nftban-core.service
 6: 
 7: [Service]
 8: Type=oneshot
 9: # Log to both journal AND file for easy viewing
10: ExecStart=/bin/bash -c '/usr/local/bin/nftban-core feeds load 2>&1 | tee -a /var/log/nftban/feeds.log'
11: StandardOutput=journal
12: StandardError=journal
13: SyslogIdentifier=nftban-feeds
14: 
15: # Security hardening
16: NoNewPrivileges=true
17: PrivateTmp=true
18: ProtectSystem=strict
19: ProtectHome=true
20: ReadWritePaths=/etc/nftban /var/lib/nftban /var/log/nftban
21: ProtectKernelTunables=true
22: ProtectKernelModules=true
23: ProtectControlGroups=true
24: RestrictRealtime=true
25: RestrictNamespaces=true
26: LockPersonality=true
27: # IMPORTANT: MemoryDenyWriteExecute is intentionally NOT set for Go services.
28: # It breaks Go runtime on Ubuntu 24.04 (AppArmor + Landlock) and potentially
29: # future SELinux-enforcing distributions. Security is maintained through
30: # other hardening measures. See: docs/architecture/SYSTEMD_GO_HARDENING.md
31: RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
32: SystemCallFilter=@system-service
33: SystemCallErrorNumber=EPERM
34: 
35: # Resource limits
36: CPUQuota=80%
37: MemoryMax=512M
38: TasksMax=20
39: TimeoutStartSec=15min
40: 
41: [Install]
42: WantedBy=multi-user.target
</file>


<file path="cmd/nftban-core/cmd_sync.go">
  1: package main
  2: 
  3: import (
  4: 	"fmt"
  5: 	"strings"
  6: 
  7: 	"github.com/google/nftables"
  8: 	"github.com/itcmsgr/nftban/pkg/nftbanconf"
  9: 	"github.com/itcmsgr/nftban/pkg/ports"
 10: 	"github.com/itcmsgr/nftban/pkg/runtime"
 11: 	"github.com/itcmsgr/nftban/pkg/sync"
 12: 	"github.com/itcmsgr/nftban/pkg/version"
 13: )
 14: 
 15: // getSyncConfigDir returns the config directory from passed config
 16: func getSyncConfigDir(cfg *nftbanconf.Config) string {
 17: 	return cfg.ConfigDir
 18: }
 19: 
 20: func cmdSync(cfg *nftbanconf.Config) error {
 21: 	// Check for privilege (root OR CAP_NET_ADMIN capability)
 22: 	if err := checkPrivilege(); err != nil {
 23: 		return err
 24: 	}
 25: 
 26: 	fmt.Println(version.BannerWithEmoji("🔄", "Differential Sync"))
 27: 	fmt.Println(strings.Repeat("=", 70))
 28: 	fmt.Println()
 29: 
 30: 	// Initialize RuntimeState
 31: 	fmt.Println("Step 1: Loading current state from config files...")
 32: 	state := runtime.NewRuntimeState(getSyncConfigDir(cfg))
 33: 
 34: 	if err := state.LoadWhitelists(); err != nil {
 35: 		return fmt.Errorf("failed to load whitelists: %w", err)
 36: 	}
 37: 	fmt.Printf("  ✅ Loaded %d IPv4 + %d IPv6 whitelist entries\n",
 38: 		len(state.WhitelistIPv4), len(state.WhitelistIPv6))
 39: 
 40: 	if err := state.LoadBlacklists(); err != nil {
 41: 		return fmt.Errorf("failed to load blacklists: %w", err)
 42: 	}
 43: 	fmt.Printf("  ✅ Loaded %d IPv4 + %d IPv6 blacklist entries\n",
 44: 		len(state.BlacklistIPv4), len(state.BlacklistIPv6))
 45: 	fmt.Println()
 46: 
 47: 	// Load ports from ALL sources (ports.d/ + enabled panel configs)
 48: 	fmt.Println("Step 1.5: Loading port configurations...")
 49: 	configDir := getSyncConfigDir(cfg)
 50: 	allPorts, err := ports.LoadAllPorts(configDir)
 51: 	if err != nil {
 52: 		return fmt.Errorf("failed to load ports: %w", err)
 53: 	}
 54: 
 55: 	// Show port statistics
 56: 	if len(allPorts.AllRules) > 0 {
 57: 		fmt.Printf("  ✅ Loaded %d TCP ports + %d UDP ports from:\n",
 58: 			len(allPorts.TCPPorts), len(allPorts.UDPPorts))
 59: 
 60: 		// Count sources
 61: 		customCount := 0
 62: 		panelCount := 0
 63: 		for _, rule := range allPorts.AllRules {
 64: 			if strings.HasPrefix(rule.Source, "panel:") {
 65: 				panelCount++
 66: 			} else {
 67: 				customCount++
 68: 			}
 69: 		}
 70: 
 71: 		if customCount > 0 {
 72: 			fmt.Printf("     - Custom ports (ports.d/): %d rules\n", customCount)
 73: 		}
 74: 		if panelCount > 0 {
 75: 			fmt.Printf("     - Panel ports (enabled panels): %d rules\n", panelCount)
 76: 		}
 77: 	} else {
 78: 		fmt.Println("  ℹ️  No port rules configured")
 79: 	}
 80: 	fmt.Println()
 81: 
 82: 	// Initialize nftables connection
 83: 	fmt.Println("Step 2: Connecting to nftables via netlink...")
 84: 	nft, err := sync.NewNFTManager()
 85: 	if err != nil {
 86: 		return fmt.Errorf("failed to create nftables manager: %w", err)
 87: 	}
 88: 	defer nft.Close()
 89: 	fmt.Println("  ✅ Connected to nftables")
 90: 	fmt.Println()
 91: 
 92: 	// Get or create nftban table (IPv4)
 93: 	fmt.Println("Step 3: Preparing nftables infrastructure...")
 94: 	tableIPv4, err := nft.GetOrCreateTable(nftables.TableFamilyIPv4)
 95: 	if err != nil {
 96: 		return fmt.Errorf("failed to get/create IPv4 table: %w", err)
 97: 	}
 98: 	fmt.Printf("  ✅ Table 'nftban' (IPv4) ready\n")
 99: 
100: 	// Get or create nftban table (IPv6)
101: 	tableIPv6, err := nft.GetOrCreateTable(nftables.TableFamilyIPv6)
102: 	if err != nil {
103: 		return fmt.Errorf("failed to get/create IPv6 table: %w", err)
104: 	}
105: 	fmt.Printf("  ✅ Table 'nftban' (IPv6) ready\n")
106: 
107: 	// Create sets (use IntervalSet for whitelists to support CIDR ranges)
108: 	whitelistIPv4Set, err := nft.GetOrCreateIntervalSet(tableIPv4, "whitelist_ipv4", true)
109: 	if err != nil {
110: 		return fmt.Errorf("failed to get/create whitelist_ipv4 set: %w", err)
111: 	}
112: 	fmt.Printf("  ✅ Set 'whitelist_ipv4' ready\n")
113: 
114: 	whitelistIPv6Set, err := nft.GetOrCreateIntervalSet(tableIPv6, "whitelist_ipv6", false)
115: 	if err != nil {
116: 		return fmt.Errorf("failed to get/create whitelist_ipv6 set: %w", err)
117: 	}
118: 	fmt.Printf("  ✅ Set 'whitelist_ipv6' ready\n")
119: 
120: 	blacklistIPv4Set, err := nft.GetOrCreateSet(tableIPv4, "blacklist_ipv4", true)
121: 	if err != nil {
122: 		return fmt.Errorf("failed to get/create blacklist_ipv4 set: %w", err)
123: 	}
124: 	fmt.Printf("  ✅ Set 'blacklist_ipv4' ready\n")
125: 
126: 	blacklistIPv6Set, err := nft.GetOrCreateSet(tableIPv6, "blacklist_ipv6", false)
127: 	if err != nil {
128: 		return fmt.Errorf("failed to get/create blacklist_ipv6 set: %w", err)
129: 	}
130: 	fmt.Printf("  ✅ Set 'blacklist_ipv6' ready\n")
131: 
132: 	// Create and populate port sets (if we have ports to load)
133: 	if len(allPorts.AllRules) > 0 {
134: 		fmt.Println()
135: 		fmt.Println("  Creating port sets...")
136: 
137: 		// TCP ports
138: 		tcpSetV4, err := nft.GetOrCreatePortSet(tableIPv4, "tcp_ports")
139: 		if err != nil {
140: 			return fmt.Errorf("failed to create IPv4 tcp_ports set: %w", err)
141: 		}
142: 		fmt.Printf("  ✅ Set 'tcp_ports' (IPv4) ready\n")
143: 
144: 		tcpSetV6, err := nft.GetOrCreatePortSet(tableIPv6, "tcp_ports")
145: 		if err != nil {
146: 			return fmt.Errorf("failed to create IPv6 tcp_ports set: %w", err)
147: 		}
148: 		fmt.Printf("  ✅ Set 'tcp_ports' (IPv6) ready\n")
149: 
150: 		// UDP ports
151: 		udpSetV4, err := nft.GetOrCreatePortSet(tableIPv4, "udp_ports")
152: 		if err != nil {
153: 			return fmt.Errorf("failed to create IPv4 udp_ports set: %w", err)
154: 		}
155: 		fmt.Printf("  ✅ Set 'udp_ports' (IPv4) ready\n")
156: 
157: 		udpSetV6, err := nft.GetOrCreatePortSet(tableIPv6, "udp_ports")
158: 		if err != nil {
159: 			return fmt.Errorf("failed to create IPv6 udp_ports set: %w", err)
160: 		}
161: 		fmt.Printf("  ✅ Set 'udp_ports' (IPv6) ready\n")
162: 
163: 		// Load ports into sets
164: 		if len(allPorts.TCPPorts) > 0 {
165: 			if err := nft.AddPortElements(tcpSetV4, allPorts.TCPPorts); err != nil {
166: 				return fmt.Errorf("failed to add IPv4 TCP ports: %w", err)
167: 			}
168: 			if err := nft.AddPortElements(tcpSetV6, allPorts.TCPPorts); err != nil {
169: 				return fmt.Errorf("failed to add IPv6 TCP ports: %w", err)
170: 			}
171: 			fmt.Printf("  ✅ Loaded %d TCP ports into both IPv4 and IPv6 sets\n", len(allPorts.TCPPorts))
172: 		}
173: 
174: 		if len(allPorts.UDPPorts) > 0 {
175: 			if err := nft.AddPortElements(udpSetV4, allPorts.UDPPorts); err != nil {
176: 				return fmt.Errorf("failed to add IPv4 UDP ports: %w", err)
177: 			}
178: 			if err := nft.AddPortElements(udpSetV6, allPorts.UDPPorts); err != nil {
179: 				return fmt.Errorf("failed to add IPv6 UDP ports: %w", err)
180: 			}
181: 			fmt.Printf("  ✅ Loaded %d UDP ports into both IPv4 and IPv6 sets\n", len(allPorts.UDPPorts))
182: 		}
183: 	}
184: 
185: 	fmt.Println()
186: 
187: 	// Get snapshots from runtime state
188: 	fmt.Println("Step 4: Performing differential sync...")
189: 	whitelistIPv4, whitelistIPv6 := state.GetWhitelistSnapshot()
190: 	blacklistIPv4, blacklistIPv6 := state.GetBlacklistSnapshot()
191: 
192: 	// Perform full sync
193: 	result, err := sync.FullSync(
194: 		nft,
195: 		whitelistIPv4Set, whitelistIPv6Set,
196: 		blacklistIPv4Set, blacklistIPv6Set,
197: 		whitelistIPv4, whitelistIPv6,
198: 		blacklistIPv4, blacklistIPv6,
199: 	)
200: 
201: 	if err != nil {
202: 		return fmt.Errorf("sync failed: %w", err)
203: 	}
204: 
205: 	// Update counters
206: 	state.IncrementSyncCounter(result.Success)
207: 
208: 	// Print results
209: 	sync.PrintSyncResult(result)
210: 
211: 	fmt.Println()
212: 	fmt.Println(strings.Repeat("=", 70))
213: 
214: 	if result.Success {
215: 		fmt.Println("✅ Sync completed successfully!")
216: 		fmt.Println()
217: 		fmt.Println("Firewall is now in sync with configuration files.")
218: 		fmt.Println()
219: 
220: 		// Print efficiency metrics
221: 		if result.WhitelistIPv4 != nil {
222: 			eff := sync.GetSyncEfficiency(result.WhitelistIPv4)
223: 			fmt.Printf("Whitelist IPv4 efficiency: %.1f%% already in sync\n", eff)
224: 		}
225: 		if result.BlacklistIPv4 != nil {
226: 			eff := sync.GetSyncEfficiency(result.BlacklistIPv4)
227: 			fmt.Printf("Blacklist IPv4 efficiency: %.1f%% already in sync\n", eff)
228: 		}
229: 	} else {
230: 		fmt.Println("❌ Sync encountered errors!")
231: 		return fmt.Errorf("sync failed")
232: 	}
233: 
234: 	fmt.Println()
235: 	return nil
236: }
</file>


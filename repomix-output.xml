425: nftban_geoban_fetch_country() {
426:     # Smart fetch: Try Go first, fallback to bash
427:     # Args: $1 = country code, $2 = action (ban/whitelist)
428:     # Returns: 0 if success, 1 if failed
429: 
430:     local cc="$1"
431:     local action="${2:-ban}"
432: 
433:     # Try Go binary first if available
434:     if nftban_geoban_check_binary_soft; then
435:         nftban_info "Using Go binary for fast loading (recommended)"
436: 
437:         if "${GEOIP_BINARY}" geoban fetch "${cc}" \
438:             --action "$action" \
439:             --atomic="${GEOBAN_ATOMIC}" \
440:             --files-dir="${GEOBAN_FILES_DIR}" \
441:             --tracking-dir="${GEOBAN_TRACKING_DIR}" \
442:             --cache-dir="${GEOBAN_CACHE_DIR}" 2>&1; then
443:             return 0
444:         else
445:             nftban_warn "Go binary failed, falling back to bash mode"
446:         fi
447:     else
448:         nftban_info "Go binary not found - using bash fallback (slower but works)"
449:     fi
450: 
451:     # Bash fallback: download from IPDENY
452:     nftban_geoban_fetch_bash "$cc" "$action"
453:     return $?
454: }

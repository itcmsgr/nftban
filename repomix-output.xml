 31: 
 32: [[ -z "${NFTBAN_LIB_DIR:-}" ]] && readonly NFTBAN_LIB_DIR="/usr/lib/nftban"
 33: 
 34: # Load strict mode library
 35: # shellcheck source=/usr/lib/nftban/lib/strict.sh
 36: if [[ -f "${NFTBAN_LIB_DIR}/lib/strict.sh" ]]; then
 37:     source "${NFTBAN_LIB_DIR}/lib/strict.sh"
 38: else
 39:     # Fallback to manual strict mode
 40:     set -Eeuo pipefail
 41: fi
 42: 
 43: # Load version library
 44: # shellcheck source=/usr/lib/nftban/lib/version.sh
 45: if [[ -f "${NFTBAN_LIB_DIR}/lib/version.sh" ]]; then
 46:     source "${NFTBAN_LIB_DIR}/lib/version.sh"
 47: fi
 48: 
 49: # Load JSON helper for --json support
 50: JSON_HELPER="${NFTBAN_LIB_DIR}/helpers/json_output.sh"
 51: if [[ -f "$JSON_HELPER" ]]; then
 52:     # shellcheck source=/dev/null
 53:     source "$JSON_HELPER"
 54: fi
 55: 
 56: # =============================================================================
 57: # HELPER FUNCTIONS
 58: # =============================================================================
 59: 
 60: test_cmd() {
 61:     local name="$1"
 62:     local cmd="$2"
 63: 
 64:     total=$((total + 1))
 65: 
 66:     # Run command with timeout
 67:     local output
 68:     local exit_code=0
 69:     local tmp_out="/tmp/nftban_quick_test_$$.txt"
 70: 
 71:     # Use timeout and redirect to file to avoid pipe issues
 72:     # 20 second timeout to handle commands with network checks (like status)
 73:     timeout 20 bash -c "$cmd" > "$tmp_out" 2>&1 || exit_code=$?
 74: 
 75:     # Read output from file
 76:     if [[ -f "$tmp_out" ]]; then
 77:         output=$(cat "$tmp_out")
 78:         rm -f "$tmp_out"
 79:     fi
 80: 
 81:     # Check for timeout
 82:     if [[ $exit_code -eq 124 ]]; then
 83:         echo "  ⏱  $name - TIMEOUT"
 84:         failed=$((failed + 1))
 85:         if [[ "$verbose" == "true" ]]; then
 86:             echo "      Command: $cmd"
 87:         fi
 88:         return 1
 89:     fi
 90: 
 91:     # Check for output
 92:     if [[ -z "$output" ]]; then
 93:         echo "  ∅  $name - NO OUTPUT"
 94:         failed=$((failed + 1))
 95:         if [[ "$verbose" == "true" ]]; then
 96:             echo "      Command: $cmd"
 97:         fi
 98:         return 1
 99:     fi
100: 
101:     # Check for exit marker or formatting
102:     if echo "$output" | grep -q "NFTBAN_CMD_EXIT\|═\|NFTBan\|nftban"; then
103:         echo "  ✓  $name"
104:         passed=$((passed + 1))
105:         return 0
106:     else
107:         echo "  ⚠  $name - no markers"
108:         passed=$((passed + 1))  # Still count as passed
109:         return 0
110:     fi
111: }
112: 
113: # =============================================================================
114: # QUICK TEST FUNCTION
115: # =============================================================================
116: 
117: nftban_cmd_test() {
118:     # Quick validation of critical CLI commands
119:     # Args: [--verbose]
120: 
121:     local verbose=false
122: 
123:     # Parse arguments
124:     while [[ $# -gt 0 ]]; do
125:         case "$1" in
126:             --verbose|-v)
127:                 verbose=true
128:                 shift
129:                 ;;
130:             help|--help|-h)
131:                 show_usage
132:                 return 0
133:                 ;;
134:             *)
135:                 echo "ERROR: Unknown option: $1" >&2
136:                 echo "" >&2
137:                 show_usage
138:                 return 1
139:                 ;;
140:         esac
141:     done
142: 
143:     # Show banner
144:     if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_output.sh" ]]; then
145:         # shellcheck source=/dev/null
146:         source "${NFTBAN_LIB_DIR}/core/nftban_output.sh"
147:         if [[ $(type -t nftban_banner) == "function" ]]; then
148:             nftban_banner
149:         fi
150:     fi
151:     echo ""
152: 
153:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
154:     echo "NFTBan Command Testing"
155:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
156:     echo ""
157:     echo "Testing critical commands..."
158:     echo ""
159: 
160:     local total=0
161:     local passed=0
162:     local failed=0
163: 
164:     # Test commands - grouped by category
165:     echo "Core Commands:"
166:     test_cmd "status --quiet" "nftban status --quiet"
167:     test_cmd "health" "nftban health"
168:     test_cmd "check" "nftban check"
169:     test_cmd "version" "nftban version"
170:     echo ""
171: 
172:     echo "Firewall & Security:"
173:     test_cmd "firewall status" "nftban firewall status"
174:     test_cmd "list banned" "nftban list banned"
175:     test_cmd "list whitelist" "nftban list whitelist"
176:     test_cmd "search 8.8.8.8" "nftban search 8.8.8.8"
177:     echo ""
178: 
179:     echo "Protection Modules:"
180:     test_cmd "ddos status" "nftban ddos status"
181:     test_cmd "portscan status" "nftban portscan status"
182:     test_cmd "login status" "nftban login status"
183:     test_cmd "feeds status" "nftban feeds status"
184:     echo ""
185: 
186:     echo "GeoIP & Monitoring:"
187:     test_cmd "geoip status" "nftban geoip status"
188:     test_cmd "stats dashboard" "nftban stats dashboard"
189:     test_cmd "metrics status" "nftban metrics status"
190:     echo ""
191: 
192:     echo "System & Config:"
193:     test_cmd "permissions check" "nftban permissions check"
194:     test_cmd "fhs check" "nftban fhs check"
195:     test_cmd "nftables status" "nftban nftables status"
196:     test_cmd "services" "nftban services"
197: 
198:     echo ""
199:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
200:     echo "Results: $passed/$total passed"
201: 
202:     if [[ $failed -eq 0 ]]; then
203:         echo "Status: ✅ ALL TESTS PASSED"
204:         echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
205:         echo ""
206:         command -v nftban_cmd_exit >/dev/null 2>&1 && nftban_cmd_exit "test"
207:         return 0
208:     else
209:         echo "Status: ❌ $failed TESTS FAILED"
210:         echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
211:         echo ""
212:         local tests_dir="${NFTBAN_TESTS_DIR:-/usr/lib/nftban/tests}"
213:         echo "Run 'bash ${tests_dir}/test_all_commands.sh' for detailed testing"
214:         echo ""
215:         command -v nftban_cmd_exit >/dev/null 2>&1 && nftban_cmd_exit "test"
216:         return 1
217:     fi
218: }
219: 
220: show_usage() {
221:     cat <<'EOF'
222: nftban test — Quick validation of CLI commands
223: 
224: USAGE:
225:   nftban test [OPTIONS]
226: 
227: OPTIONS:
228:   -v, --verbose   Show detailed output for failures
229:   -h, --help      Show this help
230: 
231: DESCRIPTION:
232:   Runs a quick test of critical CLI commands to detect failures.
233:   This is useful for:

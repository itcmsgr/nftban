 418: # Get connection statistics using ss
 419: get_connection_stats() {
 420:     local state=$1
 421: 
 422:     if ! command -v ss &>/dev/null; then
 423:         echo "0"
 424:         return
 425:     fi
 426: 
 427:     local count
 428:     case "$state" in
 429:         active)
 430:             count=$(ss -tan 2>/dev/null | grep -cE "ESTAB|SYN-SENT|SYN-RECV|FIN-WAIT|CLOSE-WAIT|TIME-WAIT" || true)
 431:             ;;
 432:         established)
 433:             count=$(ss -tan 2>/dev/null | grep -c "ESTAB" || true)
 434:             ;;
 435:         time_wait)
 436:             count=$(ss -tan 2>/dev/null | grep -c "TIME-WAIT" || true)
 437:             ;;
 438:         close_wait)
 439:             count=$(ss -tan 2>/dev/null | grep -c "CLOSE-WAIT" || true)
 440:             ;;
 441:         *)
 442:             count=0
 443:             ;;
 444:     esac
 445:     echo "${count:-0}"
 446: }

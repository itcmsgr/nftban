 358: # Get protocol statistics from /proc/net/snmp
 359: get_protocol_stats() {
 360:     local protocol=$1
 361:     local metric=$2  # bytes or packets
 362: 
 363:     case "$protocol" in
 364:         tcp)
 365:             if [[ "$metric" == "bytes" ]]; then
 366:                 local in_segs
 367:                 local out_segs
 368:                 in_segs=$(grep "^Tcp:" /proc/net/snmp | tail -1 | awk '{print $11}')
 369:                 out_segs=$(grep "^Tcp:" /proc/net/snmp | tail -1 | awk '{print $12}')
 370:                 # Assume average packet size of 1200 bytes
 371:                 echo $(( (in_segs + out_segs) * 1200 ))
 372:             else
 373:                 local in_segs
 374:                 local out_segs
 375:                 in_segs=$(grep "^Tcp:" /proc/net/snmp | tail -1 | awk '{print $11}')
 376:                 out_segs=$(grep "^Tcp:" /proc/net/snmp | tail -1 | awk '{print $12}')
 377:                 echo $(( in_segs + out_segs ))
 378:             fi
 379:             ;;
 380:         udp)
 381:             if [[ "$metric" == "bytes" ]]; then
 382:                 local in_dgrams
 383:                 local out_dgrams
 384:                 in_dgrams=$(grep "^Udp:" /proc/net/snmp | tail -1 | awk '{print $2}')
 385:                 out_dgrams=$(grep "^Udp:" /proc/net/snmp | tail -1 | awk '{print $5}')
 386:                 # Assume average datagram size of 500 bytes
 387:                 echo $(( (in_dgrams + out_dgrams) * 500 ))
 388:             else
 389:                 local in_dgrams
 390:                 local out_dgrams
 391:                 in_dgrams=$(grep "^Udp:" /proc/net/snmp | tail -1 | awk '{print $2}')
 392:                 out_dgrams=$(grep "^Udp:" /proc/net/snmp | tail -1 | awk '{print $5}')
 393:                 echo $(( in_dgrams + out_dgrams ))
 394:             fi
 395:             ;;
 396:         icmp)
 397:             if [[ "$metric" == "bytes" ]]; then
 398:                 local in_msgs
 399:                 local out_msgs
 400:                 in_msgs=$(grep "^Icmp:" /proc/net/snmp | tail -1 | awk '{print $2}')
 401:                 out_msgs=$(grep "^Icmp:" /proc/net/snmp | tail -1 | awk '{print $22}')
 402:                 # ICMP packets are typically small (64 bytes)
 403:                 echo $(( (in_msgs + out_msgs) * 64 ))
 404:             else
 405:                 local in_msgs
 406:                 local out_msgs
 407:                 in_msgs=$(grep "^Icmp:" /proc/net/snmp | tail -1 | awk '{print $2}')
 408:                 out_msgs=$(grep "^Icmp:" /proc/net/snmp | tail -1 | awk '{print $22}')
 409:                 echo $(( in_msgs + out_msgs ))
 410:             fi
 411:             ;;
 412:         *)
 413:             echo "0"
 414:             ;;
 415:     esac
 416: }

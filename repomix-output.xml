 288: 
 289:     # Reload systemd
 290:     echo "Reloading systemd daemon..."
 291:     systemctl daemon-reload
 292:     echo "✅ Systemd reloaded"
 293:     echo ""
 294: 
 295:     echo "Service installed successfully!"
 296:     echo ""
 297:     echo "To start monitoring:"
 298:     echo "  systemctl start nftban-login-monitor"
 299:     echo ""
 300:     echo "To enable on boot:"
 301:     echo "  systemctl enable nftban-login-monitor"
 302:     echo ""
 303:     echo "To check status:"
 304:     echo "  nftban login status"
 305: }

# =============================================================================
# NFTBan v1.3.0 - Zabbix Metrics Exporter Timer
# =============================================================================
# SPDX-License-Identifier: MPL-2.0
# Purpose: Periodic execution of NFTBan Zabbix trapper export
#
# meta:name="nftban-zabbix-exporter.timer"
# meta:type="systemd"
# meta:header="Zabbix Exporter Timer"
# meta:version="1.3.0"
# meta:owner="Antonios Voulvoulis <contact@nftban.com>"
# meta:homepage="https://nftban.com"
#
# meta:description="Timer that triggers NFTBan Zabbix export at configured interval"
# meta:inventory.files=""
# meta:inventory.binaries=""
# meta:inventory.env_vars=""
# meta:inventory.config_files="/etc/nftban/nftban.conf"
# meta:inventory.systemd_units="nftban-zabbix-exporter.service"
# meta:inventory.network=""
# meta:inventory.privileges="none"
#
# meta:created_date="2026-01-22"
# meta:updated_date="2026-01-22"
# =============================================================================

[Unit]
Description=NFTBan Zabbix Metrics Exporter Timer
Documentation=https://nftban.com/docs/zabbix
Requires=nftban-zabbix-exporter.service
After=nftban.service

[Timer]
# STAGGERED: Offset from metrics exporter (45s vs 30s boot)
OnBootSec=45s
OnUnitActiveSec=60s

# CRITICAL: Catch up missed runs after downtime
Persistent=true

# Allow systemd batching
AccuracySec=10s

# SMART JITTER: 50% variance, deterministic per host
RandomizedDelaySec=30s
FixedRandomDelay=true

[Install]
WantedBy=timers.target

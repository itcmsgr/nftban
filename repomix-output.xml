141: // parseLoginStatusText parses text output from nftban login status
142: func parseLoginStatusText(output string) LoginMonitorStatus {
143: 	status := LoginMonitorStatus{
144: 		ServiceStatus: "not_installed",
145: 		Monitoring:    LoginMonitorTypes{},
146: 	}
147: 
148: 	lines := strings.Split(output, "\n")
149: 	for _, line := range lines {
150: 		line = strings.TrimSpace(line)
151: 		if strings.Contains(line, "Configuration:") && strings.Contains(line, "/etc/nftban") {
152: 			status.ConfigExists = true
153: 		}
154: 		if strings.Contains(line, "Core Module: Installed") {
155: 			status.ModuleExists = true
156: 		}
157: 		if strings.Contains(line, "Service: Running") {
158: 			status.ServiceStatus = "running"
159: 		} else if strings.Contains(line, "Service:") && strings.Contains(line, "not running") {
160: 			status.ServiceStatus = "stopped"
161: 		}
162: 		if strings.Contains(line, "SSH:") && strings.Contains(line, "true") {
163: 			status.Monitoring.SSH = true
164: 		}
165: 		if strings.Contains(line, "SU:") && strings.Contains(line, "true") {
166: 			status.Monitoring.SU = true
167: 		}
168: 		if strings.Contains(line, "SUDO:") && strings.Contains(line, "true") {
169: 			status.Monitoring.SUDO = true
170: 		}
171: 		if strings.Contains(line, "Console:") && strings.Contains(line, "true") {
172: 			status.Monitoring.Console = true
173: 		}
174: 	}
175: 
176: 	return status
177: }

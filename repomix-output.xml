 425: nftban_report_cmd_email_setup() {
 426:     # Interactive email configuration setup
 427:     # Usage: nftban report email-setup
 428: 
 429:     echo ""
 430:     echo "═══════════════════════════════════════════════════════════════"
 431:     echo "  NFTBan Email Configuration Setup"
 432:     echo "═══════════════════════════════════════════════════════════════"
 433:     echo ""
 434: 
 435:     local mail_conf="/etc/nftban/conf.d/mail.conf"
 436: 
 437:     # Check if mail.conf exists
 438:     if [[ ! -f "$mail_conf" ]]; then
 439:         echo "⚠️  Mail configuration file not found: $mail_conf"
 440:         echo ""
 441:         read -p "Create configuration file? (y/n): " create_conf
 442:         if [[ "${create_conf,,}" != "y" ]]; then
 443:             echo "Setup cancelled."
 444:             return 1
 445:         fi
 446:         mkdir -p "$(dirname "$mail_conf")"
 447:         touch "$mail_conf"
 448:         chmod 640 "$mail_conf"
 449:         chown root:nftban "$mail_conf"
 450:         echo "✓ Created $mail_conf"
 451:         echo ""
 452:     fi
 453: 
 454:     # Prompt for email address
 455:     echo "Email Configuration"
 456:     echo "───────────────────────────────────────────────────────────────"
 457:     read -p "Enter your email address: " user_email
 458:     if [[ -z "$user_email" ]]; then
 459:         echo "❌ Email address is required"
 460:         return 1
 461:     fi
 462: 
 463:     # Prompt for mail method
 464:     echo ""
 465:     echo "Mail Method:"
 466:     echo "  1) sendmail (recommended if available)"
 467:     echo "  2) SMTP server (requires configuration)"
 468:     read -p "Select method (1 or 2): " mail_method
 469: 
 470:     # Update configuration
 471:     echo ""
 472:     echo "Updating configuration..."
 473: 
 474:     # Backup existing config
 475:     if [[ -f "$mail_conf" ]] && [[ -s "$mail_conf" ]]; then
 476:         cp "$mail_conf" "${mail_conf}.backup.$(date +%Y%m%d-%H%M%S)"
 477:         echo "✓ Backed up existing configuration"
 478:     fi
 479: 
 480:     # Check if file already has the standard NFTBan variables
 481:     if grep -q "NFTBAN_MAIL_RECIPIENT" "$mail_conf" 2>/dev/null; then
 482:         # File uses standard NFTBan variables - update in place
 483:         echo "✓ Updating existing mail configuration..."
 484: 
 485:         # Update recipient (proper escaping for sed)
 486:         if grep -q "^NFTBAN_MAIL_RECIPIENT=" "$mail_conf"; then
 487:             # Use different delimiter and proper escaping
 488:             sed -i "s|^NFTBAN_MAIL_RECIPIENT=.*|NFTBAN_MAIL_RECIPIENT=\"${user_email}\"|g" "$mail_conf"
 489:         else
 490:             echo "NFTBAN_MAIL_RECIPIENT=\"$user_email\"" >> "$mail_conf"
 491:         fi
 492: 
 493:         # Update mail system based on user choice
 494:         if [[ "$mail_method" == "1" ]]; then
 495:             sed -i 's|^NFTBAN_MAIL_SYSTEM=.*|NFTBAN_MAIL_SYSTEM="sendmail"|g' "$mail_conf"
 496:         else
 497:             sed -i 's|^NFTBAN_MAIL_SYSTEM=.*|NFTBAN_MAIL_SYSTEM="smtp"|g' "$mail_conf"
 498:         fi
 499: 
 500:     else
 501:         # Old format or empty file - write new configuration using STANDARD variables
 502:         {
 503:             echo "# ============================================================================="
 504:             echo "# NFTBan Mail Configuration"
 505:             echo "# Generated: $(date)"
 506:             echo "# ============================================================================="
 507:             echo ""
 508:             echo "# Recipient email (STANDARD VARIABLE)"
 509:             echo "NFTBAN_MAIL_RECIPIENT=\"$user_email\""
 510:             echo ""
 511: 
 512:             if [[ "$mail_method" == "1" ]]; then
 513:                 echo "# Use sendmail"
 514:                 echo "NFTBAN_MAIL_SYSTEM=\"sendmail\""
 515:             else
 516:                 echo "# Use SMTP (requires additional configuration)"
 517:                 echo "NFTBAN_MAIL_SYSTEM=\"smtp\""
 518:                 echo ""
 519:                 echo "# SMTP Configuration (edit these in /etc/nftban/nftban.conf.local)"
 520:                 echo "# NFTBAN_SMTP_HOST=\"smtp.example.com\""
 521:                 echo "# NFTBAN_SMTP_PORT=\"587\""
 522:                 echo "# NFTBAN_SMTP_USER=\"user@example.com\""
 523:                 echo "# NFTBAN_SMTP_PASS=\"your-password\""
 524:                 echo "# NFTBAN_SMTP_TLS=\"yes\""
 525:             fi
 526:         } > "$mail_conf"
 527:     fi
 528: 
 529:     chmod 640 "$mail_conf"
 530:     chown root:nftban "$mail_conf" 2>/dev/null || true
 531: 
 532:     echo "✓ Configuration saved to $mail_conf"
 533:     echo ""
 534: 
 535:     if [[ "$mail_method" == "2" ]]; then
 536:         echo "⚠️  SMTP configuration incomplete!"
 537:         echo ""
 538:         echo "Next steps:"
 539:         echo "  1. Edit $mail_conf"
 540:         echo "  2. Update SMTP settings (host, port, username, password)"
 541:         echo "  3. Test: nftban mail test"
 542:         echo ""
 543:     else
 544:         echo "Testing email configuration..."
 545:         echo ""
 546:         if command -v sendmail >/dev/null 2>&1; then
 547:             echo "✓ sendmail found"
 548:             echo ""
 549:             read -p "Send test email to $user_email? (y/n): " send_test
 550:             if [[ "${send_test,,}" == "y" ]]; then
 551:                 if declare -f nftban_mail_send >/dev/null 2>&1; then
 552:                     nftban_mail_send "$user_email" "NFTBan Test Email" "This is a test email from NFTBan." || {

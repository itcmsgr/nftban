 84: nftban_debug_status() {
 85:     echo "NFTBan Debug Status"
 86:     echo "==================="
 87:     echo ""
 88: 
 89:     # Check current trace status from config
 90:     local trace_enabled="false"
 91:     local trace_log="${NFTBAN_LOG_DIR:-/var/log/nftban}/debug_trace.log"
 92:     local log_level="INFO"
 93: 
 94:     if [[ -f "${NFTBAN_CONFIG_DIR}/nftban.conf" ]]; then
 95:         trace_enabled=$(grep -E '^NFTBAN_DEBUG_TRACE=' "${NFTBAN_CONFIG_DIR}/nftban.conf" 2>/dev/null | cut -d'"' -f2 || echo "false")
 96:         trace_log=$(grep -E '^NFTBAN_DEBUG_TRACE_LOG=' "${NFTBAN_CONFIG_DIR}/nftban.conf" 2>/dev/null | cut -d'"' -f2 || echo "${NFTBAN_LOG_DIR:-/var/log/nftban}/debug_trace.log")
 97:         log_level=$(grep -E '^NFTBAN_LOG_LEVEL=' "${NFTBAN_CONFIG_DIR}/nftban.conf" 2>/dev/null | cut -d'"' -f2 || echo "INFO")
 98:     fi
 99: 
100:     # Display status
101:     echo "Debug Trace:"
102:     if [[ "$trace_enabled" == "true" ]]; then
103:         echo "  Status:     ✅ ENABLED"
104:     else

  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan Sync Module - Atomic Firewall Reload
  4: # =============================================================================
  5: # SPDX-License-Identifier: GPL-3.0-or-later
  6: # Copyright (c) 2025 Antonios Voulvoulis <contact@nftban.com>
  7: #
  8: # meta:name=nftban_sync
  9: # meta:type=core
 10: # meta:header=NFTBan Sync Module
 11: # meta:version=1.0.0
 12: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 13: # meta:homepage=https://nftban.com
 14: #
 15: # **Description & Purpose**
 16: # meta:description=Atomic firewall reload using Go-based sync engine
 17: # meta:input=Configuration files (whitelist, blacklist, feeds, geoban)
 18: # meta:output=Updated nftables ruleset with preserved Fail2Ban state
 19: #
 20: # **Inventory & Requirements**
 21: # meta:depends=bash,nftables,nftban-sync (Go binary)
 22: #
 23: # meta:created_date=2025-11-18
 24: # meta:updated_date=2025-11-24
 25: # meta:last_updated=2025-11-18
 26: # =============================================================================
 27: 
 28: # Strict mode
 29: umask 027
 30: 
 31: # Constants
 32: readonly NFTBAN_SYNC_BIN="${NFTBAN_SYNC_BIN:-/usr/lib/nftban/bin/nftban-sync}"
 33: # NFTBAN_LIB_DIR is set by the calling script - don't set it here
 34: 
 35: # Load strict mode library
 36: # shellcheck source=/usr/lib/nftban/lib/strict.sh
 37: if [[ -f "${NFTBAN_LIB_DIR:-/usr/lib/nftban}/lib/strict.sh" ]]; then
 38:     source "${NFTBAN_LIB_DIR:-/usr/lib/nftban}/lib/strict.sh"
 39: else
 40:     # Fallback to manual strict mode
 41:     set -Eeuo pipefail
 42: fi
 43: 
 44: # Load version library
 45: # shellcheck source=/usr/lib/nftban/lib/version.sh
 46: if [[ -f "${NFTBAN_LIB_DIR:-/usr/lib/nftban}/lib/version.sh" ]]; then
 47:     source "${NFTBAN_LIB_DIR:-/usr/lib/nftban}/lib/version.sh"
 48: fi
 49: 
 50: # Load NFT schema (single source of truth for table/set names)
 51: # shellcheck source=/usr/lib/nftban/lib/nft_schema.sh
 52: if [[ -f "${NFTBAN_LIB_DIR:-/usr/lib/nftban}/lib/nft_schema.sh" ]]; then
 53:     source "${NFTBAN_LIB_DIR:-/usr/lib/nftban}/lib/nft_schema.sh"
 54: fi
 55: 
 56: # Load output library for nftban_output function
 57: # shellcheck source=/usr/lib/nftban/core/nftban_output.sh
 58: if [[ -f "${NFTBAN_LIB_DIR:-/usr/lib/nftban}/core/nftban_output.sh" ]]; then
 59:     source "${NFTBAN_LIB_DIR:-/usr/lib/nftban}/core/nftban_output.sh"
 60: fi
 61: 
 62: # =============================================================================
 63: # MAIN FUNCTIONS
 64: # =============================================================================
 65: 
 66: nftban_sync_full() {
 67:     # Perform full atomic firewall reload
 68:     # Usage: nftban_sync_full [--dry-run]
 69:     #
 70:     # Algorithm (v0.6.0):
 71:     # 1. Read static config (whitelist, blacklist, ports)
 72:     # 2. Build feed sets (Go pkg/feeds)
 73:     # 3. Build geoban sets (Go pkg/geoban)
 74:     # 4. Dump runtime sets (temp_ban_*, temp_whitelist_*)
 75:     # 5. Generate rules.new.nft
 76:     # 6. Validate: nft -c -f rules.new.nft
 77:     # 7. Snapshot: nft list ruleset > backup.nft
 78:     # 8. Apply: nft -f rules.new.nft
 79:     # 9. Restore runtime elements
 80:     # 10. Cleanup old snapshots
 81: 
 82:     local dry_run=""
 83:     if [[ "${1:-}" == "--dry-run" ]]; then
 84:         dry_run="--dry-run"
 85:     fi
 86: 
 87:     # Check if Go binary exists
 88:     if [[ ! -x "$NFTBAN_SYNC_BIN" ]]; then
 89:         nftban_output "error" "nftban-sync binary not found: $NFTBAN_SYNC_BIN"
 90:         nftban_output "info" "Install the Go binary or build from source:"
 91:         nftban_output "info" "  cd /home/gituser/github/nftban-dev/cmd/nftban-sync"
 92:         nftban_output "info" "  go build -o $NFTBAN_SYNC_BIN ."
 93:         return 1
 94:     fi
 95: 
 96:     # Check root
 97:     if [[ $EUID -ne 0 ]]; then
 98:         nftban_output "error" "This command must be run as root"
 99:         return 1
100:     fi
101: 
102:     nftban_output "header" "NFTBan Sync - Atomic Firewall Reload"
103:     nftban_output "info" "Architecture: Dual-table (ip nftban + ip6 nftban)"
104:     echo ""
105: 
106:     # Execute Go binary
107:     if [[ -n "$dry_run" ]]; then
108:         nftban_output "info" "Mode: DRY RUN (validate only)"
109:         "$NFTBAN_SYNC_BIN" --dry-run
110:     else
111:         nftban_output "info" "Mode: FULL SYNC (apply changes)"
112:         "$NFTBAN_SYNC_BIN"
113:     fi
114: 
115:     local exit_code=$?
116: 
117:     if [[ $exit_code -eq 0 ]]; then
118:         echo ""
119:         nftban_output "success" "Firewall sync completed successfully"
120:         nftban_output "info" "Tables: ip nftban (IPv4) + ip6 nftban (IPv6)"
121:         nftban_output "info" "Runtime state: Fail2Ban bans preserved"
122:         return 0
123:     else
124:         echo ""
125:         nftban_output "error" "Firewall sync failed (exit code: $exit_code)"
126:         return 1
127:     fi
128: }
129: 
130: nftban_sync_validate() {
131:     # Validate firewall configuration without applying
132:     # Usage: nftban_sync_validate
133: 
134:     nftban_output "info" "Validating firewall configuration..."
135:     nftban_sync_full --dry-run
136: }
137: 
138: nftban_sync_status() {
139:     # Show current sync status and statistics
140:     # Usage: nftban_sync_status
141: 
142:     nftban_output "header" "NFTBan Sync Status"
143:     echo ""
144: 
145:     # Check if tables exist (v0.7.3 dual-table architecture)
146:     local tables_ok=true
147:     if nft list table ${NFTBAN_TABLE_IPV4} &>/dev/null; then
148:         nftban_output "success" "Table '${NFTBAN_TABLE_IPV4}' exists"
149:     else
150:         nftban_output "error" "Table '${NFTBAN_TABLE_IPV4}' not found"
151:         tables_ok=false
152:     fi
153: 
154:     if nft list table ${NFTBAN_TABLE_IPV6} &>/dev/null; then
155:         nftban_output "success" "Table '${NFTBAN_TABLE_IPV6}' exists"
156:     else
157:         nftban_output "warning" "Table '${NFTBAN_TABLE_IPV6}' not found (IPv6 disabled?)"
158:     fi
159: 
160:     if [[ "$tables_ok" == "false" ]]; then
161:         nftban_output "info" "Run: nftban sync"
162:         return 1
163:     fi
164: 
165:     # Count sets (v0.7.3: check both IPv4 and IPv6 tables)
166:     echo ""
167:     nftban_output "info" "Sets in tables:"
168: 
169:     local ipv4_sets ipv6_sets
170:     ipv4_sets=$(nft list table ${NFTBAN_TABLE_IPV4} 2>/dev/null | { grep -E "^\s+set " || true; } | wc -l)
171:     ipv6_sets=$(nft list table ${NFTBAN_TABLE_IPV6} 2>/dev/null | { grep -E "^\s+set " || true; } | wc -l)
172:     nftban_output "info" "  IPv4 table sets: $ipv4_sets"
173:     nftban_output "info" "  IPv6 table sets: $ipv6_sets"
174: 
175:     # Count elements in key sets (v0.7.3: unified blacklist architecture)
176:     echo ""
177:     nftban_output "info" "Key sets (IPv4):"
178:     local set_name
179:     for set_name in whitelist_ipv4 blacklist_ipv4; do
180:         local count=0
181:         if nft list set ${NFTBAN_TABLE_IPV4} "$set_name" &>/dev/null; then
182:             # Count elements properly - handle empty sets and multiline output
183:             local elements_line
184:             elements_line=$(nft list set ${NFTBAN_TABLE_IPV4} "$set_name" 2>/dev/null | grep -oE "elements = \{[^}]*\}" || true)
185:             if [[ -n "$elements_line" && "$elements_line" != "elements = { }" ]]; then
186:                 count=$(echo "$elements_line" | tr ',' '\n' | grep -cE "[0-9]" || echo 0)
187:             fi
188:         fi
189:         # Ensure count is a valid integer
190:         [[ ! "$count" =~ ^[0-9]+$ ]] && count=0
191:         printf "  %-20s %d elements\n" "$set_name:" "$count"
192:     done
193: 
194:     echo ""
195:     nftban_output "info" "Key sets (IPv6):"
196:     for set_name in whitelist_ipv6 blacklist_ipv6; do
197:         local count=0
198:         if nft list set ${NFTBAN_TABLE_IPV6} "$set_name" &>/dev/null; then
199:             # Count elements properly - handle empty sets and multiline output
200:             local elements_line
201:             elements_line=$(nft list set ${NFTBAN_TABLE_IPV6} "$set_name" 2>/dev/null | grep -oE "elements = \{[^}]*\}" || true)
202:             if [[ -n "$elements_line" && "$elements_line" != "elements = { }" ]]; then
203:                 count=$(echo "$elements_line" | tr ',' '\n' | grep -cE "[0-9a-fA-F:]" || echo 0)
204:             fi
205:         fi
206:         # Ensure count is a valid integer
207:         [[ ! "$count" =~ ^[0-9]+$ ]] && count=0
208:         printf "  %-20s %d elements\n" "$set_name:" "$count"
209:     done
210: 
211:     # Last snapshot
212:     echo ""
213:     local snapshot_dir="${NFTBAN_DATA_DIR}/snapshots"
214:     if [[ -d "$snapshot_dir" ]]; then
215:         local latest_snapshot=""
216:         # Use find instead of ls to avoid pipefail errors on empty directories
217:         latest_snapshot=$(find "$snapshot_dir" -maxdepth 1 -name "snapshot-*.nft" -type f -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2- || true)
218:         if [[ -n "$latest_snapshot" && -f "$latest_snapshot" ]]; then
219:             local snapshot_time
220:             snapshot_time=$(stat -c %y "$latest_snapshot" 2>/dev/null | cut -d'.' -f1)
221:             nftban_output "info" "Last snapshot: $snapshot_time"
222:             nftban_output "info" "  File: $(basename "$latest_snapshot")"
223:         else
224:             nftban_output "warning" "No snapshots found"
225:         fi
226:     else
227:         nftban_output "warning" "Snapshots directory not found"
228:     fi
229: 
230:     echo ""
231:     return 0
232: }
233: 
234: nftban_sync_help() {
235:     # Show help for sync commands
236:     cat <<'EOF'
237: NFTBan Sync - Atomic Firewall Reload
238: 
239: COMMANDS:
240:   nftban sync              Full atomic firewall reload
241:   nftban sync --dry-run    Validate configuration only
242:   nftban sync status       Show current sync status
243:   nftban sync validate     Validate without applying
244:   nftban sync help         Show this help
245: 
246: DESCRIPTION:
247:   The 'sync' command performs atomic firewall reload using the
248:   dual-table architecture (ip nftban + ip6 nftban).
249: 
250: ALGORITHM:
251:   1. Read static config (whitelist, blacklist, ports)
252:   2. Build feed sets (Go pkg/feeds) - <2s for 50,000+ IPs
253:   3. Build geoban sets (Go pkg/geoban) - <2s for 2,259 CIDRs
254:   4. Dump Fail2Ban runtime state (temp_ban_*, temp_whitelist_*)
255:   5. Generate new ruleset (rules.new.nft)
256:   6. Validate (nft -c -f)
257:   7. Snapshot current rules (automatic backup)
258:   8. Apply new rules (nft -f)
259:   9. Restore Fail2Ban bans (preserve runtime state)
260:   10. Cleanup old snapshots (keep 10 most recent)
261: 
262: FEATURES:
263:   - Atomic transaction (all-or-nothing)
264:   - Preserves Fail2Ban runtime bans
265:   - Automatic validation before apply
266:   - Automatic rollback snapshots
267:   - 100x faster than bash (GeoBan: 120s → 2s)
268: 
269: ARCHITECTURE:
270:   - Tables: ip nftban (IPv4) + ip6 nftban (IPv6)
271:   - Unified blacklist (all bans consolidated per family)
272:   - Rule order: Drops BEFORE ct state established
273:   - Go modules: pkg/feeds, pkg/geoban, pkg/firewall
274: 
275: EXAMPLES:
276:   # Full sync (production)
277:   nftban sync
278: 
279:   # Validate only (test before apply)
280:   nftban sync --dry-run
281: 
282:   # Check status
283:   nftban sync status
284: 
285: FILES:
286:   /etc/nftban/whitelist.conf       Permanent whitelist
287:   /etc/nftban/blacklist.conf       Permanent blacklist
288:   /etc/nftban/geoban.d/*.conf      GeoBan country files
289:   /var/lib/nftban/feeds/*.txt      External feed files
290:   /var/lib/nftban/staging/         Temporary rulesets
291:   /var/lib/nftban/snapshots/       Automatic backups
292: 
293: SEE ALSO:
294:   nftban geoban, nftban feeds, nftban firewall
295: EOF
296: }
297: 
298: # =============================================================================
299: # MODULE EXPORTS
300: # =============================================================================
301: 
302: # Export functions for use by CLI
303: export -f nftban_sync_full
304: export -f nftban_sync_validate
305: export -f nftban_sync_status
306: export -f nftban_sync_help
</file>


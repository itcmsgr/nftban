472: // getTrustEnabledStatus reads trust config and returns enabled status map
473: func getTrustEnabledStatus(configPath string) map[string]bool {
474: 	enabledMap := make(map[string]bool)
475: 
476: 	content, err := os.ReadFile(configPath)
477: 	if err != nil {
478: 		return enabledMap // Return empty map if config doesn't exist
479: 	}
480: 
481: 	lines := strings.Split(string(content), "\n")
482: 	for _, line := range lines {
483: 		line = strings.TrimSpace(line)
484: 		if strings.HasPrefix(line, "TRUST_") && strings.Contains(line, "_ENABLED=") {
485: 			parts := strings.SplitN(line, "=", 2)
486: 			if len(parts) != 2 {
487: 				continue
488: 			}
489: 
490: 			varName := parts[0]
491: 			value := strings.Trim(parts[1], `"' `)
492: 
493: 			// Extract name: TRUST_<NAME>_ENABLED
494: 			name := strings.TrimPrefix(varName, "TRUST_")
495: 			name = strings.TrimSuffix(name, "_ENABLED")
496: 
497: 			enabledMap[name] = (value == "true")
498: 		}
499: 	}
500: 
501: 	return enabledMap
502: }

# meta:owner="Antonios Voulvoulis <contact@nftban.com>"
# meta:created_date="2025-10-26"
# meta:description="Timer for weekly GeoIP database updates"
# meta:input="None"
# meta:output="Systemd unit"
# meta:depends=""
# meta:inventory.files=""
# meta:inventory.binaries=""
# meta:inventory.env_vars=""
# meta:inventory.config_files=""
# meta:inventory.systemd_units="nftban-core-geoip.service"
# meta:inventory.network=""
# meta:inventory.privileges="root"
# =============================================================================

[Unit]
Description=NFTBan Core - Weekly GeoIP Database Update Timer
Documentation=https://github.com/itcmsgr/nftban
# Timer triggers nftban-core-geoip.service (implicit by name match)
# No explicit Requires needed - the service is self-contained

[Timer]
# Run weekly on Sundays at 02:30 AM (staggered from rbl-check at 02:00)
OnCalendar=Sun *-*-* 02:30:00

# Also run 30 minutes after boot
OnBootSec=30min

# Run if missed (e.g., system was off)
Persistent=true

# JITTER: 30m variance for weekly task (was 60m - reduced)
RandomizedDelaySec=30m

# DETERMINISTIC: Same offset per host for predictable behavior
FixedRandomDelay=true

[Install]
WantedBy=timers.target

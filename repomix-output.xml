344: nftban_port_render_json() {
345:     # Render port report as JSON
346:     # Uses: NFTBAN_PORT_SEEN, NFTBAN_PORT_FILTER_PORTS
347: 
348:     # Parse filter ports if provided
349:     local -a filter_ports_arr=()
350:     if [[ -n "$NFTBAN_PORT_FILTER_PORTS" ]]; then
351:         IFS=',' read -ra filter_ports_arr <<< "$NFTBAN_PORT_FILTER_PORTS"
352:     fi
353: 
354:     # Sorted iteration
355:     local -a keys=()
356:     local k
357:     for k in "${!NFTBAN_PORT_SEEN[@]}"; do keys+=("$k"); done
358:     IFS=$'\n' read -r -d '' -a sorted < <(printf '%s\n' "${keys[@]}" | sort -t_ -k1n -k2 && printf '\0') || true
359: 
360:     # Build JSON array
361:     local json_ports="["
362:     local first=true
363: 
364:     for entry in "${sorted[@]}"; do
365:         local port="${entry%%_*}" proto="${entry##*_}"
366: 
367:         # Filter (if any)
368:         if [[ ${#filter_ports_arr[@]} -gt 0 ]]; then
369:             local match=0 pf
370:             for pf in "${filter_ports_arr[@]}"; do
371:                 [[ "$pf" == "$port" ]] && match=1
372:             done
373:             (( match == 1 )) || continue
374:         fi
375: 
376:         local svcinfo
377:         svcinfo="$(nftban_port_detect_service "$port" "$proto")"
378:         local svc running procinfo bind scope
379:         svc="$(cut -d'|' -f1 <<<"$svcinfo")"
380:         running="$(cut -d'|' -f2 <<<"$svcinfo")"
381:         procinfo="$(cut -d'|' -f3 <<<"$svcinfo")"
382:         bind="$(cut -d'|' -f4 <<<"$svcinfo")"
383:         scope="$(cut -d'|' -f5 <<<"$svcinfo")"
384: 
385:         # Check if in firewall
386:         local in_firewall=false
387:         if [[ -n "${NFTBAN_PORT_NFT_GENERIC["${port}_${proto}_input"]+x}" ]] || \
388:            [[ -n "${NFTBAN_PORT_NFT_RULES["${port}_${proto}_input_ipv4"]+x}" ]] || \
389:            [[ -n "${NFTBAN_PORT_NFT_RULES["${port}_${proto}_input_ipv6"]+x}" ]]; then
390:             in_firewall=true
391:         fi
392: 
393:         # Skip only if: NOT listening AND NOT in firewall
394:         if [[ "$running" != "yes" ]] && [[ "$in_firewall" == "false" ]]; then
395:             continue
396:         fi
397: 
398:         local status_line
399:         status_line="$(nftban_port_determine_status "$port" "$proto")"
400:         local v4in v4out v6in v6out notes
401:         v4in="$(cut -d'|' -f1 <<< "$status_line")"
402:         v4out="$(cut -d'|' -f2 <<< "$status_line")"
403:         v6in="$(cut -d'|' -f3 <<< "$status_line")"
404:         v6out="$(cut -d'|' -f4 <<< "$status_line")"
405:         notes="$(cut -d'|' -f5 <<< "$status_line")"
406: 
407:         # Determine direction (IN/OUT/BOTH)
408:         local direction="IN"
409:         if [[ "$v4out" == "Allowed" ]] || [[ "$v6out" == "Allowed" ]]; then
410:             if [[ "$v4in" == "Allowed" ]] || [[ "$v6in" == "Allowed" ]]; then
411:                 direction="IN/OUT"
412:             else
413:                 direction="OUT"
414:             fi
415:         fi
416: 
417:         # Determine status
418:         local status="Closed"
419:         if [[ "$running" == "yes" ]]; then
420:             if [[ "$v4in" == "Allowed" ]] || [[ "$v6in" == "Allowed" ]]; then
421:                 status="Open"
422:             else
423:                 status="Listening"
424:             fi
425:         elif [[ "$in_firewall" == "true" ]]; then
426:             status="Open"
427:         fi
428: 
429:         # Add to JSON array
430:         if [[ "$first" == "true" ]]; then
431:             first=false
432:         else
433:             json_ports+=","
434:         fi
435: 
436:         # Escape quotes in strings
437:         svc="${svc//\"/\\\"}"
438:         notes="${notes//\"/\\\"}"
439: 
440:         json_ports+="{"
441:         json_ports+="\"port\":$port,"
442:         json_ports+="\"protocol\":\"${proto^^}\","
443:         json_ports+="\"direction\":\"$direction\","
444:         json_ports+="\"service\":\"$svc\","
445:         json_ports+="\"status\":\"$status\","
446:         json_ports+="\"listening\":$(if [[ "$running" == "yes" ]]; then echo "true"; else echo "false"; fi),"
447:         json_ports+="\"ipv4_in\":\"$v4in\","
448:         json_ports+="\"ipv4_out\":\"$v4out\","
449:         json_ports+="\"ipv6_in\":\"$v6in\","
450:         json_ports+="\"ipv6_out\":\"$v6out\""
451:         json_ports+="}"
452:     done
453: 
454:     json_ports+="]"
455: 
456:     # Output JSON
457:     echo "{"
458:     echo "  \"timestamp\":\"$(date --iso-8601=seconds)\","
459:     echo "  \"total\":$(echo "$json_ports" | { grep -o '{' || true; } | wc -l),"
460:     echo "  \"ports\":$json_ports"
461:     echo "}"
462: 
463:     return 0
464: }

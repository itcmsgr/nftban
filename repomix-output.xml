<file path="pkg/suricata/scanner/probes.go">
  1: package scanner
  2: 
  3: import (
  4: 	"bufio"
  5: 	"crypto/tls"
  6: 	"fmt"
  7: 	"net"
  8: 	"strings"
  9: 	"time"
 10: )
 11: 
 12: // ProbeService performs deep protocol detection on a service
 13: func ProbeService(host string, port int) (*Service, error) {
 14: 	service := &Service{
 15: 		Port:     port,
 16: 		Protocol: "tcp",
 17: 		Name:     "unknown",
 18: 	}
 19: 
 20: 	// Try different probes based on port
 21: 	switch port {
 22: 	case 80, 8080:
 23: 		if probeHTTP(host, port, service) {
 24: 			return service, nil
 25: 		}
 26: 	case 443, 8443:
 27: 		if probeHTTPS(host, port, service) {
 28: 			return service, nil
 29: 		}
 30: 	case 22:
 31: 		if probeSSH(host, port, service) {
 32: 			return service, nil
 33: 		}
 34: 	case 3306:
 35: 		if probeMySQL(host, port, service) {
 36: 			return service, nil
 37: 		}
 38: 	case 53:
 39: 		// DNS is typically UDP, handle separately
 40: 		service.Name = "dns"
 41: 		service.Protocol = "udp"
 42: 		return service, nil
 43: 	}
 44: 
 45: 	// Fallback to basic detection
 46: 	service.Name = detectServiceByPort(port)
 47: 	return service, nil
 48: }
 49: 
 50: // probeHTTP sends an HTTP request to verify HTTP service
 51: func probeHTTP(host string, port int, service *Service) bool {
 52: 	address := fmt.Sprintf("%s:%d", host, port)
 53: 	conn, err := net.DialTimeout("tcp", address, 2*time.Second)
 54: 	if err != nil {
 55: 		return false
 56: 	}
 57: 	defer conn.Close()
 58: 
 59: 	// Send HTTP GET request
 60: 	request := "GET / HTTP/1.0\r\nHost: localhost\r\n\r\n"
 61: 	conn.SetWriteDeadline(time.Now().Add(2 * time.Second))
 62: 	_, err = conn.Write([]byte(request))
 63: 	if err != nil {
 64: 		return false
 65: 	}
 66: 
 67: 	// Read response
 68: 	conn.SetReadDeadline(time.Now().Add(2 * time.Second))
 69: 	reader := bufio.NewReader(conn)
 70: 	response, err := reader.ReadString('\n')
 71: 	if err != nil {
 72: 		return false
 73: 	}
 74: 
 75: 	// Check for HTTP response
 76: 	if strings.HasPrefix(response, "HTTP/") {
 77: 		service.Name = "http"
 78: 		// Extract server banner
 79: 		for {
 80: 			line, err := reader.ReadString('\n')
 81: 			if err != nil || line == "\r\n" {
 82: 				break
 83: 			}
 84: 			if strings.HasPrefix(line, "Server:") {
 85: 				service.Banner = strings.TrimSpace(strings.TrimPrefix(line, "Server:"))
 86: 				break
 87: 			}
 88: 		}
 89: 		return true
 90: 	}
 91: 
 92: 	return false
 93: }
 94: 
 95: // probeHTTPS attempts TLS handshake to verify HTTPS
 96: func probeHTTPS(host string, port int, service *Service) bool {
 97: 	address := fmt.Sprintf("%s:%d", host, port)
 98: 	config := &tls.Config{
 99: 		InsecureSkipVerify: true,
100: 	}
101: 
102: 	conn, err := tls.DialWithDialer(
103: 		&net.Dialer{Timeout: 2 * time.Second},
104: 		"tcp",
105: 		address,
106: 		config,
107: 	)
108: 	if err != nil {
109: 		return false
110: 	}
111: 	defer conn.Close()
112: 
113: 	// Successful TLS handshake
114: 	service.Name = "https"
115: 
116: 	// Get TLS version and cipher
117: 	state := conn.ConnectionState()
118: 	service.Banner = fmt.Sprintf("TLS %s", getTLSVersion(state.Version))
119: 
120: 	return true
121: }
122: 
123: // probeSSH reads SSH banner
124: func probeSSH(host string, port int, service *Service) bool {
125: 	address := fmt.Sprintf("%s:%d", host, port)
126: 	conn, err := net.DialTimeout("tcp", address, 2*time.Second)
127: 	if err != nil {
128: 		return false
129: 	}
130: 	defer conn.Close()
131: 
132: 	// SSH server sends banner immediately
133: 	conn.SetReadDeadline(time.Now().Add(2 * time.Second))
134: 	reader := bufio.NewReader(conn)
135: 	banner, err := reader.ReadString('\n')
136: 	if err != nil {
137: 		return false
138: 	}
139: 
140: 	// Check for SSH banner
141: 	if strings.HasPrefix(banner, "SSH-") {
142: 		service.Name = "ssh"
143: 		service.Banner = strings.TrimSpace(banner)
144: 		return true
145: 	}
146: 
147: 	return false
148: }
149: 
150: // probeMySQL attempts MySQL handshake
151: func probeMySQL(host string, port int, service *Service) bool {
152: 	address := fmt.Sprintf("%s:%d", host, port)
153: 	conn, err := net.DialTimeout("tcp", address, 2*time.Second)
154: 	if err != nil {
155: 		return false
156: 	}
157: 	defer conn.Close()
158: 
159: 	// MySQL server sends handshake packet immediately
160: 	conn.SetReadDeadline(time.Now().Add(2 * time.Second))
161: 	buffer := make([]byte, 128)
162: 	n, err := conn.Read(buffer)
163: 	if err != nil || n < 5 {
164: 		return false
165: 	}
166: 
167: 	// Check for MySQL protocol version (first byte after packet length)
168: 	// MySQL handshake starts with protocol version 10 (0x0a)
169: 	if n > 4 && buffer[4] == 0x0a {
170: 		service.Name = "mysql"
171: 		// MySQL version string starts at byte 5
172: 		if n > 5 {
173: 			versionEnd := 5
174: 			for versionEnd < n && buffer[versionEnd] != 0 {
175: 				versionEnd++
176: 			}
177: 			if versionEnd < n {
178: 				service.Banner = string(buffer[5:versionEnd])
179: 			}
180: 		}
181: 		return true
182: 	}
183: 
184: 	return false
185: }
186: 
187: // getTLSVersion converts TLS version number to string
188: func getTLSVersion(version uint16) string {
189: 	switch version {
190: 	case tls.VersionTLS10:
191: 		return "1.0"
192: 	case tls.VersionTLS11:
193: 		return "1.1"
194: 	case tls.VersionTLS12:
195: 		return "1.2"
196: 	case tls.VersionTLS13:
197: 		return "1.3"
198: 	default:
199: 		return "unknown"
200: 	}
201: }
202: 
203: // DeepScan performs comprehensive service detection with protocol probes
204: func DeepScan(host string, ports []int) (*ScanResult, error) {
205: 	result := &ScanResult{
206: 		Services:       make([]Service, 0),
207: 		RuleCategories: make([]string, 0),
208: 	}
209: 
210: 	fmt.Println("Performing deep service scan...")
211: 
212: 	for _, port := range ports {
213: 		service, err := ProbeService(host, port)
214: 		if err == nil && service.Name != "unknown" {
215: 			result.Services = append(result.Services, *service)
216: 			fmt.Printf("  ✓ %s on port %d", service.Name, service.Port)
217: 			if service.Banner != "" {
218: 				fmt.Printf(" (%s)", service.Banner)
219: 			}
220: 			fmt.Println()
221: 		}
222: 	}
223: 
224: 	// Map services to rule categories
225: 	result.RuleCategories = mapServicesToCategories(result.Services)
226: 
227: 	return result, nil
228: }
</file>

<file path="pkg/suricata/stats/cache.go">
  1: package stats
  2: 
  3: import (
  4: 	"encoding/json"
  5: 	"fmt"
  6: 	"os"
  7: 	"path/filepath"
  8: 	"sort"
  9: 	"sync"
 10: 	"time"
 11: 
 12: 	"github.com/itcmsgr/nftban/pkg/nftbanconf"
 13: )
 14: 
 15: // SIDStats holds statistics for a single SID
 16: type SIDStats struct {
 17: 	SID           string    `json:"sid"`
 18: 	Category      string    `json:"category"`
 19: 	Signature     string    `json:"signature"`
 20: 	TriggerCount  int       `json:"trigger_count"`
 21: 	LastTrigger   time.Time `json:"last_trigger"`
 22: 	FirstTrigger  time.Time `json:"first_trigger"`
 23: 	UniqueSources map[string]bool `json:"-"` // Not serialized
 24: 	SourceCount   int       `json:"source_count"`
 25: 	SourceIPs     []string  `json:"source_ips,omitempty"` // Top 10 for display
 26: }
 27: 
 28: // Cache holds in-memory SID statistics
 29: type Cache struct {
 30: 	mu            sync.RWMutex
 31: 	stats         map[string]*SIDStats // Key: SID
 32: 	snapshotPath  string
 33: 	lastSnapshot  time.Time
 34: }
 35: 
 36: // NewCache creates a new statistics cache
 37: func NewCache() (*Cache, error) {
 38: 	cfg := nftbanconf.MustLoad()
 39: 	snapshotPath := filepath.Join(cfg.ConfigDir, "suricata/cache/sid-stats.json")
 40: 
 41: 	cache := &Cache{
 42: 		stats:        make(map[string]*SIDStats),
 43: 		snapshotPath: snapshotPath,
 44: 	}
 45: 
 46: 	// Load existing snapshot if available
 47: 	if err := cache.Load(); err != nil {
 48: 		fmt.Printf("No existing snapshot found (starting fresh): %v\n", err)
 49: 	}
 50: 
 51: 	return cache, nil
 52: }
 53: 
 54: // RecordTrigger records a SID trigger event
 55: func (c *Cache) RecordTrigger(sid, category, signature, sourceIP string, timestamp time.Time) {
 56: 	c.mu.Lock()
 57: 	defer c.mu.Unlock()
 58: 
 59: 	stats, exists := c.stats[sid]
 60: 	if !exists {
 61: 		stats = &SIDStats{
 62: 			SID:           sid,
 63: 			Category:      category,
 64: 			Signature:     signature,
 65: 			UniqueSources: make(map[string]bool),
 66: 			FirstTrigger:  timestamp,
 67: 		}
 68: 		c.stats[sid] = stats
 69: 	}
 70: 
 71: 	// Update counters
 72: 	stats.TriggerCount++
 73: 	stats.LastTrigger = timestamp
 74: 	if stats.FirstTrigger.IsZero() || timestamp.Before(stats.FirstTrigger) {
 75: 		stats.FirstTrigger = timestamp
 76: 	}
 77: 
 78: 	// Track unique sources
 79: 	if sourceIP != "" {
 80: 		stats.UniqueSources[sourceIP] = true
 81: 		stats.SourceCount = len(stats.UniqueSources)
 82: 	}
 83: }
 84: 
 85: // GetSIDStats returns statistics for a specific SID
 86: func (c *Cache) GetSIDStats(sid string) (*SIDStats, bool) {
 87: 	c.mu.RLock()
 88: 	defer c.mu.RUnlock()
 89: 
 90: 	stats, exists := c.stats[sid]
 91: 	if !exists {
 92: 		return nil, false
 93: 	}
 94: 
 95: 	// Make a copy with top source IPs
 96: 	copy := *stats
 97: 	copy.SourceIPs = c.getTopSourceIPs(stats.UniqueSources, 10)
 98: 	return &copy, true
 99: }
100: 
101: // GetTopSIDs returns top N SIDs by trigger count
102: func (c *Cache) GetTopSIDs(n int) []*SIDStats {
103: 	c.mu.RLock()
104: 	defer c.mu.RUnlock()
105: 
106: 	// Convert to slice
107: 	statsList := make([]*SIDStats, 0, len(c.stats))
108: 	for _, stats := range c.stats {
109: 		copy := *stats
110: 		copy.SourceIPs = c.getTopSourceIPs(stats.UniqueSources, 10)
111: 		statsList = append(statsList, &copy)
112: 	}
113: 
114: 	// Sort by trigger count (descending)
115: 	sort.Slice(statsList, func(i, j int) bool {
116: 		return statsList[i].TriggerCount > statsList[j].TriggerCount
117: 	})
118: 
119: 	// Return top N
120: 	if n > 0 && n < len(statsList) {
121: 		return statsList[:n]
122: 	}
123: 	return statsList
124: }
125: 
126: // GetRecentSIDs returns SIDs triggered in the last duration
127: func (c *Cache) GetRecentSIDs(duration time.Duration) []*SIDStats {
128: 	c.mu.RLock()
129: 	defer c.mu.RUnlock()
130: 
131: 	cutoff := time.Now().Add(-duration)
132: 	recent := make([]*SIDStats, 0)
133: 
134: 	for _, stats := range c.stats {
135: 		if stats.LastTrigger.After(cutoff) {
136: 			copy := *stats
137: 			copy.SourceIPs = c.getTopSourceIPs(stats.UniqueSources, 10)
138: 			recent = append(recent, &copy)
139: 		}
140: 	}
141: 
142: 	// Sort by last trigger (most recent first)
143: 	sort.Slice(recent, func(i, j int) bool {
144: 		return recent[i].LastTrigger.After(recent[j].LastTrigger)
145: 	})
146: 
147: 	return recent
148: }
149: 
150: // GetAllStats returns all SID statistics
151: func (c *Cache) GetAllStats() []*SIDStats {
152: 	return c.GetTopSIDs(-1) // -1 means all
153: }
154: 
155: // GetSize returns the number of tracked SIDs
156: func (c *Cache) GetSize() int {
157: 	c.mu.RLock()
158: 	defer c.mu.RUnlock()
159: 	return len(c.stats)
160: }
161: 
162: // GetUniqueSIDs returns the number of unique SIDs
163: func (c *Cache) GetUniqueSIDs() int {
164: 	return c.GetSize()
165: }
166: 
167: // GetTotalTriggers returns total trigger count across all SIDs
168: func (c *Cache) GetTotalTriggers() int {
169: 	c.mu.RLock()
170: 	defer c.mu.RUnlock()
171: 
172: 	total := 0
173: 	for _, stats := range c.stats {
174: 		total += stats.TriggerCount
175: 	}
176: 	return total
177: }
178: 
179: // GetUniqueSources returns total unique source IPs across all SIDs
180: func (c *Cache) GetUniqueSources() int {
181: 	c.mu.RLock()
182: 	defer c.mu.RUnlock()
183: 
184: 	allSources := make(map[string]bool)
185: 	for _, stats := range c.stats {
186: 		for ip := range stats.UniqueSources {
187: 			allSources[ip] = true
188: 		}
189: 	}
190: 	return len(allSources)
191: }
192: 
193: // getTopSourceIPs returns top N source IPs from map
194: func (c *Cache) getTopSourceIPs(sources map[string]bool, n int) []string {
195: 	ips := make([]string, 0, len(sources))
196: 	for ip := range sources {
197: 		ips = append(ips, ip)
198: 	}
199: 
200: 	// Sort alphabetically for consistent output
201: 	sort.Strings(ips)
202: 
203: 	// Return top N
204: 	if n > 0 && n < len(ips) {
205: 		return ips[:n]
206: 	}
207: 	return ips
208: }
209: 
210: // Save writes cache snapshot to disk
211: func (c *Cache) Save() error {
212: 	c.mu.RLock()
213: 	defer c.mu.RUnlock()
214: 
215: 	// Ensure directory exists
216: 	dir := filepath.Dir(c.snapshotPath)
217: 	if err := os.MkdirAll(dir, 0755); err != nil {
218: 		return fmt.Errorf("failed to create cache directory: %w", err)
219: 	}
220: 
221: 	// Convert stats to serializable format
222: 	snapshot := make([]*SIDStats, 0, len(c.stats))
223: 	for _, stats := range c.stats {
224: 		copy := *stats
225: 		copy.SourceCount = len(stats.UniqueSources)
226: 		copy.SourceIPs = c.getTopSourceIPs(stats.UniqueSources, 100) // Save top 100
227: 		snapshot = append(snapshot, &copy)
228: 	}
229: 
230: 	// Marshal to JSON
231: 	data, err := json.MarshalIndent(snapshot, "", "  ")
232: 	if err != nil {
233: 		return fmt.Errorf("failed to marshal cache: %w", err)
234: 	}
235: 
236: 	// Write to file
237: 	if err := os.WriteFile(c.snapshotPath, data, 0644); err != nil {
238: 		return fmt.Errorf("failed to write snapshot: %w", err)
239: 	}
240: 
241: 	c.lastSnapshot = time.Now()
242: 	fmt.Printf("Cache snapshot saved: %s (%d SIDs)\n", c.snapshotPath, len(snapshot))
243: 	return nil
244: }
245: 
246: // Load reads cache snapshot from disk
247: func (c *Cache) Load() error {
248: 	c.mu.Lock()
249: 	defer c.mu.Unlock()
250: 
251: 	// Read snapshot file
252: 	data, err := os.ReadFile(c.snapshotPath)
253: 	if err != nil {
254: 		return err
255: 	}
256: 
257: 	// Parse JSON
258: 	var snapshot []*SIDStats
259: 	if err := json.Unmarshal(data, &snapshot); err != nil {
260: 		return fmt.Errorf("failed to unmarshal snapshot: %w", err)
261: 	}
262: 
263: 	// Rebuild cache
264: 	c.stats = make(map[string]*SIDStats)
265: 	for _, stats := range snapshot {
266: 		// Reconstruct UniqueSources map
267: 		stats.UniqueSources = make(map[string]bool)
268: 		for _, ip := range stats.SourceIPs {
269: 			stats.UniqueSources[ip] = true
270: 		}
271: 		c.stats[stats.SID] = stats
272: 	}
273: 
274: 	fmt.Printf("Cache snapshot loaded: %s (%d SIDs)\n", c.snapshotPath, len(snapshot))
275: 	return nil
276: }
277: 
278: // Clear removes all statistics
279: func (c *Cache) Clear() {
280: 	c.mu.Lock()
281: 	defer c.mu.Unlock()
282: 	c.stats = make(map[string]*SIDStats)
283: }
284: 
285: // StartAutoSave starts periodic snapshot saving
286: func (c *Cache) StartAutoSave(interval time.Duration) {
287: 	ticker := time.NewTicker(interval)
288: 	go func() {
289: 		for range ticker.C {
290: 			if err := c.Save(); err != nil {
291: 				fmt.Printf("Auto-save failed: %v\n", err)
292: 			}
293: 		}
294: 	}()
295: }
</file>

<file path="pkg/suricata/stats/collector.go">
  1: package stats
  2: 
  3: import (
  4: 	"bufio"
  5: 	"encoding/json"
  6: 	"fmt"
  7: 	"io"
  8: 	"os"
  9: 	"time"
 10: 
 11: 	nftbanConfig "github.com/itcmsgr/nftban/pkg/config"
 12: )
 13: 
 14: // EveAlert represents a Suricata alert from eve.json
 15: type EveAlert struct {
 16: 	Timestamp string `json:"timestamp"`
 17: 	EventType string `json:"event_type"`
 18: 	SrcIP     string `json:"src_ip"`
 19: 	DestIP    string `json:"dest_ip"`
 20: 	Alert     struct {
 21: 		Signature   string `json:"signature"`
 22: 		SignatureID int    `json:"signature_id"`
 23: 		Category    string `json:"category"`
 24: 		Severity    int    `json:"severity"`
 25: 	} `json:"alert"`
 26: }
 27: 
 28: // Collector manages eve.json parsing and statistics collection
 29: type Collector struct {
 30: 	evePath string
 31: 	metrics *Metrics
 32: 	cache   *Cache
 33: 	stopCh  chan struct{}
 34: }
 35: 
 36: // NewCollector creates a new statistics collector
 37: func NewCollector(cache *Cache) (*Collector, error) {
 38: 	// Get eve.json path from distro config
 39: 	evePath, err := getEveJSONPath()
 40: 	if err != nil {
 41: 		return nil, err
 42: 	}
 43: 
 44: 	return &Collector{
 45: 		evePath: evePath,
 46: 		metrics: GetMetrics(),
 47: 		cache:   cache,
 48: 		stopCh:  make(chan struct{}),
 49: 	}, nil
 50: }
 51: 
 52: // getEveJSONPath returns eve.json path from distro config
 53: func getEveJSONPath() (string, error) {
 54: 	distro, err := nftbanConfig.LoadDistroConfig()
 55: 	if err != nil {
 56: 		return "", err
 57: 	}
 58: 
 59: 	evePath := distro.Paths["suricata_eve_log"]
 60: 	if evePath == "" {
 61: 		// Fallback to common paths
 62: 		evePath = "/var/log/suricata/eve.json"
 63: 	}
 64: 
 65: 	return evePath, nil
 66: }
 67: 
 68: // Start begins collecting statistics from eve.json
 69: func (c *Collector) Start() error {
 70: 	// Check if eve.json exists
 71: 	if _, err := os.Stat(c.evePath); os.IsNotExist(err) {
 72: 		return fmt.Errorf("eve.json not found: %s (is Suricata running?)", c.evePath)
 73: 	}
 74: 
 75: 	fmt.Printf("Starting eve.json collector: %s\n", c.evePath)
 76: 
 77: 	// Start tailing eve.json
 78: 	go c.tailEveJSON()
 79: 
 80: 	return nil
 81: }
 82: 
 83: // Stop stops the collector
 84: func (c *Collector) Stop() {
 85: 	close(c.stopCh)
 86: }
 87: 
 88: // tailEveJSON tails eve.json and processes alerts
 89: func (c *Collector) tailEveJSON() {
 90: 	for {
 91: 		select {
 92: 		case <-c.stopCh:
 93: 			return
 94: 		default:
 95: 			if err := c.processFile(); err != nil {
 96: 				fmt.Printf("Error processing eve.json: %v\n", err)
 97: 				time.Sleep(5 * time.Second) // Retry delay
 98: 			}
 99: 		}
100: 	}
101: }
102: 
103: // processFile reads and processes eve.json
104: func (c *Collector) processFile() error {
105: 	file, err := os.Open(c.evePath)
106: 	if err != nil {
107: 		return err
108: 	}
109: 	defer file.Close()
110: 
111: 	// Seek to end of file (only process new events)
112: 	if _, err := file.Seek(0, io.SeekEnd); err != nil {
113: 		return err
114: 	}
115: 
116: 	scanner := bufio.NewScanner(file)
117: 	for {
118: 		select {
119: 		case <-c.stopCh:
120: 			return nil
121: 		default:
122: 			if scanner.Scan() {
123: 				c.processLine(scanner.Text())
124: 			} else {
125: 				// No more data, wait a bit
126: 				time.Sleep(100 * time.Millisecond)
127: 			}
128: 		}
129: 	}
130: }
131: 
132: // processLine parses and processes a single eve.json line
133: func (c *Collector) processLine(line string) {
134: 	startTime := time.Now()
135: 
136: 	var event EveAlert
137: 	if err := json.Unmarshal([]byte(line), &event); err != nil {
138: 		c.metrics.RecordParseError()
139: 		return
140: 	}
141: 
142: 	// Only process alert events
143: 	if event.EventType != "alert" {
144: 		return
145: 	}
146: 
147: 	// Extract data
148: 	sid := fmt.Sprintf("%d", event.Alert.SignatureID)
149: 	category := event.Alert.Category
150: 	signature := event.Alert.Signature
151: 	severity := fmt.Sprintf("%d", event.Alert.Severity)
152: 	sourceIP := event.SrcIP
153: 
154: 	// Parse timestamp
155: 	timestamp, err := time.Parse(time.RFC3339, event.Timestamp)
156: 	if err != nil {
157: 		timestamp = time.Now()
158: 	}
159: 
160: 	// Record metrics
161: 	c.metrics.RecordTrigger(sid, category, signature, float64(timestamp.Unix()), sourceIP)
162: 	c.metrics.RecordSeverity(severity)
163: 
164: 	// Update cache
165: 	c.cache.RecordTrigger(sid, category, signature, sourceIP, timestamp)
166: 
167: 	// Record processing latency
168: 	c.metrics.ProcessingLatency.Observe(time.Since(startTime).Seconds())
169: }
170: 
171: // ProcessHistorical processes existing eve.json for historical data
172: func (c *Collector) ProcessHistorical(maxLines int) error {
173: 	file, err := os.Open(c.evePath)
174: 	if err != nil {
175: 		return err
176: 	}
177: 	defer file.Close()
178: 
179: 	fmt.Printf("Processing historical alerts from %s...\n", c.evePath)
180: 
181: 	scanner := bufio.NewScanner(file)
182: 	count := 0
183: 	alertCount := 0
184: 
185: 	for scanner.Scan() && (maxLines == 0 || count < maxLines) {
186: 		count++
187: 		line := scanner.Text()
188: 
189: 		var event EveAlert
190: 		if err := json.Unmarshal([]byte(line), &event); err != nil {
191: 			continue
192: 		}
193: 
194: 		// Only process alerts
195: 		if event.EventType != "alert" {
196: 			continue
197: 		}
198: 
199: 		alertCount++
200: 
201: 		// Extract data
202: 		sid := fmt.Sprintf("%d", event.Alert.SignatureID)
203: 		category := event.Alert.Category
204: 		signature := event.Alert.Signature
205: 		sourceIP := event.SrcIP
206: 
207: 		// Parse timestamp
208: 		timestamp, err := time.Parse(time.RFC3339, event.Timestamp)
209: 		if err != nil {
210: 			timestamp = time.Now()
211: 		}
212: 
213: 		// Update cache only (not Prometheus, as that would skew metrics)
214: 		c.cache.RecordTrigger(sid, category, signature, sourceIP, timestamp)
215: 
216: 		// Progress indicator
217: 		if alertCount%1000 == 0 {
218: 			fmt.Printf("  Processed %d alerts...\n", alertCount)
219: 		}
220: 	}
221: 
222: 	if err := scanner.Err(); err != nil {
223: 		return err
224: 	}
225: 
226: 	fmt.Printf("✓ Processed %d historical alerts\n", alertCount)
227: 	return nil
228: }
229: 
230: // GetStats returns current statistics summary
231: func (c *Collector) GetStats() map[string]interface{} {
232: 	return map[string]interface{}{
233: 		"eve_path":         c.evePath,
234: 		"cache_size":       c.cache.GetSize(),
235: 		"unique_sids":      c.cache.GetUniqueSIDs(),
236: 		"total_triggers":   c.cache.GetTotalTriggers(),
237: 		"unique_sources":   c.cache.GetUniqueSources(),
238: 	}
239: }
</file>

<file path="pkg/suricata/stats/metrics.go">
  1: package stats
  2: 
  3: import (
  4: 	"sync"
  5: 
  6: 	"github.com/prometheus/client_golang/prometheus"
  7: 	"github.com/prometheus/client_golang/prometheus/promauto"
  8: )
  9: 
 10: // Metrics holds all Suricata-related Prometheus metrics
 11: type Metrics struct {
 12: 	// SID trigger counters
 13: 	SIDTriggers *prometheus.CounterVec
 14: 
 15: 	// SID last trigger timestamp
 16: 	SIDLastTrigger *prometheus.GaugeVec
 17: 
 18: 	// Unique source IPs per SID
 19: 	SIDUniqueSources *prometheus.GaugeVec
 20: 
 21: 	// User actions (enabled/disabled)
 22: 	SIDUserEnabled *prometheus.GaugeVec
 23: 	SIDUserDisabled *prometheus.GaugeVec
 24: 
 25: 	// Category aggregates
 26: 	CategoryTriggers *prometheus.CounterVec
 27: 
 28: 	// Alert severity
 29: 	AlertSeverity *prometheus.CounterVec
 30: 
 31: 	// Performance metrics
 32: 	ProcessingLatency prometheus.Histogram
 33: 	EventsProcessed prometheus.Counter
 34: 	ParseErrors prometheus.Counter
 35: }
 36: 
 37: var (
 38: 	metrics *Metrics
 39: 	once    sync.Once
 40: )
 41: 
 42: // InitMetrics initializes Prometheus metrics (singleton)
 43: func InitMetrics() *Metrics {
 44: 	once.Do(func() {
 45: 		metrics = &Metrics{
 46: 			SIDTriggers: promauto.NewCounterVec(
 47: 				prometheus.CounterOpts{
 48: 					Name: "nftban_suricata_sid_triggers_total",
 49: 					Help: "Total number of triggers per SID",
 50: 				},
 51: 				[]string{"sid", "category", "signature"},
 52: 			),
 53: 
 54: 			SIDLastTrigger: promauto.NewGaugeVec(
 55: 				prometheus.GaugeOpts{
 56: 					Name: "nftban_suricata_sid_last_trigger_timestamp",
 57: 					Help: "Timestamp of last trigger for SID",
 58: 				},
 59: 				[]string{"sid", "category"},
 60: 			),
 61: 
 62: 			SIDUniqueSources: promauto.NewGaugeVec(
 63: 				prometheus.GaugeOpts{
 64: 					Name: "nftban_suricata_sid_unique_sources_total",
 65: 					Help: "Number of unique source IPs triggering this SID",
 66: 				},
 67: 				[]string{"sid", "category"},
 68: 			),
 69: 
 70: 			SIDUserEnabled: promauto.NewGaugeVec(
 71: 				prometheus.GaugeOpts{
 72: 					Name: "nftban_suricata_sid_user_enabled",
 73: 					Help: "SIDs manually enabled by user (1=enabled, 0=not)",
 74: 				},
 75: 				[]string{"sid", "mode"}, // mode: alert or drop
 76: 			),
 77: 
 78: 			SIDUserDisabled: promauto.NewGaugeVec(
 79: 				prometheus.GaugeOpts{
 80: 					Name: "nftban_suricata_sid_user_disabled",
 81: 					Help: "SIDs manually disabled by user (1=disabled, 0=not)",
 82: 				},
 83: 				[]string{"sid"},
 84: 			),
 85: 
 86: 			CategoryTriggers: promauto.NewCounterVec(
 87: 				prometheus.CounterOpts{
 88: 					Name: "nftban_suricata_category_triggers_total",
 89: 					Help: "Total triggers per rule category",
 90: 				},
 91: 				[]string{"category"},
 92: 			),
 93: 
 94: 			AlertSeverity: promauto.NewCounterVec(
 95: 				prometheus.CounterOpts{
 96: 					Name: "nftban_suricata_alert_severity_total",
 97: 					Help: "Alerts by severity level",
 98: 				},
 99: 				[]string{"severity"},
100: 			),
101: 
102: 			ProcessingLatency: promauto.NewHistogram(
103: 				prometheus.HistogramOpts{
104: 					Name:    "nftban_suricata_processing_latency_seconds",
105: 					Help:    "Latency of eve.json event processing",
106: 					Buckets: prometheus.DefBuckets,
107: 				},
108: 			),
109: 
110: 			EventsProcessed: promauto.NewCounter(
111: 				prometheus.CounterOpts{
112: 					Name: "nftban_suricata_events_processed_total",
113: 					Help: "Total number of eve.json events processed",
114: 				},
115: 			),
116: 
117: 			ParseErrors: promauto.NewCounter(
118: 				prometheus.CounterOpts{
119: 					Name: "nftban_suricata_parse_errors_total",
120: 					Help: "Total number of JSON parse errors",
121: 				},
122: 			),
123: 		}
124: 	})
125: 
126: 	return metrics
127: }
128: 
129: // GetMetrics returns the singleton metrics instance
130: func GetMetrics() *Metrics {
131: 	if metrics == nil {
132: 		return InitMetrics()
133: 	}
134: 	return metrics
135: }
136: 
137: // RecordTrigger records a SID trigger event
138: func (m *Metrics) RecordTrigger(sid, category, signature string, timestamp float64, sourceIP string) {
139: 	// Increment trigger counter
140: 	m.SIDTriggers.WithLabelValues(sid, category, signature).Inc()
141: 
142: 	// Update last trigger timestamp
143: 	m.SIDLastTrigger.WithLabelValues(sid, category).Set(timestamp)
144: 
145: 	// Increment category counter
146: 	m.CategoryTriggers.WithLabelValues(category).Inc()
147: 
148: 	// Events processed counter
149: 	m.EventsProcessed.Inc()
150: }
151: 
152: // RecordSeverity records alert severity
153: func (m *Metrics) RecordSeverity(severity string) {
154: 	m.AlertSeverity.WithLabelValues(severity).Inc()
155: }
156: 
157: // SetUserEnabled sets user-enabled flag for a SID
158: func (m *Metrics) SetUserEnabled(sid, mode string) {
159: 	m.SIDUserEnabled.WithLabelValues(sid, mode).Set(1)
160: }
161: 
162: // SetUserDisabled sets user-disabled flag for a SID
163: func (m *Metrics) SetUserDisabled(sid string) {
164: 	m.SIDUserDisabled.WithLabelValues(sid).Set(1)
165: }
166: 
167: // ClearUserEnabled clears user-enabled flag for a SID
168: func (m *Metrics) ClearUserEnabled(sid, mode string) {
169: 	m.SIDUserEnabled.WithLabelValues(sid, mode).Set(0)
170: }
171: 
172: // ClearUserDisabled clears user-disabled flag for a SID
173: func (m *Metrics) ClearUserDisabled(sid string) {
174: 	m.SIDUserDisabled.WithLabelValues(sid).Set(0)
175: }
176: 
177: // RecordParseError increments parse error counter
178: func (m *Metrics) RecordParseError() {
179: 	m.ParseErrors.Inc()
180: }
</file>

<file path="pkg/suricata/ban_handler.go">
  1: package suricata
  2: 
  3: import (
  4: 	"fmt"
  5: 	"net"
  6: 	"time"
  7: 
  8: 	"github.com/google/nftables"
  9: 	"github.com/itcmsgr/nftban/pkg/analytics"
 10: 	"github.com/itcmsgr/nftban/pkg/banlog"
 11: 	"github.com/itcmsgr/nftban/pkg/geoip"
 12: 	"github.com/itcmsgr/nftban/pkg/sync"
 13: )
 14: 
 15: // NetlinkBanHandler implements BanHandler using the existing netlink infrastructure
 16: // This matches the existing fail2ban approach - uses sync.NFTManager for banning
 17: type NetlinkBanHandler struct {
 18: 	nftManager *sync.NFTManager
 19: }
 20: 
 21: // NewNetlinkBanHandler creates a new ban handler using the existing netlink infrastructure
 22: func NewNetlinkBanHandler() (*NetlinkBanHandler, error) {
 23: 	nftManager, err := sync.NewNFTManager()
 24: 	if err != nil {
 25: 		return nil, fmt.Errorf("failed to create NFT manager: %w", err)
 26: 	}
 27: 
 28: 	return &NetlinkBanHandler{
 29: 		nftManager: nftManager,
 30: 	}, nil
 31: }
 32: 
 33: // BanIP bans an IP using the existing netlink/nftables infrastructure
 34: // This is the same mechanism used by fail2ban integration
 35: func (h *NetlinkBanHandler) BanIP(ip string, duration time.Duration, reason string) error {
 36: 	// Validate IP
 37: 	parsedIP := net.ParseIP(ip)
 38: 	if parsedIP == nil {
 39: 		return fmt.Errorf("invalid IP address: %s", ip)
 40: 	}
 41: 
 42: 	// Determine if IPv4 or IPv6
 43: 	isIPv4 := parsedIP.To4() != nil
 44: 
 45: 	// Get or create appropriate table
 46: 	var family nftables.TableFamily
 47: 	var setName string
 48: 
 49: 	if isIPv4 {
 50: 		family = nftables.TableFamilyIPv4
 51: 		setName = "blacklist_ipv4"
 52: 	} else {
 53: 		family = nftables.TableFamilyIPv6
 54: 		setName = "blacklist_ipv6"
 55: 	}
 56: 
 57: 	// Get table
 58: 	table, err := h.nftManager.GetOrCreateTable(family)
 59: 	if err != nil {
 60: 		return fmt.Errorf("failed to get nftables table: %w", err)
 61: 	}
 62: 
 63: 	// Get set
 64: 	set, err := h.nftManager.GetOrCreateSet(table, setName, isIPv4)
 65: 	if err != nil {
 66: 		return fmt.Errorf("failed to get blacklist set: %w", err)
 67: 	}
 68: 
 69: 	// Add IP with timeout using existing netlink infrastructure
 70: 	// This is the same AddIPWithTimeout used by cmdBan
 71: 	if err := h.nftManager.AddIPWithTimeout(set, ip, duration); err != nil {
 72: 		return fmt.Errorf("failed to add IP to nftables: %w", err)
 73: 	}
 74: 
 75: 	// Record analytics (if initialized)
 76: 	// Analytics extracts service dynamically from reason parameter
 77: 	country, city := lookupGeoIP(ip)
 78: 	if st := analytics.StateOrNil(); st != nil {
 79: 		st.RecordBan(ip, country, city, "suricata", reason, time.Now())
 80: 	}
 81: 
 82: 	// Log to central bans.log for stats dashboard
 83: 	if country == "" {
 84: 		country = "UNK"
 85: 	}
 86: 	_ = banlog.LogBan(ip, banlog.SourceSuricata, country)
 87: 
 88: 	return nil
 89: }
 90: 
 91: // lookupGeoIP performs GeoIP lookup for an IP address
 92: // Returns country code and city name
 93: func lookupGeoIP(ip string) (country string, city string) {
 94: 	return geoip.LookupIP(ip)
 95: }
 96: 
 97: // Close closes the ban handler and cleans up resources
 98: func (h *NetlinkBanHandler) Close() {
 99: 	if h.nftManager != nil {
100: 		h.nftManager.Close()
101: 	}
102: }
</file>

<file path="pkg/suricata/logger.go">
  1: package suricata
  2: 
  3: import (
  4: 	"fmt"
  5: 	"os"
  6: 	"sync"
  7: 	"time"
  8: 
  9: 	"github.com/itcmsgr/nftban/pkg/nftbanconf"
 10: )
 11: 
 12: // EventLogger logs Suricata events and actions to file
 13: type EventLogger struct {
 14: 	mu       sync.Mutex
 15: 	file     *os.File
 16: 	path     string
 17: }
 18: 
 19: // NewEventLogger creates a new event logger
 20: func NewEventLogger(logPath string) (*EventLogger, error) {
 21: 	// Get log directory from central config
 22: 	// NO FALLBACK - path must come from /etc/nftban/nftban.conf
 23: 	cfg := nftbanconf.MustLoad()
 24: 	logDir := cfg.LogDir
 25: 
 26: 	// Ensure log directory exists
 27: 	if err := os.MkdirAll(logDir, 0755); err != nil {
 28: 		return nil, fmt.Errorf("failed to create log directory: %w", err)
 29: 	}
 30: 
 31: 	// Open log file (create if not exists, append mode)
 32: 	file, err := os.OpenFile(logPath, os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0644)
 33: 	if err != nil {
 34: 		return nil, fmt.Errorf("failed to open log file: %w", err)
 35: 	}
 36: 
 37: 	return &EventLogger{
 38: 		file: file,
 39: 		path: logPath,
 40: 	}, nil
 41: }
 42: 
 43: // Close closes the log file
 44: func (l *EventLogger) Close() error {
 45: 	l.mu.Lock()
 46: 	defer l.mu.Unlock()
 47: 
 48: 	if l.file != nil {
 49: 		return l.file.Close()
 50: 	}
 51: 	return nil
 52: }
 53: 
 54: // LogEvent logs a Suricata event with calculated score
 55: func (l *EventLogger) LogEvent(event *Event, score int, threshold int, action string, decision string) error {
 56: 	l.mu.Lock()
 57: 	defer l.mu.Unlock()
 58: 
 59: 	timestamp := event.Timestamp.Format("2006-01-02 15:04:05")
 60: 
 61: 	// Format: 2025-11-29 12:00:00 [ACTION] IP=1.2.3.4 filter=ssh score=95/80 action=ban sig_id=2001219 msg="ET SCAN SSH BruteForce"
 62: 	logLine := fmt.Sprintf("%s [%-7s] IP=%-15s filter=%-10s score=%3d/%-3d action=%-7s sig_id=%d msg=\"%s\"\n",
 63: 		timestamp,
 64: 		decision,      // LOG, OBSERVE, BAN
 65: 		event.SrcIP,
 66: 		event.Filter,
 67: 		score,
 68: 		threshold,
 69: 		action,        // log, observe, ban
 70: 		event.SignatureID,
 71: 		event.Signature,
 72: 	)
 73: 
 74: 	if _, err := l.file.WriteString(logLine); err != nil {
 75: 		return fmt.Errorf("failed to write log: %w", err)
 76: 	}
 77: 
 78: 	// Force sync to disk
 79: 	return l.file.Sync()
 80: }
 81: 
 82: // LogBanAction logs a Suricata-triggered ban action with score details
 83: func (l *EventLogger) LogBanAction(ip string, filter string, score int, threshold int, banTime time.Duration, reason string) error {
 84: 	l.mu.Lock()
 85: 	defer l.mu.Unlock()
 86: 
 87: 	timestamp := time.Now().Format("2006-01-02 15:04:05")
 88: 
 89: 	logLine := fmt.Sprintf("%s [BAN    ] IP=%-15s filter=%-10s score=%3d/%-3d ban_time=%-6s reason=\"%s\"\n",
 90: 		timestamp,
 91: 		ip,
 92: 		filter,
 93: 		score,
 94: 		threshold,
 95: 		formatDuration(banTime),
 96: 		reason,
 97: 	)
 98: 
 99: 	if _, err := l.file.WriteString(logLine); err != nil {
100: 		return fmt.Errorf("failed to write ban log: %w", err)
101: 	}
102: 
103: 	return l.file.Sync()
104: }
105: 
106: // LogError logs an error
107: func (l *EventLogger) LogError(context string, err error) error {
108: 	l.mu.Lock()
109: 	defer l.mu.Unlock()
110: 
111: 	timestamp := time.Now().Format("2006-01-02 15:04:05")
112: 
113: 	logLine := fmt.Sprintf("%s [ERROR  ] %s: %v\n",
114: 		timestamp,
115: 		context,
116: 		err,
117: 	)
118: 
119: 	if _, err := l.file.WriteString(logLine); err != nil {
120: 		return fmt.Errorf("failed to write error log: %w", err)
121: 	}
122: 
123: 	return l.file.Sync()
124: }
125: 
126: // formatDuration formats duration for logging
127: func formatDuration(d time.Duration) string {
128: 	if d < time.Minute {
129: 		return fmt.Sprintf("%ds", int(d.Seconds()))
130: 	} else if d < time.Hour {
131: 		return fmt.Sprintf("%dm", int(d.Minutes()))
132: 	} else if d < 24*time.Hour {
133: 		return fmt.Sprintf("%dh", int(d.Hours()))
134: 	}
135: 	return fmt.Sprintf("%dd", int(d.Hours()/24))
136: }

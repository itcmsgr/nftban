166:                 // Toggle portscan detection (calls nftban portscan enable/disable)
167:                 async function togglePortscan() {
168:                     const toggle = document.getElementById('portscan-toggle');
169:                     const msgEl = document.getElementById('portscan-msg');
170:                     const statusEl = document.getElementById('portscan-toggle-status');
171:                     const isEnabled = toggle.checked;
172: 
173:                     // Disable toggle during operation
174:                     toggle.disabled = true;
175:                     statusEl.textContent = isEnabled ? 'Enabling...' : 'Disabling...';
176:                     statusEl.style.color = '#6b7280';
177: 
178:                     try {
179:                         // Call nftban portscan enable/disable via API
180:                         const action = isEnabled ? 'enable' : 'disable';
181:                         const response = await fetch('/api/v1/portscan/control', {
182:                             method: 'POST',
183:                             headers: {
184:                                 ...getAuthHeaders(),
185:                                 'Content-Type': 'application/json'
186:                             },
187:                             body: JSON.stringify({ action: action })
188:                         });
189:                         const result = await response.json();
190: 
191:                         if (response.ok && result.success) {
192:                             msgEl.className = 'bg-green-100 text-green-800 p-15 rad-6 mt-15';
193:                             msgEl.textContent = isEnabled ? '✅ Port scan detection enabled successfully' : '✅ Port scan detection disabled successfully';
194:                             msgEl.classList.remove('hidden');
195: 
196:                             // Update status text
197:                             statusEl.textContent = isEnabled ? 'ENABLED' : 'DISABLED';
198:                             statusEl.style.color = isEnabled ? '#10b981' : '#ef4444';
199: 
200:                             // Refresh stats
201:                             setTimeout(() => loadPortscanStats(), 500);
202:                         } else {
203:                             // Revert toggle on error
204:                             toggle.checked = !isEnabled;
205:                             msgEl.className = 'bg-red-100 text-red-800 p-15 rad-6 mt-15';
206:                             msgEl.textContent = '❌ Failed to ' + action + ': ' + (result.error || 'Unknown error');
207:                             msgEl.classList.remove('hidden');
208:                             statusEl.textContent = !isEnabled ? 'ENABLED' : 'DISABLED';
209:                             statusEl.style.color = !isEnabled ? '#10b981' : '#ef4444';
210:                         }
211:                     } catch (err) {
212:                         // Revert toggle on error
213:                         toggle.checked = !isEnabled;
214:                         msgEl.className = 'bg-red-100 text-red-800 p-15 rad-6 mt-15';
215:                         msgEl.textContent = '❌ Error: ' + err.message;
216:                         msgEl.classList.remove('hidden');
217:                         statusEl.textContent = !isEnabled ? 'ENABLED' : 'DISABLED';
218:                         statusEl.style.color = !isEnabled ? '#10b981' : '#ef4444';
219:                     } finally {
220:                         // Re-enable toggle
221:                         toggle.disabled = false;
222:                     }
223:                 }
224: 
225:                 // Load portscan statistics
226:                 async function loadPortscanStats() {
227:                     const toggle = document.getElementById('portscan-toggle');
228:                     const statusEl = document.getElementById('portscan-toggle-status');
229:                     const modeEl = document.getElementById('ps-mode');
230:                     const suricataBadge = document.getElementById('ps-suricata-badge');
231: 
232:                     try {
233:                         const response = await fetch('/api/v1/portscan/stats', {
234:                             headers: getAuthHeaders()
235:                         });
236:                         const result = await response.json();
237: 
238:                         if (response.ok && result.success && result.data && result.data.portscan) {
239:                             const ps = result.data.portscan;
240: 
241:                             // Update statistics
242:                             document.getElementById('ps-monitored-ports').textContent = ps.monitored_ports || 0;
243:                             document.getElementById('ps-blocked-24h').textContent = ps.blocked_24h || 0;
244:                             document.getElementById('ps-blocked-total').textContent = ps.blocked_total || 0;
245: 
246:                             // Update mode indicator
247:                             const mode = ps.mode || 'classic';
248:                             const modeDisplay = mode.charAt(0).toUpperCase() + mode.slice(1);
249:                             modeEl.textContent = modeDisplay;
250: 
251:                             // Show Suricata badge if available
252:                             if (ps.suricata_available) {
253:                                 suricataBadge.classList.remove('hidden');
254:                             } else {
255:                                 suricataBadge.classList.add('hidden');
256:                             }
257: 
258:                             // Update toggle state
259:                             toggle.checked = ps.enabled || false;
260:                             toggle.disabled = false;
261: 
262:                             // Update status text with color and mode
263:                             if (ps.enabled) {
264:                                 statusEl.textContent = `ENABLED (${modeDisplay})`;
265:                             } else {
266:                                 statusEl.textContent = 'DISABLED';
267:                             }
268:                             statusEl.style.color = ps.enabled ? '#10b981' : '#ef4444';
269:                         } else {
270:                             statusEl.textContent = 'Error';
271:                             statusEl.style.color = '#ef4444';
272:                         }
273:                     } catch (err) {
274:                         console.error('[PORTSCAN] Failed to load stats:', err);
275:                         statusEl.textContent = 'Error';
276:                         statusEl.style.color = '#ef4444';
277:                     }
278:                 }
279: 
280:                 // Configuration data storage
281:                 var portscanConfigData = { defaults: {}, overrides: {}, merged: {} };
282: 
283:                 // Load portscan configuration
284:                 async function loadPortscanConfig() {
285:                     try {
286:                         const response = await fetch('/api/v1/config/portscan', {
287:                             headers: getAuthHeaders()
288:                         });
289:                         const result = await response.json();
290: 
291:                         if (response.ok && result.success && result.data) {
292:                             portscanConfigData = result.data;
293:                             renderPortscanConfigTable();
294:                         } else {
295:                             document.getElementById('portscan-config-table').innerHTML = '<tr><td colspan="4" class="txt-c py-8 text-danger">Failed to load configuration</td></tr>';
296:                         }
297:                     } catch (err) {
298:                         console.error('[PORTSCAN] Failed to load config:', err);
299:                         document.getElementById('portscan-config-table').innerHTML = '<tr><td colspan="4" class="txt-c py-8 text-danger">Error: ' + err.message + '</td></tr>';
300:                     }
301:                 }
302: 
303:                 // Render configuration table
304:                 function renderPortscanConfigTable() {
305:                     const tbody = document.getElementById('portscan-config-table');
306:                     const defaults = portscanConfigData.defaults || {};
307:                     const overrides = portscanConfigData.overrides || {};
308:                     const merged = portscanConfigData.merged || {};
309: 
310:                     let html = '';
311:                     Object.keys(defaults).sort().forEach(key => {
312:                         const defaultValue = defaults[key] || '';
313:                         const currentValue = merged[key] || '';
314:                         const isOverridden = overrides.hasOwnProperty(key);
315:                         const bgClass = isOverridden ? 'bg-yellow-100' : '';
316: 
317:                         // Determine input type
318:                         let inputHtml = '';
319:                         if (currentValue === 'true' || currentValue === 'false') {
320:                             // Boolean - dropdown
321:                             inputHtml = `
322:                                 <select id="portscan_config_${key}" class="w-full px-2 py-1 help-feature-box main-border rad-6 fs-14">
323:                                     <option value="true" ${currentValue === 'true' ? 'selected' : ''}>true</option>
324:                                     <option value="false" ${currentValue === 'false' ? 'selected' : ''}>false</option>
325:                                 </select>`;
326:                         } else {
327:                             // String or number - input
328:                             inputHtml = `<input type="text" id="portscan_config_${key}" value="${escapeHtml(currentValue)}" class="w-full px-2 py-1 help-feature-box main-border rad-6 fs-14 font-mono">`;
329:                         }
330: 
331:                         html += `
332:                             <tr class="${bgClass}">
333:                                 <td class="px-15 py-8 main-border"><code class="fs-13">${key}</code></td>
334:                                 <td class="px-15 py-8 main-border"><code class="fs-13 text-muted">${escapeHtml(defaultValue)}</code></td>
335:                                 <td class="px-15 py-8 main-border">${inputHtml}</td>
336:                                 <td class="px-15 py-8 main-border txt-c">
337:                                     <button onclick="resetPortscanConfigKey('${key}')" class="px-10 py-5 bg-orange-500 text-white rad-6 fs-12 hover:bg-orange-600" ${!isOverridden ? 'disabled style="opacity:0.5;cursor:not-allowed;"' : ''}>Reset</button>
338:                                 </td>
339:                             </tr>`;
340:                     });
341: 
342:                     tbody.innerHTML = html;
343:                 }
344: 
345:                 // Save all configuration changes
346:                 async function saveAllPortscanConfig() {
347:                     const msgDiv = document.getElementById('portscan-config-msg');
348:                     msgDiv.className = 'p-15 rad-6 bg-blue-100 text-blue-800 fs-14';
349:                     msgDiv.textContent = '💾 Saving configuration...';
350:                     msgDiv.classList.remove('hidden');
351: 
352:                     // Collect all changed values
353:                     const updates = {};
354:                     Object.keys(portscanConfigData.defaults).forEach(key => {
355:                         const input = document.getElementById('portscan_config_' + key);
356:                         if (input) {
357:                             const newValue = input.value;
358:                             const defaultValue = portscanConfigData.defaults[key];
359:                             // Only save if different from default
360:                             if (newValue !== defaultValue) {
361:                                 updates[key] = newValue;
362:                             }
363:                         }
364:                     });
365: 
366:                     try {
367:                         const response = await fetch('/api/v1/config/portscan', {
368:                             method: 'POST',

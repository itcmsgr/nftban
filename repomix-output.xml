 42: // GetLogFile returns the path for a specific log category
 43: func GetLogFile(category LogCategory) string {
 44: 	paths := GetPaths()
 45: 	if paths == nil {
 46: 		return ""
 47: 	}
 48: 
 49: 	switch category {
 50: 	case LogCategoryMain:
 51: 		return paths.MainLog
 52: 	case LogCategoryAudit:

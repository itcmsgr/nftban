  3: // =============================================================================
  4: // NFTBan Central Configuration Loader
  5: // =============================================================================
  6: // Purpose: Read /etc/nftban/nftban.conf - the SINGLE SOURCE OF TRUTH
  7: //          Both bash CLI and Go binaries use the SAME config file
  8: //
  9: // IMPORTANT: This package reads configuration from bash config files.
 10: //            DO NOT hardcode paths here - they come from nftban.conf!
 11: // =============================================================================
 12: 
 13: import (
 14: 	"bufio"
 15: 	"os"
 16: 	"strconv"
 17: 	"strings"
 18: 	"sync"
 19: 	"time"
 20: )
 21: 
 22: // Config holds all NFTBan configuration from /etc/nftban/nftban.conf
 23: // Variable names match the bash config exactly (e.g., NFTBAN_BIN -> Bin)
 24: type Config struct {
 25: 	// Version
 26: 	Version       string
 27: 	ConfigVersion string
 28: 
 29: 	// Binary paths (from nftban.conf PATHS section)
 30: 	Bin      string // NFTBAN_BIN - main CLI
 31: 	CoreBin  string // NFTBAN_CORE_BIN - Go core binary
 32: 	UIBin    string // NFTBAN_UI_BIN - Web UI binary
 33: 	AuthBin  string // NFTBAN_AUTH_BIN - Auth helper
 34: 
 35: 	// Directory paths
 36: 	LibDir    string // NFTBAN_LIB_DIR
 37: 	ConfigDir string // NFTBAN_CONFIG_DIR
 38: 	DataDir   string // NFTBAN_DATA_DIR
 39: 	LogDir    string // NFTBAN_LOG_DIR
 40: 	CacheDir  string // NFTBAN_CACHE_DIR
 41: 	RunDir    string // NFTBAN_RUN_DIR
 42: 
 43: 	// Feature flags
 44: 	MetricsEnabled      bool   // NFTBAN_METRICS_ENABLED
 45: 	MetricsBackend      string // NFTBAN_METRICS_BACKEND
 46: 	MetricsSamplingInterval int // NFTBAN_METRICS_SAMPLING_INTERVAL (seconds)
 47: 	MetricsMaxSamples   int    // NFTBAN_METRICS_MAX_SAMPLES
 48: 	PrometheusDir       string // NFTBAN_PROMETHEUS_DIR (node_exporter textfile dir)
 49: 	MetricsPrometheusAddr   string // NFTBAN_METRICS_PROMETHEUS_ADDR
 50: 	MetricsNodeExporterAddr string // NFTBAN_METRICS_NODE_EXPORTER_ADDR

#!/usr/bin/env bash
# SPDX-License-Identifier: MPL-2.0
# nftban-baseline-save - Save baseline inventory snapshot
# Part of NFTBan v0.30 - Self-healing monitoring system

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: nftban-baseline-save [--dir DIR] [--name NAME.json] [--sign KEY.pem] [--rotate N]

Creates a baseline JSON from `nftban-health --inventory`. Optionally signs the
output and maintains a "baseline-latest.json" symlink.

Options:
  --dir DIR         Directory to write files (default: /var/lib/nftban/reports)
  --name NAME.json  Exact filename (default: hostname-YYYYmmddTHHMMSSZ.json)
  --sign KEY.pem    Sign the output (envelope format)
  --rotate N        Keep only the N most recent baselines (delete older ones)
  -h, --help        Show help
EOF
}

DIR="/var/lib/nftban/reports"
NAME=""
SIGN_KEY=""
ROTATE=""

while (( "$#" )); do
  case "$1" in
    --dir) DIR="${2:-}"; shift 2;;
    --name) NAME="${2:-}"; shift 2;;
    --sign) SIGN_KEY="${2:-}"; shift 2;;
    --rotate) ROTATE="${2:-}"; shift 2;;
    -h|--help) usage; exit 0;;
    *) echo "Unknown arg: $1" >&2; usage; exit 2;;
  esac
done

mkdir -p "$DIR"
HOST=$(hostname -f 2>/dev/null || hostname)
TS=$(date -u +%Y%m%dT%H%M%SZ)
FILE="${NAME:-$HOST-$TS.json}"
OUT="$DIR/$FILE"

# Generate baseline
if [ -n "$SIGN_KEY" ]; then
  nftban-health --inventory --sign "$SIGN_KEY" > "$OUT"
else
  nftban-health --inventory > "$OUT"
fi

# Create symlink
ln -sfn "$OUT" "$DIR/baseline-latest.json"

# Rotation
if [ -n "$ROTATE" ]; then
  ls -1t "$DIR"/*.json 2>/dev/null | tail -n +$((ROTATE+1)) | xargs -r rm -f --
fi

echo "Saved: $OUT"

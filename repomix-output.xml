 297: nftban_stats_top_sources() {
 298:     # Get top ban sources (login, portscan, ddos, manual, feeds)
 299:     # Usage: nftban_stats_top_sources [limit] [since] [until]
 300:     # Returns: JSON array [{"name":"source","count":N},...]
 301: 
 302:     local limit="${1:-${STATS_TOP_N}}"
 303:     local since="${2:-1970-01-01}"
 304:     local until="${3:-$(date +%Y-%m-%d)}"
 305: 
 306:     if [[ ! -f "$NFTBAN_BAN_LOG" ]]; then
 307:         echo "[]"
 308:         return 0
 309:     fi
 310: 
 311:     awk -F'|' -v since="$since" -v until="$until" -v limit="$limit" \
 312:         '$1 >= since && $1 <= until && $6 == "BANNED" {sources[$3]++}
 313:          END {
 314:              for (s in sources) print sources[s], s
 315:          }' \
 316:         "$NFTBAN_BAN_LOG" | \
 317:     sort -rn | \
 318:     awk -v limit="$limit" 'BEGIN{printf "["}
 319:          NR>1 && NR<=limit+1{printf ","}
 320:          NR<=limit {printf "{\"name\":\"%s\",\"count\":%d}", $2, $1}
 321:          NR==limit {exit}
 322:          END{printf "]"}'
 323: }

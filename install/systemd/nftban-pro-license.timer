# meta:name="nftban-pro-license.timer"
# meta:type="systemd"
# meta:tier="PRO"
# meta:owner="Antonios Voulvoulis <contact@nftban.com>"
# meta:created_date="2026-01-08"
# meta:description="Timer for periodic Pro license validation"
# meta:input="None"
# meta:output="Systemd unit"
# meta:depends=""
# meta:inventory.files=""
# meta:inventory.binaries=""
# meta:inventory.env_vars=""
# meta:inventory.config_files=""
# meta:inventory.systemd_units="nftban-pro-license.service"
# meta:inventory.network=""
# meta:inventory.privileges="root"
# =============================================================================

[Unit]
Description=NFTBan Pro License Check Timer
Documentation=man:nftban(8)
# v1.19.0: Removed Requires= — causes timer to stop when oneshot completes (Task 47)
ConditionPathExists=/etc/nftban/pro.token

[Timer]
# Run every 6 hours (00:00, 06:00, 12:00, 18:00)
OnCalendar=*-*-* 00/6:00:00

# JITTER: 30m variance for license check (increased from 15m)
RandomizedDelaySec=30m

# DETERMINISTIC: Same offset per host for predictable behavior
FixedRandomDelay=true

# Also run 5 minutes after boot
OnBootSec=5min

# Persist timer across reboots
Persistent=true

# Unit to activate
Unit=nftban-pro-license.service

[Install]
WantedBy=timers.target

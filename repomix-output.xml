144: // LoadSpecificFeed loads a single feed by name
145: // Returns IPv4 IPs, IPv6 IPs, IPv4 CIDRs, IPv6 CIDRs
146: func LoadSpecificFeed(feedsDir string, feedName string) ([]string, []string, []string, []string, error) {
147: 	fileName := feedName + ".txt"
148: 	filePath := filepath.Join(feedsDir, fileName)
149: 
150: 	// Check if file exists
151: 	if _, err := os.Stat(filePath); os.IsNotExist(err) {
152: 		return nil, nil, nil, nil, fmt.Errorf("feed '%s' not found", feedName)
153: 	}
154: 
155: 	// Load this feed
156: 	ipv4Set := make(map[string]bool)
157: 	ipv6Set := make(map[string]bool)
158: 	ipv4CIDRSet := make(map[string]bool)
159: 	ipv6CIDRSet := make(map[string]bool)
160: 	_, _, _, _, err := loadFeedFile(filePath, ipv4Set, ipv6Set, ipv4CIDRSet, ipv6CIDRSet)
161: 	if err != nil {
162: 		return nil, nil, nil, nil, fmt.Errorf("failed to load feed: %w", err)
163: 	}
164: 
165: 	// Convert maps to slices
166: 	var ipv4List []string
167: 	for ip := range ipv4Set {
168: 		ipv4List = append(ipv4List, ip)
169: 	}
170: 
171: 	var ipv6List []string
172: 	for ip := range ipv6Set {
173: 		ipv6List = append(ipv6List, ip)
174: 	}
175: 
176: 	var ipv4CIDRList []string
177: 	for cidr := range ipv4CIDRSet {
178: 		ipv4CIDRList = append(ipv4CIDRList, cidr)
179: 	}
180: 
181: 	var ipv6CIDRList []string
182: 	for cidr := range ipv6CIDRSet {
183: 		ipv6CIDRList = append(ipv6CIDRList, cidr)
184: 	}
185: 
186: 	return ipv4List, ipv6List, ipv4CIDRList, ipv6CIDRList, nil
187: }

 229: cmd_suricata_enable() {
 230:     _check_root enable || return 1
 231: 
 232:     echo ""
 233:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
 234:     echo "  🛡️  NFTBan - Enable Suricata IDS"
 235:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
 236:     echo ""
 237: 
 238:     # Check if installed
 239:     if ! _suricata_is_installed; then
 240:         echo "✗ Suricata is not installed"
 241:         echo ""
 242:         echo "Install first:"
 243:         echo "  nftban suricata install"
 244:         return 1
 245:     fi
 246: 
 247:     # Enable service
 248:     echo "  → Enabling Suricata service..."
 249:     systemctl enable "$SURICATA_SERVICE" || {
 250:         echo "  ✗ Failed to enable service"
 251:         return 1
 252:     }
 253:     echo "  ✓ Service enabled (will start on boot)"
 254: 
 255:     # Start service
 256:     echo "  → Starting Suricata service..."
 257:     systemctl start "$SURICATA_SERVICE" || {
 258:         echo "  ✗ Failed to start service"
 259:         echo ""
 260:         echo "Check logs:"
 261:         echo "  journalctl -u suricata -n 50"
 262:         return 1
 263:     }
 264: 
 265:     # Wait for startup
 266:     sleep 2
 267: 
 268:     # Verify running
 269:     if _suricata_is_running; then
 270:         echo "  ✓ Suricata is running"
 271:     else
 272:         echo "  ✗ Suricata failed to start"
 273:         systemctl status "$SURICATA_SERVICE" --no-pager -l
 274:         return 1
 275:     fi
 276: 
 277:     # Enable automatic rules update timer
 278:     if [[ -f /usr/lib/systemd/system/nftban-suricata-update.timer ]]; then
 279:         echo "  → Enabling weekly rules update timer..."
 280:         systemctl enable --now nftban-suricata-update.timer 2>/dev/null && \
 281:             echo "  ✓ Rules update timer enabled (weekly Sunday 3 AM)" || \
 282:             echo "  ⊘ Timer enable failed (not critical)"
 283:     fi
 284: 
 285:     echo ""
 286:     echo "✅ Suricata IDS is now ENABLED and RUNNING"
 287:     echo ""
 288:     echo "Automatic updates:"
 289:     echo "  Rules updated weekly (Sunday 3 AM)"
 290:     echo "  Manual update: nftban suricata rules update"
 291:     echo ""
 292:     echo "Monitor alerts:"
 293:     echo "  tail -f /var/log/suricata/eve.json | jq 'select(.event_type==\"alert\")'"
 294:     echo ""
 295:     echo "Check status:"
 296:     echo "  nftban suricata status"
 297:     echo ""
 298: }

391:     try {
392:         resultEl.innerHTML = '<p class="text-muted"><i class="fa fa-spinner fa-spin"></i> Banning IP...</p>';
393: 
394:         const response = await apiRequest('/ban', {
395:             method: 'POST',
396:             body: JSON.stringify({ ip, reason: reason || 'Manual ban via GUI' })
397:         });
398: 
399:         if (response.success) {
400:             resultEl.innerHTML = `<p class="text-success"><i class="fa fa-check"></i> IP ${ip} has been banned successfully</p>`;
401:             document.getElementById('ban-ip').value = '';
402:             document.getElementById('ban-reason').value = '';
403:         } else {
404:             resultEl.innerHTML = `<p class="text-danger"><i class="fa fa-triangle-exclamation"></i> ${response.error || 'Failed to ban IP'}</p>`;
405:         }
406:     } catch (error) {
407:         resultEl.innerHTML = `<p class="text-danger"><i class="fa fa-triangle-exclamation"></i> Failed to ban IP: ${error.message}</p>`;
408:     }

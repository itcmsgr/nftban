  20: // ipv4ToUint32 converts an IPv4 address to uint32 for arithmetic operations
  21: func ipv4ToUint32(ip net.IP) (uint32, error) {
  22: 	v4 := ip.To4()
  23: 	if v4 == nil {
  24: 		return 0, fmt.Errorf("not an IPv4 address: %v", ip)
  25: 	}
  26: 	return binary.BigEndian.Uint32(v4), nil
  27: }
  28: 
  29: // uint32ToIPv4 converts uint32 back to an IPv4 address
  30: func uint32ToIPv4(v uint32) net.IP {
  31: 	b := make([]byte, 4)
  32: 	binary.BigEndian.PutUint32(b, v)
  33: 	return net.IP(b)
  34: }

1007: nftban_health_check_config() {
1008:     # Check configuration files
1009:     # Returns: 0=OK, 1=Warning, 2=Error
1010: 
1011:     local status=$HEALTH_OK
1012:     local config_issues=()
1013: 
1014:     # Main config directory
1015:     if [[ ! -d "${NFTBAN_CONFIG_DIR}" ]]; then
1016:         config_issues+=("Config directory not found: ${NFTBAN_CONFIG_DIR}")
1017:         status=$HEALTH_ERROR
1018:     fi
1019: 
1020:     # Check for basic config files
1021:     local config_dir="${NFTBAN_CONFIG_DIR}/conf.d"
1022:     if [[ -d "$config_dir" ]]; then
1023:         # Try to source config files (in subshell)
1024:         # Check top-level conf files
1025:         for conf_file in "$config_dir"/*.conf; do
1026:             if [[ -f "$conf_file" ]]; then
1027:                 # shellcheck disable=SC1090  # Dynamic source for config validation
1028:                 if ! (source "$conf_file") 2>/dev/null; then
1029:                     config_issues+=("Config has syntax errors: $(basename "$conf_file")")
1030:                     status=$HEALTH_ERROR
1031:                 fi
1032:             fi
1033:         done
1034: 
1035:         # Check subdirectory config files (ddos/, portscan/, login/, panels/)
1036:         for subdir in "$config_dir"/*; do
1037:             if [[ -d "$subdir" ]]; then
1038:                 for conf_file in "$subdir"/*.conf; do
1039:                     if [[ -f "$conf_file" ]]; then
1040:                         # shellcheck disable=SC1090  # Dynamic source for config validation
1041:                         if ! (source "$conf_file") 2>/dev/null; then
1042:                             local relative_path; relative_path="$(basename "$subdir")/$(basename "$conf_file")"
1043:                             config_issues+=("Config has syntax errors: $relative_path")
1044:                             status=$HEALTH_ERROR
1045:                         fi
1046:                     fi
1047:                 done
1048:             fi
1049:         done
1050:     fi
1051: 
1052:     # Check system.conf (UID/GID configuration)
1053:     local system_conf="${NFTBAN_DATA_DIR}/config/system.conf"
1054:     if [[ ! -f "$system_conf" ]]; then
1055:         config_issues+=("System config missing: $system_conf (will auto-create)")
1056:         [[ $status -lt $HEALTH_WARNING ]] && status=$HEALTH_WARNING
1057:     else
1058:         # Verify system.conf is readable and has valid syntax
1059:         # shellcheck disable=SC1090  # Dynamic source for config validation
1060:         if ! (source "$system_conf") 2>/dev/null; then
1061:             config_issues+=("System config has syntax errors: $system_conf")
1062:             status=$HEALTH_ERROR
1063:         else
1064:             # Verify UID/GID values match actual system
1065:             # shellcheck disable=SC1090  # Dynamic source for config validation
1066:             source "$system_conf" 2>/dev/null
1067:             # NFTBan v1.0 simplified 2-group model: nftban + nftban-auditors
1068:             local actual_uid actual_gid actual_auditors_gid
1069:             actual_uid=$(id -u nftban 2>/dev/null || echo "MISSING")
1070:             actual_gid=$(id -g nftban 2>/dev/null || echo "MISSING")
1071:             actual_auditors_gid=$(getent group nftban-auditors 2>/dev/null | cut -d: -f3 || echo "MISSING")
1072: 
1073:             if [[ "$actual_uid" != "$NFTBAN_UID" ]] || \
1074:                [[ "$actual_gid" != "$NFTBAN_GID" ]] || \
1075:                [[ "$actual_auditors_gid" != "${NFTBAN_AUDITORS_GID:-MISSING}" ]]; then
1076:                 config_issues+=("System config outdated (UID/GID mismatch, will auto-fix)")

<file path="pkg/suricata/scanner/detector.go">
  1: package scanner
  2: 
  3: import (
  4: 	"fmt"
  5: 	"net"
  6: 	"time"
  7: )
  8: 
  9: // Service represents a detected network service
 10: type Service struct {
 11: 	Port     int
 12: 	Protocol string // tcp/udp
 13: 	Name     string // http, https, ssh, mysql, dns, etc.
 14: 	Banner   string // Service banner/version if detected
 15: }
 16: 
 17: // ScanResult contains all detected services
 18: type ScanResult struct {
 19: 	Services      []Service
 20: 	RuleCategories []string // Suricata rule categories to enable
 21: }
 22: 
 23: // CommonPorts defines the ports to scan
 24: var CommonPorts = []int{
 25: 	21,    // FTP
 26: 	22,    // SSH
 27: 	25,    // SMTP
 28: 	53,    // DNS
 29: 	80,    // HTTP
 30: 	110,   // POP3
 31: 	143,   // IMAP
 32: 	443,   // HTTPS
 33: 	3306,  // MySQL
 34: 	5432,  // PostgreSQL
 35: 	6379,  // Redis
 36: 	8080,  // HTTP-Alt
 37: 	8443,  // HTTPS-Alt
 38: 	9000,  // PHP-FPM
 39: 	11211, // Memcached
 40: }
 41: 
 42: // ScanLocalhost scans localhost for running services
 43: func ScanLocalhost() (*ScanResult, error) {
 44: 	result := &ScanResult{
 45: 		Services:       make([]Service, 0),
 46: 		RuleCategories: make([]string, 0),
 47: 	}
 48: 
 49: 	fmt.Println("Scanning localhost for services...")
 50: 
 51: 	for _, port := range CommonPorts {
 52: 		if service := scanPort("127.0.0.1", port); service != nil {
 53: 			result.Services = append(result.Services, *service)
 54: 			fmt.Printf("  ✓ Detected: %s on port %d\n", service.Name, service.Port)
 55: 		}
 56: 	}
 57: 
 58: 	// Map services to Suricata rule categories
 59: 	result.RuleCategories = mapServicesToCategories(result.Services)
 60: 
 61: 	return result, nil
 62: }
 63: 
 64: // scanPort attempts to connect to a port and detect the service
 65: func scanPort(host string, port int) *Service {
 66: 	address := fmt.Sprintf("%s:%d", host, port)
 67: 	conn, err := net.DialTimeout("tcp", address, 1*time.Second)
 68: 	if err != nil {
 69: 		return nil // Port closed or filtered
 70: 	}
 71: 	defer conn.Close()
 72: 
 73: 	// Basic service detection
 74: 	service := &Service{
 75: 		Port:     port,
 76: 		Protocol: "tcp",
 77: 		Name:     detectServiceByPort(port),
 78: 	}
 79: 
 80: 	// Attempt banner grab for certain services
 81: 	if port == 22 || port == 21 || port == 25 {
 82: 		banner := grabBanner(conn)
 83: 		if banner != "" {
 84: 			service.Banner = banner
 85: 		}
 86: 	}
 87: 
 88: 	return service
 89: }
 90: 
 91: // detectServiceByPort maps port numbers to service names
 92: func detectServiceByPort(port int) string {
 93: 	serviceMap := map[int]string{
 94: 		21:    "ftp",
 95: 		22:    "ssh",
 96: 		25:    "smtp",
 97: 		53:    "dns",
 98: 		80:    "http",
 99: 		110:   "pop3",
100: 		143:   "imap",
101: 		443:   "https",
102: 		3306:  "mysql",
103: 		5432:  "postgresql",
104: 		6379:  "redis",
105: 		8080:  "http-alt",
106: 		8443:  "https-alt",
107: 		9000:  "php-fpm",
108: 		11211: "memcached",
109: 	}
110: 
111: 	if name, ok := serviceMap[port]; ok {
112: 		return name
113: 	}
114: 	return "unknown"
115: }
116: 
117: // grabBanner attempts to read the service banner
118: func grabBanner(conn net.Conn) string {
119: 	conn.SetReadDeadline(time.Now().Add(2 * time.Second))
120: 	buffer := make([]byte, 512)
121: 	n, err := conn.Read(buffer)
122: 	if err != nil {
123: 		return ""
124: 	}
125: 	return string(buffer[:n])
126: }
127: 
128: // mapServicesToCategories maps detected services to Suricata rule categories
129: func mapServicesToCategories(services []Service) []string {
130: 	categories := make(map[string]bool)
131: 
132: 	for _, service := range services {
133: 		switch service.Name {
134: 		case "http", "http-alt":
135: 			categories["emerging-web_server"] = true
136: 			categories["emerging-web_client"] = true
137: 			categories["emerging-exploit"] = true
138: 			categories["emerging-scan"] = true
139: 
140: 		case "https", "https-alt":
141: 			categories["emerging-tls"] = true
142: 			categories["emerging-web_server"] = true
143: 
144: 		case "ssh":
145: 			categories["emerging-ssh"] = true
146: 			categories["emerging-exploit"] = true
147: 
148: 		case "ftp":
149: 			categories["emerging-ftp"] = true
150: 
151: 		case "smtp":
152: 			categories["emerging-smtp"] = true
153: 			categories["emerging-malware"] = true
154: 
155: 		case "dns":
156: 			categories["emerging-dns"] = true
157: 			categories["emerging-malware"] = true
158: 
159: 		case "mysql", "postgresql":
160: 			categories["emerging-sql"] = true
161: 			categories["emerging-exploit"] = true
162: 
163: 		case "pop3", "imap":
164: 			categories["emerging-pop3"] = true
165: 			categories["emerging-imap"] = true
166: 
167: 		case "redis", "memcached":
168: 			categories["emerging-exploit"] = true
169: 		}
170: 	}
171: 
172: 	// Always include these critical categories
173: 	categories["emerging-attack_response"] = true
174: 	categories["emerging-dos"] = true
175: 	categories["emerging-policy"] = true
176: 
177: 	// Convert map to slice
178: 	result := make([]string, 0, len(categories))
179: 	for cat := range categories {
180: 		result = append(result, cat)
181: 	}
182: 
183: 	return result
184: }
185: 
186: // GetServiceSummary returns a human-readable summary
187: func (sr *ScanResult) GetServiceSummary() string {
188: 	if len(sr.Services) == 0 {
189: 		return "No services detected"
190: 	}
191: 
192: 	summary := fmt.Sprintf("Detected %d service(s):\n", len(sr.Services))
193: 	for _, svc := range sr.Services {
194: 		summary += fmt.Sprintf("  • %s (port %d/%s)\n", svc.Name, svc.Port, svc.Protocol)
195: 		if svc.Banner != "" {
196: 			summary += fmt.Sprintf("    Banner: %s\n", svc.Banner)
197: 		}
198: 	}
199: 
200: 	summary += fmt.Sprintf("\nRecommended rule categories (%d):\n", len(sr.RuleCategories))
201: 	for _, cat := range sr.RuleCategories {
202: 		summary += fmt.Sprintf("  • %s\n", cat)
203: 	}
204: 
205: 	return summary
206: }

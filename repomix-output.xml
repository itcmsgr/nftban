 200: nftban_stats_count_active_bans() {
 201:     # Count currently active bans in nftables (v0.7.3 unified architecture)
 202:     # Usage: nftban_stats_count_active_bans
 203:     # Returns: Number of active bans
 204:     #
 205:     # v0.7.3: ALL bans (manual, feeds, geoban, temporary) consolidated into blacklist_ipv4/ipv6
 206:     # Uses dual-table architecture: ip nftban (IPv4) + ip6 nftban (IPv6)
 207: 
 208:     local total=0
 209: 
 210:     # Count blacklist_ipv4 (ALL IPv4 bans: permanent + temporary + feeds + geoban)
 211:     if nft list set "${NFTBAN_TABLE_IPV4}" blacklist_ipv4 &>/dev/null 2>&1; then
 212:         local black_v4
 213:         black_v4=$(nft list set "${NFTBAN_TABLE_IPV4}" blacklist_ipv4 2>/dev/null | { grep -oP '\d+\.\d+\.\d+\.\d+(/\d+)?' || true; } | wc -l 2>/dev/null)
 214:         black_v4=${black_v4:-0}
 215:         total=$((total + black_v4))
 216:     fi
 217: 
 218:     # Count blacklist_ipv6 (ALL IPv6 bans: permanent + temporary + feeds + geoban)
 219:     if nft list set "${NFTBAN_TABLE_IPV6}" blacklist_ipv6 &>/dev/null 2>&1; then
 220:         local black_v6
 221:         black_v6=$(nft list set "${NFTBAN_TABLE_IPV6}" blacklist_ipv6 2>/dev/null | { grep -oP '[0-9a-fA-F:]+::[0-9a-fA-F:]*(/\d+)?|[0-9a-fA-F:]+:[0-9a-fA-F:]+(/\d+)?' || true; } | wc -l 2>/dev/null)
 222:         black_v6=${black_v6:-0}
 223:         total=$((total + black_v6))
 224:     fi
 225: 
 226:     echo "$total"
 227: }

<file path="etc/nftban/conf.d/rbl/main.conf">
 1: # =============================================================================
 2: # NFTBan RBL Monitoring Configuration
 3: # =============================================================================
 4: # SPDX-License-Identifier: MPL-2.0
 5: # Purpose: RBL (Real-time Blackhole List) monitoring configuration
 6: #
 7: # **Description**
 8: # Configure automated RBL checking to monitor if server IPs are blacklisted
 9: # for spam, abuse, or malicious activity. Based on CSF RBL implementation.
10: #
11: # **Cache Location**
12: # Cache files stored in: /var/log/nftban/rbl/{IP}.cache
13: # =============================================================================
14: 
15: # Enable/disable RBL monitoring
16: NFTBAN_RBL_ENABLED="NO"
17: 
18: # Monitoring schedule (via systemd timer)
19: # Options: daily, hourly, disabled
20: NFTBAN_RBL_SCHEDULE="daily"
21: NFTBAN_RBL_SCHEDULE_TIME="02:00"  # For daily (02:00 AM)
22: 
23: # Alert email address
24: NFTBAN_RBL_ALERT_EMAIL=""
25: 
26: # Alert triggers
27: NFTBAN_RBL_ALERT_ON_NEW_LISTING="YES"  # Alert when IP newly listed
28: NFTBAN_RBL_ALERT_ON_DEGRADED="NO"      # Alert when many RBLs timeout
29: 
30: # DNS timeout per RBL query (seconds)
31: NFTBAN_RBL_TIMEOUT="4"
32: 
33: # Cache TTL (hours) - how long to cache results
34: NFTBAN_RBL_CACHE_TTL="24"
35: 
36: # Auto-discover public IPs from network interfaces?
37: NFTBAN_RBL_AUTO_DISCOVER_IPS="YES"
38: 
39: # Check IPv6 addresses (in addition to IPv4)?
40: NFTBAN_RBL_CHECK_IPV6="YES"
41: 
42: # Critical IPs to monitor (comma-separated)
43: # Tag format: IP:tag (e.g., "1.2.3.4:mail,5.6.7.8:web")
44: NFTBAN_RBL_CRITICAL_IPS=""
45: 
46: # Example:
47: # NFTBAN_RBL_CRITICAL_IPS="203.0.113.10:mail,203.0.113.20:web,203.0.113.30:panel"
48: 
49: # Severity by tag (affects alert priority)
50: NFTBAN_RBL_SEVERITY_MAIL="critical"    # Mail server IPs
51: NFTBAN_RBL_SEVERITY_WEB="high"         # Web server IPs
52: NFTBAN_RBL_SEVERITY_PANEL="high"       # Control panel IPs
53: NFTBAN_RBL_SEVERITY_DEFAULT="medium"   # Other IPs
54: 
55: # Cache directory (default: /var/log/nftban/rbl)
56: NFTBAN_RBL_CACHE_DIR="${NFTBAN_LOG_DIR}/rbl"
57: 
58: # RBL providers list file
59: NFTBAN_RBL_PROVIDERS_FILE="${NFTBAN_CONFIG_DIR}/conf.d/rbl/rbls.conf"
60: 
61: # Custom RBL configuration (enable/disable specific RBLs/IPs)
62: NFTBAN_RBL_CUSTOM_FILE="${NFTBAN_CONFIG_DIR}/conf.d/rbl/custom.conf"
</file>


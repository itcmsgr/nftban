                echo "help"
                ;;
            profile)
                echo "select"
                echo "apply"
                echo "show"
                echo "list"
                echo "help"
                ;;
            feeds)
                echo "select"
                echo "list"
                echo "enable"
                echo "disable"
                echo "enable-cat"
                echo "enable-category"
                echo "update"
                echo "status"
                echo "help"
                ;;
            flush)
                echo "blacklist"
                echo "whitelist"
                echo "feeds"
                echo "geoban"
                echo "ddos"
                echo "all"
                echo "--yes"
                echo "--dry-run"
                echo "help"
                ;;
            update)
                echo "check"
                echo "status"
                echo "github"
                echo "git"
                echo "local"
                echo "rollback"
                echo "list"
                echo "help"
                ;;
            support|support-bundle)
                echo "--quick"
                echo "--network"
                echo "--output"
                echo "--help"
                ;;
            trust)
                echo "list"
                echo "enable"
                echo "disable"
                echo "update"
                echo "load"
                echo "status"
                echo "help"
                ;;
            country)
                echo "list"
                echo "enable"
                echo "disable"
                echo "mode"
                echo "status"
                echo "apply"
                echo "help"
                ;;
            firewall)
                echo "validate"
                echo "check"
                echo "stats"
                echo "logs"
                echo "reload"
                echo "help"
                ;;
            list)
                echo "banned"
                echo "whitelist"
                echo "all"
                echo "--json"
                echo "help"
                ;;
            test)
                echo "--verbose"
                echo "help"
                ;;
            config)
                echo "get"
                echo "defaults"
                echo "overrides"
                echo "set"
                echo "reset"
                echo "reset-all"
                echo "test"
                echo "audit"
                echo "show"
                echo "diff"
                echo "help"
                ;;
            configtest)
                echo "--verbose"
                echo "--json"
                ;;
            configaudit)
                echo "--json"
                ;;

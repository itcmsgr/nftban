216: # Remove portscan rules
217: nftban_portscan_classic_remove_rules() {
218:     local table_ipv4="${PORTSCAN_NFT_TABLE_IPV4:-ip nftban}"
219:     local table_ipv6="${PORTSCAN_NFT_TABLE_IPV6:-ip6 nftban}"

[Unit]
Description=NFTBAN periodic maintenance (one-shot)
Documentation=man:nftban(8)

[Service]
Type=oneshot
# Run as root (feeds update requires root for nftables manipulation)
User=root
Group=root
EnvironmentFile=-/etc/nftban/nftban.env
ExecStart=/usr/sbin/nftban feeds update
Nice=5
IOSchedulingClass=best-effort

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/nftban /var/log/nftban /var/cache/nftban /run/nftban

[Install]
WantedBy=multi-user.target

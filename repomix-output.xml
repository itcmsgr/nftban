268:                 // Toggle main login monitor service
269:                 async function toggleLoginMonitor() {
270:                     const toggle = document.getElementById('login-monitor-toggle');
271:                     const msgEl = document.getElementById('login-monitor-msg');
272:                     const statusEl = document.getElementById('login-monitor-toggle-status');
273:                     const isEnabled = toggle.checked;
274: 
275:                     toggle.disabled = true;
276:                     statusEl.textContent = isEnabled ? 'Enabling...' : 'Disabling...';
277:                     statusEl.style.color = '#6b7280';
278: 
279:                     try {
280:                         const action = isEnabled ? 'enable' : 'disable';
281:                         const response = await fetch('/api/v1/login-monitor/control', {
282:                             method: 'POST',
283:                             headers: {
284:                                 ...getAuthHeaders(),
285:                                 'Content-Type': 'application/json'
286:                             },
287:                             body: JSON.stringify({ action: action, target: 'service' })
288:                         });
289:                         const result = await response.json();
290: 
291:                         if (response.ok && result.success) {
292:                             msgEl.className = 'bg-green-100 text-green-800 p-15 rad-6 mt-15';
293:                             msgEl.textContent = isEnabled ? 'Login monitor enabled successfully' : 'Login monitor disabled successfully';
294:                             msgEl.classList.remove('hidden');
295:                             statusEl.textContent = isEnabled ? 'ENABLED' : 'DISABLED';
296:                             statusEl.style.color = isEnabled ? '#10b981' : '#ef4444';
297:                             setTimeout(() => loadLoginMonitorStatus(), 500);
298:                         } else {

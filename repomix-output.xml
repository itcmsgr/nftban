<file path="cli/etc/nftban/conf.d/login_alert.conf">
  1: # =============================================================================
  2: # NFTBan v1.0.0 - Login Alert Configuration
  3: # =============================================================================
  4: # SPDX-License-Identifier: MPL-2.0
  5: # File: /etc/nftban/conf.d/login_alert.conf
  6: # Purpose: Configure login monitoring and alerting
  7: #
  8: # meta:name=login_alert.conf
  9: # meta:type=config
 10: # meta:version=1.0.0
 11: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 12: # meta:homepage=https://nftban.com
 13: #
 14: # NOTE: Email recipient is configured globally in /etc/nftban/conf.d/mail.conf
 15: #       using NFTBAN_MAIL_RECIPIENT - no need to configure email here!
 16: #
 17: # To override any setting, create /etc/nftban/conf.d/login_alert.conf.local
 18: # and set your custom values there (they will override these defaults).
 19: # =============================================================================
 20: 
 21: # =============================================================================
 22: # MASTER SWITCH
 23: # =============================================================================
 24: 
 25: # Enable/disable login monitoring (master switch)
 26: # Default: false (must be explicitly enabled)
 27: NFTBAN_LOGIN_ALERT_ENABLED="false"
 28: 
 29: # =============================================================================
 30: # MONITORING TARGETS
 31: # =============================================================================
 32: # What login types to monitor
 33: # Enable via CLI: nftban login enable ssh|su|sudo|console|all
 34: 
 35: # Monitor SSH logins (successful and failed)
 36: # Default: false
 37: NFTBAN_LOGIN_ALERT_SSH="false"
 38: 
 39: # Monitor su command usage
 40: # Default: false
 41: NFTBAN_LOGIN_ALERT_SU="false"
 42: 
 43: # Monitor sudo command usage
 44: # Default: false
 45: NFTBAN_LOGIN_ALERT_SUDO="false"
 46: 
 47: # Monitor console/TTY logins
 48: # Default: false
 49: NFTBAN_LOGIN_ALERT_CONSOLE="false"
 50: 
 51: # =============================================================================
 52: # GEOIP ENRICHMENT
 53: # =============================================================================
 54: 
 55: # Include GeoIP location information in alerts
 56: # Requires: GeoIP database installed (/var/lib/nftban/geoip/)
 57: # Default: true
 58: NFTBAN_LOGIN_ALERT_GEOIP="true"
 59: 
 60: # =============================================================================
 61: # EMAIL ALERT MODE
 62: # =============================================================================
 63: # How to send login alerts:
 64: #   realtime - Send email immediately on each trigger (default)
 65: #   digest   - Collect alerts and send daily summary only
 66: #   both     - Send realtime alerts AND include in daily digest
 67: # Default: realtime
 68: NFTBAN_LOGIN_ALERT_MODE="realtime"
 69: 
 70: # Digest schedule time (only used when mode=digest or both)
 71: # Format: HH:MM (24-hour)
 72: # Default: 08:00 (8 AM)
 73: NFTBAN_LOGIN_DIGEST_TIME="08:00"
 74: 
 75: # Digest data file (stores alerts for daily summary)
 76: # Default: /var/lib/nftban/login_digest.json
 77: NFTBAN_LOGIN_DIGEST_FILE="/var/lib/nftban/login_digest.json"
 78: 
 79: # =============================================================================
 80: # ALERT FORMAT
 81: # =============================================================================
 82: 
 83: # Email alert format: html or text
 84: # Default: html
 85: NFTBAN_LOGIN_ALERT_FORMAT="html"
 86: 
 87: # =============================================================================
 88: # LOGGING
 89: # =============================================================================
 90: 
 91: # Log file location for login events
 92: # Default: /var/log/nftban/login_alert.log
 93: NFTBAN_LOGIN_ALERT_LOG="/var/log/nftban/login_alert.log"
 94: 
 95: # =============================================================================
 96: # MONITORING SETTINGS
 97: # =============================================================================
 98: 
 99: # Interval between login checks (seconds)
100: # Lower values = more responsive but higher CPU
101: # Default: 5
102: NFTBAN_LOGIN_MONITOR_INTERVAL="5"
103: 
104: # =============================================================================
105: # WHITELIST
106: # =============================================================================
107: 
108: # IP addresses that won't trigger alerts (space-separated)
109: # Example: NFTBAN_LOGIN_WHITELIST="192.168.1.0/24 10.0.0.1"
110: # Default: empty
111: NFTBAN_LOGIN_WHITELIST=""
112: 
113: # =============================================================================
114: # FAILED LOGIN TRACKING & AUTO-BAN
115: # =============================================================================
116: # Default: 10 failures in 5 minutes = Auto-ban
117: # Same threshold applies to ALL services (SSH, Postfix, Dovecot, WordPress, etc.)
118: 
119: # Alert on failed login attempts
120: # Default: true
121: NFTBAN_LOGIN_ALERT_FAILED="true"
122: 
123: # Number of failed attempts before auto-ban
124: # Default: 10
125: NFTBAN_LOGIN_FAILED_THRESHOLD="10"
126: 
127: # Time window for counting failed attempts (seconds)
128: # Default: 300 (5 minutes)
129: NFTBAN_LOGIN_FAILED_WINDOW="300"
130: 
131: # =============================================================================
132: # PER-SERVICE THRESHOLD OVERRIDES (optional)
133: # =============================================================================
134: # Uncomment to customize thresholds for specific services:
135: #
136: # LOGIN_SERVICE_SSH_FAIL_THRESHOLD=3         # Stricter for SSH
137: # LOGIN_SERVICE_POSTFIX_FAIL_THRESHOLD=10    # More lenient for email
138: # LOGIN_SERVICE_DOVECOT_FAIL_THRESHOLD=10
139: # LOGIN_SERVICE_WORDPRESS_FAIL_THRESHOLD=10
140: # LOGIN_SERVICE_ROUNDCUBE_FAIL_THRESHOLD=10
141: # LOGIN_SERVICE_PUREFTPD_FAIL_THRESHOLD=5
142: # LOGIN_SERVICE_VSFTPD_FAIL_THRESHOLD=5
143: # LOGIN_SERVICE_PROFTPD_FAIL_THRESHOLD=5
144: 
145: # =============================================================================
146: # USAGE
147: # =============================================================================
148: #
149: # Quick Start (one command):
150: #   nftban login enable
151: #
152: # This will:
153: #   - Install the systemd service (if needed)
154: #   - Enable login monitoring
155: #   - Start monitoring SSH logins
156: #
157: # Commands:
158: #   nftban login enable          - Enable monitoring (auto-installs + SSH)
159: #   nftban login disable         - Disable monitoring
160: #   nftban login enable all      - Enable all monitoring (ssh, su, sudo)
161: #   nftban login enable ssh      - Enable SSH monitoring only
162: #   nftban login disable ssh     - Disable SSH only (keep others)
163: #   nftban login status          - Show current status
164: #   nftban login test            - Send a test alert
165: #   nftban login logs            - View recent logs
166: #
167: # For more help:
168: #   nftban login help
169: #
170: # =============================================================================
</file>

<file path="cli/etc/nftban/conf.d/recovery.conf">
  1: # =============================================================================
  2: # NFTBan Emergency Recovery Configuration
  3: # =============================================================================
  4: # SPDX-License-Identifier: MPL-2.0
  5: # Copyright (c) 2024–2026 NFTBAN Project / Antonios Voulvoulis
  6: #
  7: # This configuration file controls the emergency recovery and rollback system
  8: # that prevents permanent SSH lockout after server reboot or rule changes.
  9: #
 10: # See: /usr/share/doc/nftban/RECOVERY_GUIDE.md
 11: # =============================================================================
 12: 
 13: # =============================================================================
 14: # COMMIT-CONFIRM SAFETY SYSTEM
 15: # =============================================================================
 16: # NFTBan uses a "commit-confirm" pattern (similar to JunOS) to protect against
 17: # SSH lockout. When you apply new rules, they activate immediately but must be
 18: # confirmed within the grace period or they automatically rollback.
 19: #
 20: # How it works:
 21: #   1. Apply rules with: nftban-apply
 22: #   2. Verify SSH/connectivity works
 23: #   3. Confirm with: nftban-confirm (within grace period)
 24: #   4. If not confirmed, automatic rollback to last-known-good rules
 25: #
 26: # This prevents permanent lockouts from bad firewall rules!
 27: 
 28: # Enable commit-confirm safety system
 29: # When enabled, all rule changes require explicit confirmation
 30: # DEFAULT: "true" - always use safety system (recommended!)
 31: # Set to "false" ONLY if you have alternative recovery methods (console access)
 32: NFTBAN_RECOVERY_ENABLED="true"
 33: 
 34: # Grace period before automatic rollback (seconds)
 35: # How long you have to confirm new rules before they auto-rollback
 36: # Recommended values:
 37: #   - 300 (5 minutes) - Good for most servers
 38: #   - 600 (10 minutes) - Extra time for complex testing
 39: #   - 120 (2 minutes) - Quick testing on local VMs
 40: # DEFAULT: 300 seconds (5 minutes)
 41: NFTBAN_REBOOT_GRACE_PERIOD="300"
 42: 
 43: # SSH connectivity test before applying rules
 44: # Performs local SSH connection test before activating firewall
 45: # If test fails, rules are NOT applied (fail-safe)
 46: # CRITICAL SAFETY FEATURE - keeps SSH accessible
 47: # DEFAULT: "true" - always test (recommended!)
 48: NFTBAN_SSH_TEST_BEFORE_APPLY="true"
 49: 
 50: # SSH test port (default: 22)
 51: # Port to test for SSH connectivity during safety checks
 52: # Change if you run SSH on non-standard port
 53: NFTBAN_SSH_TEST_PORT="22"
 54: 
 55: # =============================================================================
 56: # AUTOMATIC ROLLBACK ON BOOT
 57: # =============================================================================
 58: # These settings control what happens when the server reboots
 59: 
 60: # Auto-reset firewall rules on boot (before applying nftban rules)
 61: # DEFAULT: "false" - rules persist (normal production behavior)
 62: # Set to "true" ONLY during testing to start fresh each boot
 63: # WARNING: In production, this removes all protection after reboot!
 64: NFTBAN_RESET_ON_BOOT="false"
 65: 
 66: # Auto-apply rules after reboot with commit-confirm
 67: # Automatically apply nftban rules after grace period
 68: # If SSH test fails during application, rules are NOT applied (fail-safe)
 69: # DEFAULT: "true" - apply rules automatically (with safety checks)
 70: NFTBAN_REBOOT_AUTO_APPLY="true"
 71: 
 72: # =============================================================================
 73: # ALERTING & NOTIFICATIONS
 74: # =============================================================================
 75: 
 76: # Send alert if rollback activates
 77: # Notifies admin when rules were rolled back (not confirmed in time)
 78: # Requires mail notification to be configured (see mail.conf)
 79: # DEFAULT: "true" - notify on rollback
 80: NFTBAN_ROLLBACK_ALERT="true"
 81: 
 82: # Alert email address for recovery events
 83: # Leave empty to use default from mail.conf (MAIL_TO)
 84: # Set specific address for critical recovery alerts
 85: NFTBAN_ROLLBACK_ALERT_EMAIL=""
 86: 
 87: # =============================================================================
 88: # EMERGENCY RECOVERY OPTIONS
 89: # =============================================================================
 90: 
 91: # Emergency rule reset command (via console/IPMI only)
 92: # This bypasses all safety checks and clears all rules immediately
 93: # DEFAULT: "false" - disable emergency reset in production
 94: # Enable ONLY if you have console/IPMI access and need emergency recovery
 95: NFTBAN_EMERGENCY_RESET_ENABLED="false"
 96: 
 97: # Baseline ruleset for emergency recovery
 98: # A minimal "known safe" ruleset that allows SSH and management access
 99: # Used when backup rules are missing or corrupted
100: # DEFAULT: "/etc/nftban/baseline.nft"
101: NFTBAN_BASELINE_RULES="/etc/nftban/baseline.nft"
102: 
103: # =============================================================================
104: # KERNEL COMMAND LINE KILL-SWITCH
105: # =============================================================================
106: # You can disable nftban entirely at boot by adding to kernel command line:
107: #   nftban=disabled
108: #
109: # How to use:
110: #   1. At GRUB menu, press 'e' to edit boot entry
111: #   2. Add 'nftban=disabled' to kernel line
112: #   3. Press Ctrl+X to boot
113: #   4. NFTBan will not start, SSH will work
114: #   5. Fix firewall rules, reboot normally
115: #
116: # For repeated use, create a GRUB menu entry with nftban=disabled
117: 
118: # =============================================================================
119: # BACKUP & RESTORE
120: # =============================================================================
121: 
122: # Backup ruleset location
123: # Last-known-good ruleset saved before each rule change
124: # DEFAULT: "/var/lib/nftban/backup.rules"
125: NFTBAN_BACKUP_RULES="/var/lib/nftban/backup.rules"
126: 
127: # Keep backup history
128: # Save multiple backup generations for rollback
129: # DEFAULT: "3" - keep 3 most recent backups
130: NFTBAN_BACKUP_GENERATIONS="3"
131: 
132: # =============================================================================
133: # ADVANCED OPTIONS
134: # =============================================================================
135: 
136: # Rollback check interval (seconds)
137: # How often the timer checks if rollback deadline passed
138: # DEFAULT: 15 - check every 15 seconds
139: # Lower = more responsive, Higher = less overhead
140: NFTBAN_ROLLBACK_CHECK_INTERVAL="15"
141: 
142: # Rollback flag file location
143: # Runtime file that tracks rollback deadline
144: # DEFAULT: "/run/nftban.rollback.deadline"
145: NFTBAN_ROLLBACK_FLAG="/run/nftban.rollback.deadline"
146: 
147: # =============================================================================
148: # TESTING & LAB ENVIRONMENTS
149: # =============================================================================
150: # For lab/testing environments, you may want more aggressive safety:
151: 
152: # Example lab server config (uncomment to use):
153: # NFTBAN_REBOOT_GRACE_PERIOD="600"        # 10 minutes to test
154: # NFTBAN_RESET_ON_BOOT="true"             # Start fresh each boot
155: # NFTBAN_ROLLBACK_CHECK_INTERVAL="10"     # Check every 10 seconds
156: 
157: # Example production server config (recommended):
158: # NFTBAN_REBOOT_GRACE_PERIOD="300"        # 5 minutes to confirm
159: # NFTBAN_RESET_ON_BOOT="false"            # Persistent rules
160: # NFTBAN_SSH_TEST_BEFORE_APPLY="true"     # Always test SSH
161: # NFTBAN_ROLLBACK_ALERT="true"            # Alert on issues
162: 
163: # =============================================================================
164: # CONSOLE/IPMI RECOVERY PROCEDURES
165: # =============================================================================
166: # If you get locked out and cannot SSH:
167: #
168: # 1. Access console (IPMI/iDRAC/iLO/VNC/Serial Console)
169: # 2. Log in as root
170: # 3. Check rules: nft list ruleset
171: # 4. Emergency options:
172: #    a) Rollback to backup:   nftban-rollback --force
173: #    b) Flush all rules:      nft flush ruleset
174: #    c) Load baseline:        nft -f /etc/nftban/baseline.nft
175: # 5. Fix issue, test SSH works
176: # 6. Reboot with: nftban=disabled (optional, to skip nftban at boot)
177: #
178: # See RECOVERY_GUIDE.md for detailed procedures
179: # =============================================================================
180: 
181: # =============================================================================
182: # EXAMPLE SCENARIOS
183: # =============================================================================
184: #
185: # Scenario 1: Deploying new rules on production server
186: #   1. sudo nftban-apply                # Apply with safety
187: #   2. Test SSH from another terminal   # Verify connectivity
188: #   3. sudo nftban-confirm              # Confirm within 5 minutes
189: #
190: # Scenario 2: Testing rules on lab server
191: #   1. sudo nftban-apply                # Apply with safety
192: #   2. Wait and test thoroughly
193: #   3. If good: sudo nftban-confirm
194: #   4. If bad: just wait, auto-rollback in 5 minutes
195: #
196: # Scenario 3: Emergency - locked out
197: #   1. Access console (IPMI/VNC)
198: #   2. sudo nftban-rollback --force     # Immediate rollback
199: #   3. SSH should work now
200: #
201: # Scenario 4: Server reboot with bad rules
202: #   1. Reboot with nftban=disabled in GRUB
203: #   2. Fix rules
204: #   3. Reboot normally
205: #
206: # =============================================================================
207: 
208: # =============================================================================
209: # INTEGRATION WITH OTHER TOOLS
210: # =============================================================================
211: 
212: # Integration with fail2ban
213: # Fail2ban bans are NOT affected by rollback
214: # They persist in separate nftables sets
215: # See: fail2ban.conf
216: 
217: # Integration with threat feeds
218: # Feed-based blocks are NOT affected by rollback
219: # They persist in separate nftables sets
220: # See: feeds.conf
221: 
222: # What gets rolled back:
223: #   - Main firewall rules (input/forward/output chains)
224: #   - Port access rules
225: #   - Rate limits and connection tracking
226: #   - Custom user rules
227: #
228: # What DOES NOT get rolled back:
229: #   - Fail2ban bans (separate set)
230: #   - Threat feed blocks (separate set)
231: #   - Whitelist entries (separate set)
232: 
233: # =============================================================================
234: # DOCUMENTATION & SUPPORT
235: # =============================================================================
236: # Full documentation: /usr/share/doc/nftban/RECOVERY_GUIDE.md
237: # CLI help: nftban-apply --help
238: # Project website: https://nftban.com/docs/recovery
239: # =============================================================================
</file>

<file path="cli/etc/nftban/conf.d/services.conf">
  1: # =============================================================================
  2: # NFTBan Services Control Configuration
  3: # =============================================================================
  4: # SPDX-License-Identifier: MPL-2.0
  5: # File: /etc/nftban/conf.d/services.conf
  6: # Purpose: Control which services NFTBan manages and auto-starts
  7: #
  8: # This file provides configuration-based control over service management,
  9: # allowing you to disable features without using systemctl commands.
 10: # =============================================================================
 11: 
 12: # =============================================================================
 13: # MASTER SWITCHES
 14: # =============================================================================
 15: 
 16: # Master switch - disable NFTBan completely
 17: # If set to "false", all NFTBan functionality will be disabled
 18: # Default: true
 19: NFTBAN_ENABLED="true"
 20: 
 21: # =============================================================================
 22: # NFTABLES SERVICE CONTROL
 23: # =============================================================================
 24: 
 25: # Control whether NFTBan manages nftables service
 26: # Set to "false" to prevent NFTBan from managing nftables at all
 27: # Default: true
 28: NFTABLES_ENABLED="true"
 29: 
 30: # Auto-start nftables service if it's not running
 31: # Set to "false" to prevent NFTBan from auto-starting nftables
 32: # Note: This does NOT affect systemd auto-start on boot
 33: # Default: false (don't auto-start, let systemd handle it)
 34: NFTABLES_AUTO_START="false"
 35: 
 36: # =============================================================================
 37: # SURICATA IDS SERVICE CONTROL (NFTBan v1.0+)
 38: # =============================================================================
 39: 
 40: # Control whether NFTBan manages Suricata IDS service
 41: # Suricata replaces fail2ban as the primary intrusion detection system
 42: # Set to "false" to prevent NFTBan from managing Suricata
 43: # Default: true
 44: SURICATA_ENABLED="true"
 45: 
 46: # Auto-start Suricata service if it's not running
 47: # Set to "false" to prevent NFTBan from auto-starting Suricata
 48: # Note: This does NOT affect systemd auto-start on boot
 49: # Default: false (don't auto-start, let systemd handle it)
 50: SURICATA_AUTO_START="false"
 51: 
 52: # =============================================================================
 53: # LOGIN MONITOR MODULE (NFTBan v1.0+)
 54: # =============================================================================
 55: # NOTE: Login monitor has its own detailed configuration file:
 56: #   /etc/nftban/conf.d/login_alert.conf
 57: #
 58: # Key settings in login_alert.conf:
 59: #   NFTBAN_LOGIN_ALERT_ENABLED="true"   - Enable/disable login alerting
 60: #   NFTBAN_LOGIN_ALERT_SSH="true"       - Monitor SSH logins
 61: #   NFTBAN_LOGIN_ALERT_SU="true"        - Monitor su commands
 62: #   NFTBAN_LOGIN_ALERT_SUDO="true"      - Monitor sudo commands
 63: #   NFTBAN_LOGIN_ALERT_GEOIP="true"     - Include GeoIP in alerts
 64: #   NFTBAN_LOGIN_FAILED_THRESHOLD="3"   - Failed attempts before alert
 65: #
 66: # To enable/disable login monitoring:
 67: #   nftban login enable
 68: #   nftban login disable
 69: #   nftban login status
 70: 
 71: # =============================================================================
 72: # BOOT BEHAVIOR CONTROL
 73: # =============================================================================
 74: 
 75: # Control whether services should start on system boot
 76: # Set to "false" to disable all auto-start behavior during boot
 77: # Note: This is a hint for init scripts, actual boot control is via systemd
 78: # Default: true
 79: SERVICES_START_ON_BOOT="true"
 80: 
 81: # =============================================================================
 82: # USAGE EXAMPLES
 83: # =============================================================================
 84: 
 85: # Example 1: Disable NFTBan completely
 86: # -----------------------
 87: # NFTBAN_ENABLED="false"
 88: #
 89: # Effect: NFTBan commands will exit early with "disabled" message
 90: 
 91: # Example 2: Disable nftables management
 92: # -----------------------
 93: # NFTABLES_ENABLED="false"
 94: #
 95: # Effect: NFTBan won't touch nftables rules or service
 96: 
 97: # Example 3: Prevent Suricata auto-start
 98: # -----------------------
 99: # SURICATA_AUTO_START="false"
100: #
101: # Effect: NFTBan won't start Suricata if it's stopped
102: 
103: # Example 4: Recovery mode (disable all auto-starts)
104: # -----------------------
105: # NFTABLES_AUTO_START="false"
106: # SURICATA_AUTO_START="false"
107: # SERVICES_START_ON_BOOT="false"
108: #
109: # Effect: Nothing starts automatically, manual control only
110: 
111: # =============================================================================
112: # NOTES
113: # =============================================================================
114: 
115: # These settings control NFTBan's BEHAVIOR, not systemd service state
116: # To prevent services from starting at boot, use systemd:
117: #   systemctl disable nftban
118: #   systemctl disable nftables
119: #   systemctl disable suricata
120: 
121: # To temporarily stop services:
122: #   systemctl stop nftban
123: #   systemctl stop nftables
124: #   systemctl stop suricata
125: 
126: # To permanently disable (prevent any start):
127: #   systemctl mask nftban
128: #   systemctl mask nftables
129: #   systemctl mask suricata
</file>

<file path="cli/lib/nftban/cli/cmd_ban.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - Ban Command
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Ban IP addresses using nftban-core
  7: #
  8: # meta:name=cmd_ban
  9: # meta:type=cli
 10: # meta:header=Ban Command
 11: # meta:version=1.0.0
 12: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 13: # meta:homepage=https://nftban.com
 14: #
 15: # **Description & Purpose**
 16: # meta:description=Ban IP addresses permanently using nftban-core
 17: # meta:input=IP address, optional reason
 18: # meta:output=Ban confirmation or error message
 19: #
 20: # **Inventory & Requirements**
 21: # meta:depends=bash,nftban-core
 22: #
 23: # meta:created_date=2025-11-24
 24: # meta:updated_date=2025-11-26
 25: # =============================================================================
 26: 
 27: set -Eeuo pipefail
 28: 
 29: # Source central config for canonical paths (NO HARDCODED FALLBACKS)
 30: # shellcheck source=/etc/nftban/nftban.conf
 31: [[ -f "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf" ]] && source "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf"
 32: 
 33: [[ -z "${NFTBAN_LIB_DIR:-}" ]] && readonly NFTBAN_LIB_DIR="/usr/lib/nftban"
 34: readonly NFTBAN_CORE="${NFTBAN_LIB_DIR}/bin/nftban-core"
 35: 
 36: # Prevent double-loading
 37: [[ -n "${CMD_BAN_LOADED:-}" ]] && return 0
 38: readonly CMD_BAN_LOADED=1
 39: 
 40: # =============================================================================
 41: # COMMAND HANDLER
 42: # =============================================================================
 43: 
 44: nftban_cmd_ban() {
 45:     # Ban an IP address using nftban-core
 46:     # Usage: nftban ban <ip> [--reason "REASON"] [--timeout SECONDS] [--source SOURCE] [--json]
 47: 
 48:     local ip=""
 49:     local reason=""
 50:     local timeout=""
 51:     local source=""
 52:     local json_mode=false
 53: 
 54:     # Parse arguments first to detect JSON mode
 55:     local args=("$@")
 56:     for arg in "${args[@]}"; do
 57:         [[ "$arg" == "--json" ]] && json_mode=true
 58:     done
 59: 
 60:     # NOTE: No banner here - nftban-core displays its own banner
 61:     # This avoids duplicate banners when delegating to the Go binary
 62: 
 63:     # Load JSON helper
 64:     if [[ -f "${NFTBAN_LIB_DIR}/helpers/json_output.sh" ]]; then
 65:         # shellcheck source=/dev/null
 66:         source "${NFTBAN_LIB_DIR}/helpers/json_output.sh"
 67:     fi
 68: 
 69:     # Parse arguments
 70:     while [[ $# -gt 0 ]]; do
 71:         case "$1" in
 72:             help|--help|-h)
 73:                 nftban_cmd_ban_usage
 74:                 return 0
 75:                 ;;
 76:             --json)
 77:                 json_mode=true
 78:                 shift
 79:                 ;;
 80:             --reason)
 81:                 reason="$2"
 82:                 shift 2
 83:                 ;;
 84:             --timeout)
 85:                 timeout="$2"
 86:                 shift 2
 87:                 ;;
 88:             --source)
 89:                 source="$2"
 90:                 shift 2
 91:                 ;;
 92:             -*)
 93:                 if [[ "$json_mode" == "true" ]] && declare -f json_output >/dev/null 2>&1; then
 94:                     json_output "false" '{}' "Unknown option: $1"
 95:                 else
 96:                     echo "ERROR: Unknown option: $1" >&2
 97:                     nftban_cmd_ban_usage
 98:                 fi
 99:                 return 1
100:                 ;;
101:             *)
102:                 if [[ -z "$ip" ]]; then
103:                     ip="$1"
104:                     shift
105:                 else
106:                     if [[ "$json_mode" == "true" ]] && declare -f json_output >/dev/null 2>&1; then
107:                         json_output "false" '{}' "Multiple IP addresses not supported"
108:                     else
109:                         echo "ERROR: Multiple IP addresses not supported" >&2
110:                     fi
111:                     return 1
112:                 fi
113:                 ;;
114:         esac
115:     done
116: 
117:     # Validate required arguments
118:     if [[ -z "$ip" ]]; then
119:         if [[ "$json_mode" == "true" ]] && declare -f json_output >/dev/null 2>&1; then
120:             json_output "false" '{}' "IP address is required"
121:         else
122:             echo "ERROR: IP address is required" >&2
123:             echo "" >&2
124:             nftban_cmd_ban_usage
125:         fi
126:         return 1
127:     fi
128: 
129:     # Check if nftban-core exists (required for ban command)
130:     if [[ ! -x "$NFTBAN_CORE" ]]; then
131:         if [[ "$json_mode" == "true" ]] && declare -f json_output >/dev/null 2>&1; then
132:             json_output "false" '{}' "nftban-core binary not found - CLI-only mode"
133:         else
134:             echo "ERROR: nftban-core binary not found" >&2
135:             echo "" >&2
136:             echo "The 'ban' command requires the nftban-core Go binary." >&2
137:             echo "Expected location: $NFTBAN_CORE" >&2
138:             echo "" >&2
139:             echo "This happens in CLI-only mode (bash scripts only)." >&2
140:             echo "" >&2
141:             echo "Solutions:" >&2
142:             echo "  1. Install full NFTBan package:" >&2
143:             echo "     dnf install nftban  (or: apt install nftban)" >&2
144:             echo "" >&2
145:             echo "  2. Check if binary exists:" >&2
146:             echo "     ls -la $NFTBAN_CORE" >&2
147:             echo "" >&2
148:         fi
149:         return 1
150:     fi
151: 
152:     # Build command arguments
153:     local cmd_args=("$ip")
154:     [[ -n "$reason" ]] && cmd_args+=(--reason "$reason")
155:     [[ -n "$timeout" ]] && cmd_args+=(--timeout "$timeout")
156:     [[ -n "$source" ]] && cmd_args+=(--source "$source")
157: 
158:     # Call nftban-core ban (Go binary handles logging to bans.log)
159:     local output
160:     output=$("$NFTBAN_CORE" ban "${cmd_args[@]}" 2>&1)
161:     local exit_code=$?
162: 
163:     if [[ "$json_mode" == "true" ]] && declare -f json_output >/dev/null 2>&1; then
164:         if [[ $exit_code -eq 0 ]]; then
165:             local data
166:             if command -v jq &>/dev/null; then
167:                 data=$(jq -n \
168:                     --arg ip "$ip" \
169:                     --arg reason "$reason" \
170:                     --arg timeout "$timeout" \
171:                     --arg source "$source" \
172:                     '{ip: $ip, reason: $reason, timeout: (if $timeout == "" then null else ($timeout | tonumber) end), source: (if $source == "" then "manual" else $source end)}')
173:             else
174:                 local timeout_val="null"
175:                 [[ -n "$timeout" ]] && timeout_val="$timeout"
176:                 local source_val="manual"
177:                 [[ -n "$source" ]] && source_val="$source"
178:                 data="{\"ip\":\"$ip\",\"reason\":\"$reason\",\"timeout\":$timeout_val,\"source\":\"$source_val\"}"
179:             fi
180:             json_output "true" "$data"
181:         else
182:             json_output "false" '{}' "Failed to ban IP: $output"
183:         fi
184:     else
185:         echo "$output"
186:     fi
187: 
188:     return $exit_code
189: }
190: 
191: # =============================================================================
192: # USAGE
193: # =============================================================================
194: 
195: nftban_cmd_ban_usage() {
196:     cat <<EOF
197: Usage: nftban ban <ip> [OPTIONS]
198: 
199: Ban an IP address.
200: 
201: Arguments:
202:   <ip>                  IP address to ban (IPv4 or IPv6)
203: 
204: Options:
205:   --reason "TEXT"       Ban reason (optional, stored as comment)
206:   --timeout SECONDS     Temporary ban duration (omit for permanent)
207:   --source SOURCE       Ban source (e.g., login, portscan, ddos, manual)
208:   --help, -h            Show this help message
209: 
210: Examples:
211:   nftban ban 192.168.1.100
212:   nftban ban 192.168.1.100 --reason "Brute force attack"
213:   nftban ban 192.168.1.100 --timeout 3600 --reason "SSH brute-force"
214:   nftban ban 192.168.1.100 --timeout 86400 --source login --reason "Failed logins"
215:   nftban ban 2001:db8::1
216: 
217: Notes:
218:   - Whitelisted IPs cannot be banned
219:   - Without --timeout, ban is permanent until manually removed
220:   - With --timeout, ban auto-expires after specified seconds
221:   - IP is added to ${NFTBAN_CONFIG_DIR}/blacklist.d/99-manual.conf
222:   - Changes are synced to nftables immediately
223: 
224: See also:
225:   nftban unban <ip>     Remove IP ban
226:   nftban search <ip>    Check IP status
227:   nftban list           List all banned IPs
228: 
229: EOF
230: }
231: 
232: # Export function
233: export -f nftban_cmd_ban
234: export -f nftban_cmd_ban_usage
</file>

<file path="cli/lib/nftban/cli/cmd_check.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - Check Command
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Check if IP or port is allowed/blocked in nftables
  7: #
  8: # meta:name=cmd_check
  9: # meta:type=cli
 10: # meta:header=Check Command
 11: # meta:version=1.0.0
 12: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 13: # meta:homepage=https://nftban.com
 14: #
 15: # **Description & Purpose**
 16: # meta:description=Check if specific IP address or port is allowed or blocked
 17: # meta:input=IP address or port number
 18: # meta:output=Status (allowed/blocked), matched rule, processing path
 19: #
 20: # **Inventory & Requirements**
 21: # meta:depends=bash,nftban_validator
 22: #
 23: # meta:created_date=2025-11-14
 24: # meta:updated_date=2025-11-24
 25: # =============================================================================
 26: 
 27: # Strict mode
 28: IFS=$'\n\t'
 29: umask 027
 30: 
 31: # Prevent double-loading
 32: [[ -n "${CMD_CHECK_LOADED:-}" ]] && return 0
 33: readonly CMD_CHECK_LOADED=1
 34: 
 35: # Source core validator
 36: NFTBAN_LIB_DIR="${NFTBAN_LIB_DIR:-/usr/lib/nftban}"
 37: 
 38: # Load strict mode library
 39: # shellcheck source=/usr/lib/nftban/lib/strict.sh
 40: if [[ -f "${NFTBAN_LIB_DIR}/lib/strict.sh" ]]; then
 41:     source "${NFTBAN_LIB_DIR}/lib/strict.sh"
 42: else
 43:     # Fallback to manual strict mode
 44:     set -Eeuo pipefail
 45: fi
 46: 
 47: # Load version library
 48: # shellcheck source=/usr/lib/nftban/lib/version.sh
 49: if [[ -f "${NFTBAN_LIB_DIR}/lib/version.sh" ]]; then
 50:     source "${NFTBAN_LIB_DIR}/lib/version.sh"
 51: fi
 52: source "${NFTBAN_LIB_DIR}/core/nftban_validator.sh"
 53: 
 54: # =============================================================================
 55: # COMMAND HANDLER
 56: # =============================================================================
 57: 
 58: nftban_cmd_check() {
 59:     # Check if IP or port is allowed/blocked
 60:     # Usage: nftban check <ip|port> [--json]
 61: 
 62:     local value=""
 63:     local json_output=false
 64: 
 65:     # Parse arguments
 66:     while [[ $# -gt 0 ]]; do
 67:         case "$1" in
 68:             --json)
 69:                 json_output=true
 70:                 shift
 71:                 ;;
 72:             -h|--help)
 73:                 nftban_cmd_check_help
 74:                 return 0
 75:                 ;;
 76:             -*)
 77:                 echo "ERROR: Unknown option: $1" >&2
 78:                 nftban_cmd_check_help
 79:                 return 1
 80:                 ;;
 81:             *)
 82:                 if [[ -z "$value" ]]; then
 83:                     value="$1"
 84:                 else
 85:                     echo "ERROR: Only one value can be checked at a time" >&2
 86:                     nftban_cmd_check_help
 87:                     return 1
 88:                 fi
 89:                 shift
 90:                 ;;
 91:         esac
 92:     done
 93: 
 94:     # Validate value provided
 95:     if [[ -z "$value" ]]; then
 96:         echo "ERROR: No IP address or port specified" >&2
 97:         nftban_cmd_check_help
 98:         return 1
 99:     fi
100: 
101:     # Show banner (skip for JSON output)
102:     if [[ "$json_output" != "true" ]]; then
103:         if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_output.sh" ]]; then
104:             # shellcheck source=/dev/null
105:             source "${NFTBAN_LIB_DIR}/core/nftban_output.sh"
106:             if [[ $(type -t nftban_banner) == "function" ]]; then
107:                 nftban_banner
108:             fi
109:         fi
110:         echo ""
111:     fi
112: 
113:     # Run check
114:     check_ip_or_port "$value" "$json_output"
115: }
116: 
117: nftban_cmd_check_help() {
118:     cat << 'EOF'
119: Usage: nftban check <ip|port> [OPTIONS]
120: 
121: Check if an IP address or port is allowed or blocked in the firewall.
122: 
123: ARGUMENTS:
124:   <ip|port>       IP address (e.g., 203.0.113.50) or port number (e.g., 3940)
125: 
126: OPTIONS:
127:   --json          Output results in JSON format
128:   -h, --help      Show this help message
129: 
130: DESCRIPTION:
131:   This command traces an IP address or port through the nftables ruleset
132:   and determines if it is allowed or blocked. It shows:
133: 
134:   - Current status (allowed/blocked/unknown)
135:   - Which table/chain/set matched
136:   - Processing path through the firewall
137:   - Available actions (block, allow, whitelist, etc.)
138: 
139:   The check follows the actual nftables priority order:
140:     1. ip/ip6 nftban whitelist (highest priority - full access)
141:     2. ip/ip6 nftban blacklist (permanent + temporary with timeout)
142:     3. Default deny policy
143: 
144: EXAMPLES:
145:   # Check if IP is allowed
146:   nftban check 203.0.113.50
147: 
148:   # Check if port is open
149:   nftban check 3940
150: 
151:   # JSON output for scripting
152:   nftban check 192.0.2.122 --json
153: 
154: OUTPUT:
155:   Human-readable format shows:
156:     - Type (IPv4 address or TCP port)
157:     - Status (✅ ALLOWED or ❌ BLOCKED)
158:     - Matched table, chain, and set
159:     - Full processing path
160:     - Available actions
161: 
162:   JSON format provides machine-readable data for GUI/scripts.
163: 
164: EXIT STATUS:
165:   0  Check completed successfully
166:   1  Error (invalid value, nft command failed, etc.)
167: 
168: SEE ALSO:
169:   nftban validate           Validate entire nftables structure
170:   nftban stats              Show firewall statistics
171:   nftban ban <ip>           Add IP to blacklist
172:   nftban unban <ip>         Remove IP from blacklist
173:   nftban whitelist <ip>     Add IP to whitelist
174: EOF
175: }
176: 
177: # =============================================================================
178: # EXPORTS
179: # =============================================================================
180: 
181: # Exit marker for testing validation
182: command -v nftban_cmd_exit >/dev/null 2>&1 && nftban_cmd_exit "check"
183: 
184: export -f nftban_cmd_check
185: # Exit marker for testing validation
186: command -v nftban_cmd_exit >/dev/null 2>&1 && nftban_cmd_exit "check"
187: 
188: export -f nftban_cmd_check_help
</file>

<file path="cli/lib/nftban/cli/cmd_config.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - Config CLI Handler
  4: # =============================================================================
  5: 
  6: # SPDX-License-Identifier: MPL-2.0
  7: # Purpose: Configuration management CLI interface
  8: #
  9: # meta:name=cmd_config
 10: # meta:type=cli
 11: # meta:header=Configuration CLI Handler
 12: # meta:version=1.0.0
 13: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 14: # meta:homepage=https://nftban.com
 15: #
 16: # **Description & Purpose**
 17: # meta:description=CLI interface for configuration management with .conf.local support
 18: # meta:input=Config commands and parameters
 19: # meta:output=Configuration values or status messages
 20: #
 21: # **Inventory & Requirements**
 22: # meta:depends=nftban_config.sh
 23: #
 24: # meta:created_date=2025-11-15
 25: # meta:updated_date=2025-11-24
 26: # =============================================================================
 27: 
 28: set -Eeuo pipefail
 29: IFS=$'\n\t'
 30: umask 027
 31: 
 32: # =============================================================================
 33: # CONFIGURATION
 34: # =============================================================================
 35: 
 36: : "${NFTBAN_LIB_DIR:=/usr/lib/nftban}"
 37: 
 38: # Load JSON helper for --json support
 39: JSON_HELPER="${NFTBAN_LIB_DIR}/helpers/json_output.sh"
 40: if [[ -f "$JSON_HELPER" ]]; then
 41:     # shellcheck source=/dev/null
 42:     source "$JSON_HELPER"
 43: fi
 44: 
 45: # =============================================================================
 46: # DEPENDENCIES
 47: # =============================================================================
 48: 
 49: # Load config module
 50: if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_config.sh" ]]; then
 51:     source "${NFTBAN_LIB_DIR}/core/nftban_config.sh"
 52: else
 53:     echo "ERROR: Configuration module not found"
 54:     exit 1
 55: fi
 56: 
 57: # =============================================================================
 58: # USAGE
 59: # =============================================================================
 60: 
 61: show_usage() {
 62:     cat <<'EOF'
 63: Usage: nftban config <command> <module> [options]
 64: 
 65: COMMANDS:
 66:   get <module>              Get current configuration (merged defaults + overrides)
 67:   defaults <module>         Show default configuration values
 68:   overrides <module>        Show local override values
 69:   set <module> KEY=VALUE    Set configuration value in .conf.local
 70:   reset <module> KEY        Reset single key to default (remove override)
 71:   reset-all <module>        Reset all configuration to defaults
 72: 
 73: MODULES:
 74:   portscan                  Port scan detection configuration
 75:   ddos                      DDoS protection configuration
 76: 
 77: OPTIONS:
 78:   --json                    Output in JSON format
 79: 
 80: EXAMPLES:
 81:   # View current portscan configuration (defaults + overrides)
 82:   nftban config get portscan
 83: 
 84:   # View only default values
 85:   nftban config defaults portscan
 86: 
 87:   # View only local overrides
 88:   nftban config overrides portscan
 89: 
 90:   # Set a configuration value (saves to .conf.local)
 91:   sudo nftban config set portscan PORTSCAN_THRESHOLD=15
 92: 
 93:   # Reset a single value to default
 94:   sudo nftban config reset portscan PORTSCAN_THRESHOLD
 95: 
 96:   # Reset all portscan config to defaults
 97:   sudo nftban config reset-all portscan
 98: 
 99:   # Get config in JSON format
100:   nftban config get portscan --json
101: 
102: CONFIGURATION FILES:
103:   /etc/nftban/conf.d/*.conf     Default configuration files (DO NOT EDIT)
104:   /etc/nftban/nftban.conf.local Local overrides (auto-managed by this command)
105: 
106: HOW IT WORKS:
107:   - Default values come from /etc/nftban/conf.d/<module>.conf
108:   - Local overrides are stored in /etc/nftban/nftban.conf.local
109:   - Overrides take precedence over defaults
110:   - Use 'set' to add/update overrides, 'reset' to remove them
111: 
112: EOF
113: }
114: 
115: # =============================================================================
116: # COMMAND HANDLERS
117: # =============================================================================
118: 
119: nftban_cmd_config_get() {
120:     # Get merged configuration (defaults + overrides)
121:     local module="$1"
122:     shift || true
123: 
124:     local json_mode="false"
125:     if [[ "${1:-}" == "--json" ]]; then
126:         json_mode="--json"
127:     fi
128: 
129:     nftban_config_get_merged "$module" "$json_mode"
130: }
131: 
132: nftban_cmd_config_defaults() {
133:     # Get default configuration only
134:     local module="$1"
135: 
136:     local defaults
137:     defaults=$(nftban_config_get_defaults "$module")
138: 
139:     if [[ "${2:-}" == "--json" ]]; then
140:         echo "{\"success\": true, \"data\": $defaults}"
141:     else
142:         echo "Default Configuration for: $module"
143:         echo "════════════════════════════════════════════════════════════"
144:         echo "$defaults" | jq -r 'to_entries[] | "\(.key)=\(.value)"' | sort
145:     fi
146: }
147: 
148: nftban_cmd_config_overrides() {
149:     # Get local overrides only
150:     local module="$1"
151: 
152:     local overrides
153:     overrides=$(nftban_config_get_overrides "$module")
154: 
155:     if [[ "${2:-}" == "--json" ]]; then
156:         echo "{\"success\": true, \"data\": $overrides}"
157:     else
158:         echo "Local Overrides for: $module"
159:         echo "════════════════════════════════════════════════════════════"
160:         if [[ "$overrides" == "{}" ]]; then
161:             echo "(No local overrides - using all defaults)"
162:         else
163:             echo "$overrides" | jq -r 'to_entries[] | "\(.key)=\(.value)"' | sort
164:         fi
165:     fi
166: }
167: 
168: nftban_cmd_config_set() {
169:     # Set a configuration value
170:     local module="$1"
171:     local key_value="$2"
172: 
173:     nftban_config_set "$module" "$key_value"
174: }
175: 
176: nftban_cmd_config_reset() {
177:     # Reset a single key
178:     local module="$1"
179:     local key="$2"
180: 
181:     nftban_config_reset "$module" "$key"
182: }
183: 
184: nftban_cmd_config_reset_all() {
185:     # Reset all configuration for module
186:     local module="$1"
187: 
188:     nftban_config_reset_all "$module"
189: }
190: 
191: # =============================================================================
192: # MAIN COMMAND HANDLER
193: # =============================================================================
194: 
195: nftban_cmd_config() {
196:     # Main command handler for config
197:     # Args: subcommand, module, and options
198: 
199:     local subcommand="${1:-help}"
200:     shift || true
201: 
202:     # Show banner
203:     if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_output.sh" ]]; then
204:         # shellcheck source=/dev/null
205:         source "${NFTBAN_LIB_DIR}/core/nftban_output.sh"
206:         if [[ $(type -t nftban_banner) == "function" ]]; then
207:             nftban_banner
208:         fi
209:     fi
210:     echo ""
211: 
212:     case "$subcommand" in
213:         get)
214:             if [[ -z "${1:-}" ]]; then
215:                 echo "ERROR: Module name required"
216:                 echo "Usage: nftban config get <module> [--json]"
217:                 return 1
218:             fi
219:             nftban_cmd_config_get "$@"
220:             ;;
221: 
222:         defaults)
223:             if [[ -z "${1:-}" ]]; then
224:                 echo "ERROR: Module name required"
225:                 echo "Usage: nftban config defaults <module> [--json]"
226:                 return 1
227:             fi
228:             nftban_cmd_config_defaults "$@"
229:             ;;
230: 
231:         overrides)
232:             if [[ -z "${1:-}" ]]; then
233:                 echo "ERROR: Module name required"
234:                 echo "Usage: nftban config overrides <module> [--json]"
235:                 return 1
236:             fi
237:             nftban_cmd_config_overrides "$@"
238:             ;;
239: 
240:         set)
241:             if [[ -z "${1:-}" ]] || [[ -z "${2:-}" ]]; then
242:                 echo "ERROR: Module name and KEY=VALUE required"
243:                 echo "Usage: nftban config set <module> KEY=VALUE"
244:                 return 1
245:             fi
246:             nftban_cmd_config_set "$@"
247:             ;;
248: 
249:         reset)
250:             if [[ -z "${1:-}" ]] || [[ -z "${2:-}" ]]; then
251:                 echo "ERROR: Module name and KEY required"
252:                 echo "Usage: nftban config reset <module> KEY"
253:                 return 1
254:             fi
255:             nftban_cmd_config_reset "$@"
256:             ;;
257: 
258:         reset-all)
259:             if [[ -z "${1:-}" ]]; then
260:                 echo "ERROR: Module name required"
261:                 echo "Usage: nftban config reset-all <module>"
262:                 return 1
263:             fi
264:             nftban_cmd_config_reset_all "$@"
265:             ;;
266: 
267:         help|--help|-h|"")
268:             show_usage
269:             return 0
270:             ;;
271: 
272:         *)
273:             echo "ERROR: Unknown command: $subcommand" >&2
274:             echo "" >&2
275:             show_usage
276:             return 1
277:             ;;
278:     esac
279: }
280: 
281: # =============================================================================
282: # EXPORTS
283: # =============================================================================
284: 
285: # Exit marker for testing validation
286: command -v nftban_cmd_exit >/dev/null 2>&1 && nftban_cmd_exit "config"
287: 
288: export -f nftban_cmd_config
289: 
290: # =============================================================================
291: # DIRECT EXECUTION SUPPORT
292: # =============================================================================
293: 
294: # If executed directly (not sourced), run the command handler
295: if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
296:     nftban_cmd_config "$@"
297: fi
</file>

<file path="cli/lib/nftban/cli/cmd_ddos.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: 
  4: # Load JSON helper for --json support
  5: [[ -z "${NFTBAN_LIB_DIR:-}" ]] && readonly NFTBAN_LIB_DIR="/usr/lib/nftban"
  6: 
  7: # Load strict mode library
  8: # shellcheck source=/usr/lib/nftban/lib/strict.sh
  9: if [[ -f "${NFTBAN_LIB_DIR}/lib/strict.sh" ]]; then
 10:     source "${NFTBAN_LIB_DIR}/lib/strict.sh"
 11: else
 12:     # Fallback to manual strict mode
 13:     set -Eeuo pipefail
 14: fi
 15: 
 16: # Load version library
 17: # shellcheck source=/usr/lib/nftban/lib/version.sh
 18: if [[ -f "${NFTBAN_LIB_DIR}/lib/version.sh" ]]; then
 19:     source "${NFTBAN_LIB_DIR}/lib/version.sh"
 20: fi
 21: JSON_HELPER="${NFTBAN_LIB_DIR}/helpers/json_output.sh"
 22: if [[ -f "$JSON_HELPER" ]]; then
 23:     # shellcheck source=/dev/null
 24:     source "$JSON_HELPER"
 25: fi
 26: # NFTBan v1.0.0 - DDoS CLI Handler
 27: # =============================================================================
 28: 
 29: # SPDX-License-Identifier: MPL-2.0
 30: # Purpose: Command-line interface for DDoS protection management
 31: #
 32: # meta:name=cmd_ddos
 33: # meta:type=cli
 34: # meta:header=DDoS CLI
 35: # meta:version=1.0.0
 36: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 37: # meta:homepage=https://nftban.com
 38: #
 39: # **Description & Purpose**
 40: # meta:description=CLI handler for DDoS protection commands
 41: # meta:input=Command line arguments (enable, disable, status, etc.)
 42: # meta:output=DDoS protection management output
 43: #
 44: # **Inventory & Requirements**
 45: # meta:depends=bash,nftban_ddos.sh
 46: #
 47: # meta:created_date=2025-11-05
 48: # meta:updated_date=2025-11-24
 49: # =============================================================================
 50: 
 51: 
 52: 
 53: # =============================================================================
 54: 
 55: # CONFIGURATION
 56: # =============================================================================
 57: 
 58: # =============================================================================
 59: 
 60: # HELP TEXT
 61: # =============================================================================
 62: 
 63: 
 64: _nftban_ddos_help() {
 65:     # Load output module for standard banner
 66:     source "${NFTBAN_LIB_DIR}/core/nftban_output.sh"
 67: 
 68:     # Show standard banner
 69:     nftban_banner
 70: 
 71:     cat <<'HELP'
 72: 
 73: USAGE:
 74:     nftban ddos <command> [options]
 75: 
 76: COMMANDS:
 77:     enable              Enable DDoS protection (all configured protections)
 78:     disable             Disable all DDoS protections
 79:     status              Show status of all DDoS protections
 80: 
 81:     enable synflood     Enable SYN flood protection only
 82:     disable synflood    Disable SYN flood protection only
 83:     status synflood     Show SYN flood protection status
 84: 
 85:     enable connlimit    Enable connection limit protection only
 86:     disable connlimit   Disable connection limit protection only
 87:     status connlimit    Show connection limit protection status
 88: 
 89:     enable portflood    Enable port flood protection only
 90:     disable portflood   Disable port flood protection only
 91:     status portflood    Show port flood protection status
 92: 
 93:     enable icmp         Enable ICMP flood protection only
 94:     disable icmp        Disable ICMP flood protection only
 95:     status icmp         Show ICMP flood protection status
 96: 
 97:     test                Test DDoS protection rules
 98:     help                Show this help message
 99: 
100: DESCRIPTION:
101:     The DDoS protection module provides comprehensive protection against
102:     distributed denial-of-service attacks using nftables rate limiting
103:     and connection tracking.
104: 
105: PROTECTION TYPES:
106: 
107:     1. SYN Flood Protection
108:        Protects against TCP SYN flood attacks by rate limiting new
109:        connections with SYN flag set.
110: 
111:        ⚠️  WARNING: Only enable during active attack (adds connection latency)
112: 
113:        Configuration:
114:          DDOS_SYNFLOOD_ENABLED="false"    # Master switch
115:          DDOS_SYNFLOOD_RATE="100/second"  # Rate limit
116:          DDOS_SYNFLOOD_BURST="150"        # Burst allowance
117: 
118:     2. Connection Limit Protection
119:        Limits concurrent connections per IP address to specific ports.
120:        Prevents connection exhaustion attacks.
121: 
122:        ✅ Recommended: Enable for all servers
123: 
124:        Configuration:
125:          DDOS_CONNLIMIT_ENABLED="true"    # Master switch
126:          DDOS_CONNLIMIT_SSH="5"           # Max SSH connections per IP
127:          DDOS_CONNLIMIT_HTTP="20"         # Max HTTP connections per IP
128:          DDOS_CONNLIMIT_HTTPS="20"        # Max HTTPS connections per IP
129:          DDOS_CONNLIMIT_SMTP="5"          # Max SMTP connections per IP
130:          ... (9 services total)
131: 
132:     3. Port Flood Protection
133:        Rate limits new connection attempts per time period.
134:        Effective against slowloris and brute force attacks.
135: 
136:        Configuration:
137:          DDOS_PORTFLOOD_ENABLED="true"    # Master switch
138:          DDOS_PORTFLOOD_SSH="5/300"       # 5 connections per 5 minutes
139:          DDOS_PORTFLOOD_HTTP="20/5"       # 20 connections per 5 seconds
140:          DDOS_PORTFLOOD_HTTPS="20/5"      # 20 connections per 5 seconds
141: 
142:     4. ICMP Flood Protection
143:        Rate limits ICMP echo requests (ping) to prevent ping floods.
144:        Allows legitimate monitoring but blocks abuse.
145: 
146:        ✅ Recommended: Always enable
147: 
148:        Configuration:
149:          DDOS_ICMPFLOOD_ENABLED="true"    # Master switch
150:          DDOS_ICMPFLOOD_RATE="1/second"   # 1 ping per second per IP
151:          DDOS_ICMPFLOOD_BURST="10"        # Burst allowance
152: 
153: CONFIGURATION:
154:     DDoS protection is configured in:
155:       /etc/nftban/conf.d/ddos/main.conf
156: 
157:     User overrides:
158:       /etc/nftban/nftban.conf.local
159: 
160:     Example override:
161:       DDOS_CONNLIMIT_HTTP="50"         # Increase HTTP limit to 50
162:       DDOS_SYNFLOOD_ENABLED="true"     # Enable SYN flood protection
163: 
164: PROFILE SELECTION:
165:     Instead of manually configuring DDoS protection, you can select
166:     a pre-configured profile based on your server role:
167: 
168:       nftban profile select
169: 
170:     Available profiles:
171:       • Web Server      - High HTTP/HTTPS traffic
172:       • Mail Server     - SMTP, POP3, IMAP protection
173:       • Database        - MySQL, PostgreSQL protection
174:       • Mixed           - Multiple services
175:       • Development     - Minimal protection for testing
176:       • Maximum         - All protections enabled (paranoid mode)
177:       • Custom          - User-defined configuration
178: 
179: EXAMPLES:
180:     # Enable all DDoS protections (based on config)
181:     sudo nftban ddos enable
182: 
183:     # Disable all DDoS protections
184:     sudo nftban ddos disable
185: 
186:     # Show status of all protections
187:     nftban ddos status
188: 
189:     # Enable only connection limit protection
190:     sudo nftban ddos enable connlimit
191: 
192:     # Show SYN flood protection status
193:     nftban ddos status synflood
194: 
195:     # Disable ICMP flood protection
196:     sudo nftban ddos disable icmp
197: 
198:     # Test DDoS protection rules
199:     nftban ddos test
200: 
201: LOG FILES:
202:     DDoS protection logs: /var/log/nftban/ddos.log
203:     Statistics: /var/lib/nftban/ddos/stats.json
204: 
205: REQUIREMENTS:
206:     • Root privileges (for enable/disable commands)
207:     • nftables >= 0.9.0
208:     • Linux kernel >= 3.13 (for connection tracking)
209: 
210: SEE ALSO:
211:     nftban profile help      - Profile selection help
212:     nftban portscan help     - Port scan detection help
213:     nftban cloudflare help   - Cloudflare integration help
214: 
215: HELP
216: }
217: 
218: # =============================================================================
219: 
220: # JSON STATS FUNCTION (for API/GUI)
221: # =============================================================================
222: 
223: _nftban_ddos_stats_json() {
224:     local json_mode="${1:-false}"
225: 
226:     # Get DDoS enabled status, mode, and rate limit from config
227:     local ddos_enabled="false"
228:     local ddos_mode="classic"
229:     local rate_limit=0
230:     local suricata_available="false"
231:     local config_file="/etc/nftban/conf.d/ddos.conf"
232:     local config_main="/etc/nftban/conf.d/ddos/main.conf"
233:     local config_classic="/etc/nftban/conf.d/ddos/classic.conf"
234: 
235:     # Check if Suricata is available
236:     if systemctl is-active suricata.service >/dev/null 2>&1; then
237:         suricata_available="true"
238:     fi
239: 
240:     if [[ -f "$config_main" ]]; then
241:         local enabled_val
242:         enabled_val=$(grep "^DDOS_ENABLED=" "$config_main" 2>/dev/null | cut -d= -f2 | tr -d '"' | tr -d "'" | xargs)
243:         [[ "$enabled_val" == "true" ]] && ddos_enabled="true"
244:         # Get mode (auto, classic, suricata, hybrid)
245:         local mode_val
246:         mode_val=$(grep "^DDOS_MODE=" "$config_main" 2>/dev/null | cut -d= -f2 | tr -d '"' | tr -d "'" | xargs)
247:         [[ -n "$mode_val" ]] && ddos_mode="$mode_val"
248:         # If mode is "auto", determine effective mode
249:         if [[ "$ddos_mode" == "auto" ]]; then
250:             if [[ "$suricata_available" == "true" ]]; then
251:                 ddos_mode="suricata"
252:             else
253:                 ddos_mode="classic"
254:             fi
255:         fi
256:     elif [[ -f "$config_file" ]]; then
257:         local enabled_val2
258:         enabled_val2=$(grep "^DDOS_ENABLED=" "$config_file" 2>/dev/null | cut -d= -f2 | tr -d '"' | tr -d "'" | xargs)
259:         [[ "$enabled_val2" == "true" ]] && ddos_enabled="true"
260:     fi
261: 
262:     # Get rate limit from classic config (if exists)
263:     if [[ -f "$config_classic" ]]; then
264:         local rate_val
265:         rate_val=$(grep "^DDOS_SYNFLOOD_RATE=" "$config_classic" 2>/dev/null | cut -d= -f2 | tr -d '"' | tr -d "'" | grep -oE '^[0-9]+' || echo "0")
266:         [[ -n "$rate_val" ]] && rate_limit="$rate_val"
267:     elif [[ -f "$config_main" ]]; then
268:         local rate_val2
269:         rate_val2=$(grep "^DDOS_SYNFLOOD_RATE=" "$config_main" 2>/dev/null | cut -d= -f2 | tr -d '"' | tr -d "'" | grep -oE '^[0-9]+' || echo "0")
270:         [[ -n "$rate_val2" ]] && rate_limit="$rate_val2"
271:     fi
272: 
273:     # Count DDoS blocks from nftban-actions.log
274:     local blocked_24h=0
275:     local blocked_total=0
276:     local packets_dropped=0
277:     local bytes_dropped=0
278: 
279:     if [[ -f "/var/log/nftban/nftban-actions.log" ]]; then
280:         # Count ddos bans in last 24 hours
281:         local yesterday_ts
282:         yesterday_ts=$(date -d '24 hours ago' +%s 2>/dev/null || echo "0")
283:         blocked_24h=$(jq -r --arg ts "$yesterday_ts" 'select(.source == "ddos" and .event == "ban") | select((.ts | fromdateiso8601) >= ($ts | tonumber))' /var/log/nftban/nftban-actions.log 2>/dev/null | jq -s '. | length' 2>/dev/null || echo "0")
284: 
285:         # Count total ddos bans
286:         blocked_total=$(jq -r 'select(.source == "ddos" and .event == "ban")' /var/log/nftban/nftban-actions.log 2>/dev/null | jq -s '. | length' 2>/dev/null || echo "0")
287:     fi
288: 
289:     # Try to get nftables counter stats (packets/bytes dropped)
290:     # Check DDoS-related chains for drop counters
291:     if command -v nft &>/dev/null; then
292:         # Get counter stats from ddos_protection chain if it exists
293:         local counter_output
294:         counter_output=$(nft list chain ip nftban ddos_protection 2>/dev/null || true)
295:         if [[ -n "$counter_output" ]]; then
296:             # Parse packets and bytes from counter output
297:             # Format: counter packets X bytes Y
298:             packets_dropped=$(echo "$counter_output" | grep -oP 'counter packets \K[0-9]+' | head -1 || echo "0")
299:             bytes_dropped=$(echo "$counter_output" | grep -oP 'bytes \K[0-9]+' | head -1 || echo "0")
300:         fi
301:     fi
302: 
303:     # Ensure numeric values
304:     packets_dropped=${packets_dropped:-0}
305:     bytes_dropped=${bytes_dropped:-0}
306:     blocked_24h=${blocked_24h:-0}
307:     blocked_total=${blocked_total:-0}
308: 
309:     if [[ "$json_mode" == "true" ]] && declare -f json_output >/dev/null 2>&1; then
310:         local data
311:         if command -v jq &>/dev/null; then
312:             data=$(jq -n \
313:                 --arg packets "$packets_dropped" \
314:                 --arg bytes "$bytes_dropped" \
315:                 --arg blocked_24h "$blocked_24h" \
316:                 --arg blocked_total "$blocked_total" \
317:                 --arg enabled "$ddos_enabled" \
318:                 --arg rate "$rate_limit" \
319:                 --arg mode "$ddos_mode" \
320:                 --arg suricata "$suricata_available" \
321:                 '{
322:                     ddos: {
323:                         packets_dropped: ($packets | tonumber),
324:                         bytes_dropped: ($bytes | tonumber),
325:                         blocked_24h: ($blocked_24h | tonumber),
326:                         blocked_total: ($blocked_total | tonumber),
327:                         enabled: ($enabled == "true"),
328:                         rate_limit: ($rate | tonumber),
329:                         mode: $mode,
330:                         suricata_available: ($suricata == "true")
331:                     }
332:                 }')
333:         else
334:             local enabled_json="false"
335:             local suricata_json="false"
336:             [[ "$ddos_enabled" == "true" ]] && enabled_json="true"
337:             [[ "$suricata_available" == "true" ]] && suricata_json="true"
338:             data="{\"ddos\":{\"packets_dropped\":$packets_dropped,\"bytes_dropped\":$bytes_dropped,\"blocked_24h\":$blocked_24h,\"blocked_total\":$blocked_total,\"enabled\":$enabled_json,\"rate_limit\":$rate_limit,\"mode\":\"$ddos_mode\",\"suricata_available\":$suricata_json}}"
339:         fi
340: 
341:         json_output "true" "$data"
342:         return 0
343:     fi
344: 
345:     # Human-readable output
346:     echo "DDoS Protection Statistics"
347:     echo "=========================="
348:     echo ""
349:     echo "  Enabled:         $ddos_enabled"
350:     echo "  Mode:            $ddos_mode"
351:     echo "  Suricata:        $suricata_available"
352:     echo "  Rate Limit:      $rate_limit conn/s"
353:     echo "  Packets Dropped: $packets_dropped"
354:     echo "  Bytes Dropped:   $bytes_dropped"
355:     echo "  Blocked (24h):   $blocked_24h"
356:     echo "  Blocked (Total): $blocked_total"
357:     echo ""
358: }
359: 
360: # =============================================================================
361: 
362: # MAIN COMMAND HANDLER
363: # =============================================================================
364: 
365: 
366: nftban_cmd_ddos() {
367:     local action="${1:-status}"
368:     local json_mode=false
369: 
370:     # Check for --json flag
371:     for arg in "$@"; do
372:         [[ "$arg" == "--json" ]] && json_mode=true && break
373:     done
374:     shift || true
375: 
376:     # Load core DDoS module (lazy loading for performance)
377:     if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_ddos.sh" ]]; then
378:         # shellcheck source=/dev/null
379:         source "${NFTBAN_LIB_DIR}/core/nftban_ddos.sh"
380:     else
381:         echo "ERROR: DDoS protection module not found"
382:         echo "Expected: ${NFTBAN_LIB_DIR}/core/nftban_ddos.sh"
383:         exit 1
384:     fi
385: 
386:     # NOTE: Root check removed - nftables operations require CAP_NET_ADMIN
387:     # which can be granted via capabilities, not just EUID==0.
388:     # Let the actual nft commands fail with proper error if privileges missing.
389: 
390:     # Handle commands
391:     case "$action" in
392:         enable)
393:             local subaction="${1:-all}"
394:             case "$subaction" in
395:                 synflood)
396:                     nftban_ddos_synflood_enable
397:                     ;;
398:                 connlimit)
399:                     nftban_ddos_connlimit_enable
400:                     ;;
401:                 portflood)
402:                     nftban_ddos_portflood_enable
403:                     ;;
404:                 icmp)
405:                     nftban_ddos_icmp_enable
406:                     ;;
407:                 all|*)
408:                     nftban_ddos_enable
409:                     ;;
410:             esac
411:             ;;
412: 
413:         disable)
414:             local subaction="${1:-all}"
415:             case "$subaction" in
416:                 synflood)
417:                     nftban_ddos_synflood_disable
418:                     ;;
419:                 connlimit)
420:                     nftban_ddos_connlimit_disable
421:                     ;;
422:                 portflood)
423:                     nftban_ddos_portflood_disable
424:                     ;;
425:                 icmp)
426:                     nftban_ddos_icmp_disable
427:                     ;;
428:                 all|*)
429:                     nftban_ddos_disable
430:                     ;;
431:             esac
432:             ;;
433: 
434:         status)
435:             # Banner is handled by main CLI router
436:             local subaction="${1:-all}"
437:             case "$subaction" in
438:                 synflood)
439:                     nftban_ddos_synflood_status
440:                     ;;
441:                 connlimit)
442:                     nftban_ddos_connlimit_status
443:                     ;;
444:                 portflood)
445:                     nftban_ddos_portflood_status
446:                     ;;
447:                 icmp)
448:                     nftban_ddos_icmp_status
449:                     ;;
450:                 all|*)
451:                     nftban_ddos_status
452:                     ;;
453:             esac
454:             ;;
455: 
456:         stats)
457:             # JSON stats for API/GUI - output DDoS statistics
458:             _nftban_ddos_stats_json "$json_mode"
459:             ;;
460: 
461:         test)
462:             nftban_ddos_banner
463:             echo ""
464:             echo "🧪 Testing DDoS Protection Rules"
465:             echo ""
466:             echo "Checking nftables chains..."
467:             echo ""
468: 
469:             # Check for SYN flood chain
470:             if nft list chain ${NFTBAN_TABLE_IPV4} synflood_protection &>/dev/null; then
471:                 echo "  ✅ SYN flood chain exists (IPv4)"
472:             else
473:                 echo "  ❌ SYN flood chain not found (IPv4)"
474:             fi
475: 
476:             # Check for connection limit chain
477:             if nft list chain ${NFTBAN_TABLE_IPV4} connlimit_protection &>/dev/null; then
478:                 echo "  ✅ Connection limit chain exists (IPv4)"
479:             else
480:                 echo "  ❌ Connection limit chain not found (IPv4)"
481:             fi
482: 
483:             # Check for port flood chain
484:             if nft list chain ${NFTBAN_TABLE_IPV4} portflood_protection &>/dev/null; then
485:                 echo "  ✅ Port flood chain exists (IPv4)"
486:             else
487:                 echo "  ❌ Port flood chain not found (IPv4)"
488:             fi
489: 
490:             # Check for ICMP chain
491:             if nft list chain ${NFTBAN_TABLE_IPV4} icmp_protection &>/dev/null; then
492:                 echo "  ✅ ICMP protection chain exists (IPv4)"
493:             else
494:                 echo "  ❌ ICMP protection chain not found (IPv4)"
495:             fi
496: 
497:             echo ""
498:             echo "Test complete. Run 'nftban ddos status' for detailed information."
499:             ;;
500: 
501:         help|--help|-h)
502:             _nftban_ddos_help
503:             ;;
504: 
505:         *)
506:             echo "ERROR: Unknown command: $action"
507:             echo ""
508:             echo "Available commands: enable, disable, status, test, help"
509:             echo "Run 'nftban ddos help' for detailed usage information"
510:             exit 1
511:             ;;
512:     esac
513: 
514: 
515:     # Exit marker for testing validation
516:     command -v nftban_cmd_exit >/dev/null 2>&1 && nftban_cmd_exit "ddos"
517:     return 0
518: }
519: 
520: # =============================================================================
521: 
522: # EXPORT FOR MAIN CLI
523: # =============================================================================
524: 
525: export -f nftban_cmd_ddos
526: 
527: # Execute if called directly (shouldn't happen, but handle gracefully)
528: if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
529:     nftban_cmd_ddos "$@"
530: fi
</file>

<file path="cli/lib/nftban/cli/cmd_debug.sh">
  1: #!/usr/bin/env bash

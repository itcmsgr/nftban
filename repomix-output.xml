 588: nftban_report_cmd_schedule() {
 589:     # Manage scheduled reports
 590:     # Usage: nftban report schedule <daily|weekly|monthly|list|remove> [OPTIONS]
 591: 
 592:     local action="${1:-list}"
 593: 
 594:     case "$action" in
 595:         daily|weekly|monthly)
 596:             shift
 597:             nftban_report_schedule_add "$action" "$@"
 598:             ;;
 599:         list)
 600:             nftban_report_schedule_list
 601:             ;;
 602:         remove)
 603:             shift
 604:             nftban_report_schedule_remove "$@"
 605:             ;;
 606:         *)
 607:             echo "ERROR: Unknown schedule action: $action" >&2
 608:             echo "Valid actions: daily, weekly, monthly, list, remove" >&2
 609:             return 1
 610:             ;;
 611:     esac
 612: }

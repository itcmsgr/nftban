<file path="cmd/nftban-ui/web/static/pages/config.html">
  1: <h2><i class="fa fa-gear"></i> Configuration</h2>
  2: <p class="text-muted">Manage NFTBan configuration settings</p>
  3: 
  4: <div class="card">
  5:     <h3><i class="fa fa-list"></i> Configuration Modules</h3>
  6:     <div id="config-modules" style="display: grid; gap: 15px;">
  7:         <p class="text-center text-muted"><i class="fa fa-spinner fa-spin"></i> Loading modules...</p>
  8:     </div>
  9: </div>
 10: 
 11: <div id="config-editor" class="card" style="display: none;">
 12:     <h3><i class="fa fa-file-code"></i> Edit Configuration</h3>
 13:     <div style="margin-bottom: 15px;">
 14:         <strong id="config-module-name"></strong>
 15:         <button onclick="closeConfigEditor()" class="btn-secondary" style="float: right;">
 16:             <i class="fa fa-xmark"></i> Close
 17:         </button>
 18:     </div>
 19: 
 20:     <textarea id="config-content" style="width: 100%; min-height: 400px; font-family: monospace; padding: 15px; background: var(--bg); color: var(--text); border: 1px solid var(--border); border-radius: 6px;"></textarea>
 21: 
 22:     <div style="margin-top: 15px; display: flex; gap: 10px;">
 23:         <button onclick="saveConfig()" class="btn-primary">
 24:             <i class="fa fa-save"></i> Save Configuration
 25:         </button>
 26:         <button onclick="resetConfig()" class="btn-danger">
 27:             <i class="fa fa-rotate-left"></i> Reset to Default
 28:         </button>
 29:     </div>

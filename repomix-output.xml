 275: // DeleteFromIntervalSetCLI removes a single IP from an interval set, handling merged ranges.
 276: // If the IP is inside a merged range (e.g., 7.7.7.7 inside 7.7.7.0-8.8.8.0), it will:
 277: // 1. Delete the containing range
 278: // 2. Re-add the sub-ranges before and after the IP
 279: //
 280: // This works correctly with nftables auto-merge interval sets.
 281: func (m *NFTManager) DeleteFromIntervalSetCLI(set *nftables.Set, ipStr string) error {
 282: 	// Parse the IP
 283: 	ip := net.ParseIP(ipStr)
 284: 	if ip == nil {
 285: 		return fmt.Errorf("invalid IP: %s", ipStr)
 286: 	}
 287: 
 288: 	ipVal, err := ipv4ToUint32(ip)
 289: 	if err != nil {
 290: 		return fmt.Errorf("IP conversion failed: %w", err)
 291: 	}
 292: 
 293: 	// Determine table family
 294: 	var family string
 295: 	if set.Table.Family == nftables.TableFamilyIPv4 {
 296: 		family = "ip"
 297: 	} else {
 298: 		family = "ip6"
 299: 	}
 300: 
 301: 	// Step 1: Get current set elements using nft list
 302: 	// Parse output to find if IP is exact element or inside a range
 303: 	output, err := nftListSetWithHandles(family, set.Table.Name, set.Name)
 304: 	if err != nil {
 305: 		return fmt.Errorf("failed to list set: %w", err)
 306: 	}
 307: 
 308: 	// Step 2: Parse elements to find the containing range
 309: 	containingRange, exactMatch, err := m.findContainingRange(output, ipStr, ipVal)
 310: 	if err != nil {
 311: 		return err
 312: 	}
 313: 
 314: 	// Step 3: If exact match, simple delete
 315: 	if exactMatch {
 316: 		err := nftDeleteElement(family, set.Table.Name, set.Name, "{ "+ipStr+" }")
 317: 		if err == nil {
 318: 			return nil // Successfully deleted as exact element
 319: 		}
 320: 		// If it fails, element might be merged - continue to range splitting
 321: 	}
 322: 
 323: 	// Step 4: If inside a range, need to split
 324: 	if containingRange != nil {
 325: 		return m.splitRangeAndRemoveIP(set, family, containingRange, ipVal)
 326: 	}
 327: 
 328: 	// IP not found in set
 329: 	return fmt.Errorf("IP %s not found in set %s", ipStr, set.Name)
 330: }

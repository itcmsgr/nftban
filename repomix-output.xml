<file path="cli/lib/nftban/core/nftban_watchdog.sh">
   1: #!/usr/bin/env bash
   2: # =============================================================================
   3: # NFTBan v1.0 - System Watchdog Module
   4: # =============================================================================
   5: # SPDX-License-Identifier: MPL-2.0
   6: # Purpose: Monitor system resources for auditing and alerting
   7: #
   8: # meta:name=nftban_watchdog
   9: # meta:type=core
  10: # meta:header=System Watchdog Module
  11: # meta:version=1.0.0
  12: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
  13: # meta:homepage=https://nftban.com
  14: #
  15: # **Description & Purpose**
  16: # meta:description=Monitors OS-level resources (load, memory, I/O, disk) for troubleshooting
  17: # meta:input=System /proc filesystem and df command
  18: # meta:output=Reports, alerts, and Prometheus metrics
  19: #
  20: # **Inventory & Requirements**
  21: # meta:depends=bash,df
  22: #
  23: # **What This Module Monitors (NO OVERLAP with other modules)**
  24: # - Load Average (from /proc/loadavg)
  25: # - Memory Usage (from /proc/meminfo)
  26: # - Swap Usage (from /proc/meminfo)
  27: # - I/O Wait % (from /proc/stat)
  28: # - Disk Usage (from df command)
  29: # - File Descriptors (from /proc/sys/fs/file-nr)
  30: # - Top CPU/Memory Processes (from /proc/[pid]/*)
  31: #
  32: # **What OTHER Modules Handle (we don't touch these)**
  33: # - Connection per IP: nftban_ddos_classic.sh
  34: # - Ban rate alerts: nftban_stats.sh
  35: # - Service health: nftban_health.sh
  36: #
  37: # meta:created_date=2025-12-17
  38: # meta:updated_date=2025-12-17
  39: # =============================================================================
  40: 
  41: # Enhanced strict mode
  42: IFS=$'\n\t'
  43: umask 027
  44: 
  45: # Prevent double-loading
  46: [[ -n "${NFTBAN_WATCHDOG_LOADED:-}" ]] && return 0
  47: readonly NFTBAN_WATCHDOG_LOADED=1
  48: 
  49: # =============================================================================
  50: # CONFIGURATION (defaults - override in conf.d/watchdog.conf)
  51: # =============================================================================
  52: 
  53: # Load main configuration
  54: # shellcheck source=/etc/nftban/nftban.conf
  55: if [[ -f "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf" ]]; then
  56:     source "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf"
  57: fi
  58: 
  59: # Watchdog defaults (can be overridden in conf.d/watchdog.conf)
  60: : "${NFTBAN_WATCHDOG_ENABLED:=false}"
  61: : "${NFTBAN_WATCHDOG_INTERVAL:=90}"
  62: : "${NFTBAN_WATCHDOG_ALERT_THROTTLE:=3600}"
  63: 
  64: # Load thresholds
  65: : "${NFTBAN_WATCHDOG_LOAD_ENABLED:=true}"
  66: : "${NFTBAN_WATCHDOG_LOAD_AVG:=5}"
  67: : "${NFTBAN_WATCHDOG_LOAD_WARNING:=10}"
  68: : "${NFTBAN_WATCHDOG_LOAD_CRITICAL:=20}"
  69: 
  70: # Memory thresholds
  71: : "${NFTBAN_WATCHDOG_MEM_ENABLED:=true}"
  72: : "${NFTBAN_WATCHDOG_MEM_WARNING:=80}"
  73: : "${NFTBAN_WATCHDOG_MEM_CRITICAL:=95}"
  74: : "${NFTBAN_WATCHDOG_SWAP_WARNING:=50}"
  75: 
  76: # I/O wait thresholds
  77: : "${NFTBAN_WATCHDOG_IOWAIT_ENABLED:=true}"
  78: : "${NFTBAN_WATCHDOG_IOWAIT_WARNING:=20}"
  79: : "${NFTBAN_WATCHDOG_IOWAIT_CRITICAL:=40}"
  80: 
  81: # Disk thresholds
  82: : "${NFTBAN_WATCHDOG_DISK_ENABLED:=true}"
  83: : "${NFTBAN_WATCHDOG_DISK_PATH:=/var/log}"
  84: : "${NFTBAN_WATCHDOG_DISK_WARNING:=80}"
  85: : "${NFTBAN_WATCHDOG_DISK_CRITICAL:=95}"
  86: 
  87: # Process tracking
  88: : "${NFTBAN_WATCHDOG_PROC_ENABLED:=true}"
  89: : "${NFTBAN_WATCHDOG_PROC_TOP_COUNT:=10}"
  90: : "${NFTBAN_WATCHDOG_PROC_CPU_ALERT:=80}"
  91: : "${NFTBAN_WATCHDOG_PROC_MEM_ALERT:=2048}"
  92: 
  93: # Logging and metrics
  94: : "${NFTBAN_WATCHDOG_LOG:=${NFTBAN_LOG_DIR:-/var/log/nftban}/watchdog.log}"
  95: : "${NFTBAN_WATCHDOG_REPORT_DIR:=${NFTBAN_DATA_DIR:-/var/lib/nftban}/reports/watchdog}"
  96: : "${NFTBAN_WATCHDOG_ALERT_EMAIL:=true}"
  97: : "${NFTBAN_WATCHDOG_ALERT_SYSLOG:=true}"
  98: 
  99: # Prometheus metrics
 100: : "${NFTBAN_WATCHDOG_METRICS_ENABLED:=true}"
 101: : "${NFTBAN_WATCHDOG_METRICS_FILE:=${NFTBAN_DATA_DIR:-/var/lib/nftban}/metrics/watchdog.prom}"
 102: : "${NFTBAN_WATCHDOG_REPORT_RETENTION:=7}"
 103: 
 104: # Throttle state file
 105: readonly WATCHDOG_THROTTLE_FILE="${NFTBAN_RUN_DIR:-/run/nftban}/watchdog_throttle"
 106: 
 107: # Status codes
 108: readonly WATCHDOG_OK=0
 109: readonly WATCHDOG_WARNING=1
 110: readonly WATCHDOG_CRITICAL=2
 111: 
 112: # Results storage
 113: declare -A WATCHDOG_RESULTS=()
 114: declare -a WATCHDOG_ALERTS=()
 115: 
 116: # =============================================================================
 117: # HELPER FUNCTIONS
 118: # =============================================================================
 119: 
 120: watchdog_log() {
 121:     # Write to watchdog log
 122:     local level="$1"
 123:     shift
 124:     local msg="$*"
 125:     local timestamp
 126:     timestamp=$(date '+%Y-%m-%d %H:%M:%S')
 127: 
 128:     # Ensure log directory exists
 129:     mkdir -p "$(dirname "$NFTBAN_WATCHDOG_LOG")" 2>/dev/null
 130: 
 131:     echo "[$timestamp] [$level] $msg" >> "$NFTBAN_WATCHDOG_LOG"
 132: }
 133: 
 134: watchdog_alert() {
 135:     # Add alert to list and optionally send to syslog
 136:     local severity="$1"
 137:     local msg="$2"
 138: 
 139:     WATCHDOG_ALERTS+=("[$severity] $msg")
 140: 
 141:     # Log to syslog if enabled
 142:     if [[ "$NFTBAN_WATCHDOG_ALERT_SYSLOG" == "true" ]]; then
 143:         local priority="user.notice"
 144:         [[ "$severity" == "WARNING" ]] && priority="user.warning"
 145:         [[ "$severity" == "CRITICAL" ]] && priority="user.alert"
 146:         logger -t nftban-watchdog -p "$priority" "$msg"
 147:     fi
 148: 
 149:     watchdog_log "$severity" "$msg"
 150: }
 151: 
 152: watchdog_should_alert() {
 153:     # Check if we should send alert (throttle check)
 154:     local alert_type="$1"
 155:     local throttle_file="${WATCHDOG_THROTTLE_FILE}_${alert_type}"
 156: 
 157:     if [[ -f "$throttle_file" ]]; then
 158:         local last_alert
 159:         last_alert=$(cat "$throttle_file" 2>/dev/null || echo 0)
 160:         local now
 161:         now=$(date +%s)
 162:         local diff
 163:         diff=$((now - last_alert))
 164: 
 165:         if [[ $diff -lt $NFTBAN_WATCHDOG_ALERT_THROTTLE ]]; then
 166:             return 1  # Throttled
 167:         fi
 168:     fi
 169: 
 170:     # Update throttle timestamp
 171:     mkdir -p "$(dirname "$throttle_file")" 2>/dev/null
 172:     date +%s > "$throttle_file"
 173:     return 0
 174: }

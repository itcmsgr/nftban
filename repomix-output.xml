<file path="pkg/sync/nft_cli.go">
  1: // Package sync provides nftables synchronization utilities
  2: package sync
  3: 
  4: import (
  5: 	"context"
  6: 	"fmt"
  7: 	"os/exec"
  8: 	"strings"
  9: 	"time"
 10: )
 11: 
 12: // =============================================================================
 13: // Centralized NFT CLI Execution Layer
 14: // =============================================================================
 15: // Purpose: All nft CLI calls go through these helpers for:
 16: // - Consistent timeout handling
 17: // - Unified error handling with ignorable patterns
 18: // - Logging and debugging
 19: // - Future: metrics collection, rate limiting
 20: // =============================================================================
 21: 
 22: // Default timeout for nft commands
 23: const (
 24: 	nftTimeoutDefault = 30 * time.Second
 25: 	nftTimeoutFast    = 5 * time.Second
 26: 	nftTimeoutSlow    = 120 * time.Second
 27: )
 28: 
 29: // Common ignorable error patterns
 30: const (
 31: 	ErrFileExists       = "File exists"
 32: 	ErrIntervalOverlaps = "interval overlaps"
 33: 	ErrElementNotExist  = "element does not exist"
 34: 	ErrNoSuchFile       = "No such file or directory"
 35: )
 36: 
 37: // runNft executes an nft command with default timeout
 38: // Returns combined stdout+stderr output and error
 39: func runNft(args ...string) ([]byte, error) {
 40: 	return runNftWithTimeout(nftTimeoutDefault, args...)
 41: }
 42: 
 43: // runNftFast executes an nft command with fast timeout (5s)
 44: // Use for simple queries like list, status checks
 45: func runNftFast(args ...string) ([]byte, error) {
 46: 	return runNftWithTimeout(nftTimeoutFast, args...)
 47: }
 48: 
 49: //nolint:U1000 // Helper for large batch operations with extended timeout
 50: 
 51: // runNftWithTimeout executes an nft command with specified timeout
 52: func runNftWithTimeout(timeout time.Duration, args ...string) ([]byte, error) {
 53: 	ctx, cancel := context.WithTimeout(context.Background(), timeout)
 54: 	defer cancel()
 55: 
 56: 	cmd := exec.CommandContext(ctx, "nft", args...)
 57: 	output, err := cmd.CombinedOutput()
 58: 
 59: 	if err != nil {
 60: 		if ctx.Err() == context.DeadlineExceeded {
 61: 			return output, fmt.Errorf("nft command timed out after %v: %v", timeout, args)
 62: 		}
 63: 		return output, fmt.Errorf("nft %v failed: %w (output: %s)", args, err, string(output))
 64: 	}
 65: 
 66: 	return output, nil
 67: }
 68: 
 69: // runNftFile executes nft -f <file> with default timeout
 70: func runNftFile(path string) ([]byte, error) {
 71: 	return runNft("-f", path)
 72: }
 73: 
 74: //nolint:U1000 // Helper for large rule files with extended timeout
 75: 
 76: // isIgnorableNftError checks if an nft error output contains ignorable patterns
 77: // Returns true if the error can be safely ignored
 78: func isIgnorableNftError(output string, patterns ...string) bool {
 79: 	for _, pattern := range patterns {
 80: 		if strings.Contains(output, pattern) {
 81: 			return true
 82: 		}
 83: 	}
 84: 	return false
 85: }
 86: 
 87: // runNftIgnoring executes nft and ignores specified error patterns
 88: // Returns nil error if command succeeds OR if error matches any ignore pattern
 89: func runNftIgnoring(ignorePatterns []string, args ...string) error {
 90: 	output, err := runNft(args...)
 91: 	if err != nil {
 92: 		if isIgnorableNftError(string(output), ignorePatterns...) {
 93: 			return nil
 94: 		}
 95: 		return err
 96: 	}
 97: 	return nil
 98: }
 99: 
100: // =============================================================================
101: // Convenience Functions for Common Operations
102: // =============================================================================
103: 
104: // nftAddSet creates a set with the given definition
105: // Ignores "File exists" errors (set already exists)
106: func nftAddSet(family, table, setName, setDef string) error {
107: 	args := []string{"add", "set", family, table, setName, setDef}
108: 	return runNftIgnoring([]string{ErrFileExists}, args...)
109: }
110: 
111: // nftAddElement adds elements to a set
112: // Ignores "interval overlaps" errors (element already covered)
113: func nftAddElement(family, table, setName, elements string) error {
114: 	args := []string{"add", "element", family, table, setName, elements}
115: 	return runNftIgnoring([]string{ErrIntervalOverlaps, ErrFileExists}, args...)
116: }
117: 
118: // nftDeleteElement deletes elements from a set
119: // Ignores "element does not exist" and "No such file" errors
120: func nftDeleteElement(family, table, setName, elements string) error {
121: 	args := []string{"delete", "element", family, table, setName, elements}
122: 	return runNftIgnoring([]string{ErrElementNotExist, ErrNoSuchFile}, args...)
123: }
124: 
125: // nftFlushSet flushes all elements from a set
126: func nftFlushSet(family, table, setName string) error {
127: 	_, err := runNft("flush", "set", family, table, setName)
128: 	return err
129: }
130: 
131: // nftListSet lists elements of a set
132: func nftListSet(family, table, setName string) (string, error) {
133: 	output, err := runNftFast("list", "set", family, table, setName)
134: 	return string(output), err
135: }
136: 
137: // nftListSetWithHandles lists elements of a set with handles (-a flag)
138: func nftListSetWithHandles(family, table, setName string) (string, error) {
139: 	output, err := runNftFast("-a", "list", "set", family, table, setName)
140: 	return string(output), err
141: }
142: 
143: // =============================================================================
144: // Batch Operations
145: // =============================================================================
146: 
147: // nftAddElementsBatch adds elements in batches to avoid argument list limits
148: // batchSize controls how many elements per nft command
149: func nftAddElementsBatch(family, table, setName string, elements []string, batchSize int) error {
150: 	if len(elements) == 0 {
151: 		return nil
152: 	}
153: 
154: 	if batchSize <= 0 {
155: 		batchSize = 1000 // default
156: 	}
157: 
158: 	for i := 0; i < len(elements); i += batchSize {
159: 		end := i + batchSize
160: 		if end > len(elements) {
161: 			end = len(elements)
162: 		}
163: 
164: 		batch := elements[i:end]
165: 		elemStr := "{ " + strings.Join(batch, ", ") + " }"
166: 
167: 		if err := nftAddElement(family, table, setName, elemStr); err != nil {
168: 			return fmt.Errorf("batch %d-%d failed: %w", i, end, err)
169: 		}
170: 	}
171: 
172: 	return nil
173: }
174: 
175: // nftDeleteElementsBatch deletes elements in batches
176: func nftDeleteElementsBatch(family, table, setName string, elements []string, batchSize int) error {
177: 	if len(elements) == 0 {
178: 		return nil
179: 	}
180: 
181: 	if batchSize <= 0 {
182: 		batchSize = 1000 // default
183: 	}
184: 
185: 	for i := 0; i < len(elements); i += batchSize {
186: 		end := i + batchSize
187: 		if end > len(elements) {
188: 			end = len(elements)
189: 		}
190: 
191: 		batch := elements[i:end]
192: 		elemStr := "{ " + strings.Join(batch, ", ") + " }"
193: 
194: 		if err := nftDeleteElement(family, table, setName, elemStr); err != nil {
195: 			return fmt.Errorf("batch %d-%d failed: %w", i, end, err)
196: 		}
197: 	}
198: 
199: 	return nil
200: }
201: 
202: // =============================================================================
203: // Family Helper
204: // =============================================================================
205: 
206: // nftFamily returns "ip" or "ip6" based on IPv4 flag
207: func nftFamily(ipv4 bool) string {
208: 	if ipv4 {
209: 		return "ip"
210: 	}
211: 	return "ip6"
212: }
213: 
214: //nolint:U1000 // Helper for nftables type determination
</file>


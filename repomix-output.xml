 685: nftban_watchdog_report() {
 686:     # Generate human-readable report
 687:     # Output: printed to stdout
 688: 
 689:     local sep="================================================================================"
 690: 
 691:     echo "$sep"
 692:     echo "NFTBan System Watchdog Report"
 693:     echo "Generated: ${WATCHDOG_RESULTS[check_datetime]:-$(date '+%Y-%m-%d %H:%M:%S')}"
 694:     echo "$sep"
 695:     echo ""
 696: 
 697:     # Load Average
 698:     if [[ -n "${WATCHDOG_RESULTS[load_1m]:-}" ]]; then
 699:         local load_status="${WATCHDOG_RESULTS[load_status]:-OK}"
 700:         local status_indicator="[OK]"
 701:         [[ "$load_status" == "WARNING" ]] && status_indicator="[WARNING]"
 702:         [[ "$load_status" == "CRITICAL" ]] && status_indicator="[CRITICAL]"
 703: 
 704:         echo "LOAD AVERAGE: ${status_indicator} ${WATCHDOG_RESULTS[load_avg_type]:-5}-min avg is ${WATCHDOG_RESULTS[load_checked]:-N/A}"
 705:         echo "  1 minute:  ${WATCHDOG_RESULTS[load_1m]}"
 706:         echo "  5 minute:  ${WATCHDOG_RESULTS[load_5m]}"
 707:         echo "  15 minute: ${WATCHDOG_RESULTS[load_15m]}"
 708:         echo "  Running:   ${WATCHDOG_RESULTS[procs_running]:-0} of ${WATCHDOG_RESULTS[procs_total]:-0} processes"
 709:         echo ""
 710:     fi
 711: 
 712:     # I/O Wait
 713:     if [[ -n "${WATCHDOG_RESULTS[cpu_iowait_percent]:-}" ]]; then
 714:         local iowait_status="${WATCHDOG_RESULTS[iowait_status]:-OK}"
 715:         local status_indicator="[OK]"
 716:         [[ "$iowait_status" == "WARNING" ]] && status_indicator="[WARNING]"
 717:         [[ "$iowait_status" == "CRITICAL" ]] && status_indicator="[CRITICAL]"
 718: 
 719:         echo "CPU: ${WATCHDOG_RESULTS[cpu_iowait_percent]}% I/O Wait ${status_indicator}"
 720:         echo "  User:     ${WATCHDOG_RESULTS[cpu_user_percent]}%"
 721:         echo "  System:   ${WATCHDOG_RESULTS[cpu_system_percent]}%"
 722:         echo "  Idle:     ${WATCHDOG_RESULTS[cpu_idle_percent]}%"
 723:         echo "  I/O Wait: ${WATCHDOG_RESULTS[cpu_iowait_percent]}%"
 724:         echo ""
 725:     fi
 726: 
 727:     # Memory
 728:     if [[ -n "${WATCHDOG_RESULTS[mem_used_percent]:-}" ]]; then
 729:         local mem_status="${WATCHDOG_RESULTS[mem_status]:-OK}"
 730:         local status_indicator="[OK]"
 731:         [[ "$mem_status" == "WARNING" ]] && status_indicator="[WARNING]"
 732:         [[ "$mem_status" == "CRITICAL" ]] && status_indicator="[CRITICAL]"
 733: 
 734:         echo "MEMORY: ${WATCHDOG_RESULTS[mem_used_percent]}% used ${status_indicator}"
 735:         echo "  Total:     ${WATCHDOG_RESULTS[mem_total_mb]} MB"
 736:         echo "  Used:      ${WATCHDOG_RESULTS[mem_used_mb]} MB"
 737:         echo "  Available: ${WATCHDOG_RESULTS[mem_available_mb]} MB"
 738:         echo "  Swap Used: ${WATCHDOG_RESULTS[swap_used_mb]} MB (${WATCHDOG_RESULTS[swap_used_percent]}%)"
 739:         echo ""
 740:     fi
 741: 
 742:     # Disk
 743:     if [[ -n "${WATCHDOG_RESULTS[disk_used_percent]:-}" ]]; then
 744:         local disk_status="${WATCHDOG_RESULTS[disk_status]:-OK}"
 745:         local status_indicator="[OK]"
 746:         [[ "$disk_status" == "WARNING" ]] && status_indicator="[WARNING]"
 747:         [[ "$disk_status" == "CRITICAL" ]] && status_indicator="[CRITICAL]"
 748: 
 749:         echo "DISK USAGE: ${status_indicator}"
 750:         echo "  ${WATCHDOG_RESULTS[disk_path]}: ${WATCHDOG_RESULTS[disk_used_percent]}% used (${WATCHDOG_RESULTS[disk_used_gb]}GB of ${WATCHDOG_RESULTS[disk_total_gb]}GB)"
 751:         echo ""
 752:     fi
 753: 
 754:     # File Descriptors
 755:     if [[ -n "${WATCHDOG_RESULTS[fd_allocated]:-}" ]]; then
 756:         local fd_status="${WATCHDOG_RESULTS[fd_status]:-OK}"
 757:         local status_indicator="[OK]"
 758:         [[ "$fd_status" == "WARNING" ]] && status_indicator="[WARNING]"
 759: 
 760:         echo "FILE DESCRIPTORS: ${status_indicator}"
 761:         echo "  Allocated: ${WATCHDOG_RESULTS[fd_allocated]} / ${WATCHDOG_RESULTS[fd_max]} (${WATCHDOG_RESULTS[fd_used_percent]}%)"
 762:         echo ""
 763:     fi
 764: 
 765:     # Top Processes by Memory
 766:     local top_mem_count="${WATCHDOG_RESULTS[top_mem_count]:-0}"
 767:     if [[ $top_mem_count -gt 0 ]]; then
 768:         echo "TOP PROCESSES BY MEMORY:"
 769:         printf "  %-8s %-15s %8s  %s\n" "PID" "COMMAND" "MEM(MB)" "MEM(KB)"
 770:         for ((i=0; i<top_mem_count && i<5; i++)); do
 771:             printf "  %-8s %-15s %8s  %s\n" \
 772:                 "${WATCHDOG_RESULTS[top_mem_${i}_pid]}" \
 773:                 "${WATCHDOG_RESULTS[top_mem_${i}_comm]}" \
 774:                 "${WATCHDOG_RESULTS[top_mem_${i}_mem_mb]}" \
 775:                 "${WATCHDOG_RESULTS[top_mem_${i}_mem_kb]}"
 776:         done
 777:         echo ""
 778:     fi
 779: 
 780:     # Alerts
 781:     if [[ ${#WATCHDOG_ALERTS[@]} -gt 0 ]]; then
 782:         echo "ALERTS TRIGGERED:"
 783:         for alert in "${WATCHDOG_ALERTS[@]}"; do
 784:             echo "  $alert"
 785:         done
 786:         echo ""
 787:     fi
 788: 
 789:     echo "$sep"
 790: }

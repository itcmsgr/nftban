153: # Apply GeoBan rules to nftables (minimal MVP implementation)
154: # Creates geoban_blocked_v4 set and geoban_input chain
155: nftban_geoban_apply_to_nftables() {
156:     local table="inet"
157:     local tname="nftban"
158:     local set_v4="geoban_blocked_v4"
159:     local _set_v6="geoban_blocked_v6"  # Reserved for future IPv6 support
160:     local chain="geoban_input"
161: 
162:     nftban_info "Applying GeoBan rules to nftables..."
163: 
164:     # Check if nftables is available
165:     if ! command -v nft &>/dev/null; then
166:         nftban_error "nft command not found"
167:         return 1
168:     fi
169: 
170:     # Check if table exists
171:     if ! nft list table "$table" "$tname" &>/dev/null; then
172:         nftban_error "Table $table $tname does not exist"
173:         nftban_info "Run: nft -f /etc/nftables.conf"
174:         return 1
175:     fi
176: 
177:     # 1. Ensure IPv4 set exists (should already exist from Phase 0)
178:     if ! nft list set "$table" "$tname" "$set_v4" &>/dev/null; then
179:         nftban_info "Creating set: $set_v4"
180:         nft add set "$table" "$tname" "$set_v4" '{ type ipv4_addr; flags interval; comment "GeoBan blocked countries (IPv4)"; }' || {
181:             nftban_error "Failed to create set $set_v4"
182:             return 1
183:         }
184:     fi
185: 
186:     # 2. Flush old contents
187:     nftban_info "Flushing old GeoBan entries..."
188:     nft flush set "$table" "$tname" "$set_v4" || {
189:         nftban_error "Failed to flush set $set_v4"
190:         return 1
191:     }
192: 
193:     # 3. Load all banned country CIDRs into set
194:     local ban_files=()
195:     mapfile -t ban_files < <(find "${GEOBAN_FILES_DIR}" -name "50-ban-*.conf" 2>/dev/null)
196: 
197:     if [[ ${#ban_files[@]} -eq 0 ]]; then
198:         nftban_warn "No banned country files found in ${GEOBAN_FILES_DIR}"
199:         nftban_info "GeoBan set is empty (no countries banned)"
200:         return 0
201:     fi
202: 
203:     nftban_info "Loading CIDRs from ${#ban_files[@]} country file(s)..."
204: 
205:     # Build CIDR list (all elements in ONE command for efficiency)
206:     # Separate IPv4 and IPv6 addresses
207:     local cidrs_v4=()
208:     local cidrs_v6=()
209:     local cidr_count_v4=0
210:     local cidr_count_v6=0
211: 
212:     for file in "${ban_files[@]}"; do
213:         while IFS= read -r line; do
214:             # Skip empty lines and comments
215:             [[ -z "$line" ]] && continue
216:             [[ "$line" =~ ^#.* ]] && continue
217: 
218:             # Check if IPv4 or IPv6
219:             if [[ "$line" =~ : ]]; then
220:                 # IPv6 (contains colons)
221:                 cidrs_v6+=("$line")
222:                 ((cidr_count_v6++))
223:             else
224:                 # IPv4 (no colons)
225:                 cidrs_v4+=("$line")
226:                 ((cidr_count_v4++))
227:             fi
228:         done < "$file"
229:     done
230: 
231:     local total_cidrs=$((cidr_count_v4 + cidr_count_v6))
232:     if [[ $total_cidrs -eq 0 ]]; then
233:         nftban_warn "No valid CIDRs found in ban files"
234:         return 0
235:     fi
236: 
237:     # Apply all elements in ONE command (much faster than individual adds)
238:     nftban_info "Adding $cidr_count_v4 IPv4 CIDRs to $set_v4..."
239: 
240:     # Build comma-separated list
241:     local cidr_list=""
242:     for cidr in "${cidrs_v4[@]}"; do
243:         cidr_list+="$cidr,"
244:     done
245:     cidr_list="${cidr_list%,}"  # Remove trailing comma
246: 
247:     # Single command: add element to geoban set (v0.7.3: uses unified blacklist)
248:     local nft_output
249:     nft_output=$(nft add element "$table" "$tname" "$set_v4" "{ $cidr_list }" 2>&1)
250:     local nft_exit=$?
251: 
252:     if [[ $nft_exit -eq 0 ]]; then
253:         nftban_success "Loaded $cidr_count_v4 CIDRs into $set_v4"
254:     else
255:         nftban_error "Failed to load CIDRs (nft command failed)"
256:         nftban_error "nft output: $nft_output"
257:         return 1
258:     fi
259: 
260:     # 4. Ensure geoban_input chain exists (priority filter-15)
261:     if ! nft list chain "$table" "$tname" "$chain" &>/dev/null; then
262:         nftban_info "Creating GeoBan input chain at priority filter-15..."
263:         nft add chain "$table" "$tname" "$chain" '{ type filter hook input priority filter - 15; policy accept; }' || {
264:             nftban_error "Failed to create chain $chain"
265:             return 1
266:         }
267:         nftban_success "Created chain: $chain"
268:     fi
269: 
270:     # 5. Ensure drop rule exists in geoban_input chain
271:     # Check if rule already exists (avoid duplicates)
272:     if nft list chain "$table" "$tname" "$chain" 2>/dev/null | grep -q "GeoBan blocked IPv4"; then
273:         nftban_info "GeoBan drop rule already exists"
274:     else
275:         nftban_info "Adding GeoBan drop rule..."
276:         nft add rule "$table" "$tname" "$chain" ip saddr "@$set_v4" drop comment "GeoBan blocked IPv4" || {
277:             nftban_error "Failed to add drop rule"
278:             return 1
279:         }
280:         nftban_success "Added drop rule to $chain"
281:     fi
282: 
283:     # 6. Summary
284:     echo ""
285:     nftban_success "GeoBan nftables integration complete!"
286:     nftban_info "Set: $set_v4 ($cidr_count CIDRs)"
287:     nftban_info "Chain: $chain (priority filter-15)"
288:     nftban_info "Rule: ip saddr @$set_v4 drop"
289:     echo ""
290:     nftban_info "GeoBan is now ACTIVELY BLOCKING at firewall level"
291:     nftban_info "Verify: nft list set $table $tname $set_v4"
292:     nftban_info "Verify: nft list chain $table $tname $chain"
293: 
294:     return 0
295: }

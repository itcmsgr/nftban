// meta:description="System overview page showing uptime, version, and resources"
// =============================================================================

package pages

import (
	"fmt"
	"github.com/itcmsgr/nftban/internal/ui"
)

// System renders the system overview page
templ System(data ui.SystemPageData) {
	@ui.LayoutWithNav("System", "system") {
		<!-- Page Header -->
		<div class="page-header">
			<h1 class="page-title">System Overview</h1>
			<button class="btn btn-primary" hx-get="/ui/frag/system-info" hx-target="#system-content" hx-swap="innerHTML">
				Refresh
			</button>
		</div>

		<div id="system-content" hx-get="/ui/frag/system-info" hx-trigger="every 10s" hx-swap="innerHTML">
			@SystemContentFragment(data)
		</div>
	}
}

// SystemContentFragment renders all system content sections
templ SystemContentFragment(data ui.SystemPageData) {
	<!-- Identity & NFTBan Info Row -->
	<div class="system-info-row">
		<!-- System Identity -->
		<div class="card">
			<div class="card-header">
				<span class="card-title">System Identity</span>
			</div>
			<div class="identity-grid">
				<div class="identity-item">
					<span class="identity-label">Hostname</span>
					<span class="identity-value">{ data.Hostname }</span>
				</div>
				<div class="identity-item">
					<span class="identity-label">OS</span>
					<span class="identity-value">{ data.OS }</span>
				</div>
				<div class="identity-item">
					<span class="identity-label">Kernel</span>
					<span class="identity-value">{ data.Kernel }</span>
				</div>
				<div class="identity-item">
					<span class="identity-label">Architecture</span>
					<span class="identity-value">{ data.Arch }</span>
				</div>
				<div class="identity-item">
					<span class="identity-label">Uptime</span>
					<span class="identity-value" id="system-uptime">{ data.Uptime }</span>
				</div>
				<div class="identity-item">
					<span class="identity-label">Boot Time</span>
					<span class="identity-value">{ data.BootTime }</span>
				</div>
			</div>
		</div>

		<!-- NFTBan Info -->
		<div class="card">
			<div class="card-header">
				<span class="card-title">NFTBan</span>
				<span class="badge badge-info">v{ data.NFTBanVersion }</span>
			</div>
			<div class="identity-grid">
				<div class="identity-item">
					<span class="identity-label">Version</span>
					<span class="identity-value">{ data.NFTBanVersion }</span>
				</div>
				<div class="identity-item">
					<span class="identity-label">Build</span>
					<span class="identity-value">{ data.NFTBanBuild }</span>
				</div>
				<div class="identity-item">
					<span class="identity-label">Commit</span>
					<span class="identity-value" style="font-family: monospace;">{ truncateCommit(data.NFTBanCommit) }</span>
				</div>
				<div class="identity-item">
					<span class="identity-label">PID</span>
					<span class="identity-value">{ intToStr(data.NFTBanPID) }</span>
				</div>
				<div class="identity-item">
					<span class="identity-label">CPU Usage</span>
					<span class="identity-value">{ fmt.Sprintf("%.1f%%", data.NFTBanCPU) }</span>
				</div>
				<div class="identity-item">
					<span class="identity-label">Memory</span>
					<span class="identity-value">{ fmt.Sprintf("%.1f MB", data.NFTBanMemMB) }</span>
				</div>
			</div>
		</div>
	</div>

	<!-- Resource Gauges -->
	<div class="resource-gauges-row">
		<!-- CPU -->
		<div class="card gauge-card">
			<div class="gauge-header">
				<span class="gauge-title">CPU</span>
				<span class={ "gauge-value", getResourceClass(data.CPU.UsagePercent) }>{ fmt.Sprintf("%.1f%%", data.CPU.UsagePercent) }</span>
			</div>
			<div class="gauge-bar">
				<div class={ "gauge-fill", getResourceClass(data.CPU.UsagePercent) } style={ fmt.Sprintf("width: %.0f%%", data.CPU.UsagePercent) }></div>
			</div>
			<div class="gauge-details">
				<div class="gauge-detail">
					<span>Model</span>
					<span>{ data.CPU.Model }</span>
				</div>
				<div class="gauge-detail">
					<span>Cores/Threads</span>
					<span>{ intToStr(data.CPU.Cores) } / { intToStr(data.CPU.Threads) }</span>
				</div>
				<div class="gauge-detail">
					<span>Frequency</span>
					<span>{ data.CPU.Frequency }</span>
				</div>
				<div class="gauge-detail">
					<span>Load Average</span>
					<span>{ fmt.Sprintf("%.2f / %.2f / %.2f", data.CPU.LoadAvg1, data.CPU.LoadAvg5, data.CPU.LoadAvg15) }</span>
				</div>
			</div>
		</div>

		<!-- Memory -->
		<div class="card gauge-card">
			<div class="gauge-header">
				<span class="gauge-title">Memory</span>
				<span class={ "gauge-value", getResourceClass(data.Memory.Percent) }>{ fmt.Sprintf("%.1f%%", data.Memory.Percent) }</span>
			</div>
			<div class="gauge-bar">
				<div class={ "gauge-fill", getResourceClass(data.Memory.Percent) } style={ fmt.Sprintf("width: %.0f%%", data.Memory.Percent) }></div>
			</div>
			<div class="gauge-details">
				<div class="gauge-detail">
					<span>Used / Total</span>
					<span>{ fmt.Sprintf("%.1f / %.1f GB", data.Memory.UsedGB, data.Memory.TotalGB) }</span>
				</div>
				<div class="gauge-detail">
					<span>Available</span>
					<span>{ fmt.Sprintf("%.1f GB", data.Memory.AvailableGB) }</span>
				</div>
				<div class="gauge-detail">
					<span>Free</span>
					<span>{ fmt.Sprintf("%.1f GB", data.Memory.FreeGB) }</span>
				</div>
				<div class="gauge-detail">
					<span>Swap</span>
					<span>{ fmt.Sprintf("%.1f / %.1f GB (%.0f%%)", data.Memory.SwapUsedGB, data.Memory.SwapTotalGB, data.Memory.SwapPercent) }</span>
				</div>
			</div>
		</div>

		<!-- Disk -->
		<div class="card gauge-card">
			<div class="gauge-header">
				<span class="gauge-title">Disk ({ data.Disk.Path })</span>
				<span class={ "gauge-value", getResourceClass(data.Disk.Percent) }>{ fmt.Sprintf("%.1f%%", data.Disk.Percent) }</span>
			</div>
			<div class="gauge-bar">
				<div class={ "gauge-fill", getResourceClass(data.Disk.Percent) } style={ fmt.Sprintf("width: %.0f%%", data.Disk.Percent) }></div>
			</div>
			<div class="gauge-details">
				<div class="gauge-detail">
					<span>Used / Total</span>
					<span>{ fmt.Sprintf("%.1f / %.1f GB", data.Disk.UsedGB, data.Disk.TotalGB) }</span>
				</div>
				<div class="gauge-detail">
					<span>Free</span>
					<span>{ fmt.Sprintf("%.1f GB", data.Disk.FreeGB) }</span>
				</div>
				<div class="gauge-detail">
					<span>Filesystem</span>
					<span>{ data.Disk.FSType }</span>
				</div>
				<div class="gauge-detail">
					<span>Inodes</span>
					<span>{ fmt.Sprintf("%d / %d", data.Disk.InodesUsed, data.Disk.InodesTotal) }</span>
				</div>
			</div>
		</div>
	</div>

	<!-- Services Table -->
	<div class="card" style="margin-top: 1.5rem;">
		<div class="card-header">
			<span class="card-title">NFTBan Services</span>
		</div>
		<table class="data-table">
			<thead>
				<tr>
					<th>Service</th>
					<th>Description</th>
					<th>Status</th>
					<th>PID</th>
					<th>Memory</th>
					<th>Uptime</th>
					<th>Action</th>
				</tr>
			</thead>
			<tbody>
				for _, svc := range data.Services {
					<tr>
						<td style="font-weight: 500;">{ svc.Name }</td>
						<td style="color: var(--text-muted);">{ svc.Description }</td>
						<td>
							<span class={ "badge", getServiceStatusBadge(svc.Status) }>{ svc.Status }</span>
						</td>
						<td style="font-family: monospace;">
							if svc.PID > 0 {
								{ intToStr(svc.PID) }
							} else {
								<span class="text-muted">-</span>
							}
						</td>
						<td>
							if svc.MemoryMB > 0 {
								{ fmt.Sprintf("%.1f MB", svc.MemoryMB) }
							} else {
								<span class="text-muted">-</span>
							}
						</td>
						<td style="color: var(--text-muted);">{ svc.Uptime }</td>
						<td>
							if svc.Status != "active" {
								<button
									class="btn btn-sm btn-primary"
									hx-post={ fmt.Sprintf("/ui/action/restart/%s", svc.Name) }
									hx-confirm={ fmt.Sprintf("Restart %s?", svc.Name) }
								>
									Restart
								</button>
							} else {
								<span class="text-muted">-</span>
							}
						</td>
					</tr>
				}
				if len(data.Services) == 0 {
					<tr>
						<td colspan="7" style="text-align: center; color: var(--text-muted);">No services found</td>
					</tr>
				}
			</tbody>
		</table>
	</div>

	<!-- Top Processes Table -->
	if len(data.TopProcesses) > 0 {
		<div class="card" style="margin-top: 1.5rem;">
			<div class="card-header">
				<span class="card-title">Top Processes</span>
			</div>
			<table class="data-table">
				<thead>
					<tr>
						<th>PID</th>
						<th>Process</th>
						<th>User</th>
						<th>CPU %</th>
						<th>MEM %</th>
						<th>Memory</th>
						<th>Status</th>
					</tr>
				</thead>
				<tbody>
					for _, proc := range data.TopProcesses {
						<tr>
							<td style="font-family: monospace;">{ intToStr(proc.PID) }</td>
							<td style="font-weight: 500;">{ proc.Name }</td>
							<td>{ proc.User }</td>
							<td class={ getResourceClass(proc.CPUPercent) }>{ fmt.Sprintf("%.1f%%", proc.CPUPercent) }</td>
							<td class={ getResourceClass(proc.MemPercent) }>{ fmt.Sprintf("%.1f%%", proc.MemPercent) }</td>
							<td>{ fmt.Sprintf("%.1f MB", proc.MemMB) }</td>
							<td>
								<span class={ "badge", getProcessStatusBadge(proc.Status) }>{ proc.Status }</span>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}

	<!-- Quick Commands -->
	<div class="card" style="margin-top: 1.5rem;">
		<div class="card-header">
			<span class="card-title">CLI Commands</span>
		</div>
		<div class="command-grid">
			<div class="command-item">
				<code>nftban status</code>
				<span>Show overall status</span>
			</div>
			<div class="command-item">
				<code>nftban --version</code>
				<span>Show version info</span>
			</div>
			<div class="command-item">
				<code>nftban health check</code>
				<span>Run health diagnostics</span>
			</div>
			<div class="command-item">
				<code>systemctl status nftban-*</code>
				<span>Check all services</span>
			</div>
			<div class="command-item">
				<code>journalctl -u nftban-core</code>
				<span>View service logs</span>
			</div>
			<div class="command-item">
				<code>nftban watchdog check</code>
				<span>Check system resources</span>
			</div>
		</div>
	</div>

	<!-- Uptime Counter Script -->
	<script>
		document.addEventListener('DOMContentLoaded', function() {
			startUptimeCounter('system-uptime', { fmt.Sprintf("%d", data.UptimeSeconds) });
		});
	</script>

	<style>
		.system-info-row {
			display: grid;
			grid-template-columns: repeat(2, 1fr);
			gap: 1.5rem;
			margin-bottom: 1.5rem;
		}
		@media (max-width: 1024px) {
			.system-info-row {
				grid-template-columns: 1fr;
			}
		}

		.identity-grid {
			display: grid;
			grid-template-columns: repeat(2, 1fr);
			gap: 0.75rem;
			padding: 0.5rem;
		}
		.identity-item {
			display: flex;
			justify-content: space-between;
			align-items: center;
			padding: 0.5rem;
			background: var(--bg-elevated);
			border-radius: 4px;
		}
		.identity-label {
			font-size: 0.8rem;
			color: var(--text-muted);
		}
		.identity-value {
			font-weight: 500;
		}

		.resource-gauges-row {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 1.5rem;
		}
		@media (max-width: 1024px) {
			.resource-gauges-row {
				grid-template-columns: 1fr;
			}
		}

		.gauge-card {
			padding: 1rem;
		}
		.gauge-header {
			display: flex;
			justify-content: space-between;
			align-items: center;
			margin-bottom: 0.75rem;
		}
		.gauge-title {
			font-weight: 600;
		}
		.gauge-value {
			font-size: 1.5rem;
			font-weight: 700;
			font-family: 'SF Mono', Monaco, monospace;
		}
		.gauge-value.safe { color: var(--accent-safe); }
		.gauge-value.warning { color: var(--accent-warning); }
		.gauge-value.danger { color: var(--accent-danger); }

		.gauge-bar {
			height: 8px;
			background: var(--bg-elevated);
			border-radius: 4px;
			overflow: hidden;
			margin-bottom: 1rem;
		}
		.gauge-fill {
			height: 100%;
			border-radius: 4px;
			transition: width 0.3s;
		}
		.gauge-fill.safe { background: var(--accent-safe); }
		.gauge-fill.warning { background: var(--accent-warning); }
		.gauge-fill.danger { background: var(--accent-danger); }

		.gauge-details {
			display: flex;
			flex-direction: column;
			gap: 0.5rem;
		}
		.gauge-detail {
			display: flex;
			justify-content: space-between;
			font-size: 0.85rem;
		}
		.gauge-detail span:first-child {
			color: var(--text-muted);
		}

		.command-grid {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 1rem;
			padding: 1rem;
		}
		@media (max-width: 1024px) {
			.command-grid {
				grid-template-columns: repeat(2, 1fr);
			}
		}
		@media (max-width: 768px) {
			.command-grid {
				grid-template-columns: 1fr;
			}
		}
		.command-item {
			display: flex;
			flex-direction: column;
			gap: 0.25rem;
		}
		.command-item code {
			background: var(--bg-elevated);
			padding: 0.5rem;
			border-radius: 4px;
			font-size: 0.85rem;
		}
		.command-item span {
			font-size: 0.8rem;
			color: var(--text-muted);
		}

		.text-muted {
			color: var(--text-muted);
		}
	</style>
}

// Helper functions
func truncateCommit(commit string) string {
	if len(commit) > 8 {
		return commit[:8]
	}
	return commit
}

func getServiceStatusBadge(status string) string {
	switch status {
	case "active":
		return "badge-success"
	case "inactive":
		return "badge-muted"
	case "failed":
		return "badge-danger"
	default:
		return "badge-warning"
	}
}

func getProcessStatusBadge(status string) string {
	switch status {
	case "running", "R":
		return "badge-success"
	case "sleeping", "S":
		return "badge-info"
	case "stopped", "T":
		return "badge-warning"
	case "zombie", "Z":
		return "badge-danger"
	default:
		return "badge-muted"
	}
}

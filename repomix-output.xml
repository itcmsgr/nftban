 25: 		"success": true,
 26: 		"data": map[string]interface{}{
 27: 			"ruleset":   strings.TrimSpace(output),
 28: 			"timestamp": time.Now().Unix(),
 29: 		},
 30: 	})
 31: }
 32: 
 33: // NFTablesValidateHandler validates the nftables hierarchy
 34: func NFTablesValidateHandler(w http.ResponseWriter, r *http.Request) {
 35: 	// Use nftban firewall validate with JSON output (architectural compliance)
 36: 	output, err := execNFTBanCommand("firewall", "validate", "--json")
 37: 	if err != nil {
 38: 		respondJSON(w, http.StatusOK, map[string]interface{}{
 39: 			"success": true,
 40: 			"data": map[string]interface{}{
 41: 				"valid":  false,
 42: 				"issues": []string{"Failed to validate nftables: " + err.Error()},
 43: 			},
 44: 		})
 45: 		return
 46: 	}
 47: 
 48: 	// Parse JSON output from nftban firewall validate
 49: 	var result map[string]interface{}
 50: 	if err := json.Unmarshal([]byte(output), &result); err != nil {
 51: 		// Fallback to manual validation if JSON parsing fails
 52: 		output, err = execNFTBanCommand("nftables", "list")
 53: 		if err != nil {
 54: 			respondJSON(w, http.StatusOK, map[string]interface{}{
 55: 				"success": true,
 56: 				"data": map[string]interface{}{
 57: 					"valid":  false,
 58: 					"issues": []string{"Failed to get nftables ruleset: " + err.Error()},
 59: 				},
 60: 			})
 61: 			return
 62: 		}
 63: 	} else {
 64: 		// Return the parsed JSON result directly
 65: 		respondJSON(w, http.StatusOK, map[string]interface{}{
 66: 			"success": true,
 67: 			"data":    result,
 68: 		})
 69: 		return
 70: 	}
 71: 
 72: 	ruleset := strings.TrimSpace(output)
 73: 	issues := []string{}
 74: 	warnings := []string{}
 75: 
 76: 	// Check if nftban tables exist (v0.7.3: ip nftban + ip6 nftban)
 77: 	hasIPv4Table := strings.Contains(ruleset, "table "+nftables.TableIPv4)
 78: 	hasIPv6Table := strings.Contains(ruleset, "table "+nftables.TableIPv6)
 79: 	hasOldInetTable := strings.Contains(ruleset, "table inet nftban")
 80: 
 81: 	if !hasIPv4Table && !hasIPv6Table && !hasOldInetTable {
 82: 		issues = append(issues, "NFTBan tables not found - NFTBan may not be properly initialized")
 83: 	} else if hasOldInetTable && !hasIPv4Table {
 84: 		warnings = append(warnings, "Old 'inet nftban' table detected - consider migrating to v0.7.3 dual-table architecture ("+nftables.TableIPv4+" + "+nftables.TableIPv6+")")
 85: 	} else if hasIPv4Table {
 86: 		// v0.7.3 architecture detected
 87: 		if !hasIPv6Table {
 88: 			warnings = append(warnings, "IPv4 table found but IPv6 table missing - IPv6 traffic not protected")
 89: 		}
 90: 	}
 91: 
 92: 	// Check for required chains
 93: 	requiredChains := []string{"input", "output", "forward"}
 94: 	for _, chain := range requiredChains {
 95: 		if !strings.Contains(ruleset, "chain "+chain) {
 96: 			warnings = append(warnings, "Chain '"+chain+"' not found in nftban table")
 97: 		}
 98: 	}
 99: 
100: 	// Check for nftban rules in other tables (bad practice)
101: 	lines := strings.Split(ruleset, "\n")
102: 	inNFTBanTable := false
103: 	currentTable := ""
104: 	for _, line := range lines {
105: 		line = strings.TrimSpace(line)
106: 		if strings.HasPrefix(line, "table ") {
107: 			if strings.Contains(line, "nftban") {
108: 				inNFTBanTable = true
109: 				currentTable = "nftban"
110: 			} else {
111: 				inNFTBanTable = false
112: 				if strings.Contains(line, "inet") {
113: 					parts := strings.Fields(line)
114: 					if len(parts) >= 3 {
115: 						currentTable = parts[2]
116: 					}
117: 				}
118: 			}
119: 		}
120: 		if !inNFTBanTable && currentTable != "" && currentTable != "nftban" {
121: 			if strings.Contains(line, "banned") || strings.Contains(line, "whitelist") || strings.Contains(line, "geoban") {
122: 				warnings = append(warnings, "NFTBan-related rule found in '"+currentTable+"' table - should be in nftban table only")
123: 			}
124: 		}
125: 	}
126: 
127: 	valid := len(issues) == 0
128: 
129: 	respondJSON(w, http.StatusOK, map[string]interface{}{
130: 		"success": true,
131: 		"data": map[string]interface{}{
132: 			"valid":    valid,
133: 			"issues":   issues,
134: 			"warnings": warnings,
135: 		},
136: 	})
137: }
138: 
139: // NFTablesSaveHandler saves the current nftables ruleset to a backup file
140: func NFTablesSaveHandler(w http.ResponseWriter, r *http.Request) {
141: 	var req struct {
142: 		Ruleset string `json:"ruleset"`
143: 	}
144: 
145: 	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
146: 		respondJSON(w, http.StatusBadRequest, ErrorResponse{Error: "Invalid request"})
147: 		return
148: 	}
149: 
150: 	// Save to backup file - use central config
151: 	configDir := getConfigDir()
152: 	backupPath := configDir + "/nftables.conf.backup"
153: 	timestamp := time.Now().Format("20060102_150405")
154: 	backupPathWithTime := configDir + "/backups/nftables_" + timestamp + ".conf"
155: 
156: 	// Create backups directory if it doesn't exist
157: 	os.MkdirAll(configDir+"/backups", 0755)
158: 
159: 	// Save with timestamp
160: 	if err := os.WriteFile(backupPathWithTime, []byte(req.Ruleset), 0644); err != nil {
161: 		log.Printf("[ERROR] Failed to save nftables backup: %v", err)
162: 		respondJSON(w, http.StatusInternalServerError, ErrorResponse{Error: "Failed to save backup: " + err.Error()})
163: 		return
164: 	}
165: 
166: 	// Also save to standard backup path
167: 	if err := os.WriteFile(backupPath, []byte(req.Ruleset), 0644); err != nil {
168: 		log.Printf("[WARN] Failed to save to standard backup path: %v", err)
169: 	}
170: 
171: 	respondJSON(w, http.StatusOK, map[string]interface{}{
172: 		"success": true,
173: 		"data": map[string]interface{}{
174: 			"path":      backupPathWithTime,
175: 			"timestamp": timestamp,
176: 		},
177: 	})
178: }

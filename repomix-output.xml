738: // parseFeedsConfig reads feeds.conf and extracts feed definitions
739: func parseFeedsConfig(configPath string) ([]FeedConfig, error) {
740: 	feedConfigs := []FeedConfig{}
741: 
742: 	// Read both .conf and .conf.local
743: 	configFiles := []string{configPath, configPath + ".local"}
744: 
745: 	// Maps to track feed properties
746: 	feedURLs := make(map[string]string)
747: 	feedEnabled := make(map[string]bool)
748: 	feedCategories := make(map[string]string)
749: 	feedDescriptions := make(map[string]string)
750: 
751: 	for _, cf := range configFiles {
752: 		content, err := os.ReadFile(cf)
753: 		if err != nil {
754: 			if cf == configPath {
755: 				return nil, fmt.Errorf("cannot read config file %s: %w", cf, err)
756: 			}
757: 			continue // .local file is optional
758: 		}
759: 
760: 		lines := strings.Split(string(content), "\n")
761: 		for _, line := range lines {
762: 			line = strings.TrimSpace(line)
763: 			if line == "" || strings.HasPrefix(line, "#") {
764: 				continue
765: 			}
766: 
767: 			// Parse FEED_<NAME>_<PROPERTY>="value"
768: 			if strings.HasPrefix(line, "FEED_") {
769: 				parts := strings.SplitN(line, "=", 2)
770: 				if len(parts) != 2 {
771: 					continue
772: 				}
773: 
774: 				varName := parts[0]
775: 				value := strings.Trim(parts[1], `"' `)
776: 
777: 				// Extract feed name and property
778: 				// FEED_SPAMHAUS_DROP_URL -> name=SPAMHAUS_DROP, property=URL
779: 				varName = strings.TrimPrefix(varName, "FEED_")
780: 
781: 				if strings.HasSuffix(varName, "_URL") {
782: 					feedName := strings.TrimSuffix(varName, "_URL")
783: 					feedURLs[feedName] = value
784: 				} else if strings.HasSuffix(varName, "_ENABLED") {
785: 					feedName := strings.TrimSuffix(varName, "_ENABLED")
786: 					feedEnabled[feedName] = (value == "true")
787: 				} else if strings.HasSuffix(varName, "_CATEGORY") {
788: 					feedName := strings.TrimSuffix(varName, "_CATEGORY")
789: 					feedCategories[feedName] = value
790: 				} else if strings.HasSuffix(varName, "_DESCRIPTION") {
791: 					feedName := strings.TrimSuffix(varName, "_DESCRIPTION")
792: 					feedDescriptions[feedName] = value
793: 				}
794: 			}
795: 		}
796: 	}
797: 
798: 	// Build feed configs from collected data
799: 	for name, url := range feedURLs {
800: 		fc := FeedConfig{
801: 			Name:        name,
802: 			URL:         url,
803: 			Enabled:     feedEnabled[name],
804: 			Category:    feedCategories[name],
805: 			Description: feedDescriptions[name],
806: 		}
807: 		if fc.Category == "" {
808: 			fc.Category = "other"
809: 		}
810: 		if fc.Description == "" {
811: 			fc.Description = "No description"
812: 		}
813: 		feedConfigs = append(feedConfigs, fc)
814: 	}
815: 
816: 	return feedConfigs, nil
817: }

293: func cmdFeedsLoad(feedsDir string, cfg *nftbanconf.Config) error {
294: 	// Check for privilege (root OR CAP_NET_ADMIN capability)
295: 	if err := checkPrivilege(); err != nil {
296: 		return err
297: 	}
298: 
299: 	fmt.Println(version.BannerWithEmoji("🔄", "Load Feeds"))
300: 	fmt.Println(strings.Repeat("=", 70))
301: 	fmt.Println()
302: 
303: 	// Step 1: Load all feeds
304: 	fmt.Println("Step 1: Loading feeds from disk...")
305: 	ipv4Set, ipv6Set, ipv4CIDRSet, ipv6CIDRSet, feedsInfo, err := feeds.LoadAllFeeds(feedsDir)
306: 	if err != nil {
307: 		return fmt.Errorf("failed to load feeds: %w", err)
308: 	}
309: 
310: 	if len(feedsInfo) == 0 {
311: 		fmt.Println("  ⚠️  No feeds found")
312: 		return nil
313: 	}
314: 
315: 	totalEntries := len(ipv4Set) + len(ipv4CIDRSet) + len(ipv6Set) + len(ipv6CIDRSet)
316: 
317: 	fmt.Printf("  ✅ Loaded %d feeds\n", len(feedsInfo))
318: 	fmt.Printf("  ✅ Total IPv4: %d IPs + %d CIDRs\n", len(ipv4Set), len(ipv4CIDRSet))
319: 	fmt.Printf("  ✅ Total IPv6: %d IPs + %d CIDRs\n", len(ipv6Set), len(ipv6CIDRSet))
320: 	fmt.Println()
321: 
322: 	// Warn about large feed sets
323: 	if totalEntries > 100000 {
324: 		fmt.Println("  ⚠️  WARNING: Large feed set detected!")
325: 		fmt.Printf("     Loading %d entries will take 30-60 seconds.\n", totalEntries)
326: 		fmt.Println("     After loading, 'nft list ruleset' will be VERY SLOW (60-90 sec).")
327: 		fmt.Println("     USE 'nft -t list ruleset' instead (terse mode - fast).")
328: 		fmt.Println()
329: 		fmt.Println("     See docs/FEEDS_PERFORMANCE.md for details.")
330: 		fmt.Println()
331: 	}
332: 
333: 	// Step 2: Initialize RuntimeState and load existing blacklists
334: 	fmt.Println("Step 2: Loading existing blacklists...")
335: 	_, _, configDir := getFeedsPaths(cfg)
336: 	state := runtime.NewRuntimeState(configDir)
337: 	if err := state.LoadWhitelists(); err != nil {
338: 		return fmt.Errorf("failed to load whitelists: %w", err)
339: 	}
340: 	if err := state.LoadBlacklists(); err != nil {
341: 		return fmt.Errorf("failed to load blacklists: %w", err)
342: 	}
343: 	fmt.Printf("  ✅ Loaded %d existing blacklist entries\n",
344: 		len(state.BlacklistIPv4)+len(state.BlacklistIPv6))
345: 	fmt.Println()
346: 
347: 	// Step 3: Create feeds sets in nftables
348: 	fmt.Println("Step 3: Getting blacklist sets from nftables...")
349: 	nft, err := sync.NewNFTManager()
350: 	if err != nil {
351: 		return fmt.Errorf("failed to create nftables manager: %w", err)
352: 	}
353: 	defer nft.Close()
354: 
355: 	// Get IPv4 table and blacklist set (v1.0 schema: all sources consolidated)
356: 	tableIPv4, err := nft.GetOrCreateTable(nftables.TableFamilyIPv4)
357: 	if err != nil {
358: 		return fmt.Errorf("failed to get IPv4 table: %w", err)
359: 	}
360: 
361: 	// Use blacklist_ipv4 set (consolidates: manual bans + feeds + geoban + countries)
362: 	blacklistIPv4Set, err := nft.GetOrCreateIntervalSet(tableIPv4, "blacklist_ipv4", true)
363: 	if err != nil {
364: 		return fmt.Errorf("failed to get blacklist_ipv4 set: %w", err)
365: 	}
366: 	fmt.Println("  ✅ Using blacklist_ipv4 set (consolidated architecture)")
367: 
368: 	// Get IPv6 table and blacklist set
369: 	tableIPv6, err := nft.GetOrCreateTable(nftables.TableFamilyIPv6)
370: 	if err != nil {
371: 		return fmt.Errorf("failed to get IPv6 table: %w", err)
372: 	}
373: 
374: 	// Use blacklist_ipv6 set (consolidates all sources)
375: 	blacklistIPv6Set, err := nft.GetOrCreateIntervalSet(tableIPv6, "blacklist_ipv6", false)
376: 	if err != nil {
377: 		return fmt.Errorf("failed to get blacklist_ipv6 set: %w", err)
378: 	}
379: 	fmt.Println("  ✅ Using blacklist_ipv6 set (consolidated architecture)")
380: 	fmt.Println()
381: 
382: 	// Step 4: Merge IPs and CIDRs into combined lists for blacklist (interval sets support both)
383: 	fmt.Println("Step 4: Merging feeds into blacklist...")
384: 
385: 	// Combine IPv4 IPs (as /32) and CIDRs into single list
386: 	var ipv4Combined []string
387: 	for ip := range ipv4Set {
388: 		ipv4Combined = append(ipv4Combined, ip+"/32") // Convert individual IPs to CIDR notation
389: 	}
390: 	for cidr := range ipv4CIDRSet {
391: 		ipv4Combined = append(ipv4Combined, cidr)
392: 	}
393: 
394: 	// Combine IPv6 IPs (as /128) and CIDRs into single list
395: 	var ipv6Combined []string

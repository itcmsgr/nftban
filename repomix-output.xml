2008: nftban_health_check_timers() {
2009:     # Check all NFTBan systemd timers (v0.7.3)
2010:     # Returns: 0=OK, 1=WARNING, 2=ERROR, 3=CRITICAL
2011:     # Args: $1 = auto_heal (0=check only, 1=auto-fix)
2012: 
2013:     local auto_heal="${1:-0}"
2014:     local status=$HEALTH_OK
2015:     local timer_issues=()
2016: 
2017:     # All NFTBan timers in priority order (REQUIRED for complete installation)
2018:     local -a timers=(
2019:         "nftban-maintenance.timer"      # CRITICAL: SSH/IP protection, auto-heal
2020:         "nftban-health.timer"           # Health checks
2021:         "nftban-core-feeds.timer"       # Threat feeds sync
2022:         "nftban-core-geoip.timer"       # GeoIP updates
2023:         "nftban-queue.timer"            # Ban queue processing
2024:         "nftban-watchdog.timer"         # System resource monitoring
2025:         "nftban-metrics-exporter.timer" # Prometheus metrics
2026:     )
2027: 
2028:     # Optional timers (only needed for specific features)
2029:     # Optional timers - reserved for future validation
2030:     # shellcheck disable=SC2034
2031:     local -a optional_timers=(
2032:         "nftban-suricata-update.timer"  # Suricata rules (needs suricata)
2033:         "nftban-snapshot.timer"         # Firewall snapshots
2034:         "nftban-rollback.timer"         # Auto-rollback checks
2035:     )
2036: 
2037:     local -A timer_desc=(
2038:         ["nftban-maintenance.timer"]="CRITICAL: SSH/IP lockout prevention, auto-heal"
2039:         ["nftban-health.timer"]="Health checks and auto-heal"
2040:         ["nftban-core-feeds.timer"]="Threat feeds sync"
2041:         ["nftban-core-geoip.timer"]="GeoIP database updates"
2042:         ["nftban-queue.timer"]="Ban queue processing"
2043:         ["nftban-watchdog.timer"]="System resource monitoring"
2044:         ["nftban-metrics-exporter.timer"]="Prometheus metrics collection"
2045:         ["nftban-suricata-update.timer"]="Suricata rules update (optional)"
2046:         ["nftban-snapshot.timer"]="Firewall snapshot creation (optional)"
2047:         ["nftban-rollback.timer"]="Auto-rollback checks (optional)"
2048:     )
2049: 
2050:     local total=0
2051:     local enabled=0
2052:     local active=0
2053:     local missing=0
2054:     local disabled=0
2055: 
2056:     # Check each timer
2057:     for timer in "${timers[@]}"; do
2058:         total=$((total + 1))
2059: 
2060:         # Check if timer unit file exists
2061:         if ! systemctl list-unit-files "$timer" --no-legend 2>/dev/null | grep -q "^$timer"; then
2062:             timer_issues+=("⚠ $timer not installed - ${timer_desc[$timer]}")
2063:             missing=$((missing + 1))
2064:             [[ $status -lt $HEALTH_WARNING ]] && status=$HEALTH_WARNING
2065: 
2066:             # Auto-heal: Try to install if from systemd directory
2067:             if [[ $auto_heal -eq 1 ]]; then
2068:                 local timer_file="/home/gituser/github/nftban-dev/install/systemd/$timer"
2069:                 if [[ -f "$timer_file" ]]; then
2070:                     echo "  🔧 Auto-heal: Installing $timer..."
2071:                     if cp "$timer_file" /etc/systemd/system/ 2>/dev/null && systemctl daemon-reload 2>/dev/null; then
2072:                         timer_issues+=("✓ Installed $timer")
2073:                     else
2074:                         timer_issues+=("❌ Failed to install $timer")
2075:                     fi
2076:                 fi
2077:             fi
2078:             continue
2079:         fi
2080: 
2081:         # Check if enabled
2082:         if systemctl is-enabled --quiet "$timer" 2>/dev/null; then
2083:             enabled=$((enabled + 1))
2084: 
2085:             # Check if active
2086:             if systemctl is-active --quiet "$timer" 2>/dev/null; then
2087:                 active=$((active + 1))
2088:                 timer_issues+=("✓ $timer - Active")
2089:             else
2090:                 timer_issues+=("⚠ $timer - Enabled but not active")
2091:                 [[ $status -lt $HEALTH_WARNING ]] && status=$HEALTH_WARNING
2092: 
2093:                 # Auto-heal: Start timer
2094:                 if [[ $auto_heal -eq 1 ]]; then
2095:                     echo "  🔧 Auto-heal: Starting $timer..."
2096:                     if systemctl start "$timer" 2>/dev/null; then
2097:                         timer_issues+=("✓ Started $timer")
2098:                     else
2099:                         timer_issues+=("❌ Failed to start $timer")
2100:                     fi
2101:                 fi
2102:             fi
2103:         else
2104:             disabled=$((disabled + 1))
2105:             timer_issues+=("⚠ $timer - Disabled (${timer_desc[$timer]})")
2106:             timer_issues+=("FIX: sudo systemctl enable --now $timer")
2107:             [[ $status -lt $HEALTH_ERROR ]] && status=$HEALTH_ERROR
2108: 
2109:             # Auto-heal: Enable and start timer
2110:             if [[ $auto_heal -eq 1 ]]; then
2111:                 echo "  🔧 Auto-heal: Enabling $timer..."
2112:                 if systemctl enable --now "$timer" 2>/dev/null; then
2113:                     timer_issues+=("✓ Enabled and started $timer")
2114:                     enabled=$((enabled + 1))
2115:                     active=$((active + 1))
2116:                     disabled=$((disabled - 1))
2117:                 else
2118:                     timer_issues+=("❌ Failed to enable $timer")
2119:                 fi
2120:             fi
2121:         fi
2122:     done
2123: 
2124:     # Summary
2125:     if [[ $active -eq $total ]]; then
2126:         timer_issues=("✓ All timers active ($active/$total)" "${timer_issues[@]}")
2127:     elif [[ $enabled -eq $total ]]; then
2128:         timer_issues=("⚠ All timers enabled but some not active ($active/$total active)" "${timer_issues[@]}")
2129:     elif [[ $disabled -gt 0 ]]; then
2130:         timer_issues=("⚠ $disabled/$total timers disabled" "${timer_issues[@]}")
2131:     fi
2132: 
2133:     if [[ $missing -gt 0 ]]; then
2134:         timer_issues+=("⚠ $missing/$total timers not installed")
2135:         timer_issues+=("FIX: Run install script - sudo ./install.sh systemd")
2136:     fi
2137: 
2138:     # Store results
2139:     NFTBAN_HEALTH_RESULTS["timers"]=$status
2140:     NFTBAN_HEALTH_ISSUES["timers"]="${timer_issues[*]}"
2141: 
2142:     return $status
2143: }

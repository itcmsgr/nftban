251: // AddSession increments active session count and starts sampling if needed
252: func (s *Sampler) AddSession() {
253: 	s.mu.Lock()
254: 	defer s.mu.Unlock()
255: 
256: 	s.activeSessions++
257: 	log.Printf("[METRICS] Session added (total: %d)", s.activeSessions)
258: 
259: 	// Start sampler if not running and we have sessions OR metrics enabled
260: 	if !s.running && (s.activeSessions > 0 || s.metricsEnabled) {
261: 		s.startLocked()
262: 	}
263: 
264: 	s.updateSessionCount()
265: }
266: 
267: // RemoveSession decrements active session count and stops sampling if needed
268: func (s *Sampler) RemoveSession() {
269: 	s.mu.Lock()
270: 	defer s.mu.Unlock()
271: 
272: 	if s.activeSessions > 0 {
273: 		s.activeSessions--
274: 		log.Printf("[METRICS] Session removed (total: %d)", s.activeSessions)
275: 	}
276: 
277: 	// Stop sampler if no sessions and metrics disabled
278: 	if s.running && s.activeSessions == 0 && !s.metricsEnabled {
279: 		s.stopLocked()
280: 	}
281: 
282: 	s.updateSessionCount()
283: }

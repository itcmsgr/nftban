  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - Metrics Management (Prometheus or VictoriaMetrics)
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Enable/disable metrics collection with choice of backend
  7: #
  8: # meta:name=cmd_metrics
  9: # meta:type=cli
 10: # meta:header=Metrics Management
 11: # meta:version=1.0.0
 12: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 13: # meta:homepage=https://nftban.com
 14: #
 15: # **Description & Purpose**
 16: # meta:description=Manage Prometheus or VictoriaMetrics collection independently from Web GUI
 17: # meta:input=Subcommands (enable, disable, status) with optional --backend flag
 18: # meta:output=Metrics stack status and configuration
 19: #
 20: # **Inventory & Requirements**
 21: # meta:depends=systemd,prometheus|victoriametrics,node-exporter,nftban-metrics-exporter
 22: #
 23: # meta:created_date=2025-11-28
 24: # meta:updated_date=2025-12-04
 25: # =============================================================================
 26: 
 27: set -Eeuo pipefail
 28: 
 29: [[ -z "${NFTBAN_LIB_DIR:-}" ]] && readonly NFTBAN_LIB_DIR="/usr/lib/nftban"
 30: readonly NFTBAN_CONFIG_DIR="${NFTBAN_CONFIG_DIR:-/etc/nftban}"
 31: 
 32: # Load main config for metrics endpoint addresses
 33: if [[ -f "${NFTBAN_CONFIG_DIR}/nftban.conf" ]]; then
 34:     # shellcheck source=/dev/null
 35:     source "${NFTBAN_CONFIG_DIR}/nftban.conf"
 36: fi
 37: 
 38: # Metrics endpoint defaults (use config or fallback)
 39: : "${NFTBAN_METRICS_PROMETHEUS_ADDR:=localhost:9090}"
 40: : "${NFTBAN_METRICS_NODE_EXPORTER_ADDR:=localhost:9100}"
 41: : "${NFTBAN_METRICS_VICTORIA_ADDR:=localhost:8428}"
 42: 
 43: # Load helper functions
 44: if [[ -f "${NFTBAN_LIB_DIR}/lib/nftban_distro.sh" ]]; then
 45:     source "${NFTBAN_LIB_DIR}/lib/nftban_distro.sh"
 46: fi
 47: 
 48: # Load shared metrics library
 49: if [[ -f "${NFTBAN_LIB_DIR}/lib/nftban_metrics.sh" ]]; then
 50:     source "${NFTBAN_LIB_DIR}/lib/nftban_metrics.sh"
 51: fi
 52: 
 53: # ==============================================================================
 54: # CONFLICT DETECTION FUNCTIONS
 55: # ==============================================================================
 56: 
 57: # Check if Prometheus is installed (service exists)
 58: _is_prometheus_installed() {
 59:     local prometheus_service
 60:     prometheus_service=$(nftban_distro_get_service prometheus 2>/dev/null || echo "prometheus")
 61: 
 62:     # Check if service file exists
 63:     if systemctl list-unit-files 2>/dev/null | grep -q "^${prometheus_service}.service"; then
 64:         return 0
 65:     fi
 66: 
 67:     # Check if binary exists
 68:     if [[ -f "/usr/bin/prometheus" ]] || [[ -f "/usr/local/bin/prometheus" ]]; then
 69:         return 0
 70:     fi
 71: 
 72:     return 1
 73: }
 74: 
 75: # Check if VictoriaMetrics is installed (service exists)
 76: _is_victoriametrics_installed() {
 77:     # Check if service file exists
 78:     if systemctl list-unit-files 2>/dev/null | grep -q "^victoriametrics.service"; then
 79:         return 0
 80:     fi
 81: 
 82:     # Check if binary exists
 83:     if [[ -f "/usr/local/bin/victoria-metrics-prod" ]] || [[ -f "/usr/bin/victoria-metrics-prod" ]]; then
 84:         return 0
 85:     fi
 86: 
 87:     return 1
 88: }
 89: 
 90: # Check if Prometheus is running
 91: _is_prometheus_running() {
 92:     local prometheus_service
 93:     prometheus_service=$(nftban_distro_get_service prometheus 2>/dev/null || echo "prometheus")
 94:     systemctl is-active "$prometheus_service" &>/dev/null
 95: }
 96: 
 97: # Check if VictoriaMetrics is running
 98: _is_victoriametrics_running() {
 99:     systemctl is-active victoriametrics &>/dev/null
100: }
101: 
102: # Detect conflict: both backends installed
103: _check_backend_conflict() {
104:     local prometheus_installed=false
105:     local victoriametrics_installed=false
106:     local prometheus_running=false
107:     local victoriametrics_running=false
108: 
109:     if _is_prometheus_installed; then
110:         prometheus_installed=true
111:         if _is_prometheus_running; then
112:             prometheus_running=true
113:         fi
114:     fi
115: 
116:     if _is_victoriametrics_installed; then
117:         victoriametrics_installed=true
118:         if _is_victoriametrics_running; then
119:             victoriametrics_running=true
120:         fi
121:     fi
122: 
123:     # Return status via global variables
124:     CONFLICT_PROMETHEUS_INSTALLED="$prometheus_installed"
125:     CONFLICT_VICTORIAMETRICS_INSTALLED="$victoriametrics_installed"
126:     CONFLICT_PROMETHEUS_RUNNING="$prometheus_running"
127:     CONFLICT_VICTORIAMETRICS_RUNNING="$victoriametrics_running"
128: 
129:     # Check for actual conflict (both running)
130:     if [[ "$prometheus_running" == "true" ]] && [[ "$victoriametrics_running" == "true" ]]; then
131:         return 1  # Conflict: both running
132:     fi
133: 
134:     return 0
135: }
136: 
137: # Display conflict warning and instructions
138: _show_conflict_warning() {
139:     local requested_backend="$1"
140:     local other_backend=""
141:     local other_service=""
142: 
143:     if [[ "$requested_backend" == "prometheus" ]]; then
144:         other_backend="VictoriaMetrics"
145:         other_service="victoriametrics"
146:     else
147:         other_backend="Prometheus"
148:         other_service=$(nftban_distro_get_service prometheus 2>/dev/null || echo "prometheus")
149:     fi
150: 
151:     echo ""
152:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
153:     echo "  ⚠️  METRICS BACKEND CONFLICT DETECTED"
154:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
155:     echo ""
156:     echo "  You requested: $requested_backend"
157:     echo "  Already running: $other_backend"
158:     echo ""
159:     echo "  NFTBan supports only ONE metrics backend at a time."
160:     echo "  Running both wastes resources and causes confusion."
161:     echo ""
162:     echo "  To switch to $requested_backend, first disable $other_backend:"
163:     echo ""
164:     echo "    # Stop $other_backend"
165:     echo "    sudo systemctl stop $other_service"
166:     echo "    sudo systemctl disable $other_service"
167:     echo ""
168:     echo "    # Then enable $requested_backend"
169:     echo "    nftban metrics enable --backend $requested_backend"
170:     echo ""
171:     echo "  Or use 'nftban metrics disable' to stop all metrics first."
172:     echo ""
173:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
174:     echo ""
175: }
176: 
177: # Show warning when both backends are installed (even if not both running)
178: _show_dual_install_warning() {
179:     local requested_backend="$1"
180:     local other_backend=""
181:     local other_service=""
182: 
183:     if [[ "$requested_backend" == "prometheus" ]]; then
184:         other_backend="VictoriaMetrics"
185:         other_service="victoriametrics"
186:     else
187:         other_backend="Prometheus"
188:         other_service=$(nftban_distro_get_service prometheus 2>/dev/null || echo "prometheus")
189:     fi
190: 
191:     echo ""
192:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
193:     echo "  ℹ️  NOTE: Both metrics backends are installed"
194:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
195:     echo ""

  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - Profile CLI Handler (Wizard Redirect)
  4: # =============================================================================
  5: #
  6: # SPDX-License-Identifier: MPL-2.0
  7: # Purpose: Redirect legacy 'nftban profile' command to interactive wizard
  8: #
  9: # meta:name=cmd_profile
 10: # meta:type=cli
 11: # meta:header=Profile CLI (Wizard Redirect)
 12: # meta:version=1.0.0
 13: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 14: # meta:homepage=https://nftban.com
 15: #
 16: # **Description & Purpose**
 17: # meta:description=CLI handler that redirects profile commands to wizard
 18: # meta:input=Command line arguments (select, apply, show, list, help)
 19: # meta:output=Redirects to wizard or shows current config
 20: #
 21: # **Note**
 22: # Static profiles have been replaced by an interactive wizard in v1.0.
 23: # The wizard detects your environment and asks 3 simple questions to
 24: # configure NFTBan optimally for your server.
 25: #
 26: # meta:created_date=2025-11-05
 27: # meta:updated_date=2025-12-05
 28: # =============================================================================
 29: 
 30: # Load strict mode library
 31: [[ -z "${NFTBAN_LIB_DIR:-}" ]] && readonly NFTBAN_LIB_DIR="/usr/lib/nftban"
 32: 
 33: # shellcheck source=/usr/lib/nftban/lib/strict.sh
 34: if [[ -f "${NFTBAN_LIB_DIR}/lib/strict.sh" ]]; then
 35:     source "${NFTBAN_LIB_DIR}/lib/strict.sh"
 36: else
 37:     set -Eeuo pipefail
 38: fi
 39: 
 40: # Load version library
 41: # shellcheck source=/usr/lib/nftban/lib/version.sh
 42: if [[ -f "${NFTBAN_LIB_DIR}/lib/version.sh" ]]; then
 43:     source "${NFTBAN_LIB_DIR}/lib/version.sh"
 44: fi
 45: 
 46: # =============================================================================
 47: # CONFIGURATION
 48: # =============================================================================
 49: 
 50: readonly NFTBAN_CONFIG_LOCAL="${NFTBAN_CONFIG_LOCAL:-/etc/nftban/nftban.conf.local}"
 51: readonly NFTBAN_CONFIG_MAIN="${NFTBAN_CONFIG_MAIN:-/etc/nftban/nftban.conf}"
 52: 
 53: # =============================================================================
 54: # BANNER
 55: # =============================================================================
 56: 
 57: _nftban_profile_banner() {
 58:     # Load output module for standard banner
 59:     if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_output.sh" ]]; then
 60:         source "${NFTBAN_LIB_DIR}/core/nftban_output.sh"
 61:         nftban_banner
 62:     else
 63:         echo "╔════════════════════════════════════════════════════════════╗"
 64:         echo "║  NFTBan - Enterprise Firewall Security                     ║"
 65:         echo "╚════════════════════════════════════════════════════════════╝"
 66:     fi
 67: }
 68: 
 69: # =============================================================================
 70: # DEPRECATION NOTICE
 71: # =============================================================================
 72: 
 73: _nftban_profile_deprecated_notice() {
 74:     echo ""
 75:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
 76:     echo "  📢 NOTICE: Static profiles replaced by Interactive Wizard"
 77:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
 78:     echo ""
 79:     echo "  In NFTBan v1.0, static profiles have been replaced with an"
 80:     echo "  interactive wizard that:"
 81:     echo ""
 82:     echo "    • Auto-detects your environment (CPU, RAM, ports)"
 83:     echo "    • Asks only 3 simple questions"
 84:     echo "    • Configures optimal settings for your server"
 85:     echo ""
 86:     echo "  Run the wizard:"
 87:     echo "    sudo nftban wizard"
 88:     echo ""
 89: }
 90: 
 91: # =============================================================================
 92: # SHOW CURRENT CONFIGURATION
 93: # =============================================================================
 94: 
 95: _nftban_profile_show() {
 96:     _nftban_profile_banner
 97:     echo ""
 98:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
 99:     echo "  📊 Current Configuration"
100:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
101:     echo ""
102: 
103:     # Check if wizard-generated config exists
104:     if [[ -f "$NFTBAN_CONFIG_LOCAL" ]]; then
105:         echo "Configuration file: $NFTBAN_CONFIG_LOCAL"
106:         echo ""
107: 
108:         # Show configured by
109:         if grep -q "^# Configured by: NFTBan Wizard" "$NFTBAN_CONFIG_LOCAL" 2>/dev/null; then
110:             echo "Configured by: NFTBan Wizard v1.0"
111:             local config_date
112:             config_date=$(grep "^# Timestamp:" "$NFTBAN_CONFIG_LOCAL" 2>/dev/null | cut -d':' -f2- | xargs || echo "Unknown")
113:             echo "Configured on: $config_date"
114:         else
115:             echo "Configured by: Manual configuration"
116:         fi
117: 
118:         echo ""
119:         echo "Key Settings:"
120: 
121:         # Extract settings from config
122:         local setting_value
123: 
124:         # Login Monitor
125:         if grep -q "^LOGIN_MONITOR_ENABLED=" "$NFTBAN_CONFIG_LOCAL" 2>/dev/null; then
126:             setting_value=$(grep "^LOGIN_MONITOR_ENABLED=" "$NFTBAN_CONFIG_LOCAL" | cut -d'"' -f2)
127:             echo "  Login Monitor: $setting_value"
128:         fi
129: 
130:         # DDoS Protection
131:         if grep -q "^DDOS_PROTECTION_ENABLED=" "$NFTBAN_CONFIG_LOCAL" 2>/dev/null; then
132:             setting_value=$(grep "^DDOS_PROTECTION_ENABLED=" "$NFTBAN_CONFIG_LOCAL" | cut -d'"' -f2)
133:             echo "  DDoS Protection: $setting_value"
134:         fi
135: 
136:         # Port Scan Detection
137:         if grep -q "^PORTSCAN_ENABLED=" "$NFTBAN_CONFIG_LOCAL" 2>/dev/null; then
138:             setting_value=$(grep "^PORTSCAN_ENABLED=" "$NFTBAN_CONFIG_LOCAL" | cut -d'"' -f2)
139:             echo "  Port Scan Detection: $setting_value"
140:         fi
141: 
142:         # Threat Feeds
143:         if grep -q "^FEEDS_ENABLED=" "$NFTBAN_CONFIG_LOCAL" 2>/dev/null; then
144:             setting_value=$(grep "^FEEDS_ENABLED=" "$NFTBAN_CONFIG_LOCAL" | cut -d'"' -f2)
145:             echo "  Threat Feeds: $setting_value"
146:             if [[ "$setting_value" == "yes" ]]; then
147:                 local enabled_feeds
148:                 enabled_feeds=$(grep "^FEEDS_ENABLED_LIST=" "$NFTBAN_CONFIG_LOCAL" 2>/dev/null | cut -d'"' -f2 || echo "")
149:                 [[ -n "$enabled_feeds" ]] && echo "  Enabled Feeds: $enabled_feeds"
150:             fi
151:         fi
152: 
153:         # Suricata IDS
154:         if grep -q "^SURICATA_ENABLED=" "$NFTBAN_CONFIG_LOCAL" 2>/dev/null; then
155:             setting_value=$(grep "^SURICATA_ENABLED=" "$NFTBAN_CONFIG_LOCAL" | cut -d'"' -f2)
156:             echo "  Suricata IDS: $setting_value"
157:         fi
158: 
159:         # Metrics Exporter
160:         if grep -q "^METRICS_EXPORTER_ENABLED=" "$NFTBAN_CONFIG_LOCAL" 2>/dev/null; then
161:             setting_value=$(grep "^METRICS_EXPORTER_ENABLED=" "$NFTBAN_CONFIG_LOCAL" | cut -d'"' -f2)
162:             echo "  Metrics Exporter: $setting_value"
163:         fi
164: 
165:         # Web UI
166:         if grep -q "^UI_ENABLED=" "$NFTBAN_CONFIG_LOCAL" 2>/dev/null; then
167:             setting_value=$(grep "^UI_ENABLED=" "$NFTBAN_CONFIG_LOCAL" | cut -d'"' -f2)
168:             echo "  Web UI: $setting_value"
169:         fi
170:     else
171:         echo "No configuration file found at: $NFTBAN_CONFIG_LOCAL"
172:         echo ""
173:         echo "Run the wizard to configure NFTBan:"
174:         echo "  sudo nftban wizard"
175:     fi
176: 
177:     echo ""
178:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
179:     echo ""
180:     echo "To reconfigure, run: sudo nftban wizard"
181:     echo ""
182: 
183:     return 0
184: }
185: 
186: # =============================================================================
187: # HELP TEXT
188: # =============================================================================
189: 
190: _nftban_profile_help() {
191:     _nftban_profile_banner
192:     _nftban_profile_deprecated_notice
193: 
194:     cat <<'HELP'
195: USAGE:
196:     nftban profile <command>
197: 
198: COMMANDS:
199:     show                Show current configuration
200:     help                Show this help message
201: 
202: DEPRECATED (use wizard instead):
203:     select              → Use: sudo nftban wizard
204:     apply <name>        → Use: sudo nftban wizard
205:     list                → Static profiles removed
206: 
207: MIGRATION TO WIZARD:
208: 
209:     The wizard replaces static profiles with an intelligent setup that:
210: 
211:     1. Detects your environment automatically:
212:        • CPU cores, RAM, disk space
213:        • Open ports (SSH, HTTP, HTTPS, Mail, Database)
214:        • Running services
215: 
216:     2. Asks 3 simple questions:
217:        • Security Level: minimal / basic / advanced
218:        • Traffic Level: low / medium / high
219:        • Optional Features: feeds, IDS, GUI, metrics
220: 
221:     3. Generates optimal configuration:
222:        • Creates /etc/nftban/nftban.conf.local
223:        • Enables appropriate modules
224:        • Suggests relevant threat feeds
225: 
226: RUN THE WIZARD:
227: 
228:     sudo nftban wizard
229: 
230: SEE ALSO:
231:     nftban wizard help       - Wizard help
232:     nftban ddos help         - DDoS protection help
233:     nftban portscan help     - Port scan detection help
234:     nftban login help        - Login monitor help
235:     nftban feeds help        - Threat feeds help
236: 
237: HELP
238: }
239: 
240: # =============================================================================
241: # REDIRECT TO WIZARD
242: # =============================================================================
243: 
244: _nftban_profile_redirect_to_wizard() {
245:     _nftban_profile_banner
246:     _nftban_profile_deprecated_notice
247: 
248:     # Check if wizard module exists
249:     local wizard_module="${NFTBAN_LIB_DIR}/cli/cmd_wizard.sh"
250:     if [[ -f "$wizard_module" ]]; then
251:         echo "Launching wizard..."
252:         echo ""
253: 
254:         # Source and run wizard
255:         # shellcheck source=/dev/null
256:         source "$wizard_module"
257:         cmd_wizard_install
258:     else
259:         echo "❌ ERROR: Wizard module not found"
260:         echo ""
261:         echo "Expected: $wizard_module"
262:         echo ""
263:         echo "Please reinstall NFTBan to get the wizard module."
264:         return 1
265:     fi
266: }
267: 
268: # =============================================================================
269: # MAIN COMMAND HANDLER
270: # =============================================================================
271: 
272: nftban_cmd_profile() {
273:     local action="${1:-show}"
274: 
275:     # Handle commands
276:     case "$action" in
277:         show)
278:             _nftban_profile_show
279:             ;;
280: 
281:         select|apply|list)
282:             # Redirect deprecated commands to wizard
283:             _nftban_profile_redirect_to_wizard
284:             ;;
285: 
286:         help|--help|-h)
287:             _nftban_profile_help
288:             ;;
289: 
290:         *)
291:             echo "ERROR: Unknown command: $action"
292:             echo ""
293:             echo "Available commands: show, help"
294:             echo ""
295:             echo "For configuration, use the wizard:"
296:             echo "  sudo nftban wizard"
297:             exit 1
298:             ;;
299:     esac
300: 
301:     return 0
302: }
303: 
304: # =============================================================================
305: # EXPORT FOR MAIN CLI
306: # =============================================================================
307: 
308: export -f nftban_cmd_profile
309: 
310: # Execute if called directly
311: if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
312:     nftban_cmd_profile "$@"
313: fi
</file>

<file path="cli/lib/nftban/cli/cmd_services.sh">
  1: #!/usr/bin/env bash
  2: 
  3: # =============================================================================
  4: 
  5: # Load JSON helper for --json support
  6: [[ -z "${NFTBAN_LIB_DIR:-}" ]] && readonly NFTBAN_LIB_DIR="/usr/lib/nftban"
  7: 
  8: # Load strict mode library
  9: # shellcheck source=/usr/lib/nftban/lib/strict.sh
 10: if [[ -f "${NFTBAN_LIB_DIR}/lib/strict.sh" ]]; then
 11:     source "${NFTBAN_LIB_DIR}/lib/strict.sh"
 12: else
 13:     # Fallback to manual strict mode
 14:     set -Eeuo pipefail
 15: fi
 16: 
 17: # Load version library
 18: # shellcheck source=/usr/lib/nftban/lib/version.sh
 19: if [[ -f "${NFTBAN_LIB_DIR}/lib/version.sh" ]]; then
 20:     source "${NFTBAN_LIB_DIR}/lib/version.sh"
 21: fi
 22: JSON_HELPER="${NFTBAN_LIB_DIR}/helpers/json_output.sh"
 23: if [[ -f "$JSON_HELPER" ]]; then
 24:     # shellcheck source=/dev/null
 25:     source "$JSON_HELPER"
 26: fi
 27: # NFTBan v1.0.0 - Services CLI Handler
 28: # =============================================================================
 29: 
 30: # SPDX-License-Identifier: MPL-2.0
 31: # Purpose: Handle services status CLI commands
 32: #
 33: # meta:name=cmd_services
 34: # meta:type=cli
 35: # meta:header=Services CLI Command
 36: # meta:version=1.0.0
 37: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 38: # meta:homepage=https://nftban.com
 39: #
 40: # **Description & Purpose**
 41: # meta:description=CLI interface for system services status reporting
 42: # meta:input=Output format, service management options
 43: # meta:output=Services status reports (terminal, HTML, mail)
 44: #
 45: # **Inventory & Requirements**
 46: # meta:depends=bash,nftban_report_services.sh
 47: #
 48: # meta:created_date=2025-11-05
 49: # meta:updated_date=2025-11-24
 50: # =============================================================================
 51: 
 52: 
 53: # Strict mode
 54: IFS=$'\n\t'
 55: umask 027
 56: 
 57: # Load dependencies
 58: SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
 59: LIB_DIR="$(dirname "$SCRIPT_DIR")"
 60: 
 61: # Load services report core module if not already loaded
 62: if [[ ! $(type -t nftban_report_services) == "function" ]]; then
 63:     if [[ -f "${LIB_DIR}/core/nftban_report_services.sh" ]]; then
 64:         # shellcheck source=/dev/null
 65:         source "${LIB_DIR}/core/nftban_report_services.sh"
 66:     else
 67:         echo "ERROR: nftban_report_services.sh not found at ${LIB_DIR}/core" >&2
 68:         exit 1
 69:     fi
 70: fi
 71: 
 72: # Load output module for rendering
 73: if [[ ! $(type -t nftban_render_banner) == "function" ]]; then
 74:     if [[ -f "${LIB_DIR}/core/nftban_output.sh" ]]; then
 75:         # shellcheck source=/dev/null
 76:         source "${LIB_DIR}/core/nftban_output.sh"
 77:     fi
 78: fi
 79: 
 80: # =============================================================================
 81: 
 82: # SERVICES COMMAND HANDLER
 83: # =============================================================================
 84: 
 85: 
 86: nftban_cmd_services() {
 87:     # Handle services subcommands
 88:     # Args: $@ = services subcommand and arguments
 89: 
 90:     local subcmd="${1:-status}"
 91:     local json_mode=false
 92: 
 93:     # Check for --json flag in arguments
 94:     for arg in "$@"; do
 95:         [[ "$arg" == "--json" ]] && json_mode=true && break
 96:     done
 97: 
 98:     shift || true
 99: 
100:     case "$subcmd" in
101:         status|list|detailed|"")
102:             # Show services status (terminal output - default detailed)
103:             # "list" is backwards compatible alias for "status"
104: 
105:             if [[ "$json_mode" == "true" ]]; then
106:                 nftban_report_services "json"
107:             else
108:                 # Show standard banner
109:                 nftban_banner
110:                 nftban_report_services "table"
111:             fi
112:             return $?
113:             ;;
114: 
115:         summary)
116:             # Show one-line summary
117:             nftban_report_services "summary"
118:             return $?
119:             ;;
120: 
121:         json|--json)
122:             # Show JSON output (backward compatibility)
123:             nftban_report_services "json"
124:             return $?
125:             ;;
126: 
127:         compact)
128:             # DEPRECATED: Use 'summary' instead
129:             nftban_report_services "summary"
130:             return $?
131:             ;;
132: 
133:         fix|start)
134:             # Auto-start stopped services
135:             nftban_services_fix
136:             return $?
137:             ;;
138: 
139:         check)
140:             # Check services and return exit code
141:             nftban_services_check_health
142:             return $?
143:             ;;
144: 
145:         help|--help|-h)
146:             nftban_services_show_help
147:             return 0
148:             ;;
149: 
150:         *)
151:             echo "ERROR: Unknown services subcommand: $subcmd" >&2
152:             echo "Run 'nftban services help' for usage information" >&2
153:             return 1
154:             ;;
155:     esac
156: }
157: 
158: # =============================================================================
159: 
160: # SERVICE MANAGEMENT FUNCTIONS
161: # =============================================================================
162: 
163: 
164: #
165: # nftban_services_fix - Auto-start stopped services
166: #
167: nftban_services_fix() {
168:     echo "════════════════════════════════════════════════════════════"
169:     echo "  Auto-Starting Services"
170:     echo "════════════════════════════════════════════════════════════"
171:     echo ""
172: 
173:     # Scan services first
174:     nftban_services_scan
175: 
176:     local fixed=0
177:     local failed=0
178: 
179:     # Try to start nftables
180:     if [[ -n "${NFTBAN_SERVICE_STATUS[nftables]:-}" ]]; then
181:         local info="${NFTBAN_SERVICE_STATUS[nftables]}"
182:         local status="${info%%|*}"
183: 
184:         if [[ "$status" != "RUNNING" ]]; then
185:             echo "Starting nftables service..."
186:             if systemctl start nftables.service 2>/dev/null; then
187:                 echo "  ✅ nftables started successfully"
188:                 fixed=$((fixed + 1))
189:             else
190:                 echo "  ❌ Failed to start nftables"
191:                 failed=$((failed + 1))
192:             fi
193:         else
194:             echo "✅ nftables already running"
195:         fi
196:     fi
197: 
198:     # Try to start fail2ban
199:     if [[ -n "${NFTBAN_SERVICE_STATUS[fail2ban]:-}" ]]; then
200:         local info="${NFTBAN_SERVICE_STATUS[fail2ban]}"
201:         local status="${info%%|*}"
202: 
203:         if [[ "$status" != "RUNNING" ]]; then
204:             echo "Starting fail2ban service..."
205:             if systemctl start fail2ban.service 2>/dev/null; then
206:                 echo "  ✅ fail2ban started successfully"
207:                 fixed=$((fixed + 1))
208:             else
209:                 echo "  ❌ Failed to start fail2ban"
210:                 failed=$((failed + 1))
211:             fi
212:         else
213:             echo "✅ fail2ban already running"
214:         fi
215:     fi
216: 
217:     echo ""
218:     echo "Summary: ${fixed} started, ${failed} failed"
219:     echo ""
220: 
221:     return 0
222: }
223: 
224: #
225: # nftban_services_check_health - Check services health (return code)
226: #
227: nftban_services_check_health() {
228:     # Scan services
229:     nftban_services_scan
230: 
231:     local issues=0
232: 
233:     # Check critical services
234:     for service_name in "nftables" "fail2ban"; do
235:         if [[ -n "${NFTBAN_SERVICE_STATUS[$service_name]:-}" ]]; then
236:             local info="${NFTBAN_SERVICE_STATUS[$service_name]}"
237:             local status="${info%%|*}"
238: 
239:             if [[ "$status" != "RUNNING" ]]; then
240:                 echo "⚠ $service_name is not running" >&2
241:                 issues=$((issues + 1))
242:             fi
243:         else
244:             echo "❌ $service_name not found" >&2
245:             issues=$((issues + 1))
246:         fi
247:     done
248: 
249:     if [[ $issues -eq 0 ]]; then
250:         echo "✅ All critical services are running"
251:         return 0
252:     else
253:         echo "❌ $issues service issues detected"
254:         return 1
255:     fi
256: }
257: 
258: #
259: # nftban_services_show_help - Show help message
260: #
261: nftban_services_show_help() {
262:     nftban_banner "services" 2>/dev/null || echo "NFTBan v1.0.0"
263:     echo ""
264:     echo "USAGE:"
265:     echo "    nftban services <command>"
266:     echo ""
267:     echo "COMMANDS:"
268:     echo "    [detailed]          Show all services status (default, FHS-style table)"
269:     echo "    summary             Show one-line summary"
270:     echo "    json                Show JSON output"
271:     echo "    fix                 Auto-start stopped services"
272:     echo "    check               Check services health (returns exit code)"
273:     echo "    help                Show this help message"
274:     echo ""
275:     echo "EXAMPLES:"
276:     echo "    nftban services                     # Show services status (FHS-style table)"
277:     echo "    nftban services summary             # Output: 'Services: 2/2 running, 4/4 tools'"
278:     echo "    nftban services json | jq .         # JSON output for parsing"
279:     echo "    nftban services fix                 # Start stopped services"
280:     echo "    nftban services check && echo OK    # Health check with exit code"
281:     echo ""
282:     echo "SERVICES MONITORED:"
283:     echo "    • nftables         Netfilter firewall (required)"
284:     echo "    • fail2ban         Intrusion prevention (required)"
285:     echo "    • golang           GeoIP features (optional)"
286:     echo "    • mailx            Email notifications (optional)"
287:     echo "    • curl             Feed downloads (required)"
288:     echo "    • jq               JSON processing (optional)"
289:     echo ""
290: }
291: 
292: # Export main function
293: export -f nftban_cmd_services
</file>


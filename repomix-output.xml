 750: // FeedsHandler returns ALL threat feeds (enabled and disabled) from CLI
 751: func FeedsHandler(w http.ResponseWriter, r *http.Request) {
 752: 	// Call CLI to get ALL feeds (enabled and disabled)
 753: 	output, err := execNFTBanCommand("feeds", "list")
 754: 	if err != nil {
 755: 		respondJSON(w, http.StatusOK, map[string]interface{}{
 756: 			"success": true,
 757: 			"data": map[string]interface{}{
 758: 				"feeds":     []interface{}{},
 759: 				"total":     0,
 760: 				"total_ips": 0,
 761: 			},
 762: 		})
 763: 		return
 764: 	}
 765: 
 766: 	// Parse CLI output to extract all feeds
 767: 	var feeds []map[string]interface{}
 768: 	totalIPs := 0
 769: 	feedsDir := getFeedsDir() // Use central config
 770: 
 771: 	lines := strings.Split(output, "\n")
 772: 	for _, line := range lines {
 773: 		// Look for feed lines: [✓] or [✗] FEED_NAME ...
 774: 		line = strings.TrimSpace(line)
 775: 		if !strings.Contains(line, "[✓]") && !strings.Contains(line, "[✗]") {
 776: 			continue
 777: 		}
 778: 		// Skip lines without actual feed content (enabled feeds show "enabled", disabled show "IPs (off)")
 779: 		if !strings.Contains(line, "enabled") && !strings.Contains(line, "IPs") {
 780: 			continue
 781: 		}
 782: 
 783: 		enabled := strings.Contains(line, "[✓]")
 784: 		// Remove box drawing chars and checkbox
 785: 		line = strings.ReplaceAll(line, "│", "")
 786: 		line = strings.ReplaceAll(line, "[✓]", "")
 787: 		line = strings.ReplaceAll(line, "[✗]", "")
 788: 		line = strings.TrimSpace(line)
 789: 
 790: 		// Parse: FEED_NAME enabled/disabled INTERVAL
 791: 		parts := strings.Fields(line)
 792: 		if len(parts) < 2 {
 793: 			continue
 794: 		}
 795: 
 796: 		feedName := parts[0]
 797: 		feedID := strings.ToLower(feedName)
 798: 		interval := "DAILY"
 799: 		if len(parts) >= 3 {
 800: 			interval = parts[2]
 801: 		}
 802: 
 803: 		// Count IPs if enabled (file exists)
 804: 		ipCount := 0
 805: 		lastUpdate := "-"
 806: 		if enabled {
 807: 			feedLower := strings.ToLower(feedID)  // Convert to lowercase
 808: 			filePath := filepath.Join(feedsDir, feedLower+".txt")
 809: 			ipCount = countLinesInFile(filePath)
 810: 			totalIPs += ipCount
 811: 			if info, err := os.Stat(filePath); err == nil {
 812: 				lastUpdate = info.ModTime().Format("2006-01-02 15:04")
 813: 			}
 814: 		}
 815: 
 816: 		feeds = append(feeds, map[string]interface{}{
 817: 			"id":              feedID,
 818: 			"name":            feedName,
 819: 			"enabled":         enabled,
 820: 			"ip_count":        ipCount,
 821: 			"last_update":     lastUpdate,
 822: 			"update_interval": interval,
 823: 		})
 824: 	}
 825: 
 826: 	respondJSON(w, http.StatusOK, map[string]interface{}{
 827: 		"success": true,
 828: 		"data": map[string]interface{}{
 829: 			"feeds":     feeds,
 830: 			"total":     len(feeds),
 831: 			"total_ips": totalIPs,
 832: 		},
 833: 	})
 834: }

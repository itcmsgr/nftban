 554:     local cmd_file="${NFTBAN_LIB_DIR}/cli/cmd_${cmd}.sh"
 555: 
 556:     # Special case: whitelist-system uses underscore in filename
 557:     if [[ "$cmd" == "whitelist-system" ]]; then

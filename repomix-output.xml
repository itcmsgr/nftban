145: nftban_health_cmd_check() {
146:     # Run comprehensive health check
147:     # Args: [--auto-heal] [--quiet] [--cache-status]
148: 
149:     local auto_heal=0
150:     local quiet=0
151:     local cache_status=0
152: 
153:     # Parse arguments
154:     while [[ $# -gt 0 ]]; do
155:         case "$1" in
156:             --auto-heal)
157:                 auto_heal=1
158:                 shift
159:                 ;;
160:             --quiet)
161:                 quiet=1
162:                 shift
163:                 ;;
164:             --cache-status)
165:                 # Write health status to cache for banner health indicator
166:                 cache_status=1
167:                 shift
168:                 ;;
169:             *)
170:                 echo "ERROR: Unknown option: $1" >&2
171:                 echo "Usage: nftban health check [--auto-heal] [--quiet] [--cache-status]" >&2
172:                 return 1
173:                 ;;
174:         esac
175:     done
176: 
177:     # Load health module if not already loaded
178:     if ! declare -f nftban_health_check_all >/dev/null 2>&1; then
179:         source "${NFTBAN_LIB_DIR}/core/nftban_health.sh" || {
180:             echo "ERROR: Failed to load health check module" >&2
181:             return 1
182:         }
183:     fi
184: 
185:     if [[ $quiet -eq 0 ]]; then
186:         # Show unified banner with health indicator
187:         if type -t nftban_banner >/dev/null 2>&1; then
188:             nftban_banner "health"
189:         fi
190:         echo "Running NFTBan system health check..."
191:         [[ $auto_heal -eq 1 ]] && echo "Auto-heal: ENABLED"
192:         echo ""
193:     fi
194: 
195:     # Run all checks (capture result immediately to avoid strict mode issues)
196:     local result=0
197:     nftban_health_check_all $auto_heal || result=$?
198: 
199:     # Write health status to cache file (for banner display)
200:     if [[ $cache_status -eq 1 ]]; then
201:         # Load output module for cache write function
202:         if ! declare -f nftban_health_cache_write >/dev/null 2>&1; then
203:             if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_output.sh" ]]; then
204:                 source "${NFTBAN_LIB_DIR}/core/nftban_output.sh" 2>/dev/null || true
205:             fi
206:         fi
207:         # Write cache (0=OK, 1=WARNING, 2=ERROR)
208:         if declare -f nftban_health_cache_write >/dev/null 2>&1; then
209:             nftban_health_cache_write "$result"
210:         else
211:             # Fallback: write directly
212:             local cache_dir="${NFTBAN_CACHE_DIR}/health"
213:             mkdir -p "$cache_dir" 2>/dev/null || true
214:             # Status codes: 0=OK, 1=WARNING, 2=ERROR, 3=SKIPPED, 4=NOT_INSTALLED
215:             case "$result" in
216:                 0|3|4) echo "OK" > "${cache_dir}/health_status.cache" ;;      # OK, SKIPPED, NOT_INSTALLED = OK for banner
217:                 1) echo "WARNING" > "${cache_dir}/health_status.cache" ;;
218:                 2) echo "ERROR" > "${cache_dir}/health_status.cache" ;;
219:                 *) echo "UNKNOWN" > "${cache_dir}/health_status.cache" ;;
220:             esac
221:             chmod 644 "${cache_dir}/health_status.cache" 2>/dev/null || true
222:         fi
223:     fi
224: 
225:     # Render results (unless quiet)
226:     if [[ $quiet -eq 0 ]]; then
227:         nftban_health_render_terminal
228:     else
229:         # In quiet mode, only show summary if there are issues
230:         if [[ $result -gt 0 ]]; then
231:             nftban_health_render_summary
232:         fi
233:     fi
234: 
235:     return $result
236: }

622: 	if err != nil {
623: 		return fmt.Errorf("failed to reload feeds: %w", err)
624: 	}
625: 
626: 	// Save new mod time
627: 	err = os.WriteFile(stateFile, []byte(fmt.Sprintf("%d", latestModTime)), 0644)
628: 	if err != nil {
629: 		// Non-fatal, just warn
630: 		fmt.Printf("⚠️  Warning: failed to update state file: %v\n", err)
631: 	}
632: 

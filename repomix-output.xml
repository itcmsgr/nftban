 92:         .grid-3 { grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); }
 93:         .grid-4 { grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
 94: 
 95:         .card {

261: // RuntimeSets holds current Fail2Ban state
262: type RuntimeSets struct {
263: 	Bans      *model.SetData
264: 	Whitelist *model.SetData
265: }
266: 
267: // dumpRuntimeSets reads current runtime sets (v0.7.3 unified architecture)
268: // v0.7.3: temp_whitelist in main tables, blacklist unified (permanent + temporary with timeout)
269: func dumpRuntimeSets() (*RuntimeSets, error) {
270: 	runtime := &RuntimeSets{
271: 		Bans:      model.NewSetData("runtime_bans"),
272: 		Whitelist: model.NewSetData("runtime_whitelist"),
273: 	}
274: 
275: 	// v0.7.3: Temporary bans are now in unified blacklist_ipv4/ipv6 with timeout
276: 	// NOTE: Cannot distinguish temp from permanent bans via nftables alone (both in same set)
277: 	// Temporary bans have timeout parameter, but nft list doesn't show which IPs have timeout
278: 	// Shell handles this via CLI commands that track metadata separately
279: 
280: 	// Dump temp_whitelist_ipv4 (v0.7.3: in main table ip nftban)
281: 	if ips, err := dumpSet(nftables.TableIPv4 + " temp_whitelist_ipv4"); err == nil {
282: 		for _, ip := range ips {
283: 			runtime.Whitelist.AddIPv4(ip)
284: 		}
285: 	}
286: 
287: 	// Dump temp_whitelist_ipv6 (v0.7.3: in main table ip6 nftban)
288: 	if ips, err := dumpSet(nftables.TableIPv6 + " temp_whitelist_ipv6"); err == nil {
289: 		for _, ip := range ips {
290: 			runtime.Whitelist.AddIPv6(ip)
291: 		}
292: 	}
293: 
294: 	return runtime, nil
295: }

1282: nftban_health_check_systemd_hardening() {
1283:     # Check systemd service hardening (NoNewPrivileges, security scores)
1284:     # Returns: 0=OK, 1=Warning, 2=Error, 3=Critical
1285:     #
1286:     # Checks:
1287:     # 1. NoNewPrivileges=false instances (privilege escalation risk)
1288:     # 2. systemd-analyze security scores for key services
1289: 
1290:     local status=$HEALTH_OK
1291:     local hardening_issues=()
1292: 
1293:     # =========================================================================
1294:     # CHECK 1: Scan all NFTBan systemd units for NoNewPrivileges=false
1295:     # =========================================================================
1296: 
1297:     local units_with_nnp_false=()
1298:     local systemd_unit_paths=(
1299:         "/etc/systemd/system"
1300:         "/usr/lib/systemd/system"
1301:         "/lib/systemd/system"
1302:     )
1303: 
1304:     # Find all nftban*.service files
1305:     local nftban_units=()
1306:     for unit_path in "${systemd_unit_paths[@]}"; do
1307:         if [[ -d "$unit_path" ]]; then
1308:             while IFS= read -r -d '' unit_file; do
1309:                 nftban_units+=("$unit_file")
1310:             done < <(find "$unit_path" -maxdepth 1 -name 'nftban*.service' -type f -print0 2>/dev/null)
1311:         fi
1312:     done
1313: 
1314:     # Scan each unit for NoNewPrivileges=false
1315:     for unit_file in "${nftban_units[@]}"; do
1316:         if grep -qE '^\s*NoNewPrivileges\s*=\s*false\s*$' "$unit_file" 2>/dev/null; then
1317:             local unit_name
1318:             unit_name=$(basename "$unit_file")
1319:             units_with_nnp_false+=("$unit_name")
1320:         fi
1321:     done
1322: 
1323:     # Report NoNewPrivileges=false findings
1324:     if [[ ${#units_with_nnp_false[@]} -gt 0 ]]; then
1325:         hardening_issues+=("CRITICAL: ${#units_with_nnp_false[@]} systemd service(s) have NoNewPrivileges=false")
1326:         hardening_issues+=("  └─ This allows privilege escalation via setuid/setcap executables")
1327:         for unit in "${units_with_nnp_false[@]}"; do
1328:             hardening_issues+=("  └─ $unit")
1329:         done
1330:         hardening_issues+=("  └─ FIX: Set NoNewPrivileges=yes in all units")
1331:         hardening_issues+=("  └─ See: /home/commonfolder/nftban2026/SECURITY_NONEWPRIVILEGES_FIX.md")
1332:         status=$HEALTH_CRITICAL
1333:     fi
1334: 
1335:     # =========================================================================
1336:     # CHECK 2: Run systemd-analyze security on key services
1337:     # =========================================================================
1338: 
1339:     if command -v systemd-analyze >/dev/null 2>&1; then
1340:         # Key security-sensitive services to check
1341:         local key_services=(
1342:             "nftban-maintenance.service"
1343:             "nftban-ui.service"
1344:             "nftband.service"
1345:         )
1346: 
1347:         local poor_scores=()
1348:         for service in "${key_services[@]}"; do
1349:             # Check if service exists
1350:             if systemctl list-unit-files "$service" &>/dev/null; then
1351:                 # Run systemd-analyze security (extract exposure score)
1352:                 local score_output
1353:                 score_output=$(systemd-analyze security "$service" 2>/dev/null | grep -E '^→ Overall exposure level:' | head -1)
1354: 
1355:                 if [[ -n "$score_output" ]]; then
1356:                     # Extract exposure level (SAFE, OK, MEDIUM, EXPOSED, UNSAFE)
1357:                     local exposure_level
1358:                     exposure_level=$(echo "$score_output" | awk '{print $NF}')
1359: 
1360:                     # Warn on EXPOSED or UNSAFE
1361:                     if [[ "$exposure_level" == "EXPOSED" || "$exposure_level" == "UNSAFE" ]]; then
1362:                         poor_scores+=("$service: $exposure_level")
1363:                     fi
1364:                 fi
1365:             fi
1366:         done
1367: 
1368:         if [[ ${#poor_scores[@]} -gt 0 ]]; then
1369:             hardening_issues+=("WARNING: ${#poor_scores[@]} service(s) have poor systemd security scores")
1370:             for score in "${poor_scores[@]}"; do
1371:                 hardening_issues+=("  └─ $score")
1372:             done
1373:             hardening_issues+=("  └─ Run: systemd-analyze security <service> for details")
1374:             [[ $status -lt $HEALTH_WARNING ]] && status=$HEALTH_WARNING
1375:         fi
1376:     fi
1377: 
1378:     # =========================================================================
1379:     # Store results
1380:     # =========================================================================
1381: 
1382:     if [[ ${#hardening_issues[@]} -gt 0 ]]; then
1383:         NFTBAN_HEALTH_ISSUES["systemd_hardening"]="${hardening_issues[*]}"
1384:         if [[ $status -eq $HEALTH_CRITICAL ]]; then
1385:             NFTBAN_HEALTH_ERRORS+=("CRITICAL systemd hardening issues: ${hardening_issues[*]}")
1386:         elif [[ $status -eq $HEALTH_ERROR ]]; then
1387:             NFTBAN_HEALTH_ERRORS+=("systemd hardening issues: ${hardening_issues[*]}")
1388:         elif [[ $status -eq $HEALTH_WARNING ]]; then
1389:             NFTBAN_HEALTH_WARNINGS+=("systemd hardening warnings: ${hardening_issues[*]}")
1390:         fi
1391:     fi
1392: 
1393:     NFTBAN_HEALTH_RESULTS["systemd_hardening"]=$status
1394:     return $status
1395: }

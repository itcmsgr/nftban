2865: #   - nftban health fix (during auto-heal)
2866: # =============================================================================
2867: 
2868: # NFTBan v1.0 simplified 2-group model
2869: NFTBAN_USER="nftban"
2870: NFTBAN_UID=${nftban_uid}
2871: NFTBAN_GROUP="nftban"
2872: NFTBAN_GID=${nftban_gid}
2873: NFTBAN_AUDITORS_GROUP="nftban-auditors"
2874: NFTBAN_AUDITORS_GID=${nftban_auditors_gid}
2875: EOF
2876: 
2877:         chown root:root "$system_conf"
2878:         chmod 0644 "$system_conf"
2879:         echo "  ✓ Updated $system_conf"
2880:         echo "    nftban UID=$nftban_uid GID=$nftban_gid"
2881:         if [[ "$nftban_auditors_gid" != "MISSING" ]]; then
2882:             echo "    nftban-auditors GID=$nftban_auditors_gid"
2883:         fi
2884:     else
2885:         echo "  ✓ System config is up to date"
2886:     fi
2887: 
2888:     # Fix logrotate configuration
2889:     echo ""
2890:     echo "Checking log rotation..."
2891:     local logrotate_src="${NFTBAN_LIB_DIR}/config/nftban.logrotate"
2892:     local logrotate_dst="/etc/logrotate.d/nftban"
2893: 
2894:     if [[ ! -f "$logrotate_dst" ]]; then
2895:         if [[ -f "$logrotate_src" ]]; then
2896:             cp "$logrotate_src" "$logrotate_dst" 2>/dev/null && {
2897:                 chown root:root "$logrotate_dst"
2898:                 chmod 0644 "$logrotate_dst"
2899:                 echo "  ✓ Installed logrotate config from $logrotate_src"
2900:             } || {
2901:                 echo "  ⚠️  Cannot copy logrotate config (need root)" >&2
2902:             }
2903:         else
2904:             # Create minimal logrotate config if source not found
2905:             cat > "$logrotate_dst" 2>/dev/null <<'LOGROTATE'

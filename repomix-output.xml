231: // loadIPFile loads IPs from a file (one per line, supports comments)
232: func loadIPFile(path string) (*model.SetData, error) {
233: 	file, err := os.Open(path)
234: 	if err != nil {
235: 		return nil, err
236: 	}
237: 	defer file.Close()
238: 
239: 	data := model.NewSetData(filepath.Base(path))
240: 	scanner := bufio.NewScanner(file)
241: 
242: 	for scanner.Scan() {
243: 		line := strings.TrimSpace(scanner.Text())
244: 		if line == "" || strings.HasPrefix(line, "#") {
245: 			continue
246: 		}
247: 
248: 		// Simple IP/CIDR detection
249: 		if strings.Contains(line, ":") {
250: 			// IPv6
251: 			data.AddIPv6(line)
252: 		} else {
253: 			// IPv4
254: 			data.AddIPv4(line)
255: 		}
256: 	}
257: 
258: 	return data, scanner.Err()
259: }

<file path="cli/lib/nftban/cli/cmd_timers.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBAN TIMERS MANAGEMENT COMMAND
  4: # =============================================================================
  5: # Purpose: Manage systemd timers for automated tasks
  6: # Version: 1.0.0
  7: # Created: 2025-11-28
  8: # =============================================================================
  9: 
 10: set -Eeuo pipefail
 11: 
 12: # Prevent double-loading
 13: [[ -n "${NFTBAN_CMD_TIMERS_LOADED:-}" ]] && return 0
 14: NFTBAN_CMD_TIMERS_LOADED="true"
 15: 
 16: # Load required modules
 17: # shellcheck source=/dev/null
 18: source "${NFTBAN_LIB_DIR}/core/nftban_output.sh"
 19: 
 20: # =============================================================================
 21: # CONFIGURATION
 22: # =============================================================================
 23: 
 24: # All NFTBan timers (in priority order)
 25: readonly NFTBAN_TIMERS=(
 26:     "nftban-health.timer"
 27:     "nftban-maintenance.timer"
 28:     "nftban-metrics-exporter.timer"
 29:     "nftban-core-geoip.timer"
 30:     "nftban-core-feeds.timer"
 31:     "nftban-queue.timer"
 32:     "nftban-suricata-update.timer"
 33:     "nftban-snapshot.timer"
 34:     "nftban-rollback.timer"
 35: )
 36: 
 37: # Timer descriptions
 38: declare -A TIMER_DESC=(
 39:     ["nftban-health.timer"]="System health checks and auto-heal"
 40:     ["nftban-maintenance.timer"]="SSH/IP monitoring, trend data (every 15m)"
 41:     ["nftban-metrics-exporter.timer"]="Metrics collection and export"
 42:     ["nftban-core-geoip.timer"]="GeoIP database updates"
 43:     ["nftban-core-feeds.timer"]="Threat feed synchronization"
 44:     ["nftban-queue.timer"]="Ban queue processing"
 45:     ["nftban-suricata-update.timer"]="Suricata IDS rules update"
 46:     ["nftban-snapshot.timer"]="Config/state snapshot creation"
 47:     ["nftban-rollback.timer"]="Rollback availability check"
 48: )
 49: 
 50: # =============================================================================
 51: # HELPER FUNCTIONS
 52: # =============================================================================
 53: 
 54: # Check if timer exists
 55: timer_exists() {
 56:     local timer="$1"
 57:     systemctl list-unit-files "$timer" --no-legend 2>/dev/null | grep -q "^$timer"
 58: }
 59: 
 60: # Check if timer is enabled
 61: timer_enabled() {
 62:     local timer="$1"
 63:     systemctl is-enabled --quiet "$timer" 2>/dev/null
 64: }
 65: 
 66: # Check if timer is active
 67: timer_active() {
 68:     local timer="$1"
 69:     systemctl is-active --quiet "$timer" 2>/dev/null
 70: }
 71: 
 72: # Get timer next run time
 73: timer_next_run() {
 74:     local timer="$1"
 75:     systemctl list-timers "$timer" --no-legend 2>/dev/null | awk '{print $1, $2}' || echo "N/A"
 76: }
 77: 
 78: # Get timer last trigger time
 79: timer_last_trigger() {
 80:     local timer="$1"
 81:     systemctl list-timers "$timer" --all --no-legend 2>/dev/null | awk '{print $3, $4}' || echo "N/A"
 82: }
 83: 
 84: # =============================================================================
 85: # COMMAND: STATUS
 86: # =============================================================================
 87: 
 88: cmd_timers_status() {
 89:     nftban_banner
 90: 
 91:     echo "🕐 SYSTEMD TIMERS STATUS"
 92:     echo "════════════════════════════════════════════════════════════════"
 93:     echo ""
 94: 
 95:     local total=0
 96:     local enabled=0
 97:     local active=0
 98:     local missing=0
 99: 
100:     for timer in "${NFTBAN_TIMERS[@]}"; do
101:         total=$((total + 1))
102: 
103:         if ! timer_exists "$timer"; then
104:             echo "  ❌ $timer"
105:             echo "     Description: ${TIMER_DESC[$timer]}"
106:             echo "     Status:      NOT INSTALLED"
107:             echo ""
108:             missing=$((missing + 1))
109:             continue
110:         fi
111: 
112:         local status_icon="⚪"
113:         local status_text="Inactive"
114: 
115:         if timer_enabled "$timer"; then
116:             enabled=$((enabled + 1))
117:             status_icon="✅"
118:             status_text="Enabled"
119: 
120:             if timer_active "$timer"; then
121:                 active=$((active + 1))
122:                 status_text="Enabled & Active"
123:             fi
124:         else
125:             status_icon="⚠️"
126:             status_text="Disabled"
127:         fi
128: 
129:         echo "  $status_icon $timer"
130:         echo "     Description: ${TIMER_DESC[$timer]}"
131:         echo "     Status:      $status_text"
132: 
133:         if timer_active "$timer"; then
134:             local next_run
135:             next_run=$(timer_next_run "$timer")
136:             local last_trigger
137:             last_trigger=$(timer_last_trigger "$timer")
138:             echo "     Next run:    $next_run"
139:             [[ "$last_trigger" != "N/A" && "$last_trigger" != "n/a" ]] && echo "     Last run:    $last_trigger"
140:         fi
141: 
142:         echo ""
143:     done
144: 
145:     echo "────────────────────────────────────────────────────────────────"
146:     echo "Summary:"
147:     echo "  Total timers:   $total"
148:     echo "  Enabled:        $enabled/$total"
149:     echo "  Active:         $active/$total"
150:     [[ $missing -gt 0 ]] && echo "  Missing:        $missing/$total"
151:     echo ""
152: 
153:     if [[ $enabled -lt $total ]]; then
154:         echo "💡 To enable all timers:"
155:         echo "   nftban timers enable"
156:         echo ""
157:     fi
158: 
159:     return 0
160: }
161: 
162: # =============================================================================
163: # COMMAND: ENABLE
164: # =============================================================================
165: 
166: cmd_timers_enable() {
167:     local timer_name="${1:-}"
168: 
169:     nftban_banner
170: 
171:     echo "🔧 ENABLE SYSTEMD TIMERS"
172:     echo "════════════════════════════════════════════════════════════════"
173:     echo ""
174: 
175:     # Enable specific timer
176:     if [[ -n "$timer_name" ]]; then
177:         if ! timer_exists "$timer_name"; then
178:             echo "❌ Error: Timer '$timer_name' not found"
179:             echo ""
180:             echo "Available timers:"
181:             for t in "${NFTBAN_TIMERS[@]}"; do
182:                 timer_exists "$t" && echo "  - $t"
183:             done
184:             return 1
185:         fi
186: 
187:         if timer_enabled "$timer_name"; then
188:             echo "✅ $timer_name is already enabled"
189:             return 0
190:         fi
191: 
192:         echo "Enabling $timer_name..."
193:         if systemctl enable --now "$timer_name" 2>/dev/null; then
194:             echo "✅ Successfully enabled $timer_name"
195:         else
196:             echo "❌ Failed to enable $timer_name"
197:             return 1
198:         fi
199: 
200:         return 0
201:     fi
202: 
203:     # Enable all timers
204:     local success=0
205:     local failed=0
206:     local skipped=0
207: 
208:     for timer in "${NFTBAN_TIMERS[@]}"; do
209:         if ! timer_exists "$timer"; then
210:             echo "⚪ $timer - Not installed (skipping)"
211:             skipped=$((skipped + 1))
212:             continue
213:         fi
214: 
215:         if timer_enabled "$timer"; then
216:             echo "✅ $timer - Already enabled"
217:             success=$((success + 1))
218:             continue
219:         fi
220: 
221:         echo "🔧 Enabling $timer..."
222:         if systemctl enable --now "$timer" 2>/dev/null; then
223:             echo "   ✅ Success"
224:             success=$((success + 1))
225:         else
226:             echo "   ❌ Failed"
227:             failed=$((failed + 1))
228:         fi
229:     done
230: 
231:     echo ""
232:     echo "────────────────────────────────────────────────────────────────"
233:     echo "Summary:"
234:     echo "  Enabled:  $success"
235:     [[ $failed -gt 0 ]] && echo "  Failed:   $failed"
236:     [[ $skipped -gt 0 ]] && echo "  Skipped:  $skipped"
237:     echo ""
238: 
239:     [[ $failed -eq 0 ]]
240: }
241: 
242: # =============================================================================
243: # COMMAND: DISABLE
244: # =============================================================================
245: 
246: cmd_timers_disable() {
247:     local timer_name="${1:-}"
248: 
249:     nftban_banner
250: 
251:     echo "🔧 DISABLE SYSTEMD TIMERS"
252:     echo "════════════════════════════════════════════════════════════════"
253:     echo ""
254: 
255:     # Disable specific timer
256:     if [[ -n "$timer_name" ]]; then
257:         if ! timer_exists "$timer_name"; then
258:             echo "❌ Error: Timer '$timer_name' not found"
259:             return 1
260:         fi
261: 
262:         if ! timer_enabled "$timer_name"; then
263:             echo "✅ $timer_name is already disabled"
264:             return 0
265:         fi
266: 
267:         echo "⚠️  WARNING: Disabling $timer_name"
268:         echo "   This will stop automated: ${TIMER_DESC[$timer_name]}"
269:         echo ""
270:         read -p "Continue? [y/N] " -n 1 -r
271:         echo
272: 
273:         if [[ ! $REPLY =~ ^[Yy]$ ]]; then
274:             echo "Cancelled"
275:             return 0
276:         fi
277: 
278:         echo "Disabling $timer_name..."
279:         if systemctl disable --now "$timer_name" 2>/dev/null; then
280:             echo "✅ Successfully disabled $timer_name"
281:         else
282:             echo "❌ Failed to disable $timer_name"
283:             return 1
284:         fi
285: 
286:         return 0
287:     fi
288: 
289:     # Disable all timers
290:     echo "⚠️  WARNING: This will disable ALL automated tasks:"
291:     for timer in "${NFTBAN_TIMERS[@]}"; do
292:         echo "   - ${TIMER_DESC[$timer]}"
293:     done
294:     echo ""
295:     read -p "Are you sure? [y/N] " -n 1 -r
296:     echo
297: 
298:     if [[ ! $REPLY =~ ^[Yy]$ ]]; then
299:         echo "Cancelled"
300:         return 0
301:     fi
302: 
303:     local success=0
304:     local failed=0
305: 
306:     for timer in "${NFTBAN_TIMERS[@]}"; do
307:         if ! timer_exists "$timer"; then
308:             continue
309:         fi
310: 
311:         if ! timer_enabled "$timer"; then
312:             echo "⚪ $timer - Already disabled"
313:             continue
314:         fi
315: 
316:         echo "🔧 Disabling $timer..."
317:         if systemctl disable --now "$timer" 2>/dev/null; then
318:             echo "   ✅ Success"
319:             success=$((success + 1))
320:         else
321:             echo "   ❌ Failed"
322:             failed=$((failed + 1))
323:         fi
324:     done
325: 
326:     echo ""
327:     echo "────────────────────────────────────────────────────────────────"
328:     echo "Summary:"
329:     echo "  Disabled: $success"
330:     [[ $failed -gt 0 ]] && echo "  Failed:   $failed"
331:     echo ""
332: 
333:     [[ $failed -eq 0 ]]
334: }
335: 
336: # =============================================================================
337: # COMMAND: MAIN ROUTER
338: # =============================================================================
339: 
340: nftban_cmd_timers() {
341:     local subcommand="${1:-status}"
342:     shift || true
343: 
344:     case "$subcommand" in
345:         status)
346:             cmd_timers_status "$@"
347:             ;;
348:         enable)
349:             cmd_timers_enable "$@"
350:             ;;
351:         disable)
352:             cmd_timers_disable "$@"
353:             ;;
354:         help|--help|-h)
355:             cat << 'EOF'
356: Usage: nftban timers <subcommand> [options]
357: 
358: Manage systemd timers for automated NFTBan tasks.
359: 
360: SUBCOMMANDS:
361:   status              Show status of all timers (default)
362:   enable [TIMER]      Enable timer(s) - all if no timer specified
363:   disable [TIMER]     Disable timer(s) - all if no timer specified
364:   help                Show this help message
365: 
366: TIMERS:
367:   nftban-health.timer              System health checks and auto-heal
368:   nftban-maintenance.timer         SSH/IP monitoring, trend data (every 15m)
369:   nftban-metrics-exporter.timer    Metrics collection and export
370:   nftban-core-geoip.timer          GeoIP database updates
371:   nftban-core-feeds.timer          Threat feed synchronization
372:   nftban-queue.timer               Ban queue processing
373:   nftban-suricata-update.timer     Suricata IDS rules update
374:   nftban-snapshot.timer            Config/state snapshot creation
375:   nftban-rollback.timer            Rollback availability check
376: 
377: EXAMPLES:
378:   nftban timers                         # Show status
379:   nftban timers status                  # Show status (explicit)
380:   nftban timers enable                  # Enable all timers
381:   nftban timers enable nftban-health.timer    # Enable specific timer
382:   nftban timers disable nftban-queue.timer    # Disable specific timer
383: 
384: EOF
385:             ;;
386:         *)
387:             echo "Error: Unknown subcommand '$subcommand'" >&2
388:             echo "Run 'nftban timers help' for usage" >&2
389:             return 1
390:             ;;
391:     esac
392: }
393: 
394: # Backwards compatibility alias
395: cmd_timers() {
396:     nftban_cmd_timers "$@"
397: }
398: 
399: # Export functions
400: export -f nftban_cmd_timers
401: export -f cmd_timers
402: 
403: return 0 2>/dev/null || :
</file>

<file path="cli/lib/nftban/cli/cmd_unban.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - Unban Command
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Unban IP addresses using nftban-core
  7: #
  8: # meta:name=cmd_unban
  9: # meta:type=cli
 10: # meta:header=Unban Command
 11: # meta:version=1.0.0
 12: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 13: # meta:homepage=https://nftban.com
 14: #
 15: # **Description & Purpose**
 16: # meta:description=Unban IP addresses using nftban-core
 17: # meta:input=IP address
 18: # meta:output=Unban confirmation or error message
 19: #
 20: # **Inventory & Requirements**
 21: # meta:depends=bash,nftban-core
 22: #
 23: # meta:created_date=2025-11-24
 24: # meta:updated_date=2025-11-26
 25: # =============================================================================
 26: 
 27: set -Eeuo pipefail
 28: 
 29: # Source central config for canonical paths (NO HARDCODED FALLBACKS)
 30: # shellcheck source=/etc/nftban/nftban.conf
 31: [[ -f "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf" ]] && source "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf"
 32: 
 33: [[ -z "${NFTBAN_LIB_DIR:-}" ]] && readonly NFTBAN_LIB_DIR="/usr/lib/nftban"
 34: readonly NFTBAN_CORE="${NFTBAN_LIB_DIR}/bin/nftban-core"
 35: 
 36: # Prevent double-loading
 37: [[ -n "${CMD_UNBAN_LOADED:-}" ]] && return 0
 38: readonly CMD_UNBAN_LOADED=1
 39: 
 40: # =============================================================================
 41: # COMMAND HANDLER
 42: # =============================================================================
 43: 
 44: nftban_cmd_unban() {
 45:     # Unban an IP address using nftban-core
 46:     # Usage: nftban unban <ip> [--json]
 47: 
 48:     local ip=""
 49:     local json_mode=false
 50: 
 51:     # Parse arguments first to detect JSON mode
 52:     local args=("$@")
 53:     for arg in "${args[@]}"; do
 54:         [[ "$arg" == "--json" ]] && json_mode=true
 55:     done
 56: 
 57:     # NOTE: No banner here - nftban-core displays its own banner
 58:     # This avoids duplicate banners when delegating to the Go binary
 59: 
 60:     # Load JSON helper
 61:     if [[ -f "${NFTBAN_LIB_DIR}/helpers/json_output.sh" ]]; then
 62:         # shellcheck source=/dev/null
 63:         source "${NFTBAN_LIB_DIR}/helpers/json_output.sh"
 64:     fi
 65: 
 66:     # Parse arguments
 67:     while [[ $# -gt 0 ]]; do
 68:         case "$1" in
 69:             help|--help|-h)
 70:                 nftban_cmd_unban_usage
 71:                 return 0
 72:                 ;;
 73:             --json)
 74:                 json_mode=true
 75:                 shift
 76:                 ;;
 77:             -*)
 78:                 if [[ "$json_mode" == "true" ]] && declare -f json_output >/dev/null 2>&1; then
 79:                     json_output "false" '{}' "Unknown option: $1"
 80:                 else
 81:                     echo "ERROR: Unknown option: $1" >&2
 82:                     nftban_cmd_unban_usage
 83:                 fi
 84:                 return 1
 85:                 ;;
 86:             *)
 87:                 if [[ -z "$ip" ]]; then
 88:                     ip="$1"
 89:                     shift
 90:                 else
 91:                     if [[ "$json_mode" == "true" ]] && declare -f json_output >/dev/null 2>&1; then
 92:                         json_output "false" '{}' "Multiple IP addresses not supported"
 93:                     else
 94:                         echo "ERROR: Multiple IP addresses not supported" >&2
 95:                     fi
 96:                     return 1
 97:                 fi
 98:                 ;;
 99:         esac
100:     done
101: 
102:     # Validate required arguments
103:     if [[ -z "$ip" ]]; then
104:         if [[ "$json_mode" == "true" ]] && declare -f json_output >/dev/null 2>&1; then
105:             json_output "false" '{}' "IP address is required"
106:         else
107:             echo "ERROR: IP address is required" >&2
108:             echo "" >&2
109:             nftban_cmd_unban_usage
110:         fi
111:         return 1
112:     fi
113: 
114:     # Check if nftban-core exists (required for unban command)
115:     if [[ ! -x "$NFTBAN_CORE" ]]; then
116:         if [[ "$json_mode" == "true" ]] && declare -f json_output >/dev/null 2>&1; then
117:             json_output "false" '{}' "nftban-core binary not found - CLI-only mode"
118:         else
119:             echo "ERROR: nftban-core binary not found" >&2
120:             echo "" >&2
121:             echo "The 'unban' command requires the nftban-core Go binary." >&2
122:             echo "Expected location: $NFTBAN_CORE" >&2
123:             echo "" >&2
124:             echo "This happens in CLI-only mode (bash scripts only)." >&2
125:             echo "" >&2
126:             echo "Solutions:" >&2
127:             echo "  1. Install full NFTBan package:" >&2
128:             echo "     dnf install nftban  (or: apt install nftban)" >&2
129:             echo "" >&2
130:             echo "  2. Check if binary exists:" >&2
131:             echo "     ls -la $NFTBAN_CORE" >&2
132:             echo "" >&2
133:         fi
134:         return 1
135:     fi
136: 
137:     # Call nftban-core unban
138:     local output
139:     output=$("$NFTBAN_CORE" unban "$ip" 2>&1)
140:     local exit_code=$?
141: 
142:     if [[ "$json_mode" == "true" ]] && declare -f json_output >/dev/null 2>&1; then
143:         if [[ $exit_code -eq 0 ]]; then
144:             local data
145:             if command -v jq &>/dev/null; then
146:                 data=$(jq -n --arg ip "$ip" '{ip: $ip}')
147:             else
148:                 data="{\"ip\":\"$ip\"}"
149:             fi
150:             json_output "true" "$data"
151:         else
152:             json_output "false" '{}' "Failed to unban IP: $output"
153:         fi
154:     else
155:         echo "$output"
156:     fi
157: 
158:     return $exit_code
159: }
160: 
161: # =============================================================================
162: # USAGE
163: # =============================================================================
164: 
165: nftban_cmd_unban_usage() {
166:     cat <<EOF
167: Usage: nftban unban <ip>
168: 
169: Remove an IP address ban.
170: 
171: Arguments:
172:   <ip>                IP address to unban (IPv4 or IPv6)
173: 
174: Options:
175:   --help, -h          Show this help message
176: 
177: Examples:
178:   nftban unban 192.168.1.100
179:   nftban unban 2001:db8::1
180: 
181: Notes:
182:   - IP is removed from ${NFTBAN_CONFIG_DIR}/blacklist.d/*.conf
183:   - Changes are synced to nftables immediately
184:   - If IP is not banned, nothing happens (not an error)
185: 
186: See also:
187:   nftban ban <ip>      Ban an IP address
188:   nftban search <ip>   Check IP status
189:   nftban list          List all banned IPs
190: 
191: EOF
192: }
193: 
194: # Export function
195: export -f nftban_cmd_unban
196: export -f nftban_cmd_unban_usage
</file>


 887: create_users_groups() {
 888:     log "Creating NFTBan Users and Groups..."
 889: 
 890:     # Create nftban system group
 891:     if ! getent group nftban >/dev/null 2>&1; then
 892:         groupadd --system nftban
 893:         ok "Created group: nftban"
 894:     else
 895:         ok "Group already exists: nftban"
 896:     fi
 897: 
 898:     # Create nftban system user
 899:     if ! getent passwd nftban >/dev/null 2>&1; then
 900:         useradd --system --home-dir /var/lib/nftban --shell /usr/sbin/nologin \
 901:                 --gid nftban --comment "NFTBan System User" nftban
 902:         ok "Created user: nftban"
 903:     else
 904:         ok "User already exists: nftban"
 905:     fi
 906: 
 907:     # Create nftban-auditor group (Read-only auditors)
 908:     # NFTBan v1.0.19 uses 3-group model:
 909:     #   nftban: All operators (CLI, Web, full service management)
 910:     #   nftban-auditor: Read-only audit access (renamed from nftban-auditors)
 911:     #   nftban-panel: Panel integration (limited reload access)
 912:     if ! getent group nftban-auditor >/dev/null 2>&1; then
 913:         groupadd --system nftban-auditor
 914:         ok "Created group: nftban-auditor"
 915:     else
 916:         ok "Group already exists: nftban-auditor"
 917:     fi
 918: 
 919:     # Create nftban-panel group (Panel integration)
 920:     if ! getent group nftban-panel >/dev/null 2>&1; then
 921:         groupadd --system nftban-panel
 922:         ok "Created group: nftban-panel"
 923:     else
 924:         ok "Group already exists: nftban-panel"
 925:     fi
 926: 
 927:     # Backward compatibility: Migrate nftban-auditors → nftban-auditor (v1.0.19)
 928:     if getent group nftban-auditors >/dev/null 2>&1; then
 929:         log "Migrating nftban-auditors → nftban-auditor group..."
 930:         # Copy members from old group to new group
 931:         for user in $(getent group nftban-auditors | cut -d: -f4 | tr ',' ' '); do
 932:             if [ -n "$user" ]; then
 933:                 usermod -aG nftban-auditor "$user" 2>/dev/null || warn "Could not migrate user: $user"
 934:                 ok "Migrated user to nftban-auditor: $user"
 935:             fi
 936:         done
 937:     fi
 938: 
 939:     # Add root to nftban group (for CLI access)
 940:     if ! id -nG root | grep -qw nftban 2>/dev/null; then
 941:         usermod -aG nftban root 2>/dev/null || warn "Could not add root to nftban"
 942:         ok "Added root to nftban group"
 943:     fi
 944: 
 945:     echo ""
 946:     log "Groups Summary (v1.0.19: 3-group RBAC model):"
 947:     echo "  • nftban         - Operators (CLI, Web GUI, full service management)"
 948:     echo "  • nftban-auditor - Auditors (read-only: logs, reports, status queries)"
 949:     echo "  • nftban-panel   - Panel integration (limited reload, read-only data)"
 950:     echo ""
 951:     ok "User and group setup complete"
 952: 
 953:     return 0
 954: }

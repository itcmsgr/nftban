371: # =============================================================================
372: # SCAN TYPE DETECTION
373: # =============================================================================
374: 
375: # Detect scan type from signature string
376: nftban_portscan_suricata_detect_scan_type() {
377:     local signature="$1"
378: 
379:     local sig_lower
380:     sig_lower=$(echo "$signature" | tr '[:upper:]' '[:lower:]')
381: 
382:     # Check for specific scan types
383:     if [[ "$sig_lower" =~ portsweep|port[[:space:]]sweep ]]; then
384:         echo "portsweep"
385:     elif [[ "$sig_lower" =~ decoy|spoofed ]]; then
386:         echo "decoy"
387:     elif [[ "$sig_lower" =~ distributed ]]; then
388:         echo "distributed"
389:     elif [[ "$sig_lower" =~ nmap ]]; then
390:         echo "nmap"
391:     elif [[ "$sig_lower" =~ masscan ]]; then
392:         echo "masscan"
393:     elif [[ "$sig_lower" =~ portscan|port[[:space:]]scan ]]; then
394:         echo "portscan"
395:     elif [[ "$sig_lower" =~ scan ]]; then
396:         echo "generic"
397:     fi
398: 
399:     return 0
400: }

 68: // getFeedsEnabledStatus reads the feeds config and returns a map of feed name -> enabled status
 69: func getFeedsEnabledStatus(configPath string) map[string]bool {
 70: 	enabledMap := make(map[string]bool)
 71: 
 72: 	// Try to read both .conf and .conf.local
 73: 	configFiles := []string{configPath, configPath + ".local"}
 74: 
 75: 	for _, cf := range configFiles {
 76: 		content, err := os.ReadFile(cf)
 77: 		if err != nil {
 78: 			continue // Skip if file doesn't exist
 79: 		}
 80: 
 81: 		lines := strings.Split(string(content), "\n")
 82: 		for _, line := range lines {
 83: 			line = strings.TrimSpace(line)
 84: 
 85: 			// Look for FEED_*_ENABLED="true" or "false"
 86: 			if strings.HasPrefix(line, "FEED_") && strings.Contains(line, "_ENABLED=") {
 87: 				// Extract feed name and enabled status
 88: 				// Format: FEED_BLOCKLISTDE_SSH_ENABLED="true"
 89: 				parts := strings.SplitN(line, "=", 2)
 90: 				if len(parts) != 2 {
 91: 					continue
 92: 				}
 93: 
 94: 				// Extract feed name from FEED_<NAME>_ENABLED
 95: 				varName := parts[0]
 96: 				if !strings.HasSuffix(varName, "_ENABLED") {
 97: 					continue
 98: 				}
 99: 				feedName := strings.TrimPrefix(varName, "FEED_")
100: 				feedName = strings.TrimSuffix(feedName, "_ENABLED")
101: 
102: 				// Extract enabled value
103: 				value := strings.Trim(parts[1], `"' `)
104: 				enabled := (value == "true")
105: 
106: 				enabledMap[feedName] = enabled
107: 			}
108: 		}
109: 	}
110: 
111: 	return enabledMap
112: }

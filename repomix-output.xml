20: // PortscanStatsHandler returns portscan statistics
21: // GET /api/v1/portscan/stats
22: func PortscanStatsHandler(w http.ResponseWriter, r *http.Request) {
23: 	// Execute: nftban portscan stats --json (dedicated portscan stats command)
24: 	output, err := execNFTBanCommand("portscan", "stats", "--json")
25: 	if err != nil {
26: 		log.Printf("[ERROR] Failed to get portscan stats: %v", err)
27: 		// Return default stats on error
28: 		respondJSON(w, http.StatusOK, map[string]interface{}{
29: 			"success": true,
30: 			"data": map[string]interface{}{
31: 				"portscan": PortscanStats{
32: 					Enabled: false,
33: 				},
34: 			},
35: 		})
36: 		return
37: 	}
38: 
39: 	// Strip any non-JSON output (comments, warnings, etc.) before parsing
40: 	// Look for the first '{' and last '}' to extract only the JSON portion
41: 	output = strings.TrimSpace(output)
42: 	startIdx := strings.Index(output, "{")
43: 	endIdx := strings.LastIndex(output, "}")
44: 
45: 	if startIdx == -1 || endIdx == -1 || startIdx > endIdx {
46: 		log.Printf("[ERROR] No valid JSON found in portscan stats output: %s", output)
47: 		// Return default stats on invalid JSON
48: 		respondJSON(w, http.StatusOK, map[string]interface{}{
49: 			"success": true,
50: 			"data": map[string]interface{}{
51: 				"portscan": PortscanStats{
52: 					Enabled: false,
53: 				},
54: 			},
55: 		})
56: 		return
57: 	}
58: 
59: 	jsonOutput := output[startIdx : endIdx+1]
60: 
61: 	// Parse the JSON output
62: 	var result struct {
63: 		Success bool `json:"success"`
64: 		Data    struct {
65: 			Portscan PortscanStats `json:"portscan"`
66: 		} `json:"data"`
67: 	}
68: 
69: 	if err := json.Unmarshal([]byte(jsonOutput), &result); err != nil {
70: 		log.Printf("[ERROR] Failed to parse portscan stats output: %v - Output: %s", err, jsonOutput)
71: 		// Return default stats on parse error
72: 		respondJSON(w, http.StatusOK, map[string]interface{}{
73: 			"success": true,
74: 			"data": map[string]interface{}{
75: 				"portscan": PortscanStats{
76: 					Enabled: false,
77: 				},
78: 			},
79: 		})
80: 		return
81: 	}
82: 
83: 	respondJSON(w, http.StatusOK, result)
84: }

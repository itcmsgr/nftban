244: nftban_module_check_duplicates() {
245:     # Check for duplicate module names and version conflicts (INFORMATIONAL ONLY)
246:     # Reports: Multiple files with same meta:name, version mismatches
247:     # Does NOT fix anything
248: 
249:     echo
250:     echo "════════════════════════════════════════════════════════════════════════════════════"
251:     printf "%s Duplicate Module & Version Conflict Report — %s %s\n" "${C_BOLD:-}" "$NFTBAN_MODULE_TIMESTAMP" "${C_RESET:-}"
252:     echo "════════════════════════════════════════════════════════════════════════════════════"
253:     echo
254: 
255:     # Scan modules if not already done
256:     if [[ ${#NFTBAN_MODULE_INVENTORY[@]} -eq 0 ]]; then
257:         nftban_module_scan
258:     fi
259: 
260:     # Build index: module_name -> array of (file_path|version)
261:     declare -A name_index
262: 
263:     for file in "${!NFTBAN_MODULE_INVENTORY[@]}"; do
264:         local data="${NFTBAN_MODULE_INVENTORY[$file]}"
265:         IFS='|' read -r name version module_type created depends owner homepage description <<< "$data"
266: 
267:         # Skip if no name
268:         [[ -z "$name" ]] && continue
269: 
270:         # Append to name index
271:         if [[ -n "${name_index[$name]:-}" ]]; then
272:             name_index["$name"]+=$'\n'"${file}|${version}"
273:         else
274:             name_index["$name"]="${file}|${version}"
275:         fi
276:     done
277: 
278:     local total_duplicates=0
279:     local total_version_conflicts=0
280: 
281:     # Check for duplicates
282:     for module_name in "${!name_index[@]}"; do
283:         local entries="${name_index[$module_name]}"
284:         local entry_count
285:         entry_count=$(echo "$entries" | wc -l)
286: 
287:         # If more than one file has this module name, it's a duplicate
288:         if [[ $entry_count -gt 1 ]]; then
289:             total_duplicates=$((total_duplicates + 1))
290: 
291:             echo "${C_RED:-}⚠ DUPLICATE MODULE NAME: ${module_name}${C_RESET:-}"
292:             echo "  Found in $entry_count files:"
293: 
294:             # Check for version conflicts
295:             local versions=()
296:             while IFS='|' read -r filepath fileversion; do
297:                 versions+=("$fileversion")
298:                 local basename
299:                 basename="$(basename "$filepath")"
300:                 printf "    - %-50s (version: %s)\n" "$basename" "${fileversion:-MISSING}"
301:             done <<< "$entries"
302: 
303:             # Check if all versions are the same
304:             local unique_versions
305:             unique_versions=$(printf '%s\n' "${versions[@]}" | sort -u | wc -l)
306: 
307:             if [[ $unique_versions -gt 1 ]]; then
308:                 total_version_conflicts=$((total_version_conflicts + 1))
309:                 echo "    ${C_YELLOW:-}⚠ VERSION CONFLICT: Multiple versions detected!${C_RESET:-}"
310:             elif [[ "${versions[0]}" == "" ]]; then
311:                 echo "    ${C_YELLOW:-}⚠ WARNING: Version metadata missing${C_RESET:-}"
312:             fi
313:             echo
314:         fi
315:     done
316: 
317:     # Summary
318:     echo "------------------------------------------------------------------------------------"
319:     echo
320:     echo "Summary:"
321:     echo "  Total Unique Module Names:  ${#name_index[@]}"
322:     echo "  Duplicate Module Names:     ${C_RED:-}${total_duplicates}${C_RESET:-}"
323:     echo "  Version Conflicts:          ${C_YELLOW:-}${total_version_conflicts}${C_RESET:-}"
324:     echo
325: 
326:     if [[ $total_duplicates -eq 0 ]]; then
327:         echo "${C_GREEN:-}✔ No duplicate module names found${C_RESET:-}"
328:     else
329:         echo "${C_RED:-}✖ Fix: Remove or rename duplicate module files${C_RESET:-}"
330:         echo "  Recommendation: Keep only the most recent version of each module"
331:     fi
332: 
333:     if [[ $total_version_conflicts -gt 0 ]]; then
334:         echo "${C_YELLOW:-}⚠ Version conflicts detected - update metadata in duplicate files${C_RESET:-}"
335:     fi
336: 
337:     echo
338:     echo "Note: This is informational only. No files were modified."
339:     echo
340: 
341:     # Return non-zero if issues found
342:     [[ $total_duplicates -gt 0 || $total_version_conflicts -gt 0 ]] && return 1
343:     return 0
344: }

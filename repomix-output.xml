263: # Command: nftban metrics enable [--backend prometheus|victoriametrics]
264: # ==============================================================================
265: nftban_metrics_enable() {
266:     local backend="prometheus"  # Default
267:     local force=false
268: 
269:     # Parse arguments
270:     while [[ $# -gt 0 ]]; do
271:         case "$1" in
272:             --backend)
273:                 backend="$2"
274:                 shift 2
275:                 ;;
276:             --force|-f)
277:                 force=true  # shellcheck disable=SC2034  # Reserved for force flag
278:                 shift
279:                 ;;
280:             *)
281:                 shift
282:                 ;;
283:         esac
284:     done
285: 
286:     # Validate backend
287:     if [[ "$backend" != "prometheus" ]] && [[ "$backend" != "victoriametrics" ]]; then
288:         echo "❌ Invalid backend: $backend"
289:         echo "   Valid options: prometheus, victoriametrics"
290:         return 1
291:     fi
292: 
293:     # ============================================================================
294:     # CONFLICT DETECTION: Check for existing installations
295:     # ============================================================================
296:     _check_backend_conflict
297: 
298:     # Check if the OTHER backend is running (not the one being requested)
299:     local conflict_detected=false
300:     if [[ "$backend" == "prometheus" ]] && [[ "$CONFLICT_VICTORIAMETRICS_RUNNING" == "true" ]]; then
301:         conflict_detected=true
302:         _show_conflict_warning "prometheus"
303:         echo "❌ Cannot enable Prometheus while VictoriaMetrics is running."
304:         echo ""
305:         return 1
306:     elif [[ "$backend" == "victoriametrics" ]] && [[ "$CONFLICT_PROMETHEUS_RUNNING" == "true" ]]; then
307:         conflict_detected=true  # shellcheck disable=SC2034  # Reserved for conflict resolution
308:         _show_conflict_warning "victoriametrics"
309:         echo "❌ Cannot enable VictoriaMetrics while Prometheus is running."
310:         echo ""
311:         return 1
312:     fi
313: 
314:     # Warn if both backends are installed (but only one running)
315:     local dual_install=false
316:     if [[ "$CONFLICT_PROMETHEUS_INSTALLED" == "true" ]] && [[ "$CONFLICT_VICTORIAMETRICS_INSTALLED" == "true" ]]; then
317:         dual_install=true
318:     fi
319: 
320:     echo ""
321:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
322:     echo "  Enabling NFTBan Metrics Collection"
323:     echo "  Backend: $backend"
324:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
325:     echo ""
326: 
327:     case "$backend" in
328:         prometheus)
329:             # Check if already enabled
330:             if systemctl is-active prometheus &>/dev/null && \
331:                systemctl is-active nftban-metrics-exporter.timer &>/dev/null; then
332:                 echo "✅ Prometheus metrics already enabled"
333:                 echo ""
334:                 echo "📊 Prometheus:  http://${NFTBAN_METRICS_PROMETHEUS_ADDR}/"
335:                 echo "📈 Metrics:     http://${NFTBAN_METRICS_NODE_EXPORTER_ADDR}/metrics"
336:                 echo ""
337: 
338:                 # Show dual install warning if applicable
339:                 if [[ "$dual_install" == "true" ]]; then
340:                     _show_dual_install_warning "prometheus"
341:                 fi
342: 
343:                 return 0
344:             fi
345: 
346:             # Step 1: Check and install dependencies
347:             echo "Step 1/3: Checking Prometheus dependencies..."
348: 
349:             if ! nftban_metrics_check_deps; then
350:                 echo "  ⚠️  Missing: ${NFTBAN_METRICS_MISSING[*]}"
351:                 if ! nftban_metrics_install_deps; then
352:                     return 1
353:                 fi
354:             else
355:                 echo "  ✓ All dependencies present"
356:             fi
357: 
358:             # Step 2: Start metrics stack
359:             echo ""
360:             echo "Step 2/3: Starting Prometheus stack..."
361: 
362:             if ! nftban_metrics_start_stack; then
363:                 echo "  ❌ Failed to start Prometheus stack"
364:                 return 1
365:             fi
366: 
367:             # Update config
368:             _set_metrics_backend "prometheus"
369: 
370:             # Final output
371:             echo ""
372:             echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
373:             echo "✅ Prometheus Metrics Enabled Successfully!"
374:             echo ""
375:             echo "📊 Prometheus UI:   http://${NFTBAN_METRICS_PROMETHEUS_ADDR}/"
376:             echo "📈 Node Exporter:   http://${NFTBAN_METRICS_NODE_EXPORTER_ADDR}/metrics"
377:             echo "📁 NFTBan Metrics:  /var/lib/node_exporter/textfile_collector/nftban.prom"
378:             echo "⏱️  Collection:      Every 60 seconds"
379:             echo ""

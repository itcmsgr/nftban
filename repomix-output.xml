383: // validateRuleset runs nft -c -f to validate
384: func validateRuleset(path string) error {
385: 	cmd := exec.Command("nft", "-c", "-f", path)
386: 	output, err := cmd.CombinedOutput()
387: 	if err != nil {
388: 		return fmt.Errorf("%w: %s", err, output)
389: 	}
390: 	return nil
391: }

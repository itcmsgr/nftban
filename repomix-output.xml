453: <script>
454: async function testIP() {
455:     const ip = document.getElementById('test-ip').value.trim();
456:     if (!ip) {
457:         showNotification('Please enter an IP address', 'error');
458:         return;
459:     }
460: 
461:     const proto = document.getElementById('test-proto').value;
462:     const port = document.getElementById('test-port').value;
463:     const direction = document.getElementById('test-direction').value;
464: 
465:     const btn = document.getElementById('btn-test');
466:     btn.disabled = true;
467:     btn.innerHTML = '<span class="loading-spinner"></span> Testing...';
468: 
469:     try {
470:         let url = `/api/v1/emulate?ip=${encodeURIComponent(ip)}&direction=${direction}`;
471:         if (proto) url += `&proto=${proto}`;
472:         if (port) url += `&port=${port}`;
473: 
474:         const response = await fetch(url, {
475:             headers: { 'Authorization': `Bearer ${localStorage.getItem('token')}` }
476:         });
477: 
478:         if (!response.ok) {
479:             const error = await response.json();
480:             throw new Error(error.error || 'Test failed');
481:         }
482: 
483:         const data = await response.json();
484:         displayResult(data);
485: 
486:     } catch (error) {
487:         showNotification(error.message, 'error');
488:     } finally {
489:         btn.disabled = false;
490:         btn.innerHTML = '<span class="btn-text">🔍 Test IP</span>';
491:     }
492: }
493: 
494: function quickTest(ip) {
495:     document.getElementById('test-ip').value = ip;
496:     testIP();
497: }
498: 
499: function displayResult(data) {
500:     const section = document.getElementById('result-section');
501:     const header = document.getElementById('result-header');
502: 
503:     const isBlocked = data.result.decision === 'block';
504: 
505:     header.className = 'result-header ' + (isBlocked ? 'blocked' : 'allowed');
506:     document.getElementById('result-icon').textContent = isBlocked ? '❌' : '✅';
507:     document.getElementById('result-decision').textContent = isBlocked ? 'BLOCKED' : 'ALLOWED';
508:     document.getElementById('result-ip').textContent = data.query.ip;
509: 
510:     // Decision details
511:     document.getElementById('detail-module').textContent = data.result.reason.module || '-';
512:     document.getElementById('detail-source').textContent = data.result.reason.source || '-';
513:     document.getElementById('detail-list-type').textContent = data.result.reason.list_type || '-';
514:     document.getElementById('detail-matching').textContent = data.result.reason.matching_cidr || '-';
515: 
516:     // NFTables details
517:     document.getElementById('detail-family').textContent = data.result.nftables.family || '-';
518:     document.getElementById('detail-table').textContent = data.result.nftables.table || '-';
519:     document.getElementById('detail-chain').textContent = data.result.nftables.chain || '-';
520:     document.getElementById('detail-handle').textContent = data.result.nftables.rule_handle || '-';
521: 
522:     // Explanation
523:     document.getElementById('result-explanation').textContent = data.result.explanation;
524: 
525:     // Evaluation order
526:     const evalOrder = document.getElementById('eval-order');
527:     evalOrder.innerHTML = '<span style="color: var(--text-muted); font-size: 12px; margin-right: 10px;">Evaluation order:</span>';
528: 
529:     if (data.evaluation_order) {
530:         data.evaluation_order.forEach((step, index) => {
531:             const stepEl = document.createElement('div');
532:             stepEl.className = 'eval-step ' + (step.matched ? 'matched' : 'not-matched');
533:             stepEl.innerHTML = `
534:                 <span class="step-icon">${step.matched ? '✓' : '○'}</span>
535:                 <span>${step.set}</span>
536:                 ${step.entry ? `<span style="color: var(--text-muted);">(${step.entry})</span>` : ''}
537:             `;
538:             evalOrder.appendChild(stepEl);
539:         });
540:     }
541: 
542:     section.classList.add('visible');
543:     section.scrollIntoView({ behavior: 'smooth', block: 'start' });
544: }
545: 
546: async function batchTest() {
547:     const textarea = document.getElementById('batch-ips');
548:     const ips = textarea.value.split('\n')
549:         .map(ip => ip.trim())
550:         .filter(ip => ip.length > 0);
551: 
552:     if (ips.length === 0) {
553:         showNotification('Please enter at least one IP address', 'error');
554:         return;
555:     }
556: 
557:     if (ips.length > 100) {
558:         showNotification('Maximum 100 IPs per batch', 'error');
559:         return;
560:     }
561: 
562:     const resultsDiv = document.getElementById('batch-results');
563:     resultsDiv.innerHTML = '<p style="color: var(--text-muted);">Testing...</p>';
564: 
565:     try {
566:         const response = await fetch('/api/v1/emulate/batch', {
567:             method: 'POST',
568:             headers: {
569:                 'Authorization': `Bearer ${localStorage.getItem('token')}`,
570:                 'Content-Type': 'application/json'
571:             },
572:             body: JSON.stringify({ ips: ips })
573:         });
574: 
575:         if (!response.ok) {
576:             const error = await response.json();
577:             throw new Error(error.error || 'Batch test failed');
578:         }
579: 
580:         const data = await response.json();
581: 
582:         resultsDiv.innerHTML = '';
583:         data.results.forEach(result => {
584:             const row = document.createElement('div');
585:             row.className = 'batch-result-row';
586:             row.innerHTML = `
587:                 <span class="ip">${result.ip}</span>
588:                 <span class="decision ${result.decision}">${result.decision}</span>
589:             `;
590:             row.onclick = () => {
591:                 document.getElementById('test-ip').value = result.ip;
592:                 testIP();
593:             };
594:             row.style.cursor = 'pointer';
595:             resultsDiv.appendChild(row);
596:         });
597: 
598:         const summary = document.createElement('p');
599:         const allowed = data.results.filter(r => r.decision === 'allow').length;
600:         const blocked = data.results.filter(r => r.decision === 'block').length;
601:         summary.style.cssText = 'margin-top: 15px; color: var(--text-muted); font-size: 13px;';
602:         summary.textContent = `Total: ${data.total} | Allowed: ${allowed} | Blocked: ${blocked}`;
603:         resultsDiv.appendChild(summary);
604: 
605:     } catch (error) {
606:         resultsDiv.innerHTML = `<p style="color: var(--danger);">Error: ${error.message}</p>`;
607:     }
608: }
609: 
610: // Allow Enter key to trigger test
611: document.getElementById('test-ip').addEventListener('keypress', function(e) {
612:     if (e.key === 'Enter') testIP();
613: });
614: </script>
</file>


<file path="pkg/banlog/banlog.go">
  1: // Package banlog provides centralized ban logging for NFTBan
  2: // All ban actions (from any source) should log here for stats tracking
  3: package banlog
  4: 
  5: import (
  6: 	"fmt"
  7: 	"os"
  8: 	"sync"
  9: 	"time"
 10: 
 11: 	"github.com/itcmsgr/nftban/pkg/nftbanconf"
 12: )
 13: 
 14: // =============================================================================
 15: // NFTBan Central Ban Log
 16: // =============================================================================
 17: // Format: DATE|TIME|SOURCE|IP|COUNTRY|STATUS
 18: // Example: 2025-12-09|14:30:45|manual|192.168.1.100|US|BANNED
 19: //
 20: // This log is read by nftban_stats.sh for ACTIVITY HISTORY dashboard:
 21: // - login (SSH/auth failures)
 22: // - portscan (port scan detection)
 23: // - ddos (DDoS protection)
 24: // - manual (manual bans)
 25: // - feeds (threat intelligence feeds)
 26: // - suricata (IDS alerts)
 27: // =============================================================================
 28: 
 29: // Source constants for ban log entries
 30: const (
 31: 	SourceManual    = "manual"
 32: 	SourceLogin     = "login"
 33: 	SourcePortscan  = "portscan"
 34: 	SourceDDoS      = "ddos"
 35: 	SourceFeeds     = "feeds"
 36: 	SourceSuricata  = "suricata"
 37: 	SourceFail2ban  = "fail2ban" // Legacy compatibility
 38: )
 39: 
 40: // Status constants
 41: const (
 42: 	StatusBanned   = "BANNED"
 43: 	StatusUnbanned = "UNBANNED"
 44: )
 45: 
 46: var (
 47: 	logMutex sync.Mutex
 48: )
 49: 
 50: // getBanLogPath returns the path to bans.log from central config
 51: // NO FALLBACK - path must come from /etc/nftban/nftban.conf
 52: func getBanLogPath() string {
 53: 	paths := nftbanconf.MustLoadPaths()
 54: 	if paths.BansLog != "" {
 55: 		return paths.BansLog
 56: 	}
 57: 	cfg := nftbanconf.MustLoad()
 58: 	return cfg.LogDir + "/bans.log"
 59: }
 60: 
 61: // LogBan writes a ban entry to the central ban.log
 62: // Parameters:
 63: //   - ip: IP address being banned
 64: //   - source: Ban source (manual, login, portscan, ddos, feeds, suricata)
 65: //   - country: Country code (e.g., "US", "CN", "UNK" if unknown)
 66: //
 67: // Format: DATE|TIME|SOURCE|IP|COUNTRY|BANNED
 68: func LogBan(ip, source, country string) error {
 69: 	return writeEntry(ip, source, country, StatusBanned)
 70: }
 71: 
 72: // LogUnban writes an unban entry to the central ban.log
 73: // Parameters:
 74: //   - ip: IP address being unbanned
 75: //   - source: Unban source (usually "manual")
 76: //   - country: Country code
 77: //
 78: // Format: DATE|TIME|SOURCE|IP|COUNTRY|UNBANNED
 79: func LogUnban(ip, source, country string) error {
 80: 	return writeEntry(ip, source, country, StatusUnbanned)
 81: }
 82: 
 83: // writeEntry writes a log entry to ban.log
 84: func writeEntry(ip, source, country, status string) error {
 85: 	logMutex.Lock()
 86: 	defer logMutex.Unlock()
 87: 
 88: 	logPath := getBanLogPath()
 89: 
 90: 	// Ensure log directory exists (use LogDir from central config)
 91: 	cfg := nftbanconf.MustLoad()
 92: 	if err := os.MkdirAll(cfg.LogDir, 0755); err != nil {
 93: 		return fmt.Errorf("failed to create log directory: %w", err)
 94: 	}
 95: 
 96: 	// Open file for append
 97: 	f, err := os.OpenFile(logPath, os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0644)
 98: 	if err != nil {
 99: 		return fmt.Errorf("failed to open ban log: %w", err)
100: 	}
101: 	defer f.Close()
102: 
103: 	// Format: DATE|TIME|SOURCE|IP|COUNTRY|STATUS
104: 	now := time.Now()
105: 	date := now.Format("2006-01-02")
106: 	timeStr := now.Format("15:04:05")
107: 
108: 	// Default country if empty
109: 	if country == "" {
110: 		country = "UNK"
111: 	}
112: 
113: 	// Normalize source
114: 	source = normalizeSource(source)
115: 
116: 	logLine := fmt.Sprintf("%s|%s|%s|%s|%s|%s\n", date, timeStr, source, ip, country, status)
117: 
118: 	if _, err := f.WriteString(logLine); err != nil {
119: 		return fmt.Errorf("failed to write to ban log: %w", err)
120: 	}
121: 
122: 	return nil
123: }
124: 
125: // normalizeSource ensures source string matches expected values for stats parsing
126: func normalizeSource(source string) string {
127: 	switch source {
128: 	case "manual", "user":
129: 		return SourceManual
130: 	case "login", "ssh", "auth", "login-monitor", "nftban-sshd":
131: 		return SourceLogin
132: 	case "portscan", "scan", "port-scan":
133: 		return SourcePortscan
134: 	case "ddos", "flood", "synflood", "rate-limit":
135: 		return SourceDDoS
136: 	case "feeds", "feed", "threat-intel":
137: 		return SourceFeeds
138: 	case "suricata", "ids":
139: 		return SourceSuricata
140: 	case "fail2ban":
141: 		return SourceFail2ban
142: 	default:
143: 		// Keep original for unknown sources
144: 		return source
145: 	}
146: }
147: 
148: // LogBanWithReason writes a ban entry with an optional reason (stored in extended format)
149: // This is for detailed logging - the reason is NOT used by stats but is useful for audit
150: func LogBanWithReason(ip, source, country, reason string) error {
151: 	// For now, just call LogBan - reason can be added to extended log format later
152: 	return LogBan(ip, source, country)
153: }
</file>

<file path="pkg/blacklist/loader.go">
  1: package blacklist
  2: 
  3: import (
  4: 	"fmt"
  5: 	"os"
  6: 	"path/filepath"
  7: 	"strings"
  8: 
  9: 	"github.com/itcmsgr/nftban/pkg/feeds"
 10: 	"github.com/itcmsgr/nftban/pkg/netutil"
 11: 	"github.com/itcmsgr/nftban/pkg/util"
 12: )
 13: 
 14: // LoadAllBlacklists loads IPs from all blacklist sources:
 15: // - /etc/nftban/blacklist.d/*.conf (modular files organized by category)
 16: // Returns two sets: IPv4 and IPv6 addresses
 17: //
 18: // Now uses optimized generic Set type from pkg/util for:
 19: // - Zero memory overhead (struct{} instead of bool)
 20: // - Consistent API
 21: // - Better performance
 22: func LoadAllBlacklists(configDir string) (map[string]bool, map[string]bool, error) {
 23: 	// Use generic Set internally for efficiency
 24: 	ipv4Set := util.NewSet[string]()
 25: 	ipv6Set := util.NewSet[string]()
 26: 
 27: 	// Load all files from blacklist.d/
 28: 	blacklistDir := filepath.Join(configDir, "blacklist.d")
 29: 	entries, err := os.ReadDir(blacklistDir)
 30: 	if err != nil {
 31: 		// Non-fatal: directory might not exist yet
 32: 		fmt.Fprintf(os.Stderr, "Warning: Could not read blacklist.d: %v\n", err)
 33: 
 34: 		// Convert to map[string]bool for backwards compatibility
 35: 		ipv4Map := make(map[string]bool, ipv4Set.Len())
 36: 		for ip := range ipv4Set {
 37: 			ipv4Map[ip] = true
 38: 		}
 39: 		ipv6Map := make(map[string]bool, ipv6Set.Len())
 40: 		for ip := range ipv6Set {
 41: 			ipv6Map[ip] = true
 42: 		}
 43: 		return ipv4Map, ipv6Map, nil
 44: 	}
 45: 
 46: 	for _, entry := range entries {
 47: 		if entry.IsDir() {
 48: 			continue
 49: 		}
 50: 		if !strings.HasSuffix(entry.Name(), ".conf") {
 51: 			continue
 52: 		}
 53: 
 54: 		filePath := filepath.Join(blacklistDir, entry.Name())
 55: 		if err := loadBlacklistFile(filePath, ipv4Set, ipv6Set); err != nil {
 56: 			fmt.Fprintf(os.Stderr, "Warning: Could not load %s: %v\n", filePath, err)
 57: 		}
 58: 	}
 59: 
 60: 	// Convert util.Set back to map[string]bool for backwards compatibility
 61: 	// TODO: Update all callers to use util.Set directly in future
 62: 	ipv4Map := make(map[string]bool, ipv4Set.Len())
 63: 	for ip := range ipv4Set {
 64: 		ipv4Map[ip] = true
 65: 	}
 66: 
 67: 	ipv6Map := make(map[string]bool, ipv6Set.Len())
 68: 	for ip := range ipv6Set {
 69: 		ipv6Map[ip] = true
 70: 	}
 71: 
 72: 	return ipv4Map, ipv6Map, nil
 73: }
 74: 
 75: // loadBlacklistFile loads IPs from a single blacklist file
 76: // Uses unified ParseFeedLine for consistent parsing across the codebase
 77: func loadBlacklistFile(filePath string, ipv4Set, ipv6Set util.Set[string]) error {
 78: 	lineNum := 0
 79: 
 80: 	return util.LoadLines(filePath, func(line string) error {
 81: 		lineNum++
 82: 
 83: 		// Use unified parser for consistent handling
 84: 		entry := feeds.ParseFeedLineSilent(line)
 85: 		if entry == nil {
 86: 			return nil // Skip empty/comment lines or invalid entries
 87: 		}
 88: 
 89: 		if entry.IPv4 {
 90: 			ipv4Set.Add(entry.Value)
 91: 		} else {
 92: 			ipv6Set.Add(entry.Value)
 93: 		}
 94: 
 95: 		return nil
 96: 	})
 97: }
 98: 
 99: // ValidateIP validates and normalizes an IP address
100: // Returns the normalized IP string and whether it's IPv4
101: // Delegates to netutil.ValidateAndNormalizeIP for consistency
102: func ValidateIP(ipStr string) (string, bool, error) {
103: 	return netutil.ValidateAndNormalizeIP(ipStr)
104: }
105: 
106: // AddIP adds an IP to the appropriate blacklist file
107: // Creates blacklist.d/99-manual.conf for manual additions
108: // Deprecated: Use AddIPWithSource for source-specific files
109: func AddIP(configDir string, ipStr string, reason string) error {
110: 	return AddIPWithSource(configDir, ipStr, reason, "manual")
111: }
112: 
113: // AddIPWithSource adds an IP to a source-specific blacklist file
114: // Source determines the target file:
115: //   - "login"    -> login-auto.conf
116: //   - "portscan" -> portscan-auto.conf
117: //   - "ddos"     -> ddos-auto.conf
118: //   - "manual"   -> 99-manual.conf (default)
119: //   - others     -> 99-manual.conf
120: func AddIPWithSource(configDir string, ipStr string, reason string, source string) error {
121: 	// Validate IP
122: 	normalizedIP, isIPv4, err := ValidateIP(ipStr)
123: 	if err != nil {
124: 		return err
125: 	}
126: 
127: 	// Determine target file based on source
128: 	blacklistDir := filepath.Join(configDir, "blacklist.d")
129: 	if err := os.MkdirAll(blacklistDir, 0750); err != nil {
130: 		return fmt.Errorf("failed to create blacklist.d: %w", err)
131: 	}
132: 
133: 	var targetFile string
134: 	var fileHeader string
135: 	switch source {
136: 	case "login":
137: 		targetFile = filepath.Join(blacklistDir, "login-auto.conf")
138: 		fileHeader = "# Login Monitor Auto-Ban Entries\n# Added automatically by nftban-login-monitor\n# Format: IP  # reason\n\n"
139: 	case "portscan":
140: 		targetFile = filepath.Join(blacklistDir, "portscan-auto.conf")
141: 		fileHeader = "# Port Scan Auto-Ban Entries\n# Added automatically by nftban-portscan\n# Format: IP  # reason\n\n"
142: 	case "ddos":
143: 		targetFile = filepath.Join(blacklistDir, "ddos-auto.conf")
144: 		fileHeader = "# DDoS Auto-Ban Entries\n# Added automatically by nftban-ddos\n# Format: IP  # reason\n\n"
145: 	case "persistent":
146: 		targetFile = filepath.Join(blacklistDir, "30-persistent-offenders.conf")
147: 		fileHeader = "# Persistent Offenders - Permanent Bans\n# IPs that exceeded ban thresholds and were escalated\n# Format: IP  # reason\n\n"
148: 	default:
149: 		targetFile = filepath.Join(blacklistDir, "99-manual.conf")
150: 		fileHeader = "# Manual Blacklist Entries\n# Added via nftban ban command\n# Format: IP  # reason\n\n"
151: 	}
152: 
153: 	manualFile := targetFile
154: 
155: 	// Check if IP already exists
156: 	ipv4Set, ipv6Set, err := LoadAllBlacklists(configDir)
157: 	if err != nil {
158: 		return fmt.Errorf("failed to load blacklists: %w", err)
159: 	}
160: 
161: 	if isIPv4 {
162: 		if ipv4Set[normalizedIP] {
163: 			return fmt.Errorf("IP %s already blacklisted", normalizedIP)
164: 		}
165: 	} else {
166: 		if ipv6Set[normalizedIP] {
167: 			return fmt.Errorf("IP %s already blacklisted", normalizedIP)
168: 		}
169: 	}
170: 
171: 	// Append to manual file
172: 	f, err := os.OpenFile(manualFile, os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0640)
173: 	if err != nil {
174: 		return fmt.Errorf("failed to open manual blacklist: %w", err)
175: 	}
176: 	defer f.Close()
177: 
178: 	// Add header if file is empty
179: 	stat, _ := f.Stat()
180: 	if stat.Size() == 0 {
181: 		fmt.Fprintf(f, "%s", fileHeader)
182: 	}
183: 
184: 	if reason != "" {
185: 		fmt.Fprintf(f, "%s  # %s\n", normalizedIP, reason)
186: 	} else {
187: 		fmt.Fprintf(f, "%s\n", normalizedIP)
188: 	}
189: 
190: 	return nil
191: }
192: 
193: // RemoveIP removes an IP from all blacklist files
194: func RemoveIP(configDir string, ipStr string) error {
195: 	// Validate and normalize IP
196: 	normalizedIP, _, err := ValidateIP(ipStr)
197: 	if err != nil {
198: 		return err
199: 	}
200: 
201: 	removed := false
202: 
203: 	// Check all files in blacklist.d/
204: 	blacklistDir := filepath.Join(configDir, "blacklist.d")
205: 	entries, err := os.ReadDir(blacklistDir)
206: 	if err != nil {
207: 		return fmt.Errorf("could not read blacklist.d: %w", err)
208: 	}
209: 
210: 	for _, entry := range entries {
211: 		if entry.IsDir() || !strings.HasSuffix(entry.Name(), ".conf") {
212: 			continue
213: 		}
214: 
215: 		filePath := filepath.Join(blacklistDir, entry.Name())
216: 		if err := removeIPFromFile(filePath, normalizedIP); err == nil {
217: 			removed = true
218: 		}
219: 	}
220: 
221: 	if !removed {
222: 		return fmt.Errorf("IP %s not found in blacklist", normalizedIP)
223: 	}
224: 
225: 	return nil
226: }
227: 
228: // removeIPFromFile removes an IP from a specific file
229: // Uses util.RemoveLineFromFile for atomic file operations
230: func removeIPFromFile(filePath string, ipToRemove string) error {
231: 	removed, err := util.RemoveLineFromFile(filePath, func(line string) bool {
232: 		trimmed := strings.TrimSpace(line)
233: 
234: 		// Handle inline comments
235: 		ipPart := trimmed
236: 		if idx := strings.Index(trimmed, "#"); idx >= 0 {
237: 			ipPart = strings.TrimSpace(trimmed[:idx])
238: 		}
239: 		fields := strings.Fields(ipPart)
240: 		if len(fields) > 0 {
241: 			ipPart = fields[0]
242: 		}
243: 
244: 		return ipPart == ipToRemove
245: 	})
246: 
247: 	if err != nil {
248: 		return err
249: 	}
250: 	if !removed {
251: 		return fmt.Errorf("IP not found in %s", filePath)
252: 	}
253: 	return nil
254: }
255: 
256: // GetBlacklistByCategory returns IPs from a specific category file
257: func GetBlacklistByCategory(configDir string, category string) ([]string, []string, error) {
258: 	fileName := filepath.Join(configDir, "blacklist.d", category+".conf")
259: 
260: 	ipv4Set := util.NewSet[string]()
261: 	ipv6Set := util.NewSet[string]()
262: 
263: 	if err := loadBlacklistFile(fileName, ipv4Set, ipv6Set); err != nil {
264: 		return nil, nil, err
265: 	}
266: 
267: 	// Convert maps to slices
268: 	var ipv4List []string
269: 	for ip := range ipv4Set {
270: 		ipv4List = append(ipv4List, ip)
271: 	}
272: 
273: 	var ipv6List []string
274: 	for ip := range ipv6Set {
275: 		ipv6List = append(ipv6List, ip)
276: 	}
277: 
278: 	return ipv4List, ipv6List, nil
279: }
</file>

<file path="pkg/config/loader.go">
  1: package config
  2: 
  3: import (
  4: 	"bufio"
  5: 	"fmt"
  6: 	"os"
  7: 	"os/exec"
  8: 	"strings"
  9: 
 10: 	"github.com/itcmsgr/nftban/pkg/nftbanconf"
 11: )
 12: 
 13: // FHSDirectory represents an FHS directory specification
 14: type FHSDirectory struct {
 15: 	Path    string
 16: 	Perms   string
 17: 	Owner   string
 18: 	Group   string
 19: 	Purpose string
 20: }
 21: 
 22: // DistroConfig represents distribution-specific configuration
 23: type DistroConfig struct {
 24: 	Name     string
 25: 	Family   string
 26: 	Version  string
 27: 	Services map[string]string
 28: 	Packages map[string]string
 29: 	Paths    map[string]string
 30: }
 31: 
 32: // LoadFHSSpec reads the bash FHS specification file
 33: // Returns: map[path]FHSDirectory
 34: func LoadFHSSpec() (map[string]FHSDirectory, error) {
 35: 	fhsMap := make(map[string]FHSDirectory)
 36: 
 37: 	// Get lib dir from central config
 38: 	// NO FALLBACK - path must come from /etc/nftban/nftban.conf
 39: 	cfg := nftbanconf.MustLoad()
 40: 	libDir := cfg.LibDir
 41: 
 42: 	// Execute bash to source FHS spec and output data
 43: 	cmd := exec.Command("bash", "-c", fmt.Sprintf(`
 44: 		source %s/core/nftban_fhs_spec.sh 2>/dev/null
 45: 		for path in "${!NFTBAN_FHS_DIRECTORIES[@]}"; do
 46: 			echo "$path|${NFTBAN_FHS_DIRECTORIES[$path]}"
 47: 		done
 48: 	`, libDir))
 49: 
 50: 	output, err := cmd.Output()
 51: 	if err != nil {
 52: 		return nil, fmt.Errorf("failed to load FHS spec: %w", err)
 53: 	}
 54: 
 55: 	// Parse output: path|perms|owner|group|purpose
 56: 	scanner := bufio.NewScanner(strings.NewReader(string(output)))
 57: 	for scanner.Scan() {
 58: 		line := strings.TrimSpace(scanner.Text())
 59: 		if line == "" {
 60: 			continue
 61: 		}
 62: 
 63: 		parts := strings.Split(line, "|")
 64: 		if len(parts) != 5 {
 65: 			continue
 66: 		}
 67: 
 68: 		fhsMap[parts[0]] = FHSDirectory{
 69: 			Path:    parts[0],
 70: 			Perms:   parts[1],
 71: 			Owner:   parts[2],
 72: 			Group:   parts[3],
 73: 			Purpose: parts[4],
 74: 		}
 75: 	}
 76: 
 77: 	if err := scanner.Err(); err != nil {
 78: 		return nil, fmt.Errorf("error parsing FHS spec: %w", err)
 79: 	}
 80: 
 81: 	return fhsMap, nil
 82: }
 83: 
 84: // LoadDistroConfig reads distribution-specific configuration
 85: // Detects current distro and loads appropriate config file
 86: func LoadDistroConfig() (*DistroConfig, error) {
 87: 	// Detect distro
 88: 	distro, err := detectDistro()
 89: 	if err != nil {
 90: 		return nil, fmt.Errorf("failed to detect distro: %w", err)
 91: 	}
 92: 
 93: 	// Get config dir from central config
 94: 	// NO FALLBACK - path must come from /etc/nftban/nftban.conf
 95: 	distroCfg := nftbanconf.MustLoad()
 96: 	configDir := distroCfg.ConfigDir
 97: 
 98: 	// Try to load distro-specific config
 99: 	configFile := fmt.Sprintf("%s/distros/%s.conf", configDir, distro)
100: 	if _, err := os.Stat(configFile); os.IsNotExist(err) {
101: 		// Fallback to generic detection
102: 		return &DistroConfig{
103: 			Name:     distro,
104: 			Services: make(map[string]string),
105: 			Packages: make(map[string]string),
106: 			Paths:    make(map[string]string),
107: 		}, nil
108: 	}
109: 
110: 	// Parse INI-style config file
111: 	cfg, err := parseDistroConfig(configFile)
112: 	if err != nil {
113: 		return nil, fmt.Errorf("failed to parse distro config: %w", err)
114: 	}
115: 
116: 	return cfg, nil
117: }
118: 
119: // detectDistro detects the current Linux distribution
120: func detectDistro() (string, error) {
121: 	// Read /etc/os-release (systemd standard)
122: 	data, err := os.ReadFile("/etc/os-release")
123: 	if err != nil {
124: 		return "", fmt.Errorf("cannot read /etc/os-release: %w", err)
125: 	}
126: 
127: 	lines := strings.Split(string(data), "\n")
128: 	for _, line := range lines {
129: 		if strings.HasPrefix(line, "ID=") {
130: 			distro := strings.TrimPrefix(line, "ID=")
131: 			distro = strings.Trim(distro, `"'`)
132: 			return normalizeDistroID(distro), nil
133: 		}
134: 	}
135: 
136: 	return "unknown", fmt.Errorf("cannot determine distro from /etc/os-release")
137: }
138: 
139: // normalizeDistroID normalizes distribution IDs
140: func normalizeDistroID(id string) string {
141: 	switch id {
142: 	case "centos", "centos-stream":
143: 		return "centos"
144: 	case "rhel", "redhat":
145: 		return "rhel"
146: 	case "rocky":
147: 		return "rocky"
148: 	case "almalinux", "alma":
149: 		return "almalinux"
150: 	case "debian":
151: 		return "debian"
152: 	case "ubuntu":
153: 		return "ubuntu"
154: 	case "fedora":
155: 		return "fedora"
156: 	default:
157: 		return id
158: 	}
159: }
160: 
161: // parseDistroConfig parses INI-style distro configuration file
162: func parseDistroConfig(filename string) (*DistroConfig, error) {
163: 	file, err := os.Open(filename)
164: 	if err != nil {
165: 		return nil, err
166: 	}
167: 	defer file.Close()
168: 
169: 	cfg := &DistroConfig{
170: 		Services: make(map[string]string),
171: 		Packages: make(map[string]string),
172: 		Paths:    make(map[string]string),
173: 	}
174: 
175: 	var currentSection string
176: 	scanner := bufio.NewScanner(file)
177: 
178: 	for scanner.Scan() {
179: 		line := strings.TrimSpace(scanner.Text())
180: 
181: 		// Skip empty lines and comments
182: 		if line == "" || strings.HasPrefix(line, "#") {
183: 			continue
184: 		}
185: 
186: 		// Section headers: [section]
187: 		if strings.HasPrefix(line, "[") && strings.HasSuffix(line, "]") {
188: 			currentSection = strings.Trim(line, "[]")
189: 			continue
190: 		}
191: 
192: 		// Key-value pairs: key = value
193: 		if strings.Contains(line, "=") {
194: 			parts := strings.SplitN(line, "=", 2)
195: 			if len(parts) != 2 {
196: 				continue
197: 			}
198: 
199: 			key := strings.TrimSpace(parts[0])
200: 			value := strings.TrimSpace(parts[1])
201: 			value = strings.Trim(value, `"'`)
202: 
203: 			switch currentSection {
204: 			case "distro":
205: 				switch key {
206: 				case "name":
207: 					cfg.Name = value
208: 				case "family":
209: 					cfg.Family = value
210: 				case "version":
211: 					cfg.Version = value
212: 				}
213: 			case "services":
214: 				cfg.Services[key] = value
215: 			case "packages":
216: 				cfg.Packages[key] = value
217: 			case "paths":
218: 				cfg.Paths[key] = value
219: 			}
220: 		}
221: 	}
222: 
223: 	if err := scanner.Err(); err != nil {
224: 		return nil, err
225: 	}
226: 
227: 	return cfg, nil
228: }
229: 
230: // LoadServicesConfig reads service enable/disable configuration
231: func LoadServicesConfig() (map[string]bool, error) {
232: 	services := make(map[string]bool)
233: 
234: 	// Get config dir from central config
235: 	// NO FALLBACK - path must come from /etc/nftban/nftban.conf
236: 	svcCfg := nftbanconf.MustLoad()
237: 	configDir := svcCfg.ConfigDir
238: 
239: 	data, err := os.ReadFile(configDir + "/conf.d/services.conf")
240: 	if err != nil {
241: 		// If file doesn't exist, return defaults (all enabled)
242: 		return map[string]bool{
243: 			"nftban":        true,
244: 			"nftables":      true,
245: 			// Removed: "fail2ban" (v1.0 migration to Suricata)
246: 			"login_monitor": true,
247: 		}, nil
248: 	}
249: 
250: 	lines := strings.Split(string(data), "\n")
251: 	for _, line := range lines {
252: 		line = strings.TrimSpace(line)
253: 		if line == "" || strings.HasPrefix(line, "#") {
254: 			continue
255: 		}
256: 
257: 		// Parse KEY="value" format
258: 		if strings.Contains(line, "=") {
259: 			parts := strings.SplitN(line, "=", 2)
260: 			if len(parts) != 2 {
261: 				continue
262: 			}
263: 
264: 			key := strings.TrimSpace(parts[0])
265: 			value := strings.TrimSpace(parts[1])
266: 			value = strings.Trim(value, `"'`)
267: 
268: 			// Convert to boolean
269: 			enabled := strings.ToLower(value) == "true"
270: 
271: 			// Map to service names
272: 			switch key {
273: 			case "NFTBAN_ENABLED":
274: 				services["nftban"] = enabled
275: 			case "NFTABLES_ENABLED":
276: 				services["nftables"] = enabled
277: 			case "FAIL2BAN_ENABLED":
278: 				// Removed: fail2ban enabled setting (v1.0 migration to Suricata)
279: 			case "LOGIN_MONITOR_ENABLED":
280: 				services["login_monitor"] = enabled
281: 			}
282: 		}
283: 	}
284: 
285: 	return services, nil
286: }
287: 
288: // GetFHSPath returns the FHS path for a given name
289: // NO FALLBACK - paths must come from /etc/nftban/nftban.conf
290: func GetFHSPath(name string) string {
291: 	// Get paths from central config
292: 	cfg := nftbanconf.MustLoad()
293: 
294: 	// All paths from central config
295: 	configDir := cfg.ConfigDir
296: 	dataDir := cfg.DataDir
297: 	logDir := cfg.LogDir
298: 	cacheDir := cfg.CacheDir
299: 	runDir := cfg.RunDir
300: 	shareDir := "/usr/share/nftban" // Note: ShareDir has no NFTBAN_SHARE in config
301: 	libDir := cfg.LibDir
302: 
303: 	paths := map[string]string{
304: 		"config":    configDir,
305: 		"lib":       dataDir,
306: 		"log":       logDir,
307: 		"cache":     cacheDir,
308: 		"run":       runDir,
309: 		"share":     shareDir,
310: 		"bin":       libDir + "/bin",
311: 		"core":      libDir + "/core",
312: 		"cli":       libDir + "/cli",
313: 		"sbin":      "/usr/sbin",
314: 		"geoip":     dataDir + "/geoip",
315: 		"geoban":    dataDir + "/geoban",
316: 		"feeds":     dataDir + "/feeds",
317: 		"metrics":   dataDir + "/metrics",
318: 		"snapshots": dataDir + "/snapshots",
319: 		"reports":   dataDir + "/reports",
320: 	}
321: 
322: 	if path, ok := paths[name]; ok {
323: 		return path
324: 	}
325: 
326: 	return ""
327: }
</file>

<file path="pkg/ddos/module.go">
  1: // =============================================================================
  2: // NFTBan v1.0 - DDoS Protection Module (Go Wrapper)
  3: // =============================================================================
  4: // SPDX-License-Identifier: MPL-2.0
  5: // Package: ddos
  6: // Purpose: Go module wrapper for DDoS protection, integrates with event bus
  7: //
  8: // Architecture:
  9: // - Wraps the bash dual-mode implementation (classic/suricata/hybrid)
 10: // - Publishes events to the central event bus
 11: // - Subscribes to ban events from other modules
 12: // - Runs periodic checks via goroutine
 13: //
 14: // The bash scripts remain the implementation layer, this module provides:
 15: // - Event bus integration
 16: // - Daemon lifecycle management
 17: // - Metrics collection
 18: // =============================================================================
 19: 
 20: package ddos
 21: 
 22: import (
 23: 	"context"
 24: 	"os/exec"
 25: 	"strings"
 26: 	"sync"
 27: 	"time"
 28: 
 29: 	"github.com/itcmsgr/nftban/pkg/eventbus"
 30: 	"github.com/itcmsgr/nftban/pkg/module"
 31: 	"github.com/itcmsgr/nftban/pkg/nftbanconf"
 32: )
 33: 
 34: const (
 35: 	ModuleName    = "ddos"
 36: 	ModuleVersion = "1.0.0"
 37: 
 38: 	// Check interval
 39: 	DefaultCheckInterval = 30 * time.Second
 40: )
 41: 
 42: // getDDOSScript returns the DDoS script path from central config
 43: // NO FALLBACK - path must come from /etc/nftban/nftban.conf
 44: func getDDOSScript() string {
 45: 	cfg := nftbanconf.MustLoad()
 46: 	return cfg.LibDir + "/core/nftban_ddos.sh"
 47: }
 48: 
 49: // Module implements the DDoS protection module
 50: type Module struct {
 51: 	bus           *eventbus.Bus
 52: 	status        module.Status
 53: 	mu            sync.RWMutex
 54: 	cancel        context.CancelFunc
 55: 	checkInterval time.Duration
 56: 
 57: 	// Runtime state
 58: 	mode          string // classic, suricata, hybrid, auto
 59: 	enabled       bool
 60: 	suricataAvail bool
 61: }
 62: 
 63: // New creates a new DDoS protection module
 64: func New() *Module {
 65: 	return &Module{
 66: 		status:        module.NewStatus(ModuleName),
 67: 		checkInterval: DefaultCheckInterval,
 68: 		mode:          "auto",
 69: 		enabled:       true,
 70: 	}
 71: }
 72: 
 73: // Name returns the module identifier
 74: func (m *Module) Name() string {
 75: 	return ModuleName
 76: }
 77: 
 78: // Init initializes the module with the event bus
 79: func (m *Module) Init(bus *eventbus.Bus) error {
 80: 	m.bus = bus
 81: 
 82: 	// Subscribe to relevant events
 83: 	bus.Subscribe(eventbus.EventDDoSDetected, m.handleDDoSEvent)
 84: 
 85: 	// Detect current mode
 86: 	m.detectMode()
 87: 
 88: 	m.status.Enabled = m.enabled
 89: 	return nil
 90: }
 91: 
 92: // Start begins the module's background work
 93: func (m *Module) Start(ctx context.Context) error {
 94: 	ctx, m.cancel = context.WithCancel(ctx)
 95: 
 96: 	m.mu.Lock()
 97: 	m.status.MarkRunning()
 98: 	m.mu.Unlock()
 99: 
100: 	// Enable DDoS protection
101: 	if err := m.enable(); err != nil {
102: 		m.status.RecordError(err)
103: 		// Don't fail start, just log
104: 	}
105: 
106: 	// Start periodic check goroutine
107: 	go m.runPeriodicCheck(ctx)
108: 
109: 	// Publish module start event
110: 	m.bus.Publish(eventbus.NewEvent(eventbus.EventModuleStart, ModuleName).
111: 		WithMessage("DDoS protection module started").
112: 		WithData("mode", m.mode))
113: 
114: 	return nil
115: }
116: 
117: // Stop gracefully shuts down the module
118: func (m *Module) Stop() error {
119: 	if m.cancel != nil {
120: 		m.cancel()
121: 	}
122: 
123: 	// Disable DDoS protection
124: 	m.disable()
125: 
126: 	m.mu.Lock()
127: 	m.status.MarkStopped()
128: 	m.mu.Unlock()
129: 
130: 	// Publish module stop event
131: 	m.bus.Publish(eventbus.NewEvent(eventbus.EventModuleStop, ModuleName).
132: 		WithMessage("DDoS protection module stopped"))
133: 
134: 	return nil
135: }
136: 
137: // Status returns the current module status
138: func (m *Module) Status() module.Status {
139: 	m.mu.RLock()
140: 	defer m.mu.RUnlock()
141: 
142: 	m.status.UpdateUptime()
143: 	m.status.Extra["mode"] = m.mode
144: 	m.status.Extra["suricata_available"] = m.suricataAvail
145: 
146: 	return m.status
147: }
148: 
149: // detectMode detects the current DDoS protection mode
150: func (m *Module) detectMode() {
151: 	scriptPath := getDDOSScript()
152: 	out, err := exec.Command("bash", "-c", "source "+scriptPath+" && nftban_ddos_get_mode").Output()
153: 	if err != nil {
154: 		m.mode = "classic" // Default fallback
155: 		return
156: 	}
157: 	m.mode = strings.TrimSpace(string(out))
158: 
159: 	// Check Suricata availability
160: 	out, _ = exec.Command("bash", "-c", "source "+scriptPath+" && nftban_ddos_suricata_available && echo yes || echo no").Output()
161: 	m.suricataAvail = strings.TrimSpace(string(out)) == "yes"
162: }
163: 
164: // enable enables DDoS protection
165: func (m *Module) enable() error {
166: 	cmd := exec.Command("bash", "-c", "source "+getDDOSScript()+" && nftban_ddos_enable")
167: 	return cmd.Run()
168: }
169: 
170: // disable disables DDoS protection
171: func (m *Module) disable() error {
172: 	cmd := exec.Command("bash", "-c", "source "+getDDOSScript()+" && nftban_ddos_disable")
173: 	return cmd.Run()
174: }
175: 
176: // runPeriodicCheck runs periodic status checks
177: func (m *Module) runPeriodicCheck(ctx context.Context) {
178: 	ticker := time.NewTicker(m.checkInterval)
179: 	defer ticker.Stop()
180: 
181: 	for {
182: 		select {
183: 		case <-ctx.Done():
184: 			return
185: 		case <-ticker.C:
186: 			m.checkStatus()
187: 		}
188: 	}
189: }
190: 
191: // checkStatus checks current DDoS status and updates metrics
192: func (m *Module) checkStatus() {
193: 	m.detectMode()
194: 
195: 	m.mu.Lock()
196: 	m.status.RecordEvent()
197: 	m.status.ClearError()
198: 	m.mu.Unlock()
199: }
200: 
201: // handleDDoSEvent handles DDoS detection events from other sources
202: func (m *Module) handleDDoSEvent(e eventbus.Event) {
203: 	m.mu.Lock()
204: 	m.status.RecordEvent()
205: 	m.mu.Unlock()
206: 
207: 	// Log the event
208: 	if m.bus != nil {
209: 		m.bus.Publish(eventbus.NewEvent(eventbus.EventDDoSDetected, ModuleName).
210: 			WithIP(e.IP).
211: 			WithMessage("DDoS event processed").
212: 			WithSeverity(eventbus.SeverityWarning))
213: 	}
214: }
215: 
216: // Descriptor returns the module descriptor
217: // NO FALLBACK - path must come from /etc/nftban/nftban.conf
218: func Descriptor() module.Descriptor {
219: 	cfg := nftbanconf.MustLoad()
220: 	return module.Descriptor{
221: 		Name:        ModuleName,
222: 		Version:     ModuleVersion,
223: 		Description: "DDoS Protection (Dual-Mode: Classic/Suricata/Hybrid)",
224: 		Optional:    false,
225: 		ConfigFile:  cfg.ConfigDir + "/conf.d/ddos/main.conf",
226: 	}
227: }
</file>

<file path="pkg/feeds/feeds.go">
  1: // SPDX-License-Identifier: GPL-3.0-or-later
  2: // Copyright (c) 2025 Antonios Voulvoulis <contact@nftban.com>
  3: 
  4: package feeds
  5: 
  6: import (
  7: 	"bufio"
  8: 	"fmt"
  9: 	"os"
 10: 	"path/filepath"
 11: 	"strings"
 12: 
 13: 	"github.com/itcmsgr/nftban/pkg/model"
 14: 	"github.com/itcmsgr/nftban/pkg/nftbanconf"
 15: )
 16: 
 17: // getDefaultFeedsDir returns feeds directory from central config
 18: // NO FALLBACK - path must come from /etc/nftban/nftban.conf
 19: func getDefaultFeedsDir() string {
 20: 	cfg := nftbanconf.MustLoad()
 21: 	return cfg.DataDir + "/feeds"
 22: }
 23: 
 24: // Build loads all feed files and returns consolidated SetData
 25: // This replaces the slow bash implementation with fast Go parsing
 26: //
 27: // Performance: <2s for 50,000+ IPs (vs 45s in bash)
 28: //
 29: // Features:
 30: // - IPv4/IPv6 automatic separation
 31: // - CIDR normalization
 32: // - Comment and empty line filtering
 33: // - Streaming parsing (memory efficient)
 34: func Build(feedsDir string, feedNames []string) (map[string]*model.SetData, error) {
 35: 	if feedsDir == "" {
 36: 		feedsDir = getDefaultFeedsDir()
 37: 	}
 38: 
 39: 	result := make(map[string]*model.SetData)
 40: 
 41: 	// If no feed names specified, load all *.txt files
 42: 	if len(feedNames) == 0 {
 43: 		entries, err := os.ReadDir(feedsDir)
 44: 		if err != nil {
 45: 			return nil, fmt.Errorf("failed to read feeds directory: %w", err)
 46: 		}
 47: 
 48: 		for _, entry := range entries {
 49: 			if entry.IsDir() {
 50: 				continue
 51: 			}
 52: 			if strings.HasSuffix(entry.Name(), ".txt") {
 53: 				feedName := strings.TrimSuffix(entry.Name(), ".txt")
 54: 				feedNames = append(feedNames, feedName)
 55: 			}
 56: 		}
 57: 	}
 58: 
 59: 	// Load each feed
 60: 	for _, feedName := range feedNames {
 61: 		data, err := LoadFeed(feedsDir, feedName)
 62: 		if err != nil {
 63: 			// Log error but continue with other feeds
 64: 			fmt.Fprintf(os.Stderr, "WARNING: Failed to load feed %s: %v\n", feedName, err)
 65: 			continue
 66: 		}
 67: 
 68: 		if !data.IsEmpty() {
 69: 			result[feedName] = data
 70: 		}
 71: 	}
 72: 
 73: 	return result, nil
 74: }
 75: 
 76: // LoadFeed loads a single feed file and returns SetData
 77: func LoadFeed(feedsDir, feedName string) (*model.SetData, error) {
 78: 	// Normalize feed name (uppercase, underscores)
 79: 	normalizedName := strings.ToUpper(strings.ReplaceAll(feedName, "-", "_"))
 80: 
 81: 	// Try multiple filename patterns
 82: 	filenames := []string{
 83: 		filepath.Join(feedsDir, normalizedName+".txt"),
 84: 		filepath.Join(feedsDir, feedName+".txt"),
 85: 		filepath.Join(feedsDir, strings.ToLower(feedName)+".txt"),
 86: 	}
 87: 
 88: 	var file *os.File
 89: 	var err error
 90: 	var foundPath string
 91: 
 92: 	for _, path := range filenames {
 93: 		file, err = os.Open(path)
 94: 		if err == nil {
 95: 			foundPath = path
 96: 			break
 97: 		}
 98: 	}
 99: 
100: 	if file == nil {
101: 		return nil, fmt.Errorf("feed file not found: tried %v", filenames)
102: 	}
103: 	defer file.Close()
104: 
105: 	data := model.NewSetData(normalizedName)
106: 
107: 	scanner := bufio.NewScanner(file)
108: 	lineNum := 0
109: 
110: 	for scanner.Scan() {
111: 		lineNum++
112: 		line := strings.TrimSpace(scanner.Text())
113: 
114: 		// Skip empty lines and comments
115: 		if line == "" || strings.HasPrefix(line, "#") || strings.HasPrefix(line, ";") {
116: 			continue
117: 		}
118: 
119: 		// Parse IP or CIDR
120: 		if err := addIP(data, line); err != nil {
121: 			// Log but don't fail on individual line errors
122: 			fmt.Fprintf(os.Stderr, "WARNING: %s:%d: invalid IP/CIDR: %s (%v)\n",
123: 				foundPath, lineNum, line, err)
124: 		}
125: 	}
126: 
127: 	if err := scanner.Err(); err != nil {
128: 		return nil, fmt.Errorf("error reading feed %s: %w", foundPath, err)
129: 	}
130: 
131: 	return data, nil
132: }
133: 
134: // addIP adds an IP address or CIDR to the appropriate set (IPv4 or IPv6)
135: // Uses unified ParseFeedLine for consistent parsing across the codebase
136: func addIP(data *model.SetData, ipStr string) error {
137: 	entry, err := ParseFeedLine(ipStr)
138: 	if err != nil {
139: 		return err
140: 	}
141: 	if entry == nil {
142: 		return nil // Skip (comment or empty)
143: 	}
144: 
145: 	if entry.IPv4 {
146: 		data.AddIPv4(entry.Value)
147: 	} else {
148: 		data.AddIPv6(entry.Value)
149: 	}
150: 	return nil
151: }
152: 
153: // Merge combines multiple SetData into one
154: // Useful for consolidating multiple feeds into a single nftables set
155: func Merge(feeds map[string]*model.SetData) *model.SetData {
156: 	merged := model.NewSetData("merged_feeds")
157: 
158: 	for _, feed := range feeds {
159: 		for _, ip := range feed.IPv4 {
160: 			merged.AddIPv4(ip)
161: 		}
162: 		for _, ip := range feed.IPv6 {
163: 			merged.AddIPv6(ip)
164: 		}
165: 	}
166: 
167: 	return merged
168: }
</file>

<file path="pkg/feeds/parser.go">
  1: package feeds
  2: 
  3: import (
  4: 	"fmt"
  5: 	"net"
  6: 	"strings"
  7: 
  8: 	"github.com/itcmsgr/nftban/pkg/netutil"
  9: )
 10: 
 11: // ParsedEntry represents a parsed feed line
 12: type ParsedEntry struct {
 13: 	IPv4   bool   // true if IPv4, false if IPv6
 14: 	IsCIDR bool   // true if CIDR range, false if single IP
 15: 	Value  string // normalized IP or CIDR
 16: }
 17: 
 18: // ParseFeedLine parses a single line from a feed/blacklist/whitelist file
 19: // Handles multiple formats:
 20: //   - Plain IP: "1.2.3.4"
 21: //   - CIDR: "1.2.3.0/24"
 22: //   - With inline comment: "1.2.3.4 # some comment"
 23: //   - With whitespace-separated fields: "1.2.3.4   reason   timestamp"
 24: //
 25: // Returns nil, nil for empty lines and comments (skip)
 26: // Returns nil, error for invalid IPs/CIDRs
 27: func ParseFeedLine(line string) (*ParsedEntry, error) {
 28: 	line = strings.TrimSpace(line)
 29: 
 30: 	// Skip empty lines and full-line comments
 31: 	if line == "" || strings.HasPrefix(line, "#") || strings.HasPrefix(line, ";") {
 32: 		return nil, nil
 33: 	}
 34: 
 35: 	// Handle inline comments (both # and ;)
 36: 	if idx := strings.Index(line, "#"); idx >= 0 {
 37: 		line = strings.TrimSpace(line[:idx])
 38: 		if line == "" {
 39: 			return nil, nil
 40: 		}
 41: 	}
 42: 	if idx := strings.Index(line, ";"); idx >= 0 {
 43: 		line = strings.TrimSpace(line[:idx])
 44: 		if line == "" {
 45: 			return nil, nil
 46: 		}
 47: 	}
 48: 
 49: 	// Handle whitespace-separated format (IP<whitespace>comment/reason)
 50: 	// Only take the first field (the IP/CIDR)
 51: 	fields := strings.Fields(line)
 52: 	if len(fields) == 0 {
 53: 		return nil, nil
 54: 	}
 55: 	ipStr := fields[0]
 56: 
 57: 	// Parse CIDR
 58: 	if strings.Contains(ipStr, "/") {
 59: 		_, ipNet, err := net.ParseCIDR(ipStr)
 60: 		if err != nil {
 61: 			return nil, fmt.Errorf("invalid CIDR: %s", ipStr)
 62: 		}
 63: 		return &ParsedEntry{
 64: 			IPv4:   ipNet.IP.To4() != nil,
 65: 			IsCIDR: true,
 66: 			Value:  ipNet.String(),
 67: 		}, nil
 68: 	}
 69: 
 70: 	// Parse single IP
 71: 	ip := net.ParseIP(ipStr)
 72: 	if ip == nil {
 73: 		return nil, fmt.Errorf("invalid IP: %s", ipStr)
 74: 	}
 75: 
 76: 	// Normalize IP representation
 77: 	normalized := ip.String()
 78: 
 79: 	return &ParsedEntry{
 80: 		IPv4:   ip.To4() != nil,
 81: 		IsCIDR: false,
 82: 		Value:  normalized,
 83: 	}, nil
 84: }
 85: 
 86: // ParseFeedLineStrict is like ParseFeedLine but returns error for invalid entries
 87: // Use this when you want to know about parsing failures
 88: func ParseFeedLineStrict(line string) (*ParsedEntry, error) {
 89: 	return ParseFeedLine(line)
 90: }
 91: 
 92: // ParseFeedLineSilent parses a line and returns nil for both skip and error cases
 93: // Use this when you want to silently ignore invalid entries (like the original loader)

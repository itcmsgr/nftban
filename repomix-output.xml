  1: package auth
  2: 
  3: import (
  4: 	"bufio"
  5: 	"context"
  6: 	"encoding/json"
  7: 	"fmt"
  8: 	"log"
  9: 	"net"
 10: 	"os/user"
 11: 	"time"
 12: 
 13: 	"github.com/golang-jwt/jwt/v5"
 14: 	"github.com/itcmsgr/nftban/internal/authproto"
 15: 	"github.com/itcmsgr/nftban/internal/config"
 16: )
 17: 
 18: // PAMAuth handles PAM-based authentication
 19: type PAMAuth struct {
 20: 	config *config.Config
 21: }
 22: 
 23: // User represents an authenticated user
 24: type User struct {
 25: 	Username string
 26: 	UID      string
 27: 	GID      string
 28: 	Groups   []string
 29: }
 30: 
 31: // Claims represents JWT claims
 32: type Claims struct {
 33: 	Username string   `json:"username"`
 34: 	Groups   []string `json:"groups"`
 35: 	jwt.RegisteredClaims
 36: }
 37: 
 38: // =============================================================================
 39: // RBAC Helper Methods for Claims
 40: // =============================================================================
 41: 
 42: // HasGroup checks if the user belongs to a specific group
 43: func (c *Claims) HasGroup(group string) bool {
 44: 	for _, g := range c.Groups {
 45: 		if g == group {
 46: 			return true
 47: 		}
 48: 	}
 49: 	return false
 50: }
 51: 
 52: // HasAnyGroup checks if the user belongs to any of the specified groups
 53: func (c *Claims) HasAnyGroup(groups ...string) bool {
 54: 	for _, required := range groups {
 55: 		if c.HasGroup(required) {
 56: 			return true
 57: 		}
 58: 	}
 59: 	return false
 60: }
 61: 
 62: // HasAllGroups checks if the user belongs to all of the specified groups
 63: func (c *Claims) HasAllGroups(groups ...string) bool {
 64: 	for _, required := range groups {
 65: 		if !c.HasGroup(required) {
 66: 			return false
 67: 		}
 68: 	}
 69: 	return true
 70: }
 71: 
 72: // IsAdmin checks if the user has admin privileges (root, wheel, sudo, or nftban-admin)
 73: func (c *Claims) IsAdmin() bool {
 74: 	return c.HasAnyGroup("root", "wheel", "sudo", "nftban-admin")
 75: }
 76: 
 77: // IsOperator checks if the user has operator privileges (can view/search but not modify)
 78: func (c *Claims) IsOperator() bool {
 79: 	return c.HasAnyGroup("nftban-operator", "nftban-admin") || c.IsAdmin()
 80: }
 81: 
 82: // CanModify checks if the user can modify firewall rules (ban/unban/whitelist)
 83: func (c *Claims) CanModify() bool {
 84: 	return c.IsAdmin() // Only admins can modify by default
 85: }
 86: 
 87: // CanViewLogs checks if the user can view log files
 88: func (c *Claims) CanViewLogs() bool {
 89: 	return c.IsOperator() // Operators and admins can view logs
 90: }
 91: 
 92: // MinJWTSecretLength is the minimum required length for JWT secrets (32 bytes = 256 bits)
 93: const MinJWTSecretLength = 32
 94: 
 95: // NewPAMAuth creates a new PAM authentication handler
 96: // Returns error if JWT secret is too short (security requirement)
 97: func NewPAMAuth(cfg *config.Config) (*PAMAuth, error) {
 98: 	// SECURITY: Enforce minimum JWT secret length
 99: 	if len(cfg.JWTSecret) < MinJWTSecretLength {
100: 		return nil, fmt.Errorf("JWT secret too short: got %d bytes, minimum %d bytes required", len(cfg.JWTSecret), MinJWTSecretLength)
101: 	}
102: 	return &PAMAuth{
103: 		config: cfg,
104: 	}, nil
105: }
106: 
107: // AuthRequest is an alias to shared authproto.AuthRequest
108: type AuthRequest = authproto.AuthRequest
109: 
110: // AuthResponse is an alias to shared authproto.AuthResponse
111: type AuthResponse = authproto.AuthResponse
112: 
113: // Authenticate validates user credentials via Unix socket to auth service
114: func (p *PAMAuth) Authenticate(username, password string) (*User, error) {
115: 	// SECURITY: Block root login if configured
116: 	if p.config.BlockRootLogin && username == "root" {
117: 		log.Printf("[SECURITY] Root login attempt blocked for username: %s", username)
118: 		return nil, fmt.Errorf("root login is disabled")
119: 	}
120: 
121: 	// Connect to authentication socket
122: 	const socketPath = "/run/nftban-ui/auth.sock"
123: 
124: 	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
125: 	defer cancel()
126: 
127: 	var d net.Dialer
128: 	conn, err := d.DialContext(ctx, "unix", socketPath)
129: 	if err != nil {
130: 		log.Printf("[ERROR] Failed to connect to auth socket: %v", err)
131: 		return nil, fmt.Errorf("authentication service unavailable")
132: 	}
133: 	defer conn.Close()
134: 
135: 	// Send authentication request
136: 	req := AuthRequest{
137: 		Username: username,
138: 		Password: password,
139: 	}
140: 
141: 	reqData, err := json.Marshal(req)
142: 	if err != nil {
143: 		return nil, fmt.Errorf("failed to prepare auth request: %w", err)
144: 	}
145: 
146: 	// Write request with newline
147: 	if _, err := conn.Write(append(reqData, '\n')); err != nil {
148: 		return nil, fmt.Errorf("failed to send auth request: %w", err)
149: 	}
150: 
151: 	// Read response
152: 	scanner := bufio.NewScanner(conn)
153: 	if !scanner.Scan() {
154: 		return nil, fmt.Errorf("failed to read auth response")
155: 	}
156: 
157: 	var resp AuthResponse
158: 	if err := json.Unmarshal(scanner.Bytes(), &resp); err != nil {
159: 		return nil, fmt.Errorf("failed to parse auth response: %w", err)
160: 	}
161: 
162: 	// Check authentication result
163: 	if !resp.Success {
164: 		log.Printf("[AUTH] Failed login attempt for user: %s", username)
165: 		return nil, fmt.Errorf("authentication failed: %s", resp.Error)
166: 	}
167: 
168: 	// Get user information
169: 	u, err := user.Lookup(username)
170: 	if err != nil {
171: 		return nil, fmt.Errorf("failed to lookup user: %w", err)
172: 	}
173: 
174: 	// Get user groups
175: 	groups, err := p.getUserGroups(u)
176: 	if err != nil {
177: 		return nil, fmt.Errorf("failed to get user groups: %w", err)
178: 	}
179: 
180: 	// Success
181: 	log.Printf("[AUTH] Successful login: %s (UID: %s)", username, u.Uid)
182: 
183: 	return &User{
184: 		Username: username,
185: 		UID:      u.Uid,
186: 		GID:      u.Gid,
187: 		Groups:   groups,
188: 	}, nil
189: }
190: 
191: // GenerateToken creates a JWT token for authenticated user
192: func (p *PAMAuth) GenerateToken(user *User) (string, error) {
193: 	// Create claims
194: 	claims := &Claims{
195: 		Username: user.Username,
196: 		Groups:   user.Groups,
197: 		RegisteredClaims: jwt.RegisteredClaims{
198: 			ExpiresAt: jwt.NewNumericDate(time.Now().Add(time.Duration(p.config.SessionTimeout) * time.Minute)),
199: 			IssuedAt:  jwt.NewNumericDate(time.Now()),
200: 			NotBefore: jwt.NewNumericDate(time.Now()),
201: 			Issuer:    "nftban-ui",
202: 			Subject:   user.Username,
203: 		},
204: 	}
205: 
206: 	// Create token
207: 	token := jwt.NewWithClaims(jwt.SigningMethodHS256, claims)
208: 
209: 	// Sign token
210: 	tokenString, err := token.SignedString([]byte(p.config.JWTSecret))
211: 	if err != nil {
212: 		return "", fmt.Errorf("failed to sign token: %w", err)
213: 	}
214: 
215: 	return tokenString, nil
216: }
217: 
218: // ValidateToken verifies and parses a JWT token
219: func (p *PAMAuth) ValidateToken(tokenString string) (*Claims, error) {
220: 	// Parse token
221: 	token, err := jwt.ParseWithClaims(tokenString, &Claims{}, func(token *jwt.Token) (interface{}, error) {
222: 		// Verify signing method
223: 		if _, ok := token.Method.(*jwt.SigningMethodHMAC); !ok {
224: 			return nil, fmt.Errorf("unexpected signing method: %v", token.Header["alg"])
225: 		}
226: 		return []byte(p.config.JWTSecret), nil
227: 	})
228: 
229: 	if err != nil {
230: 		return nil, fmt.Errorf("token validation failed: %w", err)
231: 	}
232: 
233: 	// Extract claims
234: 	if claims, ok := token.Claims.(*Claims); ok && token.Valid {
235: 		return claims, nil
236: 	}
237: 
238: 	return nil, fmt.Errorf("invalid token")
239: }
240: 
241: // getUserGroups retrieves all groups for a user
242: func (p *PAMAuth) getUserGroups(u *user.User) ([]string, error) {
243: 	gids, err := u.GroupIds()
244: 	if err != nil {
245: 		return nil, err
246: 	}
247: 
248: 	groups := make([]string, 0, len(gids))
249: 	for _, gid := range gids {
250: 		g, err := user.LookupGroupId(gid)
251: 		if err != nil {
252: 			continue
253: 		}
254: 		groups = append(groups, g.Name)
255: 	}
256: 
257: 	return groups, nil
258: }
259: 
260: // AuditLog writes an audit log entry
261: func (p *PAMAuth) AuditLog(username, action, result, clientIP string) {
262: 	// TODO: Write to audit log file
263: 	log.Printf("[AUDIT] User: %s | Action: %s | Result: %s | IP: %s", username, action, result, clientIP)
264: }

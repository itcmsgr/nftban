189: # Get elapsed time since start
190: # shellcheck disable=SC2120  # Argument is optional, defaults to NFTBAN_MODULE_LOAD_START
191: nftban_get_elapsed() {
192:     local start="${1:-$NFTBAN_MODULE_LOAD_START}"
193:     local now="${EPOCHREALTIME:-$(date +%s.%N)}"
194:     echo "$now - $start" | bc -l 2>/dev/null | awk '{printf "%.3f", $0}' || echo "0.000"

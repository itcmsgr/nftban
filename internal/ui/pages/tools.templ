// meta:description="Diagnostic tools page - IP check, GeoIP lookup, search, logs"
// =============================================================================

package pages

import (
	"strconv"
	"github.com/itcmsgr/nftban/internal/ui"
)

// Tools renders the diagnostic tools page (pfSense-style)
templ Tools(data ui.ToolsData) {
	@ui.LayoutWithNav("Tools", "tools") {
		<!-- Page Header -->
		<div class="page-header">
			<h1>Diagnostic Tools</h1>
			<div class="header-stats">
				<span class="stat-badge">Bans: { intToStr(data.TotalBans) }</span>
				<span class="stat-badge safe">Whitelist: { intToStr(data.TotalWhitelist) }</span>
				<span class="stat-badge info">Feeds: { intToStr(data.TotalFeeds) }</span>
			</div>
		</div>

		<!-- Tools Grid -->
		<div class="tools-grid">
			<!-- IP Check Tool (Main - Like pfSense packet capture) -->
			<div class="card tool-card tool-primary">
				<div class="card-header">
					<span class="card-title">IP Check / Emulate</span>
					<span class="tool-badge">Test Firewall Decision</span>
				</div>
				<div class="tool-body">
					<p class="tool-description">
						Test if an IP address would be blocked or allowed by the firewall.
						Shows which rule/set matches and why.
					</p>
					<form class="tool-form" hx-post="/api/v1/tools/check" hx-target="#ip-check-result" hx-swap="innerHTML">
						<div class="form-row">
							<input
								type="text"
								name="ip"
								class="form-input form-input-lg"
								placeholder="Enter IP address (e.g., 192.168.1.100 or 2001:db8::1)"
								required
								pattern="^[0-9a-fA-F.:\/]+$"
							/>
							<button type="submit" class="btn btn-primary btn-lg">
								Check IP
							</button>
						</div>
					</form>
					<div id="ip-check-result" class="tool-result">
						if data.LastIPCheck != nil {
							@IPCheckResultFragment(*data.LastIPCheck)
						}
					</div>
				</div>
			</div>

			<!-- GeoIP Lookup Tool -->
			<div class="card tool-card">
				<div class="card-header">
					<span class="card-title">GeoIP Lookup</span>
					<span class="tool-badge secondary">Location Info</span>
				</div>
				<div class="tool-body">
					<p class="tool-description">
						Look up geographic location, country, and ASN information for an IP.
					</p>
					<form class="tool-form" hx-post="/api/v1/tools/geoip" hx-target="#geoip-result" hx-swap="innerHTML">
						<div class="form-row">
							<input
								type="text"
								name="ip"
								class="form-input"
								placeholder="Enter IP address"
								required
							/>
							<button type="submit" class="btn btn-secondary">
								Lookup
							</button>
						</div>
					</form>
					<div id="geoip-result" class="tool-result">
						if data.LastGeoLookup != nil {
							@GeoLookupResultFragment(*data.LastGeoLookup)
						}
					</div>
				</div>
			</div>

			<!-- Search All Sets Tool -->
			<div class="card tool-card">
				<div class="card-header">
					<span class="card-title">Search All Sets</span>
					<span class="tool-badge info">Cross-Reference</span>
				</div>
				<div class="tool-body">
					<p class="tool-description">
						Search an IP across all sets: blacklist, whitelist, feeds, and geoban.
					</p>
					<form class="tool-form" hx-post="/api/v1/tools/search" hx-target="#search-result" hx-swap="innerHTML">
						<div class="form-row">
							<input
								type="text"
								name="ip"
								class="form-input"
								placeholder="Enter IP to search"
								required
							/>
							<button type="submit" class="btn btn-info">
								Search
							</button>
						</div>
					</form>
					<div id="search-result" class="tool-result">
						if data.LastSearch != nil {
							@SearchResultFragment(*data.LastSearch)
						}
					</div>
				</div>
			</div>

			<!-- Quick Actions -->
			<div class="card tool-card">
				<div class="card-header">
					<span class="card-title">Quick Actions</span>
				</div>
				<div class="tool-body">
					<div class="quick-actions-grid">
						<button
							class="quick-action-btn"
							hx-post="/api/v1/tools/flush-temp"
							hx-confirm="Flush all temporary bans?"
							hx-target="#quick-action-result"
						>
							<span class="qa-icon">🗑️</span>
							<span class="qa-label">Flush Temp Bans</span>
						</button>
						<button
							class="quick-action-btn"
							hx-post="/api/v1/tools/reload-feeds"
							hx-confirm="Reload all threat feeds?"
							hx-target="#quick-action-result"
						>
							<span class="qa-icon">🔄</span>
							<span class="qa-label">Reload Feeds</span>
						</button>
						<button
							class="quick-action-btn"
							hx-post="/api/v1/tools/sync-rules"
							hx-confirm="Sync nftables rules?"
							hx-target="#quick-action-result"
						>
							<span class="qa-icon">⚡</span>
							<span class="qa-label">Sync Rules</span>
						</button>
						<a href="/api/v1/export/bans?format=csv" class="quick-action-btn" download>
							<span class="qa-icon">📥</span>
							<span class="qa-label">Export Bans</span>
						</a>
					</div>
					<div id="quick-action-result" class="tool-result"></div>
				</div>
			</div>
		</div>

		<!-- Log Viewer Section -->
		<div class="card log-viewer-card">
			<div class="card-header">
				<span class="card-title">Live Log Viewer</span>
				<div class="log-controls">
					<select id="log-level-filter" class="form-select form-select-sm"
						hx-get="/ui/frag/logs"
						hx-trigger="change"
						hx-target="#log-entries"
						hx-include="[name='log-filter']"
					>
						<option value="all">All Levels</option>
						<option value="BAN">Bans Only</option>
						<option value="UNBAN">Unbans Only</option>
						<option value="ERROR">Errors</option>
						<option value="WARN">Warnings</option>
					</select>
					<input type="hidden" name="log-filter" id="log-filter-value"/>
					<button class="btn btn-sm btn-secondary" onclick="toggleLogPause()">
						<span id="log-pause-icon">⏸️</span> Pause
					</button>
				</div>
			</div>
			<div id="log-entries" class="log-entries" hx-get="/ui/frag/logs" hx-trigger="every 3s" hx-swap="innerHTML">
				@LogEntriesFragment(data.RecentLogs)
			</div>
		</div>

		<!-- Command Reference -->
		<div class="card">
			<div class="card-header">
				<span class="card-title">CLI Command Reference</span>
			</div>
			<div class="command-grid">
				<div class="command-item">
					<code>nftban check &lt;ip&gt;</code>
					<span>Check if IP is blocked</span>
				</div>
				<div class="command-item">
					<code>nftban search &lt;ip&gt;</code>
					<span>Search IP across all sets</span>
				</div>
				<div class="command-item">
					<code>nftban geoip &lt;ip&gt;</code>
					<span>GeoIP lookup</span>
				</div>
				<div class="command-item">
					<code>nftban emulate &lt;ip&gt;</code>
					<span>Simulate packet decision</span>
				</div>
				<div class="command-item">
					<code>nftban list bans</code>
					<span>List all banned IPs</span>
				</div>
				<div class="command-item">
					<code>nftban flush temp</code>
					<span>Remove temporary bans</span>
				</div>
			</div>
		</div>

		<style>
			.tools-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1.5rem;
				margin-bottom: 1.5rem;
			}
			@media (max-width: 1200px) {
				.tools-grid {
					grid-template-columns: 1fr;
				}
			}
			.tool-card {
				display: flex;
				flex-direction: column;
			}
			.tool-card.tool-primary {
				grid-column: span 2;
			}
			@media (max-width: 1200px) {
				.tool-card.tool-primary {
					grid-column: span 1;
				}
			}
			.tool-badge {
				font-size: 0.75rem;
				padding: 0.25rem 0.5rem;
				border-radius: 4px;
				background: var(--accent-blue);
				color: white;
			}
			.tool-badge.secondary {
				background: var(--text-muted);
			}
			.tool-badge.info {
				background: var(--accent-info);
			}
			.tool-body {
				padding: 1rem;
				flex: 1;
			}
			.tool-description {
				color: var(--text-muted);
				font-size: 0.9rem;
				margin-bottom: 1rem;
			}
			.tool-form {
				margin-bottom: 1rem;
			}
			.form-row {
				display: flex;
				gap: 0.5rem;
			}
			.form-row .form-input {
				flex: 1;
			}
			.form-input-lg {
				font-size: 1.1rem;
				padding: 0.75rem 1rem;
			}
			.btn-lg {
				padding: 0.75rem 1.5rem;
				font-size: 1rem;
			}
			.tool-result {
				margin-top: 1rem;
				min-height: 60px;
			}

			/* Result Cards */
			.result-card {
				background: var(--surface-elevated);
				border-radius: 8px;
				padding: 1rem;
				border-left: 4px solid var(--border-color);
			}
			.result-card.blocked {
				border-left-color: var(--accent-red);
				background: rgba(239, 68, 68, 0.1);
			}
			.result-card.allowed {
				border-left-color: var(--accent-green);
				background: rgba(16, 185, 129, 0.1);
			}
			.result-card.whitelisted {
				border-left-color: var(--accent-blue);
				background: rgba(59, 130, 246, 0.1);
			}
			.result-header {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				margin-bottom: 0.75rem;
			}
			.result-status {
				font-size: 1.5rem;
			}
			.result-ip {
				font-family: var(--font-mono);
				font-size: 1.1rem;
				font-weight: 600;
			}
			.result-verdict {
				font-weight: 600;
				text-transform: uppercase;
			}
			.result-details {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 0.5rem;
				font-size: 0.9rem;
			}
			.result-detail {
				display: flex;
				gap: 0.5rem;
			}
			.result-detail-label {
				color: var(--text-muted);
			}

			/* Quick Actions */
			.quick-actions-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 0.75rem;
			}
			.quick-action-btn {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.5rem;
				padding: 1rem;
				background: var(--surface-elevated);
				border: 1px solid var(--border-color);
				border-radius: 8px;
				cursor: pointer;
				transition: all 0.2s;
				text-decoration: none;
				color: var(--text-primary);
			}
			.quick-action-btn:hover {
				background: var(--surface-hover);
				border-color: var(--accent-blue);
			}
			.qa-icon {
				font-size: 1.5rem;
			}
			.qa-label {
				font-size: 0.85rem;
				font-weight: 500;
			}

			/* Log Viewer */
			.log-viewer-card {
				margin-bottom: 1.5rem;
			}
			.log-controls {
				display: flex;
				gap: 0.5rem;
				align-items: center;
			}
			.form-select-sm {
				padding: 0.25rem 0.5rem;
				font-size: 0.85rem;
			}
			.log-entries {
				max-height: 400px;
				overflow-y: auto;
				font-family: var(--font-mono);
				font-size: 0.85rem;
				background: var(--surface-bg);
				padding: 0.5rem;
				border-radius: 4px;
			}
			.log-entry {
				padding: 0.25rem 0.5rem;
				border-bottom: 1px solid var(--border-color);
				display: flex;
				gap: 1rem;
			}
			.log-entry:last-child {
				border-bottom: none;
			}
			.log-entry.level-BAN {
				background: rgba(239, 68, 68, 0.1);
			}
			.log-entry.level-UNBAN {
				background: rgba(16, 185, 129, 0.1);
			}
			.log-entry.level-ERROR {
				background: rgba(239, 68, 68, 0.15);
			}
			.log-entry.level-WARN {
				background: rgba(245, 158, 11, 0.1);
			}
			.log-time {
				color: var(--text-muted);
				white-space: nowrap;
			}
			.log-level {
				font-weight: 600;
				width: 50px;
			}
			.log-level.BAN { color: var(--accent-red); }
			.log-level.UNBAN { color: var(--accent-green); }
			.log-level.ERROR { color: var(--accent-red); }
			.log-level.WARN { color: var(--accent-warning); }
			.log-level.INFO { color: var(--accent-blue); }
			.log-module {
				color: var(--accent-info);
				width: 80px;
			}
			.log-message {
				flex: 1;
				word-break: break-all;
			}
			.log-ip {
				font-weight: 600;
				color: var(--text-primary);
			}

			/* Command Reference */
			.command-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1rem;
				padding: 1rem;
			}
			@media (max-width: 1024px) {
				.command-grid {
					grid-template-columns: repeat(2, 1fr);
				}
			}
			@media (max-width: 768px) {
				.command-grid {
					grid-template-columns: 1fr;
				}
			}
			.command-item {
				display: flex;
				flex-direction: column;
				gap: 0.25rem;
			}
			.command-item code {
				background: var(--surface-elevated);
				padding: 0.5rem;
				border-radius: 4px;
				font-size: 0.85rem;
			}
			.command-item span {
				font-size: 0.8rem;
				color: var(--text-muted);
			}
		</style>

		<script>
			let logPaused = false;
			function toggleLogPause() {
				logPaused = !logPaused;
				const icon = document.getElementById('log-pause-icon');
				const entries = document.getElementById('log-entries');
				if (logPaused) {
					icon.textContent = '▶️';
					entries.removeAttribute('hx-trigger');
				} else {
					icon.textContent = '⏸️';
					entries.setAttribute('hx-trigger', 'every 3s');
					htmx.process(entries);
				}
			}
		</script>
	}
}

// IPCheckResultFragment renders IP check results
templ IPCheckResultFragment(result ui.IPCheckResult) {
	<div class={ "result-card", getResultClass(result.Status) }>
		<div class="result-header">
			<span class="result-status">{ getStatusEmoji(result.Status) }</span>
			<code class="result-ip">{ result.IP }</code>
			<span class={ "result-verdict", getVerdictClass(result.Status) }>{ result.Status }</span>
		</div>
		<div class="result-details">
			if result.Country != "" {
				<div class="result-detail">
					<span class="result-detail-label">Country:</span>
					<span>{ result.Country }</span>
				</div>
			}
			if result.Module != "" {
				<div class="result-detail">
					<span class="result-detail-label">Module:</span>
					<span>{ result.Module }</span>
				</div>
			}
			if result.Reason != "" {
				<div class="result-detail">
					<span class="result-detail-label">Reason:</span>
					<span>{ result.Reason }</span>
				</div>
			}
			if result.BannedSince != "" {
				<div class="result-detail">
					<span class="result-detail-label">Since:</span>
					<span>{ result.BannedSince }</span>
				</div>
			}
		</div>
	</div>
}

// GeoLookupResultFragment renders GeoIP lookup results
templ GeoLookupResultFragment(result ui.GeoLookupResult) {
	<div class={ "result-card", templ.KV("blocked", result.IsBlocked) }>
		<div class="result-header">
			<code class="result-ip">{ result.IP }</code>
			if result.IsBlocked {
				<span class="badge danger">GEO-BLOCKED</span>
			}
		</div>
		<div class="result-details">
			<div class="result-detail">
				<span class="result-detail-label">Country:</span>
				<span>{ result.Country } ({ result.CountryCode })</span>
			</div>
			if result.City != "" {
				<div class="result-detail">
					<span class="result-detail-label">City:</span>
					<span>{ result.City }</span>
				</div>
			}
			if result.Region != "" {
				<div class="result-detail">
					<span class="result-detail-label">Region:</span>
					<span>{ result.Region }</span>
				</div>
			}
			if result.ASN != "" {
				<div class="result-detail">
					<span class="result-detail-label">ASN:</span>
					<span>{ result.ASN }</span>
				</div>
			}
			if result.ASNOrg != "" {
				<div class="result-detail">
					<span class="result-detail-label">Organization:</span>
					<span>{ result.ASNOrg }</span>
				</div>
			}
			if result.BlockReason != "" {
				<div class="result-detail">
					<span class="result-detail-label">Block Reason:</span>
					<span>{ result.BlockReason }</span>
				</div>
			}
		</div>
	</div>
}

// SearchResultFragment renders cross-set search results
templ SearchResultFragment(result ui.SearchResult) {
	<div class="result-card">
		<div class="result-header">
			<code class="result-ip">{ result.IP }</code>
			if result.Found {
				<span class="badge warning">Found in { intToStr(result.TotalMatches) } set(s)</span>
			} else {
				<span class="badge safe">Not found in any set</span>
			}
		</div>
		if result.Found && len(result.FoundIn) > 0 {
			<table class="data-table" style="margin-top: 0.5rem;">
				<thead>
					<tr>
						<th>Set</th>
						<th>Type</th>
						<th>Match</th>
						<th>Reason</th>
					</tr>
				</thead>
				<tbody>
					for _, match := range result.FoundIn {
						<tr>
							<td><code>{ match.SetName }</code></td>
							<td><span class={ "badge", getSetTypeBadge(match.SetType) }>{ match.SetType }</span></td>
							<td>
								if match.MatchedCIDR != "" {
									<code>{ match.MatchedCIDR }</code> ({ match.EntryType })
								} else {
									{ match.EntryType }
								}
							</td>
							<td>{ match.Reason }</td>
						</tr>
					}
				</tbody>
			</table>
		}
	</div>
}

// LogEntriesFragment renders log entries
templ LogEntriesFragment(logs []ui.LogEntry) {
	if len(logs) == 0 {
		<div class="empty-state">No recent log entries</div>
	} else {
		for _, log := range logs {
			<div class={ "log-entry", "level-" + log.Level }>
				<span class="log-time">{ log.Timestamp }</span>
				<span class={ "log-level", log.Level }>{ log.Level }</span>
				<span class="log-module">{ log.Module }</span>
				<span class="log-message">
					if log.IP != "" {
						<span class="log-ip">{ log.IP }</span>
						{ " - " }
					}
					{ log.Message }
				</span>
			</div>
		}
	}
}

// Helper functions
func getResultClass(status string) string {
	switch status {
	case "banned", "blocked":
		return "blocked"
	case "whitelisted":
		return "whitelisted"
	case "clean", "allowed":
		return "allowed"
	default:
		return ""
	}
}

func getStatusEmoji(status string) string {
	switch status {
	case "banned", "blocked":
		return "🚫"
	case "whitelisted":
		return "✅"
	case "clean", "allowed":
		return "✔️"
	default:
		return "❓"
	}
}

func getVerdictClass(status string) string {
	switch status {
	case "banned", "blocked":
		return "text-danger"
	case "whitelisted":
		return "text-info"
	case "clean", "allowed":
		return "text-safe"
	default:
		return ""
	}
}

func getSetTypeBadge(setType string) string {
	switch setType {
	case "blacklist":
		return "danger"
	case "whitelist":
		return "safe"
	case "feed":
		return "warning"
	case "geoban":
		return "info"
	default:
		return "secondary"
	}
}

func intToStr(n int) string {
	return strconv.Itoa(n)
}

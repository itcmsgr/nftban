<file path="cli/lib/nftban/core/nftban_ddos_suricata.sh">
  1: #!/usr/bin/env bash
  2: # shellcheck disable=SC1083  # Braces in nftables syntax are literal, not bash
  3: # =============================================================================
  4: # NFTBan v1.0 - DDoS Protection Module - SURICATA MODE
  5: # =============================================================================
  6: # SPDX-License-Identifier: MPL-2.0
  7: # Purpose: Suricata IDS-integrated DDoS protection with scoring engine
  8: #
  9: # meta:name=nftban_ddos_suricata
 10: # meta:type=core
 11: # meta:header=DDoS Protection (Suricata)
 12: # meta:version=1.0.0
 13: #
 14: # **Description**
 15: # Intelligent DDoS protection using Suricata IDS alerts:
 16: # - EVE JSON parsing for real-time alerts
 17: # - Signature-based detection (DDoS categories)
 18: # - Scoring engine with multi-signal correlation
 19: # - Integration with feeds, GeoIP for enrichment
 20: #
 21: # **When to use Suricata Mode:**
 22: # - Suricata IDS is installed and running
 23: # - Deep packet inspection required
 24: # - Protocol-aware detection needed
 25: # - AI-ready scoring pipeline
 26: #
 27: # meta:depends=bash>=4.0,nftables>=0.9.0,suricata,jq
 28: # meta:created_date=2025-12-01
 29: # meta:updated_date=2025-12-01
 30: # =============================================================================
 31: 
 32: # =============================================================================
 33: # MODULE GUARD
 34: # =============================================================================
 35: 
 36: [[ -n "${NFTBAN_DDOS_SURICATA_LOADED:-}" ]] && return 0
 37: readonly NFTBAN_DDOS_SURICATA_LOADED=1
 38: 
 39: # =============================================================================
 40: # CONFIGURATION LOADING
 41: # =============================================================================
 42: 
 43: _nftban_ddos_suricata_load_config() {
 44:     local config_file="${NFTBAN_CONFIG_DIR:-/etc/nftban}/conf.d/ddos/suricata.conf"
 45: 
 46:     if [[ -f "$config_file" ]]; then
 47:         # shellcheck source=/dev/null
 48:         source "$config_file"
 49:     fi
 50: 
 51:     # Set defaults if not configured
 52:     : "${DDOS_SURICATA_EVE_FILE:=/var/log/suricata/eve.json}"
 53:     : "${DDOS_SURICATA_EVE_SOCKET:=}"
 54:     : "${DDOS_SURICATA_SIG_PATTERNS:=DDoS|flood|amplification|reflection|slowloris}"
 55:     : "${DDOS_SURICATA_CATEGORIES:=attempted-dos,successful-dos,denial-of-service}"
 56: 
 57:     # Scoring defaults (Severity: 1=High, 2=Medium, 3=Low, 4=Info - matches Go)
 58:     : "${DDOS_SURICATA_SCORE_SEVERITY_1:=0.50}"
 59:     : "${DDOS_SURICATA_SCORE_SEVERITY_2:=0.35}"
 60:     : "${DDOS_SURICATA_SCORE_SEVERITY_3:=0.20}"
 61:     : "${DDOS_SURICATA_SCORE_SEVERITY_4:=0.10}"
 62:     : "${DDOS_SURICATA_SCORE_REPEAT_5:=0.10}"
 63:     : "${DDOS_SURICATA_SCORE_REPEAT_10:=0.20}"
 64:     : "${DDOS_SURICATA_SCORE_REPEAT_20:=0.30}"
 65:     : "${DDOS_SURICATA_SCORE_BAD_REPUTATION:=0.15}"
 66:     : "${DDOS_SURICATA_SCORE_HIGH_RISK_GEO:=0.10}"
 67: 
 68:     # Action thresholds
 69:     : "${DDOS_SURICATA_THRESHOLD_OBSERVE:=0.30}"
 70:     : "${DDOS_SURICATA_THRESHOLD_BLOCK_SHORT:=0.50}"
 71:     : "${DDOS_SURICATA_THRESHOLD_BLOCK_LONG:=0.70}"
 72:     : "${DDOS_SURICATA_THRESHOLD_BLOCK_PERMANENT:=0.90}"
 73: 
 74:     # Ban durations
 75:     : "${DDOS_SURICATA_BAN_DURATION_SHORT:=600}"
 76:     : "${DDOS_SURICATA_BAN_DURATION_LONG:=3600}"
 77:     : "${DDOS_SURICATA_BAN_DURATION_PERMANENT:=86400}"
 78:     : "${DDOS_SURICATA_SCORE_DECAY:=3600}"
 79:     : "${DDOS_SURICATA_ALERT_WINDOW:=120}"
 80: 
 81:     # Integration
 82:     : "${DDOS_SURICATA_USE_FEEDS:=true}"
 83:     : "${DDOS_SURICATA_USE_GEOIP:=true}"
 84:     : "${DDOS_SURICATA_USE_CLASSIC_LAYER0:=true}"
 85: 
 86:     # Performance
 87:     : "${DDOS_SURICATA_BATCH_SIZE:=100}"
 88:     : "${DDOS_SURICATA_POLL_INTERVAL_MS:=500}"
 89: 
 90:     # Logging
 91:     : "${DDOS_SURICATA_LOG_FILE:=/var/log/nftban/ddos-suricata.log}"
 92:     : "${DDOS_SURICATA_LOG_LEVEL:=INFO}"
 93:     : "${DDOS_SURICATA_LOG_SCORES:=true}"
 94: }
 95: 
 96: # =============================================================================
 97: # LOGGING
 98: # =============================================================================
 99: 
100: _nftban_ddos_suricata_log() {
101:     local level="$1"
102:     local message="$2"
103:     local log_file="${DDOS_SURICATA_LOG_FILE:-/var/log/nftban/ddos-suricata.log}"
104: 
105:     mkdir -p "$(dirname "$log_file")" 2>/dev/null
106: 
107:     echo "[$(date '+%Y-%m-%d %H:%M:%S')] [SURICATA] [$level] $message" >> "$log_file"
108: }
109: 
110: # =============================================================================
111: # SURICATA DETECTION (Is Suricata Available?)
112: # =============================================================================
113: 
114: # Check if Suricata binary exists
115: nftban_ddos_suricata_binary_exists() {
116:     local binary="${DDOS_SURICATA_BINARY:-/usr/bin/suricata}"
117:     [[ -x "$binary" ]] || command -v suricata &>/dev/null
118: }
119: 
120: # Check if Suricata service is running
121: nftban_ddos_suricata_service_running() {
122:     local service="${DDOS_SURICATA_SERVICE_NAME:-suricata}"
123: 
124:     # Try systemctl first
125:     if command -v systemctl &>/dev/null; then
126:         systemctl is-active --quiet "$service" 2>/dev/null && return 0
127:     fi
128: 
129:     # Try service command
130:     if command -v service &>/dev/null; then
131:         service "$service" status &>/dev/null && return 0
132:     fi
133: 
134:     # Check for running process
135:     pgrep -x suricata &>/dev/null && return 0
136:     pgrep -f "suricata.*-c" &>/dev/null && return 0
137: 
138:     return 1
139: }
140: 
141: # Check if EVE JSON file exists and is fresh
142: nftban_ddos_suricata_eve_active() {
143:     local eve_file="${DDOS_SURICATA_EVE_FILE:-/var/log/suricata/eve.json}"
144:     local threshold="${DDOS_EVE_FRESHNESS_THRESHOLD:-60}"
145: 
146:     # File must exist
147:     [[ -f "$eve_file" ]] || return 1
148: 
149:     # File must be readable
150:     [[ -r "$eve_file" ]] || return 1
151: 
152:     # Check freshness (modified within threshold seconds)
153:     local now file_mtime age
154:     now=$(date +%s)
155:     file_mtime=$(stat -c %Y "$eve_file" 2>/dev/null || stat -f %m "$eve_file" 2>/dev/null)
156: 
157:     if [[ -n "$file_mtime" ]]; then
158:         age=$((now - file_mtime))
159:         [[ $age -le $threshold ]] && return 0
160:     fi
161: 
162:     return 1
163: }
164: 
165: # Combined check: Is Suricata fully operational?
166: nftban_ddos_suricata_is_available() {
167:     local check_binary="${DDOS_AUTO_CHECK_BINARY:-true}"
168:     local check_service="${DDOS_AUTO_CHECK_SERVICE:-true}"
169:     local check_eve="${DDOS_AUTO_CHECK_EVE_FILE:-true}"
170: 
171:     # Check binary
172:     if [[ "$check_binary" == "true" ]]; then
173:         if ! nftban_ddos_suricata_binary_exists; then
174:             return 1
175:         fi
176:     fi
177: 
178:     # Check service
179:     if [[ "$check_service" == "true" ]]; then
180:         if ! nftban_ddos_suricata_service_running; then
181:             return 1
182:         fi
183:     fi
184: 
185:     # Check EVE file
186:     if [[ "$check_eve" == "true" ]]; then
187:         if ! nftban_ddos_suricata_eve_active; then
188:             return 1
189:         fi
190:     fi
191: 
192:     return 0
193: }
194: 
195: # Get Suricata status details
196: nftban_ddos_suricata_get_status() {
197:     local status=""
198: 
199:     if nftban_ddos_suricata_binary_exists; then
200:         local version
201:         version=$(suricata -V 2>/dev/null | head -1 | grep -oP '\d+\.\d+\.\d+' || echo "unknown")
202:         status+="binary=OK(v$version) "
203:     else
204:         status+="binary=MISSING "
205:     fi
206: 
207:     if nftban_ddos_suricata_service_running; then
208:         status+="service=RUNNING "
209:     else
210:         status+="service=STOPPED "
211:     fi
212: 
213:     local eve_file="${DDOS_SURICATA_EVE_FILE:-/var/log/suricata/eve.json}"
214:     if [[ -f "$eve_file" ]]; then
215:         if nftban_ddos_suricata_eve_active; then
216:             local size
217:             size=$(du -h "$eve_file" 2>/dev/null | cut -f1)
218:             status+="eve=ACTIVE($size) "
219:         else
220:             status+="eve=STALE "
221:         fi
222:     else
223:         status+="eve=MISSING "
224:     fi
225: 
226:     echo "$status"
227: }
228: 
229: # =============================================================================
230: # EVE JSON PARSING
231: # =============================================================================
232: 
233: # Parse EVE JSON and extract DDoS-related alerts
234: _nftban_ddos_suricata_parse_eve() {
235:     local eve_file="${DDOS_SURICATA_EVE_FILE:-/var/log/suricata/eve.json}"
236:     local patterns="${DDOS_SURICATA_SIG_PATTERNS}"
237:     local window="${DDOS_SURICATA_ALERT_WINDOW:-120}"
238: 
239:     # Check if jq is available
240:     if ! command -v jq &>/dev/null; then
241:         _nftban_ddos_suricata_log "ERROR" "jq not found - required for EVE parsing"
242:         return 1
243:     fi
244: 
245:     # Get alerts from last N seconds
246:     local since
247:     since=$(date -d "-${window} seconds" '+%Y-%m-%dT%H:%M:%S' 2>/dev/null || \
248:             date -v-${window}S '+%Y-%m-%dT%H:%M:%S' 2>/dev/null)
249: 
250:     # Parse and filter alerts
251:     tail -n 10000 "$eve_file" 2>/dev/null | \
252:     jq -r --arg since "$since" --arg patterns "$patterns" '
253:         select(.event_type == "alert") |
254:         select(.timestamp >= $since) |
255:         select(.alert.signature | test($patterns; "i")) |
256:         [.src_ip, .alert.severity, .alert.signature, .alert.category] | @tsv
257:     ' 2>/dev/null
258: }
259: 
260: # Count alerts per IP in window
261: _nftban_ddos_suricata_count_alerts() {
262:     local ip="$1"
263:     local eve_file="${DDOS_SURICATA_EVE_FILE:-/var/log/suricata/eve.json}"
264:     local window="${DDOS_SURICATA_ALERT_WINDOW:-120}"
265: 
266:     local since
267:     since=$(date -d "-${window} seconds" '+%Y-%m-%dT%H:%M:%S' 2>/dev/null || \
268:             date -v-${window}S '+%Y-%m-%dT%H:%M:%S' 2>/dev/null)
269: 
270:     tail -n 10000 "$eve_file" 2>/dev/null | \
271:     jq -r --arg since "$since" --arg ip "$ip" '
272:         select(.event_type == "alert") |
273:         select(.timestamp >= $since) |
274:         select(.src_ip == $ip) |
275:         .src_ip
276:     ' 2>/dev/null | wc -l
277: }
278: 
279: # =============================================================================
280: # SCORING ENGINE
281: # =============================================================================
282: 
283: # Calculate score for an IP based on alerts
284: _nftban_ddos_suricata_calculate_score() {
285:     local ip="$1"
286:     local severity="$2"
287:     local signature="$3"
288: 
289:     local score=0
290: 
291:     # Base score from severity
292:     case "$severity" in
293:         1) score=$(echo "$score + $DDOS_SURICATA_SCORE_SEVERITY_1" | bc -l) ;;
294:         2) score=$(echo "$score + $DDOS_SURICATA_SCORE_SEVERITY_2" | bc -l) ;;
295:         3) score=$(echo "$score + $DDOS_SURICATA_SCORE_SEVERITY_3" | bc -l) ;;
296:         4) score=$(echo "$score + $DDOS_SURICATA_SCORE_SEVERITY_4" | bc -l) ;;
297:     esac
298: 
299:     # Bonus for specific attack types
300:     if echo "$signature" | grep -qi "syn.*flood"; then
301:         score=$(echo "$score + ${DDOS_SURICATA_SCORE_SYN_FLOOD:-0.15}" | bc -l)
302:     fi
303:     if echo "$signature" | grep -qi "amplification\|reflection"; then
304:         score=$(echo "$score + ${DDOS_SURICATA_SCORE_AMPLIFICATION:-0.20}" | bc -l)
305:     fi
306: 
307:     # Repetition bonus
308:     local alert_count
309:     alert_count=$(_nftban_ddos_suricata_count_alerts "$ip")
310: 
311:     if [[ $alert_count -ge 20 ]]; then
312:         score=$(echo "$score + $DDOS_SURICATA_SCORE_REPEAT_20" | bc -l)
313:     elif [[ $alert_count -ge 10 ]]; then
314:         score=$(echo "$score + $DDOS_SURICATA_SCORE_REPEAT_10" | bc -l)
315:     elif [[ $alert_count -ge 5 ]]; then
316:         score=$(echo "$score + $DDOS_SURICATA_SCORE_REPEAT_5" | bc -l)
317:     fi
318: 
319:     # Feed reputation (if enabled and function exists)
320:     if [[ "$DDOS_SURICATA_USE_FEEDS" == "true" ]]; then
321:         if type -t nftban_feeds_check_ip &>/dev/null; then
322:             if nftban_feeds_check_ip "$ip" &>/dev/null; then
323:                 score=$(echo "$score + $DDOS_SURICATA_SCORE_BAD_REPUTATION" | bc -l)
324:             fi
325:         fi
326:     fi
327: 
328:     # GeoIP risk (if enabled and function exists)
329:     if [[ "$DDOS_SURICATA_USE_GEOIP" == "true" ]]; then
330:         if type -t nftban_geoip_lookup &>/dev/null; then
331:             local country
332:             country=$(nftban_geoip_lookup "$ip" 2>/dev/null)
333:             # High-risk countries (configurable)
334:             if echo "$country" | grep -qE "^(CN|RU|KP|IR)$"; then
335:                 score=$(echo "$score + $DDOS_SURICATA_SCORE_HIGH_RISK_GEO" | bc -l)
336:             fi
337:         fi
338:     fi
339: 
340:     # Clamp to 0.0 - 1.0
341:     if (( $(echo "$score > 1.0" | bc -l) )); then
342:         score="1.0"
343:     fi
344:     if (( $(echo "$score < 0.0" | bc -l) )); then
345:         score="0.0"
346:     fi
347: 
348:     echo "$score"
349: }
350: 
351: # Decide action based on score
352: _nftban_ddos_suricata_decide_action() {
353:     local ip="$1"
354:     local score="$2"
355: 
356:     if (( $(echo "$score >= $DDOS_SURICATA_THRESHOLD_BLOCK_PERMANENT" | bc -l) )); then
357:         echo "block_permanent"
358:     elif (( $(echo "$score >= $DDOS_SURICATA_THRESHOLD_BLOCK_LONG" | bc -l) )); then
359:         echo "block_long"
360:     elif (( $(echo "$score >= $DDOS_SURICATA_THRESHOLD_BLOCK_SHORT" | bc -l) )); then
361:         echo "block_short"
362:     elif (( $(echo "$score >= $DDOS_SURICATA_THRESHOLD_OBSERVE" | bc -l) )); then
363:         echo "observe"
364:     else
365:         echo "ignore"
366:     fi
367: }
368: 
369: # =============================================================================
370: # BLOCKING ACTIONS
371: # =============================================================================
372: 
373: _nftban_ddos_suricata_block_ip() {
374:     local ip="$1"
375:     local duration="$2"
376:     local reason="$3"
377: 
378:     local table="${DDOS_NFT_TABLE_IPV4:-ip nftban}"
379:     local set="${DDOS_CLASSIC_BLOCK_SET:-ddos_blocked}"
380: 
381:     # Add to nftables set with timeout
382:     nft add element $table "$set" { "$ip" timeout "${duration}s" } 2>/dev/null || {
383:         # Set might not exist, create it
384:         nft add set $table "$set" { type ipv4_addr \; flags timeout \; } 2>/dev/null
385:         nft add element $table "$set" { "$ip" timeout "${duration}s" } 2>/dev/null
386:     }
387: 
388:     _nftban_ddos_suricata_log "INFO" "BLOCKED ip=$ip duration=${duration}s reason=$reason"
389: }
390: 
391: # =============================================================================
392: # MAIN PROCESSING LOOP
393: # =============================================================================
394: 
395: _nftban_ddos_suricata_process_alerts() {
396:     _nftban_ddos_suricata_load_config
397: 
398:     local processed=0
399:     local blocked=0
400: 
401:     # shellcheck disable=SC2034  # Structured Suricata parsing - only some fields used
402:     while IFS=$'\t' read -r ip severity signature category; do
403:         [[ -z "$ip" ]] && continue
404: 
405:         # Skip private/local IPs
406:         if echo "$ip" | grep -qE "^(127\.|10\.|172\.(1[6-9]|2[0-9]|3[01])\.|192\.168\.)"; then
407:             continue
408:         fi
409: 
410:         # Calculate score
411:         local score
412:         score=$(_nftban_ddos_suricata_calculate_score "$ip" "$severity" "$signature")
413: 
414:         # Decide action
415:         local action
416:         action=$(_nftban_ddos_suricata_decide_action "$ip" "$score")
417: 
418:         if [[ "$DDOS_SURICATA_LOG_SCORES" == "true" ]]; then
419:             _nftban_ddos_suricata_log "DEBUG" "ip=$ip severity=$severity score=$score action=$action sig=$signature"
420:         fi
421: 
422:         case "$action" in
423:             block_permanent)
424:                 _nftban_ddos_suricata_block_ip "$ip" "$DDOS_SURICATA_BAN_DURATION_PERMANENT" "permanent_threat"
425:                 ((blocked++))
426:                 ;;
427:             block_long)
428:                 _nftban_ddos_suricata_block_ip "$ip" "$DDOS_SURICATA_BAN_DURATION_LONG" "high_threat"
429:                 ((blocked++))
430:                 ;;
431:             block_short)
432:                 _nftban_ddos_suricata_block_ip "$ip" "$DDOS_SURICATA_BAN_DURATION_SHORT" "medium_threat"
433:                 ((blocked++))
434:                 ;;
435:             observe)
436:                 _nftban_ddos_suricata_log "INFO" "OBSERVE ip=$ip score=$score"
437:                 ;;
438:         esac
439: 
440:         ((processed++))
441: 
442:     done < <(_nftban_ddos_suricata_parse_eve)
443: 
444:     echo "processed=$processed blocked=$blocked"
445: }
446: 
447: # =============================================================================
448: # PUBLIC API
449: # =============================================================================
450: 
451: nftban_ddos_suricata_enable() {
452:     _nftban_ddos_suricata_load_config
453: 
454:     echo ""
455:     echo "Enabling Suricata DDoS Protection..."
456:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
457: 
458:     # Check Suricata availability
459:     if ! nftban_ddos_suricata_is_available; then
460:         echo ""
461:         echo "  ERROR: Suricata is not available!"
462:         echo ""
463:         echo "  Status: $(nftban_ddos_suricata_get_status)"
464:         echo ""
465:         echo "  To use Suricata mode:"
466:         echo "    1. Install Suricata: apt install suricata"
467:         echo "    2. Start service:    systemctl start suricata"
468:         echo "    3. Verify EVE log:   ls -la $DDOS_SURICATA_EVE_FILE"
469:         echo ""
470:         return 1
471:     fi
472: 
473:     echo "  Suricata: $(nftban_ddos_suricata_get_status)"
474:     echo ""
475: 
476:     # Enable Classic Layer 0 if configured
477:     if [[ "$DDOS_SURICATA_USE_CLASSIC_LAYER0" == "true" ]]; then
478:         echo "  Enabling Classic Layer 0 (hard limits)..."
479:         if type -t nftban_ddos_classic_enable &>/dev/null; then
480:             nftban_ddos_classic_enable
481:         fi
482:     fi
483: 
484:     # Create block set if not exists
485:     local table="${DDOS_NFT_TABLE_IPV4:-ip nftban}"
486:     local set="${DDOS_CLASSIC_BLOCK_SET:-ddos_blocked}"
487: 
488:     nft add set $table "$set" { type ipv4_addr \; flags timeout \; } 2>/dev/null || true
489: 
490:     # Add drop rule for blocked set
491:     if ! nft list chain $table input 2>/dev/null | grep -q "@$set drop"; then
492:         nft add rule $table input ip saddr @"$set" counter drop \
493:             comment "\"DDoS Suricata blocked\"" 2>/dev/null || true
494:     fi
495: 
496:     echo ""
497:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
498:     echo "Suricata DDoS Protection ENABLED"
499:     echo ""
500:     echo "  EVE File:        $DDOS_SURICATA_EVE_FILE"
501:     echo "  Block Threshold: $DDOS_SURICATA_THRESHOLD_BLOCK_SHORT"
502:     echo "  Alert Window:    ${DDOS_SURICATA_ALERT_WINDOW}s"
503:     echo "  Use Feeds:       $DDOS_SURICATA_USE_FEEDS"
504:     echo "  Use GeoIP:       $DDOS_SURICATA_USE_GEOIP"
505:     echo "  Classic Layer0:  $DDOS_SURICATA_USE_CLASSIC_LAYER0"
506:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
507:     echo ""
508: 
509:     _nftban_ddos_suricata_log "INFO" "Suricata DDoS protection enabled"
510: 
511:     return 0
512: }
513: 
514: nftban_ddos_suricata_disable() {
515:     _nftban_ddos_suricata_load_config
516: 
517:     echo ""
518:     echo "Disabling Suricata DDoS Protection..."
519:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
520: 
521:     # Disable Classic Layer 0 if it was enabled
522:     if [[ "$DDOS_SURICATA_USE_CLASSIC_LAYER0" == "true" ]]; then
523:         if type -t nftban_ddos_classic_disable &>/dev/null; then
524:             nftban_ddos_classic_disable
525:         fi
526:     fi
527: 
528:     # Flush block set
529:     local table="${DDOS_NFT_TABLE_IPV4:-ip nftban}"
530:     local set="${DDOS_CLASSIC_BLOCK_SET:-ddos_blocked}"
531: 
532:     nft flush set $table "$set" 2>/dev/null || true
533: 
534:     echo ""
535:     echo "Suricata DDoS protection disabled"
536:     echo ""
537: 
538:     _nftban_ddos_suricata_log "INFO" "Suricata DDoS protection disabled"
539: 
540:     return 0
541: }
542: 
543: nftban_ddos_suricata_status() {
544:     _nftban_ddos_suricata_load_config
545: 
546:     echo ""
547:     echo "Suricata DDoS Protection Status"
548:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
549: 
550:     # Suricata availability
551:     echo ""
552:     echo "Suricata IDS:"
553:     if nftban_ddos_suricata_binary_exists; then
554:         local version
555:         version=$(suricata -V 2>/dev/null | head -1 | grep -oP '\d+\.\d+\.\d+' || echo "?")
556:         echo "  Binary:  OK (v$version)"
557:     else
558:         echo "  Binary:  NOT FOUND"
559:     fi
560: 
561:     if nftban_ddos_suricata_service_running; then
562:         echo "  Service: RUNNING"
563:     else
564:         echo "  Service: STOPPED"
565:     fi
566: 
567:     local eve_file="${DDOS_SURICATA_EVE_FILE:-/var/log/suricata/eve.json}"
568:     if [[ -f "$eve_file" ]]; then
569:         local size age
570:         size=$(du -h "$eve_file" 2>/dev/null | cut -f1)
571:         local mtime
572:         mtime=$(stat -c %Y "$eve_file" 2>/dev/null || stat -f %m "$eve_file" 2>/dev/null)
573:         age=$(($(date +%s) - mtime))
574:         if [[ $age -le 60 ]]; then
575:             echo "  EVE Log: ACTIVE (${size}, ${age}s ago)"
576:         else
577:             echo "  EVE Log: STALE (${size}, ${age}s ago)"
578:         fi
579:     else
580:         echo "  EVE Log: NOT FOUND ($eve_file)"
581:     fi
582: 
583:     # Overall status
584:     echo ""
585:     if nftban_ddos_suricata_is_available; then
586:         echo "  Overall: READY"
587:     else
588:         echo "  Overall: NOT READY"
589:     fi
590: 
591:     # Configuration
592:     echo ""
593:     echo "Configuration:"
594:     echo "  Block Threshold:   $DDOS_SURICATA_THRESHOLD_BLOCK_SHORT"
595:     echo "  Ban Short:         ${DDOS_SURICATA_BAN_DURATION_SHORT}s"
596:     echo "  Ban Long:          ${DDOS_SURICATA_BAN_DURATION_LONG}s"
597:     echo "  Alert Window:      ${DDOS_SURICATA_ALERT_WINDOW}s"
598:     echo "  Use Feeds:         $DDOS_SURICATA_USE_FEEDS"
599:     echo "  Use GeoIP:         $DDOS_SURICATA_USE_GEOIP"
600:     echo "  Classic Layer0:    $DDOS_SURICATA_USE_CLASSIC_LAYER0"
601: 
602:     # Block set stats
603:     echo ""
604:     local table="${DDOS_NFT_TABLE_IPV4:-ip nftban}"
605:     local set="${DDOS_CLASSIC_BLOCK_SET:-ddos_blocked}"
606:     local blocked_count
607:     blocked_count=$(nft list set $table "$set" 2>/dev/null | grep -c "timeout" || echo "0")
608:     echo "Currently Blocked: $blocked_count IPs"
609: 
610:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
611:     echo ""
612: 
613:     return 0
614: }
615: 
616: # Process alerts (called by timer/daemon)
617: nftban_ddos_suricata_process() {
618:     _nftban_ddos_suricata_load_config
619: 
620:     if ! nftban_ddos_suricata_is_available; then
621:         _nftban_ddos_suricata_log "WARN" "Suricata not available, skipping"
622:         return 1
623:     fi
624: 
625:     _nftban_ddos_suricata_process_alerts
626: }
627: 
628: # =============================================================================
629: # EXPORTS
630: # =============================================================================
631: 
632: export -f nftban_ddos_suricata_enable
633: export -f nftban_ddos_suricata_disable
634: export -f nftban_ddos_suricata_status
635: export -f nftban_ddos_suricata_process
636: export -f nftban_ddos_suricata_is_available
637: export -f nftban_ddos_suricata_get_status
638: export -f nftban_ddos_suricata_binary_exists
639: export -f nftban_ddos_suricata_service_running
640: export -f nftban_ddos_suricata_eve_active
</file>

<file path="cli/lib/nftban/core/nftban_ddos.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0 - DDoS Protection Module - MAIN CONTROLLER
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Dual-mode DDoS protection with auto-detection
  7: #
  8: # meta:name=nftban_ddos
  9: # meta:type=core
 10: # meta:header=DDoS Protection
 11: # meta:version=1.0.0
 12: #
 13: # **Description**
 14: # Main controller for DDoS protection with dual-mode support:
 15: #
 16: #   CLASSIC MODE:  Pure nftables (no Suricata required)
 17: #   SURICATA MODE: IDS-integrated with scoring engine
 18: #   HYBRID MODE:   Classic as Layer 0 + Suricata as Layer 1
 19: #   AUTO MODE:     Auto-detect best mode based on system
 20: #
 21: # **Mode Selection Logic:**
 22: #   1. Check DDOS_MODE in config (auto/classic/suricata/hybrid)
 23: #   2. If "auto": detect Suricata availability
 24: #   3. Load appropriate sub-module
 25: #
 26: # meta:depends=bash>=4.0,nftables>=0.9.0
 27: # meta:created_date=2025-12-01
 28: # meta:updated_date=2025-12-01
 29: # =============================================================================
 30: 
 31: IFS=$'\n\t'
 32: umask 027
 33: 
 34: # =============================================================================
 35: # MODULE GUARD
 36: # =============================================================================
 37: 
 38: [[ -n "${NFTBAN_DDOS_LOADED:-}" ]] && return 0
 39: readonly NFTBAN_DDOS_LOADED=1
 40: 
 41: # =============================================================================
 42: # MODULE METADATA
 43: # =============================================================================
 44: 
 45: # shellcheck disable=SC2034  # Module metadata used when sourced
 46: readonly DDOS_MODULE_NAME="nftban_ddos"
 47: # Module metadata - reserved for future module registry
 48: readonly DDOS_MODULE_VERSION="1.0.0"
 49: # shellcheck disable=SC2034
 50: readonly DDOS_MODULE_TYPE="core"
 51: readonly DDOS_MODULE_DESCRIPTION="DDoS Protection (Dual-Mode)"
 52: 
 53: # =============================================================================
 54: # PATHS
 55: # =============================================================================
 56: 
 57: readonly NFTBAN_DDOS_LIB_DIR="${NFTBAN_LIB_DIR:-/usr/lib/nftban}"
 58: readonly NFTBAN_DDOS_CONFIG_DIR="${NFTBAN_CONFIG_DIR:-/etc/nftban}"
 59: readonly NFTBAN_DDOS_LOG_FILE="${NFTBAN_LOG_DIR:-/var/log/nftban}/ddos.log"
 60: 
 61: # =============================================================================
 62: # LOAD SUB-MODULES
 63: # =============================================================================
 64: 
 65: # Source classic module
 66: if [[ -f "${NFTBAN_DDOS_LIB_DIR}/core/nftban_ddos_classic.sh" ]]; then
 67:     source "${NFTBAN_DDOS_LIB_DIR}/core/nftban_ddos_classic.sh"
 68: elif [[ -f "$(dirname "${BASH_SOURCE[0]}")/nftban_ddos_classic.sh" ]]; then
 69:     source "$(dirname "${BASH_SOURCE[0]}")/nftban_ddos_classic.sh"
 70: fi
 71: 
 72: # Source suricata module
 73: if [[ -f "${NFTBAN_DDOS_LIB_DIR}/core/nftban_ddos_suricata.sh" ]]; then
 74:     source "${NFTBAN_DDOS_LIB_DIR}/core/nftban_ddos_suricata.sh"
 75: elif [[ -f "$(dirname "${BASH_SOURCE[0]}")/nftban_ddos_suricata.sh" ]]; then
 76:     source "$(dirname "${BASH_SOURCE[0]}")/nftban_ddos_suricata.sh"
 77: fi
 78: 
 79: # =============================================================================
 80: # CONFIGURATION LOADING
 81: # =============================================================================
 82: 
 83: _nftban_ddos_load_config() {
 84:     local main_config="${NFTBAN_DDOS_CONFIG_DIR}/conf.d/ddos/main.conf"
 85: 
 86:     if [[ -f "$main_config" ]]; then
 87:         # shellcheck source=/dev/null
 88:         source "$main_config"
 89:     fi
 90: 
 91:     # Set defaults
 92:     : "${DDOS_ENABLED:=true}"
 93:     : "${DDOS_MODE:=auto}"
 94:     : "${DDOS_AUTO_CHECK_SERVICE:=true}"
 95:     : "${DDOS_AUTO_CHECK_BINARY:=true}"
 96:     : "${DDOS_AUTO_CHECK_EVE_FILE:=true}"
 97:     : "${DDOS_SURICATA_SERVICE_NAME:=suricata}"
 98:     : "${DDOS_SURICATA_BINARY:=/usr/bin/suricata}"
 99:     : "${DDOS_EVE_FRESHNESS_THRESHOLD:=60}"
100:     : "${DDOS_HYBRID_CLASSIC_LAYER0:=true}"
101:     : "${DDOS_NFT_TABLE_IPV4:=ip nftban}"
102:     : "${DDOS_NFT_TABLE_IPV6:=ip6 nftban}"
103:     : "${DDOS_NFT_CHAIN:=ddos_protection}"
104: }
105: 
106: # =============================================================================
107: # LOGGING
108: # =============================================================================
109: 
110: _nftban_ddos_log() {
111:     local level="$1"
112:     local message="$2"
113: 
114:     mkdir -p "$(dirname "$NFTBAN_DDOS_LOG_FILE")" 2>/dev/null
115: 
116:     echo "[$(date '+%Y-%m-%d %H:%M:%S')] [DDOS] [$level] $message" >> "$NFTBAN_DDOS_LOG_FILE"
117: }
118: 
119: # =============================================================================
120: # BANNER
121: # =============================================================================
122: 
123: _nftban_ddos_banner() {
124:     if type -t nftban_banner >/dev/null 2>&1; then
125:         nftban_banner
126:     else
127:         echo "╔══════════════════════════════════════════════════════════╗"
128:         echo "║  🛡️  DDoS Protection                                     ║"
129:         echo "║  nftban — Simplifying Linux Firewall Management         ║"
130:         echo "╚══════════════════════════════════════════════════════════╝"
131:     fi
132: }
133: 
134: # =============================================================================
135: # MODE DETECTION
136: # =============================================================================
137: 
138: # Detect the best mode based on system state
139: _nftban_ddos_detect_mode() {
140:     local configured_mode="${DDOS_MODE:-auto}"
141: 
142:     # If mode is explicitly set (not auto), return it
143:     if [[ "$configured_mode" != "auto" ]]; then
144:         echo "$configured_mode"
145:         return 0
146:     fi
147: 
148:     # Auto-detection: check if Suricata is available
149:     if type -t nftban_ddos_suricata_is_available &>/dev/null; then
150:         if nftban_ddos_suricata_is_available; then
151:             echo "suricata"
152:             return 0
153:         fi
154:     fi
155: 
156:     # Fallback to classic
157:     echo "classic"
158: }
159: 
160: # Get current active mode
161: nftban_ddos_get_mode() {
162:     _nftban_ddos_load_config
163:     _nftban_ddos_detect_mode
164: }
165: 
166: # Check if Suricata is available (wrapper)
167: nftban_ddos_suricata_available() {
168:     _nftban_ddos_load_config
169: 
170:     if type -t nftban_ddos_suricata_is_available &>/dev/null; then
171:         nftban_ddos_suricata_is_available
172:         return $?
173:     fi
174: 
175:     return 1
176: }
177: 
178: # =============================================================================
179: # PUBLIC API - ENABLE
180: # =============================================================================
181: 
182: nftban_ddos_enable() {
183:     _nftban_ddos_load_config
184:     _nftban_ddos_banner
185: 
186:     # Create log file if it doesn't exist
187:     if [[ ! -f "$NFTBAN_DDOS_LOG_FILE" ]]; then
188:         mkdir -p "$(dirname "$NFTBAN_DDOS_LOG_FILE")" 2>/dev/null || true
189:         touch "$NFTBAN_DDOS_LOG_FILE" 2>/dev/null || true
190:         chmod 640 "$NFTBAN_DDOS_LOG_FILE" 2>/dev/null || true
191:         chown nftban:nftban "$NFTBAN_DDOS_LOG_FILE" 2>/dev/null || true
192:     fi
193: 
194:     # Check if module is enabled
195:     if [[ "$DDOS_ENABLED" != "true" ]]; then
196:         echo ""
197:         echo "  DDoS module is DISABLED in configuration"
198:         echo "  Set DDOS_ENABLED=\"true\" in ${NFTBAN_DDOS_CONFIG_DIR}/conf.d/ddos/main.conf"
199:         echo ""
200:         return 1
201:     fi
202: 
203:     # Detect mode
204:     local mode
205:     mode=$(_nftban_ddos_detect_mode)
206: 
207:     echo ""
208:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
209:     echo "  DDoS Protection - Mode: ${mode^^}"
210:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
211: 
212:     _nftban_ddos_log "INFO" "Enabling DDoS protection (mode=$mode)"
213: 
214:     case "$mode" in
215:         classic)
216:             echo ""
217:             echo "  Using CLASSIC mode (native nftables)"
218:             echo "  Suricata: NOT AVAILABLE"
219:             echo ""
220:             if type -t nftban_ddos_classic_enable &>/dev/null; then
221:                 nftban_ddos_classic_enable
222:             else
223:                 echo "  ERROR: Classic module not loaded!"
224:                 return 1
225:             fi
226:             ;;
227: 
228:         suricata)
229:             echo ""
230:             echo "  Using SURICATA mode (IDS-integrated)"
231:             if type -t nftban_ddos_suricata_get_status &>/dev/null; then
232:                 echo "  Status: $(nftban_ddos_suricata_get_status)"
233:             fi
234:             echo ""
235:             if type -t nftban_ddos_suricata_enable &>/dev/null; then
236:                 nftban_ddos_suricata_enable
237:             else
238:                 echo "  ERROR: Suricata module not loaded!"
239:                 return 1
240:             fi
241:             ;;
242: 
243:         hybrid)
244:             echo ""
245:             echo "  Using HYBRID mode (Classic Layer 0 + Suricata Layer 1)"
246:             echo ""
247: 
248:             # Enable Classic as Layer 0
249:             echo "  [Layer 0] Classic (hard limits)..."
250:             if type -t nftban_ddos_classic_enable &>/dev/null; then
251:                 nftban_ddos_classic_enable
252:             fi
253: 
254:             echo ""
255: 
256:             # Enable Suricata as Layer 1
257:             echo "  [Layer 1] Suricata (intelligent detection)..."
258:                 DDOS_SURICATA_USE_CLASSIC_LAYER0="false"  # shellcheck disable=SC2034  # Reserved for dual-mode toggle
259:                 # Don't let Suricata module enable classic again
260:                 DDOS_SURICATA_USE_CLASSIC_LAYER0="false"
261:                 nftban_ddos_suricata_enable
262:             fi
263:             ;;
264: 
265:         *)
266:             echo "  ERROR: Unknown mode: $mode"
267:             return 1
268:             ;;
269:     esac
270: 
271:     echo ""
272:     echo "╔══════════════════════════════════════════════════════════╗"
273:     echo "║  ✅ DDoS Protection ENABLED (${mode^^})                   "
274:     echo "╚══════════════════════════════════════════════════════════╝"
275:     echo ""
276: 
277:     return 0
278: }
279: 
280: # =============================================================================
281: # PUBLIC API - DISABLE
282: # =============================================================================
283: 
284: nftban_ddos_disable() {
285:     _nftban_ddos_load_config
286:     _nftban_ddos_banner
287: 
288:     local mode
289:     mode=$(_nftban_ddos_detect_mode)
290: 
291:     echo ""
292:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
293:     echo "  Disabling DDoS Protection..."
294:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
295: 
296:     _nftban_ddos_log "INFO" "Disabling DDoS protection"
297: 
298:     # Disable both modes to ensure clean state
299:     if type -t nftban_ddos_classic_disable &>/dev/null; then
300:         nftban_ddos_classic_disable 2>/dev/null || true
301:     fi
302: 
303:     if type -t nftban_ddos_suricata_disable &>/dev/null; then
304:         nftban_ddos_suricata_disable 2>/dev/null || true
305:     fi
306: 
307:     echo ""
308:     echo "╔══════════════════════════════════════════════════════════╗"
309:     echo "║  ✅ DDoS Protection DISABLED                             ║"
310:     echo "╚══════════════════════════════════════════════════════════╝"
311:     echo ""
312: 
313:     return 0
314: }
315: 
316: # =============================================================================
317: # PUBLIC API - STATUS
318: # =============================================================================
319: 
320: nftban_ddos_status() {

# NFTBan Log Rotation Configuration
# Install to: /etc/logrotate.d/nftban
#
# Rotates:
# - /var/log/nftban/*.log (weekly, 4 weeks)
# - /var/lib/nftban/reports/* (monthly, 3 months)
# - Suricata logs (handled separately)
#
# Policy: Compress old files, keep reasonable history

# Main application logs (services that can be reloaded)
/var/log/nftban/nftban.log
/var/log/nftban/login-monitor.log
/var/log/nftban/service-alerts.log {
    weekly
    rotate 4
    compress
    delaycompress
    missingok
    notifempty
    create 0640 nftban nftban
    sharedscripts
    postrotate
        # Reload any services that need to reopen log files
        systemctl reload nftban-login-monitor >/dev/null 2>&1 || true
    endscript
}

# =============================================================================
# Ban Activity Log - CRITICAL for metrics and audit trail
# =============================================================================
# bans.log is the SINGLE SOURCE OF TRUTH for ban activity history.
# Used by: nftban_unified_exporter.sh, nftban_stats.sh
# Format: DATE|TIME|SOURCE|IP|COUNTRY|STATUS|REASON
#
# Use copytruncate: Processes hold open file handles during reads.
# The mv approach (used in nftban_stats_cleanup_logs) can cause data loss.
/var/log/nftban/bans.log {
    weekly
    rotate 12
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    size 10M
    create 0640 nftban nftban
}

# Mail, queue, and maintenance logs - bash scripts appending via >>
# Use copytruncate: safer for transient appenders, no reload needed
/var/log/nftban/mail.log
/var/log/nftban/queue.log
/var/log/nftban/maintenance.log {
    weekly
    rotate 4
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}

# =============================================================================
# Module-specific logs (DDoS, Login, Portscan, Trust)
# =============================================================================
# These can grow rapidly during attacks - daily rotation with size trigger
# Use copytruncate for bash scripts appending via >>
/var/log/nftban/ddos-classic.log
/var/log/nftban/ddos-suricata.log
/var/log/nftban/login-suricata.log
/var/log/nftban/portscan-suricata.log
/var/log/nftban/portscan-classic.log
/var/log/nftban/trust.log {
    daily
    rotate 30
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    size 100M
    create 0640 nftban nftban
}

# =============================================================================
# Additional module logs (Feeds, GeoBan, Botscan, etc.)
# =============================================================================
# These modules write logs that were previously missing from rotation
/var/log/nftban/feeds.log
/var/log/nftban/geoban.log
/var/log/nftban/botscan.log
/var/log/nftban/login_alert.log
/var/log/nftban/update.log
/var/log/nftban/cron.log {
    weekly
    rotate 12
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    create 0640 nftban nftban
}

# =============================================================================
# Suricata logs — MOVED to /etc/logrotate.d/nftban-suricata
# =============================================================================
# Suricata log rotation is in a separate file to avoid breaking logrotate
# when Suricata is not installed (user 'suricata' doesn't exist).
# File: /etc/logrotate.d/nftban-suricata (installed by nftban suricata setup)

# =============================================================================
# Watchdog subdirectory logs (alerts, stats, profiles)
# =============================================================================
# These are in a subdirectory of /var/log/nftban/ and need separate rotation
/var/log/nftban/watchdog/alerts.log
/var/log/nftban/watchdog/stats.log
/var/log/nftban/watchdog/profiles.log {
    weekly
    rotate 4
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    create 0640 nftban nftban
}

# Generated reports - monthly rotation, keep 3 months
/var/lib/nftban/reports/*.html /var/lib/nftban/reports/*.txt /var/lib/nftban/reports/*.json {
    monthly
    rotate 3
    compress
    delaycompress
    missingok
    notifempty
    olddir /var/lib/nftban/reports/archive
    createolddir 0750 nftban nftban
}

# Daily reports subdirectory
/var/lib/nftban/reports/daily/*.html /var/lib/nftban/reports/daily/*.txt {
    monthly
    rotate 3
    compress
    delaycompress
    missingok
    notifempty
}

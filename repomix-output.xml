349: 
350: # =============================================================================
351: # HELP TEXT
352: # =============================================================================
353: 
354: _nftban_search_help() {
355:     nftban_banner "search"
356: 
357:     cat <<'HELP'
358: 
359: USAGE:
360:     nftban search <ip|port> [--no-interactive]
361: 
362: DESCRIPTION:
363:     Search for an IP address or port number across all NFTBan components:
364: 
365:     IP Search:
366:     - nftables sets (whitelist, temp_ban, user_blacklist, system_blacklist, feeds)
367:     - Threat intelligence feeds
368:     - Fail2Ban jails
369: 
370:     Port Search:
371:     - nftables port sets (tcp_ports, udp_ports)
372:     - Port configuration files (${NFTBAN_CONFIG_DIR}/ports.d/*.conf)
373: 
374:     If IP/port is found, shows location and details.
375:     If IP is not found, offers interactive options to ban or whitelist.
376: 
377: OPTIONS:
378:     --no-interactive    Show results only, no interactive menu
379: 
380: EXAMPLES:
381:     # Search for IP
382:     nftban search 192.0.2.100
383: 
384:     # Search IPv6
385:     nftban search 2001:db8::1
386: 
387:     # Search CIDR (checks if any IP in range is banned)
388:     nftban search 192.0.2.0/24
389: 
390:     # Search for port
391:     nftban search 8080
392: 
393:     # Non-interactive (scripts)
394:     nftban search 192.0.2.100 --no-interactive
395: 
396: NOTES:
397:     - Searches all 3 nftables tables (runtime, v4, v6)
398:     - Searches all 5 sets per table
399:     - Searches downloaded threat feeds
400:     - Searches active Fail2Ban jails
401:     - Searches port whitelist sets and config files
402:     - Shows ban priority and type
403:     - Shows expiry time for temp bans
404: 
405: HELP
406: }
407: 
408: # =============================================================================
409: # MAIN COMMAND
410: # =============================================================================
411: 
412: nftban_cmd_search() {
413:     local query=""
414:     local interactive=true
415:     local json_mode=false
416: 
417:     # Parse all arguments
418:     while [[ $# -gt 0 ]]; do
419:         case "$1" in
420:             --json)
421:                 json_mode=true
422:                 interactive=false
423:                 shift
424:                 ;;
425:             --no-interactive)
426:                 interactive=false
427:                 shift
428:                 ;;
429:             help|--help|-h)
430:                 _nftban_search_help
431:                 return 0
432:                 ;;
433:             *)
434:                 if [[ -z "$query" ]]; then
435:                     query="$1"
436:                 fi
437:                 shift
438:                 ;;
439:         esac
440:     done
441: 
442:     # Check if query is empty
443:     if [[ -z "$query" ]]; then
444:         _nftban_search_help
445:         return 0
446:     fi
447: 
448:     # Show banner (skip for JSON output)
449:     if [[ "$json_mode" != "true" ]]; then
450:         if [[ $(type -t nftban_banner) == "function" ]]; then
451:             nftban_banner
452:         fi
453:         echo ""
454:     fi
455: 
456:     # Detect if query is port number or IP address
457:     if [[ "$query" =~ ^[0-9]+$ ]] && [[ "$query" -ge 1 ]] && [[ "$query" -le 65535 ]]; then
458:         # It's a port number
459:         echo ""
460:         echo "═══════════════════════════════════════════════════════════════"
461:         echo "  Port Search Results: $query"
462:         echo "═══════════════════════════════════════════════════════════════"
463:         echo ""
464: 
465:         local port_result
466:         port_result=$(_search_port "$query")
467: 
468:         if [[ "$port_result" == "FOUND"* ]]; then
469:             echo "✓ STATUS: WHITELISTED (port is allowed)"
470:             echo ""
471:             echo "Found in:"
472:             echo "───────────────────────────────────────────────────────────────"
473: 
474:             # Skip first line (FOUND)
475:             local found_locations
476:             found_locations=$(echo "$port_result" | tail -n +2)
477: 
478:             while IFS= read -r location; do
479:                 if [[ "$location" == nftables:* ]]; then
480:                     local set="${location##*:}"
481:                     echo "  ✓ nftables set: $set (active in firewall)"
482:                 elif [[ "$location" == config:* ]]; then
483:                     local file
484:                     file=$(echo "$location" | cut -d':' -f2)
485:                     local proto
486:                     proto=$(echo "$location" | cut -d':' -f3)
487:                     echo "  ✓ config file: $file (protocol: $proto)"
488:                 fi
489:             done <<< "$found_locations"
490: 
491:             echo ""
492:             echo "═══════════════════════════════════════════════════════════════"
493:         else
494:             echo "✗ STATUS: NOT WHITELISTED (port is blocked by default)"
495:             echo ""
496:             echo "Not found in:"
497:             echo "───────────────────────────────────────────────────────────────"
498:             echo "  ✗ nftables tcp_ports set"
499:             echo "  ✗ nftables udp_ports set"
500:             echo "  ✗ ${NFTBAN_CONFIG_DIR}/ports.d/*.conf"
501:             echo ""
502:             echo "To whitelist this port, use:"
503:             echo "  nftban port add $query tcp     # For TCP"
504:             echo "  nftban port add $query udp     # For UDP"
505:             echo "  nftban port add $query both    # For both"
506:             echo ""
507:             echo "═══════════════════════════════════════════════════════════════"
508:         fi
509: 
510:         return 0
511:     fi
512: 
513:     # It's an IP address - continue with IP search
514:     local ip="$query"
515: 
516:     # Validate IP (basic check)
517:     if [[ ! "$ip" =~ ^[0-9a-fA-F:.\/]+$ ]]; then
518:         echo "ERROR: Invalid IP address or port: $ip"
519:         return 1
520:     fi
521: 
522:     # Perform searches (these functions return 1 when IP not found, which is expected)
523:     local nft_result=""
524:     nft_result=$(_search_nftables "$ip" 2>/dev/null) || true
525:     local feeds_result=""
526:     feeds_result=$(_search_feeds "$ip" 2>/dev/null) || true
527: 
528:     # JSON output mode
529:     if [[ "$json_mode" == "true" ]] && declare -f json_output >/dev/null 2>&1; then
530:         local found="false"
531:         local -a locations=()
532: 
533:         # Parse nftables results
534:         if [[ "$nft_result" == "FOUND"* ]]; then
535:             found="true"
536:             while IFS= read -r location; do
537:                 [[ -z "$location" ]] && continue
538:                 locations+=("$location")
539:             done <<< "$(echo "$nft_result" | tail -n +2)"
540:         fi
541: 
542:         # Parse feeds results
543:         if [[ -n "$feeds_result" ]] && [[ "$feeds_result" == "FOUND"* ]]; then
544:             while IFS= read -r feed; do
545:                 [[ -z "$feed" ]] && continue
546:                 locations+=("feed:$feed")
547:             done <<< "$(echo "$feeds_result" | tail -n +2)"
548:         fi
549: 
550:         # Build locations JSON array
551:         local locations_json="["
552:         local first=true
553:         for loc in "${locations[@]}"; do
554:             [[ "$first" == "false" ]] && locations_json+=","
555:             locations_json+="\"$loc\""
556:             first=false
557:         done
558:         locations_json+="]"
559: 
560:         local data
561:         if command -v jq &>/dev/null; then
562:             data=$(jq -n \
563:                 --arg ip "$ip" \
564:                 --arg found "$found" \
565:                 --argjson locations "$locations_json" \
566:                 '{ip: $ip, found: ($found == "true"), locations: $locations, count: ($locations | length)}')
567:         else
568:             local found_bool="false"
569:             [[ "$found" == "true" ]] && found_bool="true"
570:             data="{\"ip\":\"$ip\",\"found\":$found_bool,\"locations\":$locations_json,\"count\":${#locations[@]}}"
571:         fi
572:         json_output "true" "$data"
573:         return 0
574:     fi
575: 
576:     # Display results (human-readable)
577:     _display_results "$ip" "$nft_result" "$feeds_result"
578: 
579:     # Show suggested actions (unless --no-interactive flag used)
580:     if [[ "$interactive" == "true" ]]; then
581:         local is_banned="false"
582:         [[ "$nft_result" == "FOUND"* ]] && is_banned="true"
583: 
584:         _suggest_actions "$ip" "$is_banned"
585:     fi
586: 
587:     # Exit marker for testing validation
588:     command -v nftban_cmd_exit >/dev/null 2>&1 && nftban_cmd_exit "search"
589: 
590:     return 0
591: }
592: 
593: # =============================================================================
594: # EXPORTS
595: # =============================================================================
596: 
597: export -f nftban_cmd_search
598: 
599: # =============================================================================
600: # DIRECT EXECUTION SUPPORT
601: # =============================================================================
602: 
603: # If sourced directly (not via main CLI), run command
604: if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
605:     nftban_cmd_search "$@"
606: fi
</file>


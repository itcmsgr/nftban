 999: // AddCIDRElementsWithStats adds CIDR elements to an interval set and returns merge statistics
1000: func (m *NFTManager) AddCIDRElementsWithStats(set *nftables.Set, cidrs []string) (*MergeStats, error) {
1001: 	if len(cidrs) == 0 {
1002: 		return &MergeStats{}, nil
1003: 	}
1004: 
1005: 	// Determine table family
1006: 	var family string
1007: 	switch set.Table.Family {
1008: 	case nftables.TableFamilyIPv4:
1009: 		family = "ip"
1010: 	case nftables.TableFamilyIPv6:
1011: 		family = "ip6"
1012: 	default:
1013: 		return nil, fmt.Errorf("unsupported table family: %v", set.Table.Family)
1014: 	}
1015: 
1016: 	// Step 1: Validate and deduplicate CIDRs
1017: 	inputCount := len(cidrs)
1018: 	seen := make(map[string]bool, len(cidrs))
1019: 	var validCIDRs []string
1020: 
1021: 	// Parse and deduplicate CIDRs using standard net package
1022: 	for _, cidr := range cidrs {
1023: 		// Validate CIDR using standard library
1024: 		_, ipNet, err := net.ParseCIDR(cidr)
1025: 		if err != nil {
1026: 			// Skip invalid CIDRs
1027: 			continue
1028: 		}
1029: 
1030: 		// Normalize to canonical form
1031: 		canonical := ipNet.String()
1032: 		if !seen[canonical] {
1033: 			seen[canonical] = true
1034: 			validCIDRs = append(validCIDRs, canonical)
1035: 		}
1036: 	}
1037: 
1038: 	// Step 2: Merge overlapping and adjacent CIDRs using interval merging algorithm
1039: 	canonicalCIDRs, stats, err := MergeCIDRs(validCIDRs)
1040: 	if err != nil {
1041: 		return nil, fmt.Errorf("failed to merge CIDRs: %w", err)
1042: 	}
1043: 
1044: 	// Update stats to reflect total reduction (including invalid/duplicate removal)
1045: 	stats.InputCIDRs = inputCount
1046: 	if inputCount > 0 {
1047: 		stats.OverlapsMerged = inputCount - len(canonicalCIDRs)
1048: 		stats.ReductionPct = float64(stats.OverlapsMerged) / float64(inputCount) * 100.0
1049: 	}
1050: 
1051: 	// Flush the set first using nft CLI to avoid netlink stale connection issues
1052: 	if err := nftFlushSet(family, set.Table.Name, set.Name); err != nil {
1053: 		return nil, fmt.Errorf("failed to flush set: %w", err)
1054: 	}
1055: 
1056: 	// Create temporary file for nft command
1057: 	tmpfile, err := os.CreateTemp("", "nftban-cidr-*.nft")
1058: 	if err != nil {
1059: 		return nil, fmt.Errorf("failed to create temp file: %w", err)
1060: 	}
1061: 	defer os.Remove(tmpfile.Name())
1062: 	defer tmpfile.Close()
1063: 
1064: 	// Write nft commands to file in batches to avoid memory issues
1065: 	// For large datasets, split into multiple add element commands (10k per batch)
1066: 	// Format: add element ip nftban blacklist_ipv4 { 10.0.0.0/8, 192.168.0.0/16, ... }
1067: 
1068: 	const batchSize = 10000
1069: 	for batchStart := 0; batchStart < len(canonicalCIDRs); batchStart += batchSize {
1070: 		batchEnd := batchStart + batchSize
1071: 		if batchEnd > len(canonicalCIDRs) {
1072: 			batchEnd = len(canonicalCIDRs)
1073: 		}
1074: 
1075: 		batch := canonicalCIDRs[batchStart:batchEnd]
1076: 
1077: 		// Use strings.Builder for efficient string concatenation
1078: 		var builder strings.Builder
1079: 		for i, cidr := range batch {
1080: 			if i > 0 {
1081: 				builder.WriteString(", ")
1082: 			}
1083: 			builder.WriteString(cidr)
1084: 		}
1085: 
1086: 		nftCmd := fmt.Sprintf("add element %s %s %s { %s }\n", family, set.Table.Name, set.Name, builder.String())
1087: 		if _, err := tmpfile.WriteString(nftCmd); err != nil {
1088: 			return nil, fmt.Errorf("failed to write to temp file: %w", err)
1089: 		}
1090: 	}
1091: 	tmpfile.Close()
1092: 
1093: 	// Execute nft -f <file> using centralized helper
1094: 	if _, err := runNftFile(tmpfile.Name()); err != nil {
1095: 		return nil, err
1096: 	}
1097: 
1098: 	return stats, nil
1099: }
1100: 
1101: //nolint:U1000 // Helper method for set retrieval
1102: 
1103: //nolint:U1000 // Helper method for batch CIDR operations
</file>


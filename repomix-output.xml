39:         comment "Allowed UDP ports"
40:     }
41: 
42:     # =========================================================================
43:     # INPUT CHAIN - CORRECT RULE ORDER (security-critical!)
44:     # =========================================================================
45:     chain input {
46:         type filter hook input priority filter; policy drop;
47: 
48:         # 1. Drop invalid packets
49:         ct state invalid counter drop comment "invalid state"
50: 
51:         # 2. Always allow loopback
52:         iif lo counter accept comment "loopback"
53: 
54:         # 3. Whitelist (bypass all checks)
55:         ip saddr @whitelist_ipv4 counter accept comment "whitelist - full access"
56: 
57:         # 4. BLACKLIST (⚠️ BEFORE established!) - permanent + temporary with timeout
58:         ip saddr @blacklist_ipv4 counter drop comment "blacklist (permanent + temporary)"
59: 
60:         # 5. NOW allow established connections (safe after all bans checked)
61:         ct state established,related counter accept comment "established connections"
62: 
63:         # 7. ICMP (ping, traceroute, etc.)
64:         ip protocol icmp icmp type { echo-reply, destination-unreachable, echo-request, time-exceeded } counter accept comment "ICMPv4"
65: 
66:         # 8. CT LIMITS (DDoS protection - SSH)
67:         ct state new tcp dport 22 ct count over 5 counter drop comment "SSH: max 5 concurrent per IP"

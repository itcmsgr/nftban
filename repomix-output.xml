414: // getNetworkStats reads /proc/net/dev and calculates RX/TX rates in Mbps
415: func (s *Sampler) getNetworkStats() (rxMbps, txMbps float64) {
416: 	file, err := os.Open("/proc/net/dev")
417: 	if err != nil {
418: 		log.Printf("[METRICS] Failed to open /proc/net/dev: %v", err)
419: 		return 0, 0
420: 	}
421: 	defer file.Close()
422: 
423: 	var totalRxBytes, totalTxBytes uint64
424: 	scanner := bufio.NewScanner(file)
425: 
426: 	// Skip first two header lines
427: 	scanner.Scan()
428: 	scanner.Scan()
429: 
430: 	for scanner.Scan() {
431: 		line := scanner.Text()
432: 		fields := strings.Fields(line)
433: 		if len(fields) < 10 {
434: 			continue
435: 		}
436: 
437: 		// Skip loopback interface
438: 		iface := strings.TrimSuffix(fields[0], ":")
439: 		if iface == "lo" {
440: 			continue
441: 		}
442: 
443: 		// Parse RX bytes (field 1) and TX bytes (field 9)
444: 		rxBytes, err := strconv.ParseUint(fields[1], 10, 64)
445: 		if err != nil {
446: 			continue
447: 		}
448: 		txBytes, err := strconv.ParseUint(fields[9], 10, 64)
449: 		if err != nil {
450: 			continue
451: 		}
452: 
453: 		totalRxBytes += rxBytes
454: 		totalTxBytes += txBytes
455: 	}
456: 
457: 	// Calculate rates if we have previous data
458: 	now := time.Now()
459: 	if !s.lastNetCheck.IsZero() {
460: 		elapsed := now.Sub(s.lastNetCheck).Seconds()
461: 		if elapsed > 0 {
462: 			// Calculate bytes per second, then convert to Mbps
463: 			rxBytesPerSec := float64(totalRxBytes-s.lastRxBytes) / elapsed
464: 			txBytesPerSec := float64(totalTxBytes-s.lastTxBytes) / elapsed
465: 
466: 			// Convert to Mbps: bytes/sec * 8 / 1000000
467: 			rxMbps = (rxBytesPerSec * 8) / 1000000
468: 			txMbps = (txBytesPerSec * 8) / 1000000
469: 		}
470: 	}
471: 
472: 	// Store current values for next calculation
473: 	s.lastRxBytes = totalRxBytes
474: 	s.lastTxBytes = totalTxBytes
475: 	s.lastNetCheck = now
476: 
477: 	return rxMbps, txMbps
478: }

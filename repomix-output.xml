  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - GeoBan Core Module
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Wrapper for Go-based country blocking (nftban-geoip geoban)
  7: #
  8: # meta:name=nftban_geoban
  9: # meta:type=core
 10: # meta:header=GeoBan Core
 11: # meta:version=1.0.0
 12: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 13: # meta:homepage=https://nftban.com
 14: #
 15: # **Description & Purpose**
 16: # meta:description=Country-based IP blocking using nftban-geoip Go binary
 17: # meta:input=Country codes (ISO alpha-2)
 18: # meta:output=IP lists to nftables, tracking JSON to /etc/nftban/geoban.d/
 19: #
 20: # **Inventory & Requirements**
 21: # meta:depends=bash,nftban-geoip (Go binary)
 22: #
 23: # meta:created_date=2025-11-05
 24: # meta:updated_date=2025-11-24
 25: # =============================================================================
 26: 
 27: # Source central config for canonical paths (NO HARDCODED FALLBACKS)
 28: # shellcheck source=/etc/nftban/nftban.conf
 29: [[ -f "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf" ]] && source "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf"
 30: 
 31: # Load logging modules if available (uses central config paths)
 32: if [[ -f "${NFTBAN_LIB_DIR}/helpers/nftban_logger.sh" ]]; then

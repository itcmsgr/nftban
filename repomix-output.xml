 32: // getFeedsPaths returns feeds directory and config paths from passed config
 33: func getFeedsPaths(cfg *nftbanconf.Config) (feedsDir, feedsConfig, configDir string) {
 34: 	return cfg.DataDir + "/feeds", cfg.ConfigDir + "/conf.d/feeds.conf", cfg.ConfigDir
 35: }

  75: cmd_suricata_install() {
  76:     _check_root install || return 1
  77: 
  78:     echo ""
  79:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  80:     echo "  🛡️  NFTBan - Suricata IDS Automated Installation"
  81:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  82:     echo ""
  83: 
  84:     # Check if already installed
  85:     if _suricata_is_installed; then
  86:         local version
  87:         version=$(suricata -V 2>&1 | head -1 || echo "unknown")
  88:         echo "✓ Suricata is already installed: $version"
  89:         echo ""
  90:         read -p "Do you want to reinstall/upgrade? [y/N]: " reinstall
  91:         if [[ "${reinstall,,}" != "y" ]]; then
  92:             echo "  Installation cancelled"
  93:             return 0
  94:         fi
  95:         echo ""
  96:     fi
  97: 
  98:     echo "This will:"
  99:     echo "  1. Check for package repository version (EPEL)"
 100:     echo "  2. Install Suricata from packages OR compile from source"
 101:     echo "  3. Configure Suricata for NFTBan integration"
 102:     echo "  4. Setup systemd service"
 103:     echo ""
 104:     read -p "Continue with installation? [Y/n]: " confirm
 105:     confirm=${confirm:-y}
 106:     if [[ "${confirm,,}" != "y" ]]; then
 107:         echo "  Installation cancelled"
 108:         return 0
 109:     fi
 110: 
 111:     echo ""
 112:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
 113:     echo "  Step 1/3: Installing Suricata"
 114:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
 115:     echo ""
 116: 
 117:     # Try package installation first
 118:     local pkg_installed=false
 119:     if command -v dnf &>/dev/null; then
 120:         echo "  → Checking DNF repositories for Suricata..."
 121:         if dnf info suricata &>/dev/null 2>&1; then
 122:             echo "  ✓ Suricata package found in repositories"
 123:             echo "  → Installing via DNF..."
 124:             if dnf install -y suricata; then
 125:                 pkg_installed=true
 126:                 echo "  ✓ Suricata installed from packages"
 127:             fi
 128:         fi
 129:     elif command -v apt-get &>/dev/null; then
 130:         echo "  → Checking APT repositories for Suricata..."
 131:         apt-get update -qq
 132:         if apt-cache show suricata &>/dev/null 2>&1; then
 133:             echo "  ✓ Suricata package found in repositories"
 134:             echo "  → Installing via APT..."
 135:             if apt-get install -y suricata; then
 136:                 pkg_installed=true
 137:                 echo "  ✓ Suricata installed from packages"
 138:             fi
 139:         fi
 140:     fi
 141: 
 142:     # If package install failed, use setup script
 143:     if [[ "$pkg_installed" == false ]]; then
 144:         echo "  ⊘ No package available, installing from source..."
 145:         if [[ -f "$SURICATA_SETUP_SCRIPT" ]]; then
 146:             bash "$SURICATA_SETUP_SCRIPT" || {
 147:                 echo "  ✗ Installation from source failed"
 148:                 return 1
 149:             }
 150:         else
 151:             echo "  ✗ Setup script not found: $SURICATA_SETUP_SCRIPT"
 152:             return 1
 153:         fi
 154:     fi
 155: 
 156:     echo ""
 157:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
 158:     echo "  Step 2/3: Installing Detection Rules"
 159:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
 160:     echo ""
 161: 
 162:     # Install suricata-update if not present
 163:     if ! command -v suricata-update &>/dev/null; then
 164:         echo "  → Installing suricata-update..."
 165:         pip3 install --upgrade suricata-update || {
 166:             echo "  ✗ Failed to install suricata-update"
 167:             return 1
 168:         }
 169:     fi
 170: 
 171:     # Run rules setup
 172:     if [[ -f "$SURICATA_RULES_SCRIPT" ]]; then
 173:         bash "$SURICATA_RULES_SCRIPT" || {
 174:             echo "  ⚠  Rules setup had warnings (may be OK)"
 175:         }
 176:     else
 177:         echo "  ⊘ Rules script not found, manual setup required"
 178:     fi
 179: 
 180:     echo ""
 181:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
 182:     echo "  Step 3/3: Finalizing Installation"
 183:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
 184:     echo ""
 185: 
 186:     # Set config flags
 187:     if [[ -f "${NFTBAN_CONF_DIR}/nftban.conf" ]]; then
 188:         if grep -q "^ENABLE_IDS_INTEGRATION=" "${NFTBAN_CONF_DIR}/nftban.conf"; then
 189:             sed -i 's/^ENABLE_IDS_INTEGRATION=.*/ENABLE_IDS_INTEGRATION=1/' "${NFTBAN_CONF_DIR}/nftban.conf"
 190:         else
 191:             echo "ENABLE_IDS_INTEGRATION=1" >> "${NFTBAN_CONF_DIR}/nftban.conf"
 192:         fi
 193: 
 194:         if grep -q "^NFTBAN_SURICATA_ENABLED=" "${NFTBAN_CONF_DIR}/nftban.conf"; then
 195:             sed -i 's/^NFTBAN_SURICATA_ENABLED=.*/NFTBAN_SURICATA_ENABLED=true/' "${NFTBAN_CONF_DIR}/nftban.conf"
 196:         else
 197:             echo "NFTBAN_SURICATA_ENABLED=true" >> "${NFTBAN_CONF_DIR}/nftban.conf"
 198:         fi
 199:         echo "  ✓ NFTBan config updated (IDS enabled)"
 200:     fi
 201: 
 202:     # Enable Suricata rules update timer (weekly updates)
 203:     if [[ -f /usr/lib/systemd/system/nftban-suricata-update.timer ]]; then
 204:         systemctl enable nftban-suricata-update.timer 2>/dev/null || echo "  ⊘ Timer enable failed (will install manually)"
 205:         echo "  ✓ Rules update timer enabled (weekly Sunday 3 AM)"
 206:     fi
 207: 
 208:     # Show version
 209:     local version
 210:     version=$(suricata -V 2>&1 | head -1 || echo "unknown")
 211:     echo "  ✓ Installed: $version"
 212:     echo ""
 213: 
 214:     echo "╔══════════════════════════════════════════════════════════════╗"
 215:     echo "║  ✅ Suricata IDS Installation Complete!                      ║"
 216:     echo "╚══════════════════════════════════════════════════════════════╝"
 217:     echo ""
 218:     echo "Next steps:"
 219:     echo "  1. Enable and start: nftban suricata enable"
 220:     echo "  2. Check status:     nftban suricata status"
 221:     echo "  3. View alerts:      tail -f /var/log/suricata/eve.json"
 222:     echo ""
 223: }

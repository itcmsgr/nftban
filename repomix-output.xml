550: # =============================================================================
551: # BLOCKING
552: # =============================================================================
553: 
554: # Block an IP based on threshold level
555: nftban_portscan_suricata_block_ip() {
556:     local ip="$1"
557:     local level="$2"
558:     local score="$3"
559: 
560:     # Determine duration
561:     local duration
562:     case "$level" in
563:         short)     duration="${PORTSCAN_SURICATA_BAN_DURATION_SHORT}" ;;
564:         long)      duration="${PORTSCAN_SURICATA_BAN_DURATION_LONG}" ;;
565:         permanent) duration="${PORTSCAN_SURICATA_BAN_DURATION_PERMANENT}" ;;
566:         *)         duration="${PORTSCAN_SURICATA_BAN_DURATION_SHORT}" ;;
567:     esac
568: 
569:     local scan_types="${_PORTSCAN_SURICATA_IP_SCAN_TYPES[$ip]:-unknown}"
570: 
571:     # Use nftban ban command if available
572:     if type -t nftban_ban &>/dev/null; then
573:         nftban_ban "$ip" \
574:             --timeout "$duration" \
575:             --reason "portscan:suricata:${level}:${scan_types}" \
576:             --source "portscan-suricata" \
577:             --score "$score"
578:     else
579:         # Direct nftables block
580:         local table_ipv4="${PORTSCAN_NFT_TABLE_IPV4:-ip nftban}"
581:         local table_ipv6="${PORTSCAN_NFT_TABLE_IPV6:-ip6 nftban}"
582: 
583:         if [[ "$ip" =~ : ]]; then
584:             nft add element ${table_ipv6} blacklist { $ip timeout ${duration}s } 2>/dev/null || true
585:         else
586:             nft add element ${table_ipv4} blacklist { $ip timeout ${duration}s } 2>/dev/null || true
587:         fi
588:     fi
589: 
590:     # Record block
591:     _PORTSCAN_SURICATA_IP_BLOCKED["$ip"]=$(date +%s)
592: 
593:     nftban_log "WARN" "portscan_suricata" "Blocked ${ip} for ${duration}s (${level}, score=${score}, types=${scan_types})"
594: 
595:     # Send notification
596:     nftban_portscan_suricata_send_alert "$ip" "$level" "$score"
597: 
598:     return 0
599: }
600: 
601: # Send alert notification
602: nftban_portscan_suricata_send_alert() {
603:     local ip="$1"
604:     local level="$2"
605:     local score="$3"
606: 
607:     local threshold="${PORTSCAN_NOTIFY_THRESHOLD:-10}"
608:     local alert_count="${_PORTSCAN_SURICATA_IP_ALERTS[$ip]:-0}"
609: 
610:     # Only alert if above threshold
611:     [[ $alert_count -lt $threshold ]] && return 0
612: 
613:     local scan_types="${_PORTSCAN_SURICATA_IP_SCAN_TYPES[$ip]:-unknown}"
614:     local message="Portscan detected by Suricata: ${ip} (${level} block, score=${score}, alerts=${alert_count}, types=${scan_types})"
615: 
616:     # Email notification
617:     if [[ "${PORTSCAN_NOTIFY_EMAIL:-false}" == "true" && -n "${PORTSCAN_NOTIFY_EMAIL_TO:-}" ]]; then
618:         echo "$message" | mail -s "[NFTBan] Portscan Alert: ${ip}" "${PORTSCAN_NOTIFY_EMAIL_TO}" 2>/dev/null || true
619:     fi
620: 
621:     # Webhook notification
622:     if [[ "${PORTSCAN_NOTIFY_WEBHOOK:-false}" == "true" && -n "${PORTSCAN_NOTIFY_WEBHOOK_URL:-}" ]]; then
623:         curl -s -X POST "${PORTSCAN_NOTIFY_WEBHOOK_URL}" \
624:             -H "Content-Type: application/json" \
625:             -d "{\"type\":\"portscan\",\"mode\":\"suricata\",\"ip\":\"${ip}\",\"level\":\"${level}\",\"score\":${score},\"alerts\":${alert_count}}" \
626:             2>/dev/null || true
627:     fi
628: 
629:     return 0
630: }

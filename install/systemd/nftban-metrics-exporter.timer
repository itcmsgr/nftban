# =============================================================================
# NFTBan v1.0.0 - Prometheus Metrics Exporter Timer
# =============================================================================
# SPDX-License-Identifier: MPL-2.0
# Purpose: Periodic execution of NFTBan metrics collection
#
# DEPRECATED: Use nftban-unified-exporter.timer instead
# =============================================================
# This timer is maintained for backward compatibility only.
# The unified exporter provides:
#   - 66% less overhead (single collection vs triple)
#   - Consistent timestamps across Prometheus/Zabbix/Connectors
#   - Better debugging (single point of monitoring)
#
# Migration: systemctl disable nftban-metrics-exporter.timer
#            systemctl enable nftban-unified-exporter.timer
# =============================================================
#
# meta:name="nftban_metrics_exporter_timer"
# meta:type="config"
# meta:owner="Antonios Voulvoulis <contact@nftban.com>"
# meta:created_date="2025-10-26"
# meta:description="Timer that triggers NFTBan metrics collection every 60 seconds"
# meta:input="None"
# meta:output="Triggers nftban-metrics-exporter.service"
# meta:depends="nftban-metrics-exporter.service"
#
# meta:inventory.files=""
# meta:inventory.binaries=""
# meta:inventory.env_vars=""
# meta:inventory.config_files=""
# meta:inventory.systemd_units="nftban-metrics-exporter.service"
# meta:inventory.network=""
# meta:inventory.privileges="none"
# =============================================================================

[Unit]
Description=NFTBan Prometheus Metrics Exporter Timer
Documentation=https://nftban.com/docs/metrics
Requires=nftban-metrics-exporter.service
After=nftban.service

[Timer]
# Run every 60 seconds with jitter
OnBootSec=30s
OnUnitActiveSec=60s

# CRITICAL: Catch up missed runs after downtime (monitoring gaps otherwise)
Persistent=true

# Allow systemd to batch with other timers (+/- 10s)
AccuracySec=10s

# SMART JITTER: 50% variance prevents thundering herd
RandomizedDelaySec=30s

# DETERMINISTIC: Same offset per host (predictable but distributed)
FixedRandomDelay=true

[Install]
WantedBy=timers.target

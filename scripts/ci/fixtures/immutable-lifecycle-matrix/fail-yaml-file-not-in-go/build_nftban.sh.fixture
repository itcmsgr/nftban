%pretrans -p <lua>
local schema = "/usr/lib/nftban/lib/nft_schema.sh"
local conf = "/etc/nftban/nftban.conf"
os.execute("chattr -i " .. schema)
os.execute("chattr -i " .. conf)
%pre
echo pre
%preun
for f in /etc/nftban/nftban.conf /usr/lib/nftban/lib/nft_schema.sh; do
    chattr -i "$f"
done
%post
echo post

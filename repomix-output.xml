 400:             echo "✅ SU login monitoring disabled"
 401:             ;;
 402:         sudo)
 403:             _nftban_login_set_config "NFTBAN_LOGIN_ALERT_SUDO" "false" "$config_local"
 404:             echo "✅ SUDO monitoring disabled"
 405:             ;;

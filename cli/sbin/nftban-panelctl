#!/usr/bin/env bash
# =============================================================================
# NFTBan v1.0.24 - Panel Control Wrapper (nftban-panelctl)
# =============================================================================
# SPDX-License-Identifier: MPL-2.0
# meta:name="nftban-panelctl"
# meta:type="cli"
# meta:owner="Antonios Voulvoulis <contact@nftban.com>"
# meta:created_date="2025-10-26"
# meta:description="Secure wrapper for hosting panel integration (DirectAdmin, cPanel, etc.)"
# meta:input="panel command requests"
# meta:output="JSON response"
# meta:depends="nftban"
# meta:inventory.files="/usr/sbin/nftban-panelctl"
# meta:inventory.binaries=""
# meta:inventory.env_vars="NFTBAN_BIN,NFTBAN_REGISTRY"
# meta:inventory.config_files="/usr/lib/nftban/commands.registry.yml"
# meta:inventory.systemd_units=""
# meta:inventory.network="none"
# meta:inventory.privileges="nftban-panel group"
# =============================================================================
#
# Security Model:
#   - Only allows commands marked with panel_expose=true in registry
#   - Validates caller is in nftban-panel group
#   - Logs all actions to syslog
#   - Returns JSON output only
#   - Runs as panel service account (nftban-da, nftban-cp, etc.)
#
# Usage:
#   nftban-panelctl <command> [subcommand] [options]
#
# Service Accounts:
#   nftban-da  - DirectAdmin integration
#   nftban-cp  - cPanel/WHM integration
#   nftban-pl  - Plesk integration
#   nftban-wm  - Webmin integration
#
# Related Files:
#   - /etc/polkit-1/rules.d/30-nftban-panel.rules (Polkit authorization)
#   - /usr/lib/nftban/commands.registry.yml (command permissions)
#
# =============================================================================

set -Eeuo pipefail

# =============================================================================
# CONFIGURATION
# =============================================================================

readonly VERSION="1.0.24"
readonly NFTBAN_BIN="${NFTBAN_BIN:-/usr/bin/nftban}"
readonly REGISTRY_FILE="${NFTBAN_REGISTRY:-/usr/lib/nftban/commands.registry.yml}"
readonly LOG_TAG="nftban-panelctl"
readonly PANEL_GROUP="nftban-panel"

# Commands allowed for panels (panel_expose=true in registry)
# This is the authoritative whitelist - validated against registry at runtime
readonly -a ALLOWED_COMMANDS=(
    "status"
    "health"
    "version"
    "list"
    "check"
    "search"
    "stats"
    "report"
    "services"
    "watchdog"
    "fhs"
    "module"
)

# Subcommands that are explicitly blocked even for allowed commands
readonly -a BLOCKED_SUBCOMMANDS=(
    "fix"
    "enforce"
    "enable"
    "disable"
    "add"
    "remove"
    "ban"
    "unban"
    "sync"
    "reload"
    "restart"
    "start"
    "stop"
)

# =============================================================================
# LOGGING
# =============================================================================

log_action() {
    local level="$1"
    local message="$2"
    local user
    user=$(whoami)
    logger -t "$LOG_TAG" -p "auth.$level" "[$user] $message"
}

log_info() { log_action "info" "$*"; }
log_warn() { log_action "warning" "$*"; }
log_error() { log_action "err" "$*"; }

# =============================================================================
# JSON OUTPUT
# =============================================================================

json_error() {
    local code="$1"
    local message="$2"
    cat <<EOF
{
  "success": false,
  "error": {
    "code": "$code",
    "message": "$message"
  },
  "timestamp": "$(date -Iseconds)",
  "wrapper": "nftban-panelctl",
  "version": "$VERSION"
}
EOF
}

json_success() {
    local data="$1"
    cat <<EOF
{
  "success": true,
  "data": $data,
  "timestamp": "$(date -Iseconds)",
  "wrapper": "nftban-panelctl",
  "version": "$VERSION"
}
EOF
}

# =============================================================================
# SECURITY CHECKS
# =============================================================================

check_group_membership() {
    local user
    user=$(whoami)

    # Allow root (for testing/debugging)
    if [[ $EUID -eq 0 ]]; then
        return 0
    fi

    # Check if user is in nftban-panel group
    if id -nG "$user" 2>/dev/null | grep -qw "$PANEL_GROUP"; then
        return 0
    fi

    # Check if user is a panel service account (nftban-*)
    if [[ "$user" =~ ^nftban-(da|cp|pl|wm|panel)$ ]]; then
        return 0
    fi

    return 1
}

is_command_allowed() {
    local cmd="$1"
    local subcmd="${2:-}"

    # Check if command is in allowed list
    local allowed=false
    for allowed_cmd in "${ALLOWED_COMMANDS[@]}"; do
        if [[ "$cmd" == "$allowed_cmd" ]]; then
            allowed=true
            break
        fi
    done

    if [[ "$allowed" != "true" ]]; then
        return 1
    fi

    # Check if subcommand is blocked
    if [[ -n "$subcmd" ]]; then
        for blocked in "${BLOCKED_SUBCOMMANDS[@]}"; do
            if [[ "$subcmd" == "$blocked" ]]; then
                return 2  # Subcommand blocked
            fi
        done
    fi

    return 0
}

validate_against_registry() {
    local cmd="$1"

    # If registry file doesn't exist, fall back to hardcoded list
    if [[ ! -f "$REGISTRY_FILE" ]]; then
        return 0
    fi

    # Check panel_expose field in registry (simple grep check)
    # Format in YAML:
    #   command_name:
    #     panel_expose: true
    if grep -A20 "^${cmd}:" "$REGISTRY_FILE" 2>/dev/null | grep -q "panel_expose: true"; then
        return 0
    fi

    return 1
}

# =============================================================================
# HELP
# =============================================================================

show_help() {
    cat <<EOF
NFTBan Panel Control Wrapper v$VERSION

USAGE:
  nftban-panelctl <command> [subcommand] [options]

DESCRIPTION:
  Secure wrapper for hosting panel integration. Only allows read-only
  commands that are marked as panel_expose=true in the registry.

ALLOWED COMMANDS:
  status              Show system status
  health [summary]    Show health status
  version             Show version info
  list [banned|whitelist]  List IPs
  check <ip>          Check IP status
  search <ip>         Search IP across all sources
  stats [dashboard]   Show statistics
  report [generate]   View reports
  services [status]   Show service status
  watchdog [status]   System resource monitoring
  fhs [status]        FHS compliance status
  module [list]       Module inventory

OPTIONS:
  --help, -h          Show this help
  --version, -v       Show version

OUTPUT:
  All output is JSON formatted for panel integration.

SECURITY:
  - Caller must be in 'nftban-panel' group or root
  - Only read-only commands are allowed
  - All actions are logged to syslog

EXAMPLES:
  nftban-panelctl status
  nftban-panelctl health summary
  nftban-panelctl list banned
  nftban-panelctl check 192.168.1.100
  nftban-panelctl stats dashboard

SERVICE ACCOUNTS:
  nftban-da   DirectAdmin integration
  nftban-cp   cPanel/WHM integration
  nftban-pl   Plesk integration
  nftban-wm   Webmin integration

For full NFTBan CLI, use 'nftban' directly (requires operator privileges).
EOF
}

show_version() {
    json_success "\"nftban-panelctl v$VERSION\""
}

list_allowed_commands() {
    local cmds=""
    for cmd in "${ALLOWED_COMMANDS[@]}"; do
        cmds="${cmds}\"${cmd}\","
    done
    cmds="${cmds%,}"  # Remove trailing comma

    json_success "[${cmds}]"
}

# =============================================================================
# MAIN EXECUTION
# =============================================================================

main() {
    local command="${1:-}"
    local subcommand="${2:-}"

    # Handle help/version flags
    case "$command" in
        --help|-h|help)
            show_help
            exit 0
            ;;
        --version|-v)
            show_version
            exit 0
            ;;
        --list-commands)
            list_allowed_commands
            exit 0
            ;;
        "")
            json_error "MISSING_COMMAND" "No command specified. Use --help for usage."
            exit 1
            ;;
    esac

    # Security check: group membership
    if ! check_group_membership; then
        log_error "ACCESS_DENIED: User not in $PANEL_GROUP group"
        json_error "ACCESS_DENIED" "User must be member of '$PANEL_GROUP' group"
        exit 1
    fi

    # Security check: command allowed
    local check_result
    is_command_allowed "$command" "$subcommand"
    check_result=$?

    if [[ $check_result -eq 1 ]]; then
        log_error "COMMAND_BLOCKED: '$command' not in panel whitelist"
        json_error "COMMAND_NOT_ALLOWED" "Command '$command' is not available for panel integration"
        exit 1
    fi

    if [[ $check_result -eq 2 ]]; then
        log_error "SUBCOMMAND_BLOCKED: '$command $subcommand' contains blocked action"
        json_error "SUBCOMMAND_BLOCKED" "Subcommand '$subcommand' is not allowed for panel integration"
        exit 1
    fi

    # Validate against registry (defense in depth)
    if ! validate_against_registry "$command"; then
        log_warn "REGISTRY_MISMATCH: '$command' not marked panel_expose in registry"
        # Don't fail - registry might not be installed, hardcoded list is authoritative
    fi

    # Check nftban binary exists
    if [[ ! -x "$NFTBAN_BIN" ]]; then
        log_error "NFTBAN_NOT_FOUND: $NFTBAN_BIN not executable"
        json_error "NFTBAN_NOT_FOUND" "NFTBan CLI not found at $NFTBAN_BIN"
        exit 1
    fi

    # Log the action
    log_info "EXECUTE: $command ${*:2}"

    # Execute command with --json flag
    # Remove any existing --json to avoid duplicates, then add it
    local args=()
    local has_json=false

    for arg in "${@:2}"; do
        if [[ "$arg" == "--json" ]]; then
            has_json=true
        fi
        args+=("$arg")
    done

    # Always force JSON output
    if [[ "$has_json" != "true" ]]; then
        args+=("--json")
    fi

    # Execute and capture output
    local output
    local exit_code

    if output=$("$NFTBAN_BIN" "$command" "${args[@]}" 2>&1); then
        exit_code=0
    else
        exit_code=$?
    fi

    # Check if output is already JSON
    if echo "$output" | head -1 | grep -qE '^\s*\{'; then
        # Output is JSON, pass through (but wrap in success envelope if needed)
        if echo "$output" | grep -q '"success"'; then
            echo "$output"
        else
            # Wrap raw JSON data
            json_success "$output"
        fi
    else
        # Output is not JSON, convert to JSON
        if [[ $exit_code -eq 0 ]]; then
            # Escape output for JSON
            local escaped
            escaped=$(echo "$output" | sed 's/\\/\\\\/g; s/"/\\"/g; s/\t/\\t/g' | tr '\n' '\\n' | sed 's/\\n$//')
            json_success "\"$escaped\""
        else
            json_error "COMMAND_FAILED" "Command failed with exit code $exit_code: $output"
        fi
    fi

    exit $exit_code
}

# Run main with all arguments
main "$@"

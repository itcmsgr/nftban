 561: # Get NFTables firewall counters (packets and bytes per rule/chain)
 562: # Schema v0.7.3: Uses separate ip/ip6 tables, aggregates both families
 563: get_nftables_counters() {
 564:     if ! command -v nft &>/dev/null; then
 565:         return
 566:     fi
 567: 
 568:     # Get counters from both IPv4 and IPv6 tables and aggregate them
 569:     local ipv4_data
 570:     local ipv6_data
 571: 
 572:     # IPv4 counters
 573:     ipv4_data=$(nft list chain ip nftban input 2>/dev/null || echo "")
 574:     # IPv6 counters
 575:     ipv6_data=$(nft list chain ip6 nftban input 2>/dev/null || echo "")
 576: 
 577:     # Default drop counters (aggregate IPv4 + IPv6)
 578:     local ipv4_drop_pkts ipv4_drop_bytes ipv6_drop_pkts ipv6_drop_bytes
 579:     ipv4_drop_pkts=$(echo "$ipv4_data" | grep "default deny" | grep -oP 'counter packets \K\d+' || echo "0")
 580:     ipv4_drop_bytes=$(echo "$ipv4_data" | grep "default deny" | grep -oP 'bytes \K\d+' || echo "0")
 581:     ipv6_drop_pkts=$(echo "$ipv6_data" | grep "default deny" | grep -oP 'counter packets \K\d+' || echo "0")
 582:     ipv6_drop_bytes=$(echo "$ipv6_data" | grep "default deny" | grep -oP 'bytes \K\d+' || echo "0")
 583: 
 584:     local total_drop_pkts=$((ipv4_drop_pkts + ipv6_drop_pkts))
 585:     local total_drop_bytes=$((ipv4_drop_bytes + ipv6_drop_bytes))
 586:     echo "default_drop ${total_drop_pkts} ${total_drop_bytes}"
 587: 
 588:     # Blacklist counters (unified blacklist_ipv4 set in schema v0.7.3)
 589:     local ipv4_bl_pkts ipv4_bl_bytes ipv6_bl_pkts ipv6_bl_bytes
 590:     ipv4_bl_pkts=$(echo "$ipv4_data" | grep "@blacklist_ipv4" | grep -oP 'counter packets \K\d+' || echo "0")
 591:     ipv4_bl_bytes=$(echo "$ipv4_data" | grep "@blacklist_ipv4" | grep -oP 'bytes \K\d+' || echo "0")
 592:     ipv6_bl_pkts=$(echo "$ipv6_data" | grep "@blacklist_ipv6" | grep -oP 'counter packets \K\d+' || echo "0")
 593:     ipv6_bl_bytes=$(echo "$ipv6_data" | grep "@blacklist_ipv6" | grep -oP 'bytes \K\d+' || echo "0")
 594: 
 595:     local total_bl_pkts=$((ipv4_bl_pkts + ipv6_bl_pkts))
 596:     local total_bl_bytes=$((ipv4_bl_bytes + ipv6_bl_bytes))
 597:     echo "blacklist ${total_bl_pkts} ${total_bl_bytes}"
 598: 
 599:     # Whitelist accept counters
 600:     local ipv4_wl_pkts ipv4_wl_bytes ipv6_wl_pkts ipv6_wl_bytes
 601:     ipv4_wl_pkts=$(echo "$ipv4_data" | grep "@whitelist_ipv4" | grep -oP 'counter packets \K\d+' || echo "0")
 602:     ipv4_wl_bytes=$(echo "$ipv4_data" | grep "@whitelist_ipv4" | grep -oP 'bytes \K\d+' || echo "0")
 603:     ipv6_wl_pkts=$(echo "$ipv6_data" | grep "@whitelist_ipv6" | grep -oP 'counter packets \K\d+' || echo "0")
 604:     ipv6_wl_bytes=$(echo "$ipv6_data" | grep "@whitelist_ipv6" | grep -oP 'bytes \K\d+' || echo "0")
 605: 
 606:     local total_wl_pkts=$((ipv4_wl_pkts + ipv6_wl_pkts))
 607:     local total_wl_bytes=$((ipv4_wl_bytes + ipv6_wl_bytes))
 608:     echo "whitelist ${total_wl_pkts} ${total_wl_bytes}"
 609: 
 610:     # ICMP counters
 611:     local ipv4_icmp_pkts ipv4_icmp_bytes ipv6_icmp_pkts ipv6_icmp_bytes
 612:     ipv4_icmp_pkts=$(echo "$ipv4_data" | grep "ICMPv4" | grep -oP 'counter packets \K\d+' || echo "0")
 613:     ipv4_icmp_bytes=$(echo "$ipv4_data" | grep "ICMPv4" | grep -oP 'bytes \K\d+' || echo "0")
 614:     ipv6_icmp_pkts=$(echo "$ipv6_data" | grep "ICMPv6" | grep -oP 'counter packets \K\d+' || echo "0")
 615:     ipv6_icmp_bytes=$(echo "$ipv6_data" | grep "ICMPv6" | grep -oP 'bytes \K\d+' || echo "0")
 616: 
 617:     local total_icmp_pkts=$((ipv4_icmp_pkts + ipv6_icmp_pkts))
 618:     local total_icmp_bytes=$((ipv4_icmp_bytes + ipv6_icmp_bytes))
 619:     echo "icmp_accept ${total_icmp_pkts} ${total_icmp_bytes}"
 620: 
 621:     # Established connections
 622:     local ipv4_est_pkts ipv4_est_bytes ipv6_est_pkts ipv6_est_bytes
 623:     ipv4_est_pkts=$(echo "$ipv4_data" | grep "established" | grep -oP 'counter packets \K\d+' || echo "0")
 624:     ipv4_est_bytes=$(echo "$ipv4_data" | grep "established" | grep -oP 'bytes \K\d+' || echo "0")
 625:     ipv6_est_pkts=$(echo "$ipv6_data" | grep "established" | grep -oP 'counter packets \K\d+' || echo "0")
 626:     ipv6_est_bytes=$(echo "$ipv6_data" | grep "established" | grep -oP 'bytes \K\d+' || echo "0")
 627: 
 628:     local total_est_pkts=$((ipv4_est_pkts + ipv6_est_pkts))
 629:     local total_est_bytes=$((ipv4_est_bytes + ipv6_est_bytes))
 630:     echo "established ${total_est_pkts} ${total_est_bytes}"
 631: }

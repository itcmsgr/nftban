// =============================================================================
// NFTBan Auth Helper - Polkit Authorization Rule (TEMPLATE)
// =============================================================================
// SPDX-License-Identifier: MPL-2.0
// Purpose: Allow nftban group to run auth helper via pkexec without prompting
//
// THIS IS A TEMPLATE FILE - DO NOT INSTALL DIRECTLY
// The @NFTBAN_AUTH_BIN@ placeholder is replaced at install time with the
// value from /etc/nftban/nftban.conf
//
// Install generates: /etc/polkit-1/rules.d/50-nftban-auth.rules
//
// Groups:
//   nftban: All NFTBan operators (CLI, services, web UI)
//   nftban-auditors: Read-only audit access (separate)
// =============================================================================

polkit.addRule(function(action, subject) {
    // Allow running auth helper via pkexec without prompt
    // Path is replaced at install time from NFTBAN_AUTH_BIN in nftban.conf
    if (action.id === "org.freedesktop.policykit.exec" &&
        action.lookup("polkit.exec.path") === "@NFTBAN_AUTH_BIN@") {
        if (subject.isInGroup("nftban")) {
            return polkit.Result.YES; // non-interactive allow
        }
        return polkit.Result.NO;
    }
});

297: // dumpSet reads IPs from a nftables set
298: func dumpSet(setName string) ([]string, error) {
299: 	cmd := exec.Command("nft", "list", "set", setName)
300: 	output, err := cmd.Output()
301: 	if err != nil {
302: 		return nil, err
303: 	}
304: 
305: 	var ips []string
306: 	scanner := bufio.NewScanner(bytes.NewReader(output))
307: 	inElements := false
308: 
309: 	for scanner.Scan() {
310: 		line := strings.TrimSpace(scanner.Text())
311: 
312: 		if strings.HasPrefix(line, "elements = {") {
313: 			inElements = true
314: 			line = strings.TrimPrefix(line, "elements = {")
315: 			line = strings.TrimSuffix(line, "}")
316: 		}
317: 
318: 		if inElements {
319: 			// Parse IP addresses (remove timeout, expires, etc)
320: 			fields := strings.Split(line, ",")
321: 			for _, field := range fields {
322: 				field = strings.TrimSpace(field)
323: 				if field == "" || field == "}" {
324: 					continue
325: 				}
326: 				// Remove timeout/expires annotations
327: 				ip := strings.Fields(field)[0]
328: 				ips = append(ips, ip)
329: 			}
330: 
331: 			if strings.HasSuffix(line, "}") {
332: 				break
333: 			}
334: 		}
335: 	}
336: 
337: 	return ips, nil
338: }

 339: cmd_suricata_status() {
 340:     echo ""
 341:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
 342:     echo "  🛡️  Suricata IDS Status"
 343:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
 344:     echo ""
 345: 
 346:     # Installation status

 448: # Update peak values
 449: update_peaks() {
 450:     local rx_mbps=$1
 451:     local tx_mbps=$2
 452:     local current_ts=$3
 453: 
 454:     # Initialize peaks file if missing
 455:     if [[ ! -f "$PEAK_FILE" ]]; then
 456:         echo "0 0 $current_ts" > "$PEAK_FILE"
 457:     fi
 458: 
 459:     # Read current peaks
 460:     local peak_data
 461:     local peak_rx
 462:     local peak_tx
 463:     local peak_ts
 464:     peak_data=$(cat "$PEAK_FILE")
 465:     peak_rx=$(echo "$peak_data" | awk '{print $1}')
 466:     peak_tx=$(echo "$peak_data" | awk '{print $2}')
 467:     peak_ts=$(echo "$peak_data" | awk '{print $3}')
 468: 
 469:     # Check if peak window expired (5 minutes)
 470:     if [[ $(( current_ts - peak_ts )) -gt $PEAK_WINDOW ]]; then
 471:         # Reset peaks
 472:         peak_rx=$rx_mbps
 473:         peak_tx=$tx_mbps
 474:         peak_ts=$current_ts
 475:     else
 476:         # Update peaks if current is higher
 477:         peak_rx=$(awk -v curr="$rx_mbps" -v peak="$peak_rx" 'BEGIN {print (curr > peak) ? curr : peak}')
 478:         peak_tx=$(awk -v curr="$tx_mbps" -v peak="$peak_tx" 'BEGIN {print (curr > peak) ? curr : peak}')
 479:     fi
 480: 
 481:     # Save peaks
 482:     echo "$peak_rx $peak_tx $peak_ts" > "$PEAK_FILE"
 483: 
 484:     # Output peaks
 485:     echo "$peak_rx $peak_tx"
 486: }

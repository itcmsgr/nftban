 54: NFTBAN_CPANEL_UDP_IN="20,21,53,80,443"
 55: 
 56: # UDP OUTPUT (outgoing connections)
 57: # Ports: FTP(20,21), DNS(53), Ident(113), NTP(123), Rsync(873),
 58: #        cPanel dnsadmin(6277), CloudLinux(24441)

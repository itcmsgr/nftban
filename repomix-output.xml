<file path="scripts/validate_cli_help.sh">
  1: #!/bin/bash
  2: # =============================================================================
  3: # NFTBan CLI Help Validation Script
  4: # =============================================================================
  5: # Validates that all CLI commands have proper help functions
  6: #
  7: # Usage:
  8: #   ./validate_cli_help.sh
  9: #
 10: # Exit codes:
 11: #   0 - All commands have help functions
 12: #   N - Number of commands missing help
 13: #
 14: # =============================================================================
 15: 
 16: set -euo pipefail
 17: 
 18: CLI_DIR="${NFTBAN_LIB_DIR:-/usr/lib/nftban}/cli"
 19: 
 20: # Fallback for development environment
 21: if [[ ! -d "$CLI_DIR" ]]; then
 22:     CLI_DIR="/home/gituser/github/nftban-v1.0-dev/cli/lib/nftban/cli"
 23: fi
 24: 
 25: if [[ ! -d "$CLI_DIR" ]]; then
 26:     echo "ERROR: CLI directory not found: $CLI_DIR" >&2
 27:     exit 1
 28: fi
 29: 
 30: echo "=============================================="
 31: echo "NFTBan CLI Help Function Validation"
 32: echo "=============================================="
 33: echo ""
 34: echo "Directory: $CLI_DIR"
 35: echo ""
 36: 
 37: total=0
 38: missing=0
 39: ok=0
 40: 
 41: declare -a missing_cmds=()
 42: 
 43: for cmd_file in "$CLI_DIR"/cmd_*.sh; do
 44:     ((total++))
 45: 
 46:     cmd_name=$(basename "$cmd_file" .sh | sed 's/cmd_//' | sed 's/_/-/g')
 47:     func_name="${cmd_name//-/_}"
 48: 
 49:     # Check for any help function pattern
 50:     has_help=false
 51: 
 52:     for pattern in \
 53:         "_nftban_${func_name}_help()" \
 54:         "show_${func_name}_help()" \
 55:         "show_usage()" \
 56:         "_${func_name}_help()" \
 57:         "${func_name}_help()"
 58:     do
 59:         if grep -q "^${pattern%()}()" "$cmd_file" 2>/dev/null || \
 60:            grep -q "^function ${pattern%()}" "$cmd_file" 2>/dev/null; then
 61:             has_help=true
 62:             break
 63:         fi
 64:     done
 65: 
 66:     if [[ "$has_help" == "true" ]]; then
 67:         echo "✓ $cmd_name"
 68:         ((ok++))
 69:     else
 70:         echo "✗ $cmd_name - MISSING help function"
 71:         ((missing++))
 72:         missing_cmds+=("$cmd_name")
 73:     fi
 74: done
 75: 
 76: echo ""
 77: echo "=============================================="
 78: echo "Summary"
 79: echo "=============================================="
 80: echo "Total commands:  $total"
 81: echo "With help:       $ok"
 82: echo "Missing help:    $missing"
 83: echo ""
 84: 
 85: if [[ $missing -gt 0 ]]; then
 86:     echo "Commands missing help functions:"
 87:     for cmd in "${missing_cmds[@]}"; do
 88:         echo "  - $cmd"
 89:     done
 90:     echo ""
 91:     echo "To add help, create a function in the command file:"
 92:     echo ""
 93:     echo '  _nftban_<command>_help() {'
 94:     echo '      cat <<'\''HELP'\'''
 95:     echo '  USAGE:'
 96:     echo '      nftban <command> [options]'
 97:     echo '  ...'
 98:     echo '  HELP'
 99:     echo '  }'
100:     echo ""
101: fi
102: 
103: exit $missing
</file>


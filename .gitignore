# =============================================================================
# NFTBan .gitignore
# =============================================================================

# Build artifacts
bin/
dist/
build/
# Exception: FHS spec files are tracked
!build/fhs-spec.yaml
!build/generate-fhs-outputs.sh
*.o
*.a

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test artifacts
*.test
*.out
coverage.html
coverage.txt

# IDE and editor
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Claude Code (local dev settings)
.claude/

# Local environment
.env
.env.local
*.local
# Exception: Track .conf.local templates in source tree (shipped as empty templates)
!etc/nftban/conf.d/**/*.local

# Node modules (for web UI)
node_modules/

# Temporary files
*.tmp
*.temp
*.log
*.bak

# SEC-INFRA: sanitized SYNTHETIC parser fixtures (reserved values only — RFC5737/
# RFC3849 IPs + *.example.test domains; NO real customer/operator data). Tracked
# so parser tests get real coverage in CI. Real production logs must NEVER live
# under the repo tree (even gitignored) — sanitize to a synthetic fixture, then
# delete the source. Only these exact sanitized files are un-ignored:
!internal/loginmon/pipeline/testdata/exim/auth_failures_a.log
!internal/loginmon/pipeline/testdata/exim/auth_failures_b.log
!internal/loginmon/pipeline/testdata/dovecot/auth_failures_a.log
!internal/loginmon/pipeline/testdata/dovecot/auth_failures_b.log
!internal/loginmon/pipeline/testdata/directadmin/login_sample.log

# Package artifacts
*.rpm
*.deb
*.tar.gz
*.tgz

# Go daemon binary (at repo root only, not cmd/nftband/ source dir)
/nftband

# Debug
*.debug
__debug_bin

# Local test data
*.mmdb
GeoLite2-*.mmdb

# Config files with secrets (examples are ok)
/etc/nftban/*.conf
!/etc/nftban/*.conf.example
bin/
dist/

# Repomix analysis files
repomix*.json
repomix*.xml

# PR-25 §28 evidence — internal lab snapshots (host names + infra
# detail are private). Real evidence lives at:
#   /home/commonfolder/LLMAI4NFTBAN/V1.90_AUDIT_WIKI_CODE/PR25_EVIDENCE_4B4/
evidence/
pr25-evidence/

# Private lab/fleet infrastructure map — never commit (use .example template)
scripts/lab-deploy-servers.conf
# Private exact host/IP patterns for privacy-scan (never commit)
scripts/ci/privacy-forbidden.txt
/nftban-core

# v1.226.0 PR-C: ci-bash informational runner manifest (CI runtime artifact)
ci-bash-manifest.txt

# v1.229: CI-cached, SHA-pinned yq (packaging/build_nftban.sh PROV_YQ_SHA256).
# Never committed — provision_yq re-verifies the checksum wherever it came from.
offline/yq_linux_amd64

# v1.229.4 SC-B — Python bytecode cache from the CI authorities.
# ⛔ THIS IS THE PROVEN CAUSE OF THE `+dirty` BUILD STAMP. CI runs scripts/ci/*.py
# (test-authority.py, privacy-scan.py, ...) BEFORE the release build. Python writes
# __pycache__/, `git status --porcelain` reports it as untracked, Go's VCS stamper reads

# v1.229.6: the SLSA reusable builder runs `go mod vendor` in the project checkout
# immediately before compiling (builder_go_slsa3.yml@v2.1.0, job "build", step
# "Download dependencies"). That materializes vendor/ as an untracked directory, git
# reports the worktree as dirty, and Go's VCS stamper records vcs.modified=true — which
# is why every SLSA-built nftban-core has shipped +dirty (v1.229.3, v1.229.5) while our
# own build path, which never vendors, has not.
#   MEASURED: an untracked vendor/ produces exactly one dirty path in this repository.
# ⛔ Scoped to that measured producer. This is NOT a general gitignore cleanup, and it is
#    a DIFFERENT cause from the __pycache__ entry above — same shape, separate producer.
vendor/
# any unclean tree as dirty, and both shipped binaries were stamped +dirty.
# MEASURED on the release path (run 32292166763):
#     DIRTY_PATH_COUNT=1  ->  ?? scripts/ci/__pycache__/
#     tracked source modified: NONE · staged: NONE · unstaged: NONE
# ⛔ The dirtiness was never about the source. It was our own tooling's build artifact.
__pycache__/
*.py[cod]

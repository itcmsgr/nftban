<file path="cli/lib/nftban/lib/nft_schema.sh">
   1: #!/usr/bin/env bash
   2: # =============================================================================
   3: # NFTBan v1.0.0 - Canonical NFT Schema Specification
   4: # =============================================================================
   5: # SPDX-License-Identifier: MPL-2.0
   6: # Purpose: Single source of truth for nftables table/set/chain structure
   7: #
   8: # meta:name=nft_schema
   9: # meta:type=library
  10: # meta:header=NFT Schema Specification
  11: # meta:version=1.0.0
  12: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
  13: # meta:homepage=https://nftban.com
  14: #
  15: # **Description & Purpose**
  16: # meta:description=Canonical nftables schema to prevent table structure drift
  17: # meta:input=None (defines constants)
  18: # meta:output=Table/set/chain specifications and validation functions
  19: #
  20: # **Inventory & Requirements**
  21: # meta:depends=bash>=4.0,nftables>=0.9.3
  22: #
  23: # meta:created_date=2025-11-27
  24: # =============================================================================
  25: 
  26: # Prevent double-loading
  27: [[ -n "${NFTBAN_NFT_SCHEMA_LOADED:-}" ]] && return 0
  28: readonly NFTBAN_NFT_SCHEMA_LOADED=1
  29: 
  30: # =============================================================================
  31: # CANONICAL NFTABLES ARCHITECTURE
  32: # =============================================================================
  33: #
  34: # NFTBan uses SEPARATE IPv4/IPv6 TABLES (ip/ip6 families)
  35: #
  36: # WHY SEPARATE TABLES (ip/ip6) instead of COMBINED (inet)?
  37: # --------------------------------------------------------
  38: # ✅ Cleaner:      No _v4/_v6 suffixes on set names
  39: # ✅ Simpler:      No ip/ip6 prefixes in rules (kernel knows family)
  40: # ✅ Performance:  Kernel routes by family first anyway
  41: # ✅ Port mgmt:    Each family has own tcp_ports/udp_ports sets
  42: # ✅ Maintenance:  Clear separation, easier to debug
  43: # ✅ Efficiency:   No mixed-family lookups, direct routing
  44: #
  45: # WRONG APPROACH (inet dual-stack):
  46: #   set blacklist_v4 { ... }   # Need suffix
  47: #   set blacklist_v6 { ... }   # Need suffix
  48: #   ip saddr @blacklist_v4     # Need ip prefix
  49: #   ip6 saddr @blacklist_v6    # Need ip6 prefix
  50: #
  51: # CORRECT APPROACH (separate ip/ip6):
  52: #   table ip nftban {
  53: #     set blacklist { ... }    # Clean name
  54: #     ip saddr @blacklist      # No prefix needed (implicit)
  55: #   }
  56: #   table ip6 nftban {
  57: #     set blacklist { ... }    # Clean name
  58: #     ip6 saddr @blacklist     # No prefix needed (implicit)
  59: #   }
  60: #
  61: # =============================================================================
  62: # CRITICAL: RULE ORDER IN INPUT CHAIN
  63: # =============================================================================
  64: #
  65: # The order of rules in the input chain is SECURITY-CRITICAL!
  66: # INCORRECT ORDER can allow banned IPs to bypass blocking.
  67: #
  68: # ✅ CORRECT ORDER (enforce bans BEFORE established connections):
  69: #
  70: # Priority  | Rule                          | Reason
  71: # ----------|-------------------------------|----------------------------------
  72: # 1.        | ct state invalid → drop       | Malformed packets
  73: # 2.        | iif lo → accept               | Loopback always allowed
  74: # 3.        | whitelist → accept            | Trusted IPs bypass all checks
  75: # 4.        | blacklist → drop              | ⚠️ BEFORE established! (permanent + temporary with timeout)
  76: # 5.        | ct state established → accept | ✅ NOW SAFE (after all bans)
  77: # 6.        | ICMP → accept                 | Ping, etc.
  78: # 7.        | CT limits → drop              | DDoS protection (rate/connection limits)
  79: # 8.        | Services (SSH/HTTP) → accept  | Public services
  80: # 9.        | default deny                  | Drop everything else
  81: #
  82: # ❌ SECURITY BUG: Placing "ct state established,related accept" BEFORE
  83: #    blacklist checks allows attackers to keep connections after being banned!
  84: #
  85: # =============================================================================
  86: 
  87: # =============================================================================
  88: # TABLE: ip nftban (IPv4 PRIMARY TABLE)
  89: # =============================================================================
  90: 
  91: readonly NFTBAN_TABLE_IPV4_FAMILY="ip"
  92: readonly NFTBAN_TABLE_IPV4_NAME="nftban"
  93: readonly NFTBAN_TABLE_IPV4="${NFTBAN_TABLE_IPV4_FAMILY} ${NFTBAN_TABLE_IPV4_NAME}"
  94: 
  95: # Sets in ip nftban (IPv4)
  96: declare -g -A NFTBAN_IPV4_SETS=(
  97:     # Whitelist - ALL trusted IPs consolidated
  98:     ["whitelist_ipv4"]="ipv4_addr|interval|Whitelist (admin IPs + internal networks)"
  99: 
 100:     # Blacklist - ALL blocked IPs consolidated by nftban-core
 101:     # Sources: manual bans + threat feeds + geoban + country blocking
 102:     # Supports BOTH permanent and temporary bans via timeout parameter
 103:     # - Permanent: nft add element ip nftban blacklist_ipv4 { 1.2.3.4 }
 104:     # - Temporary: nft add element ip nftban blacklist_ipv4 { 1.2.3.4 timeout 1h }
 105:     # Metadata (reason, date, source) stored in config files, NOT in NFT
 106:     ["blacklist_ipv4"]="ipv4_addr|interval,timeout|Blacklist (permanent + temporary with timeout)"
 107: 
 108:     # Service ports
 109:     ["tcp_ports"]="inet_service||Allowed TCP ports"
 110:     ["udp_ports"]="inet_service||Allowed UDP ports"
 111: )
 112: 
 113: # Chains in ip nftban (IPv4)
 114: # BASE CHAINS (mandatory - always present)
 115: declare -g -A NFTBAN_IPV4_CHAINS=(
 116:     ["input"]="filter|input|0|drop|Main IPv4 input chain"
 117:     ["forward"]="filter|forward|0|drop|IPv4 forward chain"
 118:     ["output"]="filter|output|0|accept|IPv4 output chain"
 119: )
 120: 
 121: # HELPER CHAINS (optional - modular protection features)
 122: # These chains MAY exist when protection features are enabled
 123: # If present, they MUST be called via "jump" from input chain AFTER ct state established
 124: # Helper chains - reserved for nftables schema validation
 125: # shellcheck disable=SC2034
 126: declare -g -A NFTBAN_IPV4_HELPER_CHAINS=(
 127:     ["portscan_detection"]="optional|Port scan detection logging"
 128:     ["ddos_protection"]="optional|DDoS protection (SYN flood, conn limits, rate limits)"
 129:     ["synflood_protection"]="optional|SYN flood protection (deprecated - use ddos_protection)"
 130:     ["connlimit_protection"]="optional|Connection limit protection (deprecated - use ddos_protection)"
 131:     ["portflood_protection"]="optional|Port flood protection (deprecated - use ddos_protection)"
 132:     ["icmp_protection"]="optional|ICMP flood protection (deprecated - use ddos_protection)"
 133: )
 134: 
 135: # =============================================================================
 136: # TABLE: ip6 nftban (IPv6 PRIMARY TABLE)
 137: # =============================================================================
 138: 
 139: readonly NFTBAN_TABLE_IPV6_FAMILY="ip6"
 140: readonly NFTBAN_TABLE_IPV6_NAME="nftban"
 141: readonly NFTBAN_TABLE_IPV6="${NFTBAN_TABLE_IPV6_FAMILY} ${NFTBAN_TABLE_IPV6_NAME}"
 142: 
 143: # Sets in ip6 nftban (IPv6)
 144: declare -g -A NFTBAN_IPV6_SETS=(
 145:     # Whitelist - ALL trusted IPs consolidated
 146:     ["whitelist_ipv6"]="ipv6_addr|interval|Whitelist (admin IPs + internal networks)"
 147: 
 148:     # Blacklist - ALL blocked IPs consolidated by nftban-core
 149:     # Sources: manual bans + threat feeds + geoban + country blocking
 150:     # Supports BOTH permanent and temporary bans via timeout parameter
 151:     # - Permanent: nft add element ip6 nftban blacklist_ipv6 { 2001:db8::1 }
 152:     # - Temporary: nft add element ip6 nftban blacklist_ipv6 { 2001:db8::1 timeout 1h }
 153:     # Metadata (reason, date, source) stored in config files, NOT in NFT
 154:     ["blacklist_ipv6"]="ipv6_addr|interval,timeout|Blacklist (permanent + temporary with timeout)"
 155: 
 156:     # Service ports
 157:     ["tcp_ports"]="inet_service||Allowed TCP ports"
 158:     ["udp_ports"]="inet_service||Allowed UDP ports"
 159: )
 160: 
 161: # Chains in ip6 nftban (IPv6)
 162: # BASE CHAINS (mandatory - always present)
 163: declare -g -A NFTBAN_IPV6_CHAINS=(
 164:     ["input"]="filter|input|0|drop|Main IPv6 input chain"
 165:     ["forward"]="filter|forward|0|drop|IPv6 forward chain"
 166:     ["output"]="filter|output|0|accept|IPv6 output chain"
 167: )
 168: 
 169: # HELPER CHAINS (optional - modular protection features)
 170: # These chains MAY exist when protection features are enabled
 171: # If present, they MUST be called via "jump" from input chain AFTER ct state established
 172: declare -g -A NFTBAN_IPV6_HELPER_CHAINS=(
 173:     ["portscan_detection"]="optional|Port scan detection logging"
 174:     ["ddos_protection"]="optional|DDoS protection (SYN flood, conn limits, rate limits)"
 175:     ["synflood_protection"]="optional|SYN flood protection (deprecated - use ddos_protection)"
 176:     ["connlimit_protection"]="optional|Connection limit protection (deprecated - use ddos_protection)"
 177:     ["portflood_protection"]="optional|Port flood protection (deprecated - use ddos_protection)"
 178:     ["icmp_protection"]="optional|ICMP flood protection (deprecated - use ddos_protection)"
 179: )
 180: 
 181: # =============================================================================
 182: # DEPRECATED TABLES (SHOULD NOT EXIST - LEGACY FROM UPGRADES)
 183: # =============================================================================
 184: 
 185: declare -g -A NFTBAN_DEPRECATED_TABLES=(
 186:     ["inet nftban"]="OLD: v0.6.0-beta single inet table (deprecated)"
 187:     ["inet nftban_main"]="OLD: v0.6.x dual-table approach (deprecated)"
 188:     ["inet nftban_runtime"]="OLD: v0.6.x runtime table (deprecated)"
 189: )
 190: 
 191: # =============================================================================
 192: # CONNECTION TRACKING (CT) AND RATE LIMITS
 193: # =============================================================================
 194: #
 195: # Connection tracking and rate limiting are ESSENTIAL for DDoS protection.
 196: # These limits should be applied in the input chain BEFORE service rules.
 197: #
 198: # CT LIMITS (per source IP):
 199: # ---------------------------
 200: # Purpose: Limit concurrent connections per IP to prevent resource exhaustion
 201: #
 202: # Example rules for input chain:
 203: #   ct state new tcp dport @tcp_ports \
 204: #     meter syn_flood { ip saddr limit rate 100/second burst 200 } accept
 205: #
 206: #   ct state new tcp dport 22 \
 207: #     ct count over 5 drop comment "SSH: max 5 concurrent connections per IP"
 208: #
 209: #   ct state new tcp dport { 80, 443 } \
 210: #     ct count over 50 drop comment "HTTP(S): max 50 concurrent connections per IP"
 211: #
 212: # RATE LIMITS (connection rate per IP):
 213: # --------------------------------------
 214: # Purpose: Limit NEW connection rate per IP to prevent flood attacks
 215: #
 216: # Example rules:
 217: #   tcp flags syn ct state new \
 218: #     limit rate 100/second burst 200 packets \
 219: #     log prefix "nftban: portscan: "
 220: #
 221: #   tcp flags syn ct state new \
 222: #     meter syn_rate { ip saddr limit rate 10/second burst 20 } accept
 223: #
 224: # CONNECTION STATE TRACKING:
 225: # --------------------------
 226: # CRITICAL: "ct state established,related accept" MUST come AFTER all ban checks!
 227: # See RULE ORDER section above for correct placement.
 228: #
 229: # Global connection limits (optional):
 230: #   ct state new limit rate 1000/second burst 2000 accept
 231: #
 232: # =============================================================================
 233: # HELPER CHAINS (OPTIONAL MODULAR PROTECTION)
 234: # =============================================================================
 235: #
 236: # NFTBan v1.0.0+ supports OPTIONAL helper chains for modular protection features.
 237: #
 238: # ARCHITECTURE:
 239: # -------------
 240: # Base chains (input, forward, output) = MANDATORY (always present)
 241: # Helper chains (portscan_detection, ddos_protection) = OPTIONAL (created by enable commands)
 242: #
 243: # HELPER CHAIN LIFECYCLE:
 244: # -----------------------
 245: # 1. nftban portscan enable:
 246: #    - Creates chain "portscan_detection" with logging rules
 247: #    - Adds "jump portscan_detection" to input chain (after ct state established)
 248: #
 249: # 2. nftban portscan disable:
 250: #    - Removes jump rule from input chain
 251: #    - Deletes "portscan_detection" chain
 252: #
 253: # STATUS CHECKING:
 254: # ----------------
 255: # Enabled  = chain exists AND jump rule present in input
 256: # Disabled = chain absent OR jump rule absent
 257: #
 258: # JUMP RULE PLACEMENT:
 259: # --------------------
 260: # Helper chains MUST be called from input chain in this order:
 261: # 1. After: ct state established,related accept
 262: # 2. Before: ICMP rules
 263: # 3. Before: Service rules (tcp dport @tcp_ports)
 264: #
 265: # Example input chain with helper chains:
 266: #
 267: #   chain input {
 268: #       type filter hook input priority 0; policy drop;
 269: #       iif "lo" accept
 270: #       ct state invalid drop
 271: #       ip saddr @whitelist_ipv4 accept
 272: #       ip saddr @blacklist_ipv4 drop
 273: #       ct state established,related accept
 274: #
 275: #       # Helper chain jumps (if enabled)
 276: #       jump ddos_protection comment "DDoS protection module"
 277: #       jump portscan_detection comment "Portscan detection module"
 278: #
 279: #       # Service rules
 280: #       ip protocol icmp icmp type { ... } accept
 281: #       tcp dport @tcp_ports ct state new accept
 282: #       udp dport @udp_ports ct state new accept
 283: #       drop
 284: #   }
 285: #
 286: # HELPER CHAIN: portscan_detection
 287: # ---------------------------------
 288: # Purpose: Log connection attempts for portscan analysis
 289: # Rules:
 290: #   tcp flags syn ct state new limit rate 10/minute burst 20 \
 291: #       log prefix "nftban: portscan: "
 292: #   return
 293: #
 294: # HELPER CHAIN: ddos_protection
 295: # ------------------------------
 296: # Purpose: Rate limiting and connection limits
 297: # Rules:
 298: #   # SYN flood protection
 299: #   tcp flags syn tcp dport @tcp_ports \
 300: #       meter syn_flood { ip saddr limit rate 10/second burst 20 } return
 301: #   tcp flags syn tcp dport @tcp_ports drop
 302: #
 303: #   # Connection limits per service
 304: #   tcp dport 22 ct state new ct count over 5 drop
 305: #   tcp dport { 80, 443 } ct state new ct count over 50 drop
 306: #
 307: #   # ICMP rate limit
 308: #   ip protocol icmp limit rate 10/second burst 20 return
 309: #   ip protocol icmp drop
 310: #
 311: #   return
 312: #
 313: # =============================================================================
 314: # PORT MANAGEMENT
 315: # =============================================================================
 316: #
 317: # Port sets define which services are exposed to the internet.
 318: # Each family (ip/ip6) has its own port sets.
 319: #
 320: # SET DEFINITIONS:
 321: # ----------------
 322: # tcp_ports: TCP services (SSH, HTTP, HTTPS, custom)
 323: # udp_ports: UDP services (DNS, NTP, VPN, custom)
 324: #
 325: # ADVANTAGES OF PORT SETS:
 326: # -------------------------
 327: # ✅ Dynamic updates: Add/remove ports without firewall reload
 328: # ✅ Atomic changes: Port list updates are atomic operations
 329: # ✅ Cleaner rules: Single rule "tcp dport @tcp_ports accept"
 330: # ✅ Less error-prone: No need to duplicate port lists across rules
 331: #
 332: # EXAMPLE USAGE IN INPUT CHAIN:
 333: # ------------------------------
 334: # tcp dport @tcp_ports ct state new ct count over 50 drop comment "CT limit"
 335: # tcp dport @tcp_ports accept comment "TCP services"
 336: # udp dport @udp_ports accept comment "UDP services"
 337: #
 338: # RUNTIME MANAGEMENT:
 339: # -------------------
 340: # Add port:    nft add element ip nftban tcp_ports { 8080 }
 341: # Remove port: nft delete element ip nftban tcp_ports { 8080 }
 342: # List ports:  nft list set ip nftban tcp_ports
 343: #
 344: # DEFAULT PORTS:
 345: # --------------
 346: # TCP: 22 (SSH), 80 (HTTP), 443 (HTTPS)
 347: # UDP: (empty by default, add as needed)
 348: #
 349: # =============================================================================
 350: # TEMP_BAN OPTIONS
 351: # =============================================================================
 352: #
 353: # Temporary bans (fail2ban) can be stored in TWO ways:
 354: #
 355: # OPTION A: Same table as permanent bans (simpler)
 356: #   - temp_ban_ipv4 set in "ip nftban" table
 357: #   - Advantage: One table, simpler rule order
 358: #   - Disadvantage: Atomic reload must preserve temp_ban set
 359: #
 360: # OPTION B: Separate runtime table (current approach on lab1)
 361: #   - temp_ban_v4 set in "inet nftban_runtime" table
 362: #   - Advantage: Runtime state isolated, never touched by reloads
 363: #   - Disadvantage: Extra table, more complex
 364: #
 365: # RECOMMENDED: Option A (simpler, one table per family)
 366: # =============================================================================
 367: 
 368: # =============================================================================
 369: # VALIDATION FUNCTIONS
 370: # =============================================================================
 371: 
 372: nftban_nft_validate_tables() {
 373:     # Check if required tables exist
 374:     # Returns: 0 if valid, 1 if invalid
 375: 
 376:     local status=0
 377:     local existing_tables
 378:     existing_tables=$(nft list tables 2>/dev/null)
 379: 
 380:     # Check required tables
 381:     if ! echo "$existing_tables" | grep -q "^table ${NFTBAN_TABLE_IPV4}$"; then
 382:         echo "ERROR: Missing required table: ${NFTBAN_TABLE_IPV4}" >&2
 383:         status=1
 384:     fi
 385: 
 386:     if ! echo "$existing_tables" | grep -q "^table ${NFTBAN_TABLE_IPV6}$"; then
 387:         echo "WARNING: Missing IPv6 table: ${NFTBAN_TABLE_IPV6}" >&2
 388:         echo "  (IPv6 support disabled)" >&2
 389:     fi
 390: 
 391:     # Check for deprecated tables
 392:     for deprecated_table in "${!NFTBAN_DEPRECATED_TABLES[@]}"; do
 393:         if echo "$existing_tables" | grep -q "^table ${deprecated_table}$"; then
 394:             echo "INFO: Legacy table exists: ${deprecated_table}" >&2
 395:             echo "  Reason: ${NFTBAN_DEPRECATED_TABLES[$deprecated_table]}" >&2
 396:             echo "  Action: Can be removed after migration to ip/ip6 tables" >&2
 397:         fi
 398:     done
 399: 
 400:     return $status
 401: }
 402: 
 403: nftban_nft_validate_sets() {
 404:     # Check if required sets exist in correct tables
 405:     # Returns: 0 if valid, 1 if invalid
 406: 
 407:     local status=0
 408: 
 409:     # Validate IPv4 table sets
 410:     for set_name in "${!NFTBAN_IPV4_SETS[@]}"; do
 411:         if ! nft list set "${NFTBAN_TABLE_IPV4}" "$set_name" &>/dev/null; then
 412:             echo "ERROR: Missing set in ${NFTBAN_TABLE_IPV4}: $set_name" >&2
 413:             status=1
 414:         fi
 415:     done
 416: 
 417:     # Validate IPv6 table sets (warn only)
 418:     for set_name in "${!NFTBAN_IPV6_SETS[@]}"; do
 419:         if ! nft list set "${NFTBAN_TABLE_IPV6}" "$set_name" &>/dev/null; then
 420:             echo "WARNING: Missing set in ${NFTBAN_TABLE_IPV6}: $set_name" >&2
 421:         fi
 422:     done
 423: 
 424:     return $status
 425: }

259:                     COMPREPLY=($(compgen -W "${global_opts}" -- "${cur}"))
260:                     ;;
261:             esac
262:             ;;
263:         3)
264:             # Complete third-level arguments
265:             local main_cmd="${words[1]}"
266:             local sub_cmd="${words[2]}"
267: 
268:             case "${main_cmd}" in
269:                 login)
270:                     case "${sub_cmd}" in
271:                         enable|disable)
272:                             COMPREPLY=($(compgen -W "${login_targets}" -- "${cur}"))
273:                             ;;
274:                         status|stats)
275:                             COMPREPLY=($(compgen -W "--json" -- "${cur}"))
276:                             ;;
277:                         logs)
278:                             # Suggest common log line counts
279:                             COMPREPLY=($(compgen -W "10 25 50 100 200" -- "${cur}"))
280:                             ;;
281:                     esac
282:                     ;;
283:                 metrics)
284:                     case "${sub_cmd}" in
285:                         enable)
286:                             COMPREPLY=($(compgen -W "--backend prometheus victoria" -- "${cur}"))
287:                             ;;
288:                     esac
289:                     ;;
290:                 profile)
291:                     case "${sub_cmd}" in
292:                         apply)
293:                             COMPREPLY=($(compgen -W "basic standard advanced" -- "${cur}"))
294:                             ;;
295:                     esac
296:                     ;;
297:                 trust)
298:                     case "${sub_cmd}" in
299:                         enable|disable)
300:                             # Trust providers
301:                             COMPREPLY=($(compgen -W "${trust_providers}" -- "${cur}"))
302:                             ;;
303:                     esac
304:                     ;;
305:                 country)
306:                     case "${sub_cmd}" in
307:                         enable|disable)
308:                             # Common country codes
309:                             COMPREPLY=($(compgen -W "${country_codes}" -- "${cur}"))
310:                             ;;
311:                         mode)
312:                             COMPREPLY=($(compgen -W "blacklist whitelist" -- "${cur}"))
313:                             ;;
314:                     esac
315:                     ;;
316:                 geoban)
317:                     case "${sub_cmd}" in
318:                         ban|unban|whitelist|unwhitelist)
319:                             # Common country codes
320:                             COMPREPLY=($(compgen -W "RU CN KP IR SY VE BY CU KZ help" -- "${cur}"))
321:                             ;;
322:                     esac
323:                     ;;
324:                 emulate)
325:                     # After IP, suggest options
326:                     case "${sub_cmd}" in
327:                         --proto)
328:                             COMPREPLY=($(compgen -W "tcp udp icmp" -- "${cur}"))
329:                             ;;
330:                         --direction)
331:                             COMPREPLY=($(compgen -W "in out" -- "${cur}"))
332:                             ;;
333:                         *)
334:                             COMPREPLY=($(compgen -W "--proto --port --direction --json" -- "${cur}"))
335:                             ;;
336:                     esac
337:                     ;;
338:                 ban)
339:                     # After IP address, suggest ban options
340:                     COMPREPLY=($(compgen -W "--timeout --reason --source --json" -- "${cur}"))
341:                     ;;
342:                 stats)
343:                     case "${sub_cmd}" in
344:                         top|ip|recent|export)
345:                             COMPREPLY=($(compgen -W "--json" -- "${cur}"))
346:                             ;;
347:                     esac
348:                     ;;
349:                 timers)
350:                     case "${sub_cmd}" in
351:                         enable|disable)
352:                             # List available timers
353:                             COMPREPLY=($(compgen -W "nftban-health.timer nftban-metrics-exporter.timer nftban-core-geoip.timer nftban-core-feeds.timer nftban-queue.timer nftban-suricata-update.timer nftban-snapshot.timer nftban-rollback.timer" -- "${cur}"))
354:                             ;;
355:                     esac
356:                     ;;
357:             esac
358:             ;;
359:         4)
360:             # Complete fourth-level arguments (e.g., nftban ban IP --timeout 1h)
361:             local main_cmd="${words[1]}"
362:             local option="${words[3]}"
363: 
364:             case "${main_cmd}" in
365:                 ban)
366:                     case "${option}" in
367:                         --timeout)
368:                             # Suggest common timeout values
369:                             COMPREPLY=($(compgen -W "1h 2h 6h 12h 24h 48h 7d 30d" -- "${cur}"))
370:                             ;;
371:                         --source)
372:                             COMPREPLY=($(compgen -W "manual suricata login portscan ddos" -- "${cur}"))
373:                             ;;
374:                     esac
375:                     ;;
376:                 emulate)
377:                     case "${option}" in
378:                         --proto)
379:                             COMPREPLY=($(compgen -W "tcp udp icmp" -- "${cur}"))
380:                             ;;
381:                         --direction)
382:                             COMPREPLY=($(compgen -W "in out" -- "${cur}"))
383:                             ;;
384:                         --port)
385:                             # Common port numbers
386:                             COMPREPLY=($(compgen -W "22 80 443 25 465 587 3306 5432" -- "${cur}"))
387:                             ;;
388:                     esac
389:                     ;;
390:                 metrics)
391:                     case "${option}" in
392:                         --backend)
393:                             COMPREPLY=($(compgen -W "prometheus victoria" -- "${cur}"))
394:                             ;;
395:                     esac
396:                     ;;
397:             esac
398:             ;;
399:     esac
400: 
401:     return 0
402: }
403: 
404: complete -F _nftban nftban
</file>

<file path="install/packaging/build_packages.sh">
  1: #!/bin/bash
  2: # shellcheck disable=SC2155  # Readonly assignments are safe
  3: # SPDX-License-Identifier: MPL-2.0
  4: # SPDX-FileCopyrightText: Copyright (c) 2024-2025 NFTBan Development Team
  5: #
  6: # Build script for nftban-metrics DEB and RPM packages
  7: #
  8: # Usage:
  9: #   ./build_packages.sh [deb|rpm|both]
 10: #
 11: # Examples:
 12: #   ./build_packages.sh         # Build both DEB and RPM
 13: #   ./build_packages.sh deb     # Build DEB only
 14: #   ./build_packages.sh rpm     # Build RPM only
 15: 
 16: set -Eeuo pipefail
 17: 
 18: # Colors for output
 19: readonly RED='\033[0;31m'
 20: readonly GREEN='\033[0;32m'
 21: readonly YELLOW='\033[1;33m'
 22: readonly BLUE='\033[0;34m'
 23: readonly NC='\033[0m' # No Color
 24: 
 25: # Package metadata
 26: readonly PKG_NAME="nftban-metrics"
 27: readonly PKG_VERSION="1.0.0"
 28: readonly PKG_RELEASE="1"
 29: 
 30: # Paths
 31: readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
 32: readonly PROJECT_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
 33: readonly BUILD_DIR="${PROJECT_ROOT}/build"
 34: 
 35: # Functions
 36: log_info() {
 37:     echo -e "${BLUE}[INFO]${NC} $*"
 38: }
 39: 
 40: log_success() {
 41:     echo -e "${GREEN}[SUCCESS]${NC} $*"
 42: }
 43: 
 44: log_warn() {
 45:     echo -e "${YELLOW}[WARN]${NC} $*"
 46: }
 47: 
 48: log_error() {
 49:     echo -e "${RED}[ERROR]${NC} $*"
 50: }
 51: 
 52: check_dependencies() {
 53:     local missing_deps=()
 54: 
 55:     if [[ "$1" == "deb" || "$1" == "both" ]]; then
 56:         if ! command -v dpkg-deb >/dev/null 2>&1; then
 57:             missing_deps+=("dpkg-deb")
 58:         fi
 59:     fi
 60: 
 61:     if [[ "$1" == "rpm" || "$1" == "both" ]]; then
 62:         if ! command -v rpmbuild >/dev/null 2>&1; then
 63:             missing_deps+=("rpmbuild (rpm-build package)")
 64:         fi
 65:     fi
 66: 
 67:     if [ ${#missing_deps[@]} -gt 0 ]; then
 68:         log_error "Missing dependencies: ${missing_deps[*]}"
 69:         log_info "Install dependencies:"
 70:         log_info "  Debian/Ubuntu: sudo apt install dpkg-dev rpm"
 71:         log_info "  RHEL/Fedora: sudo dnf install rpm-build dpkg"
 72:         return 1
 73:     fi
 74: 
 75:     return 0
 76: }
 77: 
 78: build_deb() {
 79:     log_info "Building DEB package..."
 80: 
 81:     local deb_build_dir="${BUILD_DIR}/deb/${PKG_NAME}-${PKG_VERSION}"
 82: 
 83:     # Clean and create build directory
 84:     rm -rf "${deb_build_dir}"
 85:     mkdir -p "${deb_build_dir}/DEBIAN"
 86: 
 87:     # Create directory structure
 88:     mkdir -p "${deb_build_dir}/usr/lib/nftban"/{exporters,setup}
 89:     mkdir -p "${deb_build_dir}/usr/lib/systemd/system/node_exporter.service.d"
 90:     mkdir -p "${deb_build_dir}/usr/share/nftban/prometheus/alerts"
 91:     mkdir -p "${deb_build_dir}/usr/share/nftban/grafana/dashboards"
 92:     mkdir -p "${deb_build_dir}/usr/share/doc/nftban/metrics"
 93: 
 94:     # Copy DEBIAN control files
 95:     cp "${SCRIPT_DIR}/deb/control" "${deb_build_dir}/DEBIAN/"
 96:     cp "${SCRIPT_DIR}/deb/postinst" "${deb_build_dir}/DEBIAN/"
 97:     cp "${SCRIPT_DIR}/deb/prerm" "${deb_build_dir}/DEBIAN/"
 98:     cp "${SCRIPT_DIR}/deb/postrm" "${deb_build_dir}/DEBIAN/"
 99: 
100:     chmod 0755 "${deb_build_dir}/DEBIAN"/{postinst,prerm,postrm}
101: 
102:     # Copy Track 1: Core Metrics Exporter
103:     cp "${PROJECT_ROOT}/work/track1/nftban_prometheus_exporter.sh" \
104:         "${deb_build_dir}/usr/lib/nftban/exporters/"
105:     cp "${PROJECT_ROOT}/work/track1/nftban-metrics-exporter.service" \
106:         "${deb_build_dir}/usr/lib/systemd/system/"
107:     cp "${PROJECT_ROOT}/work/track1/nftban-metrics-exporter.timer" \
108:         "${deb_build_dir}/usr/lib/systemd/system/"
109: 
110:     # Copy Track 2: Node Exporter Setup
111:     cp "${PROJECT_ROOT}/cli/lib/nftban/setup/install_node_exporter.sh" \
112:         "${deb_build_dir}/usr/lib/nftban/setup/"
113:     cp "${PROJECT_ROOT}/cli/lib/nftban/setup/validate_node_exporter.sh" \
114:         "${deb_build_dir}/usr/lib/nftban/setup/"
115:     cp "${PROJECT_ROOT}/install/systemd/node_exporter.service.d/textfile-collector.conf" \
116:         "${deb_build_dir}/usr/lib/systemd/system/node_exporter.service.d/"
117:     cp "${PROJECT_ROOT}/install/systemd/node_exporter.service.d/hardening.conf" \
118:         "${deb_build_dir}/usr/lib/systemd/system/node_exporter.service.d/"
119: 
120:     if [ -f "${PROJECT_ROOT}/docs/metrics/NODE_EXPORTER_SETUP.md" ]; then
121:         cp "${PROJECT_ROOT}/docs/metrics/NODE_EXPORTER_SETUP.md" \
122:             "${deb_build_dir}/usr/share/doc/nftban/metrics/"
123:     fi
124: 
125:     # Copy Track 3: Grafana Dashboards
126:     cp "${PROJECT_ROOT}/install/grafana/dashboards"/*.json \
127:         "${deb_build_dir}/usr/share/nftban/grafana/dashboards/"
128: 
129:     # Copy Track 4: Prometheus Configuration
130:     cp "${PROJECT_ROOT}/cli/lib/nftban/setup/install_prometheus.sh" \
131:         "${deb_build_dir}/usr/lib/nftban/setup/"
132:     cp "${PROJECT_ROOT}/cli/lib/nftban/setup/validate_prometheus.sh" \
133:         "${deb_build_dir}/usr/lib/nftban/setup/"
134:     cp "${PROJECT_ROOT}/install/prometheus"/*.example \
135:         "${deb_build_dir}/usr/share/nftban/prometheus/"
136:     cp "${PROJECT_ROOT}/install/prometheus/alerts/nftban-metrics.yml" \
137:         "${deb_build_dir}/usr/share/nftban/prometheus/alerts/"
138: 
139:     if [ -f "${PROJECT_ROOT}/docs/metrics/PROMETHEUS_SETUP.md" ]; then
140:         cp "${PROJECT_ROOT}/docs/metrics/PROMETHEUS_SETUP.md" \
141:             "${deb_build_dir}/usr/share/doc/nftban/metrics/"
142:     fi
143: 
144:     # Copy Track 10: Security
145:     cp "${PROJECT_ROOT}/install/firewall/metrics-firewall-rules.sh" \
146:         "${deb_build_dir}/usr/lib/nftban/setup/"
147: 
148:     # Note: Security documentation moved to wiki
149:     # See: https://github.com/itcmsgr/nftban/wiki/Security-Operations-Guide
150: 
151:     # Set permissions
152:     chmod 0755 "${deb_build_dir}/usr/lib/nftban/exporters"/*.sh
153:     chmod 0755 "${deb_build_dir}/usr/lib/nftban/setup"/*.sh
154: 
155:     # Build DEB package
156:     dpkg-deb --build "${deb_build_dir}"
157: 
158:     # Move to output directory
159:     mv "${deb_build_dir}.deb" "${BUILD_DIR}/${PKG_NAME}_${PKG_VERSION}_all.deb"
160: 
161:     log_success "DEB package built: ${BUILD_DIR}/${PKG_NAME}_${PKG_VERSION}_all.deb"
162: }
163: 
164: build_rpm() {
165:     log_info "Building RPM package..."
166: 
167:     local rpm_build_dir="${BUILD_DIR}/rpm"
168:     local rpmbuild_root="${rpm_build_dir}/rpmbuild"
169: 
170:     # Clean and create rpmbuild structure
171:     rm -rf "${rpmbuild_root}"
172:     mkdir -p "${rpmbuild_root}"/{BUILD,RPMS,SOURCES,SPECS,SRPMS}
173: 
174:     # Create source tarball
175:     local tarball_name="${PKG_NAME}-${PKG_VERSION}.tar.gz"
176:     local temp_dir=$(mktemp -d)
177:     local pkg_dir="${temp_dir}/${PKG_NAME}-${PKG_VERSION}"
178: 
179:     mkdir -p "${pkg_dir}"
180: 
181:     # Copy all source files
182:     cp -r "${PROJECT_ROOT}/work" "${pkg_dir}/"
183:     cp -r "${PROJECT_ROOT}/cli" "${pkg_dir}/"
184:     cp -r "${PROJECT_ROOT}/install" "${pkg_dir}/"
185:     cp -r "${PROJECT_ROOT}/docs" "${pkg_dir}/" 2>/dev/null || true
186: 
187:     # Create tarball
188:     tar czf "${rpmbuild_root}/SOURCES/${tarball_name}" \
189:         -C "${temp_dir}" "${PKG_NAME}-${PKG_VERSION}"
190: 
191:     # Clean up temp directory
192:     rm -rf "${temp_dir}"
193: 
194:     # Copy spec file
195:     cp "${SCRIPT_DIR}/rpm/nftban-metrics.spec" "${rpmbuild_root}/SPECS/"
196: 
197:     # Build RPM
198:     rpmbuild --define "_topdir ${rpmbuild_root}" \
199:         -ba "${rpmbuild_root}/SPECS/nftban-metrics.spec"
200: 
201:     # Move RPMs to output directory
202:     find "${rpmbuild_root}/RPMS" -name "*.rpm" -exec mv {} "${BUILD_DIR}/" \;
203:     find "${rpmbuild_root}/SRPMS" -name "*.rpm" -exec mv {} "${BUILD_DIR}/" \;
204: 
205:     log_success "RPM packages built in: ${BUILD_DIR}/"
206: }
207: 
208: show_usage() {
209:     cat <<EOF
210: Usage: $(basename "$0") [deb|rpm|both]
211: 
212: Build NFTBan metrics packages (DEB and/or RPM).
213: 
214: Arguments:
215:   deb     Build DEB package only
216:   rpm     Build RPM package only
217:   both    Build both DEB and RPM packages (default)
218: 
219: Examples:
220:   $(basename "$0")         # Build both packages
221:   $(basename "$0") deb     # Build DEB only
222:   $(basename "$0") rpm     # Build RPM only
223: 
224: Output:
225:   Packages will be created in: ${BUILD_DIR}/
226: 
227: EOF
228: }
229: 
230: main() {
231:     local build_type="${1:-both}"
232: 
233:     # Validate argument
234:     if [[ ! "$build_type" =~ ^(deb|rpm|both)$ ]]; then
235:         log_error "Invalid argument: $build_type"
236:         show_usage
237:         exit 1
238:     fi
239: 
240:     # Check dependencies
241:     if ! check_dependencies "$build_type"; then
242:         exit 1
243:     fi
244: 
245:     # Create build directory
246:     mkdir -p "${BUILD_DIR}"
247: 
248:     log_info "Building NFTBan Metrics v${PKG_VERSION}"
249:     log_info "Build type: ${build_type}"
250:     echo ""
251: 
252:     # Build packages
253:     if [[ "$build_type" == "deb" || "$build_type" == "both" ]]; then
254:         build_deb
255:         echo ""
256:     fi
257: 
258:     if [[ "$build_type" == "rpm" || "$build_type" == "both" ]]; then
259:         build_rpm
260:         echo ""
261:     fi
262: 
263:     # Show results
264:     log_success "Build complete!"
265:     echo ""
266:     log_info "Generated packages:"
267:     ls -lh "${BUILD_DIR}"/*.{deb,rpm} 2>/dev/null || true
268:     echo ""
269:     log_info "To install:"
270:     log_info "  DEB: sudo dpkg -i ${BUILD_DIR}/${PKG_NAME}_${PKG_VERSION}_all.deb"
271:     log_info "  RPM: sudo rpm -ivh ${BUILD_DIR}/${PKG_NAME}-${PKG_VERSION}-${PKG_RELEASE}.*.noarch.rpm"
272: }
273: 
274: main "$@"
</file>


  71: # Check and install nftables (REQUIRED)
  72: check_nftables() {
  73:     log "Checking nftables..."
  74: 
  75:     if command -v nft &>/dev/null; then
  76:         ok "nftables found: $(nft --version 2>/dev/null | head -1)"
  77:         return 0
  78:     fi
  79: 
  80:     warn "nftables not found - installing..."
  81: 
  82:     # Detect package manager and install
  83:     if command -v dnf &>/dev/null; then
  84:         dnf install -y nftables || { error "Failed to install nftables"; exit 1; }
  85:     elif command -v yum &>/dev/null; then
  86:         yum install -y nftables || { error "Failed to install nftables"; exit 1; }
  87:     elif command -v apt-get &>/dev/null; then
  88:         apt-get update && apt-get install -y nftables || { error "Failed to install nftables"; exit 1; }
  89:     elif command -v zypper &>/dev/null; then
  90:         zypper install -y nftables || { error "Failed to install nftables"; exit 1; }
  91:     else
  92:         error "Unknown package manager. Please install nftables manually."
  93:         exit 1
  94:     fi
  95: 
  96:     ok "nftables installed successfully"
  97: }

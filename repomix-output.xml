 92: // DefaultSyncOptions returns default sync options
 93: func DefaultSyncOptions() *SyncOptions {
 94: 	return &SyncOptions{
 95: 		StagingDir:    getDefaultStagingDir(),
 96: 		SnapshotDir:   getDefaultSnapshotDir(),
 97: 		WhitelistFile: getDefaultWhitelistFile(),
 98: 		BlacklistFile: getDefaultBlacklistFile(),
 99: 		FeedsDir:      getDefaultFeedsDir(),
100: 		GeobanDir:     getDefaultGeobanDir(),
101: 		TemplateFile:  getDefaultTemplateFile(),
102: 		TCPPorts:      []int{22, 80, 443, 3940},
103: 		UDPPorts:      []int{},
104: 		DryRun:        false,
105: 	}

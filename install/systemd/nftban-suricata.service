[Unit]
Description=NFTBan Suricata Integration Daemon
Documentation=man:nftban(8) https://nftban.com/docs
After=network.target nftables.service suricata.service
Requires=suricata.service
PartOf=suricata.service

[Service]
Type=simple

# SECURITY FIX: Run as unprivileged nftban user (not root)
# Reads: /var/log/nftban/suricata/eve-alerts.json (via suricata group)
# Writes: /var/lib/nftban/, /var/log/nftban/
# Firewall bans via IPC to daemon (no direct nft operations)
# See: SYSTEMD-SERVICE-CLASSIFICATION.md
User=nftban
Group=nftban
SupplementaryGroups=suricata

# Daemon command
ExecStart=/usr/lib/nftban/bin/nftban-core suricata daemon

# Restart on failure
Restart=on-failure
RestartSec=10

# =============================================================================
# SECURITY HARDENING
# =============================================================================

# Core hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

# Minimal filesystem access
ReadWritePaths=/var/lib/nftban /var/log/nftban /var/cache/nftban /run/nftban

# Network for IPC socket
RestrictAddressFamilies=AF_UNIX

# Resource limits
MemoryMax=512M
TasksMax=50
LimitNOFILE=65536
LimitNPROC=512

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nftban-suricata

[Install]
WantedBy=multi-user.target

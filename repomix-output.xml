<file path="install/config/nftban.logrotate">
 1: # NFTBan Log Rotation Configuration
 2: # Install to: /etc/logrotate.d/nftban
 3: #
 4: # Rotates:
 5: # - /var/log/nftban/*.log (weekly, 4 weeks)
 6: # - /var/lib/nftban/reports/* (monthly, 3 months)
 7: # - Suricata logs (handled separately)
 8: #
 9: # Policy: Compress old files, keep reasonable history
10: 
11: /var/log/nftban/*.log {
12:     weekly
13:     rotate 4
14:     compress
15:     delaycompress
16:     missingok
17:     notifempty
18:     create 0640 nftban nftban
19:     sharedscripts
20:     postrotate
21:         # Reload any services that need to reopen log files
22:         systemctl reload nftban-login-monitor >/dev/null 2>&1 || true
23:     endscript
24: }
25: 
26: # Suricata eve.json - rotated more frequently due to size
27: /var/log/nftban/suricata/eve.json {
28:     daily
29:     rotate 7
30:     compress
31:     delaycompress
32:     missingok
33:     notifempty
34:     create 0640 suricata nftban
35:     copytruncate
36:     size 100M
37:     postrotate
38:         # Signal Suricata to reopen log file
39:         systemctl kill -s USR2 suricata.service >/dev/null 2>&1 || true
40:     endscript
41: }
42: 
43: # Fast.log for Suricata
44: /var/log/nftban/suricata/fast.log {
45:     weekly
46:     rotate 4
47:     compress
48:     delaycompress
49:     missingok
50:     notifempty
51:     create 0640 suricata nftban
52:     copytruncate
53: }
54: 
55: # Stats.log for Suricata
56: /var/log/nftban/suricata/stats.log {
57:     weekly
58:     rotate 4
59:     compress
60:     delaycompress
61:     missingok
62:     notifempty
63:     create 0640 suricata nftban
64:     copytruncate
65: }
66: 
67: # Generated reports - monthly rotation, keep 3 months
68: /var/lib/nftban/reports/*.html /var/lib/nftban/reports/*.txt /var/lib/nftban/reports/*.json {
69:     monthly
70:     rotate 3
71:     compress
72:     delaycompress
73:     missingok
74:     notifempty
75:     olddir /var/lib/nftban/reports/archive
76:     createolddir 0750 nftban nftban
77: }
78: 
79: # Daily reports subdirectory
80: /var/lib/nftban/reports/daily/*.html /var/lib/nftban/reports/daily/*.txt {
81:     monthly
82:     rotate 3
83:     compress
84:     delaycompress
85:     missingok
86:     notifempty
87: }
</file>

<file path="install/config/ui-access.list">
 1: # NFTBan Web GUI - IP Access Control
 2: # ===================================
 3: # This file controls which IPs can access the nftban-ui web interface.
 4: # One entry per line (supports IP and CIDR notation)
 5: # Comments start with #
 6: #
 7: # This is SEPARATE from the firewall whitelist (/etc/nftban/whitelist.d/)
 8: # The firewall whitelist controls which IPs bypass firewall rules.
 9: # This file controls which IPs can access the admin web interface.
10: 
11: # Localhost (always allowed for health checks)
12: 127.0.0.1
13: ::1
14: 
15: # Server's own IPs (auto-populated during install)
16: # {{SERVER_IPS}}
17: 
18: # Admin networks (add your management IPs/ranges here)
19: # Example:
20: # 10.0.0.0/8          # Internal network
21: # 192.168.1.100       # Admin workstation
22: # 203.0.113.0/24      # Office network
23: 
24: # WARNING: Uncomment below ONLY for testing (allows ALL access)
25: # 0.0.0.0/0
26: # ::/0
</file>


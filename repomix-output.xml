 15: func cmdInit(cfg *nftbanconf.Config) error {
 16: 	fmt.Println(version.BannerWithEmoji("🛡️", "Safety-First Initialization"))
 17: 	fmt.Println(strings.Repeat("=", 70))
 18: 	fmt.Println()
 19: 
 20: 	// Check for privilege (root OR CAP_NET_ADMIN capability)
 21: 	if err := checkPrivilege(); err != nil {
 22: 		return err
 23: 	}
 24: 
 25: 	// Step 1: Detect all system IPs
 26: 	fmt.Println("Step 1: Detecting system IPs...")
 27: 	sysIPs, err := safety.DetectSystemIPs()
 28: 	if err != nil {
 29: 		return fmt.Errorf("failed to detect system IPs: %w", err)
 30: 	}
 31: 
 32: 	// Step 2: Display detected IPs
 33: 	sysIPs.PrintSystemIPs()
 34: 
 35: 	// Step 3: Confirm with user if SSH IP not detected
 36: 	if sysIPs.CurrentUserIP == nil {
 37: 		fmt.Println("⚠️  WARNING: Could not detect your current SSH IP!")
 38: 		fmt.Println("⚠️  Please manually add your IP to whitelist before proceeding:")
 39: 		fmt.Printf("   echo \"YOUR_IP_HERE\" >> /etc/nftban/whitelist.conf\n")
 40: 		fmt.Println()
 41: 		fmt.Print("Continue anyway? [y/N]: ")
 42: 
 43: 		reader := bufio.NewReader(os.Stdin)
 44: 		response, _ := reader.ReadString('\n')
 45: 		response = strings.TrimSpace(strings.ToLower(response))
 46: 
 47: 		if response != "y" && response != "yes" {
 48: 			return fmt.Errorf("initialization cancelled by user")
 49: 		}
 50: 	}
 51: 
 52: 	// Step 4: Load configurations
 53: 	fmt.Println("Step 2: Loading configurations...")
 54: 
 55: 	// Load FHS spec
 56: 	fhsSpec, err := config.LoadFHSSpec()
 57: 	if err != nil {

<file path="cli/lib/nftban/core/nftban_portscan.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0 - Port Scan Detection Module (Dual-Mode Controller)
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Master controller for portscan detection with dual-mode support
  7: #
  8: # meta:name=nftban_portscan
  9: # meta:type=core
 10: # meta:header=Port Scan Detection
 11: # meta:version=1.0.0
 12: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 13: # meta:homepage=https://nftban.com
 14: #
 15: # **Description & Purpose**
 16: # meta:description=Detects IP addresses accessing multiple ports and auto-bans scanners
 17: # meta:input=Configuration from /etc/nftban/conf.d/portscan/
 18: # meta:output=nftables logging rules and ban actions
 19: #
 20: # **Dual-Mode Architecture**
 21: # - Classic Mode: Pure nftables log-based detection (no IDS required)
 22: # - Suricata Mode: Uses Suricata IDS EVE JSON alerts for intelligent detection
 23: # - Auto Mode: Automatically selects mode based on Suricata availability
 24: # - Hybrid Mode: Classic for logging + Suricata for intelligent detection
 25: #
 26: # **Inventory & Requirements**
 27: # meta:depends=bash>=4.0,nftables>=0.9.0,nftban_output.sh
 28: # meta:optional=suricata,jq
 29: #
 30: # meta:created_date=2025-11-05
 31: # meta:updated_date=2025-12-01
 32: # meta:migrated_from=v0.7.3:cli/lib/nftban/core/nftban_portscan.sh
 33: # =============================================================================
 34: 
 35: IFS=$'\n\t'
 36: umask 027
 37: 
 38: # =============================================================================
 39: # MODULE GUARD
 40: # =============================================================================
 41: 
 42: [[ -n "${NFTBAN_PORTSCAN_LOADED:-}" ]] && return 0
 43: readonly NFTBAN_PORTSCAN_LOADED=1
 44: 
 45: # =============================================================================
 46: # MODULE METADATA
 47: # =============================================================================
 48: 
 49: # shellcheck disable=SC2034  # Module metadata used when sourced
 50: readonly PORTSCAN_MODULE_NAME="nftban_portscan"
 51: # Module metadata - reserved for future module registry
 52: readonly PORTSCAN_MODULE_VERSION="1.0.0"
 53: # shellcheck disable=SC2034
 54: readonly PORTSCAN_MODULE_TYPE="core"
 55: readonly PORTSCAN_MODULE_DESCRIPTION="Port Scan Detection Module (Dual-Mode)"
 56: 
 57: # =============================================================================
 58: # FHS COMPLIANT PATHS
 59: # =============================================================================
 60: 
 61: # Source central config for canonical paths (NO HARDCODED FALLBACKS)
 62: # shellcheck source=/etc/nftban/nftban.conf
 63: [[ -f "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf" ]] && source "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf"
 64: 
 65: readonly NFTBAN_PORTSCAN_CONFIG_DIR="${NFTBAN_CONFIG_DIR}/conf.d/portscan"
 66: readonly NFTBAN_PORTSCAN_DATA_DIR="${PORTSCAN_DATA_DIR:-${NFTBAN_DATA_DIR}/portscan}"
 67: readonly NFTBAN_PORTSCAN_CACHE_DIR="${PORTSCAN_CACHE_DIR:-${NFTBAN_CACHE_DIR}/portscan}"
 68: readonly NFTBAN_PORTSCAN_LOG_FILE="${PORTSCAN_LOG_FILE:-${NFTBAN_LOG_DIR}/portscan.log}"
 69: 
 70: # =============================================================================
 71: # NFTABLES CONFIGURATION
 72: # =============================================================================
 73: 
 74: readonly NFTBAN_NFT_TABLE_IPV4="${NFTBAN_NFT_TABLE_IPV4:-ip nftban}"
 75: readonly NFTBAN_NFT_TABLE_IPV6="${NFTBAN_NFT_TABLE_IPV6:-ip6 nftban}"
 76: readonly NFTBAN_NFT_PORTSCAN_CHAIN="${PORTSCAN_NFT_CHAIN:-portscan_detection}"
 77: 
 78: # =============================================================================
 79: # RUNTIME STATE
 80: # =============================================================================
 81: 
 82: declare -g _PORTSCAN_ACTIVE_MODE=""      # Currently active mode
 83: declare -g _PORTSCAN_INITIALIZED=0       # Initialization flag
 84: 
 85: # =============================================================================
 86: # BANNER FUNCTION
 87: # =============================================================================
 88: 
 89: nftban_portscan_banner() {
 90:     cat <<'BANNER'
 91: ╔══════════════════════════════════════════════════════════╗
 92: ║  🔍 Port Scan Detection (v1.0 Dual-Mode)                ║
 93: ║  nftban — Simplifying Linux Firewall Management         ║
 94: ╚══════════════════════════════════════════════════════════╝
 95: BANNER
 96: }
 97: 
 98: # =============================================================================
 99: # CONFIGURATION LOADING
100: # =============================================================================
101: 
102: # Load main portscan configuration
103: nftban_portscan_load_config() {
104:     local config_dir="${NFTBAN_PORTSCAN_CONFIG_DIR}"
105: 
106:     # Load main config
107:     local main_config="${config_dir}/main.conf"
108:     local main_local="${config_dir}/main.conf.local"
109: 
110:     if [[ -f "$main_config" ]]; then
111:         # shellcheck source=/dev/null
112:         source "$main_config"
113:     fi
114: 
115:     if [[ -f "$main_local" ]]; then
116:         # shellcheck source=/dev/null
117:         source "$main_local"
118:     fi
119: 
120:     # Set defaults
121:     : "${PORTSCAN_ENABLED:=true}"
122:     : "${PORTSCAN_MODE:=auto}"
123:     : "${PORTSCAN_AUTO_CHECK_SERVICE:=true}"
124:     : "${PORTSCAN_AUTO_CHECK_BINARY:=true}"
125:     : "${PORTSCAN_AUTO_CHECK_EVE_FILE:=true}"
126:     : "${PORTSCAN_SURICATA_SERVICE_NAME:=suricata}"
127:     : "${PORTSCAN_SURICATA_BINARY:=/usr/bin/suricata}"
128:     : "${PORTSCAN_EVE_FRESHNESS_THRESHOLD:=60}"
129: 
130:     return 0
131: }
132: 
133: # =============================================================================
134: # MODE DETECTION
135: # =============================================================================
136: 
137: # Check if Suricata binary exists
138: _nftban_portscan_suricata_binary_exists() {
139:     local binary="${PORTSCAN_SURICATA_BINARY:-/usr/bin/suricata}"
140:     [[ -x "$binary" ]]
141: }
142: 
143: # Check if Suricata service is running
144: _nftban_portscan_suricata_service_running() {
145:     local service_name="${PORTSCAN_SURICATA_SERVICE_NAME:-suricata}"
146: 
147:     # Try systemctl first
148:     if command -v systemctl &>/dev/null; then
149:         if systemctl is-active --quiet "$service_name" 2>/dev/null; then
150:             return 0
151:         fi
152:     fi
153: 
154:     # Fall back to pgrep
155:     if pgrep -x suricata &>/dev/null; then
156:         return 0
157:     fi
158: 
159:     return 1
160: }
161: 
162: # Check if EVE JSON file is being actively written
163: _nftban_portscan_suricata_eve_active() {
164:     local eve_file="${PORTSCAN_SURICATA_EVE_FILE:-/var/log/suricata/eve.json}"
165:     local freshness="${PORTSCAN_EVE_FRESHNESS_THRESHOLD:-60}"
166: 
167:     [[ -f "$eve_file" ]] || return 1
168: 
169:     local file_mtime
170:     file_mtime=$(stat -c %Y "$eve_file" 2>/dev/null) || return 1
171: 
172:     local current_time
173:     current_time=$(date +%s)
174: 
175:     local age
176:     age=$((current_time - file_mtime))
177:     [[ $age -le $freshness ]]
178: }
179: 
180: # Combined Suricata availability check
181: _nftban_portscan_suricata_is_available() {
182:     local check_binary="${PORTSCAN_AUTO_CHECK_BINARY:-true}"
183:     local check_service="${PORTSCAN_AUTO_CHECK_SERVICE:-true}"
184:     local check_eve="${PORTSCAN_AUTO_CHECK_EVE_FILE:-true}"
185: 
186:     # Check binary
187:     if [[ "$check_binary" == "true" ]]; then
188:         if ! _nftban_portscan_suricata_binary_exists; then
189:             return 1
190:         fi
191:     fi
192: 
193:     # Check service
194:     if [[ "$check_service" == "true" ]]; then
195:         if ! _nftban_portscan_suricata_service_running; then
196:             return 1
197:         fi
198:     fi
199: 
200:     # Check EVE file
201:     if [[ "$check_eve" == "true" ]]; then
202:         if ! _nftban_portscan_suricata_eve_active; then
203:             return 1
204:         fi
205:     fi
206: 
207:     return 0
208: }
209: 
210: # Detect which mode to use
211: _nftban_portscan_detect_mode() {
212:     local configured_mode="${PORTSCAN_MODE:-auto}"
213: 
214:     # If not auto, use configured mode
215:     if [[ "$configured_mode" != "auto" ]]; then
216:         echo "$configured_mode"
217:         return 0
218:     fi
219: 
220:     # Auto-detect: check if Suricata is available
221:     if _nftban_portscan_suricata_is_available; then
222:         echo "suricata"
223:         return 0
224:     fi
225: 
226:     # Fall back to classic
227:     echo "classic"
228: }
229: 
230: # =============================================================================
231: # MODULE LOADING
232: # =============================================================================
233: 
234: # Source the appropriate mode modules
235: _nftban_portscan_load_modules() {
236:     local lib_dir="${NFTBAN_LIB_DIR:-/usr/lib/nftban}"
237:     local core_dir="${lib_dir}/core"
238: 
239:     # Also check for dev paths
240:     local dev_core_dir
241:     if [[ -d "${BASH_SOURCE[0]%/*}" ]]; then
242:         dev_core_dir="${BASH_SOURCE[0]%/*}"
243:     fi
244: 
245:     # Load classic module
246:     local classic_module=""
247:     for path in "${core_dir}/nftban_portscan_classic.sh" "${dev_core_dir}/nftban_portscan_classic.sh"; do
248:         if [[ -f "$path" ]]; then
249:             classic_module="$path"
250:             break
251:         fi
252:     done
253: 
254:     if [[ -n "$classic_module" ]]; then
255:         # shellcheck source=/dev/null
256:         source "$classic_module"
257:     fi
258: 
259:     # Load suricata module
260:     local suricata_module=""
261:     for path in "${core_dir}/nftban_portscan_suricata.sh" "${dev_core_dir}/nftban_portscan_suricata.sh"; do
262:         if [[ -f "$path" ]]; then
263:             suricata_module="$path"
264:             break
265:         fi
266:     done
267: 
268:     if [[ -n "$suricata_module" ]]; then
269:         # shellcheck source=/dev/null
270:         source "$suricata_module"
271:     fi
272: 
273:     return 0
274: }
275: 
276: # =============================================================================
277: # INITIALIZATION
278: # =============================================================================
279: 
280: # Initialize directory structure
281: nftban_portscan_init_dirs() {
282:     local dirs=(
283:         "$NFTBAN_PORTSCAN_DATA_DIR"
284:         "$NFTBAN_PORTSCAN_CACHE_DIR"
285:         "$(dirname "$NFTBAN_PORTSCAN_LOG_FILE")"
286:     )
287: 
288:     for dir in "${dirs[@]}"; do
289:         if [[ ! -d "$dir" ]]; then
290:             mkdir -p "$dir" 2>/dev/null || true
291:             chmod 750 "$dir" 2>/dev/null || true
292:         fi
293:     done
294: 
295:     # Create log file if it doesn't exist
296:     if [[ ! -f "$NFTBAN_PORTSCAN_LOG_FILE" ]]; then
297:         touch "$NFTBAN_PORTSCAN_LOG_FILE" 2>/dev/null || true
298:         chmod 640 "$NFTBAN_PORTSCAN_LOG_FILE" 2>/dev/null || true
299:         chown nftban:nftban "$NFTBAN_PORTSCAN_LOG_FILE" 2>/dev/null || true
300:     fi
301: 
302:     return 0
303: }
304: 
305: # Initialize portscan detection
306: nftban_portscan_init() {
307:     [[ $_PORTSCAN_INITIALIZED -eq 1 ]] && return 0
308: 
309:     nftban_log "INFO" "portscan" "Initializing portscan detection module"
310: 
311:     # Load configuration
312:     nftban_portscan_load_config
313: 
314:     # Check if enabled
315:     if [[ "${PORTSCAN_ENABLED:-true}" != "true" ]]; then
316:         nftban_log "INFO" "portscan" "Portscan detection is disabled"
317:         return 0
318:     fi
319: 
320:     # Initialize directories
321:     nftban_portscan_init_dirs
322: 
323:     # Load mode modules
324:     _nftban_portscan_load_modules
325: 
326:     # Detect mode
327:     _PORTSCAN_ACTIVE_MODE=$(_nftban_portscan_detect_mode)
328: 
329:     nftban_log "INFO" "portscan" "Portscan mode: ${_PORTSCAN_ACTIVE_MODE}"
330: 
331:     _PORTSCAN_INITIALIZED=1
332:     return 0
333: }
334: 
335: # =============================================================================
336: # ENABLE/DISABLE
337: # =============================================================================
338: 
339: # Enable portscan detection
340: nftban_portscan_enable() {
341:     nftban_portscan_init
342: 
343:     if [[ "${PORTSCAN_ENABLED:-true}" != "true" ]]; then
344:         nftban_log "WARN" "portscan" "Portscan is disabled in configuration"
345:         return 1
346:     fi
347: 
348:     local mode="${_PORTSCAN_ACTIVE_MODE}"
349: 
350:     nftban_log "INFO" "portscan" "Enabling portscan detection (mode: ${mode})"
351: 
352:     case "$mode" in
353:         classic)
354:             if type -t nftban_portscan_classic_enable &>/dev/null; then
355:                 nftban_portscan_classic_enable
356:             else
357:                 nftban_log "ERROR" "portscan" "Classic mode module not loaded"
358:                 return 1
359:             fi
360:             ;;
361:         suricata)
362:             if type -t nftban_portscan_suricata_enable &>/dev/null; then
363:                 nftban_portscan_suricata_enable
364:             else
365:                 nftban_log "ERROR" "portscan" "Suricata mode module not loaded"
366:                 return 1
367:             fi
368:             ;;
369:         hybrid)
370:             # Enable both modes
371:             if type -t nftban_portscan_classic_enable &>/dev/null; then
372:                 nftban_portscan_classic_enable
373:             fi
374:             if type -t nftban_portscan_suricata_enable &>/dev/null; then
375:                 nftban_portscan_suricata_enable
376:             fi
377:             ;;
378:         *)
379:             nftban_log "ERROR" "portscan" "Unknown mode: ${mode}"
380:             return 1
381:             ;;
382:     esac
383: 
384:     nftban_log "INFO" "portscan" "Portscan detection enabled successfully"
385:     return 0
386: }
387: 
388: # Disable portscan detection
389: nftban_portscan_disable() {
390:     local mode="${_PORTSCAN_ACTIVE_MODE}"
391: 
392:     nftban_log "INFO" "portscan" "Disabling portscan detection"
393: 
394:     case "$mode" in
395:         classic)
396:             if type -t nftban_portscan_classic_disable &>/dev/null; then
397:                 nftban_portscan_classic_disable
398:             fi
399:             ;;
400:         suricata)
401:             if type -t nftban_portscan_suricata_disable &>/dev/null; then
402:                 nftban_portscan_suricata_disable
403:             fi
404:             ;;
405:         hybrid)
406:             if type -t nftban_portscan_classic_disable &>/dev/null; then
407:                 nftban_portscan_classic_disable
408:             fi
409:             if type -t nftban_portscan_suricata_disable &>/dev/null; then
410:                 nftban_portscan_suricata_disable
411:             fi
412:             ;;
413:     esac
414: 
415:     _PORTSCAN_INITIALIZED=0
416:     nftban_log "INFO" "portscan" "Portscan detection disabled"
417:     return 0
418: }
419: 
420: # =============================================================================
421: # STATUS
422: # =============================================================================
423: 
424: # Get portscan detection status
425: nftban_portscan_status() {
426:     # Show unified banner
427:     if type -t nftban_banner >/dev/null 2>&1; then
428:         nftban_banner "portscan"
429:         echo ""
430:     fi
431:     echo "╔══════════════════════════════════════════════════════════╗"
432:     echo "║  NFTBan Portscan Detection Status                       ║"
433:     echo "╚══════════════════════════════════════════════════════════╝"
434:     echo ""
435: 
436:     # ==========================================================================
437:     # MAIN STATUS - Is it enabled and protecting?
438:     # ==========================================================================
439:     local is_enabled="${PORTSCAN_ENABLED:-true}"
440:     local auto_ban="${PORTSCAN_AUTO_BAN:-true}"
441: 
442:     if [[ "$is_enabled" == "true" ]]; then
443:         echo "  Status:      ✅ ENABLED - Port scan detection is active"
444:     else
445:         echo "  Status:      ❌ DISABLED - Port scan detection is OFF"
446:         echo ""
447:         echo "  To enable:   nftban portscan enable"
448:         echo ""
449:         return 0
450:     fi
451: 
452:     if [[ "$auto_ban" == "true" ]]; then
453:         echo "  Auto-Ban:    ✅ ON - Detected scanners will be automatically banned"
454:     else
455:         echo "  Auto-Ban:    ⚠️  OFF - Monitoring only, no automatic bans"
456:     fi
457:     echo ""
458: 
459:     # ==========================================================================
460:     # DETECTION METHOD
461:     # ==========================================================================
462:     echo "DETECTION METHOD"
463:     echo "───────────────────────────────────────────────────────────"
464: 
465:     local configured_mode="${PORTSCAN_MODE:-auto}"
466:     local detected_mode
467:     detected_mode=$(_nftban_portscan_detect_mode)
468:     local active_mode="${_PORTSCAN_ACTIVE_MODE:-$detected_mode}"
469: 
470:     case "$active_mode" in
471:         suricata)
472:             echo "  Using:       Suricata IDS (recommended, high accuracy)"
473:             echo "  Mode:        Suricata is analyzing network traffic in real-time"
474:             ;;
475:         classic)
476:             echo "  Using:       Classic nftables log parsing"
477:             echo "  Mode:        Monitoring closed port connection attempts"
478:             ;;
479:         hybrid)
480:             echo "  Using:       Hybrid (Suricata + nftables logs)"
481:             echo "  Mode:        Dual detection for maximum coverage"
482:             ;;
483:         *)
484:             echo "  Using:       Unknown (needs initialization)"
485:             ;;
486:     esac
487:     echo ""
488: 
489:     # ==========================================================================
490:     # SURICATA STATUS (if relevant)
491:     # ==========================================================================
492:     local suricata_available=false
493:     if _nftban_portscan_suricata_is_available; then
494:         suricata_available=true
495:     fi
496: 
497:     echo "SURICATA IDS"
498:     echo "───────────────────────────────────────────────────────────"
499:     if [[ "$suricata_available" == "true" ]]; then
500:         echo "  Available:   ✅ YES - Suricata is installed and running"
501:         echo "  Service:     $(systemctl is-active suricata 2>/dev/null || echo 'unknown')"
502:         local eve_file="${SURICATA_EVE_LOG:-/var/log/suricata/eve.json}"
503:         if [[ -f "$eve_file" ]]; then
504:             local eve_age
505:             eve_age=$(( $(date +%s) - $(stat -c %Y "$eve_file" 2>/dev/null || echo 0) ))
506:             if [[ $eve_age -lt 300 ]]; then
507:                 echo "  EVE Log:     ✅ Active (updated ${eve_age}s ago)"
508:             else
509:                 echo "  EVE Log:     ⚠️  Stale (last update ${eve_age}s ago)"
510:             fi
511:         else
512:             echo "  EVE Log:     ❌ Not found at $eve_file"
513:         fi
514:     else
515:         echo "  Available:   ❌ NO - Suricata not available"
516:         if ! command -v suricata &>/dev/null; then
517:             echo "  Reason:      Binary not installed"
518:             echo "  Install:     nftban setup suricata"
519:         elif ! systemctl is-active suricata &>/dev/null; then
520:             echo "  Reason:      Service not running"
521:             echo "  Start:       systemctl start suricata"
522:         fi
523:     fi
524:     echo ""
525: 
526:     # ==========================================================================
527:     # DETECTION SETTINGS
528:     # ==========================================================================
529:     echo "DETECTION SETTINGS"
530:     echo "───────────────────────────────────────────────────────────"
531:     echo "  Threshold:   ${PORTSCAN_THRESHOLD:-10} unique ports triggers detection"
532:     echo "  Time Window: ${PORTSCAN_TIME_WINDOW:-300} seconds ($(( ${PORTSCAN_TIME_WINDOW:-300} / 60 )) minutes)"
533:     echo "  Ban Type:    ${PORTSCAN_BAN_TYPE:-temporary}"
534:     if [[ "${PORTSCAN_BAN_TYPE:-temporary}" == "temporary" ]]; then
535:         echo "  Ban Duration: ${PORTSCAN_BAN_TIME:-3600} seconds ($(( ${PORTSCAN_BAN_TIME:-3600} / 60 )) minutes)"
536:     fi
537:     echo ""
538: 
539:     # ==========================================================================
540:     # RECENT ACTIVITY
541:     # ==========================================================================
542:     echo "RECENT ACTIVITY (last 24h)"
543:     echo "───────────────────────────────────────────────────────────"
544:     local ban_log="${NFTBAN_BAN_LOG:-/var/log/nftban/bans.log}"
545:     if [[ -f "$ban_log" ]]; then
546:         local yesterday today scan_bans
547:         yesterday=$(date -d '24 hours ago' '+%Y-%m-%d' 2>/dev/null || date '+%Y-%m-%d')
548:         today=$(date '+%Y-%m-%d')
549:         # Count portscan bans from last 24 hours
550:         scan_bans=$(grep "|portscan|" "$ban_log" 2>/dev/null | grep -cE "^($yesterday|$today)" || true)
551:         [[ -z "$scan_bans" ]] && scan_bans=0
552:         echo "  Port scans detected: $scan_bans"
553:     else
554:         echo "  No activity log found"
555:     fi
556:     echo ""
557: 
558:     # ==========================================================================
559:     # DETECTION MODES EXPLAINED
560:     # ==========================================================================
561:     echo "DETECTION MODES"
562:     echo "───────────────────────────────────────────────────────────"
563:     echo ""
564:     echo "  classic   - Uses nftables logging of closed port attempts"
565:     echo "              Parses kernel/journalctl logs for scan patterns"
566:     echo ""
567:     echo "  suricata  - Uses Suricata IDS with portscan rules"
568:     echo "              Better accuracy, lower false positives"
569:     echo ""
570:     echo "  hybrid    - Combines both classic and Suricata detection"
571:     echo "              Maximum coverage with redundant detection"
572:     echo ""
573:     echo "  auto      - Auto-selects based on Suricata availability"
574:     echo "              Uses suricata if available, otherwise classic"
575:     echo ""
576: 
577:     # ==========================================================================
578:     # CONFIGURATION
579:     # ==========================================================================
580:     echo "CONFIGURATION"
581:     echo "───────────────────────────────────────────────────────────"
582:     echo ""
583:     echo "  Config File:  /etc/nftban/conf.d/portscan/main.conf"
584:     echo "  Log File:     ${NFTBAN_PORTSCAN_LOG_FILE}"
585:     echo ""
586:     echo "  Key Settings:"
587:     echo "    PORTSCAN_ENABLED=true|false"
588:     echo "    PORTSCAN_MODE=auto|classic|suricata|hybrid"
589:     echo "    PORTSCAN_AUTO_BAN=true|false   - Auto-ban detected scanners"
590:     echo "    PORTSCAN_THRESHOLD=10          - Ports to trigger detection"
591:     echo "    PORTSCAN_TIME_WINDOW=300       - Detection window (seconds)"
592:     echo "    PORTSCAN_BAN_TIME=3600         - Ban duration (seconds)"
593:     echo ""
594: 
595:     # ==========================================================================
596:     # COMMANDS
597:     # ==========================================================================
598:     echo "COMMANDS"
599:     echo "───────────────────────────────────────────────────────────"
600:     echo ""
601:     echo "  nftban portscan enable         - Enable port scan detection"
602:     echo "  nftban portscan disable        - Disable port scan detection"
603:     echo "  nftban portscan history        - View detected port scans"
604:     echo "  nftban portscan check          - Run manual detection now"
605:     echo "  nftban portscan sync           - Sync logs from journalctl"
606:     echo "  nftban portscan help           - Show all available commands"
607:     echo ""
608: 
609:     return 0
610: }
611: 
612: # =============================================================================
613: # RUN (PERIODIC PROCESSING)
614: # =============================================================================
615: 
616: # Run portscan detection cycle
617: nftban_portscan_run() {
618:     if [[ "${PORTSCAN_ENABLED:-true}" != "true" ]]; then
619:         return 0
620:     fi
621: 
622:     # Initialize if needed
623:     if [[ $_PORTSCAN_INITIALIZED -eq 0 ]]; then
624:         nftban_portscan_init
625:     fi
626: 
627:     local mode="${_PORTSCAN_ACTIVE_MODE}"
628: 
629:     case "$mode" in
630:         classic)
631:             if type -t nftban_portscan_classic_run &>/dev/null; then
632:                 nftban_portscan_classic_run
633:             fi
634:             ;;
635:         suricata)
636:             if type -t nftban_portscan_suricata_run &>/dev/null; then
637:                 nftban_portscan_suricata_run
638:             fi
639:             ;;
640:         hybrid)
641:             if type -t nftban_portscan_classic_run &>/dev/null; then
642:                 nftban_portscan_classic_run
643:             fi
644:             if type -t nftban_portscan_suricata_run &>/dev/null; then
645:                 nftban_portscan_suricata_run
646:             fi
647:             ;;
648:     esac
649: 
650:     return 0
651: }
652: 
653: # =============================================================================
654: # CLI INTERFACE
655: # =============================================================================
656: 
657: # Main CLI handler
658: nftban_portscan_cli() {
659:     local cmd="${1:-status}"
660:     shift || true
661: 
662:     case "$cmd" in
663:         enable)
664:             nftban_portscan_enable
665:             ;;
666:         disable)
667:             nftban_portscan_disable
668:             ;;
669:         status)
670:             nftban_portscan_status
671:             ;;
672:         run|process)
673:             nftban_portscan_run
674:             ;;
675:         mode)
676:             echo "Configured: ${PORTSCAN_MODE:-auto}"
677:             echo "Active: ${_PORTSCAN_ACTIVE_MODE:-$(_nftban_portscan_detect_mode)}"
678:             ;;
679:         help|--help|-h)
680:             echo "Usage: nftban portscan <command>"
681:             echo ""
682:             echo "Commands:"
683:             echo "  enable    Enable portscan detection"
684:             echo "  disable   Disable portscan detection"
685:             echo "  status    Show portscan detection status"
686:             echo "  run       Run detection cycle"
687:             echo "  mode      Show current mode"
688:             echo ""
689:             echo "Configuration: ${NFTBAN_PORTSCAN_CONFIG_DIR}/"
690:             ;;
691:         *)
692:             echo "Unknown command: $cmd"
693:             echo "Run 'nftban portscan help' for usage"
694:             return 1
695:             ;;
696:     esac
697: 
698:     return 0
699: }
700: 
701: # =============================================================================
702: # LOGGING HELPER
703: # =============================================================================
704: 
705: # Log function (use nftban_log if available, otherwise echo)
706: if ! type -t nftban_log &>/dev/null; then
707:     nftban_log() {
708:         local level="$1"
709:         local module="$2"
710:         local message="$3"
711:         echo "[$(date -Iseconds)] [${level}] [${module}] ${message}" >&2
712:     }
713: fi
714: 
715: # =============================================================================
716: # AUTO-INITIALIZATION
717: # =============================================================================
718: 
719: # Initialize on source if not in library mode
720: if [[ "${NFTBAN_LIBRARY_MODE:-0}" != "1" ]]; then
721:     nftban_portscan_load_config
722: fi
723: 
724: # =============================================================================
725: # END OF PORTSCAN MODULE
726: # =============================================================================
</file>

<file path="cli/lib/nftban/core/nftban_rbl.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - RBL Core Module
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Real-time Blackhole List (RBL) checking core logic
  7: #
  8: # meta:name=nftban_rbl
  9: # meta:type=core
 10: # meta:header=RBL Core Logic
 11: # meta:version=1.0.0
 12: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 13: # meta:homepage=https://nftban.com
 14: #
 15: # **Description**
 16: # meta:description=RBL checking against 20+ DNS blackhole lists
 17: # meta:input=IP addresses, RBL configuration
 18: # meta:output=Blacklist status, cached results, alerts
 19: #
 20: # **Based on CSF RBL Implementation**
 21: # Source: ConfigServer Security & Firewall
 22: # Method: DNS reverse lookup with caching
 23: #
 24: # meta:created_date=2025-12-31
 25: # meta:updated_date=2025-12-31
 26: # =============================================================================
 27: 
 28: # Strict mode
 29: set -euo pipefail
 30: IFS=$'\n\t'
 31: umask 027
 32: 
 33: # Prevent double-loading
 34: [[ -n "${NFTBAN_RBL_CORE_LOADED:-}" ]] && return 0
 35: readonly NFTBAN_RBL_CORE_LOADED=1
 36: 
 37: # Load configuration
 38: [[ -z "${NFTBAN_CONFIG_DIR:-}" ]] && readonly NFTBAN_CONFIG_DIR="/etc/nftban"
 39: [[ -z "${NFTBAN_LOG_DIR:-}" ]] && readonly NFTBAN_LOG_DIR="/var/log/nftban"
 40: 
 41: # Load RBL configuration
 42: if [[ -f "${NFTBAN_CONFIG_DIR}/conf.d/rbl/main.conf" ]]; then
 43:     # shellcheck source=/dev/null
 44:     source "${NFTBAN_CONFIG_DIR}/conf.d/rbl/main.conf"
 45: fi
 46: 
 47: # Set defaults if not configured
 48: : "${NFTBAN_RBL_ENABLED:=NO}"
 49: : "${NFTBAN_RBL_TIMEOUT:=4}"
 50: : "${NFTBAN_RBL_CACHE_TTL:=24}"
 51: : "${NFTBAN_RBL_AUTO_DISCOVER_IPS:=YES}"
 52: : "${NFTBAN_RBL_CHECK_IPV6:=YES}"
 53: : "${NFTBAN_RBL_CACHE_DIR:=${NFTBAN_LOG_DIR}/rbl}"
 54: : "${NFTBAN_RBL_PROVIDERS_FILE:=${NFTBAN_CONFIG_DIR}/conf.d/rbl/rbls.conf}"
 55: : "${NFTBAN_RBL_CUSTOM_FILE:=${NFTBAN_CONFIG_DIR}/conf.d/rbl/custom.conf}"
 56: : "${NFTBAN_RBL_ALERT_ON_NEW_LISTING:=YES}"
 57: 
 58: # =============================================================================
 59: # IP DISCOVERY FUNCTIONS
 60: # =============================================================================
 61: 
 62: nftban_rbl_get_public_ips() {
 63:     # Auto-discover public IPs from network interfaces
 64:     # Output: One IP per line
 65: 
 66:     local ips=()
 67: 
 68:     # Get all IPv4 addresses from interfaces (excluding loopback)
 69:     while IFS= read -r ip; do
 70:         if nftban_rbl_is_public_ip "$ip"; then
 71:             ips+=("$ip")
 72:         fi
 73:     done < <(ip -4 addr show | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | grep -v '^127\.')
 74: 
 75:     # Get all IPv6 addresses if enabled (excluding link-local and loopback)
 76:     if [[ "${NFTBAN_RBL_CHECK_IPV6:-YES}" == "YES" ]]; then
 77:         while IFS= read -r ip; do
 78:             if nftban_rbl_is_public_ip "$ip"; then
 79:                 ips+=("$ip")
 80:             fi
 81:         done < <(ip -6 addr show | grep -oP '(?<=inet6\s)[0-9a-f:]+' | grep -v '^::1' | grep -v '^fe80:')
 82:     fi
 83: 
 84:     # Remove duplicates and output
 85:     printf '%s\n' "${ips[@]}" | sort -u
 86: }
 87: 
 88: nftban_rbl_get_critical_ips() {
 89:     # Get critical IPs from configuration
 90:     # Format: NFTBAN_RBL_CRITICAL_IPS="1.2.3.4:mail,5.6.7.8:web"
 91:     # Output: IP:tag (one per line)
 92: 
 93:     if [[ -z "${NFTBAN_RBL_CRITICAL_IPS:-}" ]]; then
 94:         return 0
 95:     fi
 96: 
 97:     # Split by comma and output
 98:     echo "$NFTBAN_RBL_CRITICAL_IPS" | tr ',' '\n' | grep -v '^$'
 99: }
100: 
101: nftban_rbl_is_public_ip() {
102:     # Check if IP is public (not private/loopback)
103:     # Args: $1 = IP address (IPv4 or IPv6)
104:     # Return: 0 if public, 1 if private
105: 
106:     local ip="$1"
107: 
108:     # IPv4 private ranges
109:     if [[ "$ip" =~ ^10\. ]] ||              # 10.0.0.0/8
110:        [[ "$ip" =~ ^172\.(1[6-9]|2[0-9]|3[0-1])\. ]] ||  # 172.16.0.0/12
111:        [[ "$ip" =~ ^192\.168\. ]] ||        # 192.168.0.0/16
112:        [[ "$ip" =~ ^127\. ]] ||             # 127.0.0.0/8 (loopback)
113:        [[ "$ip" =~ ^169\.254\. ]]; then     # 169.254.0.0/16 (link-local)
114:         return 1
115:     fi
116: 
117:     # IPv6 private/special ranges
118:     if [[ "$ip" =~ ^::1$ ]] ||              # Loopback
119:        [[ "$ip" =~ ^fe80: ]] ||             # Link-local
120:        [[ "$ip" =~ ^fc00: ]] ||             # Unique local (ULA)
121:        [[ "$ip" =~ ^fd00: ]]; then          # Unique local (ULA)
122:         return 1
123:     fi
124: 
125:     return 0
126: }
127: 
128: nftban_rbl_reverse_ip() {
129:     # Reverse IP address for DNS lookup
130:     # Args: $1 = IP address (IPv4 or IPv6)
131:     # Output: Reversed IP for RBL query
132: 
133:     local ip="$1"
134: 
135:     # Detect IPv4 vs IPv6
136:     if [[ "$ip" =~ : ]]; then
137:         # IPv6: Use nibble format with .ip6.arpa
138:         # Note: Most RBLs don't support IPv6 yet, but we prepare for it
139:         # Example: 2001:db8::1 -> 1.0.0.0...8.b.d.0.1.0.0.2.ip6.arpa
140: 
141:         # Expand IPv6 to full form first (simplified approach)
142:         # For production, would use 'sipcalc' or similar tool
143:         # For now, just return the compressed form (most RBLs won't accept it anyway)
144:         echo "$ip"  # Placeholder - full IPv6 reverse is complex
145:     else
146:         # IPv4: Simple octet reversal
147:         echo "$ip" | awk -F. '{print $4"."$3"."$2"."$1}'
148:     fi
149: }
150: 
151: # =============================================================================
152: # RBL PROVIDER FUNCTIONS
153: # =============================================================================
154: 
155: nftban_rbl_load_providers() {
156:     # Load RBL providers from configuration files
157:     # Output: domain:url (one per line)
158: 
159:     local providers=()
160:     local disabled_rbls=()
161:     local enabled_rbls=()
162: 
163:     # Load custom disable/enable list first
164:     if [[ -f "$NFTBAN_RBL_CUSTOM_FILE" ]]; then
165:         while IFS= read -r line; do
166:             # Skip comments and empty lines
167:             [[ "$line" =~ ^#.*$ ]] && continue
168:             [[ -z "$line" ]] && continue
169: 
170:             if [[ "$line" =~ ^disablerbl:(.*)$ ]]; then
171:                 disabled_rbls+=("${BASH_REMATCH[1]}")
172:             elif [[ "$line" =~ ^enablerbl:(.*)$ ]]; then
173:                 enabled_rbls+=("${BASH_REMATCH[1]}")
174:             fi
175:         done < "$NFTBAN_RBL_CUSTOM_FILE"
176:     fi
177: 
178:     # Load main RBL list
179:     if [[ -f "$NFTBAN_RBL_PROVIDERS_FILE" ]]; then
180:         while IFS= read -r line; do
181:             # Skip comments and empty lines
182:             [[ "$line" =~ ^#.*$ ]] && continue
183:             [[ -z "$line" ]] && continue
184: 
185:             # Extract domain (before colon)
186:             local domain="${line%%:*}"
187: 
188:             # Check if disabled
189:             local is_disabled=0
190:             for disabled in "${disabled_rbls[@]:-}"; do
191:                 if [[ "$domain" == "$disabled" ]]; then
192:                     is_disabled=1
193:                     break
194:                 fi
195:             done
196: 
197:             if [[ $is_disabled -eq 0 ]]; then
198:                 providers+=("$line")
199:             fi
200:         done < "$NFTBAN_RBL_PROVIDERS_FILE"
201:     fi
202: 
203:     # Add enabled custom RBLs
204:     for enabled in "${enabled_rbls[@]:-}"; do
205:         providers+=("$enabled")
206:     done
207: 
208:     # Output unique providers
209:     printf '%s\n' "${providers[@]}" | sort -u
210: }
211: 
212: # =============================================================================
213: # DNS LOOKUP FUNCTIONS
214: # =============================================================================
215: 
216: nftban_rbl_check_ip() {
217:     # Check single IP against all RBL providers
218:     # Args: $1 = IP address
219:     #       $2 = output format (text|json)
220:     # Output: RBL check results
221: 
222:     local ip="$1"
223:     local format="${2:-text}"
224:     local reversed_ip
225:     local results=()  # shellcheck disable=SC2034  # Reserved for detailed RBL results
226:     local listed_count=0
227:     local clean_count=0
228:     local timeout_count=0
229: 
230:     reversed_ip=$(nftban_rbl_reverse_ip "$ip")
231: 
232:     if [[ "$format" == "json" ]]; then
233:         echo "{"
234:         echo "  \"ip\": \"$ip\","
235:         echo "  \"checks\": ["
236:     else
237:         echo "RBL Check Results for: $ip"
238:         echo "─────────────────────────────────────────────────────────"
239:     fi
240: 
241:     local first=1
242:     while IFS=: read -r rbl_domain rbl_url; do
243:         local result
244:         local txt_record
245: 
246:         result=$(nftban_rbl_dns_lookup "$reversed_ip" "$rbl_domain")
247: 
248:         if [[ "$result" == "LISTED" ]]; then
249:             txt_record=$(nftban_rbl_get_txt_record "$reversed_ip" "$rbl_domain")
250:             ((listed_count++))
251: 
252:             if [[ "$format" == "json" ]]; then
253:                 [[ $first -eq 0 ]] && echo ","
254:                 echo "    {"
255:                 echo "      \"rbl\": \"$rbl_domain\","
256:                 echo "      \"status\": \"listed\","
257:                 echo "      \"reason\": \"$txt_record\","
258:                 echo "      \"url\": \"$rbl_url\""
259:                 echo -n "    }"
260:                 first=0
261:             else
262:                 echo "❌ LISTED: $rbl_domain"
263:                 [[ -n "$txt_record" ]] && echo "   Reason: $txt_record"
264:                 echo "   Info: $rbl_url"
265:             fi
266:         elif [[ "$result" == "TIMEOUT" ]]; then
267:             ((timeout_count++))
268: 
269:             if [[ "$format" == "json" ]]; then
270:                 [[ $first -eq 0 ]] && echo ","
271:                 echo "    {"
272:                 echo "      \"rbl\": \"$rbl_domain\","
273:                 echo "      \"status\": \"timeout\","
274:                 echo "      \"url\": \"$rbl_url\""
275:                 echo -n "    }"
276:                 first=0
277:             else
278:                 echo "⏱️  TIMEOUT: $rbl_domain"
279:             fi
280:         else
281:             ((clean_count++))
282: 
283:             if [[ "$format" == "text" ]] && [[ "${NFTBAN_RBL_VERBOSE:-NO}" == "YES" ]]; then
284:                 echo "✅ CLEAN: $rbl_domain"
285:             fi
286:         fi
287:     done < <(nftban_rbl_load_providers)
288: 
289:     if [[ "$format" == "json" ]]; then
290:         echo ""
291:         echo "  ],"
292:         echo "  \"summary\": {"
293:         echo "    \"listed\": $listed_count,"
294:         echo "    \"clean\": $clean_count,"
295:         echo "    \"timeout\": $timeout_count"
296:         echo "  }"
297:         echo "}"
298:     else
299:         echo "─────────────────────────────────────────────────────────"
300:         echo "Summary:"
301:         echo "  Listed: $listed_count"
302:         echo "  Clean: $clean_count"
303:         echo "  Timeout: $timeout_count"
304:     fi
305: }
306: 
307: nftban_rbl_dns_lookup() {
308:     # Perform DNS A record lookup for RBL
309:     # Args: $1 = reversed IP (4.3.2.1)
310:     #       $2 = RBL domain (zen.spamhaus.org)
311:     # Output: LISTED, CLEAN, or TIMEOUT
312: 
313:     local reversed_ip="$1"
314:     local rbl_domain="$2"
315:     local lookup_host="${reversed_ip}.${rbl_domain}"
316:     local timeout="${NFTBAN_RBL_TIMEOUT:-4}"
317: 
318:     # Perform DNS lookup with timeout
319:     if timeout "$timeout" host -t A "$lookup_host" &>/dev/null; then
320:         echo "LISTED"
321:     else
322:         local exit_code=$?
323:         if [[ $exit_code -eq 124 ]]; then
324:             echo "TIMEOUT"
325:         else
326:             echo "CLEAN"
327:         fi
328:     fi
329: }
330: 
331: nftban_rbl_get_txt_record() {
332:     # Get TXT record for listed IP (reason/description)
333:     # Args: $1 = reversed IP (4.3.2.1)
334:     #       $2 = RBL domain
335:     # Output: TXT record content (or empty)
336: 
337:     local reversed_ip="$1"
338:     local rbl_domain="$2"
339:     local lookup_host="${reversed_ip}.${rbl_domain}"
340:     local timeout="${NFTBAN_RBL_TIMEOUT:-4}"
341: 
342:     # Get TXT record
343:     timeout "$timeout" host -t TXT "$lookup_host" 2>/dev/null | \
344:         grep -oP '(?<=").*(?=")' | \
345:         head -n1 || echo ""
346: }
347: 
348: # =============================================================================
349: # CACHE FUNCTIONS
350: # =============================================================================
351: 
352: nftban_rbl_cache_get() {
353:     # Get cached RBL results for IP
354:     # Args: $1 = IP address
355:     # Return: 0 if valid cache exists, 1 otherwise
356:     # Output: Cache file path if valid
357: 
358:     local ip="$1"
359:     local cache_file="${NFTBAN_RBL_CACHE_DIR}/${ip}.cache"
360:     local cache_ttl_seconds=$((NFTBAN_RBL_CACHE_TTL * 3600))
361: 
362:     if [[ ! -f "$cache_file" ]]; then
363:         return 1
364:     fi
365: 
366:     # Check if cache expired
367:     local cache_age=$(($(date +%s) - $(stat -c %Y "$cache_file" 2>/dev/null || echo 0)))
368:     if [[ $cache_age -gt $cache_ttl_seconds ]]; then
369:         return 1
370:     fi
371: 
372:     echo "$cache_file"
373:     return 0
374: }
375: 
376: nftban_rbl_cache_set() {
377:     # Cache RBL results for IP
378:     # Args: $1 = IP address
379:     #       stdin = check results
380: 
381:     local ip="$1"
382:     local cache_file="${NFTBAN_RBL_CACHE_DIR}/${ip}.cache"
383: 
384:     # Create cache directory if needed
385:     mkdir -p "$NFTBAN_RBL_CACHE_DIR"
386: 
387:     # Write cache file
388:     cat > "$cache_file"
389: 
390:     # Set permissions
391:     chmod 640 "$cache_file" 2>/dev/null || true
392: }
393: 
394: nftban_rbl_cache_purge() {
395:     # Purge RBL cache
396:     # Args: $1 = IP address (optional, purge all if empty)
397: 
398:     local ip="${1:-}"
399: 
400:     if [[ -n "$ip" ]]; then
401:         # Purge specific IP
402:         rm -f "${NFTBAN_RBL_CACHE_DIR}/${ip}.cache"
403:         echo "Purged cache for: $ip"
404:     else
405:         # Purge all
406:         rm -f "${NFTBAN_RBL_CACHE_DIR}"/*.cache 2>/dev/null || true
407:         echo "Purged all RBL cache files"
408:     fi
409: }
410: 
411: nftban_rbl_cache_expired() {
412:     # Check if cache is expired
413:     # Args: $1 = IP address
414:     # Return: 0 if expired, 1 if valid
415: 
416:     local ip="$1"
417: 
418:     if nftban_rbl_cache_get "$ip" &>/dev/null; then
419:         return 1  # Valid cache
420:     else
421:         return 0  # Expired or missing
422:     fi
423: }
424: 
425: # =============================================================================
426: # ALERT FUNCTIONS
427: # =============================================================================
428: 
429: nftban_rbl_check_new_listing() {
430:     # Check if IP has new listing (state transition)
431:     # Args: $1 = IP address
432:     #       $2 = current status (listed/clean)
433:     # Return: 0 if new listing, 1 otherwise
434: 
435:     local ip="$1"
436:     local current_status="$2"
437:     local state_file="${NFTBAN_RBL_CACHE_DIR}/state.json"
438: 
439:     # If currently clean, no alert needed
440:     if [[ "$current_status" != "listed" ]]; then
441:         return 1
442:     fi
443: 
444:     # Check previous state
445:     if [[ ! -f "$state_file" ]]; then
446:         # No previous state - this is first check
447:         return 0
448:     fi
449: 
450:     # Check if IP was listed before
451:     if grep -q "\"$ip\".*\"listed\"" "$state_file" 2>/dev/null; then
452:         return 1  # Already listed
453:     fi
454: 
455:     return 0  # New listing
456: }
457: 
458: nftban_rbl_update_state() {
459:     # Update RBL state file
460:     # Args: $1 = IP address
461:     #       $2 = status (listed/clean/timeout)
462: 
463:     local ip="$1"
464:     local status="$2"
465:     local state_file="${NFTBAN_RBL_CACHE_DIR}/state.json"
466:     local timestamp
467:     timestamp=$(date -Iseconds)
468: 
469:     # Create directory if needed
470:     mkdir -p "$NFTBAN_RBL_CACHE_DIR"
471: 
472:     # Initialize state file if missing
473:     if [[ ! -f "$state_file" ]]; then
474:         echo "{}" > "$state_file"
475:     fi
476: 
477:     # Update state (simple JSON append for now)
478:     # Note: This is simplified - production would use jq
479:     {
480:         echo "{"
481:         echo "  \"$ip\": {"
482:         echo "    \"status\": \"$status\","
483:         echo "    \"timestamp\": \"$timestamp\""
484:         echo "  }"
485:         echo "}"
486:     } > "$state_file"
487: }
488: 
489: nftban_rbl_send_alert() {
490:     # Send RBL listing alert
491:     # Args: $1 = IP address
492:     #       $2 = RBL domain
493:     #       $3 = reason
494:     #       $4 = tag (mail/web/panel)
495: 
496:     local ip="$1"
497:     local rbl="$2"
498:     local reason="$3"
499:     local tag="${4:-unknown}"
500:     local email="${NFTBAN_RBL_ALERT_EMAIL:-}"
501: 
502:     if [[ -z "$email" ]]; then
503:         return 0
504:     fi
505: 
506:     # Build alert message
507:     local subject="[NFTBAN ALERT] IP Blacklisted: $ip ($tag)"
508:     local body
509:     body=$(cat <<EOF
510: ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
511: NFTBan RBL Alert - IP Blacklisted
512: ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
513: 
514: Severity:     CRITICAL
515: IP Address:   $ip
516: Tag:          $tag
517: Blacklist:    $rbl
518: Reason:       $reason
519: Detected:     $(date)
520: 
521: Impact:
522:   - Email delivery may fail
523:   - Reputation damage
524:   - Possible compromise indicator
525: 
526: Recommended Actions:
527:   1. Check outbound mail logs for spam
528:   2. Verify no open relay: telnet localhost 25
529:   3. Check for unauthorized processes
530:   4. Review recent logins: last -n 50
531:   5. Request delisting from RBL provider
532: 
533: ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
534: 
535: Full Report: nftban rbl check --verbose
536: ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
537: EOF
538: )
539: 
540:     # Send via mail command (basic implementation)
541:     echo "$body" | mail -s "$subject" "$email" 2>/dev/null || \
542:         echo "Warning: Failed to send RBL alert email" >&2
543: }
544: 
545: # =============================================================================
546: # STATUS FUNCTIONS
547: # =============================================================================
548: 
549: nftban_rbl_status() {
550:     # Get overall RBL monitoring status
551:     # Args: $1 = format (text|json)
552: 
553:     local format="${1:-text}"
554:     local last_check
555:     local cache_count
556: 
557:     # Get last check time
558:     if [[ -f "${NFTBAN_RBL_CACHE_DIR}/last_check" ]]; then
559:         last_check=$(cat "${NFTBAN_RBL_CACHE_DIR}/last_check")
560:     else
561:         last_check="Never"
562:     fi
563: 
564:     # Count cache files
565:     cache_count=$(find "${NFTBAN_RBL_CACHE_DIR}" -name "*.cache" 2>/dev/null | wc -l)
566: 
567:     if [[ "$format" == "json" ]]; then
568:         echo "{"
569:         echo "  \"enabled\": \"${NFTBAN_RBL_ENABLED}\","
570:         echo "  \"last_check\": \"$last_check\","
571:         echo "  \"cached_ips\": $cache_count,"
572:         echo "  \"cache_ttl_hours\": ${NFTBAN_RBL_CACHE_TTL}"
573:         echo "}"
574:     else
575:         echo "RBL Monitoring Status"
576:         echo "─────────────────────────────────────────────────────────"
577:         echo "Enabled: ${NFTBAN_RBL_ENABLED}"
578:         echo "Last Check: $last_check"
579:         echo "Cached IPs: $cache_count"
580:         echo "Cache TTL: ${NFTBAN_RBL_CACHE_TTL} hours"
581:     fi
582: }
583: 
584: # Export functions for use by CLI module
585: export -f nftban_rbl_get_public_ips
586: export -f nftban_rbl_check_ip
587: export -f nftban_rbl_cache_purge
588: export -f nftban_rbl_status
</file>

<file path="cli/lib/nftban/helpers/autoheal.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0 - Auto-Heal Script
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # meta:name=autoheal.sh
  7: # meta:type=helper
  8: # meta:header=Auto-Heal System Configuration
  9: # meta:version=1.0.0
 10: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 11: # meta:homepage=https://nftban.com
 12: # meta:description=Automatically fixes common configuration issues
 13: # =============================================================================
 14: 
 15: set -euo pipefail
 16: IFS=$'\n\t'
 17: 
 18: # Source central config for canonical paths (NO HARDCODED FALLBACKS)
 19: # shellcheck source=/etc/nftban/nftban.conf
 20: [[ -f "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf" ]] && source "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf"
 21: 
 22: # Colors for output
 23: readonly GREEN='\033[0;32m'
 24: readonly YELLOW='\033[1;33m'
 25: readonly RED='\033[0;31m'
 26: readonly NC='\033[0m'
 27: 
 28: log_info() {
 29:     echo -e "${GREEN}[AUTOHEAL]${NC} $*"
 30: }
 31: 
 32: log_warn() {
 33:     echo -e "${YELLOW}[AUTOHEAL]${NC} $*"
 34: }
 35: 
 36: log_error() {
 37:     echo -e "${RED}[AUTOHEAL]${NC} $*"
 38: }
 39: 
 40: # Check if running as root
 41: if [ "$(id -u)" -ne 0 ]; then
 42:     log_error "Must run as root"
 43:     exit 1
 44: fi
 45: 
 46: log_info "Starting NFTBan Auto-Heal..."
 47: 
 48: # =============================================================================
 49: # 1. Verify and create all FHS directories
 50: # =============================================================================
 51: log_info "Checking FHS directory structure..."
 52: 
 53: DIRS=(
 54:     "${NFTBAN_CONFIG_DIR}/conf.d"
 55:     "${NFTBAN_CONFIG_DIR}/secrets.d"
 56:     "${NFTBAN_CONFIG_DIR}/keys"
 57:     "${NFTBAN_CONFIG_DIR}/feeds.d"
 58:     "${NFTBAN_CONFIG_DIR}/distros"
 59:     "${NFTBAN_CONFIG_DIR}/ports.d"
 60:     "${NFTBAN_CONFIG_DIR}/whitelist.d"
 61:     "${NFTBAN_CONFIG_DIR}/blacklist.d"
 62:     "${NFTBAN_CONFIG_DIR}/geoban.d"
 63:     "/etc/suricata/rules"
 64:     "/etc/suricata/update.d"
 65:     "/etc/nftables/nftban.d"
 66:     "${NFTBAN_LIB_DIR}"
 67:     "${NFTBAN_LIB_DIR}/bin"
 68:     "${NFTBAN_LIB_DIR}/core"
 69:     "${NFTBAN_LIB_DIR}/cli"
 70:     "${NFTBAN_LIB_DIR}/helpers"
 71:     "${NFTBAN_LIB_DIR}/exporters"
 72:     "${NFTBAN_LIB_DIR}/setup"
 73:     "/usr/share/nftban"
 74:     "/usr/share/nftban/templates"
 75:     "/usr/share/nftban/templates/mail"
 76:     "/usr/share/nftban/templates/reports"
 77:     "${NFTBAN_DATA_DIR}/state"
 78:     "${NFTBAN_DATA_DIR}/snapshots"
 79:     "${NFTBAN_DATA_DIR}/feeds"
 80:     "${NFTBAN_DATA_DIR}/geoip"
 81:     "${NFTBAN_DATA_DIR}/reports"
 82:     "${NFTBAN_DATA_DIR}/keyring"
 83:     "${NFTBAN_DATA_DIR}/backup"
 84:     "${NFTBAN_DATA_DIR}/reports"
 85:     "${NFTBAN_DATA_DIR}/reports/baseline"
 86:     "${NFTBAN_DATA_DIR}/reports/auditors"
 87:     "${NFTBAN_DATA_DIR}/metrics"
 88:     "${NFTBAN_DATA_DIR}/config"
 89:     "${NFTBAN_DATA_DIR}/geoip"
 90:     "${NFTBAN_DATA_DIR}/geoban"
 91:     "${NFTBAN_DATA_DIR}/geoban/tracking"
 92:     "${NFTBAN_CACHE_DIR}/geoip"
 93:     "${NFTBAN_CACHE_DIR}/geoban"
 94:     "${NFTBAN_CACHE_DIR}/feeds"
 95:     "${NFTBAN_CACHE_DIR}/tmp"
 96:     "${NFTBAN_LOG_DIR}"
 97:     "${NFTBAN_LOG_DIR}/rbl"
 98:     "${NFTBAN_RUN_DIR}"
 99:     "${NFTBAN_RUN_DIR}/locks"
100: )
101: 
102: for DIR in "${DIRS[@]}"; do
103:     if [ ! -d "$DIR" ]; then
104:         mkdir -p "$DIR"
105:         log_info "Created missing directory: $DIR"
106:     fi
107: done
108: 
109: # =============================================================================
110: # 2. Fix permissions
111: # =============================================================================
112: log_info "Fixing permissions..."
113: 
114: chown -R root:nftban "${NFTBAN_CONFIG_DIR}"
115: chmod 750 "${NFTBAN_CONFIG_DIR}"
116: chmod 750 "${NFTBAN_CONFIG_DIR}/conf.d"
117: chmod 700 "${NFTBAN_CONFIG_DIR}/secrets.d"
118: chmod 700 "${NFTBAN_CONFIG_DIR}/keys"
119: 
120: # Suricata config directories (nftban group read access)
121: chown -R root:nftban /etc/suricata 2>/dev/null || true
122: chmod 750 /etc/suricata 2>/dev/null || true
123: chmod 640 /etc/suricata/*.conf 2>/dev/null || true
124: chmod 640 /etc/suricata/rules/*.rules 2>/dev/null || true
125: 
126: # nftables config
127: chown -R root:nftban /etc/nftables/nftban.d 2>/dev/null || true
128: chmod 750 /etc/nftables/nftban.d 2>/dev/null || true
129: 
130: chown -R nftban:nftban "${NFTBAN_DATA_DIR}"
131: chmod 750 "${NFTBAN_DATA_DIR}"
132: chmod 750 "${NFTBAN_DATA_DIR}/state"
133: chmod 750 "${NFTBAN_DATA_DIR}/feeds"
134: chmod 750 "${NFTBAN_DATA_DIR}/reports"
135: chmod 750 "${NFTBAN_DATA_DIR}/reports/baseline"
136: 
137: # Dedicated directory for nftban-auditors group (separate from main reports)
138: if getent group nftban-auditors >/dev/null 2>&1; then
139:     chown root:nftban-auditors "${NFTBAN_DATA_DIR}/reports/auditors"
140:     chmod 0770 "${NFTBAN_DATA_DIR}/reports/auditors"
141: else
142:     # Fallback if group doesn't exist
143:     chown nftban:nftban "${NFTBAN_DATA_DIR}/reports/auditors"
144:     chmod 750 "${NFTBAN_DATA_DIR}/reports/auditors"
145: fi
146: 
147: chown -R nftban:nftban "${NFTBAN_CACHE_DIR}"
148: chmod 755 "${NFTBAN_CACHE_DIR}"
149: 
150: # Application libraries directory (FHS: /usr/lib = root:root, 755)
151: chown -R root:root "${NFTBAN_LIB_DIR}" 2>/dev/null || true
152: chmod 755 "${NFTBAN_LIB_DIR}" 2>/dev/null || true
153: chmod 755 "${NFTBAN_LIB_DIR}/bin" 2>/dev/null || true
154: chmod 755 "${NFTBAN_LIB_DIR}/core" 2>/dev/null || true
155: chmod 755 "${NFTBAN_LIB_DIR}/cli" 2>/dev/null || true
156: chmod 755 "${NFTBAN_LIB_DIR}/helpers" 2>/dev/null || true
157: chmod 755 "${NFTBAN_LIB_DIR}/exporters" 2>/dev/null || true
158: chmod 755 "${NFTBAN_LIB_DIR}/setup" 2>/dev/null || true
159: # Make all shell scripts executable
160: find "${NFTBAN_LIB_DIR}" -type f -name "*.sh" -exec chmod 755 {} \; 2>/dev/null || true
161: # Make binaries executable
162: find "${NFTBAN_LIB_DIR}/bin" -type f -exec chmod 755 {} \; 2>/dev/null || true
163: # CRITICAL: Set CAP_NET_ADMIN on nftban-core for GUI ban/unban functionality
164: # The GUI (nftban-ui) runs as non-root and calls nftban-core for firewall operations
165: if [ -x "${NFTBAN_LIB_DIR}/bin/nftban-core" ]; then
166:     setcap cap_net_admin+ep "${NFTBAN_LIB_DIR}/bin/nftban-core" 2>/dev/null || log_warn "Failed to set CAP_NET_ADMIN on nftban-core"
167: fi
168: 
169: # Templates directory (FHS: /usr/share = root:root, 755)
170: chown -R root:root /usr/share/nftban 2>/dev/null || true
171: chmod 755 /usr/share/nftban 2>/dev/null || true
172: chmod 755 /usr/share/nftban/templates 2>/dev/null || true
173: chmod 755 /usr/share/nftban/templates/mail 2>/dev/null || true
174: chmod 755 /usr/share/nftban/templates/reports 2>/dev/null || true
175: find /usr/share/nftban/templates -type f -name "*.html" -exec chmod 644 {} \; 2>/dev/null || true
176: 
177: # =============================================================================
178: # CRITICAL: Fix log directory and ALL log files for nftban-auditors access
179: # =============================================================================
180: 
181: # Determine audit group (prefer nftban-auditors for compliance, fallback to nftban)
182: AUDIT_GROUP="nftban"
183: if getent group nftban-auditors >/dev/null 2>&1; then
184:     AUDIT_GROUP="nftban-auditors"
185:     log_info "Using nftban-auditors group for log file access"
186: fi
187: 
188: # Fix log directory ownership and permissions
189: chown nftban:"$AUDIT_GROUP" "${NFTBAN_LOG_DIR}"
190: chmod 750 "${NFTBAN_LOG_DIR}"
191: 
192: # Fix ALL log files (including those created by root like cloudflare.log, portscan.log)
193: # This ensures auditors can read all logs for compliance
194: log_info "Fixing log file ownership (including root-owned logs)..."
195: if [ -d "${NFTBAN_LOG_DIR}" ]; then
196:     find "${NFTBAN_LOG_DIR}" -type f \( -name "*.log" -o -name "*.log-*" -o -name "*.gz" \) \
197:         -exec chown nftban:"$AUDIT_GROUP" {} \; 2>/dev/null || true
198: 
199:     find "${NFTBAN_LOG_DIR}" -type f \( -name "*.log" -o -name "*.log-*" \) \
200:         -exec chmod 640 {} \; 2>/dev/null || true
201: 
202:     # Compressed logs can be read-only
203:     find "${NFTBAN_LOG_DIR}" -type f -name "*.gz" \
204:         -exec chmod 440 {} \; 2>/dev/null || true
205: 
206:     log_info "✅ All log files now accessible to $AUDIT_GROUP group"
207: fi
208: 
209: # =============================================================================
210: # 3. Generate system.conf if missing
211: # =============================================================================
212: log_info "Checking system.conf..."
213: 
214: SYSTEM_CONF="${NFTBAN_DATA_DIR}/config/system.conf"
215: if [ ! -f "$SYSTEM_CONF" ]; then
216:     log_info "Generating system.conf..."
217: 
218:     # NFTBan v1.0 simplified 2-group model
219:     NFTBAN_UID=$(id -u nftban)
220:     NFTBAN_GID=$(getent group nftban | cut -d: -f3)
221:     NFTBAN_AUDITORS_GID=$(getent group nftban-auditors | cut -d: -f3)
222: 
223:     cat > "$SYSTEM_CONF" <<EOF
224: # NFTBan System Configuration
225: # Auto-generated during installation
226: # v1.0 simplified 2-group model: nftban + nftban-auditors
227: NFTBAN_UID=$NFTBAN_UID
228: NFTBAN_GID=$NFTBAN_GID
229: NFTBAN_AUDITORS_GID=$NFTBAN_AUDITORS_GID
230: EOF
231: 
232:     chmod 644 "$SYSTEM_CONF"
233:     chown root:nftban "$SYSTEM_CONF"
234:     log_info "Created $SYSTEM_CONF"
235: fi
236: 
237: # =============================================================================
238: # 4. Enable and start systemd timer
239: # =============================================================================
240: log_info "Configuring systemd timer..."
241: 
242: if systemctl list-unit-files | grep -q "nftban.timer"; then
243:     systemctl daemon-reload 2>/dev/null || true
244:     systemctl enable nftban.timer 2>/dev/null || log_warn "Failed to enable nftban.timer"
245:     systemctl start nftban.timer 2>/dev/null || log_warn "Failed to start nftban.timer"
246:     log_info "Enabled and started nftban.timer"
247: else
248:     log_warn "nftban.timer not found - may need to complete installation first"
249: fi
250: 
251: # =============================================================================
252: # 5. Create default configuration if missing
253: # =============================================================================
254: log_info "Checking configuration files..."
255: 
256: if [ ! -f "${NFTBAN_CONFIG_DIR}/nftban.conf" ]; then
257:     log_warn "Main configuration missing - please run: nftban config init"
258: fi
259: 
260: # =============================================================================
261: # 6. Test nftables access
262: # =============================================================================
263: log_info "Testing nftables access..."
264: 
265: # PERFORMANCE FIX: Use 'nft -t list tables' (terse mode) to avoid dumping
266: # all IP sets which can cause 30+ second hangs with large feed sets
267: if command -v nft &>/dev/null; then
268:     if nft -t list tables &>/dev/null; then
269:         log_info "nftables access: OK"
270:     else
271:         log_warn "nftables access: FAILED - check permissions"
272:     fi
273: else
274:     log_warn "nftables (nft command) not found"
275: fi
276: 
277: # =============================================================================
278: # Automatically fix common issues
279: # =============================================================================
280: log_info "Running automated fixes..."
281: 
282: # Use centralized NFTBAN_BIN path
283: NFTBAN_CMD="${NFTBAN_BIN:-/usr/bin/nftban}"
284: 
285: # Fix permissions silently
286: "$NFTBAN_CMD" permissions enforce >/dev/null 2>&1 || true
287: 
288: # Fix FHS issues silently
289: "$NFTBAN_CMD" health check --auto-heal >/dev/null 2>&1 || true
290: 
291: # =============================================================================
292: # Check and auto-heal Suricata IDS (replaces fail2ban in v1.0)
293: # =============================================================================
294: log_info "Checking Suricata IDS configuration..."
295: 
296: # Check if Suricata service exists
297: if systemctl list-unit-files suricata.service &>/dev/null 2>&1; then
298:     # Suricata is installed - verify it's running
299:     if ! systemctl is-active --quiet suricata.service 2>/dev/null; then
300:         log_warn "Suricata service not running - attempting to start..."
301:         if systemctl start suricata.service 2>/dev/null; then
302:             log_info "✅ Started Suricata service"
303:         else
304:             log_error "Failed to start Suricata - check logs: journalctl -u suricata.service"
305:         fi
306:     else
307:         log_info "✅ Suricata service is running"
308:     fi
309: 
310:     # Verify eve.json is being written (use central config path)
311:     EVE_LOG="${NFTBAN_SURICATA_EVE_LOG:-/var/log/suricata/eve.json}"
312:     if [ -f "$EVE_LOG" ]; then
313:         # Check if file is recent (modified in last 5 minutes)
314:         if [ "$(find "$EVE_LOG" -mmin -5 2>/dev/null)" ]; then
315:             log_info "✅ Suricata eve.json is actively writing"
316:         else
317:             log_warn "Suricata eve.json not recently updated - may not be capturing traffic"
318:         fi
319:     else
320:         log_warn "Suricata eve.json not found at $EVE_LOG"
321:     fi
322: else
323:     log_warn "Suricata not installed - IDS protection disabled"
324: fi
325: 
326: # Check NFTBan Suricata integration daemon
327: if systemctl list-unit-files nftban-suricata.service &>/dev/null 2>&1; then
328:     if ! systemctl is-active --quiet nftban-suricata.service 2>/dev/null; then
329:         log_warn "NFTBan Suricata daemon not running - attempting to start..."
330: 
331:         # First verify filters.conf exists
332:         FILTERS_CONF="/etc/suricata/filters.conf"
333:         if [ ! -f "$FILTERS_CONF" ]; then
334:             log_error "Missing $FILTERS_CONF - cannot start Suricata daemon"
335:         else
336:             # Pre-create suricata-events.log with correct ownership for CAP_NET_ADMIN-only daemon
337:             # Daemon runs as User=root with SupplementaryGroups=nftban (no DAC capabilities)
338:             # File must be group-writable by nftban so root process can write via group perms
339:             SURICATA_LOG="${NFTBAN_LOG_DIR}/suricata-events.log"
340:             if [ ! -f "$SURICATA_LOG" ]; then
341:                 touch "$SURICATA_LOG" 2>/dev/null || true
342:                 chown root:nftban "$SURICATA_LOG" 2>/dev/null || true
343:                 chmod 660 "$SURICATA_LOG" 2>/dev/null || true
344:             else
345:                 # Fix ownership if file exists but has wrong perms (e.g. created by nftban user)
346:                 chown root:nftban "$SURICATA_LOG" 2>/dev/null || true
347:                 chmod 660 "$SURICATA_LOG" 2>/dev/null || true
348:             fi
349: 
350:             # Try to start daemon
351:             if systemctl start nftban-suricata.service 2>/dev/null; then
352:                 sleep 2
353:                 if systemctl is-active --quiet nftban-suricata.service 2>/dev/null; then
354:                     log_info "✅ Started NFTBan Suricata daemon"
355:                 else
356:                     log_error "NFTBan Suricata daemon failed to start - check: journalctl -u nftban-suricata.service"
357:                 fi
358:             else
359:                 log_error "Failed to start NFTBan Suricata daemon"
360:             fi
361:         fi
362:     else
363:         log_info "✅ NFTBan Suricata daemon is running"
364:     fi
365: else
366:     log_warn "NFTBan Suricata integration not installed"
367: fi
368: 
369: # Verify Suricata filter configuration (already set above in autoheal section)
370: if [ -f "${FILTERS_CONF:-/etc/suricata/filters.conf}" ]; then
371:     log_info "✅ Suricata filters configuration found"
372: else
373:     log_warn "Missing ${FILTERS_CONF:-/etc/suricata/filters.conf} - Suricata integration may not work"
374: fi
375: 
376: # =============================================================================
377: # Auto-fix metrics exporters (node_exporter + VictoriaMetrics)
378: # =============================================================================
379: log_info "Checking metrics exporters configuration..."
380: 
381: # Fix node_exporter textfile collector directory permissions
382: if [ -d "/var/lib/node_exporter" ]; then
383:     # Parent directory must be readable by node_exporter user
384:     chmod 755 /var/lib/node_exporter 2>/dev/null || true
385: 
386:     # Textfile collector directory - node_exporter needs read, nftban needs write
387:     if [ -d "/var/lib/node_exporter/textfile_collector" ]; then
388:         # Change owner to node_exporter user (if exists)
389:         if id node_exporter &>/dev/null; then
390:             chown node_exporter:nftban /var/lib/node_exporter/textfile_collector 2>/dev/null || true
391:             chmod 775 /var/lib/node_exporter/textfile_collector 2>/dev/null || true
392:             log_info "Fixed node_exporter textfile collector permissions"
393:         fi
394:     fi
395: fi
396: 
397: # Fix VictoriaMetrics scrape configuration (conflicting metric_relabel_configs)
398: VICTORIA_SCRAPE_CONF="/etc/victoriametrics/scrape.yml"
399: if [ -f "$VICTORIA_SCRAPE_CONF" ]; then
400:     # Check if config has the conflicting double-keep pattern
401:     if grep -q "action: keep" "$VICTORIA_SCRAPE_CONF" 2>/dev/null; then
402:         # Count how many "action: keep" lines exist
403:         KEEP_COUNT=$(grep -c "action: keep" "$VICTORIA_SCRAPE_CONF" 2>/dev/null || echo "0")
404: 
405:         if [ "$KEEP_COUNT" -gt 1 ]; then
406:             log_info "Fixing VictoriaMetrics scrape config (conflicting rules)..."
407: 
408:             # Backup original
409:             cp "$VICTORIA_SCRAPE_CONF" "${VICTORIA_SCRAPE_CONF}.bak" 2>/dev/null || true
410: 
411:             # Write corrected config
412:             cat > "$VICTORIA_SCRAPE_CONF" <<'VICTORIA_EOF'
413: global:
414:   scrape_interval: 60s
415: 
416: scrape_configs:
417:   - job_name: 'nftban'
418:     static_configs:
419:       - targets: ['localhost:9100']
420:     metric_relabel_configs:
421:       # Keep NFTBan metrics and essential node_exporter metrics
422:       - source_labels: [__name__]
423:         regex: '(nftban_.*|node_(cpu|memory|disk|network).*)'
424:         action: keep
425: VICTORIA_EOF
426: 
427:             # Restart VictoriaMetrics if running
428:             if systemctl is-active --quiet victoriametrics 2>/dev/null; then
429:                 systemctl restart victoriametrics 2>/dev/null || true
430:                 log_info "Restarted VictoriaMetrics with fixed config"
431:             fi
432:         fi
433:     fi
434: fi
435: 
436: # =============================================================================
437: # Auto-fix login monitor issues
438: # =============================================================================
439: log_info "Checking login monitor configuration..."
440: 
441: LOGIN_CONFIG="${NFTBAN_CONFIG_DIR}/conf.d/login_alert.conf"
442: LOGIN_CONFIG_LOCAL="${NFTBAN_CONFIG_DIR}/conf.d/login_alert.conf.local"
443: LOGIN_ISSUES_FOUND=0
444: LOGIN_ISSUES_FIXED=0
445: 
446: # Check if login monitor is configured (either config exists)
447: if [ -f "$LOGIN_CONFIG" ] || [ -f "$LOGIN_CONFIG_LOCAL" ]; then
448: 
449:     # 1. Check log directory exists
450:     LOGIN_LOG_DIR="${NFTBAN_LOG_DIR}"
451:     if [ ! -d "$LOGIN_LOG_DIR" ]; then
452:         mkdir -p "$LOGIN_LOG_DIR"
453:         chown nftban:nftban "$LOGIN_LOG_DIR" 2>/dev/null || true
454:         chmod 750 "$LOGIN_LOG_DIR"
455:         log_info "Created login log directory: $LOGIN_LOG_DIR"
456:         ((LOGIN_ISSUES_FIXED++))
457:     fi
458: 
459:     # 2. Check core module exists
460:     if [ ! -f "${NFTBAN_LIB_DIR}/core/nftban_login_alert.sh" ]; then
461:         log_warn "Login alert core module not found"
462:         ((LOGIN_ISSUES_FOUND++))
463:     fi
464: 
465:     # 3. Check if service should be running but isn't
466:     login_monitor_svc="${NFTBAN_SERVICE_LOGIN_MONITOR:-nftban-login-monitor.service}"
467:     if [ -f "/etc/systemd/system/$login_monitor_svc" ]; then
468:         if systemctl is-enabled --quiet "$login_monitor_svc" 2>/dev/null; then
469:             if ! systemctl is-active --quiet "$login_monitor_svc" 2>/dev/null; then
470:                 log_warn "Login monitor service enabled but not running - attempting restart"
471:                 if systemctl start "$login_monitor_svc" 2>/dev/null; then
472:                     log_info "✅ Started login monitor service"
473:                     ((LOGIN_ISSUES_FIXED++))
474:                 else
475:                     log_warn "Failed to start login monitor service"
476:                     ((LOGIN_ISSUES_FOUND++))
477:                 fi
478:             else
479:                 log_info "✅ Login monitor service is running"
480:             fi
481:         fi
482:     fi
483: 
484:     # Summary
485:     if [ "$LOGIN_ISSUES_FIXED" -gt 0 ]; then
486:         log_info "Fixed $LOGIN_ISSUES_FIXED login monitor issues"
487:     fi
488:     if [ "$LOGIN_ISSUES_FOUND" -gt 0 ]; then
489:         log_warn "Login monitor has $LOGIN_ISSUES_FOUND issues requiring attention"
490:     fi
491:     if [ "$LOGIN_ISSUES_FOUND" -eq 0 ] && [ "$LOGIN_ISSUES_FIXED" -eq 0 ]; then
492:         log_info "✅ Login monitor is healthy"
493:     fi
494: else
495:     log_info "Login monitor not configured (optional module)"
496: fi
497: 
498: # =============================================================================
499: # Run final health check - only report real errors, not warnings
500: # =============================================================================
501: HEALTH_OUTPUT=$("$NFTBAN_CMD" health check 2>&1 || true)
502: 
503: # Check for real errors (not warnings)
504: if echo "$HEALTH_OUTPUT" | grep -q "Overall Status:.*ERROR"; then
505:     ERROR_COUNT=$(echo "$HEALTH_OUTPUT" | grep -oP "Errors: \K\d+" || echo "0")
506:     # shellcheck disable=SC2034  # WARNING_COUNT reserved for future alerting logic
507:     WARNING_COUNT=$(echo "$HEALTH_OUTPUT" | grep -oP "Warnings: \K\d+" || echo "0")
508: 
509:     # Only alert if real errors exist (not just warnings)
510:     if [ "$ERROR_COUNT" != "0" ]; then
511:         echo ""
512:         echo "$HEALTH_OUTPUT"
513:         echo ""
514:         log_warn "================================================================="
515:         log_warn "⚠️  Some issues require manual attention"
516:         log_warn "================================================================="
517:         echo ""
518:         echo "Run: nftban health check --verbose"
519:         echo ""
520:         HEALTH_STATUS="ERROR"
521:     else
522:         # Only warnings, treat as success
523:         HEALTH_STATUS="OK"
524:     fi
525: else
526:     # OK or only warnings - both are fine
527:     HEALTH_STATUS="OK"
528: fi
529: 
530: # =============================================================================
531: # Summary
532: # =============================================================================
533: echo ""
534: log_info "================================================================="
535: log_info "Auto-Heal Complete!"
536: log_info "================================================================="
537: echo ""
538: log_info "✅ FHS directories created (38 directories)"
539: log_info "✅ Permissions enforced (correct ownership and modes)"
540: log_info "✅ System configuration generated"
541: log_info "✅ Systemd timer configured"
542: echo ""
543: 
544: # Only show health status line if errors exist
545: if [ "${HEALTH_STATUS:-OK}" = "ERROR" ]; then
546:     log_warn "Health: ${HEALTH_STATUS} (some issues need attention)"
547: else
548:     log_info "Health: OK (system ready)"
549: fi
550: echo ""
551: 
552: exit 0
</file>

<file path="cli/lib/nftban/setup/install_node_exporter.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - Node Exporter Installation Script
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Install and configure Prometheus Node Exporter for NFTBan metrics
  7: # Location: /usr/lib/nftban/setup/install_node_exporter.sh
  8: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
  9: # meta:homepage=https://nftban.com
 10: # nftban — Simplifying Linux Firewall Management
 11: #
 12: # meta:name=install_node_exporter
 13: # meta:type=setup
 14: # meta:header=Node Exporter Installation
 15: # meta:version=1.0.0
 16: #
 17: # **Description & Purpose**
 18: # meta:description=Install and configure Node Exporter with textfile collector for NFTBan metrics
 19: # meta:input=User choices (package vs binary installation)
 20: # meta:output=Configured Node Exporter service
 21: #
 22: # **Inventory & Requirements**
 23: # meta:depends=bash,wget|curl,tar
 24: #
 25: # meta:created_date=2025-11-17
 26: # =============================================================================
 27: 
 28: # Enhanced strict mode
 29: set -Eeuo pipefail
 30: IFS=$'\n\t'
 31: umask 027
 32: 
 33: # =============================================================================
 34: # CONFIGURATION
 35: # =============================================================================
 36: 
 37: SCRIPT_NAME="$(basename "${BASH_SOURCE[0]}")"
 38: readonly SCRIPT_NAME
 39: readonly NODE_EXPORTER_VERSION="1.7.0"
 40: readonly NODE_EXPORTER_PORT=9100
 41: readonly TEXTFILE_COLLECTOR_DIR="/var/lib/node_exporter/textfile_collector"
 42: 
 43: # =============================================================================
 44: # FUNCTIONS
 45: # =============================================================================
 46: 
 47: # Print informational message
 48: info() {
 49:     echo "[INFO] $*" >&2
 50: }
 51: 
 52: # Print error message
 53: error() {
 54:     echo "[ERROR] $*" >&2
 55: }
 56: 
 57: # Print success message
 58: success() {
 59:     echo "[SUCCESS] $*" >&2
 60: }
 61: 
 62: # Print usage
 63: usage() {
 64:     cat <<EOF
 65: Usage: $SCRIPT_NAME [OPTIONS]
 66: 
 67: Install and configure Prometheus Node Exporter for NFTBan metrics.
 68: 
 69: OPTIONS:
 70:     --method <method>       Installation method: package or binary (auto-detect)
 71:     --version <version>     Node Exporter version for binary install (default: $NODE_EXPORTER_VERSION)
 72:     --help                  Show this help message
 73: 
 74: INSTALLATION METHODS:
 75:     package                 Use distribution package manager (recommended)
 76:     binary                  Download and install official binary
 77: 
 78: EXAMPLES:
 79:     # Auto-detect and install
 80:     $SCRIPT_NAME
 81: 
 82:     # Use package manager
 83:     $SCRIPT_NAME --method package
 84: 
 85:     # Use binary installation
 86:     $SCRIPT_NAME --method binary --version 1.7.0
 87: 
 88: EOF
 89: }
 90: 
 91: # Detect OS distribution
 92: detect_os() {
 93:     if [[ -f /etc/os-release ]]; then
 94:         . /etc/os-release
 95:         echo "$ID"
 96:     else
 97:         error "Cannot detect OS distribution"
 98:         exit 1
 99:     fi
100: }
101: 
102: # Check if Node Exporter is already installed
103: check_existing() {
104:     if systemctl is-active --quiet node_exporter || \
105:        systemctl is-active --quiet prometheus-node-exporter; then
106:         info "Node Exporter is already running"
107: 
108:         # Ask user if they want to reconfigure
109:         read -p "Reconfigure existing installation? [y/N] " -n 1 -r
110:         echo
111:         if [[ ! $REPLY =~ ^[Yy]$ ]]; then
112:             info "Exiting without changes"
113:             exit 0
114:         fi
115:     fi
116: }
117: 
118: # Install via package manager
119: install_package() {
120:     local distro="$1"
121: 
122:     info "Installing Node Exporter via package manager..."
123: 
124:     case "$distro" in
125:         fedora|rhel|centos|rocky|almalinux)
126:             # Check if EPEL is needed (RHEL derivatives)
127:             if [[ "$distro" != "fedora" ]]; then
128:                 if ! rpm -q epel-release &>/dev/null; then
129:                     info "Installing EPEL repository..."
130:                     dnf install -y epel-release
131:                 fi
132:             fi
133: 
134:             # Install Node Exporter
135:             info "Installing golang-github-prometheus-node-exporter..."
136:             dnf install -y golang-github-prometheus-node-exporter
137:             ;;
138: 
139:         debian|ubuntu)
140:             info "Updating package list..."
141:             apt-get update
142: 
143:             info "Installing prometheus-node-exporter..."
144:             apt-get install -y prometheus-node-exporter
145:             ;;
146: 
147:         *)
148:             error "Unsupported distribution: $distro"
149:             error "Please use --method binary for manual installation"
150:             exit 1
151:             ;;
152:     esac
153: 
154:     success "Node Exporter package installed"
155: }
156: 
157: # Install from binary
158: install_binary() {
159:     local version="$1"
160: 
161:     info "Installing Node Exporter from official binary..."
162:     info "Version: $version"
163: 
164:     # Download
165:     local download_url="https://github.com/prometheus/node_exporter/releases/download/v${version}/node_exporter-${version}.linux-amd64.tar.gz"
166:     local tmpdir="/tmp/node_exporter_install_$$"
167: 
168:     mkdir -p "$tmpdir"
169:     cd "$tmpdir"
170: 
171:     info "Downloading Node Exporter..."
172:     if command -v wget &>/dev/null; then
173:         wget -q "$download_url"
174:     elif command -v curl &>/dev/null; then
175:         curl -sL -O "$download_url"
176:     else
177:         error "Neither wget nor curl is available"
178:         exit 1
179:     fi
180: 
181:     # Extract
182:     info "Extracting archive..."
183:     tar xzf "node_exporter-${version}.linux-amd64.tar.gz"
184: 
185:     # Install binary
186:     info "Installing binary to /usr/local/bin..."
187:     cp "node_exporter-${version}.linux-amd64/node_exporter" /usr/local/bin/
188:     chmod 755 /usr/local/bin/node_exporter
189: 
190:     # Create user if doesn't exist
191:     if ! id node_exporter &>/dev/null; then
192:         info "Creating node_exporter user..."
193:         useradd --no-create-home --shell /usr/sbin/nologin node_exporter
194:     fi
195: 
196:     # Create systemd service
197:     info "Creating systemd service..."
198:     cat > /etc/systemd/system/node_exporter.service <<'EOF'
199: [Unit]
200: Description=Prometheus Node Exporter
201: Documentation=https://github.com/prometheus/node_exporter
202: After=network.target
203: 
204: [Service]
205: Type=simple
206: User=node_exporter
207: Group=node_exporter
208: 
209: ExecStart=/usr/local/bin/node_exporter \
210:   --web.listen-address=127.0.0.1:9100 \
211:   --collector.textfile.directory=/var/lib/node_exporter/textfile_collector
212: 
213: Restart=on-failure
214: RestartSec=5s
215: 
216: # Security hardening
217: PrivateTmp=yes
218: ProtectSystem=strict
219: ProtectHome=yes
220: NoNewPrivileges=yes
221: ReadOnlyPaths=/var/lib/node_exporter/textfile_collector
222: 
223: # Kernel protections
224: ProtectKernelTunables=yes
225: ProtectKernelModules=yes
226: ProtectControlGroups=yes
227: 
228: # Resource limits
229: CPUQuota=20%
230: MemoryMax=128M
231: 
232: [Install]
233: WantedBy=multi-user.target
234: EOF
235: 
236:     # Cleanup
237:     cd /
238:     rm -rf "$tmpdir"
239: 
240:     success "Node Exporter binary installed"
241: }
242: 
243: # Configure textfile collector
244: configure_textfile_collector() {
245:     info "Configuring textfile collector..."
246: 
247:     # Create directory
248:     if [[ ! -d "$TEXTFILE_COLLECTOR_DIR" ]]; then
249:         info "Creating textfile collector directory..."
250:         mkdir -p "$TEXTFILE_COLLECTOR_DIR"
251:     fi
252: 
253:     # Set ownership to nftban user
254:     if id nftban &>/dev/null; then
255:         info "Setting ownership to nftban:nftban..."
256:         chown nftban:nftban "$TEXTFILE_COLLECTOR_DIR"
257:     else
258:         error "nftban user does not exist - run NFTBan installation first"
259:         error "Setting ownership to root for now..."
260:         chown root:root "$TEXTFILE_COLLECTOR_DIR"
261:     fi
262: 
263:     # Set permissions
264:     chmod 750 "$TEXTFILE_COLLECTOR_DIR"
265: 
266:     # Add node_exporter to nftban group
267:     if id nftban &>/dev/null && id node_exporter &>/dev/null; then
268:         info "Adding node_exporter to nftban group..."
269:         usermod -a -G nftban node_exporter
270:     fi
271: 
272:     success "Textfile collector configured"
273: }
274: 
275: # Configure Node Exporter service
276: configure_service() {
277:     info "Configuring Node Exporter service..."
278: 
279:     # Create systemd override directory
280:     mkdir -p /etc/systemd/system/node_exporter.service.d
281: 
282:     # Detect service name
283:     local service_name="node_exporter.service"
284:     if systemctl list-unit-files | grep -q prometheus-node-exporter.service; then
285:         service_name="prometheus-node-exporter.service"
286:         mkdir -p /etc/systemd/system/prometheus-node-exporter.service.d
287:     fi
288: 
289:     # Create override configuration
290:     info "Creating systemd override for textfile collector..."
291:     cat > "/etc/systemd/system/${service_name}.d/textfile-collector.conf" <<EOF
292: [Service]
293: # Clear existing ExecStart
294: ExecStart=
295: 
296: # Set new ExecStart with textfile collector and localhost binding
297: ExecStart=/usr/local/bin/node_exporter \\
298:   --web.listen-address=127.0.0.1:${NODE_EXPORTER_PORT} \\
299:   --collector.textfile.directory=${TEXTFILE_COLLECTOR_DIR}
300: EOF
301: 
302:     # Create security hardening override
303:     info "Creating systemd security hardening override..."
304:     cat > "/etc/systemd/system/${service_name}.d/hardening.conf" <<'EOF'
305: [Service]
306: # Additional security hardening
307: ProtectKernelTunables=yes
308: ProtectKernelModules=yes
309: ProtectControlGroups=yes
310: RestrictRealtime=yes
311: RestrictNamespaces=yes
312: LockPersonality=yes
313: PrivateDevices=yes
314: 
315: # Restrict capabilities
316: CapabilityBoundingSet=CAP_NET_BIND_SERVICE
317: 
318: # System call filtering
319: SystemCallFilter=@system-service
320: SystemCallErrorNumber=EPERM
321: EOF
322: 
323:     # Reload systemd
324:     info "Reloading systemd..."
325:     systemctl daemon-reload
326: 
327:     success "Service configured"
328: }
329: 
330: # Enable and start service
331: enable_service() {
332:     local service_name="node_exporter.service"
333: 
334:     # Detect service name
335:     if systemctl list-unit-files | grep -q prometheus-node-exporter.service; then
336:         service_name="prometheus-node-exporter.service"
337:     fi
338: 
339:     info "Enabling and starting $service_name..."
340: 
341:     # Enable on boot
342:     systemctl enable "$service_name"
343: 
344:     # Start service
345:     systemctl restart "$service_name"
346: 
347:     # Wait for service to start
348:     sleep 2
349: 
350:     # Check status
351:     if systemctl is-active --quiet "$service_name"; then
352:         success "Node Exporter is running"
353:     else
354:         error "Node Exporter failed to start"
355:         error "Check logs: journalctl -u $service_name -n 50"
356:         exit 1
357:     fi
358: }
359: 
360: # Verify installation
361: verify_installation() {
362:     info "Verifying installation..."
363: 
364:     # Check service is running
365:     if ! systemctl is-active --quiet node_exporter && \
366:        ! systemctl is-active --quiet prometheus-node-exporter; then
367:         error "Node Exporter service is not running"
368:         return 1
369:     fi
370:     success "✓ Service is running"
371: 
372:     # Check localhost binding
373:     if netstat -tulnp 2>/dev/null | grep "$NODE_EXPORTER_PORT" | grep -q "127.0.0.1"; then
374:         success "✓ Bound to localhost only (secure)"
375:     else
376:         error "⚠ Not bound to localhost - security risk!"
377:     fi
378: 
379:     # Check metrics endpoint
380:     if curl -s "http://localhost:$NODE_EXPORTER_PORT/metrics" | grep -q "node_exporter_build_info"; then
381:         success "✓ Metrics endpoint is accessible"
382:     else
383:         error "✗ Metrics endpoint is not accessible"
384:         return 1
385:     fi
386: 
387:     # Check textfile collector
388:     if curl -s "http://localhost:$NODE_EXPORTER_PORT/metrics" | grep -q "node_textfile_scrape_error"; then
389:         success "✓ Textfile collector is enabled"
390:     else
391:         error "✗ Textfile collector is not enabled"
392:         return 1
393:     fi
394: 
395:     # Check directory permissions
396:     if [[ -d "$TEXTFILE_COLLECTOR_DIR" ]]; then
397:         success "✓ Textfile collector directory exists"
398:     else
399:         error "✗ Textfile collector directory missing"
400:         return 1
401:     fi
402: 
403:     success "✅ Installation verified successfully!"
404: }
405: 
406: # Print next steps
407: print_next_steps() {
408:     cat <<EOF
409: 
410: ═══════════════════════════════════════════════════════════════
411:  Node Exporter Installation Complete!
412: ═══════════════════════════════════════════════════════════════
413: 
414: 📊 Metrics endpoint: http://localhost:9100/metrics
415: 📁 Textfile collector: $TEXTFILE_COLLECTOR_DIR
416: 
417: 🔹 Next Steps:
418: 
419: 1. Deploy NFTBan metrics exporter:
420:    sudo systemctl enable --now nftban-metrics-exporter.timer
421: 
422: 2. Verify metrics are being collected:
423:    curl -s http://localhost:9100/metrics | grep nftban_
424: 
425: 3. Configure Prometheus to scrape metrics:
426:    Add job to /etc/prometheus/prometheus.yml
427: 
428: 4. Configure firewall (if not already done):
429:    /usr/lib/nftban/setup/metrics-firewall-rules.sh --mode local-only
430: 
431: 📚 Documentation:
432:    - Setup guide: /usr/share/doc/nftban/metrics/NODE_EXPORTER_SETUP.md
433:    - Security guide: https://github.com/itcmsgr/nftban/wiki/Security-Operations-Guide
434: 
435: ═══════════════════════════════════════════════════════════════
436: 
437: EOF
438: }
439: 
440: # =============================================================================
441: # MAIN
442: # =============================================================================
443: 
444: main() {
445:     local method=""
446:     local version="$NODE_EXPORTER_VERSION"
447: 
448:     # Parse arguments
449:     while [[ $# -gt 0 ]]; do
450:         case "$1" in
451:             --method)
452:                 method="$2"
453:                 shift 2
454:                 ;;
455:             --version)
456:                 version="$2"
457:                 shift 2
458:                 ;;
459:             --help)
460:                 usage
461:                 exit 0
462:                 ;;
463:             *)
464:                 error "Unknown option: $1"
465:                 usage
466:                 exit 1
467:                 ;;
468:         esac
469:     done
470: 
471:     # Check if running as root
472:     if [[ $EUID -ne 0 ]]; then
473:         error "This script must be run as root"
474:         exit 1
475:     fi
476: 
477:     info "NFTBan Node Exporter Installation"
478:     info "════════════════════════════════════"
479: 
480:     # Check for existing installation
481:     check_existing
482: 
483:     # Detect OS
484:     local distro
485:     distro=$(detect_os)
486:     info "Detected OS: $distro"
487: 
488:     # Determine installation method
489:     if [[ -z "$method" ]]; then
490:         case "$distro" in
491:             fedora|rhel|centos|rocky|almalinux|debian|ubuntu)
492:                 method="package"
493:                 info "Using package installation (recommended)"
494:                 ;;
495:             *)
496:                 method="binary"
497:                 info "Using binary installation (distro not supported by packages)"
498:                 ;;
499:         esac
500:     fi
501: 
502:     # Install Node Exporter
503:     case "$method" in
504:         package)
505:             install_package "$distro"
506:             ;;
507:         binary)
508:             install_binary "$version"
509:             ;;
510:         *)
511:             error "Invalid installation method: $method"
512:             exit 1
513:             ;;
514:     esac
515: 
516:     # Configure textfile collector
517:     configure_textfile_collector
518: 
519:     # Configure service
520:     configure_service
521: 
522:     # Enable and start service
523:     enable_service
524: 
525:     # Verify installation
526:     verify_installation
527: 
528:     # Print next steps
529:     print_next_steps
530: }
531: 
532: # Run main function
533: main "$@"
534: 

 418:             if [[ -f "/etc/systemd/system/${NFTBAN_SERVICE_LOGIN_MONITOR:-nftban-login-monitor.service}" ]]; then
 419:                 systemctl stop ${NFTBAN_SERVICE_LOGIN_MONITOR:-nftban-login-monitor.service} 2>/dev/null || true
 420:                 systemctl disable ${NFTBAN_SERVICE_LOGIN_MONITOR:-nftban-login-monitor.service} 2>/dev/null || true
 421:             fi
 422:             echo "✅ Login monitoring disabled"
 423:             ;;
 424:         *)
 425:             echo "ERROR: Unknown target: $target" >&2
 426:             echo "Usage: nftban login disable [ssh|su|sudo|console|service|all]" >&2
 427:             return 1
 428:             ;;
 429:     esac

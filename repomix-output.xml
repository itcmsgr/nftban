1665: 
1666: // printRecommendation formats and prints a recommendation
1667: func printRecommendation(rec *recommendations.Recommendation) {
1668: 	// Type icon
1669: 	typeIcon := "ℹ️"
1670: 	switch rec.Type {
1671: 	case recommendations.FalsePositive:
1672: 		typeIcon = "⚠️"
1673: 	case recommendations.NoiseReduction:
1674: 		typeIcon = "🔇"
1675: 	case recommendations.DropMode:
1676: 		typeIcon = "🛡️"
1677: 	case recommendations.DisableRule:
1678: 		typeIcon = "❌"
1679: 	}
1680: 
1681: 	fmt.Printf("%s SID %s: %s\n", typeIcon, rec.SID, rec.Reason)
1682: 	fmt.Printf("   Category: %s\n", rec.Category)
1683: 
1684: 	signature := rec.Signature
1685: 	if len(signature) > 60 {
1686: 		signature = signature[:57] + "..."
1687: 	}
1688: 	fmt.Printf("   Signature: %s\n", signature)
1689: 
1690: 	fmt.Println("   Evidence:")
1691: 	for _, evidence := range rec.Evidence {
1692: 		fmt.Printf("     • %s\n", evidence)
1693: 	}
1694: 
1695: 	fmt.Printf("   ✅ Action: %s\n", rec.Action)
1696: 	fmt.Println()
1697: }

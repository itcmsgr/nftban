473:                                 <td class="px-15 py-8 main-border fs-13 font-mono">${event.ip || '-'}</td>
474:                                 <td class="px-15 py-8 main-border fs-13">${event.location || '-'}</td>
475:                                 <td class="px-15 py-8 main-border txt-c">${statusBadge}</td>

# =============================================================================
# NFTBan .gitignore
# =============================================================================

# Build artifacts
bin/
dist/
build/
*.o
*.a

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test artifacts
*.test
*.out
coverage.html
coverage.txt

# IDE and editor
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Claude Code (local dev settings)
.claude/

# Local environment
.env
.env.local
*.local

# Node modules (for web UI)
node_modules/
cmd/nftban-ui/web/node_modules/

# Temporary files
*.tmp
*.temp
*.log
*.bak

# Package artifacts
*.rpm
*.deb
*.tar.gz
*.tgz

# Debug
*.debug
__debug_bin

# Local test data
*.mmdb
GeoLite2-*.mmdb

# Config files with secrets (examples are ok)
/etc/nftban/*.conf
!/etc/nftban/*.conf.example

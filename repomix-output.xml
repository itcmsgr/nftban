 742: nftban_login_cmd_mode() {
 743:     # Set login alert email mode: realtime, digest, or both
 744:     # Usage: nftban login mode <realtime|digest|both>
 745: 
 746:     local mode="${1:-}"
 747: 
 748:     if [[ -z "$mode" ]]; then
 749:         # Show current mode
 750:         local current_mode="${NFTBAN_LOGIN_ALERT_MODE:-realtime}"
 751:         local digest_time="${NFTBAN_LOGIN_DIGEST_TIME:-08:00}"
 752:         local digest_file="${NFTBAN_LOGIN_DIGEST_FILE:-${NFTBAN_DATA_DIR:-/var/lib/nftban}/login_digest.json}"
 753:         local digest_count=0
 754: 
 755:         if [[ -f "$digest_file" ]] && command -v jq &>/dev/null; then
 756:             digest_count=$(jq 'length' "$digest_file" 2>/dev/null || echo "0")
 757:         fi
 758: 
 759:         echo "Login Alert Email Mode"
 760:         echo "======================"
 761:         echo ""
 762:         echo "Current Mode: $current_mode"
 763:         echo ""
 764:         echo "Modes:"
 765:         echo "  realtime  - Send email immediately on each trigger"
 766:         echo "  digest    - Collect alerts and send daily summary only"
 767:         echo "  both      - Send realtime alerts AND include in daily digest"
 768:         echo ""
 769:         echo "Digest Settings:"
 770:         echo "  Schedule: Daily at $digest_time (with daily report)"
 771:         echo "  File: $digest_file"
 772:         echo "  Pending alerts: $digest_count"
 773:         echo ""
 774:         echo "Usage: nftban login mode <realtime|digest|both>"
 775:         return 0
 776:     fi
 777: 
 778:     # Validate mode
 779:     case "$mode" in
 780:         realtime|digest|both)
 781:             ;;
 782:         *)
 783:             echo "ERROR: Invalid mode: $mode" >&2
 784:             echo "Valid modes: realtime, digest, both" >&2
 785:             return 1
 786:             ;;
 787:     esac
 788: 
 789:     # Set the mode in local config file
 790:     local config_local="${NFTBAN_CONFIG_DIR:-/etc/nftban}/conf.d/login_alert.conf.local"
 791:     _nftban_login_set_config "NFTBAN_LOGIN_ALERT_MODE" "$mode" "$config_local"
 792: 
 793:     echo "✅ Login alert mode set to: $mode"
 794:     echo ""
 795: 
 796:     case "$mode" in
 797:         realtime)
 798:             echo "Emails will be sent immediately when alerts are triggered."
 799:             ;;
 800:         digest)
 801:             echo "Alerts will be collected and sent as a daily digest."
 802:             echo "Digest is sent with the daily report (nftban report run daily)."
 803:             ;;
 804:         both)
 805:             echo "Realtime emails will be sent AND alerts included in daily digest."
 806:             ;;
 807:     esac
 808: 
 809:     # Restart service if running
 810:     if systemctl is-active --quiet ${NFTBAN_SERVICE_LOGIN_MONITOR:-nftban-login-monitor.service} 2>/dev/null; then
 811:         echo ""
 812:         echo "Restarting login monitor service..."
 813:         systemctl restart ${NFTBAN_SERVICE_LOGIN_MONITOR:-nftban-login-monitor.service} 2>/dev/null || true
 814:         echo "✅ Service restarted"
 815:     fi
 816: }

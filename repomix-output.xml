  56: # shellcheck source=/usr/lib/nftban/lib/version.sh
  57: if [[ -f "${NFTBAN_LIB_DIR}/lib/version.sh" ]]; then
  58:     source "${NFTBAN_LIB_DIR}/lib/version.sh"
  59: fi
  60: JSON_HELPER="${NFTBAN_LIB_DIR}/helpers/json_output.sh"
  61: if [[ -f "$JSON_HELPER" ]]; then
  62:     # shellcheck source=/dev/null
  63:     source "$JSON_HELPER"
  64: fi
  65: 
  66: # Load stats core module
  67: if ! declare -f nftban_stats_generate_dashboard >/dev/null 2>&1; then
  68:     if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_stats.sh" ]]; then
  69:         source "${NFTBAN_LIB_DIR}/core/nftban_stats.sh" || {
  70:             echo "ERROR: Failed to load stats core module" >&2
  71:             return 1
  72:         }
  73:     else
  74:         echo "ERROR: Stats module not found: ${NFTBAN_LIB_DIR}/core/nftban_stats.sh" >&2
  75:         return 1
  76:     fi
  77: fi
  78: 
  79: # Load path security module
  80: if ! declare -f nftban_path_get_safe_output >/dev/null 2>&1; then
  81:     if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_path_security.sh" ]]; then
  82:         source "${NFTBAN_LIB_DIR}/core/nftban_path_security.sh" || {
  83:             echo "ERROR: Failed to load path security module" >&2
  84:             return 1
  85:         }
  86:     fi
  87: fi

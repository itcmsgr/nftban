 23:     source "${NFTBAN_LIB_DIR}/lib/version.sh"
 24: fi
 25: JSON_HELPER="${NFTBAN_LIB_DIR}/helpers/json_output.sh"
 26: if [[ -f "$JSON_HELPER" ]]; then
 27:     # shellcheck source=/dev/null
 28:     source "$JSON_HELPER"
 29: fi
 30: # NFTBan v1.0.0 - Cloudflare CLI Handler
 31: # =============================================================================
 32: 
 33: # SPDX-License-Identifier: MPL-2.0
 34: # Purpose: CLI handler for cloudflare commands
 35: #
 36: # meta:name=cmd_cloudflare
 37: # meta:type=cli
 38: # meta:header=Cloudflare CLI Handler
 39: # meta:version=1.0.0
 40: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 41: # meta:homepage=https://nftban.com
 42: #
 43: # **Description & Purpose**
 44: # meta:description=CLI command handler for Cloudflare IP whitelist management
 45: # meta:input=User commands (update, status, enable, disable)
 46: # meta:output=Calls nftban_cloudflare core module functions
 47: #
 48: # **Inventory & Requirements**
 49: # meta:depends=bash,nftban_cloudflare.sh
 50: #
 51: # meta:created_date=2025-11-05
 52: # meta:updated_date=2025-11-24
 53: # =============================================================================
 54: 
 55: 
 56: IFS=$'\n\t'
 57: 
 58: # =============================================================================
 59: 
 60: # CLOUDFLARE COMMAND HANDLER
 61: # =============================================================================
 62: 
 63: 
 64: nftban_cmd_cloudflare() {
 65:     local action="${1:-status}"
 66:     local json_mode=false
 67: 
 68:     # Check for --json flag
 69:     for arg in "$@"; do
 70:         [[ "$arg" == "--json" ]] && json_mode=true && break  # shellcheck disable=SC2034  # Reserved for JSON output
 71:     done
 72:     shift || true
 73: 
 74:     # Load core cloudflare module
 75:     if [[ -f "${NFTBAN_LIB_DIR:-/usr/lib/nftban}/core/nftban_cloudflare.sh" ]]; then
 76:         # shellcheck source=/dev/null
 77:         source "${NFTBAN_LIB_DIR:-/usr/lib/nftban}/core/nftban_cloudflare.sh"
 78:     else
 79:         echo "ERROR: Cloudflare module not found" >&2
 80:         exit 1
 81:     fi
 82: 
 83:     # Check root for state-changing operations
 84:     case "$action" in
 85:         enable|disable|update)
 86:             if [[ "$EUID" -ne 0 ]]; then
 87:                 echo "ERROR: This command requires root privileges" >&2
 88:                 echo "Please run with sudo: sudo nftban cloudflare $action" >&2
 89:                 exit 1
 90:             fi
 91:             ;;
 92:     esac
 93: 
 94:     case "$action" in
 95:         enable)
 96:             nftban_cloudflare_enable
 97:             ;;
 98:         disable)
 99:             nftban_cloudflare_disable
100:             ;;
101:         update)
102:             nftban_cloudflare_update
103:             ;;
104:         status)
105:             nftban_cloudflare_status
106:             ;;
107:         download)
108:             # Just download, don't apply
109:             if [[ "$EUID" -ne 0 ]]; then
110:                 echo "ERROR: This command requires root privileges" >&2
111:                 exit 1
112:             fi
113:             nftban_cloudflare_init
114:             nftban_cloudflare_download_ips
115:             echo "✅ IP ranges downloaded to cache"
116:             echo "   Run 'nftban cloudflare update' to apply"
117:             ;;
118:         help|--help|-h)
119:             _nftban_cloudflare_help
120:             ;;
121:         *)
122:             echo "ERROR: Unknown cloudflare action: $action" >&2
123:             echo ""
124:             _nftban_cloudflare_help
125:             exit 1
126:             ;;
127:     esac
128: }
129: 
130: # =============================================================================
131: 
132: # HELP TEXT
133: # =============================================================================
134: 
135: 
136: _nftban_cloudflare_help() {
137:     # Load output module for standard banner
138:     source "${NFTBAN_LIB_DIR}/core/nftban_output.sh"
139: 
140:     # Show standard banner
141:     nftban_banner
142: 
143:     cat <<'HELP'
144: 
145: USAGE:
146:     nftban cloudflare <command>
147: 
148: COMMANDS:
149:     enable          Enable Cloudflare integration
150:                     - Downloads Cloudflare IP ranges
151:                     - Adds to system whitelist
152:                     - Applies to nftables
153:                     - Enables auto-update (if configured)
154: 
155:     disable         Disable Cloudflare integration
156:                     - Removes from whitelist
157:                     - Removes from nftables
158:                     - Clears cache files
159: 
160:     update          Update Cloudflare IP ranges
161:                     - Downloads latest ranges
162:                     - Updates whitelist
163:                     - Reloads nftables
164: 
165:     status          Show Cloudflare integration status
166:                     - Configuration
167:                     - Cache status
168:                     - Recent activity
169: 
170:     download        Download IP ranges (without applying)
171:                     - Useful for testing
172: 
173:     help            Show this help message
174: 
175: EXAMPLES:
176:     # Enable Cloudflare integration
177:     sudo nftban cloudflare enable
178: 
179:     # Check status
180:     nftban cloudflare status
181: 
182:     # Update IP ranges
183:     sudo nftban cloudflare update
184: 
185:     # Disable integration
186:     sudo nftban cloudflare disable
187: 
188: CONFIGURATION:
189:     Config file: /etc/nftban/conf.d/cloudflare.conf
190:     User overrides: /etc/nftban/nftban.conf.local
191: 
192:     Key settings:
193:       CLOUDFLARE_ENABLED="true|false"
194:       CLOUDFLARE_IPV4_ENABLED="true|false"
195:       CLOUDFLARE_IPV6_ENABLED="true|false"
196:       CLOUDFLARE_AUTO_UPDATE="true|false"
197: 
198: WHY USE CLOUDFLARE INTEGRATION?
199:     If you use Cloudflare as a CDN/proxy:
200:     ✓ All traffic comes from Cloudflare IPs
201:     ✓ Need to whitelist them to see real client IPs
202:     ✓ Prevents blocking legitimate Cloudflare traffic
203:     ✓ Essential for proper logging and security
204: 
205: FILES:
206:     Cache: /var/cache/nftban/cloudflare/
207:     Whitelist: /etc/nftban/whitelist.d/20-cloudflare.conf
208:     Logs: /var/log/nftban/cloudflare.log
209: 
210: NOTES:
211:     - Auto-update checks for new ranges daily (configurable)
212:     - Cloudflare IPs change occasionally
213:     - IPv6 support (if your server supports it)
214: 
215: For more information:
216:     https://docs.nftban.com/modules/cloudflare
217:     https://www.cloudflare.com/ips/
218: 
219: HELP
220: }
221: 
222: # =============================================================================
223: 
224: # EXPORT FUNCTION
225: # =============================================================================
226: 
227: 
228: export -f nftban_cmd_cloudflare
229: export -f _nftban_cloudflare_help
230: 
231: # =============================================================================
232: 
233: # END OF CLI HANDLER
234: # =============================================================================
</file>


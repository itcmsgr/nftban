530: 	if len(allIPs) == 0 {
531: 		return 0, fmt.Errorf("no valid IPs found")
532: 	}
533: 
534: 	// Write to file
535: 	out, err := os.Create(outputFile)
536: 	if err != nil {
537: 		return 0, fmt.Errorf("failed to create output file: %w", err)
538: 	}
539: 	defer out.Close()
540: 
541: 	writer := bufio.NewWriter(out)
542: 	for _, ip := range allIPs {

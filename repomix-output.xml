  1: #!/usr/bin/env bash
  2: # shellcheck disable=SC1083  # Braces in nftables syntax are literal, not bash
  3: # =============================================================================
  4: # NFTBan v1.0.0 - Search CLI Handler
  5: # =============================================================================
  6: # SPDX-License-Identifier: MPL-2.0
  7: # Purpose: Search for IP/Port across all ban lists, feeds, jails, and whitelists
  8: #
  9: # meta:name=cmd_search
 10: # meta:type=cli
 11: # meta:header=IP Search CLI
 12: # meta:version=1.0.0
 13: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 14: # meta:homepage=https://nftban.com
 15: #
 16: # **Description & Purpose**
 17: # meta:description=Search for IP in all nftables sets and threat feeds with interactive options
 18: # meta:input=IP address or CIDR
 19: # meta:output=Search results and interactive menu
 20: #
 21: # **Inventory & Requirements**
 22: # meta:depends=bash
 23: #
 24: # meta:created_date=2025-11-05
 25: # meta:updated_date=2025-11-24
 26: # =============================================================================
 27: 
 28: 
 29: # =============================================================================
 30: # CONFIGURATION
 31: # =============================================================================
 32: 
 33: # Source central config for canonical paths (NO HARDCODED FALLBACKS)
 34: # shellcheck source=/etc/nftban/nftban.conf
 35: [[ -f "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf" ]] && source "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf"
 36: 
 37: [[ -z "${NFTBAN_LIB_DIR:-}" ]] && readonly NFTBAN_LIB_DIR="/usr/lib/nftban"
 38: 
 39: # Load strict mode library
 40: # shellcheck source=/usr/lib/nftban/lib/strict.sh
 41: if [[ -f "${NFTBAN_LIB_DIR}/lib/strict.sh" ]]; then
 42:     source "${NFTBAN_LIB_DIR}/lib/strict.sh"
 43: else
 44:     # Fallback to manual strict mode
 45:     set -Eeuo pipefail
 46: fi
 47: 
 48: # Load version library
 49: # shellcheck source=/usr/lib/nftban/lib/version.sh
 50: if [[ -f "${NFTBAN_LIB_DIR}/lib/version.sh" ]]; then
 51:     source "${NFTBAN_LIB_DIR}/lib/version.sh"
 52: fi
 53: readonly NFTBAN_FEEDS_DIR="${NFTBAN_FEEDS_DIR:-/var/lib/nftban/feeds}"
 54: 
 55: # Load JSON helper for --json support
 56: JSON_HELPER="${NFTBAN_LIB_DIR}/helpers/json_output.sh"
 57: if [[ -f "$JSON_HELPER" ]]; then
 58:     # shellcheck source=/dev/null
 59:     source "$JSON_HELPER"
 60: fi
 61: 
 62: # Load NFT schema (single source of truth for table/set names)
 63: # shellcheck source=/usr/lib/nftban/lib/nft_schema.sh
 64: if [[ -f "${NFTBAN_LIB_DIR}/lib/nft_schema.sh" ]]; then
 65:     source "${NFTBAN_LIB_DIR}/lib/nft_schema.sh"
 66: fi
 67: 
 68: # Load required core modules
 69: if [[ ! $(type -t nftban_render_banner) == "function" ]]; then
 70:     if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_output.sh" ]]; then
 71:         # shellcheck source=/dev/null
 72:         source "${NFTBAN_LIB_DIR}/core/nftban_output.sh"
 73:     fi
 74: fi
 75: 
 76: # =============================================================================
 77: # SEARCH FUNCTIONS
 78: # =============================================================================
 79: 
 80: # Search in nftables sets
 81: _search_nftables() {
 82:     local ip="$1"
 83:     local found_in=()
 84: 
 85:     # Determine IP version and table family
 86:     local table_family
 87:     local ip_suffix
 88:     if [[ "$ip" == *:* ]]; then
 89:         table_family="ip6"
 90:         ip_suffix="ipv6"
 91:     else
 92:         table_family="ip"
 93:         ip_suffix="ipv4"
 94:     fi
 95: 
 96:     # Search in ip/ip6 nftban tables (v0.7.3 dual table architecture)
 97:     # Sets: whitelist, blacklist (blacklist contains both permanent + temporary bans)
 98:     # Note: feeds, geoban, and temp bans are ALL consolidated into blacklist by nftban-core
 99:     local all_sets=("whitelist_${ip_suffix}" "blacklist_${ip_suffix}")
100:     for set in "${all_sets[@]}"; do
101:         # Temporarily disable errexit and ERR trap for this check
102:         # Save current trap, disable it, then restore
103:         local old_trap
104:         old_trap=$(trap -p ERR)
105:         trap - ERR
106:         set +e
107:         # Add timeout to prevent hanging on large sets
108:         timeout 2 nft get element "${table_family}" nftban "$set" { "$ip" } &>/dev/null
109:         local result=$?
110:         set -e
111:         eval "$old_trap"
112: 
113:         if [[ $result -eq 0 ]]; then
114:             # Normalize set names for display (remove _ipv4/_ipv6 suffix)
115:             local display_set="${set//_ipv4/}"
116:             display_set="${display_set//_ipv6/}"
117:             found_in+=("nftban:${display_set}")
118:         fi
119:     done
120: 
121:     if [[ ${#found_in[@]} -gt 0 ]]; then
122:         echo "FOUND"
123:         printf '%s\n' "${found_in[@]}"
124:         return 0
125:     else
126:         echo "NOT_FOUND"
127:         return 1
128:     fi
129: }
130: 
131: # Search in feed files
132: _search_feeds() {
133:     local ip="$1"
134:     local found_feeds=()
135: 
136:     if [[ ! -d "$NFTBAN_FEEDS_DIR" ]]; then
137:         return 1
138:     fi
139: 
140:     for feed_file in "$NFTBAN_FEEDS_DIR"/*.txt; do
141:         if [[ ! -f "$feed_file" ]]; then
142:             continue
143:         fi
144: 
145:         if grep -q "^${ip}$" "$feed_file" 2>/dev/null; then
146:             local feed_name
147:             feed_name=$(basename "$feed_file" .txt)
148:             found_feeds+=("$feed_name")
149:         fi
150:     done
151: 
152:     if [[ ${#found_feeds[@]} -gt 0 ]]; then
153:         printf '%s\n' "${found_feeds[@]}"
154:         return 0
155:     else
156:         return 1
157:     fi
158: }
159: 
160: # Note: fail2ban search removed in v1.0 (replaced by Suricata IDS and built-in login monitoring)
161: 
162: # Get ban details (source, time, etc.)
163: _get_ban_details() {
164:     local ip="$1"
165:     local table="$2"
166:     local set="$3"
167: 
168:     # Try to get element with timeout info
169:     nft list set "$table" "$set" | grep "$ip" || echo "No details available"
170: }
171: 
172: # Search for port in nftables and config files
173: _search_port() {
174:     local port="$1"
175:     local found_in=()
176: 
177:     # Search in nftables tcp_ports set (v0.7.3: ip nftban + ip6 nftban tables)
178:     # Note: Both IPv4 and IPv6 tables have tcp_ports sets, check both
179:     if nft list set ${NFTBAN_TABLE_IPV4} tcp_ports 2>/dev/null | grep -qw "$port" || \
180:        nft list set ${NFTBAN_TABLE_IPV6} tcp_ports 2>/dev/null | grep -qw "$port"; then
181:         found_in+=("nftables:tcp_ports")
182:     fi
183: 
184:     # Search in nftables udp_ports set (v0.7.3: ip nftban + ip6 nftban tables)
185:     if nft list set ${NFTBAN_TABLE_IPV4} udp_ports 2>/dev/null | grep -qw "$port" || \
186:        nft list set ${NFTBAN_TABLE_IPV6} udp_ports 2>/dev/null | grep -qw "$port"; then
187:         found_in+=("nftables:udp_ports")
188:     fi
189: 
190:     # Search in config files
191:     if [[ -d "${NFTBAN_CONFIG_DIR}/ports.d" ]]; then
192:         while IFS= read -r file; do
193:             if grep -qE "^${port}\|" "$file" 2>/dev/null; then
194:                 local proto
195:                 proto=$(grep -E "^${port}\|" "$file" | cut -d'|' -f2 | head -1)
196:                 local proto_name="unknown"
197:                 case "$proto" in
198:                     T) proto_name="TCP" ;;
199:                     U) proto_name="UDP" ;;
200:                     B) proto_name="TCP+UDP" ;;
201:                 esac
202:                 found_in+=("config:$(basename "$file"):$proto_name")
203:             fi
204:         done < <(find "${NFTBAN_CONFIG_DIR}/ports.d" -type f -name "*.conf" 2>/dev/null)
205:     fi
206: 
207:     if [[ ${#found_in[@]} -gt 0 ]]; then
208:         echo "FOUND"
209:         printf '%s\n' "${found_in[@]}"
210:         return 0
211:     else
212:         echo "NOT_FOUND"
213:         return 1
214:     fi
215: }
216: 
217: # =============================================================================
218: # DISPLAY FUNCTIONS
219: # =============================================================================
220: 
221: _display_results() {
222:     local ip="$1"
223:     local nft_result="$2"
224:     local feeds_result="$3"
225: 
226:     echo ""
227:     echo "═══════════════════════════════════════════════════════════════"
228:     echo "  IP Search Results: $ip"
229:     echo "═══════════════════════════════════════════════════════════════"
230:     echo ""
231: 
232:     # Parse nftables results
233:     if [[ "$nft_result" == "FOUND"* ]]; then
234:         echo "✗ STATUS: BANNED"
235:         echo ""
236:         echo "Found in nftables sets:"
237:         echo "───────────────────────────────────────────────────────────────"
238: 
239:         # Skip first line (FOUND)
240:         local found_sets
241:         found_sets=$(echo "$nft_result" | tail -n +2)
242: 
243:         while IFS= read -r location; do
244:             local table="${location%%:*}"
245:             local set="${location##*:}"
246: 
247:             case "$set" in
248:                 whitelist)
249:                     echo "  ✓ WHITELISTED in $table"
250:                     echo "    → Priority: HIGHEST (cannot be banned)"
251:                     ;;
252:                 temp_ban)
253:                     echo "  ✓ TEMP BAN in $table"
254:                     echo "    → Auto-expires (timeout active)"
255:                     echo "    → Details: No details available"
256:                     ;;
257:                 blacklist)
258:                     echo "  ✓ BLACKLISTED in $table"
259:                     # Check if it has a timeout (temporary ban)
260:                     local ban_info set_name timeout_str expires_str
261:                     set_name="blacklist_ipv4"
262:                     [[ "$ip" == *:* ]] && set_name="blacklist_ipv6"
263:                     ban_info=$(nft list set "$table" "$set_name" 2>/dev/null | grep -F "$ip" | head -1) || true
264:                     if [[ "$ban_info" == *"timeout"* ]]; then
265:                         # Extract timeout info: "timeout 1h expires 55m30s123ms,"
266:                         timeout_str=$(echo "$ban_info" | grep -oE 'timeout [0-9]+[smhd]' | head -1) || true
267:                         expires_str=$(echo "$ban_info" | grep -oE 'expires [0-9]+[smhd]+[0-9]*[smhd]*' | head -1) || true
268:                         echo "    → Type: Temporary ban ($timeout_str)"
269:                         [[ -n "$expires_str" ]] && echo "    → Expires in: ${expires_str#expires }"
270:                     else
271:                         echo "    → Type: Permanent ban"
272:                     fi
273:                     ;;
274:                 user_blacklist)
275:                     echo "  ✓ USER BLACKLIST in $table"
276:                     echo "    → Type: Manual permanent ban"
277:                     ;;
278:                 system_blacklist)
279:                     echo "  ✓ SYSTEM BLACKLIST in $table"
280:                     echo "    → Type: Automatic permanent ban"
281:                     ;;
282:                 feeds)
283:                     echo "  ✓ THREAT FEEDS in $table"
284:                     echo "    → Source: Threat intelligence"
285:                     ;;
286:             esac
287:         done <<< "$found_sets"
288: 
289:         echo ""
290:     else
291:         echo "✓ STATUS: NOT BANNED"
292:         echo ""
293:         echo "Not found in nftables sets:"
294:         echo "───────────────────────────────────────────────────────────────"
295:         echo "  ✗ whitelist"
296:         echo "  ✗ temp_ban"
297:         echo "  ✗ user_blacklist"
298:         echo "  ✗ system_blacklist"
299:         echo "  ✗ feeds"
300:         echo ""
301:     fi
302: 
303:     # Show feed matches
304:     if [[ -n "$feeds_result" ]]; then
305:         echo "Found in threat feeds:"
306:         echo "───────────────────────────────────────────────────────────────"
307:         while IFS= read -r feed; do
308:             echo "  ✓ $feed"
309:         done <<< "$feeds_result"
310:         echo ""
311:     fi
312: 
313:     echo "═══════════════════════════════════════════════════════════════"
314: }
315: 
316: # =============================================================================
317: # ACTION SUGGESTIONS (replaced interactive menu in v1.0.18)
318: # =============================================================================
319: 
320: _suggest_actions() {
321:     # Suggest commands instead of interactive menu
322:     # This is simpler, faster, and follows Unix philosophy
323:     local ip="$1"
324:     local is_banned="$2"
325: 
326:     echo ""
327:     echo "💡 Quick Actions:"
328:     echo "───────────────────────────────────────────────────────────────"
329: 
330:     if [[ "$is_banned" == "true" ]]; then
331:         echo "  Remove ban:"
332:         echo "    nftban unban $ip"

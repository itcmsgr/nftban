# =============================================================================
# Prometheus Configuration - Remote Write to Grafana Cloud
# =============================================================================
# Location: /etc/prometheus/prometheus.yml
#
# This configuration sends NFTBan metrics to Grafana Cloud via remote write.
#
# Setup:
#   1. Create Grafana Cloud account (free tier available)
#   2. Get your Prometheus endpoint and API key
#   3. Replace placeholders below with your credentials
#   4. Copy to /etc/prometheus/prometheus.yml
#   5. Store API key in /etc/default/prometheus-secrets
#   6. Reload Prometheus: systemctl reload prometheus
# =============================================================================

# Global configuration
global:
  scrape_interval: 60s
  evaluation_interval: 60s
  scrape_timeout: 10s

  external_labels:
    monitor: 'nftban-prometheus'
    environment: 'production'
    # These labels will be attached to all metrics sent to Grafana Cloud

# Scrape configurations (same as base config)
scrape_configs:
  - job_name: 'nftban'
    scrape_interval: 60s
    scrape_timeout: 10s

    static_configs:
      - targets:
          - 'localhost:9100'
        labels:
          instance: 'nftban-server'

    # Keep only nftban metrics
    metric_relabel_configs:
      - source_labels: [__name__]
        regex: 'nftban_.*'
        action: keep

# Remote write to Grafana Cloud
remote_write:
  - url: https://prometheus-prod-XX-prod-XX-XX.grafana.net/api/prom/push
    # Replace with your Grafana Cloud Prometheus endpoint
    # Example: https://prometheus-prod-13-prod-us-east-0.grafana.net/api/prom/push

    # Authentication
    basic_auth:
      username: '123456'  # Your Grafana Cloud instance ID
      password: '${GRAFANA_CLOUD_API_KEY}'  # Use environment variable

    # Queue configuration (tuning for reliability)
    queue_config:
      capacity: 10000
      max_shards: 10
      min_shards: 1
      max_samples_per_send: 5000
      batch_send_deadline: 5s
      min_backoff: 30ms
      max_backoff: 100ms

    # Only send nftban metrics (save on bandwidth/storage)
    write_relabel_configs:
      - source_labels: [__name__]
        regex: 'nftban_.*'
        action: keep

    # Metadata configuration
    metadata_config:
      send: true
      send_interval: 1m

    # Retry configuration
    # If remote write fails, retry with exponential backoff

# Optional: Also keep local storage (recommended)
# This allows querying even if Grafana Cloud is down
storage:
  tsdb:
    retention.time: 7d  # Keep 7 days locally
    retention.size: 5GB
    path: /var/lib/prometheus/

# =============================================================================
# Environment Variable Setup
# =============================================================================
#
# Create /etc/default/prometheus-secrets:
#
#   GRAFANA_CLOUD_API_KEY=glc_eyJrIjoiWW91ckFwaUtleUhlcmUiLCJuIjoibmZ0YmFu...
#
# Set permissions:
#   chmod 600 /etc/default/prometheus-secrets
#   chown prometheus:prometheus /etc/default/prometheus-secrets
#
# Load in systemd service:
#   [Service]
#   EnvironmentFile=/etc/default/prometheus-secrets
#
# =============================================================================

# =============================================================================
# Getting Grafana Cloud Credentials
# =============================================================================
#
# 1. Sign up at https://grafana.com/auth/sign-up/create-user
# 2. Create a free Grafana Cloud account
# 3. Go to "Connections" → "Add new connection"
# 4. Select "Hosted Prometheus metrics"
# 5. Click "Configure"
# 6. Find:
#    - Remote write endpoint (URL)
#    - Instance ID (username)
#    - API key (password - generate if needed)
#
# Free tier includes:
#   - 10,000 series
#   - 14 days retention
#   - 3 users
#
# NFTBan metrics typically use ~250 series, well within free tier.
#
# =============================================================================

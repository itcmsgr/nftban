 32: <script>
 33: // Avoid redeclaration errors when navigating between pages
 34: if (typeof window.currentModule === 'undefined') {
 35:     window.currentModule = null;
 36: }
 37: 
 38: async function loadConfigModules() {
 39:     try {
 40:         const modules = ['main', 'firewall', 'feeds', 'fail2ban', 'portscan', 'ddos', 'geoip'];
 41:         let html = '';
 42: 
 43:         modules.forEach(module => {
 44:             html += `
 45:                 <div style="background: var(--bg-alt); border: 1px solid var(--border); border-radius: 8px; padding: 20px; display: flex; justify-content: space-between; align-items: center;">
 46:                     <div>
 47:                         <h4>${module.charAt(0).toUpperCase() + module.slice(1)} Configuration</h4>
 48:                         <p style="font-size: 13px; color: var(--text-muted);">/etc/nftban/${module}.conf</p>
 49:                     </div>
 50:                     <button onclick="editConfig('${module}')" class="btn-primary">
 51:                         <i class="fa fa-edit"></i> Edit
 52:                     </button>
 53:                 </div>
 54:             `;
 55:         });
 56: 
 57:         document.getElementById('config-modules').innerHTML = html;
 58:     } catch (error) {
 59:         console.error('Failed to load config modules:', error);
 60:     }
 61: }
 62: 
 63: async function editConfig(module) {
 64:     window.currentModule = module;
 65: 
 66:     try {
 67:         const response = await apiRequest(`/config/${module}`);
 68: 
 69:         document.getElementById('config-module-name').textContent = `${module}.conf`;
 70:         document.getElementById('config-content').value = response.data || '';
 71:         document.getElementById('config-editor').style.display = 'block';
 72: 
 73:         // Scroll to editor
 74:         document.getElementById('config-editor').scrollIntoView({ behavior: 'smooth' });
 75:     } catch (error) {
 76:         alert(`Failed to load configuration: ${error.message}`);
 77:     }
 78: }
 79: 
 80: function closeConfigEditor() {

152: 
153:         .chart-container {
154:             position: relative;
155:             height: 300px;
156:         }
157: 
158:         .alert {
159:             padding: 16px;
160:             border-radius: 8px;
161:             margin-bottom: 16px;
162:         }
163: 
164:         .alert-warning {
165:             background: rgba(245, 158, 11, 0.1);
166:             border: 1px solid var(--warning);
167:             color: var(--warning);
168:         }
169: 
170:         .alert-danger {
171:             background: rgba(239, 68, 68, 0.1);
172:             border: 1px solid var(--danger);
173:             color: var(--danger);
174:         }
175: 
176:         .alert-success {
177:             background: rgba(16, 185, 129, 0.1);
178:             border: 1px solid var(--success);
179:             color: var(--success);
180:         }
181: 
182:         footer {
183:             margin-top: 48px;
184:             padding-top: 24px;
185:             border-top: 1px solid var(--border);
186:             text-align: center;
187:             color: var(--text-muted);
188:             font-size: 14px;
189:         }
190: 
191:         @media print {
192:             .theme-toggle { display: none; }
193:             .card { break-inside: avoid; }
194:         }
195:     </style>
196: </head>
197: <body>
198:     <button class="theme-toggle" onclick="toggleTheme()">Toggle Theme</button>
199: 
200:     <div class="container">
201:         <header>
202:             <div>
203:                 <h1>NFTBan Statistics Report</h1>
204:                 <p class="meta">
205:                     <strong>Server:</strong> <span id="hostname">-</span> |
206:                     <strong>Period:</strong> <span id="period">-</span> |
207:                     <strong>Generated:</strong> <span id="generated">-</span>
208:                 </p>
209:             </div>
210:         </header>
211: 
212:         <!-- KPI Cards -->
213:         <section>
214:             <h2 style="margin-bottom: 16px;">Key Metrics</h2>
215:             <div class="grid grid-4" id="kpi-grid"></div>
216:         </section>
217: 
218:         <!-- Alerts Section -->
219:         <section id="alerts-section"></section>
220: 
221:         <!-- Activity Timeline Chart -->
222:         <section>
223:             <div class="card">
224:                 <h2>Ban Activity Timeline</h2>
225:                 <div class="chart-container">
226:                     <canvas id="timeline-chart"></canvas>
227:                 </div>
228:             </div>
229:         </section>
230: 
231:         <!-- Geographic & Source Charts -->
232:         <div class="grid grid-2">
233:             <section class="card">
234:                 <h2>Top Countries</h2>
235:                 <div class="chart-container">
236:                     <canvas id="countries-chart"></canvas>
237:                 </div>
238:             </section>
239: 
240:             <section class="card">
241:                 <h2>Top Ban Sources</h2>
242:                 <div class="chart-container">
243:                     <canvas id="sources-chart"></canvas>
244:                 </div>
245:             </section>
246:         </div>
247: 
248:         <!-- Top Banned IPs Table -->
249:         <section>
250:             <div class="card">
251:                 <h2>Top Banned IPs</h2>
252:                 <table id="top-ips-table">
253:                     <thead>
254:                         <tr>
255:                             <th>#</th>
256:                             <th>IP Address</th>
257:                             <th>Country</th>
258:                             <th>Ban Count</th>
259:                             <th>Source</th>
260:                             <th>Last Seen</th>
261:                         </tr>
262:                     </thead>
263:                     <tbody id="top-ips-body"></tbody>
264:                 </table>
265:             </div>
266:         </section>
267: 
268:         <!-- Recommendations -->
269:         <section id="recommendations-section"></section>
270:     </div>
271: 
272:     <footer>
273:         <p>Generated by <strong>NFTBan v{NFTBAN_VERSION}</strong> |
274:         <a href="https://nftban.com" style="color: var(--accent);">nftban.com</a></p>
275:         <p style="margin-top: 8px;">Report ID: <span id="report-id">-</span></p>
276:     </footer>
277: 
278:     <script>
279:         // Data will be injected here by bash script
280:         window.__NFTBAN_DATA__ = {
281:             // Placeholder - will be replaced
282:         };
283: 
284:         // Theme toggle
285:         function toggleTheme() {
286:             const current = document.documentElement.getAttribute('data-theme');
287:             const newTheme = current === 'light' ? 'dark' : 'light';
288:             document.documentElement.setAttribute('data-theme', newTheme);
289:             localStorage.setItem('nftban-theme', newTheme);
290: 
291:             // Update charts for new theme
292:             renderCharts();
293:         }
294: 
295:         // Load saved theme
296:         const savedTheme = localStorage.getItem('nftban-theme') || 'dark';
297:         document.documentElement.setAttribute('data-theme', savedTheme);
298: 
299:         // Render dashboard
300:         function renderDashboard() {
301:             const data = window.__NFTBAN_DATA__;
302: 
303:             if (!data || !data.summary) {
304:                 console.error('No data available');
305:                 return;
306:             }
307: 
308:             // Set metadata
309:             document.getElementById('hostname').textContent = data.report?.hostname || '-';
310:             document.getElementById('period').textContent =
311:                 `${data.report?.period?.since || '-'} to ${data.report?.period?.until || '-'}`;
312:             document.getElementById('generated').textContent = data.report?.generated_at || '-';
313:             document.getElementById('report-id').textContent =
314:                 data.report?.generated_at?.replace(/[^0-9]/g, '') || '-';
315: 
316:             // Render KPIs
317:             renderKPIs(data.summary);
318: 
319:             // Render alerts
320:             renderAlerts(data.alerts || []);
321: 
322:             // Render charts
323:             renderCharts();
324: 
325:             // Render top IPs table
326:             renderTopIPs(data.top_ips || []);
327: 
328:             // Render recommendations
329:             renderRecommendations(data.recommendations || []);
330:         }
331: 
332:         function renderKPIs(summary) {
333:             const kpis = [
334:                 { label: 'Total Bans', value: summary.total_bans || 0 },
335:                 { label: 'Unique IPs', value: summary.unique_ips || 0 },
336:                 { label: 'Active Bans', value: summary.active_bans || 0 },
337:                 { label: 'Whitelist', value: summary.whitelist_total || 0 }
338:             ];
339: 
340:             const grid = document.getElementById('kpi-grid');
341:             grid.innerHTML = kpis.map(kpi => `
342:                 <div class="card kpi-card">
343:                     <div class="kpi-value">${kpi.value.toLocaleString()}</div>
344:                     <div class="kpi-label">${kpi.label}</div>
345:                 </div>
346:             `).join('');
347:         }
348: 
349:         function renderAlerts(alerts) {
350:             const section = document.getElementById('alerts-section');
351: 
352:             if (!alerts || alerts.length === 0) {
353:                 section.innerHTML = `
354:                     <div class="alert alert-success">
355:                         <strong>All Clear!</strong> No threshold alerts triggered.
356:                     </div>
357:                 `;
358:                 return;
359:             }
360: 
361:             section.innerHTML = alerts.map(alert => {
362:                 const severity = alert.severity || 'warning';
363:                 return `
364:                     <div class="alert alert-${severity}">
365:                         <strong>${alert.message}</strong>
366:                         ${alert.timestamp ? `<br><small>Time: ${alert.timestamp}</small>` : ''}
367:                     </div>
368:                 `;
369:             }).join('');
370:         }
371: 
372:         function renderCharts() {
373:             const data = window.__NFTBAN_DATA__;
374:             const isDark = document.documentElement.getAttribute('data-theme') !== 'light';
375: 
376:             const chartColors = {
377:                 text: isDark ? '#e9eef5' : '#111827',
378:                 grid: isDark ? '#223046' : '#e5e7eb',
379:                 primary: '#6aa9ff',
380:                 success: '#10b981',
381:                 warning: '#f59e0b',
382:                 danger: '#ef4444'
383:             };
384: 
385:             // Timeline Chart
386:             if (data.timeline && data.timeline.length > 0) {
387:                 const ctx = document.getElementById('timeline-chart');
388:                 if (window.timelineChart) window.timelineChart.destroy();
389: 
390:                 window.timelineChart = new Chart(ctx, {
391:                     type: 'line',
392:                     data: {
393:                         labels: data.timeline.map(t => t.timestamp),
394:                         datasets: [{
395:                             label: 'Bans',
396:                             data: data.timeline.map(t => t.count),
397:                             borderColor: chartColors.primary,
398:                             backgroundColor: chartColors.primary + '20',
399:                             fill: true,
400:                             tension: 0.4
401:                         }]
402:                     },
403:                     options: {
404:                         responsive: true,
405:                         maintainAspectRatio: false,
406:                         plugins: {
407:                             legend: { display: false }
408:                         },
409:                         scales: {
410:                             x: {
411:                                 ticks: { color: chartColors.text },
412:                                 grid: { color: chartColors.grid }
413:                             },
414:                             y: {
415:                                 ticks: { color: chartColors.text },
416:                                 grid: { color: chartColors.grid },
417:                                 beginAtZero: true
418:                             }
419:                         }
420:                     }
421:                 });
422:             }
423: 
424:             // Countries Pie Chart
425:             if (data.top_countries && data.top_countries.length > 0) {
426:                 const ctx = document.getElementById('countries-chart');
427:                 if (window.countriesChart) window.countriesChart.destroy();
428: 
429:                 window.countriesChart = new Chart(ctx, {
430:                     type: 'doughnut',
431:                     data: {
432:                         labels: data.top_countries.map(c => c.country),
433:                         datasets: [{
434:                             data: data.top_countries.map(c => c.count),
435:                             backgroundColor: [
436:                                 '#6aa9ff', '#10b981', '#f59e0b', '#ef4444',
437:                                 '#8b5cf6', '#ec4899', '#14b8a6', '#f97316'
438:                             ]
439:                         }]
440:                     },
441:                     options: {
442:                         responsive: true,
443:                         maintainAspectRatio: false,
444:                         plugins: {
445:                             legend: {
446:                                 labels: { color: chartColors.text },
447:                                 position: 'bottom'
448:                             }
449:                         }
450:                     }
451:                 });
452:             }
453: 
454:             // Sources Bar Chart
455:             if (data.top_sources && data.top_sources.length > 0) {
456:                 const ctx = document.getElementById('sources-chart');
457:                 if (window.sourcesChart) window.sourcesChart.destroy();
458: 
459:                 window.sourcesChart = new Chart(ctx, {
460:                     type: 'bar',
461:                     data: {
462:                         labels: data.top_sources.map(s => s.name),
463:                         datasets: [{
464:                             label: 'Bans',
465:                             data: data.top_sources.map(s => s.count),
466:                             backgroundColor: chartColors.primary
467:                         }]
468:                     },
469:                     options: {
470:                         responsive: true,
471:                         maintainAspectRatio: false,
472:                         plugins: {
473:                             legend: { display: false }
474:                         },
475:                         scales: {
476:                             x: {
477:                                 ticks: { color: chartColors.text },
478:                                 grid: { display: false }
479:                             },
480:                             y: {
481:                                 ticks: { color: chartColors.text },
482:                                 grid: { color: chartColors.grid },
483:                                 beginAtZero: true
484:                             }
485:                         }
486:                     }
487:                 });
488:             }
489:         }
490: 
491:         function renderTopIPs(topIPs) {
492:             const tbody = document.getElementById('top-ips-body');
493: 
494:             if (!topIPs || topIPs.length === 0) {
495:                 tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;">No data available</td></tr>';
496:                 return;
497:             }
498: 
499:             tbody.innerHTML = topIPs.slice(0, 10).map((ip, index) => `
500:                 <tr>
501:                     <td>${index + 1}</td>
502:                     <td><code>${ip.ip}</code></td>
503:                     <td>${ip.country || '--'}</td>
504:                     <td><strong>${ip.count}</strong></td>
505:                     <td>${ip.source || '-'}</td>
506:                     <td>${ip.last_seen || '-'}</td>
507:                 </tr>
508:             `).join('');
509:         }
510: 
511:         function renderRecommendations(recommendations) {
512:             const section = document.getElementById('recommendations-section');
513: 
514:             if (!recommendations || recommendations.length === 0) {
515:                 return;
516:             }
517: 
518:             section.innerHTML = `
519:                 <div class="card">
520:                     <h2>Recommendations</h2>
521:                     <ul style="list-style: none; padding: 0;">
522:                         ${recommendations.map(rec => `
523:                             <li style="padding: 12px; border-left: 3px solid ${
524:                                 rec.priority === 'high' ? 'var(--danger)' :
525:                                 rec.priority === 'medium' ? 'var(--warning)' : 'var(--success)'
526:                             }; margin-bottom: 8px; background: var(--bg-tertiary);">
527:                                 <strong>${rec.action}:</strong> ${rec.target}<br>
528:                                 <small style="color: var(--text-muted);">${rec.reason}</small>
529:                             </li>
530:                         `).join('')}
531:                     </ul>
532:                 </div>
533:             `;
534:         }
535: 
536:         // Initialize dashboard
537:         if (document.readyState === 'loading') {
538:             document.addEventListener('DOMContentLoaded', renderDashboard);
539:         } else {
540:             renderDashboard();
541:         }
542:     </script>
543: </body>
544: </html>
</file>

<file path="install/systemd/node_exporter.service.d/hardening.conf">
 1: # =============================================================================
 2: # Node Exporter - Security Hardening Configuration
 3: # =============================================================================
 4: # Location: /etc/systemd/system/node_exporter.service.d/hardening.conf
 5: #
 6: # This override adds additional systemd security directives to Node Exporter.
 7: #
 8: # Installation:
 9: #   sudo cp hardening.conf /etc/systemd/system/node_exporter.service.d/
10: #   sudo systemctl daemon-reload
11: #   sudo systemctl restart node_exporter
12: #
13: # Verify hardening:
14: #   systemd-analyze security node_exporter.service
15: # =============================================================================
16: 
17: [Service]
18: # Kernel protections
19: ProtectKernelTunables=yes
20: ProtectKernelModules=yes
21: ProtectKernelLogs=yes
22: ProtectControlGroups=yes
23: 
24: # Capability restrictions
25: CapabilityBoundingSet=CAP_NET_BIND_SERVICE
26: AmbientCapabilities=
27: 
28: # Namespace restrictions
29: RestrictNamespaces=yes
30: RestrictRealtime=yes
31: 
32: # Personality and device restrictions
33: LockPersonality=yes
34: PrivateDevices=yes
35: 
36: # Clock protection
37: ProtectClock=yes
38: 
39: # IPC isolation
40: PrivateIPC=yes
41: 
42: # Address family restrictions (allow IPv4, IPv6, Unix sockets)
43: RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
44: 
45: # System call filtering
46: SystemCallFilter=@system-service
47: SystemCallFilter=~@privileged @resources @obsolete
48: SystemCallErrorNumber=EPERM
49: 
50: # Memory restrictions
51: MemoryDenyWriteExecute=yes
52: RestrictSUIDSGID=yes
53: 
54: # File system restrictions (already in base service, but reinforcing)
55: ReadOnlyPaths=/var/lib/node_exporter/textfile_collector
</file>

<file path="install/systemd/node_exporter.service.d/textfile-collector.conf">
 1: # =============================================================================
 2: # Node Exporter - Textfile Collector Configuration
 3: # =============================================================================
 4: # Location: /etc/systemd/system/node_exporter.service.d/textfile-collector.conf
 5: #
 6: # This override configures Node Exporter to:
 7: # 1. Enable textfile collector for NFTBan metrics
 8: # 2. Bind to localhost only (security)
 9: #
10: # Installation:
11: #   sudo cp textfile-collector.conf /etc/systemd/system/node_exporter.service.d/
12: #   sudo systemctl daemon-reload
13: #   sudo systemctl restart node_exporter
14: # =============================================================================
15: 
16: [Service]
17: # Clear existing ExecStart (required before setting new value)
18: ExecStart=
19: 
20: # Set new ExecStart with textfile collector and localhost binding
21: # Note: Adjust binary path if needed (/usr/bin or /usr/local/bin)
22: ExecStart=/usr/bin/node_exporter \
23:   --web.listen-address=127.0.0.1:9100 \
24:   --collector.textfile.directory=/var/lib/node_exporter/textfile_collector
25: 
26: # Optional: Add additional collectors or disable unwanted ones
27: # --collector.disable-defaults \
28: # --collector.textfile \
29: # --collector.cpu \
30: # --collector.meminfo \
31: # --collector.diskstats
</file>

<file path="install/systemd/nftban-core-geoip.service">
 1: [Unit]
 2: Description=NFTBan Core - GeoIP Database Update
 3: Documentation=https://github.com/itcmsgr/nftban-dev
 4: After=network-online.target nftban-core.service
 5: Requires=nftban-core.service
 6: 
 7: [Service]
 8: Type=oneshot
 9: ExecStart=/usr/local/bin/nftban-core geoip update
10: StandardOutput=journal
11: StandardError=journal
12: SyslogIdentifier=nftban-geoip
13: 
14: # Security hardening
15: NoNewPrivileges=true
16: PrivateTmp=true
17: ProtectSystem=strict
18: ProtectHome=true
19: ReadWritePaths=/var/lib/nftban
20: ProtectKernelTunables=true
21: ProtectKernelModules=true
22: ProtectControlGroups=true
23: RestrictRealtime=true
24: RestrictNamespaces=true
25: LockPersonality=true
26: # IMPORTANT: MemoryDenyWriteExecute is intentionally NOT set for Go services.
27: # It breaks Go runtime on Ubuntu 24.04 (AppArmor + Landlock) and potentially
28: # future SELinux-enforcing distributions. Security is maintained through
29: # other hardening measures. See: docs/architecture/SYSTEMD_GO_HARDENING.md
30: RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
31: SystemCallFilter=@system-service
32: SystemCallErrorNumber=EPERM
33: 
34: # Resource limits
35: CPUQuota=50%
36: MemoryMax=256M
37: TasksMax=10
38: TimeoutStartSec=10min
39: 
40: [Install]
41: WantedBy=multi-user.target
</file>

<file path="install/systemd/nftban-core-geoip.timer">
 1: [Unit]
 2: Description=NFTBan Core - Weekly GeoIP Database Update Timer
 3: Documentation=https://github.com/itcmsgr/nftban-dev
 4: Requires=nftban-core.service
 5: 
 6: [Timer]
 7: # Run weekly on Sundays at 2:00 AM
 8: OnCalendar=weekly
 9: OnCalendar=Sun *-*-* 02:00:00
10: # Also run 30 minutes after boot
11: OnBootSec=30min
12: # Run if missed (e.g., system was off)
13: Persistent=true
14: # Add 0-60 minute random delay to avoid thundering herd
15: RandomizedDelaySec=60min
16: 
17: [Install]
18: WantedBy=timers.target
</file>

<file path="install/systemd/nftban-health-fix.service">
 1: [Unit]
 2: Description=NFTBan Health Fixer (On-Demand, Privileged)
 3: Documentation=man:nftban(8)
 4: After=network.target nftables.service
 5: 
 6: # This service is NOT timer-triggered
 7: # Admin must explicitly run: systemctl start nftban-health-fix.service
 8: 
 9: [Service]
10: Type=oneshot
11: 
12: # Runs as root because fixing permissions/directories requires it
13: # This is intentional - fixes need privileged access
14: User=root
15: 
16: # Fix all detected issues
17: ExecStart=/usr/bin/nftban health fix all
18: 
19: # Logging
20: StandardOutput=journal
21: StandardError=journal
22: SyslogIdentifier=nftban-health-fix
23: 
24: # Security - still apply some hardening
25: PrivateTmp=yes
26: NoNewPrivileges=yes
27: 
28: # Allow writes to system paths for fixes
29: # ProtectSystem is NOT set - we need to fix permissions
30: 
31: [Install]
32: WantedBy=multi-user.target
</file>

<file path="install/systemd/nftban-health.service">
 1: [Unit]
 2: Description=NFTBan Periodic Health Check with Auto-Heal
 3: Documentation=man:nftban(8)
 4: After=network.target nftables.service
 5: 
 6: [Service]
 7: Type=oneshot
 8: 
 9: # Run as root to allow auto-heal fixes
10: User=root
11: 
12: # Check and auto-fix issues
13: # --auto-heal: Automatically fix detected issues
14: # --cache-status: Write health result for banner display
15: ExecStart=/usr/bin/nftban health check --auto-heal --cache-status
16: 

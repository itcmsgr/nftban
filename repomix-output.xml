114:         echo "  Log size:   $trace_size ($trace_lines entries)"
115:     else
116:         echo "  Log size:   (no log file yet)"
117:     fi
118: 
119:     echo ""
120:     echo "Log Level:    $log_level"
121:     echo ""
122: 
123:     # Show orphan check
124:     if [[ -f "$trace_log" ]] && [[ "$trace_enabled" == "true" ]]; then
125:         echo "Recent Trace Activity:"
126:         echo "─────────────────────────────────────────"
127:         local start_count end_count
128:         start_count=$(grep -c '\[START\]' "$trace_log" 2>/dev/null || echo 0)
129:         end_count=$(grep -c '\[END\]' "$trace_log" 2>/dev/null || echo 0)
130:         echo "  START entries: $start_count"
131:         echo "  END entries:   $end_count"
132: 
133:         if [[ $start_count -gt $end_count ]]; then
134:             local diff=$((start_count - end_count))
135:             echo "  ⚠️  Potential orphans: $diff (run 'nftban debug trace orphans' to check)"
136:         else
137:             echo "  ✅ No orphaned traces detected"
138:         fi
139:     fi
140: 
141:     echo ""
142:     echo "Commands:"
143:     echo "  nftban debug enable     Enable debug trace"
144:     echo "  nftban debug disable    Disable debug trace"
145:     echo "  nftban debug trace      View trace log"
146:     echo "  nftban debug logs       View main log"
147: }

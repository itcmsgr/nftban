#
# DEPRECATED since v1.21.3 (2026-03-16)
# ======================================
# This shell-based login monitor is superseded by the Go daemon's built-in
# loginmon module (pkg/loginmon). The daemon module provides:
#   - Integrated scoring system with configurable thresholds
#   - Multi-protocol detection (SSH, FTP, mail, web panels)
#   - Suricata EVE hybrid mode
#   - No double-ban failures (single nftables writer)
#
# Both running simultaneously causes "Failed to ban" errors in the shell
# service because the daemon already banned the IP.
#
# Deprecation plan:
#   v1.21.3: Marked deprecated, postinst warns if both active
#   v1.22.0: Postinst disables this service when daemon loginmon is active
#   v1.23.0: Unit file removed from package
#
# =============================================================================

[Unit]
Description=NFTBan Login Monitor
Documentation=https://nftban.com
After=network.target sshd.service systemd-journald.service
Wants=sshd.service

[Service]
Type=simple

# SECURITY FIX: Run as unprivileged nftban user (not root)
# Reads: /var/log/auth.log, /var/log/secure (via adm group)
# Writes: /var/lib/nftban/login/, /var/log/nftban/
# Firewall bans via IPC to daemon
# See: SYSTEMD-SERVICE-CLASSIFICATION.md
User=nftban
Group=nftban
SupplementaryGroups=adm systemd-journal

ExecStart=/usr/sbin/nftban login run
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10

# =============================================================================
# SECURITY HARDENING (Enhanced after privilege drop)
# =============================================================================

# Core hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

# Minimal filesystem access
ReadWritePaths=/var/log/nftban /var/lib/nftban /var/cache/nftban /run/nftban /run/systemd/journal
ReadOnlyPaths=/etc/nftban /usr/lib/nftban /usr/share/nftban

# Network for IPC socket
RestrictAddressFamilies=AF_UNIX

# Resource limits
MemoryMax=128M
TasksMax=20
CPUQuota=25%

[Install]
WantedBy=multi-user.target

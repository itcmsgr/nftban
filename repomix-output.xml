<file path="cli/lib/nftban/core/nftban_portscan_classic.sh">
  1: #!/bin/bash
  2: # shellcheck disable=SC1083  # Braces in nftables syntax are literal, not bash
  3: # =============================================================================
  4: # NFTBan Portscan Protection - CLASSIC MODE Implementation
  5: # =============================================================================
  6: # Pure nftables-based portscan detection without external IDS.
  7: # Uses nftables logging + kernel log parsing to detect port scans.
  8: #
  9: # File: /usr/lib/nftban/core/nftban_portscan_classic.sh
 10: # =============================================================================
 11: 
 12: # Prevent double sourcing
 13: [[ -n "${_NFTBAN_PORTSCAN_CLASSIC_LOADED:-}" ]] && return 0
 14: declare -g _NFTBAN_PORTSCAN_CLASSIC_LOADED=1
 15: 
 16: # =============================================================================
 17: # CONFIGURATION LOADING
 18: # =============================================================================
 19: 
 20: # Load classic mode configuration
 21: nftban_portscan_classic_load_config() {
 22:     local config_file="${NFTBAN_CONFIG_DIR:-/etc/nftban}/conf.d/portscan/classic.conf"
 23:     local local_config="${config_file%.conf}.conf.local"
 24: 
 25:     # Load base config
 26:     if [[ -f "$config_file" ]]; then
 27:         # shellcheck source=/dev/null
 28:         source "$config_file"
 29:     else
 30:         nftban_log "WARN" "portscan_classic" "Config not found: $config_file"
 31:     fi
 32: 
 33:     # Load local overrides
 34:     if [[ -f "$local_config" ]]; then
 35:         # shellcheck source=/dev/null
 36:         source "$local_config"
 37:     fi
 38: 
 39:     # Set defaults
 40:     : "${PORTSCAN_CLASSIC_LOG_PREFIX:=NFTBAN_PORTSCAN:}"
 41:     : "${PORTSCAN_CLASSIC_LOG_FILE:=/var/log/kern.log}"
 42:     : "${PORTSCAN_CLASSIC_MIN_PORTS:=5}"
 43:     : "${PORTSCAN_CLASSIC_TIME_WINDOW:=60}"
 44:     : "${PORTSCAN_CLASSIC_VERTICAL_PORTS:=10}"
 45:     : "${PORTSCAN_CLASSIC_HORIZONTAL_TARGETS:=5}"
 46:     : "${PORTSCAN_CLASSIC_ACTION:=block}"
 47:     : "${PORTSCAN_CLASSIC_BAN_DEFAULT:=1800}"
 48:     : "${PORTSCAN_CLASSIC_MAX_TRACKED_IPS:=10000}"
 49:     : "${PORTSCAN_CLASSIC_LOG_RATE:=10/second}"
 50:     : "${PORTSCAN_CLASSIC_LOG_BURST:=50}"
 51:     : "${PORTSCAN_CLASSIC_STATE_FILE:=/var/lib/nftban/portscan-state.db}"
 52: 
 53:     return 0

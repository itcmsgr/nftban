221: # ==============================================================================
222: # Helper: Get current backend from config
223: # ==============================================================================
224: _get_metrics_backend() {
225:     # Returns: "prometheus" or "victoriametrics" (defaults to prometheus)
226:     if [[ -f "${NFTBAN_CONFIG_DIR}/nftban.conf" ]]; then
227:         local backend
228:         backend=$(grep "^NFTBAN_METRICS_BACKEND=" "${NFTBAN_CONFIG_DIR}/nftban.conf" 2>/dev/null | cut -d'=' -f2 | tr -d '"' || echo "")
229:         if [[ -n "$backend" ]]; then
230:             echo "$backend"
231:             return
232:         fi
233:     fi
234:     echo "prometheus"  # Default
235: }

415: nftban_geoban_check_binary_soft() {
416:     # Soft check: returns 0 if Go binary exists, 1 if not (no error messages)
417:     # Used to decide between Go and bash mode
418: 
419:     if [[ -n "${GEOIP_BINARY}" ]] && [[ -x "${GEOIP_BINARY}" ]]; then
420:         return 0
421:     fi
422:     return 1
423: }

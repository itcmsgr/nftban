[Unit]
Description=NFTBan Periodic Health Check (Read-Only)
Documentation=man:nftban(8)
After=network.target nftables.service

[Service]
Type=oneshot

# Run as unprivileged nftban user - CHECK ONLY, no fixes
User=nftban
Group=nftban

# Check-only mode: reports issues but cannot fix them
# Fixes require explicit admin action via nftban-health-fix.service
# Uses --cache-status to write health result to /var/cache/nftban/health/
# for banner health indicator display (🟢/🟠/🔴)
ExecStart=/usr/bin/nftban health check --quiet --cache-status

# Exit codes: 0=OK, 1=warnings, 2=errors - all are valid check results
# Only treat as failure if command itself crashes
SuccessExitStatus=0 1 2

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nftban-health

# Security hardening - strict read-only access
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
ReadOnlyPaths=/etc /usr
ReadWritePaths=/var/log/nftban /var/lib/nftban /var/cache/nftban

[Install]
WantedBy=multi-user.target

# =============================================================================
# NFTBan Feed Provider Sample
# =============================================================================
# Copy to: /etc/nftban/feeds.d/<name>.list
# Format: <name>|<url>|<type>|<interval>

# Spamhaus DROP (Don't Route Or Peer) list
spamhaus_drop|https://www.spamhaus.org/drop/drop.txt|ipv4|6h

# Spamhaus EDROP (Extended DROP) list
spamhaus_edrop|https://www.spamhaus.org/drop/edrop.txt|ipv4|6h

# FireHOL Level 1 (most aggressive attackers)
firehol_level1|https://iplists.firehol.org/files/firehol_level1.netset|ipv4|4h

# AbuseCH URLhaus malware URLs
abusech_urlhaus|https://urlhaus.abuse.ch/downloads/text/|url|12h

# TOR Exit Nodes
tor_exit|https://check.torproject.org/exit-addresses|ipv4|1h

# Emerging Threats Compromised IPs
et_compromised|https://rules.emergingthreats.net/blockrules/compromised-ips.txt|ipv4|6h

<file path="scripts/generate-help.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan - Help Generator from Registry
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Generate task-grouped CLI help from commands.registry.yml
  7: #
  8: # Usage: ./scripts/generate-help.sh [--profile operator|auditor]
  9: # Output: Formatted help text for nftban help command
 10: # =============================================================================
 11: 
 12: set -euo pipefail
 13: 
 14: # Source central config for canonical paths (NO HARDCODED FALLBACKS)
 15: # shellcheck source=/etc/nftban/nftban.conf
 16: [[ -f "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf" ]] && source "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf"
 17: 
 18: # Determine registry location (installed vs development)
 19: if [[ -f "${NFTBAN_CONFIG_DIR:-/etc/nftban}/commands.registry.yml" ]]; then
 20:     # Installed location (FHS compliant)
 21:     REGISTRY="${NFTBAN_CONFIG_DIR:-/etc/nftban}/commands.registry.yml"
 22: else
 23:     # Development location (relative to script)
 24:     SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
 25:     PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
 26:     REGISTRY="${PROJECT_ROOT}/commands.registry.yml"
 27: fi
 28: 
 29: # =============================================================================
 30: # CONFIGURATION
 31: # =============================================================================
 32: 
 33: # Reserved for future profile-based filtering
 34: _PROFILE="${2:-operator}"
 35: 
 36: # Task group names and descriptions
 37: declare -A GROUP_NAMES=(
 38:     ["setup_discovery"]="0. Setup & Discovery"
 39:     ["immediate_action"]="1. Immediate Action"
 40:     ["active_protection"]="2. Active Protection"
 41:     ["infrastructure"]="3. Infrastructure"
 42:     ["intelligence_reporting"]="4. Intelligence & Reporting"
 43:     ["developer_sysadmin"]="5. Developer / SysAdmin"
 44: )
 45: 
 46: declare -A GROUP_ICONS=(
 47:     ["setup_discovery"]="🛠️"
 48:     ["immediate_action"]="⚡"
 49:     ["active_protection"]="🧱"
 50:     ["infrastructure"]="⚙️"
 51:     ["intelligence_reporting"]="📊"
 52:     ["developer_sysadmin"]="🧪"
 53: )
 54: 
 55: declare -A GROUP_DESC=(
 56:     ["setup_discovery"]="First-run configuration and system diagnostics"
 57:     ["immediate_action"]="Reactive security - 'Firefighter mode'"
 58:     ["active_protection"]="Proactive hardening - 'Builder mode'"
 59:     ["infrastructure"]="Low-level firewall and policy management"
 60:     ["intelligence_reporting"]="Visibility and observability"
 61:     ["developer_sysadmin"]="Advanced debugging and testing"
 62: )
 63: 
 64: # Risk level colors (for future terminal coloring)
 65: declare -A RISK_ICONS=(
 66:     ["core"]="⚡"
 67:     ["setup"]="🛠️"
 68:     ["advanced"]="⚠️"
 69: )
 70: 
 71: # =============================================================================
 72: # HELPER FUNCTIONS
 73: # =============================================================================
 74: 
 75: check_dependencies() {
 76:     if ! command -v yq &>/dev/null; then
 77:         echo "ERROR: yq is required for YAML parsing" >&2
 78:         echo "Install: pip install yq  OR  brew install yq" >&2
 79:         return 1
 80:     fi
 81: }
 82: 
 83: get_commands_by_category() {
 84:     local category="$1"
 85:     local profile="${2:-operator}"
 86: 
 87:     # Parse registry and filter by category
 88:     yq -r "
 89:         to_entries |
 90:         map(select(.key != \"_metadata\" and .value.category == \"$category\")) |
 91:         map(.key) |
 92:         .[]
 93:     " "$REGISTRY" 2>/dev/null || true
 94: }
 95: 
 96: get_command_info() {
 97:     local command="$1"
 98:     local field="$2"
 99: 
100:     yq -r ".\"$command\".\"$field\" // empty" "$REGISTRY" 2>/dev/null
101: }
102: 
103: should_show_for_profile() {
104:     local command="$1"
105:     local profile="$2"
106: 
107:     local audience
108:     audience=$(yq -r ".\"$command\".audience // []" "$REGISTRY" 2>/dev/null)
109: 
110:     case "$profile" in
111:         operator)
112:             # Operators see everything
113:             return 0
114:             ;;
115:         auditor)
116:             # Auditors see only auditor-allowed commands
117:             if echo "$audience" | grep -q "auditor"; then
118:                 return 0
119:             else
120:                 return 1
121:             fi
122:             ;;
123:         panel)
124:             # Panels see only panel-exposed commands
125:             local panel_expose
126:             panel_expose=$(yq -r ".\"$command\".panel_expose // false" "$REGISTRY" 2>/dev/null)
127:             [[ "$panel_expose" == "true" ]] && return 0 || return 1
128:             ;;
129:         *)
130:             return 0
131:             ;;
132:     esac
133: }
134: 
135: # =============================================================================
136: # HELP OUTPUT GENERATION
137: # =============================================================================
138: 
139: generate_help_header() {
140:     cat <<'EOF'
141: NFTBan - Adaptive Firewall Management
142: ======================================
143: 
144: Usage: nftban <command> [subcommand] [options]
145: 
146: Global Options:
147:   --json        Output in JSON format (where supported)
148:   --dry-run     Preview changes without applying (for mutating commands)
149:   --quiet       Suppress non-essential output
150:   --verbose     Show detailed diagnostic output
151:   --help, -h    Show command-specific help
152: 
153: Quick Examples:
154:   nftban status                    # System overview
155:   nftban ban 1.2.3.4               # Block an IP
156:   nftban health check              # Run diagnostics
157:   nftban feeds update              # Update threat intelligence
158:   nftban firewall reload           # Atomic reload
159: 
160: EOF
161: }
162: 
163: generate_group_section() {
164:     local category="$1"
165:     local profile="$2"
166: 
167:     local group_name="${GROUP_NAMES[$category]}"
168:     local group_icon="${GROUP_ICONS[$category]}"
169:     local group_desc="${GROUP_DESC[$category]}"
170: 
171:     # Get commands for this category
172:     local commands
173:     commands=$(get_commands_by_category "$category" "$profile")
174: 
175:     # Filter by profile
176:     local visible_commands=()
177:     for cmd in $commands; do
178:         if should_show_for_profile "$cmd" "$profile"; then
179:             visible_commands+=("$cmd")
180:         fi
181:     done
182: 
183:     # Skip empty groups
184:     [[ ${#visible_commands[@]} -eq 0 ]] && return 0
185: 
186:     echo ""
187:     echo "$group_icon  $group_name"
188:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
189:     echo "$group_desc"
190:     echo ""
191: 
192:     # Display commands in this group
193:     for cmd in "${visible_commands[@]}"; do
194:         local description
195:         description=$(get_command_info "$cmd" "description")
196: 
197:         local risk
198:         risk=$(get_command_info "$cmd" "risk")
199:         local risk_icon="${RISK_ICONS[$risk]:-}"
200: 
201:         # Format: command (icon) - description
202:         printf "  %-20s %s  %s\n" "$cmd" "$risk_icon" "$description"
203:     done
204: }
205: 
206: generate_help_footer() {
207:     local profile="$1"
208: 
209:     cat <<EOF
210: 
211: ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
212: Risk Levels:
213:   ⚡ Core      - Essential, safe operations
214:   🛠️  Setup     - One-time configuration
215:   ⚠️  Advanced  - Use with caution, may affect system state
216: 
217: For detailed command help:
218:   nftban <command> help
219: 
220: Documentation:
221:   Wiki:    https://github.com/itcmsgr/nftban/wiki
222:   Issues:  https://github.com/itcmsgr/nftban/issues
223: 
224: Profile: $profile
225: ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
226: EOF
227: }
228: 
229: # =============================================================================
230: # MAIN
231: # =============================================================================
232: 
233: main() {
234:     # Parse arguments
235:     local profile="operator"
236: 
237:     while [[ $# -gt 0 ]]; do
238:         case "$1" in
239:             --profile)
240:                 profile="$2"
241:                 shift 2
242:                 ;;
243:             --help|-h)
244:                 echo "Usage: $0 [--profile operator|auditor|panel]"
245:                 echo "Generate help output from commands.registry.yml"
246:                 exit 0
247:                 ;;
248:             *)
249:                 echo "Unknown option: $1" >&2
250:                 exit 1
251:                 ;;
252:         esac
253:     done
254: 
255:     # Validate profile
256:     case "$profile" in
257:         operator|auditor|panel) ;;
258:         *)
259:             echo "ERROR: Invalid profile: $profile" >&2
260:             echo "Valid profiles: operator, auditor, panel" >&2
261:             exit 1
262:             ;;
263:     esac
264: 
265:     # Check dependencies
266:     check_dependencies || exit 1
267: 
268:     # Check registry exists
269:     if [[ ! -f "$REGISTRY" ]]; then
270:         echo "ERROR: Registry not found: $REGISTRY" >&2
271:         exit 1
272:     fi
273: 
274:     # Generate help output
275:     generate_help_header
276: 
277:     # Generate each task group
278:     generate_group_section "setup_discovery" "$profile"
279:     generate_group_section "immediate_action" "$profile"
280:     generate_group_section "active_protection" "$profile"
281:     generate_group_section "infrastructure" "$profile"
282:     generate_group_section "intelligence_reporting" "$profile"
283: 
284:     # Developer/SysAdmin group only for operator profile
285:     if [[ "$profile" == "operator" ]]; then
286:         generate_group_section "developer_sysadmin" "$profile"
287:     fi
288: 
289:     generate_help_footer "$profile"
290: }
291: 
292: main "$@"

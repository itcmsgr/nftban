 76: 
 77: collect_geoban_countries() {
 78:     # Count blocked countries from nftables sets
 79:     local blocked_countries=0
 80: 
 81:     if nft list sets 2>/dev/null | grep -q 'geoban'; then
 82:         blocked_countries=$(nft list sets 2>/dev/null | grep -c 'set.*geoban.*country' || echo 0)
 83:     fi
 84: 
 85:     write_metric "nftban_geoban_countries_blocked" "gauge" \
 86:         "Number of countries currently blocked" " ${blocked_countries}"
 87: }
 88: 
 89: collect_geoban_ips_by_country() {
 90:     # Count IPs blocked per country
 91:     # This requires parsing nftables sets
 92: 
 93:     local metrics=()
 94: 
 95:     # Try to get geoban sets
 96:     if nft list sets 2>/dev/null | grep -q 'geoban'; then
 97:         while IFS= read -r set_name; do
 98:             # Extract country code from set name (e.g., geoban_cn, geoban_ru)
 99:             local country
100:             country=$(echo "$set_name" | grep -oP 'geoban_\K[a-z]{2}' || echo "unknown")
101: 
102:             # Count elements in set
103:             local ip_count=0
104:             if nft list set inet filter "$set_name" 2>/dev/null | grep -q 'elements'; then
105:                 ip_count=$(nft list set inet filter "$set_name" 2>/dev/null | \
106:                     { grep -oP 'elements = \{ \K[^}]*' || true; } | tr ',' '\n' | wc -l || echo 0)
107:             fi
108: 
109:             if [[ -n "$country" && "$country" != "unknown" ]]; then
110:                 metrics+=("{country=\"${country}\"} ${ip_count}")
111:             fi
112:         done < <(nft list sets 2>/dev/null | grep 'set geoban_' | awk '{print $2}')
113:     fi
114: 
115:     if [[ ${#metrics[@]} -gt 0 ]]; then
116:         write_metric "nftban_geoban_ips_blocked" "gauge" \
117:             "Number of IP addresses blocked per country" "${metrics[@]}"
118:     else
119:         write_metric "nftban_geoban_ips_blocked" "gauge" \
120:             "Number of IP addresses blocked per country" "{country=\"none\"} 0"
121:     fi
122: }
123: 
124: collect_geoban_hit_stats() {
125:     # Collect hit statistics if counters exist
126:     # This is a placeholder - actual implementation depends on nftables rules with counters
127: 
128:     local total_hits=0
129: 
130:     # Try to get total geoban hits from nftables counters
131:     if nft list ruleset 2>/dev/null | grep -q 'geoban.*counter'; then
132:         total_hits=$(nft list ruleset 2>/dev/null | \
133:             grep 'geoban.*counter' | grep -oP 'packets \K\d+' | \
134:             awk '{sum+=$1} END {print sum}' || echo 0)
135:     fi
136: 
137:     write_metric "nftban_geoban_hits_total" "counter" \
138:         "Total connection attempts blocked by geo-blocking" " ${total_hits}"
139: }
140: 
141: # ====================================================================
142: # Main Collection Function
143: # ====================================================================
144: 
145: main() {
146:     local start_time
147:     start_time=$(date +%s.%N)
148: 
149:     # Initialize output file
150:     : > "$TMP_FILE"
151: 
152:     # Collect all metrics
153:     collect_geoban_countries
154:     collect_geoban_ips_by_country
155:     collect_geoban_hit_stats
156: 
157:     # Collection duration
158:     local end_time
159:     end_time=$(date +%s.%N)
160:     local duration
161:     duration=$(echo "$end_time - $start_time" | bc)
162: 
163:     write_metric "nftban_geoban_exporter_duration_seconds" "gauge" \
164:         "Time taken to collect geo-blocking metrics" " ${duration}"
165: 
166:     # Last update timestamp
167:     write_metric "nftban_geoban_exporter_last_update" "gauge" \
168:         "Unix timestamp of last successful collection" " $(date +%s)"
169: 
170:     # Atomic move
171:     mv "$TMP_FILE" "$OUTPUT_FILE"
172: 
173:     # Set permissions
174:     chmod 644 "$OUTPUT_FILE"
175: }
176: 

620:     echo "  login-monitor:    $login_status"
621: 
622:     echo ""
623:     echo "Timers:"
624:     _nftban_timers_status
625: 
626:     echo ""
627: }
628: 
629: # =============================================================================
630: # TIMER CONTROL HELPER
631: # =============================================================================
632: 
633: _nftban_timers_control() {
634:     local action="$1"
635: 
636:     local timers=(
637:         "nftban.timer"
638:         "nftban-feeds.timer"
639:         "nftban-geoip-update.timer"
640:         "nftban-maintenance.timer"
641:         "nftban-stats.timer"
642:     )
643: 
644:     for timer in "${timers[@]}"; do
645:         if systemctl list-unit-files "$timer" &>/dev/null 2>&1; then
646:             case "$action" in
647:                 enable)
648:                     systemctl enable "$timer" 2>/dev/null && systemctl start "$timer" 2>/dev/null && echo "  Enabled: $timer"
649:                     ;;
650:                 disable)
651:                     systemctl stop "$timer" 2>/dev/null && systemctl disable "$timer" 2>/dev/null && echo "  Disabled: $timer"
652:                     ;;
653:                 restart)
654:                     systemctl restart "$timer" 2>/dev/null && echo "  Restarted: $timer"
655:                     ;;
656:             esac
657:         fi
658:     done
659: }
660: 
661: _nftban_timers_status() {
662:     local timers=(
663:         "nftban.timer"
664:         "nftban-feeds.timer"
665:         "nftban-geoip-update.timer"
666:         "nftban-maintenance.timer"
667:     )
668: 
669:     for timer in "${timers[@]}"; do
670:         if systemctl list-unit-files "$timer" &>/dev/null 2>&1; then
671:             local status
672:             status=$(systemctl is-active "$timer" 2>/dev/null || echo "inactive")
673:             local enabled
674:             enabled=$(systemctl is-enabled "$timer" 2>/dev/null || echo "disabled")
675:             printf "  %-30s %s (%s)\n" "$timer" "$status" "$enabled"
676:         fi
677:     done
678: }
679: 
680: # =============================================================================
681: # COMMAND HANDLER
682: # =============================================================================
683: 
684: nftban_cmd_system() {
685:     local action="${1:-}"
686: 
687:     # Show banner if available
688:     if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_output.sh" ]]; then
689:         # shellcheck source=/dev/null
690:         source "${NFTBAN_LIB_DIR}/core/nftban_output.sh"
691:         if declare -f nftban_banner &>/dev/null; then
692:             nftban_banner 2>/dev/null || true
693:         fi
694:     fi
695: 
696:     case "$action" in
697:         enable)
698:             shift
699:             nftban_system_enable "$@"
700:             ;;
701:         disable)
702:             shift
703:             nftban_system_disable "$@"
704:             ;;
705:         restart)
706:             shift
707:             nftban_system_restart "$@"
708:             ;;
709:         status|services)
710:             shift
711:             nftban_system_status "$@"
712:             ;;
713:         help|--help|-h)
714:             _nftban_system_help
715:             ;;
716:         *)
717:             _nftban_system_help
718:             return 1
719:             ;;
720:     esac
721: }
722: 
723: _nftban_system_help() {
724:     cat <<'EOF'
725: NFTBan Service Control
726: 
727: USAGE:
728:     nftban enable [TARGET]     Enable NFTBan services
729:     nftban disable [TARGET]    Disable NFTBan services
730:     nftban restart [TARGET]    Restart NFTBan services
731:     nftban services status     Show service status
732: 
733: TARGETS:
734:     all       - All NFTBan services (default for enable/restart)
735:     nftables  - nftables firewall management
736:     suricata  - Suricata IDS
737:     login     - Login monitoring
738:     timers    - Maintenance timers
739: 
740: EXAMPLES:
741:     # Enable everything
742:     sudo nftban enable
743: 
744:     # Disable Suricata only
745:     sudo nftban disable suricata
746: 
747:     # Restart all services
748:     sudo nftban restart
749: 
750:     # Check status
751:     nftban services status
752: 
753:     # EMERGENCY: Disable all NFTBan
754:     sudo nftban disable all
755: 
756: CONFIGURATION:
757:     ${NFTBAN_CONFIG_DIR}/conf.d/services.conf        - Service settings
758:     ${NFTBAN_CONFIG_DIR}/conf.d/services.conf.local  - User overrides
759: 
760:     Edit services.conf.local instead of services.conf to preserve
761:     settings across package updates.
762: 
763: KERNEL EMERGENCY DISABLE:
764:     Add 'nftban=disabled' to kernel command line at boot to
765:     completely bypass NFTBan (useful for recovery).
766: 
767:     At GRUB menu:
768:     1. Press 'e' to edit boot entry
769:     2. Add 'nftban=disabled' to kernel line
770:     3. Press Ctrl+X to boot
771: 
772: See also: nftban login help
773: EOF
774: }
775: 
776: # =============================================================================
777: # EXPORTS

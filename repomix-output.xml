465:         diagram.innerHTML = '<span style="color:#ffaa00;">Please check current ruleset first</span>';
466:         return;
467:     }
468: 
469:     // Parse and display hierarchy
470:     let html = 'nftables Framework\n';
471:     html += '│\n';
472: 
473:     const tableMatches = currentRuleset.match(/table\s+(inet|ip|ip6)\s+(\w+)\s*\{([^}]*)\}/gs);
474: 
475:     if (tableMatches) {
476:         tableMatches.forEach((tableBlock, idx) => {
477:             const tableMatch = tableBlock.match(/table\s+(inet|ip|ip6)\s+(\w+)/);

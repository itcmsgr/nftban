package pages

import (
	"fmt"
	"strconv"
	"github.com/itcmsgr/nftban/internal/ui"
)

// Whitelist renders the whitelist management page
templ Whitelist(data ui.WhitelistData) {
	@ui.LayoutWithNav("Whitelist", "whitelist") {
		<!-- Page Header with Stats -->
		<div class="page-header">
			<h1>Whitelist Management</h1>
			<div class="header-stats">
				<span class="stat-badge safe">{ strconv.Itoa(data.TotalEntries) } Total</span>
				<span class="stat-badge">IPv4: { strconv.Itoa(data.IPv4Count) }</span>
				<span class="stat-badge">IPv6: { strconv.Itoa(data.IPv6Count) }</span>
				<span class="stat-badge info">Networks: { strconv.Itoa(data.NetworkCount) }</span>
			</div>
		</div>

		<!-- Toolbar -->
		<div class="toolbar">
			<div class="search-group">
				<input
					type="text"
					class="search-input"
					placeholder="Search IP or comment..."
					name="search"
					hx-get="/ui/frag/whitelist-table"
					hx-trigger="keyup changed delay:300ms"
					hx-target="#whitelist-table"
				/>
			</div>
			<div class="action-group">
				<button class="btn btn-primary" onclick="showWhitelistModal()">
					+ Add to Whitelist
				</button>
			</div>
		</div>

		<!-- Main Content Grid -->
		<div class="content-grid">
			<!-- Whitelist Table -->
			<div class="card main-card">
				<div class="card-header">
					<span class="card-title">Whitelisted IPs</span>
				</div>
				<div id="whitelist-table" hx-get="/ui/frag/whitelist-table" hx-trigger="every 30s" hx-swap="innerHTML">
					@WhitelistTableFragment(data)
				</div>
			</div>

			<!-- Sources Sidebar -->
			<div class="card sidebar-card">
				<div class="card-header">
					<span class="card-title">Whitelist Sources</span>
				</div>
				<div class="sources-list">
					for _, src := range data.Sources {
						<div class="source-item">
							<div class="source-name">{ src.Name }</div>
							<div class="source-meta">
								<span class="source-count">{ strconv.Itoa(src.EntryCount) } entries</span>
								if src.Editable {
									<span class="source-editable">editable</span>
								} else {
									<span class="source-readonly">system</span>
								}
							</div>
						</div>
					}
					if len(data.Sources) == 0 {
						<div class="empty-state">No whitelist files found</div>
					}
				</div>
			</div>
		</div>

		<!-- Add Whitelist Modal -->
		<div id="whitelist-modal" class="modal" style="display: none;">
			<div class="modal-content">
				<div class="modal-header">
					<h3>Add to Whitelist</h3>
					<button class="modal-close" onclick="hideWhitelistModal()">&times;</button>
				</div>
				<form hx-post="/api/v1/whitelist/add" hx-target="#whitelist-result" hx-swap="innerHTML">
					<div class="form-group">
						<label>IP Address or Network</label>
						<input type="text" name="ip" class="form-input" placeholder="192.168.1.100 or 10.0.0.0/8" required/>
						<small class="form-hint">Single IP, CIDR notation (10.0.0.0/8), or IPv6 address</small>
					</div>
					<div class="form-group">
						<label>Comment</label>
						<input type="text" name="comment" class="form-input" placeholder="Office network"/>
					</div>
					<div id="whitelist-result"></div>
					<div class="modal-actions">
						<button type="button" class="btn btn-secondary" onclick="hideWhitelistModal()">Cancel</button>
						<button type="submit" class="btn btn-primary">Add to Whitelist</button>
					</div>
				</form>
			</div>
		</div>

		<script>
			function showWhitelistModal() {
				document.getElementById('whitelist-modal').style.display = 'flex';
			}
			function hideWhitelistModal() {
				document.getElementById('whitelist-modal').style.display = 'none';
			}
		</script>

		<style>
			.content-grid {
				display: grid;
				grid-template-columns: 1fr 300px;
				gap: 1.5rem;
			}
			@media (max-width: 1024px) {
				.content-grid {
					grid-template-columns: 1fr;
				}
			}
			.sources-list {
				padding: 0.5rem;
			}
			.source-item {
				padding: 0.75rem;
				border-bottom: 1px solid var(--border-color);
			}
			.source-item:last-child {
				border-bottom: none;
			}
			.source-name {
				font-weight: 500;
				margin-bottom: 0.25rem;
			}
			.source-meta {
				font-size: 0.85rem;
				color: var(--text-muted);
				display: flex;
				gap: 0.5rem;
			}
			.source-editable {
				color: var(--accent-green);
			}
			.source-readonly {
				color: var(--text-muted);
			}
		</style>
	}
}

// WhitelistTableFragment renders just the table (for HTMX updates)
templ WhitelistTableFragment(data ui.WhitelistData) {
	<table class="data-table">
		<thead>
			<tr>
				<th>IP / Network</th>
				<th>Type</th>
				<th>Comment</th>
				<th>Source</th>
				<th>Added</th>
				<th>Added By</th>
				<th>Action</th>
			</tr>
		</thead>
		<tbody>
			if len(data.Entries) == 0 {
				<tr>
					<td colspan="7" class="empty-state">No whitelist entries found</td>
				</tr>
			} else {
				for _, entry := range data.Entries {
					<tr>
						<td class="ip-cell">
							<code>{ entry.IP }</code>
						</td>
						<td>
							<span class={ "type-badge", getWhitelistTypeClass(entry.Type) }>{ entry.Type }</span>
						</td>
						<td class="comment-cell" title={ entry.Comment }>
							if entry.Comment != "" {
								{ truncate(entry.Comment, 40) }
							} else {
								<span class="text-muted">--</span>
							}
						</td>
						<td class="source-cell">
							<span class="source-badge">{ entry.Source }</span>
						</td>
						<td class="time-cell">
							if entry.AddedAt != "" {
								{ entry.AddedAt }
							} else {
								<span class="text-muted">--</span>
							}
						</td>
						<td>
							if entry.AddedBy != "" {
								<span class="source-badge">{ entry.AddedBy }</span>
							} else {
								<span class="text-muted">--</span>
							}
						</td>
						<td>
							<button
								class="btn btn-sm btn-warning"
								hx-post="/api/v1/whitelist/remove"
								hx-vals={ fmt.Sprintf(`{"ip": "%s"}`, entry.IP) }
								hx-confirm={ fmt.Sprintf("Remove %s from whitelist?", entry.IP) }
								hx-target="#whitelist-table"
								hx-swap="innerHTML"
							>
								Remove
							</button>
						</td>
					</tr>
				}
			}
		</tbody>
	</table>
}

// Helper function for whitelist type styling
func getWhitelistTypeClass(entryType string) string {
	switch entryType {
	case "ip":
		return "info"
	case "network":
		return "secondary"
	case "range":
		return "warning"
	default:
		return ""
	}
}

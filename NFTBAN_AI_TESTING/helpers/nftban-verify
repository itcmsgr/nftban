#!/usr/bin/env bash
# SPDX-License-Identifier: MPL-2.0
# nftban-verify - Package integrity verification (RPM/DEB)
# Part of NFTBan v0.30 - Self-healing monitoring system

set -euo pipefail

# RPM verification
if command -v rpm >/dev/null 2>&1; then
    TMP=$(mktemp)
    trap 'rm -f "$TMP"' EXIT

    # Run rpm -Va (skip time/size/deps, focus on tampering)
    rpm -Va --nomtime --nosize --nodeps 2>/dev/null | tee "$TMP" >/dev/null || true

    # Parse output (skip config files marked with 'c')
    awk 'BEGIN{printf("{\"tampered\":[")} {
        f=$0
        pkg=$NF
        sub(/^.*\s+/, "", pkg)
        flags=substr($0,1,8)

        # Skip config-only changes
        if (index($0," c ")>0) next

        gsub(/"/,"\\\"",f)
        printf("%s{\"pkg\":\"%s\",\"flags\":\"%s\",\"line\":\"%s\"}",
               NR==1?"":",", pkg, flags, f)
    } END{print("]}")}' "$TMP"

    exit 0
fi

# DEB verification
if command -v dpkg >/dev/null 2>&1; then
    TMP=$(mktemp)
    trap 'rm -f "$TMP"' EXIT

    dpkg -V 2>/dev/null | tee "$TMP" >/dev/null || true

    awk 'BEGIN{printf("{\"tampered\":[")} {
        f=$0
        pkg=$2
        flags=$1

        gsub(/"/,"\\\"",f)
        printf("%s{\"pkg\":\"%s\",\"flags\":\"%s\",\"line\":\"%s\"}",
               NR==1?"":",", pkg, flags, f)
    } END{print("]}")}' "$TMP"

    exit 0
fi

# No package manager found
echo '{"tampered":[]}'

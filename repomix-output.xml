<file path="cmd/nftban-core/cmd_unban.go">
  1: package main
  2: 
  3: import (
  4: 	"fmt"
  5: 	"strings"
  6: 
  7: 	"github.com/google/nftables"
  8: 	"github.com/itcmsgr/nftban/pkg/banlog"
  9: 	"github.com/itcmsgr/nftban/pkg/blacklist"
 10: 	"github.com/itcmsgr/nftban/pkg/geoip"
 11: 	"github.com/itcmsgr/nftban/pkg/nftbanconf"
 12: 	"github.com/itcmsgr/nftban/pkg/sync"
 13: 	"github.com/itcmsgr/nftban/pkg/version"
 14: )
 15: 
 16: // getUnbanConfigDir returns the config directory from passed config
 17: func getUnbanConfigDir(cfg *nftbanconf.Config) string {
 18: 	return cfg.ConfigDir
 19: }
 20: 
 21: func cmdUnban(ipStr string, cfg *nftbanconf.Config) error {
 22: 	// Check for privilege (root OR CAP_NET_ADMIN capability)
 23: 	if err := checkPrivilege(); err != nil {
 24: 		return err
 25: 	}
 26: 
 27: 	fmt.Printf("%s: %s\n", version.BannerWithEmoji("🛡️", "Unban IP"), ipStr)
 28: 	fmt.Println(strings.Repeat("=", 70))
 29: 	fmt.Println()
 30: 
 31: 	// Validate IP
 32: 	fmt.Println("Step 1: Validating IP address...")
 33: 	normalizedIP, isIPv4, err := blacklist.ValidateIP(ipStr)
 34: 	if err != nil {
 35: 		return fmt.Errorf("invalid IP: %w", err)
 36: 	}
 37: 	ipType := "IPv6"
 38: 	if isIPv4 {
 39: 		ipType = "IPv4"
 40: 	}
 41: 	fmt.Printf("  ✅ Valid %s address: %s\n", ipType, normalizedIP)
 42: 	fmt.Println()
 43: 
 44: 	// Check if currently banned (in files OR in nftables)
 45: 	fmt.Println("Step 2: Checking if IP is banned...")
 46: 	configDir := getUnbanConfigDir(cfg)
 47: 	blacklistIPv4, blacklistIPv6, err := blacklist.LoadAllBlacklists(configDir)
 48: 	if err != nil {
 49: 		return fmt.Errorf("failed to load blacklists: %w", err)
 50: 	}
 51: 
 52: 	isBannedInFile := false
 53: 	if isIPv4 {
 54: 		isBannedInFile = blacklistIPv4[normalizedIP]
 55: 	} else {
 56: 		isBannedInFile = blacklistIPv6[normalizedIP]
 57: 	}
 58: 
 59: 	// Also check nftables directly (handles orphan entries not in files)
 60: 	nft, err := sync.NewNFTManager()
 61: 	if err != nil {
 62: 		return fmt.Errorf("failed to create nftables manager: %w", err)
 63: 	}
 64: 	defer nft.Close()
 65: 
 66: 	var table *nftables.Table
 67: 	var setName string
 68: 	if isIPv4 {
 69: 		table, err = nft.GetOrCreateTable(nftables.TableFamilyIPv4)
 70: 		setName = "blacklist_ipv4"
 71: 	} else {
 72: 		table, err = nft.GetOrCreateTable(nftables.TableFamilyIPv6)
 73: 		setName = "blacklist_ipv6"
 74: 	}
 75: 	if err != nil {
 76: 		return fmt.Errorf("failed to get table: %w", err)
 77: 	}
 78: 
 79: 	blacklistSet, err := nft.GetOrCreateSet(table, setName, isIPv4)
 80: 	if err != nil {
 81: 		return fmt.Errorf("failed to get blacklist set: %w", err)
 82: 	}
 83: 
 84: 	// Check if IP is in nftables set
 85: 	isBannedInNFT := false
 86: 	currentIPs, err := nft.GetSetElements(blacklistSet)
 87: 	if err == nil {
 88: 		for _, ip := range currentIPs {
 89: 			if ip == normalizedIP {
 90: 				isBannedInNFT = true
 91: 				break
 92: 			}
 93: 		}
 94: 	}
 95: 
 96: 	if !isBannedInFile && !isBannedInNFT {
 97: 		fmt.Printf("  ⚠️  IP %s is not currently banned\n", normalizedIP)
 98: 		fmt.Println()
 99: 		fmt.Println("Nothing to do - IP is already not banned.")
100: 		return nil
101: 	}
102: 
103: 	if isBannedInFile {
104: 		fmt.Printf("  ✅ IP is in blacklist files\n")
105: 	}
106: 	if isBannedInNFT {
107: 		fmt.Printf("  ✅ IP is in nftables set\n")
108: 	}
109: 	fmt.Println()
110: 
111: 	// Remove from blacklist file (only if it's in files)
112: 	fmt.Println("Step 3: Removing from blacklist...")
113: 	if isBannedInFile {
114: 		if err := blacklist.RemoveIP(configDir, normalizedIP); err != nil {
115: 			return fmt.Errorf("failed to remove from blacklist: %w", err)
116: 		}
117: 		fmt.Printf("  ✅ Removed from blacklist.d/*.conf\n")
118: 	} else {
119: 		fmt.Printf("  ⚠️  IP not in blacklist files (orphan in nftables)\n")
120: 	}
121: 	fmt.Println()
122: 
123: 	// Remove directly from nftables (more efficient than full sync for single IP)
124: 	fmt.Println("Step 4: Removing from nftables...")
125: 
126: 	// Use range-aware delete for IPv4 interval sets (handles auto-merge ranges)
127: 	// For IPv6 or non-interval sets, fall back to simple delete
128: 	if isIPv4 {
129: 		// IPv4 uses interval sets with auto-merge - need range-aware delete
130: 		if err := nft.DeleteFromIntervalSetCLI(blacklistSet, normalizedIP); err != nil {
131: 			// Check if it's just "not found" vs a real error
132: 			if strings.Contains(err.Error(), "not found in set") {
133: 				fmt.Printf("  ⚠️  IP %s was not in nftables set\n", normalizedIP)
134: 			} else {
135: 				fmt.Printf("  ⚠️  Could not delete from nftables: %v\n", err)
136: 			}
137: 		} else {
138: 			fmt.Printf("  ✅ Removed %s from nftables (range-aware)\n", normalizedIP)
139: 		}
140: 	} else {
141: 		// IPv6 - use simple delete (or extend to range-aware if needed)
142: 		if err := nft.DeleteSetElements(blacklistSet, []string{normalizedIP}); err != nil {
143: 			fmt.Printf("  ⚠️  Could not delete from nftables: %v\n", err)
144: 		} else {
145: 			fmt.Printf("  ✅ Removed %s from nftables\n", normalizedIP)
146: 		}
147: 	}
148: 	fmt.Println()
149: 
150: 	// Log the unban action
151: 	fmt.Println("Step 5: Logging unban...")
152: 	country, _ := geoip.LookupIP(normalizedIP)
153: 	if country == "" {
154: 		country = "UNK"
155: 	}
156: 	if err := banlog.LogUnban(normalizedIP, banlog.SourceManual, country); err != nil {
157: 		fmt.Printf("  ⚠️  Failed to write to ban.log: %v\n", err)
158: 	} else {
159: 		fmt.Printf("  ✅ Unban logged to /var/log/nftban/ban.log\n")
160: 	}
161: 	fmt.Println()
162: 
163: 	// Success!
164: 	fmt.Println(strings.Repeat("=", 70))
165: 	fmt.Printf("✅ IP %s has been UNBANNED!\n", normalizedIP)
166: 	fmt.Println()
167: 	fmt.Println("The IP is no longer blocked by the firewall.")
168: 	fmt.Println()
169: 
170: 	return nil
171: }

  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - List Command
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: List banned IPs, whitelisted IPs, and other nftables sets
  7: #
  8: # meta:name=cmd_list
  9: # meta:type=cli
 10: # meta:header=List Command
 11: # meta:version=1.0.0
 12: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 13: # meta:homepage=https://nftban.com
 14: #
 15: # **Description & Purpose**
 16: # meta:description=List banned IPs, whitelist, and other nftables sets
 17: # meta:input=Optional: set type (banned, whitelist, all)
 18: # meta:output=List of IPs with metadata
 19: #
 20: # **Inventory & Requirements**
 21: # meta:depends=bash,nft
 22: #
 23: # meta:created_date=2025-11-24
 24: # =============================================================================
 25: 
 26: [[ -z "${NFTBAN_LIB_DIR:-}" ]] && readonly NFTBAN_LIB_DIR="/usr/lib/nftban"
 27: 
 28: # Load strict mode library
 29: # shellcheck source=/usr/lib/nftban/lib/strict.sh
 30: if [[ -f "${NFTBAN_LIB_DIR}/lib/strict.sh" ]]; then
 31:     source "${NFTBAN_LIB_DIR}/lib/strict.sh"
 32: else
 33:     set -Eeuo pipefail
 34: fi
 35: 
 36: # Load version library
 37: # shellcheck source=/usr/lib/nftban/lib/version.sh
 38: if [[ -f "${NFTBAN_LIB_DIR}/lib/version.sh" ]]; then
 39:     source "${NFTBAN_LIB_DIR}/lib/version.sh"
 40: fi
 41: 
 42: # Load NFT schema (single source of truth for table/set names)
 43: # shellcheck source=/usr/lib/nftban/lib/nft_schema.sh
 44: if [[ -f "${NFTBAN_LIB_DIR}/lib/nft_schema.sh" ]]; then
 45:     source "${NFTBAN_LIB_DIR}/lib/nft_schema.sh"
 46: fi
 47: 
 48: # Load JSON helper
 49: # shellcheck source=/usr/lib/nftban/helpers/json_output.sh
 50: if [[ -f "${NFTBAN_LIB_DIR}/helpers/json_output.sh" ]]; then
 51:     source "${NFTBAN_LIB_DIR}/helpers/json_output.sh"
 52: fi
 53: 
 54: # Prevent double-loading
 55: [[ -n "${CMD_LIST_LOADED:-}" ]] && return 0
 56: readonly CMD_LIST_LOADED=1
 57: 
 58: # =============================================================================
 59: # HELPER FUNCTIONS
 60: # =============================================================================
 61: 
 62: parse_nft_set() {
 63:     # Parse nft set output and extract IPs
 64:     # Args: $1 = nft output, $2 = set name
 65:     local output="$1"
 66:     local set_name="$2"
 67: 
 68:     # Extract elements from the set (multi-line format)
 69:     # Format spans multiple lines:
 70:     #   elements = { 1.2.3.4, 5.6.7.8,
 71:     #                9.10.11.12 }
 72:     #
 73:     # Strategy:
 74:     # 1. Join all lines into one
 75:     # 2. Extract content between "elements = {" and "}"
 76:     # 3. Split by comma and clean up
 77:     # Note: grep/sed may return exit 1 with no matches, so use || true
 78:     echo "$output" | \
 79:         tr '\n' ' ' | \
 80:         sed -n 's/.*elements = { *\([^}]*\).*/\1/p' | \
 81:         tr ',' '\n' | \
 82:         sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | \
 83:         grep -v '^$' || true
 84: }
 85: 
 86: # =============================================================================
 87: # COMMAND HANDLER
 88: # =============================================================================
 89: 
 90: nftban_cmd_list() {
 91:     # List IPs from nftables sets
 92:     # Usage: nftban list [banned|whitelist|all] [--json]
 93: 
 94:     local list_type="banned"  # Default to banned IPs
 95:     local json_output=false
 96: 
 97:     # Parse arguments
 98:     while [[ $# -gt 0 ]]; do
 99:         case "$1" in
100:             banned|ban)
101:                 list_type="banned"
102:                 shift
103:                 ;;
104:             whitelist|white)
105:                 list_type="whitelist"
106:                 shift
107:                 ;;
108:             all)
109:                 list_type="all"
110:                 shift
111:                 ;;
112:             --json|-j)
113:                 json_output=true
114:                 shift
115:                 ;;
116:             --help|-h)
117:                 nftban_cmd_list_usage
118:                 return 0
119:                 ;;
120:             *)
121:                 echo "ERROR: Unknown option: $1" >&2
122:                 nftban_cmd_list_usage
123:                 return 1
124:                 ;;
125:         esac
126:     done
127: 
128:     # Show banner (skip for JSON output)
129:     if [[ "$json_output" != "true" ]]; then
130:         if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_output.sh" ]]; then
131:             # shellcheck source=/dev/null
132:             source "${NFTBAN_LIB_DIR}/core/nftban_output.sh"
133:             nftban_banner
134:         fi
135:         echo ""
136:     fi
137: 
138:     # Collect IPs from sets
139:     declare -A all_ips=()
140:     local ip_count=0  # shellcheck disable=SC2034  # Reserved for pagination
141: 
142:     if [[ "$list_type" == "banned" || "$list_type" == "all" ]]; then
143:         # v0.7.3: Unified blacklist (contains both permanent and temporary bans)
144:         # Get blacklist_ipv4
145:         if nft list set ${NFTBAN_TABLE_IPV4} blacklist_ipv4 &>/dev/null; then
146:             while IFS= read -r ip; do
147:                 [[ -n "$ip" ]] && all_ips["$ip"]="blacklist:ipv4"
148:             done < <(parse_nft_set "$(nft list set ${NFTBAN_TABLE_IPV4} blacklist_ipv4 2>/dev/null)" "blacklist_ipv4")
149:         fi
150: 
151:         # Get blacklist_ipv6
152:         if nft list set ${NFTBAN_TABLE_IPV6} blacklist_ipv6 &>/dev/null; then
153:             while IFS= read -r ip; do
154:                 [[ -n "$ip" ]] && all_ips["$ip"]="blacklist:ipv6"
155:             done < <(parse_nft_set "$(nft list set ${NFTBAN_TABLE_IPV6} blacklist_ipv6 2>/dev/null)" "blacklist_ipv6")
156:         fi
157:     fi
158: 
159:     if [[ "$list_type" == "whitelist" || "$list_type" == "all" ]]; then
160:         # v0.7.3: Get whitelist_ipv4
161:         if nft list set ${NFTBAN_TABLE_IPV4} whitelist_ipv4 &>/dev/null; then
162:             while IFS= read -r ip; do
163:                 [[ -n "$ip" ]] && all_ips["$ip"]="whitelist:ipv4"
164:             done < <(parse_nft_set "$(nft list set ${NFTBAN_TABLE_IPV4} whitelist_ipv4 2>/dev/null)" "whitelist_ipv4")
165:         fi
166: 
167:         # Get whitelist_ipv6
168:         if nft list set ${NFTBAN_TABLE_IPV6} whitelist_ipv6 &>/dev/null; then
169:             while IFS= read -r ip; do
170:                 [[ -n "$ip" ]] && all_ips["$ip"]="whitelist:ipv6"
171:             done < <(parse_nft_set "$(nft list set ${NFTBAN_TABLE_IPV6} whitelist_ipv6 2>/dev/null)" "whitelist_ipv6")
172:         fi
173:     fi
174: 
175:     # Output results
176:     if [[ "$json_output" == "true" ]]; then
177:         # JSON output
178:         echo "{"
179:         echo "  \"success\": true,"
180:         echo "  \"type\": \"$list_type\","
181:         echo "  \"total\": ${#all_ips[*]},"
182:         echo "  \"ips\": ["
183: 
184:         # Safe array iteration compatible with set -u
185:         if [[ ${#all_ips[@]} -gt 0 ]]; then
186:             local first=true
187:             for ip in "${!all_ips[@]}"; do
188:                 local meta="${all_ips[$ip]}"
189:                 local set_name="${meta%:*}"
190:                 local ip_version="${meta#*:}"
191: 
192:                 if [[ "$first" == "true" ]]; then
193:                     first=false
194:                 else
195:                     echo ","
196:                 fi
197: 
198:                 echo -n "    {\"ip\": \"$ip\", \"set\": \"$set_name\", \"version\": \"$ip_version\"}"
199:             done
200:         fi
201: 
202:         echo ""
203:         echo "  ]"
204:         echo "}"
205:     else
206:         # Text output with clear descriptions
207:         echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
208:         case "$list_type" in
209:             banned)
210:                 echo "📋 NFTBan List - BANNED IPs"
211:                 echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
212:                 echo ""
213:                 echo "These IPs are currently BLOCKED by the firewall."
214:                 echo "They cannot access any services on this server."
215:                 ;;
216:             whitelist)
217:                 echo "📋 NFTBan List - WHITELISTED IPs"
218:                 echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
219:                 echo ""
220:                 echo "These IPs are TRUSTED and will NEVER be blocked."
221:                 echo "They bypass all ban rules and rate limits."
222:                 ;;
223:             all)
224:                 echo "📋 NFTBan List - ALL IPs"
225:                 echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
226:                 echo ""
227:                 echo "Combined view of both banned and whitelisted IPs."
228:                 ;;
229:         esac
230:         echo ""
231: 
232:         # Count by type
233:         local banned_count=0
234:         local whitelist_count=0
235:         local ipv4_count=0
236:         local ipv6_count=0
237: 
238:         if [[ ${#all_ips[@]} -gt 0 ]]; then
239:             for ip in "${!all_ips[@]}"; do
240:                 local meta="${all_ips[$ip]}"
241:                 local set_name="${meta%:*}"
242:                 local ip_version="${meta#*:}"
243: 
244:                 [[ "$set_name" == "blacklist" ]] && banned_count=$((banned_count + 1))
245:                 [[ "$set_name" == "whitelist" ]] && whitelist_count=$((whitelist_count + 1))
246:                 [[ "$ip_version" == "ipv4" ]] && ipv4_count=$((ipv4_count + 1))
247:                 [[ "$ip_version" == "ipv6" ]] && ipv6_count=$((ipv6_count + 1))
248:             done
249:         fi
250: 
251:         echo "📊 Summary:"
252:         echo "   Total IPs: ${#all_ips[*]}"
253:         if [[ "$list_type" == "all" ]]; then
254:             echo "   ├── Banned:     $banned_count"
255:             echo "   └── Whitelisted: $whitelist_count"
256:         fi
257:         echo "   IPv4: $ipv4_count | IPv6: $ipv6_count"
258:         echo ""
259:         echo "────────────────────────────────────────────────────────────────────"
260:         printf "  %-42s %-12s %-8s\n" "IP Address" "Type" "Version"
261:         echo "────────────────────────────────────────────────────────────────────"
262: 
263:         # Safe array iteration compatible with set -u
264:         if [[ ${#all_ips[@]} -gt 0 ]]; then
265:             # Create sorted array of keys first
266:             local sorted_keys=()
267:             while IFS= read -r key; do
268:                 sorted_keys+=("$key")
269:             done < <(printf '%s\n' "${!all_ips[@]}" | sort)
270: 
271:             for ip in "${sorted_keys[@]}"; do
272:                 local meta="${all_ips[$ip]}"
273:                 local set_name="${meta%:*}"
274:                 local ip_version="${meta#*:}"
275:                 local icon=""
276:                 [[ "$set_name" == "blacklist" ]] && icon="🚫"
277:                 [[ "$set_name" == "whitelist" ]] && icon="✅"
278:                 printf "  %s %-40s %-12s %-8s\n" "$icon" "$ip" "$set_name" "$ip_version"
279:             done
280:         else
281:             echo ""
282:             echo "  (No IPs found)"
283:         fi
284: 
285:         echo "────────────────────────────────────────────────────────────────────"
286: 
287:         # Check if there are ranges (entries with '-') and explain
288:         local has_ranges=false
289:         if [[ ${#all_ips[@]} -gt 0 ]]; then
290:             for ip in "${!all_ips[@]}"; do
291:                 if [[ "$ip" == *"-"* ]]; then
292:                     has_ranges=true
293:                     break
294:                 fi
295:             done
296:         fi
297: 
298:         if [[ "$has_ranges" == "true" ]]; then
299:             echo ""
300:             echo "ℹ️  Note: Entries with '-' are IP RANGES (e.g., 1.2.3.4-1.2.3.10)"
301:             echo "   nftables auto-merges adjacent IPs for efficiency."
302:             echo "   Use 'nftban search <IP>' to check if a specific IP is banned."
303:         fi
304: 
305:         echo ""
306:         echo "💡 Commands:"
307:         case "$list_type" in
308:             banned)
309:                 echo "   nftban search <IP>       - Check if specific IP is banned"
310:                 echo "   nftban unban <IP>        - Remove IP from blacklist"
311:                 ;;
312:             whitelist)
313:                 echo "   nftban whitelist add <IP> - Add IP to whitelist"
314:                 echo "   nftban whitelist remove <IP> - Remove IP from whitelist"
315:                 ;;
316:             all)
317:                 echo "   nftban list banned       - Show only banned IPs"
318:                 echo "   nftban list whitelist    - Show only whitelisted IPs"
319:                 echo "   nftban list all --json   - Export as JSON"
320:                 ;;
321:         esac
322:         echo ""
323:     fi
324: 
325:     return 0
326: }
327: 
328: nftban_cmd_list_usage() {
329:     cat <<EOF
330: Usage: nftban list [TYPE] [OPTIONS]
331: 
332: List IPs from nftables sets (active firewall rules).
333: 
334: TYPES:
335:   banned        List banned IPs (temp_ban + blacklist) [default]
336:   whitelist     List whitelisted IPs (from firewall)
337:   all           List all IPs (banned + whitelist)
338: 
339: OPTIONS:
340:   --json, -j    Output in JSON format
341:   --help, -h    Show this help message
342: 
343: EXAMPLES:
344:   nftban list                    # List all banned IPs
345:   nftban list banned --json      # List banned IPs in JSON
346:   nftban list whitelist          # List whitelisted IPs from firewall
347:   nftban list all --json         # List all IPs in JSON
348: 
349: WHITELIST COMMANDS COMPARISON:
350:   nftban list whitelist          # Shows IPs loaded in nftables (active now)
351:   nftban whitelist list          # Shows IPs from config files (persistent)
352:   nftban whitelist-system show   # Shows only system auto-detected IPs
353: 
354: TIP: Use 'nftban list whitelist' to see what's currently protecting your IPs.
355:      Use 'nftban whitelist list' to see what's saved in configuration.
356: 
357: EOF
358: }
359: 
360: # Export functions
361: export -f nftban_cmd_list
362: export -f nftban_cmd_list_usage
363: 
364: # =============================================================================
365: # EXECUTE IF RUN DIRECTLY
366: # =============================================================================
367: 
368: if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
369:     nftban_cmd_list "$@"
370: fi

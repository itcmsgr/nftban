827:     setInterval(loadDashboardStats, 30000);
828:     setInterval(loadRecentActivity, 30000);
829:     setInterval(loadTopCountries, 60000);
830:     setInterval(loadTrendData, 60000); // Trend data refreshes every 60s
831: }
832: </script>

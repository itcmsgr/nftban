 427: nftban_nft_get_table_for_ip() {
 428:     # Determine which table to use for a given IP
 429:     # Args: $1 = IP address
 430:     # Returns: table name (e.g., "ip nftban" or "ip6 nftban")
 431: 
 432:     local ip="$1"
 433: 
 434:     if [[ "$ip" == *:* ]]; then
 435:         echo "${NFTBAN_TABLE_IPV6}"
 436:     else
 437:         echo "${NFTBAN_TABLE_IPV4}"
 438:     fi
 439: }

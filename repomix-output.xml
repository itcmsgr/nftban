675: nftban_port_generate_html_report() {
676:     # Generate HTML report from port data
677:     # Returns: Path to generated HTML file
678: 
679:     local template_path="${NFTBAN_TEMPLATE_DIR:-/usr/share/nftban/templates}/reports/port_report.html"
680:     local report_dir="${NFTBAN_REPORT_DIR:-/var/lib/nftban/reports}"
681:     local timestamp
682:     timestamp=$(date +%Y%m%d_%H%M%S)
683:     local report_file="${report_dir}/port_report_${timestamp}.html"
684: 
685:     # Ensure report directory exists
686:     mkdir -p "$report_dir" 2>/dev/null || true
687: 
688:     # Check if template exists
689:     if [[ ! -f "$template_path" ]]; then
690:         echo "ERROR: Template not found: $template_path" >&2
691:         return 1
692:     fi
693: 
694:     # Gather data if not already gathered
695:     if [[ ${#NFTBAN_PORT_LISTENERS[@]} -eq 0 ]]; then
696:         nftban_port_gather_listeners
697:         nftban_port_gather_nft_rules
698:     fi
699: 
700:     # Calculate statistics
701:     local total_ports=${#NFTBAN_PORT_LISTENERS[@]}
702:     local running_services=0
703:     local public_ports=0
704:     local local_ports=0
705: 
706:     for key in "${!NFTBAN_PORT_LISTENERS[@]}"; do
707:         IFS='/' read -r port proto <<< "$key"
708:         local bind="${NFTBAN_PORT_BIND_ADDR[$key]:-unknown}"
709: 
710:         [[ "$bind" != "-" ]] && running_services=$((running_services + 1)) || true
711: 
712:         if [[ "$bind" == "0.0.0.0" ]] || [[ "$bind" == "::" ]] || [[ "$bind" == "*" ]]; then
713:             public_ports=$((public_ports + 1)) || true
714:         elif [[ "$bind" != "-" ]]; then
715:             local_ports=$((local_ports + 1)) || true
716:         fi
717:     done
718: 
719:     # Generate HTML table rows
720:     local table_rows=""
721:     for key in $(printf '%s\n' "${!NFTBAN_PORT_LISTENERS[@]}" | sort -t'/' -k1 -n); do
722:         IFS='/' read -r port proto <<< "$key"
723: 
724:         local service="${NFTBAN_PORT_SERVICE_MAP[$port]:-unknown}"
725:         local process="${NFTBAN_PORT_LISTENERS[$key]:-}"
726:         local bind="${NFTBAN_PORT_BIND_ADDR[$key]:-}"
727: 
728:         # Get firewall status
729:         local ipv4_in="${NFTBAN_PORT_STATUS["${port}/${proto}/ipv4/in"]:-?}"
730:         local ipv4_out="${NFTBAN_PORT_STATUS["${port}/${proto}/ipv4/out"]:-?}"
731:         local ipv6_in="${NFTBAN_PORT_STATUS["${port}/${proto}/ipv6/in"]:-?}"
732:         local ipv6_out="${NFTBAN_PORT_STATUS["${port}/${proto}/ipv6/out"]:-?}"
733: 
734:         # Status badges
735:         local status_badge="<span class=\"badge badge-stopped\">Stopped</span>"
736:         [[ -n "$process" && "$process" != "-" ]] && status_badge="<span class=\"badge badge-running\">Running</span>"
737: 
738:         # Bind badge
739:         local bind_badge="-"
740:         if [[ "$bind" == "0.0.0.0" ]] || [[ "$bind" == "::" ]] || [[ "$bind" == "*" ]]; then
741:             bind_badge="<span class=\"badge badge-public\">PUBLIC</span>"
742:         elif [[ -n "$bind" && "$bind" != "-" ]]; then
743:             bind_badge="<span class=\"badge badge-local\">LOCAL</span>"
744:         fi
745: 
746:         # Status cells with colors
747:         local ipv4_in_html
748:         ipv4_in_html="<span class=\"status-${ipv4_in}\">$(nftban_port_status_symbol "$ipv4_in")</span>"
749:         local ipv4_out_html
750:         ipv4_out_html="<span class=\"status-${ipv4_out}\">$(nftban_port_status_symbol "$ipv4_out")</span>"
751:         local ipv6_in_html
752:         ipv6_in_html="<span class=\"status-${ipv6_in}\">$(nftban_port_status_symbol "$ipv6_in")</span>"
753:         local ipv6_out_html
754:         ipv6_out_html="<span class=\"status-${ipv6_out}\">$(nftban_port_status_symbol "$ipv6_out")</span>"
755: 
756:         table_rows+="                <tr>
757:                     <td>${service}</td>
758:                     <td><strong>${port}</strong></td>
759:                     <td>${proto}</td>
760:                     <td>${status_badge}</td>
761:                     <td>${ipv4_in_html}</td>
762:                     <td>${ipv4_out_html}</td>
763:                     <td>${ipv6_in_html}</td>
764:                     <td>${ipv6_out_html}</td>
765:                     <td>${bind_badge}</td>
766:                     <td class=\"perm-text\">${process:-N/A}</td>
767:                     <td>-</td>
768:                 </tr>
769: "
770:     done
771: 
772:     # Read template
773:     local html_content
774:     html_content=$(cat "$template_path")
775: 
776:     # Get system info
777:     local hostname
778:     hostname=$(hostname -f 2>/dev/null || hostname)
779:     local server_ip
780:     server_ip=$(hostname -I 2>/dev/null | awk '{print $1}' || echo "N/A")
781:     local current_date
782:     current_date=$(date +%Y-%m-%d)
783:     local current_time
784:     current_time=$(date +%H:%M:%S)
785: 
786:     # Substitute placeholders
787:     html_content="${html_content//\{HOSTNAME\}/$hostname}"
788:     html_content="${html_content//\{SERVER_IP\}/$server_ip}"
789:     html_content="${html_content//\{DATE\}/$current_date}"
790:     html_content="${html_content//\{TIME\}/$current_time}"
791:     html_content="${html_content//\{NFTBAN_VERSION\}/${NFTBAN_VERSION:-0.6.0}}"
792:     html_content="${html_content//\{COMPANY_NAME\}/${NFTBAN_COMPANY_NAME:-}}"
793:     html_content="${html_content//\{LOGO_HTML\}/}"
794:     html_content="${html_content//\{VERSION_HTML\}/<p>Version: <strong>${NFTBAN_VERSION:-0.6.0}</strong></p>}"
795: 
796:     # Statistics
797:     html_content="${html_content//\{TOTAL_PORTS\}/$total_ports}"
798:     html_content="${html_content//\{RUNNING_SERVICES\}/$running_services}"
799:     html_content="${html_content//\{PUBLIC_PORTS\}/$public_ports}"
800:     html_content="${html_content//\{LOCAL_PORTS\}/$local_ports}"
801: 
802:     # Table rows
803:     html_content="${html_content//\{PORT_TABLE_ROWS\}/$table_rows}"
804: 
805:     # Warnings section (empty for now)
806:     html_content="${html_content//\{WARNINGS_SECTION\}/}"
807: 
808:     # Write HTML file
809:     echo "$html_content" > "$report_file"
810: 
811:     # Set permissions
812:     chmod 640 "$report_file" 2>/dev/null || true
813: 
814:     echo "$report_file"
815: }
816: 

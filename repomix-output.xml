 98: # =============================================================================
 99: # STATUS COMMAND
100: # =============================================================================
101: 
102: nftban_watchdog_cmd_status() {
103:     # Quick one-line status
104:     local json_mode=false
105:     [[ "${1:-}" == "--json" ]] && json_mode=true
106: 
107:     # Check if enabled
108:     local enabled="${NFTBAN_WATCHDOG_ENABLED:-false}"
109: 
110:     # Run quick checks
111:     nftban_watchdog_run_all >/dev/null 2>&1
112: 
113:     local load="${WATCHDOG_RESULTS[load_5m]:-N/A}"
114:     local mem="${WATCHDOG_RESULTS[mem_used_percent]:-N/A}"
115:     local iowait="${WATCHDOG_RESULTS[cpu_iowait_percent]:-N/A}"
116:     local disk="${WATCHDOG_RESULTS[disk_used_percent]:-N/A}"
117:     local status="${WATCHDOG_RESULTS[overall_status]:-0}"
118: 
119:     local status_text="OK"
120:     [[ "$status" == "1" ]] && status_text="WARNING"
121:     [[ "$status" == "2" ]] && status_text="CRITICAL"
122: 
123:     if [[ "$json_mode" == "true" ]]; then
124:         cat << EOF
125: {
126:   "enabled": $([[ "$enabled" == "true" ]] && echo "true" || echo "false"),
127:   "status": "$status_text",
128:   "load_5m": "$load",
129:   "memory_percent": "$mem",
130:   "iowait_percent": "$iowait",
131:   "disk_percent": "$disk",
132:   "alerts_count": ${#WATCHDOG_ALERTS[@]}
133: }
134: EOF
135:     else
136:         # Color coding
137:         local color_reset="\033[0m"
138:         local color_green="\033[32m"
139:         local color_yellow="\033[33m"
140:         local color_red="\033[31m"
141: 
142:         local status_color="$color_green"
143:         [[ "$status_text" == "WARNING" ]] && status_color="$color_yellow"
144:         [[ "$status_text" == "CRITICAL" ]] && status_color="$color_red"
145: 
146:         local enabled_text="disabled"
147:         [[ "$enabled" == "true" ]] && enabled_text="enabled"
148: 
149:         printf "Watchdog: %b%s%b | Load: %s | Mem: %s%% | I/O Wait: %s%% | Disk: %s%% | Timer: %s\n" \
150:             "$status_color" "$status_text" "$color_reset" \
151:             "$load" "$mem" "$iowait" "$disk" "$enabled_text"
152:     fi
153: }
154: 
155: # =============================================================================
156: # CHECK COMMAND
157: # =============================================================================
158: 
159: nftban_watchdog_cmd_check() {
160:     # Run all checks and show alerts only
161:     local json_mode=false
162:     [[ "${1:-}" == "--json" ]] && json_mode=true
163: 
164:     # Run all checks
165:     nftban_watchdog_run_all
166: 
167:     if [[ "$json_mode" == "true" ]]; then
168:         # JSON output
169:         cat << EOF
170: {
171:   "status": "${WATCHDOG_RESULTS[overall_status]:-0}",
172:   "timestamp": "${WATCHDOG_RESULTS[check_datetime]:-$(date '+%Y-%m-%d %H:%M:%S')}",
173:   "load": {
174:     "1m": "${WATCHDOG_RESULTS[load_1m]:-0}",
175:     "5m": "${WATCHDOG_RESULTS[load_5m]:-0}",
176:     "15m": "${WATCHDOG_RESULTS[load_15m]:-0}",
177:     "status": "${WATCHDOG_RESULTS[load_status]:-OK}"
178:   },
179:   "memory": {
180:     "used_percent": "${WATCHDOG_RESULTS[mem_used_percent]:-0}",
181:     "total_mb": "${WATCHDOG_RESULTS[mem_total_mb]:-0}",
182:     "available_mb": "${WATCHDOG_RESULTS[mem_available_mb]:-0}",
183:     "status": "${WATCHDOG_RESULTS[mem_status]:-OK}"
184:   },
185:   "iowait": {
186:     "percent": "${WATCHDOG_RESULTS[cpu_iowait_percent]:-0}",
187:     "status": "${WATCHDOG_RESULTS[iowait_status]:-OK}"
188:   },
189:   "disk": {
190:     "path": "${WATCHDOG_RESULTS[disk_path]:-/var/log}",
191:     "used_percent": "${WATCHDOG_RESULTS[disk_used_percent]:-0}",
192:     "status": "${WATCHDOG_RESULTS[disk_status]:-OK}"
193:   },
194:   "alerts_count": ${#WATCHDOG_ALERTS[@]}
195: }
196: EOF
197:     else
198:         # Text output - show alerts only if any
199:         if [[ ${#WATCHDOG_ALERTS[@]} -eq 0 ]]; then
200:             echo "Watchdog check completed: OK (no alerts)"
201:         else
202:             echo "Watchdog check completed with ${#WATCHDOG_ALERTS[@]} alert(s):"
203:             echo ""
204:             for alert in "${WATCHDOG_ALERTS[@]}"; do
205:                 echo "  $alert"
206:             done
207:         fi
208:     fi
209: 
210:     return "${WATCHDOG_RESULTS[overall_status]:-0}"
211: }
212: 
213: # =============================================================================
214: # REPORT COMMAND
215: # =============================================================================
216: 
217: nftban_watchdog_cmd_report() {
218:     # Full detailed report
219:     local save_report=false
220: 
221:     # Parse args
222:     for arg in "$@"; do
223:         [[ "$arg" == "--save" ]] && save_report=true
224:     done
225: 
226:     # Run all checks
227:     nftban_watchdog_run_all
228: 
229:     # Print report
230:     nftban_watchdog_report
231: 
232:     # Save if requested or if there are alerts
233:     if [[ "$save_report" == "true" || ${#WATCHDOG_ALERTS[@]} -gt 0 ]]; then
234:         local report_file
235:         report_file=$(nftban_watchdog_report_save)
236:         echo "Report saved to: $report_file"
237:     fi
238: 
239:     # Export metrics

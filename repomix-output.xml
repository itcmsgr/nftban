 260: nftban_watchdog_check_memory() {
 261:     # Check memory usage from /proc/meminfo
 262:     # Returns: status code, sets WATCHDOG_RESULTS
 263: 
 264:     if [[ "$NFTBAN_WATCHDOG_MEM_ENABLED" != "true" ]]; then
 265:         return 0
 266:     fi
 267: 
 268:     local mem_total=0 mem_free=0 mem_available=0 buffers=0 cached=0
 269:     local swap_total=0 swap_free=0
 270: 
 271:     while IFS=': ' read -r key value _; do
 272:             # Memory stats - reserved for future metrics
 273:             # shellcheck disable=SC2034
 274:         case "$key" in
 275:             MemTotal)     mem_total=$value ;;
 276:             MemFree)      mem_free=$value ;;
 277:             MemAvailable) mem_available=$value ;;
 278:             Buffers)      buffers=$value ;;
 279:             Cached)       cached=$value ;;
 280:             SwapTotal)    swap_total=$value ;;
 281:             SwapFree)     swap_free=$value ;;
 282:         esac
 283:     done < /proc/meminfo
 284: 
 285:     # Calculate usage (values are in kB)
 286:     local mem_used
 287:     mem_used=$((mem_total - mem_available))
 288:     local mem_used_percent=0
 289:     if [[ $mem_total -gt 0 ]]; then
 290:         mem_used_percent=$((mem_used * 100 / mem_total))
 291:     fi
 292: 
 293:     local swap_used
 294:     swap_used=$((swap_total - swap_free))
 295:     local swap_used_percent=0
 296:     if [[ $swap_total -gt 0 ]]; then
 297:         swap_used_percent=$((swap_used * 100 / swap_total))
 298:     fi
 299: 
 300:     # Store in MB for readability
 301:     WATCHDOG_RESULTS[mem_total_mb]=$((mem_total / 1024))
 302:     WATCHDOG_RESULTS[mem_used_mb]=$((mem_used / 1024))
 303:     WATCHDOG_RESULTS[mem_available_mb]=$((mem_available / 1024))
 304:     WATCHDOG_RESULTS[mem_used_percent]="$mem_used_percent"
 305:     WATCHDOG_RESULTS[swap_total_mb]=$((swap_total / 1024))
 306:     WATCHDOG_RESULTS[swap_used_mb]=$((swap_used / 1024))
 307:     WATCHDOG_RESULTS[swap_used_percent]="$swap_used_percent"
 308: 
 309:     # Store in bytes for Prometheus metrics
 310:     WATCHDOG_RESULTS[mem_total_bytes]=$((mem_total * 1024))
 311:     WATCHDOG_RESULTS[mem_available_bytes]=$((mem_available * 1024))
 312:     WATCHDOG_RESULTS[swap_used_bytes]=$((swap_used * 1024))
 313: 
 314:     # Check thresholds
 315:     local status=$WATCHDOG_OK
 316: 
 317:     if [[ $mem_used_percent -ge $NFTBAN_WATCHDOG_MEM_CRITICAL ]]; then
 318:         status=$WATCHDOG_CRITICAL
 319:         WATCHDOG_RESULTS[mem_status]="CRITICAL"
 320:         if watchdog_should_alert "memory"; then
 321:             watchdog_alert "CRITICAL" "Memory usage CRITICAL: ${mem_used_percent}% >= ${NFTBAN_WATCHDOG_MEM_CRITICAL}%"
 322:         fi
 323:     elif [[ $mem_used_percent -ge $NFTBAN_WATCHDOG_MEM_WARNING ]]; then
 324:         status=$WATCHDOG_WARNING
 325:         WATCHDOG_RESULTS[mem_status]="WARNING"
 326:         if watchdog_should_alert "memory"; then
 327:             watchdog_alert "WARNING" "Memory usage high: ${mem_used_percent}% >= ${NFTBAN_WATCHDOG_MEM_WARNING}%"
 328:         fi
 329:     else
 330:         WATCHDOG_RESULTS[mem_status]="OK"
 331:     fi
 332: 
 333:     # Check swap separately
 334:     if [[ $swap_total -gt 0 && $swap_used_percent -ge $NFTBAN_WATCHDOG_SWAP_WARNING ]]; then
 335:         if [[ $status -lt $WATCHDOG_WARNING ]]; then
 336:             status=$WATCHDOG_WARNING
 337:         fi
 338:         WATCHDOG_RESULTS[swap_status]="WARNING"
 339:         if watchdog_should_alert "swap"; then
 340:             watchdog_alert "WARNING" "Swap usage: ${swap_used_percent}% >= ${NFTBAN_WATCHDOG_SWAP_WARNING}%"
 341:         fi
 342:     else
 343:         WATCHDOG_RESULTS[swap_status]="OK"
 344:     fi
 345: 
 346:     return $status
 347: }

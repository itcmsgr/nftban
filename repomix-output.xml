293: // SystemFHSHandler returns FHS compliance report
294: // GET /api/v1/system/fhs
295: func SystemFHSHandler(w http.ResponseWriter, r *http.Request) {
296: 	output, err := execNFTBanCommand("fhs", "--json")
297: 	if err != nil {
298: 		// Try without --json
299: 		output, _ = execNFTBanCommand("fhs")
300: 	}
301: 
302: 	// Parse output into structured data
303: 	directories := []map[string]interface{}{}
304: 	lines := strings.Split(output, "\n")
305: 	okCount, errCount, missingCount := 0, 0, 0
306: 
307: 	for _, line := range lines {
308: 		line = strings.TrimSpace(line)
309: 		if line == "" || strings.HasPrefix(line, "=") || strings.HasPrefix(line, "DIRECTORY") || strings.HasPrefix(line, "---") || strings.HasPrefix(line, "Total") {
310: 			continue
311: 		}
312: 
313: 		// Parse FHS output line
314: 		parts := strings.Fields(line)
315: 		if len(parts) >= 4 {
316: 			dir := map[string]interface{}{
317: 				"path":     parts[0],
318: 				"expected": "",
319: 				"actual":   "",
320: 				"status":   "OK",
321: 				"notes":    "",
322: 			}
323: 
324: 			// Find status
325: 			for i, p := range parts {
326: 				if p == "OK" || strings.Contains(p, "✔") {
327: 					dir["status"] = "OK"
328: 					okCount++
329: 					if i > 0 {
330: 						dir["expected"] = parts[1]
331: 					}
332: 					if i > 1 {
333: 						dir["actual"] = parts[2]
334: 					}
335: 					break
336: 				} else if p == "ERROR" || strings.Contains(p, "✖") {
337: 					dir["status"] = "ERROR"
338: 					errCount++
339: 					if len(parts) > i+1 {
340: 						dir["notes"] = strings.Join(parts[i+1:], " ")
341: 					}
342: 					break
343: 				} else if strings.Contains(p, "MISSING") || strings.Contains(p, "⚠") {
344: 					dir["status"] = "MISSING"
345: 					missingCount++
346: 					break
347: 				}
348: 			}
349: 
350: 			directories = append(directories, dir)
351: 		}
352: 	}
353: 
354: 	respondJSON(w, http.StatusOK, map[string]interface{}{
355: 		"success": true,
356: 		"data": map[string]interface{}{
357: 			"directories": directories,
358: 			"total":       len(directories),
359: 			"ok":          okCount,
360: 			"errors":      errCount,
361: 			"missing":     missingCount,
362: 		},
363: 	})
364: }

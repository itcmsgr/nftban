[Unit]
Description=NFTBan Suricata Integration Daemon
Documentation=man:nftban(8) https://nftban.com/docs
After=network.target nftables.service suricata.service
Requires=suricata.service
PartOf=suricata.service
OnFailure=nftban-alert@%n.service

[Service]
Type=simple

# SECURITY FIX: Run as unprivileged nftban user (not root)
# Reads: /var/log/nftban/suricata/eve-alerts.json (via suricata group)
# Writes: /var/lib/nftban/, /var/log/nftban/
# Firewall bans via IPC to daemon (no direct nft operations)
# See: SYSTEMD-SERVICE-CLASSIFICATION.md
User=nftban
Group=nftban
SupplementaryGroups=suricata

# Grant CAP_NET_ADMIN for nftables operations (required for ban actions)
# Bug fix v1.9.4: Service failed without this capability
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN

# PRECONDITION 1: Ensure EVE log file exists with correct ownership
# Suricata 7.x with threaded:yes only creates file on first event
# Without this, nftban-suricata fails if no alerts have been generated yet
# Bug fix v1.12.8: Service was failing with "no such file or directory" after logrotate
# Bug fix v1.12.9: Detect actual Suricata user (suricata, _suricata, or root) for cross-distro compatibility
# Note: + prefix runs as root (required for chown/mkdir since service runs as nftban)
ExecStartPre=+/bin/bash -c '\
  mkdir -p /var/log/nftban/suricata && \
  SURI_USER=$(ps -o user= -p $(pgrep -x Suricata-Main 2>/dev/null || pgrep suricata 2>/dev/null | head -1) 2>/dev/null || echo "root"); \
  [ -z "$SURI_USER" ] && SURI_USER="root"; \
  touch /var/log/nftban/suricata/eve-alerts.json && \
  chown "$SURI_USER":nftban /var/log/nftban/suricata/eve-alerts.json && \
  chmod 640 /var/log/nftban/suricata/eve-alerts.json'

# PRECONDITION 2: Verify Suricata has rules loaded before starting EVE reader
# Without rules, Suricata produces no alerts → nftban has nothing to process
# This prevents "silent failure" where service runs but provides no protection
# Note: + prefix runs as root (nftban command needs root for some checks)
ExecStartPre=+/usr/sbin/nftban suricata rules verify --quiet

# Daemon command
ExecStart=/usr/lib/nftban/bin/nftban-core suricata daemon

# Restart on failure
Restart=on-failure
RestartSec=10

# =============================================================================
# SECURITY HARDENING
# =============================================================================

# Core hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

# Minimal filesystem access
ReadWritePaths=/var/lib/nftban /var/log/nftban /var/cache/nftban /run/nftban

# Network for IPC socket
RestrictAddressFamilies=AF_UNIX

# Resource limits
MemoryMax=512M
TasksMax=50
LimitNOFILE=65536
LimitNPROC=512

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nftban-suricata
LogRateLimitIntervalSec=10s
LogRateLimitBurst=1000

[Install]
WantedBy=multi-user.target

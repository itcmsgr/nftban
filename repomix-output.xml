 23: // replaceConfigValue replaces a config variable value using regex to handle spacing variations
 24: // Pattern matches: VAR="value", VAR = "value", VAR= "value", etc.
 25: func replaceConfigValue(content, varName, newValue string) string {
 26: 	// Regex pattern: varName + optional spaces + = + optional spaces + quoted value
 27: 	pattern := regexp.MustCompile(fmt.Sprintf(`(?m)^(\s*)%s\s*=\s*"[^"]*"(.*)$`, regexp.QuoteMeta(varName)))
 28: 	replacement := fmt.Sprintf(`${1}%s="%s"${2}`, varName, newValue)
 29: 	return pattern.ReplaceAllString(content, replacement)
 30: }

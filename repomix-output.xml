437: 
438:     try {
439:         console.log('[DASHBOARD] Loading stats...');
440: 
441:         // Get hostname
442:         const hostnameResp = await fetch('/api/v1/system/hostname', {
443:             headers: window.getAuthHeaders()
444:         }).catch(() => null);
445: 
446:         const hostnameEl = document.getElementById('stat-hostname');
447:         if (hostnameResp && hostnameResp.ok && hostnameEl) {
448:             const data = await hostnameResp.json();
449:             hostnameEl.textContent = data.hostname || '-';
450:         }
451: 
452:         // Helper to safely set element text
453:         const setText = (id, value) => {
454:             const el = document.getElementById(id);
455:             if (el) el.textContent = value;
456:         };

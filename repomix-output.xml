 399:             tail -5 || echo "    (no recent alerts or jq not installed)"
 400:     else
 401:         echo "    (eve.json not found)"
 402:     fi
 403: 
 404:     echo ""
 405:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
 406:     echo ""
 407: 
 408:     # Show systemd status if running
 409:     if _suricata_is_running; then
 410:         echo "Service Status:"
 411:         systemctl status "$SURICATA_SERVICE" --no-pager -l | head -15
 412:     fi
 413: 
 414:     echo ""
 415: }

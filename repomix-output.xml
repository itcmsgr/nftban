  1: # =============================================================================
  2: # NFTBan System Watchdog Configuration
  3: # =============================================================================
  4: # SPDX-License-Identifier: MPL-2.0
  5: # Purpose: Monitor system resources for troubleshooting and auditing
  6: #
  7: # This module monitors OS-level metrics NOT covered by other modules:
  8: # - Load Average (from /proc/loadavg)
  9: # - Memory/Swap Usage (from /proc/meminfo)
 10: # - I/O Wait % (from /proc/stat)
 11: # - Disk Usage (df command)
 12: # - File Descriptors (from /proc/sys/fs/file-nr)
 13: # - Top Processes (CPU and memory consumers)
 14: #
 15: # What OTHER modules handle (we don't touch):
 16: # - Connection per IP: nftban ddos (ct count in nftables)
 17: # - Ban rate alerts: nftban stats
 18: # - Service health: nftban health
 19: # =============================================================================
 20: 
 21: # -----------------------------------------------------------------------------
 22: # GENERAL SETTINGS
 23: # -----------------------------------------------------------------------------
 24: # Enable/disable watchdog (use: nftban watchdog enable/disable)
 25: NFTBAN_WATCHDOG_ENABLED="false"
 26: 
 27: # Check interval in seconds (default: 90s for responsive alerting)
 28: # CSF uses 60s, we use 90s for slightly less overhead
 29: NFTBAN_WATCHDOG_INTERVAL="90"
 30: 
 31: # Alert throttle - don't repeat same alert within this time (seconds)
 32: # Default: 1 hour (3600s) - same as CSF
 33: NFTBAN_WATCHDOG_ALERT_THROTTLE="3600"
 34: 
 35: # -----------------------------------------------------------------------------
 36: # LOAD AVERAGE MONITORING
 37: # -----------------------------------------------------------------------------
 38: NFTBAN_WATCHDOG_LOAD_ENABLED="true"
 39: 
 40: # Which load average to check: 1, 5, or 15 (minute)
 41: # Recommendation: 5 (balances responsiveness with stability)
 42: NFTBAN_WATCHDOG_LOAD_AVG="5"
 43: 
 44: # Warning threshold (will generate WARNING alert)
 45: NFTBAN_WATCHDOG_LOAD_WARNING="10"
 46: 
 47: # Critical threshold (will generate CRITICAL alert)
 48: NFTBAN_WATCHDOG_LOAD_CRITICAL="20"
 49: 
 50: # -----------------------------------------------------------------------------
 51: # MEMORY MONITORING
 52: # -----------------------------------------------------------------------------
 53: NFTBAN_WATCHDOG_MEM_ENABLED="true"
 54: 
 55: # Memory usage warning threshold (percentage)
 56: NFTBAN_WATCHDOG_MEM_WARNING="80"
 57: 
 58: # Memory usage critical threshold (percentage)
 59: NFTBAN_WATCHDOG_MEM_CRITICAL="95"
 60: 
 61: # Swap usage warning threshold (percentage)
 62: # Swap usage often indicates memory pressure
 63: NFTBAN_WATCHDOG_SWAP_WARNING="50"
 64: 
 65: # -----------------------------------------------------------------------------
 66: # I/O WAIT MONITORING (Disk Bottleneck Detection)
 67: # -----------------------------------------------------------------------------
 68: NFTBAN_WATCHDOG_IOWAIT_ENABLED="true"
 69: 
 70: # I/O wait warning threshold (percentage)
 71: # High I/O wait indicates disk is bottleneck
 72: NFTBAN_WATCHDOG_IOWAIT_WARNING="20"
 73: 
 74: # I/O wait critical threshold (percentage)
 75: NFTBAN_WATCHDOG_IOWAIT_CRITICAL="40"
 76: 
 77: # -----------------------------------------------------------------------------
 78: # DISK USAGE MONITORING
 79: # -----------------------------------------------------------------------------
 80: NFTBAN_WATCHDOG_DISK_ENABLED="true"
 81: 
 82: # Path to monitor for disk usage (usually log directory)
 83: # Can be comma-separated for multiple paths: "/var/log,/var/lib"
 84: NFTBAN_WATCHDOG_DISK_PATH="/var/log"
 85: 
 86: # Disk usage warning threshold (percentage)
 87: NFTBAN_WATCHDOG_DISK_WARNING="80"
 88: 
 89: # Disk usage critical threshold (percentage)
 90: NFTBAN_WATCHDOG_DISK_CRITICAL="95"
 91: 
 92: # -----------------------------------------------------------------------------
 93: # PROCESS TRACKING (Top Resource Consumers)
 94: # -----------------------------------------------------------------------------
 95: NFTBAN_WATCHDOG_PROC_ENABLED="true"
 96: 
 97: # Number of top processes to track in reports
 98: NFTBAN_WATCHDOG_PROC_TOP_COUNT="10"
 99: 
100: # Alert if single process exceeds this CPU percentage
101: NFTBAN_WATCHDOG_PROC_CPU_ALERT="80"
102: 
103: # Alert if single process exceeds this memory (in MB)
104: NFTBAN_WATCHDOG_PROC_MEM_ALERT="2048"
105: 
106: # -----------------------------------------------------------------------------
107: # ALERTS & LOGGING
108: # -----------------------------------------------------------------------------
109: # Watchdog log file
110: NFTBAN_WATCHDOG_LOG="/var/log/nftban/watchdog.log"
111: 
112: # Directory for saved reports (for auditing)
113: NFTBAN_WATCHDOG_REPORT_DIR="/var/lib/nftban/reports/watchdog"
114: 
115: # Send email on critical alerts (uses system mail)
116: NFTBAN_WATCHDOG_ALERT_EMAIL="true"
117: 
118: # Log alerts to syslog (journald)
119: NFTBAN_WATCHDOG_ALERT_SYSLOG="true"
120: 
121: # -----------------------------------------------------------------------------
122: # PROMETHEUS METRICS (for History and Graphing)
123: # -----------------------------------------------------------------------------
124: # Export metrics in Prometheus format
125: NFTBAN_WATCHDOG_METRICS_ENABLED="true"
126: 
127: # Prometheus metrics file (picked up by node_exporter textfile collector)
128: NFTBAN_WATCHDOG_METRICS_FILE="/var/lib/nftban/metrics/watchdog.prom"
129: 
130: # Days to keep reports (for auditing)
131: NFTBAN_WATCHDOG_REPORT_RETENTION="7"
132: 
133: # =============================================================================
134: # USAGE
135: # =============================================================================
136: # Enable:   nftban watchdog enable
137: # Disable:  nftban watchdog disable
138: # Status:   nftban watchdog status
139: # Check:    nftban watchdog check
140: # Report:   nftban watchdog report
141: # History:  nftban watchdog history
142: # =============================================================================

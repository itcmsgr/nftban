 534:             total_events=${total_events:-0}
 535:             success_events=$(grep -c "SUCCESS" "$log_file" 2>/dev/null) || success_events=0
 536:             failed_events=$(grep -c "FAILED" "$log_file" 2>/dev/null) || failed_events=0
 537:             today_events=$(grep -c "\[$today" "$log_file" 2>/dev/null) || today_events=0
 538:         fi
 539: 
 540:         if systemctl is-active --quiet ${NFTBAN_SERVICE_LOGIN_MONITOR:-nftban-login-monitor.service} 2>/dev/null; then
 541:             service_running="true"

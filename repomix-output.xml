183:         local desc risk has_json examples mutates
184:         desc=$(yq -r ".\"$cmd\".description" "$REGISTRY")
185:         risk=$(yq -r ".\"$cmd\".risk" "$REGISTRY")
186:         has_json=$(yq -r ".\"$cmd\".has_json" "$REGISTRY")
187:         mutates=$(yq -r ".\"$cmd\".mutates" "$REGISTRY")
188: 
189:         # Get examples array
190:         examples=$(yq -r ".\"$cmd\".examples[]?" "$REGISTRY" 2>/dev/null || echo "")
191: 
192:         cat <<EOF

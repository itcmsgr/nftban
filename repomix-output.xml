420: function displayChart(stats) {
421:     if (!stats || Object.keys(stats).length === 0) {
422:         if (geobanChart) {
423:             geobanChart.destroy();
424:             geobanChart = null;
425:         }
426:         return;
427:     }
428: 
429:     // Sort by blocks descending and get top 10
430:     const sorted = Object.entries(stats)
431:         .sort((a, b) => {
432:             const blocksA = (a[1].blocks !== undefined ? a[1].blocks : a[1]) || 0;
433:             const blocksB = (b[1].blocks !== undefined ? b[1].blocks : b[1]) || 0;
434:             return blocksB - blocksA;
435:         })
436:         .slice(0, 10);
437: 
438:     const labels = sorted.map(([code]) => {
439:         const name = window.countryNames[code] || code;
440:         const flag = window.countryFlags[code] || '🌍';
441:         return `${flag} ${name}`;
442:     });
443: 
444:     const dataValues = sorted.map(([code, data]) => {
445:         return (data.blocks !== undefined ? data.blocks : data) || 0;
446:     });
447: 
448:     const ctx = document.getElementById('geoban-chart');
449:     if (!ctx) return;

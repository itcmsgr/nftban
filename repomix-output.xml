 524:     total_bans=$(nftban_stats_count_bans "$since" "$until")
 525:     unique_ips=$(nftban_stats_count_unique_ips "$since" "$until")
 526:     active_bans=$(nftban_stats_count_active_bans)  # shellcheck disable=SC2034  # Reserved for metrics
 527:     whitelist_count=$(nftban_stats_count_whitelist)
 528: 

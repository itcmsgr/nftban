187:     node_service=$(nftban_distro_get_service node_exporter)
188:     if [[ -n "$node_service" ]]; then
189:         set +o pipefail
190:         systemctl list-unit-files 2>/dev/null | grep -q "^${node_service}.service"
191:         local node_found=$?
192:         set -o pipefail
193:         if [[ $node_found -ne 0 ]]; then
194:             missing_deps+=("node-exporter")
195:             missing_packages+=("$(nftban_distro_get_package node_exporter)")

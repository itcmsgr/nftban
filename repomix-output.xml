 432: _nftban_login_set_config() {
 433:     # Helper: Set config value in local override file
 434:     local key="$1"
 435:     local value="$2"
 436:     local file="$3"
 437: 
 438:     if grep -q "^${key}=" "$file" 2>/dev/null; then
 439:         sed -i "s|^${key}=.*|${key}=${value}|" "$file"
 440:     else
 441:         echo "${key}=${value}" >> "$file"
 442:     fi
 443: }

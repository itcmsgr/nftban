636: # Check if IP is whitelisted
637: nftban_portscan_suricata_is_whitelisted() {
638:     local ip="$1"
639: 
640:     # Localhost
641:     if [[ "${PORTSCAN_WHITELIST_LOCALHOST:-true}" == "true" ]]; then
642:         case "$ip" in
643:             127.*|::1|0.0.0.0) return 0 ;;
644:         esac
645:     fi
646: 
647:     # Private networks
648:     if [[ "${PORTSCAN_WHITELIST_PRIVATE:-true}" == "true" ]]; then
649:         case "$ip" in
650:             10.*|172.1[6-9].*|172.2[0-9].*|172.3[0-1].*|192.168.*) return 0 ;;
651:             fc*|fd*) return 0 ;;
652:         esac
653:     fi
654: 
655:     # Use nftban whitelist check if available
656:     if type -t nftban_is_whitelisted &>/dev/null; then
657:         if nftban_is_whitelisted "$ip"; then
658:             return 0
659:         fi
660:     fi
661: 
662:     return 1
663: }

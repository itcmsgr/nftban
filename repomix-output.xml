153: nftban_debug_enable() {
154:     local what="${1:-trace}"
155:     local config_file="${NFTBAN_CONFIG_DIR}/nftban.conf"
156: 
157:     case "$what" in
158:         trace|all)
159:             echo "Enabling debug trace..."
160: 
161:             if [[ ! -f "$config_file" ]]; then
162:                 echo "ERROR: Config file not found: $config_file" >&2
163:                 return 1
164:             fi
165: 
166:             # Check if already enabled
167:             if grep -q '^NFTBAN_DEBUG_TRACE="true"' "$config_file" 2>/dev/null; then
168:                 echo "Debug trace is already enabled"
169:                 return 0
170:             fi
171: 
172:             # Update config
173:             if grep -q '^NFTBAN_DEBUG_TRACE=' "$config_file"; then
174:                 sed -i 's/^NFTBAN_DEBUG_TRACE="false"/NFTBAN_DEBUG_TRACE="true"/' "$config_file"
175:             else
176:                 echo 'NFTBAN_DEBUG_TRACE="true"' >> "$config_file"
177:             fi
178: 
179:             # Ensure log directory exists
180:             local log_dir="${NFTBAN_LOG_DIR:-/var/log/nftban}"
181:             [[ ! -d "$log_dir" ]] && mkdir -p "$log_dir"
182: 
183:             echo ""
184:             echo "✅ Debug trace ENABLED"
185:             echo ""
186:             echo "What happens now:"
187:             echo "  - Each script logs START/END with unique trace ID"
188:             echo "  - Log file: ${NFTBAN_LOG_DIR:-/var/log/nftban}/debug_trace.log"
189:             echo "  - Check for stuck scripts: nftban debug trace orphans"
190:             echo ""
191:             echo "To disable: nftban debug disable"
192:             ;;
193: 
194:         verbose)
195:             echo "Enabling verbose logging..."
196:             if grep -q '^NFTBAN_LOG_LEVEL=' "$config_file"; then
197:                 sed -i 's/^NFTBAN_LOG_LEVEL="[^"]*"/NFTBAN_LOG_LEVEL="DEBUG"/' "$config_file"
198:             else
199:                 echo 'NFTBAN_LOG_LEVEL="DEBUG"' >> "$config_file"
200:             fi
201:             echo "✅ Log level set to DEBUG"
202:             ;;
203: 
204:         *)
205:             echo "Unknown debug type: $what"
206:             echo "Options: trace, verbose, all"
207:             return 1
208:             ;;
209:     esac
210: }

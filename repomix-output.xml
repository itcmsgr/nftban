<file path="pkg/suricata/customrules/validator.go">
  1: package customrules
  2: 
  3: import (
  4: 	"fmt"
  5: 	"os/exec"
  6: 	"regexp"
  7: 	"strconv"
  8: 	"strings"
  9: )
 10: 
 11: // SID range for custom rules (9000000-9999999)
 12: const (
 13: 	MinCustomSID = 9000000
 14: 	MaxCustomSID = 9999999
 15: )
 16: 
 17: // ValidationResult holds validation outcome
 18: type ValidationResult struct {
 19: 	Valid   bool
 20: 	Errors  []string
 21: 	SID     int
 22: 	Action  string // alert, drop, reject
 23: 	Message string
 24: }
 25: 
 26: // ValidateRule validates a Suricata rule
 27: func ValidateRule(rule string) (*ValidationResult, error) {
 28: 	result := &ValidationResult{
 29: 		Valid:  true,
 30: 		Errors: make([]string, 0),
 31: 	}
 32: 
 33: 	rule = strings.TrimSpace(rule)
 34: 
 35: 	// Empty rule
 36: 	if rule == "" {
 37: 		result.Valid = false
 38: 		result.Errors = append(result.Errors, "Rule cannot be empty")
 39: 		return result, nil
 40: 	}
 41: 
 42: 	// Comment line
 43: 	if strings.HasPrefix(rule, "#") {
 44: 		result.Valid = false
 45: 		result.Errors = append(result.Errors, "Rule is commented out")
 46: 		return result, nil
 47: 	}
 48: 
 49: 	// Validate basic structure
 50: 	if err := validateBasicStructure(rule, result); err != nil {
 51: 		return nil, err
 52: 	}
 53: 
 54: 	// Extract and validate SID
 55: 	if err := validateSID(rule, result); err != nil {
 56: 		return nil, err
 57: 	}
 58: 
 59: 	// Validate with suricata if available
 60: 	if err := validateWithSuricata(rule, result); err != nil {
 61: 		// Don't fail if suricata not available, just skip this validation
 62: 		result.Errors = append(result.Errors, fmt.Sprintf("Warning: Could not validate with suricata: %v", err))
 63: 	}
 64: 
 65: 	if len(result.Errors) > 0 {
 66: 		result.Valid = false
 67: 	}
 68: 
 69: 	return result, nil
 70: }
 71: 
 72: // validateBasicStructure checks basic rule format
 73: func validateBasicStructure(rule string, result *ValidationResult) error {
 74: 	// Must start with action (alert, drop, reject, pass)
 75: 	validActions := []string{"alert", "drop", "reject", "pass"}
 76: 	actionFound := false
 77: 	for _, action := range validActions {
 78: 		if strings.HasPrefix(rule, action+" ") {
 79: 			result.Action = action
 80: 			actionFound = true
 81: 			break
 82: 		}
 83: 	}
 84: 
 85: 	if !actionFound {
 86: 		result.Errors = append(result.Errors, "Rule must start with action: alert, drop, reject, or pass")
 87: 		return nil
 88: 	}
 89: 
 90: 	// Must contain protocol
 91: 	validProtocols := []string{"tcp", "udp", "icmp", "ip", "http", "ftp", "tls", "smb", "dns"}
 92: 	protocolFound := false
 93: 	for _, proto := range validProtocols {
 94: 		if strings.Contains(strings.ToLower(rule), " "+proto+" ") {
 95: 			protocolFound = true
 96: 			break
 97: 		}
 98: 	}
 99: 
100: 	if !protocolFound {
101: 		result.Errors = append(result.Errors, "Rule must specify protocol (tcp, udp, icmp, ip, http, etc.)")
102: 	}
103: 
104: 	// Must contain parentheses for rule options
105: 	if !strings.Contains(rule, "(") || !strings.Contains(rule, ")") {
106: 		result.Errors = append(result.Errors, "Rule must contain options in parentheses")
107: 		return nil
108: 	}
109: 
110: 	// Check balanced parentheses
111: 	openCount := strings.Count(rule, "(")
112: 	closeCount := strings.Count(rule, ")")
113: 	if openCount != closeCount {
114: 		result.Errors = append(result.Errors, fmt.Sprintf("Unbalanced parentheses: %d open, %d close", openCount, closeCount))
115: 	}
116: 
117: 	// Must contain msg
118: 	if !strings.Contains(rule, "msg:") {
119: 		result.Errors = append(result.Errors, "Rule must contain 'msg:' field")
120: 	}
121: 
122: 	// Extract message for display
123: 	msgRegex := regexp.MustCompile(`msg:\s*"([^"]+)"`)
124: 	if matches := msgRegex.FindStringSubmatch(rule); len(matches) > 1 {
125: 		result.Message = matches[1]
126: 	}
127: 
128: 	return nil
129: }
130: 
131: // validateSID extracts and validates the SID
132: func validateSID(rule string, result *ValidationResult) error {
133: 	// Extract SID using regex
134: 	sidRegex := regexp.MustCompile(`sid:\s*(\d+)\s*;`)
135: 	matches := sidRegex.FindStringSubmatch(rule)
136: 
137: 	if len(matches) < 2 {
138: 		result.Errors = append(result.Errors, "Rule must contain 'sid:' field")
139: 		return nil
140: 	}
141: 
142: 	sid, err := strconv.Atoi(matches[1])
143: 	if err != nil {
144: 		result.Errors = append(result.Errors, fmt.Sprintf("Invalid SID format: %s", matches[1]))
145: 		return nil
146: 	}
147: 
148: 	result.SID = sid
149: 
150: 	// Validate SID range for custom rules
151: 	if sid < MinCustomSID || sid > MaxCustomSID {
152: 		result.Errors = append(result.Errors, fmt.Sprintf("Custom rule SID must be in range %d-%d (got %d)", MinCustomSID, MaxCustomSID, sid))
153: 	}
154: 
155: 	// Check for revision
156: 	if !strings.Contains(rule, "rev:") {
157: 		result.Errors = append(result.Errors, "Rule should contain 'rev:' field (recommended)")
158: 	}
159: 
160: 	return nil
161: }
162: 
163: // validateWithSuricata validates rule syntax using suricata binary
164: func validateWithSuricata(rule string, result *ValidationResult) error {
165: 	// Check if suricata is available
166: 	if _, err := exec.LookPath("suricata"); err != nil {
167: 		return fmt.Errorf("suricata binary not found")
168: 	}
169: 
170: 	// Create temporary rule file content
171: 	// We use echo and pipe to avoid file creation
172: 	cmd := exec.Command("suricata", "-T", "-S", "-")
173: 	cmd.Stdin = strings.NewReader(rule + "\n")
174: 
175: 	output, err := cmd.CombinedOutput()
176: 	if err != nil {
177: 		// Parse error from output
178: 		outputStr := string(output)
179: 		if strings.Contains(outputStr, "ERROR") || strings.Contains(outputStr, "WARN") {
180: 			// Extract error message
181: 			lines := strings.Split(outputStr, "\n")
182: 			for _, line := range lines {
183: 				if strings.Contains(line, "ERROR") || strings.Contains(line, "WARN") {
184: 					result.Errors = append(result.Errors, "Suricata validation: "+line)
185: 				}
186: 			}
187: 		} else {
188: 			result.Errors = append(result.Errors, fmt.Sprintf("Suricata validation failed: %v", err))
189: 		}
190: 	}
191: 
192: 	return nil
193: }

# (orphaned the capitalised "# NFTBan firewall configuration" comment) and only
# ran on purge — so duplicate comments accumulated and `remove` (non-purge) left
# a dangling include pointing at a deleted /etc/nftban/nftables.conf.
# >>> NFTBAN_STRIP_FN_BEGIN >>>
_nftban_strip_conf_include() {
    _f="$1"
    [ -f "$_f" ] || return 0
    _tmp="${_f}.nftban-strip.$$"
    awk '
        $0 == "# >>> nftban firewall include (managed; do not edit between markers) >>>" { infence=1; next }
        $0 == "# <<< nftban firewall include (managed) <<<" { infence=0; next }
        infence { next }
        $0 == "# NFTBan firewall configuration" { next }
        index($0, "\"/etc/nftban/nftables.conf\"") > 0 { next }
        { print }
    ' "$_f" > "$_tmp" 2>/dev/null || { rm -f "$_tmp" 2>/dev/null || true; return 0; }
    # Replace in place (cat-redirect preserves inode/owner/mode + statoverride).
    # Guard against awk truncation: only commit when output is non-empty OR the
    # original was already empty (a distro nftables.conf is never only-our-lines).
    if [ -s "$_tmp" ] || [ ! -s "$_f" ]; then
        cat "$_tmp" > "$_f" 2>/dev/null || true
    fi
    rm -f "$_tmp" 2>/dev/null || true
}
# <<< NFTBAN_STRIP_FN_END <<<

# >>> NFTBAN_RELEASE_TABLES_BEGIN >>>
# v1.238 (owner 2026-11-24, audit KERNEL_WRITER_AUDIT_d016f838 V2): flush and delete the
# nftban ip/ip6 tables under the CANONICAL write boundary /run/nftban-writers/nft_writers.lock
# (root only; fhs-spec, tmpfiles). The pre-v1.238 lines locked /run/nftban/nft_writers.lock,
# a file no other writer uses (the boundary moved in v1.236), and RPM postun had already
# removed /run/nftban. Same protocol as nft_writers.sh nftban_writers_acquire: publish the
# intent, wait at most 60 s for LOCK_EX. nft_writers.lock is not under the one-release
# legacy-path rule (that covers nft_operations / session_whitelist / maintenance locks).
# BUSY = NOT REMOVED (owner 2026-11-24): no table is touched without the lock, the existing
# nftban rules stay active, and the WARN gives a retry that holds the same lock for the whole
# intervention. REPORT, DO NOT ABORT, as in _nftban_uninstall_synproxy_raw: the package
# removal itself does not fail on it.
# INTENT: removed only on success and only while it still holds exactly what this scriptlet
# wrote; never on the busy path (it may belong to another writer by then).
# Byte-identical copies: packaging/deb/postrm, packaging/build_nftban.sh (RPM postun) -
# drift-checked by cli/lib/nftban/tests/uninstall_release_tables_lock_v1238_test.sh.
_nftban_release_tables() {
    command -v nft >/dev/null 2>&1 || return 0
    _nrt_dir=/run/nftban-writers
    # nftban:held - operator text, runs every nft step under the same flock
    _nrt_retry="flock -w 60 $_nrt_dir/nft_writers.lock sh -c 'nft delete table ip nftban; nft delete table ip6 nftban'"
    [ -d "$_nrt_dir" ] || mkdir -m 0700 "$_nrt_dir" 2>/dev/null || true
    if ! command -v flock >/dev/null 2>&1 || ! { exec 9>>"$_nrt_dir/nft_writers.lock"; } 2>/dev/null; then
        echo "nftban: WARN: cannot use $_nrt_dir/nft_writers.lock - nftban tables NOT removed; the existing nftban rules stay active." >&2
        return 0
    fi
    _nrt_intent="pid=$$ boot=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)"
    echo "$_nrt_intent" > "$_nrt_dir/nft_writers.intent" 2>/dev/null || true
    if ! flock -w 60 9; then
        exec 9>&-
        echo "nftban: WARN: the nft write boundary ($_nrt_dir/nft_writers.lock) stayed busy for 60s - nftban tables NOT removed; the existing nftban rules stay active. To remove them later, as root, holding the same lock for the whole step: $_nrt_retry" >&2
        return 0
    fi
    # Literal per family (not a loop variable) so scripts/ci/check-uninstall-firewall-safety.sh
    # sees every flush paired with its delete.
    nft flush table ip nftban 2>/dev/null || true  # nftban:held
    nft delete table ip nftban 2>/dev/null || true  # nftban:held
    nft flush table ip6 nftban 2>/dev/null || true  # nftban:held
    nft delete table ip6 nftban 2>/dev/null || true  # nftban:held
    if [ "$(cat "$_nrt_dir/nft_writers.intent" 2>/dev/null)" = "$_nrt_intent" ]; then
        rm -f "$_nrt_dir/nft_writers.intent" 2>/dev/null || true
    fi
    exec 9>&-
    return 0
}
# <<< NFTBAN_RELEASE_TABLES_END <<<

# >>> NFTBAN_SYNPROXY_RAW_CLEANUP_BEGIN >>>
# v1.233.1 BUG-UNINSTALL-DOES-NOT-REMOVE-SYNPROXY-RAW-NOTRACK-RULES.
# NFTBan's SYNPROXY notrack rules live in the FOREIGN tables ip/ip6 raw, chain
# prerouting, outside the nftban tables that uninstall deletes. Until v1.233.0
# they disappeared at uninstall only as a side effect of the daemon Stop()
# re-running the DDoS reconcile; Stop() no longer does that (Stop != Disable).
# SCOPE: delete ONLY rules in <family> raw prerouting whose comment carries the
# NFTBan marker "SYNPROXY: - the comment scope of _nft_cleanup_synproxy_raw
# (cli/lib/nftban/lib/nft_fragment.sh) - by handle, after a successful listing.
# The raw tables, their chains and every other rule are never touched.
# SELF-CONTAINED: DEB postrm and RPM postun run after the payload is gone, so nothing
# here may source a product library. Needs only nft and awk.
# REPORT, DO NOT ABORT: when the kernel cannot be observed (nft missing, listing
# refused) or a delete fails, a WARN naming the residue goes to stderr and the
# function still returns 0 - the package removal itself must not fail on it.
# Byte-identical copies: packaging/deb/postrm, packaging/build_nftban.sh
# (RPM postun), uninstall.sh - drift-checked by
# cli/lib/nftban/tests/uninstall_synproxy_raw_cleanup_v1233_1_test.sh.
_nftban_uninstall_synproxy_raw() {
    _nsr_handles_prog='
        $1 == "chain" && $2 == "prerouting" { inchain = 1; next }
        inchain && $1 == "}" { inchain = 0; next }
        inchain && tolower($0) ~ /comment.*"synproxy:/ && NF >= 3 && $(NF-2) == "#" && $(NF-1) == "handle" && $NF ~ /^[0-9]+$/ { print $NF }'
    if ! command -v nft >/dev/null 2>&1; then
        echo "nftban: WARN: SYNPROXY raw notrack cleanup NOT_OBSERVED: nft not found - check with: nft -a list chain ip raw prerouting; nft -a list chain ip6 raw prerouting" >&2
        return 0
    fi
    if ! _nsr_tables=$(nft list tables 2>&1); then
        echo "nftban: WARN: SYNPROXY raw notrack cleanup NOT_OBSERVED: nft list tables failed: $_nsr_tables" >&2
        return 0
    fi
    for _nsr_fam in ip ip6; do
        _nsr_present=$(awk -v want="table $_nsr_fam raw" '$0 == want { found = 1 } END { print found + 0 }' <<_NFTBAN_NSR_
$_nsr_tables
_NFTBAN_NSR_
)
        [ "$_nsr_present" = 1 ] || continue
        if ! _nsr_list=$(nft -a list table "$_nsr_fam" raw 2>&1); then
            echo "nftban: WARN: SYNPROXY raw notrack cleanup NOT_OBSERVED ($_nsr_fam raw): $_nsr_list" >&2
            continue
        fi
        _nsr_handles=$(awk "$_nsr_handles_prog" <<_NFTBAN_NSR_
$_nsr_list
_NFTBAN_NSR_
)
        [ -n "$_nsr_handles" ] || continue
        _nsr_removed=0
        _nsr_failed=0
        for _nsr_h in $_nsr_handles; do
            # nftban:outside-boundary — the foreign ip/ip6 raw table is never part of a replacement.
            if _nsr_err=$(nft delete rule "$_nsr_fam" raw prerouting handle "$_nsr_h" 2>&1); then
                _nsr_removed=$((_nsr_removed + 1))
            else
                _nsr_failed=$((_nsr_failed + 1))
                echo "nftban: WARN: could not delete NFTBan SYNPROXY rule ($_nsr_fam raw prerouting handle $_nsr_h): $_nsr_err" >&2
            fi
        done
        if ! _nsr_list=$(nft -a list table "$_nsr_fam" raw 2>&1); then
            echo "nftban: WARN: SYNPROXY raw notrack cleanup ($_nsr_fam): removed=$_nsr_removed failed=$_nsr_failed remaining=NOT_OBSERVED: $_nsr_list" >&2
            continue
        fi
        _nsr_rest=$(awk "$_nsr_handles_prog" <<_NFTBAN_NSR_
$_nsr_list
_NFTBAN_NSR_
)
        _nsr_left=0
        for _nsr_h in $_nsr_rest; do
            _nsr_left=$((_nsr_left + 1))
        done
        if [ "$_nsr_left" -eq 0 ] && [ "$_nsr_failed" -eq 0 ]; then
            echo "nftban: removed $_nsr_removed NFTBan SYNPROXY notrack rule(s) from $_nsr_fam raw prerouting; other raw rules left untouched."
        else
            echo "nftban: WARN: SYNPROXY raw notrack cleanup ($_nsr_fam): removed=$_nsr_removed failed=$_nsr_failed remaining=$_nsr_left - remove manually: nft -a list chain $_nsr_fam raw prerouting" >&2
        fi
    done
    return 0
}
# <<< NFTBAN_SYNPROXY_RAW_CLEANUP_END <<<

# >>> NFTBAN_INSTALL_STATE_RETIRE_BEGIN >>>
# v1.235 BUG-INSTALL-STATE-SAYS-COMMITTED-AFTER-PACKAGE-REMOVE (K1).
# Package removal used to leave /var/lib/nftban/state/install_state untouched, so a
# removed host still claimed INSTALL_STATE=COMMITTED (or whatever the last install
# wrote) with no package behind it. On a COMPLETE removal only (DEB postrm remove,
# RPM postun $1 -eq 0) the file is moved aside, not deleted: the forensic record of
# the last install survives as install_state.removed-<UTC>, and nothing claims a
# current install any more. A later install starts from no state, exactly like a
# fresh host. Purge (DEB) removes /var/lib/nftban as before.
# SELF-CONTAINED: runs after the payload is gone, sources nothing. REPORT, DO NOT
# ABORT: a failed move is reported on stderr and the removal still succeeds.
# Byte-identical copies: packaging/deb/postrm, RPM postun scriptlet of the generated spec
# (rendered from packaging/build_nftban.sh) - drift-checked by
# cli/lib/nftban/tests/remove_retires_install_state_v1235_test.sh.
_nftban_retire_install_state() {
    _nis_dir="${NFTBAN_INSTALL_STATE_DIR:-/var/lib/nftban/state}"
    _nis_f="$_nis_dir/install_state"
    [ -f "$_nis_f" ] || return 0
    _nis_ts=$(date -u -Iseconds 2>/dev/null) || _nis_ts=unknown
    _nis_to="$_nis_dir/install_state.removed-$_nis_ts"
    if mv -f "$_nis_f" "$_nis_to" 2>/dev/null; then
        echo "nftban: install state retired (package removed): $_nis_to"
    else
        echo "nftban: WARN: could not retire $_nis_f - it still records the last install state" >&2
    fi
    return 0
}
# <<< NFTBAN_INSTALL_STATE_RETIRE_END <<<

# =============================================================================
# v1.238 operator configuration backup (owner GO 2026-11-23; retention R1)
# =============================================================================
# dpkg deletes the shipped config files (conffiles) AFTER `postrm remove` and BEFORE
# `postrm purge`, so the copy is taken in the remove step — the last point where the operator's
# edits still exist — and the purge uses it. Before v1.238 the purge copied the leftovers into a
# predictable, group-readable /var/tmp path with `|| true` on every step, printed "saved" even
# when nothing was copied, then deleted /etc/nftban (BUG-DEB-PURGE-REPORTS-BACKUP-SAVED-THEN-
# DELETES-CONFIG, BUG-DEB-PURGE-RESTORE-SOURCE-REPLACEABLE-BY-LOCAL-USER).
#   - private, uniquely named directory: mktemp -d -> root:root 0700, never an existing path;
#   - contents are tar archives (0600) that keep the original owners and modes for restore;
#   - kept until the operator deletes it (R1); location also written to the journal;
#   - a purge deletes /etc/nftban and /var/lib/nftban ONLY when a valid backup exists.
_NFTBAN_BACKUP_MARK=/var/lib/nftban/.purge-config-backup

_nftban_backup_valid() {  # <dir> : ours, root:root 0700, not a symlink, holds the config archive
    case "$1" in /var/tmp/nftban-config-backup-*) ;; *) return 1 ;; esac
    case "$1" in *..*|*//*) return 1 ;; esac   # VM check D4: no path traversal in the record
    [ -d "$1" ] && [ ! -L "$1" ] || return 1
    [ "$(stat -c '%u:%g:%a' "$1" 2>/dev/null)" = "0:0:700" ] || return 1
    [ -f "$1/etc-nftban.tar" ] && [ ! -L "$1/etc-nftban.tar" ] && [ -s "$1/etc-nftban.tar" ]
}

_nftban_backup_take() {  # prints the new backup directory; rc!=0 = nothing usable was written
    # (the reason is printed on stderr as "nftban: backup failed: ...")
    [ -d /etc/nftban ] || return 1
    _b=$(umask 077; mktemp -d /var/tmp/nftban-config-backup-XXXXXXXX 2>&1) || {
        echo "nftban: backup failed: cannot create a private directory in /var/tmp: $_b" >&2; return 1; }
    if ! _e=$( (umask 077; tar -C / -cpf "$_b/etc-nftban.tar" etc/nftban) 2>&1 ); then
        rm -rf "$_b"; echo "nftban: backup failed: writing $_b/etc-nftban.tar: ${_e:-tar error}" >&2; return 1
    fi
    if [ -d /var/lib/nftban/state ] && ! _e=$( (umask 077; tar -C / -cpf "$_b/var-lib-nftban-state.tar" var/lib/nftban/state) 2>&1 ); then
        rm -rf "$_b"; echo "nftban: backup failed: writing $_b/var-lib-nftban-state.tar: ${_e:-tar error}" >&2; return 1
    fi
    _nftban_backup_valid "$_b" || { rm -rf "$_b"; echo "nftban: backup failed: $_b did not validate (owner/mode/content)" >&2; return 1; }
    printf '%s\n' "$_b"
}

_nftban_backup_add_latest() {  # <dir> : add what still exists now (newer than the remove-step copy)
    # Owner 2026-11-23: remove and purge can be days apart; a valid but older copy is not enough
    # for deletion. The purge adds the current /etc/nftban (and state) as a second archive in the
    # same private directory; restore extracts the remove-step archive first, then this one.
    # VM check D3: a failed archive is removed, never left behind as a partial file.
    if [ -d /etc/nftban ]; then
        (umask 077; tar -C / -cpf "$1/etc-nftban-at-purge.tar" etc/nftban) 2>/dev/null \
            || { rm -f "$1/etc-nftban-at-purge.tar"; return 1; }
    fi
    if [ -d /var/lib/nftban/state ]; then
        (umask 077; tar -C / -cpf "$1/var-lib-nftban-state-at-purge.tar" var/lib/nftban/state) 2>/dev/null \
            || { rm -f "$1/etc-nftban-at-purge.tar" "$1/var-lib-nftban-state-at-purge.tar"; return 1; }
    fi
    return 0
}

_nftban_backup_report() {  # <dir>
    echo "nftban: Configuration backup (root-only, kept until you delete it): $1"
    echo "nftban:   Contents: $(cd "$1" && ls -1 | tr '\n' ' ')"
    echo "nftban:   Restore after reinstalling, as root (checks that the backup is root-owned, 0700 and has no links):"
    # VM check D1: after a reinstall /etc/nftban/nftban.conf carries the package's immutable flag, so
    # extracting it fails (rc 2) and the newer archive was never applied. It is package-managed
    # (operator settings belong in nftban.conf.local), so the restore skips it; its copy stays in the
    # archive.
    echo "nftban:     B=$1; [ ! -L \"\$B\" ] && [ \"\$(stat -c %u:%g:%a \"\$B\")\" = 0:0:700 ] && [ -z \"\$(find \"\$B\" -mindepth 1 ! -type f -print -quit)\" ] && tar -C / -xpf \"\$B/etc-nftban.tar\" --exclude=etc/nftban/nftban.conf etc/nftban && { [ ! -f \"\$B/etc-nftban-at-purge.tar\" ] || tar -C / -xpf \"\$B/etc-nftban-at-purge.tar\" --exclude=etc/nftban/nftban.conf etc/nftban; } && echo restored"
    echo "nftban:   nftban.conf is package-managed and is NOT restored by this command. Your saved copy is in the archive;"
    echo "nftban:     view it:  tar -xOf $1/etc-nftban.tar etc/nftban/nftban.conf"
    echo "nftban:     compare:  tar -xOf $1/etc-nftban.tar etc/nftban/nftban.conf | diff /etc/nftban/nftban.conf -"
    echo "nftban:     then put the settings you changed into /etc/nftban/nftban.conf.local (it overrides nftban.conf)."
    echo "nftban:   (etc-nftban.tar = copy taken at package removal, including shipped config files; etc-nftban-at-purge.tar, when present = newer copy taken at purge, applied second)"
    echo "nftban:   Remove it when no longer needed: rm -rf $1"
    logger -t nftban "configuration backup kept at $1 (root-only; remove with: rm -rf $1)" 2>/dev/null || true
}

case "$1" in
    purge)
        # =============================================================================
        # FULL CLEANUP — must match RPM %postun ($1 -eq 0) section
        # v1.38.0: Added config backup, proper nft cleanup sequence, sysctl removal
        # =============================================================================

        # -----------------------------------------------------------------
        # STEP 1: Backup user configuration before purge
        # -----------------------------------------------------------------
        # v1.238: use the copy the remove step took (it still had the shipped config files);
        # otherwise (purge of an already-removed package, or no valid copy) copy what remains.
        BACKUP_DIR=""
        BACKUP_OK=0
        BACKUP_FAILED_LATEST=0
        if [ -f "$_NFTBAN_BACKUP_MARK" ] && [ ! -L "$_NFTBAN_BACKUP_MARK" ]; then
            _cand=$(head -n 1 "$_NFTBAN_BACKUP_MARK" 2>/dev/null || true)
            if _nftban_backup_valid "$_cand"; then
                if _nftban_backup_add_latest "$_cand"; then
                    BACKUP_DIR="$_cand"
                else
                    echo "nftban: ERROR: could not add the current configuration to $_cand (it may be older than your latest changes)." >&2
                    BACKUP_FAILED_LATEST=1
                fi
            fi
        fi
        if [ -z "$BACKUP_DIR" ] && [ "$BACKUP_FAILED_LATEST" -eq 0 ] && [ -d /etc/nftban ]; then
            echo "nftban: No backup from the remove step; copying the remaining configuration (edits to shipped config files were already removed by dpkg)."
            BACKUP_DIR=$(_nftban_backup_take) || BACKUP_DIR=""
        fi
        if [ -n "$BACKUP_DIR" ] || { [ ! -d /etc/nftban ] && [ ! -d /var/lib/nftban/state ]; }; then
            BACKUP_OK=1
        fi
        if [ "$BACKUP_OK" -ne 1 ]; then
            echo "nftban: ERROR: the configuration backup FAILED. NFTBan will not delete /etc/nftban or /var/lib/nftban." >&2
            logger -t nftban "purge: configuration backup failed; NFTBan kept /etc/nftban and /var/lib/nftban" 2>/dev/null || true
        fi

        # -----------------------------------------------------------------
        # STEP 2: Remove runtime directories
        # -----------------------------------------------------------------
        rm -rf /run/nftban /run/nftban-ui 2>/dev/null || true

        # -----------------------------------------------------------------
        # STEP 3: Purge ALL systemd units (must match DEB prerm + RPM %preun)
        # -----------------------------------------------------------------
        for unit in \
            nftband.socket nftband.service \
            nftban-maintenance.timer nftban-maintenance.service \
            nftban-health.timer nftban-health.service nftban-health-fix.service \
            nftban-watchdog.timer nftban-watchdog.service \
            nftban-login-monitor.service \
            nftban-core-geoip.timer nftban-core-geoip.service \
            nftban-core-feeds.timer nftban-core-feeds.service \
            nftban-unified-exporter.timer nftban-unified-exporter.service \
            nftban-queue.timer nftban-queue.service \
            nftban-rbl-check.timer nftban-rbl-check.service \
            nftban-rollback.timer nftban-rollback.service \
            nftban-snapshot.timer nftban-snapshot.service \
            nftban-suricata-update.timer nftban-suricata-update.service \
            nftban-suricata.service nftban-suricata-stats.service \
            nftban-pro-inventory.timer nftban-pro-inventory.service \
            nftban-pro-license.timer nftban-pro-license.service \
            nftban-update-check.timer nftban-update-check.service \
            nftban-update-apply.timer nftban-update-apply.service \
            nftban-api.service nftban-firewall-init.service \
            nftban-ui.service nftban-ui-auth.socket nftban-ui-auth.service; do
            deb-systemd-helper purge "$unit" >/dev/null 2>&1 || true
            deb-systemd-helper unmask "$unit" >/dev/null 2>&1 || true
        done

        # v1.235: deb-systemd-helper purge removes only links it created; the installer
        # enables with systemctl. Remove every enablement link that still points at an
        # NFTBan PACKAGED unit (boot units, sockets and timers included), even if dangling.
        # A link whose target is anything else (an operator's own unit) is kept.
        for _lnk in /etc/systemd/system/*.wants/* /etc/systemd/system/*.requires/* \
                    /etc/systemd/system/*.upholds/*; do
            [ -L "$_lnk" ] || continue
            _name="${_lnk##*/}"
            case "$_name" in nftband.*|nftban-*) ;; *) continue ;; esac
            case "$(readlink "$_lnk" 2>/dev/null)" in
                "/usr/lib/systemd/system/$_name"|"/lib/systemd/system/$_name")
                    rm -f "$_lnk" && echo "nftban: removed enablement link $_lnk" ;;
            esac
        done
        systemctl daemon-reload 2>/dev/null || true

        # -----------------------------------------------------------------
        # STEP 4: Remove NFTBan include from system nftables config FIRST
        # (must happen BEFORE table deletion so nftables.service won't
        #  try to reload our tables after we delete them)
        # -----------------------------------------------------------------
        for nft_conf in /etc/sysconfig/nftables.conf /etc/nftables.conf; do
            _nftban_strip_conf_include "$nft_conf"
        done

        # -----------------------------------------------------------------
        # STEP 5: Delete nftables tables (CRITICAL — rules persist otherwise)
        # Flush first, then delete to ensure clean removal
        # -----------------------------------------------------------------
        if command -v nft >/dev/null 2>&1; then
            # v1.238: the canonical write boundary (see _nftban_release_tables).
            _nftban_release_tables
        fi

        # STEP 5b: NFTBan SYNPROXY notrack rules in the FOREIGN ip/ip6 raw
        # tables (comment-scoped; tables/chains/operator rules untouched).
        # Reports NOT_OBSERVED instead of failing the purge.
        _nftban_uninstall_synproxy_raw

        # Reload nftables.service so it picks up config without our includes
        if command -v systemctl >/dev/null 2>&1; then
            systemctl reload nftables.service 2>/dev/null || true
        fi

        # -----------------------------------------------------------------
        # STEP 6: Remove auxiliary config files
        # -----------------------------------------------------------------
        rm -f /etc/tmpfiles.d/nftban.conf 2>/dev/null || true
        rm -f /usr/lib/tmpfiles.d/nftban.conf 2>/dev/null || true
        rm -f /etc/logrotate.d/nftban 2>/dev/null || true
        rm -f /etc/logrotate.d/nftban-suricata 2>/dev/null || true
        rm -f /etc/sysctl.d/90-nftban.conf 2>/dev/null || true
        sysctl --system >/dev/null 2>&1 || true

        # Remove polkit policies and rules
        rm -f /usr/share/polkit-1/actions/com.nftban.* 2>/dev/null || true
        rm -f /etc/polkit-1/rules.d/*nftban*.rules 2>/dev/null || true
        rm -f /usr/share/polkit-1/rules.d/*nftban*.rules 2>/dev/null || true

        # v1.147-A: unload + remove the nftband AppArmor profile (guarded; no-op
        # when AppArmor absent). The profile is a conffile under /etc/apparmor.d/;
        # unload it from the kernel here and remove the file on purge.
        if command -v apparmor_parser >/dev/null 2>&1 && [ -f /etc/apparmor.d/usr.lib.nftban.bin.nftband ]; then
            apparmor_parser -R /etc/apparmor.d/usr.lib.nftban.bin.nftband 2>/dev/null || true
        fi
        rm -f /etc/apparmor.d/usr.lib.nftban.bin.nftband 2>/dev/null || true

        # Remove yq symlink (only if it points to our bundled binary)
        if [ -L /usr/bin/yq ] && readlink /usr/bin/yq | grep -q nftban; then
            rm -f /usr/bin/yq 2>/dev/null || true
        fi

        # -----------------------------------------------------------------
        # STEP 6b: Remove dpkg-statoverride entries registered by postinst
        # (PKG-EFFECTIVE-PARITY Slot 5a / row 14)
        # -----------------------------------------------------------------
        # Postinst registered statoverride for each path in the attrs list so
        # dpkg --verify stays clean against the DEB DB (which records root:root
        # for these paths because the archive ships them that way and ownership
        # converges at install time, not in the archive). On purge, remove the
        # override entries so the dpkg DB is clean. Tolerate missing list (e.g.
        # if the package was installed before this convergence model existed).
        # MUST run before STEP 7's rm -rf /usr/share/nftban (which would also
        # delete the attrs list itself).
        _nftban_attrs="/usr/share/nftban/packaging/nftban-dir-attrs.list"
        if [ -r "$_nftban_attrs" ] && command -v dpkg-statoverride >/dev/null 2>&1; then
            while IFS='|' read -r _attr_path _attr_mode _attr_owner _attr_group; do
                case "$_attr_path" in
                    ""|"#"*) continue ;;
                esac
                if dpkg-statoverride --list "$_attr_path" >/dev/null 2>&1; then
                    dpkg-statoverride --remove "$_attr_path" >/dev/null 2>&1 || true
                fi
            done < "$_nftban_attrs"
            unset _attr_path _attr_mode _attr_owner _attr_group
        fi
        unset _nftban_attrs

        # -----------------------------------------------------------------
        # STEP 7: Remove ALL configuration, data, logs, cache directories
        # (v1.238: configuration and state only when STEP 1 has a valid backup)
        # -----------------------------------------------------------------
        if [ "$BACKUP_OK" -eq 1 ]; then
            rm -rf /etc/nftban 2>/dev/null || true
            rm -rf /var/lib/nftban 2>/dev/null || true
        fi
        rm -rf /var/log/nftban 2>/dev/null || true
        rm -rf /var/cache/nftban 2>/dev/null || true
        rm -rf /usr/share/nftban 2>/dev/null || true

        if [ "$BACKUP_OK" -eq 1 ]; then
            echo "nftban: Complete purge finished."
            if [ -n "$BACKUP_DIR" ]; then _nftban_backup_report "$BACKUP_DIR"; fi
        else
            # Owner 2026-11-23: name exactly what NFTBan kept and where — dpkg itself has already
            # removed the package files and the shipped config files before this script ran.
            echo "nftban: Purge finished, but no configuration backup could be written. NFTBan kept, in place:" >&2
            [ -d /etc/nftban ] && echo "nftban:   /etc/nftban        — your remaining configuration (*.local files, white/blacklists, tokens; the shipped config files were already removed by dpkg)" >&2
            [ -d /var/lib/nftban/state ] && echo "nftban:   /var/lib/nftban/state — runtime state" >&2
            [ -d /var/lib/nftban ] && echo "nftban:   /var/lib/nftban    — other NFTBan data (feeds, GeoIP data, records)" >&2
            echo "nftban: Make space or fix /var/tmp, then copy what you need, or delete these directories deliberately." >&2
        fi
        echo "nftban: User accounts/groups preserved (manual: userdel nftban; groupdel nftban)."
        ;;

    remove)
        # v1.238: the configuration backup is taken by `prerm remove`, before dpkg removes anything;
        # a failed backup stops the removal there (owner 2026-11-23). Nothing to do here for it.

        # v1.222.1 HEALTH-OOM Lane 2 BACKSTOP: remove the NFTBan-generated
        # health-resource systemd drop-in (generated state, NOT payload; primary
        # owner is the Go installer's uninstall path). Path-only — NO RAM/tier/policy
        # calculation. Administrator sibling drop-ins are preserved. Must match the
        # RPM %postun ($1 -eq 0) STEP 2b snippet.
        _nftban_hr_dropin=/etc/systemd/system/nftban-health.service.d/20-nftban-resource-profile.conf
        if [ -f "$_nftban_hr_dropin" ]; then
            rm -f "$_nftban_hr_dropin" 2>/dev/null || true
            rmdir /etc/systemd/system/nftban-health.service.d 2>/dev/null || true
            systemctl daemon-reload 2>/dev/null || true
        fi

        # v1.221.3: On non-purge remove, DELETE the NFTBan tables (do NOT merely
        # flush them). The pre-v1.221.3 code flushed `table ip nftban` /
        # `table ip6 nftban` but KEPT the tables — leaving the base `input` chain
        # with `type filter hook input priority filter; policy drop;` and ZERO
        # accept rules. With the daemon gone, that empty drop-policy chain silently
        # dropped ALL inbound traffic (SSH, ping) until a reboot tore down the
        # ruleset — the CONFIRMED uninstall-connectivity defect that could lock an
        # administrator out of a remote host. Deleting the tables removes the
        # drop-policy chain entirely: connectivity is preserved and NO reboot is
        # needed. Config under /etc/nftban IS still retained for reinstall
        # (deleting runtime nftables objects is NOT deleting configuration);
        # reinstall re-renders the tables from config. Absent tables = success.
        # INVARIANT: package removal must never leave an NFTBan base chain with
        # policy drop after its accept rules are gone.
        if command -v nft >/dev/null 2>&1; then
            # v1.238: the canonical write boundary (see _nftban_release_tables).
            _nftban_release_tables
        fi

        # v1.233.1: NFTBan SYNPROXY notrack rules in the FOREIGN ip/ip6 raw
        # tables are not inside the nftban tables deleted above. Remove them
        # here (comment-scoped; see _nftban_uninstall_synproxy_raw). Not gated
        # on nft: the function reports NOT_OBSERVED itself when nft is gone.
        _nftban_uninstall_synproxy_raw

        # v1.235 K1: a removed package must not leave install_state claiming the
        # last install (COMMITTED). Moved aside, not deleted; see the function.
        _nftban_retire_install_state

        # D5 (UNINSTALL-PR2): the operator message is NOT gated on `nft` being
        # present. It used to sit inside the guard above, so on a host where the
        # package manager's dependency cleanup had already removed the nftables
        # tooling — the one case where the warning matters most — removal printed
        # nothing at all. Enforcement is gone whether or not `nft` survives to
        # confirm it, so the disclosure must not depend on the tool.
        #
        # The claim that other firewall rules "were NOT modified and may still be
        # active" is DELETED, not reworded: nothing in this scriptlet observes
        # other firewall authorities, and on the proven EL9 host it was false.
        # Parity with the RPM %postun is on this truth contract, not on wording.
        echo "nftban: NFTBan has been removed."
        echo "nftban: NFTBan-owned nftables tables and enforcement rules were deleted — NFTBan no longer protects this host."
        echo "nftban: Review the resulting firewall state before exposing services:  sudo nft list ruleset"
        echo "nftban: nftables tooling may have been removed by package-manager dependency cleanup."
        echo "nftban: To restore NFTBan protection, reinstall/start NFTBan and validate the rebuilt firewall policy."
        echo "nftban: Config preserved in /etc/nftban/. Purge with: apt remove --purge nftban-core"

        # v1.146 Phase-D D-NFTABLES-POSTRM-MARKER-IDEMPOTENCY (remove-branch gap):
        # On `remove` (non-purge) the package files are gone, so the distro
        # include would dangle at a deleted /etc/nftban/nftables.conf — a plain
        # `systemctl reload nftables.service` would then error on the missing
        # include. Strip our fenced block here too (config under /etc/nftban is
        # preserved for reinstall, but the *distro-file* include must not dangle).
        for nft_conf in /etc/sysconfig/nftables.conf /etc/nftables.conf; do
            _nftban_strip_conf_include "$nft_conf"
        done

        # v1.147-A: unload the nftband AppArmor profile (guarded; no-op when
        # AppArmor absent). On non-purge `remove` the conffile is kept by dpkg
        # for reinstall — unload from the kernel only, do NOT delete the file.
        if command -v apparmor_parser >/dev/null 2>&1 && [ -f /etc/apparmor.d/usr.lib.nftban.bin.nftband ]; then
            apparmor_parser -R /etc/apparmor.d/usr.lib.nftban.bin.nftband 2>/dev/null || true
        fi
        ;;

    abort-install|abort-upgrade)
        # v1.234 (PR #1439): the install/upgrade failed after this package's
        # preinst unlocked NFTBan's own proven immutable flags; re-apply exactly
        # those (record-proven: same inode and ctime) and report what could not be.
        nftban_immut_relock_owned | while read -r _st _p; do echo "nftban: immutable flag $_st: $_p" >&2; done
        ;;

    upgrade|failed-upgrade|disappear)
        # Nothing to do
        ;;
esac

#DEBHELPER#

exit 0

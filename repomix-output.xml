328: 			count = c
329: 		}
330: 	}
331: 
332: 	sampler := metrics.GetSampler()
333: 	samples := sampler.GetRecentSamples(count)
334: 
335: 	respondJSON(w, http.StatusOK, map[string]interface{}{
336: 		"count":   len(samples),
337: 		"samples": samples,
338: 	})
339: }

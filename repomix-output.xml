292: 	defer file.Close()
293: 
294: 	rules := make([]*CustomRule, 0)
295: 	scanner := bufio.NewScanner(file)
296: 
297: 	for scanner.Scan() {
298: 		line := scanner.Text()
299: 		trimmed := strings.TrimSpace(line)
300: 
301: 		// Skip empty lines and header comments
302: 		if trimmed == "" || strings.HasPrefix(trimmed, "# NFTBan") || strings.HasPrefix(trimmed, "# SID") {
303: 			continue
304: 		}
305: 
306: 		// Check if disabled (commented)
307: 		enabled := !strings.HasPrefix(trimmed, "#")
308: 		if !enabled {
309: 			trimmed = strings.TrimPrefix(trimmed, "#")
310: 			trimmed = strings.TrimSpace(trimmed)
311: 		}
312: 
313: 		// Skip if not a rule line
314: 		if !strings.Contains(trimmed, "sid:") {
315: 			continue
316: 		}
317: 
318: 		// Validate to extract metadata
319: 		result, err := ValidateRule(trimmed)
320: 		if err != nil {
321: 			continue // Skip invalid rules
322: 		}
323: 
324: 		rule := &CustomRule{
325: 			SID:      result.SID,
326: 			FilePath: m.customFile,
327: 			Rule:     trimmed,
328: 			Message:  result.Message,
329: 			Action:   result.Action,
330: 			Enabled:  enabled,
331: 		}
332: 
333: 		rules = append(rules, rule)
334: 	}
335: 
336: 	if err := scanner.Err(); err != nil {
337: 		return nil, fmt.Errorf("error reading custom.rules: %w", err)
338: 	}
339: 
340: 	return rules, nil
341: }

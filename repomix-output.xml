<file path="cli/lib/nftban/exporters/nftban_firewall_exporter.sh">
  1: #!/usr/bin/env bash
  2: # ====================================================================
  3: # NFTBan v1.0.0
  4: # Script: nftban_firewall_exporter.sh
  5: # Description: Prometheus exporter for NFTables firewall metrics
  6: # Author: Antonios Voulvoulis
  7: # License: GPL-3.0
  8: #
  9: # Meta Information:
 10: # meta:version=1.0.0
 11: # meta:category=exporter
 12: # meta:priority=high
 13: # meta:dependencies=nft,bc
 14: # ====================================================================
 15: 
 16: set -euo pipefail
 17: IFS=$'\n\t'
 18: 
 19: # Source central config for canonical paths (NO HARDCODED FALLBACKS)
 20: # shellcheck source=/etc/nftban/nftban.conf
 21: [[ -f "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf" ]] && source "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf"
 22: 
 23: # ====================================================================
 24: # LIBRARY LOADING
 25: # ====================================================================
 26: 
 27: # Determine library path
 28: NFTBAN_LIB_DIR="${NFTBAN_LIB_DIR}"
 29: 
 30: # Source common exporter utilities
 31: if [[ -f "${NFTBAN_LIB_DIR}/lib/exporter_utils.sh" ]]; then
 32:     # shellcheck source=/dev/null
 33:     source "${NFTBAN_LIB_DIR}/lib/exporter_utils.sh"
 34: elif [[ -f "$(dirname "${BASH_SOURCE[0]}")/../lib/exporter_utils.sh" ]]; then
 35:     # shellcheck source=/dev/null
 36:     source "$(dirname "${BASH_SOURCE[0]}")/../lib/exporter_utils.sh"
 37: fi
 38: 
 39: # ====================================================================
 40: # CONFIGURATION
 41: # ====================================================================
 42: 
 43: # Textfile collector output
 44: OUTPUT_FILE="${OUTPUT_FILE:-/var/lib/node_exporter/textfile_collector/nftban_firewall.prom}"
 45: 
 46: # Temporary file for atomic writes
 47: TMP_FILE="${OUTPUT_FILE}.$$"
 48: 
 49: # Cleanup on exit
 50: trap 'rm -f "$TMP_FILE"' EXIT
 51: 
 52: # ====================================================================
 53: # Helper Functions (fallback if library not loaded)
 54: # ====================================================================
 55: 
 56: # Only define if not already loaded from library
 57: if ! declare -f write_metric &>/dev/null; then
 58:     write_metric() {
 59:         local name="$1"
 60:         local type="$2"
 61:         local help="$3"
 62:         shift 3
 63: 
 64:         echo "# HELP ${name} ${help}" >> "$TMP_FILE"
 65:         echo "# TYPE ${name} ${type}" >> "$TMP_FILE"
 66: 
 67:         for line in "$@"; do
 68:             echo "${name}${line}" >> "$TMP_FILE"
 69:         done
 70:     }
 71: fi
 72: 
 73: # ====================================================================
 74: # Collect NFTables Metrics
 75: # ====================================================================
 76: 
 77: collect_nftables_rules() {
 78:     # Total rules count
 79:     local total_rules
 80:     total_rules=$(nft list ruleset 2>/dev/null | grep -c '^[[:space:]]*[^#]' || echo 0)
 81: 
 82:     write_metric "nftban_nftables_rules_total" "gauge" "Total number of nftables rules" \
 83:         " ${total_rules}"
 84: }
 85: 
 86: collect_nftables_chains() {
 87:     # Total chains count
 88:     local total_chains
 89:     total_chains=$(nft list chains 2>/dev/null | grep -c 'chain ' || echo 0)
 90: 
 91:     write_metric "nftban_nftables_chains_total" "gauge" "Total number of nftables chains" \
 92:         " ${total_chains}"
 93: }
 94: 
 95: collect_nftables_sets() {
 96:     # NFTBan sets count
 97:     local nftban_sets=0
 98:     local temp_sets=0
 99:     local perm_sets=0
100: 
101:     if nft list sets 2>/dev/null | grep -q 'nftban'; then
102:         # Use subshell to avoid grep exit code 1 when count is 0
103:         nftban_sets=$(nft list sets 2>/dev/null | grep -c 'set nftban' 2>/dev/null) || nftban_sets=0
104:         temp_sets=$(nft list sets 2>/dev/null | grep -c 'set nftban.*temp' 2>/dev/null) || temp_sets=0
105:         perm_sets=$(nft list sets 2>/dev/null | grep -c 'set nftban.*perm' 2>/dev/null) || perm_sets=0
106:     fi
107: 
108:     write_metric "nftban_nftables_sets_total" "gauge" "Total number of NFTBan nftables sets" \
109:         "{type=\"all\"} ${nftban_sets}" \
110:         "{type=\"temporary\"} ${temp_sets}" \
111:         "{type=\"permanent\"} ${perm_sets}"
112: }
113: 
114: collect_nftables_counters() {
115:     # Packet counters from nftables
116:     local input_packets=0
117:     local forward_packets=0
118:     local output_packets=0
119: 
120:     # Try to get counter stats if available
121:     if nft list chain inet filter input 2>/dev/null | grep -q 'counter'; then
122:         input_packets=$(nft list chain inet filter input 2>/dev/null | \
123:             grep -oP 'packets \K\d+' | head -1 || echo 0)
124:     fi
125: 
126:     if nft list chain inet filter forward 2>/dev/null | grep -q 'counter'; then
127:         forward_packets=$(nft list chain inet filter forward 2>/dev/null | \
128:             grep -oP 'packets \K\d+' | head -1 || echo 0)
129:     fi
130: 
131:     if nft list chain inet filter output 2>/dev/null | grep -q 'counter'; then
132:         output_packets=$(nft list chain inet filter output 2>/dev/null | \
133:             grep -oP 'packets \K\d+' | head -1 || echo 0)
134:     fi
135: 
136:     write_metric "nftban_nftables_packets_total" "counter" "Total packets processed by chain" \
137:         "{chain=\"input\"} ${input_packets}" \
138:         "{chain=\"forward\"} ${forward_packets}" \
139:         "{chain=\"output\"} ${output_packets}"
140: }
141: 
142: collect_drop_stats() {
143:     # Dropped packets count
144:     local dropped=0
145: 
146:     if nft list ruleset 2>/dev/null | grep -q 'drop'; then
147:         # This is approximate - actual drop counters depend on ruleset
148:         dropped=$(nft list ruleset 2>/dev/null | grep -c 'drop' || echo 0)
149:     fi
150: 
151:     write_metric "nftban_nftables_drop_rules" "gauge" "Number of drop rules" \
152:         " ${dropped}"
153: }
154: 
155: # ====================================================================
156: # Main Collection Function
157: # ====================================================================
158: 
159: main() {
160:     local start_time
161:     start_time=$(date +%s.%N)
162: 
163:     # Initialize output file
164:     : > "$TMP_FILE"
165: 
166:     # Collect all metrics
167:     collect_nftables_rules
168:     collect_nftables_chains
169:     collect_nftables_sets
170:     collect_nftables_counters
171:     collect_drop_stats
172: 
173:     # Collection duration
174:     local end_time
175:     end_time=$(date +%s.%N)
176:     local duration
177:     duration=$(echo "$end_time - $start_time" | bc)
178: 
179:     write_metric "nftban_firewall_exporter_duration_seconds" "gauge" \
180:         "Time taken to collect firewall metrics" " ${duration}"
181: 
182:     # Last update timestamp
183:     write_metric "nftban_firewall_exporter_last_update" "gauge" \
184:         "Unix timestamp of last successful collection" " $(date +%s)"
185: 
186:     # Atomic move
187:     mv "$TMP_FILE" "$OUTPUT_FILE"
188: 
189:     # Set permissions
190:     chmod 644 "$OUTPUT_FILE"
191: }
192: 
193: # ====================================================================
194: # Execute
195: # ====================================================================
196: 
197: main "$@"
</file>


 936:     else if (data.warnings > 0) statusClass = 'warning';
 937: 
 938:     let html = `
 939:         <div style="margin-bottom: 20px;">
 940:             <span class="health-status ${statusClass}">
 941:                 <i class="fa fa-${statusClass === 'ok' ? 'check-circle' : statusClass === 'warning' ? 'triangle-exclamation' : 'times-circle'}"></i>
 942:                 Health: ${data.status || 'Unknown'} (${data.errors || 0} errors, ${data.warnings || 0} warnings)
 943:             </span>
 944:         </div>
 945:     `;
 946: 
 947:     if (data.errors_list && data.errors_list.length > 0) {
 948:         html += '<h4 style="color:var(--danger);"><i class="fa fa-times-circle"></i> Errors</h4><ul>';
 949:         data.errors_list.forEach(e => html += `<li style="color:var(--danger);">${e}</li>`);
 950:         html += '</ul>';
 951:     }
 952: 
 953:     if (data.warnings_list && data.warnings_list.length > 0) {
 954:         html += '<h4 style="color:#eab308;"><i class="fa fa-triangle-exclamation"></i> Warnings</h4><ul>';
 955:         data.warnings_list.forEach(w => html += `<li style="color:#eab308;">${w}</li>`);
 956:         html += '</ul>';
 957:     }
 958: 
 959:     if (data.checks && data.checks.length > 0) {
 960:         html += '<h4><i class="fa fa-list-check"></i> All Checks</h4>';

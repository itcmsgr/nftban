#!/usr/bin/env bash
# NFTBan v0.10.0 - Ban Management Backend
# Production-ready ban management with:
# - Two-table architecture (runtime + main)
# - Fail2ban integration with temp bans
# - Persistent offender detection
# - Comprehensive logging and statistics
# - Master enable/disable switch

set -euo pipefail
IFS=$'\n\t'
umask 027

# ═══════════════════════════════════════════════════════════════════════════
# CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

STATE_DIR="/var/lib/nftban"
LOG_DIR="/var/log/nftban"
DB_PATH="$STATE_DIR/nftban.db"
RUNTIME_NFT="/usr/lib/nftban/nft-runtime.nft"

ETC_DIR="/etc/nftban"
PORTS_DIR="$ETC_DIR/ports.d"
WL_DIR="$ETC_DIR/whitelist.d"
BL_DIR="$ETC_DIR/blacklist.d"

RUNDIR="/run/nftban"

SYSTEMD_NFTBAN="nftban.service"
SYSTEMD_FAIL2BAN="fail2ban.service"

TEMPLATE_DIR="/usr/share/nftban/templates/fail2ban"
JAIL_DIR="/etc/fail2ban/jail.d"
ACTION_DIR="/etc/fail2ban/action.d"

# Persistent offender settings
PERSISTENT_THRESHOLD=3
PERSISTENT_WINDOW_S=$((24*3600))
BLACKLIST_FILE="$BL_DIR/30-persistent-offenders.conf"

# Ensure directories exist
mkdir -p "$STATE_DIR" "$LOG_DIR" "$RUNDIR"

# ═══════════════════════════════════════════════════════════════════════════
# LOGGING
# ═══════════════════════════════════════════════════════════════════════════

# JSON logging for machine-readable events
nftban_log_json() {
  local level="$1"; shift
  local event="$1"; shift
  local ts
  ts="$(date -u +'%Y-%m-%dT%H:%M:%SZ')"
  printf '{"ts":"%s","level":"%s","event":"%s",%s}\n' \
    "$ts" "$level" "$event" "$(echo "$*" | sed 's/^ *//; s/ *$//')" \
    | tee -a "$LOG_DIR/nftban-actions.log" >/dev/null 2>&1
}

# ═══════════════════════════════════════════════════════════════════════════
# SQLITE INITIALIZATION
# ═══════════════════════════════════════════════════════════════════════════

have_sqlite=0
if command -v sqlite3 >/dev/null 2>&1; then
  have_sqlite=1
  if [ ! -f "$DB_PATH" ]; then
    sqlite3 "$DB_PATH" <<'SQL'
PRAGMA journal_mode=WAL;
CREATE TABLE IF NOT EXISTS bans (
  ip TEXT NOT NULL,
  jail TEXT NOT NULL,
  source TEXT NOT NULL,
  ts INTEGER NOT NULL
);
CREATE INDEX IF NOT EXISTS idx_bans_ip_ts ON bans(ip, ts);
CREATE INDEX IF NOT EXISTS idx_bans_jail_ts ON bans(jail, ts);
SQL
    nftban_log_json info db_init '"message":"Created SQLite database"'
  fi
fi

# ═══════════════════════════════════════════════════════════════════════════
# RUNTIME TABLE MANAGEMENT
# ═══════════════════════════════════════════════════════════════════════════

ensure_runtime_table() {
  if ! nft list table inet nftban_runtime >/dev/null 2>&1; then
    if [ -f "$RUNTIME_NFT" ]; then
      nft -f "$RUNTIME_NFT"
      nftban_log_json info runtime_init '"message":"Created nftban_runtime table"'
    else
      echo "ERROR: Runtime table file not found: $RUNTIME_NFT" >&2
      return 1
    fi
  fi
}

# ═══════════════════════════════════════════════════════════════════════════
# STATIC TABLE BUILDER
# ═══════════════════════════════════════════════════════════════════════════

nftban_build_main() {
  set -euo pipefail

  local OUT="$RUNDIR/nftban_main.nft"

  # ---- Collect data -------------------------------------------------------

  # Whitelist (v4 and v6)
  mapfile -t WL4 < <(grep -h -v '^\s*$' "$WL_DIR"/*.conf 2>/dev/null | grep -v '^\s*#' | awk '{print $1}' | awk '$0 !~ /:/' | sort -u) || true
  mapfile -t WL6 < <(grep -h -v '^\s*$' "$WL_DIR"/*.conf 2>/dev/null | grep -v '^\s*#' | awk '{print $1}' | awk '$0 ~ /:/' | sort -u) || true

  # Blacklist (v4 and v6)
  mapfile -t BL4 < <(grep -h -v '^\s*$' "$BL_DIR"/*.conf 2>/dev/null | grep -v '^\s*#' | awk '{print $1}' | awk '$0 !~ /:/' | sort -u) || true
  mapfile -t BL6 < <(grep -h -v '^\s*$' "$BL_DIR"/*.conf 2>/dev/null | grep -v '^\s*#' | awk '{print $1}' | awk '$0 ~ /:/' | sort -u) || true

  # Ports (TCP/UDP, with single ports and ranges)
  local -a TCP_PORT_ELEMS=()
  local -a UDP_PORT_ELEMS=()

  if compgen -G "$PORTS_DIR/*.conf" >/dev/null 2>&1; then
    while IFS= read -r line; do
      line="${line%%#*}"; line="$(echo "$line" | xargs)"
      [ -z "$line" ] && continue
      IFS='|' read -r port spec <<<"$line"
      case "$spec" in
        T|t)
          TCP_PORT_ELEMS+=("$port")
          ;;
        U|u)
          UDP_PORT_ELEMS+=("$port")
          ;;
        B|b)
          TCP_PORT_ELEMS+=("$port")
          UDP_PORT_ELEMS+=("$port")
          ;;
        *)
          echo "WARN: Unknown proto spec in ports.d: $line" >&2
          ;;
      esac
    done < <(grep -h -v '^\s*$' "$PORTS_DIR"/*.conf 2>/dev/null | grep -v '^\s*#')
  fi

  # Helper to render nft set elements list (comma-separated)
  render_csv() {
    local -n arr="$1"
    local first=1 out=""
    for v in "${arr[@]}"; do
      if [ $first -eq 1 ]; then out="$v"; first=0; else out="$out, $v"; fi
    done
    printf '%s' "$out"
  }

  local WL4_CSV WL6_CSV BL4_CSV BL6_CSV TCP_CSV UDP_CSV
  WL4_CSV="$(render_csv WL4)"
  WL6_CSV="$(render_csv WL6)"
  BL4_CSV="$(render_csv BL4)"
  BL6_CSV="$(render_csv BL6)"
  TCP_CSV="$(render_csv TCP_PORT_ELEMS)"
  UDP_CSV="$(render_csv UDP_PORT_ELEMS)"

  # ---- Generate nft file for nftban_main ----------------------------------

  cat > "$OUT" <<'NFT'
# Autogenerated by nftban_build_main
# This file rebuilds the static main table and leaves the runtime table intact.

table inet nftban_main {
  # ---------------- Sets ----------------

  # Whitelist
  set whitelist_v4 {
    type ipv4_addr
    comment "IPv4 whitelist (always wins)"
  }
  set whitelist_v6 {
    type ipv6_addr
    comment "IPv6 whitelist (always wins)"
  }

  # Blacklists (permanent)
  set blacklist_v4 {
    type ipv4_addr
    comment "IPv4 permanent blacklist"
  }
  set blacklist_v6 {
    type ipv6_addr
    comment "IPv6 permanent blacklist"
  }

  # Allowed service ports (set-based for performance)
  set tcp_ports {
    type inet_service
    comment "Allowed TCP ports"
  }
  set udp_ports {
    type inet_service
    comment "Allowed UDP ports"
  }

  # --------------- Chains ----------------
  chain input_main {
    type filter hook input priority -300; policy accept;

    # 1) Always allow established/related and loopback
    ct state established,related accept
    iif lo accept

    # 2) Whitelist always wins
    ip   saddr @whitelist_v4 accept
    ip6  saddr @whitelist_v6 accept

    # 3) Basic ICMP/ICMPv6
    ip   protocol icmp  icmp type { echo-request, echo-reply, destination-unreachable, time-exceeded } accept
    ip6  nexthdr icmpv6 icmpv6 type { echo-request, echo-reply, destination-unreachable, time-exceeded, packet-too-big } accept

    # 4) Allowed service ports
    tcp dport @tcp_ports accept
    udp dport @udp_ports accept

    # 5) Invalid traffic
    ct state invalid drop

    # 6) Permanent blacklists
    ip   saddr @blacklist_v4 drop
    ip6  saddr @blacklist_v6 drop

    # 7) Default drop (policy)
  }
}
NFT

  # ---- Inject set elements ------------------------------------------------

  {
    echo "# --- Populate whitelist sets ---"
    if [ -n "${WL4_CSV:-}" ]; then
      echo "add element inet nftban_main whitelist_v4 { $WL4_CSV }"
    fi
    if [ -n "${WL6_CSV:-}" ]; then
      echo "add element inet nftban_main whitelist_v6 { $WL6_CSV }"
    fi

    echo "# --- Populate blacklist sets ---"
    if [ -n "${BL4_CSV:-}" ]; then
      echo "add element inet nftban_main blacklist_v4 { $BL4_CSV }"
    fi
    if [ -n "${BL6_CSV:-}" ]; then
      echo "add element inet nftban_main blacklist_v6 { $BL6_CSV }"
    fi

    echo "# --- Populate allowed ports ---"
    if [ -n "${TCP_CSV:-}" ]; then
      echo "add element inet nftban_main tcp_ports { $TCP_CSV }"
    fi
    if [ -n "${UDP_CSV:-}" ]; then
      echo "add element inet nftban_main udp_ports { $UDP_CSV }"
    fi
  } >> "$OUT"

  # ---- Apply the rules ----------------------------------------------------

  nft -c -f "$OUT" || { echo "ERROR: nftables validation failed!"; cat "$OUT"; return 1; }

  # ATOMIC RELOAD: Flush all rules/chains but keep sets (preserves data)
  if nft list table inet nftban_main >/dev/null 2>&1; then
    nft flush table inet nftban_main
  fi

  # Now load the new rules (no duplicates because we flushed first)
  nft -f "$OUT"

  nftban_log_json info reload '"message":"Reloaded nftban_main from configs"'
  echo "✓ nftban_main applied from $OUT"
}

# ═══════════════════════════════════════════════════════════════════════════
# FAIL2BAN BAN IMPLEMENTATION
# ═══════════════════════════════════════════════════════════════════════════

to_seconds() {
  case "$1" in
    *h) echo $(( ${1%h} * 3600 ));;
    *m) echo $(( ${1%m} * 60 ));;
    *s) echo $(( ${1%s} ));;
    *) echo "$1";;
  esac
}

nftban_fail2ban_ban() {
  local ip bantime source jail
  ip="$1"; shift
  bantime=""
  source="unknown"
  jail="unknown"

  while [ $# -gt 0 ]; do
    case "$1" in
      --temp) : ;;
      --timeout) bantime="$2"; shift ;;
      --source) source="$2"; shift ;;
      --jail) jail="$2"; shift ;;
      *) ;;
    esac
    shift
  done

  local timeout_s
  timeout_s="$(to_seconds "${bantime:-3600}")"

  ensure_runtime_table || return 1

  local fam
  if [[ "$ip" == *:* ]]; then
    nft add element inet nftban_runtime temp_ban_v6 "{ $ip timeout ${timeout_s}s }"
    fam="ipv6"
  else
    nft add element inet nftban_runtime temp_ban_v4 "{ $ip timeout ${timeout_s}s }"
    fam="ipv4"
  fi

  nftban_fail2ban_track_offender "$ip" "$jail" "$source" "$timeout_s"

  nftban_log_json info ban \
    "\"ip\":\"$ip\",\"family\":\"$fam\",\"type\":\"temp\",\"timeout\":\"${timeout_s}s\",\"source\":\"$source\",\"jail\":\"$jail\",\"result\":\"success\""
}

nftban_fail2ban_track_offender() {
  local ip="$1" jail="$2" source="$3" timeout_s="$4"
  local epoch
  epoch="$(date +%s)"

  printf '%s [BAN] ip=%s jail=%s timeout=%ss source=%s\n' \
    "$(date +'%Y-%m-%d %H:%M:%S')" "$ip" "$jail" "$timeout_s" "$source" \
    >> "$LOG_DIR/fail2ban-bans.log"

  if [ "$have_sqlite" -eq 1 ]; then
    sqlite3 "$DB_PATH" "INSERT INTO bans(ip,jail,source,ts) VALUES('$ip','$jail','$source',$epoch);" || true
  else
    echo -e "$epoch\t$ip\t$jail\t$source" >> "$STATE_DIR/bans.tsv"
  fi

  nftban_fail2ban_check_persistent "$ip" "$jail"
}

nftban_fail2ban_check_persistent() {
  local ip="$1" jail="$2"
  local now since count
  now="$(date +%s)"
  since=$(( now - PERSISTENT_WINDOW_S ))

  count=0
  if [ "$have_sqlite" -eq 1 ]; then
    count="$(sqlite3 "$DB_PATH" "SELECT COUNT(*) FROM bans WHERE ip='$ip' AND ts >= $since;" 2>/dev/null || echo 0)"
  else
    if [ -f "$STATE_DIR/bans.tsv" ]; then
      count="$(awk -v since="$since" -v ip="$ip" '$1>=since && $2==ip{c++} END{print c+0}' "$STATE_DIR/bans.tsv")"
    fi
  fi

  if [ "${count:-0}" -ge "$PERSISTENT_THRESHOLD" ]; then
    mkdir -p "$(dirname "$BLACKLIST_FILE")"

    if ! grep -q -E "^\s*$ip(\s|$)" "$BLACKLIST_FILE" 2>/dev/null; then
      echo "$ip  # persistent offender: >=${PERSISTENT_THRESHOLD} bans in 24h" >> "$BLACKLIST_FILE"
    fi

    printf '%s [BLACKLIST] ip=%s trigger="%d_in_24h" count=%s jail=%s\n' \
      "$(date +'%Y-%m-%d %H:%M:%S')" "$ip" "$PERSISTENT_THRESHOLD" "$count" "$jail" \
      >> "$LOG_DIR/persistent-offenders.log"

    nftban_log_json info persistent \
      "\"ip\":\"$ip\",\"reason\":\"${PERSISTENT_THRESHOLD}_in_24h\",\"count\":\"$count\",\"action\":\"blacklist_file_append\""
  fi
}

# ═══════════════════════════════════════════════════════════════════════════
# MASTER ENABLE/DISABLE & COMPONENT CONTROL
# ═══════════════════════════════════════════════════════════════════════════

do_enable_all()   {
  systemctl enable --now "$SYSTEMD_NFTBAN" "$SYSTEMD_FAIL2BAN"
  nftban_log_json info enable_all '"components":"nftban,fail2ban"'
  echo "✓ Enabled nftban and fail2ban"
}

do_disable_all()  {
  systemctl disable --now "$SYSTEMD_NFTBAN" "$SYSTEMD_FAIL2BAN"
  nftban_log_json info disable_all '"components":"nftban,fail2ban"'
  echo "✓ Disabled nftban and fail2ban"
}

do_status_all()   {
  echo "=== NFTBan Status ==="
  systemctl is-active "$SYSTEMD_NFTBAN" 2>/dev/null && echo "nftban: active" || echo "nftban: inactive"
  systemctl is-active "$SYSTEMD_FAIL2BAN" 2>/dev/null && echo "fail2ban: active" || echo "fail2ban: inactive"
}

do_nftables_enable()  { systemctl enable --now "$SYSTEMD_NFTBAN"; echo "✓ Enabled nftban"; }
do_nftables_disable() { systemctl disable --now "$SYSTEMD_NFTBAN"; echo "✓ Disabled nftban"; }
do_nftables_status()  { systemctl status "$SYSTEMD_NFTBAN" --no-pager || true; }

do_fail2ban_enable()  { systemctl enable --now "$SYSTEMD_FAIL2BAN"; echo "✓ Enabled fail2ban"; }
do_fail2ban_disable() { systemctl disable --now "$SYSTEMD_FAIL2BAN"; echo "✓ Disabled fail2ban"; }
do_fail2ban_status()  { systemctl status "$SYSTEMD_FAIL2BAN" --no-pager || true; }

# ═══════════════════════════════════════════════════════════════════════════
# FAIL2BAN JAIL MANAGEMENT
# ═══════════════════════════════════════════════════════════════════════════

fail2ban_setup() {
  mkdir -p "$JAIL_DIR" "$ACTION_DIR" "$TEMPLATE_DIR"
  install -m 0644 -o root -g root "$TEMPLATE_DIR/nftban.conf" "$ACTION_DIR/nftban.conf"
  [ -f "$JAIL_DIR/nftban-sshd.conf" ] || \
    install -m 0644 -o root -g root "$TEMPLATE_DIR/nftban-sshd.conf" "$JAIL_DIR/nftban-sshd.conf"
  systemctl restart "$SYSTEMD_FAIL2BAN"
  echo "✓ Fail2ban setup complete"
}

fail2ban_jail_enable()  { sed -i 's/^\s*enabled\s*=.*/enabled = true/' "$JAIL_DIR/$1.conf"; systemctl restart "$SYSTEMD_FAIL2BAN"; echo "✓ Enabled jail: $1"; }
fail2ban_jail_disable() { sed -i 's/^\s*enabled\s*=.*/enabled = false/' "$JAIL_DIR/$1.conf"; systemctl restart "$SYSTEMD_FAIL2BAN"; echo "✓ Disabled jail: $1"; }
fail2ban_jail_delete()  { rm -f "$JAIL_DIR/$1.conf"; systemctl restart "$SYSTEMD_FAIL2BAN"; echo "✓ Deleted jail: $1"; }
fail2ban_jail_list()    { ls -1 "$JAIL_DIR"/*.conf 2>/dev/null | sed 's#.*/##; s/\.conf$//' || echo "(no jails)"; }

# ═══════════════════════════════════════════════════════════════════════════
# LOGS & STATISTICS
# ═══════════════════════════════════════════════════════════════════════════

logs_tail() { [ -f "$LOG_DIR/$1" ] && tail -n "${2:-50}" "$LOG_DIR/$1" || echo "Log not found: $1"; }
logs_ip() { echo "=== Logs for IP: $1 ==="; grep -h "$1" "$LOG_DIR"/*.log 2>/dev/null || echo "(no logs)"; }

stats_overall() {
  if [ "$have_sqlite" -eq 1 ]; then
    sqlite3 -header -column "$DB_PATH" "SELECT date(ts,'unixepoch') AS day, COUNT(*) AS bans FROM bans GROUP BY day ORDER BY day DESC LIMIT 30;" 2>/dev/null || echo "(no data)"
  else
    [ -f "$STATE_DIR/bans.tsv" ] && awk '{print strftime("%Y-%m-%d",$1)}' "$STATE_DIR/bans.tsv" | sort | uniq -c | sort -k2 || echo "(no data)"
  fi
}

stats_range() {
  local from="$1"
  if [ "$have_sqlite" -eq 1 ]; then
    sqlite3 "$DB_PATH" "SELECT COUNT(*) FROM bans WHERE ts>=$from;" 2>/dev/null || echo "0"
  else
    [ -f "$STATE_DIR/bans.tsv" ] && awk -v since="$from" '$1>=since{c++} END{print c+0}' "$STATE_DIR/bans.tsv" || echo "0"
  fi
}

stats_top_ips() {
  if [ "$have_sqlite" -eq 1 ]; then
    sqlite3 -header -column "$DB_PATH" "SELECT ip, COUNT(*) AS bans FROM bans GROUP BY ip ORDER BY bans DESC LIMIT 10;" 2>/dev/null || echo "(no data)"
  else
    [ -f "$STATE_DIR/bans.tsv" ] && awk '{print $2}' "$STATE_DIR/bans.tsv" | sort | uniq -c | sort -nr | head -10 || echo "(no data)"
  fi
}

stats_top_jails() {
  if [ "$have_sqlite" -eq 1 ]; then
    sqlite3 -header -column "$DB_PATH" "SELECT jail, COUNT(*) AS bans FROM bans GROUP BY jail ORDER BY bans DESC LIMIT 10;" 2>/dev/null || echo "(no data)"
  else
    [ -f "$STATE_DIR/bans.tsv" ] && awk '{print $3}' "$STATE_DIR/bans.tsv" | sort | uniq -c | sort -nr | head -10 || echo "(no data)"
  fi
}

# ═══════════════════════════════════════════════════════════════════════════
# LIST & UNBAN OPERATIONS
# ═══════════════════════════════════════════════════════════════════════════

nftban_list() {
  echo "=== Banned IPs ==="
  echo ""

  # Check if runtime table exists
  if ! nft list table inet nftban_runtime >/dev/null 2>&1; then
    echo "No runtime bans active (nftban_runtime table not found)"
    echo ""
  else
    echo "Temporary Bans (Runtime):"
    echo "  IPv4:"
    nft list set inet nftban_runtime temp_ban_v4 2>/dev/null | grep -E 'elements = ' | sed 's/.*elements = { \(.*\) }.*/\1/' | tr ',' '\n' | sed 's/^ */    /' || echo "    (none)"
    echo "  IPv6:"
    nft list set inet nftban_runtime temp_ban_v6 2>/dev/null | grep -E 'elements = ' | sed 's/.*elements = { \(.*\) }.*/\1/' | tr ',' '\n' | sed 's/^ */    /' || echo "    (none)"
    echo ""
  fi

  # Check permanent bans in main table
  if nft list table inet nftban_main >/dev/null 2>&1; then
    echo "Permanent Bans (Main):"
    echo "  IPv4:"
    nft list set inet nftban_main blacklist_v4 2>/dev/null | grep -E 'elements = ' | sed 's/.*elements = { \(.*\) }.*/\1/' | tr ',' '\n' | sed 's/^ */    /' || echo "    (none)"
    echo "  IPv6:"
    nft list set inet nftban_main blacklist_v6 2>/dev/null | grep -E 'elements = ' | sed 's/.*elements = { \(.*\) }.*/\1/' | tr ',' '\n' | sed 's/^ */    /' || echo "    (none)"
  fi
}

nftban_unban() {
  local ip="$1"

  if [[ -z "$ip" ]]; then
    echo "ERROR: IP address required" >&2
    echo "Usage: nftban unban <ip>" >&2
    return 1
  fi

  local found=0

  # Try to remove from runtime table
  if nft list table inet nftban_runtime >/dev/null 2>&1; then
    if [[ "$ip" == *:* ]]; then
      if nft delete element inet nftban_runtime temp_ban_v6 "{ $ip }" 2>/dev/null; then
        echo "✓ Removed $ip from temporary bans (IPv6)"
        found=1
      fi
    else
      if nft delete element inet nftban_runtime temp_ban_v4 "{ $ip }" 2>/dev/null; then
        echo "✓ Removed $ip from temporary bans (IPv4)"
        found=1
      fi
    fi
  fi

  # Try to remove from main table blacklist
  if nft list table inet nftban_main >/dev/null 2>&1; then
    if [[ "$ip" == *:* ]]; then
      if nft delete element inet nftban_main blacklist_v6 "{ $ip }" 2>/dev/null; then
        echo "✓ Removed $ip from permanent blacklist (IPv6)"
        found=1
      fi
    else
      if nft delete element inet nftban_main blacklist_v4 "{ $ip }" 2>/dev/null; then
        echo "✓ Removed $ip from permanent blacklist (IPv4)"
        found=1
      fi
    fi
  fi

  # Remove from blacklist config files
  if [[ -d "$BL_DIR" ]]; then
    for bl_file in "$BL_DIR"/*.conf; do
      if [[ -f "$bl_file" ]] && grep -q "^$ip" "$bl_file" 2>/dev/null; then
        sed -i "/^$ip/d" "$bl_file"
        echo "✓ Removed $ip from $bl_file"
        found=1
      fi
    done
  fi

  if [[ $found -eq 0 ]]; then
    echo "⚠ IP $ip not found in any ban lists"
    return 1
  fi

  nftban_log_json info unban "\"ip\":\"$ip\",\"result\":\"success\""
}

# ═══════════════════════════════════════════════════════════════════════════
# USAGE & MAIN ROUTER
# ═══════════════════════════════════════════════════════════════════════════

usage() {
  cat <<EOF
NFTBan v0.10.0 - Ban Management

MASTER CONTROL:
  nftban enable|disable|status

COMPONENT CONTROL:
  nftban nftables enable|disable|status|reload
  nftban fail2ban enable|disable|status|setup

JAIL MANAGEMENT:
  nftban fail2ban jail list|enable|disable|delete <name>

BAN OPERATIONS:
  nftban ban <ip> --temp --timeout <dur> --source <src> --jail <name>
  nftban unban <ip>
  nftban list

LOGS:
  nftban logs tail <file> [N]
  nftban logs ip <addr>

STATISTICS:
  nftban stats [overall|today|week|top-ips|top-jails]
EOF
}

case "${1:-}" in
  enable)   do_enable_all ;;
  disable)  do_disable_all ;;
  status)   do_status_all ;;
  list)     nftban_list ;;
  unban)    shift; nftban_unban "$@" ;;
  nftables)
    case "${2:-}" in
      enable) do_nftables_enable ;;
      disable) do_nftables_disable ;;
      status) do_nftables_status ;;
      reload) nftban_build_main ;;
      *) usage; exit 1;;
    esac ;;
  fail2ban)
    case "${2:-}" in
      enable) do_fail2ban_enable ;;
      disable) do_fail2ban_disable ;;
      status) do_fail2ban_status ;;
      setup)  fail2ban_setup ;;
      jail)
        case "${3:-}" in
          list)    fail2ban_jail_list ;;
          enable)  fail2ban_jail_enable "$4" ;;
          disable) fail2ban_jail_disable "$4" ;;
          delete)  fail2ban_jail_delete "$4" ;;
          *) usage; exit 1;;
        esac ;;
      *) usage; exit 1;;
    esac ;;
  ban) shift; nftban_fail2ban_ban "$@" ;;
  logs)
    case "${2:-}" in
      tail) logs_tail "$3" "${4:-50}" ;;
      ip)   logs_ip "$3" ;;
      *) usage; exit 1;;
    esac ;;
  stats)
    case "${2:-overall}" in
      overall) stats_overall ;;
      today)   stats_range "$(date -d '00:00' +%s)" ;;
      week)    stats_range "$(date -d '7 days ago' +%s)" ;;
      top-ips)   stats_top_ips ;;
      top-jails) stats_top_jails ;;
      *) usage; exit 1;;
    esac ;;
  *) usage; exit 1;;
esac

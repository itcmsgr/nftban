324: nftban_geoban_fetch_bash() {
325:     # Download country IP ranges from IPDENY (bash-only, no Go required)
326:     # Args: $1 = country code, $2 = action (ban/whitelist)
327:     # Returns: 0 if success, 1 if failed
328: 
329:     local cc="$1"
330:     local action="${2:-ban}"
331:     local cc_lower="${cc,,}"
332: 
333:     nftban_info "Downloading $cc IP ranges from IPDENY (bash mode)"
334: 
335:     # Ensure directories exist
336:     mkdir -p "$GEOBAN_CACHE_DIR" "$GEOBAN_FILES_DIR" "$GEOBAN_TRACKING_DIR"
337: 
338:     # Determine file prefix based on action
339:     local prefix
340:     case "$action" in
341:         ban)
342:             prefix="50-ban"
343:             ;;
344:         whitelist)
345:             prefix="40-whitelist"
346:             ;;
347:         *)
348:             nftban_error "Invalid action: $action"
349:             return 1
350:             ;;
351:     esac
352: 
353:     local cache_file="$GEOBAN_CACHE_DIR/${cc}.txt"
354:     local output_file="$GEOBAN_FILES_DIR/${prefix}-${cc}.conf"
355:     local tracking_file="$GEOBAN_TRACKING_DIR/${cc}.json"
356: 
357:     # Download IPv4 ranges from IPDENY
358:     nftban_info "Fetching IPv4 ranges for $cc from ipdeny.com..."
359: 
360:     if ! curl -s -f "https://www.ipdeny.com/ipblocks/data/countries/${cc_lower}.zone" \
361:         -o "$cache_file" --max-time 30; then
362:         nftban_error "Failed to download $cc from IPDENY"
363:         nftban_info "URL: https://www.ipdeny.com/ipblocks/data/countries/${cc_lower}.zone"
364:         return 1
365:     fi
366: 
367:     # Validate download
368:     if [[ ! -s "$cache_file" ]]; then
369:         nftban_error "Downloaded file is empty for $cc"
370:         rm -f "$cache_file"
371:         return 1
372:     fi
373: 
374:     # Count IPs
375:     local ip_count
376:     ip_count=$(wc -l < "$cache_file")
377: 
378:     if [[ $ip_count -lt 10 ]]; then
379:         nftban_error "Downloaded only $ip_count IP ranges for $cc (expected more)"
380:         nftban_warn "This may indicate an invalid country code or IPDENY service issue"
381:         rm -f "$cache_file"
382:         return 1
383:     fi
384: 
385:     # Copy to output location with header comment
386:     {
387:         echo "# NFTBan GeoBan - Country: $cc"
388:         echo "# Action: $action"
389:         echo "# Source: IPDENY (bash fallback mode)"
390:         echo "# Downloaded: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
391:         echo "# IP Ranges: $ip_count"
392:         echo "#"
393:         cat "$cache_file"
394:     } > "$output_file"
395: 
396:     # Create tracking JSON (simple format for bash mode)
397:     cat > "$tracking_file" <<EOF
398: {
399:   "country": "$cc",
400:   "action": "$action",
401:   "source": "bash",
402:   "ipv4_count": $ip_count,
403:   "ipv6_count": 0,
404:   "downloaded": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
405:   "url": "https://www.ipdeny.com/ipblocks/data/countries/${cc_lower}.zone"
406: }
407: EOF
408: 
409:     nftban_success "Downloaded $ip_count IPv4 ranges for $cc (bash mode)"
410:     nftban_info "File: $output_file"
411: 
412:     return 0
413: }

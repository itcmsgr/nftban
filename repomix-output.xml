<file path="cli/lib/nftban/core/nftban_report_port.sh">
  1: #!/usr/bin/env bash
  2: 
  3: # =============================================================================
  4: # NFTBan v1.0.0 - Port Report Core Module
  5: # =============================================================================
  6: # SPDX-License-Identifier: MPL-2.0
  7: # Purpose: Port scanning and nftables firewall status analysis
  8: #
  9: # meta:name=nftban_report_port
 10: # meta:type=core
 11: # meta:header=Port Report Core
 12: # meta:version=1.0.0
 13: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 14: # meta:homepage=https://nftban.com
 15: #
 16: # **Description & Purpose**
 17: # meta:description=Scans listening services and analyzes nftables firewall status per port
 18: # meta:input=Port filters, output format options
 19: # meta:output=Port status reports (terminal, HTML, mail)
 20: #
 21: # **Inventory & Requirements**
 22: # meta:depends=bash,ss,nft,netstat(optional),lsof(optional)
 23: #
 24: # meta:created_date=2025-11-05
 25: # meta:updated_date=2025-11-24
 26: # =============================================================================
 27: 
 28: # Strict mode
 29: IFS=$'\n\t'
 30: umask 027
 31: 
 32: # =============================================================================
 33: # GLOBALS
 34: # =============================================================================
 35: 
 36: declare -g -A NFTBAN_PORT_LISTEN_MAP=()    # key: proto_port_family -> "proc:pid"
 37: declare -g -A NFTBAN_PORT_BIND_ADDR=()     # key: proto_port_family -> local address
 38: declare -g -A NFTBAN_PORT_NFT_RULES=()     # key: port_proto_chain_family -> action
 39: declare -g -A NFTBAN_PORT_NFT_GENERIC=()   # key: port_proto_chain -> action
 40: declare -g -A NFTBAN_PORT_SEEN=()          # key: port_proto -> 1
 41: declare -g -A NFTBAN_PORT_SERVICE_NAME=()  # key: port_proto -> service name
 42: declare -g -A NFTBAN_PORT_STATUS=()        # key: port/proto/family/direction -> status (BUG-005 FIX)
 43: 
 44: NFTBAN_PORT_TIMESTAMP="$(date --iso-8601=seconds)"  # shellcheck disable=SC2034  # Reserved for report headers
 45: NFTBAN_PORT_DETAILED="${NFTBAN_PORT_DETAILED:-0}"
 46: NFTBAN_PORT_OUTPUT_FORMAT="${NFTBAN_PORT_OUTPUT_FORMAT:-table}"
 47: NFTBAN_PORT_FILTER_PORTS="${NFTBAN_PORT_FILTER_PORTS:-}"
 48: 
 49: # Color symbols (use nftban_output.sh if available)
 50: if type -t nftban_render_banner >/dev/null 2>&1; then
 51:     # nftban_output.sh loaded, use its colors
 52:     NFTBAN_PORT_SYM_OK="✔"  # shellcheck disable=SC2034  # Symbols for UI rendering
 53:     NFTBAN_PORT_SYM_KO="✖"  # shellcheck disable=SC2034  # Symbols for UI rendering
 54:     NFTBAN_PORT_SYM_QUEST="−"  # shellcheck disable=SC2034  # Symbols for UI rendering
 55: else
 56:     # Fallback colors
 57:     NFTBAN_PORT_SYM_OK="✔"  # shellcheck disable=SC2034  # Symbols for UI rendering
 58:     NFTBAN_PORT_SYM_KO="✖"  # shellcheck disable=SC2034  # Symbols for UI rendering
 59:     NFTBAN_PORT_SYM_QUEST="−"  # shellcheck disable=SC2034  # Symbols for UI rendering
 60:     C_RESET="\e[0m"
 61:     C_RED="\e[31m"
 62:     C_GREEN="\e[32m"
 63:     C_YELLOW="\e[33m"
 64:     C_BOLD="\e[1m"
 65: fi
 66: 
 67: # =============================================================================
 68: # HELPER FUNCTIONS
 69: # =============================================================================
 70: 
 71: nftban_port_trim() {
 72:     local s="${*-}"
 73:     s="${s#"${s%%[![:space:]]*}"}"
 74:     s="${s%"${s##*[![:space:]]}"}"
 75:     printf '%s' "$s"
 76: }
 77: 
 78: nftban_port_is_loopback() {
 79:     local a="${1-}"
 80:     [[ -z "$a" ]] && return 1
 81:     [[ "$a" == "127.0.0.1" || "$a" == "::1" || "$a" == "localhost" ]] && return 0
 82:     [[ "$a" =~ ^127\. ]] && return 0
 83:     return 1
 84: }
 85: 
 86: nftban_port_bind_scope() {
 87:     local a="${1-}"
 88:     if nftban_port_is_loopback "$a"; then echo "LOCAL-ONLY"; return; fi
 89:     [[ "$a" == "0.0.0.0" || "$a" == "::" || "$a" == "*" ]] && { echo "PUBLIC"; return; }
 90:     # Any non-loopback specific IP is considered exposed
 91:     echo "PUBLIC"
 92: }
 93: 
 94: # =============================================================================
 95: # PORT SCANNING FUNCTIONS
 96: # =============================================================================
 97: 
 98: nftban_port_gather_listeners() {
 99:     # Gather listening ports using ss (preferred) or lsof (fallback)
100:     # Populates: NFTBAN_PORT_LISTEN_MAP, NFTBAN_PORT_BIND_ADDR, NFTBAN_PORT_SEEN
101: 
102:     # Prefer ss
103:     while IFS= read -r line; do
104:         # Skip non-listener lines or lines without process info
105:         [[ "$line" =~ users: ]] || continue
106: 
107:         local proto local_ap port addr family users cmd pid proto_norm key
108: 
109:         # Grab the local address:port from the 5th field
110:         proto="$(awk '{print $1}' <<<"$line")"
111:         local_ap="$(awk '{print $5}' <<<"$line")"
112: 
113:         # Ensure it's an address:port pair
114:         [[ "$local_ap" =~ : ]] || continue
115: 
116:         port="${local_ap##*:}"
117:         addr="${local_ap%:*}"
118:         # Normalize IPv6 [::] / [::ffff:...] -> ::... (strip brackets)
119:         addr="${addr#[}"; addr="${addr%]}"
120:         family="ipv4"; [[ "$addr" =~ : ]] && family="ipv6"
121: 
122:         users="$(sed -n 's/.*users:(\([^)]*\)).*/\1/p' <<<"$line" || true)"
123:         cmd=""; pid=""
124:         if [[ "$users" =~ \"([^\"]+)\"[,[:space:]]*pid=([0-9]+) ]]; then
125:             cmd="${BASH_REMATCH[1]}"; pid="${BASH_REMATCH[2]}"
126:         fi
127: 
128:         proto_norm="tcp"; [[ "$proto" =~ udp ]] && proto_norm="udp"
129:         key="${proto_norm}_${port}_${family}"
130: 
131:         NFTBAN_PORT_LISTEN_MAP["$key"]="${cmd:+$cmd:}${pid}"
132:         NFTBAN_PORT_BIND_ADDR["$key"]="$addr"
133:         NFTBAN_PORT_SEEN["${port}_${proto_norm}"]=1
134:     done < <(ss -tunlp -H 2>/dev/null || true)
135: 
136:     # Fallback 1: netstat (if ss found nothing)
137:     if (( ${#NFTBAN_PORT_LISTEN_MAP[@]} == 0 )) && command -v netstat >/dev/null 2>&1; then
138:         while IFS= read -r line; do
139:             # Parse netstat output: tcp/tcp6/udp/udp6  0  0  0.0.0.0:22  0.0.0.0:*  LISTEN  1234/sshd
140:             [[ "$line" =~ ^(tcp|tcp6|udp|udp6)[[:space:]]+[0-9]+[[:space:]]+[0-9]+[[:space:]]+([^\ :]+):([0-9]+)[[:space:]]+[^\ ]+[[:space:]]+(LISTEN)?[[:space:]]*([0-9]+)/([^\ ]+) ]] || continue
141: 
142:             local proto_raw="${BASH_REMATCH[1]}"
143:             local addr="${BASH_REMATCH[2]}"
144:             local port="${BASH_REMATCH[3]}"
145:             local pid="${BASH_REMATCH[5]}"
146:             local cmd="${BASH_REMATCH[6]}"
147: 
148:             # Normalize protocol and family
149:             local proto_norm="tcp"
150:             local family="ipv4"
151: 
152:             case "$proto_raw" in
153:                 tcp)  proto_norm="tcp"; family="ipv4" ;;
154:                 tcp6) proto_norm="tcp"; family="ipv6" ;;
155:                 udp)  proto_norm="udp"; family="ipv4" ;;
156:                 udp6) proto_norm="udp"; family="ipv6" ;;
157:             esac
158: 
159:             # Normalize address (strip brackets from IPv6)
160:             addr="${addr#[}"; addr="${addr%]}"
161:             [[ "$addr" == ":::" ]] && addr="::"
162: 
163:             local key="${proto_norm}_${port}_${family}"
164:             NFTBAN_PORT_LISTEN_MAP["$key"]="${cmd:+$cmd:}${pid}"
165:             NFTBAN_PORT_BIND_ADDR["$key"]="$addr"
166:             NFTBAN_PORT_SEEN["${port}_${proto_norm}"]=1
167:         done < <(netstat -tulnp 2>/dev/null || true)
168:     fi
169: 
170:     # Fallback 2: lsof (only if ss and netstat found nothing)
171:     if (( ${#NFTBAN_PORT_LISTEN_MAP[@]} == 0 )) && command -v lsof >/dev/null 2>&1; then
172:         while IFS= read -r l; do
173:             # mysqld 1234 ... TCP 0.0.0.0:3306 (LISTEN)  OR TCP [::]:22 (LISTEN)
174:             [[ "$l" =~ ^([[:alnum:]._-]+)[[:space:]]+([0-9]+).*TCP[[:space:]]+(\[::\]|[^\ :]+):([0-9]+)[[:space:]]+\(LISTEN\) ]] || continue
175:             local cmd2 pid2 addr2 port2 family2 key2
176:             cmd2="${BASH_REMATCH[1]}"; pid2="${BASH_REMATCH[2]}"; addr2="${BASH_REMATCH[3]}"; port2="${BASH_REMATCH[4]}"
177:             addr2="${addr2#[}"; addr2="${addr2%]}"
178:             family2="ipv4"; [[ "$addr2" =~ : ]] && family2="ipv6"
179:             key2="tcp_${port2}_${family2}"
180:             NFTBAN_PORT_LISTEN_MAP["$key2"]="${cmd2:+$cmd2:}${pid2}"
181:             NFTBAN_PORT_BIND_ADDR["$key2"]="$addr2"
182:             NFTBAN_PORT_SEEN["${port2}_tcp"]=1
183:         done < <(lsof -nP -iTCP -sTCP:LISTEN 2>/dev/null || true)
184:     fi
185: }
186: 
187: nftban_port_gather_nft_rules() {
188:     # Parse nftables ruleset and populate NFT_RULES/NFT_GENERIC
189:     # Populates: NFTBAN_PORT_NFT_RULES, NFTBAN_PORT_NFT_GENERIC, NFTBAN_PORT_SEEN
190: 
191:     local RULESET_RAW
192:     RULESET_RAW="$(nft list ruleset 2>/dev/null || true)"
193:     [[ -z "$RULESET_RAW" ]] && return
194: 
195:     # First, gather set-based rules (tcp dport @tcp_ports, etc.)
196:     local set_rules=()
197:     local line cur_chain=""
198:     while IFS= read -r line; do
199:         if [[ "$line" =~ ^[[:space:]]*chain[[:space:]]+([[:alnum:]_-]+) ]]; then
200:             cur_chain="${BASH_REMATCH[1]}"; continue
201:         fi
202:         # Detect set-based rules: tcp dport @tcp_ports accept
203:         # Note: May have 'counter' between set and action
204:         if [[ "$line" =~ (tcp|udp)[[:space:]]+dport[[:space:]]+@([[:alnum:]_-]+)[[:space:]].*(accept|drop|reject) ]]; then
205:             local proto="${BASH_REMATCH[1]}" set_name="${BASH_REMATCH[2]}" action="${BASH_REMATCH[3]}"
206:             set_rules+=("${proto}|${set_name}|${cur_chain}|${action}")
207:         fi
208:     done < <(printf '%s\n' "$RULESET_RAW")
209: 
210:     # Parse sets and expand them to individual ports
211:     for rule in "${set_rules[@]}"; do
212:         IFS='|' read -r proto set_name chain action <<< "$rule"
213:         # Normalize chain name: services_in→input, services_out→output, input_*→input, etc.
214:         local norm_chain="$chain"
215:         [[ "$chain" =~ input|_in$ ]] && norm_chain="input"
216:         [[ "$chain" =~ output|_out$ ]] && norm_chain="output"
217: 
218:         # Get set contents (v0.7.3: check IPv4 table, could also check IPv6)
219:         local set_contents
220:         set_contents=$(nft list set ${NFTBAN_TABLE_IPV4} "$set_name" 2>/dev/null | grep -o 'elements = {[^}]*}' | sed 's/elements = {//; s/}//' || true)
221:         if [[ -n "$set_contents" ]]; then
222:             # Parse ports from set (handles: 22, 80, 443, etc.)
223:             local port
224:             for port in $(echo "$set_contents" | tr ',' '\n' | grep -oE '[0-9]+'); do
225:                 NFTBAN_PORT_NFT_GENERIC["${port}_${proto}_${norm_chain}"]="$action"
226:                 NFTBAN_PORT_SEEN["${port}_${proto}"]=1
227:             done
228:         fi
229:     done
230: 
231:     # Then, gather direct port rules (tcp dport 22 accept)
232:     cur_chain=""
233:     while IFS= read -r line; do
234:         if [[ "$line" =~ ^[[:space:]]*chain[[:space:]]+([[:alnum:]_-]+) ]]; then
235:             cur_chain="${BASH_REMATCH[1]}"; continue
236:         fi
237:         if [[ "$line" =~ (tcp|udp)[[:space:]]+dport[[:space:]]+([0-9]+) ]]; then
238:             local proto port family="generic" action="unknown"
239:             proto="${BASH_REMATCH[1]}"; port="${BASH_REMATCH[2]}"
240:             [[ "$line" =~ nfproto[[:space:]]+ipv6 ]] && family="ipv6"
241:             [[ "$line" =~ nfproto[[:space:]]+ipv4 ]] && family="ipv4"
242:             if [[ "$line" =~ (accept|drop|reject) ]]; then action="${BASH_REMATCH[1]}"; fi
243:             if [[ "$family" == "generic" ]]; then
244:                 NFTBAN_PORT_NFT_GENERIC["${port}_${proto}_${cur_chain}"]="$action"
245:             else
246:                 NFTBAN_PORT_NFT_RULES["${port}_${proto}_${cur_chain}_${family}"]="$action"
247:             fi
248:             NFTBAN_PORT_SEEN["${port}_${proto}"]=1
249:         fi
250:     done < <(printf '%s\n' "$RULESET_RAW")
251: }
252: 
253: # =============================================================================
254: # STATUS DETERMINATION FUNCTIONS
255: # =============================================================================
256: 
257: nftban_port_determine_status() {
258:     # Determine firewall status for a port/proto
259:     # Args: $1 = port, $2 = proto
260:     # Output: "v4in|v4out|v6in|v6out|notes"
261: 
262:     local port="$1" proto="$2"
263:     local in="input" out="output"
264:     local notes=()
265: 
266:     _res() {
267:         local p="$1" r="$2" c="$3" f="$4"
268:         if [[ -n "${NFTBAN_PORT_NFT_RULES["${p}_${r}_${c}_${f}"]+x}" ]]; then
269:             printf '%s' "${NFTBAN_PORT_NFT_RULES["${p}_${r}_${c}_${f}"]}"; return
270:         fi
271:         if [[ -n "${NFTBAN_PORT_NFT_GENERIC["${p}_${r}_${c}"]+x}" ]]; then
272:             printf '%s_generic' "${NFTBAN_PORT_NFT_GENERIC["${p}_${r}_${c}"]}"; return
273:         fi
274:         printf 'no-rule'
275:     }
276: 
277:     local v4i v4o v6i v6o
278:     v4i="$(_res "$port" "$proto" "$in" "ipv4")"
279:     v4o="$(_res "$port" "$proto" "$out" "ipv4")"
280:     v6i="$(_res "$port" "$proto" "$in" "ipv6")"
281:     v6o="$(_res "$port" "$proto" "$out" "ipv6")"
282: 
283:     [[ "$v4i" == *_generic ]] && notes+=("ipv4-in:generic")
284:     [[ "$v4o" == *_generic ]] && notes+=("ipv4-out:generic")
285:     [[ "$v6i" == *_generic ]] && notes+=("ipv6-in:generic")
286:     [[ "$v6o" == *_generic ]] && notes+=("ipv6-out:generic")
287: 
288:     map_action() {
289:         case "$1" in
290:             accept|accept_generic) echo "Allowed" ;;
291:             drop|reject|drop_generic|reject_generic) echo "Blocked" ;;
292:             no-rule) echo "No-rule" ;;
293:             *) echo "Unknown" ;;
294:         esac
295:     }
296: 
297:     # Populate NFTBAN_PORT_STATUS array (BUG-005 FIX)
298:     NFTBAN_PORT_STATUS["${port}/${proto}/ipv4/in"]="$(map_action "${v4i%%_*}")"
299:     NFTBAN_PORT_STATUS["${port}/${proto}/ipv4/out"]="$(map_action "${v4o%%_*}")"
300:     NFTBAN_PORT_STATUS["${port}/${proto}/ipv6/in"]="$(map_action "${v6i%%_*}")"
301:     NFTBAN_PORT_STATUS["${port}/${proto}/ipv6/out"]="$(map_action "${v6o%%_*}")"
302: 
303:     printf "%s|%s|%s|%s|%s\n" \
304:         "$(map_action "${v4i%%_*}")" "$(map_action "${v4o%%_*}")" \
305:         "$(map_action "${v6i%%_*}")" "$(map_action "${v6o%%_*}")" \
306:         "$(printf '%s; ' "${notes[@]-}" | sed 's/; $//')"
307: }
308: 
309: nftban_port_detect_service() {
310:     # Detect service name and running status
311:     # Args: $1 = port, $2 = proto
312:     # Output: "NAME|RUNNING|PROCSTR|BIND|SCOPE"
313: 
314:     local port="$1" proto="$2"
315:     local k4="${proto}_${port}_ipv4" k6="${proto}_${port}_ipv6"
316:     local p4="${NFTBAN_PORT_LISTEN_MAP[$k4]:-}" p6="${NFTBAN_PORT_LISTEN_MAP[$k6]:-}"
317:     local b4="${NFTBAN_PORT_BIND_ADDR[$k4]:-}" b6="${NFTBAN_PORT_BIND_ADDR[$k6]:-}"
318: 
319:     local running="no" proc="" bind="" scope=""
320:     if [[ -n "$p4$b4$p6$b6" ]]; then
321:         running="yes"
322:         proc="$(nftban_port_trim "${p4:-}${p4:+ / }${p6:-}")"
323:         bind="$(nftban_port_trim "${b4:-}${b4:+ / }${b6:-}")"
324:         local sc4=""; [[ -n "$b4" ]] && sc4="$(nftban_port_bind_scope "$b4")"
325:         local sc6=""; [[ -n "$b6" ]] && sc6="$(nftban_port_bind_scope "$b6")"
326:         if [[ "$sc4" == "PUBLIC" || "$sc6" == "PUBLIC" ]]; then scope="PUBLIC"; else scope="LOCAL-ONLY"; fi
327:     fi
328: 
329:     local sname="${NFTBAN_PORT_SERVICE_NAME["${port}_${proto}"]-}"
330: 
331:     if [[ -z "$sname" && -r /etc/services ]]; then
332:         sname="$(awk -v P="$port" -v R="$proto" '!/^#/ && NF >= 2 { if ($2 ~ P"/"R) { print $1; exit; } }' /etc/services 2>/dev/null || true)"
333:     fi
334: 
335:     [[ -z "$sname" ]] && sname="UNKNOWN"
336: 
337:     printf "%s|%s|%s|%s|%s\n" "$sname" "$running" "$proc" "$bind" "$scope"
338: }

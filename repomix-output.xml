 948: # =============================================================================
 949: # TREND ANALYSIS (7-day rolling history)
 950: # =============================================================================
 951: 
 952: readonly NFTBAN_WATCHDOG_TREND_DIR="${NFTBAN_DATA_DIR:-/var/lib/nftban}/watchdog"
 953: readonly NFTBAN_WATCHDOG_TREND_FILE="${NFTBAN_WATCHDOG_TREND_DIR}/trend_hourly.json"
 954: readonly NFTBAN_WATCHDOG_TREND_RETENTION=168  # 7 days in hours
 955: 
 956: nftban_watchdog_trend_collect() {
 957:     # Collect current system metrics and append to trend history
 958:     # Called hourly by maintenance timer
 959:     # Usage: nftban_watchdog_trend_collect
 960: 
 961:     mkdir -p "$NFTBAN_WATCHDOG_TREND_DIR" 2>/dev/null || true
 962: 
 963:     # Run checks to populate WATCHDOG_RESULTS
 964:     nftban_watchdog_run_all >/dev/null 2>&1
 965: 
 966:     local hour_start
 967:     hour_start=$(date -d "$(date +%Y-%m-%d\ %H):00:00" +%Y-%m-%dT%H:%M:%SZ)
 968: 
 969:     # Extract metrics from WATCHDOG_RESULTS
 970:     local load5="${WATCHDOG_RESULTS[load_5m]:-0}"
 971:     local mem_pct="${WATCHDOG_RESULTS[mem_used_percent]:-0}"
 972:     local iowait="${WATCHDOG_RESULTS[cpu_iowait_percent]:-0}"
 973:     local disk_pct="${WATCHDOG_RESULTS[disk_used_percent]:-0}"
 974: 
 975:     # Create new sample JSON
 976:     local sample
 977:     sample=$(cat <<EOF
 978: {"hour":"${hour_start}","load_5m":${load5},"mem_percent":${mem_pct},"iowait_percent":${iowait},"disk_percent":${disk_pct}}
 979: EOF
 980: )
 981: 
 982:     # Load existing data, append, and enforce retention
 983:     local temp_file="${NFTBAN_WATCHDOG_TREND_FILE}.tmp"
 984: 
 985:     if [[ -f "$NFTBAN_WATCHDOG_TREND_FILE" ]] && command -v jq &>/dev/null; then
 986:         jq --argjson new "$sample" --argjson max "$NFTBAN_WATCHDOG_TREND_RETENTION" \
 987:             '.samples += [$new] | .samples = .samples[-$max:]' \
 988:             "$NFTBAN_WATCHDOG_TREND_FILE" > "$temp_file" 2>/dev/null && \
 989:             mv "$temp_file" "$NFTBAN_WATCHDOG_TREND_FILE"
 990:     else
 991:         echo "{\"samples\":[$sample],\"retention_hours\":$NFTBAN_WATCHDOG_TREND_RETENTION}" > "$NFTBAN_WATCHDOG_TREND_FILE"
 992:     fi
 993: 
 994:     chown nftban:nftban "$NFTBAN_WATCHDOG_TREND_FILE" 2>/dev/null || true
 995:     chmod 640 "$NFTBAN_WATCHDOG_TREND_FILE" 2>/dev/null || true
 996: }
 997: 
 998: nftban_watchdog_trend_load() {
 999:     # Load watchdog trend history
1000:     # Returns: JSON array of samples
1001: 
1002:     if [[ -f "$NFTBAN_WATCHDOG_TREND_FILE" ]] && command -v jq &>/dev/null; then
1003:         jq -r '.samples' "$NFTBAN_WATCHDOG_TREND_FILE" 2>/dev/null
1004:     else
1005:         echo "[]"
1006:     fi
1007: }
1008: 
1009: nftban_watchdog_trend_averages() {
1010:     # Calculate averages from watchdog trend data
1011:     # Returns: JSON with averages for each metric
1012: 
1013:     if [[ ! -f "$NFTBAN_WATCHDOG_TREND_FILE" ]] || ! command -v jq &>/dev/null; then
1014:         echo '{"load_5m":{"avg":0,"min":0,"max":0},"mem_percent":{"avg":0,"min":0,"max":0},"iowait_percent":{"avg":0,"min":0,"max":0},"disk_percent":{"avg":0,"min":0,"max":0},"samples":0}'
1015:         return
1016:     fi
1017: 
1018:     jq '
1019:         .samples as $s |
1020:         ($s | length) as $n |
1021:         if $n == 0 then
1022:             {"load_5m":{"avg":0,"min":0,"max":0},"mem_percent":{"avg":0,"min":0,"max":0},"iowait_percent":{"avg":0,"min":0,"max":0},"disk_percent":{"avg":0,"min":0,"max":0},"samples":0}
1023:         else
1024:             {
1025:                 "load_5m": {
1026:                     "avg": (($s | map(.load_5m) | add / $n) | . * 10 | floor / 10),
1027:                     "min": ($s | map(.load_5m) | min),
1028:                     "max": ($s | map(.load_5m) | max)
1029:                 },
1030:                 "mem_percent": {
1031:                     "avg": (($s | map(.mem_percent) | add / $n) | floor),
1032:                     "min": ($s | map(.mem_percent) | min),
1033:                     "max": ($s | map(.mem_percent) | max)
1034:                 },
1035:                 "iowait_percent": {
1036:                     "avg": (($s | map(.iowait_percent) | add / $n) | . * 10 | floor / 10),
1037:                     "min": ($s | map(.iowait_percent) | min),
1038:                     "max": ($s | map(.iowait_percent) | max)
1039:                 },
1040:                 "disk_percent": {
1041:                     "avg": (($s | map(.disk_percent) | add / $n) | floor),
1042:                     "min": ($s | map(.disk_percent) | min),
1043:                     "max": ($s | map(.disk_percent) | max)
1044:                 },
1045:                 "samples": $n
1046:             }
1047:         end
1048:     ' "$NFTBAN_WATCHDOG_TREND_FILE" 2>/dev/null || echo '{"samples":0}'
1049: }
1050: 
1051: nftban_watchdog_trend_thresholds() {
1052:     # Calculate suggested thresholds based on historical data
1053:     # Returns: JSON with suggested warning/critical thresholds
1054: 
1055:     if [[ ! -f "$NFTBAN_WATCHDOG_TREND_FILE" ]] || ! command -v jq &>/dev/null; then
1056:         echo '{"load":{"warning":10,"critical":20},"mem":{"warning":80,"critical":95},"iowait":{"warning":20,"critical":40}}'
1057:         return
1058:     fi
1059: 
1060:     jq '
1061:         .samples as $s |
1062:         ($s | length) as $n |
1063:         if $n < 24 then
1064:             {"load":{"warning":10,"critical":20},"mem":{"warning":80,"critical":95},"iowait":{"warning":20,"critical":40},"insufficient_data":true}
1065:         else
1066:             # Load thresholds
1067:             (($s | map(.load_5m) | add / $n) as $avg |
1068:              ($s | map((.load_5m - $avg) * (.load_5m - $avg)) | add / $n | sqrt) as $sd |
1069:              {"warning": ([($avg + 1.5 * $sd) | floor, 5] | max), "critical": ([($avg + 3 * $sd) | floor, 10] | max)}) as $load |
1070:             # Memory thresholds (cap at 95%)
1071:             (($s | map(.mem_percent) | add / $n) as $avg |
1072:              ($s | map((.mem_percent - $avg) * (.mem_percent - $avg)) | add / $n | sqrt) as $sd |
1073:              {"warning": ([($avg + 1.5 * $sd) | floor, 80] | min), "critical": 95}) as $mem |
1074:             # I/O wait thresholds
1075:             (($s | map(.iowait_percent) | add / $n) as $avg |
1076:              ($s | map((.iowait_percent - $avg) * (.iowait_percent - $avg)) | add / $n | sqrt) as $sd |
1077:              {"warning": ([($avg + 2 * $sd) | floor, 15] | max), "critical": ([($avg + 4 * $sd) | floor, 30] | max)}) as $iowait |
1078:             {
1079:                 "load": $load,
1080:                 "mem": $mem,
1081:                 "iowait": $iowait,
1082:                 "based_on_samples": $n
1083:             }
1084:         end
1085:     ' "$NFTBAN_WATCHDOG_TREND_FILE" 2>/dev/null || echo '{"load":{"warning":10,"critical":20},"mem":{"warning":80,"critical":95},"iowait":{"warning":20,"critical":40}}'
1086: }
1087: 
1088: nftban_watchdog_trend_display() {
1089:     # Display formatted watchdog trend analysis
1090:     # Usage: nftban_watchdog_trend_display [--json]
1091: 
1092:     local json_mode=0
1093:     [[ "${1:-}" == "--json" ]] && json_mode=1
1094: 
1095:     if [[ $json_mode -eq 1 ]]; then
1096:         local averages thresholds
1097:         averages=$(nftban_watchdog_trend_averages)
1098:         thresholds=$(nftban_watchdog_trend_thresholds)
1099:         jq -n --argjson avg "$averages" --argjson thr "$thresholds" \
1100:             '{averages: $avg, thresholds: $thr}'
1101:         return
1102:     fi
1103: 
1104:     # Text output
1105:     echo ""
1106:     echo "SYSTEM RESOURCE TRENDS (Last 7 Days)"
1107:     echo "══════════════════════════════════════════════════════════════"
1108:     echo ""
1109: 
1110:     local avg_data threshold_data
1111:     avg_data=$(nftban_watchdog_trend_averages)
1112:     threshold_data=$(nftban_watchdog_trend_thresholds)
1113: 
1114:     if ! command -v jq &>/dev/null; then
1115:         echo "[WARN] jq not installed - trend analysis requires jq"
1116:         return 1
1117:     fi
1118: 
1119:     local samples
1120:     samples=$(echo "$avg_data" | jq -r '.samples')
1121: 
1122:     if [[ "$samples" == "0" ]]; then
1123:         echo "  No trend data available yet."
1124:         echo "  Trend data is collected every 15 minutes by the maintenance timer."
1125:         echo ""
1126:         echo "  Enable timer: nftban timers enable nftban-maintenance.timer"
1127:         return 0
1128:     fi
1129: 
1130:     # Load Average
1131:     local load_avg load_min load_max load_warn
1132:     load_avg=$(echo "$avg_data" | jq -r '.load_5m.avg')
1133:     load_min=$(echo "$avg_data" | jq -r '.load_5m.min')
1134:     load_max=$(echo "$avg_data" | jq -r '.load_5m.max')
1135:     load_warn=$(echo "$threshold_data" | jq -r '.load.warning')
1136: 
1137:     echo "LOAD AVERAGE (5-min)"
1138:     echo "───────────────────────────────────────────────────────────────"
1139:     printf "  %-20s %s\n" "Average............." "$load_avg"
1140:     printf "  %-20s %s (min) / %s (max)\n" "Range..............." "$load_min" "$load_max"
1141:     printf "  %-20s %s (current: ${NFTBAN_WATCHDOG_LOAD_WARNING:-10})\n" "Suggested Warning..." "$load_warn"
1142:     echo ""
1143: 
1144:     # Memory
1145:     local mem_avg mem_min mem_max
1146:     mem_avg=$(echo "$avg_data" | jq -r '.mem_percent.avg')

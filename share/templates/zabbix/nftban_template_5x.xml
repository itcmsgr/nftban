<?xml version="1.0" encoding="UTF-8"?>
<zabbix_export>
    <version>5.0</version>
    <date>2026-01-22T00:00:00Z</date>
    <groups>
        <group>
            <name>Templates/Security</name>
        </group>
        <group>
            <name>NFTBan Servers</name>
        </group>
    </groups>
    <templates>
        <template>
            <template>NFTBan</template>
            <name>NFTBan Firewall</name>
            <description>NFTBan monitoring template for Zabbix 5.x

Monitors:
- Daemon status, version, uptime
- Ban statistics (total, 24h, rate)
- Memory usage, goroutines, GC stats
- Module status per enabled module
- Watchdog pressure scores
- Feed status and IP counts
- GeoIP statistics
- nftables rule counts

Requirements:
- NFTBan v1.2.3+
- Zabbix Agent or Trapper items

Documentation: https://nftban.com/docs/zabbix</description>
            <groups>
                <group>
                    <name>Templates/Security</name>
                </group>
            </groups>
            <applications>
                <application>
                    <name>NFTBan</name>
                </application>
                <application>
                    <name>NFTBan Bans</name>
                </application>
                <application>
                    <name>NFTBan Memory</name>
                </application>
                <application>
                    <name>NFTBan Modules</name>
                </application>
                <application>
                    <name>NFTBan Feeds</name>
                </application>
                <application>
                    <name>NFTBan GeoIP</name>
                </application>
            </applications>
            <items>
                <!-- Daemon Status -->
                <item>
                    <name>NFTBan: Daemon status</name>
                    <type>TRAP</type>
                    <key>nftban.status</key>
                    <delay>0</delay>
                    <value_type>UNSIGNED</value_type>
                    <description>Daemon status: 1=running, 0=stopped</description>
                    <applications>
                        <application>
                            <name>NFTBan</name>
                        </application>
                    </applications>
                    <triggers>
                        <trigger>
                            <expression>{last()}=0</expression>
                            <name>NFTBan daemon is down</name>
                            <priority>DISASTER</priority>
                            <description>NFTBan daemon is not running. Firewall protection may be compromised.</description>
                        </trigger>
                    </triggers>
                </item>
                <item>
                    <name>NFTBan: Version</name>
                    <type>TRAP</type>
                    <key>nftban.version</key>
                    <delay>0</delay>
                    <value_type>CHAR</value_type>
                    <description>NFTBan daemon version</description>
                    <applications>
                        <application>
                            <name>NFTBan</name>
                        </application>
                    </applications>
                </item>
                <item>
                    <name>NFTBan: Uptime</name>
                    <type>TRAP</type>
                    <key>nftban.uptime</key>
                    <delay>0</delay>
                    <value_type>FLOAT</value_type>
                    <units>s</units>
                    <description>Daemon uptime in seconds</description>
                    <applications>
                        <application>
                            <name>NFTBan</name>
                        </application>
                    </applications>
                </item>
                <item>
                    <name>NFTBan: PID</name>
                    <type>TRAP</type>
                    <key>nftban.pid</key>
                    <delay>0</delay>
                    <value_type>UNSIGNED</value_type>
                    <description>Daemon process ID</description>
                    <applications>
                        <application>
                            <name>NFTBan</name>
                        </application>
                    </applications>
                </item>
                <item>
                    <name>NFTBan: Operating mode</name>
                    <type>TRAP</type>
                    <key>nftban.mode</key>
                    <delay>0</delay>
                    <value_type>CHAR</value_type>
                    <description>Operating mode: normal, degraded, survival</description>
                    <applications>
                        <application>
                            <name>NFTBan</name>
                        </application>
                    </applications>
                    <triggers>
                        <trigger>
                            <expression>{last()}&lt;&gt;"normal" and {strlen()}&gt;0</expression>
                            <name>NFTBan in {ITEM.VALUE} mode</name>
                            <priority>WARNING</priority>
                            <description>NFTBan is running in degraded or survival mode.</description>
                        </trigger>
                    </triggers>
                </item>
                <!-- Ban Statistics -->
                <item>
                    <name>NFTBan: Active bans</name>
                    <type>TRAP</type>
                    <key>nftban.active.count</key>
                    <delay>0</delay>
                    <value_type>UNSIGNED</value_type>
                    <description>Currently active ban count</description>
                    <applications>
                        <application>
                            <name>NFTBan Bans</name>
                        </application>
                    </applications>
                </item>
                <item>
                    <name>NFTBan: Bans (24h)</name>
                    <type>TRAP</type>
                    <key>nftban.bans.24h</key>
                    <delay>0</delay>
                    <value_type>UNSIGNED</value_type>
                    <description>Bans in last 24 hours</description>
                    <applications>
                        <application>
                            <name>NFTBan Bans</name>
                        </application>
                    </applications>
                    <triggers>
                        <trigger>
                            <expression>{last()}&gt;1000</expression>
                            <name>High ban rate (&gt;{ITEM.VALUE}/24h)</name>
                            <priority>WARNING</priority>
                            <description>More than 1000 bans in the last 24 hours.</description>
                        </trigger>
                        <trigger>
                            <expression>{last()}&gt;5000</expression>
                            <name>Mass attack detected (&gt;{ITEM.VALUE}/24h)</name>
                            <priority>HIGH</priority>
                            <description>More than 5000 bans in 24 hours.</description>
                        </trigger>
                    </triggers>
                </item>
                <item>
                    <name>NFTBan: Bans (1h)</name>
                    <type>TRAP</type>
                    <key>nftban.bans.1h</key>
                    <delay>0</delay>
                    <value_type>UNSIGNED</value_type>
                    <description>Bans in last hour</description>
                    <applications>
                        <application>
                            <name>NFTBan Bans</name>
                        </application>
                    </applications>
                </item>
                <item>
                    <name>NFTBan: Ban rate</name>
                    <type>TRAP</type>
                    <key>nftban.bans.rate</key>
                    <delay>0</delay>
                    <value_type>FLOAT</value_type>
                    <units>/min</units>
                    <description>Current ban rate per minute</description>
                    <applications>
                        <application>
                            <name>NFTBan Bans</name>
                        </application>
                    </applications>
                </item>
                <item>
                    <name>NFTBan: Total bans</name>
                    <type>TRAP</type>
                    <key>nftban.bans.total</key>
                    <delay>0</delay>
                    <value_type>UNSIGNED</value_type>
                    <description>Total bans since daemon start</description>
                    <applications>
                        <application>
                            <name>NFTBan Bans</name>
                        </application>
                    </applications>
                </item>
                <item>
                    <name>NFTBan: Permanent bans</name>
                    <type>TRAP</type>
                    <key>nftban.permanent.count</key>
                    <delay>0</delay>
                    <value_type>UNSIGNED</value_type>
                    <description>Permanent ban count</description>
                    <applications>
                        <application>
                            <name>NFTBan Bans</name>
                        </application>
                    </applications>
                </item>
                <!-- Memory Metrics -->
                <item>
                    <name>NFTBan: Memory RSS</name>
                    <type>TRAP</type>
                    <key>nftban.memory.rss</key>
                    <delay>0</delay>
                    <value_type>UNSIGNED</value_type>
                    <units>B</units>
                    <description>Process resident set size</description>
                    <applications>
                        <application>
                            <name>NFTBan Memory</name>
                        </application>
                    </applications>
                    <triggers>
                        <trigger>
                            <expression>{last()}&gt;524288000</expression>
                            <name>NFTBan memory usage high (&gt;500MB)</name>
                            <priority>WARNING</priority>
                        </trigger>
                        <trigger>
                            <expression>{last()}&gt;1073741824</expression>
                            <name>NFTBan memory usage critical (&gt;1GB)</name>
                            <priority>HIGH</priority>
                        </trigger>
                    </triggers>
                </item>
                <item>
                    <name>NFTBan: Open file descriptors</name>
                    <type>TRAP</type>
                    <key>nftban.fds.open</key>
                    <delay>0</delay>
                    <value_type>UNSIGNED</value_type>
                    <description>Open file descriptors</description>
                    <applications>
                        <application>
                            <name>NFTBan Memory</name>
                        </application>
                    </applications>
                    <triggers>
                        <trigger>
                            <expression>{last()}&gt;1000</expression>
                            <name>NFTBan open FDs &gt; 1000</name>
                            <priority>WARNING</priority>
                        </trigger>
                    </triggers>
                </item>
                <item>
                    <name>NFTBan: Threads</name>
                    <type>TRAP</type>
                    <key>nftban.threads</key>
                    <delay>0</delay>
                    <value_type>UNSIGNED</value_type>
                    <description>OS thread count</description>
                    <applications>
                        <application>
                            <name>NFTBan Memory</name>
                        </application>
                    </applications>
                </item>
                <!-- Module Metrics -->
                <item>
                    <name>NFTBan: Modules enabled</name>
                    <type>TRAP</type>
                    <key>nftban.modules.enabled</key>
                    <delay>0</delay>
                    <value_type>UNSIGNED</value_type>
                    <description>Number of enabled modules</description>
                    <applications>
                        <application>
                            <name>NFTBan Modules</name>
                        </application>
                    </applications>
                </item>
                <item>
                    <name>NFTBan: Modules active</name>
                    <type>TRAP</type>
                    <key>nftban.modules.active</key>
                    <delay>0</delay>
                    <value_type>UNSIGNED</value_type>
                    <description>Number of currently active modules</description>
                    <applications>
                        <application>
                            <name>NFTBan Modules</name>
                        </application>
                    </applications>
                </item>
                <item>
                    <name>NFTBan: Modules failed</name>
                    <type>TRAP</type>
                    <key>nftban.modules.failed</key>
                    <delay>0</delay>
                    <value_type>UNSIGNED</value_type>
                    <description>Number of failed modules</description>
                    <applications>
                        <application>
                            <name>NFTBan Modules</name>
                        </application>
                    </applications>
                    <triggers>
                        <trigger>
                            <expression>{last()}&gt;0</expression>
                            <name>NFTBan module(s) failed ({ITEM.VALUE})</name>
                            <priority>HIGH</priority>
                        </trigger>
                    </triggers>
                </item>
                <!-- nftables Metrics -->
                <item>
                    <name>NFTBan: nftables sets</name>
                    <type>TRAP</type>
                    <key>nftban.nft.sets_total</key>
                    <delay>0</delay>
                    <value_type>UNSIGNED</value_type>
                    <description>Total nftables sets</description>
                    <applications>
                        <application>
                            <name>NFTBan</name>
                        </application>
                    </applications>
                </item>
                <item>
                    <name>NFTBan: nftables elements</name>
                    <type>TRAP</type>
                    <key>nftban.nft.elements_total</key>
                    <delay>0</delay>
                    <value_type>UNSIGNED</value_type>
                    <description>Total set elements across all sets</description>
                    <applications>
                        <application>
                            <name>NFTBan</name>
                        </application>
                    </applications>
                    <triggers>
                        <trigger>
                            <expression>{last()}&gt;100000</expression>
                            <name>NFTBan large ruleset (&gt;100k elements)</name>
                            <priority>WARNING</priority>
                        </trigger>
                    </triggers>
                </item>
                <item>
                    <name>NFTBan: nftables rules</name>
                    <type>TRAP</type>
                    <key>nftban.nft.rules_total</key>
                    <delay>0</delay>
                    <value_type>UNSIGNED</value_type>
                    <description>Total nftables rules</description>
                    <applications>
                        <application>
                            <name>NFTBan</name>
                        </application>
                    </applications>
                </item>
                <!-- Feeds Metrics -->
                <item>
                    <name>NFTBan: Feeds enabled</name>
                    <type>TRAP</type>
                    <key>nftban.feeds.enabled</key>
                    <delay>0</delay>
                    <value_type>UNSIGNED</value_type>
                    <description>Number of enabled threat feeds</description>
                    <applications>
                        <application>
                            <name>NFTBan Feeds</name>
                        </application>
                    </applications>
                </item>
                <item>
                    <name>NFTBan: Feeds loaded</name>
                    <type>TRAP</type>
                    <key>nftban.feeds.loaded</key>
                    <delay>0</delay>
                    <value_type>UNSIGNED</value_type>
                    <description>Number of successfully loaded feeds</description>
                    <applications>
                        <application>
                            <name>NFTBan Feeds</name>
                        </application>
                    </applications>
                </item>
                <item>
                    <name>NFTBan: Feeds failed</name>
                    <type>TRAP</type>
                    <key>nftban.feeds.failed</key>
                    <delay>0</delay>
                    <value_type>UNSIGNED</value_type>
                    <description>Number of failed feed loads</description>
                    <applications>
                        <application>
                            <name>NFTBan Feeds</name>
                        </application>
                    </applications>
                    <triggers>
                        <trigger>
                            <expression>{last()}&gt;0</expression>
                            <name>NFTBan feed load failures ({ITEM.VALUE})</name>
                            <priority>WARNING</priority>
                        </trigger>
                    </triggers>
                </item>
                <item>
                    <name>NFTBan: Feeds total IPs</name>
                    <type>TRAP</type>
                    <key>nftban.feeds.ips_total</key>
                    <delay>0</delay>
                    <value_type>UNSIGNED</value_type>
                    <description>Total IPs from all feeds</description>
                    <applications>
                        <application>
                            <name>NFTBan Feeds</name>
                        </application>
                    </applications>
                </item>
                <!-- GeoIP Metrics -->
                <item>
                    <name>NFTBan: GeoIP database age</name>
                    <type>TRAP</type>
                    <key>nftban.geoip.database_age</key>
                    <delay>0</delay>
                    <value_type>UNSIGNED</value_type>
                    <units>days</units>
                    <description>Age of GeoIP database in days</description>
                    <applications>
                        <application>
                            <name>NFTBan GeoIP</name>
                        </application>
                    </applications>
                    <triggers>
                        <trigger>
                            <expression>{last()}&gt;30</expression>
                            <name>NFTBan GeoIP database outdated (&gt;30 days)</name>
                            <priority>WARNING</priority>
                        </trigger>
                    </triggers>
                </item>
                <item>
                    <name>NFTBan: Countries blocked</name>
                    <type>TRAP</type>
                    <key>nftban.geoip.countries_blocked</key>
                    <delay>0</delay>
                    <value_type>UNSIGNED</value_type>
                    <description>Number of blocked countries</description>
                    <applications>
                        <application>
                            <name>NFTBan GeoIP</name>
                        </application>
                    </applications>
                </item>
                <!-- Watchdog Metrics -->
                <item>
                    <name>NFTBan: Watchdog status</name>
                    <type>TRAP</type>
                    <key>nftban.watchdog.status</key>
                    <delay>0</delay>
                    <value_type>SIGNED</value_type>
                    <description>Watchdog status: 1=ok, 0=disabled, -1=error</description>
                    <applications>
                        <application>
                            <name>NFTBan</name>
                        </application>
                    </applications>
                </item>
                <item>
                    <name>NFTBan: CPU pressure score</name>
                    <type>TRAP</type>
                    <key>nftban.watchdog.cpu_score</key>
                    <delay>0</delay>
                    <value_type>FLOAT</value_type>
                    <description>CPU pressure score (0-100)</description>
                    <applications>
                        <application>
                            <name>NFTBan</name>
                        </application>
                    </applications>
                    <triggers>
                        <trigger>
                            <expression>{last()}&gt;80</expression>
                            <name>NFTBan CPU pressure high</name>
                            <priority>WARNING</priority>
                        </trigger>
                    </triggers>
                </item>
                <item>
                    <name>NFTBan: Memory pressure score</name>
                    <type>TRAP</type>
                    <key>nftban.watchdog.mem_score</key>
                    <delay>0</delay>
                    <value_type>FLOAT</value_type>
                    <description>Memory pressure score (0-100)</description>
                    <applications>
                        <application>
                            <name>NFTBan</name>
                        </application>
                    </applications>
                    <triggers>
                        <trigger>
                            <expression>{last()}&gt;80</expression>
                            <name>NFTBan memory pressure high</name>
                            <priority>WARNING</priority>
                        </trigger>
                    </triggers>
                </item>
                <item>
                    <name>NFTBan: I/O pressure score</name>
                    <type>TRAP</type>
                    <key>nftban.watchdog.io_score</key>
                    <delay>0</delay>
                    <value_type>FLOAT</value_type>
                    <description>I/O pressure score (0-100)</description>
                    <applications>
                        <application>
                            <name>NFTBan</name>
                        </application>
                    </applications>
                </item>
                <!-- Server Info -->
                <item>
                    <name>NFTBan: Server hostname</name>
                    <type>TRAP</type>
                    <key>nftban.server.hostname</key>
                    <delay>0</delay>
                    <value_type>CHAR</value_type>
                    <description>Server hostname</description>
                    <applications>
                        <application>
                            <name>NFTBan</name>
                        </application>
                    </applications>
                </item>
                <item>
                    <name>NFTBan: Server OS</name>
                    <type>TRAP</type>
                    <key>nftban.server.os</key>
                    <delay>0</delay>
                    <value_type>CHAR</value_type>
                    <description>Operating system</description>
                    <applications>
                        <application>
                            <name>NFTBan</name>
                        </application>
                    </applications>
                </item>
                <item>
                    <name>NFTBan: Server kernel</name>
                    <type>TRAP</type>
                    <key>nftban.server.kernel</key>
                    <delay>0</delay>
                    <value_type>CHAR</value_type>
                    <description>Kernel version</description>
                    <applications>
                        <application>
                            <name>NFTBan</name>
                        </application>
                    </applications>
                </item>
                <item>
                    <name>NFTBan: CPU cores</name>
                    <type>TRAP</type>
                    <key>nftban.server.cpu_cores</key>
                    <delay>0</delay>
                    <value_type>UNSIGNED</value_type>
                    <description>Number of CPU cores</description>
                    <applications>
                        <application>
                            <name>NFTBan</name>
                        </application>
                    </applications>
                </item>
                <item>
                    <name>NFTBan: Load average (1m)</name>
                    <type>TRAP</type>
                    <key>nftban.server.load_1m</key>
                    <delay>0</delay>
                    <value_type>FLOAT</value_type>
                    <description>1-minute load average</description>
                    <applications>
                        <application>
                            <name>NFTBan</name>
                        </application>
                    </applications>
                </item>
                <item>
                    <name>NFTBan: Load average (5m)</name>
                    <type>TRAP</type>
                    <key>nftban.server.load_5m</key>
                    <delay>0</delay>
                    <value_type>FLOAT</value_type>
                    <description>5-minute load average</description>
                    <applications>
                        <application>
                            <name>NFTBan</name>
                        </application>
                    </applications>
                </item>
                <item>
                    <name>NFTBan: Load average (15m)</name>
                    <type>TRAP</type>
                    <key>nftban.server.load_15m</key>
                    <delay>0</delay>
                    <value_type>FLOAT</value_type>
                    <description>15-minute load average</description>
                    <applications>
                        <application>
                            <name>NFTBan</name>
                        </application>
                    </applications>
                </item>
            </items>
            <!-- Discovery Rules -->
            <discovery_rules>
                <discovery_rule>
                    <name>NFTBan: Module discovery</name>
                    <type>TRAP</type>
                    <key>nftban.discovery.modules</key>
                    <delay>0</delay>
                    <description>Discover all NFTBan modules</description>
                    <item_prototypes>
                        <item_prototype>
                            <name>NFTBan: Module {#MODULE} status</name>
                            <type>TRAP</type>
                            <key>nftban.module.status[{#MODULE}]</key>
                            <delay>0</delay>
                            <value_type>SIGNED</value_type>
                            <description>Module {#MODULE} status: 1=ok, 0=error, -1=disabled</description>
                            <applications>
                                <application>
                                    <name>NFTBan Modules</name>
                                </application>
                            </applications>
                        </item_prototype>
                        <item_prototype>
                            <name>NFTBan: Module {#MODULE} bans</name>
                            <type>TRAP</type>
                            <key>nftban.module.bans[{#MODULE}]</key>
                            <delay>0</delay>
                            <value_type>UNSIGNED</value_type>
                            <description>Bans from module {#MODULE}</description>
                            <applications>
                                <application>
                                    <name>NFTBan Modules</name>
                                </application>
                            </applications>
                        </item_prototype>
                    </item_prototypes>
                    <trigger_prototypes>
                        <trigger_prototype>
                            <expression>{NFTBan:nftban.module.status[{#MODULE}].last()}=0</expression>
                            <name>NFTBan module {#MODULE} failed</name>
                            <priority>HIGH</priority>
                            <description>Module {#MODULE} is in error state.</description>
                        </trigger_prototype>
                    </trigger_prototypes>
                </discovery_rule>
                <discovery_rule>
                    <name>NFTBan: Feed discovery</name>
                    <type>TRAP</type>
                    <key>nftban.discovery.feeds</key>
                    <delay>0</delay>
                    <description>Discover configured threat feeds</description>
                    <item_prototypes>
                        <item_prototype>
                            <name>NFTBan: Feed {#FEED} status</name>
                            <type>TRAP</type>
                            <key>nftban.feed.status[{#FEED}]</key>
                            <delay>0</delay>
                            <value_type>UNSIGNED</value_type>
                            <description>Feed {#FEED} status: 1=ok, 0=error</description>
                            <applications>
                                <application>
                                    <name>NFTBan Feeds</name>
                                </application>
                            </applications>
                        </item_prototype>
                        <item_prototype>
                            <name>NFTBan: Feed {#FEED} IPs</name>
                            <type>TRAP</type>
                            <key>nftban.feed.ips[{#FEED}]</key>
                            <delay>0</delay>
                            <value_type>UNSIGNED</value_type>
                            <description>IPs loaded from {#FEED}</description>
                            <applications>
                                <application>
                                    <name>NFTBan Feeds</name>
                                </application>
                            </applications>
                        </item_prototype>
                    </item_prototypes>
                    <trigger_prototypes>
                        <trigger_prototype>
                            <expression>{NFTBan:nftban.feed.status[{#FEED}].last()}=0</expression>
                            <name>NFTBan feed {#FEED} failed</name>
                            <priority>WARNING</priority>
                            <description>Threat feed {#FEED} failed to load.</description>
                        </trigger_prototype>
                    </trigger_prototypes>
                </discovery_rule>
                <discovery_rule>
                    <name>NFTBan: Country discovery</name>
                    <type>TRAP</type>
                    <key>nftban.discovery.countries</key>
                    <delay>0</delay>
                    <description>Discover countries with ban activity</description>
                    <item_prototypes>
                        <item_prototype>
                            <name>NFTBan: Country {#COUNTRY} bans</name>
                            <type>TRAP</type>
                            <key>nftban.country.bans[{#COUNTRY}]</key>
                            <delay>0</delay>
                            <value_type>UNSIGNED</value_type>
                            <description>Active bans from {#COUNTRY}</description>
                            <applications>
                                <application>
                                    <name>NFTBan GeoIP</name>
                                </application>
                            </applications>
                        </item_prototype>
                        <item_prototype>
                            <name>NFTBan: Country {#COUNTRY} bans (24h)</name>
                            <type>TRAP</type>
                            <key>nftban.country.bans_24h[{#COUNTRY}]</key>
                            <delay>0</delay>
                            <value_type>UNSIGNED</value_type>
                            <description>24h bans from {#COUNTRY}</description>
                            <applications>
                                <application>
                                    <name>NFTBan GeoIP</name>

366: 
367:     local nft_config="false"
368:     nftban_service_is_enabled "nftables" && nft_config="true"
369:     local nft_status
370:     nft_status=$(systemctl is-active nftables.service 2>/dev/null || echo "inactive")
371: 
372:     local suri_config="false"
373:     nftban_service_is_enabled "suricata" && suri_config="true"
374:     local suri_status
375:     suri_status=$(systemctl is-active suricata.service 2>/dev/null || echo "inactive")
376: 
377:     local login_config="false"
378:     nftban_service_is_enabled "login" && login_config="true"
379:     local login_status
380:     local login_svc="${NFTBAN_SERVICE_LOGIN_MONITOR:-nftban-login-monitor.service}"
381:     login_status=$(systemctl is-active "$login_svc" 2>/dev/null || echo "inactive")

396: # =============================================================================
397: # END OF OPTIMIZED CONFIGURATION
398: # =============================================================================
399: # Expected resource usage with this config:
400: # - CPU: 10-30% of 1 core (medium traffic)
401: # - RAM: 300-600 MB (typical)

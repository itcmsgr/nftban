 923: nftban_stats_find_repeat_offenders() {
 924:     # Identify repeat offenders
 925:     # Usage: nftban_stats_find_repeat_offenders [threshold]
 926:     # Returns: JSON array of IPs with multiple bans
 927: 
 928:     local threshold="${1:-${STATS_REPEAT_OFFENDER_THRESHOLD:-5}}"
 929: 
 930:     if [[ ! -f "$NFTBAN_BAN_LOG" ]]; then
 931:         echo "[]"
 932:         return 0
 933:     fi
 934: 
 935:     awk -F'|' -v thresh="$threshold" '
 936:     $6 == "BANNED" {ips[$4]++}
 937:     END {
 938:         printf "["
 939:         first=1
 940:         for (ip in ips) {
 941:             if (ips[ip] >= thresh) {
 942:                 if (!first) printf ","
 943:                 printf "{\"ip\":\"%s\",\"count\":%d}", ip, ips[ip]
 944:                 first=0
 945:             }
 946:         }
 947:         printf "]"
 948:     }' "$NFTBAN_BAN_LOG"
 949: }

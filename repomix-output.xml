578: nftban_module_render_table() {
579:     # Render module inventory as terminal table
580:     # Uses: NFTBAN_MODULE_OUTPUT_FORMAT
581: 
582:     if [[ "$NFTBAN_MODULE_OUTPUT_FORMAT" == "table" ]]; then
583:         local short_ts
584:         short_ts=$(date +"%Y-%m-%d %H:%M")
585:         echo ""
586:         echo "╔════════════════════════════════════════════════════════╗"
587:         printf "║  NFTBan Modules                 %-12s    ║\n" "$short_ts"
588:         echo "╚════════════════════════════════════════════════════════╝"
589:         echo ""
590:         printf "%-25s %-10s %-8s %-10s %-40s\n" \
591:             "NAME" "VERSION" "TYPE" "STATUS" "PATH"
592:         echo "────────────────────────────────────────────────────────"
593:     elif [[ "$NFTBAN_MODULE_OUTPUT_FORMAT" == "md" ]]; then
594:         echo "| NAME | VERSION | TYPE | STATUS | PATH | DEPENDS |"
595:         echo "|:---|:---|:---:|:---:|:---|:---|"
596:     elif [[ "$NFTBAN_MODULE_OUTPUT_FORMAT" == "csv" ]]; then
597:         echo "NAME,VERSION,TYPE,STATUS,PATH,DEPENDS"
598:     fi
599: 
600:     # Sort by module name
601:     local -a sorted_paths=()
602:     local file
603:     for file in "${!NFTBAN_MODULE_INVENTORY[@]}"; do
604:         sorted_paths+=("$file")
605:     done
606: 
607:     # Sort by name (extract from inventory)
608:     IFS=$'\n' read -r -d '' -a sorted_paths < <(
609:         for file in "${sorted_paths[@]}"; do
610:             local data="${NFTBAN_MODULE_INVENTORY[$file]}"
611:             local name="${data%%|*}"
612:             echo "$name|$file"
613:         done | sort | cut -d'|' -f2 && printf '\0'
614:     ) || true
615: 
616:     local file
617:     for file in "${sorted_paths[@]}"; do
618:         local data="${NFTBAN_MODULE_INVENTORY[$file]}"
619: 
620:         # Parse inventory data
621:         IFS='|' read -r name version module_type created depends owner homepage description <<< "$data"
622: 
623:         # Get enabled status
624:         local status
625:         status="$(nftban_module_check_enabled "$file")"
626: 
627:         # Use full path
628:         local display_path="$file"
629: 
630:         # Render row
631:         if [[ "$NFTBAN_MODULE_OUTPUT_FORMAT" == "table" ]]; then
632:             # Status badge
633:             local status_badge
634:             if [[ "$status" == "ENABLED" ]]; then
635:                 status_badge="${C_GREEN:-}${NFTBAN_MODULE_SYM_OK}${C_RESET:-} ENABLED"
636:             else
637:                 status_badge="${C_YELLOW:-}${NFTBAN_MODULE_SYM_KO}${C_RESET:-} DISABLED"
638:             fi
639: 
640:             printf "%-25s %-10s %-8s %-10s %s\n" \
641:                 "${name:0:24}" \
642:                 "${version:0:9}" \
643:                 "${module_type:0:7}" \
644:                 "$status_badge" \
645:                 "$display_path"
646: 
647:         elif [[ "$NFTBAN_MODULE_OUTPUT_FORMAT" == "md" ]]; then
648:             printf "| %s | %s | %s | %s | %s | %s |\n" \
649:                 "$name" "$version" "$module_type" "$status" "$display_path" "$depends"
650: 
651:         else # csv
652:             printf "%s,%s,%s,%s,%s,%s\n" \
653:                 "$name" "$version" "$module_type" "$status" "\"$file\"" "\"$depends\""
654:         fi
655:     done
656: 
657:     if [[ "$NFTBAN_MODULE_OUTPUT_FORMAT" == "table" ]]; then
658:         echo
659:         local total="${#NFTBAN_MODULE_INVENTORY[@]}"
660:         local enabled=0
661:         for file in "${!NFTBAN_MODULE_INVENTORY[@]}"; do
662:             if [[ "$(nftban_module_check_enabled "$file")" == "ENABLED" ]]; then
663:                 (( enabled++ ))
664:             fi
665:         done
666:         echo "Total modules: $total | Enabled: $enabled | Disabled: $((total - enabled))"
667:         echo
668: 
669:         # Module Type Legend
670:         echo "────────────────────────────────────────────────────────────────────────────────────"
671:         echo "MODULE TYPES:"
672:         echo "  cli      - Command-line interface handlers (nftban <command>)"
673:         echo "  core     - Core functionality modules (loaded by CLI commands)"
674:         echo "  lib      - Shared libraries (sourced by multiple modules)"
675:         echo "  helper   - Helper utilities (logging, JSON output, etc.)"
676:         echo "  setup    - Installation and setup scripts"
677:         echo "  exporter - Prometheus/metrics exporters"
678:         echo "  cron     - Scheduled task modules (timers)"
679:         echo ""
680:         echo "STATUS:"
681:         echo "  ✔ ENABLED  - Module is active and available"
682:         echo "  ✖ DISABLED - Module exists but not in active path"
683:         echo ""
684:     fi
685: }

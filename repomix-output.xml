 1: package suricata
 2: 
 3: import (
 4: 	"strings"
 5: )
 6: 
 7: // FilterMatcher handles matching Suricata signatures to filters
 8: type FilterMatcher struct {
 9: 	config *Config
10: }
11: 
12: // NewFilterMatcher creates a new filter matcher
13: func NewFilterMatcher(config *Config) *FilterMatcher {
14: 	return &FilterMatcher{
15: 		config: config,
16: 	}
17: }
18: 
19: // MatchSignature matches a Suricata signature against configured filters
20: // Returns the matching filter name, or empty string if no match
21: func (fm *FilterMatcher) MatchSignature(signature string) (string, *FilterConfig) {
22: 	sigLower := strings.ToLower(signature)
23: 
24: 	// Try to match against each enabled filter
25: 	for name, filter := range fm.config.GetEnabledFilters() {
26: 		// Check if any keyword matches
27: 		for _, keyword := range filter.Keywords {
28: 			if strings.Contains(sigLower, keyword) {
29: 				return name, filter
30: 			}
31: 		}
32: 	}
33: 
34: 	return "", nil
35: }
36: 
37: // MatchCategory matches a Suricata category against configured filters
38: func (fm *FilterMatcher) MatchCategory(category string) (string, *FilterConfig) {
39: 	catLower := strings.ToLower(category)
40: 
41: 	// Try to match category against filter keywords
42: 	for name, filter := range fm.config.GetEnabledFilters() {
43: 		for _, keyword := range filter.Keywords {
44: 			if strings.Contains(catLower, keyword) {
45: 				return name, filter
46: 			}
47: 		}
48: 	}
49: 
50: 	return "", nil
51: }
52: 
53: // GetFilterForEvent determines which filter matches an event
54: // Tries signature first, then category, returns first match
55: func (fm *FilterMatcher) GetFilterForEvent(signature, category string) (string, *FilterConfig) {
56: 	// Try signature match first (more specific)
57: 	if name, filter := fm.MatchSignature(signature); filter != nil {
58: 		return name, filter
59: 	}
60: 
61: 	// Fall back to category match
62: 	if name, filter := fm.MatchCategory(category); filter != nil {
63: 		return name, filter
64: 	}
65: 
66: 	// No match
67: 	return "", nil
68: }
</file>

<file path="pkg/suricata/reader.go">
  1: package suricata
  2: 
  3: import (
  4: 	"bufio"
  5: 	"encoding/json"
  6: 	"fmt"
  7: 	"io"

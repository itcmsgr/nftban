159: // BandwidthCurrentHandler - GET /api/v1/bandwidth/current
160: func BandwidthCurrentHandler(w http.ResponseWriter, r *http.Request) {
161: 	metrics, err := getBandwidthMetrics()
162: 	if err != nil {
163: 		log.Printf("[API] Failed to get bandwidth metrics: %v", err)
164: 		respondJSON(w, http.StatusInternalServerError, map[string]string{
165: 			"error":   "Bandwidth data unavailable",
166: 			"message": "Exporter not running or metrics file missing",
167: 			"code":    "BANDWIDTH_UNAVAILABLE",
168: 		})
169: 		return
170: 	}
171: 
172: 	// Build response
173: 	response := BandwidthCurrentResponse{
174: 		Timestamp: metrics.Timestamp.Unix(),
175: 		Total: BandwidthTotal{
176: 			RxMbps: metrics.TotalRxMbps,
177: 			TxMbps: metrics.TotalTxMbps,
178: 		},
179: 		Interfaces:  make([]BandwidthInterface, 0, len(metrics.Interfaces)),
180: 		Protocols:   make(map[string]ProtocolStats),
181: 		Connections: metrics.Connections,
182: 		Peaks5Min:   metrics.Peaks,
183: 	}
184: 
185: 	// Add interfaces
186: 	var totalRxBytes, totalTxBytes, totalRxPackets, totalTxPackets uint64
187: 	for _, iface := range metrics.Interfaces {
188: 		response.Interfaces = append(response.Interfaces, *iface)
189: 		totalRxBytes += iface.RxBytes
190: 		totalTxBytes += iface.TxBytes
191: 		totalRxPackets += iface.RxPackets
192: 		totalTxPackets += iface.TxPackets
193: 	}
194: 
195: 	response.Total.RxBytes = totalRxBytes
196: 	response.Total.TxBytes = totalTxBytes
197: 	response.Total.RxPackets = totalRxPackets
198: 	response.Total.TxPackets = totalTxPackets
199: 
200: 	// Add protocols
201: 	for proto, stats := range metrics.Protocols {
202: 		response.Protocols[proto] = *stats
203: 	}
204: 
205: 	respondJSON(w, http.StatusOK, response)
206: }

247:                 window.currentLogs = [];
248:             }
249: 
250:             window.filteredLogs = window.currentLogs;
251:             displayLogs();
252:             updateStats();
253:             updateLastUpdateTime();
254: 
255:             // Show message if no logs
256:             if (window.currentLogs.length === 0 && response.message) {
257:                 container.innerHTML = `<div style="text-align: center; color: var(--text-muted);">${response.message}</div>`;
258:             }
259:         } else {
260:             container.innerHTML = '<div style="text-align: center; color: var(--text-muted);">No logs available</div>';
261:             window.currentLogs = [];
262:             window.filteredLogs = [];
263:             updateStats();
264:         }
265:     } catch (error) {
266:         console.error('Failed to load logs:', error);
267:         document.getElementById('logs-container').innerHTML =
268:             `<div style="text-align: center; color: #ff6b6b;">Error loading logs: ${error.message}</div>`;
269:         window.currentLogs = [];
270:         window.filteredLogs = [];
271:         updateStats();
272:     }
273: }
274: 
275: function displayLogs() {
276:     const container = document.getElementById('logs-container');
277: 
278:     if (window.filteredLogs.length === 0) {
279:         container.innerHTML = '<div style="text-align: center; color: var(--text-muted);">No logs match your search filter</div>';
280:         return;
281:     }
282: 
283:     // Join lines and display
284:     container.textContent = window.filteredLogs.join('\n');
285: 
286:     // Auto-scroll to bottom if enabled
287:     if (window.autoScrollEnabled) {
288:         container.scrollTop = container.scrollHeight;
289:     }
290: }
291: 
292: function filterLogs() {
293:     const searchTerm = document.getElementById('log-search').value.toLowerCase();
294: 
295:     if (!searchTerm) {
296:         window.filteredLogs = window.currentLogs;
297:     } else {
298:         window.filteredLogs = window.currentLogs.filter(line =>
299:             line.toLowerCase().includes(searchTerm)
300:         );
301:     }
302: 
303:     displayLogs();
304:     updateStats();
305: }
306: 
307: function refreshLogs() {
308:     loadSelectedLogs();
309: }
310: 
311: function clearLogsDisplay() {
312:     if (!confirm('Clear the logs display? This will not delete actual log files.')) return;
313: 
314:     window.currentLogs = [];
315:     window.filteredLogs = [];
316:     document.getElementById('logs-container').innerHTML =
317:         '<div style="text-align: center; color: var(--text-muted);"><i class="fa fa-circle-info"></i> Display cleared. Select a log type and click "Load Logs".</div>';
318:     updateStats();
319: }
320: 
321: function downloadLogs() {
322:     const logType = document.getElementById('log-type').value;
323:     const logsText = window.filteredLogs.join('\n');
324: 
325:     if (!logsText || logsText.length === 0) {
326:         console.log('[warning]', 'No logs to download');
327:         return;
328:     }
329: 
330:     const blob = new Blob([logsText], { type: 'text/plain' });
331:     const url = URL.createObjectURL(blob);
332:     const a = document.createElement('a');
333:     a.href = url;
334:     a.download = `nftban_${logType}_${new Date().toISOString().replace(/[:.]/g, '-')}.txt`;
335:     document.body.appendChild(a);
336:     a.click();
337:     document.body.removeChild(a);
338:     URL.revokeObjectURL(url);
339: 
340:     console.log('[success]', `Downloaded ${window.filteredLogs.length} lines`);
341: }
342: 
343: function toggleTailMode() {
344:     const enabled = document.getElementById('tail-mode').checked;
345:     window.autoScrollEnabled = enabled;
346: 
347:     if (enabled) {
348:         // Start auto-refresh
349:         window.tailInterval = setInterval(() => {
350:             loadSelectedLogs();
351:         }, 3000);
352:         console.log('[info]', 'Tail mode enabled - auto-refreshing every 3 seconds');
353:     } else {
354:         // Stop auto-refresh
355:         if (window.tailInterval) {
356:             clearInterval(window.tailInterval);
357:             window.tailInterval = null;
358:         }
359:         console.log('[info]', 'Tail mode disabled');
360:     }
361: }
362: 
363: function updateStats() {
364:     document.getElementById('total-lines').textContent = window.currentLogs.length.toLocaleString();
365:     document.getElementById('visible-lines').textContent = window.filteredLogs.length.toLocaleString();
366: }

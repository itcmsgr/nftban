# =============================================================================
# NFTBan Lab Deployment Gate — Server Configuration (EXAMPLE TEMPLATE)
# =============================================================================
# meta:name="lab-deploy-servers"
# meta:type="config"
# meta:version="1.0.0"
# meta:owner="NFTBan maintainers <contact@nftban.com>"
# meta:description="Server list for lab deployment gate testing (example template)"
# meta:inventory.files="scripts/lab-deploy-servers.conf"
# meta:inventory.binaries=""
# meta:inventory.env_vars=""
# meta:inventory.config_files=""
# meta:inventory.systemd_units=""
# meta:inventory.network=""
# meta:inventory.privileges="none"
# =============================================================================
# Copy this file to scripts/lab-deploy-servers.conf and fill in your own hosts.
# The real file is gitignored and MUST NOT be committed — it contains private
# lab/fleet infrastructure (hostnames, IPs, ports, OS/panel assignments).
#
# Format: ALIAS|HOST|PORT|OS_FAMILY|GATE_LIST|ENABLED
#   ALIAS      — short name for output
#   HOST       — SSH hostname or IP
#   PORT       — SSH port
#   OS_FAMILY  — rpm or deb (selects package type + install command)
#   GATE_LIST  — comma-separated gates to run (G1,G4,G5,G6)
#   ENABLED    — 1=active, 0=skip
#
# Gate reference:
#   G1 = DEB upgrade (dpkg -i)
#   G2 = DEB upgrade (apt-get, panel server)
#   G3 = DEB takeover (NFTBAN_TAKEOVER=1)
#   G4 = RPM no-regression (dnf install)
#   G5 = Installer binary present
#   G6 = Installer log validation
# =============================================================================

# DEB servers (documentation examples — replace with your own)
deb-lab-01|deb-lab-01.example.test|22|deb|G1,G5,G6|1
observability-node-01|observability-node-01.example.test|55000|deb|G2,G5,G6|1

# RPM servers
rpm-lab-01|rpm-lab-01.example.test|22|rpm|G4,G5,G6|1
rpm-lab-02|rpm-lab-02.example.test|22|rpm|G4,G5,G6|1
rpm-host-ip|192.0.2.89|22|rpm|G4,G5,G6|1

app-node-02|app-node-02.example.test|55000|rpm|G4,G5,G6|1

# DEB takeover (CSF + control panel host)
app-node-03|app-node-03.example.test|22|deb|G3,G5,G6|1

# G3 (takeover) needs a host with CSF installed

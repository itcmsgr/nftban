240: 	}
241: 
242: 	// Modify the rule
243: 	lines := strings.Split(string(content), "\n")
244: 	newLines := make([]string, 0, len(lines))
245: 	modified := false
246: 
247: 	sidPattern := fmt.Sprintf("sid:%d;", sid)
248: 
249: 	for _, line := range lines {
250: 		trimmed := strings.TrimSpace(line)
251: 		if strings.Contains(line, sidPattern) {
252: 			if enabled {
253: 				// Remove comment if present
254: 				if strings.HasPrefix(trimmed, "#") {
255: 					line = strings.TrimPrefix(trimmed, "#")
256: 					line = strings.TrimSpace(line)
257: 					modified = true
258: 				}
259: 			} else {
260: 				// Add comment if not present
261: 				if !strings.HasPrefix(trimmed, "#") {
262: 					line = "# " + trimmed
263: 					modified = true
264: 				}
265: 			}
266: 		}
267: 		newLines = append(newLines, line)
268: 	}
269: 
270: 	if !modified {
271: 		if enabled {
272: 			return fmt.Errorf("rule with SID %d is already enabled or not found", sid)
273: 		}
274: 		return fmt.Errorf("rule with SID %d is already disabled or not found", sid)
275: 	}
276: 
277: 	// Write back
278: 	newContent := strings.Join(newLines, "\n")
279: 	if err := os.WriteFile(m.customFile, []byte(newContent), 0644); err != nil {
280: 		return fmt.Errorf("failed to write custom.rules: %w", err)
281: 	}
282: 
283: 	return nil
284: }

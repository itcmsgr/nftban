186: 			fmt.Fprintf(os.Stderr, "Error: %v\n", err)
187: 			os.Exit(1)
188: 		}
189: 	case "analytics":
190: 		if len(os.Args) < 3 {
191: 			errorWithUsage("analytics", "analytics command requires an action")
192: 			os.Exit(1)
193: 		}
194: 		action := os.Args[2]
195: 		if err := cmdAnalytics(action, cfg); err != nil {
196: 			fmt.Fprintf(os.Stderr, "Error: %v\n", err)
197: 			os.Exit(1)
198: 		}
199: 	case "profile-sync":
200: 		if err := runProfileSync(cfg); err != nil {
201: 			fmt.Fprintf(os.Stderr, "Error: %v\n", err)
202: 			os.Exit(1)
203: 		}
204: 	case "version":
205: 		fmt.Printf("nftban-core %s (git %s, build %s)\n", version.FullVersion(), GitCommit, BuildDate)
206: 	case "help", "--help", "-h":
207: 		printUsage()
208: 	default:
209: 		fmt.Fprintf(os.Stderr, "Unknown command: %s\n", command)
210: 		printUsage()
211: 		os.Exit(1)
212: 	}
213: }
214: 
215: func printUsage() {
216: 	fmt.Printf("%s - %s Core Engine\n", version.CoreEngineName, version.Banner(""))
217: 	fmt.Println()
218: 	fmt.Println("Usage:")
219: 	fmt.Println("  nftban-core init                 Initialize NFTBan with safety checks")
220: 	fmt.Println("  nftban-core status               Show current firewall status")
221: 	fmt.Println("  nftban-core sync                 Sync config files to nftables (differential)")
222: 	fmt.Println("  nftban-core ban <IP> [reason]    Ban an IP address")
223: 	fmt.Println("  nftban-core unban <IP>           Unban an IP address")
224: 	fmt.Println("  nftban-core check <IP>           Check IP status (whitelist/blacklist)")
225: 	fmt.Println("  nftban-core feeds [list|load|stats] Manage threat feeds")
226: 	fmt.Println("  nftban-core ports [list|load|status] Manage port rules (IPv4/IPv6 auto-detect)")
227: 	fmt.Println("  nftban-core geoip [update|status|lookup] Manage GeoIP database and lookups")
228: 	fmt.Println("  nftban-core suricata [status|filters|enable|disable] Manage Suricata IDS integration (v1.0)")
229: 	fmt.Println("  nftban-core analytics [summary|countries|top|ip] Show ban analytics (use --json for GUI)")
230: 	fmt.Println("  nftban-core profile-sync         Run sync operations with profiling enabled (pprof on :6060)")
231: 	fmt.Println("  nftban-core version              Show version information")
232: 	fmt.Println("  nftban-core help                 Show this help message")
233: 	fmt.Println()
234: }
</file>

<file path="cmd/nftban-core/profile_sync.go">
  1: package main
  2: 
  3: import (
  4: 	"fmt"
  5: 	"log"
  6: 	"net/http"
  7: 	_ "net/http/pprof"
  8: 	"time"
  9: 
 10: 	"github.com/itcmsgr/nftban/pkg/blacklist"
 11: 	"github.com/itcmsgr/nftban/pkg/nftbanconf"
 12: 	"github.com/itcmsgr/nftban/pkg/sync"
 13: 	"github.com/itcmsgr/nftban/pkg/whitelist"
 14: )
 15: 
 16: // getProfileSyncConfigDir returns the config directory from passed config
 17: func getProfileSyncConfigDir(cfg *nftbanconf.Config) string {
 18: 	return cfg.ConfigDir
 19: }
 20: 
 21: func runProfileSync(cfg *nftbanconf.Config) error {
 22: 	// Start pprof HTTP server
 23: 	go func() {
 24: 		log.Println("🔍 Profiling server starting on :6060")
 25: 		log.Println("")
 26: 		log.Println("Access profiling data:")
 27: 		log.Println("  CPU Profile:    go tool pprof http://localhost:6060/debug/pprof/profile?seconds=30")
 28: 		log.Println("  Heap Profile:   go tool pprof http://localhost:6060/debug/pprof/heap")
 29: 		log.Println("  Allocs Profile: go tool pprof http://localhost:6060/debug/pprof/allocs")
 30: 		log.Println("  Goroutines:     go tool pprof http://localhost:6060/debug/pprof/goroutine")
 31: 		log.Println("")
 32: 		log.Println("Interactive pprof commands:")
 33: 		log.Println("  top20          - Show top 20 CPU/memory consumers")
 34: 		log.Println("  list FuncName  - Show annotated source code")
 35: 		log.Println("  web            - Generate call graph (requires graphviz)")
 36: 		log.Println("  png            - Save call graph as PNG")
 37: 		log.Println("")
 38: 		if err := http.ListenAndServe("localhost:6060", nil); err != nil {
 39: 			log.Printf("pprof server error: %v", err)
 40: 		}
 41: 	}()
 42: 
 43: 	// Small delay to ensure pprof server is ready
 44: 	time.Sleep(100 * time.Millisecond)
 45: 
 46: 	// Initialize NFT Manager
 47: 	log.Println("🔧 Initializing NFT Manager...")
 48: 	nft, err := sync.NewNFTManager()
 49: 	if err != nil {
 50: 		return fmt.Errorf("failed to create NFT manager: %w", err)
 51: 	}
 52: 	defer nft.Close()
 53: 
 54: 	// Load whitelist
 55: 	configDir := getProfileSyncConfigDir(cfg)
 56: 	log.Println("📥 Loading whitelist...")
 57: 	whitelistIPv4, whitelistIPv6, err := whitelist.LoadAllWhitelists(configDir)
 58: 	if err != nil {
 59: 		return fmt.Errorf("failed to load whitelist: %w", err)
 60: 	}
 61: 	log.Printf("  ✅ Loaded %d IPv4 + %d IPv6 whitelist entries", len(whitelistIPv4), len(whitelistIPv6))
 62: 
 63: 	// Load blacklist
 64: 	log.Println("📥 Loading blacklist...")
 65: 	blacklistIPv4, blacklistIPv6, err := blacklist.LoadAllBlacklists(configDir)
 66: 	if err != nil {
 67: 		return fmt.Errorf("failed to load blacklist: %w", err)
 68: 	}
 69: 	log.Printf("  ✅ Loaded %d IPv4 + %d IPv6 blacklist entries", len(blacklistIPv4), len(blacklistIPv6))
 70: 
 71: 	// Convert maps to slices for processing
 72: 	wl4Slice := mapKeysToSlice(whitelistIPv4)
 73: 	wl6Slice := mapKeysToSlice(whitelistIPv6)
 74: 	bl4Slice := mapKeysToSlice(blacklistIPv4)
 75: 	bl6Slice := mapKeysToSlice(blacklistIPv6)
 76: 
 77: 	// Run sync operations multiple times to generate profile data
 78: 	log.Println("")
 79: 	log.Println("🔄 Running sync operations for profiling...")
 80: 	log.Println("   (5 iterations to generate meaningful profile data)")
 81: 	log.Println("")
 82: 
 83: 	var totalDuration time.Duration
 84: 	iterations := 5
 85: 
 86: 	for i := 0; i < iterations; i++ {
 87: 		start := time.Now()
 88: 		log.Printf("  📊 Iteration %d/%d starting...", i+1, iterations)
 89: 
 90: 		// NOTE: CIDR merging profiling disabled - implementation reserved for future
 91: 		// TODO: Re-enable when CIDR merge implementation is completed
 92: 
 93: 		// Test diff computation
 94: 		wl4Diff := sync.ComputeDiff(wl4Slice, []string{})
 95: 		wl6Diff := sync.ComputeDiff(wl6Slice, []string{})
 96: 		bl4Diff := sync.ComputeDiff(bl4Slice, []string{})
 97: 		bl6Diff := sync.ComputeDiff(bl6Slice, []string{})
 98: 
 99: 		duration := time.Since(start)
100: 		totalDuration += duration
101: 		log.Printf("  ✅ Iteration %d/%d completed in %s", i+1, iterations, duration)
102: 		log.Printf("     WL4: +%d -%d | WL6: +%d -%d | BL4: +%d -%d | BL6: +%d -%d",
103: 			len(wl4Diff.ToAdd), len(wl4Diff.ToRemove),
104: 			len(wl6Diff.ToAdd), len(wl6Diff.ToRemove),
105: 			len(bl4Diff.ToAdd), len(bl4Diff.ToRemove),
106: 			len(bl6Diff.ToAdd), len(bl6Diff.ToRemove))
107: 
108: 		// Small delay between iterations
109: 		time.Sleep(100 * time.Millisecond)
110: 	}
111: 
112: 	avgDuration := totalDuration / time.Duration(iterations)
113: 	log.Println("")
114: 	log.Println("📊 Performance Summary:")
115: 	log.Printf("  Total time:   %s", totalDuration)
116: 	log.Printf("  Average/sync: %s", avgDuration)
117: 	log.Printf("  Iterations:   %d", iterations)
118: 	log.Println("")
119: 	log.Println("🔍 Profiling data ready!")
120: 	log.Println("   Press Ctrl+C to exit (or leave running to capture more data)")
121: 	log.Println("")
122: 
123: 	// Keep server alive for profiling
124: 	select {}
125: }
126: 
127: // mapKeysToSlice converts a map[string]bool to []string
128: func mapKeysToSlice(m map[string]bool) []string {
129: 	result := make([]string, 0, len(m))
130: 	for k := range m {
131: 		result = append(result, k)
132: 	}
133: 	return result
134: }
</file>

<file path="install/man/man8/nftban.8">
  1: .\" NFTBan - nftables-based firewall management
  2: .\" Copyright (c) 2024-2026 Antonios Voulvoulis
  3: .TH NFTBAN 8 "December 2025" "NFTBan 1.0.21" "System Administration"
  4: .SH NAME
  5: nftban \- nftables-based firewall management and intrusion prevention system
  6: .SH SYNOPSIS
  7: .B nftban
  8: .RI [ command ]
  9: .RI [ subcommand ]
 10: .RI [ options ]
 11: .SH DESCRIPTION
 12: .B NFTBAN
 13: is an enterprise-grade firewall management engine built on Linux nftables.
 14: It replaces legacy iptables-based scripts with a modern architecture featuring
 15: atomic rule updates, strict privilege separation via Polkit, and AI-assisted
 16: threat intelligence.
 17: .PP
 18: The name
 19: .B NFTBAN
 20: stands for
 21: .IR "NFTables BAN actions" ,
 22: emphasizing its foundation on native nftables technology for high-performance,
 23: kernel-level packet filtering and ban enforcement.
 24: .PP
 25: .B Key Capabilities:
 26: .IP "\fBAtomic Performance\fR" 4
 27: Leverages native nftables for near-instant rule updates without flushing
 28: existing connections or causing network disruption.
 29: .IP "\fBSecurity First\fR" 4
 30: Uses Polkit for granular privilege separation, enabling firewall management
 31: without requiring full root access.
 32: .IP "\fBIntelligent Defense\fR" 4
 33: Integrates AI-assisted threat intelligence for proactive, self-healing network
 34: protection. Supports real-time feeds from Spamhaus, AbuseIPDB, and Firehol.
 35: .IP "\fBHosting Ready\fR" 4
 36: Built-in support for DirectAdmin, cPanel, CWP, CyberPanel, and custom control
 37: panels. Automatically detects and whitelists critical service ports.
 38: .SH ARCHITECTURE
 39: .B NFTBAN
 40: operates through direct integration with the Linux nftables netfilter framework.
 41: All firewall operations are executed as atomic nftables transactions, providing
 42: deterministic, high-performance packet filtering at the kernel level with zero
 43: connection disruption during rule updates.
 44: .SH COMMANDS
 45: .SS "Core Commands"
 46: .TP
 47: .B status
 48: Display system status including firewall state, banned IPs, and service health.
 49: Use \fB\-\-json\fR for machine-readable output.
 50: .TP
 51: .B health
 52: Run comprehensive health checks on all NFTBan components.
 53: .TP
 54: .B check
 55: Verify environment and prerequisites for NFTBan operation.
 56: .TP
 57: .B validate
 58: Validate configuration files for syntax and logical errors.
 59: .TP
 60: .B sync
 61: Atomic reload of nftables rules preserving runtime state.
 62: .TP
 63: .B version
 64: Display NFTBan version and component versions.
 65: .TP
 66: .B help
 67: Show available commands and usage information.
 68: .SS "Service Control"
 69: .TP
 70: .B enable \fR[\fIservice\fR]
 71: Enable NFTBan services (all, nftables, suricata, login, timers).
 72: .TP
 73: .B disable \fR[\fIservice\fR]
 74: Disable NFTBan services.
 75: .TP
 76: .B restart \fR[\fIservice\fR]
 77: Restart NFTBan services.
 78: .TP
 79: .B services
 80: Display status of all NFTBan-related services.
 81: .SS "Firewall Management"
 82: .TP
 83: .B firewall \fR[\fIsubcommand\fR]
 84: Manage nftables firewall: init, reload, status, check, reset, validate, stats.
 85: .TP
 86: .B ban \fIIP\fR [\fIoptions\fR]
 87: Ban an IP address. Options: \fB\-\-timeout\fR, \fB\-\-reason\fR, \fB\-\-permanent\fR.
 88: .TP
 89: .B unban \fIIP\fR
 90: Remove ban on an IP address.
 91: .TP
 92: .B list \fR[\fItype\fR]
 93: List IPs: banned, whitelist, or all. Use \fB\-\-json\fR for JSON output.
 94: .TP
 95: .B search \fIIP\fR
 96: Search for an IP across all blocklists and show ban details.
 97: .TP
 98: .B whitelist \fR[\fIsubcommand\fR]
 99: Manage IP whitelist: sync, show, whitelistme.
100: .TP
101: .B whitelist-system
102: Auto-whitelist essential system IPs (gateway, DNS, server IPs).
103: Ensures critical infrastructure is never blocked.
104: .SS "Protection Modules"
105: .TP
106: .B ddos \fR[\fIsubcommand\fR]
107: DDoS protection: enable, disable, status, test.
108: .TP
109: .B portscan \fR[\fIsubcommand\fR]
110: Port scan detection: enable, disable, status, check, history, test.
111: .TP
112: .B login \fR[\fIsubcommand\fR]
113: Login monitoring: status, enable, disable, logs, test, run.
114: .br
115: \fBenable\fR auto-installs the service and enables SSH monitoring in one step.
116: .br
117: Use \fBenable all\fR for ssh+su+sudo, or \fBenable ssh\fR for specific types.
118: .TP
119: .B feeds \fR[\fIsubcommand\fR]
120: Threat intelligence feeds: select, list, enable, disable, update, status.
121: .TP
122: .B trust \fR[\fIsubcommand\fR]
123: Trust feeds (whitelist CDN/cloud): list, enable, disable, update, load, status.
124: Supports Cloudflare, AWS, Google Cloud, Azure, Fastly, and more.
125: .TP
126: .B country \fR[\fIsubcommand\fR]
127: Country blocking: list, enable, disable, mode, status, apply.
128: Block or allow traffic by ISO country code (CN, RU, etc.).
129: .TP
130: .B cloudflare \fR[\fIsubcommand\fR]
131: Cloudflare IP management: enable, disable, update, status.
132: .br
133: \fBDEPRECATED\fR: Use \fBnftban trust enable CLOUDFLARE\fR instead for unified CDN management.
134: .SS "GeoIP and Geographic Blocking"
135: .TP
136: .B geoip \fR[\fIsubcommand\fR]
137: GeoIP lookups: lookup, bulk, status, test, update, config.
138: .TP
139: .B geoban \fR[\fIsubcommand\fR]
140: Geographic blocking: ban, unban, whitelist, unwhitelist, list, status.
141: .SS "Monitoring and Reporting"
142: .TP
143: .B stats \fR[\fIsubcommand\fR]
144: Statistics and monitoring. Subcommands:
145: .RS
146: .IP \fBdashboard\fR
147: Show statistics dashboard (default). Options: \fB\-\-json\fR, \fB\-\-last\fR, \fB\-\-since\fR, \fB\-\-until\fR.
148: .IP "\fBtop\fR \fItype\fR [\fIN\fR]"
149: Show top lists: ips, countries, jails. Example: \fBnftban stats top ips 20\fR.
150: .IP "\fBip\fR \fIIP\fR"
151: Show ban history for specific IP address.
152: .IP "\fBrecent\fR [\fIN\fR]"
153: Show recent ban activity. Use \fB\-\-follow\fR for real-time.
154: .IP \fBmonitor\fR
155: Real-time monitoring with auto-refresh. Use \fB\-\-interval\fR to set refresh rate.
156: .IP \fBexport\fR
157: Export statistics to file. Options: \fB\-\-format\fR (json/csv), \fB\-\-output\fR, \fB\-\-since\fR, \fB\-\-until\fR.
158: .IP \fBsnapshot\fR
159: Create hourly statistics snapshot.
160: .IP \fBcleanup\fR
161: Cleanup old logs and snapshots. Use \fB\-\-days\fR to set retention (default: 90).
162: .IP \fBclear-cache\fR
163: Clear statistics cache.
164: .IP \fBcheck-alerts\fR
165: Check for threshold alerts.
166: .RE
167: .TP
168: .B watchdog \fR[\fIsubcommand\fR]
169: System resource monitoring: status, check, report, history, enable, disable.
170: .br
171: Monitors load average, memory, I/O wait, disk usage.
172: .br
173: Exports Prometheus metrics to /var/lib/nftban/metrics/watchdog.prom.
174: .TP
175: .B report \fR[\fIsubcommand\fR]
176: Generate reports: generate, email, schedule, run, list.
177: .TP
178: .B metrics \fR[\fIsubcommand\fR]
179: Prometheus metrics: enable, disable, status.
180: .TP
181: .B timers \fR[\fIsubcommand\fR]
182: Systemd timer management: status, enable, disable.
183: .TP
184: .B mail \fR[\fIsubcommand\fR]
185: Email notifications: test, send, configure.
186: Send reports and alerts via email.
187: .SS "Configuration and Setup"
188: .TP
189: .B config \fR[\fIsubcommand\fR]
190: Configuration management.
191: .TP
192: .B setup \fR[\fIsubcommand\fR]
193: Initial system setup.
194: .TP
195: .B wizard
196: Interactive setup wizard with step-by-step configuration.
197: Guides new users through initial NFTBan configuration.
198: .TP
199: .B profile \fR[\fIsubcommand\fR]
200: Security profiles: select, apply, show, list.
201: .TP
202: .B permissions \fR[\fIsubcommand\fR]
203: File permissions: check, enforce, fix.
204: .SS "System Information"
205: .TP
206: .B module
207: Display installed modules inventory.
208: .TP
209: .B fhs
210: Check FHS (Filesystem Hierarchy Standard) compliance.
211: .TP
212: .B nftables \fR[\fIsubcommand\fR]
213: Direct nftables control: start, stop, restart, reload, enable, disable, status.
214: .TP
215: .B port \fR[\fIsubcommand\fR]
216: Port scanning and analysis: scan, list, summary, html-report, mail-report.
217: .TP
218: .B panel \fR[\fIpanel\fR] \fR[\fIaction\fR]
219: Web hosting panel firewall integration. Manages firewall ports for control panels.
220: .RS
221: .IP \fBdirectadmin\fR
222: DirectAdmin panel (port 2222, FTP passive 35000-35999). Includes CloudFlare whitelist.
223: .IP \fBcpanel\fR
224: cPanel/WHM (ports 2082-2087, 2095-2096, webmail).
225: .IP \fBcwp\fR
226: CentOS Web Panel (ports 2030, 2031).
227: .IP \fBcyberpanel\fR
228: CyberPanel with OpenLiteSpeed (ports 7080, 8090).
229: .IP \fBinterworx\fR
230: InterWorx panel (ports 2080, 2443).
231: .IP \fBvesta\fR
232: VestaCP/HestiaCP (port 8083).
233: .RE
234: .IP
235: Actions: \fBenable\fR, \fBdisable\fR, \fBstatus\fR.
236: .br
237: Example: \fBnftban panel directadmin enable\fR
238: .TP
239: .B test
240: Run CLI command validation tests.
241: .SS "Debug and Troubleshooting"
242: .TP
243: .B debug \fR[\fIsubcommand\fR]
244: Debug and troubleshooting tools. Subcommands:
245: .RS
246: .IP \fBstatus\fR
247: Show debug status (trace enabled, log level, orphan count).
248: .IP "\fBenable\fR [\fItype\fR]"
249: Enable debug trace or verbose logging. Types: trace (default), verbose, all.
250: .IP "\fBdisable\fR [\fItype\fR]"
251: Disable debug trace or verbose logging.
252: .IP "\fBtrace recent\fR [\fIN\fR]"
253: Show last N trace entries (default: 30).
254: .IP "\fBtrace orphans\fR [\fIMIN\fR]"
255: Find stuck scripts (START without END, older than MIN minutes).
256: .IP \fBtrace stats\fR
257: Show trace statistics.
258: .IP "\fBtrace clear\fR [\fIDAYS\fR]"
259: Rotate trace log, keep DAYS (default: 7).
260: .IP "\fBlogs\fR [\fITYPE\fR] [\fIN\fR]"
261: View log files: main, trace, login, bans, all.
262: .IP "\fBdump\fR [\fIWHAT\fR]"
263: Dump debug info: config, env, services, nft, all.
264: .RE
265: .TP
266: .B emulate \fIIP\fR [\fIoptions\fR]
267: Simulate packet decision to test firewall rules without actual traffic.
268: Options: \fB\-\-proto\fR (tcp/udp), \fB\-\-port\fR, \fB\-\-direction\fR (in/out), \fB\-\-json\fR.
269: Useful for testing before deploying rules.
270: .TP
271: .B smoke \fR[\fIsubcommand\fR]
272: Smoke test suite for CLI health checks. Subcommands:
273: .RS
274: .IP \fBrun\fR
275: Run full smoke test suite (tests all major commands).
276: .IP \fBquick\fR
277: Run quick test (core commands only).
278: .IP "\fBcheck\fR [\fIMIN\fR]"
279: Check for orphaned traces (stuck scripts).
280: .IP \fBstats\fR
281: Show trace statistics.
282: .RE
283: .SS "User Interface"
284: .TP
285: .B menu
286: Interactive text-based menu interface.
287: .TP
288: .B gui \fR[\fIsubcommand\fR]
289: Web GUI management: enable, disable, status.
290: .SH OPTIONS
291: .TP
292: .B \-\-json
293: Output in JSON format (supported by status, list, services, and other commands).
294: .TP
295: .B \-\-quiet
296: Suppress banner and non-essential output.
297: .TP
298: .B \-\-verbose
299: Show detailed output.
300: .TP
301: .B \-\-help, \-h
302: Show help for specific command.
303: .SH FILES
304: .TP
305: .I /etc/nftban/nftban.conf
306: Main configuration file.
307: .TP
308: .I /etc/nftban/conf.d/
309: Module configuration directory.
310: .TP
311: .I /etc/nftban/blacklist.d/
312: Custom blacklist files.
313: .TP
314: .I /etc/nftban/whitelist.d/
315: Custom whitelist files.
316: .TP
317: .I /var/lib/nftban/
318: Runtime data directory.
319: .TP
320: .I /var/lib/nftban/geoip/
321: GeoIP database files.
322: .TP
323: .I /var/log/nftban/
324: Log files directory.
325: .TP
326: .I /var/log/nftban/debug_trace.log
327: Debug trace log (when NFTBAN_DEBUG_TRACE=true).
328: .TP
329: .I /var/log/nftban/watchdog.log
330: Watchdog monitoring log.
331: .TP
332: .I /var/lib/nftban/metrics/watchdog.prom
333: Watchdog Prometheus metrics (for node_exporter textfile collector).
334: .TP
335: .I /var/lib/nftban/reports/watchdog/
336: Saved watchdog reports directory.
337: .TP
338: .I /etc/nftban/conf.d/watchdog.conf
339: Watchdog configuration (thresholds, intervals).
340: .TP
341: .I /usr/lib/nftban/
342: Library and module directory.
343: .SH EXAMPLES
344: .TP
345: Check system status:
346: .B nftban status
347: .TP
348: Ban an IP for 1 hour:
349: .B nftban ban 192.168.1.100 \-\-timeout 3600 \-\-reason "suspicious activity"
350: .TP
351: Permanently ban an IP:
352: .B nftban ban 192.168.1.100 \-\-permanent
353: .TP
354: Show statistics dashboard:
355: .B nftban stats dashboard
356: .TP
357: Stats with time filter:
358: .B nftban stats \-\-last 7d
359: .TP
360: Top 20 banned IPs:
361: .B nftban stats top ips 20
362: .TP
363: Export stats to JSON:
364: .B nftban stats export \-\-format json \-\-output /tmp/stats.json
365: .TP
366: Export stats to CSV:
367: .B nftban stats export \-\-format csv
368: .TP
369: Real-time monitoring:
370: .B nftban stats monitor
371: .TP
372: Enable DDoS protection:
373: .B nftban ddos enable

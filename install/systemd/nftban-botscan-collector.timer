# =============================================================================
# NFTBan - Bot Scanner Read-Authority Collector Timer
# =============================================================================
# SPDX-License-Identifier: MPL-2.0
# Purpose: Trigger the read-collector every 5 minutes so the spool is fresh
#          ahead of the 10-minute scanner cycle.
#
# meta:name="nftban_botscan_collector_timer"
# meta:type="config"
# meta:owner="Antonios Voulvoulis <contact@nftban.com>"
# meta:created_date="2026-06-12"
# meta:description="Timer that triggers the NFTBan botscan read-collector every 5 minutes (ahead of the 10-minute scanner)"
# meta:input="None"
# meta:output="Triggers nftban-botscan-collector.service"
# meta:depends="nftban-botscan-collector.service"
#
# meta:inventory.files=""
# meta:inventory.binaries=""
# meta:inventory.env_vars=""
# meta:inventory.config_files=""
# meta:inventory.systemd_units="nftban-botscan-collector.service"
# meta:inventory.network=""
# meta:inventory.privileges="none"
# =============================================================================

[Unit]
# v1.235 R-DEC: kernel parameter nftban=disabled = per-boot emergency bypass of NFTBan.
# systemd enforces this on every start path (socket, Requires=, timer, installer, self-heal).
ConditionKernelCommandLine=!nftban=disabled
Description=NFTBan Bot Scanner Read-Authority Collector Timer
Documentation=man:nftban(8)

[Timer]
# 5-minute interval — keep the spool fresher than the 10-minute scan
OnBootSec=2min
# v1.235 T1: also count from TIMER activation. With only OnBootSec + OnUnitActiveSec,
# a timer started on a long-running host after a remove->install has nothing to
# fire on: OnBootSec is already past (and is treated as used, because Persistent=true
# kept the old last-trigger stamp), and OnUnitActiveSec has no base because the
# reinstalled service has never run. systemd then shows it active with no next
# elapse until reboot. OnActiveSec gives it a first run 2min after it starts.
OnActiveSec=2min
OnUnitActiveSec=5min
AccuracySec=30s
RandomizedDelaySec=1min
FixedRandomDelay=true
Persistent=true

[Install]
WantedBy=timers.target

237:     fi
238: 
239:     # Get version info
240:     local version
241:     version=$(curl -s "http://localhost:${NODE_EXPORTER_PORT}/metrics" | grep "node_exporter_build_info" | grep -o 'version="[^"]*"' | cut -d'"' -f2)
242:     if [[ -n "$version" ]]; then
243:         test_result "PASS" "Node Exporter version: $version"

#!/bin/bash
# =============================================================================
# NFTBan v0.30.0 - DEB Post-Remove Script
# =============================================================================
# SPDX-License-Identifier: MPL-2.0
# Purpose: Post-removal cleanup for DEB packages
# =============================================================================

set -e

case "$1" in
    remove)
        # On remove (not purge): preserve logs and config for audit/forensics
        # Remove only runtime and cache data
        rm -rf /run/nftban
        rm -rf /var/cache/nftban

        # Remove nftables table if empty
        if command -v nft >/dev/null 2>&1; then
            nft list table inet nftban >/dev/null 2>&1 && \
                nft delete table inet nftban || true
        fi

        # Change ownership to root to avoid unknown UID/GID after user removal
        if [ -d /var/log/nftban ]; then
            chown -R root:root /var/log/nftban
        fi
        if [ -d /var/lib/nftban ]; then
            chown -R root:root /var/lib/nftban
        fi

        # Leave informational note in logs directory
        if [ -d /var/log/nftban ]; then
            cat > /var/log/nftban/README.removed <<'EOF'
NFTBan has been removed, but logs have been preserved for audit purposes.

To completely purge all NFTBan data including logs:
  sudo apt-get purge nftban

Or manually remove:
  sudo rm -rf /var/log/nftban
  sudo rm -rf /var/lib/nftban
  sudo rm -rf /etc/nftban
EOF
        fi
        ;;

    purge)
        # On purge: remove EVERYTHING including logs and config
        # This is explicit user action via "apt-get purge nftban"
        rm -rf /var/lib/nftban
        rm -rf /var/cache/nftban
        rm -rf /var/log/nftban
        rm -rf /etc/nftban
        rm -rf /run/nftban

        # Remove nftables table
        if command -v nft >/dev/null 2>&1; then
            nft list table inet nftban >/dev/null 2>&1 && \
                nft delete table inet nftban || true
        fi
        ;;
esac

#DEBHELPER#

exit 0

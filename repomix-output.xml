458:         // Get traffic stats
459:         const trafficResp = await fetch('/api/v1/stats/traffic', {
460:             headers: window.getAuthHeaders()
461:         }).catch(() => null);
462: 
463:         if (trafficResp && trafficResp.ok) {
464:             const data = await trafficResp.json();
465:             if (data.success && data.data) {
466:                 // Format bytes to human-readable format (MB/GB)
467:                 const formatBytes = (bytes) => {
468:                     if (bytes >= 1073741824) return (bytes / 1073741824).toFixed(2) + ' GB';
469:                     if (bytes >= 1048576) return (bytes / 1048576).toFixed(2) + ' MB';
470:                     if (bytes >= 1024) return (bytes / 1024).toFixed(2) + ' KB';
471:                     return bytes + ' B';

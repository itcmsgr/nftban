<file path=".github/workflows/ci.yml">
  1: # =============================================================================
  2: # NFTBan v1.0.0 - CI Pipeline
  3: # =============================================================================
  4: # SPDX-License-Identifier: MPL-2.0
  5: # Purpose: Comprehensive CI for pull request validation
  6: #
  7: # Runs on:
  8: #   - All pull requests to main/master
  9: #   - Pushes to main/master/develop
 10: #
 11: # Checks:
 12: #   - ShellCheck (bash linting)
 13: #   - Go build & tests
 14: #   - Go security scanning (gosec, staticcheck)
 15: #   - Syntax validation for all scripts
 16: # =============================================================================
 17: 
 18: name: CI
 19: 
 20: on:
 21:   push:
 22:     branches: [main, master, develop]
 23:   pull_request:
 24:     branches: [main, master]
 25: 
 26: concurrency:
 27:   group: ci-${{ github.ref }}
 28:   cancel-in-progress: true
 29: 
 30: jobs:
 31:   # ===========================================================================
 32:   # BASH VALIDATION
 33:   # ===========================================================================
 34:   bash-check:
 35:     name: Bash Validation
 36:     runs-on: ubuntu-latest
 37:     steps:
 38:       - uses: actions/checkout@v4
 39: 
 40:       - name: Install ShellCheck
 41:         run: sudo apt-get update && sudo apt-get install -y shellcheck
 42: 
 43:       - name: Syntax check all bash scripts
 44:         run: |
 45:           echo "=== Checking bash syntax ==="
 46:           find cli install packaging -name "*.sh" -type f | while read -r script; do
 47:             bash -n "$script" || { echo "FAIL: $script"; exit 1; }
 48:           done
 49:           bash -n build.sh install.sh
 50:           echo "✓ All bash syntax valid"
 51: 
 52:       - name: ShellCheck core scripts
 53:         run: |
 54:           echo "=== ShellCheck: Core ==="
 55:           shellcheck -x -S warning cli/lib/nftban/core/*.sh || true
 56: 
 57:       - name: ShellCheck CLI scripts
 58:         run: |
 59:           echo "=== ShellCheck: CLI ==="
 60:           shellcheck -x -S warning cli/lib/nftban/cli/*.sh || true
 61: 
 62:       - name: ShellCheck lib scripts
 63:         run: |
 64:           echo "=== ShellCheck: Lib ==="
 65:           shellcheck -x -S warning cli/lib/nftban/lib/*.sh || true
 66: 
 67:       - name: ShellCheck setup scripts
 68:         run: |
 69:           echo "=== ShellCheck: Setup ==="
 70:           shellcheck -x -S warning cli/lib/nftban/setup/*.sh || true
 71: 
 72:       - name: ShellCheck install scripts
 73:         run: |
 74:           echo "=== ShellCheck: Install ==="
 75:           shellcheck -x -S warning install/*.sh || true
 76:           shellcheck -x -S warning install.sh build.sh
 77: 
 78:   # ===========================================================================
 79:   # GO VALIDATION
 80:   # ===========================================================================
 81:   go-check:
 82:     name: Go Validation
 83:     runs-on: ubuntu-latest
 84:     steps:
 85:       - uses: actions/checkout@v4
 86: 
 87:       - uses: actions/setup-go@v5
 88:         with:
 89:           go-version: '1.22'
 90: 
 91:       - name: Install build dependencies
 92:         run: sudo apt-get update && sudo apt-get install -y libpam0g-dev
 93: 
 94:       - name: Cache Go modules
 95:         uses: actions/cache@v4
 96:         with:
 97:           path: |
 98:             ~/go/pkg/mod
 99:             ~/.cache/go-build
100:           key: ${{ runner.os }}-go-${{ hashFiles('**/go.sum') }}
101:           restore-keys: ${{ runner.os }}-go-
102: 
103:       - name: Verify go mod tidy
104:         run: |
105:           go mod tidy
106:           git diff --exit-code go.mod go.sum || {
107:             echo "::error ::Run 'go mod tidy' and commit changes"
108:             exit 1
109:           }
110: 
111:       - name: Build all packages
112:         run: go build ./...
113: 
114:       - name: Run tests
115:         run: go test -race -v ./...
116: 
117:       - name: Install staticcheck
118:         run: go install honnef.co/go/tools/cmd/staticcheck@latest
119: 
120:       - name: Run staticcheck
121:         run: $(go env GOPATH)/bin/staticcheck ./...
122: 
123:       - name: Install gosec
124:         run: go install github.com/securego/gosec/v2/cmd/gosec@latest
125: 
126:       - name: Run gosec
127:         run: $(go env GOPATH)/bin/gosec -quiet ./... || true
128: 
129:   # ===========================================================================
130:   # BUILD VERIFICATION
131:   # ===========================================================================
132:   build-verify:
133:     name: Build Verification
134:     runs-on: ubuntu-latest
135:     needs: [bash-check, go-check]
136:     steps:
137:       - uses: actions/checkout@v4
138: 
139:       - uses: actions/setup-go@v5
140:         with:
141:           go-version: '1.22'
142: 
143:       - name: Install build dependencies
144:         run: sudo apt-get update && sudo apt-get install -y libpam0g-dev
145: 
146:       - name: Build Go binaries
147:         run: |
148:           mkdir -p bin
149:           go build -o bin/nftban-core ./cmd/nftban-core
150:           go build -o bin/nftban-ui ./cmd/nftban-ui
151:           go build -o bin/nftban-ui-auth ./cmd/nftban-ui-auth
152:           go build -o bin/nftband ./cmd/nftband
153: 
154:       - name: Verify binaries
155:         run: |
156:           echo "=== Built binaries ==="
157:           ls -lh bin/
158:           file bin/nftban-core
159:           file bin/nftban-ui
160:           file bin/nftban-ui-auth
161:           file bin/nftband
162: 
163:       - name: Verify CLI structure
164:         run: |
165:           echo "=== Verifying CLI structure ==="
166:           test -f cli/sbin/nftban || { echo "FAIL: cli/sbin/nftban missing"; exit 1; }
167:           test -f cli/lib/nftban/nftban_main.sh || { echo "FAIL: nftban_main.sh missing"; exit 1; }
168:           test -d cli/lib/nftban/core || { echo "FAIL: core/ missing"; exit 1; }
169:           test -d cli/lib/nftban/cli || { echo "FAIL: cli/ missing"; exit 1; }
170:           echo "✓ CLI structure valid"
171: 
172:   # ===========================================================================
173:   # SUMMARY
174:   # ===========================================================================
175:   ci-summary:
176:     name: CI Summary
177:     runs-on: ubuntu-latest
178:     needs: [bash-check, go-check, build-verify]
179:     if: always()
180:     steps:
181:       - name: Generate summary
182:         run: |
183:           echo "## CI Pipeline Results" >> $GITHUB_STEP_SUMMARY
184:           echo "" >> $GITHUB_STEP_SUMMARY
185:           echo "| Check | Status |" >> $GITHUB_STEP_SUMMARY
186:           echo "|-------|--------|" >> $GITHUB_STEP_SUMMARY
187:           echo "| Bash Validation | ${{ needs.bash-check.result }} |" >> $GITHUB_STEP_SUMMARY
188:           echo "| Go Validation | ${{ needs.go-check.result }} |" >> $GITHUB_STEP_SUMMARY
189:           echo "| Build Verification | ${{ needs.build-verify.result }} |" >> $GITHUB_STEP_SUMMARY
</file>


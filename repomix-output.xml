 91: NFTBAN_CPANEL_CUSTOM_TCP6_OUT=""
 92: NFTBAN_CPANEL_CUSTOM_UDP6_IN=""
 93: NFTBAN_CPANEL_CUSTOM_UDP6_OUT=""
 94: 
 95: # -----------------------------------------------------------------------------
 96: # CPANEL LICENSE SERVERS
 97: # -----------------------------------------------------------------------------
 98: # cPanel license verification requires access to cPanel servers
 99: # See: cpanel.allow file for specific IP whitelisting
100: 
101: # Auto-enable cPanel license server whitelist? (YES|NO|ASK)
102: # YES  - Automatically enable cPanel server whitelist (recommended)
103: # NO   - Skip cPanel server whitelist (you must enable manually!)
104: # ASK  - Prompt user during setup (default)
105: NFTBAN_CPANEL_AUTO_LICENSE_WHITELIST="ASK"
106: 
107: # Update cPanel license server list automatically? (YES|NO)
108: NFTBAN_CPANEL_UPDATE_LICENSE_SERVERS="YES"

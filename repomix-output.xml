<file path="cli/lib/nftban/cli/cmd_gui.sh">
  1: #!/usr/bin/env bash
  2: # ==============================================================================
  3: # NFTBan CLI Command: gui
  4: # ==============================================================================
  5: # Description:  Enable/disable Web GUI + Prometheus + Go binaries
  6: # shellcheck disable=SC1083  # Braces in nftables syntax are literal, not bash
  7: # Author:       NFTBan Team
  8: # License:      MIT
  9: # ==============================================================================
 10: 
 11: # shellcheck disable=SC2034  # Variables used by framework
 12: 
 13: set -euo pipefail
 14: 
 15: # Simple config functions (no external dependencies)
 16: NFTBAN_CONF_DIR="${NFTBAN_CONF_DIR:-/etc/nftban}"
 17: NFTBAN_LIB_DIR="${NFTBAN_LIB_DIR:-/usr/lib/nftban}"
 18: 
 19: # Load main configuration (service names, paths)
 20: if [[ -f "${NFTBAN_CONF_DIR}/nftban.conf" ]]; then
 21:     source "${NFTBAN_CONF_DIR}/nftban.conf"
 22: fi
 23: 
 24: # Load distro configuration
 25: if [[ -f "${NFTBAN_LIB_DIR}/lib/nftban_distro_config.sh" ]]; then
 26:     # shellcheck source=/dev/null
 27:     source "${NFTBAN_LIB_DIR}/lib/nftban_distro_config.sh"
 28: fi
 29: 
 30: # Load shared metrics library
 31: if [[ -f "${NFTBAN_LIB_DIR}/lib/nftban_metrics.sh" ]]; then
 32:     # shellcheck source=/dev/null
 33:     source "${NFTBAN_LIB_DIR}/lib/nftban_metrics.sh"
 34: fi
 35: 
 36: # GUI-specific config helpers (local to this module to avoid conflicts with nftban_config.sh)
 37: _gui_config_get() {
 38:     local key="$1"
 39:     local conf_file="${NFTBAN_CONF_DIR}/nftban.conf"
 40: 
 41:     if [[ -f "$conf_file" ]]; then
 42:         local value
 43:         value=$(grep "^${key}=" "$conf_file" 2>/dev/null | tail -n1 | cut -d= -f2- | tr -d '"' || echo "")
 44:         echo "$value"
 45:     fi
 46: }
 47: 
 48: _gui_config_set() {
 49:     local key="$1"
 50:     local value="$2"
 51:     local conf_file="${NFTBAN_CONF_DIR}/nftban.conf"
 52: 
 53:     mkdir -p "${NFTBAN_CONF_DIR}"
 54: 
 55:     if [[ ! -f "$conf_file" ]]; then
 56:         cat > "$conf_file" << 'EOF'
 57: # NFTBan Global Configuration
 58: NFTBAN_GUI_MODE="false"
 59: EOF
 60:     fi
 61: 
 62:     if grep -q "^${key}=" "$conf_file"; then
 63:         sed -i "s|^${key}=.*|${key}=\"${value}\"|" "$conf_file"
 64:     else
 65:         echo "${key}=\"${value}\"" >> "$conf_file"
 66:     fi
 67: }

388: # =============================================================================
389: # HEALTH CACHE WRITER (called by nftban-health.timer)
390: # =============================================================================
391: # Writes health status to cache file for banner display
392: # Usage: nftban_health_cache_write <status_code>
393: #   0 = OK (🟢), 1 = WARNING (🟠), 2 = ERROR (🔴), 3 = CRITICAL, 4 = NOT_INSTALLED
394: #
395: nftban_health_cache_write() {
396:     local status_code="${1:-0}"
397:     local cache_dir="${NFTBAN_CACHE_DIR}/health"
398:     local cache_file="${cache_dir}/health_status.cache"
399: 
400:     # Create cache directory if needed
401:     mkdir -p "$cache_dir" 2>/dev/null || true
402: 
403:     # Write status (4=NOT_INSTALLED is OK for banner - optional feature)
404:     case "$status_code" in
405:         0|4) echo "OK" > "$cache_file" ;;        # OK or NOT_INSTALLED = green
406:         1) echo "WARNING" > "$cache_file" ;;
407:         2) echo "ERROR" > "$cache_file" ;;
408:         3) echo "CRITICAL" > "$cache_file" ;;
409:         *) echo "UNKNOWN" > "$cache_file" ;;
410:     esac
411: 
412:     # Set permissions
413:     chmod 644 "$cache_file" 2>/dev/null || true
414:     chown nftban:nftban "$cache_file" 2>/dev/null || true
415: 
416:     return 0
417: }

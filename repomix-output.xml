290:     echo ""
291: 
292:     if ! command -v nft &>/dev/null; then
293:         echo "ERROR: nft binary not found" >&2
294:         return 1
295:     fi
296: 
297:     nft list ruleset
298: }
299: 
300: # =============================================================================
301: 
302: # MAIN COMMAND HANDLER
303: # =============================================================================
304: 
305: 
306: nftban_cmd_nftables() {
307:     local action="${1:-help}"
308:     local json_mode=false
309: 
310:     # Check for --json flag
311:     for arg in "$@"; do
312:         [[ "$arg" == "--json" ]] && json_mode=true && break
313:     done
314: 
315:     shift || true
316: 
317:     case "$action" in
318:         start)
319:             if [[ $EUID -ne 0 ]]; then
320:                 echo "ERROR: This command requires root privileges" >&2
321:                 exit 1
322:             fi
323:             _nftban_nftables_cmd_start
324:             ;;
325: 
326:         stop)
327:             if [[ $EUID -ne 0 ]]; then
328:                 echo "ERROR: This command requires root privileges" >&2
329:                 exit 1
330:             fi
331:             _nftban_nftables_cmd_stop
332:             ;;
333: 
334:         restart)
335:             if [[ $EUID -ne 0 ]]; then
336:                 echo "ERROR: This command requires root privileges" >&2
337:                 exit 1
338:             fi
339:             _nftban_nftables_cmd_restart
340:             ;;
341: 
342:         reload)
343:             if [[ $EUID -ne 0 ]]; then
344:                 echo "ERROR: This command requires root privileges" >&2
345:                 exit 1
346:             fi
347:             _nftban_nftables_cmd_reload
348:             ;;
349: 
350:         enable)
351:             if [[ $EUID -ne 0 ]]; then
352:                 echo "ERROR: This command requires root privileges" >&2
353:                 exit 1
354:             fi
355:             _nftban_nftables_cmd_enable
356:             ;;
357: 
358:         disable)
359:             if [[ $EUID -ne 0 ]]; then
360:                 echo "ERROR: This command requires root privileges" >&2
361:                 exit 1
362:             fi
363:             _nftban_nftables_cmd_disable
364:             ;;
365: 
366:         status)
367:             if [[ "$json_mode" == "true" ]] && declare -f json_output >/dev/null 2>&1; then
368:                 local active="false"
369:                 systemctl is-active --quiet nftables && active="true"
370:                 local data
371:                 data=$(json_build_object "service" "nftables" "active" "$active")
372:                 json_output "true" "$data"
373:             else
374:                 _nftban_nftables_cmd_status
375:             fi
376:             ;;
377: 
378:         check)
379:             if [[ $EUID -ne 0 ]]; then
380:                 echo "ERROR: This command requires root privileges" >&2
381:                 exit 1
382:             fi
383:             _nftban_nftables_cmd_check
384:             ;;
385: 
386:         list)
387:             _nftban_nftables_cmd_list
388:             ;;
389: 
390:         help|--help|-h)
391:             _nftban_nftables_help
392:             ;;
393: 
394:         *)
395:             echo "ERROR: Unknown command: $action" >&2
396:             echo "" >&2
397:             echo "Run 'nftban nftables help' for available commands" >&2
398:             exit 1
399:             ;;
400:     esac
401: 
402:     return 0
403: }
404: 
405: # =============================================================================
406: 
407: # EXPORT FOR MAIN CLI
408: # =============================================================================
409: 
410: export -f nftban_cmd_nftables

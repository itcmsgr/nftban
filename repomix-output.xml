  87: nftban_stats_get_cache() {
  88:     # Get cached data if fresh
  89:     # Usage: nftban_stats_get_cache "cache_key"
  90:     # Returns: 0=cache hit (prints data), 1=cache miss
  91: 
  92:     local cache_key="$1"
  93:     local cache_file="${NFTBAN_STATS_CACHE_DIR}/${cache_key}.cache"
  94: 
  95:     [[ "$STATS_CACHE_ENABLED" != "true" ]] && return 1
  96:     [[ ! -f "$cache_file" ]] && return 1
  97: 
  98:     # Check if cache is fresh
  99:     local cache_age
 100:     cache_age=$(( $(date +%s) - $(stat -c %Y "$cache_file" 2>/dev/null || echo 0) ))
 101:     if [[ $cache_age -lt ${STATS_CACHE_TTL} ]]; then
 102:         cat "$cache_file"
 103:         return 0
 104:     fi
 105: 
 106:     return 1
 107: }
 108: 
 109: nftban_stats_set_cache() {
 110:     # Store data in cache
 111:     # Usage: nftban_stats_set_cache "cache_key" "data"
 112: 
 113:     local cache_key="$1"
 114:     local data="$2"
 115:     local cache_file="${NFTBAN_STATS_CACHE_DIR}/${cache_key}.cache"
 116: 
 117:     [[ "$STATS_CACHE_ENABLED" != "true" ]] && return 0
 118: 
 119:     echo "$data" > "$cache_file" 2>/dev/null || true
 120: }

 532:     echo "  NFTBan Statistics Dashboard"
 533:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
 534:     echo ""
 535: 
 536:     # ─────────────────────────────────────────────────────────────────────
 537:     # SYSTEM
 538:     # ─────────────────────────────────────────────────────────────────────
 539:     echo "SYSTEM"
 540:     echo "───────────────────────────────────────────────────────────"
 541:     printf "  %-20s %s\n" "Hostname............" "$(hostname)"
 542:     printf "  %-20s %s → %s\n" "Period.............." "$since" "$until"
 543:     printf "  %-20s %s\n" "Generated..........." "$(date '+%Y-%m-%d %H:%M:%S')"
 544:     echo ""
 545: 
 546:     # ─────────────────────────────────────────────────────────────────────
 547:     # UNIFIED BLACKLIST (count first, used by FIREWALL section)
 548:     # ─────────────────────────────────────────────────────────────────────
 549:     local black_v4=0 black_v6=0
 550: 
 551:     # Count blacklist sets (contains ALL bans: manual, feeds, geoban, temporary)
 552:     if nft list set "${NFTBAN_TABLE_IPV4}" blacklist_ipv4 &>/dev/null 2>&1; then
 553:         black_v4=$(nft list set "${NFTBAN_TABLE_IPV4}" blacklist_ipv4 2>/dev/null | { grep -oP '\d+\.\d+\.\d+\.\d+(/\d+)?' || true; } | wc -l 2>/dev/null || echo "0")
 554:         black_v4=${black_v4:-0}
 555:     fi
 556:     if nft list set "${NFTBAN_TABLE_IPV6}" blacklist_ipv6 &>/dev/null 2>&1; then
 557:         black_v6=$(nft list set "${NFTBAN_TABLE_IPV6}" blacklist_ipv6 2>/dev/null | { grep -oP '[0-9a-fA-F:]+::[0-9a-fA-F:]*(/\d+)?|[0-9a-fA-F:]+:[0-9a-fA-F:]+(/\d+)?' || true; } | wc -l 2>/dev/null || echo "0")
 558:         black_v6=${black_v6:-0}
 559:     fi
 560: 
 561:     black_v4=${black_v4//[^0-9]/}
 562:     black_v6=${black_v6//[^0-9]/}
 563:     local total_black
 564:     total_black=$((${black_v4:-0} + ${black_v6:-0}))
 565: 
 566:     # ─────────────────────────────────────────────────────────────────────
 567:     # FIREWALL (CURRENT)
 568:     # ─────────────────────────────────────────────────────────────────────
 569:     echo "FIREWALL (CURRENT)"
 570:     echo "───────────────────────────────────────────────────────────"
 571:     printf "  %-20s %s\n" "Blocked IPs........." "$total_black"
 572:     printf "  %-20s %s\n" "Whitelisted........." "$whitelist_count"
 573:     echo ""
 574: 
 575:     # ─────────────────────────────────────────────────────────────────────
 576:     # UNIFIED BLACKLIST BREAKDOWN
 577:     # ─────────────────────────────────────────────────────────────────────
 578:     echo "BLACKLIST BREAKDOWN"
 579:     echo "───────────────────────────────────────────────────────────"
 580:     printf "  %-20s %s\n" "IPv4 Entries........" "$black_v4"
 581:     printf "  %-20s %s\n" "IPv6 Entries........" "$black_v6"
 582:     printf "  %-20s %s\n" "TOTAL..............." "$total_black"
 583:     echo ""
 584:     echo "  Note: Unified blacklist contains manual + feeds + geoban + temp bans"
 585:     echo ""
 586: 
 587:     # ─────────────────────────────────────────────────────────────────────
 588:     # ACTIVITY HISTORY
 589:     # ─────────────────────────────────────────────────────────────────────
 590:     echo "ACTIVITY HISTORY"
 591:     echo "───────────────────────────────────────────────────────────"
 592:     printf "  %-20s %s\n" "New bans (period)..." "$total_bans"
 593:     printf "  %-20s %s\n" "Unique IPs banned..." "$unique_ips"
 594: 
 595:     # Source breakdown
 596:     local sources
 597:     sources=$(nftban_stats_ban_sources "$since" "$until")
 598:     if command -v jq &>/dev/null && [[ -n "$sources" ]]; then
 599:         local login_bans portscan_bans ddos_bans manual feeds
 600:         login_bans=$(echo "$sources" | jq -r '.login // 0')
 601:         portscan_bans=$(echo "$sources" | jq -r '.portscan // 0')
 602:         ddos_bans=$(echo "$sources" | jq -r '.ddos // 0')
 603:         manual=$(echo "$sources" | jq -r '.manual // 0')
 604:         feeds=$(echo "$sources" | jq -r '.feeds // 0')
 605: 
 606:         echo "  Modules:"
 607:         printf "      %-14s %s\n" "Login..........." "$login_bans"
 608:         printf "      %-14s %s\n" "Port Scan......." "$portscan_bans"
 609:         printf "      %-14s %s\n" "DDoS............" "$ddos_bans"
 610:         printf "      %-14s %s\n" "Manual.........." "$manual"
 611:         printf "      %-14s %s\n" "Feeds..........." "$feeds"
 612: 
 613:         if [[ "$login_bans" == "0" ]] && [[ "$portscan_bans" == "0" ]] && [[ "$ddos_bans" == "0" ]] && [[ "$manual" == "0" ]] && [[ "$feeds" == "0" ]]; then
 614:             echo ""
 615:             echo "  Summary: No new attacks detected this period."
 616:             if [[ $total_black -gt 0 ]]; then
 617:                 echo "           Protection active: $total_black IPs blocked in firewall."
 618:             fi
 619:         fi
 620:     fi
 621:     echo ""
 622: 
 623:     # ─────────────────────────────────────────────────────────────────────
 624:     # THREAT FEEDS
 625:     # ─────────────────────────────────────────────────────────────────────
 626:     if ! type -t nftban_feeds_discover_all >/dev/null 2>&1; then
 627:         if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_feeds.sh" ]]; then
 628:             source "${NFTBAN_LIB_DIR}/core/nftban_feeds.sh" 2>/dev/null || true
 629:         fi
 630:     fi
 631: 
 632:     if type -t nftban_feeds_discover_all >/dev/null 2>&1 && type -t nftban_feeds_get_property >/dev/null 2>&1; then
 633:         echo "THREAT FEEDS"
 634:         echo "───────────────────────────────────────────────────────────"
 635: 
 636:         local all_feeds
 637:         all_feeds=$(nftban_feeds_discover_all 2>/dev/null || true)
 638: 
 639:         if [[ -n "$all_feeds" ]]; then
 640:             local found_enabled=false
 641:             for feed in $all_feeds; do
 642:                 local enabled
 643:                 enabled=$(nftban_feeds_get_property "$feed" "ENABLED" 2>/dev/null || echo "false")
 644: 
 645:                 if [[ "$enabled" == "true" ]]; then
 646:                     found_enabled=true
 647:                     local feed_lower="${feed,,}"
 648:                     local feed_file="${NFTBAN_FEEDS_STORAGE_DIR:-/var/lib/nftban/feeds}/${feed_lower}.txt"
 649:                     if [[ -f "$feed_file" ]]; then
 650:                         local count mtime
 651:                         count=$(wc -l < "$feed_file" 2>/dev/null || true)
 652:                         count=${count:-0}
 653:                         mtime=$(date -r "$feed_file" '+%m-%d %H:%M' 2>/dev/null || echo "?")
 654:                         local feed_padded
 655:                         feed_padded=$(printf "%-20s" "$feed")
 656:                         feed_padded="${feed_padded// /.}"
 657:                         printf "  %s %s IPs (Updated: %s)\n" "$feed_padded" "$count" "$mtime"
 658:                     else
 659:                         local feed_padded
 660:                         feed_padded=$(printf "%-20s" "$feed")
 661:                         feed_padded="${feed_padded// /.}"
 662:                         printf "  %s pending download\n" "$feed_padded"
 663:                     fi
 664:                 fi
 665:             done
 666: 
 667:             if [[ "$found_enabled" == "false" ]]; then
 668:                 echo "  (no feeds enabled)"
 669:             fi
 670:         else
 671:             echo "  (no feeds configured)"
 672:         fi
 673:         echo ""
 674: 
 675:         # Packet blocking stats
 676:         local ipv4_packets ipv6_packets
 677:         ipv4_packets=$(nft list table "${NFTBAN_TABLE_IPV4}" 2>/dev/null | grep 'blacklist_ipv4.*counter' | grep -oP 'packets \K[0-9]+' || true)
 678:         ipv4_packets=${ipv4_packets:-0}
 679:         ipv6_packets=$(nft list table "${NFTBAN_TABLE_IPV6}" 2>/dev/null | grep 'blacklist_ipv6.*counter' | grep -oP 'packets \K[0-9]+' || true)
 680:         ipv6_packets=${ipv6_packets:-0}
 681:         local total_blocks
 682:         total_blocks=$((ipv4_packets + ipv6_packets))
 683: 
 684:         # Format large numbers with commas
 685:         local formatted_blocks
 686:         formatted_blocks=$(printf "%'d" "$total_blocks" 2>/dev/null || echo "$total_blocks")
 687: 
 688:         printf "  %-20s %s\n" "Total packets blocked" "$formatted_blocks"
 689:         echo ""
 690:     fi
 691: 
 692:     # ─────────────────────────────────────────────────────────────────────
 693:     # BANS BY MODULE (count IPs by source/module)
 694:     # ─────────────────────────────────────────────────────────────────────
 695:     echo "BANS BY MODULE"
 696:     echo "───────────────────────────────────────────────────────────"
 697: 
 698:     # Count IPs from each module
 699:     local feeds_total=0 login_count=0 portscan_count=0 ddos_count=0 manual_count=0
 700:     local blacklist_dir="${NFTBAN_CONFIG_DIR:-/etc/nftban}/blacklist.d"
 701:     local feeds_dir="${NFTBAN_DATA_DIR:-/var/lib/nftban}/feeds"
 702: 
 703:     # FEEDS: Count total IPs from all feeds
 704:     if [[ -d "$feeds_dir" ]]; then
 705:         shopt -s nullglob 2>/dev/null || true
 706:         for feed_file in "$feeds_dir"/*.txt "$feeds_dir"/*.netset; do
 707:             [[ -f "$feed_file" ]] || continue
 708:             local count
 709:             count=$(grep -cE '^[0-9]' "$feed_file" 2>/dev/null) || count=0
 710:             feeds_total=$((feeds_total + count))
 711:         done
 712:         shopt -u nullglob 2>/dev/null || true
 713:     fi
 714: 
 715:     # LOGIN: Count from login-auto.conf (source-specific file)
 716:     if [[ -f "$blacklist_dir/login-auto.conf" ]]; then
 717:         login_count=$(grep -cE '^[0-9]' "$blacklist_dir/login-auto.conf" 2>/dev/null) || login_count=0
 718:     fi
 719: 
 720:     # PORTSCAN: Count from portscan-auto.conf (source-specific file)
 721:     if [[ -f "$blacklist_dir/portscan-auto.conf" ]]; then
 722:         portscan_count=$(grep -cE '^[0-9]' "$blacklist_dir/portscan-auto.conf" 2>/dev/null) || portscan_count=0
 723:     fi
 724: 
 725:     # DDOS: Count from ddos-auto.conf (source-specific file)
 726:     if [[ -f "$blacklist_dir/ddos-auto.conf" ]]; then
 727:         ddos_count=$(grep -cE '^[0-9]' "$blacklist_dir/ddos-auto.conf" 2>/dev/null) || ddos_count=0
 728:     fi
 729: 
 730:     # MANUAL: Count from 99-manual.conf
 731:     if [[ -f "$blacklist_dir/99-manual.conf" ]]; then
 732:         manual_count=$(grep -cE '^[0-9]' "$blacklist_dir/99-manual.conf" 2>/dev/null) || manual_count=0
 733:     fi
 734: 
 735:     # Display counts
 736:     printf "  %-18s %'d IPs\n" "FEEDS" "$feeds_total"
 737:     printf "  %-18s %'d IPs\n" "LOGIN" "$login_count"
 738:     printf "  %-18s %'d IPs\n" "PORTSCAN" "$portscan_count"
 739:     printf "  %-18s %'d IPs\n" "DDOS" "$ddos_count"
 740:     printf "  %-18s %'d IPs\n" "MANUAL" "$manual_count"
 741:     echo ""
 742: 
 743:     # ─────────────────────────────────────────────────────────────────────
 744:     # CURRENT ACTIVE BANS (sample)
 745:     # ─────────────────────────────────────────────────────────────────────
 746:     if [[ $total_black -gt 0 ]]; then
 747:         echo "CURRENT ACTIVE BANS (sample)"
 748:         echo "───────────────────────────────────────────────────────────"
 749:         if nft list set "${NFTBAN_TABLE_IPV4}" blacklist_ipv4 &>/dev/null 2>&1; then
 750:             nft list set "${NFTBAN_TABLE_IPV4}" blacklist_ipv4 2>/dev/null | \
 751:                 grep -oP '\d+\.\d+\.\d+\.\d+(/\d+)?' | \
 752:                 awk 'NR<=5 {print "  " $1}' 2>/dev/null || true
 753:         fi
 754:         echo ""
 755:     fi
 756: 
 757:     # Top countries (if GeoIP enabled)
 758:     if [[ "${STATS_GEOIP_ENABLED}" == "true" ]] && command -v nftban-geoip &>/dev/null && command -v jq &>/dev/null; then
 759:         echo "TOP COUNTRIES"
 760:         echo "───────────────────────────────────────────────────────────"
 761:         nftban_stats_top_countries 5 "$since" "$until" | \
 762:             jq -r '.[] | "  \(.country): \(.count)"' 2>/dev/null || true
 763:         echo ""
 764:     fi
 765: 
 766:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
 767: }

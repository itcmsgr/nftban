1548: nftban_health_check_metrics() {
1549:     # Check Prometheus/Grafana metrics integration (NFTBan v0.6.0)
1550:     # Returns: 0=OK, 1=WARNING, 2=ERROR, 3=CRITICAL
1551:     # Uses central config: NFTBAN_METRICS_ENABLED, NFTBAN_METRICS_BACKEND
1552: 
1553:     local status=$HEALTH_OK
1554:     local metrics_issues=()
1555: 
1556:     # Check central config - if metrics disabled, skip detailed checks
1557:     if [[ "${NFTBAN_METRICS_ENABLED:-false}" != "true" ]]; then
1558:         NFTBAN_HEALTH_ISSUES["metrics"]="Disabled in config (set NFTBAN_METRICS_ENABLED=true to enable)"
1559:         NFTBAN_HEALTH_RESULTS["metrics"]=$HEALTH_NOT_INSTALLED
1560:         return $HEALTH_NOT_INSTALLED
1561:     fi
1562: 
1563:     # Check if metrics exporter script exists
1564:     if [[ ! -f "${NFTBAN_LIB_DIR}/exporters/nftban_prometheus_exporter.sh" ]]; then
1565:         metrics_issues+=("Metrics exporter not installed (optional)")
1566:         NFTBAN_HEALTH_ISSUES["metrics"]="Not installed (optional feature)"
1567:         return $HEALTH_NOT_INSTALLED
1568:     fi
1569: 
1570:     # Check if exporter script is executable
1571:     if [[ ! -x "${NFTBAN_LIB_DIR}/exporters/nftban_prometheus_exporter.sh" ]]; then
1572:         metrics_issues+=("Metrics exporter not executable")
1573:         metrics_issues+=("FIX: sudo chmod +x ${NFTBAN_LIB_DIR}/exporters/nftban_prometheus_exporter.sh")
1574:         status=$HEALTH_ERROR
1575:     fi
1576: 
1577:     # Check if metrics file exists and is recent (PRIMARY CHECK)
1578:     local metrics_file="/var/lib/node_exporter/textfile_collector/nftban.prom"
1579:     if [[ -f "$metrics_file" ]]; then
1580:         local file_age
1581:         file_age=$(( $(date +%s) - $(stat -c %Y "$metrics_file" 2>/dev/null || stat -f %m "$metrics_file" 2>/dev/null || echo 0) ))
1582: 
1583:         if [[ $file_age -lt 120 ]]; then
1584:             metrics_issues+=("✓ Metrics exporter: Working (file ${file_age}s old)")
1585:             # Exporter is working - check timer status
1586:             if systemctl is-active --quiet nftban-metrics-exporter.timer 2>/dev/null; then
1587:                 metrics_issues+=("✓ Metrics timer: Active")
1588:             else
1589:                 metrics_issues+=("⚠ Metrics timer not active (but exporter is working)")
1590:                 [[ $status -eq $HEALTH_OK ]] && status=$HEALTH_WARNING
1591:             fi
1592:         elif [[ $file_age -lt 300 ]]; then
1593:             metrics_issues+=("⚠ Metrics file is ${file_age}s old (may be stale)")
1594:             [[ $status -eq $HEALTH_OK ]] && status=$HEALTH_WARNING
1595:         else
1596:             metrics_issues+=("Metrics file is stale (${file_age}s old)")
1597:             metrics_issues+=("Exporter may not be running or timer is disabled")
1598:             [[ $status -lt $HEALTH_ERROR ]] && status=$HEALTH_ERROR
1599:         fi
1600:     else
1601:         # No metrics file - check if timer exists
1602:         if systemctl list-unit-files 2>/dev/null | grep -q "nftban-metrics-exporter.timer"; then
1603:             if systemctl is-active --quiet nftban-metrics-exporter.timer 2>/dev/null; then
1604:                 metrics_issues+=("Metrics timer active but no metrics file yet (may be first run)")
1605:                 status=$HEALTH_WARNING
1606:             else
1607:                 metrics_issues+=("Metrics timer exists but not running")
1608:                 metrics_issues+=("FIX: sudo systemctl enable --now nftban-metrics-exporter.timer")
1609:                 status=$HEALTH_ERROR
1610:             fi
1611:         else
1612:             metrics_issues+=("Metrics timer not installed")
1613:             metrics_issues+=("FIX: sudo ./install.sh systemd")
1614:             status=$HEALTH_ERROR
1615:         fi
1616:     fi
1617: 
1618:     # Check Node Exporter (OPTIONAL - only needed for Prometheus scraping)
1619:     # Binary name varies: node_exporter (CentOS/Debian) or prometheus-node-exporter (some RHEL)
1620:     # Service name varies: node_exporter, prometheus-node-exporter, or node-exporter
1621:     local node_exporter_running=false
1622:     if command -v node_exporter >/dev/null 2>&1 || command -v prometheus-node-exporter >/dev/null 2>&1; then
1623:         # Check all possible service names
1624:         if systemctl is-active --quiet node_exporter 2>/dev/null || \
1625:            systemctl is-active --quiet prometheus-node-exporter 2>/dev/null || \
1626:            systemctl is-active --quiet node-exporter 2>/dev/null; then
1627:             metrics_issues+=("✓ Node Exporter: Running")
1628:             node_exporter_running=true  # shellcheck disable=SC2034  # Reserved for metrics validation
1629:         else
1630:             metrics_issues+=("ℹ️ Node Exporter installed but not running (optional - for Prometheus)")
1631:         fi
1632:     else
1633:         # Not installed - this is OK, it's optional
1634:         metrics_issues+=("ℹ️ Node Exporter not installed (optional - only needed for Prometheus scraping)")
1635:     fi
1636: 
1637:     # Check Prometheus or VictoriaMetrics (optional alternatives - only one needed)
1638:     local metrics_backend_found=false
1639:     local prometheus_running=false
1640: 
1641:     # Check Prometheus first
1642:     if command -v prometheus >/dev/null 2>&1 || systemctl list-unit-files 2>/dev/null | grep -q "^prometheus.service"; then
1643:         metrics_backend_found=true
1644:         if systemctl is-active --quiet prometheus 2>/dev/null; then
1645:             prometheus_running=true
1646:             metrics_issues+=("✓ Prometheus: Running")
1647: 
1648:             # Check if Prometheus is accessible
1649:             if command -v curl >/dev/null 2>&1; then
1650:                 if curl -s --connect-timeout "${NFTBAN_TIMEOUT_FAST}" "http://${NFTBAN_METRICS_PROMETHEUS_ADDR}/-/healthy" >/dev/null 2>&1; then
1651:                     metrics_issues+=("✓ Prometheus: Healthy")
1652:                 else
1653:                     metrics_issues+=("Prometheus not responding on ${NFTBAN_METRICS_PROMETHEUS_ADDR}")
1654:                     [[ $status -lt $HEALTH_WARNING ]] && status=$HEALTH_WARNING
1655:                 fi
1656:             fi
1657:         else
1658:             metrics_issues+=("Prometheus installed but not running")
1659:             [[ $status -lt $HEALTH_WARNING ]] && status=$HEALTH_WARNING
1660:         fi
1661:     fi
1662: 
1663:     # Check VictoriaMetrics (alternative to Prometheus) - only if Prometheus not running
1664:     # Skip VictoriaMetrics check if Prometheus is already running (they're alternatives)
1665:     if [[ "$prometheus_running" != "true" ]]; then
1666:         if command -v victoria-metrics >/dev/null 2>&1 || systemctl list-unit-files 2>/dev/null | grep -q "^victoria-metrics.service"; then
1667:             metrics_backend_found=true  # shellcheck disable=SC2034  # Reserved for backend detection
1668:             if systemctl is-active --quiet victoria-metrics 2>/dev/null; then
1669:                 metrics_issues+=("✓ VictoriaMetrics: Running")
1670: 
1671:                 # Check if VictoriaMetrics is accessible
1672:                 if command -v curl >/dev/null 2>&1; then
1673:                     if curl -s --connect-timeout "${NFTBAN_TIMEOUT_FAST}" "http://${NFTBAN_METRICS_VICTORIA_ADDR}/metrics" >/dev/null 2>&1; then
1674:                         metrics_issues+=("✓ VictoriaMetrics: Healthy")
1675:                     else
1676:                         metrics_issues+=("VictoriaMetrics not responding on ${NFTBAN_METRICS_VICTORIA_ADDR}")
1677:                         [[ $status -lt $HEALTH_WARNING ]] && status=$HEALTH_WARNING
1678:                     fi
1679:                 fi
1680:             else
1681:                 metrics_issues+=("VictoriaMetrics installed but not running")
1682:                 [[ $status -lt $HEALTH_WARNING ]] && status=$HEALTH_WARNING
1683:             fi
1684:         fi
1685:     fi
1686: 
1687:     # Check Grafana (optional)
1688:     if command -v grafana-server >/dev/null 2>&1 || systemctl list-unit-files | grep -q "grafana-server"; then
1689:         if systemctl is-active --quiet grafana-server 2>/dev/null; then
1690:             metrics_issues+=("✓ Grafana: Running")
1691:         else
1692:             metrics_issues+=("Grafana installed but not running")
1693:             [[ $status -lt $HEALTH_WARNING ]] && status=$HEALTH_WARNING
1694:         fi
1695:     fi
1696: 
1697:     # Check Bandwidth Exporter (v0.6 GUI redesign)
1698:     if [[ -f "${NFTBAN_LIB_DIR}/exporters/nftban_bandwidth_exporter.sh" ]]; then
1699:         # Check if bandwidth exporter timer is enabled
1700:         if systemctl list-unit-files | grep -q "nftban-bandwidth-exporter.timer"; then
1701:             if systemctl is-enabled --quiet nftban-bandwidth-exporter.timer 2>/dev/null; then
1702:                 if systemctl is-active --quiet nftban-bandwidth-exporter.timer; then
1703:                     metrics_issues+=("✓ Bandwidth exporter timer: Active")
1704:                 else
1705:                     metrics_issues+=("Bandwidth exporter timer not running")
1706:                     [[ $status -lt $HEALTH_WARNING ]] && status=$HEALTH_WARNING
1707:                 fi
1708:             else
1709:                 metrics_issues+=("Bandwidth exporter timer not enabled")
1710:                 [[ $status -lt $HEALTH_WARNING ]] && status=$HEALTH_WARNING
1711:             fi
1712:         else
1713:             metrics_issues+=("Bandwidth exporter timer not installed")
1714:             [[ $status -lt $HEALTH_WARNING ]] && status=$HEALTH_WARNING
1715:         fi
1716: 
1717:         # Check if bandwidth metrics file exists and is recent
1718:         local bandwidth_metrics_file="/var/lib/node_exporter/textfile_collector/nftban_bandwidth.prom"
1719:         if [[ -f "$bandwidth_metrics_file" ]]; then
1720:             local file_age
1721:             file_age=$(( $(date +%s) - $(stat -c %Y "$bandwidth_metrics_file" 2>/dev/null || stat -f %m "$bandwidth_metrics_file" 2>/dev/null || echo 0) ))
1722: 
1723:             if [[ $file_age -lt 30 ]]; then
1724:                 metrics_issues+=("✓ Bandwidth metrics: Fresh (${file_age}s old)")
1725:             elif [[ $file_age -lt 60 ]]; then
1726:                 metrics_issues+=("Bandwidth metrics ${file_age}s old (may be stale)")
1727:                 [[ $status -eq $HEALTH_OK ]] && status=$HEALTH_WARNING
1728:             else
1729:                 # Bandwidth exporter is optional - only WARNING, not ERROR
1730:                 metrics_issues+=("⚠ Bandwidth metrics stale (${file_age}s old)")
1731:                 [[ $status -eq $HEALTH_OK ]] && status=$HEALTH_WARNING
1732:             fi
1733:         else
1734:             metrics_issues+=("ℹ️ Bandwidth metrics file not found (optional - exporter may not have run yet)")
1735:             # Don't upgrade status for missing optional component
1736:         fi
1737:     fi
1738: 
1739:     # Store results (format metrics issues as separate lines)
1740:     NFTBAN_HEALTH_RESULTS["metrics"]=$status
1741:     if [[ ${#metrics_issues[@]} -gt 0 ]]; then
1742:         # Join array elements with newlines and proper indentation
1743:         local formatted_issues=""
1744:         for issue in "${metrics_issues[@]}"; do
1745:             if [[ -z "$formatted_issues" ]]; then
1746:                 formatted_issues="$issue"
1747:             else
1748:                 formatted_issues="${formatted_issues}
1749:      ${issue}"
1750:             fi
1751:         done
1752:         NFTBAN_HEALTH_ISSUES["metrics"]="$formatted_issues"
1753:     fi
1754: 
1755:     return $status
1756: }

126: 
127:     # Clean temp compilation files
128:     rm -f /tmp/nftban_*.tmp 2>/dev/null || true
129: 
130:     # Keep Go binaries for fast re-enable
131:     echo "  ℹ️  Keeping compiled Go binaries for fast re-enable"
132: }

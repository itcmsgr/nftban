// =============================================================================
// NFTBan - GOTH GUI Metrics Overview Page
// =============================================================================
// SPDX-License-Identifier: MPL-2.0
// meta:name="metrics"
// meta:type="templ"
// meta:owner="Antonios Voulvoulis <contact@nftban.com>"
// meta:created_date="2026-01-26"
// meta:description="Unified metrics overview page showing all NFTBan metrics"
// =============================================================================

package pages

import (
	"fmt"
	"github.com/itcmsgr/nftban/internal/ui"
)

// Metrics renders the unified metrics overview page
templ Metrics(data ui.MetricsData) {
	@ui.LayoutWithNav("Metrics", "metrics") {
		<!-- Page Header -->
		<div class="page-header">
			<h1 class="page-title">Metrics Overview</h1>
			<div style="display: flex; gap: 0.5rem; align-items: center;">
				<span class="collector-status" style={ getCollectorStatusStyle(data.CollectorState) } data-tooltip="Metrics collector service status">
					{ data.CollectorState }
				</span>
				<span id="metrics-loading" class="htmx-indicator">
					<span class="loading-spinner"></span>
				</span>
				<button class="btn btn-primary" hx-get="/ui/frag/metrics-summary" hx-target="#metrics-content" hx-swap="innerHTML" hx-indicator="#metrics-loading">
					Refresh
				</button>
			</div>
		</div>

		<!-- Collection Info Banner -->
		<div class="card info-banner" style="margin-bottom: 1.5rem;">
			<div style="display: flex; justify-content: space-between; align-items: center;">
				<div>
					<span style="font-size: 0.85rem; color: var(--text-muted);">Data Source:</span>
					<code style="margin-left: 0.5rem;">{ data.CachePath }</code>
				</div>
				<div style="font-size: 0.85rem; color: var(--text-muted);">
					Last updated: { data.Timestamp } (age: { data.CacheAge })
				</div>
			</div>
		</div>

		<div id="metrics-content">
			@MetricsContentFragment(data)
		</div>
	}
}

// MetricsContentFragment renders all metrics sections
templ MetricsContentFragment(data ui.MetricsData) {
	<!-- Summary Cards Row -->
	<div class="metrics-summary-row">
		<div class="metric-card" data-tooltip="Total IPs currently blocked by NFTBan">
			<div class="metric-icon danger">&#x1F6AB;</div>
			<div class="metric-info">
				<div class="metric-value danger">{ intToStr(data.Summary.TotalBans) }</div>
				<div class="metric-label">Total Bans</div>
				<div class="metric-detail">v4: { intToStr(data.Summary.BansIPv4) } | v6: { intToStr(data.Summary.BansIPv6) }</div>
			</div>
		</div>
		<div class="metric-card" data-tooltip="IPs exempted from all blocking rules">
			<div class="metric-icon safe">&#x2705;</div>
			<div class="metric-info">
				<div class="metric-value safe">{ intToStr(data.Summary.TotalWhitelist) }</div>
				<div class="metric-label">Whitelist</div>
			</div>
		</div>
		<div class="metric-card" data-tooltip="Threat intelligence feeds currently syncing">
			<div class="metric-icon info">&#x1F4E1;</div>
			<div class="metric-info">
				<div class="metric-value info">{ intToStr(data.Summary.ActiveFeeds) }</div>
				<div class="metric-label">Active Feeds</div>
			</div>
		</div>
		<div class="metric-card" data-tooltip="Countries blocked via GeoIP rules">
			<div class="metric-icon warning">&#x1F30D;</div>
			<div class="metric-info">
				<div class="metric-value warning">{ intToStr(data.Summary.BlockedCountries) }</div>
				<div class="metric-label">Blocked Countries</div>
			</div>
		</div>
		<div class="metric-card" data-tooltip="Security events processed in the last hour">
			<div class="metric-icon">&#x1F4CA;</div>
			<div class="metric-info">
				<div class="metric-value">{ intToStr(data.Summary.EventsLastHour) }</div>
				<div class="metric-label">Events/Hour</div>
			</div>
		</div>
		<div class="metric-card">
			<div class={ "metric-icon", data.Summary.HealthStatus }>
				if data.Summary.HealthStatus == "ok" {
					&#x2714;
				} else if data.Summary.HealthStatus == "warning" {
					&#x26A0;
				} else {
					&#x274C;
				}
			</div>
			<div class="metric-info">
				<div class={ "metric-value", data.Summary.HealthStatus }>{ data.Summary.HealthStatus }</div>
				<div class="metric-label">Health</div>
			</div>
		</div>
	</div>

	<!-- Main Content Grid -->
	<div class="metrics-grid">
		<!-- Firewall Metrics -->
		<div class="card">
			<div class="card-header">
				<span class="card-title">Firewall (nftables)</span>
				if data.Firewall.NftablesActive {
					<span class="badge badge-success">Active</span>
				} else {
					<span class="badge badge-danger">Inactive</span>
				}
			</div>
			<div class="metrics-detail-grid">
				<div class="detail-item">
					<span class="detail-label">Table Exists</span>
					<span class="detail-value">
						if data.Firewall.TableExists {
							Yes
						} else {
							No
						}
					</span>
				</div>
				<div class="detail-item">
					<span class="detail-label">Total Rules</span>
					<span class="detail-value">{ intToStr(data.Firewall.RulesTotal) }</span>
				</div>
				<div class="detail-item">
					<span class="detail-label">Sets</span>
					<span class="detail-value">{ intToStr(data.Firewall.SetsTotal) }</span>
				</div>
				<div class="detail-item">
					<span class="detail-label">Counters</span>
					<span class="detail-value">{ intToStr(data.Firewall.CountersTotal) }</span>
				</div>
				<div class="detail-item">
					<span class="detail-label">Chains</span>
					<span class="detail-value">{ intToStr(data.Firewall.ChainCount) }</span>
				</div>
			</div>
		</div>

		<!-- Security Metrics -->
		<div class="card">
			<div class="card-header">
				<span class="card-title">Security</span>
				<span class={ "badge", getThreatLevelBadge(data.Security.ThreatLevel) }>{ data.Security.ThreatLevel }</span>
			</div>
			<div class="metrics-detail-grid">
				<div class="detail-item">
					<span class="detail-label">Total Bans</span>
					<span class="detail-value danger">{ intToStr(data.Security.BansTotal) }</span>
				</div>
				<div class="detail-item">
					<span class="detail-label">Temporary</span>
					<span class="detail-value">{ intToStr(data.Security.BansTemporary) }</span>
				</div>
				<div class="detail-item">
					<span class="detail-label">Permanent</span>
					<span class="detail-value">{ intToStr(data.Security.BansPermanent) }</span>
				</div>
				<div class="detail-item">
					<span class="detail-label">From Feeds</span>
					<span class="detail-value">{ intToStr(data.Security.BansFeed) }</span>
				</div>
				<div class="detail-item">
					<span class="detail-label">From GeoIP</span>
					<span class="detail-value">{ intToStr(data.Security.BansGeoIP) }</span>
				</div>
				<div class="detail-item">
					<span class="detail-label">Unbans Today</span>
					<span class="detail-value safe">{ intToStr(data.Security.UnbansToday) }</span>
				</div>
			</div>
		</div>

		<!-- Network Metrics -->
		<div class="card">
			<div class="card-header">
				<span class="card-title">Network Traffic</span>
				<span class="badge badge-info">{ data.Network.TopInterface }</span>
			</div>
			<div class="metrics-detail-grid">
				<div class="detail-item">
					<span class="detail-label">RX Rate</span>
					<span class="detail-value info">{ fmt.Sprintf("%.2f", data.Network.RxMbps) } Mbps</span>
				</div>
				<div class="detail-item">
					<span class="detail-label">TX Rate</span>
					<span class="detail-value info">{ fmt.Sprintf("%.2f", data.Network.TxMbps) } Mbps</span>
				</div>
				<div class="detail-item">
					<span class="detail-label">Total RX</span>
					<span class="detail-value">{ fmt.Sprintf("%.2f", data.Network.TotalRxGB) } GB</span>
				</div>
				<div class="detail-item">
					<span class="detail-label">Total TX</span>
					<span class="detail-value">{ fmt.Sprintf("%.2f", data.Network.TotalTxGB) } GB</span>
				</div>
				<div class="detail-item">
					<span class="detail-label">Connections</span>
					<span class="detail-value">{ intToStr(data.Network.ConnectionsTotal) }</span>
				</div>
				<div class="detail-item">
					<span class="detail-label">Dropped</span>
					<span class="detail-value warning">{ fmt.Sprintf("%d", data.Network.PacketsDropped) }</span>
				</div>
			</div>
		</div>

		<!-- System Metrics -->
		<div class="card">
			<div class="card-header">
				<span class="card-title">System Resources</span>
			</div>
			<div class="metrics-detail-grid">
				<div class="detail-item">
					<span class="detail-label">CPU Usage</span>
					<span class={ "detail-value", getResourceClass(data.System.CPUPercent) }>{ fmt.Sprintf("%.1f%%", data.System.CPUPercent) }</span>
				</div>
				<div class="detail-item">
					<span class="detail-label">Memory</span>
					<span class={ "detail-value", getResourceClass(data.System.MemPercent) }>{ fmt.Sprintf("%.1f%%", data.System.MemPercent) }</span>
				</div>
				<div class="detail-item">
					<span class="detail-label">Disk</span>
					<span class={ "detail-value", getResourceClass(data.System.DiskPercent) }>{ fmt.Sprintf("%.1f%%", data.System.DiskPercent) }</span>
				</div>
				<div class="detail-item">
					<span class="detail-label">Load Avg</span>
					<span class="detail-value">{ fmt.Sprintf("%.2f / %.2f / %.2f", data.System.LoadAvg1, data.System.LoadAvg5, data.System.LoadAvg15) }</span>
				</div>
				<div class="detail-item">
					<span class="detail-label">NFTBan CPU</span>
					<span class="detail-value">{ fmt.Sprintf("%.1f%%", data.System.NFTBanCPU) }</span>
				</div>
				<div class="detail-item">
					<span class="detail-label">NFTBan Mem</span>
					<span class="detail-value">{ fmt.Sprintf("%.1f MB", data.System.NFTBanMemMB) }</span>
				</div>
			</div>
		</div>
	</div>

	<!-- Module Metrics Table -->
	<div class="card" style="margin-top: 1.5rem;">
		<div class="card-header">
			<span class="card-title">Module Metrics</span>
		</div>
		<table class="data-table">
			<thead>
				<tr>
					<th>Module</th>
					<th>Status</th>
					<th>Bans</th>
					<th>Events</th>
					<th>CPU</th>
					<th>Memory</th>
					<th>Last Sync</th>
				</tr>
			</thead>
			<tbody>
				for _, mod := range data.Modules {
					<tr>
						<td style="font-weight: 500;">{ mod.Name }</td>
						<td>
							<span class={ "badge", getModuleStatusBadge(mod.Status) }>{ mod.Status }</span>
						</td>
						<td>{ intToStr(mod.BansCount) }</td>
						<td>{ intToStr(mod.EventsCount) }</td>
						<td>{ fmt.Sprintf("%.1f%%", mod.CPUPercent) }</td>
						<td>{ fmt.Sprintf("%.1f MB", mod.MemoryMB) }</td>
						<td style="color: var(--text-muted);">{ mod.LastSync }</td>
					</tr>
				}
				if len(data.Modules) == 0 {
					<tr>
						<td colspan="7">
							<div class="empty-state">
								<div class="empty-state-icon">&#x1F4CA;</div>
								<div class="empty-state-title">No Module Metrics</div>
								<div class="empty-state-description">Module metrics will appear here once modules are enabled and running.</div>
							</div>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>

	<!-- Threat Feeds Table -->
	if len(data.Feeds) > 0 {
		<div class="card" style="margin-top: 1.5rem;">
			<div class="card-header">
				<span class="card-title">Threat Feeds</span>
			</div>
			<table class="data-table">
				<thead>
					<tr>
						<th>Feed</th>
						<th>Status</th>
						<th>IP Count</th>
						<th>Last Sync</th>
						<th>Next Sync</th>
						<th>Errors</th>
					</tr>
				</thead>
				<tbody>
					for _, feed := range data.Feeds {
						<tr>
							<td style="font-weight: 500;">{ feed.Name }</td>
							<td>
								<span class={ "badge", getFeedStatusBadge(feed.Status) }>{ feed.Status }</span>
							</td>
							<td>{ intToStr(feed.IPCount) }</td>
							<td style="color: var(--text-muted);">{ feed.LastSync }</td>
							<td style="color: var(--text-muted);">{ feed.NextSync }</td>
							<td>
								if feed.SyncErrors > 0 {
									<span class="badge badge-danger">{ intToStr(feed.SyncErrors) }</span>
								} else {
									<span class="badge badge-muted">0</span>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}

	<!-- Specialized Modules Grid -->
	<div class="metrics-grid" style="margin-top: 1.5rem;">
		<!-- GeoIP Stats -->
		<div class="card">
			<div class="card-header">
				<span class="card-title">GeoIP / GeoBan</span>
				if data.GeoIP.Enabled {
					<span class="badge badge-success">Enabled</span>
				} else {
					<span class="badge badge-muted">Disabled</span>
				}
			</div>
			<div class="metrics-detail-grid">
				<div class="detail-item">
					<span class="detail-label">Blocked Countries</span>
					<span class="detail-value warning">{ intToStr(data.GeoIP.BlockedCountries) }</span>
				</div>
				<div class="detail-item">
					<span class="detail-label">Blocked Ranges</span>
					<span class="detail-value">{ intToStr(data.GeoIP.BlockedRanges) }</span>
				</div>
				<div class="detail-item">
					<span class="detail-label">DB Version</span>
					<span class="detail-value">{ data.GeoIP.DatabaseVersion }</span>
				</div>
				<div class="detail-item">
					<span class="detail-label">DB Age</span>
					<span class="detail-value">{ data.GeoIP.DatabaseAge }</span>
				</div>
			</div>
			if len(data.GeoIP.CountryStats) > 0 {
				<div class="metrics-subtable">
					<div class="subtable-header">Top Blocked Countries</div>
					<table class="data-table compact">
						<thead>
							<tr>
								<th>Country</th>
								<th>Bans</th>
								<th>Ranges</th>
								<th>%</th>
							</tr>
						</thead>
						<tbody>
							for _, cs := range data.GeoIP.CountryStats {
								<tr>
									<td><span class="country-flag" title={ cs.Name }>{ cs.Code }</span> { cs.Name }</td>
									<td>{ intToStr(cs.BanCount) }</td>
									<td>{ intToStr(cs.RangeCount) }</td>
									<td>{ fmt.Sprintf("%.1f%%", cs.Percent) }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>

		<!-- Portscan Stats -->
		<div class="card">
			<div class="card-header">
				<span class="card-title">Portscan Detection</span>
				if data.Portscan.Enabled {
					<span class="badge badge-success">Enabled</span>
				} else {
					<span class="badge badge-muted">Disabled</span>
				}
			</div>
			<div class="metrics-detail-grid">
				<div class="detail-item">
					<span class="detail-label">Total Blocks</span>
					<span class="detail-value danger">{ intToStr(data.Portscan.TotalBlocks) }</span>
				</div>
				<div class="detail-item">
					<span class="detail-label">Blocks Today</span>
					<span class="detail-value">{ intToStr(data.Portscan.BlocksToday) }</span>
				</div>
			</div>
			if len(data.Portscan.TopPorts) > 0 {
				<div class="metrics-subtable">
					<div class="subtable-header">Most Scanned Ports</div>
					<table class="data-table compact">
						<thead>
							<tr>
								<th>Port</th>
								<th>Protocol</th>
								<th>Scans</th>
							</tr>
						</thead>
						<tbody>
							for _, p := range data.Portscan.TopPorts {
								<tr>
									<td><code>{ intToStr(p.Port) }</code></td>
									<td>{ p.Protocol }</td>
									<td>{ intToStr(p.ScanCount) }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>

		<!-- DDoS Stats -->
		<div class="card">
			<div class="card-header">
				<span class="card-title">DDoS Protection</span>
				if data.DDoS.Enabled {
					<span class="badge badge-success">Enabled</span>
				} else {
					<span class="badge badge-muted">Disabled</span>
				}
			</div>
			<div class="metrics-detail-grid">
				<div class="detail-item">
					<span class="detail-label">Total Blocks</span>
					<span class="detail-value danger">{ intToStr(data.DDoS.TotalBlocks) }</span>
				</div>
				<div class="detail-item">
					<span class="detail-label">Blocks Today</span>
					<span class="detail-value">{ intToStr(data.DDoS.BlocksToday) }</span>
				</div>
				<div class="detail-item">
					<span class="detail-label">Active Mitigations</span>
					<span class="detail-value warning">{ intToStr(data.DDoS.ActiveMitigations) }</span>
				</div>
			</div>
		</div>

		<!-- Suricata Stats -->
		<div class="card">
			<div class="card-header">
				<span class="card-title">Suricata IDS</span>
				if data.Suricata.Enabled {
					<span class="badge badge-success">{ data.Suricata.Status }</span>
				} else {
					<span class="badge badge-muted">Disabled</span>
				}
			</div>
			<div class="metrics-detail-grid">
				<div class="detail-item">
					<span class="detail-label">Total Alerts</span>
					<span class="detail-value warning">{ intToStr(data.Suricata.AlertsTotal) }</span>
				</div>
				<div class="detail-item">
					<span class="detail-label">Alerts Today</span>
					<span class="detail-value">{ intToStr(data.Suricata.AlertsToday) }</span>
				</div>
				<div class="detail-item">
					<span class="detail-label">Rules Loaded</span>
					<span class="detail-value info">{ intToStr(data.Suricata.RulesLoaded) }</span>
				</div>
			</div>
			if len(data.Suricata.TopAlerts) > 0 {
				<div class="metrics-subtable">
					<div class="subtable-header">Top Alerts</div>
					<table class="data-table compact">
						<thead>
							<tr>
								<th>SID</th>
								<th>Signature</th>
								<th>Severity</th>
								<th>Count</th>
							</tr>
						</thead>
						<tbody>
							for _, a := range data.Suricata.TopAlerts {
								<tr>
									<td><code>{ a.SID }</code></td>
									<td style="max-width: 250px; overflow: hidden; text-overflow: ellipsis;">{ a.Signature }</td>
									<td>
										if a.Severity == "high" || a.Severity == "critical" {
											<span class="badge badge-danger">{ a.Severity }</span>
										} else if a.Severity == "medium" {
											<span class="badge badge-warning">{ a.Severity }</span>
										} else {
											<span class="badge badge-info">{ a.Severity }</span>
										}
									</td>
									<td>{ intToStr(a.Count) }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	</div>

	<style>
		.metrics-summary-row {
			display: grid;
			grid-template-columns: repeat(6, 1fr);
			gap: 1rem;
			margin-bottom: 1.5rem;
		}
		@media (max-width: 1400px) {
			.metrics-summary-row {
				grid-template-columns: repeat(3, 1fr);
			}
		}
		@media (max-width: 768px) {
			.metrics-summary-row {
				grid-template-columns: repeat(2, 1fr);
			}
		}
		.metric-card {
			background: var(--bg-surface);
			border: 1px solid var(--border-color);
			border-radius: 8px;
			padding: 1rem;
			display: flex;
			align-items: center;
			gap: 1rem;
		}
		.metric-icon {
			font-size: 2rem;
			opacity: 0.8;
		}
		.metric-icon.danger { color: var(--accent-danger); }
		.metric-icon.safe, .metric-icon.ok { color: var(--accent-safe); }
		.metric-icon.info { color: var(--accent-info); }
		.metric-icon.warning { color: var(--accent-warning); }
		.metric-icon.error { color: var(--accent-danger); }
		.metric-info {
			flex: 1;
		}
		.metric-value {
			font-size: 1.5rem;
			font-weight: 700;
			font-family: 'SF Mono', Monaco, monospace;
		}
		.metric-value.danger { color: var(--accent-danger); }
		.metric-value.safe, .metric-value.ok { color: var(--accent-safe); }
		.metric-value.info { color: var(--accent-info); }
		.metric-value.warning { color: var(--accent-warning); }
		.metric-value.error { color: var(--accent-danger); }
		.metric-label {
			font-size: 0.75rem;
			color: var(--text-muted);
			text-transform: uppercase;
		}
		.metric-detail {
			font-size: 0.7rem;
			color: var(--text-muted);
		}

		.metrics-grid {
			display: grid;
			grid-template-columns: repeat(2, 1fr);
			gap: 1.5rem;
		}
		@media (max-width: 1024px) {
			.metrics-grid {
				grid-template-columns: 1fr;
			}
		}
		.metrics-detail-grid {
			display: grid;
			grid-template-columns: repeat(2, 1fr);
			gap: 0.75rem;
			padding: 0.5rem;
		}
		.detail-item {
			display: flex;
			justify-content: space-between;
			align-items: center;
			padding: 0.5rem;
			background: var(--bg-elevated);
			border-radius: 4px;
		}
		.detail-label {
			font-size: 0.8rem;
			color: var(--text-muted);
		}
		.detail-value {
			font-family: 'SF Mono', Monaco, monospace;
			font-weight: 500;
		}
		.detail-value.danger { color: var(--accent-danger); }
		.detail-value.safe { color: var(--accent-safe); }
		.detail-value.info { color: var(--accent-info); }
		.detail-value.warning { color: var(--accent-warning); }

		.metrics-subtable {
			border-top: 1px solid var(--border-color);
			padding: 0.5rem;
		}
		.subtable-header {
			font-size: 0.75rem;
			font-weight: 600;
			color: var(--text-muted);
			text-transform: uppercase;
			padding: 0.5rem 0.5rem 0.25rem;
		}
		.data-table.compact {
			font-size: 0.8rem;
		}
		.data-table.compact td, .data-table.compact th {
			padding: 0.35rem 0.5rem;
		}

		.info-banner {
			background: var(--bg-elevated);
			padding: 0.75rem 1rem;
		}

		.collector-status {
			padding: 0.25rem 0.75rem;
			border-radius: 4px;
			font-size: 0.8rem;
			font-weight: 500;
			text-transform: uppercase;
		}
	</style>
}

// Helper functions
func getCollectorStatusStyle(state string) string {
	switch state {
	case "running":
		return "background: rgba(16, 185, 129, 0.15); color: var(--accent-safe);"
	case "stopped":
		return "background: rgba(107, 114, 128, 0.15); color: var(--text-muted);"
	case "stale":
		return "background: rgba(245, 158, 11, 0.15); color: var(--accent-warning);"
	default:
		return "background: rgba(239, 68, 68, 0.15); color: var(--accent-danger);"
	}
}

func getThreatLevelBadge(level string) string {
	switch level {
	case "low":
		return "badge-success"
	case "medium":
		return "badge-warning"
	case "high":
		return "badge-danger"
	case "critical":
		return "badge-danger"
	default:
		return "badge-muted"
	}
}

func getResourceClass(percent float64) string {
	if percent >= 90 {
		return "danger"
	} else if percent >= 70 {
		return "warning"
	}
	return "safe"
}

func getModuleStatusBadge(status string) string {
	switch status {
	case "active":
		return "badge-success"
	case "inactive":
		return "badge-muted"
	case "error":
		return "badge-danger"
	default:
		return "badge-warning"
	}
}

func getFeedStatusBadge(status string) string {
	switch status {
	case "active":
		return "badge-success"
	case "syncing":
		return "badge-info"
	case "stale":
		return "badge-warning"
	case "error":
		return "badge-danger"
	default:
		return "badge-muted"
	}
}

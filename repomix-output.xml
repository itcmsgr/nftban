270: # ==============================================================================
271: # Shared: Install Prometheus from official binaries
272: # ==============================================================================
273: nftban_metrics_install_from_binaries() {
274:     # Install Prometheus and Node Exporter from official GitHub releases
275:     # Used when packages not available in distribution repositories
276:     # Returns: 0 on success, 1 on failure
277: 
278:     local verbose="${1:-true}"
279: 
280:     # Latest stable versions (update periodically)
281:     local prom_ver="2.54.1"
282:     local node_ver="1.8.2"
283:     local tmp_dir="/tmp/nftban-metrics-install-$$"
284: 
285:     [[ "$verbose" == "true" ]] && echo ""
286:     [[ "$verbose" == "true" ]] && echo "  📦 Binary Installation Details:"
287:     [[ "$verbose" == "true" ]] && echo "     Prometheus: v${prom_ver}"
288:     [[ "$verbose" == "true" ]] && echo "     Node Exporter: v${node_ver}"
289:     [[ "$verbose" == "true" ]] && echo ""
290: 
291:     # Create temp directory
292:     mkdir -p "$tmp_dir"
293:     cd "$tmp_dir" || return 1
294: 
295:     # Download Prometheus
296:     [[ "$verbose" == "true" ]] && echo "  ⬇️  Downloading Prometheus..."
297:     if ! wget -q "https://github.com/prometheus/prometheus/releases/download/v${prom_ver}/prometheus-${prom_ver}.linux-amd64.tar.gz"; then
298:         [[ "$verbose" == "true" ]] && echo "  ❌ Failed to download Prometheus"
299:         rm -rf "$tmp_dir"
300:         return 1
301:     fi
302: 
303:     # Download Node Exporter
304:     [[ "$verbose" == "true" ]] && echo "  ⬇️  Downloading Node Exporter..."
305:     if ! wget -q "https://github.com/prometheus/node_exporter/releases/download/v${node_ver}/node_exporter-${node_ver}.linux-amd64.tar.gz"; then
306:         [[ "$verbose" == "true" ]] && echo "  ❌ Failed to download Node Exporter"
307:         rm -rf "$tmp_dir"
308:         return 1
309:     fi
310: 
311:     # Extract archives
312:     [[ "$verbose" == "true" ]] && echo "  📦 Extracting archives..."
313:     tar xzf "prometheus-${prom_ver}.linux-amd64.tar.gz" || return 1
314:     tar xzf "node_exporter-${node_ver}.linux-amd64.tar.gz" || return 1
315: 
316:     # Install Prometheus binaries
317:     [[ "$verbose" == "true" ]] && echo "  📂 Installing binaries..."
318:     install -m 0755 "prometheus-${prom_ver}.linux-amd64/prometheus" /usr/local/bin/prometheus
319:     install -m 0755 "prometheus-${prom_ver}.linux-amd64/promtool" /usr/local/bin/promtool
320:     install -m 0755 "node_exporter-${node_ver}.linux-amd64/node_exporter" /usr/local/bin/node_exporter
321: 
322:     # Create Prometheus user if doesn't exist
323:     if ! id prometheus &>/dev/null; then
324:         useradd --system --no-create-home --shell /usr/sbin/nologin prometheus 2>/dev/null || true
325:     fi
326: 
327:     # Create directories
328:     mkdir -p /etc/prometheus
329:     mkdir -p /var/lib/prometheus
330:     mkdir -p /var/lib/node_exporter/textfile_collector
331: 
332:     chown -R prometheus:prometheus /etc/prometheus /var/lib/prometheus 2>/dev/null || true
333:     chown -R nftban:nftban /var/lib/node_exporter 2>/dev/null || true
334: 
335:     # Create minimal Prometheus config if doesn't exist
336:     if [[ ! -f /etc/prometheus/prometheus.yml ]]; then
337:         cat > /etc/prometheus/prometheus.yml << 'PROMCONFIG'
338: global:
339:   scrape_interval: 15s
340:   evaluation_interval: 15s
341: 
342: scrape_configs:
343:   - job_name: 'prometheus'
344:     static_configs:
345:       - targets: ['localhost:9090']
346: 
347:   - job_name: 'node'
348:     static_configs:
349:       - targets: ['localhost:9100']
350: 
351:   - job_name: 'nftban'
352:     static_configs:
353:       - targets: ['localhost:9100']
354:     metric_relabel_configs:
355:       - source_labels: [__name__]
356:         regex: 'nftban_.*'
357:         action: keep
358: PROMCONFIG
359:         chown prometheus:prometheus /etc/prometheus/prometheus.yml
360:     fi
361: 
362:     # Create systemd services
363:     nftban_metrics_create_systemd_services "$verbose"
364: 
365:     # Cleanup
366:     cd /
367:     rm -rf "$tmp_dir"
368: 
369:     [[ "$verbose" == "true" ]] && echo "  ✅ Binary installation complete"
370:     [[ "$verbose" == "true" ]] && echo ""
371:     [[ "$verbose" == "true" ]] && echo "  ℹ️  Installed to /usr/local/bin/"
372:     [[ "$verbose" == "true" ]] && echo "     prometheus --version: $(prometheus --version 2>&1 | head -1)"
373:     [[ "$verbose" == "true" ]] && echo "     node_exporter --version: $(node_exporter --version 2>&1 | head -1)"
374: 
375:     return 0
376: }
377: 
378: # ==============================================================================
379: # Shared: Create systemd services for binary installation
380: # ==============================================================================
381: nftban_metrics_create_systemd_services() {
382:     # Create systemd service files for manually installed binaries
383:     # Called by nftban_metrics_install_from_binaries()
384: 
385:     local verbose="${1:-true}"
386: 
387:     [[ "$verbose" == "true" ]] && echo "  ⚙️  Creating systemd services..."
388: 
389:     # Prometheus service
390:     cat > /etc/systemd/system/prometheus.service << 'PROMSERVICE'
391: [Unit]
392: Description=Prometheus Time Series Database
393: Documentation=https://prometheus.io/docs/introduction/overview/
394: After=network-online.target
395: Wants=network-online.target
396: 
397: [Service]
398: Type=simple
399: User=prometheus
400: Group=prometheus
401: ExecStart=/usr/local/bin/prometheus \
402:   --config.file=/etc/prometheus/prometheus.yml \
403:   --storage.tsdb.path=/var/lib/prometheus/ \
404:   --web.console.templates=/etc/prometheus/consoles \
405:   --web.console.libraries=/etc/prometheus/console_libraries \
406:   --web.listen-address=0.0.0.0:9090
407: 
408: Restart=always
409: RestartSec=5
410: StandardOutput=journal
411: StandardError=journal
412: 
413: [Install]
414: WantedBy=multi-user.target
415: PROMSERVICE
416: 
417:     # Node Exporter service
418:     cat > /etc/systemd/system/node-exporter.service << 'NODESERVICE'
419: [Unit]
420: Description=Prometheus Node Exporter
421: Documentation=https://github.com/prometheus/node_exporter
422: After=network-online.target
423: Wants=network-online.target
424: 
425: [Service]
426: Type=simple
427: User=nftban
428: Group=nftban
429: ExecStart=/usr/local/bin/node_exporter \
430:   --collector.textfile.directory=/var/lib/node_exporter/textfile_collector
431: 
432: Restart=always
433: RestartSec=5
434: StandardOutput=journal
435: StandardError=journal
436: 
437: [Install]
438: WantedBy=multi-user.target
439: NODESERVICE
440: 
441:     # Reload systemd
442:     systemctl daemon-reload
443: 
444:     [[ "$verbose" == "true" ]] && echo "  ✓ Systemd services created"
445: }
446: 
447: # ==============================================================================
448: # VictoriaMetrics: Start Stack
449: # ==============================================================================
450: nftban_metrics_start_stack_victoriametrics() {
451:     # Start Node Exporter, VictoriaMetrics, and NFTBan metrics exporter
452:     # Returns: 0 on success, 1 on failure
453: 
454:     local verbose="${1:-true}"  # Show output by default
455: 
456:     # Create textfile collector directory (same as Prometheus)
457:     mkdir -p /var/lib/node_exporter/textfile_collector
458:     chown -R nftban:nftban /var/lib/node_exporter/textfile_collector 2>/dev/null || true
459: 
460:     # Start Node Exporter (service name varies by distro/install method)
461:     local node_exporter_started=false
462:     local node_exporter_service=""
463: 
464:     for svc in node-exporter node_exporter prometheus-node-exporter; do
465:         if systemctl list-unit-files 2>/dev/null | grep -q "^${svc}.service"; then
466:             node_exporter_service="$svc"
467:             systemctl enable "$svc" &>/dev/null || true
468:             systemctl restart "$svc" &>/dev/null || true
469:             if systemctl is-active "$svc" &>/dev/null; then
470:                 node_exporter_started=true
471:                 break
472:             fi
473:         fi
474:     done
475: 
476:     if [[ "$node_exporter_started" == "true" ]]; then
477:         [[ "$verbose" == "true" ]] && echo "  ✓ Node Exporter running ($node_exporter_service)"
478:     else
479:         [[ "$verbose" == "true" ]] && echo "  ❌ Node Exporter service not found"
480:         return 1
481:     fi
482: 
483:     # Start VictoriaMetrics
484:     if systemctl list-unit-files 2>/dev/null | grep -q "victoriametrics.service"; then
485:         systemctl enable victoriametrics &>/dev/null || true
486:         systemctl restart victoriametrics &>/dev/null || true
487:         if systemctl is-active victoriametrics &>/dev/null; then
488:             [[ "$verbose" == "true" ]] && echo "  ✓ VictoriaMetrics running"
489:         else
490:             [[ "$verbose" == "true" ]] && echo "  ❌ VictoriaMetrics failed to start"
491:             return 1
492:         fi
493:     else
494:         [[ "$verbose" == "true" ]] && echo "  ❌ VictoriaMetrics service not found"
495:         return 1
496:     fi
497: 
498:     # Start NFTBan metrics exporter timer
499:     local metrics_timer="${NFTBAN_TIMER_METRICS_EXPORTER:-nftban-metrics-exporter.timer}"
500:     local metrics_svc="${NFTBAN_SERVICE_METRICS_EXPORTER:-nftban-metrics-exporter.service}"
501:     if systemctl list-unit-files 2>/dev/null | grep -q "$metrics_timer"; then
502:         systemctl enable "$metrics_timer" &>/dev/null || true
503:         systemctl restart "$metrics_timer" &>/dev/null || true
504:         # Trigger one immediate collection
505:         systemctl start "$metrics_svc" &>/dev/null || true
506:         [[ "$verbose" == "true" ]] && echo "  ✓ Metrics collection timer enabled (60s interval)"
507:     else
508:         [[ "$verbose" == "true" ]] && echo "  ⚠️  $metrics_timer not installed"
509:     fi
510: 
511:     return 0
512: }
513: 
514: # ==============================================================================
515: # VictoriaMetrics: Stop Stack
516: # ==============================================================================
517: nftban_metrics_stop_stack_victoriametrics() {
518:     # Stop VictoriaMetrics, Node Exporter, and NFTBan metrics exporter
519:     # Returns: 0 on success
520: 
521:     local verbose="${1:-true}"  # Show output by default
522: 
523:     # Stop NFTBan metrics exporter
524:     local metrics_timer="${NFTBAN_TIMER_METRICS_EXPORTER:-nftban-metrics-exporter.timer}"
525:     local metrics_svc="${NFTBAN_SERVICE_METRICS_EXPORTER:-nftban-metrics-exporter.service}"
526:     if systemctl list-unit-files 2>/dev/null | grep -q "$metrics_timer"; then
527:         systemctl stop "$metrics_timer" &>/dev/null || true
528:         systemctl stop "$metrics_svc" &>/dev/null || true
529:         systemctl disable "$metrics_timer" &>/dev/null || true
530:         [[ "$verbose" == "true" ]] && echo "  ✓ NFTBan metrics exporter stopped"
531:     fi
532: 
533:     # Stop VictoriaMetrics
534:     if systemctl list-unit-files 2>/dev/null | grep -q "victoriametrics.service"; then
535:         systemctl stop victoriametrics &>/dev/null || true
536:         systemctl disable victoriametrics &>/dev/null || true
537:         [[ "$verbose" == "true" ]] && echo "  ✓ VictoriaMetrics stopped"
538:     fi
539: 
540:     # Stop Node Exporter
541:     local node_exporter_service
542:     node_exporter_service=$(nftban_distro_get_service node_exporter 2>/dev/null || echo "prometheus-node-exporter")
543:     if systemctl list-unit-files 2>/dev/null | grep -q "${node_exporter_service}.service"; then
544:         systemctl stop "$node_exporter_service" &>/dev/null || true
545:         systemctl disable "$node_exporter_service" &>/dev/null || true
546:         [[ "$verbose" == "true" ]] && echo "  ✓ Node Exporter stopped"
547:     fi
548: 
549:     return 0
550: }
551: 
552: # ==============================================================================
553: # VictoriaMetrics: Check if stack is running
554: # ==============================================================================
555: nftban_metrics_is_running_victoriametrics() {
556:     # Check if all 3 services are running
557:     # Returns: 0 if all running, 1 if any stopped
558: 
559:     local node_exporter_service
560:     node_exporter_service=$(nftban_distro_get_service node_exporter 2>/dev/null || echo "prometheus-node-exporter")
561: 
562:     local metrics_timer="${NFTBAN_TIMER_METRICS_EXPORTER:-nftban-metrics-exporter.timer}"
563:     if systemctl is-active victoriametrics &>/dev/null && \
564:        systemctl is-active "$node_exporter_service" &>/dev/null && \
565:        systemctl is-active "$metrics_timer" &>/dev/null; then
566:         return 0  # All running
567:     else
568:         return 1  # Some stopped
569:     fi
570: }
571: 
572: # ==============================================================================
573: # VictoriaMetrics: Install VictoriaMetrics binary
574: # ==============================================================================
575: nftban_metrics_install_victoriametrics() {
576:     # Install VictoriaMetrics from official binary releases
577:     # Returns: 0 on success, 1 on failure
578: 
579:     local verbose="${1:-true}"
580: 
581:     [[ "$verbose" == "true" ]] && echo "  📥 Installing VictoriaMetrics..."
582: 
583:     # Check if already installed
584:     if [[ -f /usr/local/bin/victoria-metrics-prod ]]; then
585:         [[ "$verbose" == "true" ]] && echo "  ✓ VictoriaMetrics already installed"
586:         return 0
587:     fi
588: 
589:     # Run installation script
590:     if [[ -f "${NFTBAN_LIB_DIR}/setup/install_victoriametrics.sh" ]]; then
591:         if bash "${NFTBAN_LIB_DIR}/setup/install_victoriametrics.sh"; then
592:             [[ "$verbose" == "true" ]] && echo "  ✅ VictoriaMetrics installed successfully"
593:             return 0
594:         else
595:             [[ "$verbose" == "true" ]] && echo "  ❌ VictoriaMetrics installation failed"
596:             return 1
597:         fi
598:     else
599:         [[ "$verbose" == "true" ]] && echo "  ❌ VictoriaMetrics installation script not found"
600:         [[ "$verbose" == "true" ]] && echo "     Expected: ${NFTBAN_LIB_DIR}/setup/install_victoriametrics.sh"
601:         return 1
602:     fi
603: }
604: 
605: # ==============================================================================
606: # VictoriaMetrics: Check health
607: # ==============================================================================
608: nftban_metrics_check_victoriametrics_health() {
609:     # Check if VictoriaMetrics is responding
610:     # Returns: 0 if healthy, 1 if not
611: 
612:     local vm_url="${NFTBAN_VICTORIAMETRICS_URL:-http://127.0.0.1:8428}"
613: 
614:     if curl -sf "${vm_url}/health" &>/dev/null; then
615:         return 0
616:     else
617:         return 1
618:     fi
619: }
620: 
621: # Export all functions
622: export -f nftban_metrics_start_stack
623: export -f nftban_metrics_stop_stack
624: export -f nftban_metrics_is_running
625: export -f nftban_metrics_check_deps
626: export -f nftban_metrics_install_deps
627: export -f nftban_metrics_install_from_binaries
628: export -f nftban_metrics_create_systemd_services
629: export -f nftban_metrics_start_stack_victoriametrics
630: export -f nftban_metrics_stop_stack_victoriametrics
631: export -f nftban_metrics_is_running_victoriametrics
632: export -f nftban_metrics_install_victoriametrics
633: export -f nftban_metrics_check_victoriametrics_health
</file>

<file path="cli/lib/nftban/lib/service_control.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - Service Control Library
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Centralized service enable/disable logic for NFTBan
  7: # Location: /usr/lib/nftban/lib/service_control.sh
  8: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
  9: # meta:homepage=https://nftban.com
 10: #
 11: # meta:name=service_control
 12: # meta:type=lib
 13: # meta:header=Service Control Library
 14: # meta:version=1.0.0
 15: #
 16: # **Description & Purpose**
 17: # meta:description=Centralized service control for enable/disable NFTBan and subsystems
 18: # meta:input=Service name (nftban, nftables, suricata, login)
 19: # meta:output=Service state changes and status
 20: #
 21: # **Functions Provided**
 22: # - nftban_is_enabled(): Check if NFTBan master switch is on
 23: # - nftban_service_is_enabled(): Check if specific service is enabled
 24: # - nftban_enable_all(): Enable all NFTBan services
 25: # - nftban_disable_all(): Disable all NFTBan services (emergency)
 26: # - nftban_service_start(): Start a specific service
 27: # - nftban_service_stop(): Stop a specific service
 28: #
 29: # meta:created_date=2025-12-02
 30: # =============================================================================
 31: 
 32: # Guard against multiple sourcing
 33: [[ -n "${_NFTBAN_SERVICE_CONTROL_LOADED:-}" ]] && return 0
 34: readonly _NFTBAN_SERVICE_CONTROL_LOADED=1
 35: 
 36: # =============================================================================
 37: # CONFIGURATION
 38: # =============================================================================
 39: 
 40: # Config paths
 41: NFTBAN_CONFIG_DIR="${NFTBAN_CONFIG_DIR:-/etc/nftban}"
 42: 
 43: # Load main configuration (service names, paths)
 44: if [[ -f "${NFTBAN_CONFIG_DIR}/nftban.conf" ]]; then
 45:     source "${NFTBAN_CONFIG_DIR}/nftban.conf"
 46: fi
 47: NFTBAN_SERVICES_CONF="${NFTBAN_CONFIG_DIR}/conf.d/services.conf"
 48: NFTBAN_SERVICES_LOCAL="${NFTBAN_CONFIG_DIR}/conf.d/services.conf.local"
 49: 
 50: # Load services config
 51: _nftban_load_services_config() {
 52:     # Load base config
 53:     if [[ -f "$NFTBAN_SERVICES_CONF" ]]; then
 54:         # shellcheck source=/dev/null
 55:         source "$NFTBAN_SERVICES_CONF"
 56:     fi
 57: 
 58:     # Load local overrides
 59:     if [[ -f "$NFTBAN_SERVICES_LOCAL" ]]; then
 60:         # shellcheck source=/dev/null
 61:         source "$NFTBAN_SERVICES_LOCAL"
 62:     fi
 63: }
 64: 
 65: # =============================================================================
 66: # MASTER SWITCH FUNCTIONS
 67: # =============================================================================
 68: 
 69: # Check if NFTBan is globally enabled
 70: # Returns: 0 if enabled, 1 if disabled
 71: nftban_is_enabled() {
 72:     _nftban_load_services_config
 73: 
 74:     # Check kernel command line for emergency disable
 75:     if grep -q 'nftban=disabled' /proc/cmdline 2>/dev/null; then
 76:         return 1
 77:     fi
 78: 
 79:     # Check master switch
 80:     [[ "${NFTBAN_ENABLED:-true}" == "true" ]]
 81: }
 82: 
 83: # Check master switch and exit if disabled
 84: # Usage: nftban_check_enabled || exit 0
 85: nftban_check_enabled() {
 86:     if ! nftban_is_enabled; then
 87:         echo "NFTBan is disabled (NFTBAN_ENABLED=false or kernel parameter nftban=disabled)" >&2
 88:         return 1
 89:     fi
 90:     return 0
 91: }
 92: 
 93: # =============================================================================
 94: # SERVICE-SPECIFIC CHECKS
 95: # =============================================================================
 96: 
 97: # Check if a specific service is enabled in config
 98: # Usage: nftban_service_is_enabled "nftables"
 99: # Returns: 0 if enabled, 1 if disabled
100: nftban_service_is_enabled() {
101:     local service="$1"
102:     _nftban_load_services_config
103: 
104:     # Master switch overrides everything
105:     if ! nftban_is_enabled; then
106:         return 1
107:     fi
108: 
109:     case "$service" in
110:         nftables)
111:             [[ "${NFTABLES_ENABLED:-true}" == "true" ]]
112:             ;;
113:         suricata)
114:             [[ "${SURICATA_ENABLED:-true}" == "true" ]]
115:             ;;
116:         login|login_monitor)
117:             # Login uses its own config file
118:             local login_conf="${NFTBAN_CONFIG_DIR}/conf.d/login_alert.conf"
119:             local login_local="${NFTBAN_CONFIG_DIR}/conf.d/login_alert.conf.local"
120: 
121:             # Default to true, check configs
122:             local enabled="true"
123:             if [[ -f "$login_conf" ]]; then
124:                 # shellcheck source=/dev/null
125:                 source "$login_conf"
126:                 enabled="${NFTBAN_LOGIN_ALERT_ENABLED:-true}"
127:             fi
128:             if [[ -f "$login_local" ]]; then
129:                 # shellcheck source=/dev/null
130:                 source "$login_local"
131:                 enabled="${NFTBAN_LOGIN_ALERT_ENABLED:-$enabled}"
132:             fi
133:             [[ "$enabled" == "true" ]]
134:             ;;
135:         *)
136:             # Unknown service - assume enabled
137:             return 0
138:             ;;
139:     esac
140: }
141: 
142: # Check if auto-start is enabled for a service
143: # Usage: nftban_service_auto_start "nftables"
144: nftban_service_auto_start() {
145:     local service="$1"
146:     _nftban_load_services_config
147: 
148:     case "$service" in
149:         nftables)
150:             [[ "${NFTABLES_AUTO_START:-false}" == "true" ]]
151:             ;;
152:         suricata)
153:             [[ "${SURICATA_AUTO_START:-false}" == "true" ]]
154:             ;;
155:         *)
156:             return 1
157:             ;;
158:     esac
159: }
160: 
161: # =============================================================================
162: # SERVICE CONTROL FUNCTIONS
163: # =============================================================================
164: 
165: # Enable all NFTBan services
166: # Usage: nftban_enable_all
167: nftban_enable_all() {
168:     if [[ $EUID -ne 0 ]]; then
169:         echo "ERROR: Must be root to enable services" >&2
170:         return 1
171:     fi
172: 
173:     echo "Enabling all NFTBan services..."
174: 
175:     # Set master switch
176:     _nftban_set_config "NFTBAN_ENABLED" "true"
177: 
178:     # Enable systemd services
179:     local services=("nftban" "nftables")
180: 
181:     # Add suricata if installed
182:     if command -v suricata &>/dev/null; then
183:         services+=("suricata")
184:     fi
185: 
186:     for svc in "${services[@]}"; do
187:         if systemctl list-unit-files "${svc}.service" &>/dev/null; then
188:             echo "  Enabling ${svc}..."
189:             systemctl enable "${svc}.service" 2>/dev/null || true
190:             systemctl start "${svc}.service" 2>/dev/null || true
191:         fi
192:     done
193: 
194:     echo "All services enabled"
195:     return 0
196: }
197: 
198: # Disable all NFTBan services (emergency mode)
199: # Usage: nftban_disable_all
200: nftban_disable_all() {
201:     if [[ $EUID -ne 0 ]]; then
202:         echo "ERROR: Must be root to disable services" >&2
203:         return 1
204:     fi
205: 
206:     echo "EMERGENCY: Disabling all NFTBan services..."
207: 
208:     # Stop and disable systemd services
209:     local login_svc="${NFTBAN_SERVICE_LOGIN_MONITOR:-nftban-login-monitor.service}"
210:     local metrics_svc="${NFTBAN_SERVICE_METRICS_EXPORTER:-nftban-metrics-exporter.service}"
211:     local services=("${login_svc%.service}" "${metrics_svc%.service}" "nftban" "suricata")
212: 
213:     for svc in "${services[@]}"; do
214:         if systemctl list-unit-files "${svc}.service" &>/dev/null 2>&1; then
215:             echo "  Stopping ${svc}..."
216:             systemctl stop "${svc}.service" 2>/dev/null || true
217:             systemctl disable "${svc}.service" 2>/dev/null || true
218:         fi
219:     done
220: 
221:     # Set master switch to disabled
222:     _nftban_set_config "NFTBAN_ENABLED" "false"
223: 
224:     echo ""
225:     echo "All NFTBan services stopped and disabled."
226:     echo ""
227:     echo "To re-enable:"
228:     echo "  nftban enable"
229:     echo ""
230:     echo "Note: nftables service left running for manual firewall management"
231: 
232:     return 0
233: }
234: 
235: # Start a specific service if enabled
236: # Usage: nftban_service_start "suricata"
237: nftban_service_start() {
238:     local service="$1"
239: 
240:     if [[ $EUID -ne 0 ]]; then
241:         echo "ERROR: Must be root to start services" >&2
242:         return 1
243:     fi
244: 
245:     # Check if enabled first
246:     if ! nftban_service_is_enabled "$service"; then
247:         echo "Service '$service' is disabled in configuration" >&2
248:         return 1
249:     fi
250: 
251:     case "$service" in
252:         nftables)
253:             systemctl start nftables.service
254:             ;;
255:         suricata)
256:             systemctl start suricata.service
257:             ;;
258:         login|login_monitor)
259:             systemctl start "${NFTBAN_SERVICE_LOGIN_MONITOR:-nftban-login-monitor.service}"
260:             ;;
261:         nftban)
262:             systemctl start nftban.service
263:             ;;
264:         *)
265:             echo "Unknown service: $service" >&2
266:             return 1
267:             ;;
268:     esac
269: }
270: 
271: # Stop a specific service
272: # Usage: nftban_service_stop "suricata"
273: nftban_service_stop() {
274:     local service="$1"
275: 
276:     if [[ $EUID -ne 0 ]]; then
277:         echo "ERROR: Must be root to stop services" >&2
278:         return 1
279:     fi
280: 
281:     case "$service" in
282:         nftables)
283:             systemctl stop nftables.service
284:             ;;
285:         suricata)
286:             systemctl stop suricata.service
287:             ;;
288:         login|login_monitor)
289:             systemctl stop "${NFTBAN_SERVICE_LOGIN_MONITOR:-nftban-login-monitor.service}"
290:             ;;
291:         nftban)
292:             systemctl stop nftban.service
293:             ;;
294:         *)
295:             echo "Unknown service: $service" >&2
296:             return 1
297:             ;;
298:     esac
299: }
300: 
301: # =============================================================================
302: # STATUS FUNCTIONS
303: # =============================================================================
304: 
305: # Get status of all services
306: # Usage: nftban_services_status [--json]
307: nftban_services_status() {
308:     local json_mode="${1:-}"
309:     _nftban_load_services_config
310: 
311:     if [[ "$json_mode" == "--json" ]]; then
312:         _nftban_services_status_json
313:         return
314:     fi
315: 
316:     echo "NFTBan Service Status"
317:     echo "====================="

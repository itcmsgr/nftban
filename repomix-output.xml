 894: nftban_health_check_geoip() {
 895:     # Check GeoIP system (v0.7.3 unified architecture)
 896:     # - All GeoIP functionality in nftban-core (update, status, lookup)
 897:     # Returns: 0=OK, 1=Warning, 2=Error
 898: 
 899:     local status=$HEALTH_OK
 900:     local geoip_issues=()
 901: 
 902:     local nftban_core="${NFTBAN_LIB_DIR}/bin/nftban-core"
 903:     local db_path="${NFTBAN_DATA_DIR}/geoip/GeoLite2-City.mmdb"
 904: 
 905:     # Check nftban-core (REQUIRED CORE MODULE - handles country/feeds/geoip)
 906:     if [[ ! -x "$nftban_core" ]]; then
 907:         # Try fallback paths
 908:         nftban_core=$(command -v nftban-core 2>/dev/null || echo "")
 909:         if [[ -z "$nftban_core" ]]; then
 910:             geoip_issues+=("nftban-core binary NOT FOUND - REQUIRED core module")
 911:             geoip_issues+=("FIX: nftban-core must be installed and compiled (handles country/feeds/geoip)")
 912:             status=$HEALTH_ERROR
 913:             # Store and return immediately - no point checking database if core is missing
 914:             NFTBAN_HEALTH_ISSUES["geoip"]="${geoip_issues[*]}"
 915:             NFTBAN_HEALTH_ERRORS+=("nftban-core: ${geoip_issues[*]}")
 916:             NFTBAN_HEALTH_RESULTS["geoip"]=$status
 917:             return "$status"
 918:         fi
 919:     fi
 920: 
 921:     # Check database (nftban-core is installed, now check if GeoIP DB is downloaded)
 922:     if [[ ! -f "$db_path" ]]; then
 923:         geoip_issues+=("GeoIP database not downloaded")
 924:         geoip_issues+=("FIX: Run 'nftban geoip update' to download GeoLite2 database")
 925:         status=$HEALTH_ERROR
 926:     elif [[ ! -r "$db_path" ]]; then
 927:         geoip_issues+=("Database not readable: $db_path")
 928:         status=$HEALTH_WARNING
 929:     else
 930:         # Database exists - verify with nftban-core
 931:         if [[ -n "$nftban_core" && -x "$nftban_core" ]]; then
 932:             if ! "$nftban_core" geoip status >/dev/null 2>&1; then
 933:                 geoip_issues+=("Database verification failed")
 934:                 status=$HEALTH_WARNING
 935:             else
 936:                 # Performance test
 937:                 local start_time end_time elapsed
 938:                 start_time=$(date +%s%N)

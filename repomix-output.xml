 46: print_section() {
 47:     echo ""
 48:     echo -e "${BLUE}═══════════════════════════════════════════════════════════${NC}"
 49:     echo -e "${BLUE}  $1${NC}"
 50:     echo -e "${BLUE}═══════════════════════════════════════════════════════════${NC}"
 51: }
 52: 
 53: test_pass() {
 54:     ((TESTS_PASSED++))
 55:     echo -e "${GREEN}[✓ PASS]${NC} $1"
 56: }

322:         // Check if we have any data to display
323:         const bannedCountries = data.banned_countries || [];
324:         const blocksByCountry = data.blocks_by_country || data.by_country || {};
325: 
326:         if (bannedCountries.length > 0 || Object.keys(blocksByCountry).length > 0) {
327:             displayBannedCountries(bannedCountries);
328:             displayStats(blocksByCountry);
329:             displayChart(blocksByCountry);

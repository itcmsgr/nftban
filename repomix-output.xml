1166:     printf "  %-20s %s%% (min) / %s%% (max)\n" "Range..............." "$io_min" "$io_max"
1167:     printf "  %-20s %s%% (current: ${NFTBAN_WATCHDOG_IOWAIT_WARNING:-20}%%)\n" "Suggested Warning..." "$io_warn"

602: 
603:     # NFTBan main
604:     local nftban_status
605:     nftban_status=$(systemctl is-active nftban.service 2>/dev/null || echo "inactive")
606:     echo "  nftban:           $nftban_status"
607: 
608:     # Suricata
609:     if command -v suricata &>/dev/null; then
610:         local suri_status
611:         suri_status=$(systemctl is-active suricata.service 2>/dev/null || echo "inactive")
612:         echo "  suricata:         $suri_status"
613:     else
614:         echo "  suricata:         not installed"
615:     fi
616: 
617:     # Login monitor
618:     local login_status

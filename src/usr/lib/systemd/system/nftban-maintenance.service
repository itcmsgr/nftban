# =============================================================================
# NFTBan v0.30.0 - Maintenance Service (Always Active)
# =============================================================================
# SPDX-License-Identifier: MPL-2.0
# Purpose: Critical maintenance tasks that run even when NFTBan is disabled
#
# This service performs safety-critical checks:
#   - SSH port monitoring (prevents lockout)
#   - System IP monitoring (updates whitelists)
#   - Autoheal (fixes permissions, creates directories)
#   - Configuration validation
#
# Runs every 15 minutes via nftban-maintenance.timer
# =============================================================================

[Unit]
Description=NFTBan Maintenance Service (Safety Checks)
Documentation=https://nftban.com/docs/maintenance
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root

# Run maintenance script
ExecStart=/usr/lib/nftban/cron/maintenance.sh

# Security hardening
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/nftban /var/log/nftban /var/cache/nftban /etc/nftban /run/nftban
NoNewPrivileges=false
ProtectHome=true
RestrictSUIDSGID=true

# Resource limits
CPUQuota=50%
MemoryMax=256M
TasksMax=20

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nftban-maintenance

# Restart on failure
Restart=on-failure
RestartSec=5min

456:     // Create new chart
457:     geobanChart = new Chart(ctx, {
458:         type: 'bar',
459:         data: {
460:             labels: labels,
461:             datasets: [{
462:                 label: 'Blocked Connections',
463:                 data: dataValues,
464:                 backgroundColor: 'rgba(239, 68, 68, 0.7)',
465:                 borderColor: 'rgba(239, 68, 68, 1)',
466:                 borderWidth: 2
467:             }]
468:         },
469:         options: {
470:             responsive: true,
471:             maintainAspectRatio: false,
472:             plugins: {
473:                 legend: {
474:                     display: false
475:                 },
476:                 title: {
477:                     display: true,
478:                     text: 'Top 10 Blocked Countries',
479:                     color: '#fff',
480:                     font: { size: 14 }
481:                 }
482:             },
483:             scales: {
484:                 y: {
485:                     beginAtZero: true,
486:                     ticks: { color: '#9ca3af' },
487:                     grid: { color: 'rgba(255, 255, 255, 0.1)' }
488:                 },
489:                 x: {
490:                     ticks: {
491:                         color: '#9ca3af',
492:                         maxRotation: 45,
493:                         minRotation: 45
494:                     },
495:                     grid: { display: false }
496:                 }
497:             }
498:         }
499:     });
500: }

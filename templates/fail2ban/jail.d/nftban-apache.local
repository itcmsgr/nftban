# nftban-managed: yes
# nftban-templates-version: 1

[nftban-apache]
enabled   = @@NFTBAN_F2B_APACHE_JAIL@@
filter    = apache-auth
backend   = auto
port      = http,https
logpath   = @@NFTBAN_F2B_APACHE_LOG@@
maxretry  = @@NFTBAN_F2B_APACHE_MAX_RETRY@@
findtime  = @@NFTBAN_F2B_APACHE_FIND_TIME@@
bantime   = @@NFTBAN_F2B_APACHE_BAN_TIME@@

# inherits banaction = nftban-global from 00-nftban.conf

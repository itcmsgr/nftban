  1: package safety
  2: 
  3: import (
  4: 	"fmt"
  5: 	"net"
  6: 	"os"
  7: 	"os/exec"
  8: 	"strings"
  9: )
 10: 
 11: // SystemIPs holds all critical IPs that must NEVER be blocked
 12: type SystemIPs struct {
 13: 	ServerIPs     []net.IP     // All server interface IPs
 14: 	CurrentUserIP net.IP       // IP of current SSH connection
 15: 	GatewayIPs    []net.IP     // Default gateway
 16: 	DNSServers    []net.IP     // DNS servers from /etc/resolv.conf
 17: 	LoopbackCIDRs []net.IPNet  // 127.0.0.0/8, ::1/128
 18: }
 19: 
 20: // DetectSystemIPs auto-detects all critical IPs that must be whitelisted
 21: func DetectSystemIPs() (*SystemIPs, error) {
 22: 	sys := &SystemIPs{}
 23: 
 24: 	// 1. Detect all server IPs (all interfaces)
 25: 	serverIPs, err := detectServerIPs()
 26: 	if err != nil {
 27: 		return nil, fmt.Errorf("failed to detect server IPs: %w", err)
 28: 	}
 29: 	sys.ServerIPs = serverIPs
 30: 
 31: 	// 2. Detect current user's SSH connection IP (CRITICAL!)
 32: 	userIP, err := detectCurrentUserIP()
 33: 	if err != nil {
 34: 		fmt.Fprintf(os.Stderr, "WARNING: Could not detect current user IP: %v\n", err)
 35: 		// Don't fail - just warn
 36: 	} else {
 37: 		sys.CurrentUserIP = userIP
 38: 	}
 39: 
 40: 	// 3. Detect gateway IPs
 41: 	gatewayIPs, err := detectGatewayIPs()
 42: 	if err != nil {
 43: 		fmt.Fprintf(os.Stderr, "WARNING: Could not detect gateway IPs: %v\n", err)
 44: 	} else {
 45: 		sys.GatewayIPs = gatewayIPs
 46: 	}
 47: 
 48: 	// 4. Detect DNS servers
 49: 	dnsIPs, err := detectDNSServers()
 50: 	if err != nil {
 51: 		fmt.Fprintf(os.Stderr, "WARNING: Could not detect DNS servers: %v\n", err)
 52: 	} else {
 53: 		sys.DNSServers = dnsIPs
 54: 	}
 55: 
 56: 	// 5. Add loopback ranges (always whitelist!)
 57: 	sys.LoopbackCIDRs = []net.IPNet{
 58: 		{IP: net.IPv4(127, 0, 0, 0), Mask: net.CIDRMask(8, 32)},  // 127.0.0.0/8
 59: 		{IP: net.ParseIP("::1"), Mask: net.CIDRMask(128, 128)},   // ::1/128
 60: 	}
 61: 
 62: 	return sys, nil
 63: }
 64: 
 65: // detectServerIPs gets all IPs from all network interfaces
 66: func detectServerIPs() ([]net.IP, error) {
 67: 	var ips []net.IP
 68: 
 69: 	ifaces, err := net.Interfaces()
 70: 	if err != nil {
 71: 		return nil, err
 72: 	}
 73: 
 74: 	for _, iface := range ifaces {
 75: 		// Skip loopback
 76: 		if iface.Flags&net.FlagLoopback != 0 {
 77: 			continue
 78: 		}
 79: 
 80: 		// Skip down interfaces
 81: 		if iface.Flags&net.FlagUp == 0 {
 82: 			continue
 83: 		}
 84: 
 85: 		addrs, err := iface.Addrs()
 86: 		if err != nil {
 87: 			continue
 88: 		}
 89: 
 90: 		for _, addr := range addrs {
 91: 			var ip net.IP
 92: 			switch v := addr.(type) {
 93: 			case *net.IPNet:
 94: 				ip = v.IP
 95: 			case *net.IPAddr:
 96: 				ip = v.IP
 97: 			}
 98: 
 99: 			if ip != nil && !ip.IsLoopback() {
100: 				ips = append(ips, ip)
101: 			}
102: 		}
103: 	}
104: 
105: 	return ips, nil
106: }
107: 
108: // detectCurrentUserIP detects the IP of the current SSH connection
109: func detectCurrentUserIP() (net.IP, error) {
110: 	// Method 1: Check SSH_CONNECTION environment variable
111: 	sshConn := os.Getenv("SSH_CONNECTION")
112: 	if sshConn != "" {
113: 		// Format: "client_ip client_port server_ip server_port"
114: 		parts := strings.Fields(sshConn)
115: 		if len(parts) >= 1 {
116: 			ip := net.ParseIP(parts[0])
117: 			if ip != nil {
118: 				return ip, nil
119: 			}
120: 		}
121: 	}
122: 
123: 	// Method 2: Check SSH_CLIENT environment variable
124: 	sshClient := os.Getenv("SSH_CLIENT")
125: 	if sshClient != "" {
126: 		// Format: "client_ip client_port server_port"
127: 		parts := strings.Fields(sshClient)
128: 		if len(parts) >= 1 {
129: 			ip := net.ParseIP(parts[0])
130: 			if ip != nil {
131: 				return ip, nil
132: 			}
133: 		}
134: 	}
135: 
136: 	// Method 3: Parse output of 'who' command
137: 	cmd := exec.Command("who", "-u")
138: 	output, err := cmd.Output()
139: 	if err == nil {
140: 		lines := strings.Split(string(output), "\n")
141: 		for _, line := range lines {
142: 			// Look for IP in parentheses: username pts/0 2024-11-26 10:30 (1.2.3.4)
143: 			if strings.Contains(line, "(") && strings.Contains(line, ")") {
144: 				start := strings.Index(line, "(")
145: 				end := strings.Index(line, ")")
146: 				if start < end {
147: 					ipStr := line[start+1 : end]
148: 					ip := net.ParseIP(ipStr)
149: 					if ip != nil {
150: 						return ip, nil
151: 					}
152: 				}
153: 			}
154: 		}
155: 	}
156: 
157: 	// Method 4: Parse output of 'w' command
158: 	cmd = exec.Command("w", "-h")
159: 	output, err = cmd.Output()
160: 	if err == nil {
161: 		lines := strings.Split(string(output), "\n")
162: 		for _, line := range lines {
163: 			fields := strings.Fields(line)
164: 			if len(fields) >= 3 {
165: 				// Third field is usually the FROM field (IP or hostname)
166: 				ipStr := fields[2]
167: 				ip := net.ParseIP(ipStr)
168: 				if ip != nil {
169: 					return ip, nil
170: 				}
171: 			}
172: 		}
173: 	}
174: 
175: 	return nil, fmt.Errorf("could not detect current user IP")
176: }
177: 
178: // detectGatewayIPs gets default gateway IPs
179: func detectGatewayIPs() ([]net.IP, error) {
180: 	var ips []net.IP
181: 
182: 	// Method 1: Parse 'ip route' output
183: 	cmd := exec.Command("ip", "route", "show", "default")
184: 	output, err := cmd.Output()
185: 	if err != nil {
186: 		return nil, err
187: 	}
188: 
189: 	// Output format: "default via 192.168.1.1 dev eth0"
190: 	lines := strings.Split(string(output), "\n")
191: 	for _, line := range lines {
192: 		if strings.Contains(line, "via") {
193: 			parts := strings.Fields(line)
194: 			for i, part := range parts {
195: 				if part == "via" && i+1 < len(parts) {
196: 					ip := net.ParseIP(parts[i+1])
197: 					if ip != nil {
198: 						ips = append(ips, ip)
199: 					}
200: 				}
201: 			}
202: 		}
203: 	}
204: 
205: 	return ips, nil
206: }
207: 
208: // detectDNSServers gets DNS server IPs from /etc/resolv.conf
209: func detectDNSServers() ([]net.IP, error) {
210: 	var ips []net.IP
211: 
212: 	data, err := os.ReadFile("/etc/resolv.conf")
213: 	if err != nil {
214: 		return nil, err
215: 	}
216: 
217: 	lines := strings.Split(string(data), "\n")
218: 	for _, line := range lines {
219: 		line = strings.TrimSpace(line)
220: 		if strings.HasPrefix(line, "nameserver") {
221: 			parts := strings.Fields(line)
222: 			if len(parts) >= 2 {
223: 				ip := net.ParseIP(parts[1])
224: 				if ip != nil && !ip.IsLoopback() {
225: 					ips = append(ips, ip)
226: 				}
227: 			}
228: 		}
229: 	}
230: 
231: 	return ips, nil
232: }
233: 
234: // PrintSystemIPs displays all detected IPs
235: func (s *SystemIPs) PrintSystemIPs() {
236: 	fmt.Println("🛡️  CRITICAL IPs DETECTED (WILL BE AUTO-WHITELISTED):")
237: 	fmt.Println()
238: 
239: 	if len(s.ServerIPs) > 0 {
240: 		fmt.Println("Server IPs:")
241: 		for _, ip := range s.ServerIPs {
242: 			fmt.Printf("  ✅ %s (server interface)\n", ip)
243: 		}
244: 		fmt.Println()
245: 	}
246: 
247: 	if s.CurrentUserIP != nil {
248: 		fmt.Println("⚠️  YOUR CURRENT CONNECTION IP:")
249: 		fmt.Printf("  ✅ %s (YOU - SSH connection)\n", s.CurrentUserIP)
250: 		fmt.Println()
251: 		fmt.Println("  ⚠️  THIS IP WILL BE WHITELISTED TO PREVENT LOCKOUT!")
252: 		fmt.Println()
253: 	}
254: 
255: 	if len(s.GatewayIPs) > 0 {
256: 		fmt.Println("Gateway IPs:")
257: 		for _, ip := range s.GatewayIPs {
258: 			fmt.Printf("  ✅ %s (gateway/router)\n", ip)
259: 		}
260: 		fmt.Println()
261: 	}
262: 
263: 	if len(s.DNSServers) > 0 {
264: 		fmt.Println("DNS Servers:")
265: 		for _, ip := range s.DNSServers {
266: 			fmt.Printf("  ✅ %s (DNS)\n", ip)
267: 		}
268: 		fmt.Println()
269: 	}
270: 
271: 	fmt.Println("Loopback Ranges:")
272: 	for _, cidr := range s.LoopbackCIDRs {
273: 		fmt.Printf("  ✅ %s (localhost)\n", cidr.String())
274: 	}
275: 	fmt.Println()
276: }
277: 
278: // GetAllIPs returns all IPs as a flat list
279: func (s *SystemIPs) GetAllIPs() []net.IP {
280: 	var all []net.IP
281: 	all = append(all, s.ServerIPs...)
282: 	if s.CurrentUserIP != nil {
283: 		all = append(all, s.CurrentUserIP)
284: 	}
285: 	all = append(all, s.GatewayIPs...)
286: 	all = append(all, s.DNSServers...)
287: 	return all
288: }
289: 
290: // GetAllIPsWithCIDRs returns all IPs including loopback CIDRs
291: func (s *SystemIPs) GetAllIPsWithCIDRs() ([]net.IP, []net.IPNet) {
292: 	ips := s.GetAllIPs()
293: 	cidrs := s.LoopbackCIDRs
294: 	return ips, cidrs
295: }

<file path="cli/lib/nftban/core/nftban_report_services.sh">
  1: #!/usr/bin/env bash
  2: 
  3: # =============================================================================
  4: # NFTBan v1.0 - Services Report Core Module
  5: # =============================================================================
  6: # SPDX-License-Identifier: MPL-2.0
  7: # Purpose: System services status scanning and reporting
  8: #
  9: # meta:name=nftban_report_services
 10: # meta:type=core
 11: # meta:header=Services Report Core
 12: # meta:version=1.0.0
 13: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 14: # meta:homepage=https://nftban.com
 15: #
 16: # **Description & Purpose**
 17: # meta:description=Scans and reports status of all required system services
 18: # meta:input=Service check options, output format
 19: # meta:output=Service status reports (terminal, HTML, mail)
 20: #
 21: # **Inventory & Requirements**
 22: # meta:depends=bash,systemctl
 23: #
 24: # meta:created_date=2025-11-05
 25: # meta:updated_date=2025-11-24
 26: # =============================================================================
 27: 
 28: # Strict mode
 29: IFS=$'\n\t'
 30: umask 027
 31: 
 32: # Load main configuration (service names, paths)
 33: if [[ -f "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf" ]]; then
 34:     source "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf"
 35: fi
 36: 
 37: # =============================================================================
 38: # GLOBALS
 39: # =============================================================================
 40: 
 41: declare -g -A NFTBAN_SERVICE_STATUS=()  # key: service_name -> "status|version|required|notes"
 42: declare -g NFTBAN_SERVICE_TIMESTAMP
 43: NFTBAN_SERVICE_TIMESTAMP="$(date --iso-8601=seconds)"
 44: declare -g NFTBAN_SERVICE_OUTPUT_FORMAT="${NFTBAN_SERVICE_OUTPUT_FORMAT:-table}"
 45: 
 46: # Color symbols
 47: NFTBAN_SERVICE_SYM_OK="✔"  # shellcheck disable=SC2034  # Symbols for UI rendering
 48: NFTBAN_SERVICE_SYM_KO="✖"  # shellcheck disable=SC2034  # Symbols for UI rendering
 49: NFTBAN_SERVICE_SYM_WARN="⚠"  # shellcheck disable=SC2034  # Symbols for UI rendering
 50: C_RESET="\e[0m"
 51: C_RED="\e[31m"
 52: C_GREEN="\e[32m"
 53: C_YELLOW="\e[33m"
 54: C_CYAN="\e[36m"
 55: C_BOLD="\e[1m"
 56: 
 57: # =============================================================================
 58: # SERVICE SCANNING
 59: # =============================================================================
 60: 
 61: #
 62: # nftban_services_scan - Scan all required services
 63: #
 64: # Checks:
 65: #   - nftables (systemd service)
 66: #   - suricata (systemd service - IDS)
 67: #   - nftban-suricata (systemd service - integration daemon)
 68: #   - golang (binary)
 69: #   - mailx (binary)
 70: #   - curl (binary)
 71: #   - jq (binary)
 72: #
 73: nftban_services_scan() {
 74:     # Clear previous scan
 75:     NFTBAN_SERVICE_STATUS=()
 76: 
 77:     # ==========================================================================
 78:     # SYSTEMD SERVICES
 79:     # ==========================================================================
 80: 
 81:     # nftables
 82:     local nft_status="NOT_FOUND"
 83:     local nft_version="n/a"
 84:     local nft_notes=""
 85: 
 86:     if command -v systemctl &>/dev/null && systemctl list-unit-files nftables.service &>/dev/null 2>&1; then
 87:         if systemctl is-active nftables.service &>/dev/null 2>&1; then
 88:             nft_status="RUNNING"
 89:         elif systemctl is-enabled nftables.service &>/dev/null 2>&1; then
 90:             nft_status="ENABLED"
 91:         else
 92:             nft_status="STOPPED"
 93:         fi
 94: 
 95:         if command -v nft &>/dev/null; then
 96:             nft_version=$(nft --version 2>&1 | head -1 | awk '{print $2}' || echo "unknown")
 97:         fi
 98:         nft_notes="Netfilter tables firewall"
 99:     else
100:         nft_notes="Service not found or systemd not available"
101:     fi
102: 
103:     NFTBAN_SERVICE_STATUS["nftables"]="${nft_status}|${nft_version}|required|${nft_notes}"
104: 
105:     # suricata (IDS - replaces fail2ban in v1.0)
106:     local suricata_status="NOT_FOUND"
107:     local suricata_version="n/a"
108:     local suricata_notes=""
109: 
110:     if command -v systemctl &>/dev/null && systemctl list-unit-files suricata.service &>/dev/null 2>&1; then
111:         if systemctl is-active suricata.service &>/dev/null 2>&1; then
112:             suricata_status="RUNNING"
113:         elif systemctl is-enabled suricata.service &>/dev/null 2>&1; then
114:             suricata_status="ENABLED"
115:         else
116:             suricata_status="STOPPED"
117:         fi
118: 
119:         if command -v suricata &>/dev/null; then
120:             suricata_version=$(suricata --build-info 2>&1 | grep -oP 'This is Suricata version \K[0-9.]+' | head -1 || echo "unknown")
121:         fi
122:         suricata_notes="Suricata IDS (Network threat detection)"
123:     else
124:         suricata_notes="Service not found"
125:     fi
126: 
127:     NFTBAN_SERVICE_STATUS["suricata"]="${suricata_status}|${suricata_version}|required|${suricata_notes}"
128: 
129:     # nftban-suricata (NFTBan Suricata integration daemon)
130:     local nft_suricata_status="NOT_FOUND"
131:     local nft_suricata_version="n/a"
132:     local nft_suricata_notes=""
133: 
134:     local nftban_suricata_svc="${NFTBAN_SERVICE_SURICATA:-nftban-suricata.service}"
135:     if command -v systemctl &>/dev/null && systemctl list-unit-files "$nftban_suricata_svc" &>/dev/null 2>&1; then
136:         if systemctl is-active "$nftban_suricata_svc" &>/dev/null 2>&1; then
137:             nft_suricata_status="RUNNING"
138:         elif systemctl is-enabled "$nftban_suricata_svc" &>/dev/null 2>&1; then
139:             nft_suricata_status="ENABLED"
140:         else
141:             nft_suricata_status="STOPPED"
142:         fi
143:         nft_suricata_notes="NFTBan Suricata integration daemon"
144:     else
145:         nft_suricata_notes="Service not found"
146:     fi
147: 
148:     NFTBAN_SERVICE_STATUS["nftban-suricata"]="${nft_suricata_status}|${nft_suricata_version}|required|${nft_suricata_notes}"
149: 
150:     # ==========================================================================
151:     # BINARY DEPENDENCIES
152:     # ==========================================================================
153: 
154:     # GeoIP Database (required for country blocking and IP geolocation)
155:     local geoip_status="NOT_FOUND"
156:     local geoip_version="n/a"
157:     local geoip_notes=""
158:     local geoip_db="${NFTBAN_DATA_DIR:-/var/lib/nftban}/geoip/GeoLite2-City.mmdb"
159: 
160:     # Check if GeoIP database exists
161:     if [[ -f "$geoip_db" ]]; then
162:         geoip_status="INSTALLED"
163:         # Get database modification date as version
164:         geoip_version=$(stat -c '%Y' "$geoip_db" 2>/dev/null | xargs -I{} date -d @{} '+%Y-%m-%d' 2>/dev/null || echo "unknown")
165:         local db_size
166:         db_size=$(du -h "$geoip_db" 2>/dev/null | awk '{print $1}')
167:         geoip_notes="GeoLite2-City database ($db_size)"
168:     else
169:         # Check for alternative database locations
170:         local alt_db=""
171:         for db_path in /usr/share/GeoIP/*.mmdb /var/lib/GeoIP/*.mmdb; do
172:             [[ -f "$db_path" ]] && alt_db="$db_path" && break
173:         done
174:         if [[ -n "$alt_db" ]]; then
175:             geoip_status="INSTALLED"
176:             geoip_notes="Found at $alt_db"
177:         else
178:             geoip_notes="Database not found - run: nftban geoip download"
179:         fi
180:     fi
181: 
182:     NFTBAN_SERVICE_STATUS["geoip-database"]="${geoip_status}|${geoip_version}|required|${geoip_notes}"
183: 
184:     # mailx/mail
185:     local mail_status="NOT_FOUND"
186:     local mail_version="n/a"
187:     local mail_notes=""
188: 
189:     if command -v mailx &>/dev/null; then
190:         mail_status="INSTALLED"
191:         mail_version=$(mailx -V 2>&1 | head -1 | awk '{print $2}' || echo "unknown")
192:         mail_notes="Email notifications"
193:     elif command -v mail &>/dev/null; then
194:         mail_status="INSTALLED"
195:         mail_version=$(mail -V 2>&1 | head -1 | awk '{print $2}' || echo "unknown")
196:         mail_notes="Email notifications (mail)"
197:     else
198:         mail_notes="Not installed (email features disabled)"
199:     fi
200: 
201:     NFTBAN_SERVICE_STATUS["mailx"]="${mail_status}|${mail_version}|optional|${mail_notes}"
202: 
203:     # curl
204:     local curl_status="NOT_FOUND"
205:     local curl_version="n/a"
206:     local curl_notes=""
207: 
208:     if command -v curl &>/dev/null; then
209:         curl_status="INSTALLED"
210:         curl_version=$(curl --version 2>&1 | head -1 | awk '{print $2}' || echo "unknown")
211:         curl_notes="Feed downloads and API calls"
212:     else
213:         curl_notes="Not installed (feed features disabled)"
214:     fi
215: 
216:     NFTBAN_SERVICE_STATUS["curl"]="${curl_status}|${curl_version}|required|${curl_notes}"
217: 
218:     # jq
219:     local jq_status="NOT_FOUND"
220:     local jq_version="n/a"
221:     local jq_notes=""
222: 
223:     if command -v jq &>/dev/null; then
224:         jq_status="INSTALLED"
225:         jq_version=$(jq --version 2>&1 | sed 's/jq-//' || echo "unknown")
226:         jq_notes="JSON processing"
227:     else
228:         jq_notes="Not installed (some features limited)"
229:     fi
230: 
231:     NFTBAN_SERVICE_STATUS["jq"]="${jq_status}|${jq_version}|optional|${jq_notes}"
232: }
233: 
234: # =============================================================================
235: # OUTPUT FORMATTERS
236: # =============================================================================
237: 
238: #
239: # nftban_services_report_table - Terminal table output
240: #
241: nftban_services_report_table() {
242:     local timestamp="$1"  # shellcheck disable=SC2034  # Reserved for timestamp formatting
243:     local short_ts
244:     short_ts=$(date +"%Y-%m-%d %H:%M")
245: 
246:     echo ""
247:     echo "╔════════════════════════════════════════════════════════╗"
248:     printf "║  NFTBan Services                %-12s    ║\n" "$short_ts"
249:     echo "╚════════════════════════════════════════════════════════╝"
250:     echo ""
251: 
252:     # Header
253:     printf "%-20s %-15s %-12s\n" \
254:         "SERVICE" "STATUS" "VERSION"
255:     echo "────────────────────────────────────────────────────────"
256: 
257:     # Count statistics
258:     local running_services=0
259:     local stopped_services=0
260:     local missing_services=0
261:     local installed_bins=0
262:     local missing_bins=0
263: 
264:     # Sort services: systemd first, then binaries
265:     local sorted_keys=()
266: 
267:     # Add systemd services first
268:     for key in "${!NFTBAN_SERVICE_STATUS[@]}"; do
269:         if [[ "$key" == "nftables" || "$key" == "suricata" ]]; then
270:             sorted_keys+=("$key")
271:         fi
272:     done
273: 
274:     # Add binaries
275:     for key in "${!NFTBAN_SERVICE_STATUS[@]}"; do
276:         if [[ "$key" != "nftables" && "$key" != "suricata" && "$key" != "nftban-suricata" ]]; then
277:             sorted_keys+=("$key")
278:         fi
279:     done
280: 
281:     # Print each service
282:     for service_name in "${sorted_keys[@]}"; do
283:         local info="${NFTBAN_SERVICE_STATUS[$service_name]}"
284:         IFS='|' read -r status version required notes <<< "$info"
285: 
286:         # Determine status display with icon
287:         local status_display=""  # shellcheck disable=SC2034  # Reserved for formatted status
288: 
289:         case "$status" in
290:             RUNNING)
291:                 printf "%-20s ${C_GREEN}%-15s${C_RESET} %-12s\n" "$service_name" "✓ Running" "$version"
292:                 running_services=$((running_services + 1))
293:                 ;;
294:             ENABLED)
295:                 printf "%-20s ${C_YELLOW}%-15s${C_RESET} %-12s\n" "$service_name" "⚠ Enabled" "$version"
296:                 stopped_services=$((stopped_services + 1))
297:                 ;;
298:             STOPPED)
299:                 printf "%-20s ${C_RED}%-15s${C_RESET} %-12s\n" "$service_name" "− Stopped" "$version"
300:                 stopped_services=$((stopped_services + 1))
301:                 ;;
302:             INSTALLED)
303:                 printf "%-20s ${C_GREEN}%-15s${C_RESET} %-12s\n" "$service_name" "✓ Installed" "$version"
304:                 installed_bins=$((installed_bins + 1))
305:                 ;;
306:             NOT_FOUND)
307:                 printf "%-20s ${C_RED}%-15s${C_RESET} %-12s\n" "$service_name" "✖ Missing" "$version"
308:                 if [[ "$service_name" == "nftables" || "$service_name" == "suricata" ]]; then
309:                     missing_services=$((missing_services + 1))
310:                 else
311:                     missing_bins=$((missing_bins + 1))
312:                 fi
313:                 ;;
314:             *)
315:                 printf "%-20s %-15s %-12s\n" "$service_name" "? Unknown" "$version"
316:                 ;;
317:         esac
318:     done
319: 
320:     echo ""
321: 
322:     # Summary
323:     local total_services
324:     total_services=$((running_services + stopped_services + missing_services))
325:     local total_bins
326:     total_bins=$((installed_bins + missing_bins))
327: 
328:     echo "Systemd Services: ${total_services} total | ${running_services} running | ${stopped_services} stopped | ${missing_services} missing"
329:     echo "Binary Tools: ${total_bins} total | ${installed_bins} installed | ${missing_bins} missing"
330:     echo ""
331: 
332:     # Status message
333:     if [[ $missing_services -gt 0 ]] || [[ $stopped_services -gt 0 ]]; then
334:         echo "⚠ Some required services are not running. Run 'nftban services fix' to auto-start."
335:     elif [[ $missing_bins -gt 0 ]]; then
336:         echo "⚠ Some optional tools are missing. Some features may be disabled."
337:     else
338:         echo "✅ All services operational!"
339:     fi
340:     echo ""
341: }
342: 
343: #
344: # nftban_services_report_compact - Compact one-line status
345: #
346: nftban_services_report_compact() {
347:     local running=0
348:     local total=0
349: 
350:     for service_name in "${!NFTBAN_SERVICE_STATUS[@]}"; do
351:         if [[ "$service_name" == "nftables" || "$service_name" == "suricata" || "$service_name" == "nftban-suricata" ]]; then
352:             total=$((total + 1))
353:             local info="${NFTBAN_SERVICE_STATUS[$service_name]}"
354:             local status="${info%%|*}"
355:             [[ "$status" == "RUNNING" ]] && running=$((running + 1))
356:         fi
357:     done
358: 
359:     echo "Services: ${running}/${total} running"
360: }
361: 
362: # =============================================================================
363: # MAIN REPORT FUNCTION
364: # =============================================================================
365: 
366: #
367: # nftban_report_services - Main entry point
368: #
369: # Arguments:
370: #   $1 - Output format (table|compact|json|html)
371: #
372: nftban_report_services() {
373:     local output_format="${1:-table}"
374: 
375:     # Scan all services
376:     nftban_services_scan
377: 
378:     # Generate report based on format
379:     case "$output_format" in
380:         table|terminal|detailed)
381:             nftban_services_report_table "$NFTBAN_SERVICE_TIMESTAMP"
382:             ;;
383:         compact|summary)
384:             nftban_services_report_summary
385:             ;;
386:         json)
387:             nftban_services_report_json
388:             ;;
389:         *)
390:             nftban_services_report_table "$NFTBAN_SERVICE_TIMESTAMP"
391:             ;;
392:     esac
393: }
394: 
395: nftban_services_report_summary() {
396:     # Generate one-line summary of services status
397:     # Output: "Services: 2/2 running, 4/4 tools"
398:     # Returns: 0=OK, 1=Warning, 2=Error
399: 
400:     # Services already scanned by caller
401: 
402:     local total_systemd=0
403:     local running_systemd=0
404:     local total_binaries=0
405:     local installed_binaries=0
406:     local errors=0
407: 
408:     # Count systemd services
409:     for svc in "${NFTBAN_SERVICE_SYSTEMD[@]}"; do
410:         total_systemd=$((total_systemd + 1))
411:         local status_line="${NFTBAN_SERVICE_STATUS[$svc]:-}"
412:         local status="${status_line%%|*}"
413:         if [[ "$status" == "RUNNING" ]]; then
414:             running_systemd=$((running_systemd + 1))
415:         elif [[ "$status" =~ ERROR|MISSING ]]; then
416:             errors=$((errors + 1))
417:         fi
418:     done
419: 
420:     # Count binary tools
421:     for bin in "${NFTBAN_SERVICE_BINARIES[@]}"; do
422:         total_binaries=$((total_binaries + 1))
423:         local status_line="${NFTBAN_SERVICE_STATUS[$bin]:-}"
424:         local status="${status_line%%|*}"
425:         if [[ "$status" == "INSTALLED" ]]; then
426:             installed_binaries=$((installed_binaries + 1))
427:         fi
428:     done
429: 
430:     # Output summary
431:     if [[ $errors -eq 0 && $running_systemd -eq $total_systemd ]]; then
432:         echo "Services: $running_systemd/$total_systemd running, $installed_binaries/$total_binaries tools"
433:         return 0
434:     elif [[ $errors -eq 0 ]]; then
435:         echo "Services: $running_systemd/$total_systemd running ($(($total_systemd - $running_systemd)) stopped), $installed_binaries/$total_binaries tools"
436:         return 1  # Warning - services stopped
437:     else
438:         echo "Services: $errors errors, $running_systemd/$total_systemd running, $installed_binaries/$total_binaries tools"
439:         return 2  # Error - missing/broken services
440:     fi
441: }
442: 
443: nftban_services_report_json() {
444:     # Generate JSON output of services status
445:     # Output: JSON object with services data
446: 
447:     # Services already scanned by caller
448: 
449:     echo "{"
450:     echo "  \"timestamp\": \"$NFTBAN_SERVICE_TIMESTAMP\","
451:     echo "  \"systemd\": {"
452:     echo "    \"services\": ["
453: 
454:     # Output systemd services
455:     local first=true
456:     for svc in "${NFTBAN_SERVICE_SYSTEMD[@]}"; do
457:         local status_line="${NFTBAN_SERVICE_STATUS[$svc]:-}"
458:         IFS='|' read -r status version required notes <<< "$status_line"
459: 
460:         if [[ "$first" == "true" ]]; then
461:             first=false
462:         else
463:             echo ","
464:         fi
465: 
466:         echo "      {"
467:         echo "        \"name\": \"$svc\","
468:         echo "        \"status\": \"$status\","
469:         echo "        \"version\": \"$version\","
470:         echo "        \"required\": \"$required\","
471:         echo "        \"notes\": \"$notes\""
472:         echo -n "      }"
473:     done
474: 
475:     echo ""
476:     echo "    ]"
477:     echo "  },"
478:     echo "  \"binaries\": {"
479:     echo "    \"tools\": ["
480: 
481:     # Output binary tools
482:     first=true
483:     for bin in "${NFTBAN_SERVICE_BINARIES[@]}"; do
484:         local status_line="${NFTBAN_SERVICE_STATUS[$bin]:-}"
485:         IFS='|' read -r status version required notes <<< "$status_line"
486: 
487:         if [[ "$first" == "true" ]]; then
488:             first=false
489:         else
490:             echo ","
491:         fi
492: 
493:         echo "      {"
494:         echo "        \"name\": \"$bin\","
495:         echo "        \"status\": \"$status\","
496:         echo "        \"version\": \"$version\","
497:         echo "        \"required\": \"$required\","
498:         echo "        \"notes\": \"$notes\""
499:         echo -n "      }"
500:     done
501: 
502:     echo ""
503:     echo "    ]"
504:     echo "  }"
505:     echo "}"
506: 
507:     return 0
508: }
509: 
510: # =============================================================================
511: # EXPORT FUNCTIONS
512: # =============================================================================
513: 
514: # Make functions available to sourcing scripts
515: export -f nftban_services_scan
516: export -f nftban_services_report_table
517: export -f nftban_services_report_compact
518: export -f nftban_services_report_summary
519: export -f nftban_services_report_json
520: export -f nftban_report_services
</file>

<file path="cli/lib/nftban/core/nftban_stats.sh">
   1: #!/usr/bin/env bash
   2: # =============================================================================
   3: # NFTBan v1.0.0 - Statistics & Metrics Core Engine
   4: # =============================================================================
   5: # SPDX-License-Identifier: MPL-2.0
   6: # Purpose: Comprehensive statistics collection, analysis, and reporting
   7: #
   8: # meta:name=nftban_stats
   9: # meta:type=core
  10: # meta:header=Statistics & Metrics Engine
  11: # meta:version=1.0.0
  12: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
  13: # meta:homepage=https://nftban.com
  14: #
  15: # **Description & Purpose**
  16: # meta:description=Production-grade stats engine with real-time metrics and analytics

 884:     if type -t nftban_print_status >/dev/null 2>&1; then
 885:         nftban_print_status "success" "Exported ${count} records to: $output_file"
 886:     else
 887:         echo "[SUCCESS] Exported ${count} records to: $output_file"
 888:     fi
 889: 
 890:     echo "$output_file"
 891: }

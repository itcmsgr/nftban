166: # =============================================================================
167: # NEW: VALIDATION FUNCTIONS (INFORMATIONAL ONLY)
168: # =============================================================================
169: 
170: nftban_module_validate_metadata() {
171:     # Validate module metadata completeness (INFORMATIONAL ONLY)
172:     # Returns: Report of modules with missing or incomplete metadata
173:     # Does NOT fix anything - only reports issues
174: 
175:     echo
176:     echo "════════════════════════════════════════════════════════════════════════════════════"
177:     printf "%s Metadata Validation Report — %s %s\n" "${C_BOLD:-}" "$NFTBAN_MODULE_TIMESTAMP" "${C_RESET:-}"
178:     echo "════════════════════════════════════════════════════════════════════════════════════"
179:     echo
180: 
181:     # Scan modules if not already done
182:     if [[ ${#NFTBAN_MODULE_INVENTORY[@]} -eq 0 ]]; then
183:         nftban_module_scan
184:     fi
185: 
186:     local total=0
187:     local complete=0
188:     local incomplete=0
189: 
190:     printf "%-40s %-8s %-8s %-8s %-10s %-10s\n" "MODULE" "NAME" "VERSION" "TYPE" "OWNER" "LICENSE"
191:     echo "------------------------------------------------------------------------------------"
192: 
193:     for file in "${!NFTBAN_MODULE_INVENTORY[@]}"; do
194:         total=$((total + 1))
195:         local data="${NFTBAN_MODULE_INVENTORY[$file]}"
196:         IFS='|' read -r name version module_type created depends owner homepage description <<< "$data"
197: 
198:         # Extract license
199:         local license
200:         license="$(nftban_module_extract_license "$file")"
201: 
202:         # Check completeness
203:         local missing_fields=()
204:         [[ -z "$name" ]] && missing_fields+=("name")
205:         [[ -z "$version" ]] && missing_fields+=("version")
206:         [[ -z "$module_type" ]] && missing_fields+=("type")
207:         [[ -z "$owner" ]] && missing_fields+=("owner")
208:         [[ -z "$license" ]] && missing_fields+=("license")
209: 
210:         # Status symbols
211:         local name_status="${C_GREEN:-}${NFTBAN_MODULE_SYM_OK}${C_RESET:-}"
212:         local version_status="${C_GREEN:-}${NFTBAN_MODULE_SYM_OK}${C_RESET:-}"
213:         local type_status="${C_GREEN:-}${NFTBAN_MODULE_SYM_OK}${C_RESET:-}"
214:         local owner_status="${C_GREEN:-}${NFTBAN_MODULE_SYM_OK}${C_RESET:-}"
215:         local license_status="${C_GREEN:-}${NFTBAN_MODULE_SYM_OK}${C_RESET:-}"
216: 
217:         [[ -z "$name" ]] && name_status="${C_RED:-}${NFTBAN_MODULE_SYM_KO}${C_RESET:-}"
218:         [[ -z "$version" ]] && version_status="${C_RED:-}${NFTBAN_MODULE_SYM_KO}${C_RESET:-}"
219:         [[ -z "$module_type" ]] && type_status="${C_RED:-}${NFTBAN_MODULE_SYM_KO}${C_RESET:-}"
220:         [[ -z "$owner" ]] && owner_status="${C_YELLOW:-}${NFTBAN_MODULE_SYM_KO}${C_RESET:-}"
221:         [[ -z "$license" ]] && license_status="${C_RED:-}${NFTBAN_MODULE_SYM_KO}${C_RESET:-}"
222: 
223:         if [[ ${#missing_fields[@]} -eq 0 ]]; then
224:             complete=$((complete + 1))
225:         else
226:             incomplete=$((incomplete + 1))
227:             local basename
228:             basename="$(basename "$file")"
229:             printf "%-40s %-8s %-8s %-8s %-10s %-10s\n" \
230:                 "${basename:0:39}" "$name_status" "$version_status" "$type_status" "$owner_status" "$license_status"
231:         fi
232:     done
233: 
234:     echo
235:     echo "Summary:"
236:     echo "  Total Modules:      $total"
237:     echo "  Complete Metadata:  ${C_GREEN:-}$complete${C_RESET:-}"
238:     echo "  Incomplete Metadata: ${C_YELLOW:-}$incomplete${C_RESET:-}"
239:     echo
240:     echo "Note: This is informational only. No files were modified."
241:     echo
242: }

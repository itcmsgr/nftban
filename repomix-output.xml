 127: // Stats cache for background updates
 128: var (
 129: 	statsCache     map[string]interface{}
 130: 	statsCacheMux  sync.RWMutex
 131: 	activeUsers    = make(map[string]time.Time) // Track active sessions
 132: 	activeUsersMux sync.RWMutex
 133: )
 134: 
 135: // Response structures
 136: type LoginRequest struct {
 137: 	Username string `json:"username"`
 138: 	Password string `json:"password"`
 139: }
 140: 
 141: type LoginResponse struct {
 142: 	Success bool   `json:"success"`
 143: 	Token   string `json:"token,omitempty"`
 144: 	Message string `json:"message,omitempty"`
 145: }
 146: 
 147: type ErrorResponse struct {
 148: 	Error string `json:"error"`
 149: }
 150: 
 151: type SuccessResponse struct {
 152: 	Success bool   `json:"success"`
 153: 	Message string `json:"message"`
 154: }
 155: 
 156: // LoginHandler handles user authentication
 157: func LoginHandler(authService *auth.PAMAuth) http.HandlerFunc {
 158: 	return func(w http.ResponseWriter, r *http.Request) {
 159: 		var req LoginRequest
 160: 		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
 161: 			respondJSON(w, http.StatusBadRequest, ErrorResponse{Error: "Invalid request"})
 162: 			return
 163: 		}
 164: 
 165: 		// Authenticate user
 166: 		user, err := authService.Authenticate(req.Username, req.Password)
 167: 		if err != nil {
 168: 			clientIP := middleware.GetClientIP(r)
 169: 			authService.AuditLog(req.Username, "login", "failed", clientIP)
 170: 			respondJSON(w, http.StatusUnauthorized, LoginResponse{
 171: 				Success: false,
 172: 				Message: "Authentication failed",
 173: 			})

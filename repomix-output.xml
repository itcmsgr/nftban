351: // IP Lookup functionality
352: document.addEventListener('DOMContentLoaded', function() {
353:     const lookupBtn = document.getElementById('analytics-ip-lookup-btn');
354:     const ipInput = document.getElementById('analytics-ip-input');
355:     const resultDiv = document.getElementById('analytics-ip-result');
356: 
357:     if (lookupBtn && ipInput) {
358:         lookupBtn.addEventListener('click', async function() {
359:             const ip = ipInput.value.trim();
360:             if (!ip) {
361:                 alert('Please enter an IP address');
362:                 return;
363:             }
364: 
365:             lookupBtn.disabled = true;
366:             lookupBtn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Looking up...';
367: 
368:             try {
369:                 const resp = await fetch(`/api/v1/analytics/ip?ip=${encodeURIComponent(ip)}`, {
370:                     headers: window.getAuthHeaders()
371:                 });
372: 
373:                 if (resp.ok) {
374:                     const data = await resp.json();
375:                     console.log('[ANALYTICS] IP lookup result:', data);
376: 
377:                     if (data.success && data.found && data.origin) {
378:                         const origin = data.origin;
379:                         resultDiv.innerHTML = `
380:                             <div style="display: grid; grid-template-columns: 150px 1fr; gap: 10px;">
381:                                 <div><strong>IP Address:</strong></div><div>${origin.ip}</div>
382:                                 <div><strong>Country:</strong></div><div>${getCountryFlag(origin.country)} ${origin.country}</div>
383:                                 ${origin.city ? `<div><strong>City:</strong></div><div>${origin.city}</div>` : ''}
384:                                 <div><strong>Banned At:</strong></div><div>${new Date(origin.banned_at).toLocaleString()}</div>
385:                                 ${origin.jail ? `<div><strong>Source:</strong></div><div>${origin.jail}</div>` : ''}
386:                                 ${origin.reason ? `<div><strong>Reason:</strong></div><div>${origin.reason}</div>` : ''}
387:                             </div>
388:                         `;
389:                         resultDiv.style.display = 'block';
390:                         resultDiv.style.borderColor = '#51cf66';
391:                     } else {
392:                         resultDiv.innerHTML = `
393:                             <div style="text-align: center; color: var(--text-muted);">
394:                                 <i class="fa fa-circle-xmark"></i> IP not found in analytics database
395:                             </div>
396:                         `;
397:                         resultDiv.style.display = 'block';
398:                         resultDiv.style.borderColor = '#ffd43b';
399:                     }
400:                 } else {
401:                     throw new Error('API request failed');
402:                 }
403:             } catch (error) {
404:                 console.error('[ANALYTICS] IP lookup failed:', error);
405:                 resultDiv.innerHTML = `
406:                     <div style="text-align: center; color: #ff6b6b;">
407:                         <i class="fa fa-exclamation-triangle"></i> Lookup failed: ${error.message}
408:                     </div>
409:                 `;
410:                 resultDiv.style.display = 'block';
411:                 resultDiv.style.borderColor = '#ff6b6b';
412:             } finally {
413:                 lookupBtn.disabled = false;
414:                 lookupBtn.innerHTML = '<i class="fa fa-search"></i> Lookup';
415:             }
416:         });
417: 
418:         // Allow Enter key to trigger lookup
419:         ipInput.addEventListener('keypress', function(e) {
420:             if (e.key === 'Enter') {
421:                 lookupBtn.click();
422:             }
423:         });
424:     }
425: });
426: 
427: // Initialize charts when analytics page loads
428: window.initAnalyticsPage = function() {
429:     console.log('[ANALYTICS] Initializing analytics page');
430:     if (typeof Chart !== 'undefined') {
431:         initAnalyticsCharts();
432:     } else {
433:         console.error('[ANALYTICS] Chart.js not loaded!');
434:         setTimeout(() => {
435:             if (typeof Chart !== 'undefined') {
436:                 initAnalyticsCharts();
437:             }
438:         }, 100);
439:     }
440: };
441: 
442: // Auto-initialize when script loads
443: if (document.getElementById('countries-chart')) {
444:     console.log('[ANALYTICS] Auto-initializing analytics page');
445:     window.initAnalyticsPage();
446: 
447:     // Auto-refresh every 30 seconds
448:     setInterval(loadAnalyticsData, 30000);
449: }
450: </script>

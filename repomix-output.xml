 822: nftban_stats_cmd_recent() {
 823:     # Show recent ban activity
 824:     # Usage: nftban stats recent [LIMIT] [--follow] [--json]
 825: 
 826:     local limit="${1:-20}"
 827:     local follow=false
 828:     local json_mode=false
 829: 
 830:     shift || true
 831: 
 832:     # Parse options
 833:     while [[ $# -gt 0 ]]; do
 834:         case "$1" in
 835:             --json)
 836:                 json_mode=true
 837:                 shift
 838:                 ;;
 839:             --follow)
 840:                 follow=true
 841:                 shift
 842:                 ;;
 843:             *)
 844:                 shift
 845:                 ;;
 846:         esac
 847:     done
 848: 
 849:     # JSON mode doesn't support --follow
 850:     if [[ "$follow" == "true" ]] && [[ "$json_mode" == "true" ]]; then
 851:         if declare -f json_output >/dev/null 2>&1; then
 852:             json_output "false" '{}' "JSON mode does not support --follow. Use --json without --follow."
 853:         else
 854:             echo "ERROR: JSON mode does not support --follow" >&2
 855:         fi
 856:         return 1
 857:     fi
 858: 
 859:     if [[ "$follow" == "true" ]]; then
 860:         # Tail mode
 861:         echo "Following ban log (Ctrl+C to exit)..."
 862:         echo ""
 863:         # shellcheck disable=SC2034  # Structured log parsing - only some fields used
 864:         tail -f "${NFTBAN_BAN_LOG:-/var/log/nftban/ban.log}" | while IFS='|' read -r timestamp id jail ip reason action timeout; do
 865:             printf "[%s] %s | %-16s | %-12s | %s\n" \
 866:                 "$(date +%H:%M:%S)" "$timestamp" "$ip" "$action" "$jail"
 867:         done
 868:     else
 869:         # JSON output mode
 870:         if [[ "$json_mode" == "true" ]] && declare -f json_output >/dev/null 2>&1; then
 871:             local activity_data="[]"
 872: 
 873:             if declare -f nftban_stats_recent_activity >/dev/null 2>&1; then
 874:                 activity_data=$(nftban_stats_recent_activity "$limit" 2>/dev/null || echo "[]")
 875:             fi
 876: 
 877:             local data
 878:             if command -v jq &>/dev/null; then
 879:                 data=$(jq -n \
 880:                     --arg limit "$limit" \
 881:                     --argjson items "$activity_data" \
 882:                     '{
 883:                         limit: ($limit | tonumber),
 884:                         items: $items,
 885:                         count: ($items | length)
 886:                     }')
 887:             else
 888:                 local count
 889:                 count=$(echo "$activity_data" | { grep -o "}" || true; } | wc -l)
 890:                 data="{\"limit\":$limit,\"items\":$activity_data,\"count\":$count}"
 891:             fi
 892: 
 893:             json_output "true" "$data"
 894:             return 0
 895:         fi
 896: 
 897:         # Human-readable output
 898:         nftban_stats_recent_activity "$limit"
 899:     fi
 900: }

# =============================================================================
# NFTBan Debian conffiles - configuration files preserved across upgrades
# =============================================================================
# Listed explicitly per Debian policy (no wildcards allowed).
# Each file here is protected by dpkg's config file handling:
#   - Modified files: prompt user on upgrade
#   - Unmodified files: silently replaced
# =============================================================================

# Core configuration
/etc/nftban/nftban.conf
/etc/nftban/update.conf

# Feature configurations (conf.d/)
/etc/nftban/conf.d/banner.conf
/etc/nftban/conf.d/mail.conf
/etc/nftban/conf.d/stats.conf
/etc/nftban/conf.d/trust.conf
/etc/nftban/conf.d/feeds.conf
/etc/nftban/conf.d/watchdog.conf
/etc/nftban/conf.d/metrics.conf
/etc/nftban/conf.d/persistent.conf
/etc/nftban/conf.d/zabbix.conf
/etc/nftban/conf.d/connectors.conf

# Portscan module
/etc/nftban/conf.d/portscan/main.conf
/etc/nftban/conf.d/portscan/classic.conf
/etc/nftban/conf.d/portscan/suricata.conf

# DDoS module
/etc/nftban/conf.d/ddos/main.conf
/etc/nftban/conf.d/ddos/classic.conf
/etc/nftban/conf.d/ddos/suricata.conf

# Login monitor module
/etc/nftban/conf.d/login/main.conf
/etc/nftban/conf.d/login/classic.conf
/etc/nftban/conf.d/login/suricata.conf
/etc/nftban/conf.d/login/services.conf
/etc/nftban/conf.d/login/scorer.conf

# Central whitelist (SINGLE SOURCE OF TRUTH)
# All modules use /etc/nftban/whitelist.d/*.conf instead of per-module files
/etc/nftban/whitelist.d/99-manual.conf

# Bot scanner module
/etc/nftban/conf.d/botscan/main.conf

# GeoIP/GeoBan modules
/etc/nftban/conf.d/geoip/main.conf
/etc/nftban/conf.d/geoban/main.conf

# Suricata IDS profiles
/etc/nftban/suricata/profiles/minimal.yaml
/etc/nftban/suricata/profiles/standard.yaml
/etc/nftban/suricata/profiles/maximum.yaml
/etc/nftban/suricata/config/profile.conf

# Suricata interface configuration (v1.12.0)
/etc/nftban/conf.d/suricata/interfaces.conf

# RBL module
/etc/nftban/conf.d/rbl/main.conf
/etc/nftban/conf.d/rbl/rbls.conf
/etc/nftban/conf.d/rbl/custom.conf
/etc/nftban/conf.d/rbl/watchlist.conf

# Panel integrations
/etc/nftban/conf.d/panels/cpanel/main.conf
/etc/nftban/conf.d/panels/cwp/main.conf
/etc/nftban/conf.d/panels/cyberpanel/main.conf
/etc/nftban/conf.d/panels/directadmin/main.conf
/etc/nftban/conf.d/panels/generic/main.conf
/etc/nftban/conf.d/panels/interworx/main.conf
/etc/nftban/conf.d/panels/plesk/main.conf
/etc/nftban/conf.d/panels/vesta/main.conf

# Polkit authorization rules
/etc/polkit-1/rules.d/10-nftban-systemd.rules
/etc/polkit-1/rules.d/20-nftban-auditor.rules
/etc/polkit-1/rules.d/30-nftban-panel.rules

# Logrotate
/etc/logrotate.d/nftban

16: <script>
17: async function lookupIP() {
18:     const ip = document.getElementById('geoip-input').value.trim();
19:     const resultEl = document.getElementById('geoip-result');
20: 
21:     if (!ip) {
22:         resultEl.innerHTML = '<p class="text-danger">Please enter an IP address</p>';
23:         return;
24:     }
25: 
26:     try {
27:         resultEl.innerHTML = '<p class="text-muted"><i class="fa fa-spinner fa-spin"></i> Looking up...</p>';
28: 
29:         const response = await apiRequest(`/geo?ip=${encodeURIComponent(ip)}`);
30: 
31:         if (!response.data) {
32:             resultEl.innerHTML = '<p class="text-danger">No data found for this IP</p>';
33:             return;
34:         }
35: 
36:         const data = response.data;
37:         let html = `
38:             <div style="background: var(--bg-alt); border: 1px solid var(--border); border-radius: 8px; padding: 20px;">
39:                 <h4 style="margin-bottom: 15px;">${ip}</h4>
40:                 <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 15px;">
41:                     <div>
42:                         <strong>Country:</strong> ${data.country || 'Unknown'} ${data.country_code ? `(${data.country_code})` : ''}
43:                     </div>
44:                     <div>
45:                         <strong>City:</strong> ${data.city || 'Unknown'}
46:                     </div>
47:                     <div>
48:                         <strong>Region:</strong> ${data.region || 'Unknown'}
49:                     </div>
50:                     <div>
51:                         <strong>ISP:</strong> ${data.isp || 'Unknown'}
52:                     </div>
53:                     <div>
54:                         <strong>Latitude:</strong> ${data.latitude || 'N/A'}
55:                     </div>
56:                     <div>
57:                         <strong>Longitude:</strong> ${data.longitude || 'N/A'}
58:                     </div>
59:                 </div>
60:             </div>
61:         `;
62: 
63:         resultEl.innerHTML = html;
64:     } catch (error) {
65:         resultEl.innerHTML = `<p class="text-danger">Lookup failed: ${error.message}</p>`;
66:     }
67: }
68: 
69: // Enter key support
70: document.getElementById('geoip-input')?.addEventListener('keypress', (e) => {
71:     if (e.key === 'Enter') lookupIP();
72: });
73: </script>

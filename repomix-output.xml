1414: // LogFileHandler serves individual log files from /var/log/nftban/
1415: func LogFileHandler(w http.ResponseWriter, r *http.Request) {
1416: 	// Get log file path from query parameter: /api/v1/logs?path=/var/log/nftban/portscan.log
1417: 	logPath := r.URL.Query().Get("path")
1418: 	if logPath == "" {
1419: 		respondJSON(w, http.StatusBadRequest, ErrorResponse{Error: "Missing 'path' parameter"})
1420: 		return
1421: 	}
1422: 
1423: 	// Security: Validate log path (must be under configured log dir)
1424: 	baseDir := getLogDir() + "/"
1425: 	if !strings.HasPrefix(logPath, baseDir) {
1426: 		respondJSON(w, http.StatusForbidden, ErrorResponse{Error: fmt.Sprintf("Log file must be under %s", baseDir)})
1427: 		return
1428: 	}
1429: 
1430: 	// Security: Prevent directory traversal
1431: 	if strings.Contains(logPath, "..") {
1432: 		respondJSON(w, http.StatusForbidden, ErrorResponse{Error: "Invalid log path"})
1433: 		return
1434: 	}
1435: 
1436: 	// Security: Only allow .log files (not .conf, .sh, etc.)
1437: 	if !strings.HasSuffix(logPath, ".log") {
1438: 		respondJSON(w, http.StatusForbidden, ErrorResponse{Error: "Only .log files are allowed"})
1439: 		return
1440: 	}
1441: 
1442: 	// Check if file exists
1443: 	fileInfo, err := os.Stat(logPath)
1444: 	if err != nil {
1445: 		if os.IsNotExist(err) {
1446: 			respondJSON(w, http.StatusNotFound, ErrorResponse{Error: "Log file not found"})
1447: 		} else {
1448: 			respondJSON(w, http.StatusInternalServerError, ErrorResponse{Error: "Failed to access log file"})
1449: 		}
1450: 		return
1451: 	}
1452: 
1453: 	// If today's log is empty, try yesterday's compressed log
1454: 	if fileInfo.Size() == 0 {
1455: 		gzLogPath := logPath + ".1.gz"
1456: 		if gzInfo, err := os.Stat(gzLogPath); err == nil {
1457: 			// Yesterday's log exists, decompress and read it
1458: 			output, err := execCommand("zcat", gzLogPath)
1459: 			if err == nil {
1460: 				// Get last N lines from decompressed content
1461: 				linesParam := r.URL.Query().Get("lines")
1462: 
1463: 				// Split into lines and get last N
1464: 				allLines := strings.Split(strings.TrimSpace(output), "\n")
1465: 				if linesParam == "all" || len(allLines) <= 100 {
1466: 					content := strings.Join(allLines, "\n")
1467: 					respondJSON(w, http.StatusOK, map[string]interface{}{
1468: 						"success": true,
1469: 						"data": map[string]interface{}{
1470: 							"content":  content,
1471: 							"size":     gzInfo.Size(),
1472: 							"modified": gzInfo.ModTime().Unix(),
1473: 							"lines":    len(allLines),
1474: 							"note":     "Today's log is empty, showing yesterday's log",
1475: 						},
1476: 					})
1477: 					return
1478: 				} else {
1479: 					// Get last N lines
1480: 					lineCount := 100
1481: 					if linesParam != "" {
1482: 						if n, err := strconv.Atoi(linesParam); err == nil {
1483: 							lineCount = n
1484: 						}
1485: 					}
1486: 					start := len(allLines) - lineCount
1487: 					if start < 0 {
1488: 						start = 0
1489: 					}
1490: 					content := strings.Join(allLines[start:], "\n")
1491: 					respondJSON(w, http.StatusOK, map[string]interface{}{
1492: 						"success": true,
1493: 						"data": map[string]interface{}{
1494: 							"content":  content,
1495: 							"size":     gzInfo.Size(),
1496: 							"modified": gzInfo.ModTime().Unix(),
1497: 							"lines":    lineCount,
1498: 							"note":     "Today's log is empty, showing yesterday's log",
1499: 						},
1500: 					})
1501: 					return
1502: 				}
1503: 			}
1504: 		}
1505: 	}
1506: 
1507: 	// Get number of lines to return (default: 100, max: all)
1508: 	linesParam := r.URL.Query().Get("lines")
1509: 	lines := "100"
1510: 	if linesParam != "" {
1511: 		lines = linesParam
1512: 	}
1513: 
1514: 	// Read log file
1515: 	var content string
1516: 	if lines == "all" {
1517: 		// Read entire file
1518: 		data, err := os.ReadFile(logPath)
1519: 		if err != nil {
1520: 			respondJSON(w, http.StatusInternalServerError, ErrorResponse{Error: "Failed to read log file"})
1521: 			return
1522: 		}
1523: 		content = string(data)
1524: 	} else {
1525: 		// Use tail to get last N lines
1526: 		output, err := execCommand("tail", "-n", lines, logPath)
1527: 		if err != nil {
1528: 			respondJSON(w, http.StatusInternalServerError, ErrorResponse{Error: "Failed to read log file"})
1529: 			return
1530: 		}
1531: 		content = output
1532: 	}
1533: 
1534: 	// Return log content in standard response format
1535: 	respondJSON(w, http.StatusOK, map[string]interface{}{
1536: 		"success": true,
1537: 		"data": map[string]interface{}{
1538: 			"content":  content,
1539: 			"size":     fileInfo.Size(),
1540: 			"modified": fileInfo.ModTime().Unix(),
1541: 			"lines":    strings.Count(content, "\n"),
1542: 		},
1543: 	})
1544: }

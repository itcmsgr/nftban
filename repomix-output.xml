 1: # ============================================================================
 2: # NFTBan v1.0 - Suricata Filter Configuration (DEFAULT)
 3: # ============================================================================
 4: # DO NOT EDIT THIS FILE - Your changes will be overwritten on updates!
 5: # Create /etc/nftban/filters.conf.local for custom settings
 6: # ============================================================================
 7: #
 8: # FORMAT (one filter per line):
 9: # filter_name = enabled | keywords | threshold | ban_time | action | ban_type | description
10: #
11: # FIELDS:
12: #   enabled    = true/false (enable/disable this filter)
13: #   keywords   = comma-separated words to match in Suricata signatures
14: #   threshold  = score needed to trigger action (0-200)
15: #   ban_time   = duration of each ban (30s, 5m, 1h, 24h, 7d)
16: #   action     = log/observe/ban (log=testing, observe=tuning, ban=production)
17: #   ban_type   = temporary/permanent/escalate:N:PERIOD
18: #   description = human-readable description
19: #
20: # BAN TYPES:
21: #   temporary         - Always ban for ban_time duration (e.g., 30m)
22: #   permanent         - Always ban permanently (forever)
23: #   escalate:N:PERIOD - Ban for ban_time initially, but after N bans in PERIOD, go permanent
24: #
25: # ESCALATION EXAMPLES:
26: #   escalate:3:24h - After 3 bans in 24 hours, ban permanently
27: #   escalate:5:7d  - After 5 bans in 7 days, ban permanently
28: #   escalate:2:1h  - After 2 bans in 1 hour, ban permanently
29: #
30: # SCORING SYSTEM:
31: #   Base severity:  High=40pts, Medium=30pts, Low=20pts, Info=10pts
32: #   Repetition:     5+ events=+20pts, 10+ events=+30pts, 20+ events=+50pts
33: #   Feeds:          In blacklist=+30pts (future)
34: #   GeoIP:          Risky country=+10pts (future)
35: #   DDoS:           High PPS=+40pts (future)
36: #
37: # TESTING WORKFLOW:
38: #   1. New filter → action=log, ban_type=temporary (test matching, tune threshold)
39: #   2. Tuned filter → action=observe, ban_type=temporary (track scores, verify no false positives)
40: #   3. Production → action=ban, ban_type=escalate:3:24h (real protection with escalation)
41: #
42: # ============================================================================
43: 
44: [global]
45: enabled = true
46: default_threshold = 100
47: default_ban_time = 30m
48: default_action = ban
49: score_decay = 1h
50: 
51: # ============================================================================
52: # FILTERS - Default Configuration
53: # ============================================================================
54: 
55: [filters]
56: # ──────────────────────────────────────────────────────────────────────────
57: # Network Services (Enabled by default with escalation)
58: # ──────────────────────────────────────────────────────────────────────────
59: ssh       = true  | ssh,brute,bruteforce                           | 80  | 30m | ban | escalate:3:24h  | SSH brute-force (temp 30m, perm after 3x)
60: http      = true  | http,web,wordpress,sqli,xss,rfi,lfi           | 100 | 1h  | ban | escalate:3:24h  | Web exploits (temp 1h, perm after 3x)

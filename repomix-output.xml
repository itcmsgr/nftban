<file path="pkg/sync/diff.go">
  1: package sync
  2: 
  3: import (
  4: 	"fmt"
  5: 	"time"
  6: 
  7: 	"github.com/google/nftables"
  8: 	"github.com/itcmsgr/nftban/pkg/util"
  9: )
 10: 
 11: // DiffResult is a type alias for the generic util.DiffResult[string]
 12: // This maintains backwards compatibility while using the optimized generic implementation
 13: type DiffResult = util.DiffResult[string]
 14: 
 15: // ComputeDiff compares desired state with current nftables state
 16: // Returns IPs that need to be added or removed
 17: //
 18: // This now uses the optimized generic diff engine from pkg/util
 19: // Benefits:
 20: // - Preallocated maps (no resizing)
 21: // - Zero allocations for struct{} map values
 22: // - Same algorithm, better performance
 23: func ComputeDiff(desiredIPs []string, currentIPs []string) *DiffResult {
 24: 	diff := util.ComputeDiff[string](desiredIPs, currentIPs)
 25: 	return &diff
 26: }
 27: 
 28: // SyncStats holds statistics about a sync operation
 29: type SyncStats struct {
 30: 	SetName       string
 31: 	IPsAdded      int
 32: 	IPsRemoved    int
 33: 	IPsUnchanged  int
 34: 	TotalDesired  int
 35: 	TotalCurrent  int
 36: 	Duration      time.Duration
 37: 	Error         error
 38: }
 39: 
 40: // SyncSetToNFT performs differential sync of a set
 41: // Only adds/removes IPs that have changed
 42: func SyncSetToNFT(nft *NFTManager, set *nftables.Set, desiredIPs []string) (*SyncStats, error) {
 43: 	startTime := time.Now()
 44: 
 45: 	stats := &SyncStats{
 46: 		SetName:      set.Name,
 47: 		TotalDesired: len(desiredIPs),
 48: 	}
 49: 
 50: 	// Get current IPs in nftables set
 51: 	currentIPs, err := nft.GetSetElements(set)
 52: 	if err != nil {
 53: 		stats.Error = fmt.Errorf("failed to get current elements: %w", err)
 54: 		stats.Duration = time.Since(startTime)
 55: 		return stats, stats.Error
 56: 	}
 57: 
 58: 	stats.TotalCurrent = len(currentIPs)
 59: 
 60: 	// Compute diff
 61: 	diff := ComputeDiff(desiredIPs, currentIPs)
 62: 	stats.IPsAdded = len(diff.ToAdd)
 63: 	stats.IPsRemoved = len(diff.ToRemove)
 64: 	stats.IPsUnchanged = diff.Unchanged
 65: 
 66: 	// Apply diff using centralized ApplyDiff layer
 67: 	// This ensures all nftables updates go through a single code path
 68: 	if err := ApplyStringDiffToSet(nft, set, *diff); err != nil {
 69: 		stats.Error = fmt.Errorf("failed to apply diff: %w", err)
 70: 		stats.Duration = time.Since(startTime)
 71: 		return stats, stats.Error
 72: 	}
 73: 
 74: 	stats.Duration = time.Since(startTime)
 75: 	return stats, nil
 76: }
 77: 
 78: // SyncResult holds results of syncing multiple sets
 79: type SyncResult struct {
 80: 	WhitelistIPv4 *SyncStats
 81: 	WhitelistIPv6 *SyncStats
 82: 	BlacklistIPv4 *SyncStats
 83: 	BlacklistIPv6 *SyncStats
 84: 	TotalDuration time.Duration
 85: 	Success       bool
 86: }
 87: 
 88: // FullSync performs a complete sync of all whitelist/blacklist sets
 89: func FullSync(
 90: 	nft *NFTManager,
 91: 	whitelistIPv4Set, whitelistIPv6Set *nftables.Set,
 92: 	blacklistIPv4Set, blacklistIPv6Set *nftables.Set,
 93: 	whitelistIPv4, whitelistIPv6 []string,
 94: 	blacklistIPv4, blacklistIPv6 []string,
 95: ) (*SyncResult, error) {
 96: 	startTime := time.Now()
 97: 	result := &SyncResult{Success: true}
 98: 
 99: 	// Sync whitelist IPv4
100: 	if whitelistIPv4Set != nil {
101: 		stats, err := SyncSetToNFT(nft, whitelistIPv4Set, whitelistIPv4)
102: 		result.WhitelistIPv4 = stats
103: 		if err != nil {
104: 			result.Success = false
105: 			return result, fmt.Errorf("whitelist IPv4 sync failed: %w", err)
106: 		}
107: 	}
108: 
109: 	// Sync whitelist IPv6
110: 	if whitelistIPv6Set != nil {
111: 		stats, err := SyncSetToNFT(nft, whitelistIPv6Set, whitelistIPv6)
112: 		result.WhitelistIPv6 = stats
113: 		if err != nil {
114: 			result.Success = false
115: 			return result, fmt.Errorf("whitelist IPv6 sync failed: %w", err)
116: 		}
117: 	}
118: 
119: 	// Sync blacklist IPv4
120: 	if blacklistIPv4Set != nil {
121: 		stats, err := SyncSetToNFT(nft, blacklistIPv4Set, blacklistIPv4)
122: 		result.BlacklistIPv4 = stats
123: 		if err != nil {
124: 			result.Success = false
125: 			return result, fmt.Errorf("blacklist IPv4 sync failed: %w", err)
126: 		}
127: 	}
128: 
129: 	// Sync blacklist IPv6
130: 	if blacklistIPv6Set != nil {
131: 		stats, err := SyncSetToNFT(nft, blacklistIPv6Set, blacklistIPv6)
132: 		result.BlacklistIPv6 = stats
133: 		if err != nil {
134: 			result.Success = false
135: 			return result, fmt.Errorf("blacklist IPv6 sync failed: %w", err)
136: 		}
137: 	}
138: 
139: 	result.TotalDuration = time.Since(startTime)
140: 	return result, nil
141: }
142: 
143: // PrintSyncStats prints sync statistics in a readable format
144: func PrintSyncStats(stats *SyncStats) {
145: 	if stats == nil {
146: 		return
147: 	}
148: 
149: 	fmt.Printf("  Set: %s\n", stats.SetName)
150: 	fmt.Printf("    Added:     %d IPs\n", stats.IPsAdded)
151: 	fmt.Printf("    Removed:   %d IPs\n", stats.IPsRemoved)
152: 	fmt.Printf("    Unchanged: %d IPs\n", stats.IPsUnchanged)
153: 	fmt.Printf("    Current:   %d → %d IPs\n", stats.TotalCurrent, stats.TotalDesired)
154: 	fmt.Printf("    Duration:  %v\n", stats.Duration)
155: 	if stats.Error != nil {
156: 		fmt.Printf("    Error:     %v\n", stats.Error)
157: 	}
158: }
159: 
160: // PrintSyncResult prints a complete sync result
161: func PrintSyncResult(result *SyncResult) {
162: 	fmt.Println("\n📊 Sync Results:")
163: 	fmt.Println("================")
164: 
165: 	if result.WhitelistIPv4 != nil {
166: 		fmt.Println("\nWhitelist IPv4:")
167: 		PrintSyncStats(result.WhitelistIPv4)
168: 	}
169: 
170: 	if result.WhitelistIPv6 != nil {
171: 		fmt.Println("\nWhitelist IPv6:")
172: 		PrintSyncStats(result.WhitelistIPv6)
173: 	}
174: 
175: 	if result.BlacklistIPv4 != nil {
176: 		fmt.Println("\nBlacklist IPv4:")
177: 		PrintSyncStats(result.BlacklistIPv4)
178: 	}
179: 
180: 	if result.BlacklistIPv6 != nil {
181: 		fmt.Println("\nBlacklist IPv6:")
182: 		PrintSyncStats(result.BlacklistIPv6)
183: 	}
184: 
185: 	fmt.Printf("\nTotal Duration: %v\n", result.TotalDuration)
186: 	if result.Success {
187: 		fmt.Println("✅ Sync completed successfully!")
188: 	} else {
189: 		fmt.Println("❌ Sync failed!")
190: 	}
191: }
192: 
193: // IsFastSync checks if a sync operation is "fast" (few changes)
194: // This can be used for metrics/alerting
195: func IsFastSync(stats *SyncStats, threshold int) bool {
196: 	return (stats.IPsAdded + stats.IPsRemoved) <= threshold
197: }
198: 
199: // GetSyncEfficiency returns the percentage of IPs that were already in sync
200: func GetSyncEfficiency(stats *SyncStats) float64 {
201: 	total := stats.IPsAdded + stats.IPsRemoved + stats.IPsUnchanged
202: 	if total == 0 {
203: 		return 100.0
204: 	}
205: 	return float64(stats.IPsUnchanged) / float64(total) * 100.0
206: }

 8:         <button onclick="lookupIP()" class="btn-primary">
 9:             <i class="fa fa-search"></i> Lookup
10:         </button>
11:     </div>
12: 
13:     <div id="geoip-result" style="margin-top: 20px;"></div>
14: </div>

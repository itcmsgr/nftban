# meta:owner="Antonios Voulvoulis <contact@nftban.com>"
# meta:created_date="2025-10-26"
# meta:description="Timer for periodic health checks"
# meta:input="None"
# meta:output="Systemd unit"
# meta:depends=""
# meta:inventory.files=""
# meta:inventory.binaries=""
# meta:inventory.env_vars=""
# meta:inventory.config_files=""
# meta:inventory.systemd_units="nftban-health.service"
# meta:inventory.network=""
# meta:inventory.privileges="root"
# =============================================================================

[Unit]
Description=NFTBan Periodic Health Check Timer
Documentation=man:nftban(8)
# v1.19.0: Removed Requires= — causes timer to stop when oneshot completes (Task 47)

[Timer]
# Run daily at 03:00 AM (first in staggered sequence: health@03:00, feeds@03:20, suricata@03:40)
# This is a lightweight read-only check, so runs first
OnCalendar=*-*-* 03:00:00

# Also run 15min after boot to catch issues on system startup
OnBootSec=15min

# JITTER: 10m variance (reduced from 30m to fit in 20-minute window before feeds)
RandomizedDelaySec=10m

# DETERMINISTIC: Same offset per host for predictable behavior
FixedRandomDelay=true

# Persist timer across reboots
Persistent=true

# Unit to activate
Unit=nftban-health.service

[Install]
WantedBy=timers.target

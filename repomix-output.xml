480: // takeSample collects a single metrics snapshot
481: func (s *Sampler) takeSample() {
482: 	start := time.Now()
483: 
484: 	// Get network statistics
485: 	rxMbps, txMbps := s.getNetworkStats()
486: 
487: 	// Execute nftban status --json
488: 	cmd := exec.Command("nftban", "status", "--json")
489: 	output, err := cmd.Output()
490: 	if err != nil {
491: 		log.Printf("[METRICS] Failed to get status: %v", err)
492: 		return
493: 	}
494: 
495: 	// Strip any non-JSON output (comments, warnings, etc.) before parsing
496: 	// Look for the first '{' and last '}' to extract only the JSON portion
497: 	outputStr := strings.TrimSpace(string(output))
498: 	startIdx := strings.Index(outputStr, "{")
499: 	endIdx := strings.LastIndex(outputStr, "}")
500: 
501: 	if startIdx == -1 || endIdx == -1 || startIdx > endIdx {
502: 		log.Printf("[METRICS] No valid JSON found in status output: %s", outputStr)
503: 		return
504: 	}
505: 
506: 	jsonOutput := outputStr[startIdx : endIdx+1]
507: 
508: 	// Parse JSON
509: 	var statusData map[string]interface{}
510: 	if err := json.Unmarshal([]byte(jsonOutput), &statusData); err != nil {
511: 		log.Printf("[METRICS] Failed to parse status JSON: %v - Output: %s", err, jsonOutput)
512: 		return
513: 	}
514: 
515: 	// Extract metrics
516: 	sample := Sample{
517: 		Timestamp:    time.Now(),
518: 		NetworkRxMbps: rxMbps,
519: 		NetworkTxMbps: txMbps,
520: 		RawData:      statusData,
521: 	}
522: 
523: 	if version, ok := statusData["version"].(string); ok {
524: 		sample.Version = version
525: 	}
526: 
527: 	if firewall, ok := statusData["firewall"].(map[string]interface{}); ok {
528: 		if bannedIPs, ok := firewall["banned_ips"].(float64); ok {
529: 			sample.BlockedIPs = int(bannedIPs)
530: 		}
531: 		if ruleCount, ok := firewall["rule_count"].(float64); ok {
532: 			sample.RuleCount = int(ruleCount)
533: 		}
534: 	}
535: 
536: 	if health, ok := statusData["health"].(map[string]interface{}); ok {
537: 		if status, ok := health["status"].(string); ok {
538: 			sample.HealthOK = (status == "ok")
539: 		}
540: 	}
541: 
542: 	// Collect additional comprehensive metrics
543: 	feedsTotal := s.collectFeedsMetrics()
544: 	// Removed: fail2ban metrics collection (v1.0 migration to Suricata)
545: 	geobanCountries, geobanRanges := s.collectGeobanMetrics()
546: 	blacklistIPs := s.collectBlacklistMetrics()
547: 	whitelistIPs := s.collectWhitelistMetrics()
548: 	portscanBlocks := s.collectPortscanMetrics()
549: 	ddosBlocks := s.collectDDoSMetrics()
550: 
551: 	// Parse service status
552: 	nftablesActive := 0.0
553: 	// Removed: fail2banActive variable (v1.0 migration to Suricata)
554: 	if services, ok := statusData["services"].(map[string]interface{}); ok {
555: 		if nft, ok := services["nftables"].(string); ok && nft == "active" {
556: 			nftablesActive = 1.0
557: 		}
558: 		// Removed: fail2ban service check (v1.0 migration to Suricata)
559: 	}
560: 
561: 	// Update Prometheus metrics
562: 	s.blockedIPsGauge.Set(float64(sample.BlockedIPs))
563: 	s.ruleCountGauge.Set(float64(sample.RuleCount))
564: 	if sample.HealthOK {
565: 		s.healthGauge.Set(1)
566: 	} else {
567: 		s.healthGauge.Set(0)
568: 	}
569: 	s.feedsActiveGauge.Set(float64(sample.FeedsActive))
570: 	s.feedsTotalIPsGauge.Set(float64(feedsTotal))
571: 	s.uptimeGauge.Set(time.Since(s.startTime).Seconds())
572: 	s.networkRxGauge.Set(sample.NetworkRxMbps)
573: 	s.networkTxGauge.Set(sample.NetworkTxMbps)
574: 	// Removed: fail2ban gauge Set() calls (v1.0 migration to Suricata)
575: 	s.geobanCountriesGauge.Set(float64(geobanCountries))
576: 	s.geobanRangesGauge.Set(float64(geobanRanges))
577: 	s.blacklistIPsGauge.Set(float64(blacklistIPs))
578: 	s.whitelistIPsGauge.Set(float64(whitelistIPs))
579: 	s.portscanBlocksGauge.Set(float64(portscanBlocks))
580: 	s.ddosBlocksGauge.Set(float64(ddosBlocks))
581: 	s.nftablesActiveGauge.Set(nftablesActive)
582: 	// Removed: fail2banActiveGauge.Set() call (v1.0 migration to Suricata)
583: 
584: 	// Store sample in ring buffer
585: 	s.mu.Lock()
586: 	s.samples = append(s.samples, sample)
587: 	if len(s.samples) > s.maxSamples {
588: 		s.samples = s.samples[1:]
589: 	}
590: 	s.lastSample = sample.Timestamp
591: 	s.mu.Unlock()
592: 
593: 	duration := time.Since(start)
594: 	log.Printf("[METRICS] Sample collected in %v (blocked=%d, rules=%d, health=%v, net=%.2fMbps↓ %.2fMbps↑)",
595: 		duration, sample.BlockedIPs, sample.RuleCount, sample.HealthOK, sample.NetworkRxMbps, sample.NetworkTxMbps)
596: }

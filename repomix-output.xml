315: // cmdGeoipLookup performs IP→Country lookup
316: func cmdGeoipLookup(ipStr string, jsonOutput bool) error {
317: 	dbFile := getGeoipDir() + "/GeoLite2-City.mmdb"
318: 
319: 	// Open database
320: 	db, err := maxminddb.Open(dbFile)
321: 	if err != nil {
322: 		return fmt.Errorf("failed to open GeoIP database: %w\nDatabase path: %s\nRun: nftban-core geoip update", err, dbFile)
323: 	}
324: 	defer db.Close()
325: 
326: 	// Lookup IP
327: 	var record struct {
328: 		Country struct {
329: 			ISOCode string            `maxminddb:"iso_code"`
330: 			Names   map[string]string `maxminddb:"names"`
331: 		} `maxminddb:"country"`
332: 		City struct {
333: 			Names map[string]string `maxminddb:"names"`
334: 		} `maxminddb:"city"`
335: 		Location struct {
336: 			Latitude  float64 `maxminddb:"latitude"`
337: 			Longitude float64 `maxminddb:"longitude"`
338: 			TimeZone  string  `maxminddb:"time_zone"`
339: 		} `maxminddb:"location"`
340: 	}
341: 
342: 	err = db.Lookup([]byte(ipStr), &record)
343: 	if err != nil {
344: 		return fmt.Errorf("lookup failed: %w", err)
345: 	}
346: 
347: 	// Extract data with defaults
348: 	countryCode := record.Country.ISOCode
349: 	if countryCode == "" {
350: 		countryCode = "Unknown"
351: 	}
352: 
353: 	countryName := record.Country.Names["en"]
354: 	if countryName == "" {
355: 		countryName = "Unknown"
356: 	}
357: 
358: 	cityName := record.City.Names["en"]
359: 	if cityName == "" {
360: 		cityName = "Unknown"
361: 	}
362: 
363: 	timezone := record.Location.TimeZone
364: 	if timezone == "" {
365: 		timezone = "Unknown"
366: 	}
367: 
368: 	latitude := record.Location.Latitude
369: 	longitude := record.Location.Longitude
370: 
371: 	// Output format
372: 	if jsonOutput {
373: 		// JSON format for GUI/API
374: 		fmt.Printf(`{"ip":"%s","country_code":"%s","country_name":"%s","city":"%s","timezone":"%s","latitude":%f,"longitude":%f}`,
375: 			ipStr, countryCode, countryName, cityName, timezone, latitude, longitude)
376: 		fmt.Println()
377: 	} else {
378: 		// Compact format for shell scripts: CC/City/Timezone
379: 		fmt.Printf("%s/%s/%s\n", countryCode, cityName, timezone)
380: 	}
381: 
382: 	return nil
383: }

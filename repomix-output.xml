187:         print_info "Running Prometheus installation..."
188:         "$SCRIPT_DIR/install_prometheus.sh"
189:         print_status "Prometheus installation complete"
190:     else
191:         print_error "install_prometheus.sh not found at: $SCRIPT_DIR"
192:         exit 1
193:     fi
194: 
195:     # Validate
196:     if [[ -f "$SCRIPT_DIR/validate_prometheus.sh" ]]; then
197:         print_info "Validating Prometheus..."
198:         if "$SCRIPT_DIR/validate_prometheus.sh"; then
199:             print_status "Prometheus validation passed"
200:         else
201:             print_warn "Prometheus validation had warnings"
202:         fi
203:     fi
204: }
205: 
206: step4_install_grafana() {

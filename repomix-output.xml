461:         echo "✅ nftables updated"
462:     fi
463: 
464:     echo ""
465:     echo "╔══════════════════════════════════════════════════════════╗"
466:     echo "║  ✅ Cloudflare IP Ranges UPDATED                         ║"
467:     echo "╚══════════════════════════════════════════════════════════╝"
468:     echo ""
469: 
470:     _cf_log "INFO" "Cloudflare IP ranges updated"
471: 
472:     return 0
473: }
474: 
475: # =============================================================================
476: # SHOW CLOUDFLARE STATUS
477: # =============================================================================
478: nftban_cloudflare_status() {
479:     # Load output module for standard banner

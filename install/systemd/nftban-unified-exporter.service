# meta:inventory.privileges="nftban"
#
# Collects metrics ONCE, exports to ALL configured targets:
# - Prometheus (node_exporter textfile)
# - Zabbix (trapper protocol)
# - Connectors (Elasticsearch, Kafka, file, etc.)
#
# =============================================================================

[Unit]
Description=NFTBan Unified Metrics Exporter
Documentation=https://nftban.com/docs/metrics
After=network.target nftban.service
Wants=nftban.service

# MUTUAL EXCLUSION: Prevent running alongside legacy exporters
Conflicts=nftban-metrics-exporter.service
Conflicts=nftban-zabbix-exporter.service
Conflicts=nftban-connector-exporter.service

[Service]
Type=oneshot

# Run as nftban user (least privilege)
User=nftban
Group=nftban

# Execute unified exporter
ExecStart=/usr/lib/nftban/exporters/nftban_unified_exporter.sh

# Resource limits (prevent runaway)
CPUQuota=10%
MemoryMax=64M
TimeoutStartSec=30s

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/node_exporter/textfile_collector
ReadWritePaths=/run/nftban
ReadWritePaths=/var/log/nftban

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nftban-exporter

[Install]
WantedBy=multi-user.target

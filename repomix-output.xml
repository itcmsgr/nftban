203: # ==============================================================================
204: # Shared: Install metrics dependencies
205: # ==============================================================================
206: nftban_metrics_install_deps() {
207:     # Install Prometheus and Node Exporter based on distro
208:     # Auto-detects if packages available in repos, falls back to binaries
209:     # Returns: 0 on success, 1 on failure
210: 
211:     local verbose="${1:-true}"
212: 
213:     # Detect distro
214:     local distro_id distro_version
215:     distro_id=$(grep "^ID=" /etc/os-release | cut -d= -f2 | tr -d '"')
216:     distro_version=$(grep "^VERSION_ID=" /etc/os-release | cut -d= -f2 | tr -d '"')
217: 
218:     [[ "$verbose" == "true" ]] && echo "  📦 Installing dependencies..."
219: 
220:     case "$distro_id" in
221:         debian|ubuntu)
222:             # Debian/Ubuntu have Prometheus in repos
223:             apt-get update -qq &>/dev/null || true
224:             if apt-get install -y prometheus prometheus-node-exporter &>/dev/null; then
225:                 [[ "$verbose" == "true" ]] && echo "  ✓ Dependencies installed from APT repositories"
226:                 return 0
227:             else
228:                 [[ "$verbose" == "true" ]] && echo "  ⚠️  APT install failed, trying binary installation..."
229:                 nftban_metrics_install_from_binaries "$verbose"
230:                 return $?
231:             fi
232:             ;;
233:         centos|rhel|rocky|almalinux)
234:             # RHEL-family: Check if Prometheus available in repos
235:             if dnf search prometheus 2>/dev/null | grep -q "^prometheus\."; then
236:                 # Available in repos (Fedora or custom repos)
237:                 if dnf install -y prometheus golang-github-prometheus-node-exporter &>/dev/null || \
238:                    dnf install -y prometheus node-exporter &>/dev/null; then
239:                     [[ "$verbose" == "true" ]] && echo "  ✓ Dependencies installed from DNF repositories"
240:                     return 0
241:                 fi
242:             fi
243: 
244:             # Not available in repos - install from binaries
245:             [[ "$verbose" == "true" ]] && echo "  ℹ️  Prometheus not available in $distro_id $distro_version repositories"
246:             [[ "$verbose" == "true" ]] && echo "  📥 Installing from official GitHub releases..."
247:             nftban_metrics_install_from_binaries "$verbose"
248:             return $?
249:             ;;
250:         fedora)
251:             # Fedora has Prometheus in repos
252:             if dnf install -y prometheus golang-github-prometheus-node-exporter &>/dev/null; then
253:                 [[ "$verbose" == "true" ]] && echo "  ✓ Dependencies installed from DNF repositories"
254:                 return 0
255:             else
256:                 [[ "$verbose" == "true" ]] && echo "  ⚠️  DNF install failed, trying binary installation..."
257:                 nftban_metrics_install_from_binaries "$verbose"
258:                 return $?
259:             fi
260:             ;;
261:         *)
262:             [[ "$verbose" == "true" ]] && echo "  ⚠️  Unknown distribution: $distro_id"
263:             [[ "$verbose" == "true" ]] && echo "  📥 Attempting binary installation..."
264:             nftban_metrics_install_from_binaries "$verbose"
265:             return $?
266:             ;;
267:     esac
268: }

 11: // SystemOverviewStatusHandler returns comprehensive system status for overview
 12: // GET /api/v1/system/status
 13: func SystemOverviewStatusHandler(w http.ResponseWriter, r *http.Request) {
 14: 	data := make(map[string]interface{})
 15: 
 16: 	// Get nftban status
 17: 	output, err := execNFTBanCommand("status", "--json")
 18: 	if err == nil {
 19: 		// Strip any non-JSON output (comments, warnings, etc.) before parsing
 20: 		output = strings.TrimSpace(output)
 21: 		startIdx := strings.Index(output, "{")
 22: 		endIdx := strings.LastIndex(output, "}")
 23: 
 24: 		if startIdx != -1 && endIdx != -1 && startIdx <= endIdx {
 25: 			jsonOutput := output[startIdx : endIdx+1]
 26: 			var statusResult map[string]interface{}
 27: 			if json.Unmarshal([]byte(jsonOutput), &statusResult) == nil {
 28: 				if statusData, ok := statusResult["data"].(map[string]interface{}); ok {
 29: 					data["active"] = true
 30: 					data["version"] = statusData["version"]
 31: 					if fw, ok := statusData["firewall"].(map[string]interface{}); ok {
 32: 						data["rules"] = fw["rules"]
 33: 						data["banned"] = fw["banned"]
 34: 					}
 35: 				}
 36: 			}
 37: 		}
 38: 	}
 39: 	if data["active"] == nil {
 40: 		data["active"] = false
 41: 		data["version"] = "v1.0.0"
 42: 		data["rules"] = 0
 43: 		data["banned"] = 0
 44: 	}
 45: 
 46: 	// Check protection modules (parse text output, not JSON)
 47: 	ddosOut, _ := execNFTBanCommand("ddos", "status")
 48: 	data["ddos_enabled"] = strings.Contains(ddosOut, "Master Switch: ✅ ENABLED") ||
 49: 		strings.Contains(ddosOut, "ENABLED")
 50: 
 51: 	portscanOut, _ := execNFTBanCommand("portscan", "status")
 52: 	data["portscan_enabled"] = strings.Contains(portscanOut, "Master Switch: ✅ ENABLED") ||
 53: 		strings.Contains(portscanOut, "ENABLED")
 54: 
 55: 	loginOut, _ := execNFTBanCommand("login", "status", "--json")
 56: 	data["login_enabled"] = strings.Contains(loginOut, "enabled") || strings.Contains(loginOut, "true")
 57: 
 58: 	// Feeds count
 59: 	feedsOut, _ := execNFTBanCommand("feeds", "status", "--json")
 60: 	data["feeds_active"] = countMatches(feedsOut, `"enabled":\s*true`)
 61: 
 62: 	// Services status
 63: 	data["nftables_running"] = isServiceRunning("nftables")
 64: 	// Removed: fail2ban_running (v1.0 migration to Suricata)
 65: 	data["ui_running"] = isServiceRunning("nftban-ui")
 66: 	data["login_monitor_running"] = isServiceRunning("nftban-login-monitor")
 67: 
 68: 	// Count running services
 69: 	services := []string{"nftables", "nftban-ui", "nftban-ui-auth", "nftban-login-monitor", "nftban-metrics-exporter"}
 70: 	running := 0
 71: 	for _, svc := range services {
 72: 		if isServiceRunning(svc) {
 73: 			running++
 74: 		}
 75: 	}
 76: 	data["services_running"] = running
 77: 	data["services_total"] = len(services)
 78: 
 79: 	// Timers
 80: 	timersOut, _ := execCommand("systemctl", "list-timers", "--no-pager")
 81: 	data["timers_active"] = strings.Count(timersOut, "nftban")
 82: 
 83: 	// Modules
 84: 	modulesOut, _ := execNFTBanCommand("module", "--json")
 85: 	data["modules_total"] = countMatches(modulesOut, `"name"`)
 86: 	data["modules_enabled"] = countMatches(modulesOut, `"status":\s*"ENABLED"`)
 87: 
 88: 	// Health summary
 89: 	healthOut, _ := execNFTBanCommand("health", "summary")
 90: 	if strings.Contains(healthOut, "OK") {
 91: 		data["health_status"] = "OK"
 92: 		data["health_errors"] = 0
 93: 		data["health_warnings"] = 0
 94: 	} else {
 95: 		data["health_status"] = "ERROR"
 96: 		data["health_errors"] = countMatches(healthOut, `error`)
 97: 		data["health_warnings"] = countMatches(healthOut, `warning`)
 98: 	}
 99: 
100: 	respondJSON(w, http.StatusOK, map[string]interface{}{
101: 		"success": true,
102: 		"data":    data,
103: 	})
104: }

 403: check_conflicting_firewalls() {
 404:     log "Checking for conflicting firewalls..."
 405: 
 406:     local conflicts_found=0
 407:     local firewall_issues=()
 408: 
 409:     # 1. Check firewalld
 410:     if command -v firewall-cmd &>/dev/null; then
 411:         if systemctl is-active --quiet firewalld 2>/dev/null; then
 412:             firewall_issues+=("firewalld is ACTIVE")
 413:             conflicts_found=1
 414:         elif systemctl is-enabled --quiet firewalld 2>/dev/null; then
 415:             firewall_issues+=("firewalld is ENABLED (not running)")
 416:             conflicts_found=1
 417:         fi
 418:     fi
 419: 
 420:     # 2. Check iptables (legacy service)
 421:     if command -v iptables &>/dev/null; then
 422:         if systemctl is-active --quiet iptables 2>/dev/null; then
 423:             firewall_issues+=("iptables service is ACTIVE")
 424:             conflicts_found=1
 425:         elif systemctl is-enabled --quiet iptables 2>/dev/null; then
 426:             firewall_issues+=("iptables service is ENABLED (not running)")
 427:             conflicts_found=1
 428:         fi
 429:     fi
 430: 
 431:     # 3. Check iptables-services (RHEL/CentOS)
 432:     if systemctl is-active --quiet iptables.service 2>/dev/null || \
 433:        systemctl is-active --quiet ip6tables.service 2>/dev/null; then
 434:         firewall_issues+=("iptables-services is ACTIVE")
 435:         conflicts_found=1
 436:     fi
 437: 
 438:     # 4. Check ufw (Ubuntu/Debian)
 439:     if command -v ufw &>/dev/null; then
 440:         if ufw status 2>/dev/null | grep -q "Status: active"; then
 441:             firewall_issues+=("ufw is ACTIVE")
 442:             conflicts_found=1
 443:         fi
 444:     fi
 445: 
 446:     # If no conflicts, all good
 447:     if [[ $conflicts_found -eq 0 ]]; then
 448:         ok "No conflicting firewalls detected"
 449:         return 0
 450:     fi
 451: 
 452:     # CONFLICT DETECTED - Show warnings
 453:     echo ""
 454:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
 455:     error "⚠ CONFLICTING FIREWALL(S) DETECTED!"
 456:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
 457:     echo ""
 458:     warn "NFTBan uses nftables and CANNOT coexist with these firewalls:"
 459:     echo ""
 460:     for issue in "${firewall_issues[@]}"; do
 461:         echo "  ✗ $issue"
 462:     done
 463:     echo ""
 464:     echo "These firewalls will conflict with NFTBan and cause:"
 465:     echo "  • Duplicate filtering rules"
 466:     echo "  • Unpredictable blocking behavior"
 467:     echo "  • Performance degradation"
 468:     echo "  • NFTBan blocks may not work"
 469:     echo ""
 470:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
 471:     echo "MANUAL FIX INSTRUCTIONS:"
 472:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
 473:     echo ""
 474: 
 475:     # Show specific commands for each detected firewall
 476:     for issue in "${firewall_issues[@]}"; do
 477:         if [[ "$issue" == *"firewalld"* ]]; then
 478:             echo "Disable firewalld:"
 479:             echo "  systemctl stop firewalld"
 480:             echo "  systemctl disable firewalld"
 481:             echo ""
 482:         fi
 483:         if [[ "$issue" == *"iptables"* ]]; then
 484:             echo "Disable iptables:"
 485:             echo "  systemctl stop iptables"
 486:             echo "  systemctl disable iptables"
 487:             echo "  systemctl stop ip6tables 2>/dev/null || true"
 488:             echo "  systemctl disable ip6tables 2>/dev/null || true"
 489:             echo ""
 490:         fi
 491:         if [[ "$issue" == *"ufw"* ]]; then
 492:             echo "Disable ufw:"
 493:             echo "  ufw disable"
 494:             echo "  systemctl stop ufw 2>/dev/null || true"
 495:             echo "  systemctl disable ufw 2>/dev/null || true"
 496:             echo ""
 497:         fi
 498:     done
 499: 
 500:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
 501:     echo ""
 502: 
 503:     # Show current firewall rules summary
 504:     analyze_firewall_rules
 505: 
 506:     # Ask user if they want automatic fix
 507:     read -p "Would you like NFTBan to automatically stop and disable these firewalls? [y/N]: " auto_fix
 508: 
 509:     if [[ "${auto_fix,,}" == "y" || "${auto_fix,,}" == "yes" ]]; then
 510:         echo ""
 511: 
 512:         # Backup existing rules before disabling
 513:         backup_firewall_rules || warn "Backup failed, but continuing..."
 514: 
 515:         log "Automatically stopping and disabling conflicting firewalls..."
 516: 
 517:         local fixed=0
 518:         local failed=0
 519: 
 520:         # Fix firewalld
 521:         if systemctl is-active --quiet firewalld 2>/dev/null || systemctl is-enabled --quiet firewalld 2>/dev/null; then
 522:             log "Stopping firewalld..."
 523:             if systemctl stop firewalld 2>/dev/null && systemctl disable firewalld 2>/dev/null; then
 524:                 ok "firewalld stopped and disabled"
 525:                 fixed=$((fixed + 1))
 526:             else
 527:                 warn "Failed to stop/disable firewalld"
 528:                 failed=$((failed + 1))
 529:             fi
 530:         fi
 531: 
 532:         # Fix iptables
 533:         if systemctl is-active --quiet iptables 2>/dev/null || systemctl is-enabled --quiet iptables 2>/dev/null; then
 534:             log "Stopping iptables..."
 535:             if systemctl stop iptables 2>/dev/null && systemctl disable iptables 2>/dev/null; then
 536:                 systemctl stop ip6tables 2>/dev/null || true
 537:                 systemctl disable ip6tables 2>/dev/null || true
 538:                 ok "iptables stopped and disabled"
 539:                 fixed=$((fixed + 1))
 540:             else
 541:                 warn "Failed to stop/disable iptables"
 542:                 failed=$((failed + 1))
 543:             fi
 544:         fi
 545: 
 546:         # Fix ufw
 547:         if command -v ufw &>/dev/null && ufw status 2>/dev/null | grep -q "Status: active"; then
 548:             log "Disabling ufw..."
 549:             if ufw --force disable 2>/dev/null && \
 550:                systemctl stop ufw 2>/dev/null && \
 551:                systemctl disable ufw 2>/dev/null; then
 552:                 ok "ufw disabled"
 553:                 fixed=$((fixed + 1))
 554:             else
 555:                 warn "Failed to disable ufw"
 556:                 failed=$((failed + 1))
 557:             fi
 558:         fi
 559: 
 560:         echo ""
 561:         if [[ $failed -gt 0 ]]; then
 562:             error "Some firewalls could not be disabled automatically"
 563:             echo "Please disable them manually using the commands above."
 564:             exit 1
 565:         else
 566:             ok "All conflicting firewalls have been stopped and disabled ($fixed fixed)"
 567:             echo ""
 568:             info "NFTBan will now take over firewall management using nftables"
 569:         fi
 570:     else
 571:         echo ""
 572:         error "Installation cannot continue with conflicting firewalls active"
 573:         echo ""
 574:         echo "Please disable the conflicting firewalls manually and re-run:"
 575:         echo "  sudo ./install.sh"
 576:         echo ""
 577:         exit 1
 578:     fi
 579: 
 580:     echo ""
 581:     return 0
 582: }

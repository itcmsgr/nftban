202: async function loadAnalyticsData() {
203:     try {
204:         console.log('[ANALYTICS] Loading analytics data...');
205: 
206:         // Call the nftban-core analytics commands via API
207:         // We need to create API endpoints that execute: nftban-core analytics summary --json
208:         // and nftban-core analytics countries --json
209: 
210:         // For now, let's try to fetch from a generic analytics endpoint
211:         // The API handler should execute the CLI commands and return JSON
212: 
213:         const summaryResp = await fetch('/api/v1/analytics/summary', {
214:             headers: window.getAuthHeaders()
215:         }).catch(() => null);
216: 
217:         if (summaryResp && summaryResp.ok) {
218:             const data = await summaryResp.json();
219:             console.log('[ANALYTICS] Summary data:', data);
220: 
221:             if (data.success && data.data) {
222:                 const summary = data.data;
223: 
224:                 // Update summary stats
225:                 document.getElementById('analytics-total-ips').textContent = summary.total_ips || '0';
226:                 document.getElementById('analytics-total-countries').textContent = summary.total_countries || '0';
227:                 document.getElementById('analytics-ipv4-count').textContent = summary.ipv4_count || '0';
228:                 document.getElementById('analytics-ipv6-count').textContent = summary.ipv6_count || '0';
229: 
230:                 if (summary.last_updated) {
231:                     document.getElementById('analytics-last-updated').textContent =
232:                         new Date(summary.last_updated).toLocaleString();
233:                 }
234:             }
235:         }
236: 
237:         // Load countries data
238:         const countriesResp = await fetch('/api/v1/analytics/countries', {
239:             headers: window.getAuthHeaders()
240:         }).catch(() => null);
241: 
242:         if (countriesResp && countriesResp.ok) {
243:             const data = await countriesResp.json();
244:             console.log('[ANALYTICS] Countries data:', data);
245: 
246:             if (data.success && data.data) {
247:                 analyticsData = data.data;
248:                 updateAnalyticsCharts(data.data);
249:                 updateCountriesTable(data.data);
250:             }

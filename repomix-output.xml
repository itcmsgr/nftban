 122: nftban_stats_clear_cache() {
 123:     # Clear all cached statistics
 124:     # Usage: nftban_stats_clear_cache
 125: 
 126:     rm -f "${NFTBAN_STATS_CACHE_DIR}"/*.cache 2>/dev/null || true
 127: 
 128:     if type -t nftban_print_status >/dev/null 2>&1; then
 129:         nftban_print_status "info" "Stats cache cleared"
 130:     else
 131:         echo "[INFO] Stats cache cleared"
 132:     fi

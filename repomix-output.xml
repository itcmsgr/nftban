1233: // SearchHandler searches for an IP across all NFTBan components
1234: func SearchHandler(w http.ResponseWriter, r *http.Request) {
1235: 	ip := r.URL.Query().Get("ip")
1236: 	if ip == "" {
1237: 		respondJSON(w, http.StatusBadRequest, ErrorResponse{Error: "IP parameter is required"})
1238: 		return
1239: 	}
1240: 
1241: 	// Use nftban check command (returns text output)
1242: 	output, err := execNFTBanCommand("check", ip)
1243: 
1244: 	// Parse the text output to build JSON response
1245: 	searchData := map[string]interface{}{
1246: 		"ip":          ip,
1247: 		"found":       false,
1248: 		"whitelisted": false,
1249: 		"blacklisted": false,
1250: 		"in_feeds":    false,
1251: 		"locations":   []string{},
1252: 	}
1253: 
1254: 	if err == nil && output != "" {
1255: 		outputLower := strings.ToLower(output)
1256: 
1257: 		// Check if whitelisted (matches "MATCHED: whitelist_ipv4" or "whitelist" in output)
1258: 		if strings.Contains(outputLower, "whitelist") || strings.Contains(outputLower, "✅ allowed") {
1259: 			searchData["whitelisted"] = true
1260: 			searchData["found"] = true
1261: 			searchData["locations"] = append(searchData["locations"].([]string), "whitelist")
1262: 		}
1263: 
1264: 		// Check if blacklisted (matches "MATCHED: blacklist_ipv4" or "blacklist" in output)
1265: 		if strings.Contains(outputLower, "blacklist") || strings.Contains(outputLower, "❌ blocked") {
1266: 			searchData["blacklisted"] = true
1267: 			searchData["found"] = true
1268: 			searchData["locations"] = append(searchData["locations"].([]string), "blacklist")
1269: 		}
1270: 
1271: 		// Check if in feeds
1272: 		if strings.Contains(outputLower, "found in feeds") || strings.Contains(outputLower, "⚠️  potentially blocked") {
1273: 			searchData["in_feeds"] = true

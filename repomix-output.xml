494: 
495:     local cf_enabled="${CLOUDFLARE_ENABLED:-false}"
496:     local ipv4_enabled="${CLOUDFLARE_IPV4_ENABLED:-true}"
497:     local ipv6_enabled="${CLOUDFLARE_IPV6_ENABLED:-true}"
498:     local auto_update="${CLOUDFLARE_AUTO_UPDATE:-true}"
499: 
500:     echo "📋 Configuration:"

 172: nftban_stats_count_unique_ips() {
 173:     # Count unique IPs banned in time window
 174:     # Usage: nftban_stats_count_unique_ips [since] [until]
 175: 
 176:     local since="${1:-1970-01-01}"
 177:     local until="${2:-$(date +%Y-%m-%d)}"
 178: 
 179:     if [[ ! -f "$NFTBAN_BAN_LOG" ]]; then
 180:         echo "0"
 181:         return 0
 182:     fi
 183: 
 184:     # Try cache
 185:     local cache_key="unique_ips_${since}_${until}"
 186:     if nftban_stats_get_cache "$cache_key"; then
 187:         return 0
 188:     fi
 189: 
 190:     # Count unique IPs
 191:     local count
 192:     count=$(awk -F'|' -v since="$since" -v until="$until" \
 193:         '$1 >= since && $1 <= until && $6 == "BANNED" {ips[$4]=1} END {print length(ips)}' \
 194:         "$NFTBAN_BAN_LOG")
 195: 
 196:     nftban_stats_set_cache "$cache_key" "$count"
 197:     echo "$count"

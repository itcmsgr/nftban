665: # =============================================================================
666: # CLEANUP
667: # =============================================================================
668: 
669: # Cleanup stale tracking entries
670: nftban_portscan_suricata_cleanup() {
671:     local current_time
672:     current_time=$(date +%s)
673:     local alert_window="${PORTSCAN_SURICATA_ALERT_WINDOW}"
674:     local max_tracked="${PORTSCAN_SURICATA_MAX_TRACKED_IPS}"
675: 
676:     # Remove entries older than alert window
677:     for ip in "${!_PORTSCAN_SURICATA_IP_LAST_SEEN[@]}"; do
678:         local last_seen="${_PORTSCAN_SURICATA_IP_LAST_SEEN[$ip]}"
679:         local age
680:         age=$((current_time - last_seen))
681: 
682:         if [[ $age -gt $alert_window ]]; then
683:             # Check if blocked, keep those for longer
684:             if [[ -z "${_PORTSCAN_SURICATA_IP_BLOCKED[$ip]:-}" ]]; then
685:                 unset "_PORTSCAN_SURICATA_IP_SCORES[$ip]"
686:                 unset "_PORTSCAN_SURICATA_IP_ALERTS[$ip]"
687:                 unset "_PORTSCAN_SURICATA_IP_FIRST_SEEN[$ip]"
688:                 unset "_PORTSCAN_SURICATA_IP_LAST_SEEN[$ip]"
689:                 unset "_PORTSCAN_SURICATA_IP_SCAN_TYPES[$ip]"
690:             fi
691:         fi
692:     done
693: 
694:     # If still over limit, remove oldest entries
695:     if [[ ${#_PORTSCAN_SURICATA_IP_SCORES[@]} -gt $max_tracked ]]; then
696:         local count_to_remove
697:         count_to_remove=$((${#_PORTSCAN_SURICATA_IP_SCORES[@]} - max_tracked))
698:         local removed=0
699: 
700:         for ip in "${!_PORTSCAN_SURICATA_IP_LAST_SEEN[@]}"; do
701:             [[ $removed -ge $count_to_remove ]] && break
702:             [[ -n "${_PORTSCAN_SURICATA_IP_BLOCKED[$ip]:-}" ]] && continue
703: 
704:             unset "_PORTSCAN_SURICATA_IP_SCORES[$ip]"
705:             unset "_PORTSCAN_SURICATA_IP_ALERTS[$ip]"
706:             unset "_PORTSCAN_SURICATA_IP_FIRST_SEEN[$ip]"
707:             unset "_PORTSCAN_SURICATA_IP_LAST_SEEN[$ip]"
708:             unset "_PORTSCAN_SURICATA_IP_SCAN_TYPES[$ip]"
709: 
710:             ((removed++))
711:         done
712:     fi
713: 
714:     return 0
715: }

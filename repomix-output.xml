<file path="cli/lib/nftban/core/nftban_report_engine.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan v1.0.0 - Unified Reporting Engine
  4: # =============================================================================
  5: # SPDX-License-Identifier: MPL-2.0
  6: # Purpose: Unified reporting engine
  7: #
  8: # meta:name=nftban_report_engine
  9: # meta:type=core
 10: # meta:header=Unified Reporting Engine
 11: # meta:version=1.0.0
 12: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 13: # meta:homepage=https://nftban.com
 14: #
 15: # **Description & Purpose**
 16: # meta:description=Centralized report generation system with multiple formats and destinations
 17: # meta:input=Report type, format selection, and destination parameters
 18: # meta:output=Reports in text, JSON, or HTML format to terminal, file, or email
 19: #
 20: # **Inventory & Requirements**
 21: # meta:depends=nftban_health.sh,nftban_stats.sh,nftban_fhs_spec.sh
 22: #
 23: # meta:created_date=2025-11-05
 24: # meta:updated_date=2025-11-24
 25: # =============================================================================
 26: 
 27: 
 28: # =============================================================================
 29: # GLOBAL VARIABLES
 30: # =============================================================================
 31: 
 32: declare -g NFTBAN_REPORT_ENGINE_VERSION="1.0.0"
 33: declare -g NFTBAN_REPORT_ENGINE_LOADED=false
 34: 
 35: # Report data structure
 36: declare -gA NFTBAN_REPORT_DATA=()
 37: declare -gA NFTBAN_REPORT_METADATA=()
 38: 
 39: # Default configuration
 40: # Default report settings - reserved for future use
 41: # shellcheck disable=SC2034
 42: declare -g NFTBAN_REPORT_DEFAULT_FORMAT="text"
 43: declare -g NFTBAN_REPORT_DEFAULT_MODE="detailed"
 44: 
 45: # =============================================================================
 46: # INITIALIZATION
 47: # =============================================================================
 48: 
 49: nftban_report_init() {
 50:     # Initialize report engine and load dependencies
 51:     # Usage: nftban_report_init
 52:     # Returns: 0 on success, 1 on error
 53: 
 54:     if [[ "$NFTBAN_REPORT_ENGINE_LOADED" == "true" ]]; then
 55:         return 0
 56:     fi
 57: 
 58:     # Load base library if not already loaded
 59:     if ! declare -f nftban_log >/dev/null 2>&1; then
 60:         if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_base.sh" ]]; then
 61:             source "${NFTBAN_LIB_DIR}/core/nftban_base.sh"
 62:         fi
 63:     fi
 64: 
 65:     # Initialize metadata with defaults
 66:     NFTBAN_REPORT_METADATA["hostname"]="${NFTBAN_REPORT_METADATA[hostname]:-$(hostname -f 2>/dev/null || hostname)}"
 67:     NFTBAN_REPORT_METADATA["timestamp"]="${NFTBAN_REPORT_METADATA[timestamp]:-$(date -u +"%Y-%m-%dT%H:%M:%S%z")}"
 68:     NFTBAN_REPORT_METADATA["date_display"]="${NFTBAN_REPORT_METADATA[date_display]:-$(date "+%Y-%m-%d %H:%M:%S")}"
 69:     NFTBAN_REPORT_METADATA["title"]="${NFTBAN_REPORT_METADATA[title]:-NFTBan Report}"
 70:     NFTBAN_REPORT_METADATA["sections"]="${NFTBAN_REPORT_METADATA[sections]:-health}"
 71:     NFTBAN_REPORT_METADATA["format"]="${NFTBAN_REPORT_METADATA[format]:-text}"
 72:     NFTBAN_REPORT_METADATA["mode"]="${NFTBAN_REPORT_METADATA[mode]:-detailed}"
 73: 
 74:     NFTBAN_REPORT_ENGINE_LOADED=true
 75:     return 0
 76: }
 77: 
 78: # =============================================================================
 79: # MAIN REPORT GENERATOR
 80: # =============================================================================
 81: 
 82: nftban_report_generate() {
 83:     # Generate a report with specified sections, format, and output destination
 84:     # Usage: nftban_report_generate SECTIONS FORMAT OUTPUT_FILE EMAIL [TITLE] [MODE]
 85:     # Arguments:
 86:     #   SECTIONS    - Comma-separated list: health,module,fhs,services,stats,all
 87:     #   FORMAT      - Output format: text, json, html
 88:     #   OUTPUT_FILE - File path to save (empty for stdout)
 89:     #   EMAIL       - Email address to send (empty to skip)
 90:     #   TITLE       - Optional report title
 91:     #   MODE        - Optional mode: summary or detailed (default: detailed)
 92:     # Returns: Exit code of worst section (0=OK, 1=WARNING, 2=ERROR)
 93: 
 94:     nftban_report_init
 95: 
 96:     local sections="${1:-health}"
 97:     local format="${2:-text}"
 98:     local output_file="${3:-}"
 99:     local email="${4:-}"
100:     local title="${5:-NFTBan System Report}"
101:     local mode="${6:-detailed}"
102: 
103:     # Expand "all" to all sections
104:     if [[ "$sections" == "all" ]]; then
105:         sections="health,module,fhs,services,stats"
106:     fi
107: 
108:     # Store report configuration
109:     NFTBAN_REPORT_METADATA["title"]="$title"
110:     NFTBAN_REPORT_METADATA["sections"]="$sections"
111:     NFTBAN_REPORT_METADATA["format"]="$format"
112:     NFTBAN_REPORT_METADATA["mode"]="$mode"
113: 
114:     # Collect data from requested sections
115:     local overall_exit_code=0
116:     local exit_code=0
117: 
118:     IFS=',' read -ra section_array <<< "$sections"
119:     for section in "${section_array[@]}"; do
120:         section=$(echo "$section" | xargs)  # Trim whitespace
121: 
122:         case "$section" in
123:             health)
124:                 nftban_report_collect_health "$mode" || exit_code=$?
125:                 ;;
126:             module)
127:                 nftban_report_collect_module "$mode" || exit_code=$?
128:                 ;;
129:             fhs)
130:                 nftban_report_collect_fhs "$mode" || exit_code=$?
131:                 ;;
132:             services)
133:                 nftban_report_collect_services "$mode" || exit_code=$?
134:                 ;;
135:             stats)
136:                 nftban_report_collect_stats "$mode" || exit_code=$?
137:                 ;;
138:             *)
139:                 echo "Warning: Unknown section '$section'" >&2
140:                 continue
141:                 ;;
142:         esac
143: 
144:         # Track worst exit code
145:         [[ $exit_code -gt $overall_exit_code ]] && overall_exit_code=$exit_code
146:     done
147: 
148:     # Render report in requested format
149:     local report_output=""
150:     case "$format" in
151:         text)
152:             report_output=$(nftban_report_render_text)
153:             ;;
154:         json)
155:             report_output=$(nftban_report_render_json)
156:             ;;
157:         html)
158:             report_output=$(nftban_report_render_html)
159:             ;;
160:         *)
161:             echo "Error: Unknown format '$format'" >&2
162:             return 1
163:             ;;
164:     esac
165: 
166:     # Output to requested destinations
167:     if [[ -n "$output_file" ]]; then
168:         nftban_report_save_file "$report_output" "$output_file" || return 1
169:     fi
170: 
171:     if [[ -n "$email" ]]; then
172:         nftban_report_send_email "$report_output" "$email" "$format" || return 1
173:     fi
174: 
175:     # If no file or email specified, output to stdout
176:     if [[ -z "$output_file" && -z "$email" ]]; then
177:         echo "$report_output"
178:     fi
179: 
180:     return $overall_exit_code
181: }
182: 
183: # =============================================================================
184: # DATA COLLECTION FUNCTIONS
185: # =============================================================================
186: 
187: nftban_report_collect_health() {
188:     # Collect health check data (with optional auto-heal)
189:     # Usage: nftban_report_collect_health MODE [AUTO_HEAL]
190:     # Arguments:
191:     #   MODE      - summary or detailed
192:     #   AUTO_HEAL - 0=check only, 1=auto-heal enabled (optional, default: 0)
193:     # Returns: Health check exit code (0=OK, 1=WARNING, 2=ERROR)
194: 
195:     local mode="${1:-detailed}"
196:     local auto_heal="${2:-0}"
197:     local exit_code=0
198:     local auto_heal_applied=0
199: 
200:     # Load health module
201:     if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_health.sh" ]]; then
202:         source "${NFTBAN_LIB_DIR}/core/nftban_health.sh"
203:     else
204:         NFTBAN_REPORT_DATA["health_error"]="Health module not found"
205:         return 2
206:     fi
207: 
208:     # Run health check (with auto-heal if requested)
209:     if [[ $auto_heal -eq 1 ]]; then
210:         # Capture output to count fixes
211:         local health_output
212:         health_output=$(nftban_health_check_all 1 2>&1) || exit_code=$?
213: 
214:         # Extract auto-heal info from output
215:         if echo "$health_output" | grep -q "Auto-heal complete"; then
216:             auto_heal_applied=$(echo "$health_output" | grep "Auto-heal complete" | sed 's/.*(\([0-9]*\).*/\1/')
217:             NFTBAN_REPORT_DATA["health_auto_heal_fixes"]="$auto_heal_applied"
218:             NFTBAN_REPORT_DATA["health_auto_heal_enabled"]="true"
219:         fi
220:     else
221:         # Standard check without auto-heal
222:         nftban_health_check_all 0 >/dev/null 2>&1 || exit_code=$?
223:         NFTBAN_REPORT_DATA["health_auto_heal_enabled"]="false"
224:     fi
225: 
226:     # Collect summary with auto-heal info
227:     local summary
228:     summary=$(nftban_health_render_summary 2>/dev/null || echo "Health check failed")
229: 
230:     # Append auto-heal info to summary if fixes were applied
231:     if [[ $auto_heal_applied -gt 0 ]]; then
232:         summary="$summary (auto-healed $auto_heal_applied issues)"
233:     fi
234: 
235:     NFTBAN_REPORT_DATA["health_summary"]="$summary"
236:     NFTBAN_REPORT_DATA["health_exit_code"]="$exit_code"
237: 
238:     # Determine status icon for reports
239:     case $exit_code in
240:         0) NFTBAN_REPORT_DATA["health_status"]="✅ HEALTHY" ;;
241:         1) NFTBAN_REPORT_DATA["health_status"]="⚠️  WARNING" ;;
242:         2) NFTBAN_REPORT_DATA["health_status"]="❌ ERROR" ;;
243:         *) NFTBAN_REPORT_DATA["health_status"]="❓ UNKNOWN" ;;
244:     esac
245: 
246:     # Collect detailed if requested
247:     if [[ "$mode" == "detailed" ]]; then
248:         NFTBAN_REPORT_DATA["health_detailed"]=$(nftban_health_render_terminal 2>/dev/null || echo "Detailed output unavailable")
249:     fi
250: 
251:     # Collect JSON data (enhanced with auto-heal info)
252:     local json_data
253:     json_data=$(nftban_health_render_json 2>/dev/null || echo "{}")
254: 
255:     # Add auto-heal info to JSON if present
256:     if [[ $auto_heal -eq 1 ]]; then
257:         json_data=$(echo "$json_data" | jq --arg fixes "$auto_heal_applied" \
258:             '. + {auto_heal_enabled: true, auto_heal_fixes_applied: ($fixes | tonumber)}' 2>/dev/null || echo "$json_data")
259:     fi
260: 
261:     NFTBAN_REPORT_DATA["health_json"]="$json_data"
262: 
263:     return $exit_code
264: }
265: 

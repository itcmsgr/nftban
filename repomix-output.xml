1449:             status=$HEALTH_ERROR
1450:         fi
1451:     fi
1452: 
1453:     # Store results
1454:     if [[ ${#ssh_issues[@]} -gt 0 ]]; then
1455:         NFTBAN_HEALTH_ISSUES["ssh_port"]="${ssh_issues[*]}"
1456:         if [[ $status -eq $HEALTH_ERROR ]]; then
1457:             NFTBAN_HEALTH_ERRORS+=("SSH port issues: ${ssh_issues[*]}")
1458:         else
1459:             NFTBAN_HEALTH_WARNINGS+=("SSH port issues: ${ssh_issues[*]}")
1460:         fi
1461:     fi
1462: 
1463:     NFTBAN_HEALTH_RESULTS["ssh_port"]=$status
1464:     return $status
1465: }

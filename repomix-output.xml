 515: nftban_watchdog_get_top_cpu() {
 516:     # Get top CPU-consuming processes from /proc
 517:     # Stores results in WATCHDOG_RESULTS[top_cpu_*]
 518: 
 519:     if [[ "$NFTBAN_WATCHDOG_PROC_ENABLED" != "true" ]]; then
 520:         return 0
 521:     fi
 522: 
 523:     # Process stats - only some fields used
 524:     # shellcheck disable=SC2034
 525:     local count="${NFTBAN_WATCHDOG_PROC_TOP_COUNT:-10}"
 526:     local -a procs=()
 527: 
 528:     # Read all process stats quickly
 529:     local pid cmdline comm state utime stime
 530:     for proc_dir in /proc/[0-9]*/; do
 531:         pid="${proc_dir#/proc/}"
 532:         pid="${pid%/}"
 533:         [[ ! -d "/proc/$pid" ]] && continue
 534: 
 535:         # Read comm (process name)
 536:         comm=$(cat "/proc/$pid/comm" 2>/dev/null) || continue
 537: 
 538:         # Read stat for CPU time
 539:         local stat_line
 540:         stat_line=$(cat "/proc/$pid/stat" 2>/dev/null) || continue
 541: 
 542:         # Parse stat: pid (comm) state ... utime(14) stime(15)
 543:         # Use awk for reliable parsing
 544:         local cpu_time
 545:         cpu_time=$(echo "$stat_line" | awk '{print $14 + $15}')
 546: 
 547:         # Read status for memory
 548:         local vmrss=0
 549:         while IFS=': ' read -r key value _; do
 550:             [[ "$key" == "VmRSS" ]] && { vmrss=$value; break; }
 551:         done < "/proc/$pid/status" 2>/dev/null
 552: 
 553:         # Store: cpu_time pid vmrss_kb comm
 554:         procs+=("$cpu_time $pid $vmrss $comm")
 555:     done
 556: 
 557:     # Sort by CPU time (descending) and take top N
 558:     local sorted
 559:     sorted=$(printf '%s\n' "${procs[@]}" | sort -rn | head -"$count")
 560: 
 561:     local i=0
 562:     while IFS=' ' read -r cpu_time pid vmrss comm; do
 563:         [[ -z "$pid" ]] && continue
 564:         WATCHDOG_RESULTS["top_cpu_${i}_pid"]="$pid"
 565:         WATCHDOG_RESULTS["top_cpu_${i}_comm"]="$comm"
 566:         WATCHDOG_RESULTS["top_cpu_${i}_cpu_ticks"]="$cpu_time"
 567:         WATCHDOG_RESULTS["top_cpu_${i}_mem_kb"]="$vmrss"
 568:         ((++i)) || true  # Avoid exit code 1 when i was 0
 569:     done <<< "$sorted"
 570: 
 571:     WATCHDOG_RESULTS[top_cpu_count]="$i"
 572:     return 0
 573: }
 574: 
 575: nftban_watchdog_get_top_mem() {
 576:     # Get top memory-consuming processes from /proc
 577:     # Stores results in WATCHDOG_RESULTS[top_mem_*]
 578: 
 579:     if [[ "$NFTBAN_WATCHDOG_PROC_ENABLED" != "true" ]]; then
 580:         return 0
 581:     fi
 582: 
 583:     local count="${NFTBAN_WATCHDOG_PROC_TOP_COUNT:-10}"
 584:     local -a procs=()
 585: 
 586:     # Read all process memory quickly
 587:     for proc_dir in /proc/[0-9]*/; do
 588:         local pid="${proc_dir#/proc/}"
 589:         pid="${pid%/}"
 590:         [[ ! -d "/proc/$pid" ]] && continue
 591: 
 592:         # Read comm (process name)
 593:         local comm
 594:         comm=$(cat "/proc/$pid/comm" 2>/dev/null) || continue
 595: 
 596:         # Read status for memory
 597:         local vmrss=0
 598:         while IFS=': ' read -r key value _; do
 599:             [[ "$key" == "VmRSS" ]] && { vmrss=$value; break; }
 600:         done < "/proc/$pid/status" 2>/dev/null
 601: 
 602:         [[ $vmrss -gt 0 ]] && procs+=("$vmrss $pid $comm")
 603:     done
 604: 
 605:     # Sort by memory (descending) and take top N
 606:     local sorted
 607:     sorted=$(printf '%s\n' "${procs[@]}" | sort -rn | head -"$count")
 608: 
 609:     local i=0
 610:     local alert_threshold_kb
 611:     alert_threshold_kb=$((NFTBAN_WATCHDOG_PROC_MEM_ALERT * 1024))
 612: 
 613:     while IFS=' ' read -r vmrss pid comm; do
 614:         [[ -z "$pid" ]] && continue
 615:         WATCHDOG_RESULTS["top_mem_${i}_pid"]="$pid"
 616:         WATCHDOG_RESULTS["top_mem_${i}_comm"]="$comm"
 617:         WATCHDOG_RESULTS["top_mem_${i}_mem_kb"]="$vmrss"
 618:         WATCHDOG_RESULTS["top_mem_${i}_mem_mb"]=$((vmrss / 1024))
 619: 
 620:         # Alert if single process exceeds threshold
 621:         if [[ $vmrss -ge $alert_threshold_kb && $i -eq 0 ]]; then
 622:             if watchdog_should_alert "proc_mem_$pid"; then
 623:                 watchdog_alert "INFO" "High memory process: $comm (PID $pid) using $((vmrss / 1024)) MB"
 624:             fi
 625:         fi
 626: 
 627:         ((++i)) || true  # Avoid exit code 1 when i was 0
 628:     done <<< "$sorted"
 629: 
 630:     WATCHDOG_RESULTS[top_mem_count]="$i"
 631:     return 0
 632: }

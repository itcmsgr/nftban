<file path="cli/lib/nftban/cli/cmd_geoban.sh">
  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: 
  4: # Source central config for canonical paths (NO HARDCODED FALLBACKS)
  5: # shellcheck source=/etc/nftban/nftban.conf
  6: [[ -f "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf" ]] && source "${NFTBAN_CONFIG_DIR:-/etc/nftban}/nftban.conf"
  7: 
  8: # Load JSON helper for --json support
  9: [[ -z "${NFTBAN_LIB_DIR:-}" ]] && readonly NFTBAN_LIB_DIR="/usr/lib/nftban"
 10: [[ -z "${NFTBAN_CONFIG_DIR:-}" ]] && readonly NFTBAN_CONFIG_DIR="/etc/nftban"
 11: [[ -z "${NFTBAN_DATA_DIR:-}" ]] && readonly NFTBAN_DATA_DIR="/var/lib/nftban"
 12: [[ -z "${NFTBAN_CACHE_DIR:-}" ]] && readonly NFTBAN_CACHE_DIR="/var/cache/nftban"
 13: 
 14: # Load strict mode library
 15: # shellcheck source=/usr/lib/nftban/lib/strict.sh
 16: if [[ -f "${NFTBAN_LIB_DIR}/lib/strict.sh" ]]; then
 17:     source "${NFTBAN_LIB_DIR}/lib/strict.sh"
 18: else
 19:     # Fallback to manual strict mode
 20:     set -Eeuo pipefail
 21: fi
 22: 
 23: # Load version library
 24: # shellcheck source=/usr/lib/nftban/lib/version.sh
 25: if [[ -f "${NFTBAN_LIB_DIR}/lib/version.sh" ]]; then
 26:     source "${NFTBAN_LIB_DIR}/lib/version.sh"
 27: fi
 28: JSON_HELPER="${NFTBAN_LIB_DIR}/helpers/json_output.sh"
 29: if [[ -f "$JSON_HELPER" ]]; then
 30:     # shellcheck source=/dev/null
 31:     source "$JSON_HELPER"
 32: fi
 33: # NFTBan v1.0.0 - GeoBan CLI Handler
 34: # =============================================================================
 35: 
 36: # SPDX-License-Identifier: MPL-2.0
 37: # Purpose: CLI interface for country-based IP blocking (wrapper for geoip)
 38: #
 39: # meta:name=cmd_geoban
 40: # meta:type=cli
 41: # meta:header=GeoBan CLI Handler
 42: # meta:version=1.0.0
 43: # meta:owner="Antonios Voulvoulis <contact@nftban.com>"
 44: # meta:homepage=https://nftban.com
 45: #
 46: # meta:created_date=2025-11-06
 47: # meta:updated_date=2025-11-24
 48: # =============================================================================
 49: 
 50: 
 51: # Enhanced strict mode
 52: IFS=$'\n\t'
 53: umask 027
 54: 
 55: # Prevent double-loading
 56: [[ -n "${NFTBAN_CLI_GEOBAN_LOADED:-}" ]] && return 0
 57: readonly NFTBAN_CLI_GEOBAN_LOADED=1
 58: 
 59: # =============================================================================
 60: 
 61: # MAIN CLI HANDLER
 62: # =============================================================================
 63: 
 64: 
 65: nftban_cmd_geoban() {
 66:     # Main GeoBan command handler - wraps geoip commands
 67:     # Args: subcommand [options]
 68:     #
 69:     # This provides a user-friendly alias:
 70:     #   nftban geoban ban CN    ->  nftban geoban ban CN
 71:     #   nftban geoban whitelist US  ->  nftban geoban whitelist US
 72: 
 73:     local subcommand="${1:-help}"
 74: 
 75:     # Check if --json flag is present - skip banner for JSON output
 76:     local json_mode="false"
 77:     for arg in "$@"; do
 78:         [[ "$arg" == "--json" ]] && json_mode="true"
 79:     done
 80: 
 81:     # Show banner (skip for JSON output)
 82:     if [[ "$json_mode" != "true" ]]; then
 83:         if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_output.sh" ]]; then
 84:             # shellcheck source=/dev/null
 85:             source "${NFTBAN_LIB_DIR}/core/nftban_output.sh"
 86:             if [[ $(type -t nftban_banner) == "function" ]]; then
 87:                 nftban_banner
 88:             fi
 89:         fi
 90:         echo ""
 91:     fi
 92: 
 93:     # Load geoip command handler
 94:     if ! declare -f nftban_cmd_geoip >/dev/null 2>&1; then
 95:         source /usr/lib/nftban/cli/cmd_geoip.sh || {
 96:             echo "ERROR: Failed to load geoip command handler" >&2
 97:             return 1
 98:         }
 99:     fi
100: 
101:     # Map geoban subcommands to geoip subcommands
102:     case "$subcommand" in
103:         stats)
104:             # Stats command for GUI/API - provides JSON output
105:             nftban_geoban_stats "$@"
106:             ;;
107:         ban|unban|whitelist|unwhitelist|list|update|status|config|refresh)
108:             # Pass directly to geoip handler
109:             nftban_cmd_geoip "$@"
110:             ;;
111:         help|--help|-h)
112:             nftban_geoban_help
113:             ;;
114:         *)
115:             echo "ERROR: Unknown geoban command: $subcommand" >&2
116:             nftban_geoban_help
117:             return 1
118:             ;;
119:     esac
120: }
121: 
122: # =============================================================================
123: # STATS FUNCTION (for API/GUI)
124: # =============================================================================
125: 
126: nftban_geoban_stats() {
127:     local json_mode="false"
128: 
129:     # Check for --json flag
130:     for arg in "$@"; do
131:         [[ "$arg" == "--json" ]] && json_mode="true"
132:     done
133: 
134:     # Get banned countries from geoban.d directory
135:     local banned_countries=()
136:     local whitelisted_countries=()
137:     local total_blocked_ips=0
138: 
139:     # Read banned countries
140:     local geoban_dir="${NFTBAN_CONFIG_DIR}/geoban.d"
141:     if [[ -d "$geoban_dir" ]]; then
142:         # Use glob safely - check if files exist
143:         shopt -s nullglob 2>/dev/null || true
144:         for file in "$geoban_dir"/*.conf; do
145:             [[ -f "$file" ]] || continue
146:             local cc
147:             cc=$(basename "$file" .conf)
148:             # Check if it's a ban or whitelist
149:             if grep -q "^MODE=.*ban" "$file" 2>/dev/null; then
150:                 banned_countries+=("$cc")
151:                 # Count IPs in the country file
152:                 local ip_file="${NFTBAN_CACHE_DIR}/geoban/${cc}.txt"
153:                 if [[ -f "$ip_file" ]]; then
154:                     local count
155:                     count=$(wc -l < "$ip_file" 2>/dev/null) || count=0
156:                     total_blocked_ips=$((total_blocked_ips + count))
157:                 fi
158:             elif grep -q "^MODE=.*whitelist" "$file" 2>/dev/null; then
159:                 whitelisted_countries+=("$cc")
160:             fi
161:         done
162:         shopt -u nullglob 2>/dev/null || true
163:     fi
164: 
165:     local banned_count=${#banned_countries[@]}
166:     local whitelisted_count=${#whitelisted_countries[@]}
167: 
168:     # Check if geoip database is available
169:     local geoip_enabled="false"
170:     local db_path="${NFTBAN_DATA_DIR}/geoip/GeoLite2-City.mmdb"
171:     [[ -f "$db_path" ]] && geoip_enabled="true"
172: 
173:     if [[ "$json_mode" == "true" ]] && declare -f json_output >/dev/null 2>&1; then
174:         local banned_json="["
175:         local first=true
176:         for cc in "${banned_countries[@]}"; do
177:             [[ "$first" == "false" ]] && banned_json+=","
178:             banned_json+="\"$cc\""
179:             first=false
180:         done
181:         banned_json+="]"
182: 
183:         local whitelist_json="["
184:         first=true
185:         for cc in "${whitelisted_countries[@]}"; do
186:             [[ "$first" == "false" ]] && whitelist_json+=","
187:             whitelist_json+="\"$cc\""
188:             first=false
189:         done
190:         whitelist_json+="]"
191: 
192:         local data
193:         if command -v jq &>/dev/null; then
194:             data=$(jq -n \
195:                 --argjson banned_count "$banned_count" \
196:                 --argjson whitelisted_count "$whitelisted_count" \
197:                 --argjson total_blocked_ips "$total_blocked_ips" \
198:                 --argjson geoip_enabled "$geoip_enabled" \
199:                 --argjson banned_countries "$banned_json" \
200:                 --argjson whitelisted_countries "$whitelist_json" \
201:                 '{
202:                     geoban: {
203:                         enabled: $geoip_enabled,
204:                         banned_countries: $banned_count,
205:                         whitelisted_countries: $whitelisted_count,
206:                         total_blocked_ips: $total_blocked_ips,
207:                         countries_banned: $banned_countries,
208:                         countries_whitelisted: $whitelisted_countries
209:                     }
210:                 }')
211:         else
212:             data="{\"geoban\":{\"enabled\":$geoip_enabled,\"banned_countries\":$banned_count,\"whitelisted_countries\":$whitelisted_count,\"total_blocked_ips\":$total_blocked_ips,\"countries_banned\":$banned_json,\"countries_whitelisted\":$whitelist_json}}"
213:         fi
214: 
215:         json_output "true" "$data"
216:         return 0
217:     fi
218: 
219:     # Human-readable output
220:     echo "GeoBan Statistics"
221:     echo "================="
222:     echo ""
223:     echo "  GeoIP Enabled:      $geoip_enabled"
224:     echo "  Banned Countries:   $banned_count"
225:     echo "  Whitelisted:        $whitelisted_count"
226:     echo "  Total Blocked IPs:  $total_blocked_ips"
227:     echo ""
228:     if [[ $banned_count -gt 0 ]]; then
229:         echo "  Countries Banned:   ${banned_countries[*]}"
230:     fi
231:     if [[ $whitelisted_count -gt 0 ]]; then
232:         echo "  Countries Allowed:  ${whitelisted_countries[*]}"
233:     fi
234: }
235: 

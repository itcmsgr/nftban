  76: nftban_cmd_status() {
  77:     # Display global system status overview
  78:     # Args: [--json] [--quiet]
  79: 
  80:     local json_mode=0
  81:     local quiet_mode=0
  82: 
  83:     # Parse arguments
  84:     while [[ $# -gt 0 ]]; do
  85:         case "$1" in
  86:             --json)
  87:                 json_mode=1
  88:                 shift
  89:                 ;;
  90:             --quiet)
  91:                 quiet_mode=1
  92:                 shift
  93:                 ;;
  94:             help|--help|-h)
  95:                 show_usage
  96:                 return 0
  97:                 ;;
  98:             *)
  99:                 echo "ERROR: Unknown option: $1" >&2
 100:                 echo "" >&2
 101:                 show_usage
 102:                 return 1
 103:                 ;;
 104:         esac
 105:     done
 106: 
 107:     # Show unified banner with health indicator (skip for JSON/quiet output)
 108:     if [[ $json_mode -eq 0 ]] && [[ $quiet_mode -eq 0 ]]; then
 109:         if [[ -f "${NFTBAN_LIB_DIR}/core/nftban_output.sh" ]]; then
 110:             # shellcheck source=/dev/null
 111:             source "${NFTBAN_LIB_DIR}/core/nftban_output.sh"
 112:             # Use unified banner with health indicator
 113:             if [[ $(type -t nftban_banner_unified) == "function" ]]; then
 114:                 nftban_banner_unified "status"
 115:             elif [[ $(type -t nftban_banner) == "function" ]]; then
 116:                 nftban_banner
 117:             fi
 118:         fi
 119:     fi
 120: 
 121:     # JSON mode
 122:     if [[ $json_mode -eq 1 ]]; then
 123:         output_json
 124:         return $?
 125:     fi
 126: 
 127:     # Terminal mode (default)
 128:     output_terminal "$quiet_mode"
 129:     return $?
 130: }
 131: 
 132: output_terminal() {
 133:     # Output formatted terminal status - Clean professional layout v1.0
 134:     local quiet_mode="$1"
 135: 
 136:     # Header with version
 137:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
 138:     echo "  NFTBan v${NFTBAN_VERSION:-1.0.0} — System Status"
 139:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
 140:     echo ""
 141: 
 142:     # ─────────────────────────────────────────────────────────────────────
 143:     # SYSTEM
 144:     # ─────────────────────────────────────────────────────────────────────
 145:     echo "SYSTEM"
 146:     echo "───────────────────────────────────────────────────────────────"
 147:     printf "  %-20s %s\n" "Hostname............" "$(hostname)"
 148:     printf "  %-20s %s\n" "Kernel.............." "$(uname -r)"
 149:     printf "  %-20s %s\n" "Uptime.............." "$(uptime -p 2>/dev/null | sed 's/^up //' || uptime | awk '{print $3, $4}' | sed 's/,$//')"
 150:     printf "  %-20s %s\n" "NFTBan.............." "v${NFTBAN_VERSION:-unknown}"
 151:     echo ""
 152: 
 153:     # ─────────────────────────────────────────────────────────────────────
 154:     # FIREWALL
 155:     # ─────────────────────────────────────────────────────────────────────
 156:     echo "FIREWALL"
 157:     echo "───────────────────────────────────────────────────────────────"
 158: 
 159:     local nft_status="INACTIVE"
 160:     if systemctl is-active nftables.service >/dev/null 2>&1; then
 161:         nft_status="ACTIVE"
 162:     fi
 163:     printf "  %-20s %s\n" "nftables............" "$nft_status"
 164: 
 165:     # Count rules (using -a to show handles, then count them)
 166:     local rule_count=0
 167:     if command -v nft >/dev/null 2>&1; then
 168:         # nft -a shows "# handle N" for each rule - count those
 169:         rule_count=$(nft -a list table ${NFTBAN_TABLE_IPV4} 2>/dev/null | grep -c "# handle" 2>/dev/null || true)
 170:         rule_count="${rule_count:-0}"
 171:     fi
 172:     printf "  %-20s %s\n" "Rules..............." "$rule_count"
 173: 
 174:     # Count banned IPs (use centralized function)
 175:     local ban_count=0
 176:     if declare -f nftban_stats_count_active_bans >/dev/null 2>&1; then
 177:         ban_count=$(nftban_stats_count_active_bans)
 178:     fi
 179:     printf "  %-20s %s\n" "Banned IPs.........." "$ban_count"
 180: 
 181:     # Count whitelisted IPs (from nftables)
 182:     local whitelist_count=0
 183:     if command -v nft >/dev/null 2>&1; then
 184:         local wl_v4; wl_v4=$(nft list set ${NFTBAN_TABLE_IPV4} whitelist_ipv4 2>/dev/null | grep -oP 'd+.d+.d+.d+' 2>/dev/null | wc -l | xargs)
 185:         local wl_v6; wl_v6=$(nft list set ${NFTBAN_TABLE_IPV6} whitelist_ipv6 2>/dev/null | grep -oP '[0-9a-fA-F:]+' | grep ':' 2>/dev/null | wc -l | xargs)
 186:         # Ensure valid numbers (strip any whitespace/newlines)
 187:         wl_v4=${wl_v4:-0}
 188:         wl_v6=${wl_v6:-0}
 189:         whitelist_count=$((wl_v4 + wl_v6))
 190:     fi
 191:     printf "  %-20s %s\n" "Whitelisted IPs....." "$whitelist_count"
 192: 
 193:     # Check master switch
 194:     local master_enabled="true"
 195:     if [[ -f "${NFTBAN_CONFIG_DIR}/conf.d/services.conf.local" ]]; then
 196:         source "${NFTBAN_CONFIG_DIR}/conf.d/services.conf.local" 2>/dev/null || true
 197:         master_enabled="${NFTBAN_ENABLED:-true}"
 198:     fi
 199: 
 200:     local master_status="ENABLED"
 201:     if grep -q 'nftban=disabled' /proc/cmdline 2>/dev/null; then
 202:         master_status="DISABLED (kernel)"
 203:     elif [[ "$master_enabled" == "false" ]]; then
 204:         master_status="DISABLED (config)"
 205:     fi
 206:     printf "  %-20s %s\n" "Master Control......" "$master_status"
 207: 
 208:     # Helpful hints (only in non-quiet mode)
 209:     if [[ $quiet_mode -eq 0 ]] && [[ $ban_count -gt 0 || $whitelist_count -gt 0 ]]; then
 210:         echo ""
 211:         echo "  Quick Commands:"
 212:         if [[ $ban_count -gt 0 ]]; then
 213:             echo "    View banned IPs:     nftban list banned"
 214:         fi
 215:         if [[ $whitelist_count -gt 0 ]]; then
 216:             echo "    View whitelist:      nftban list whitelist"
 217:         fi
 218:         echo "    View all:            nftban list all"
 219:     fi
 220:     echo ""
 221: 
 222:     # ─────────────────────────────────────────────────────────────────────
 223:     # SERVICES
 224:     # ─────────────────────────────────────────────────────────────────────
 225:     echo "SERVICES"
 226:     echo "───────────────────────────────────────────────────────────────"
 227: 
 228:     check_service_clean "nftables" "nftables.service"
 229:     check_service_clean "suricata" "suricata.service"
 230:     check_service_clean "nftban-api" "${NFTBAN_SERVICE_UI:-nftban-ui.service}"
 231:     check_service_clean "nftban-suricata" "${NFTBAN_SERVICE_SURICATA:-nftban-suricata.service}"
 232:     check_service_clean "login-monitor" "${NFTBAN_SERVICE_LOGIN_MONITOR:-nftban-login-monitor.service}"
 233:     check_service_clean "metrics-exporter" "${NFTBAN_SERVICE_METRICS_EXPORTER:-nftban-metrics-exporter.service}"
 234:     echo ""
 235: 
 236:     # ─────────────────────────────────────────────────────────────────────
 237:     # PROTECTION MODULES
 238:     # ─────────────────────────────────────────────────────────────────────
 239:     echo "PROTECTION MODULES"
 240:     echo "───────────────────────────────────────────────────────────────"
 241: 
 242:     # Suricata IDS
 243:     local suricata_status="NOT INSTALLED"
 244:     if systemctl is-active suricata.service >/dev/null 2>&1; then
 245:         if systemctl is-active nftban-suricata.service >/dev/null 2>&1; then
 246:             suricata_status="ACTIVE (IDS + Banning)"
 247:         else
 248:             suricata_status="ACTIVE (IDS only)"
 249:         fi
 250:     elif command -v suricata &>/dev/null; then
 251:         suricata_status="INSTALLED (stopped)"
 252:     fi
 253:     printf "  %-20s %s\n" "Suricata IDS........" "$suricata_status"
 254: 
 255:     # DDoS Protection (check config directly to avoid recursion)
 256:     local ddos_status="DISABLED"
 257:     local ddos_main="${NFTBAN_CONFIG_DIR}/conf.d/ddos/main.conf"
 258:     local ddos_local="${NFTBAN_CONFIG_DIR}/conf.d/ddos/main.conf.local"
 259:     local ddos_enabled="false"
 260: 
 261:     # Load ddos config (new directory structure)
 262:     [[ -f "$ddos_main" ]] && source "$ddos_main" 2>/dev/null || true
 263:     [[ -f "$ddos_local" ]] && source "$ddos_local" 2>/dev/null || true
 264:     ddos_enabled="${DDOS_ENABLED:-${NFTBAN_DDOS_ENABLED:-false}}"
 265: 
 266:     if [[ "$ddos_enabled" == "true" ]]; then
 267:         ddos_status="ENABLED"
 268:     fi
 269:     printf "  %-20s %s\n" "DDoS................" "$ddos_status"
 270: 
 271:     # Port-scan Detection (check config directly to avoid recursion)
 272:     local portscan_status="DISABLED"
 273:     local portscan_main="${NFTBAN_CONFIG_DIR}/conf.d/portscan/main.conf"
 274:     local portscan_local="${NFTBAN_CONFIG_DIR}/conf.d/portscan/main.conf.local"
 275:     local portscan_enabled="false"
 276: 
 277:     # Load portscan config (new directory structure)
 278:     [[ -f "$portscan_main" ]] && source "$portscan_main" 2>/dev/null || true
 279:     [[ -f "$portscan_local" ]] && source "$portscan_local" 2>/dev/null || true
 280:     portscan_enabled="${PORTSCAN_ENABLED:-false}"
 281: 
 282:     if [[ "$portscan_enabled" == "true" ]]; then
 283:         if systemctl is-active suricata.service >/dev/null 2>&1; then
 284:             portscan_status="ENABLED (Suricata mode)"
 285:         else
 286:             portscan_status="ENABLED (Standalone)"
 287:         fi
 288:     elif systemctl is-active suricata.service >/dev/null 2>&1; then
 289:         portscan_status="AVAILABLE (not enabled)"
 290:     fi
 291:     printf "  %-20s %s\n" "Port Scan..........." "$portscan_status"
 292: 
 293:     # Protection module explanation (if not quiet mode)
 294:     if [[ $quiet_mode -eq 0 ]]; then
 295:         local show_note=false
 296: 
 297:         # Show note if portscan or ddos are enabled
 298:         if [[ "$portscan_enabled" == "true" ]] || [[ "$ddos_enabled" == "true" ]]; then
 299:             show_note=true
 300:         fi
 301: 
 302:         if [[ "$show_note" == "true" ]]; then
 303:             echo ""
 304:             echo "  Detection Modes:"
 305:             if [[ "$portscan_enabled" == "true" ]]; then
 306:                 if systemctl is-active suricata.service >/dev/null 2>&1; then
 307:                     echo "    Port Scan: Using Suricata IDS (deep packet inspection)"
 308:                 else
 309:                     echo "    Port Scan: Standalone mode (kernel log monitoring)"
 310:                 fi
 311:             fi
 312:             if [[ "$ddos_enabled" == "true" ]]; then
 313:                 echo "    DDoS: Active (connection rate limiting + SYN flood protection)"
 314:             fi
 315:             echo ""
 316:             echo "  View details: nftban portscan status | nftban ddos status"
 317:         fi
 318:     fi
 319:     echo ""
 320: 
 321:     # Trust Feeds (CDN whitelist - including Cloudflare)
 322:     local trust_status="UNKNOWN"
 323:     local trust_count=0
 324:     if command -v nftban-core &>/dev/null; then
 325:         local trust_output
 326:         trust_output=$(nftban-core trust list 2>/dev/null) || true
 327:         trust_count=$(echo "$trust_output" | grep -c "enabled" 2>/dev/null) || trust_count=0
 328:         if [[ $trust_count -gt 0 ]]; then
 329:             trust_status="ENABLED ($trust_count feeds)"
 330:         else
 331:             trust_status="DISABLED"
 332:         fi
 333:     fi
 334:     printf "  %-20s %s\n" "Trust Feeds........." "$trust_status"
 335: 
 336:     # Feeds
 337:     local feeds_enabled=0
 338:     if [[ -d "${NFTBAN_DATA_DIR}/feeds" ]]; then
 339:         feeds_enabled=$(find "${NFTBAN_DATA_DIR}/feeds" -name "*.txt" -type f 2>/dev/null | wc -l)
 340:     fi
 341:     printf "  %-20s %s Active\n" "Threat Feeds........" "$feeds_enabled"
 342: 
 343:     # Login Monitor
 344:     local login_status="UNKNOWN"
 345:     local login_details=""
 346:     if systemctl is-active nftban-login-monitor.service >/dev/null 2>&1; then
 347:         login_status="ACTIVE"
 348:         # Get monitoring targets from config
 349:         local login_conf="${NFTBAN_CONFIG_DIR}/conf.d/login_alert.conf"
 350:         local login_local="${NFTBAN_CONFIG_DIR}/conf.d/login_alert.conf.local"
 351:         [[ -f "$login_conf" ]] && source "$login_conf" 2>/dev/null || true
 352:         [[ -f "$login_local" ]] && source "$login_local" 2>/dev/null || true
 353: 
 354:         local monitors=""
 355:         [[ "${NFTBAN_LOGIN_ALERT_SSH:-true}" == "true" ]] && monitors="${monitors}SSH, "
 356:         [[ "${NFTBAN_LOGIN_ALERT_SU:-true}" == "true" ]] && monitors="${monitors}SU, "
 357:         [[ "${NFTBAN_LOGIN_ALERT_SUDO:-true}" == "true" ]] && monitors="${monitors}SUDO, "
 358:         monitors="${monitors%, }"
 359:         [[ -n "$monitors" ]] && login_details="$monitors"
 360:     elif command -v nftban &>/dev/null; then
 361:         local login_output
 362:         login_output=$(nftban login status 2>/dev/null | grep "Enabled:" | head -1) || true
 363:         if [[ "$login_output" =~ "true" ]]; then
 364:             login_status="ENABLED (stopped)"
 365:         elif [[ "$login_output" =~ "false" ]]; then
 366:             login_status="DISABLED"
 367:         fi
 368:     fi
 369:     printf "  %-20s %s\n" "Login Monitor......." "$login_status"
 370:     [[ -n "$login_details" ]] && printf "      %-16s %s\n" "Watching........" "$login_details"
 371: 
 372:     # GeoIP/GeoBan
 373:     local geoip_db="${NFTBAN_DATA_DIR}/geoip/GeoLite2-City.mmdb"
 374:     local geoban_status="NOT INSTALLED"
 375:     if [[ -f "$geoip_db" ]]; then
 376:         local db_size db_date
 377:         db_size=$(du -h "$geoip_db" 2>/dev/null | awk '{print $1}' || echo "?")
 378:         db_date=$(stat -c %y "$geoip_db" 2>/dev/null | cut -d' ' -f1 || echo "?")
 379: 
 380:         local banned_countries
 381:         banned_countries=$(nftban geoban list 2>/dev/null | grep -c "BLOCKED" 2>/dev/null || echo "0")
 382:         banned_countries=$(echo "$banned_countries" | tr -d '\n' | tr -d ' ')
 383: 
 384:         if [[ "$banned_countries" =~ ^[0-9]+$ ]] && [[ "$banned_countries" -gt 0 ]]; then
 385:             geoban_status="ACTIVE ($banned_countries countries blocked)"
 386:         else
 387:             geoban_status="READY (DB: $db_size, $db_date)"
 388:         fi
 389:     fi
 390:     printf "  %-20s %s\n" "GeoIP / GeoBan......" "$geoban_status"
 391: 
 392:     # Metrics Database
 393:     local metrics_db_status="NOT INSTALLED"
 394:     local prom_running=false vm_running=false
 395:     systemctl is-active prometheus >/dev/null 2>&1 && prom_running=true
 396:     systemctl is-active victoriametrics >/dev/null 2>&1 && vm_running=true
 397:     if [[ "$prom_running" == "true" ]]; then
 398:         metrics_db_status="Prometheus (running)"
 399:     elif [[ "$vm_running" == "true" ]]; then
 400:         metrics_db_status="VictoriaMetrics (running)"
 401:     elif systemctl list-unit-files 2>/dev/null | grep -qE "^(prometheus|victoriametrics).service"; then
 402:         metrics_db_status="INSTALLED (stopped)"
 403:     fi
 404:     printf "  %-20s %s\n" "Metrics DB.........." "$metrics_db_status"
 405: 
 406:     # Metrics Exporter
 407:     local metrics_exp_status="NOT INSTALLED"
 408:     if systemctl is-active nftban-metrics-exporter.timer >/dev/null 2>&1 || \
 409:        systemctl is-active nftban-metrics-exporter.service >/dev/null 2>&1; then
 410:         metrics_exp_status="ACTIVE"
 411:     elif systemctl list-unit-files 2>/dev/null | grep -q "nftban-metrics-exporter"; then
 412:         metrics_exp_status="INACTIVE"
 413:     fi
 414:     printf "  %-20s %s\n" "Metrics Exporter...." "$metrics_exp_status"
 415: 
 416:     # GUI
 417:     local gui_status="NOT INSTALLED"
 418:     if systemctl is-active nftban-ui >/dev/null 2>&1; then
 419:         gui_status="ACTIVE"
 420:     elif systemctl list-unit-files 2>/dev/null | grep -q nftban-ui; then
 421:         gui_status="INACTIVE"
 422:     fi
 423:     printf "  %-20s %s\n" "GUI................." "$gui_status"
 424:     echo ""
 425: 
 426:     # ─────────────────────────────────────────────────────────────────────
 427:     # HEALTH
 428:     # ─────────────────────────────────────────────────────────────────────
 429:     echo "HEALTH"
 430:     echo "───────────────────────────────────────────────────────────────"
 431: 
 432:     # Load health module
 433:     # Read from health cache (written by nftban-health.timer)
 434:     local health_cache="${NFTBAN_CACHE_DIR:-/var/cache/nftban}/health/health_status.cache"
 435:     local health_status="UNKNOWN"
 436: 
 437:     if [[ -r "$health_cache" ]]; then
 438:         health_status=$(cat "$health_cache" 2>/dev/null) || health_status="UNKNOWN"
 439:     fi
 440: 
 441:     printf "  %-20s %s\n" "Overall Status......" "$health_status"
 442: 
 443:     # Quick security hardening check (systemd NoNewPrivileges)
 444:     local security_issues=0
 445:     local systemd_unit_paths=("/etc/systemd/system" "/usr/lib/systemd/system" "/lib/systemd/system")
 446:     for unit_path in "${systemd_unit_paths[@]}"; do
 447:         if [[ -d "$unit_path" ]]; then
 448:             security_issues=$(find "$unit_path" -maxdepth 1 -name 'nftban*.service' -type f -exec grep -l '^\s*NoNewPrivileges\s*=\s*false\s*$' {} + 2>/dev/null | wc -l)
 449:             [[ $security_issues -gt 0 ]] && break
 450:         fi
 451:     done
 452: 
 453:     local security_status="✅ OK"
 454:     if [[ $security_issues -gt 0 ]]; then
 455:         security_status="⚠️  ${security_issues} systemd hardening issue(s)"
 456:     fi
 457:     printf "  %-20s %s\n" "Security Hardening.." "$security_status"
 458: 
 459:     # Show hints if not OK
 460:     if [[ "$health_status" != "OK" ]] || [[ $security_issues -gt 0 ]] && [[ $quiet_mode -eq 0 ]]; then
 461:         echo "      → Run: nftban health check"
 462:         echo "      → Auto-fix: nftban health check --auto-heal"
 463:     fi
 464:     echo ""
 465: 
 466:     # ─────────────────────────────────────────────────────────────────────
 467:     # RECENT ACTIVITY
 468:     # ─────────────────────────────────────────────────────────────────────
 469:     echo "RECENT ACTIVITY"
 470:     echo "───────────────────────────────────────────────────────────────"
 471: 
 472:     # Count bans in last 24 hours from bans.log (consistent with nftban stats)
 473:     local bans_24h="0"
 474:     local unbans_24h="0"
 475:     local ban_log="${NFTBAN_LOG_DIR}/bans.log"
 476:     local since_date
 477:     local until_date
 478:     since_date=$(date -d '24 hours ago' +%Y-%m-%d)
 479:     until_date=$(date +%Y-%m-%d)
 480: 
 481:     if [[ -r "$ban_log" ]]; then
 482:         # Use awk to count bans in last 24 hours (same logic as nftban_stats_count_bans)
 483:         bans_24h=$(awk -F'|' -v since="$since_date" -v until="$until_date" \
 484:             '$1 >= since && $1 <= until && $6 == "BANNED" {count++} END {print count+0}' \
 485:             "$ban_log" 2>/dev/null) || bans_24h=0
 486:         unbans_24h=$(awk -F'|' -v since="$since_date" -v until="$until_date" \
 487:             '$1 >= since && $1 <= until && $6 == "UNBANNED" {count++} END {print count+0}' \
 488:             "$ban_log" 2>/dev/null) || unbans_24h=0
 489:     fi
 490: 
 491:     printf "  %-20s %s\n" "Bans (24h).........." "$bans_24h"
 492:     printf "  %-20s %s\n" "Unbans (24h)........" "$unbans_24h"
 493:     echo ""
 494: 
 495:     # ─────────────────────────────────────────────────────────────────────
 496:     # TIMERS
 497:     # ─────────────────────────────────────────────────────────────────────
 498:     echo "TIMERS"
 499:     echo "───────────────────────────────────────────────────────────────"
 500: 
 501:     # Define all NFTBan timers with their descriptions
 502:     local -A timer_desc=(
 503:         ["nftban-health.timer"]="Health check"
 504:         ["nftban-maintenance.timer"]="Maintenance tasks"
 505:         ["nftban-metrics-exporter.timer"]="Prometheus metrics"
 506:         ["nftban-core-feeds.timer"]="Threat feeds update"
 507:         ["nftban-core-geoip.timer"]="GeoIP database update"
 508:         ["nftban-queue.timer"]="Queue processing"
 509:         ["nftban-suricata-update.timer"]="Suricata rules update"
 510:         ["nftban-snapshot.timer"]="Snapshot creation"
 511:         ["nftban-rollback.timer"]="Rollback check"
 512:     )
 513: 
 514:     local timer_count=0
 515:     local timer_active=0
 516:     local timer_output=""
 517: 
 518:     for timer in "${!timer_desc[@]}"; do
 519:         if systemctl list-unit-files "$timer" --no-legend 2>/dev/null | grep -q "$timer"; then
 520:             timer_count=$((timer_count + 1))
 521:             local status_text="INACTIVE"
 522:             local next_run=""
 523: 
 524:             if systemctl is-active "$timer" >/dev/null 2>&1; then
 525:                 timer_active=$((timer_active + 1))
 526: 
 527:                 # Get next run time
 528:                 next_run=$(systemctl list-timers "$timer" --no-legend 2>/dev/null | awk '{
 529:                     if (NF >= 6) { print $5, $6 }
 530:                     else if (NF >= 2) { print $1, $2 }
 531:                 }' || true)
 532: 
 533:                 if [[ -n "$next_run" ]] && [[ "$next_run" != "n/a" ]]; then
 534:                     status_text="OK — next in $next_run"
 535:                 else
 536:                     status_text="ACTIVE"
 537:                 fi
 538:             elif systemctl is-enabled "$timer" >/dev/null 2>&1; then
 539:                 status_text="ENABLED (stopped)"
 540:             fi
 541: 
 542:             # Format timer name (remove .timer suffix and prefix)
 543:             local timer_name="${timer%.timer}"
 544:             timer_name="${timer_name#nftban-}"
 545:             [[ "$timer_name" == "nftban" ]] && timer_name="main"
 546:             timer_name=$(printf "%-16s" "$timer_name")
 547:             timer_name="${timer_name// /.}"
 548: 
 549:             timer_output+=$(printf "  %s %s\n" "$timer_name" "$status_text")
 550:             timer_output+=$'\n'
 551:         fi
 552:     done
 553: 
 554:     if [[ $timer_count -gt 0 ]]; then
 555:         printf "  %-20s %s\n" "Active timers......." "$timer_active / $timer_count"
 556:         echo ""
 557:         echo -n "$timer_output"
 558:     else
 559:         printf "  %-20s %s\n" "Active timers......." "None installed"
 560:     fi
 561: 
 562:     # Timer status explanation
 563:     if [[ $timer_count -gt 0 ]] && [[ $quiet_mode -eq 0 ]]; then
 564:         echo "  Timer Status Guide:"
 565:         echo "    OK              - Running automatically"
 566:         echo "    ENABLED (stopped) - Will start at boot (or run: systemctl start <timer>)"
 567:         echo "    INACTIVE        - Disabled (optional feature)"
 568:         echo ""
 569:         if [[ $timer_active -lt $timer_count ]]; then
 570:             echo "  To enable all timers: nftban timers enable"
 571:         fi
 572:     fi
 573:     echo ""
 574: 
 575:     # ─────────────────────────────────────────────────────────────────────
 576:     # LOGS
 577:     # ─────────────────────────────────────────────────────────────────────
 578:     echo "LOGS"
 579:     echo "───────────────────────────────────────────────────────────────"
 580: 
 581:     local log_rotation_status="NOT CONFIGURED"
 582:     local log_size="N/A"
 583:     local last_rotate="N/A"
 584: 
 585:     if [[ -f /etc/logrotate.d/nftban ]]; then
 586:         log_rotation_status="CONFIGURED"
 587:     fi
 588: 
 589:     if [[ -d "${NFTBAN_LOG_DIR}" ]]; then
 590:         log_size=$(du -sh "${NFTBAN_LOG_DIR}" 2>/dev/null | awk '{print $1}' || echo "N/A")
 591:     fi
 592: 
 593:     if [[ -f /var/lib/logrotate/status ]] && grep -q "nftban" /var/lib/logrotate/status 2>/dev/null; then
 594:         last_rotate=$(grep "nftban" /var/lib/logrotate/status 2>/dev/null | head -1 | awk '{print $NF}' || echo "N/A")
 595:     elif [[ -f /var/lib/logrotate.status ]] && grep -q "nftban" /var/lib/logrotate.status 2>/dev/null; then
 596:         last_rotate=$(grep "nftban" /var/lib/logrotate.status 2>/dev/null | head -1 | awk '{print $NF}' || echo "N/A")
 597:     fi
 598: 
 599:     printf "  %-20s %s\n" "Log rotation........" "$log_rotation_status"
 600:     printf "  %-20s %s\n" "Size................" "$log_size"
 601:     printf "  %-20s %s\n" "Last rotation......." "$last_rotate"
 602:     echo ""
 603: 
 604:     # ─────────────────────────────────────────────────────────────────────
 605:     # SYSTEM REQUIREMENTS
 606:     # ─────────────────────────────────────────────────────────────────────
 607:     echo "SYSTEM REQUIREMENTS"
 608:     echo "───────────────────────────────────────────────────────────────"
 609: 
 610:     # Check DNS
 611:     local dns_status="NOT WORKING"
 612:     if host google.com >/dev/null 2>&1 || nslookup google.com >/dev/null 2>&1; then
 613:         dns_status="OK"
 614:     fi
 615:     printf "  %-20s %s\n" "DNS................." "$dns_status"
 616: 
 617:     # Check Email capability
 618:     local email_status="NOT CONFIGURED"
 619:     local email_working=false
 620:     if [[ -f "${NFTBAN_CONFIG_DIR}/conf.d/mail.conf" ]]; then
 621:         if grep -q "MAIL_ENABLED=true" "${NFTBAN_CONFIG_DIR}/conf.d/mail.conf" 2>/dev/null; then
 622:             if command -v sendmail >/dev/null 2>&1 || \
 623:                command -v msmtp >/dev/null 2>&1 || \
 624:                command -v mailx >/dev/null 2>&1; then
 625:                 email_status="CONFIGURED"
 626:                 email_working=true  # shellcheck disable=SC2034  # Reserved for email test status
 627:             else
 628:                 email_status="CONFIGURED (no mail cmd)"
 629:             fi
 630:         fi
 631:     fi
 632:     printf "  %-20s %s\n" "Email..............." "$email_status"
 633: 
 634:     # Check Auto-Reports
 635:     local report_status="DISABLED"
 636:     if [[ -d "${NFTBAN_DATA_DIR}/reports" ]]; then
 637:         local report_count
 638:         report_count=$(find "${NFTBAN_DATA_DIR}/reports" -type f \( -name "*.html" -o -name "*.json" \) 2>/dev/null | wc -l)
 639:         if [[ $report_count -gt 0 ]]; then
 640:             report_status="ENABLED ($report_count reports)"
 641:         else
 642:             report_status="ENABLED (no reports yet)"
 643:         fi
 644:     fi
 645:     printf "  %-20s %s\n" "Auto-Reports........" "$report_status"
 646:     echo "      → ${NFTBAN_DATA_DIR}/reports/"
 647:     echo ""
 648: 
 649:     # ─────────────────────────────────────────────────────────────────────
 650:     # QUICK COMMANDS
 651:     # ─────────────────────────────────────────────────────────────────────
 652:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
 653:     echo "QUICK COMMANDS"
 654:     echo "  nftban menu              Interactive TUI menu"
 655:     echo "  nftban health check      Full diagnostics"
 656:     echo "  nftban stats dashboard   Detailed statistics"
 657:     echo "  nftban firewall status   Firewall details"
 658:     echo "  nftban help              Show all commands"
 659:     echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
 660: 
 661:     return 0
 662: }

# =============================================================================
# NFTBan - RBL Check Timer
# =============================================================================
# SPDX-License-Identifier: MPL-2.0
# meta:name="nftban-rbl-check.timer"
# meta:type="systemd"
# meta:tier="OPTIONAL"
# meta:owner="Antonios Voulvoulis <contact@nftban.com>"
# meta:description="Timer for twice-daily RBL checking schedule (every 12 hours)"
# meta:inventory.files=""
# meta:inventory.binaries=""
# meta:inventory.env_vars=""
# meta:inventory.config_files=""
# meta:inventory.systemd_units="nftban-rbl-check.service"
# meta:inventory.network=""
# meta:inventory.privileges="root"
# =============================================================================

[Unit]
# v1.235 R-DEC: kernel parameter nftban=disabled = per-boot emergency bypass of NFTBan.
# systemd enforces this on every start path (socket, Requires=, timer, installer, self-heal).
ConditionKernelCommandLine=!nftban=disabled
# v1.235 D10: while a commit-confirm rollback has FAILED, nothing may apply another state.
ConditionPathExists=!/var/lib/nftban/state/commit-confirm.rollback-failed
Description=NFTBan RBL Check 12-Hour Timer
Documentation=https://nftban.com/docs/rbl
After=network-online.target
Wants=network-online.target

[Timer]
# Run twice daily at 02:00 and 14:00 (every 12 hours)
OnCalendar=*-*-* 02:00:00
OnCalendar=*-*-* 14:00:00

# JITTER: 15m variance for 12-hour task
RandomizedDelaySec=15m

# DETERMINISTIC: Same offset per host for predictable behavior
FixedRandomDelay=true

# Persist if missed
Persistent=true

# If system was off during scheduled time, run on next boot
OnBootSec=10min

# Accuracy (how close to target time)
AccuracySec=1min

[Install]
WantedBy=timers.target

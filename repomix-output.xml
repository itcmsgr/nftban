1672: # Auto-detect SSH port from sshd_config and whitelist it
1673: _install_auto_whitelist_ssh_port() {
1674:     local ports_dir="/etc/nftban/ports.d"
1675:     local ssh_conf="${ports_dir}/00-ssh.conf"
1676:     local sshd_config="/etc/ssh/sshd_config"
1677:     local ssh_port="22"
1678: 
1679:     # Try to detect SSH port from sshd_config
1680:     if [[ -f "$sshd_config" ]]; then
1681:         local detected_port
1682:         detected_port=$(grep -E "^Port\s+" "$sshd_config" 2>/dev/null | awk '{print $2}' | head -1)
1683:         if [[ -n "$detected_port" && "$detected_port" =~ ^[0-9]+$ ]]; then
1684:             ssh_port="$detected_port"
1685:         fi
1686:     fi
1687: 
1688:     mkdir -p "$ports_dir"
1689: 
1690:     # Create or update SSH port config
1691:     if [[ ! -f "$ssh_conf" ]]; then
1692:         cat > "$ssh_conf" << SSHEOF
1693: # Auto-generated SSH port whitelist
1694: # Created by: NFTBan installer
1695: # Date: $(date -Iseconds)
1696: # Detected from: $sshd_config
1697: [ssh]
1698: port=$ssh_port
1699: protocol=tcp
1700: direction=input
1701: SSHEOF
1702:         chmod 644 "$ssh_conf"
1703:         chown root:nftban "$ssh_conf"
1704:         ok "SSH port whitelisted: $ssh_port/tcp (from sshd_config)"
1705:     else
1706:         ok "SSH port config exists: $ssh_conf"
1707:     fi
1708: }
1709: 
1710: # Auto-whitelist system's primary IP address (prevents lockout)
1711: _install_auto_whitelist_system_ip() {
1712:     local whitelist_dir="/etc/nftban/whitelist.d"
1713:     local whitelist_file="${whitelist_dir}/00-system-ip.conf"
1714: 
1715:     # Get primary IP (non-loopback)
1716:     local system_ip
1717:     system_ip=$(ip route get 1.1.1.1 2>/dev/null | grep -oP 'src \K[0-9.]+' | head -1)
1718: 
1719:     if [[ -z "$system_ip" ]]; then
1720:         # Fallback: get first non-loopback IP
1721:         system_ip=$(hostname -I 2>/dev/null | awk '{print $1}')
1722:     fi
1723: 
1724:     if [[ -n "$system_ip" ]]; then
1725:         mkdir -p "$whitelist_dir"
1726:         if [[ ! -f "$whitelist_file" ]] || ! grep -q "$system_ip" "$whitelist_file" 2>/dev/null; then
1727:             cat > "$whitelist_file" << IPEOF
1728: # Auto-generated system IP whitelist
1729: # Created by: NFTBan installer
1730: # Date: $(date -Iseconds)
1731: # Purpose: Prevent lockout from this server
1732: $system_ip
1733: IPEOF
1734:             chmod 644 "$whitelist_file"
1735:             chown root:nftban "$whitelist_file" 2>/dev/null || true
1736:             ok "System IP whitelisted: $system_ip"
1737:         else
1738:             ok "System IP already whitelisted: $system_ip"
1739:         fi
1740:     else
1741:         warn "Could not detect system IP for whitelist"
1742:     fi
1743: }

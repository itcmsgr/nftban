  1: #!/usr/bin/env bash
  2: # =============================================================================
  3: # NFTBan Build Script - Consolidated Build System
  4: # =============================================================================
  5: # Purpose: Build all NFTBan Go binaries in one place
  6: # Usage: ./build.sh [component]
  7: #        component: all (default), gui, auth, or specific binary name
  8: # =============================================================================
  9: 
 10: set -euo pipefail
 11: 
 12: # Colors for output
 13: GREEN='\033[0;32m'
 14: BLUE='\033[0;34m'
 15: YELLOW='\033[1;33m'
 16: RED='\033[0;31m'
 17: NC='\033[0m' # No Color
 18: 
 19: log()   { echo -e "${BLUE}[BUILD]${NC} $*"; }
 20: ok()    { echo -e "${GREEN}[  OK ]${NC} $*"; }
 21: warn()  { echo -e "${YELLOW}[WARN ]${NC} $*"; }
 22: error() { echo -e "${RED}[ERROR]${NC} $*"; }
 23: 
 24: # Get script directory
 25: SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
 26: cd "$SCRIPT_DIR"
 27: 
 28: # Build directories
 29: BIN_DIR="$SCRIPT_DIR/bin"
 30: mkdir -p "$BIN_DIR"
 31: 
 32: # Build configuration
 33: CGO_ENABLED=1
 34: GOOS=linux
 35: GOARCH=amd64
 36: 
 37: # Read version from VERSION file (single source of truth)
 38: VERSION=$(cat "$SCRIPT_DIR/VERSION" 2>/dev/null || echo "dev")
 39: LDFLAGS="-s -w -X github.com/itcmsgr/nftban/pkg/version.Version=$VERSION"
 40: 
 41: # Component to build (default: all)
 42: COMPONENT="${1:-all}"
 43: 
 44: # =============================================================================
 45: # PRE-BUILD FIXES
 46: # =============================================================================
 47: 
 48: # Fix go.work if it exists (causes module resolution issues)
 49: if [[ -f "$SCRIPT_DIR/go.work" ]]; then
 50:     warn "Removing go.work (causes module resolution issues)"
 51:     rm -f "$SCRIPT_DIR/go.work"
 52: fi
 53: 
 54: # Ensure go.mod dependencies are up to date
 55: fix_dependencies() {
 56:     local module_dir="$1"
 57:     if [[ -f "$module_dir/go.mod" ]]; then
 58:         log "Updating dependencies in $module_dir..."
 59:         (cd "$module_dir" && go mod tidy -v 2>/dev/null) || true
 60:     fi
 61: }
 62: 
 63: # Fix dependencies for all Go modules
 64: log "Checking Go module dependencies..."
 65: fix_dependencies "$SCRIPT_DIR/cmd/nftban-core"
 66: fix_dependencies "$SCRIPT_DIR/cmd/nftban-ui"
 67: fix_dependencies "$SCRIPT_DIR/cmd/nftban-ui-auth"
 68: ok "Dependencies checked"
 69: echo ""
 70: 
 71: # =============================================================================
 72: # BUILD FUNCTIONS
 73: # =============================================================================
 74: 
 75: build_core() {
 76:     log "Building nftban-core (Core binary with GeoIP, feeds, etc.)..."
 77: 
 78:     cd "$SCRIPT_DIR/cmd/nftban-core"
 79: 
 80:     CGO_ENABLED=$CGO_ENABLED GOOS=$GOOS GOARCH=$GOARCH \
 81:         go build -o "$BIN_DIR/nftban-core" \
 82:         -ldflags="$LDFLAGS" \
 83:         . || {
 84:         error "Failed to build nftban-core"
 85:         return 1
 86:     }
 87: 
 88:     chmod +x "$BIN_DIR/nftban-core"
 89:     ok "Built: $BIN_DIR/nftban-core"
 90: 
 91:     cd "$SCRIPT_DIR"
 92:     return 0
 93: }
 94: 
 95: 
 96: build_gui() {
 97:     log "Building nftban-ui (Web GUI)..."
 98: 
 99:     cd "$SCRIPT_DIR/cmd/nftban-ui"
100: 
101:     CGO_ENABLED=$CGO_ENABLED GOOS=$GOOS GOARCH=$GOARCH \
102:         go build -o "$BIN_DIR/nftban-ui" \
103:         -ldflags="$LDFLAGS" \
104:         . || {
105:         error "Failed to build nftban-ui"
106:         return 1
107:     }
108: 
109:     chmod +x "$BIN_DIR/nftban-ui"
110:     ok "Built: $BIN_DIR/nftban-ui"
111: 
112:     cd "$SCRIPT_DIR"
113:     return 0
114: }
115: 
116: 
117: build_ui_auth() {
118:     log "Building nftban-ui-auth (PAM authentication daemon)..."
119: 
120:     cd "$SCRIPT_DIR/cmd/nftban-ui-auth"
121: 
122:     CGO_ENABLED=1 GOOS=$GOOS GOARCH=$GOARCH \
123:         go build -o "$BIN_DIR/nftban-ui-auth" \
124:         -ldflags="$LDFLAGS" \
125:         . || {
126:         error "Failed to build nftban-ui-auth"
127:         return 1
128:     }
129: 
130:     chmod +x "$BIN_DIR/nftban-ui-auth"
131:     ok "Built: $BIN_DIR/nftban-ui-auth"
132: 
133:     cd "$SCRIPT_DIR"
134:     return 0
135: }
136: 
137: 
138: show_usage() {
139:     cat << EOF
140: NFTBan Build Script
141: 
142: Usage:
143:   $0 [component]
144: 
145: Components:
146:   all       Build all Go binaries (default)
147:   core      Build nftban-core only
148:   gui       Build nftban-ui only
149:   ui-auth   Build nftban-ui-auth only
150: 
151: Environment Variables:
152:   CGO_ENABLED   Enable/disable CGO (default: 1)
153:   GOOS          Target OS (default: linux)
154:   GOARCH        Target architecture (default: amd64)
155: 
156: Examples:
157:   $0              # Build everything
158:   $0 all          # Build everything
159:   $0 core         # Build core binary only
160:   $0 gui          # Build GUI only
161: 
162: Output:
163:   All binaries are placed in: $BIN_DIR/
164: EOF
165: }
166: 
167: # =============================================================================
168: # MAIN BUILD LOGIC
169: # =============================================================================
170: 
171: log "NFTBan Build System"
172: log "==================="
173: log "Target: $GOOS/$GOARCH (CGO: $CGO_ENABLED)"
174: log "Output: $BIN_DIR/"
175: echo ""
176: 
177: case "$COMPONENT" in
178:     all)
179:         log "Building all components..."
180:         echo ""
181: 
182:         build_core || exit 1
183:         echo ""
184: 
185:         build_gui || exit 1
186:         echo ""
187: 
188:         build_ui_auth || exit 1
189:         echo ""
190: 
191:         log "Build Summary:"
192:         ls -lh "$BIN_DIR"/ 2>/dev/null || true
193:         echo ""
194:         ok "All components built successfully!"
195:         ;;
196: 
197:     core)
198:         build_core || exit 1
199:         ;;
200: 
201:     gui)
202:         build_gui || exit 1
203:         ;;
204: 
205:     ui-auth)
206:         build_ui_auth || exit 1
207:         ;;
208: 
209:     help|-h|--help)
210:         show_usage
211:         exit 0
212:         ;;
213: 
214:     *)
215:         error "Unknown component: $COMPONENT"
216:         echo ""
217:         show_usage
218:         exit 1
219:         ;;
220: esac
221: 
222: echo ""
223: ok "Build complete!"
224: echo ""
225: echo "Next steps:"
226: echo "  - Install locally: sudo ./install.sh all"
227: echo "  - Deploy to remote: ./deploy.sh [target]"
228: echo "  - Test core binary: ./bin/nftban-core --version"
229: echo "  - View install options: ./install.sh --help"

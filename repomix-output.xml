519: // LoginMonitorControlHandler enables/disables login monitoring
520: // POST /api/v1/login-monitor/control
521: func LoginMonitorControlHandler(w http.ResponseWriter, r *http.Request) {
522: 	var req struct {
523: 		Action string `json:"action"` // enable or disable
524: 		Target string `json:"target"` // ssh, su, sudo, console, service, all
525: 	}
526: 
527: 	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
528: 		respondJSON(w, http.StatusBadRequest, ErrorResponse{Error: "Invalid request"})
529: 		return
530: 	}
531: 
532: 	// Validate action
533: 	if req.Action != "enable" && req.Action != "disable" {
534: 		respondJSON(w, http.StatusBadRequest, ErrorResponse{Error: "Invalid action. Use 'enable' or 'disable'"})
535: 		return
536: 	}
537: 
538: 	// Default target to service
539: 	if req.Target == "" {
540: 		req.Target = "service"
541: 	}
542: 
543: 	// Validate target
544: 	validTargets := map[string]bool{"ssh": true, "su": true, "sudo": true, "console": true, "service": true, "all": true}
545: 	if !validTargets[req.Target] {
546: 		respondJSON(w, http.StatusBadRequest, ErrorResponse{Error: "Invalid target"})
547: 		return
548: 	}
549: 
550: 	// Execute: nftban login enable/disable <target>
551: 	output, err := execNFTBanCommand("login", req.Action, req.Target)
552: 	if err != nil {
553: 		log.Printf("[ERROR] Failed to %s login monitor %s: %v - Output: %s", req.Action, req.Target, err, output)
554: 		respondJSON(w, http.StatusInternalServerError, ErrorResponse{
555: 			Error: "Failed to " + req.Action + " login monitor: " + err.Error(),
556: 		})
557: 		return
558: 	}
559: 
560: 	respondJSON(w, http.StatusOK, map[string]interface{}{
561: 		"success": true,
562: 		"message": "Login monitor " + req.Target + " " + req.Action + "d successfully",
563: 	})
564: }

 453: nftban_health_check_suricata() {
 454:     # Comprehensive Suricata IDS health check
 455:     # Returns: 0=OK, 1=Warning, 2=Error
 456: 
 457:     local status=$HEALTH_OK
 458:     local suricata_issues=()
 459: 
 460:     # 1. Check if Suricata is installed
 461:     if ! command -v suricata >/dev/null 2>&1; then
 462:         # Suricata is optional, not an error if missing
 463:         NFTBAN_HEALTH_RESULTS["suricata"]=$HEALTH_OK
 464:         return $HEALTH_OK
 465:     fi
 466: 
 467:     # 2. Check if Suricata service is active (if enabled)
 468:     if systemctl list-unit-files 2>/dev/null | grep -q "^suricata.service"; then
 469:         if systemctl is-enabled --quiet suricata.service 2>/dev/null; then
 470:             if ! systemctl is-active --quiet suricata.service; then
 471:                 suricata_issues+=("Suricata service enabled but not running")
 472:                 status=$HEALTH_ERROR
 473:             fi
 474:         fi
 475:     fi
 476: 
 477:     # 3. Check eve.json log file exists and has recent activity
 478:     # Use central config path, with fallback to common locations
 479:     local eve_log="${NFTBAN_SURICATA_EVE_LOG:-/var/log/suricata/eve.json}"
 480:     if [[ -f "$eve_log" ]]; then
 481:         # Check if file has been modified in last 10 minutes
 482:         local last_modified
 483:         last_modified=$(stat -c %Y "$eve_log" 2>/dev/null || echo 0)
 484:         local current_time
 485:         current_time=$(date +%s)
 486:         local age
 487:         age=$((current_time - last_modified))
 488: 
 489:         if [[ $age -gt 600 ]]; then
 490:             suricata_issues+=("Eve.json not updated in 10+ minutes (may be stalled)")
 491:             [[ $status -lt $HEALTH_WARNING ]] && status=$HEALTH_WARNING
 492:         fi
 493: 
 494:         # Check file size (warn if > 1GB)
 495:         local file_size
 496:         file_size=$(stat -c %s "$eve_log" 2>/dev/null || echo 0)
 497:         if [[ $file_size -gt 1073741824 ]]; then
 498:             suricata_issues+=("Eve.json large ($(numfmt --to=iec "$file_size")), consider log rotation")
 499:             [[ $status -lt $HEALTH_WARNING ]] && status=$HEALTH_WARNING
 500:         fi
 501:     elif systemctl is-active --quiet suricata.service 2>/dev/null; then
 502:         # Service running but no log file
 503:         suricata_issues+=("Suricata running but eve.json not found at $eve_log")
 504:         status=$HEALTH_ERROR
 505:     fi
 506: 
 507:     # 4. Check Suricata memory usage (if running)
 508:     if systemctl is-active --quiet suricata.service 2>/dev/null; then
 509:         local suricata_pid
 510:         suricata_pid=$(systemctl show -p MainPID --value suricata.service 2>/dev/null)
 511:         if [[ -n "$suricata_pid" && "$suricata_pid" != "0" ]]; then
 512:             local mem_mb
 513:             mem_mb=$(ps -p "$suricata_pid" -o rss= 2>/dev/null | awk '{print int($1/1024)}')
 514:             if [[ -n "$mem_mb" && $mem_mb -gt 1024 ]]; then
 515:                 suricata_issues+=("Suricata memory usage high (${mem_mb}MB, expected 300-600MB)")
 516:                 [[ $status -lt $HEALTH_WARNING ]] && status=$HEALTH_WARNING
 517:             fi
 518:         fi
 519:     fi
 520: 
 521:     # 5. Check sysctl network buffer tuning
 522:     if [[ -f /etc/sysctl.d/90-suricata.conf ]]; then
 523:         local rmem_max
 524:         rmem_max=$(sysctl -n net.core.rmem_max 2>/dev/null || echo 0)
 525:         if [[ $rmem_max -lt 67108864 ]]; then
 526:             suricata_issues+=("Network buffer not optimized (rmem_max: $rmem_max, expected: 67108864)")
 527:             [[ $status -lt $HEALTH_WARNING ]] && status=$HEALTH_WARNING
 528:         fi
 529:     elif systemctl is-active --quiet suricata.service 2>/dev/null; then
 530:         suricata_issues+=("Sysctl tuning not applied (/etc/sysctl.d/90-suricata.conf missing)")
 531:         [[ $status -lt $HEALTH_WARNING ]] && status=$HEALTH_WARNING
 532:     fi
 533: 
 534:     # Store results
 535:     if [[ ${#suricata_issues[@]} -gt 0 ]]; then
 536:         NFTBAN_HEALTH_ISSUES["suricata"]="${suricata_issues[*]}"
 537:         if [[ $status -eq $HEALTH_WARNING ]]; then
 538:             NFTBAN_HEALTH_WARNINGS+=("Suricata: ${suricata_issues[*]}")
 539:         elif [[ $status -eq $HEALTH_ERROR ]]; then
 540:             NFTBAN_HEALTH_ERRORS+=("Suricata: ${suricata_issues[*]}")
 541:         fi
 542:     fi
 543: 
 544:     NFTBAN_HEALTH_RESULTS["suricata"]=$status
 545:     return $status
 546: }

<file path="etc/nftban/suricata/profiles/maximum.yaml">
  1: # =============================================================================
  2: # NFTBan Suricata Profile: Maximum
  3: # =============================================================================
  4: # Target: 8+ cores, 8-16 GB RAM
  5: # Focus: Deep inspection and comprehensive coverage
  6: # Use Case: High-traffic servers, dedicated security appliances
  7: # =============================================================================
  8: 
  9: %YAML 1.1
 10: ---
 11: 
 12: # Packet capture interface
 13: af-packet:
 14:   - interface: default
 15:     cluster-id: 99
 16:     cluster-type: cluster_flow
 17:     defrag: yes
 18:     ring-size: 300000          # LARGE buffer
 19:     use-mmap: yes
 20: 
 21: # Threading configuration
 22: threading:
 23:   set-cpu-affinity: yes        # Pin threads to CPUs
 24:   detect-thread-ratio: 2.0     # Aggressive parallelism
 25: 
 26: # Flow timeout settings (DEFAULT Suricata behavior)
 27: flow:
 28:   memcap: 256mb                # High memory allocation
 29:   hash-size: 262144
 30:   prealloc: 40000
 31:   timeout:
 32:     new: 30
 33:     established: 300           # DEFAULT timeout (generous)
 34:     closed: 0
 35:     bypassed: 100
 36:     emergency-new: 10
 37:     emergency-established: 100
 38:     emergency-closed: 0
 39: 
 40: # Stream engine
 41: stream:
 42:   memcap: 128mb                # Large stream memory
 43:   checksum-validation: yes
 44:   inline: no
 45: 
 46: # HTTP configuration (FULL body inspection)
 47: app-layer:
 48:   protocols:
 49:     http:
 50:       enabled: yes
 51:       libhtp:
 52:         default-config:
 53:           personality: IDS
 54:           request-body-limit: 30kb       # FULL inspection
 55:           response-body-limit: 30kb      # FULL inspection
 56:           request-body-minimal-inspect-size: 8192
 57:           request-body-inspect-window: 8192
 58:           response-body-minimal-inspect-size: 8192
 59:           response-body-inspect-window: 8192
 60:           double-decode-path: yes
 61:           double-decode-query: yes
 62: 
 63:     tls:
 64:       enabled: yes
 65:       detection-ports:
 66:         dp: 443
 67:       ja3-fingerprints: yes
 68: 
 69:     ssh:
 70:       enabled: yes
 71: 
 72:     dns:
 73:       enabled: yes
 74:       tcp:
 75:         enabled: yes
 76:       udp:
 77:         enabled: yes
 78: 
 79:     smtp:
 80:       enabled: yes
 81:       raw-extraction: yes        # Full SMTP inspection
 82:       mime:
 83:         decode-mime: yes
 84:         decode-base64: yes
 85:         decode-quoted-printable: yes
 86: 
 87:     mysql:
 88:       enabled: yes
 89: 
 90:     # ALL protocols enabled
 91:     smb:
 92:       enabled: yes
 93:       detection-ports:
 94:         dp: 139, 445
 95: 
 96:     dcerpc:
 97:       enabled: yes
 98: 
 99:     ftp:
100:       enabled: yes
101: 
102:     nfs:
103:       enabled: yes
104: 
105:     tftp:
106:       enabled: yes
107: 
108:     ikev2:
109:       enabled: yes
110: 
111:     krb5:
112:       enabled: yes
113: 
114:     ntp:
115:       enabled: yes
116: 
117:     dhcp:
118:       enabled: yes
119: 
120:     rfb:
121:       enabled: yes
122: 
123:     sip:
124:       enabled: yes
125: 
126: # Logging configuration (COMPREHENSIVE)
127: outputs:
128:   - fast:
129:       enabled: no
130: 
131:   - eve-log:
132:       enabled: yes
133:       filetype: regular
134:       filename: /var/log/suricata/eve.json
135:       rotate-interval: 1h
136: 
137:       types:
138:         - alert:
139:             payload: yes
140:             payload-buffer-size: 8kb    # Large payload capture
141:             payload-printable: yes
142:             packet: yes
143:             metadata: yes
144:             tagged-packets: yes
145:             http-body: yes              # Include HTTP body in alerts
146:             http-body-printable: yes
147: 
148:         - anomaly:
149:             enabled: yes
150:             types:
151:               applayer: yes
152:               stream: yes
153:               decode: yes
154: 
155:         - http:
156:             extended: yes
157:             dump-all-headers: yes       # Full header dump
158: 
159:         - dns:
160:             query: yes
161:             answer: yes
162:             version: 2
163: 
164:         - tls:
165:             extended: yes
166:             session-resumption: yes
167:             custom: [subject, issuer, session_resumed, fingerprint, sni, version, not_before, not_after, certificate, chain, ja3, ja3s]
168: 
169:         - ssh:
170:             enabled: yes
171: 
172:         - smtp:
173:             enabled: yes
174:             extended: yes
175: 
176:         - flow:
177:             enabled: yes
178: 
179:         - netflow:
180:             enabled: yes
181: 
182:         - stats:
183:             enabled: yes
184:             totals: yes
185:             threads: yes
186: 
187:         - files:
188:             enabled: yes
189:             force-magic: yes
190:             force-hash: [md5, sha1, sha256]
191: 
192: # Detection engine (HIGH performance)
193: detect:
194:   profile: high                # HIGH CPU usage for deep inspection
195:   custom-values:
196:     toclient-groups: 4
197:     toserver-groups: 4
198:   sgh-mpm-context: full
199:   inspection-recursion-limit: 3000
200: 
201: # Profiling (enabled for tuning)
202: profiling:
203:   rules:
204:     enabled: yes
205:     filename: /var/log/suricata/rule_perf.log
206:     append: yes
207:   keywords:
208:     enabled: yes
209:     filename: /var/log/suricata/keyword_perf.log
210:     append: yes
211: 
212: # Detection engine configuration
213: detect-engine:
214:   - profile: high
215:   - sgh-mpm-context: full
216:   - inspection-recursion-limit: 3000
217:   - rule-reload: true
218: 
219: # Default rule path
220: default-rule-path: /var/lib/suricata/rules
221: 
222: # Rule files (managed by NFTBan)
223: rule-files:
224:   - /etc/nftban/suricata/rules/enabled.list
225: 
226: # Classification file
227: classification-file: /etc/suricata/classification.config
228: 
229: # Reference config file
230: reference-config-file: /etc/suricata/reference.config
231: 
232: # GeoIP database
233: geoip-database: /var/lib/GeoIP/GeoLite2-Country.mmdb
234: 
235: # File extraction (optional, disabled by default for performance)
236: # Uncomment to enable file extraction:
237: #file-store:
238: #  enabled: yes
239: #  dir: /var/log/suricata/files
240: #  write-fileinfo: yes
241: #  force-hash: [md5, sha256]
242: #  force-filestore: no
243: #  stream-depth: 1mb
244: #  max-open-files: 1000
245: 
246: # =============================================================================
247: # NFTBan Integration Notes:
248: # - This profile is for HIGH-END servers (8+ cores / 8-16GB RAM)
249: # - HTTP body inspection FULLY ENABLED (30KB both request/response)
250: # - Flow timeouts: DEFAULT/GENEROUS (300s established)
251: # - ALL protocols enabled (HTTP, TLS, SSH, DNS, SMTP, MySQL, SMB, DCERPC, FTP, etc.)
252: # - Ring size: 300k frames (6x minimal profile)
253: # - Detection profile: HIGH (most aggressive)
254: # - CPU affinity enabled (pin threads)
255: # - Profiling enabled for performance tuning
256: # - Comprehensive logging (files, netflow, stats)
257: # =============================================================================
</file>


# shellcheck shell=bash
# nftban bash completion v1.0.0
# =============================================================================
# NFTBan CLI Tab Completion
# Install: cp nftban /etc/bash_completion.d/nftban
# =============================================================================

# shellcheck disable=SC2207  # Bash completion uses traditional array assignment for compatibility

_nftban() {
    local cur prev words cword
    _init_completion || return

    # ==========================================================================
    # MAIN COMMANDS (from nftban help)
    # ==========================================================================
    # CORE: status health validate config sync version help
    # FIREWALL: firewall ban unban list check search whitelist whitelist-system profile panel permissions
    # PROTECTION: ddos portscan login feeds trust country cloudflare geoban geoip
    # MONITORING: metrics stats report fhs module services timers mail
    # DEBUG: debug smoke selftest emulate setup menu

    # H28 fix: 'cloudflare' is a legacy alias for 'trust' — still listed for discovery
    local commands="status health validate config sync version help firewall firewall-logs ban unban protect unprotect cleanup list check search blacklist whitelist whitelist-system profile panel permissions polkit ddos portscan botscan botguard login feeds trust country cloudflare geoban geoip metrics stats report queue fhs module services timers mail rbl debug smoke selftest emulate setup menu nftables port system test wizard watchdog flush update support suricata pro connector modes snapshot zabbix preflight export tunnel benchmark rollback scale"

    # ==========================================================================
    # SUBCOMMANDS FOR EACH MAIN COMMAND
    # ==========================================================================

    # Core commands
    local status_cmds="--json help"
    local health_cmds="check summary json fix enforce binaries geoip pro registries install verify conflicts config posture security --auto-heal --json help"
    local validate_cmds="all firewall config permissions --json help"
    local config_cmds="validate audit doctor diff show get defaults overrides set reset reset-all apply status help"
    local sync_cmds="full validate status --dry-run help"

    # Firewall & Security commands
    local firewall_cmds="status stats validate conflicts check logs record init reload rebuild reset restore transition-health takeover ssh-audit --json help"
    local firewall_logs_cmds="enable disable status show help"
    local ban_cmds="--timeout --reason --source --json help"
    local unban_cmds="--json help"
    local list_cmds="banned whitelist all --json help"
    local check_cmds="--json help"
    local search_cmds="--json help"
    local blacklist_cmds="add remove list show files count flush --json help"
    local whitelist_cmds="add remove list show --json help"
    local whitelist_system_cmds="--dry-run --json help"
    local profile_cmds="list apply status basic standard advanced help"
    local panel_cmds="detect status directadmin help"
    local permissions_cmds="audit fix status --json help"

    # Protection Modules
    local ddos_cmds="status enable disable test config --json help"
    local portscan_cmds="status enable disable check history test --json help"
    local login_cmds="status stats enable disable restart logs test run mode digest --json help"
    local login_targets="ssh su sudo console service all"
    local feeds_cmds="select list enable disable enable-cat update status --json help"
    local trust_cmds="list enable disable update load status --json help"
    local trust_providers="CLOUDFLARE QUICCLOUD AWS GOOGLE AZURE FASTLY DIGITALOCEAN LINODE VULTR OVH HETZNER ALL"
    local country_cmds="list enable disable mode status apply --json help"
    local country_codes="CN RU KP IR SY BY CU VE MM AF IQ LY SD YE US GB DE FR NL"
    local geoban_cmds="enable disable ban unban whitelist unwhitelist list status update refresh --json help"
    local geoip_cmds="status update lookup config --json help"

    # Monitoring & Reporting
    local metrics_cmds="status enable disable help"
    local stats_cmds="summary dashboard top export monitor cleanup trend comms --json help"
    local report_cmds="generate run schedule email email-setup list status --json help"
    local fhs_cmds="check status --json help"
    local module_cmds="list status --json help"
    local services_cmds="status --json help"
    local timers_cmds="status enable disable --json help"
    local mail_cmds="status port-status test config help"

    # Debug & Testing
    local debug_cmds="status enable disable trace logs dump botguard --json help"
    local smoke_cmds="--json --group --module --deep help"
    local selftest_cmds="run quick all lifecycle verify config check stats trace help"
    local emulate_cmds="--proto --port --direction --json help"
    local setup_cmds="install uninstall configure wizard help"
    local menu_cmds="help"
    local test_cmds="run all --verbose --json help"
    local wizard_cmds="help"

    # System & Infrastructure
    local nftables_cmds="status reload reset backup restore --json help"
    local port_cmds="allow list status --json help"
    local port_protocols="tcp udp both"
    local port_directions="in out inout"
    local system_cmds="status enable disable install uninstall --json help"

    # Watchdog (System Resource Monitoring)
    local watchdog_cmds="status check run report trend trends history enable disable --json help"

    # Emergency/Recovery
    local flush_cmds="blacklist whitelist feeds geoban ddos all --yes --dry-run help"

    # New commands (added for completion)
    local botscan_cmds="status enable disable --json help"
    local botguard_cmds="status enable disable test --json help"
    local export_cmds="--format --output --since --until --last help"
    local tunnel_cmds="status enable disable scan top explain config --json help"
    local benchmark_cmds="all ipc nft sets --iterations --json help"
    local polkit_cmds="validate static runtime status groups rules test help"
    local pro_cmds="status enroll disable token inventory license-check community help"
    local queue_cmds="status list process dlq metrics help"
    local rbl_cmds="check server status list enable disable cache alert critical watchlist help"
    local support_cmds="--network help"
    local suricata_cmds="install enable disable status eve rules profile scan services sid category local custom recommend iface help"
    local update_cmds="check status github git local force repair rollback list history auto preflight verify auto-apply help"

    # Memory/Ban Management (NEW)
    local protect_cmds="--json help"
    local unprotect_cmds="--json help"
    local cleanup_cmds="--stats --dry-run --execute --count --json help"

    # New commands (connector, modes, snapshot, zabbix, preflight)
    local connector_cmds="list add remove enable disable test show push --json help"
    local modes_cmds="--json help"
    local snapshot_cmds="create list restore --json help"
    local zabbix_cmds="setup status test push reload template discover targets config --json help"
    local preflight_cmds="--strict --json help"
    local rollback_cmds="--list --version --dry-run --json help"
    local scale_cmds="status --json help"

    # Global options available for most commands
    local global_opts="--json --help --version -h"

    # ==========================================================================
    # COMPLETION LOGIC
    # ==========================================================================

    case "${cword}" in
        1)
            # Complete main commands
            COMPREPLY=($(compgen -W "${commands}" -- "${cur}"))
            ;;
        2)
            # Complete subcommands based on main command
            case "${prev}" in
                # Core
                status)
                    COMPREPLY=($(compgen -W "${status_cmds}" -- "${cur}"))
                    ;;
                health)
                    COMPREPLY=($(compgen -W "${health_cmds}" -- "${cur}"))
                    ;;
                validate)
                    COMPREPLY=($(compgen -W "${validate_cmds}" -- "${cur}"))
                    ;;
                config)
                    COMPREPLY=($(compgen -W "${config_cmds}" -- "${cur}"))
                    ;;
                sync)
                    COMPREPLY=($(compgen -W "${sync_cmds}" -- "${cur}"))
                    ;;

                # Firewall & Security
                firewall)
                    COMPREPLY=($(compgen -W "${firewall_cmds}" -- "${cur}"))
                    ;;
                firewall-logs)
                    COMPREPLY=($(compgen -W "${firewall_logs_cmds}" -- "${cur}"))
                    ;;
                ban)
                    # Ban expects an IP address first, then options
                    COMPREPLY=($(compgen -W "${ban_cmds}" -- "${cur}"))
                    ;;
                unban)
                    COMPREPLY=($(compgen -W "${unban_cmds}" -- "${cur}"))
                    ;;
                list)
                    COMPREPLY=($(compgen -W "${list_cmds}" -- "${cur}"))
                    ;;
                check)
                    COMPREPLY=($(compgen -W "${check_cmds}" -- "${cur}"))
                    ;;
                search)
                    COMPREPLY=($(compgen -W "${search_cmds}" -- "${cur}"))
                    ;;
                blacklist)
                    COMPREPLY=($(compgen -W "${blacklist_cmds}" -- "${cur}"))
                    ;;
                whitelist)
                    COMPREPLY=($(compgen -W "${whitelist_cmds}" -- "${cur}"))
                    ;;
                whitelist-system)
                    COMPREPLY=($(compgen -W "${whitelist_system_cmds}" -- "${cur}"))
                    ;;
                profile)
                    COMPREPLY=($(compgen -W "${profile_cmds}" -- "${cur}"))
                    ;;
                panel)
                    COMPREPLY=($(compgen -W "${panel_cmds}" -- "${cur}"))
                    ;;
                permissions)
                    COMPREPLY=($(compgen -W "${permissions_cmds}" -- "${cur}"))
                    ;;

                # Protection Modules
                ddos)
                    COMPREPLY=($(compgen -W "${ddos_cmds}" -- "${cur}"))
                    ;;
                portscan)
                    COMPREPLY=($(compgen -W "${portscan_cmds}" -- "${cur}"))
                    ;;
                login)
                    COMPREPLY=($(compgen -W "${login_cmds}" -- "${cur}"))
                    ;;
                feeds)
                    COMPREPLY=($(compgen -W "${feeds_cmds}" -- "${cur}"))
                    ;;
                trust)
                    COMPREPLY=($(compgen -W "${trust_cmds}" -- "${cur}"))
                    ;;
                country)
                    COMPREPLY=($(compgen -W "${country_cmds}" -- "${cur}"))
                    ;;
                cloudflare)
                    # H28 fix: cloudflare is alias for trust
                    COMPREPLY=($(compgen -W "${trust_cmds}" -- "${cur}"))
                    ;;
                geoban)
                    COMPREPLY=($(compgen -W "${geoban_cmds}" -- "${cur}"))
                    ;;
                geoip)
                    COMPREPLY=($(compgen -W "${geoip_cmds}" -- "${cur}"))
                    ;;

                # Monitoring & Reporting
                metrics)
                    COMPREPLY=($(compgen -W "${metrics_cmds}" -- "${cur}"))
                    ;;
                stats)
                    COMPREPLY=($(compgen -W "${stats_cmds}" -- "${cur}"))
                    ;;
                report)
                    COMPREPLY=($(compgen -W "${report_cmds}" -- "${cur}"))
                    ;;
                fhs)
                    COMPREPLY=($(compgen -W "${fhs_cmds}" -- "${cur}"))
                    ;;
                module)
                    COMPREPLY=($(compgen -W "${module_cmds}" -- "${cur}"))
                    ;;
                services)
                    COMPREPLY=($(compgen -W "${services_cmds}" -- "${cur}"))
                    ;;
                timers)
                    COMPREPLY=($(compgen -W "${timers_cmds}" -- "${cur}"))
                    ;;
                mail)
                    COMPREPLY=($(compgen -W "${mail_cmds}" -- "${cur}"))
                    ;;

                # Debug & Testing
                debug)
                    COMPREPLY=($(compgen -W "${debug_cmds}" -- "${cur}"))
                    ;;
                smoke)
                    COMPREPLY=($(compgen -W "${smoke_cmds}" -- "${cur}"))
                    ;;
                selftest)
                    COMPREPLY=($(compgen -W "${selftest_cmds}" -- "${cur}"))
                    ;;
                emulate)
                    # Emulate expects an IP address first
                    COMPREPLY=($(compgen -W "${emulate_cmds}" -- "${cur}"))
                    ;;
                setup)
                    COMPREPLY=($(compgen -W "${setup_cmds}" -- "${cur}"))
                    ;;
                menu)
                    COMPREPLY=($(compgen -W "${menu_cmds}" -- "${cur}"))
                    ;;
                test)
                    COMPREPLY=($(compgen -W "${test_cmds}" -- "${cur}"))
                    ;;
                wizard)
                    COMPREPLY=($(compgen -W "${wizard_cmds}" -- "${cur}"))
                    ;;

                # System & Infrastructure
                nftables)
                    COMPREPLY=($(compgen -W "${nftables_cmds}" -- "${cur}"))
                    ;;
                port)
                    COMPREPLY=($(compgen -W "${port_cmds}" -- "${cur}"))
                    ;;
                system)
                    COMPREPLY=($(compgen -W "${system_cmds}" -- "${cur}"))
                    ;;

                # Watchdog
                watchdog)
                    COMPREPLY=($(compgen -W "${watchdog_cmds}" -- "${cur}"))
                    ;;

                # Emergency/Recovery
                flush)
                    COMPREPLY=($(compgen -W "${flush_cmds}" -- "${cur}"))
                    ;;

                # New commands
                botscan)
                    COMPREPLY=($(compgen -W "${botscan_cmds}" -- "${cur}"))
                    ;;
                botguard)
                    COMPREPLY=($(compgen -W "${botguard_cmds}" -- "${cur}"))
                    ;;
                export)
                    COMPREPLY=($(compgen -W "${export_cmds}" -- "${cur}"))
                    ;;
                tunnel)
                    COMPREPLY=($(compgen -W "${tunnel_cmds}" -- "${cur}"))
                    ;;
                benchmark)
                    COMPREPLY=($(compgen -W "${benchmark_cmds}" -- "${cur}"))
                    ;;
                polkit)
                    COMPREPLY=($(compgen -W "${polkit_cmds}" -- "${cur}"))
                    ;;
                pro)
                    COMPREPLY=($(compgen -W "${pro_cmds}" -- "${cur}"))
                    ;;
                queue)
                    COMPREPLY=($(compgen -W "${queue_cmds}" -- "${cur}"))
                    ;;
                rbl)
                    COMPREPLY=($(compgen -W "${rbl_cmds}" -- "${cur}"))
                    ;;
                support)
                    COMPREPLY=($(compgen -W "${support_cmds}" -- "${cur}"))
                    ;;
                suricata)
                    COMPREPLY=($(compgen -W "${suricata_cmds}" -- "${cur}"))
                    ;;
                update)
                    COMPREPLY=($(compgen -W "${update_cmds}" -- "${cur}"))
                    ;;

                # Memory/Ban Management (NEW)
                protect)
                    COMPREPLY=($(compgen -W "${protect_cmds}" -- "${cur}"))
                    ;;
                unprotect)
                    COMPREPLY=($(compgen -W "${unprotect_cmds}" -- "${cur}"))
                    ;;
                cleanup)
                    COMPREPLY=($(compgen -W "${cleanup_cmds}" -- "${cur}"))
                    ;;

                # New commands (connector, modes, snapshot, zabbix)
                connector)
                    COMPREPLY=($(compgen -W "${connector_cmds}" -- "${cur}"))
                    ;;
                modes)
                    COMPREPLY=($(compgen -W "${modes_cmds}" -- "${cur}"))
                    ;;
                snapshot)
                    COMPREPLY=($(compgen -W "${snapshot_cmds}" -- "${cur}"))
                    ;;
                zabbix)
                    COMPREPLY=($(compgen -W "${zabbix_cmds}" -- "${cur}"))
                    ;;
                preflight)
                    COMPREPLY=($(compgen -W "${preflight_cmds}" -- "${cur}"))
                    ;;
                rollback)
                    COMPREPLY=($(compgen -W "${rollback_cmds}" -- "${cur}"))
                    ;;
                scale)
                    COMPREPLY=($(compgen -W "${scale_cmds}" -- "${cur}"))
                    ;;

                # Fallback
                *)
                    COMPREPLY=($(compgen -W "${global_opts}" -- "${cur}"))
                    ;;
            esac
            ;;
        3)
            # Complete third-level arguments
            local main_cmd="${words[1]}"
            local sub_cmd="${words[2]}"

            case "${main_cmd}" in
                login)
                    case "${sub_cmd}" in
                        enable|disable)
                            COMPREPLY=($(compgen -W "${login_targets}" -- "${cur}"))
                            ;;
                        status|stats)
                            COMPREPLY=($(compgen -W "--json" -- "${cur}"))
                            ;;
                        logs)
                            # Suggest common log line counts
                            COMPREPLY=($(compgen -W "10 25 50 100 200" -- "${cur}"))
                            ;;
                    esac
                    ;;
                metrics)
                    case "${sub_cmd}" in
                        enable)
                            COMPREPLY=($(compgen -W "--pro --remote --url --token --labels --force" -- "${cur}"))
                            ;;
                    esac
                    ;;
                profile)
                    case "${sub_cmd}" in
                        apply)
                            COMPREPLY=($(compgen -W "basic standard advanced" -- "${cur}"))
                            ;;
                    esac
                    ;;
                trust)
                    case "${sub_cmd}" in
                        enable|disable)
                            # Trust providers
                            COMPREPLY=($(compgen -W "${trust_providers}" -- "${cur}"))
                            ;;
                    esac
                    ;;
                country)
                    case "${sub_cmd}" in
                        enable|disable)
                            # Common country codes
                            COMPREPLY=($(compgen -W "${country_codes}" -- "${cur}"))
                            ;;
                        mode)
                            COMPREPLY=($(compgen -W "blacklist whitelist" -- "${cur}"))
                            ;;
                    esac
                    ;;
                geoban)
                    case "${sub_cmd}" in
                        ban|unban|whitelist|unwhitelist)
                            # Common country codes
                            COMPREPLY=($(compgen -W "RU CN KP IR SY VE BY CU KZ help" -- "${cur}"))
                            ;;
                    esac
                    ;;
                emulate)
                    # After IP, suggest options
                    case "${sub_cmd}" in
                        --proto)
                            COMPREPLY=($(compgen -W "tcp udp icmp" -- "${cur}"))
                            ;;
                        --direction)
                            COMPREPLY=($(compgen -W "in out" -- "${cur}"))
                            ;;
                        *)
                            COMPREPLY=($(compgen -W "--proto --port --direction --json" -- "${cur}"))
                            ;;
                    esac
                    ;;
                ban)
                    # After IP address, suggest ban options
                    COMPREPLY=($(compgen -W "--timeout --reason --source --json" -- "${cur}"))
                    ;;
                stats)
                    case "${sub_cmd}" in
                        top|ip|recent|export)
                            COMPREPLY=($(compgen -W "--json" -- "${cur}"))
                            ;;
                    esac
                    ;;
                timers)
                    case "${sub_cmd}" in
                        enable|disable)
                            # List available timers
                            COMPREPLY=($(compgen -W "nftban-health.timer nftban-unified-exporter.timer nftban-core-geoip.timer nftban-core-feeds.timer nftban-queue.timer nftban-suricata-update.timer nftban-snapshot.timer nftban-rollback.timer" -- "${cur}"))
                            ;;
                    esac
                    ;;
                pro)
                    case "${sub_cmd}" in
                        token)
                            COMPREPLY=($(compgen -W "check rotate revoke" -- "${cur}"))
                            ;;
                        inventory)
                            COMPREPLY=($(compgen -W "show run submit" -- "${cur}"))
                            ;;
                        community)
                            COMPREPLY=($(compgen -W "show enable disable status submit" -- "${cur}"))
                            ;;
                    esac
                    ;;
                report)
                    case "${sub_cmd}" in
                        schedule)
                            COMPREPLY=($(compgen -W "enable disable status" -- "${cur}"))
                            ;;
                        run)
                            COMPREPLY=($(compgen -W "daily weekly monthly" -- "${cur}"))
                            ;;
                    esac
                    ;;
                port)
                    case "${sub_cmd}" in
                        add|remove|block|unblock)
                            # Expecting port number - show hint
                            COMPREPLY=($(compgen -W "22 80 443 25 465 587 3306 5432 8080 8443" -- "${cur}"))
                            ;;
                        allow)
                            COMPREPLY=($(compgen -W "add remove list flush help" -- "${cur}"))
                            ;;
                        allow-panel)
                            COMPREPLY=($(compgen -W "directadmin cpanel plesk" -- "${cur}"))
                            ;;
                        egress)
                            COMPREPLY=($(compgen -W "status audit enforce report --json help" -- "${cur}"))
                            ;;
                    esac
                    ;;
            esac
            ;;
        4)
            # Complete fourth-level arguments (e.g., nftban ban IP --timeout 1h)
            local main_cmd="${words[1]}"
            local option="${words[3]}"

            case "${main_cmd}" in
                ban)
                    case "${option}" in
                        --timeout)
                            # Suggest common timeout values
                            COMPREPLY=($(compgen -W "1h 2h 6h 12h 24h 48h 7d 30d" -- "${cur}"))
                            ;;
                        --source)
                            COMPREPLY=($(compgen -W "manual suricata login portscan ddos" -- "${cur}"))
                            ;;
                    esac
                    ;;
                emulate)
                    case "${option}" in
                        --proto)
                            COMPREPLY=($(compgen -W "tcp udp icmp" -- "${cur}"))
                            ;;
                        --direction)
                            COMPREPLY=($(compgen -W "in out" -- "${cur}"))
                            ;;
                        --port)
                            # Common port numbers
                            COMPREPLY=($(compgen -W "22 80 443 25 465 587 3306 5432" -- "${cur}"))
                            ;;
                    esac
                    ;;
                metrics)
                    case "${option}" in
                        --url)
                            # URL completion - no suggestions
                            COMPREPLY=()
                            ;;
                    esac
                    ;;
                port)
                    # After port number, suggest protocols
                    local sub_cmd="${words[2]}"
                    case "${sub_cmd}" in
                        add|remove|block|unblock)
                            COMPREPLY=($(compgen -W "${port_protocols}" -- "${cur}"))
                            ;;
                    esac
                    ;;
            esac
            ;;
        5)
            # Complete fifth-level arguments (e.g., nftban port add 80 tcp <direction>)
            local main_cmd="${words[1]}"
            local sub_cmd="${words[2]}"

            case "${main_cmd}" in
                port)
                    case "${sub_cmd}" in
                        add|remove|block|unblock)
                            # After protocol, suggest directions
                            COMPREPLY=($(compgen -W "${port_directions}" -- "${cur}"))
                            ;;
                    esac
                    ;;
            esac
            ;;
    esac

    return 0
}

complete -F _nftban nftban

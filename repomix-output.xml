1762: nftban_health_check_gui() {
1763:     # Check NFTBan Web UI (nftban-ui) health and binary deployment
1764:     # Returns: 0=OK, 1=WARNING, 2=ERROR, 3=CRITICAL
1765:     # Auto-heal: Rebuild binary if outdated, restart service if crashed
1766: 
1767:     local status=$HEALTH_OK
1768:     local gui_issues=()
1769:     local auto_heal="${1:-0}"
1770: 
1771:     # Check if GUI is installed
1772:     local gui_binary="/usr/sbin/nftban-ui"
1773:     local gui_source_dir="${NFTBAN_DEV_SOURCE_DIR:-}/cmd/nftban-ui"
1774:     local build_binary="$gui_source_dir/nftban-ui"
1775: 
1776:     if [[ ! -f "$gui_binary" ]]; then
1777:         gui_issues+=("GUI binary not found at $gui_binary")
1778:         status=$HEALTH_CRITICAL
1779: 
1780:         if [[ $auto_heal -eq 1 ]]; then
1781:             echo "  🔧 Auto-heal: Building and installing GUI binary..."
1782:             if [[ -d "$gui_source_dir" ]]; then
1783:                 (
1784:                     cd "$gui_source_dir" || exit 1
1785:                     CGO_ENABLED=1 GOOS=linux GOARCH=amd64 go build -o "$build_binary" . 2>&1
1786:                     cp -f "$build_binary" "$gui_binary" 2>&1
1787:                     chmod +x "$gui_binary" 2>&1
1788:                 ) && gui_issues+=("✓ GUI binary built and installed") || gui_issues+=("Failed to build GUI binary")
1789:             else
1790:                 gui_issues+=("GUI source directory not found: $gui_source_dir")
1791:             fi
1792:         fi
1793:     else
1794:         # Check if binary is executable
1795:         if [[ ! -x "$gui_binary" ]]; then
1796:             gui_issues+=("GUI binary not executable")
1797:             status=$HEALTH_ERROR
1798: 
1799:             if [[ $auto_heal -eq 1 ]]; then
1800:                 echo "  🔧 Auto-heal: Making GUI binary executable..."
1801:                 chmod +x "$gui_binary" && gui_issues+=("✓ Fixed GUI binary permissions")
1802:             fi
1803:         else
1804:             gui_issues+=("✓ GUI binary: Installed and executable")
1805:         fi
1806: 
1807:         # Check if binary is up-to-date (compare with build directory)
1808:         if [[ -f "$build_binary" ]]; then
1809:             local installed_md5 built_md5
1810:             installed_md5=$(md5sum "$gui_binary" 2>/dev/null | awk '{print $1}')
1811:             built_md5=$(md5sum "$build_binary" 2>/dev/null | awk '{print $1}')
1812: 
1813:             if [[ "$installed_md5" != "$built_md5" ]]; then
1814:                 gui_issues+=("Web UI binary outdated (needs reinstall)")
1815:                 gui_issues+=("ℹ️  To update: Rebuild with './build.sh' then restart service")
1816:                 [[ $status -lt $HEALTH_WARNING ]] && status=$HEALTH_WARNING
1817: 
1818:                 if [[ $auto_heal -eq 1 ]]; then
1819:                     echo "  🔧 Auto-heal: Updating GUI binary from build directory..."
1820:                     cp -f "$build_binary" "$gui_binary" 2>&1 && \
1821:                     chmod +x "$gui_binary" 2>&1 && \
1822:                     gui_issues+=("✓ GUI binary updated from build directory")
1823:                 fi
1824:             else
1825:                 gui_issues+=("✓ GUI binary: Up-to-date")
1826:             fi
1827:         elif [[ -d "$gui_source_dir" ]]; then
1828:             # Build binary doesn't exist but installed binary is working - this is OK
1829:             # The build directory may exist on servers with dev repo but binary was deployed via rsync/install
1830:             gui_issues+=("✓ GUI binary: Installed (build directory present but binary not built locally)")
1831:         fi
1832:     fi
1833: 
1834:     # Check if GUI service exists (check both systemctl and service files)
1835:     local service_exists=false
1836:     if systemctl list-unit-files | grep -q "${NFTBAN_SERVICE_UI:-nftban-ui.service}" 2>/dev/null; then
1837:         service_exists=true
1838:     elif [[ -f "/etc/systemd/system/${NFTBAN_SERVICE_UI:-nftban-ui.service}" ]] || [[ -f "/usr/lib/systemd/system/${NFTBAN_SERVICE_UI:-nftban-ui.service}" ]]; then
1839:         service_exists=true
1840:     fi
1841: 
1842:     if [[ "$service_exists" == "false" ]]; then
1843:         gui_issues+=("Web UI not enabled (OPTIONAL)")
1844:         gui_issues+=("ℹ️  To enable: Run 'nftban ui init' then 'nftban ui start'")
1845:         # GUI is OPTIONAL - only set WARNING if binary exists (partially installed)
1846:         # If binary doesn't exist either, keep status OK (not installed = OK for optional feature)
1847:         if [[ -f "$gui_binary" ]]; then
1848:             [[ $status -lt $HEALTH_WARNING ]] && status=$HEALTH_WARNING
1849:         fi
1850:     else
1851:         # Check if service is enabled
1852:         if systemctl is-enabled --quiet ${NFTBAN_SERVICE_UI:-nftban-ui.service} 2>/dev/null; then
1853:             gui_issues+=("✓ GUI service: Enabled")
1854:         else
1855:             gui_issues+=("Web UI service not enabled (OPTIONAL)")
1856:             gui_issues+=("ℹ️  To enable: Run 'systemctl enable nftban-ui'")
1857:             [[ $status -lt $HEALTH_WARNING ]] && status=$HEALTH_WARNING
1858: 
1859:             if [[ $auto_heal -eq 1 ]]; then
1860:                 echo "  🔧 Auto-heal: Enabling GUI service..."
1861:                 systemctl enable ${NFTBAN_SERVICE_UI:-nftban-ui.service} 2>&1 && gui_issues+=("✓ GUI service enabled")
1862:             fi
1863:         fi
1864: 
1865:         # Check if service is running
1866:         if systemctl is-active --quiet ${NFTBAN_SERVICE_UI:-nftban-ui.service} 2>/dev/null; then
1867:             gui_issues+=("✓ GUI service: Running")
1868: 
1869:             # Check if GUI is accessible
1870:             local gui_addr="${NFTBAN_GUI_ADDR:-127.0.0.1:3940}"
1871:             if command -v curl >/dev/null 2>&1; then
1872:                 if timeout "${NFTBAN_TIMEOUT_FAST}" curl -k -s "https://${gui_addr}/" >/dev/null 2>&1; then
1873:                     gui_issues+=("✓ GUI: Accessible on https://${gui_addr}")
1874:                 else
1875:                     gui_issues+=("GUI not responding on https://${gui_addr}")
1876:                     [[ $status -lt $HEALTH_WARNING ]] && status=$HEALTH_WARNING
1877:                 fi
1878:             fi
1879:         else
1880:             gui_issues+=("Web UI service not running (OPTIONAL)")
1881:             gui_issues+=("ℹ️  To start: Run 'nftban ui start'")
1882:             [[ $status -lt $HEALTH_WARNING ]] && status=$HEALTH_WARNING
1883: 
1884:             if [[ $auto_heal -eq 1 ]]; then
1885:                 echo "  🔧 Auto-heal: Starting GUI service..."
1886:                 systemctl start ${NFTBAN_SERVICE_UI:-nftban-ui.service} 2>&1 && \
